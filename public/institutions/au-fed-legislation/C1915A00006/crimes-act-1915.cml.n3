concept:crimes-act-1915-sec-2 a cml:Concept ;
    skos:prefLabel "2 Section 2"@en ;
    cml:realizedBy doc:sec-2 ;
    values:originalText "Section eighty-six of the Crimes Act 1914 is amended by inserting after paragraph (d) the following words:— \"or (e) to defraud the Commonwealth.\" Conspiracy to defraud the Commonwealth." ;
