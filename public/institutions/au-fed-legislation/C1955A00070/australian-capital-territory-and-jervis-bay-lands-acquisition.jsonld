    {
      "@id": "concept:australian-capital-territory-and-jervis-bay-lands-acquisition-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Section 5",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-and-jervis-bay-lands-acquisition#sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
