concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-40e a cml:Concept ;
    skos:prefLabel "40E Special members"@en ;
    cml:realizedBy doc:sch-1-sec-40e ;
    values:originalText "(1) The Commissioner may, on such terms and conditions as he or she determines in writing, appoint a person as a special member of the Australian Federal Police to assist in the performance of its functions.  (2) A person appointed under subsection (1) has, during the continuance of his or her appointment:  (a) any powers and duties that are expressly conferred or imposed on special members under a provision of this Act or of any other Act; and  (b) such of the powers and duties conferred or imposed on members as are specified in his or her instrument of appointment." ;
    skos:definition "(1) The Commissioner may, on such terms and conditions as he or she determines in writing, appoint a person as a special member of the Australian Federal Police to assist in the performance of its functions.  (2) A person appointed under subsection (1) has, during the continuance of his or her appointment:  (a) any powers and duties that are expressly conferred or imposed on special members under a provision of this Act or of any other Act; and  (b) such of the powers and duties conferred or imposed on members as are specified in his or her instrument of appointment."@en ;
    cml:integrityHash "812c129565e84cb94f4be611978ffe01b54b831715ded6e3d2f172824bbcb9b1" ;
    cof:pageNumber "30"^^xsd:integer ;
    cml:hasPart concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-40e-ss-1 ;
    cml:hasPart concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-40e-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-legislation-amendment-act-2000.pdf> ;
    dc:source "australian-federal-police-legislation-amendment-act-2000.pdf, p.30" .
