concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-31-2 a cml:Concept ;
    skos:prefLabel "31 Retirement upon reaching minimum retiring age"@en ;
    cml:realizedBy doc:sch-1-sec-31-2 ;
    values:originalText "(1) An AFP employee who has reached the minimum retiring age is entitled to retire at any time by notice in writing to the Commissioner.  Amendment of the Australian Federal Police Act 1979  Schedule 1  Minimum retiring age  (2) For the purposes of this section, the minimum retiring age is 55 years, or such higher or lower age as is prescribed by the regulations." ;
    skos:definition "(1) An AFP employee who has reached the minimum retiring age is entitled to retire at any time by notice in writing to the Commissioner.  Amendment of the Australian Federal Police Act 1979  Schedule 1  Minimum retiring age  (2) For the purposes of this section, the minimum retiring age is 55 years, or such higher or lower age as is prescribed by the regulations."@en ;
    cml:integrityHash "937dc9972807b3d3c601604a8df245deeb07ebcb171268ca9863725c7fb6a7bc" ;
    cof:pageNumber "20"^^xsd:integer ;
    cml:hasPart concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-31-2-ss-1 ;
