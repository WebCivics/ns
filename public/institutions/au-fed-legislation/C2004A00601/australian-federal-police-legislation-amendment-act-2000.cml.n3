concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-41a a cml:Concept ;
    skos:prefLabel "41A Old law members or staff members"@en ;
    cml:realizedBy doc:sch-1-sec-41a ;
    values:originalText "For the purposes of this Part, if at a particular time before the changeover day a person was a member or staff member (within the meaning of this Act as in force at that time), the person was an old law member or staff member at that time." ;
    skos:definition "For the purposes of this Part, if at a particular time before the changeover day a person was a member or staff member (within the meaning of this Act as in force at that time), the person was an old law member or staff member at that time."@en ;
