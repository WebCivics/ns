    cml:hasPart concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-85-ss-4 ;
    cml:hasPart concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-85-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-legislation-amendment-act-2000.pdf> ;
