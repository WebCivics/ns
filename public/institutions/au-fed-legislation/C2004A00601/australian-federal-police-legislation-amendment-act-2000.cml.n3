concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-66 a cml:Concept ;
    skos:prefLabel "66 At the end of section 51"@en ;
    cml:realizedBy doc:sch-1-sec-66 ;
    values:originalText "Add:  (5) To avoid doubt, for the purposes of paragraph (1)(b), a person does not cease to be an AFP employee in circumstances where the person completes a period of engagement under section 24 (the initial period) and is re-engaged under that section for a further period starting immediately after the end of the initial period." ;
    skos:definition "Add:  (5) To avoid doubt, for the purposes of paragraph (1)(b), a person does not cease to be an AFP employee in circumstances where the person completes a period of engagement under section 24 (the initial period) and is re-engaged under that section for a further period starting immediately after the end of the initial period."@en ;
    cml:integrityHash "cbb061166444841197452ae6dc293ad9118cdcf15c8f1359d52f543cb2f23e6f" ;
    cof:pageNumber "42"^^xsd:integer ;
