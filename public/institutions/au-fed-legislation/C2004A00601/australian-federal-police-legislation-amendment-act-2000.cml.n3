doc:sch-1-sec-6-2 a cof:Section ;
    cof:title "6 Constitution of the Australian Federal Police" ;
    values:kind "section" ;
    values:originalText "The Australian Federal Police consists of:  (a) the Commissioner of Police; and  (b) any Deputy Commissioner of Police; and  (c) AFP employees; and  (d) special members." ;
    cof:pageNumber "14"^^xsd:integer .

concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-29 a cml:Concept ;
    skos:prefLabel "29 Paragraph 9(1)(a)"@en ;
    cml:realizedBy doc:sch-1-sec-29 ;
    values:originalText "Repeal the paragraph, substitute:  (a) the powers and duties that are conferred or imposed by or under a law of the Commonwealth on:  (i) a constable; or  Amendment of the Australian Federal Police Act 1979  Schedule 1  (ii) a constable of a particular rank, if a declaration under subsection (2A) is in force that the member is of that rank for the purposes of this subparagraph; and Note: The heading to section 9 is replaced by the heading “Laws conferring powers on members”." ;
    skos:definition "Repeal the paragraph, substitute:  (a) the powers and duties that are conferred or imposed by or under a law of the Commonwealth on:  (i) a constable; or  Amendment of the Australian Federal Police Act 1979  Schedule 1  (ii) a constable of a particular rank, if a declaration under subsection (2A) is in force that the member is of that rank for the purposes of this subparagraph; and Note: The heading to section 9 is replaced by the heading “Laws conferring powers on members”."@en ;
    cml:integrityHash "70c9900838fa83fd14fd9203f5c03aeb567393690d45877e51f6360ac3cd1b00" ;
    cof:pageNumber "14"^^xsd:integer ;
