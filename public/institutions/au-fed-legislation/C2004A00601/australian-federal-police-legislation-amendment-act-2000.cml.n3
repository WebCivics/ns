concept:australian-federal-police-legislation-amendment-act-2000-sch-3-sec-30 a cml:Concept ;
    skos:prefLabel "30 Amendment of the Radiocommunications Act 1992"@en ;
    cml:realizedBy doc:sch-3-sec-30 ;
    values:originalText "The Radiocommunications Act 1992 as in force at and after the commencing time applies to a certificate issued under section 305 of that Act at any time before the commencing time by a member or special member of the Australian Federal Police in the same way as it does to a certificate given under that section at or after the commencing time." ;
    skos:definition "The Radiocommunications Act 1992 as in force at and after the commencing time applies to a certificate issued under section 305 of that Act at any time before the commencing time by a member or special member of the Australian Federal Police in the same way as it does to a certificate given under that section at or after the commencing time."@en ;
    cml:integrityHash "0afdf3a18736571a5e9257bb94245402df62565327aee8caf9c95fd8c8933874" ;
    cof:pageNumber "80"^^xsd:integer ;
