doc:sch-1-sec-40h-ss-3 a cof:Section ;
    cof:title "40H(3) Assignment of duties etc." ;
    values:kind "subsection" ;
    values:originalText "(3) If:  (a) the Commissioner makes a determination under subsection (1); and  Amendment of the Australian Federal Police Act 1979  Schedule 1  (b) the Commissioner specifies in the determination that the duties concerned are to meet the special operational needs of the Australian Federal Police; the Commissioner may determine in writing the accommodation arrangements that are to apply to the employee, or any allowances the employee is to be paid, while the employee is performing those duties." ;
    cof:pageNumber "32"^^xsd:integer .

concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-40j a cml:Concept ;
    skos:prefLabel "40J Suspension from duties etc."@en ;
    cml:realizedBy doc:sch-1-sec-40j ;
    values:originalText "The regulations may do either or both of the following:  (a) provide for the suspension from duties of AFP employees, with or without remuneration;  (b) provide that declarations under section 40B (about declaring AFP employees to be members) cease to be in force during a specified period. Note: A declaration under section 40B could also be revoked etc. under subsection 33(3) of the Acts Interpretation Act 1901." ;
    skos:definition "The regulations may do either or both of the following:  (a) provide for the suspension from duties of AFP employees, with or without remuneration;  (b) provide that declarations under section 40B (about declaring AFP employees to be members) cease to be in force during a specified period. Note: A declaration under section 40B could also be revoked etc. under subsection 33(3) of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "143adaf70a953ee27b40ab6145842502c9ab587e98d3b83f4790b1ac6f641caa" ;
    cof:pageNumber "33"^^xsd:integer ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
