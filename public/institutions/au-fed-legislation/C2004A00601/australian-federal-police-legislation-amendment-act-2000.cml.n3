concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-25-2 a cml:Concept ;
    skos:prefLabel "25 Senior executive AFP employees"@en ;
    cml:realizedBy doc:sch-1-sec-25-2 ;
    values:originalText "The Commissioner may, by writing, declare an AFP employee to be a senior executive AFP employee.  Amendment of the Australian Federal Police Act 1979  Schedule 1" ;
    skos:definition "The Commissioner may, by writing, declare an AFP employee to be a senior executive AFP employee.  Amendment of the Australian Federal Police Act 1979  Schedule 1"@en ;
