concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-6-2 a cml:Concept ;
    skos:prefLabel "6 Constitution of the Australian Federal Police"@en ;
    cml:realizedBy doc:sch-1-sec-6-2 ;
    values:originalText "The Australian Federal Police consists of:  (a) the Commissioner of Police; and  (b) any Deputy Commissioner of Police; and  (c) AFP employees; and  (d) special members." ;
    skos:definition "The Australian Federal Police consists of:  (a) the Commissioner of Police; and  (b) any Deputy Commissioner of Police; and  (c) AFP employees; and  (d) special members."@en ;
    cml:integrityHash "8cc5e53ffbe0b9875cf99f49cffb533f6c39549bd32f5069f6d5da908c8ca33e" ;
    cof:pageNumber "14"^^xsd:integer ;
