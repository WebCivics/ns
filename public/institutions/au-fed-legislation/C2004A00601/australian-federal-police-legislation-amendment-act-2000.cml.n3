doc:sch-3-sec-17 a cof:Section ;
    cof:title "17 Certificates under section 68 of the Australian Federal" ;
    values:kind "section" ;
    values:originalText "Police Act 1979 Section 68 of the Australian Federal Police Act 1979 as in force at and after the commencing time applies to a certificate given under that section at any time before the commencing time in the same way as it does to a certificate given under that section at or after the commencing time." ;
    cof:pageNumber "74"^^xsd:integer .

concept:australian-federal-police-legislation-amendment-act-2000-sch-3-sec-18 a cml:Concept ;
    skos:prefLabel "18 References in statutory instruments to “staff member”"@en ;
    cml:realizedBy doc:sch-3-sec-18 ;
    values:originalText "If a statutory instrument was in force immediately before the commencing time, for the purpose of applying the instrument to any thing done or any circumstance existing after the commencing time, references in the instrument to a staff member of the Australian Federal Police are, unless the contrary intention appears, taken to be references to an AFP employee who is not a member." ;
    skos:definition "If a statutory instrument was in force immediately before the commencing time, for the purpose of applying the instrument to any thing done or any circumstance existing after the commencing time, references in the instrument to a staff member of the Australian Federal Police are, unless the contrary intention appears, taken to be references to an AFP employee who is not a member."@en ;
    cml:integrityHash "a2d830351a5a4a06b0a5d5707d26ba49523262372ee65144638eb5c5eb1b19ce" ;
    cof:pageNumber "74"^^xsd:integer ;
