concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-28-2 a cml:Concept ;
    skos:prefLabel "28 Termination of employment by Commissioner"@en ;
    cml:realizedBy doc:sch-1-sec-28-2 ;
    values:originalText "The Commissioner may at any time, by notice in writing, terminate the employment of an AFP employee. Note: The Workplace Relations Act 1996 has rules that apply to termination of employment. Subdivision D—Resignation and retirement" ;
    skos:definition "The Commissioner may at any time, by notice in writing, terminate the employment of an AFP employee. Note: The Workplace Relations Act 1996 has rules that apply to termination of employment. Subdivision D—Resignation and retirement"@en ;
    cml:integrityHash "ba25ae5034b6e1fff6c26d6ae9a07c0d28efd95a1953fe7974efa3b7844e20a8" ;
    cof:pageNumber "20"^^xsd:integer ;
