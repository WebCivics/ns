concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-69 a cml:Concept ;
    skos:prefLabel "69 Subsection 60A(1)"@en ;
    cml:realizedBy doc:sch-1-sec-69 ;
    values:originalText "Repeal the subsection, substitute:  (1) This section applies to a person who is, or was at any time:  Schedule 1  Amendment of the Australian Federal Police Act 1979  (a) the Commissioner; or  (b) a Deputy Commissioner; or  (c) an AFP employee; or  (d) a special member; or  (e) a person engaged under section 35; or  (f) a person performing functions under an agreement under section 69D." ;
    skos:definition "Repeal the subsection, substitute:  (1) This section applies to a person who is, or was at any time:  Schedule 1  Amendment of the Australian Federal Police Act 1979  (a) the Commissioner; or  (b) a Deputy Commissioner; or  (c) an AFP employee; or  (d) a special member; or  (e) a person engaged under section 35; or  (f) a person performing functions under an agreement under section 69D."@en ;
    cml:integrityHash "b799270d353428d967baa4fa78ad5e0926ef98acd0fd0ede17fe3bd469ea511d" ;
    cof:pageNumber "43"^^xsd:integer ;
