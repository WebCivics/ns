doc:sch-1-sec-31-2 a cof:Section ;
    cof:title "31 Retirement upon reaching minimum retiring age" ;
    values:kind "section" ;
    values:originalText "(1) An AFP employee who has reached the minimum retiring age is entitled to retire at any time by notice in writing to the Commissioner.  Amendment of the Australian Federal Police Act 1979  Schedule 1  Minimum retiring age  (2) For the purposes of this section, the minimum retiring age is 55 years, or such higher or lower age as is prescribed by the regulations." ;
    cof:pageNumber "20"^^xsd:integer .

