concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-69-2 a cml:Concept ;
    skos:prefLabel "69 Prohibition of patronage and favouritism"@en ;
    cml:realizedBy doc:sch-1-sec-69-2 ;
    values:originalText "The Commissioner, or a delegate of the Commissioner, in exercising powers under this Act:  (a) in relation to the engagement of AFP employees; or  (b) otherwise in relation to AFP employees; must do so without patronage or favouritism.  Schedule 1  Amendment of the Australian Federal Police Act 1979" ;
    skos:definition "The Commissioner, or a delegate of the Commissioner, in exercising powers under this Act:  (a) in relation to the engagement of AFP employees; or  (b) otherwise in relation to AFP employees; must do so without patronage or favouritism.  Schedule 1  Amendment of the Australian Federal Police Act 1979"@en ;
    cml:integrityHash "53967678c3cdb5e8b430a76652f3a6f75b7671b51b7d0260050f174edae6061e" ;
    cof:pageNumber "47"^^xsd:integer ;
