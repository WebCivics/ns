concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-40c a cml:Concept ;
    skos:prefLabel "40C Determination of competency or qualification requirements"@en ;
    cml:realizedBy doc:sch-1-sec-40c ;
    values:originalText "The Commissioner may, by written determination, specify either or both of the following for the purposes of section 40B:  (a) competency requirements;  (b) qualification requirements." ;
    skos:definition "The Commissioner may, by written determination, specify either or both of the following for the purposes of section 40B:  (a) competency requirements;  (b) qualification requirements."@en ;
    cml:integrityHash "ad8ed5acd12fdd6975587e4a45c064238af532fa9c4d636155a3301bf43f1c1a" ;
