doc:sch-1-sec-84 a cof:Section ;
    cof:title "84 Subsection 66(2)" ;
    values:kind "section" ;
    values:originalText "Omit “member or staff member concerned”, substitute “Commissioner, Deputy Commissioner, AFP employee or special member, as the case may be,”." ;
