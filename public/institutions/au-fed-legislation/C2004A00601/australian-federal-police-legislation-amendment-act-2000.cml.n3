doc:sch-1-sec-34-2-ss-1 a cof:Section ;
    cof:title "34(1) Voluntary retirement for the purposes of the Superannuation Act" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) an AFP employee resigns from the Australian Federal Police in accordance with section 30; and  (b) the resignation takes effect on or after the day on which he or she reaches 55 but before he or she reaches 60; he or she is taken, for the purposes of the Superannuation Act, to have retired voluntarily. Termination of employment" ;
    cof:pageNumber "24"^^xsd:integer .

concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-34-2-ss-2 a cml:Concept ;
    skos:prefLabel "34(2) Voluntary retirement for the purposes of the Superannuation Act"@en ;
    cml:realizedBy doc:sch-1-sec-34-2-ss-2 ;
    values:originalText "(2) If:  (a) an AFP employee’s employment is terminated under section 28; and  (b) the termination takes effect on or after the day on which he or she reaches 55 but before he or she reaches 60; he or she is taken, for the purposes of the Superannuation Act, to have retired voluntarily. Period of employment ends" ;
    skos:definition "(2) If:  (a) an AFP employee’s employment is terminated under section 28; and  (b) the termination takes effect on or after the day on which he or she reaches 55 but before he or she reaches 60; he or she is taken, for the purposes of the Superannuation Act, to have retired voluntarily. Period of employment ends"@en ;
    cml:integrityHash "ced1ef05ada8b8aeef56e4cbef157ae32cb53ae9d79860d16089882ec418d03e" ;
    values:partOf concept:australian-federal-police-legislation-amendment-act-2000-sch-1-sec-34-2 ;
    cof:pageNumber "24"^^xsd:integer ;
