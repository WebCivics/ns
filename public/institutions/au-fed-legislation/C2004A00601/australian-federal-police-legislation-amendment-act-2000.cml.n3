concept:australian-federal-police-legislation-amendment-act-2000-sch-3-sec-13 a cml:Concept ;
    skos:prefLabel "13 Continuation of section 49 of the Australian Federal Police"@en ;
    cml:realizedBy doc:sch-3-sec-13 ;
    values:originalText "Act 1979 Section 49 of the Australian Federal Police Act 1979 as in force immediately before the commencing time continues to apply at and after the commencing time to any person found guilty of a relevant disciplinary offence before the commencing time as if the amendments to that section made by Schedule 1 to this Act had not been made." ;
    skos:definition "Act 1979 Section 49 of the Australian Federal Police Act 1979 as in force immediately before the commencing time continues to apply at and after the commencing time to any person found guilty of a relevant disciplinary offence before the commencing time as if the amendments to that section made by Schedule 1 to this Act had not been made."@en ;
    cml:integrityHash "b0993923724eab00b9c158d64baacab0fc96752c31ebbc6edad660fa1d9cb158" ;
    cof:pageNumber "73"^^xsd:integer ;
