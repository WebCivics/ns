concept:australian-federal-police-legislation-amendment-act-2000-sch-3-sec-9 a cml:Concept ;
    skos:prefLabel "9 Misconduct"@en ;
    cml:realizedBy doc:sch-3-sec-9 ;
    values:originalText "The Commissioner may, under section 28 of the later Act, terminate the employment of an AFP employee for pre-commencement misconduct as if the conduct had happened after the commencing time." ;
    skos:definition "The Commissioner may, under section 28 of the later Act, terminate the employment of an AFP employee for pre-commencement misconduct as if the conduct had happened after the commencing time."@en ;
