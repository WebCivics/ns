    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-2000-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act-2000#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act-2000.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act-2000.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nTelecommunications (Consumer Protection and Service Standards) Act 1999  Schedule\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act 2000       No.\n33, 2000            3",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nTelecommunications (Consumer Protection and Service Standards) Act 1999  Schedule\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act 2000       No.\n33, 2000            3",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-2000-sec-3-norm"
        }
      ],
      "cml:integrityHash": "7283606bee7df60b45d783cf704f69cd7e1b6c2d5e68d0f6982586a9668f9ea1"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act-2000#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nTelecommunications (Consumer Protection and Service Standards) Act 1999  Schedule\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act 2000       No.\n33, 2000            3"
    },
