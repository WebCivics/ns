    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act-2000#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Transitional",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Despite section 100 of the Telecommunications (Consumer Protection\nand Service Standards) Act 1999, the total levy for the first quarter that\ncommences after the day on which this Act receives the Royal Assent is\nthe estimated NRS cost for the quarter."
    },
