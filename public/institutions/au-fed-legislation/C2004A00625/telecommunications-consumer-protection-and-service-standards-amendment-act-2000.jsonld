      }
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-2000-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Transitional",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act-2000#sch-1-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act-2000.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act-2000.pdf, p.7",
      "values:originalText": "Despite section 100 of the Telecommunications (Consumer Protection\nand Service Standards) Act 1999, the total levy for the first quarter that\ncommences after the day on which this Act receives the Royal Assent is\nthe estimated NRS cost for the quarter.",
      "skos:definition": "Despite section 100 of the Telecommunications (Consumer Protection\nand Service Standards) Act 1999, the total levy for the first quarter that\ncommences after the day on which this Act receives the Royal Assent is\nthe estimated NRS cost for the quarter.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-2000-sch-1-sec-5-norm"
