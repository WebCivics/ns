    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-2000-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act-2000#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
