    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-84",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.26",
      "skos:note": "Commencement provisions for declarations under subsections 26A(4) and (5)",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "84 New subsections 26A(4) and (5) and old subsections"
      },
      "wasDerivedFrom": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf",
      "asserts": [
        "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-84-norm",
        "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-84-logic-deontic-1",
        "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-84-logic-deontic-2",
        "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-84-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "7e06903333b4b77b1063f6b6e5dd56fd04cd6f771f0e6db275d97a5a0cd4cd6c",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-84",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-84-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Subsection 26A(5) of the amended Act applies in relation to declarations made before, on or after the commencement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Subsections apply to declarations made before, on or after commencement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicability",
      "cml:premiseText": "Subsection 26A(4) of the amended Act applies in relation to declarations referred to in that subsection that are made on or after the commencement."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-84-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Subsection 26A(5) of the old Act continues to apply to a revocation made before the commencement as if the subsection had not been repealed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Old subsections continue to apply to certain declarations",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continuity",
      "cml:premiseText": "Subsection 26A(4) of the old Act continues to apply in relation to a declaration made before the commencement as if the subsection had not been repealed."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-84-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Subsection 26A(6) or (7) of the old Act applies to 2 declarations (an original declaration and a fresh declaration) made before the commencement",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Subsections apply to declarations made before, on or after commencement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicability",
      "cml:premiseText": "If subsection 26A(6) or (7) of the old Act applied to 2 declarations (an original declaration and a fresh declaration) made before the commencement, but the fresh declaration had not taken effect, and the original declaration had not ceased to have effect, under that subsection by the commencement, that subsection continues to apply to those declarations as if it had not been repealed."
    },
