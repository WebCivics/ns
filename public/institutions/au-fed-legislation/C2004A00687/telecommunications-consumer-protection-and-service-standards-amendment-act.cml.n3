concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-35 a cml:Concept ;
    skos:prefLabel "35 Subsections 26A(4), (5), (6) and (7)"@en ;
    cml:realizedBy doc:sch-1-sec-35 ;
    values:originalText "Repeal the subsections, substitute:  (4) A declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the declaration. That day must not be a day before the declaration is made.  (5) A revocation of a declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the instrument of revocation. That day must not be a day before the instrument is made." ;
    skos:definition "Repeal the subsections, substitute:  (4) A declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the declaration. That day must not be a day before the declaration is made.  (5) A revocation of a declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the instrument of revocation. That day must not be a day before the instrument is made."@en ;
    cml:integrityHash "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d" ;
    cof:pageNumber "14"^^xsd:integer ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-35-ss-4 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-35-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.14" .
