concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-18-2-ss-1j a cml:Concept ;
    skos:prefLabel "18(1J) Telecommunications (Consumer Protection and Service Standards) Amendment Act"@en ;
    cml:realizedBy doc:sch-1-sec-18-2-ss-1j ;
    values:originalText "(1J) If:  (a) the Minister has received advice under subsection (1F) about a proposed determination or variation; and  (b) the determination or variation is not made in accordance with the advice; the Minister must:  (c) publish his or her reasons for departing from the advice in the Gazette within 14 days after making the determination; and  (d) cause copies of his or her reasons for departing from the advice to be laid before each House of the Parliament within 5 sitting days of that House after making the determination." ;
    skos:definition "(1J) If:  (a) the Minister has received advice under subsection (1F) about a proposed determination or variation; and  (b) the determination or variation is not made in accordance with the advice; the Minister must:  (c) publish his or her reasons for departing from the advice in the Gazette within 14 days after making the determination; and  (d) cause copies of his or her reasons for departing from the advice to be laid before each House of the Parliament within 5 sitting days of that House after making the determination."@en ;
    cml:integrityHash "0dd3f8a6ad5a087c91b390c6f7784885fb7e68f37aa74b77bc9e3eb3a65b180c" ;
    values:partOf concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-18-2 ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Publish reasons for departing from advice within 14 days and lay copies before Parliament." ;
    dc:description "Reasons for departure" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.22" ;
