concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-7 a cml:Concept ;
    skos:prefLabel "7 Subsections 20(4), (5), (6), (7) and (8)"@en ;
    cml:realizedBy doc:sch-1-sec-7 ;
    values:originalText "Repeal the subsections, substitute:  (4) A declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the declaration. That day must not be a day before the declaration is made.  Amendments relating to the universal service regime  Schedule 1 Amendments  Part 1  Telecommunications (Consumer Protection and Service Standards) Amendment Act (No. 1) 2000 No. 95, 2000            5  (5) A revocation of a declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the instrument of revocation. That day must not be a day before the instrument is made." ;
    skos:definition "Repeal the subsections, substitute:  (4) A declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the declaration. That day must not be a day before the declaration is made.  Amendments relating to the universal service regime  Schedule 1 Amendments  Part 1  Telecommunications (Consumer Protection and Service Standards) Amendment Act (No. 1) 2000 No. 95, 2000            5  (5) A revocation of a declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the instrument of revocation. That day must not be a day before the instrument is made."@en ;
    cml:integrityHash "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d" ;
    cof:pageNumber "8"^^xsd:integer ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-7-ss-4 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-7-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.8" .
doc:sch-1-sec-7 a cof:Section ;
    cof:title "7 Subsections 20(4), (5), (6), (7) and (8)" ;
    values:kind "section" ;
    values:originalText "Repeal the subsections, substitute:  (4) A declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the declaration. That day must not be a day before the declaration is made.  Amendments relating to the universal service regime  Schedule 1 Amendments  Part 1  Telecommunications (Consumer Protection and Service Standards) Amendment Act (No. 1) 2000 No. 95, 2000            5  (5) A revocation of a declaration under subsection (1) or (2) takes effect on the day specified for the purpose in the instrument of revocation. That day must not be a day before the instrument is made." ;
    cof:pageNumber "8"^^xsd:integer .

