concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12 a cml:Concept ;
    skos:prefLabel "12 Subsection 21(2) (note)"@en ;
    cml:realizedBy doc:sch-1-sec-12 ;
    values:originalText "Repeal the note, substitute: Note: If a carrier that is the sole regional universal service provider for a particular service area ceases to be a regional universal service provider for that area and is not replaced as a regional universal service provider for that area by another carrier, the carrier, or each carrier, that is a national universal service provider automatically becomes a universal service provider for that area." ;
    skos:definition "Repeal the note, substitute: Note: If a carrier that is the sole regional universal service provider for a particular service area ceases to be a regional universal service provider for that area and is not replaced as a regional universal service provider for that area by another carrier, the carrier, or each carrier, that is a national universal service provider automatically becomes a universal service provider for that area."@en ;
    cml:integrityHash "380da56b0359551dd7fe1dfe8ed1cb0c06a4ee5d6e6a3aa390ace9d3044be565" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Automatically becomes a universal service provider for that area if sole regional universal service provider ceases to be so." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
