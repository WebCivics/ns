concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-2 a cml:Concept ;
    skos:prefLabel "20 Telecommunications (Consumer Protection and Service Standards) Amendment Act"@en ;
    cml:realizedBy doc:sch-1-sec-20-2 ;
    values:originalText "(No. 1) 2000       No. 95, 2000  (a) by the ACA in providing advice to the Minister (whether pursuant to a direction under subsection 57(22) or otherwise) about the specification of an amount or method in a determination proposed to be made under subsection 57(1A); or  (b) in the application of the formula in subsection 57(2); or  (c) in a method specified in a determination by the ACA under subsection 57(9); or  (d) in a method, or in working out an amount, specified by the ACA in a determination under subsection 60(1)." ;
    skos:definition "(No. 1) 2000       No. 95, 2000  (a) by the ACA in providing advice to the Minister (whether pursuant to a direction under subsection 57(22) or otherwise) about the specification of an amount or method in a determination proposed to be made under subsection 57(1A); or  (b) in the application of the formula in subsection 57(2); or  (c) in a method specified in a determination by the ACA under subsection 57(9); or  (d) in a method, or in working out an amount, specified by the ACA in a determination under subsection 60(1)."@en ;
    cml:integrityHash "d6c7bbc97e714d76e539e8d0fc25e566925474d3e473fa5ba9f2d8064e1f3f14" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "The ACA must provide advice to the Minister on certain matters." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
