    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-77",
      "@type": "cof:Section",
      "cof:title": "77 At the end of subsection 60(1)",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Add:\nNote:\nA method or amount specified in a determination under this\nsubsection must not take into account any grant that has been or may\nbe made to a person under section 56 or 57 of the Telstra Corporation\nAct 1991—see section 61AA."
    },
