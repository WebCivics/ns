    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-66",
      "@type": "cml:Concept",
      "skos:prefLabel": "66 Subsection 51(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-66"
      },
      "cml:curationStatus": {
