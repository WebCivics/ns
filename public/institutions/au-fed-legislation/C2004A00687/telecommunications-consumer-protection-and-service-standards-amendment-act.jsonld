      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.6",
      "values:originalText": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nAmendments relating to the universal service regime  Schedule 1\nAmendments  Part 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 1) 2000\nNo. 95, 2000            3",
      "skos:definition": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nAmendments relating to the universal service regime  Schedule 1\nAmendments  Part 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 1) 2000\nNo. 95, 2000            3",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sec-3-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sec-3-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "e906945528e292655750f405bd613d736967111bebf28c759b47789a715c10b6",
      "skos:note": "Amendments to Schedule 1 and other items in Schedules have effect according to their terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nAmendments relating to the universal service regime  Schedule 1\nAmendments  Part 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 1) 2000\nNo. 95, 2000            3"
    },
