    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-24a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "24A(3) Former universal service provider may be required to provide",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-24a-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.10",
      "values:originalText": "(3) The information that may be required to be given must be\ninformation that will assist the current provider in doing something\nthat the current provider is or will be required or permitted to do by\nor under a provision of this Part. The notice must identify the doing\nof that thing as the purpose for which the information is required.\nNote 1:\nIf, for example, information about service location and customer\ncontact details will assist the current provider in fulfilling its\nobligation under subsection 21(5), the former provider may be\nrequired to provide that kind of information.\nNote 2:\nSee also subsection (5), which allows the Minister to determine that a\nspecified kind of information is information referred to in this\nsubsection.",
      "skos:definition": "(3) The information that may be required to be given must be\ninformation that will assist the current provider in doing something\nthat the current provider is or will be required or permitted to do by\nor under a provision of this Part. The notice must identify the doing\nof that thing as the purpose for which the information is required.\nNote 1:\nIf, for example, information about service location and customer\ncontact details will assist the current provider in fulfilling its\nobligation under subsection 21(5), the former provider may be\nrequired to provide that kind of information.\nNote 2:\nSee also subsection (5), which allows the Minister to determine that a\nspecified kind of information is information referred to in this\nsubsection.",
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-24a"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-24a-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-24a-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-24a-ss-3-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "7b8ee5d9754564e8efaf94f8806e661a61d790fe99985351ca3c6b9a1489d358",
      "skos:note": "Former universal service provider must provide information to assist current provider in fulfilling obligations.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-24a-ss-3",
      "@type": "cof:Section",
      "cof:title": "24A(3) Former universal service provider may be required to provide",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(3) The information that may be required to be given must be\ninformation that will assist the current provider in doing something\nthat the current provider is or will be required or permitted to do by\nor under a provision of this Part. The notice must identify the doing\nof that thing as the purpose for which the information is required.\nNote 1:\nIf, for example, information about service location and customer\ncontact details will assist the current provider in fulfilling its\nobligation under subsection 21(5), the former provider may be\nrequired to provide that kind of information.\nNote 2:\nSee also subsection (5), which allows the Minister to determine that a\nspecified kind of information is information referred to in this\nsubsection."
    },
