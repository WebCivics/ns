      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.10",
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what carrier\nshould be declared under subsection 20(2) in a particular situation,\nor may make that decision on some other basis.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what carrier\nshould be declared under subsection 20(2) in a particular situation,\nor may make that decision on some other basis.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-18-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "30442dfe3871f8753c2f3fcf120a82ce41f64973b68dd9e631d4196fad79f75a",
      "skos:note": "May use system for deciding carrier declaration"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Subsection 23(4)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what carrier\nshould be declared under subsection 20(2) in a particular situation,\nor may make that decision on some other basis."
    },
