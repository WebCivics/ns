    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-35",
      "@type": "cml:Concept",
      "skos:prefLabel": "35 Subsections 26A(4), (5), (6) and (7)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-35"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.14",
      "values:originalText": "Repeal the subsections, substitute:\n\n(4) A declaration under subsection (1) or (2) takes effect on the day\nspecified for the purpose in the declaration. That day must not be a\nday before the declaration is made.\n\n(5) A revocation of a declaration under subsection (1) or (2) takes\neffect on the day specified for the purpose in the instrument of\nrevocation. That day must not be a day before the instrument is\nmade.",
      "skos:definition": "Repeal the subsections, substitute:\n\n(4) A declaration under subsection (1) or (2) takes effect on the day\nspecified for the purpose in the declaration. That day must not be a\nday before the declaration is made.\n\n(5) A revocation of a declaration under subsection (1) or (2) takes\neffect on the day specified for the purpose in the instrument of\nrevocation. That day must not be a day before the instrument is\nmade.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-35-ss-4"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-35-ss-5"
        }
      ],
      "cml:integrityHash": "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-35",
      "@type": "cof:Section",
      "cof:title": "35 Subsections 26A(4), (5), (6) and (7)",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Repeal the subsections, substitute:\n\n(4) A declaration under subsection (1) or (2) takes effect on the day\nspecified for the purpose in the declaration. That day must not be a\nday before the declaration is made.\n\n(5) A revocation of a declaration under subsection (1) or (2) takes\neffect on the day specified for the purpose in the instrument of\nrevocation. That day must not be a day before the instrument is\nmade."
    },
