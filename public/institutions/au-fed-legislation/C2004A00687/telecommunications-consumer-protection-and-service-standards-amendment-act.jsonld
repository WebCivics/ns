    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Subsection 22(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.10",
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what carrier\nshould be declared under subsection 20(1) in a particular situation,\nor may make that decision on some other basis.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what carrier\nshould be declared under subsection 20(1) in a particular situation,\nor may make that decision on some other basis.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-16-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-16-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9209f9c708c053793976712c66994f50c9330d9689a13461b1b63ea32cf5f0f1",
      "skos:note": "May use a system for deciding carrier declaration in a particular situation."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Subsection 22(4)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what carrier\nshould be declared under subsection 20(1) in a particular situation,\nor may make that decision on some other basis."
    },
