    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.24",
      "values:originalText": "(No. 1) 2000       No. 95, 2000\n\n(a) by the ACA in providing advice to the Minister (whether\npursuant to a direction under subsection 57(22) or otherwise)\nabout the specification of an amount or method in a\ndetermination proposed to be made under subsection 57(1A);\nor\n\n(b) in the application of the formula in subsection 57(2); or\n\n(c) in a method specified in a determination by the ACA under\nsubsection 57(9); or\n\n(d) in a method, or in working out an amount, specified by the\nACA in a determination under subsection 60(1).",
      "skos:definition": "(No. 1) 2000       No. 95, 2000\n\n(a) by the ACA in providing advice to the Minister (whether\npursuant to a direction under subsection 57(22) or otherwise)\nabout the specification of an amount or method in a\ndetermination proposed to be made under subsection 57(1A);\nor\n\n(b) in the application of the formula in subsection 57(2); or\n\n(c) in a method specified in a determination by the ACA under\nsubsection 57(9); or\n\n(d) in a method, or in working out an amount, specified by the\nACA in a determination under subsection 60(1).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-2-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d6c7bbc97e714d76e539e8d0fc25e566925474d3e473fa5ba9f2d8064e1f3f14",
      "skos:note": "The ACA must provide advice to the Minister on certain matters."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20-2",
      "@type": "cof:Section",
      "cof:title": "20 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "(No. 1) 2000       No. 95, 2000\n\n(a) by the ACA in providing advice to the Minister (whether\npursuant to a direction under subsection 57(22) or otherwise)\nabout the specification of an amount or method in a\ndetermination proposed to be made under subsection 57(1A);\nor\n\n(b) in the application of the formula in subsection 57(2); or\n\n(c) in a method specified in a determination by the ACA under\nsubsection 57(9); or\n\n(d) in a method, or in working out an amount, specified by the\nACA in a determination under subsection 60(1)."
    },
