      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.25",
      "values:originalText": "In this Part:\namended Act means the Telecommunications (Consumer Protection\nand Service Standards) Act 1999 as in force after the commencement.\ncommencement means the commencement of this Schedule.\nold Act means the Telecommunications (Consumer Protection and\nService Standards) Act 1999 as in force immediately before the\ncommencement.",
      "skos:definition": "In this Part:\namended Act means the Telecommunications (Consumer Protection\nand Service Standards) Act 1999 as in force after the commencement.\ncommencement means the commencement of this Schedule.\nold Act means the Telecommunications (Consumer Protection and\nService Standards) Act 1999 as in force immediately before the\ncommencement.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-81-norm"
        }
      ],
      "cml:integrityHash": "87b4935451b1bfd81b71c4309447aa63a668dc64e9b3f78cd69b50cbddf6d528",
      "skos:note": "Definitions for amended and old Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-81",
      "@type": "cof:Section",
      "cof:title": "81 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "In this Part:\namended Act means the Telecommunications (Consumer Protection\nand Service Standards) Act 1999 as in force after the commencement.\ncommencement means the commencement of this Schedule.\nold Act means the Telecommunications (Consumer Protection and\nService Standards) Act 1999 as in force immediately before the\ncommencement."
    },
