      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.9",
      "values:originalText": "Insert:\n\n(10A) Subsection (10) does not apply to a declaration that the Minister is\ntaken by subsection (2B) to have made. Instead, a notice must be\npublished in the Gazette advising that the person concerned is a\nregional universal service provider for the area concerned and of\nthe relevant commencement date or dates.\nNote:\nSubsection (10) does however apply to a variation or revocation of\nsuch a declaration.",
      "skos:definition": "Insert:\n\n(10A) Subsection (10) does not apply to a declaration that the Minister is\ntaken by subsection (2B) to have made. Instead, a notice must be\npublished in the Gazette advising that the person concerned is a\nregional universal service provider for the area concerned and of\nthe relevant commencement date or dates.\nNote:\nSubsection (10) does however apply to a variation or revocation of\nsuch a declaration.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a98aa290dd6928a516b20f9a4a5599775242698b215d61c3b5e87082d75f12eb",
      "skos:note": "A notice must be published in the Gazette advising that a person is a regional universal service provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 After subsection 20(10)",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Insert:\n\n(10A) Subsection (10) does not apply to a declaration that the Minister is\ntaken by subsection (2B) to have made. Instead, a notice must be\npublished in the Gazette advising that the person concerned is a\nregional universal service provider for the area concerned and of\nthe relevant commencement date or dates.\nNote:\nSubsection (10) does however apply to a variation or revocation of\nsuch a declaration."
    },
