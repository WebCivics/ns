    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsection 21(2) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.9",
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a carrier that is the sole regional universal service provider for a\nparticular service area ceases to be a regional universal service\nprovider for that area and is not replaced as a regional universal\nservice provider for that area by another carrier, the carrier, or each\ncarrier, that is a national universal service provider automatically\nbecomes a universal service provider for that area.",
      "skos:definition": "Repeal the note, substitute:\nNote:\nIf a carrier that is the sole regional universal service provider for a\nparticular service area ceases to be a regional universal service\nprovider for that area and is not replaced as a regional universal\nservice provider for that area by another carrier, the carrier, or each\ncarrier, that is a national universal service provider automatically\nbecomes a universal service provider for that area.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "380da56b0359551dd7fe1dfe8ed1cb0c06a4ee5d6e6a3aa390ace9d3044be565",
      "skos:note": "Automatically becomes a universal service provider for that area if sole regional universal service provider ceases to be so."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Subsection 21(2) (note)",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a carrier that is the sole regional universal service provider for a\nparticular service area ceases to be a regional universal service\nprovider for that area and is not replaced as a regional universal\nservice provider for that area by another carrier, the carrier, or each\ncarrier, that is a national universal service provider automatically\nbecomes a universal service provider for that area."
    },
