      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.12",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) For the purposes of this section, there is a multiple provider\nsituation if there are 2 or more national universal service\nproviders.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) For the purposes of this section, there is a multiple provider\nsituation if there are 2 or more national universal service\nproviders.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "650abc747b00c77277cd525de849cba38a839d8e9fb7cdb960626ccbdedd88ce",
      "skos:note": "Repeal subsection, substitute definition of multiple provider situation"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Subsection 25(1)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) For the purposes of this section, there is a multiple provider\nsituation if there are 2 or more national universal service\nproviders."
    },
