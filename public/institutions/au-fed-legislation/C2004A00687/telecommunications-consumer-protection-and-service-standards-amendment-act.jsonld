      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-81",
      "@type": "cml:Concept",
      "skos:prefLabel": "81 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-81"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
