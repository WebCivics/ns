          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-59-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-59-logic-deontic-1"
