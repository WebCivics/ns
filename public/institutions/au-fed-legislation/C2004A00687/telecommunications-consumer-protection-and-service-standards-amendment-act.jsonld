    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Subsection 26C(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.15",
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what eligible\nperson should be declared under subsection 26A(1) in a particular\nsituation, or may make that decision on some other basis.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what eligible\nperson should be declared under subsection 26A(1) in a particular\nsituation, or may make that decision on some other basis.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-42-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-42-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dd518a82a6193aac934e6ee0973cef519e86b8863f6e4bd4c848d362c09d99e6",
      "skos:note": "May use a system for deciding eligible persons in a particular situation."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-42",
      "@type": "cof:Section",
      "cof:title": "42 Subsection 26C(4)",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) If a system has been determined under this section, the Minister\nmay use that system for the purposes of deciding what eligible\nperson should be declared under subsection 26A(1) in a particular\nsituation, or may make that decision on some other basis."
    },
