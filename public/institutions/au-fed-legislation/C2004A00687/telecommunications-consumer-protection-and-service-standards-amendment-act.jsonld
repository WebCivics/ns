    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 After subsection 26A(8)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
