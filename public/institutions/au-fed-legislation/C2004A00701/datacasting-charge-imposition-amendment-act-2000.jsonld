      "dc:source": "datacasting-charge-imposition-amendment-act-2000.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Datacasting Charge (Imposition) Act 1998  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Datacasting Charge (Imposition) Act 1998  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:datacasting-charge-imposition-amendment-act-2000-sec-3-norm"
        }
      ],
      "cml:integrityHash": "478be9bb6769935ce63bb3a07ac78cd7b3459fc0ae5966ed9a626fe0fb54fa1e",
      "skos:note": "Amends or repeals Acts specified in a Schedule according to its terms."
    },
    {
