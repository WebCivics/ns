    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12w-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) This section applies if:  (a) an approved policy statement for a primary universal service provider (the current statement) is in force; or  (b) an approved standard marketing plan for a primary universal service provider (the current plan) is in force; or  (c) an approved ATS marketing plan for a primary universal service provider (the current plan) is in force; and the provider gives the ACA a draft variation of the current statement or current plan.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide variation of approved policy statement or plan.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(1) This section applies if:  (a) an approved policy statement for a primary universal service provider (the current statement) is in force; or  (b) an approved standard marketing plan for a primary universal service provider (the current plan) is in force; or  (c) an approved ATS marketing plan for a primary universal service provider (the current plan) is in force; and the provider gives the ACA a draft variation of the current statement or current plan."
    },
