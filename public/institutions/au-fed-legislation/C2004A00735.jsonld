    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12c-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Service obligation is tied to a specific area.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "(1) A primary universal service provider for a universal service area in respect of a service obligation must take all reasonable steps to:"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12c-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Reasonable steps are defined by the approved policy statement and marketing plan.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "(b) Comply with: (i) the provider’s approved policy statement; and (ii) the approved standard marketing plan of the provider that covers that area in respect of that service obligation."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12c-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(a) Fulfil that service obligation, so far as it relates to that area; (b) Comply with the provider’s approved policy statement and approved standard marketing plan of the provider that covers that area in respect of that service obligation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Primary universal service provider must take reasonable steps to fulfil a service obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12c-ss-1-logic-diffusion-4",
