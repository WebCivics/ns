    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12c-ss-1",
      "@type": "cml:Concept",
      "dc:description": "(a) Fulfil that service obligation, so far as it relates to that area; (b) Comply with the provider’s approved policy statement and approved standard marketing plan of the provider that covers that area in respect of that service obligation.",
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.29",
      "skos:note": "Primary universal service provider must take reasonable steps to fulfil a service obligation.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "12C(1) Obligations of primary universal service providers"
      },
      "wasDerivedFrom": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf",
      "asserts": [
        "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12c-ss-1-norm",
        "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12c-ss-1-logic-deontic-1",
