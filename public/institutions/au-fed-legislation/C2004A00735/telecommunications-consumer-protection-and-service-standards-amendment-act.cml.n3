concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-26 a cml:Concept ;
    skos:prefLabel "26 Telecommunications (Consumer Protection and Service Standards) Amendment Act"@en ;
    cml:realizedBy doc:sch-1-sec-26 ;
    values:originalText "(No. 2) 2000       No. 142, 2000 by supplying alternative telecommunications services in accordance with an approved ATS marketing plan, is taken to have fulfilled any other obligation that arises under this Act because of that service obligation to the extent that the other obligation applies to the supply of alternative telecommunications services.  (2) The ACA may determine in writing requirements that a primary universal service provider must comply with if the provider intends to cease supplying alternative telecommunications services in accordance with an approved ATS marketing plan. A copy of the determination must be given to the provider.  (3) The provider must comply with those requirements (as well as any requirements in the plan)." ;
    skos:definition "(No. 2) 2000       No. 142, 2000 by supplying alternative telecommunications services in accordance with an approved ATS marketing plan, is taken to have fulfilled any other obligation that arises under this Act because of that service obligation to the extent that the other obligation applies to the supply of alternative telecommunications services.  (2) The ACA may determine in writing requirements that a primary universal service provider must comply with if the provider intends to cease supplying alternative telecommunications services in accordance with an approved ATS marketing plan. A copy of the determination must be given to the provider.  (3) The provider must comply with those requirements (as well as any requirements in the plan)."@en ;
    cml:integrityHash "a60311de45972967fc08da7a0dae04b6d4f030f2d1259eb48aede211bdcd00bd" ;
    cof:pageNumber "30"^^xsd:integer ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-26-ss-2 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-26-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
