doc:sch-1-sec-14-2-ss-2 a cof:Section ;
    cof:title "14(2) Determination of alternative arrangements" ;
    values:kind "subsection" ;
    values:originalText "(2) A determination under subsection (1) may expressly modify:  (a) the extent to which the default arrangements set out in Division 5 apply to the area; or  (b) the way in which any of the provisions in this Part apply to the area." ;
    cof:pageNumber "57"^^xsd:integer .

