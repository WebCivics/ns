concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20v a cml:Concept ;
    skos:prefLabel "20V Publication of assessment"@en ;
    cml:realizedBy doc:sch-1-sec-20v ;
    values:originalText "As soon as practicable after making an assessment under section 20U for a claim period, the ACA must:  (a) cause a copy of the assessment to be published in the Gazette; and  (b) give a copy of the assessment to each of the persons referred to in subsections 20U(2), (3) and (4)." ;
    skos:definition "As soon as practicable after making an assessment under section 20U for a claim period, the ACA must:  (a) cause a copy of the assessment to be published in the Gazette; and  (b) give a copy of the assessment to each of the persons referred to in subsections 20U(2), (3) and (4)."@en ;
    cml:integrityHash "00043df13b40485f3c1bb27231bf6ef9ae578c3acfeeb75c53e0ab6f5dcb8778" ;
    cof:pageNumber "85"^^xsd:integer ;
    skos:note "Publish assessment in Gazette and provide to persons referred to in subsections 20U(2), (3) and (4)" ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
