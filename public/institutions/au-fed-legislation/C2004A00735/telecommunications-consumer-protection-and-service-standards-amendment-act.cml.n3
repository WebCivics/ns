concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-8e a cml:Concept ;
    skos:prefLabel "8E Meaning of alternative telecommunications services, or ATS"@en ;
    cml:realizedBy doc:sch-1-sec-8e ;
    values:originalText "For the purposes of this Part, alternative telecommunications services, or ATS, are services the supply of which by a particular universal service provider the ACA authorises for the purposes of this section." ;
    skos:definition "For the purposes of this Part, alternative telecommunications services, or ATS, are services the supply of which by a particular universal service provider the ACA authorises for the purposes of this section."@en ;
