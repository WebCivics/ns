concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2 a cml:Concept ;
    skos:prefLabel "2 Levy distribution for 1998-1999 financial year"@en ;
    cml:realizedBy doc:sch-4-sec-2 ;
    values:originalText "Items 3 to 6 of this Schedule apply if section 215 of the former law prevents a payment being made out of the Universal Service Account for the 1998-1999 financial year because of either or both of the following:  (a) the ACA has not yet made a written assessment under section 193 of the former law for that year;  (b) not all participating carriers in respect of which levy was assessed have paid the levy. Note: The operation of the former law for the 1998-1999 financial year is preserved by item 23 of Schedule 4 to the Telecommunications Legislation Amendment Act 1999." ;
    skos:definition "Items 3 to 6 of this Schedule apply if section 215 of the former law prevents a payment being made out of the Universal Service Account for the 1998-1999 financial year because of either or both of the following:  (a) the ACA has not yet made a written assessment under section 193 of the former law for that year;  (b) not all participating carriers in respect of which levy was assessed have paid the levy. Note: The operation of the former law for the 1998-1999 financial year is preserved by item 23 of Schedule 4 to the Telecommunications Legislation Amendment Act 1999."@en ;
    cml:integrityHash "132c32bbe76d652eeb261649f18771825199db02c9145b38fb8cc7100db2babc" ;
    cof:pageNumber "112"^^xsd:integer ;
    skos:note "Payment of levy for 1998-1999 financial year if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
