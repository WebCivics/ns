doc:sch-1-sec-15a-ss-1 a cof:Section ;
    cof:title "15A(1) Effect of digital data service provider determination" ;
    values:kind "subsection" ;
    values:originalText "(1) A digital data service provider in relation to a particular service area is a digital data service provider:  (a) for that area; and  (b) for each service area that is within that area." ;
    cof:pageNumber "59"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15a-ss-2 a cml:Concept ;
