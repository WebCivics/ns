concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-5 a cml:Concept ;
    skos:prefLabel "5 Distributions before all levies have been paid"@en ;
    cml:realizedBy doc:sch-5-sec-5 ;
    values:originalText "Despite paragraph 86(b) of the former law, an amount is payable from the Universal Service Account for the 1999-2000 financial year even if all of the participating carriers in respect of which the levy was assessed have not yet paid the levy." ;
    skos:definition "Despite paragraph 86(b) of the former law, an amount is payable from the Universal Service Account for the 1999-2000 financial year even if all of the participating carriers in respect of which the levy was assessed have not yet paid the levy."@en ;
    cml:integrityHash "7fa4961c60cab5e2db3fd7387504a4d014a4a3dfe73b568d0cb8296fcf532559" ;
    cof:pageNumber "116"^^xsd:integer ;
    skos:note "Payable despite non-payment by carriers" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
