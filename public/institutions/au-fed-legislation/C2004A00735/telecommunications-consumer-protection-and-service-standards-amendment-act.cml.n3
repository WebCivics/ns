concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22-2 a cml:Concept ;
    skos:prefLabel "22 Public may request information"@en ;
    cml:realizedBy doc:sch-1-sec-22-2 ;
    values:originalText "(1) A person may request the ACA to make available to the person:  (a) specified information or documents on the basis of which the ACA may make, or has made, its assessment under section 20U for a claim period; or  (b) specified information about how the ACA may work out, or has worked out, the matters that such an assessment will set out, or sets out, because of subsection 20U(2), (3) or (4).  (2) The ACA must comply with a request as provided in section 22B. This subsection has effect subject to subsection (3).  (3) The ACA must not make available under this section:  (a) information (other than information prescribed for the purposes of this paragraph):  (i) that was obtained from, or relates to, a universal service provider, or a digital data service provider, for a claim period; and  Schedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999" ;
    skos:definition "(1) A person may request the ACA to make available to the person:  (a) specified information or documents on the basis of which the ACA may make, or has made, its assessment under section 20U for a claim period; or  (b) specified information about how the ACA may work out, or has worked out, the matters that such an assessment will set out, or sets out, because of subsection 20U(2), (3) or (4).  (2) The ACA must comply with a request as provided in section 22B. This subsection has effect subject to subsection (3).  (3) The ACA must not make available under this section:  (a) information (other than information prescribed for the purposes of this paragraph):  (i) that was obtained from, or relates to, a universal service provider, or a digital data service provider, for a claim period; and  Schedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999"@en ;
    cml:integrityHash "9bad473d5a96d89bdf045266e4eb037de658e96a29b0b09df6f18bb89c065958" ;
    cof:pageNumber "91"^^xsd:integer ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22-2-ss-1 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22-2-ss-2 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22-2-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.91" .
doc:sch-1-sec-22-2 a cof:Section ;
    cof:title "22 Public may request information" ;
    values:kind "section" ;
    values:originalText "(1) A person may request the ACA to make available to the person:  (a) specified information or documents on the basis of which the ACA may make, or has made, its assessment under section 20U for a claim period; or  (b) specified information about how the ACA may work out, or has worked out, the matters that such an assessment will set out, or sets out, because of subsection 20U(2), (3) or (4).  (2) The ACA must comply with a request as provided in section 22B. This subsection has effect subject to subsection (3).  (3) The ACA must not make available under this section:  (a) information (other than information prescribed for the purposes of this paragraph):  (i) that was obtained from, or relates to, a universal service provider, or a digital data service provider, for a claim period; and  Schedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999" ;
    cof:pageNumber "91"^^xsd:integer .

