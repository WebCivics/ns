concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-6a a cml:Concept ;
    skos:prefLabel "6A ACA advice under section 16A"@en ;
    cml:realizedBy doc:sch-2-sec-6a ;
    values:originalText "If, before 31 December 2000, the ACA has given an advice relating to universal service subsidies to the Minister, the advice is taken to have been given to the Minister in accordance with section 16A." ;
    skos:definition "If, before 31 December 2000, the ACA has given an advice relating to universal service subsidies to the Minister, the advice is taken to have been given to the Minister in accordance with section 16A."@en ;
