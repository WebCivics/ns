concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-7 a cml:Concept ;
    skos:prefLabel "7 Meaning of eligible person"@en ;
    cml:realizedBy doc:sch-2-sec-7 ;
    values:originalText "After Schedule 1 to this Act commences, each of the following persons, in relation to a financial year that ended on or before 30 June 2000, is taken to be an eligible person for the purposes of section 22A of the Telecommunications (Consumer Protection and Service Standards) Act 1999:  (a) a universal service provider;  (b) a digital data service provider;  (c) a participating carrier. Note: Section 22A of that Act deals with requests for information.  Schedule 2  Application and transitional provisions" ;
    skos:definition "After Schedule 1 to this Act commences, each of the following persons, in relation to a financial year that ended on or before 30 June 2000, is taken to be an eligible person for the purposes of section 22A of the Telecommunications (Consumer Protection and Service Standards) Act 1999:  (a) a universal service provider;  (b) a digital data service provider;  (c) a participating carrier. Note: Section 22A of that Act deals with requests for information.  Schedule 2  Application and transitional provisions"@en ;
    cml:integrityHash "ea3420df5067fe8ed0e408dab2781429cc891963b440f6eff18b9dac4826ccfa" ;
    cof:pageNumber "101"^^xsd:integer ;
    skos:note "Definition of eligible person for section 22A of the Telecommunications (Consumer Protection and Service Standards) Act 1999" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
