concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15n a cml:Concept ;
    skos:prefLabel "15N Minister may direct variation or replacement of plan"@en ;
    cml:realizedBy doc:sch-1-sec-15n ;
    values:originalText "(1) This section applies if an approved digital data service plan (the current plan) for an area is in force.  (2) The Minister may give the digital data service provider concerned a written notice requiring the provider:  (a) within the period and in the terms set out in the notice, to give the Minister a draft variation of the current plan; or  (b) within the period and in the terms set out in the notice, to give the Minister a fresh draft digital data service plan for the area that is expressed to replace the current plan.  (3) The provider must comply with the notice." ;
    skos:definition "(1) This section applies if an approved digital data service plan (the current plan) for an area is in force.  (2) The Minister may give the digital data service provider concerned a written notice requiring the provider:  (a) within the period and in the terms set out in the notice, to give the Minister a draft variation of the current plan; or  (b) within the period and in the terms set out in the notice, to give the Minister a fresh draft digital data service plan for the area that is expressed to replace the current plan.  (3) The provider must comply with the notice."@en ;
    cml:integrityHash "92373b5ee917e3182d7376daecfcbe7e15dd01a0b1691775f7e0f96846ad143a" ;
    cof:pageNumber "66"^^xsd:integer ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15n-ss-1 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15n-ss-2 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15n-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.66" .
