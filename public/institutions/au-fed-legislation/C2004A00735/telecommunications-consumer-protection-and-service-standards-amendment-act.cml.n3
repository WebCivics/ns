concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9-ss-6 a cml:Concept ;
    skos:prefLabel "9(6) Universal service obligation"@en ;
    cml:realizedBy doc:sch-1-sec-9-ss-6 ;
    values:originalText "(6) To avoid doubt, an obligation arising under paragraph (2)(a) in relation to customer equipment requires the customer concerned to be given the option of hiring the equipment." ;
