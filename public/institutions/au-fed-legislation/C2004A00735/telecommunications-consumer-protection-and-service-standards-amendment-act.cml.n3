concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20s a cml:Concept ;
    skos:prefLabel "20S Levy debit balance"@en ;
    cml:realizedBy doc:sch-1-sec-20s ;
    values:originalText "If a person’s levy debit (if any) under section 20R for a claim period exceeds the person’s assessed levy credit (if any) under section 20N for the claim period, then:  (a) the person has a levy debit balance for the period; and  Schedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999" ;
    skos:definition "If a person’s levy debit (if any) under section 20R for a claim period exceeds the person’s assessed levy credit (if any) under section 20N for the claim period, then:  (a) the person has a levy debit balance for the period; and  Schedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999"@en ;
    cml:integrityHash "b5f0caed4f38bb7e628e5eb14909311bb1c584d7345abb5540755c41dc0e7d16" ;
    cof:pageNumber "83"^^xsd:integer ;
    skos:note "If levy debit exceeds assessed levy credit, person has a levy debit balance." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
