concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20m a cml:Concept ;
    skos:prefLabel "20M ACA may inquire into correctness of claim"@en ;
    cml:realizedBy doc:sch-1-sec-20m ;
    values:originalText "The ACA may make whatever inquiries it thinks necessary or desirable in order to determine:  (a) whether or not a claim by a universal service provider for a levy credit for a claim period correctly states the provider’s entitlement to universal service subsidy for the period; or  (b) whether or not a claim by a digital data service provider for a levy credit for a claim period correctly states the amount of the digital data cost of the provider for the period." ;
    skos:definition "The ACA may make whatever inquiries it thinks necessary or desirable in order to determine:  (a) whether or not a claim by a universal service provider for a levy credit for a claim period correctly states the provider’s entitlement to universal service subsidy for the period; or  (b) whether or not a claim by a digital data service provider for a levy credit for a claim period correctly states the amount of the digital data cost of the provider for the period."@en ;
    cml:integrityHash "0a666bd8059f393cc44e1ec6f59884bd645c69a755af119f092e6b877acde81f" ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "May make inquiries into claim correctness" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
