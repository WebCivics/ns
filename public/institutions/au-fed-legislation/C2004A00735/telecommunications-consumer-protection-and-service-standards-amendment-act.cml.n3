    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy definition" ;
    cml:premiseText "alternative telecommunications services, or ATS, in Part 2 has the meaning given by section 8E." ;
