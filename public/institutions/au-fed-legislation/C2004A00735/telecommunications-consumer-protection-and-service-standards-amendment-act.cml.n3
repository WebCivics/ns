doc:sch-1-sec-19b-ss-1 a cof:Section ;
    cof:title "19B(1) Price control determinations" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if a determination is in force under section 19A in relation to a particular digital data service charge." ;
