doc:sch-1-sec-20w-ss-1 a cof:Section ;
    cof:title "20W(1) Variation of assessments" ;
    values:kind "subsection" ;
    values:originalText "(1) The ACA may vary an assessment made under this Part by making such alterations and additions as it thinks necessary, even if levy credits or levy has been paid in respect of an assessment." ;
    cof:pageNumber "85"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20w-ss-2 a cml:Concept ;
    skos:prefLabel "20W(2) Variation of assessments"@en ;
    cml:realizedBy doc:sch-1-sec-20w-ss-2 ;
    values:originalText "(2) Unless the contrary intention appears, an amended assessment is taken, for the purposes of this Part, to be an assessment under section 20F, 20N or 20U (as the case may be)." ;
