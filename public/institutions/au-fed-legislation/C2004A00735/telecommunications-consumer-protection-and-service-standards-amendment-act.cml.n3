    cml:conclusionText "the assessment was made before the commencement of Schedule 1 to the Telecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-101c cml:asserts concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-101c-logic-deontic-6 .
