doc:sch-1-sec-12ea-ss-2 a cof:Section ;
    cof:title "12EA(2) Exclusive access to universal service subsidy" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) applies while the agreement referred to in subsection 12E(2) remains in force in relation to that area but no longer than 3 years after the commencement date for the area." ;
