concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-13v-ss-4 a cml:Concept ;
    skos:prefLabel "13V(4) Minister may revoke approved ATS marketing plan"@en ;
    cml:realizedBy doc:sch-1-sec-13v-ss-4 ;
