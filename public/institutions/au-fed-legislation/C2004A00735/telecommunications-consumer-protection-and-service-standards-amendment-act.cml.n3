doc:sch-1-sec-12x-ss-2 a cof:Section ;
    cof:title "12X(2) Notice of decision" ;
    values:kind "subsection" ;
    values:originalText "(2) If the ACA refuses to approve the variation, the ACA must give a written notice setting out the reasons for the refusal to the provider." ;
    cof:pageNumber "42"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12x-ss-3 a cml:Concept ;
    skos:prefLabel "12X(3) Notice of decision"@en ;
    cml:realizedBy doc:sch-1-sec-12x-ss-3 ;
    values:originalText "(3) If the ACA approves the variation:  (a) the current statement or plan is varied accordingly; and  (b) a copy of the notice given to the provider must be published in the Gazette, unless the variation is only of a minor technical nature." ;
    skos:definition "(3) If the ACA approves the variation:  (a) the current statement or plan is varied accordingly; and  (b) a copy of the notice given to the provider must be published in the Gazette, unless the variation is only of a minor technical nature."@en ;
