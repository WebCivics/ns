doc:sch-1-sec-22b-ss-1 a cof:Section ;
    cof:title "22B(1) How the ACA is to comply with a request" ;
    values:kind "subsection" ;
    values:originalText "(1) The ACA may comply with a request by a person under section 22 or 22A by:  (a) communicating information to the person in writing or in some other form; or  (b) making documents available for inspection by the person or by an employee, agent or professional adviser of the person; or  (c) giving to the person copies of, extracts from, or summaries of, documents." ;
    cof:pageNumber "94"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22b-ss-2 a cml:Concept ;
