    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12u-ss-2 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12u-ss-3 ;
