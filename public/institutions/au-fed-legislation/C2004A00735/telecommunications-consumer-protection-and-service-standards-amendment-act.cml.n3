    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-101a-ss-7 ;
    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-101a-ss-8 ;
