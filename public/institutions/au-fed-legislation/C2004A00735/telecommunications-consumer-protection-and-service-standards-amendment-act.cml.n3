concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21a a cml:Concept ;
    skos:prefLabel "21A Credits to Universal Service Account"@en ;
    cml:realizedBy doc:sch-1-sec-21a ;
    values:originalText "There must be credited to the Universal Service Account:  (a) amounts equal to amounts of levy paid from time to time under this Part; and  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999  Schedule 1  Telecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000 No. 142, 2000            85  (b) all money appropriated by law for the purposes of the Universal Service Account; and  (c) amounts equal to amounts that were overpaid under section 21C and have been recovered; and  (d) amounts equal to amounts of penalty paid from time to time under section 23D." ;
    skos:definition "There must be credited to the Universal Service Account:  (a) amounts equal to amounts of levy paid from time to time under this Part; and  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999  Schedule 1  Telecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000 No. 142, 2000            85  (b) all money appropriated by law for the purposes of the Universal Service Account; and  (c) amounts equal to amounts that were overpaid under section 21C and have been recovered; and  (d) amounts equal to amounts of penalty paid from time to time under section 23D."@en ;
    cml:integrityHash "21a0e0252c5a657391f380f18e611745a858799caae7d01a89e4f3a23dcdb297" ;
    cof:pageNumber "88"^^xsd:integer ;
    skos:note "Must credit amounts to Universal Service Account" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.88" ;
    cml:asserts concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21a-norm .
