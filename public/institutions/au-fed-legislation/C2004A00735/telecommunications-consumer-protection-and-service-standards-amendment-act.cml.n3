    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Obligation" ;
    cml:premiseText "most recent levy assessment means the assessment most recently made by the ACA under one of the following sections:" ;
    cml:conclusionText "the assessment must be made by the ACA under one of the following sections" ;
