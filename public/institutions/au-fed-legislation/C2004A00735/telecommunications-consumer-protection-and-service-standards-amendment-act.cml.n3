concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19b-ss-2 a cml:Concept ;
    skos:prefLabel "19B(2) Price control determinations"@en ;
    cml:realizedBy doc:sch-1-sec-19b-ss-2 ;
    values:originalText "(2) The Minister may make a written determination setting out:  (a) price-cap arrangements and other price control arrangements that are to apply in relation to the charge; or  (b) principles or rules in accordance with which the digital data service provider may impose or alter the charge; or both." ;
    skos:definition "(2) The Minister may make a written determination setting out:  (a) price-cap arrangements and other price control arrangements that are to apply in relation to the charge; or  (b) principles or rules in accordance with which the digital data service provider may impose or alter the charge; or both."@en ;
    cml:integrityHash "968527beaccc5ab4e6717ac7c2f70ea90ec4d4cd40ff5d99deeeace311469f92" ;
    values:partOf concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19b ;
    cof:pageNumber "73"^^xsd:integer ;
    skos:note "The Minister may make a written determination setting out price-cap arrangements and principles or rules for imposing the charge." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
