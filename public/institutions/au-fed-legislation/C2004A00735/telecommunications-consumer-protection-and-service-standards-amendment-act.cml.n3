doc:sch-1-sec-9-ss-4 a cof:Section ;
    cof:title "9(4) Universal service obligation" ;
    values:kind "subsection" ;
    values:originalText "(4) An obligation does not arise under paragraph (2)(a) in relation to particular equipment, goods or services the supply of which is treated under section 9E as the supply of a standard telephone service if the customer concerned requests not to be supplied with the equipment, goods or services." ;
    cof:pageNumber "11"^^xsd:integer .

