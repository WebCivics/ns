doc:sch-1-sec-15d a cof:Section ;
    cof:title "15D Digital data service plans" ;
    values:kind "section" ;
    values:originalText "A draft or approved digital data service plan for an area is a plan that sets out how a digital data service provider for that area will progressively fulfil:  (a) if that area is a general digital data service area—the general digital data service obligation (in so far as the obligation relates to that area); or  (b) if that area is a special digital data service area—the special digital data service obligation (in so far as the obligation relates to that area). Note: An approved digital data service plan is a draft digital data service plan that has been approved by the Minister.  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999  Schedule 1  Telecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000 No. 142, 2000            59" ;
    cof:pageNumber "62"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15e a cml:Concept ;
    skos:prefLabel "15E Replacement of approved digital data service plan"@en ;
    cml:realizedBy doc:sch-1-sec-15e ;
    values:originalText "If an approved digital data service plan (the original plan) for an area is in force, a draft digital data service plan for the area may be expressed to replace the original plan. When the draft plan becomes an approved digital data service plan, the original plan ceases to be in force." ;
    skos:definition "If an approved digital data service plan (the original plan) for an area is in force, a draft digital data service plan for the area may be expressed to replace the original plan. When the draft plan becomes an approved digital data service plan, the original plan ceases to be in force."@en ;
    cml:integrityHash "10f9a9dbb15c9907e5d87ae8ba0a866c8031abef73d4d6cdf241272b79bdc37f" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Replacement of approved digital data service plan" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.63" ;
