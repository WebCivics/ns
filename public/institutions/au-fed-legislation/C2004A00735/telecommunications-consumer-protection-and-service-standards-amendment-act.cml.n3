concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-104 a cml:Concept ;
    skos:prefLabel "104 Telecommunications (Consumer Protection and Service Standards) Amendment Act"@en ;
    cml:realizedBy doc:sch-3-sec-104 ;
    values:originalText "(No. 2) 2000       No. 142, 2000  (a) is a participating person for the last eligible revenue period that ends before the start of the quarter; and  (b) is covered by the most recent levy assessment made before the start of the quarter. Note: The most recent levy assessment is defined in section 101C." ;
    skos:definition "(No. 2) 2000       No. 142, 2000  (a) is a participating person for the last eligible revenue period that ends before the start of the quarter; and  (b) is covered by the most recent levy assessment made before the start of the quarter. Note: The most recent levy assessment is defined in section 101C."@en ;
    cml:integrityHash "4c68b95a6cb8e0c00f7f62f053ffbfd43bbe71188ea11fc68a8d56921e72bae2" ;
    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Must be a participating person for the last eligible revenue period and covered by the most recent levy assessment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.108" ;
    cml:asserts concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-104-norm .
