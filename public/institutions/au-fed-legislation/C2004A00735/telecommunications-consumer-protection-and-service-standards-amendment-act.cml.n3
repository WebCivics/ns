concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-1 a cml:Concept ;
    skos:prefLabel "1 Application of repealed Part 2"@en ;
    cml:realizedBy doc:sch-2-sec-1 ;
    values:originalText "Despite the repeal and substitution of Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999 by Schedule 1 to this Act, that Part continues to apply, after that Schedule commences in relation to the financial year that ended on 30 June 2000, as if that repeal and substitution had not happened." ;
    skos:definition "Despite the repeal and substitution of Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999 by Schedule 1 to this Act, that Part continues to apply, after that Schedule commences in relation to the financial year that ended on 30 June 2000, as if that repeal and substitution had not happened."@en ;
    cml:integrityHash "1d941d177b268158ba641d53e12711eb334e0d67be5e2c7a94ed42efc9057ab8" ;
    cof:pageNumber "98"^^xsd:integer ;
    skos:note "Continuation of repealed Part 2 despite repeal and substitution" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.98" ;
    cml:asserts concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-1-norm .
