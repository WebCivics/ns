doc:sch-1-sec-12r-ss-1 a cof:Section ;
    cof:title "12R(1) Primary universal service provider may submit a draft ATS" ;
    values:kind "subsection" ;
    values:originalText "(1) A primary universal service provider for a universal service obligation in respect of a service obligation, who wishes to supply alternative telecommunications services in fulfilment of that service obligation so far as it relates to that area, may give to the ACA a draft ATS marketing plan covering the supply of those services." ;
    cof:pageNumber "38"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12r-ss-2 a cml:Concept ;
    skos:prefLabel "12R(2) Primary universal service provider may submit a draft ATS"@en ;
    cml:realizedBy doc:sch-1-sec-12r-ss-2 ;
    values:originalText "(2) To avoid doubt, the primary universal service provider is still required to fulfil that service obligation so far as it relates to that area in accordance with section 9." ;
    skos:definition "(2) To avoid doubt, the primary universal service provider is still required to fulfil that service obligation so far as it relates to that area in accordance with section 9."@en ;
    cml:integrityHash "0c83900004492de9581e27b129fcb73eecd5716fd0396f4a40a6e9116a3e085f" ;
    values:partOf concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12r ;
    cof:pageNumber "38"^^xsd:integer ;
    skos:note "Primary universal service provider must fulfill service obligation in that area." ;
    dc:description "true" ;
