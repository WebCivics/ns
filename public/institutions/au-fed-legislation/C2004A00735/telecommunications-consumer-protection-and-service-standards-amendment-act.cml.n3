doc:sch-1-sec-21-ss-4 a cof:Section ;
    cof:title "21(4) Universal Service Account" ;
    values:kind "subsection" ;
    values:originalText "(4) If there is a change to who is to administer the Universal Service Account in accordance with subsection (3), the Minister may determine in writing arrangements to deal with any issues of a transitional nature that may arise as a result of the change." ;
    cof:pageNumber "88"^^xsd:integer .

