concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20j a cml:Concept ;
    skos:prefLabel "20J Claims for levy credit"@en ;
    cml:realizedBy doc:sch-1-sec-20j ;
    values:originalText "(1) Within the period of 45 days after the end of a claim period, or such other period as is determined in writing by the Minister, a carrier or carriage service provider who is a:  (a) universal service provider; or  (b) a digital data service provider;  Schedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999" ;
    skos:definition "(1) Within the period of 45 days after the end of a claim period, or such other period as is determined in writing by the Minister, a carrier or carriage service provider who is a:  (a) universal service provider; or  (b) a digital data service provider;  Schedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999"@en ;
    cml:integrityHash "c3e2a4e866883318adb3395b42a58ab5de6b1847891a19fc5054d0a068d823c4" ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Carrier or carriage service provider must claim levy credit within 45 days after the end of a claim period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
