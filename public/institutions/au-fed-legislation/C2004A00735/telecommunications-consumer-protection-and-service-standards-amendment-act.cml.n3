concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-64 a cml:Concept ;
    skos:prefLabel "64 Telecommunications (Consumer Protection and Service Standards) Amendment Act"@en ;
    cml:realizedBy doc:sch-1-sec-64 ;
    values:originalText "(No. 2) 2000       No. 142, 2000  (b) is laid before each House of the Parliament within 5 sitting days of that House after making the determination or variation.  (4) Subsection (1) does not, by implication, limit the Minister’s powers under section 486 of the Telecommunications Act 1997 (which deals with public inquiries)." ;
    skos:definition "(No. 2) 2000       No. 142, 2000  (b) is laid before each House of the Parliament within 5 sitting days of that House after making the determination or variation.  (4) Subsection (1) does not, by implication, limit the Minister’s powers under section 486 of the Telecommunications Act 1997 (which deals with public inquiries)."@en ;
    cml:integrityHash "c1c6acf23ed59f91a4b432656f2c40c6942fd3c562bab3fb134bbfb5acea8828" ;
    cof:pageNumber "68"^^xsd:integer ;
    skos:note "Lay before each House of Parliament within 5 sitting days after making determination or variation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
