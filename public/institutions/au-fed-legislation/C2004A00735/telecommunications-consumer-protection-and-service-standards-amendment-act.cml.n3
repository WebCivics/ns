doc:sch-1-sec-11d-ss-2 a cof:Section ;
    cof:title "11D(2) Effect of determination" ;
    values:kind "subsection" ;
    values:originalText "(2) If a determination under section 11C is expressed to cease to have effect at a specified time, the determination ceases to have effect at that time." ;
    cof:pageNumber "26"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11d-ss-3 a cml:Concept ;
    skos:prefLabel "11D(3) Effect of determination"@en ;
    cml:realizedBy doc:sch-1-sec-11d-ss-3 ;
    values:originalText "(3) A variation or revocation of a determination under section 11C takes effect on the day specified for the purpose in the instrument of variation or revocation. That day must not be before the day on which notice of the instrument is published in the Gazette." ;
