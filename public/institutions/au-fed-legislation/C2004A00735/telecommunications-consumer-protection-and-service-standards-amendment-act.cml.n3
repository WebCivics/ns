doc:sch-1-sec-13b-ss-3 a cof:Section ;
    cof:title "13B(3) Approval of person as a competing universal service provider" ;
    values:kind "subsection" ;
    values:originalText "(3) If the applicant is already a competing universal service provider for a universal service area in respect of another contestable service obligation, the ACA may, but is not required to, assume that paragraph (2)(a) is satisfied." ;
    cof:pageNumber "44"^^xsd:integer .

