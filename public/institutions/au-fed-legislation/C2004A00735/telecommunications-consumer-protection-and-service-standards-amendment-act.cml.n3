doc:sch-1-sec-15g-ss-1 a cof:Section ;
    cof:title "15G(1) Public consultation—draft plan" ;
    values:kind "subsection" ;
    values:originalText "(1) Before giving the Minister a draft digital data service plan under section 15F, a digital data service provider must:  (a) publish a preliminary version of the draft plan and invite members of the public to make submissions to the provider about the preliminary version within a specified period; and  (b) give consideration to any submissions received from members of the public within that period." ;
    cof:pageNumber "63"^^xsd:integer .

