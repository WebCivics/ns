doc:sch-1-sec-20f-ss-1 a cof:Section ;
    cof:title "20F(1) ACA to assess eligible revenue" ;
    values:kind "subsection" ;
    values:originalText "(1) The ACA must make a written assessment of each participating person’s eligible revenue for an eligible revenue period. Note: The assessment may be included in the same document as any other assessment the ACA makes under this Part (see section 20Y)." ;
    cof:pageNumber "78"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20f-ss-2 a cml:Concept ;
    skos:prefLabel "20F(2) ACA to assess eligible revenue"@en ;
    cml:realizedBy doc:sch-1-sec-20f-ss-2 ;
    values:originalText "(2) A person’s eligible revenue:  (a) must be assessed as zero if the person’s eligible revenue is less than the amount (the threshold amount) determined in writing by the Minister for the purposes of this subsection; or  (b) in any other case—must be reduced by the threshold amount." ;
    skos:definition "(2) A person’s eligible revenue:  (a) must be assessed as zero if the person’s eligible revenue is less than the amount (the threshold amount) determined in writing by the Minister for the purposes of this subsection; or  (b) in any other case—must be reduced by the threshold amount."@en ;
    cml:integrityHash "473ec95bc60c3673294b6650bc13d363f4636d691fcba5ce8be028523c76986c" ;
    values:partOf concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20f ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Assess eligible revenue as zero if below threshold amount" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
