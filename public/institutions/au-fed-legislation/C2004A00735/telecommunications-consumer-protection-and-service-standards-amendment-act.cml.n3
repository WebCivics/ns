doc:sch-1-sec-12z-ss-1 a cof:Section ;
    cof:title "12Z(1) Minister may revoke approved ATS marketing plan" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister may, by giving written notice to a primary universal service provider, revoke the provider’s approved ATS marketing plan if the Minister considers that it is in the public interest to do so. A copy of the notice must be given to the ACA." ;
    cof:pageNumber "43"^^xsd:integer .

