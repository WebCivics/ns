concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-24 a cml:Concept ;
    skos:prefLabel "24 Telecommunications (Consumer Protection and Service Standards) Amendment Act"@en ;
    cml:realizedBy doc:sch-1-sec-24 ;
    values:originalText "(No. 2) 2000       No. 142, 2000 Note: These apply to each universal service area except to the extent that a determination of alternative arrangements modifies the way they apply, or excludes them from applying, to the area (see subsection 11(4)). Subdivision B—Primary universal service providers" ;
    skos:definition "(No. 2) 2000       No. 142, 2000 Note: These apply to each universal service area except to the extent that a determination of alternative arrangements modifies the way they apply, or excludes them from applying, to the area (see subsection 11(4)). Subdivision B—Primary universal service providers"@en ;
    cml:integrityHash "b8ea3e580f4bea85f57ea7c2e8636b8e98d2c1578b8f8a724cd93eae7fdcd0c7" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Applicable to each universal service area except to the extent that a determination of alternative arrangements modifies the way they apply, or excludes them from applying." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.28" ;
