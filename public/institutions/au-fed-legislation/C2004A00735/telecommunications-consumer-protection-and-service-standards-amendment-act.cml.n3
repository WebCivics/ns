    cml:hasPart concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
    dc:source "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.95" .
