concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-2 a cml:Concept ;
    skos:prefLabel "2 Levy distribution for 1999-2000 financial year"@en ;
    cml:realizedBy doc:sch-5-sec-2 ;
    values:originalText "Items 3 to 6 of this Schedule apply if section 86 of the former law prevents a payment being made out of the Universal Service Account for the 1999-2000 financial year because of either or both of the following:  (a) the ACA has not yet made a written assessment under section 64 of the former law for that year;  (b) not all participating carriers in respect of which levy was assessed have paid the levy. Note: The operation of the former law for the 1999-2000 financial year is preserved by item 1 of Schedule 2 to this Act." ;
    skos:definition "Items 3 to 6 of this Schedule apply if section 86 of the former law prevents a payment being made out of the Universal Service Account for the 1999-2000 financial year because of either or both of the following:  (a) the ACA has not yet made a written assessment under section 64 of the former law for that year;  (b) not all participating carriers in respect of which levy was assessed have paid the levy. Note: The operation of the former law for the 1999-2000 financial year is preserved by item 1 of Schedule 2 to this Act."@en ;
    cml:integrityHash "8a01b4dd7c8e1f185a4392cd0d5e7276262f4b6b0e53e4d35e2d16d12612f3ae" ;
    cof:pageNumber "115"^^xsd:integer ;
    skos:note "Payment of levy if ACA assessment not made or carriers pay levy" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-consumer-protection-and-service-standards-amendment-act.pdf> ;
