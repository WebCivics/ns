concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sec-2 a cml:Concept ;
    skos:prefLabel "2 Commencement"@en ;
    cml:realizedBy doc:sec-2 ;
    values:originalText "(1) Subject to this section, this Act commences on the day on which it receives the Royal Assent.  (2) Schedules 1 to 3 (other than items 10, 11 and 13 of Schedule 3) commence, or are taken to have commenced, on 1 July 2000.  (3) Items 10, 11 and 13 of Schedule 3 commence on the first 1 January, 1 April, 1 July or 1 October following the day on which this Act receives the Royal Assent." ;
    skos:definition "(1) Subject to this section, this Act commences on the day on which it receives the Royal Assent.  (2) Schedules 1 to 3 (other than items 10, 11 and 13 of Schedule 3) commence, or are taken to have commenced, on 1 July 2000.  (3) Items 10, 11 and 13 of Schedule 3 commence on the first 1 January, 1 April, 1 July or 1 October following the day on which this Act receives the Royal Assent."@en ;
    cml:integrityHash "b7aee70e1ab49fff68457cf2e83f76fa9d746f4944607d4db0345c23a0972475" ;
    cof:pageNumber "6"^^xsd:integer ;
