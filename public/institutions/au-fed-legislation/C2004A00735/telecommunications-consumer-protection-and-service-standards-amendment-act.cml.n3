doc:sch-1-sec-23d-ss-7 a cof:Section ;
    cof:title "23D(7) Penalty for late payment of levy" ;
    values:kind "subsection" ;
    values:originalText "(7) As soon as practicable after a person fails to pay an amount of levy by the time by which it must be paid, the ACA must, in writing, notify the person that the person is liable to a penalty under this section. However, a failure to do so does not affect the person’s liability." ;
    cof:pageNumber "97"^^xsd:integer .

concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23d-ss-8 a cml:Concept ;
