      "@type": "cml:Concept",
      "skos:prefLabel": "112 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-5-sec-112"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
