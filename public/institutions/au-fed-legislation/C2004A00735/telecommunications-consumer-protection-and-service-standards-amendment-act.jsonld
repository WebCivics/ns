      "@type": "cml:Concept",
      "skos:prefLabel": "15N(2) Minister may direct variation or replacement of plan",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15n-ss-2"
