    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20w",
      "@type": "cml:Concept",
      "skos:prefLabel": "20W Variation of assessments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.85",
      "values:originalText": "(1) The ACA may vary an assessment made under this Part by making\nsuch alterations and additions as it thinks necessary, even if levy\ncredits or levy has been paid in respect of an assessment.\n\n(2) Unless the contrary intention appears, an amended assessment is\ntaken, for the purposes of this Part, to be an assessment under\nsection 20F, 20N or 20U (as the case may be).",
      "skos:definition": "(1) The ACA may vary an assessment made under this Part by making\nsuch alterations and additions as it thinks necessary, even if levy\ncredits or levy has been paid in respect of an assessment.\n\n(2) Unless the contrary intention appears, an amended assessment is\ntaken, for the purposes of this Part, to be an assessment under\nsection 20F, 20N or 20U (as the case may be).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20w-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20w-ss-2"
        }
      ],
      "cml:integrityHash": "0da8368179af36ad0bec7adc333d7c271958beb781db0cac247d9c2a02cbf7ef"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20w",
      "@type": "cof:Section",
      "cof:title": "20W Variation of assessments",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "(1) The ACA may vary an assessment made under this Part by making\nsuch alterations and additions as it thinks necessary, even if levy\ncredits or levy has been paid in respect of an assessment.\n\n(2) Unless the contrary intention appears, an amended assessment is\ntaken, for the purposes of this Part, to be an assessment under\nsection 20F, 20N or 20U (as the case may be)."
    },
