      ],
      "cml:integrityHash": "b51fa9b6d07fe3308800b781dd4a3e1e8c49c0ae1cd11901229a8c10fdb38f42",
      "skos:note": "Ensure one primary universal service provider for each service obligation and universal service area.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12a-ss-3",
      "@type": "cof:Section",
      "cof:title": "12A(3) Determination of primary universal service providers",
      "values:kind": "subsection",
      "cof:pageNumber": 28,
      "values:originalText": "(3) In exercising his or her powers under this section, the Minister\nmust ensure that at all times there is one primary universal service\nprovider, in respect of each service obligation, for each universal\nservice area."
    },
