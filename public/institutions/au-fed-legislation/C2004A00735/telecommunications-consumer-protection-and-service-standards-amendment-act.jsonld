      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.58",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\nmodify includes excluding the application of a provision entirely,\nas well as omitting, adding and substituting provisions.",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\nmodify includes excluding the application of a provision entirely,\nas well as omitting, adding and substituting provisions.",
