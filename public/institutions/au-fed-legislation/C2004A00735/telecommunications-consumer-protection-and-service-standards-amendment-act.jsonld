    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21a",
      "@type": "cml:Concept",
      "skos:prefLabel": "21A Credits to Universal Service Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-21a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.88",
      "values:originalText": "There must be credited to the Universal Service Account:\n\n(a) amounts equal to amounts of levy paid from time to time\nunder this Part; and\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            85\n\n(b) all money appropriated by law for the purposes of the\nUniversal Service Account; and\n\n(c) amounts equal to amounts that were overpaid under\nsection 21C and have been recovered; and\n\n(d) amounts equal to amounts of penalty paid from time to time\nunder section 23D.",
      "skos:definition": "There must be credited to the Universal Service Account:\n\n(a) amounts equal to amounts of levy paid from time to time\nunder this Part; and\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            85\n\n(b) all money appropriated by law for the purposes of the\nUniversal Service Account; and\n\n(c) amounts equal to amounts that were overpaid under\nsection 21C and have been recovered; and\n\n(d) amounts equal to amounts of penalty paid from time to time\nunder section 23D.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21a-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "21a0e0252c5a657391f380f18e611745a858799caae7d01a89e4f3a23dcdb297",
      "skos:note": "Must credit amounts to Universal Service Account",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-21a",
      "@type": "cof:Section",
      "cof:title": "21A Credits to Universal Service Account",
      "values:kind": "section",
      "cof:pageNumber": 88,
      "values:originalText": "There must be credited to the Universal Service Account:\n\n(a) amounts equal to amounts of levy paid from time to time\nunder this Part; and\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            85\n\n(b) all money appropriated by law for the purposes of the\nUniversal Service Account; and\n\n(c) amounts equal to amounts that were overpaid under\nsection 21C and have been recovered; and\n\n(d) amounts equal to amounts of penalty paid from time to time\nunder section 23D."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21a-logic-deontic-1",
      "@type": "cml:LogicApplication",
