    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10b",
      "@type": "cml:Concept",
      "skos:prefLabel": "10B Special digital data service obligation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.18",
      "values:originalText": "(1) For the purposes of this Act, the special digital data service\nobligation is the obligation to ensure that special digital data\nservices are reasonably accessible to all people in special digital\ndata service areas on an equitable basis.\n\n(2) To the extent necessary to achieve the special digital data service\nobligation, it is part of that obligation to supply special digital data\nservices to people in special digital data service areas on request.",
      "skos:definition": "(1) For the purposes of this Act, the special digital data service\nobligation is the obligation to ensure that special digital data\nservices are reasonably accessible to all people in special digital\ndata service areas on an equitable basis.\n\n(2) To the extent necessary to achieve the special digital data service\nobligation, it is part of that obligation to supply special digital data\nservices to people in special digital data service areas on request.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10b-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10b-ss-2"
        }
      ],
      "cml:integrityHash": "24562a56e4ce77ff45ee6601895717e5403b065f03a77897d81f095893b59216"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10b",
      "@type": "cof:Section",
      "cof:title": "10B Special digital data service obligation",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "(1) For the purposes of this Act, the special digital data service\nobligation is the obligation to ensure that special digital data\nservices are reasonably accessible to all people in special digital\ndata service areas on an equitable basis.\n\n(2) To the extent necessary to achieve the special digital data service\nobligation, it is part of that obligation to supply special digital data\nservices to people in special digital data service areas on request."
    },
