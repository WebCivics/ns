      ],
      "cml:integrityHash": "b44e0827d24a846ac16ee2ad26bd66a725efe4e31d78c2c7e0c130fd2124627e",
      "skos:note": "Eligible revenue return must be accompanied by a report of an approved auditor.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20d-ss-1",
      "@type": "cof:Section",
      "cof:title": "20D(1) Audit report of eligible revenue return",
      "values:kind": "subsection",
      "cof:pageNumber": 77,
      "values:originalText": "(1) An eligible revenue return given to the ACA under section 20 must\nbe accompanied by a report of an approved auditor that:\n\n(a) is in a form approved in writing by the ACA; and\n\n(b) states that the auditor has audited the return; and\n\n(c) contains a determination, in the terms specified in the form,\nof the auditor’s opinion; and\n\n(d) states that the auditor has been given sufficient information\nand assistance in order to audit the return; and\n\n(e) includes all other statements and information required by the\nform to be included."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20d-ss-1-norm",
