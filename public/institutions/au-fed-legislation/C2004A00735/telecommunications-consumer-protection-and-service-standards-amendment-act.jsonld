    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21e",
      "@type": "cml:Concept",
      "skos:prefLabel": "21E Recovery of overpayments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-21e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.91",
      "values:originalText": "(1) For the purposes of this section, an overpaid amount is so much of\nan amount paid under section 21C as represents an overpayment.\n\n(2) An overpaid amount is a debt due to the Commonwealth.\n\n(3) An overpaid amount may be recovered by the Commonwealth by\naction in a court of competent jurisdiction.\n\n(4) If a person is liable to pay an overpaid amount, the overpaid\namount may be deducted from one or more other amounts that are\npayable to the person under this Part, and if it is so deducted, the\nother amounts are taken to have been paid in full to the person.",
      "skos:definition": "(1) For the purposes of this section, an overpaid amount is so much of\nan amount paid under section 21C as represents an overpayment.\n\n(2) An overpaid amount is a debt due to the Commonwealth.\n\n(3) An overpaid amount may be recovered by the Commonwealth by\naction in a court of competent jurisdiction.\n\n(4) If a person is liable to pay an overpaid amount, the overpaid\namount may be deducted from one or more other amounts that are\npayable to the person under this Part, and if it is so deducted, the\nother amounts are taken to have been paid in full to the person.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21e-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21e-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21e-ss-3"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21e-ss-4"
        }
      ],
      "cml:integrityHash": "24caf8f52d0b607d0f2874145e751328db36df34275589d822f72f0fdfef1112"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-21e",
      "@type": "cof:Section",
      "cof:title": "21E Recovery of overpayments",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "(1) For the purposes of this section, an overpaid amount is so much of\nan amount paid under section 21C as represents an overpayment.\n\n(2) An overpaid amount is a debt due to the Commonwealth.\n\n(3) An overpaid amount may be recovered by the Commonwealth by\naction in a court of competent jurisdiction.\n\n(4) If a person is liable to pay an overpaid amount, the overpaid\namount may be deducted from one or more other amounts that are\npayable to the person under this Part, and if it is so deducted, the\nother amounts are taken to have been paid in full to the person."
    },
