      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Things done under repealed Part 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.98",
      "values:originalText": "(1)\nIf:\n\n(a) something was done (other than something covered by\nitem 3), before this Act received the Royal Assent, under or\nfor the purposes of a provision of Part 2 of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) immediately after the repeal and substitution of that Part by\nSchedule 1 to this Act, there is a provision in that Part that\nrequires or allows the same, or an equivalent, thing to be\ndone;\nthen, after the commencement of Schedule 1, the thing is taken to have\nbeen done under or for the purposes of the latter provision.\n(2)\nIf the thing would have been done by another person or body, had it\nbeen done after the commencement of Schedule 1, then it is taken to\nhave been done by that other person or body for the purposes of Part 2\nof the Telecommunications (Consumer Protection and Service\nStandards) Act 1999.",
      "skos:definition": "(1)\nIf:\n\n(a) something was done (other than something covered by\nitem 3), before this Act received the Royal Assent, under or\nfor the purposes of a provision of Part 2 of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) immediately after the repeal and substitution of that Part by\nSchedule 1 to this Act, there is a provision in that Part that\nrequires or allows the same, or an equivalent, thing to be\ndone;\nthen, after the commencement of Schedule 1, the thing is taken to have\nbeen done under or for the purposes of the latter provision.\n(2)\nIf the thing would have been done by another person or body, had it\nbeen done after the commencement of Schedule 1, then it is taken to\nhave been done by that other person or body for the purposes of Part 2\nof the Telecommunications (Consumer Protection and Service\nStandards) Act 1999.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a93f28e0296a503e5bf1e2cd8952c07dadbf0cac438f3f098588f8f888586166",
      "skos:note": "If something was done before the Act received Royal Assent, under or for the purposes of a provision of Part 2 of the Telecommunications (Consumer Protection and Service Standards) Act 1999, then it is taken to have been done under or for the purposes of the latter provision."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Things done under repealed Part 2",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "(1)\nIf:\n\n(a) something was done (other than something covered by\nitem 3), before this Act received the Royal Assent, under or\nfor the purposes of a provision of Part 2 of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999; and\n\n(b) immediately after the repeal and substitution of that Part by\nSchedule 1 to this Act, there is a provision in that Part that\nrequires or allows the same, or an equivalent, thing to be\ndone;\nthen, after the commencement of Schedule 1, the thing is taken to have\nbeen done under or for the purposes of the latter provision.\n(2)\nIf the thing would have been done by another person or body, had it\nbeen done after the commencement of Schedule 1, then it is taken to\nhave been done by that other person or body for the purposes of Part 2\nof the Telecommunications (Consumer Protection and Service\nStandards) Act 1999."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
