    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11d",
      "@type": "cml:Concept",
      "skos:prefLabel": "11D Effect of determination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-11d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.26",
      "values:originalText": "(1) A determination under section 11C takes effect on the day\nspecified in the determination. That day must not be before the day\non which notice of the determination is published in the Gazette.\n\n(2) If a determination under section 11C is expressed to cease to have\neffect at a specified time, the determination ceases to have effect at\nthat time.\n\n(3) A variation or revocation of a determination under section 11C\ntakes effect on the day specified for the purpose in the instrument\nof variation or revocation. That day must not be before the day on\nwhich notice of the instrument is published in the Gazette.",
      "skos:definition": "(1) A determination under section 11C takes effect on the day\nspecified in the determination. That day must not be before the day\non which notice of the determination is published in the Gazette.\n\n(2) If a determination under section 11C is expressed to cease to have\neffect at a specified time, the determination ceases to have effect at\nthat time.\n\n(3) A variation or revocation of a determination under section 11C\ntakes effect on the day specified for the purpose in the instrument\nof variation or revocation. That day must not be before the day on\nwhich notice of the instrument is published in the Gazette.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11d-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11d-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11d-ss-3"
        }
      ],
      "cml:integrityHash": "8a9e6d3addb79af8cf9bceb45de709fa776a54fb3c8231ded33200557741643f"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-11d",
      "@type": "cof:Section",
      "cof:title": "11D Effect of determination",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "(1) A determination under section 11C takes effect on the day\nspecified in the determination. That day must not be before the day\non which notice of the determination is published in the Gazette.\n\n(2) If a determination under section 11C is expressed to cease to have\neffect at a specified time, the determination ceases to have effect at\nthat time.\n\n(3) A variation or revocation of a determination under section 11C\ntakes effect on the day specified for the purpose in the instrument\nof variation or revocation. That day must not be before the day on\nwhich notice of the instrument is published in the Gazette."
    },
