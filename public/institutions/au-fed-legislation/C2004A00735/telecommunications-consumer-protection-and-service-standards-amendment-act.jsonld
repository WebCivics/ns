        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The definition of eligible revenue is updated periodically.",
      "cml:conclusionText": "Taxpayer must update their revenue information regularly."
    },
