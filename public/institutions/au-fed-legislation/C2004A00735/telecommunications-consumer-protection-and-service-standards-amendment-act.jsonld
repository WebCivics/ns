    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22b",
      "@type": "cml:Concept",
      "skos:prefLabel": "22B How the ACA is to comply with a request",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-22b"
      },
