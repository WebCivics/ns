      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must be reimbursed",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) in reimbursing the Commonwealth for: (i) the costs or expenses incurred by the Commonwealth or the ACA in administering the Telecommunications (Universal Service Levy) Act 1997 and this Division during any period; and (ii) without limiting subparagraph (i), costs or expenses incurred in connection with recovering levy; and (iii) costs incurred by the Commonwealth during the period in collecting, compiling, analysing and publishing information about the operation of that Act and this Division."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-logic-deontic-5",
