    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "21(6) Universal Service Account",
      "cml:realizedBy": {
