      "cml:logicSummary": "Rebate entitlement knowledge representation",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The regulations may provide that...",
      "cml:conclusionText": "...the entitlement to the rebate complies with such requirements, restrictions and conditions (if any) as are specified in the regulations."
    },
