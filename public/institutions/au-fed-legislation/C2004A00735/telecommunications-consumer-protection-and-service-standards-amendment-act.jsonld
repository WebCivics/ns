    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-13s",
      "@type": "cml:Concept",
      "skos:prefLabel": "13S Replacement of approved policy statement, approved standard",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-13s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.55",
      "values:originalText": "marketing plan or approved ATS marketing plan\n\n(1) An approved policy statement for a competing universal service\nprovider ceases to be in force if a later draft policy statement, that\nis expressed to replace it, becomes an approved policy statement.\n\n(2) An approved standard marketing plan for a competing universal\nservice provider ceases to be in force if a later draft standard\nmarketing plan, that is expressed to replace it, becomes an\napproved standard marketing plan.\n\n(3) An approved ATS marketing plan for a competing universal\nservice provider ceases to be in force if a later draft ATS marketing\nplan, that is expressed to replace it, becomes an approved ATS\nmarketing plan.",
      "skos:definition": "marketing plan or approved ATS marketing plan\n\n(1) An approved policy statement for a competing universal service\nprovider ceases to be in force if a later draft policy statement, that\nis expressed to replace it, becomes an approved policy statement.\n\n(2) An approved standard marketing plan for a competing universal\nservice provider ceases to be in force if a later draft standard\nmarketing plan, that is expressed to replace it, becomes an\napproved standard marketing plan.\n\n(3) An approved ATS marketing plan for a competing universal\nservice provider ceases to be in force if a later draft ATS marketing\nplan, that is expressed to replace it, becomes an approved ATS\nmarketing plan.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-13s-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-13s-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-13s-ss-3"
        }
      ],
      "cml:integrityHash": "669de56158c34ccc1a4c6a047420e99252318118d4ee37a4a7de8edcda59f9d7"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-13s",
      "@type": "cof:Section",
      "cof:title": "13S Replacement of approved policy statement, approved standard",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "marketing plan or approved ATS marketing plan\n\n(1) An approved policy statement for a competing universal service\nprovider ceases to be in force if a later draft policy statement, that\nis expressed to replace it, becomes an approved policy statement.\n\n(2) An approved standard marketing plan for a competing universal\nservice provider ceases to be in force if a later draft standard\nmarketing plan, that is expressed to replace it, becomes an\napproved standard marketing plan.\n\n(3) An approved ATS marketing plan for a competing universal\nservice provider ceases to be in force if a later draft ATS marketing\nplan, that is expressed to replace it, becomes an approved ATS\nmarketing plan."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-13s-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "13S(1) Replacement of approved policy statement, approved standard",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-13s-ss-1"
