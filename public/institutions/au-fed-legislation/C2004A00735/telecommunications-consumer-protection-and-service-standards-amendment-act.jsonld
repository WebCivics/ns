      "cml:integrityHash": "df87727b6f0b588d4bfb4ab8c21be609e14e9be891ce6f82c436f6b02b40325b",
      "skos:note": "If areas are not within a universal service area, they constitute a single universal service area."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12-ss-3",
      "@type": "cof:Section",
      "cof:title": "12(3) Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "subsection",
      "cof:pageNumber": 16,
      "values:originalText": "(3) If, at a particular time, any areas of Australia are not within a\nuniversal service area, covered by a determination under\nsubsection (1), in respect of a service obligation:\n\n(a) those areas together constitute at that time a single universal\nservice area in respect of that service obligation; and\n\n(b) the Minister is taken to have made a determination under\nsubsection (1) to that effect."
    },
