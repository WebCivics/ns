    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-8f-ss-1",
      "@type": "cof:Section",
      "cof:title": "8F(1) Meaning of approved auditor",
      "values:kind": "subsection",
      "cof:pageNumber": 11,
      "values:originalText": "(1) A reference in this Part to an approved auditor is a reference to a\nperson included in a class of persons specified in a written\ndetermination made by the ACA for the purposes of this section."
    },
