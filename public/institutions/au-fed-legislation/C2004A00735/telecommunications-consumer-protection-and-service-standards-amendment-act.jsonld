    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9j",
      "@type": "cml:Concept",
      "skos:prefLabel": "9J Transitional arrangements may be determined",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-9j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.17",
      "values:originalText": "(1) If the Minister revokes a determination under section 9G, the\nMinister may determine in writing arrangements to deal with any\nissues of a transitional nature that may arise as a result of the\nrevocation.\n\n(2) A copy of a determination under subsection (1) must be published\nin the Gazette.",
      "skos:definition": "(1) If the Minister revokes a determination under section 9G, the\nMinister may determine in writing arrangements to deal with any\nissues of a transitional nature that may arise as a result of the\nrevocation.\n\n(2) A copy of a determination under subsection (1) must be published\nin the Gazette.",
      "cml:hasPart": [
        {
