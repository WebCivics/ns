    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20m",
      "@type": "cml:Concept",
      "skos:prefLabel": "20M ACA may inquire into correctness of claim",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.81",
      "values:originalText": "The ACA may make whatever inquiries it thinks necessary or\ndesirable in order to determine:\n\n(a) whether or not a claim by a universal service provider for a\nlevy credit for a claim period correctly states the provider’s\nentitlement to universal service subsidy for the period; or\n\n(b) whether or not a claim by a digital data service provider for a\nlevy credit for a claim period correctly states the amount of\nthe digital data cost of the provider for the period.",
      "skos:definition": "The ACA may make whatever inquiries it thinks necessary or\ndesirable in order to determine:\n\n(a) whether or not a claim by a universal service provider for a\nlevy credit for a claim period correctly states the provider’s\nentitlement to universal service subsidy for the period; or\n\n(b) whether or not a claim by a digital data service provider for a\nlevy credit for a claim period correctly states the amount of\nthe digital data cost of the provider for the period.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20m-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20m-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0a666bd8059f393cc44e1ec6f59884bd645c69a755af119f092e6b877acde81f",
      "skos:note": "May make inquiries into claim correctness"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20m",
      "@type": "cof:Section",
      "cof:title": "20M ACA may inquire into correctness of claim",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "The ACA may make whatever inquiries it thinks necessary or\ndesirable in order to determine:\n\n(a) whether or not a claim by a universal service provider for a\nlevy credit for a claim period correctly states the provider’s\nentitlement to universal service subsidy for the period; or\n\n(b) whether or not a claim by a digital data service provider for a\nlevy credit for a claim period correctly states the amount of\nthe digital data cost of the provider for the period."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20m-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20m"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20m-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
