      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.102",
      "values:originalText": "The Governor-General may make regulations in relation to any matters\nof a transitional nature that may arise out of the amendments and\nrepeals made by this Act.\n\nConsequential and other amendments  Schedule 3\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            99",
      "skos:definition": "The Governor-General may make regulations in relation to any matters\nof a transitional nature that may arise out of the amendments and\nrepeals made by this Act.\n\nConsequential and other amendments  Schedule 3\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            99",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-9-norm"
        }
      ],
      "cml:integrityHash": "0dd27e71de9c6a6dc459eeb7e72c1117e08e1427a051fa276d43ea1bb32a3eac",
      "skos:note": "Governor-General may make regulations on transitional matters."
    },
