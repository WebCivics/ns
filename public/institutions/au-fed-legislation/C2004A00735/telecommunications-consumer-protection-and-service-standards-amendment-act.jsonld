    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10j",
      "@type": "cml:Concept",
      "skos:prefLabel": "10J Special digital data service areas",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.22",
      "values:originalText": "(1) The Minister may make a written determination that a service area\nascertained in accordance with the determination is a special digital\ndata service area for the purposes of this Act. The determination\nhas effect accordingly.\n\n(2) A copy of the determination must be published in the Gazette.\n\n(3) The Minister must exercise the powers conferred by this section in\na manner that is consistent with the fulfilment of the digital data\nservice obligation.",
      "skos:definition": "(1) The Minister may make a written determination that a service area\nascertained in accordance with the determination is a special digital\ndata service area for the purposes of this Act. The determination\nhas effect accordingly.\n\n(2) A copy of the determination must be published in the Gazette.\n\n(3) The Minister must exercise the powers conferred by this section in\na manner that is consistent with the fulfilment of the digital data\nservice obligation.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10j-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10j-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10j-ss-3"
        }
      ],
      "cml:integrityHash": "2b5878efa046b5c76f2d158a48b2d936cf651c1f6df86f09d37db067057eb161"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10j",
      "@type": "cof:Section",
      "cof:title": "10J Special digital data service areas",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "(1) The Minister may make a written determination that a service area\nascertained in accordance with the determination is a special digital\ndata service area for the purposes of this Act. The determination\nhas effect accordingly.\n\n(2) A copy of the determination must be published in the Gazette.\n\n(3) The Minister must exercise the powers conferred by this section in\na manner that is consistent with the fulfilment of the digital data\nservice obligation."
    },
