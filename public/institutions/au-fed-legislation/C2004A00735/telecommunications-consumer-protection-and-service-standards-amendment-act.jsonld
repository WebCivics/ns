        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-13u-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c13b2cf6998bcc6b32d2df6606d48e0fed02285759f9c1443fdb81079cf0b3f7",
      "skos:note": "Publication in Gazette required for notice of decision on variation",
      "dc:description": "Notice given to provider, publication in Gazette"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-13u-ss-3",
      "@type": "cof:Section",
      "cof:title": "13U(3) Notice of decision",
      "values:kind": "subsection",
      "cof:pageNumber": 56,
      "values:originalText": "(3) If the ACA approves the variation:\n\n(a) the current statement or plan is varied accordingly; and\n\n(b) a copy of the notice given to the provider must be published\nin the Gazette, unless the variation is only of a minor\ntechnical nature."
    },
