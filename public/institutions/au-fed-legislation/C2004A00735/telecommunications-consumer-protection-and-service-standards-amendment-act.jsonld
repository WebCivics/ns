    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Levy distribution for 1998-1999 financial year",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-4-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.112",
      "values:originalText": "Items 3 to 6 of this Schedule apply if section 215 of the former law\nprevents a payment being made out of the Universal Service Account\nfor the 1998-1999 financial year because of either or both of the\nfollowing:\n\n(a) the ACA has not yet made a written assessment under\nsection 193 of the former law for that year;\n\n(b) not all participating carriers in respect of which levy was\nassessed have paid the levy.\nNote:\nThe operation of the former law for the 1998-1999 financial year is preserved by\nitem 23 of Schedule 4 to the Telecommunications Legislation Amendment Act 1999.",
      "skos:definition": "Items 3 to 6 of this Schedule apply if section 215 of the former law\nprevents a payment being made out of the Universal Service Account\nfor the 1998-1999 financial year because of either or both of the\nfollowing:\n\n(a) the ACA has not yet made a written assessment under\nsection 193 of the former law for that year;\n\n(b) not all participating carriers in respect of which levy was\nassessed have paid the levy.\nNote:\nThe operation of the former law for the 1998-1999 financial year is preserved by\nitem 23 of Schedule 4 to the Telecommunications Legislation Amendment Act 1999.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "132c32bbe76d652eeb261649f18771825199db02c9145b38fb8cc7100db2babc",
      "skos:note": "Payment of levy for 1998-1999 financial year if certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-4-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Levy distribution for 1998-1999 financial year",
      "values:kind": "section",
      "cof:pageNumber": 112,
      "values:originalText": "Items 3 to 6 of this Schedule apply if section 215 of the former law\nprevents a payment being made out of the Universal Service Account\nfor the 1998-1999 financial year because of either or both of the\nfollowing:\n\n(a) the ACA has not yet made a written assessment under\nsection 193 of the former law for that year;\n\n(b) not all participating carriers in respect of which levy was\nassessed have paid the levy.\nNote:\nThe operation of the former law for the 1998-1999 financial year is preserved by\nitem 23 of Schedule 4 to the Telecommunications Legislation Amendment Act 1999."
    },
    {
