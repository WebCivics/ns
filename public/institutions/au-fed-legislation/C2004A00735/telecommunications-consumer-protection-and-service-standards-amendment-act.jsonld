    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.68",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(b) is laid before each House of the Parliament within 5 sitting\ndays of that House after making the determination or\nvariation.\n\n(4) Subsection (1) does not, by implication, limit the Minister’s\npowers under section 486 of the Telecommunications Act 1997\n(which deals with public inquiries).",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\n\n(b) is laid before each House of the Parliament within 5 sitting\ndays of that House after making the determination or\nvariation.\n\n(4) Subsection (1) does not, by implication, limit the Minister’s\npowers under section 486 of the Telecommunications Act 1997\n(which deals with public inquiries).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-64-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-64-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c1c6acf23ed59f91a4b432656f2c40c6942fd3c562bab3fb134bbfb5acea8828",
      "skos:note": "Lay before each House of Parliament within 5 sitting days after making determination or variation."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-64",
      "@type": "cof:Section",
      "cof:title": "64 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(b) is laid before each House of the Parliament within 5 sitting\ndays of that House after making the determination or\nvariation.\n\n(4) Subsection (1) does not, by implication, limit the Minister’s\npowers under section 486 of the Telecommunications Act 1997\n(which deals with public inquiries)."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-64-norm",
