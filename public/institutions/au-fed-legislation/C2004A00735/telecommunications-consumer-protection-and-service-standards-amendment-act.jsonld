        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) the costs or expenses incurred by the Commonwealth or the ACA in administering the Telecommunications (Universal Service Levy) Act 1997 and this Division during any period;"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
