      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.104",
      "values:originalText": "Despite the repeal and substitution of subsection 2(2) of the\nTelecommunications (Consumer Protection and Service Standards) Act\n1999 made by item 6, that subsection continues to apply, after this item\ncommences in relation to the financial year that ended on 30 June 2000,\nas if that repeal and substitution had not happened.",
      "skos:definition": "Despite the repeal and substitution of subsection 2(2) of the\nTelecommunications (Consumer Protection and Service Standards) Act\n1999 made by item 6, that subsection continues to apply, after this item\ncommences in relation to the financial year that ended on 30 June 2000,\nas if that repeal and substitution had not happened.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-7-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-7-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "0ef46615113f0889b2b583f7fb10ba43da7c48acbf057b86b60944fb08404f83",
      "skos:note": "Continuation of subsection 2(2) of the Telecommunications (Consumer Protection and Service Standards) Act 1999"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-3-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Application",
      "values:kind": "section",
      "cof:pageNumber": 104,
      "values:originalText": "Despite the repeal and substitution of subsection 2(2) of the\nTelecommunications (Consumer Protection and Service Standards) Act\n1999 made by item 6, that subsection continues to apply, after this item\ncommences in relation to the financial year that ended on 30 June 2000,\nas if that repeal and substitution had not happened."
    },
