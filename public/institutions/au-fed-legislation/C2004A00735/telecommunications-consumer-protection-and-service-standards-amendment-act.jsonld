      },
      "cml:premiseText": "section 215 of the former law prevents a payment being made out of the Universal Service Account",
      "cml:conclusionText": "payment of levy for 1998-1999 financial year if certain conditions are met."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2-logic-alleninterval-2",
