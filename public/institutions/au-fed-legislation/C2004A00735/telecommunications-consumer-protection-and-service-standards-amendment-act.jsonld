      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15f",
      "@type": "cml:Concept",
      "skos:prefLabel": "15F Approval of draft digital data service plan by Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.63",
      "values:originalText": "(1) If a digital data service provider gives the Minister a draft digital\ndata service plan, the Minister must:\n\n(a) approve the draft plan; or\n\n(b) refuse to approve the draft plan.\n\n(2) If the Minister approves the draft plan, the draft plan becomes an\napproved digital data service plan.\n\n(3) If the Minister refuses to approve the draft plan, the Minister may,\nby written notice given to the provider, direct the provider to give\nthe Minister, within the period and in the terms specified in the\ndirection, a fresh draft digital data service plan for the area\nconcerned. The provider must comply with the direction.",
      "skos:definition": "(1) If a digital data service provider gives the Minister a draft digital\ndata service plan, the Minister must:\n\n(a) approve the draft plan; or\n\n(b) refuse to approve the draft plan.\n\n(2) If the Minister approves the draft plan, the draft plan becomes an\napproved digital data service plan.\n\n(3) If the Minister refuses to approve the draft plan, the Minister may,\nby written notice given to the provider, direct the provider to give\nthe Minister, within the period and in the terms specified in the\ndirection, a fresh draft digital data service plan for the area\nconcerned. The provider must comply with the direction.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15f-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15f-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15f-ss-3"
        }
      ],
      "cml:integrityHash": "94cf68d315be7dfbdb82b23a4420e7384b2f73ae0f418c2aa79b3ee53867d39b"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15f",
      "@type": "cof:Section",
      "cof:title": "15F Approval of draft digital data service plan by Minister",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "(1) If a digital data service provider gives the Minister a draft digital\ndata service plan, the Minister must:\n\n(a) approve the draft plan; or\n\n(b) refuse to approve the draft plan.\n\n(2) If the Minister approves the draft plan, the draft plan becomes an\napproved digital data service plan.\n\n(3) If the Minister refuses to approve the draft plan, the Minister may,\nby written notice given to the provider, direct the provider to give\nthe Minister, within the period and in the terms specified in the\ndirection, a fresh draft digital data service plan for the area\nconcerned. The provider must comply with the direction."
    },
