    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-16-2-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(4) Determination of universal service subsidy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-16-2-ss-4"
      },
