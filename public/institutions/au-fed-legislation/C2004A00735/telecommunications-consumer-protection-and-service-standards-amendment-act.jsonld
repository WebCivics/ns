    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zf",
      "@type": "cml:Concept",
      "skos:prefLabel": "20ZF Cancellation of certain exemptions from levy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20zf"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
