      "@type": "cml:Concept",
      "skos:prefLabel": "9 Transitional regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-9"
