    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Distributions before all levies have been paid",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-4-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.113",
      "values:originalText": "Despite paragraph 215(b) of the former law, an amount is payable from\nthe Universal Service Account for the 1998-1999 financial year even if\nall of the participating carriers in respect of which the levy was assessed\nhave not yet paid the levy.",
      "skos:definition": "Despite paragraph 215(b) of the former law, an amount is payable from\nthe Universal Service Account for the 1998-1999 financial year even if\nall of the participating carriers in respect of which the levy was assessed\nhave not yet paid the levy.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-5-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5157a9e5301763d0cfffedaaf19302f1a3732ecfc613e27ca060de9e69987ede",
      "skos:note": "Payable despite non-payment by carriers"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-4-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Distributions before all levies have been paid",
      "values:kind": "section",
      "cof:pageNumber": 113,
      "values:originalText": "Despite paragraph 215(b) of the former law, an amount is payable from\nthe Universal Service Account for the 1998-1999 financial year even if\nall of the participating carriers in respect of which the levy was assessed\nhave not yet paid the levy."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-5-norm",
