      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.14",
      "values:originalText": "For the purposes of this Part, a prescribed carriage service is a\ncarriage service specified in the regulations.",
      "skos:definition": "For the purposes of this Part, a prescribed carriage service is a\ncarriage service specified in the regulations.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9d-norm"
        }
      ],
      "cml:integrityHash": "7deef7f176434137246dcaac14a11db1282ee87e9e6e9f6f38442ba8fb9ad79a",
      "skos:note": "Defines prescribed carriage service as a carriage service specified in regulations."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-9d",
      "@type": "cof:Section",
      "cof:title": "9D Prescribed carriage services",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "For the purposes of this Part, a prescribed carriage service is a\ncarriage service specified in the regulations."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9d-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
