    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.6",
      "values:originalText": "(1) Subject to this section, this Act commences on the day on which it\nreceives the Royal Assent.\n\n(2) Schedules 1 to 3 (other than items 10, 11 and 13 of Schedule 3)\ncommence, or are taken to have commenced, on 1 July 2000.\n\n(3) Items 10, 11 and 13 of Schedule 3 commence on the first\n1 January, 1 April, 1 July or 1 October following the day on which\nthis Act receives the Royal Assent.",
      "skos:definition": "(1) Subject to this section, this Act commences on the day on which it\nreceives the Royal Assent.\n\n(2) Schedules 1 to 3 (other than items 10, 11 and 13 of Schedule 3)\ncommence, or are taken to have commenced, on 1 July 2000.\n\n(3) Items 10, 11 and 13 of Schedule 3 commence on the first\n1 January, 1 April, 1 July or 1 October following the day on which\nthis Act receives the Royal Assent.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sec-2-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sec-2-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sec-2-ss-3"
        }
      ],
      "cml:integrityHash": "b7aee70e1ab49fff68457cf2e83f76fa9d746f4944607d4db0345c23a0972475"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Commencement",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "(1) Subject to this section, this Act commences on the day on which it\nreceives the Royal Assent.\n\n(2) Schedules 1 to 3 (other than items 10, 11 and 13 of Schedule 3)\ncommence, or are taken to have commenced, on 1 July 2000.\n\n(3) Items 10, 11 and 13 of Schedule 3 commence on the first\n1 January, 1 April, 1 July or 1 October following the day on which\nthis Act receives the Royal Assent."
    },
