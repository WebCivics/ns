    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Digital data service obligation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.17",
      "values:originalText": "For the purposes of this Act, the digital data service obligation is\nthe obligation:\n\n(a) to ensure that one or other of the following:\n\n(i) general digital data services;\n\n(ii) special digital data services;\n\nare reasonably accessible to all people in Australia on an\nequitable basis, wherever they reside or carry on business;\nand\n\n(b) to ensure that general digital data services are reasonably\naccessible to at least 96% of the Australian population on an\nequitable basis; and\n\n(c) to ensure that special digital data services are reasonably\naccessible to the remainder of the Australian population on\nan equitable basis.",
      "skos:definition": "For the purposes of this Act, the digital data service obligation is\nthe obligation:\n\n(a) to ensure that one or other of the following:\n\n(i) general digital data services;\n\n(ii) special digital data services;\n\nare reasonably accessible to all people in Australia on an\nequitable basis, wherever they reside or carry on business;\nand\n\n(b) to ensure that general digital data services are reasonably\naccessible to at least 96% of the Australian population on an\nequitable basis; and\n\n(c) to ensure that special digital data services are reasonably\naccessible to the remainder of the Australian population on\nan equitable basis.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10-2-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7ddd8a02e3d7b70168ef76abf33cce29756937b66d341394c637dd70b62620c0",
      "skos:note": "Ensure digital data services are reasonably accessible to all people in Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10-2",
      "@type": "cof:Section",
      "cof:title": "10 Digital data service obligation",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "For the purposes of this Act, the digital data service obligation is\nthe obligation:\n\n(a) to ensure that one or other of the following:\n\n(i) general digital data services;\n\n(ii) special digital data services;\n\nare reasonably accessible to all people in Australia on an\nequitable basis, wherever they reside or carry on business;\nand\n\n(b) to ensure that general digital data services are reasonably\naccessible to at least 96% of the Australian population on an\nequitable basis; and\n\n(c) to ensure that special digital data services are reasonably\naccessible to the remainder of the Australian population on\nan equitable basis."
    },
