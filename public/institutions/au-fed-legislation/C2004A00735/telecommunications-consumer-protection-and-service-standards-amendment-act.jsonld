    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-40",
      "@type": "cof:Section",
      "cof:title": "40 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "(No. 2) 2000       No. 142, 2000\nNote:\nThese apply to universal service areas in respect of a contestable\nservice obligation or obligations (see subsection 11(3)).\nSubdivision B—Competing universal service providers"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-40-norm",
      "@type": "values:Obligation",
