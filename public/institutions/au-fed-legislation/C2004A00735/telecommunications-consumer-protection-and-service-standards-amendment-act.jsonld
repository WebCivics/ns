      "cml:premiseText": "(3) A period determined by the Minister under paragraph (1)(b)",
      "cml:conclusionText": "must not be a part of more than one financial year."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-8d-ss-3-logic-deontic-2",
