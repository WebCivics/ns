    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20y",
      "@type": "cml:Concept",
      "skos:prefLabel": "20Y Multiple assessments in the same document",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20y"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.86",
      "values:originalText": "The ACA may include in the same document more than one\nassessment made under this Part.\nSubdivision D—Collection and recovery of levy\n20Z  When levy payable\n\n(1) Levy assessed under section 20U becomes due and payable on:\n\n(a) the 28th day; or\n\n(b) such later day as is determined in writing by the ACA;\nafter the ACA gives a copy of the assessment to the participating\nperson in respect of which the levy has been assessed.\n\n(2) A copy of a determination under paragraph (1)(b) must be\npublished in the Gazette.",
      "skos:definition": "The ACA may include in the same document more than one\nassessment made under this Part.\nSubdivision D—Collection and recovery of levy\n20Z  When levy payable\n\n(1) Levy assessed under section 20U becomes due and payable on:\n\n(a) the 28th day; or\n\n(b) such later day as is determined in writing by the ACA;\nafter the ACA gives a copy of the assessment to the participating\nperson in respect of which the levy has been assessed.\n\n(2) A copy of a determination under paragraph (1)(b) must be\npublished in the Gazette.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20y-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20y-ss-2"
        }
      ],
      "cml:integrityHash": "4809e23d603e4e947009785f6c21c476d4505533677c8022aac19a5994be89f9"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20y",
      "@type": "cof:Section",
      "cof:title": "20Y Multiple assessments in the same document",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "The ACA may include in the same document more than one\nassessment made under this Part.\nSubdivision D—Collection and recovery of levy\n20Z  When levy payable\n\n(1) Levy assessed under section 20U becomes due and payable on:\n\n(a) the 28th day; or\n\n(b) such later day as is determined in writing by the ACA;\nafter the ACA gives a copy of the assessment to the participating\nperson in respect of which the levy has been assessed.\n\n(2) A copy of a determination under paragraph (1)(b) must be\npublished in the Gazette."
    },
    {
