    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15e",
      "@type": "cml:Concept",
      "skos:prefLabel": "15E Replacement of approved digital data service plan",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.63",
      "values:originalText": "If an approved digital data service plan (the original plan) for an\narea is in force, a draft digital data service plan for the area may be\nexpressed to replace the original plan. When the draft plan\nbecomes an approved digital data service plan, the original plan\nceases to be in force.",
      "skos:definition": "If an approved digital data service plan (the original plan) for an\narea is in force, a draft digital data service plan for the area may be\nexpressed to replace the original plan. When the draft plan\nbecomes an approved digital data service plan, the original plan\nceases to be in force.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15e-norm"
        }
      ],
      "cml:integrityHash": "10f9a9dbb15c9907e5d87ae8ba0a866c8031abef73d4d6cdf241272b79bdc37f",
      "skos:note": "Replacement of approved digital data service plan"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15e",
      "@type": "cof:Section",
      "cof:title": "15E Replacement of approved digital data service plan",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "If an approved digital data service plan (the original plan) for an\narea is in force, a draft digital data service plan for the area may be\nexpressed to replace the original plan. When the draft plan\nbecomes an approved digital data service plan, the original plan\nceases to be in force."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15e-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
