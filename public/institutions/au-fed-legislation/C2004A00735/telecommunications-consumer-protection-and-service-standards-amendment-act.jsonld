      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.28",
      "values:originalText": "(3) In exercising his or her powers under this section, the Minister\nmust ensure that at all times there is one primary universal service\nprovider, in respect of each service obligation, for each universal\nservice area.",
      "skos:definition": "(3) In exercising his or her powers under this section, the Minister\nmust ensure that at all times there is one primary universal service\nprovider, in respect of each service obligation, for each universal\nservice area.",
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12a"
      },
