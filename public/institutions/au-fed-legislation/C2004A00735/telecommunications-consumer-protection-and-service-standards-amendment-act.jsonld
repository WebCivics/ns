    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20x",
      "@type": "cml:Concept",
      "skos:prefLabel": "20X ACA may accept statements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.85",
      "values:originalText": "Despite anything in this Part, the ACA may, for the purposes of\nmaking an assessment under this Part, partly or completely accept\na statement in a claim for levy credit or an eligible revenue return.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "Despite anything in this Part, the ACA may, for the purposes of\nmaking an assessment under this Part, partly or completely accept\na statement in a claim for levy credit or an eligible revenue return.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20x-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20x-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4f642df54880419a5589e10f882a79138cfc66d16ad8e79e8e7f90dfb101d721",
      "skos:note": "The ACA may accept a statement in a claim for levy credit or an eligible revenue return."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20x",
      "@type": "cof:Section",
      "cof:title": "20X ACA may accept statements",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "Despite anything in this Part, the ACA may, for the purposes of\nmaking an assessment under this Part, partly or completely accept\na statement in a claim for levy credit or an eligible revenue return.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
