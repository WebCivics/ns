    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23a",
      "@type": "cml:Concept",
      "skos:prefLabel": "23A Delegation to the ACA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-23a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.96",
      "values:originalText": "(1) The Minister may delegate one or more of his or her powers under\nthis Part to an SES employee, or an acting SES employee, of the\nACA. The delegation must be in writing.\n\n(2) The delegation may be made subject to specified conditions.\n\n(3) A notice of a delegation made under this section must be published\nin the Gazette, including details of the delegation.",
      "skos:definition": "(1) The Minister may delegate one or more of his or her powers under\nthis Part to an SES employee, or an acting SES employee, of the\nACA. The delegation must be in writing.\n\n(2) The delegation may be made subject to specified conditions.\n\n(3) A notice of a delegation made under this section must be published\nin the Gazette, including details of the delegation.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23a-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23a-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23a-ss-3"
        }
      ],
      "cml:integrityHash": "33f8d3e715cb10683c406ab9c613c3b438190346930a24ff327461b6504b008d"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-23a",
      "@type": "cof:Section",
      "cof:title": "23A Delegation to the ACA",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "(1) The Minister may delegate one or more of his or her powers under\nthis Part to an SES employee, or an acting SES employee, of the\nACA. The delegation must be in writing.\n\n(2) The delegation may be made subject to specified conditions.\n\n(3) A notice of a delegation made under this section must be published\nin the Gazette, including details of the delegation."
    },
