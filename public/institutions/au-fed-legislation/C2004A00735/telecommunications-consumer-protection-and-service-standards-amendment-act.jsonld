      "cml:integrityHash": "258a25fe64ba39448cd32ee31c600a245ecc2783ef832cfc786ec6057f6f9faa",
      "skos:note": "A reference to the supply of a standard telephone service includes a reference to the supply, to a person with a disability, of customer equipment, goods or services."
    },
