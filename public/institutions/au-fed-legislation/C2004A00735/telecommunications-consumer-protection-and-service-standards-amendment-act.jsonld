          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12-ss-4-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "51a7f58135d7bd04700ec44b7f11541f60a455ac57cc4f4192de4678c6894173",
      "skos:note": "If multiple universal service areas cover the same areas, they constitute a single area for all service obligations."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12-ss-4",
