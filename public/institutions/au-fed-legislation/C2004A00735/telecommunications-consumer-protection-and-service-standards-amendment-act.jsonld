          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11f-ss-2-norm"
        }
      ],
      "cml:integrityHash": "d67f9c333a113441df51aa27318daa6747fe57862ec8f533ca4c66f13b60a486",
      "skos:note": "Definition of pilot area"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-11f-ss-2",
      "@type": "cof:Section",
      "cof:title": "11F(2) Section 11C temporarily limited to pilot areas",
      "values:kind": "subsection",
      "cof:pageNumber": 27,
      "values:originalText": "(2) A pilot area is an area determined in writing by the Minister for\nthe purposes of this section. The Minister may determine a\nmaximum of 2 pilot areas and cannot later change the boundaries\nof a pilot area."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11f-ss-2-norm",
      "@type": "values:Undertaking",
