      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Rebate entitlement implies liability to pay rebate",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) the amount of the rebate is equal to the amount ascertained in accordance with the regulations;...",
      "cml:conclusionText": "...and (f) the liability to pay the rebate has been discharged;"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10d-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Propagation",
      "cml:logicSummary": "Rebate entitlement propagates to third-party acquirers/hirers",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(g) the entitlement to the rebate complies with such requirements, restrictions and conditions (if any) as are specified in the regulations.",
      "cml:conclusionText": "...the supply of a special digital data service;"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10d-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
