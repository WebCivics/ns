    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "21B(3) Purposes of Universal Service Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-21b-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.89",
      "values:originalText": "(3) Despite subsection (2), the total of the amounts reimbursed under\nparagraph (1)(e) must not exceed the total of the amounts paid into\nthe Universal Service Account under paragraph 21A(b) (including\nany interest earned on those amounts).\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "(3) Despite subsection (2), the total of the amounts reimbursed under\nparagraph (1)(e) must not exceed the total of the amounts paid into\nthe Universal Service Account under paragraph 21A(b) (including\nany interest earned on those amounts).\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ffb135cc8cc430feb45fcf2bcdf3fa3c6da6aee8380d749fe7da330984200e9d",
      "skos:note": "Total reimbursement amount must not exceed total payment into Universal Service Account."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-21b-ss-3",
      "@type": "cof:Section",
      "cof:title": "21B(3) Purposes of Universal Service Account",
      "values:kind": "subsection",
      "cof:pageNumber": 89,
      "values:originalText": "(3) Despite subsection (2), the total of the amounts reimbursed under\nparagraph (1)(e) must not exceed the total of the amounts paid into\nthe Universal Service Account under paragraph 21A(b) (including\nany interest earned on those amounts).\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
