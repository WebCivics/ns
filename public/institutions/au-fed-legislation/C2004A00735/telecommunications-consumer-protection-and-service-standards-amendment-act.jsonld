    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Application of repealed Part 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.98",
      "values:originalText": "Despite the repeal and substitution of Part 2 of the Telecommunications\n(Consumer Protection and Service Standards) Act 1999 by Schedule 1\nto this Act, that Part continues to apply, after that Schedule commences\nin relation to the financial year that ended on 30 June 2000, as if that\nrepeal and substitution had not happened.",
      "skos:definition": "Despite the repeal and substitution of Part 2 of the Telecommunications\n(Consumer Protection and Service Standards) Act 1999 by Schedule 1\nto this Act, that Part continues to apply, after that Schedule commences\nin relation to the financial year that ended on 30 June 2000, as if that\nrepeal and substitution had not happened.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-1-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1d941d177b268158ba641d53e12711eb334e0d67be5e2c7a94ed42efc9057ab8",
      "skos:note": "Continuation of repealed Part 2 despite repeal and substitution"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Application of repealed Part 2",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "Despite the repeal and substitution of Part 2 of the Telecommunications\n(Consumer Protection and Service Standards) Act 1999 by Schedule 1\nto this Act, that Part continues to apply, after that Schedule commences\nin relation to the financial year that ended on 30 June 2000, as if that\nrepeal and substitution had not happened."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
