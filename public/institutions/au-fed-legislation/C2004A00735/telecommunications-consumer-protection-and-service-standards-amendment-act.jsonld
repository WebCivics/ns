        }
      ],
      "cml:integrityHash": "552e3edccb780b756cf6aa39966b154d265269cad47751fe879111b5cac1d3f1",
      "skos:note": "Primary universal service provider must comply with ACA requirements if ceasing alternative telecommunications services.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-26-ss-2",
      "@type": "cof:Section",
      "cof:title": "26(2) Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(2) The ACA may determine in writing requirements that a primary\nuniversal service provider must comply with if the provider intends\nto cease supplying alternative telecommunications services in\naccordance with an approved ATS marketing plan. A copy of the\ndetermination must be given to the provider."
    },
