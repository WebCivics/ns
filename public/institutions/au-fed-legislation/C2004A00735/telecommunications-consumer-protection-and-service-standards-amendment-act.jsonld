          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9h-ss-3-norm"
        }
      ],
      "cml:integrityHash": "cb77af869ad6f299b71be8cc505cacb1c82465d99a2275ce5560245b31513f84",
      "skos:note": "Variation or revocation of a determination under section 9G takes effect on the specified day after notice is published in the Gazette."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-9h-ss-3",
      "@type": "cof:Section",
      "cof:title": "9H(3) Effect of determination",
      "values:kind": "subsection",
      "cof:pageNumber": 16,
      "values:originalText": "(3) A variation or revocation of a determination under section 9G takes\neffect on the day specified for the purpose in the instrument of\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            13\nvariation or revocation. That day must not be before notice of the\ninstrument is published in the Gazette."
    },
