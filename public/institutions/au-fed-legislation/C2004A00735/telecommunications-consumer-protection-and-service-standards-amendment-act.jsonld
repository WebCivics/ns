      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12x",
      "@type": "cml:Concept",
      "skos:prefLabel": "12X Notice of decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.42",
      "values:originalText": "(1) After deciding whether to approve a variation under section 12W,\nthe ACA must give a written notice setting out the decision to the\nprovider concerned.\n\n(2) If the ACA refuses to approve the variation, the ACA must give a\nwritten notice setting out the reasons for the refusal to the provider.\n\n(3) If the ACA approves the variation:\n\n(a) the current statement or plan is varied accordingly; and\n\n(b) a copy of the notice given to the provider must be published\nin the Gazette, unless the variation is only of a minor\ntechnical nature.",
      "skos:definition": "(1) After deciding whether to approve a variation under section 12W,\nthe ACA must give a written notice setting out the decision to the\nprovider concerned.\n\n(2) If the ACA refuses to approve the variation, the ACA must give a\nwritten notice setting out the reasons for the refusal to the provider.\n\n(3) If the ACA approves the variation:\n\n(a) the current statement or plan is varied accordingly; and\n\n(b) a copy of the notice given to the provider must be published\nin the Gazette, unless the variation is only of a minor\ntechnical nature.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12x-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12x-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12x-ss-3"
        }
      ],
      "cml:integrityHash": "3f1b3ca141ce79802763e69df181d0887a1b172342520b5647f3aa34d7b29c19"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12x",
      "@type": "cof:Section",
      "cof:title": "12X Notice of decision",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "(1) After deciding whether to approve a variation under section 12W,\nthe ACA must give a written notice setting out the decision to the\nprovider concerned.\n\n(2) If the ACA refuses to approve the variation, the ACA must give a\nwritten notice setting out the reasons for the refusal to the provider.\n\n(3) If the ACA approves the variation:\n\n(a) the current statement or plan is varied accordingly; and\n\n(b) a copy of the notice given to the provider must be published\nin the Gazette, unless the variation is only of a minor\ntechnical nature."
    },
