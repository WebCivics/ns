    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15p",
      "@type": "cml:Concept",
      "skos:prefLabel": "15P Compliance with approved digital data service plan",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15p"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.66",
      "values:originalText": "If an approved digital data service plan is in force, the general\ndigital data service provider, or special digital data service\nprovider, concerned must take all reasonable steps to ensure that\nthe plan is complied with.",
      "skos:definition": "If an approved digital data service plan is in force, the general\ndigital data service provider, or special digital data service\nprovider, concerned must take all reasonable steps to ensure that\nthe plan is complied with.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15p-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15p-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8508e4bc8e8a5122e46895ede50450ae8540fe7d5ca763736384cb20331a8147",
      "skos:note": "Ensure compliance with approved digital data service plan"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15p",
      "@type": "cof:Section",
      "cof:title": "15P Compliance with approved digital data service plan",
      "values:kind": "section",
      "cof:pageNumber": 66,
      "values:originalText": "If an approved digital data service plan is in force, the general\ndigital data service provider, or special digital data service\nprovider, concerned must take all reasonable steps to ensure that\nthe plan is complied with."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15p-norm",
