      "@type": "cml:Concept",
      "skos:prefLabel": "8F Meaning of approved auditor",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-8f"
