      "cml:integrityHash": "36c346ad74f66c690c6e7ad78d7f6a93ee32799e2beca2043a35d7539856ae9d",
      "skos:note": "Modifies the application of this Part to carriers and carriage service providers"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-8d-ss-4",
      "@type": "cof:Section",
      "cof:title": "8D(4) Meaning of claim period",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(4) If the Minister determines a period under paragraph (1)(b), the\ndetermination may modify the way this Part applies to carriers and\ncarriage service providers. The modifications may include\nadditions, omissions and substitutions."
    },
