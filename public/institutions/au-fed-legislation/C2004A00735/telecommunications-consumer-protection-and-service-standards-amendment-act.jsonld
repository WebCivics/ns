    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11c",
      "@type": "cml:Concept",
      "skos:prefLabel": "11C Determination of contestable service obligation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-11c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.26",
      "values:originalText": "(1) The Minister may determine in writing, for a universal service area\nin respect of a service obligation, that the obligation is a\ncontestable service obligation.\nNote 1:\nThis means that the standard contestability arrangements apply to the\narea in respect of the contestable service obligation (see subsection\n11(3)).\nNote 2:\nThe Minister can make determinations under this section initially only\nin relation to pilot areas (see section 11F).\n\n(2) The Minister must give to the ACA a copy of each determination\nmade under this section.\n\n(3) A determination under this section is a disallowable instrument for\nthe purposes of section 46A of the Acts Interpretation Act 1901.",
      "skos:definition": "(1) The Minister may determine in writing, for a universal service area\nin respect of a service obligation, that the obligation is a\ncontestable service obligation.\nNote 1:\nThis means that the standard contestability arrangements apply to the\narea in respect of the contestable service obligation (see subsection\n11(3)).\nNote 2:\nThe Minister can make determinations under this section initially only\nin relation to pilot areas (see section 11F).\n\n(2) The Minister must give to the ACA a copy of each determination\nmade under this section.\n\n(3) A determination under this section is a disallowable instrument for\nthe purposes of section 46A of the Acts Interpretation Act 1901.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11c-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11c-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-11c-ss-3"
        }
      ],
      "cml:integrityHash": "5f44d5d2390bcc9ccb74ff57b44c6f5aaffd67c6cc32f5c732786f5258891e50"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-11c",
      "@type": "cof:Section",
      "cof:title": "11C Determination of contestable service obligation",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "(1) The Minister may determine in writing, for a universal service area\nin respect of a service obligation, that the obligation is a\ncontestable service obligation.\nNote 1:\nThis means that the standard contestability arrangements apply to the\narea in respect of the contestable service obligation (see subsection\n11(3)).\nNote 2:\nThe Minister can make determinations under this section initially only\nin relation to pilot areas (see section 11F).\n\n(2) The Minister must give to the ACA a copy of each determination\nmade under this section.\n\n(3) A determination under this section is a disallowable instrument for\nthe purposes of section 46A of the Acts Interpretation Act 1901."
    },
