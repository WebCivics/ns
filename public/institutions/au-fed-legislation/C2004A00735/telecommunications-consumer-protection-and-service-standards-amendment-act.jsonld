    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20v",
      "@type": "cml:Concept",
      "skos:prefLabel": "20V Publication of assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.85",
      "values:originalText": "As soon as practicable after making an assessment under\nsection 20U for a claim period, the ACA must:\n\n(a) cause a copy of the assessment to be published in the\nGazette; and\n\n(b) give a copy of the assessment to each of the persons referred\nto in subsections 20U(2), (3) and (4).",
      "skos:definition": "As soon as practicable after making an assessment under\nsection 20U for a claim period, the ACA must:\n\n(a) cause a copy of the assessment to be published in the\nGazette; and\n\n(b) give a copy of the assessment to each of the persons referred\nto in subsections 20U(2), (3) and (4).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20v-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20v-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "00043df13b40485f3c1bb27231bf6ef9ae578c3acfeeb75c53e0ab6f5dcb8778",
      "skos:note": "Publish assessment in Gazette and provide to persons referred to in subsections 20U(2), (3) and (4)",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20v",
      "@type": "cof:Section",
      "cof:title": "20V Publication of assessment",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "As soon as practicable after making an assessment under\nsection 20U for a claim period, the ACA must:\n\n(a) cause a copy of the assessment to be published in the\nGazette; and\n\n(b) give a copy of the assessment to each of the persons referred\nto in subsections 20U(2), (3) and (4)."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20v-norm",
