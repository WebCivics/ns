        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to provide return",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 191 of the former law requires participating carriers to give returns",
      "cml:conclusionText": "The ACA may estimate and assess eligible revenue if a return is not provided"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST NOT",
      "cml:logicSummary": "Prohibition on making assessment based on estimate after receiving return",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 193 of the former law requires ACA to make written assessments",
      "cml:conclusionText": "The ACA must not make an assessment based on an estimate after receiving a return from the carrier concerned"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Assessment based on estimate must occur after receiving return",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 193 of the former law requires ACA to make written assessments",
      "cml:conclusionText": "The assessment based on estimate must occur after receiving a return from the carrier concerned"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY",
      "cml:logicSummary": "Permission for ACA to estimate and assess eligible revenue",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 191 of the former law requires participating carriers to give returns",
      "cml:conclusionText": "The ACA may estimate and assess eligible revenue if a return is not provided"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "IS REQUIRED TO",
      "cml:logicSummary": "Obligation for ACA to provide notice of proposal to make assessment based on estimate",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 193 of the former law requires ACA to give at least 14 days' notice to carriers",
      "cml:conclusionText": "The ACA is required to provide notice of its proposal to make an assessment based on an estimate"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Nil assessments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-4-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.113",
      "values:originalText": "The ACA may make an assessment under section 193 of the former law\nor item 3 of this Schedule that a participating carrier’s eligible revenue\nfor the 1998-1999 financial year is nil if, in the ACA’s opinion, without\nsuch an assessment:\n\n(a) it is unlikely that the carrier would be able to pay any levy\nthat would be payable; or\n\n(b) the carrier is unlikely to pay the levy unless the\nCommonwealth takes action to recover it and the cost of\ndoing so would exceed the amount of the levy.\nNote:\nHowever, the ACA could later amend a nil assessment under section 195 of the former\nlaw.",
      "skos:definition": "The ACA may make an assessment under section 193 of the former law\nor item 3 of this Schedule that a participating carrier’s eligible revenue\nfor the 1998-1999 financial year is nil if, in the ACA’s opinion, without\nsuch an assessment:\n\n(a) it is unlikely that the carrier would be able to pay any levy\nthat would be payable; or\n\n(b) the carrier is unlikely to pay the levy unless the\nCommonwealth takes action to recover it and the cost of\ndoing so would exceed the amount of the levy.\nNote:\nHowever, the ACA could later amend a nil assessment under section 195 of the former\nlaw.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-4-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-4-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-4-logic-argumentation-3"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-4-logic-diffusion-4"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "c52799b300cb95787edd41b616a8c1f56cabbceaadef47d51e1bf10069fd8349",
      "skos:note": "Participating carrier must pay levy unless Commonwealth recovers it."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-4-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Nil assessments",
      "values:kind": "section",
      "cof:pageNumber": 113,
      "values:originalText": "The ACA may make an assessment under section 193 of the former law\nor item 3 of this Schedule that a participating carrier’s eligible revenue\nfor the 1998-1999 financial year is nil if, in the ACA’s opinion, without\nsuch an assessment:\n\n(a) it is unlikely that the carrier would be able to pay any levy\nthat would be payable; or\n\n(b) the carrier is unlikely to pay the levy unless the\nCommonwealth takes action to recover it and the cost of\ndoing so would exceed the amount of the levy.\nNote:\nHowever, the ACA could later amend a nil assessment under section 195 of the former\nlaw."
    },
