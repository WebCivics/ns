    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-8e",
      "@type": "cml:Concept",
      "skos:prefLabel": "8E Meaning of alternative telecommunications services, or ATS",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-8e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.11",
      "values:originalText": "For the purposes of this Part, alternative telecommunications\nservices, or ATS, are services the supply of which by a particular\nuniversal service provider the ACA authorises for the purposes of\nthis section.",
      "skos:definition": "For the purposes of this Part, alternative telecommunications\nservices, or ATS, are services the supply of which by a particular\nuniversal service provider the ACA authorises for the purposes of\nthis section.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-8e-norm"
        }
      ],
      "cml:integrityHash": "6de7dde6d23e358c1251c96dd65be37679f8970779e0cae88e7633f0700e2e66",
      "skos:note": "Defines alternative telecommunications services (ATS) for the purposes of this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-8e",
      "@type": "cof:Section",
      "cof:title": "8E Meaning of alternative telecommunications services, or ATS",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "For the purposes of this Part, alternative telecommunications\nservices, or ATS, are services the supply of which by a particular\nuniversal service provider the ACA authorises for the purposes of\nthis section."
    },
