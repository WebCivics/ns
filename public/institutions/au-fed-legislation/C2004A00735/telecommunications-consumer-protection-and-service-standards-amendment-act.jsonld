      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.87",
      "values:originalText": "In any proceeding, the onus of establishing that an assessment\nunder section 20U is incorrect is on the party making that assertion.",
      "skos:definition": "In any proceeding, the onus of establishing that an assessment\nunder section 20U is incorrect is on the party making that assertion.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zd-norm"
        },
