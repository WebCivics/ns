    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20u-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "20U(5) ACA to make written assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20u-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.84",
      "values:originalText": "(5) The assessment must be made on the basis of:\n\n(a) the assessments under section 20N of levy credits for the\nclaim period; and\n\n(b) the assessments under section 20F of eligible revenue for\neach participating person for the last eligible revenue period\nthat ended before the start of the claim period; and\n\n(c) any other information or documents that the ACA has and\nthat it thinks relevant to making the assessment.",
      "skos:definition": "(5) The assessment must be made on the basis of:\n\n(a) the assessments under section 20N of levy credits for the\nclaim period; and\n\n(b) the assessments under section 20F of eligible revenue for\neach participating person for the last eligible revenue period\nthat ended before the start of the claim period; and\n\n(c) any other information or documents that the ACA has and\nthat it thinks relevant to making the assessment.",
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20u"
      },
      "cml:asserts": [
