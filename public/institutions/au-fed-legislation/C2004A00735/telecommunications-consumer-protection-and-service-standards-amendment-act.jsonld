    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22c",
      "@type": "cml:Concept",
      "skos:prefLabel": "22C Minister’s information-gathering powers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-22c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.94",
      "values:originalText": "(1) This section applies if the Minister has reason to believe that a\ncarrier or carriage service provider has information that is relevant\nto the exercise of the Minister’s powers, or performance of the\nMinister’s functions, under this Part.\n\n(2) The Minister may give written notice to the carrier or provider\nrequiring the carrier or provider to give the information to the\nMinister, within the period and in the manner specified in the\nnotice.\n\n(3) The carrier or provider must comply with the notice.\n\n(4) A notice under subsection (2) is a disallowable instrument for the\npurposes of section 46A of the Acts Interpretation Act 1901.",
      "skos:definition": "(1) This section applies if the Minister has reason to believe that a\ncarrier or carriage service provider has information that is relevant\nto the exercise of the Minister’s powers, or performance of the\nMinister’s functions, under this Part.\n\n(2) The Minister may give written notice to the carrier or provider\nrequiring the carrier or provider to give the information to the\nMinister, within the period and in the manner specified in the\nnotice.\n\n(3) The carrier or provider must comply with the notice.\n\n(4) A notice under subsection (2) is a disallowable instrument for the\npurposes of section 46A of the Acts Interpretation Act 1901.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22c-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22c-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22c-ss-3"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22c-ss-4"
        }
      ],
      "cml:integrityHash": "6e5a891b58e48bb5c2c8694e2e45d75a5375828096b4c93564787d461f64fff3"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-22c",
      "@type": "cof:Section",
      "cof:title": "22C Minister’s information-gathering powers",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "(1) This section applies if the Minister has reason to believe that a\ncarrier or carriage service provider has information that is relevant\nto the exercise of the Minister’s powers, or performance of the\nMinister’s functions, under this Part.\n\n(2) The Minister may give written notice to the carrier or provider\nrequiring the carrier or provider to give the information to the\nMinister, within the period and in the manner specified in the\nnotice.\n\n(3) The carrier or provider must comply with the notice.\n\n(4) A notice under subsection (2) is a disallowable instrument for the\npurposes of section 46A of the Acts Interpretation Act 1901."
    },
