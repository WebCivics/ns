    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20j",
      "@type": "cml:Concept",
      "skos:prefLabel": "20J Claims for levy credit",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.79",
      "values:originalText": "(1) Within the period of 45 days after the end of a claim period, or\nsuch other period as is determined in writing by the Minister, a\ncarrier or carriage service provider who is a:\n\n(a) universal service provider; or\n\n(b) a digital data service provider;\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "(1) Within the period of 45 days after the end of a claim period, or\nsuch other period as is determined in writing by the Minister, a\ncarrier or carriage service provider who is a:\n\n(a) universal service provider; or\n\n(b) a digital data service provider;\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20j-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20j-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c3e2a4e866883318adb3395b42a58ab5de6b1847891a19fc5054d0a068d823c4",
      "skos:note": "Carrier or carriage service provider must claim levy credit within 45 days after the end of a claim period."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20j",
      "@type": "cof:Section",
      "cof:title": "20J Claims for levy credit",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "(1) Within the period of 45 days after the end of a claim period, or\nsuch other period as is determined in writing by the Minister, a\ncarrier or carriage service provider who is a:\n\n(a) universal service provider; or\n\n(b) a digital data service provider;\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20j-norm",
