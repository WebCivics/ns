      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9a",
      "@type": "cml:Concept",
      "skos:prefLabel": "9A Determinations of what is necessary to ensure reasonable",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-9a"
      },
      "cml:curationStatus": {
