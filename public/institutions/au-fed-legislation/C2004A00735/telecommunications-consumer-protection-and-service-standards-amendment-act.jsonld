      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.65",
      "values:originalText": "(1) After deciding whether to approve a draft variation of an approved\ndigital data service plan, the Minister must give a written notice\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "(1) After deciding whether to approve a draft variation of an approved\ndigital data service plan, the Minister must give a written notice\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15m-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15m-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1a33b4ff8d6d34b46be9ee6173aa2904878639584ccbcd5387be5d45abdf5f1e",
      "skos:note": "Minister must give written notice after deciding on variation of digital data service plan"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15m",
      "@type": "cof:Section",
      "cof:title": "15M Notice of decision on variation",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "(1) After deciding whether to approve a draft variation of an approved\ndigital data service plan, the Minister must give a written notice\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
