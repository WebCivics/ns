    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-6a",
      "@type": "cml:Concept",
      "skos:prefLabel": "6A ACA advice under section 16A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-6a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.101",
      "values:originalText": "If, before 31 December 2000, the ACA has given an advice relating to\nuniversal service subsidies to the Minister, the advice is taken to have\nbeen given to the Minister in accordance with section 16A.",
      "skos:definition": "If, before 31 December 2000, the ACA has given an advice relating to\nuniversal service subsidies to the Minister, the advice is taken to have\nbeen given to the Minister in accordance with section 16A.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-6a-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-6a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "91cae06e4f59d78da396e3f4e5351e1fcee41f02c9eb720bbb36be99400abfd2",
      "skos:note": "Advice from ACA is binding on the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-6a",
      "@type": "cof:Section",
      "cof:title": "6A ACA advice under section 16A",
      "values:kind": "section",
      "cof:pageNumber": 101,
      "values:originalText": "If, before 31 December 2000, the ACA has given an advice relating to\nuniversal service subsidies to the Minister, the advice is taken to have\nbeen given to the Minister in accordance with section 16A."
    },
    {
