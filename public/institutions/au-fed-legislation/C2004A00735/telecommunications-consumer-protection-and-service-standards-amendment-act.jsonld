      "@type": "cml:Concept",
      "skos:prefLabel": "22A(5) Request for information that is unavailable under section 22",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-22a-ss-5"
      },
