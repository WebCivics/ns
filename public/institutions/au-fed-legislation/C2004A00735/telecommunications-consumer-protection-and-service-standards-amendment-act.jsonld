    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "12(4) Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
