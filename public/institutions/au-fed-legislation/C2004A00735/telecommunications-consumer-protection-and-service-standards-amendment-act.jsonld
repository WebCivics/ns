      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) without limiting subparagraph (i), costs or expenses incurred in connection with recovering levy; and (iii) costs incurred by the Commonwealth during the period in collecting, compiling, analysing and publishing information about the operation of that Act and this Division."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
