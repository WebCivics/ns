    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-13u-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "13U(3) Notice of decision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-13u-ss-3"
      },
