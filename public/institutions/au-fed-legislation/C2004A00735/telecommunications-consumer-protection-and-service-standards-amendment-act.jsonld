      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.90",
      "values:originalText": "(No. 2) 2000       No. 142, 2000",
      "skos:definition": "(No. 2) 2000       No. 142, 2000",
      "cml:asserts": [
