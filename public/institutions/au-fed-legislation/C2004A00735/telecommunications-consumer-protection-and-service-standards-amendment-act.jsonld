      "@type": "cml:Concept",
      "skos:prefLabel": "10F(3) Supply of general digital data services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10f-ss-3"
      },
