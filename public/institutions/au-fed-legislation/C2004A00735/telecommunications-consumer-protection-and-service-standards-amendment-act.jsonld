    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10g-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "10G(2) Supply of special digital data services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10g-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
