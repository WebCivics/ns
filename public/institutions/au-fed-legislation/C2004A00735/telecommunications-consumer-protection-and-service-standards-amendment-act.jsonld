      "cml:integrityHash": "634187ad2a0e6e2aa01d85b01a89abd47cf93e6670eec3545088c077d426230f",
      "skos:note": "Minister must consider relevant factors when determining primary universal service providers."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12a-ss-4",
      "@type": "cof:Section",
      "cof:title": "12A(4) Determination of primary universal service providers",
      "values:kind": "subsection",
      "cof:pageNumber": 28,
      "values:originalText": "(4) In deciding whether to make a determination that a person is a\nprimary universal service provider, the Minister is limited to\nconsidering factors that are relevant to achieving the objects of this\nAct."
    },
