      "cml:integrityHash": "917d19b08dd6b1957b174792bd2d32de27a39a92c1f49e67f66cc3ccb2a0a6a1"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-62",
      "@type": "cof:Section",
      "cof:title": "62 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 66,
      "values:originalText": "(No. 2) 2000       No. 142, 2000\nsetting out the decision to both the digital data service provider\nconcerned and the ACA.\n\n(2) A copy of the notice must be published in the Gazette.\n\n(3) If the Minister refuses to approve the variation, the Minister must\ngive a written notice setting out the reasons for the refusal to the\nprovider.\n\n(4) If the Minister approves the variation, the current plan is varied\naccordingly.\n\n(5) The Minister must give to the ACA a copy of each variation\napproved under section 15L."
    },
