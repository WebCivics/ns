      },
      "cml:premiseText": "the 1998-1999 financial year",
      "cml:conclusionText": "payment of levy for the period between the start and end of the 1998-1999 financial year."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-4-sec-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
