    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-23-ss-4",
      "@type": "cof:Section",
      "cof:title": "23(4) ACA must maintain Register/s",
      "values:kind": "subsection",
