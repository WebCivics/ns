    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Nil assessments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-5-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.116",
      "values:originalText": "The ACA may make an assessment under section 64 of the former law\nor item 3 of this Schedule that a participating carrier’s eligible revenue\nfor the 1999-2000 financial year is nil if, in the ACA’s opinion, without\nsuch an assessment:\n\n(a) it is unlikely that the carrier would be able to pay any levy\nthat would be payable; or\n\n(b) the carrier is unlikely to pay the levy unless the\nCommonwealth takes action to recover it and the cost of\ndoing so would exceed the amount of the levy.\nNote:\nHowever, the ACA could later amend a nil assessment under section 66 of the former\nlaw.",
      "skos:definition": "The ACA may make an assessment under section 64 of the former law\nor item 3 of this Schedule that a participating carrier’s eligible revenue\nfor the 1999-2000 financial year is nil if, in the ACA’s opinion, without\nsuch an assessment:\n\n(a) it is unlikely that the carrier would be able to pay any levy\nthat would be payable; or\n\n(b) the carrier is unlikely to pay the levy unless the\nCommonwealth takes action to recover it and the cost of\ndoing so would exceed the amount of the levy.\nNote:\nHowever, the ACA could later amend a nil assessment under section 66 of the former\nlaw.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-4-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6deea17a86f6d871cb84cb3927a313e824971126db65a55ad50d3228e905ee02",
      "skos:note": "Participating carrier must pay levy unless Commonwealth recovers it."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-5-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Nil assessments",
      "values:kind": "section",
      "cof:pageNumber": 116,
      "values:originalText": "The ACA may make an assessment under section 64 of the former law\nor item 3 of this Schedule that a participating carrier’s eligible revenue\nfor the 1999-2000 financial year is nil if, in the ACA’s opinion, without\nsuch an assessment:\n\n(a) it is unlikely that the carrier would be able to pay any levy\nthat would be payable; or\n\n(b) the carrier is unlikely to pay the levy unless the\nCommonwealth takes action to recover it and the cost of\ndoing so would exceed the amount of the levy.\nNote:\nHowever, the ACA could later amend a nil assessment under section 66 of the former\nlaw."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-4-norm",
      "@type": "values:Obligation",
