    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9g",
      "@type": "cml:Concept",
      "skos:prefLabel": "9G Universal service areas",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-9g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.15",
      "values:originalText": "(1) The Minister may make a written determination that a service area,\ndetermined in any way the Minister considers appropriate, is a\nuniversal service area in respect of one or more specified service\nobligations.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "(1) The Minister may make a written determination that a service area,\ndetermined in any way the Minister considers appropriate, is a\nuniversal service area in respect of one or more specified service\nobligations.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9g-norm"
        }
      ],
      "cml:integrityHash": "07f4f0ad4ad4300590f21209cae1c9ca7c6c5674262079ac2beeb4fff76fbf9d",
      "skos:note": "The Minister may make a written determination about universal service areas."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-9g",
      "@type": "cof:Section",
      "cof:title": "9G Universal service areas",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "(1) The Minister may make a written determination that a service area,\ndetermined in any way the Minister considers appropriate, is a\nuniversal service area in respect of one or more specified service\nobligations.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9g-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-9g"
