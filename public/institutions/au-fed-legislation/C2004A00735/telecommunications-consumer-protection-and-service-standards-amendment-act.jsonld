          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19b-ss-2-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19b-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "968527beaccc5ab4e6717ac7c2f70ea90ec4d4cd40ff5d99deeeace311469f92",
      "skos:note": "The Minister may make a written determination setting out price-cap arrangements and principles or rules for imposing the charge."
    },
    {
