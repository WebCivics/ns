      "cml:premiseText": "(3) The revocation takes effect on the day specified in the notice which must be on or after the day on which the notice is given to the provider."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12z-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "12Z(4) Minister may revoke approved ATS marketing plan",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12z-ss-4"
