    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-8c",
      "@type": "cml:Concept",
      "skos:prefLabel": "8C Meaning of service area",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-8c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.10",
      "values:originalText": "For the purposes of this Part, a service area is:\n\n(a) a geographical area within Australia; or\n\n(b) any area of land; or\n\n(c) any premises or part of premises;\nregardless of size.",
      "skos:definition": "For the purposes of this Part, a service area is:\n\n(a) a geographical area within Australia; or\n\n(b) any area of land; or\n\n(c) any premises or part of premises;\nregardless of size.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-8c-norm"
        }
      ],
      "cml:integrityHash": "85ac9ae6162930f93f69eadf29320f5a3253db939e5a84287f0cad8dcfd0965f",
      "skos:note": "Definition of service area"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-8c",
      "@type": "cof:Section",
      "cof:title": "8C Meaning of service area",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "For the purposes of this Part, a service area is:\n\n(a) a geographical area within Australia; or\n\n(b) any area of land; or\n\n(c) any premises or part of premises;\nregardless of size."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-8c-norm",
