    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Meaning of eligible person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.101",
      "values:originalText": "After Schedule 1 to this Act commences, each of the following persons,\nin relation to a financial year that ended on or before 30 June 2000, is\ntaken to be an eligible person for the purposes of section 22A of the\nTelecommunications (Consumer Protection and Service Standards) Act\n1999:\n\n(a) a universal service provider;\n\n(b) a digital data service provider;\n\n(c) a participating carrier.\nNote:\nSection 22A of that Act deals with requests for information.\n\nSchedule 2  Application and transitional provisions",
      "skos:definition": "After Schedule 1 to this Act commences, each of the following persons,\nin relation to a financial year that ended on or before 30 June 2000, is\ntaken to be an eligible person for the purposes of section 22A of the\nTelecommunications (Consumer Protection and Service Standards) Act\n1999:\n\n(a) a universal service provider;\n\n(b) a digital data service provider;\n\n(c) a participating carrier.\nNote:\nSection 22A of that Act deals with requests for information.\n\nSchedule 2  Application and transitional provisions",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-7-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-7-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "ea3420df5067fe8ed0e408dab2781429cc891963b440f6eff18b9dac4826ccfa",
      "skos:note": "Definition of eligible person for section 22A of the Telecommunications (Consumer Protection and Service Standards) Act 1999"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Meaning of eligible person",
      "values:kind": "section",
      "cof:pageNumber": 101,
      "values:originalText": "After Schedule 1 to this Act commences, each of the following persons,\nin relation to a financial year that ended on or before 30 June 2000, is\ntaken to be an eligible person for the purposes of section 22A of the\nTelecommunications (Consumer Protection and Service Standards) Act\n1999:\n\n(a) a universal service provider;\n\n(b) a digital data service provider;\n\n(c) a participating carrier.\nNote:\nSection 22A of that Act deals with requests for information.\n\nSchedule 2  Application and transitional provisions"
    },
    {
