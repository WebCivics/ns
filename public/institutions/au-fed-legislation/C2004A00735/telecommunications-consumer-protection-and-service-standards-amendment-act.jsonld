      "@type": "cml:Concept",
      "skos:prefLabel": "9E(2) Supply of standard telephone services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-9e-ss-2"
      },
