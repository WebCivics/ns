      "cml:integrityHash": "09174c0809f06889ed80a62be21563fb133ead2c781fd14de158bd22170258bd",
      "skos:note": "Defines modifications to the Telecommunications (Consumer Protection and Service Standards) Act 1999"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-22d-ss-3",
      "@type": "cof:Section",
