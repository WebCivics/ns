        }
      ],
      "cml:integrityHash": "9fe0f6b27ab4f71de9673a959d3d6efa0d92de11a3e07cc04d27f23d911fe62d",
      "skos:note": "Participating person must lodge return of eligible revenue",
      "dc:description": "return of eligible revenue, details of how it was worked out, and other required information"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20-2-ss-3",
      "@type": "cof:Section",
      "cof:title": "20(3) Participating person must lodge return of eligible revenue",
      "values:kind": "subsection",
      "cof:pageNumber": 75,
      "values:originalText": "(3) The return must set out:\n\n(a) the eligible revenue for the eligible revenue period of the\nparticipating person; and\n\n(b) details of how the eligible revenue was worked out; and\n\n(c) such other information (if any) as the approved form of\nreturn requires.\nNote:\nIt is an offence to make a false or misleading statement in connection\nwith the operation of this Act (see section 578 of the\nTelecommunications Act 1997)."
    },
