      "cml:conclusionText": "subparagraph 11(b)(iii), subparagraph 9C(b)(iii), section 12, etc."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-2-sec-96",
      "@type": "cml:Concept",
      "skos:prefLabel": "96 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-2-sec-96"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.100",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\nEquivalent provisions of the Telecommunications (Consumer Protection\nand Service Standards) Act 1999\nItem\nThis original provision\n(before this Act receives the\nRoyal Assent):\n... is equivalent, after Schedule 1\ncommences, to this provision:\nsubsection 40M(2)\nsubsection 15N(2)\nsubsection 42(1)\nsubsection 18A(1)\nsubsection 43(2)\nsubsection 18B(2)\nsubsection 46B(1)\nsubsection 19A(1)\nsubsection 46C(2)\nsubsection 19B(2)\nsection 61A\nsection 17\nsubsection 61B(1)\nsubsection 17A(1)",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\nEquivalent provisions of the Telecommunications (Consumer Protection\nand Service Standards) Act 1999\nItem\nThis original provision\n(before this Act receives the\nRoyal Assent):\n... is equivalent, after Schedule 1\ncommences, to this provision:\nsubsection 40M(2)\nsubsection 15N(2)\nsubsection 42(1)\nsubsection 18A(1)\nsubsection 43(2)\nsubsection 18B(2)\nsubsection 46B(1)\nsubsection 19A(1)\nsubsection 46C(2)\nsubsection 19B(2)\nsection 61A\nsection 17\nsubsection 61B(1)\nsubsection 17A(1)",
      "cml:asserts": [
