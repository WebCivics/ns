    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10g-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "10G(3) Supply of special digital data services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10g-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.21",
      "values:originalText": "(3) Regulations made for the purposes of paragraph (1)(e) may require\nthat specified customer equipment is to be supplied on the basis\nthat the customer concerned enters into a legally enforceable\nagreement containing such terms and conditions relating to the\nownership, possession, location, disposal or use of the equipment,\nas are specified in, or ascertained in accordance with, the\nregulations.",
      "skos:definition": "(3) Regulations made for the purposes of paragraph (1)(e) may require\nthat specified customer equipment is to be supplied on the basis\nthat the customer concerned enters into a legally enforceable\nagreement containing such terms and conditions relating to the\nownership, possession, location, disposal or use of the equipment,\nas are specified in, or ascertained in accordance with, the\nregulations.",
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10g"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10g-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10g-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7a1c5d10eee65ef3a164b68f94b26a67e7dceb96edb6a630b5b830dfdec7fe9c",
      "skos:note": "Customer equipment must be supplied under a legally enforceable agreement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10g-ss-3",
      "@type": "cof:Section",
      "cof:title": "10G(3) Supply of special digital data services",
      "values:kind": "subsection",
      "cof:pageNumber": 21,
      "values:originalText": "(3) Regulations made for the purposes of paragraph (1)(e) may require\nthat specified customer equipment is to be supplied on the basis\nthat the customer concerned enters into a legally enforceable\nagreement containing such terms and conditions relating to the\nownership, possession, location, disposal or use of the equipment,\nas are specified in, or ascertained in accordance with, the\nregulations."
    },
