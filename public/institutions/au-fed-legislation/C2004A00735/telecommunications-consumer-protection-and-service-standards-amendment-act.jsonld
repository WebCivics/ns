          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20p-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "df666748d83acd34014eb9fd7c049a18cf73ada3dfba67ab7d7401ed95c9b3fc",
      "skos:note": "Minister may determine principles for assessing claims"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20p-ss-1",
      "@type": "cof:Section",
      "cof:title": "20P(1) Principles for assessing and adjusting claims",
      "values:kind": "subsection",
      "cof:pageNumber": 82,
      "values:originalText": "(1) The Minister may determine in writing principles that are to be\napplied in assessing (including adjusting) claims for a levy credit.\nThe principles apply from the date specified in the determination."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20p-ss-1-norm",
