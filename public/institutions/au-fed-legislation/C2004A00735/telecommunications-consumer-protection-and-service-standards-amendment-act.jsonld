    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-88",
      "@type": "cml:Concept",
      "skos:prefLabel": "88 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-88"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.92",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(ii) the making available of which under this section can\nreasonably be expected to cause substantial damage to\nthat provider; or\n\n(b) information prescribed for the purposes of this paragraph; or\n\n(c) so much of a document as sets out information of a kind\nreferred to in paragraph (a) or (b).",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\n\n(ii) the making available of which under this section can\nreasonably be expected to cause substantial damage to\nthat provider; or\n\n(b) information prescribed for the purposes of this paragraph; or\n\n(c) so much of a document as sets out information of a kind\nreferred to in paragraph (a) or (b).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-88-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-88-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "878d7eec4d897c974f5b660d22ebd93c69f1fbf0306bcae861cc75ffc58cfe20",
      "skos:note": "Making available of certain information is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-88",
      "@type": "cof:Section",
      "cof:title": "88 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(ii) the making available of which under this section can\nreasonably be expected to cause substantial damage to\nthat provider; or\n\n(b) information prescribed for the purposes of this paragraph; or\n\n(c) so much of a document as sets out information of a kind\nreferred to in paragraph (a) or (b)."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-88-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-88"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-88-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits making available of certain information.",
      "cml:executionSurface": "modalities::logic::deontic",
