    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12e-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "12E(2) Effect of certain agreements under the Telstra Corporation Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12e-ss-2"
      },
