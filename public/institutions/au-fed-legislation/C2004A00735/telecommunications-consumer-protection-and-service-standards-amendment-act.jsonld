        }
      ],
      "cml:integrityHash": "fac42d1d85f59086050176bf70d1bf5ec65643437776ca02ff66aba5c8fcb739",
      "skos:note": "Party making assertion of incorrect assessment bears burden of proof."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20zd",
      "@type": "cof:Section",
      "cof:title": "20ZD Onus of establishing incorrectness of assessment",
      "values:kind": "section",
      "cof:pageNumber": 87,
      "values:originalText": "In any proceeding, the onus of establishing that an assessment\nunder section 20U is incorrect is on the party making that assertion."
    },
