    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19e",
      "@type": "cml:Concept",
      "skos:prefLabel": "19E Compliance with price control determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-19e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.74",
      "values:originalText": "A digital data service provider must comply with a determination\nin force under this Division.\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            71",
      "skos:definition": "A digital data service provider must comply with a determination\nin force under this Division.\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            71",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19e-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "058fc47b966d4183ae2711386dfb75d4d6a2ee57ac481795cb857e9980a4e136",
      "skos:note": "Compliance with price control determinations"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-19e",
      "@type": "cof:Section",
      "cof:title": "19E Compliance with price control determinations",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "A digital data service provider must comply with a determination\nin force under this Division.\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            71"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19e-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19e"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-19e-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must comply",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Participating person must lodge return of eligible revenue",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.75",
      "values:originalText": "(1) A participating person for an eligible revenue period must give the\nACA a written return of the person’s eligible revenue for that\nperiod.\n\n(2) The return must be:\n\n(a) given to the ACA within the period specified in writing by\nthe ACA for providing returns; and\n\n(b) in a form approved in writing by the ACA.\nThe approved form may require verification, by a statutory\ndeclaration, of statements made in the return.\n\n(3) The return must set out:\n\n(a) the eligible revenue for the eligible revenue period of the\nparticipating person; and\n\n(b) details of how the eligible revenue was worked out; and\n\n(c) such other information (if any) as the approved form of\nreturn requires.\nNote:\nIt is an offence to make a false or misleading statement in connection\nwith the operation of this Act (see section 578 of the\nTelecommunications Act 1997).",
      "skos:definition": "(1) A participating person for an eligible revenue period must give the\nACA a written return of the person’s eligible revenue for that\nperiod.\n\n(2) The return must be:\n\n(a) given to the ACA within the period specified in writing by\nthe ACA for providing returns; and\n\n(b) in a form approved in writing by the ACA.\nThe approved form may require verification, by a statutory\ndeclaration, of statements made in the return.\n\n(3) The return must set out:\n\n(a) the eligible revenue for the eligible revenue period of the\nparticipating person; and\n\n(b) details of how the eligible revenue was worked out; and\n\n(c) such other information (if any) as the approved form of\nreturn requires.\nNote:\nIt is an offence to make a false or misleading statement in connection\nwith the operation of this Act (see section 578 of the\nTelecommunications Act 1997).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-2-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-2-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20-2-ss-3"
        }
      ],
      "cml:integrityHash": "bf9e05c1682fe3a208513a7bb68b2806a8f7cfaa0d30c5a381718fc2c02d7ad1"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20-2",
      "@type": "cof:Section",
      "cof:title": "20 Participating person must lodge return of eligible revenue",
      "values:kind": "section",
      "cof:pageNumber": 75,
      "values:originalText": "(1) A participating person for an eligible revenue period must give the\nACA a written return of the person’s eligible revenue for that\nperiod.\n\n(2) The return must be:\n\n(a) given to the ACA within the period specified in writing by\nthe ACA for providing returns; and\n\n(b) in a form approved in writing by the ACA.\nThe approved form may require verification, by a statutory\ndeclaration, of statements made in the return.\n\n(3) The return must set out:\n\n(a) the eligible revenue for the eligible revenue period of the\nparticipating person; and\n\n(b) details of how the eligible revenue was worked out; and\n\n(c) such other information (if any) as the approved form of\nreturn requires.\nNote:\nIt is an offence to make a false or misleading statement in connection\nwith the operation of this Act (see section 578 of the\nTelecommunications Act 1997)."
    },
