      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zb-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "State obligation to uphold assessment validity",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Assessment under this Division is subject to this Act.",
      "cml:conclusionText": "Contravention of this Act does not affect assessment validity."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zb-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "State permission to contravene assessment validity",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Contravention of this Act does not affect assessment validity.",
      "cml:conclusionText": "State may choose to contravene assessment validity if it wishes."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zb-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:logicSummary": "State right to contravene assessment validity",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Contravention of this Act does not affect assessment validity.",
      "cml:conclusionText": "State has a right to choose whether or not to contravene assessment validity."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zc",
      "@type": "cml:Concept",
      "skos:prefLabel": "20ZC Evidence of assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20zc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.86",
      "values:originalText": "(1) This section applies if:\n\n(a) a copy of the Gazette is produced that sets out what purports\nto be a copy of an assessment made under section 20U; or\n\n(b) a document that purports to be such a copy is produced.\n\n(2) Except so far as the contrary is established, it must be presumed:\n\n(a) that the copy of the Gazette sets out, or that the document is,\nas the case may be, a copy of such an assessment; and\n\n(b) that the ACA has duly made the assessment; and\n\n(c) that the amounts and other particulars set out in the\nassessment are correct.\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            83",
      "skos:definition": "(1) This section applies if:\n\n(a) a copy of the Gazette is produced that sets out what purports\nto be a copy of an assessment made under section 20U; or\n\n(b) a document that purports to be such a copy is produced.\n\n(2) Except so far as the contrary is established, it must be presumed:\n\n(a) that the copy of the Gazette sets out, or that the document is,\nas the case may be, a copy of such an assessment; and\n\n(b) that the ACA has duly made the assessment; and\n\n(c) that the amounts and other particulars set out in the\nassessment are correct.\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            83",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zc-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zc-ss-2"
        }
      ],
      "cml:integrityHash": "452863b5c38902785857864b4ed12714c86c89a43302a6693035fb4191b40e55"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20zc",
