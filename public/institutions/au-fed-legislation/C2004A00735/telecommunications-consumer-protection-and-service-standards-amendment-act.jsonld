        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-logic-deontic-4"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "c4f8bda4049e74ae554ae090b55c9b8fd245dc9a04a90d580c16ac3b49a37f3c",
      "skos:note": "Expenditure of Universal Service Account funds"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-21b-ss-1",
      "@type": "cof:Section",
      "cof:title": "21B(1) Purposes of Universal Service Account",
      "values:kind": "subsection",
      "cof:pageNumber": 89,
      "values:originalText": "(1) Amounts standing to the credit of the Universal Service Account\nmay be expended:\n\n(a) in payment of any amounts payable under section 21C; and\n\n(b) in payment of any refunds under section 20ZE; and\n\n(c) in refunding any amounts paid into the Universal Service\nAccount in error; and\n\n(d) in making distributions in accordance with section 21D; and\n\n(e) in reimbursing the Commonwealth for:\n\n(i) the costs or expenses incurred by the Commonwealth or\nthe ACA in administering the Telecommunications\n(Universal Service Levy) Act 1997 and this Division\nduring any period; and\n\n(ii) without limiting subparagraph (i), costs or expenses\nincurred in connection with recovering levy; and\n\n(iii) costs incurred by the Commonwealth during the period\nin collecting, compiling, analysing and publishing\ninformation about the operation of that Act and this\nDivision."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-1-norm",
