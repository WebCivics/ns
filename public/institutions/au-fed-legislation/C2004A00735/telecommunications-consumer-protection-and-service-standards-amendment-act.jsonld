        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20r-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f44afe6ef91621b3e80f2d6c0685fc31f75f8deb7394fc24e92221be3e64eb2f",
      "skos:note": "Minister may modify levy credit formula"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20r-ss-3",
      "@type": "cof:Section",
      "cof:title": "20R(3) Levy debit of a participating person",
      "values:kind": "subsection",
      "cof:pageNumber": 83,
      "values:originalText": "(3) The Minister may, by written determination, modify the formula in\nsubsection (2).\nNote:\nThe Minister may, for example, increase the amount of total levy\ncredits to take account of the possibility of defaults in the payment of\nlevy for a claim period."
    },
