    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23c",
      "@type": "cml:Concept",
      "skos:prefLabel": "23C Offence of failing to lodge eligible revenue return",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-23c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.96",
      "values:originalText": "(1) A person is guilty of an offence if:\n\n(a) the person is required under section 20 to give the ACA an\neligible revenue return for an eligible revenue period; and\n\n(b) the person fails to do so; and\n\n(c) the ACA has not made an assessment under section 20U that\nincludes an estimate of the person’s eligible revenue for the\neligible revenue period.\nThis is an offence of strict liability.\nMaximum penalty: 50 penalty units.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\nNote 2:\nFor strict liability, see section 6.1 of the Criminal Code.\nNote 3:\nThe maximum penalty for a body corporate is 250 penalty units. See\nsubsection 4B(3) of the Crimes Act 1914.\n\n(2) A person who is guilty of an offence under subsection (1) is guilty\nof a separate offence in respect of each day on which the failure\ncontinues (including the day of a conviction for the offence or any\nlater day).\n\n(3) Despite anything in section 583 of the Telecommunications Act\n1997, that section does not apply to an offence under\nsubsection (1).\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            93",
      "skos:definition": "(1) A person is guilty of an offence if:\n\n(a) the person is required under section 20 to give the ACA an\neligible revenue return for an eligible revenue period; and\n\n(b) the person fails to do so; and\n\n(c) the ACA has not made an assessment under section 20U that\nincludes an estimate of the person’s eligible revenue for the\neligible revenue period.\nThis is an offence of strict liability.\nMaximum penalty: 50 penalty units.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\nNote 2:\nFor strict liability, see section 6.1 of the Criminal Code.\nNote 3:\nThe maximum penalty for a body corporate is 250 penalty units. See\nsubsection 4B(3) of the Crimes Act 1914.\n\n(2) A person who is guilty of an offence under subsection (1) is guilty\nof a separate offence in respect of each day on which the failure\ncontinues (including the day of a conviction for the offence or any\nlater day).\n\n(3) Despite anything in section 583 of the Telecommunications Act\n1997, that section does not apply to an offence under\nsubsection (1).\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            93",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23c-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23c-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-23c-ss-3"
        }
      ],
      "cml:integrityHash": "feb42550689b35824dc932686885e08d9574911f8283308c49bfca9019fe1cd6"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-23c",
      "@type": "cof:Section",
      "cof:title": "23C Offence of failing to lodge eligible revenue return",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "(1) A person is guilty of an offence if:\n\n(a) the person is required under section 20 to give the ACA an\neligible revenue return for an eligible revenue period; and\n\n(b) the person fails to do so; and\n\n(c) the ACA has not made an assessment under section 20U that\nincludes an estimate of the person’s eligible revenue for the\neligible revenue period.\nThis is an offence of strict liability.\nMaximum penalty: 50 penalty units.\nNote 1:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\nNote 2:\nFor strict liability, see section 6.1 of the Criminal Code.\nNote 3:\nThe maximum penalty for a body corporate is 250 penalty units. See\nsubsection 4B(3) of the Crimes Act 1914.\n\n(2) A person who is guilty of an offence under subsection (1) is guilty\nof a separate offence in respect of each day on which the failure\ncontinues (including the day of a conviction for the offence or any\nlater day).\n\n(3) Despite anything in section 583 of the Telecommunications Act\n1997, that section does not apply to an offence under\nsubsection (1).\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            93"
    },
