    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20t",
      "@type": "cml:Concept",
      "skos:prefLabel": "20T Levy credit balance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20t"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.84",
      "values:originalText": "If a person’s assessed levy credit (if any) under section 20N for a\nclaim period exceeds the person’s levy debit under subsection 20R\nfor the claim period, then:\n\n(a) the person has a levy credit balance for the period; and\n\n(b) the amount of that balance is the amount of the excess.",
      "skos:definition": "If a person’s assessed levy credit (if any) under section 20N for a\nclaim period exceeds the person’s levy debit under subsection 20R\nfor the claim period, then:\n\n(a) the person has a levy credit balance for the period; and\n\n(b) the amount of that balance is the amount of the excess.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20t-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20t-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "11b9110475d6eab8e4f04a06d82e5d3af959109426f289a92b5dc062fdade3ce",
      "skos:note": "If a person's assessed levy credit exceeds their levy debit, they have a levy credit balance."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20t",
      "@type": "cof:Section",
      "cof:title": "20T Levy credit balance",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "If a person’s assessed levy credit (if any) under section 20N for a\nclaim period exceeds the person’s levy debit under subsection 20R\nfor the claim period, then:\n\n(a) the person has a levy credit balance for the period; and\n\n(b) the amount of that balance is the amount of the excess."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20t-norm",
