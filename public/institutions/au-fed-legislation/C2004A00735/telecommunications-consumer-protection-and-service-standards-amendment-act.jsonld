    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22a-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "22A(6) Request for information that is unavailable under section 22",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-22a-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.92",
      "values:originalText": "(6) For the purposes of this section, a person may give the ACA a\nwritten undertaking that, if specified information, or the whole or a\npart of a specified document, is made available to the person under\nthis section, the person will not disclose the information, or the\ncontents of the document, except to one or more specified persons.\nNote:\nInformation, documents or persons may be specified by name, by\ninclusion in a class or in any other way.",
      "skos:definition": "(6) For the purposes of this section, a person may give the ACA a\nwritten undertaking that, if specified information, or the whole or a\npart of a specified document, is made available to the person under\nthis section, the person will not disclose the information, or the\ncontents of the document, except to one or more specified persons.\nNote:\nInformation, documents or persons may be specified by name, by\ninclusion in a class or in any other way.",
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22a"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22a-ss-6-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22a-ss-6-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22a-ss-6-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "bf60bf1f587cc782bfd71452f49dd92e35db19919bd72f053329e4a32a9a4b00",
      "skos:note": "Granting permission to disclose information under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-22a-ss-6",
      "@type": "cof:Section",
      "cof:title": "22A(6) Request for information that is unavailable under section 22",
      "values:kind": "subsection",
      "cof:pageNumber": 92,
      "values:originalText": "(6) For the purposes of this section, a person may give the ACA a\nwritten undertaking that, if specified information, or the whole or a\npart of a specified document, is made available to the person under\nthis section, the person will not disclose the information, or the\ncontents of the document, except to one or more specified persons.\nNote:\nInformation, documents or persons may be specified by name, by\ninclusion in a class or in any other way."
    },
