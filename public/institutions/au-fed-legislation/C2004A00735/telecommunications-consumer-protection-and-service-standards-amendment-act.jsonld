    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10h",
      "@type": "cml:Concept",
      "skos:prefLabel": "10H General digital data service areas",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.21",
      "values:originalText": "(1) The Minister may make a written determination that a service area\nascertained in accordance with the determination is a general\ndigital data service area for the purposes of this Act. The\ndetermination has effect accordingly.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "(1) The Minister may make a written determination that a service area\nascertained in accordance with the determination is a general\ndigital data service area for the purposes of this Act. The\ndetermination has effect accordingly.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10h-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10h-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-10h-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "4d54fac69086b203b1d10b607dc3de39b2d0faf0dd7b1a419fb17fb2cdcdee13",
      "skos:note": "Minister may make written determination about general digital data service areas."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-10h",
      "@type": "cof:Section",
      "cof:title": "10H General digital data service areas",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "(1) The Minister may make a written determination that a service area\nascertained in accordance with the determination is a general\ndigital data service area for the purposes of this Act. The\ndetermination has effect accordingly.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
