      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.27",
      "values:originalText": "The default arrangements consist of the arrangements set out in\nthis Division.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "The default arrangements consist of the arrangements set out in\nthis Division.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12-2-norm"
        }
      ],
      "cml:integrityHash": "54d591311f02c7adeaff362e7581823418b78928144f771190d1c58417019d7f",
      "skos:note": "Default arrangements consist of the arrangements set out in this Division."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12-2",
      "@type": "cof:Section",
      "cof:title": "12 The default arrangements",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "The default arrangements consist of the arrangements set out in\nthis Division.\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12-2-norm",
