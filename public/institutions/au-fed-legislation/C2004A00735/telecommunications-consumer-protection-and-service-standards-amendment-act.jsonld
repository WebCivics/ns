    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Levy distribution for 1999-2000 financial year",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-5-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.115",
      "values:originalText": "Items 3 to 6 of this Schedule apply if section 86 of the former law\nprevents a payment being made out of the Universal Service Account\nfor the 1999-2000 financial year because of either or both of the\nfollowing:\n\n(a) the ACA has not yet made a written assessment under\nsection 64 of the former law for that year;\n\n(b) not all participating carriers in respect of which levy was\nassessed have paid the levy.\nNote:\nThe operation of the former law for the 1999-2000 financial year is preserved by item 1\nof Schedule 2 to this Act.",
      "skos:definition": "Items 3 to 6 of this Schedule apply if section 86 of the former law\nprevents a payment being made out of the Universal Service Account\nfor the 1999-2000 financial year because of either or both of the\nfollowing:\n\n(a) the ACA has not yet made a written assessment under\nsection 64 of the former law for that year;\n\n(b) not all participating carriers in respect of which levy was\nassessed have paid the levy.\nNote:\nThe operation of the former law for the 1999-2000 financial year is preserved by item 1\nof Schedule 2 to this Act.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-2-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8a01b4dd7c8e1f185a4392cd0d5e7276262f4b6b0e53e4d35e2d16d12612f3ae",
      "skos:note": "Payment of levy if ACA assessment not made or carriers pay levy"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-5-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Levy distribution for 1999-2000 financial year",
      "values:kind": "section",
      "cof:pageNumber": 115,
      "values:originalText": "Items 3 to 6 of this Schedule apply if section 86 of the former law\nprevents a payment being made out of the Universal Service Account\nfor the 1999-2000 financial year because of either or both of the\nfollowing:\n\n(a) the ACA has not yet made a written assessment under\nsection 64 of the former law for that year;\n\n(b) not all participating carriers in respect of which levy was\nassessed have paid the levy.\nNote:\nThe operation of the former law for the 1999-2000 financial year is preserved by item 1\nof Schedule 2 to this Act."
    },
    {
