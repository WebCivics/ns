        }
      ],
      "cml:integrityHash": "fec683abb78fc7a9c99bdbb8fe86505139e0a20a0a8e4b69df86d1aaf31b8ee7",
      "skos:note": "Minister or ACA must publish notices in the Gazette as required by a provision of this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-23b",
      "@type": "cof:Section",
      "cof:title": "23B Effect of failure to publish notices in the Gazette",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "A failure by the Minister or the ACA to publish a notice in the\nGazette as required by a provision of this Act does not affect the\nvalidity of anything else done in accordance with this Act."
    },
