    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20s",
      "@type": "cml:Concept",
      "skos:prefLabel": "20S Levy debit balance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.83",
      "values:originalText": "If a person’s levy debit (if any) under section 20R for a claim\nperiod exceeds the person’s assessed levy credit (if any) under\nsection 20N for the claim period, then:\n\n(a) the person has a levy debit balance for the period; and\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "If a person’s levy debit (if any) under section 20R for a claim\nperiod exceeds the person’s assessed levy credit (if any) under\nsection 20N for the claim period, then:\n\n(a) the person has a levy debit balance for the period; and\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20s-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20s-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b5f0caed4f38bb7e628e5eb14909311bb1c584d7345abb5540755c41dc0e7d16",
      "skos:note": "If levy debit exceeds assessed levy credit, person has a levy debit balance."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20s",
      "@type": "cof:Section",
      "cof:title": "20S Levy debit balance",
      "values:kind": "section",
      "cof:pageNumber": 83,
      "values:originalText": "If a person’s levy debit (if any) under section 20R for a claim\nperiod exceeds the person’s assessed levy credit (if any) under\nsection 20N for the claim period, then:\n\n(a) the person has a levy debit balance for the period; and\n\nSchedule 1  New Part 2 of the Telecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
