    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-86",
      "@type": "cof:Section",
      "cof:title": "86 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 90,
      "values:originalText": "(No. 2) 2000       No. 142, 2000"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-86-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-86"
      },
