    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-15m",
      "@type": "cml:Concept",
      "skos:prefLabel": "15M Notice of decision on variation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-15m"
      },
      "cml:curationStatus": {
