    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-13g-ss-3",
      "@type": "cof:Section",
      "cof:title": "13G(3) Minister may determine requirements for drafts",
      "values:kind": "subsection",
      "cof:pageNumber": 48,
      "values:originalText": "(3) A determination under subsection (1) is a disallowable instrument\nfor the purposes of section 46A of the Acts Interpretation Act 1901.\n\nNew Part 2 of the Telecommunications (Consumer Protection and Service Standards)\nAct 1999  Schedule 1\n\nTelecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000\nNo. 142, 2000            45"
    },
