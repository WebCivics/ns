      },
      "cml:premiseText": "(iii) costs incurred by the Commonwealth during the period in collecting, compiling, analysing and publishing information about the operation of that Act and this Division."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-21b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "21B(2) Purposes of Universal Service Account",
