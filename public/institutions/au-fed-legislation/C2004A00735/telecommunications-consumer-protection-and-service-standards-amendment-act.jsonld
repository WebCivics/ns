      "skos:note": "Minister must determine universal service areas before making determination under section 11C"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-11f-ss-3",
      "@type": "cof:Section",
      "cof:title": "11F(3) Section 11C temporarily limited to pilot areas",
