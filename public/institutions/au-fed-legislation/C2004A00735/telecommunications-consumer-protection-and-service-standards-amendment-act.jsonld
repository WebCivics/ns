    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.38",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(a) timeframes for the supply of specified equipment, goods or\nservices;\n\n(b) performance standards relating to the fulfilment of the\nuniversal service obligation;\n\n(c) processes for advising persons about the availability, offer\nand supply of equipment, goods or services in the fulfilment\nof the universal service obligation, and the terms and\nconditions on which the equipment, goods or services are\noffered or supplied;\n\n(d) the form of a draft ATS marketing plan.\n\n(3) A determination under subsection (1) is a disallowable instrument\nfor the purposes of section 46A of the Acts Interpretation Act 1901.",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\n\n(a) timeframes for the supply of specified equipment, goods or\nservices;\n\n(b) performance standards relating to the fulfilment of the\nuniversal service obligation;\n\n(c) processes for advising persons about the availability, offer\nand supply of equipment, goods or services in the fulfilment\nof the universal service obligation, and the terms and\nconditions on which the equipment, goods or services are\noffered or supplied;\n\n(d) the form of a draft ATS marketing plan.\n\n(3) A determination under subsection (1) is a disallowable instrument\nfor the purposes of section 46A of the Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-34-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-34-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7ce117fcaab77652b5bb7b8d2a818c33f27db7a7fa47472b75b686cc1e439afe",
      "skos:note": "Regulates timeframes for supply of equipment, goods or services; performance standards for universal service obligation; processes for advising persons about availability and terms and conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(a) timeframes for the supply of specified equipment, goods or\nservices;\n\n(b) performance standards relating to the fulfilment of the\nuniversal service obligation;\n\n(c) processes for advising persons about the availability, offer\nand supply of equipment, goods or services in the fulfilment\nof the universal service obligation, and the terms and\nconditions on which the equipment, goods or services are\noffered or supplied;\n\n(d) the form of a draft ATS marketing plan.\n\n(3) A determination under subsection (1) is a disallowable instrument\nfor the purposes of section 46A of the Acts Interpretation Act 1901."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-34-norm",
      "@type": "values:Obligation",
      "cml:modality": {
