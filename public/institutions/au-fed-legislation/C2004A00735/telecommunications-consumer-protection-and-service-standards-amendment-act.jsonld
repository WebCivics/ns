      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.116",
      "values:originalText": "Despite paragraph 86(b) of the former law, an amount is payable from\nthe Universal Service Account for the 1999-2000 financial year even if\nall of the participating carriers in respect of which the levy was assessed\nhave not yet paid the levy.",
      "skos:definition": "Despite paragraph 86(b) of the former law, an amount is payable from\nthe Universal Service Account for the 1999-2000 financial year even if\nall of the participating carriers in respect of which the levy was assessed\nhave not yet paid the levy.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-5-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-5-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7fa4961c60cab5e2db3fd7387504a4d014a4a3dfe73b568d0cb8296fcf532559",
      "skos:note": "Payable despite non-payment by carriers"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-5-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Distributions before all levies have been paid",
      "values:kind": "section",
      "cof:pageNumber": 116,
      "values:originalText": "Despite paragraph 86(b) of the former law, an amount is payable from\nthe Universal Service Account for the 1999-2000 financial year even if\nall of the participating carriers in respect of which the levy was assessed\nhave not yet paid the levy."
    },
    {
