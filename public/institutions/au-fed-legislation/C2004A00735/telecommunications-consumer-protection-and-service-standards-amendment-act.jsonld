    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-12a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "12A(3) Determination of primary universal service providers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-12a-ss-3"
      },
