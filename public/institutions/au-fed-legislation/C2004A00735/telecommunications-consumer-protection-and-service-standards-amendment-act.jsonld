      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.5",
      "values:originalText": "This Act may be cited as the Telecommunications (Consumer\nProtection and Service Standards) Amendment Act (No. 2) 2000.\n\n\n\n2            Telecommunications (Consumer Protection and Service Standards) Amendment Act (No.\n2) 2000       No. 142, 2000",
      "skos:definition": "This Act may be cited as the Telecommunications (Consumer\nProtection and Service Standards) Amendment Act (No. 2) 2000.\n\n\n\n2            Telecommunications (Consumer Protection and Service Standards) Amendment Act (No.\n2) 2000       No. 142, 2000",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sec-1-norm"
        }
      ],
      "cml:integrityHash": "3aa276f812cc3edc767835497f0395a05c418e7665965fabcaed0698c806c5c0",
      "skos:note": "Cites this Act as the Telecommunications (Consumer Protection and Service Standards) Amendment Act (No. 2) 2000."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sec-1",
      "@type": "cof:Section",
