    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-104",
      "@type": "cml:Concept",
      "skos:prefLabel": "104 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-3-sec-104"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.108",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(a) is a participating person for the last eligible revenue period\nthat ends before the start of the quarter; and\n\n(b) is covered by the most recent levy assessment made before\nthe start of the quarter.\nNote:\nThe most recent levy assessment is defined in section 101C.",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\n\n(a) is a participating person for the last eligible revenue period\nthat ends before the start of the quarter; and\n\n(b) is covered by the most recent levy assessment made before\nthe start of the quarter.\nNote:\nThe most recent levy assessment is defined in section 101C.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-104-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-104-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4c68b95a6cb8e0c00f7f62f053ffbfd43bbe71188ea11fc68a8d56921e72bae2",
      "skos:note": "Must be a participating person for the last eligible revenue period and covered by the most recent levy assessment."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-3-sec-104",
      "@type": "cof:Section",
      "cof:title": "104 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(a) is a participating person for the last eligible revenue period\nthat ends before the start of the quarter; and\n\n(b) is covered by the most recent levy assessment made before\nthe start of the quarter.\nNote:\nThe most recent levy assessment is defined in section 101C."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-104-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-104"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-104-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "Mandatory condition",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) is a participating person for the last eligible revenue period that ends before the start of the quarter; and (b) is covered by the most recent levy assessment made before the start of the quarter.",
      "cml:conclusionText": "(a) and (b)"
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Subsection 100(3) (definition of eligible revenue)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-3-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.108",
      "values:originalText": "Repeal the definition, substitute:\neligible revenue, for a taxpayer for a quarter, means the taxpayer’s\neligible revenue as shown in the most recent levy assessment made\nbefore the start of the quarter.\nNote:\nThe most recent levy assessment is defined in section 101C.",
      "skos:definition": "Repeal the definition, substitute:\neligible revenue, for a taxpayer for a quarter, means the taxpayer’s\neligible revenue as shown in the most recent levy assessment made\nbefore the start of the quarter.\nNote:\nThe most recent levy assessment is defined in section 101C.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-11-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-11-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-11-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-11-logic-deontic-3"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-11-logic-argumentation-4"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-11-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "71dfc4f61892c7eac1b16d5dfcd2b43d30653789c23a9df0c602e1f35adb08a4",
      "skos:note": "Taxpayer's eligible revenue for a quarter is the most recent levy assessment made before the start of the quarter."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-3-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Subsection 100(3) (definition of eligible revenue)",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "Repeal the definition, substitute:\neligible revenue, for a taxpayer for a quarter, means the taxpayer’s\neligible revenue as shown in the most recent levy assessment made\nbefore the start of the quarter.\nNote:\nThe most recent levy assessment is defined in section 101C."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-11-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
