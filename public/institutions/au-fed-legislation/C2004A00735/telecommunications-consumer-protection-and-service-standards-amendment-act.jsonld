    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.42",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\npolicy statement in the same terms as the current statement as\nvaried, the ACA would approve that draft; or\n\n(b) in the case of a draft variation of an approved standard\nmarketing plan—if the provider were to give the ACA a draft\nstandard marketing plan in the same terms as the current plan\nas varied, the ACA would approve that draft; or\n\n(c) in the case of a draft variation of an approved ATS marketing\nplan—if the provider were to give the ACA a draft ATS\nmarketing plan in the same terms as the current plan as\nvaried, the ACA would approve that draft.",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\npolicy statement in the same terms as the current statement as\nvaried, the ACA would approve that draft; or\n\n(b) in the case of a draft variation of an approved standard\nmarketing plan—if the provider were to give the ACA a draft\nstandard marketing plan in the same terms as the current plan\nas varied, the ACA would approve that draft; or\n\n(c) in the case of a draft variation of an approved ATS marketing\nplan—if the provider were to give the ACA a draft ATS\nmarketing plan in the same terms as the current plan as\nvaried, the ACA would approve that draft.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-38-norm"
        }
      ],
      "cml:integrityHash": "6de3d306960715eb479db8e1808fe910d4f1e2dad57ef3395a4575f954ef5b74",
      "skos:note": "Approval process for draft variations of approved standards and marketing plans."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-38",
      "@type": "cof:Section",
      "cof:title": "38 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "(No. 2) 2000       No. 142, 2000\npolicy statement in the same terms as the current statement as\nvaried, the ACA would approve that draft; or\n\n(b) in the case of a draft variation of an approved standard\nmarketing plan—if the provider were to give the ACA a draft\nstandard marketing plan in the same terms as the current plan\nas varied, the ACA would approve that draft; or\n\n(c) in the case of a draft variation of an approved ATS marketing\nplan—if the provider were to give the ACA a draft ATS\nmarketing plan in the same terms as the current plan as\nvaried, the ACA would approve that draft."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-38-norm",
