      "cml:integrityHash": "984c663e1eef925c5fe68acf59650fca3d9c6ecdeec7f6cf71bae90d40c4cf93",
      "skos:note": "Failure to lodge eligible revenue return is an offence that must be repeated for each day of non-compliance."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-23c-ss-2",
      "@type": "cof:Section",
      "cof:title": "23C(2) Offence of failing to lodge eligible revenue return",
      "values:kind": "subsection",
      "cof:pageNumber": 96,
      "values:originalText": "(2) A person who is guilty of an offence under subsection (1) is guilty\nof a separate offence in respect of each day on which the failure\ncontinues (including the day of a conviction for the offence or any\nlater day)."
    },
