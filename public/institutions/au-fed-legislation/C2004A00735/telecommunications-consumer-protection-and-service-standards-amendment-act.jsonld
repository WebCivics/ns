      ],
      "cml:integrityHash": "5302c26e9caea6813505b3c57509cefd33741ae66ff5b06cb7cdbd0a2f1c8041",
      "skos:note": "Must fulfill other obligations when fulfilling a contestable service obligation"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-13d-ss-2",
      "@type": "cof:Section",
      "cof:title": "13D(2) Obligations of competing universal service providers",
      "values:kind": "subsection",
      "cof:pageNumber": 46,
      "values:originalText": "(2) A competing universal service provider for a universal service area\nin respect of a contestable service obligation, who fulfils that\nservice obligation by supplying alternative telecommunications\nservices in accordance with an approved ATS marketing plan, is\ntaken to have fulfilled any other obligation that arises under this\nAct because of that service obligation to the extent that the other\nobligation applies to the supply of alternative telecommunications\nservices."
    },
