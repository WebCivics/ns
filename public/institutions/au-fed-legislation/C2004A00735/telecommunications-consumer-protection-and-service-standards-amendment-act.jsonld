    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Subsection 5(2)",
      "cml:realizedBy": {
