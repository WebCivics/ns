    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.60",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\nduring a claim period is a digital data service provider for the claim\nperiod.\n\n(3) For the purposes of this Part, the areas for which a person is a\ndigital data service provider are taken to be a single area.\n\n(4) A general digital data service provider for a general digital data\nservice area must take all reasonable steps to fulfil the general\ndigital data service obligation, so far as the obligation relates to\nthat area.\n\n(5) A special digital data service provider for a special digital data\nservice area must take all reasonable steps to fulfil the special\ndigital data service obligation, so far as the obligation relates to\nthat area.",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\nduring a claim period is a digital data service provider for the claim\nperiod.\n\n(3) For the purposes of this Part, the areas for which a person is a\ndigital data service provider are taken to be a single area.\n\n(4) A general digital data service provider for a general digital data\nservice area must take all reasonable steps to fulfil the general\ndigital data service obligation, so far as the obligation relates to\nthat area.\n\n(5) A special digital data service provider for a special digital data\nservice area must take all reasonable steps to fulfil the special\ndigital data service obligation, so far as the obligation relates to\nthat area.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-56-ss-3"
        },
        {
