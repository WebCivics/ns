      ],
      "cml:integrityHash": "b3f6ec2620e8542345b71dff6b6c18e22cfa63c2e76b57bf0eba2d97fbe29da4",
      "skos:note": "Modifies provisions by excluding their application entirely, omitting, adding, or substituting them."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-54",
