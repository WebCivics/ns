    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-20zb",
      "@type": "cof:Section",
      "cof:title": "20ZB Validity of assessment",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "The validity of an assessment under this Division is not affected by\na contravention of this Act."
    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-20zb-norm",
      "@type": "values:Obligation",
      "cml:modality": {
