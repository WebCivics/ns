    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 After subsection 107(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-3-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.110",
      "values:originalText": "Insert:\n\n(6A) However, subsection (6) does not apply if obligations arising under\none or any combination of the following:\n\n(a) one or more agreements;\n\n(b) this Act or the Telecommunications Act 1997;\n\n(c) one or more disallowable instruments under this Act (other\nthan regulations under subsection (2)) or the\nTelecommunications Act 1997;\nhave the effect of providing a scheme to give benefits of a kind\nmentioned in subsection (2).",
      "skos:definition": "Insert:\n\n(6A) However, subsection (6) does not apply if obligations arising under\none or any combination of the following:\n\n(a) one or more agreements;\n\n(b) this Act or the Telecommunications Act 1997;\n\n(c) one or more disallowable instruments under this Act (other\nthan regulations under subsection (2)) or the\nTelecommunications Act 1997;\nhave the effect of providing a scheme to give benefits of a kind\nmentioned in subsection (2).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-14-norm"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-3-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "691c4bb0657408f793c62c641484397164fd0fcf245825a39f02e61820173135",
      "skos:note": "Exemptions from subsection (6) based on agreements, Acts, or disallowable instruments"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-3-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 After subsection 107(6)",
      "values:kind": "section",
      "cof:pageNumber": 110,
      "values:originalText": "Insert:\n\n(6A) However, subsection (6) does not apply if obligations arising under\none or any combination of the following:\n\n(a) one or more agreements;\n\n(b) this Act or the Telecommunications Act 1997;\n\n(c) one or more disallowable instruments under this Act (other\nthan regulations under subsection (2)) or the\nTelecommunications Act 1997;\nhave the effect of providing a scheme to give benefits of a kind\nmentioned in subsection (2)."
    },
