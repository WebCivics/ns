    },
    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-16b",
      "@type": "cml:Concept",
      "skos:prefLabel": "16B Effect of the determination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-16b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.68",
      "values:originalText": "(1) A determination under section 16 takes effect on the day specified\nin the determination (which may be before, on or after the day on\nwhich the determination is made).\n\n(2) A determination under section 16 applies for the period specified in\nthe determination, which must not be longer than 3 years.\n\n(3) A variation or revocation of such a determination takes effect on\nthe day specified for the purpose in the instrument of variation or\nrevocation (which may be before, on or after the day on which the\ninstrument is made).",
      "skos:definition": "(1) A determination under section 16 takes effect on the day specified\nin the determination (which may be before, on or after the day on\nwhich the determination is made).\n\n(2) A determination under section 16 applies for the period specified in\nthe determination, which must not be longer than 3 years.\n\n(3) A variation or revocation of such a determination takes effect on\nthe day specified for the purpose in the instrument of variation or\nrevocation (which may be before, on or after the day on which the\ninstrument is made).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-16b-ss-1"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-16b-ss-2"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-16b-ss-3"
        }
      ],
      "cml:integrityHash": "32bf2a0c72e2a248c3fb6daa54c849bc0046048de512a0ee4229a0e74be685aa"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-16b",
      "@type": "cof:Section",
      "cof:title": "16B Effect of the determination",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "(1) A determination under section 16 takes effect on the day specified\nin the determination (which may be before, on or after the day on\nwhich the determination is made).\n\n(2) A determination under section 16 applies for the period specified in\nthe determination, which must not be longer than 3 years.\n\n(3) A variation or revocation of such a determination takes effect on\nthe day specified for the purpose in the instrument of variation or\nrevocation (which may be before, on or after the day on which the\ninstrument is made)."
    },
