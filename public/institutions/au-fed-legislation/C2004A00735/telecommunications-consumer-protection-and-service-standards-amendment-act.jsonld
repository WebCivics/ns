    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-22d",
      "@type": "cml:Concept",
      "skos:prefLabel": "22D Minister may modify way in which this Division applies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-22d"
