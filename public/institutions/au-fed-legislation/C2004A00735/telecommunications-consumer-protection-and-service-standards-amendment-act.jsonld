    {
      "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-66",
      "@type": "cml:Concept",
      "skos:prefLabel": "66 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-66"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.70",
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(ii) was supplied by the person during the claim period to\npersons in the area; and\n\n(b) the total rebates that became payable during the claim period\nby the person, in accordance with regulations made for the\npurposes of subsection 10D(1), in respect of customer\nequipment acquired or hired by persons in the area.\n\n(4) The Minister may make a written determination specifying a\nmethod of ascertaining an amount for the purposes of\nparagraph (1)(a).\n\n(5) The amount worked out under such a determination may be zero.\n\n(6) A copy of a determination under subsection (4) must be published\nin the Gazette.",
      "skos:definition": "(No. 2) 2000       No. 142, 2000\n\n(ii) was supplied by the person during the claim period to\npersons in the area; and\n\n(b) the total rebates that became payable during the claim period\nby the person, in accordance with regulations made for the\npurposes of subsection 10D(1), in respect of customer\nequipment acquired or hired by persons in the area.\n\n(4) The Minister may make a written determination specifying a\nmethod of ascertaining an amount for the purposes of\nparagraph (1)(a).\n\n(5) The amount worked out under such a determination may be zero.\n\n(6) A copy of a determination under subsection (4) must be published\nin the Gazette.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-66-ss-4"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-66-ss-5"
        },
        {
          "@id": "concept:telecommunications-consumer-protection-and-service-standards-amendment-act-sch-1-sec-66-ss-6"
        }
      ],
      "cml:integrityHash": "f76a9c9837e161c62706bbd42a7824e6d60e69ec7aa850b2b5e250f098fa5337"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-consumer-protection-and-service-standards-amendment-act#sch-1-sec-66",
      "@type": "cof:Section",
      "cof:title": "66 Telecommunications (Consumer Protection and Service Standards) Amendment Act",
      "values:kind": "section",
      "cof:pageNumber": 70,
      "values:originalText": "(No. 2) 2000       No. 142, 2000\n\n(ii) was supplied by the person during the claim period to\npersons in the area; and\n\n(b) the total rebates that became payable during the claim period\nby the person, in accordance with regulations made for the\npurposes of subsection 10D(1), in respect of customer\nequipment acquired or hired by persons in the area.\n\n(4) The Minister may make a written determination specifying a\nmethod of ascertaining an amount for the purposes of\nparagraph (1)(a).\n\n(5) The amount worked out under such a determination may be zero.\n\n(6) A copy of a determination under subsection (4) must be published\nin the Gazette."
    },
