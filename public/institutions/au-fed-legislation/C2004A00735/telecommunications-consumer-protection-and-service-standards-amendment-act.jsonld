      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf"
      },
      "dc:source": "telecommunications-consumer-protection-and-service-standards-amendment-act.pdf, p.115",
      "values:originalText": "In this Schedule:\nformer law means the Telecommunications (Consumer Protection and\nService Standards) Act 1999 as in force immediately before the\ncommencement of Schedule 1 to this Act.",
      "skos:definition": "In this Schedule:\nformer law means the Telecommunications (Consumer Protection and\nService Standards) Act 1999 as in force immediately before the\ncommencement of Schedule 1 to this Act.",
