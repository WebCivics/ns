    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3d-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval of the authorised person's presence overlaps with the temporal interval of the occupier's or person in charge's request.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(3D) If an authorised person is on premises..."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3d-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The cognitive system of the occupier or person in charge recognises the obligation to leave the premises.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Cognitive recognition",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognises",
      "cml:premiseText": "(3D) If an authorised person is on premises..."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3d-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The authorised person must leave the premises.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:premiseText": "(3D) If an authorised person is on premises..."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3d-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The diffusion of the obligation to leave the premises occurs when the occupier or person in charge requests it.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion of obligation",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "(3D) If an authorised person is on premises..."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3d-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval of the occupier's or person in charge's request occurs before the temporal interval of the authorised person's presence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal until condition",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(3D) If an authorised person is on premises..."
    },
