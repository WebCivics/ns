      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The business's annual turnover for the previous financial year must be $3,000,000 or less.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
