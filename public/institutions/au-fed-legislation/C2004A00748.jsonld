      },
      "cml:operator": "=",
      "cml:premiseText": "The test time is a financial year (the current year)."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The business is a small business at the test time if its annual turnover for the current year is $3,000,000 or less.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Business is obligated to meet the annual turnover threshold.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Annual turnover for the previous financial year is $3,000,000 or less."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The business's classification as a small business operator depends on meeting the annual turnover threshold.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Business classification affects its status as a small business operator.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "=",
      "cml:premiseText": "A business is considered a small business operator if it meets the annual turnover threshold."
    },
