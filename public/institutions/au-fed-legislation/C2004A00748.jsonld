    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-7c-ss-6-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Parliament means: (a) the Parliament of the Commonwealth; or (b) a State Parliament; or (c) the legislature of a Territory.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for electoral law and Parliament",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "electoral law means a law of the Commonwealth, or a law of a State or Territory, relating to elections to a Parliament or to a local government authority."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-7c-ss-6-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for Parliament",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(a) the Parliament of the Commonwealth; or (b) a State Parliament; or (c) the legislature of a Territory."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-7c-ss-6-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
