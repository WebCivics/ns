      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It implies that the organisation must meet these conditions if it wants to operate extra-territorially.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
