    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106",
      "@type": "cml:Concept",
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.64",
      "skos:note": "Journalist has a reasonable excuse to keep confidential the identity of an informant.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "106 After subsection 66(1)"
      },
      "wasDerivedFrom": "privacy-amendment-private-sector-act-2000.pdf",
      "asserts": [
        "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-norm",
        "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-deontic-1",
        "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-alleninterval-2",
        "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-ltl-3",
        "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-diffusion-4",
        "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "3d63bcb3fbe69d938867311d9d387e1e8d88be66ac5b0d8ca00d4f3249357ece",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:privacy-amendment-private-sector-act-2000#sch-1-sec-106",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is a temporal overlap: The journalist's reasonable excuse overlaps with the time when giving information would reveal the identity of an informant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap: The journalist's reasonable excuse overlaps with the time when giving information would reveal the identity of an informant.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The journalist has a reasonable excuse."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is a CogAI inference: The journalist's reasonable excuse can be inferred from the fact that they have a reasonable excuse.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "CogAI inference: The journalist's reasonable excuse can be inferred from the fact that they have a reasonable excuse.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "The journalist has a reasonable excuse."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to keep confidential the identity of an informant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to keep confidential the identity of an informant.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The journalist has a reasonable excuse."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is a diffusion: The journalist's reasonable excuse diffuses to all situations where giving information would tend to reveal the identity of an informant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion: The journalist's reasonable excuse diffuses to all situations where giving information would tend to reveal the identity of an informant.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "The journalist has a reasonable excuse."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is a temporal until: The journalist's reasonable excuse holds until the time when giving information would reveal the identity of an informant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal until: The journalist's reasonable excuse holds until the time when giving information would reveal the identity of an informant.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "The journalist has a reasonable excuse."
    },
