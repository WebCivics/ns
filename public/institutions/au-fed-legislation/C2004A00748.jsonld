      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the organisation does not meet these conditions, it is not entitled to operate extra-territorially.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
