      "cml:logicSummary": "Annual turnover threshold applies to a specific time period (previous financial year).",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "=",
      "cml:premiseText": "The test time is a financial year (the current year)."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The business's annual turnover for the previous financial year must be $3,000,000 or less to be classified as small.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Business classification uses artificial intelligence to determine eligibility.",
      "cml:modality": {
