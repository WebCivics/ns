      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The personal information was collected or held by the organisation before or at the time of the act or practice."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-3-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It implies that the organisation must meet conditions (b) and (c).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
