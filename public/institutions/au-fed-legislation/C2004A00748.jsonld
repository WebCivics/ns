      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-2",
      "@type": "cml:Concept",
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.22",
      "skos:note": "Business is a small business if annual turnover for the current year is $3,000,000 or less.",
      "skos:prefLabel": {
        "@language": "en",
