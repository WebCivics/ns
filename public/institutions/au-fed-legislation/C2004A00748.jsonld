    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner's action must be taken because of subsection (1).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Subsection (1) is a condition for extra-territorial operation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "because of",
      "cml:premiseText": "Part V of this Act has extra-territorial operation because of subsection (1)"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Commissioner must take action overseas for complaints and investigations.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Commissioner has obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "Part V of this Act has extra-territorial operation"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner has permission to investigate complaints and practices.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Commissioner is allowed to take action overseas for complaints and investigations.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "lets",
      "cml:premiseText": "This lets the Commissioner take action overseas"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner's action must be taken within the context of extra-territorial operation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Ancillary provisions of Part V operate in the context of extra-territorial operation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "operates in that context",
      "cml:premiseText": "This lets the Commissioner take action overseas to investigate complaints and lets the ancillary provisions of Part V operate in that context."
    },
