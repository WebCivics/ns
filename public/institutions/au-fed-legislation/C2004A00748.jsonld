      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If there was no time in the previous financial year when the business was carried on, then the business is a small business at the test time only if its annual turnover for the current year is $3,000,000 or less.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
