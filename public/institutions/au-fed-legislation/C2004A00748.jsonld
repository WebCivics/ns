      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The organisation's action meets the Commonwealth contract obligation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relationship between obligations",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "meets",
      "cml:premiseText": "Subsection (1A) does not prevent an individual from complaining under this Part to the Commissioner about an act done, or practice engaged in, by an organisation."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-74-ss-1c-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An individual can complain about an act done by an organisation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Ability to perform an action",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:premiseText": "Subsection (1A) does not prevent an individual from complaining under this Part."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-74-ss-1c-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The adjudicator must refer the complaint.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requirement for an adjudicator to refer a complaint",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must refer",
      "cml:premiseText": "Section 40A requires an adjudicator for an approved privacy code to refer a code complaint to the Commissioner if the complaint is about an act or practice of a contracted service provider for a Commonwealth contract."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-74-ss-1c-logic-deontic-4",
