      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The new partnership's use of personal information may breach National Privacy Principle 2.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "breaches",
      "cml:premiseText": "For example, the new partnership’s use of Schedule 1 Amendment of the Privacy Act 1988 personal information collected from the old partnership may constitute an interference with privacy if it breaches National Privacy Principle 2 or a corresponding provision in a binding approved privacy code."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-13c-ss-1-logic-deontic-4",
