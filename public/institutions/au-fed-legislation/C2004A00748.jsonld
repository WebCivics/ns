      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is a specific type of organisation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
