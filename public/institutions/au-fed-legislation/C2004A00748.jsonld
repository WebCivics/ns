      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The business was carried on in the previous financial year if its annual turnover for the current year is $3,000,000 or less.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
