concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80a-ss-1 cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80a-ss-1-logic-deontic-1 .
concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80a-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Agency or organisation must comply with privacy principles." ;
    cml:premiseText "(a) the act or practice of an agency or organisation that is the subject of an application under section 73 for a determination under section 72 breaches, or may breach: ..." ;
    cml:conclusionText "...the public interest in adhering to that Principle or code; and (b) the public interest in the agency or organisation doing the act, or engaging in the practice, outweighs to a substantial degree the public interest in adhering to that Principle or code;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

