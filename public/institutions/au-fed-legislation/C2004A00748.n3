    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy for electoral law and Parliament" ;
    cml:premiseText "electoral law means a law of the Commonwealth, or a law of a State or Territory, relating to elections to a Parliament or to a local government authority." ;
    cml:conclusionText "Parliament means: (a) the Parliament of the Commonwealth; or (b) a State Parliament; or (c) the legislature of a Territory." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

