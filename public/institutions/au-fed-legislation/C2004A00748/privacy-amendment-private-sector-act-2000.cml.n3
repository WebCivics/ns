concept:privacy-amendment-private-sector-act-2000-sch-1-sec-95-ss-3b a cml:Concept ;
    skos:prefLabel "95(3B) Subsection 52(3A)"@en ;
    cml:realizedBy doc:sch-1-sec-95-ss-3b ;
