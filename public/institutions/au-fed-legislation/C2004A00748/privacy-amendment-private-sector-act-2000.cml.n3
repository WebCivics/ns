concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-6 a cml:Concept ;
    skos:prefLabel "6D(6) Small business and small business operators"@en ;
    cml:realizedBy doc:sch-1-sec-6d-ss-6 ;
    values:originalText "(6) Subsection (4) does not prevent a body corporate, partnership, unincorporated association or trust from being a small business operator merely because it does something described in paragraph (4)(b), (c) or (d) otherwise than in the course of a business it carries on. Disclosure compelled or made with consent" ;
    skos:definition "(6) Subsection (4) does not prevent a body corporate, partnership, unincorporated association or trust from being a small business operator merely because it does something described in paragraph (4)(b), (c) or (d) otherwise than in the course of a business it carries on. Disclosure compelled or made with consent"@en ;
    cml:integrityHash "87bc4c072aa6faa9178b7d14263566b3faafd8255b55df8ffc8e477bbc73cd8b" ;
    values:partOf concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Small business operators are exempt from disclosure requirements." ;
