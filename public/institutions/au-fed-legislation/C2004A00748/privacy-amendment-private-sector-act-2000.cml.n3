concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4 a cml:Concept ;
    skos:prefLabel "7 2 An organisation must not use or disclose an identifier assigned to"@en ;
    cml:realizedBy doc:sch-3-sec-7-4 ;
    values:originalText "an individual by an agency, or by an agent or contracted service provider mentioned in subclause 7.1, unless:  (a) the use or disclosure is necessary for the organisation to fulfil its obligations to the agency; or  (b) one or more of paragraphs 2.1(e) to 2.1(h) (inclusive) apply to the use or disclosure; or  (c) the use or disclosure is by a prescribed organisation of a prescribed identifier in prescribed circumstances. Note: There are prerequisites that must be satisfied before the matters mentioned in paragraph (c) are prescribed: see subsection 100(2)." ;
    skos:definition "an individual by an agency, or by an agent or contracted service provider mentioned in subclause 7.1, unless:  (a) the use or disclosure is necessary for the organisation to fulfil its obligations to the agency; or  (b) one or more of paragraphs 2.1(e) to 2.1(h) (inclusive) apply to the use or disclosure; or  (c) the use or disclosure is by a prescribed organisation of a prescribed identifier in prescribed circumstances. Note: There are prerequisites that must be satisfied before the matters mentioned in paragraph (c) are prescribed: see subsection 100(2)."@en ;
    cml:integrityHash "0817f2aec2b6c476ad1662e0b812c32466e3e19df0ffe94f1824824db9d8e870" ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Organisation must not use or disclose an identifier assigned to an individual without certain exceptions." ;
    cml:curationStatus cml:Proposed ;
