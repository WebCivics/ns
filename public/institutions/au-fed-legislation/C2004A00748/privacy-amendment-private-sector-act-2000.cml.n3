doc:sch-1-sec-12b-ss-3 a cof:Section ;
    cof:title "12B(3) Severability: additional effect of Act in relation to organisations" ;
    values:kind "subsection" ;
    values:originalText "(3) This Act also has the effect it would have if its operation in relation to organisations were expressly confined to acts or practices covered by subsection 5B(1) (which deals with acts and practices outside Australia and the external Territories by organisations)." ;
    cof:pageNumber "33"^^xsd:integer .

