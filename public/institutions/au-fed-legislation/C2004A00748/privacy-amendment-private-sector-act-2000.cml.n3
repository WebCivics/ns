    cml:premiseText "Organisation may collect health information under certain conditions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-3-sec-10-3 a cof:Section ;
    cof:title "10 2 Despite subclause 10.1, an organisation may collect health" ;
    values:kind "section" ;
    values:originalText "information about an individual if:  (a) the information is necessary to provide a health service to the individual; and  (b) the information is collected:  (i) as required by law (other than this Act); or  (ii) in accordance with rules established by competent health or medical bodies that deal with obligations of professional confidentiality which bind the organisation." ;
    cof:pageNumber "86"^^xsd:integer .

concept:privacy-amendment-private-sector-act-2000-sch-3-sec-10-4 a cml:Concept ;
    skos:prefLabel "10 3 Despite subclause 10.1, an organisation may collect health"@en ;
    cml:realizedBy doc:sch-3-sec-10-4 ;
    values:originalText "information about an individual if:  (a) the collection is necessary for any of the following purposes:  (i) research relevant to public health or public safety;  (ii) the compilation or analysis of statistics relevant to public health or public safety;  (iii) the management, funding or monitoring of a health service; and  (b) that purpose cannot be served by the collection of information that does not identify the individual or from  Amendment of the Privacy Act 1988  Schedule 1  which the individual’s identity cannot reasonably be ascertained; and  (c) it is impracticable for the organisation to seek the individual’s consent to the collection; and  (d) the information is collected:  (i) as required by law (other than this Act); or  (ii) in accordance with rules established by competent health or medical bodies that deal with obligations of professional confidentiality which bind the organisation; or  (iii) in accordance with guidelines approved by the Commissioner under section 95A for the purposes of this subparagraph." ;
    skos:definition "information about an individual if:  (a) the collection is necessary for any of the following purposes:  (i) research relevant to public health or public safety;  (ii) the compilation or analysis of statistics relevant to public health or public safety;  (iii) the management, funding or monitoring of a health service; and  (b) that purpose cannot be served by the collection of information that does not identify the individual or from  Amendment of the Privacy Act 1988  Schedule 1  which the individual’s identity cannot reasonably be ascertained; and  (c) it is impracticable for the organisation to seek the individual’s consent to the collection; and  (d) the information is collected:  (i) as required by law (other than this Act); or  (ii) in accordance with rules established by competent health or medical bodies that deal with obligations of professional confidentiality which bind the organisation; or  (iii) in accordance with guidelines approved by the Commissioner under section 95A for the purposes of this subparagraph."@en ;
    cml:integrityHash "7f1c6e7b6bc0742859d4b0cfc5a2c6e0e402a3f630a0e9bfc8903d2a13ce56c8" ;
