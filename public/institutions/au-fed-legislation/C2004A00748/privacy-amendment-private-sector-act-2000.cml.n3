concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes a duty on the state to treat partners as if they were the organisation." ;
