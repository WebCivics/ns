concept:privacy-amendment-private-sector-act-2000-sch-1-sec-30 a cml:Concept ;
    skos:prefLabel "30 Subsection 6(1)"@en ;
    cml:realizedBy doc:sch-1-sec-30 ;
    values:originalText "Insert: State contract means a contract, to which a State or Territory or State or Territory authority is or was a party, under which services are to be, or were to be, provided to a State or Territory authority. Note: See also subsection (9) about provision of services to a State or Territory authority." ;
