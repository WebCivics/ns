concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111 a cml:Concept ;
    skos:prefLabel "111 After subsection 68(3)"@en ;
    cml:realizedBy doc:sch-1-sec-111 ;
    values:originalText "Insert:  (3A) Before obtaining the consent, the authorised person must inform the occupier or person in charge that he or she may refuse to consent.  (3B) An entry by an authorised person with the consent of the occupier or person in charge is not lawful if the consent was not voluntary.  (3C) The authorised person may not enter premises (other than premises occupied by an agency) if:  (a) the occupant or person in charge asks the authorised person to produce his or her identity card; and  (b) the authorised person does not produce it.  (3D) If an authorised person is on premises with the consent of the occupier or person in charge, the authorised person must leave the premises if the occupier or person in charge asks the authorised person to do so." ;
    skos:definition "Insert:  (3A) Before obtaining the consent, the authorised person must inform the occupier or person in charge that he or she may refuse to consent.  (3B) An entry by an authorised person with the consent of the occupier or person in charge is not lawful if the consent was not voluntary.  (3C) The authorised person may not enter premises (other than premises occupied by an agency) if:  (a) the occupant or person in charge asks the authorised person to produce his or her identity card; and  (b) the authorised person does not produce it.  (3D) If an authorised person is on premises with the consent of the occupier or person in charge, the authorised person must leave the premises if the occupier or person in charge asks the authorised person to do so."@en ;
    cml:integrityHash "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4" ;
    cof:pageNumber "65"^^xsd:integer ;
    cml:hasPart concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3a ;
    cml:hasPart concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3b ;
    cml:hasPart concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3c ;
    cml:hasPart concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3d ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-private-sector-act-2000.pdf> ;
    dc:source "privacy-amendment-private-sector-act-2000.pdf, p.65" .
doc:sch-1-sec-111 a cof:Section ;
    cof:title "111 After subsection 68(3)" ;
    values:kind "section" ;
    values:originalText "Insert:  (3A) Before obtaining the consent, the authorised person must inform the occupier or person in charge that he or she may refuse to consent.  (3B) An entry by an authorised person with the consent of the occupier or person in charge is not lawful if the consent was not voluntary.  (3C) The authorised person may not enter premises (other than premises occupied by an agency) if:  (a) the occupant or person in charge asks the authorised person to produce his or her identity card; and  (b) the authorised person does not produce it.  (3D) If an authorised person is on premises with the consent of the occupier or person in charge, the authorised person must leave the premises if the occupier or person in charge asks the authorised person to do so." ;
    cof:pageNumber "65"^^xsd:integer .

