concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-9 a cml:Concept ;
    skos:prefLabel "6D(9) Small business and small business operators"@en ;
    cml:realizedBy doc:sch-1-sec-6d-ss-9 ;
    values:originalText "(9) Despite subsection (3), a body corporate is not a small business operator if it is related to a body corporate that carries on a business that is not a small business." ;
    skos:definition "(9) Despite subsection (3), a body corporate is not a small business operator if it is related to a body corporate that carries on a business that is not a small business."@en ;
    cml:integrityHash "140a3fd354b967caba41170686874c8dfa63c4b79b34f4b1e3f5882b845d942b" ;
