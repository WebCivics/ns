doc:sch-3-sec-2-4 a cof:Section ;
    cof:title "2 3 Subclause 2.1 operates in relation to personal information that an" ;
    values:kind "section" ;
    values:originalText "organisation that is a body corporate has collected from a related body corporate as if the organisation’s primary purpose of collection of the information were the primary purpose for which the related body corporate collected the information.  Schedule 1  Amendment of the Privacy Act 1988" ;
    cof:pageNumber "79"^^xsd:integer .

concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5 a cml:Concept ;
    skos:prefLabel "2 4 Despite subclause 2.1, an organisation that provides a health"@en ;
    cml:realizedBy doc:sch-3-sec-2-5 ;
    values:originalText "service to an individual may disclose health information about the individual to a person who is responsible for the individual if:  (a) the individual:  (i) is physically or legally incapable of giving consent to the disclosure; or  (ii) physically cannot communicate consent to the disclosure; and  (b) a natural person (the carer) providing the health service for the organisation is satisfied that either:  (i) the disclosure is necessary to provide appropriate care or treatment of the individual; or  (ii) the disclosure is made for compassionate reasons; and  (c) the disclosure is not contrary to any wish:  (i) expressed by the individual before the individual became unable to give or communicate consent; and  (ii) of which the carer is aware, or of which the carer could reasonably be expected to be aware; and  (d) the disclosure is limited to the extent reasonable and necessary for a purpose mentioned in paragraph (b)." ;
    skos:definition "service to an individual may disclose health information about the individual to a person who is responsible for the individual if:  (a) the individual:  (i) is physically or legally incapable of giving consent to the disclosure; or  (ii) physically cannot communicate consent to the disclosure; and  (b) a natural person (the carer) providing the health service for the organisation is satisfied that either:  (i) the disclosure is necessary to provide appropriate care or treatment of the individual; or  (ii) the disclosure is made for compassionate reasons; and  (c) the disclosure is not contrary to any wish:  (i) expressed by the individual before the individual became unable to give or communicate consent; and  (ii) of which the carer is aware, or of which the carer could reasonably be expected to be aware; and  (d) the disclosure is limited to the extent reasonable and necessary for a purpose mentioned in paragraph (b)."@en ;
    cml:integrityHash "e687b514f34bc7a9a12a59c529d03aa35b6a31d772d937ad8e6772a9a5550114" ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Disclosure of health information under certain circumstances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-private-sector-act-2000.pdf> ;
    dc:source "privacy-amendment-private-sector-act-2000.pdf, p.80" ;
    cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-norm .
concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5 ;
    values:borneBy values:Agent ;
