    skos:prefLabel "6C(5) Organisations"@en ;
    cml:realizedBy doc:sch-1-sec-6c-ss-5 ;
    values:originalText "(5) In this section:  Schedule 1  Amendment of the Privacy Act 1988  State does not include the Australian Capital Territory or the Northern Territory (despite subsection 6(1))." ;
