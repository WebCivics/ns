doc:sch-1-sec-2 a cof:Section ;
    cof:title "2 At the end of section 3" ;
    values:kind "section" ;
    values:originalText "Add: Note: Such a law can have effect for the purposes of the provisions of the National Privacy Principles that regulate the handling of personal information by organisations by reference to the effect of other laws." ;
    cof:pageNumber "8"^^xsd:integer .

