concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53a-ss-3 a cml:Concept ;
    skos:prefLabel "53A(3) Notice to be given to outsourcing agency"@en ;
    cml:realizedBy doc:sch-1-sec-53a-ss-3 ;
    values:originalText "(3) An agency that receives a recommendation from the Commissioner must tell the Commissioner in writing of any action the agency proposes to take in relation to the recommendation. The agency must do so within 60 days of receiving the recommendation." ;
    skos:definition "(3) An agency that receives a recommendation from the Commissioner must tell the Commissioner in writing of any action the agency proposes to take in relation to the recommendation. The agency must do so within 60 days of receiving the recommendation."@en ;
    cml:integrityHash "45d1ca3c38669a363daa973ce17f9a579771b51292343add30311a2bbde7284f" ;
    values:partOf concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53a ;
    cof:pageNumber "58"^^xsd:integer ;
    skos:note "Agency must notify Commissioner of proposed action within 60 days." ;
    dc:description "True" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
