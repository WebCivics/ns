doc:sch-1-sec-6d-ss-2 a cof:Section ;
    cof:title "6D(2) Small business and small business operators" ;
    values:kind "subsection" ;
    values:originalText "(2) However, if there was no time in the previous financial year when the business was carried on, the business is a small business at the test time only if its annual turnover for the current year is $3,000,000 or less. What is a small business operator?" ;
    cof:pageNumber "22"^^xsd:integer .

concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-3 a cml:Concept ;
    skos:prefLabel "6D(3) Small business and small business operators"@en ;
    cml:realizedBy doc:sch-1-sec-6d-ss-3 ;
    values:originalText "(3) A small business operator is an individual, body corporate, partnership, unincorporated association or trust that:  (a) carries on one or more small businesses; and  (b) does not carry on a business that is not a small business. Entities that are not small business operators" ;
    skos:definition "(3) A small business operator is an individual, body corporate, partnership, unincorporated association or trust that:  (a) carries on one or more small businesses; and  (b) does not carry on a business that is not a small business. Entities that are not small business operators"@en ;
    cml:integrityHash "e0007e2f1f2b7198fee6e28043f3cc33282d6f0d99bbf845ac550bb5bb8d9eb5" ;
    values:partOf concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d ;
