concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3-2 a cml:Concept ;
    skos:prefLabel "3 After subsection 7(1)"@en ;
    cml:realizedBy doc:sch-3-sec-3-2 ;
    values:originalText "Insert:  (1A) Despite subsections (1) and (2), a reference in this Act (other than section 8) to an act or to a practice does not include a reference to the act or practice so far as it involves the disclosure of personal information to:  (a) the Australian Security Intelligence Organisation; or  (b) the Australian Secret Intelligence Service." ;
    skos:definition "Insert:  (1A) Despite subsections (1) and (2), a reference in this Act (other than section 8) to an act or to a practice does not include a reference to the act or practice so far as it involves the disclosure of personal information to:  (a) the Australian Security Intelligence Organisation; or  (b) the Australian Secret Intelligence Service."@en ;
    cml:integrityHash "99f06500adfc074c72e00eb3c9c0d5eb646a212c0068ea579804e958a8aedb38" ;
    cof:pageNumber "94"^^xsd:integer ;
