concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80-ss-1a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Must Not" ;
    cml:logicSummary "Prohibition" ;
    cml:premiseText "Commissioner must not investigate complaint." ;
    cml:conclusionText "Complainant did not complain to respondent first." ;
