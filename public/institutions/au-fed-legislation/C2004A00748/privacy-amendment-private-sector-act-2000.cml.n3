concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-3-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "must be met" ;
    cml:logicSummary "Positive condition" ;
    cml:premiseText "The organisation carries on business in Australia or an external Territory." ;
    cml:conclusionText "If the organisation carries on business in Australia or an external Territory, it is subject to this Act." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-5b-ss-3 a cof:Section ;
    cof:title "5B(3) Extra-territorial operation of Act" ;
    values:kind "subsection" ;
    values:originalText "(3) All of the following conditions must be met:  (a) the organisation is not described in subsection (2);  (b) the organisation carries on business in Australia or an external Territory;  (c) the personal information was collected or held by the organisation in Australia or an external Territory, either before or at the time of the act or practice. Power to deal with complaints about overseas acts and practices" ;
    cof:pageNumber "8"^^xsd:integer .

concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4 a cml:Concept ;
    skos:prefLabel "5B(4) Extra-territorial operation of Act"@en ;
    cml:realizedBy doc:sch-1-sec-5b-ss-4 ;
    values:originalText "(4) Part V of this Act has extra-territorial operation so far as that Part relates to complaints and investigation concerning acts and practices to which this Act extends because of subsection (1). Note: This lets the Commissioner take action overseas to investigate complaints and lets the ancillary provisions of Part V operate in that context." ;
    skos:definition "(4) Part V of this Act has extra-territorial operation so far as that Part relates to complaints and investigation concerning acts and practices to which this Act extends because of subsection (1). Note: This lets the Commissioner take action overseas to investigate complaints and lets the ancillary provisions of Part V operate in that context."@en ;
    cml:integrityHash "45787635b42189cc7bf2e210565a8cdb6b04113dd5c90f32e2068a13a1ddd347" ;
    values:partOf concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Commissioner has obligation to take action overseas for complaints and investigations." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-private-sector-act-2000.pdf> ;
