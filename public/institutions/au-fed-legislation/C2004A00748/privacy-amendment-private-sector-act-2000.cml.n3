concept:privacy-amendment-private-sector-act-2000-sch-3-sec-6-6 a cml:Concept ;
    skos:prefLabel "6 4 If an organisation charges for providing access to personal"@en ;
    cml:realizedBy doc:sch-3-sec-6-6 ;
    values:originalText "information, those charges:  (a) must not be excessive; and  (b) must not apply to lodging a request for access." ;
