    cof:pageNumber "65"^^xsd:integer .

concept:privacy-amendment-private-sector-act-2000-sch-1-sec-111-ss-3c a cml:Concept ;
    skos:prefLabel "111(3C) After subsection 68(3)"@en ;
    cml:realizedBy doc:sch-1-sec-111-ss-3c ;
    values:originalText "(3C) The authorised person may not enter premises (other than premises occupied by an agency) if:  (a) the occupant or person in charge asks the authorised person to produce his or her identity card; and  (b) the authorised person does not produce it." ;
    skos:definition "(3C) The authorised person may not enter premises (other than premises occupied by an agency) if:  (a) the occupant or person in charge asks the authorised person to produce his or her identity card; and  (b) the authorised person does not produce it."@en ;
