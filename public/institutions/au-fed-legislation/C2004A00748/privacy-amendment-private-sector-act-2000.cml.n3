concept:privacy-amendment-private-sector-act-2000-sch-2-sec-15 a cml:Concept ;
    skos:prefLabel "15 Subsection 134(1)"@en ;
    cml:realizedBy doc:sch-2-sec-15 ;
    values:originalText "Repeal the subsection, substitute:  (1) This section applies to an industry standard that deals with a matter set out in paragraph 113(3)(f), including a matter dealt with by:  (a) the National Privacy Principles (as defined in the Privacy Act 1988); or  (b) other provisions of that Act relating to those Principles; or  (c) an approved privacy code (as defined in that Act); or  (d) provisions of that Act that relate to an approved privacy code." ;
    skos:definition "Repeal the subsection, substitute:  (1) This section applies to an industry standard that deals with a matter set out in paragraph 113(3)(f), including a matter dealt with by:  (a) the National Privacy Principles (as defined in the Privacy Act 1988); or  (b) other provisions of that Act relating to those Principles; or  (c) an approved privacy code (as defined in that Act); or  (d) provisions of that Act that relate to an approved privacy code."@en ;
    cml:integrityHash "76eae0b1440864188e18cab2d05793e98089bd76d6a992c6c5f8b4e37760455c" ;
    cof:pageNumber "91"^^xsd:integer ;
    skos:note "Repeal subsection, substitute with new section applying to industry standards related to privacy principles and codes." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
