concept:privacy-amendment-private-sector-act-2000-sch-1-sec-37 a cml:Concept ;
    skos:prefLabel "37 Application"@en ;
    cml:realizedBy doc:sch-1-sec-37 ;
    values:originalText "Under subsection 6A(2) or 6B(2) of the Privacy Act 1988 (as amended by this Schedule), a Commonwealth contract may prevent an act or practice from being a breach of a National Privacy Principle or an approved privacy code (as appropriate) regardless of whether the contract was made before or after the commencement of that subsection." ;
    skos:definition "Under subsection 6A(2) or 6B(2) of the Privacy Act 1988 (as amended by this Schedule), a Commonwealth contract may prevent an act or practice from being a breach of a National Privacy Principle or an approved privacy code (as appropriate) regardless of whether the contract was made before or after the commencement of that subsection."@en ;
    cml:integrityHash "1c43753204a5c34b97f5bca8e31dd2963ef4045058465a96503e44436ed8b4ae" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Prevents breach of National Privacy Principle or approved privacy code regardless of contract date." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-private-sector-act-2000.pdf> ;
    dc:source "privacy-amendment-private-sector-act-2000.pdf, p.27" ;
    cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-1-sec-37-norm .
