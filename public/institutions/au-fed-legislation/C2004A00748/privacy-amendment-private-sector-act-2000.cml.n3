doc:sch-1-sec-50a-ss-3 a cof:Section ;
    cof:title "50A(3) Substitution of respondent to complaint" ;
    values:kind "subsection" ;
    values:originalText "(3) Before amending the complaint, the Commissioner must:  (a) give the agency a notice stating that the Commissioner proposes to amend the complaint and stating the reasons for the proposal; and  (b) give the agency an opportunity to appear before the Commissioner and to make oral and/or written submissions relating to the proposed amendment." ;
    cof:pageNumber "57"^^xsd:integer .

concept:privacy-amendment-private-sector-act-2000-sch-1-sec-50a-ss-4 a cml:Concept ;
    skos:prefLabel "50A(4) Substitution of respondent to complaint"@en ;
    cml:realizedBy doc:sch-1-sec-50a-ss-4 ;
    values:originalText "(4) If the Commissioner amends the complaint after starting to investigate it, the Commissioner is taken to have satisfied subsection 43(1A) in relation to the agency." ;
    skos:definition "(4) If the Commissioner amends the complaint after starting to investigate it, the Commissioner is taken to have satisfied subsection 43(1A) in relation to the agency."@en ;
    cml:integrityHash "58d30fe7d9eafa48cd33a6e07f828eae2829c265f22f24dbf0be0f80163a7744" ;
    values:partOf concept:privacy-amendment-private-sector-act-2000-sch-1-sec-50a ;
    cof:pageNumber "57"^^xsd:integer ;
    skos:note "Commissioner satisfies subsection 43(1A) if amends complaint during investigation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
