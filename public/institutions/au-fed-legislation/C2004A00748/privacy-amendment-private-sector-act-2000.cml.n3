concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-8 a cml:Concept ;
    skos:prefLabel "2 Saving"@en ;
    cml:realizedBy doc:sch-3-sec-2-8 ;
    values:originalText "The repeal of section 93A of the Australian Security Intelligence Organisation Act 1979 by this Schedule does not make the Privacy Act 1988 apply to an act or practice:  (a) that was done or engaged in before the repeal; and  (b) to which the Privacy Act 1988 did not apply before the repeal because of that section. Privacy Act 1988" ;
    skos:definition "The repeal of section 93A of the Australian Security Intelligence Organisation Act 1979 by this Schedule does not make the Privacy Act 1988 apply to an act or practice:  (a) that was done or engaged in before the repeal; and  (b) to which the Privacy Act 1988 did not apply before the repeal because of that section. Privacy Act 1988"@en ;
    cml:integrityHash "08607e6a2d3e99b927e814e58567f7c22cebe444903edd9d940ffee58b1ebc14" ;
    cof:pageNumber "94"^^xsd:integer ;
