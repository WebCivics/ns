concept:privacy-amendment-private-sector-act-2000-sch-1-sec-17 a cml:Concept ;
    skos:prefLabel "17 Subsection 6(1)"@en ;
    cml:realizedBy doc:sch-1-sec-17 ;
    values:originalText "Insert: health service means:  (a) an activity performed in relation to an individual that is intended or claimed (expressly or otherwise) by the individual or the person performing it:  (i) to assess, record, maintain or improve the individual’s health; or  (ii) to diagnose the individual’s illness or disability; or  (iii) to treat the individual’s illness or disability or suspected illness or disability; or  (b) the dispensing on prescription of a drug or medicinal preparation by a pharmacist." ;
    skos:definition "Insert: health service means:  (a) an activity performed in relation to an individual that is intended or claimed (expressly or otherwise) by the individual or the person performing it:  (i) to assess, record, maintain or improve the individual’s health; or  (ii) to diagnose the individual’s illness or disability; or  (iii) to treat the individual’s illness or disability or suspected illness or disability; or  (b) the dispensing on prescription of a drug or medicinal preparation by a pharmacist."@en ;
    cml:integrityHash "8e9787acd4bac773af263d374d0f25f9862ca5825e4342d8030701b66f2c0a43" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Defines health service" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
