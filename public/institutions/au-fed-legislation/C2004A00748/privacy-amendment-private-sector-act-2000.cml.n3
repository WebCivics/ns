concept:privacy-amendment-private-sector-act-2000-sch-3-sec-1-4 a cml:Concept ;
    skos:prefLabel "1 Section 1"@en ;
    cml:realizedBy doc:sch-3-sec-1-4 ;
    values:originalText "3 At or before the time (or, if that is not practicable, as soon as practicable after) an organisation collects personal information about an individual from the individual, the organisation must take reasonable steps to ensure that the individual is aware of:  (a) the identity of the organisation and how to contact it; and  Amendment of the Privacy Act 1988  Schedule 1  (b) the fact that he or she is able to gain access to the information; and  (c) the purposes for which the information is collected; and  (d) the organisations (or the types of organisations) to which the organisation usually discloses information of that kind; and  (e) any law that requires the particular information to be collected; and  (f) the main consequences (if any) for the individual if all or part of the information is not provided." ;
    skos:definition "3 At or before the time (or, if that is not practicable, as soon as practicable after) an organisation collects personal information about an individual from the individual, the organisation must take reasonable steps to ensure that the individual is aware of:  (a) the identity of the organisation and how to contact it; and  Amendment of the Privacy Act 1988  Schedule 1  (b) the fact that he or she is able to gain access to the information; and  (c) the purposes for which the information is collected; and  (d) the organisations (or the types of organisations) to which the organisation usually discloses information of that kind; and  (e) any law that requires the particular information to be collected; and  (f) the main consequences (if any) for the individual if all or part of the information is not provided."@en ;
    cml:integrityHash "33ee9e454498d387d443b3ae507275e64e26bddd769ffbd414125eb6a105a6da" ;
    cof:pageNumber "76"^^xsd:integer ;
    skos:note "Organisation must inform individual of personal information collection details." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
