doc:sch-1-sec-95b-ss-1 a cof:Section ;
    cof:title "95B(1) Requirements for Commonwealth contracts" ;
    values:kind "subsection" ;
    values:originalText "(1) This section requires an agency entering into a Commonwealth contract to take contractual measures to ensure that a contracted service provider for the contract does not do an act, or engage in a practice, that would breach an Information Privacy Principle if done or engaged in by the agency." ;
    cof:pageNumber "74"^^xsd:integer .

