concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80e a cml:Concept ;
    skos:prefLabel "80E Register of determinations"@en ;
    cml:realizedBy doc:sch-1-sec-80e ;
    values:originalText "(1) The Commissioner must keep a register of determinations made under Division 1 or 2.  (2) The Commissioner may decide the form of the register and how it is to be kept.  (3) The Commissioner must make the register available to the public in the way that the Commissioner determines.  (4) The Commissioner may charge fees for:  (a) making the register available to the public; or  (b) providing copies of, or extracts from, the register." ;
    skos:definition "(1) The Commissioner must keep a register of determinations made under Division 1 or 2.  (2) The Commissioner may decide the form of the register and how it is to be kept.  (3) The Commissioner must make the register available to the public in the way that the Commissioner determines.  (4) The Commissioner may charge fees for:  (a) making the register available to the public; or  (b) providing copies of, or extracts from, the register."@en ;
    cml:integrityHash "7afcc2dee533d29a73f9e7cf9821bb4cb5d4887b9981e288f1d784b1d9cf4d02" ;
    cof:pageNumber "72"^^xsd:integer ;
