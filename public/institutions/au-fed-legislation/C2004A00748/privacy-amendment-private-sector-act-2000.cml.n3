concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98 a cml:Concept ;
    skos:prefLabel "98 After subsection 54(1)"@en ;
    cml:realizedBy doc:sch-1-sec-98 ;
    values:originalText "Insert:  (1A) This Division also applies to a determination made by an adjudicator for an approved privacy code under the code in relation to a complaint made under the code. Note: The making of a determination by the Commissioner under this Act or by an adjudicator under an approved privacy code is subject to judicial review under the Administrative Decisions (Judicial Review) Act 1977." ;
    skos:definition "Insert:  (1A) This Division also applies to a determination made by an adjudicator for an approved privacy code under the code in relation to a complaint made under the code. Note: The making of a determination by the Commissioner under this Act or by an adjudicator under an approved privacy code is subject to judicial review under the Administrative Decisions (Judicial Review) Act 1977."@en ;
    cml:integrityHash "cc89a24c5edd5b015ddc321cdd433896a89383bdc25e6afbb84f8b1ad20de5ca" ;
    cof:pageNumber "60"^^xsd:integer ;
    skos:note "Judicial review of privacy code determinations is subject to the Administrative Decisions (Judicial Review) Act 1977." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-private-sector-act-2000.pdf> ;
