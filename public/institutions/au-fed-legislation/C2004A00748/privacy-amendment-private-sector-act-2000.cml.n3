concept:privacy-amendment-private-sector-act-2000-sch-1-sec-95c a cml:Concept ;
    skos:prefLabel "95C Disclosure of certain provisions of Commonwealth contracts"@en ;
    cml:realizedBy doc:sch-1-sec-95c ;
    values:originalText "If a person asks a party to a Commonwealth contract to be informed of the content of provisions (if any) of the contract that are inconsistent with an approved privacy code binding a party to the contract or with a National Privacy Principle, the party requested must inform the person in writing of that content (if any)." ;
    skos:definition "If a person asks a party to a Commonwealth contract to be informed of the content of provisions (if any) of the contract that are inconsistent with an approved privacy code binding a party to the contract or with a National Privacy Principle, the party requested must inform the person in writing of that content (if any)."@en ;
    cml:integrityHash "8437072d4da3799de4bf25928b59dc0ca13dbb9d726d84d5e55df634eeee4439" ;
    cof:pageNumber "75"^^xsd:integer ;
    skos:note "Party must inform person of inconsistent contract provisions." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-private-sector-act-2000.pdf> ;
    dc:source "privacy-amendment-private-sector-act-2000.pdf, p.75" ;
    cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-1-sec-95c-norm .
