concept:privacy-amendment-private-sector-act-2000-sch-1-sec-105 a cml:Concept ;
    skos:prefLabel "105 At the end of section 64"@en ;
    cml:realizedBy doc:sch-1-sec-105 ;
    values:originalText "Add:  (2) Neither an adjudicator for an approved privacy code, nor a person acting under his or her direction or authority, is liable to an action, suit or proceeding in relation to an act done or omitted to be done in good faith in the exercise or purported exercise of any power or authority conferred by this Act or the code. Note: The heading to section 64 is altered by inserting “etc.” after “Commissioner”." ;
    skos:definition "Add:  (2) Neither an adjudicator for an approved privacy code, nor a person acting under his or her direction or authority, is liable to an action, suit or proceeding in relation to an act done or omitted to be done in good faith in the exercise or purported exercise of any power or authority conferred by this Act or the code. Note: The heading to section 64 is altered by inserting “etc.” after “Commissioner”."@en ;
    cml:integrityHash "42c57f898458476cedc2347b1e68caa47ba4eae49c7c7c676dab9d51e0f3b545" ;
    cof:pageNumber "64"^^xsd:integer ;
    skos:note "No liability for acts done in good faith under the Act or code." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-private-sector-act-2000.pdf> ;
    dc:source "privacy-amendment-private-sector-act-2000.pdf, p.64" ;
    cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-1-sec-105-norm .
