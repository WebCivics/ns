    skos:prefLabel "64 Paragraph 27(1)(f)"@en ;
    cml:realizedBy doc:sch-1-sec-64 ;
    values:originalText "Repeal the paragraph, substitute:  (f) to provide (on request or on the Commissioner’s own initiative) advice to a Minister, agency or organisation on any matter relevant to the operation of this Act;  (fa) to provide advice to an adjudicator for an approved privacy code on any matter relevant to the operation of this Act or the code, on request by the adjudicator;" ;
    skos:definition "Repeal the paragraph, substitute:  (f) to provide (on request or on the Commissioner’s own initiative) advice to a Minister, agency or organisation on any matter relevant to the operation of this Act;  (fa) to provide advice to an adjudicator for an approved privacy code on any matter relevant to the operation of this Act or the code, on request by the adjudicator;"@en ;
    cml:integrityHash "8ef24caa72d10bc788e6c31b368b03cbe74b18036e322a41c8596178887cb017" ;
    cof:pageNumber "50"^^xsd:integer ;
