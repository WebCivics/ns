    cml:curationStatus cml:Proposed .
concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5 cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-deontic-1 .
concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Necessity" ;
    cml:logicSummary "The organisation has an obligation to disclose health information under certain circumstances." ;
    cml:premiseText "the individual is physically or legally incapable of giving consent to the disclosure;" ;
    cml:conclusionText "the organisation must disclose health information." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5 cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-alleninterval-2 .
concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The disclosure must be limited to the extent reasonable and necessary for a purpose mentioned in paragraph (b)." ;
    cml:premiseText "the disclosure is not contrary to any wish:  (i) expressed by the individual before the individual became unable to give or communicate consent; and  (ii) of which the carer is aware, or of which the carer could reasonably be expected to be aware;" ;
    cml:conclusionText "the disclosure must be limited." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5 cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-ltl-3 .
concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "The disclosure must not continue beyond the point where the individual is able to give consent or communicate effectively." ;
    cml:premiseText "the individual is physically or legally incapable of giving consent to the disclosure;" ;
    cml:conclusionText "the disclosure must stop when the individual is able to give consent or communicate effectively." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5 cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-diffusion-4 .
concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Propagation" ;
    cml:logicSummary "The disclosure of health information may lead to further disclosures under certain circumstances." ;
    cml:premiseText "a natural person providing the health service for the organisation is satisfied that either:  (i) the disclosure is necessary to provide appropriate care or treatment of the individual; or  (ii) the disclosure is made for compassionate reasons;" ;
    cml:conclusionText "the disclosure may lead to further disclosures." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5 cml:asserts concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-argumentation-5 .
concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-5-logic-argumentation-5 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "The organisation's decision to disclose health information implies that it has considered the potential consequences and alternatives." ;
    cml:premiseText "a natural person providing the health service for the organisation is satisfied that either:  (i) the disclosure is necessary to provide appropriate care or treatment of the individual; or  (ii) the disclosure is made for compassionate reasons;" ;
    cml:conclusionText "the organisation's decision implies consideration of potential consequences and alternatives." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-3-sec-2-5 a cof:Section ;
    cof:title "2 4 Despite subclause 2.1, an organisation that provides a health" ;
    values:kind "section" ;
    values:originalText "service to an individual may disclose health information about the individual to a person who is responsible for the individual if:  (a) the individual:  (i) is physically or legally incapable of giving consent to the disclosure; or  (ii) physically cannot communicate consent to the disclosure; and  (b) a natural person (the carer) providing the health service for the organisation is satisfied that either:  (i) the disclosure is necessary to provide appropriate care or treatment of the individual; or  (ii) the disclosure is made for compassionate reasons; and  (c) the disclosure is not contrary to any wish:  (i) expressed by the individual before the individual became unable to give or communicate consent; and  (ii) of which the carer is aware, or of which the carer could reasonably be expected to be aware; and  (d) the disclosure is limited to the extent reasonable and necessary for a purpose mentioned in paragraph (b)." ;
    cof:pageNumber "80"^^xsd:integer .

concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-6 a cml:Concept ;
    skos:prefLabel "2 Section 2"@en ;
    cml:realizedBy doc:sch-3-sec-2-6 ;
    values:originalText "5 For the purposes of subclause 2.4, a person is responsible for an individual if the person is:  (a) a parent of the individual; or  (b) a child or sibling of the individual and at least 18 years old; or  (c) a spouse or de facto spouse of the individual; or  (d) a relative of the individual, at least 18 years old and a member of the individual’s household; or  (e) a guardian of the individual; or  (f) exercising an enduring power of attorney granted by the individual that is exercisable in relation to decisions about the individual’s health; or  (g) a person who has an intimate personal relationship with the individual; or  (h) a person nominated by the individual to be contacted in case of emergency." ;
    skos:definition "5 For the purposes of subclause 2.4, a person is responsible for an individual if the person is:  (a) a parent of the individual; or  (b) a child or sibling of the individual and at least 18 years old; or  (c) a spouse or de facto spouse of the individual; or  (d) a relative of the individual, at least 18 years old and a member of the individual’s household; or  (e) a guardian of the individual; or  (f) exercising an enduring power of attorney granted by the individual that is exercisable in relation to decisions about the individual’s health; or  (g) a person who has an intimate personal relationship with the individual; or  (h) a person nominated by the individual to be contacted in case of emergency."@en ;
    cml:integrityHash "953743e01095a68c7eb2f2de61c625b31d1bca7c0481dc2a05bfb5ee95dfcc0f" ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Person responsible for an individual" ;
