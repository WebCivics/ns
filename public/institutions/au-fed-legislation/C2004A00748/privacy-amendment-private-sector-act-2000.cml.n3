concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16b a cml:Concept ;
    skos:prefLabel "16B Personal information in records"@en ;
    cml:realizedBy doc:sch-1-sec-16b ;
    values:originalText "(1) This Act (except Divisions 4 and 5 of Part III and Part IIIA) applies to the collection of personal information by an organisation only if the information is collected for inclusion in a record or a generally available publication.  (2) This Act (except Divisions 4 and 5 of Part III and Part IIIA) applies to personal information that has been collected by an organisation only if the information is held by the organisation in a record.  Schedule 1  Amendment of the Privacy Act 1988" ;
    skos:definition "(1) This Act (except Divisions 4 and 5 of Part III and Part IIIA) applies to the collection of personal information by an organisation only if the information is collected for inclusion in a record or a generally available publication.  (2) This Act (except Divisions 4 and 5 of Part III and Part IIIA) applies to personal information that has been collected by an organisation only if the information is held by the organisation in a record.  Schedule 1  Amendment of the Privacy Act 1988"@en ;
    cml:integrityHash "8658f66585c1f0cf27440895aab466ef249e08151202e26637c40e4f419309cb" ;
    cof:pageNumber "39"^^xsd:integer ;
    cml:hasPart concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16b-ss-1 ;
    cml:hasPart concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16b-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-private-sector-act-2000.pdf> ;
    dc:source "privacy-amendment-private-sector-act-2000.pdf, p.39" .
doc:sch-1-sec-16b a cof:Section ;
    cof:title "16B Personal information in records" ;
    values:kind "section" ;
    values:originalText "(1) This Act (except Divisions 4 and 5 of Part III and Part IIIA) applies to the collection of personal information by an organisation only if the information is collected for inclusion in a record or a generally available publication.  (2) This Act (except Divisions 4 and 5 of Part III and Part IIIA) applies to personal information that has been collected by an organisation only if the information is held by the organisation in a record.  Schedule 1  Amendment of the Privacy Act 1988" ;
    cof:pageNumber "39"^^xsd:integer .

