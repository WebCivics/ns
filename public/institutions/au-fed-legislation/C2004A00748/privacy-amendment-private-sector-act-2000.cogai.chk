  executionSurface: modalities::interval_reasoning;
  curationStatus: Proposed;
  @condition: the disclosure is not contrary to any wish: (i) expressed by the individual before the individual became unable to give or communicate consent; and (ii) of which the carer is aware, or of which the carer could reasonably be expected to be aware;;
  @action: the disclosure must be limited.;
}

