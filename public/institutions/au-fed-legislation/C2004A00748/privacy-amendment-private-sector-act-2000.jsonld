    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-18bg",
      "@type": "cml:Concept",
      "skos:prefLabel": "18BG Register of approved privacy codes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-18bg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.47",
      "values:originalText": "(1) The Commissioner must keep a register of approved privacy codes.\n\nSchedule 1  Amendment of the Privacy Act 1988\n\n(2) The Commissioner may decide the form of the register and how it\nis to be kept.\n\n(3) The Commissioner must make the register available to the public\nin the way that the Commissioner determines.\n\n(4) The Commissioner may charge fees for:\n\n(a) making the register available to the public; or\n\n(b) providing copies of, or extracts from, the register.",
      "skos:definition": "(1) The Commissioner must keep a register of approved privacy codes.\n\nSchedule 1  Amendment of the Privacy Act 1988\n\n(2) The Commissioner may decide the form of the register and how it\nis to be kept.\n\n(3) The Commissioner must make the register available to the public\nin the way that the Commissioner determines.\n\n(4) The Commissioner may charge fees for:\n\n(a) making the register available to the public; or\n\n(b) providing copies of, or extracts from, the register.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-18bg-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-18bg-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-18bg-ss-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-18bg-ss-4"
        }
      ],
      "cml:integrityHash": "18cf715d6f24f12f1286e9025a53803be1a124d52e66262bc7d3485e8fa717c2"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-18bg",
      "@type": "cof:Section",
      "cof:title": "18BG Register of approved privacy codes",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "(1) The Commissioner must keep a register of approved privacy codes.\n\nSchedule 1  Amendment of the Privacy Act 1988\n\n(2) The Commissioner may decide the form of the register and how it\nis to be kept.\n\n(3) The Commissioner must make the register available to the public\nin the way that the Commissioner determines.\n\n(4) The Commissioner may charge fees for:\n\n(a) making the register available to the public; or\n\n(b) providing copies of, or extracts from, the register."
    },
