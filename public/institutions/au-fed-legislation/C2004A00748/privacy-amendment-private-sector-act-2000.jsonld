      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.63",
      "values:originalText": "Schedule 1  Amendment of the Privacy Act 1988\n\nInsert:\n\n(2A) Subsection (2) does not permit an application relating to\nproceedings under section 55A to enforce a determination relating\nto a code complaint or an NPP complaint.",
      "skos:definition": "Schedule 1  Amendment of the Privacy Act 1988\n\nInsert:\n\n(2A) Subsection (2) does not permit an application relating to\nproceedings under section 55A to enforce a determination relating\nto a code complaint or an NPP complaint.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-104-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-104-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-104-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-104-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-104-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-104-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "0ae381867b28d2ac2a63be6cc4c2979321cb02321f9ff98f671013bff15def23",
      "skos:note": "No application can enforce a determination relating to a code complaint or an NPP complaint."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-104",
      "@type": "cof:Section",
      "cof:title": "104 After subsection 63(2)",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "Schedule 1  Amendment of the Privacy Act 1988\n\nInsert:\n\n(2A) Subsection (2) does not permit an application relating to\nproceedings under section 55A to enforce a determination relating\nto a code complaint or an NPP complaint."
    },
