    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "5B(4) Extra-territorial operation of Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-5b-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.8",
      "values:originalText": "(4) Part V of this Act has extra-territorial operation so far as that Part\nrelates to complaints and investigation concerning acts and\npractices to which this Act extends because of subsection (1).\nNote:\nThis lets the Commissioner take action overseas to investigate\ncomplaints and lets the ancillary provisions of Part V operate in that\ncontext.",
      "skos:definition": "(4) Part V of this Act has extra-territorial operation so far as that Part\nrelates to complaints and investigation concerning acts and\npractices to which this Act extends because of subsection (1).\nNote:\nThis lets the Commissioner take action overseas to investigate\ncomplaints and lets the ancillary provisions of Part V operate in that\ncontext.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "45787635b42189cc7bf2e210565a8cdb6b04113dd5c90f32e2068a13a1ddd347",
      "skos:note": "Commissioner has obligation to take action overseas for complaints and investigations."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-5b-ss-4",
      "@type": "cof:Section",
      "cof:title": "5B(4) Extra-territorial operation of Act",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(4) Part V of this Act has extra-territorial operation so far as that Part\nrelates to complaints and investigation concerning acts and\npractices to which this Act extends because of subsection (1).\nNote:\nThis lets the Commissioner take action overseas to investigate\ncomplaints and lets the ancillary provisions of Part V operate in that\ncontext."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Commissioner has obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Part V of this Act has extra-territorial operation",
      "cml:conclusionText": "Commissioner must take action overseas for complaints and investigations."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "because of",
      "cml:logicSummary": "Subsection (1) is a condition for extra-territorial operation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Part V of this Act has extra-territorial operation because of subsection (1)",
      "cml:conclusionText": "The Commissioner's action must be taken because of subsection (1)."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "lets",
      "cml:logicSummary": "Commissioner is allowed to take action overseas for complaints and investigations.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "This lets the Commissioner take action overseas to investigate complaints and lets the ancillary provisions of Part V operate in that context.",
      "cml:conclusionText": "The Commissioner has permission to take action overseas."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-4-logic-deontic-4",
