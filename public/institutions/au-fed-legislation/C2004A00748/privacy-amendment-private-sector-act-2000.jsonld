      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to provide judicial review of adjudicator's determinations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The making of a determination by the Commissioner under this Act or by an adjudicator under an approved privacy code is subject to judicial review.",
      "cml:conclusionText": "Judicial review is required for adjudicator's determinations"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between judicial review and Commissioner's determinations",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The making of a determination by the Commissioner under this Act or by an adjudicator under an approved privacy code is subject to judicial review.",
      "cml:conclusionText": "Judicial review overlaps with Commissioner's determinations"
    },
