    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-6-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 2 However, where providing access would reveal evaluative",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-6-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.83",
      "values:originalText": "information generated within the organisation in connection with a\ncommercially sensitive decision-making process, the organisation\nmay give the individual an explanation for the commercially\nsensitive decision rather than direct access to the information.\nNote:\nAn organisation breaches subclause 6.1 if it relies on subclause 6.2 to\ngive an individual an explanation for a commercially sensitive\ndecision in circumstances where subclause 6.2 does not apply.",
      "skos:definition": "information generated within the organisation in connection with a\ncommercially sensitive decision-making process, the organisation\nmay give the individual an explanation for the commercially\nsensitive decision rather than direct access to the information.\nNote:\nAn organisation breaches subclause 6.1 if it relies on subclause 6.2 to\ngive an individual an explanation for a commercially sensitive\ndecision in circumstances where subclause 6.2 does not apply.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-6-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-6-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c46e9d4f9d5c7f0e7fd51634f1fe8c5b31766de59cc09d81e5fb10b6ca9b16af",
      "skos:note": "Organisation may give individual an explanation for commercially sensitive decision instead of direct access to information.",
      "dc:description": "No"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-6-3",
      "@type": "cof:Section",
      "cof:title": "6 2 However, where providing access would reveal evaluative",
      "values:kind": "section",
      "cof:pageNumber": 83,
      "values:originalText": "information generated within the organisation in connection with a\ncommercially sensitive decision-making process, the organisation\nmay give the individual an explanation for the commercially\nsensitive decision rather than direct access to the information.\nNote:\nAn organisation breaches subclause 6.1 if it relies on subclause 6.2 to\ngive an individual an explanation for a commercially sensitive\ndecision in circumstances where subclause 6.2 does not apply."
    },
