    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Subsection 6(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-32"
      },
      "cml:curationStatus": {
