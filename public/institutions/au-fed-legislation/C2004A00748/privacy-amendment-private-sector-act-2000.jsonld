    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Data quality",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.81",
      "values:originalText": "An organisation must take reasonable steps to make sure that the\npersonal information it collects, uses or discloses is accurate,\ncomplete and up-to-date.",
      "skos:definition": "An organisation must take reasonable steps to make sure that the\npersonal information it collects, uses or discloses is accurate,\ncomplete and up-to-date.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b919b820ac98f1d2e2bdefc6b198ac85950b3cd51c6bcb89a2815c12a85e1cda",
      "skos:note": "Ensure personal information is accurate, complete and up-to-date."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Data quality",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "An organisation must take reasonable steps to make sure that the\npersonal information it collects, uses or discloses is accurate,\ncomplete and up-to-date."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3-norm",
      "@type": "values:Obligation",
