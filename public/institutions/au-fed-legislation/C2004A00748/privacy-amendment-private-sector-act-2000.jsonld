    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-116a",
      "@type": "cml:Concept",
      "skos:prefLabel": "116A Industry codes and standards do not affect Privacy Act 1988",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-116a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.89",
      "values:originalText": "Neither an industry code nor an industry standard derogates from a\nrequirement made by or under the Privacy Act 1988 or an approved\nprivacy code (as defined in that Act).",
      "skos:definition": "Neither an industry code nor an industry standard derogates from a\nrequirement made by or under the Privacy Act 1988 or an approved\nprivacy code (as defined in that Act).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-116a-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-116a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3d6b7916637068062c4065b697906858f03f979d79250e02fff27e3ff363ebb2",
      "skos:note": "Industry codes and standards do not affect Privacy Act 1988 requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-116a",
      "@type": "cof:Section",
      "cof:title": "116A Industry codes and standards do not affect Privacy Act 1988",
      "values:kind": "section",
      "cof:pageNumber": 89,
      "values:originalText": "Neither an industry code nor an industry standard derogates from a\nrequirement made by or under the Privacy Act 1988 or an approved\nprivacy code (as defined in that Act)."
    },
