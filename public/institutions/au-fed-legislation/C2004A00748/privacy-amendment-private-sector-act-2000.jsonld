    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.27",
      "values:originalText": "Under subsection 6A(2) or 6B(2) of the Privacy Act 1988 (as amended\nby this Schedule), a Commonwealth contract may prevent an act or\npractice from being a breach of a National Privacy Principle or an\napproved privacy code (as appropriate) regardless of whether the\ncontract was made before or after the commencement of that\nsubsection.",
      "skos:definition": "Under subsection 6A(2) or 6B(2) of the Privacy Act 1988 (as amended\nby this Schedule), a Commonwealth contract may prevent an act or\npractice from being a breach of a National Privacy Principle or an\napproved privacy code (as appropriate) regardless of whether the\ncontract was made before or after the commencement of that\nsubsection.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-37-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-37-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1c43753204a5c34b97f5bca8e31dd2963ef4045058465a96503e44436ed8b4ae",
      "skos:note": "Prevents breach of National Privacy Principle or approved privacy code regardless of contract date."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-37",
      "@type": "cof:Section",
      "cof:title": "37 Application",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "Under subsection 6A(2) or 6B(2) of the Privacy Act 1988 (as amended\nby this Schedule), a Commonwealth contract may prevent an act or\npractice from being a breach of a National Privacy Principle or an\napproved privacy code (as appropriate) regardless of whether the\ncontract was made before or after the commencement of that\nsubsection."
    },
    {
