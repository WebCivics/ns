    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-85",
      "@type": "cml:Concept",
      "skos:prefLabel": "85 Paragraphs 41(1)(e) and (f)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-85"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.54",
      "values:originalText": "Repeal the paragraphs, substitute:\n\nAmendment of the Privacy Act 1988  Schedule 1\n\n(e) the act or practice is the subject of an application under\nanother Commonwealth law, or a State or Territory law, and\nthe subject-matter of the complaint has been, or is being,\ndealt with adequately under that law; or\n\n(f) another Commonwealth law, or a State or Territory law,\nprovides a more appropriate remedy for the act or practice\nthat is the subject of the complaint.",
      "skos:definition": "Repeal the paragraphs, substitute:\n\nAmendment of the Privacy Act 1988  Schedule 1\n\n(e) the act or practice is the subject of an application under\nanother Commonwealth law, or a State or Territory law, and\nthe subject-matter of the complaint has been, or is being,\ndealt with adequately under that law; or\n\n(f) another Commonwealth law, or a State or Territory law,\nprovides a more appropriate remedy for the act or practice\nthat is the subject of the complaint.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-85-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-85-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "931314567ce0a04be039f523a1829a904929fa482b2679cbf1ae1afca90b14e1",
      "skos:note": "Repeal paragraphs and substitute with new provisions for dealing with complaints under other laws."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-85",
      "@type": "cof:Section",
      "cof:title": "85 Paragraphs 41(1)(e) and (f)",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "Repeal the paragraphs, substitute:\n\nAmendment of the Privacy Act 1988  Schedule 1\n\n(e) the act or practice is the subject of an application under\nanother Commonwealth law, or a State or Territory law, and\nthe subject-matter of the complaint has been, or is being,\ndealt with adequately under that law; or\n\n(f) another Commonwealth law, or a State or Territory law,\nprovides a more appropriate remedy for the act or practice\nthat is the subject of the complaint."
    },
