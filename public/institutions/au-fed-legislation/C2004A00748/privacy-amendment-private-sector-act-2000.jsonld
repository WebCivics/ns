    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-104",
      "@type": "cml:Concept",
      "skos:prefLabel": "104 After subsection 63(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-104"
