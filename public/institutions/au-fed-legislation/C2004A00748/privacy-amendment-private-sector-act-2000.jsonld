    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Saving",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-2-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.94",
      "values:originalText": "The repeal of section 93A of the Australian Security Intelligence\nOrganisation Act 1979 by this Schedule does not make the Privacy Act\n1988 apply to an act or practice:\n\n(a) that was done or engaged in before the repeal; and\n\n(b) to which the Privacy Act 1988 did not apply before the repeal\nbecause of that section.\nPrivacy Act 1988",
      "skos:definition": "The repeal of section 93A of the Australian Security Intelligence\nOrganisation Act 1979 by this Schedule does not make the Privacy Act\n1988 apply to an act or practice:\n\n(a) that was done or engaged in before the repeal; and\n\n(b) to which the Privacy Act 1988 did not apply before the repeal\nbecause of that section.\nPrivacy Act 1988",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-8-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "08607e6a2d3e99b927e814e58567f7c22cebe444903edd9d940ffee58b1ebc14",
      "skos:note": "Exempts certain acts from Privacy Act 1988"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-2-8",
      "@type": "cof:Section",
      "cof:title": "2 Saving",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "The repeal of section 93A of the Australian Security Intelligence\nOrganisation Act 1979 by this Schedule does not make the Privacy Act\n1988 apply to an act or practice:\n\n(a) that was done or engaged in before the repeal; and\n\n(b) to which the Privacy Act 1988 did not apply before the repeal\nbecause of that section.\nPrivacy Act 1988"
    },
