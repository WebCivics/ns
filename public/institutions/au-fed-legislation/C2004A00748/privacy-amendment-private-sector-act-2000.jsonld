    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-6b-ss-5",
      "@type": "cof:Section",
      "cof:title": "6B(5) Breach of an approved privacy code",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(5) Subsections (2), (3) and (4) have effect despite subsection (1)."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6b-ss-5-norm",
      "@type": "values:Obligation",
