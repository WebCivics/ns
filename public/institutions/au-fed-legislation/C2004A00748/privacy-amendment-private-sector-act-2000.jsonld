    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-122a",
      "@type": "cml:Concept",
      "skos:prefLabel": "122A De-registering industry codes and provisions of industry codes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-122a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.91",
      "values:originalText": "(1) The ACA may remove from the Register of industry codes kept\nunder section 136:\n\n(a) an industry code; or\n\n(b) a provision of an industry code.\n\n(2) An industry code ceases to be registered when it is removed from\nthe Register.\n\n(3) If the ACA removes a provision of an industry code from the\nRegister, this Part has effect in relation to things occurring after the\nremoval of the provision as if the code registered under this Part\ndid not include the provision removed.",
      "skos:definition": "(1) The ACA may remove from the Register of industry codes kept\nunder section 136:\n\n(a) an industry code; or\n\n(b) a provision of an industry code.\n\n(2) An industry code ceases to be registered when it is removed from\nthe Register.\n\n(3) If the ACA removes a provision of an industry code from the\nRegister, this Part has effect in relation to things occurring after the\nremoval of the provision as if the code registered under this Part\ndid not include the provision removed.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-122a-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-122a-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-122a-ss-3"
        }
      ],
      "cml:integrityHash": "d19d3cb0f75a1c4efb48e0205803a75abb5a33b73efe7e981370df1625fd01c4"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-122a",
      "@type": "cof:Section",
      "cof:title": "122A De-registering industry codes and provisions of industry codes",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "(1) The ACA may remove from the Register of industry codes kept\nunder section 136:\n\n(a) an industry code; or\n\n(b) a provision of an industry code.\n\n(2) An industry code ceases to be registered when it is removed from\nthe Register.\n\n(3) If the ACA removes a provision of an industry code from the\nRegister, this Part has effect in relation to things occurring after the\nremoval of the provision as if the code registered under this Part\ndid not include the provision removed."
    },
