    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-105",
      "@type": "cml:Concept",
      "skos:prefLabel": "105 At the end of section 64",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-105"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.64",
      "values:originalText": "Add:\n\n(2) Neither an adjudicator for an approved privacy code, nor a person\nacting under his or her direction or authority, is liable to an action,\nsuit or proceeding in relation to an act done or omitted to be done\nin good faith in the exercise or purported exercise of any power or\nauthority conferred by this Act or the code.\nNote:\nThe heading to section 64 is altered by inserting “etc.” after “Commissioner”.",
      "skos:definition": "Add:\n\n(2) Neither an adjudicator for an approved privacy code, nor a person\nacting under his or her direction or authority, is liable to an action,\nsuit or proceeding in relation to an act done or omitted to be done\nin good faith in the exercise or purported exercise of any power or\nauthority conferred by this Act or the code.\nNote:\nThe heading to section 64 is altered by inserting “etc.” after “Commissioner”.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-105-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-105-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "42c57f898458476cedc2347b1e68caa47ba4eae49c7c7c676dab9d51e0f3b545",
      "skos:note": "No liability for acts done in good faith under the Act or code."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-105",
      "@type": "cof:Section",
      "cof:title": "105 At the end of section 64",
      "values:kind": "section",
      "cof:pageNumber": 64,
      "values:originalText": "Add:\n\n(2) Neither an adjudicator for an approved privacy code, nor a person\nacting under his or her direction or authority, is liable to an action,\nsuit or proceeding in relation to an act done or omitted to be done\nin good faith in the exercise or purported exercise of any power or\nauthority conferred by this Act or the code.\nNote:\nThe heading to section 64 is altered by inserting “etc.” after “Commissioner”."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-105-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-105"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-105-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "No liability implies a duty to act in good faith.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No liability for acts done in good faith.",
      "cml:conclusionText": "Duty to act in good faith."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106",
      "@type": "cml:Concept",
      "skos:prefLabel": "106 After subsection 66(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-106"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.64",
      "values:originalText": "Insert:\n\n(1A) For the purposes of subsection (1), a journalist has a reasonable\nexcuse if giving the information, answering the question or\nproducing the document or record would tend to reveal the identity\nof a person who gave information or a document or record to the\njournalist in confidence.",
      "skos:definition": "Insert:\n\n(1A) For the purposes of subsection (1), a journalist has a reasonable\nexcuse if giving the information, answering the question or\nproducing the document or record would tend to reveal the identity\nof a person who gave information or a document or record to the\njournalist in confidence.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "3d63bcb3fbe69d938867311d9d387e1e8d88be66ac5b0d8ca00d4f3249357ece",
      "skos:note": "Journalist has a reasonable excuse to keep confidential the identity of an informant."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-106",
      "@type": "cof:Section",
      "cof:title": "106 After subsection 66(1)",
      "values:kind": "section",
      "cof:pageNumber": 64,
      "values:originalText": "Insert:\n\n(1A) For the purposes of subsection (1), a journalist has a reasonable\nexcuse if giving the information, answering the question or\nproducing the document or record would tend to reveal the identity\nof a person who gave information or a document or record to the\njournalist in confidence."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-norm",
