      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to provide judicial review",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The making of a determination by the Commissioner under this Act or by an adjudicator under an approved privacy code is subject to judicial review.",
      "cml:conclusionText": "Judicial review is required"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98-logic-deontic-2",
