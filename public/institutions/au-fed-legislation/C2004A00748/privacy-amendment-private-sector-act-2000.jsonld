        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16e",
      "@type": "cml:Concept",
      "skos:prefLabel": "16E Personal, family or household affairs",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-16e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.41",
      "values:originalText": "Nothing in the National Privacy Principles applies to:\n\n(a) the collection, holding, use, disclosure or transfer of personal\ninformation by an individual; or\n\n(b) personal information held by an individual;\nonly for the purposes of, or in connection with, his or her personal,\nfamily or household affairs.\n\nSchedule 1  Amendment of the Privacy Act 1988",
      "skos:definition": "Nothing in the National Privacy Principles applies to:\n\n(a) the collection, holding, use, disclosure or transfer of personal\ninformation by an individual; or\n\n(b) personal information held by an individual;\nonly for the purposes of, or in connection with, his or her personal,\nfamily or household affairs.\n\nSchedule 1  Amendment of the Privacy Act 1988",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16e-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9b6fe2712d94c46f775b2dce1d2eff1baae14271ce70b589b3d57168816a29fd",
      "skos:note": "Exemptions from National Privacy Principles for personal, family or household affairs"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-16e",
      "@type": "cof:Section",
      "cof:title": "16E Personal, family or household affairs",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "Nothing in the National Privacy Principles applies to:\n\n(a) the collection, holding, use, disclosure or transfer of personal\ninformation by an individual; or\n\n(b) personal information held by an individual;\nonly for the purposes of, or in connection with, his or her personal,\nfamily or household affairs.\n\nSchedule 1  Amendment of the Privacy Act 1988"
    },
