      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the act or practice occurred after the approval of the code came into effect;",
      "cml:conclusionText": "The complaint >= the approval of the code."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80-ss-1b-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Commissioner accepts the complaint before consulting the complainant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the Commissioner accepts the complaint;",
      "cml:conclusionText": "The Commissioner MUST accept the complaint before consulting the complainant."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80-ss-1b-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
