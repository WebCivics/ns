      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-6-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 4 If an organisation charges for providing access to personal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-6-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.83",
      "values:originalText": "information, those charges:\n\n(a) must not be excessive; and\n\n(b) must not apply to lodging a request for access.",
      "skos:definition": "information, those charges:\n\n(a) must not be excessive; and\n\n(b) must not apply to lodging a request for access.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-6-6-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-6-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ec05b600319edd8be2ab34f74194aa2887593ff86e5fa172f9f4077d2808bf53",
      "skos:note": "Charges for access to personal information must not be excessive.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-6-6",
      "@type": "cof:Section",
      "cof:title": "6 4 If an organisation charges for providing access to personal",
      "values:kind": "section",
      "cof:pageNumber": 83,
      "values:originalText": "information, those charges:\n\n(a) must not be excessive; and\n\n(b) must not apply to lodging a request for access."
    },
