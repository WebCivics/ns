      "@type": "cml:Concept",
      "skos:prefLabel": "5 2 On request by a person, an organisation must take reasonable steps",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-5-3"
      },
