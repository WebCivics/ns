    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53b-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "53B(2) Substituting respondent to determination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-53b-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.59",
      "values:originalText": "(2) The Commissioner may determine in writing that a specified\nagency to which services were or were to be provided under the\ncontract is the respondent to the determination under section 52.\nThe determination has effect according to its terms for the purposes\nof section 60.\nNote:\nThis means that the amount owed by the contracted service provider\nwill be a debt due by the agency to the complainant.",
      "skos:definition": "(2) The Commissioner may determine in writing that a specified\nagency to which services were or were to be provided under the\ncontract is the respondent to the determination under section 52.\nThe determination has effect according to its terms for the purposes\nof section 60.\nNote:\nThis means that the amount owed by the contracted service provider\nwill be a debt due by the agency to the complainant.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53b"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53b-ss-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53b-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53b-ss-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "efe894502342f79407965e7774ffcb7bce074e948880ca36535aaa5a75b73000",
      "skos:note": "Agency is respondent to determination under section 52."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-53b-ss-2",
      "@type": "cof:Section",
      "cof:title": "53B(2) Substituting respondent to determination",
      "values:kind": "subsection",
      "cof:pageNumber": 59,
      "values:originalText": "(2) The Commissioner may determine in writing that a specified\nagency to which services were or were to be provided under the\ncontract is the respondent to the determination under section 52.\nThe determination has effect according to its terms for the purposes\nof section 60.\nNote:\nThis means that the amount owed by the contracted service provider\nwill be a debt due by the agency to the complainant."
    },
