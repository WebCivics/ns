    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-35",
      "@type": "cml:Concept",
      "skos:prefLabel": "35 Subsection 6(8)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-35"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.17",
      "values:originalText": "Repeal the subsection, substitute:\n\n(8) For the purposes of this Act, the question whether bodies corporate\nare related to each other is determined in the manner in which that\nquestion is determined under the Corporations Law.\n\n(9) To avoid doubt, for the purposes of this Act, services provided to\nan agency or a State or Territory authority include services that\nconsist of the provision of services to other persons in connection\nwith the performance of the functions of the agency or State or\nTerritory authority.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(8) For the purposes of this Act, the question whether bodies corporate\nare related to each other is determined in the manner in which that\nquestion is determined under the Corporations Law.\n\n(9) To avoid doubt, for the purposes of this Act, services provided to\nan agency or a State or Territory authority include services that\nconsist of the provision of services to other persons in connection\nwith the performance of the functions of the agency or State or\nTerritory authority.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-35-ss-8"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-35-ss-9"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-35",
      "@type": "cof:Section",
      "cof:title": "35 Subsection 6(8)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Repeal the subsection, substitute:\n\n(8) For the purposes of this Act, the question whether bodies corporate\nare related to each other is determined in the manner in which that\nquestion is determined under the Corporations Law.\n\n(9) To avoid doubt, for the purposes of this Act, services provided to\nan agency or a State or Territory authority include services that\nconsist of the provision of services to other persons in connection\nwith the performance of the functions of the agency or State or\nTerritory authority."
    },
