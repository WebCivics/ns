    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 2 An organisation must not use or disclose an identifier assigned to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-7-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.84",
      "values:originalText": "an individual by an agency, or by an agent or contracted service\nprovider mentioned in subclause 7.1, unless:\n\n(a) the use or disclosure is necessary for the organisation to fulfil\nits obligations to the agency; or\n\n(b) one or more of paragraphs 2.1(e) to 2.1(h) (inclusive) apply\nto the use or disclosure; or\n\n(c) the use or disclosure is by a prescribed organisation of a\nprescribed identifier in prescribed circumstances.\nNote:\nThere are prerequisites that must be satisfied before the matters\nmentioned in paragraph (c) are prescribed: see subsection 100(2).",
      "skos:definition": "an individual by an agency, or by an agent or contracted service\nprovider mentioned in subclause 7.1, unless:\n\n(a) the use or disclosure is necessary for the organisation to fulfil\nits obligations to the agency; or\n\n(b) one or more of paragraphs 2.1(e) to 2.1(h) (inclusive) apply\nto the use or disclosure; or\n\n(c) the use or disclosure is by a prescribed organisation of a\nprescribed identifier in prescribed circumstances.\nNote:\nThere are prerequisites that must be satisfied before the matters\nmentioned in paragraph (c) are prescribed: see subsection 100(2).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "0817f2aec2b6c476ad1662e0b812c32466e3e19df0ffe94f1824824db9d8e870",
      "skos:note": "Organisation must not use or disclose an identifier assigned to an individual without certain exceptions."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-7-4",
      "@type": "cof:Section",
      "cof:title": "7 2 An organisation must not use or disclose an identifier assigned to",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "an individual by an agency, or by an agent or contracted service\nprovider mentioned in subclause 7.1, unless:\n\n(a) the use or disclosure is necessary for the organisation to fulfil\nits obligations to the agency; or\n\n(b) one or more of paragraphs 2.1(e) to 2.1(h) (inclusive) apply\nto the use or disclosure; or\n\n(c) the use or disclosure is by a prescribed organisation of a\nprescribed identifier in prescribed circumstances.\nNote:\nThere are prerequisites that must be satisfied before the matters\nmentioned in paragraph (c) are prescribed: see subsection 100(2)."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-norm",
