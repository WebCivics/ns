      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.52",
      "values:originalText": "Subsection 36(8) of the Privacy Act 1988 as amended by this Schedule\napplies in relation to complaints made after the commencement of this\nSchedule.",
      "skos:definition": "Subsection 36(8) of the Privacy Act 1988 as amended by this Schedule\napplies in relation to complaints made after the commencement of this\nSchedule.",
