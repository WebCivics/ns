      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.38",
      "values:originalText": "An act or practice of an organisation may be an interference with the\nprivacy of an individual under paragraph 13A(1)(c) of the Privacy Act\n1988 whether the contract mentioned in that paragraph was made before\nor after the commencement of section 13A of that Act.",
      "skos:definition": "An act or practice of an organisation may be an interference with the\nprivacy of an individual under paragraph 13A(1)(c) of the Privacy Act\n1988 whether the contract mentioned in that paragraph was made before\nor after the commencement of section 13A of that Act.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53-norm"
        }
      ],
      "cml:integrityHash": "7d02cfbd48af898a316387e8383d51c3a3737ba937e7ae8e1aa1f41ddac1dfb7",
      "skos:note": "An act or practice of an organisation may be an interference with the privacy of an individual."
    },
