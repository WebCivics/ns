    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-13e",
      "@type": "cml:Concept",
      "skos:prefLabel": "13E Effect on section 13 of sections 13B, 13C and 13D",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-13e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.38",
      "values:originalText": "Sections 13B, 13C and 13D do not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under section 13.\n13F  Act or practice not covered by section 13 or section 13A is not\nan interference with privacy\n\nAn act or practice that is not covered by section 13 or section 13A\nis not an interference with the privacy of an individual.",
      "skos:definition": "Sections 13B, 13C and 13D do not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under section 13.\n13F  Act or practice not covered by section 13 or section 13A is not\nan interference with privacy\n\nAn act or practice that is not covered by section 13 or section 13A\nis not an interference with the privacy of an individual.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-13e-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-13e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "babe1fedff5b9fea6fa79278769873557bd1ddfc2a8249263e96156d0fbb1c73",
      "skos:note": "Organisations can still be an interference with privacy under section 13."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-13e",
      "@type": "cof:Section",
      "cof:title": "13E Effect on section 13 of sections 13B, 13C and 13D",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Sections 13B, 13C and 13D do not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under section 13.\n13F  Act or practice not covered by section 13 or section 13A is not\nan interference with privacy\n\nAn act or practice that is not covered by section 13 or section 13A\nis not an interference with the privacy of an individual."
    },
    {
