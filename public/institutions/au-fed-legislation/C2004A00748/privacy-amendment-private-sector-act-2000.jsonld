        }
      ],
      "cml:integrityHash": "58d30fe7d9eafa48cd33a6e07f828eae2829c265f22f24dbf0be0f80163a7744",
      "skos:note": "Commissioner satisfies subsection 43(1A) if amends complaint during investigation."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-50a-ss-4",
      "@type": "cof:Section",
      "cof:title": "50A(4) Substitution of respondent to complaint",
      "values:kind": "subsection",
      "cof:pageNumber": 57,
      "values:originalText": "(4) If the Commissioner amends the complaint after starting to\ninvestigate it, the Commissioner is taken to have satisfied\nsubsection 43(1A) in relation to the agency."
    },
