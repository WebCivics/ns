    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "takes",
      "cml:logicSummary": "Implication of obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An act done by a member is an act done by the organisation.",
      "cml:conclusionText": "The organisation takes the act."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relation between acts",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An act done by a member is during the act of the committee.",
      "cml:conclusionText": "The act of the committee is during the act of the organisation."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-4-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implication of obligation",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An act done by a member implies that the organisation does the act.",
      "cml:conclusionText": "The organisation does the act."
    },
