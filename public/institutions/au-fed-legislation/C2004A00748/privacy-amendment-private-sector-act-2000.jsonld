    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-2-4",
      "@type": "cof:Section",
      "cof:title": "2 3 Subclause 2.1 operates in relation to personal information that an",
      "values:kind": "section",
