    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "6D(9) Small business and small business operators",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-6d-ss-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.22",
      "values:originalText": "(9) Despite subsection (3), a body corporate is not a small business\noperator if it is related to a body corporate that carries on a\nbusiness that is not a small business.",
      "skos:definition": "(9) Despite subsection (3), a body corporate is not a small business\noperator if it is related to a body corporate that carries on a\nbusiness that is not a small business.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-9-norm"
        }
      ],
      "cml:integrityHash": "140a3fd354b967caba41170686874c8dfa63c4b79b34f4b1e3f5882b845d942b",
      "skos:note": "A body corporate is not a small business operator if it is related to a body corporate that carries on a business that is not a small business."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-6d-ss-9",
      "@type": "cof:Section",
      "cof:title": "6D(9) Small business and small business operators",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(9) Despite subsection (3), a body corporate is not a small business\noperator if it is related to a body corporate that carries on a\nbusiness that is not a small business."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-9-norm",
