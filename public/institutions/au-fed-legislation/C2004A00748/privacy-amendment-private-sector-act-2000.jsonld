          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16c-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16c-ss-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16c-ss-4"
