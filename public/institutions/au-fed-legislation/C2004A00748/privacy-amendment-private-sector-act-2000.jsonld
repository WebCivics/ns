    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Subsection 134(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.91",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) This section applies to an industry standard that deals with a matter\nset out in paragraph 113(3)(f), including a matter dealt with by:\n\n(a) the National Privacy Principles (as defined in the Privacy Act\n1988); or\n\n(b) other provisions of that Act relating to those Principles; or\n\n(c) an approved privacy code (as defined in that Act); or\n\n(d) provisions of that Act that relate to an approved privacy\ncode.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) This section applies to an industry standard that deals with a matter\nset out in paragraph 113(3)(f), including a matter dealt with by:\n\n(a) the National Privacy Principles (as defined in the Privacy Act\n1988); or\n\n(b) other provisions of that Act relating to those Principles; or\n\n(c) an approved privacy code (as defined in that Act); or\n\n(d) provisions of that Act that relate to an approved privacy\ncode.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-15-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "76eae0b1440864188e18cab2d05793e98089bd76d6a992c6c5f8b4e37760455c",
      "skos:note": "Repeal subsection, substitute with new section applying to industry standards related to privacy principles and codes."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Subsection 134(1)",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) This section applies to an industry standard that deals with a matter\nset out in paragraph 113(3)(f), including a matter dealt with by:\n\n(a) the National Privacy Principles (as defined in the Privacy Act\n1988); or\n\n(b) other provisions of that Act relating to those Principles; or\n\n(c) an approved privacy code (as defined in that Act); or\n\n(d) provisions of that Act that relate to an approved privacy\ncode."
    },
