    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6d-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "6D(7) Small business and small business operators",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-6d-ss-7"
      },
