    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98",
      "@type": "cml:Concept",
      "skos:prefLabel": "98 After subsection 54(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-98"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.60",
      "values:originalText": "Insert:\n\n(1A) This Division also applies to a determination made by an\nadjudicator for an approved privacy code under the code in relation\nto a complaint made under the code.\nNote:\nThe making of a determination by the Commissioner under this Act or\nby an adjudicator under an approved privacy code is subject to judicial\nreview under the Administrative Decisions (Judicial Review) Act\n1977.",
      "skos:definition": "Insert:\n\n(1A) This Division also applies to a determination made by an\nadjudicator for an approved privacy code under the code in relation\nto a complaint made under the code.\nNote:\nThe making of a determination by the Commissioner under this Act or\nby an adjudicator under an approved privacy code is subject to judicial\nreview under the Administrative Decisions (Judicial Review) Act\n1977.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98-logic-deontic-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98-logic-deontic-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98-logic-alleninterval-4"
        }
      ],
      "cml:integrityHash": "cc89a24c5edd5b015ddc321cdd433896a89383bdc25e6afbb84f8b1ad20de5ca",
      "skos:note": "Judicial review of privacy code determinations is subject to the Administrative Decisions (Judicial Review) Act 1977."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-98",
      "@type": "cof:Section",
      "cof:title": "98 After subsection 54(1)",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "Insert:\n\n(1A) This Division also applies to a determination made by an\nadjudicator for an approved privacy code under the code in relation\nto a complaint made under the code.\nNote:\nThe making of a determination by the Commissioner under this Act or\nby an adjudicator under an approved privacy code is subject to judicial\nreview under the Administrative Decisions (Judicial Review) Act\n1977."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-98-norm",
