    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-93",
      "@type": "cml:Concept",
      "skos:prefLabel": "93 At the end of section 48",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-93"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
