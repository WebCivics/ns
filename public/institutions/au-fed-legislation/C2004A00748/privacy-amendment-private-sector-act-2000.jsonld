    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 At the end of subsection 130(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.91",
      "values:originalText": "Add:\nNote:\nThe ACA may be satisfied that it is necessary or convenient to vary an\nindustry standard that is inconsistent with the National Privacy\nPrinciples or an approved privacy code (as defined in the Privacy Act\n1988), following advice given by the Privacy Commissioner in the\nexercise of his or her functions under that Act.",
      "skos:definition": "Add:\nNote:\nThe ACA may be satisfied that it is necessary or convenient to vary an\nindustry standard that is inconsistent with the National Privacy\nPrinciples or an approved privacy code (as defined in the Privacy Act\n1988), following advice given by the Privacy Commissioner in the\nexercise of his or her functions under that Act.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-14-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c75b846304db42e0e6b115153238c1d4baa42aabba218d57fe561ba82b63e83",
      "skos:note": "Allowing variation of industry standards under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 At the end of subsection 130(1)",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "Add:\nNote:\nThe ACA may be satisfied that it is necessary or convenient to vary an\nindustry standard that is inconsistent with the National Privacy\nPrinciples or an approved privacy code (as defined in the Privacy Act\n1988), following advice given by the Privacy Commissioner in the\nexercise of his or her functions under that Act."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-14-norm",
