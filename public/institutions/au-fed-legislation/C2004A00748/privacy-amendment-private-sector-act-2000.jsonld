      },
      "cml:premiseText": "The journalist has a reasonable excuse.",
      "cml:conclusionText": "There is a temporal until: The journalist's reasonable excuse holds until the time when giving information would reveal the identity of an informant."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffusion: The journalist's reasonable excuse diffuses to all situations where giving information would tend to reveal the identity of an informant.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
