    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16b",
      "@type": "cml:Concept",
      "skos:prefLabel": "16B Personal information in records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-16b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.39",
      "values:originalText": "(1) This Act (except Divisions 4 and 5 of Part III and Part IIIA)\napplies to the collection of personal information by an organisation\nonly if the information is collected for inclusion in a record or a\ngenerally available publication.\n\n(2) This Act (except Divisions 4 and 5 of Part III and Part IIIA)\napplies to personal information that has been collected by an\norganisation only if the information is held by the organisation in a\nrecord.\n\nSchedule 1  Amendment of the Privacy Act 1988",
      "skos:definition": "(1) This Act (except Divisions 4 and 5 of Part III and Part IIIA)\napplies to the collection of personal information by an organisation\nonly if the information is collected for inclusion in a record or a\ngenerally available publication.\n\n(2) This Act (except Divisions 4 and 5 of Part III and Part IIIA)\napplies to personal information that has been collected by an\norganisation only if the information is held by the organisation in a\nrecord.\n\nSchedule 1  Amendment of the Privacy Act 1988",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16b-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-16b-ss-2"
        }
      ],
      "cml:integrityHash": "8658f66585c1f0cf27440895aab466ef249e08151202e26637c40e4f419309cb"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-16b",
      "@type": "cof:Section",
      "cof:title": "16B Personal information in records",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "(1) This Act (except Divisions 4 and 5 of Part III and Part IIIA)\napplies to the collection of personal information by an organisation\nonly if the information is collected for inclusion in a record or a\ngenerally available publication.\n\n(2) This Act (except Divisions 4 and 5 of Part III and Part IIIA)\napplies to personal information that has been collected by an\norganisation only if the information is held by the organisation in a\nrecord.\n\nSchedule 1  Amendment of the Privacy Act 1988"
    },
