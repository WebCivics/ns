    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 3 In this clause:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-7-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.84",
      "values:originalText": "identifier includes a number assigned by an organisation to an\nindividual to identify uniquely the individual for the purposes of\nthe organisation’s operations. However, an individual’s name or\nABN (as defined in the A New Tax System (Australian Business\nNumber) Act 1999) is not an identifier.",
      "skos:definition": "identifier includes a number assigned by an organisation to an\nindividual to identify uniquely the individual for the purposes of\nthe organisation’s operations. However, an individual’s name or\nABN (as defined in the A New Tax System (Australian Business\nNumber) Act 1999) is not an identifier.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-5-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-5-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-5-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "e181317b0e0725f01d1f2a35f694e6d0dcb5293d5430923df3888c93f44194d7",
      "skos:note": "An identifier must be assigned by an organisation to uniquely identify an individual."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-7-5",
      "@type": "cof:Section",
      "cof:title": "7 3 In this clause:",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "identifier includes a number assigned by an organisation to an\nindividual to identify uniquely the individual for the purposes of\nthe organisation’s operations. However, an individual’s name or\nABN (as defined in the A New Tax System (Australian Business\nNumber) Act 1999) is not an identifier."
    },
