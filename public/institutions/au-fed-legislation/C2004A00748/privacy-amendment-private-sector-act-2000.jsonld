      "skos:note": "Court may receive certain documents as evidence in proceedings about a determination made by an adjudicator under an approved privacy code."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-55a-ss-7",
      "@type": "cof:Section",
