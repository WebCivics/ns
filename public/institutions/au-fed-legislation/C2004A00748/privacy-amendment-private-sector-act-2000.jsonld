      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to collect health information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Organisation may collect health information under certain conditions."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-10-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 3 Despite subclause 10.1, an organisation may collect health",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-10-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.86",
      "values:originalText": "information about an individual if:\n\n(a) the collection is necessary for any of the following purposes:\n\n(i) research relevant to public health or public safety;\n\n(ii) the compilation or analysis of statistics relevant to\npublic health or public safety;\n\n(iii) the management, funding or monitoring of a health\nservice; and\n\n(b) that purpose cannot be served by the collection of\ninformation that does not identify the individual or from\n\nAmendment of the Privacy Act 1988  Schedule 1\n\nwhich the individual’s identity cannot reasonably be\nascertained; and\n\n(c) it is impracticable for the organisation to seek the\nindividual’s consent to the collection; and\n\n(d) the information is collected:\n\n(i) as required by law (other than this Act); or\n\n(ii) in accordance with rules established by competent\nhealth or medical bodies that deal with obligations of\nprofessional confidentiality which bind the organisation;\nor\n\n(iii) in accordance with guidelines approved by the\nCommissioner under section 95A for the purposes of\nthis subparagraph.",
      "skos:definition": "information about an individual if:\n\n(a) the collection is necessary for any of the following purposes:\n\n(i) research relevant to public health or public safety;\n\n(ii) the compilation or analysis of statistics relevant to\npublic health or public safety;\n\n(iii) the management, funding or monitoring of a health\nservice; and\n\n(b) that purpose cannot be served by the collection of\ninformation that does not identify the individual or from\n\nAmendment of the Privacy Act 1988  Schedule 1\n\nwhich the individual’s identity cannot reasonably be\nascertained; and\n\n(c) it is impracticable for the organisation to seek the\nindividual’s consent to the collection; and\n\n(d) the information is collected:\n\n(i) as required by law (other than this Act); or\n\n(ii) in accordance with rules established by competent\nhealth or medical bodies that deal with obligations of\nprofessional confidentiality which bind the organisation;\nor\n\n(iii) in accordance with guidelines approved by the\nCommissioner under section 95A for the purposes of\nthis subparagraph.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-10-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-10-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7f1c6e7b6bc0742859d4b0cfc5a2c6e0e402a3f630a0e9bfc8903d2a13ce56c8",
      "skos:note": "Organisation may collect health information under specified conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-10-4",
      "@type": "cof:Section",
      "cof:title": "10 3 Despite subclause 10.1, an organisation may collect health",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "information about an individual if:\n\n(a) the collection is necessary for any of the following purposes:\n\n(i) research relevant to public health or public safety;\n\n(ii) the compilation or analysis of statistics relevant to\npublic health or public safety;\n\n(iii) the management, funding or monitoring of a health\nservice; and\n\n(b) that purpose cannot be served by the collection of\ninformation that does not identify the individual or from\n\nAmendment of the Privacy Act 1988  Schedule 1\n\nwhich the individual’s identity cannot reasonably be\nascertained; and\n\n(c) it is impracticable for the organisation to seek the\nindividual’s consent to the collection; and\n\n(d) the information is collected:\n\n(i) as required by law (other than this Act); or\n\n(ii) in accordance with rules established by competent\nhealth or medical bodies that deal with obligations of\nprofessional confidentiality which bind the organisation;\nor\n\n(iii) in accordance with guidelines approved by the\nCommissioner under section 95A for the purposes of\nthis subparagraph."
    },
