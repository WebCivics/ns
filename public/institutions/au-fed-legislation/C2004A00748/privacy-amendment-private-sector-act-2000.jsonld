    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-12b-ss-1",
      "@type": "cof:Section",
      "cof:title": "12B(1) Severability: additional effect of Act in relation to organisations",
      "values:kind": "subsection",
      "cof:pageNumber": 33,
      "values:originalText": "(1) Without limiting its effect apart from each of the following\nsubsections of this section, this Act also has effect in relation to\norganisations as provided by that subsection."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-12b-ss-1-norm",
