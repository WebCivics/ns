    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-95a-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "95A(5) Guidelines for National Privacy Principles about health",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-95a-ss-5"
      },
      "cml:curationStatus": {
