    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-74-ss-1c",
      "@type": "cml:Concept",
      "skos:prefLabel": "74(1C) After subsection 36(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-74-ss-1c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.51",
      "values:originalText": "(1C) Subsection (1A) does not prevent an individual from complaining\nunder this Part to the Commissioner about an act done, or practice\nengaged in, by an organisation purportedly for the purpose of\nmeeting (directly or indirectly) an obligation under a\nCommonwealth contract (whether or not the organisation is a party\nto the contract).\nNote:\nSection 40A requires an adjudicator for an approved privacy code to\nrefer a code complaint to the Commissioner if the complaint is about\nan act or practice of a contracted service provider for a\nCommonwealth contract.",
      "skos:definition": "(1C) Subsection (1A) does not prevent an individual from complaining\nunder this Part to the Commissioner about an act done, or practice\nengaged in, by an organisation purportedly for the purpose of\nmeeting (directly or indirectly) an obligation under a\nCommonwealth contract (whether or not the organisation is a party\nto the contract).\nNote:\nSection 40A requires an adjudicator for an approved privacy code to\nrefer a code complaint to the Commissioner if the complaint is about\nan act or practice of a contracted service provider for a\nCommonwealth contract.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-74"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-74-ss-1c-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-74-ss-1c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5e4fb4ef0820bef99dcefbff8208ad65c6fd57ac98772e5aa9ecfc5c19fca6eb",
      "skos:note": "An individual can complain about an act done by an organisation meeting a Commonwealth contract obligation."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-74-ss-1c",
      "@type": "cof:Section",
      "cof:title": "74(1C) After subsection 36(1)",
      "values:kind": "subsection",
      "cof:pageNumber": 51,
      "values:originalText": "(1C) Subsection (1A) does not prevent an individual from complaining\nunder this Part to the Commissioner about an act done, or practice\nengaged in, by an organisation purportedly for the purpose of\nmeeting (directly or indirectly) an obligation under a\nCommonwealth contract (whether or not the organisation is a party\nto the contract).\nNote:\nSection 40A requires an adjudicator for an approved privacy code to\nrefer a code complaint to the Commissioner if the complaint is about\nan act or practice of a contracted service provider for a\nCommonwealth contract."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-74-ss-1c-norm",
      "@type": "values:Obligation",
