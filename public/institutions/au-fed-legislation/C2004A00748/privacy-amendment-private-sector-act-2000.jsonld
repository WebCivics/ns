      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.36",
      "values:originalText": "(2) Subsection (1) does not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under paragraph 13A(1)(c) or (d).",
      "skos:definition": "(2) Subsection (1) does not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under paragraph 13A(1)(c) or (d).",
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-13b"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-13b-ss-2-norm"
        }
      ],
      "cml:integrityHash": "acbf0b81a026fb093e1c3ed4217f621c0976879fdfc739d77b390789fb9a697e",
      "skos:note": "Organisation's act or practice may interfere with individual's privacy."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-13b-ss-2",
      "@type": "cof:Section",
      "cof:title": "13B(2) Related bodies corporate",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(2) Subsection (1) does not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under paragraph 13A(1)(c) or (d)."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-13b-ss-2-norm",
      "@type": "values:Obligation",
