    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-55a-ss-7a",
      "@type": "cof:Section",
      "cof:title": "55A(7A) Proceedings in the Federal Court or Federal Magistrates Court",
      "values:kind": "subsection",
      "cof:pageNumber": 61,
      "values:originalText": "(7A) In conducting a hearing and making an order under this section, the\ncourt is to have due regard to the matters that paragraph 29(a)\nrequires the Commissioner to have due regard to."
    },
