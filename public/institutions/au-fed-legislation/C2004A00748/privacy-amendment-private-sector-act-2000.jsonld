    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 After subsection 7(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.94",
      "values:originalText": "Insert:\n\n(1A) Despite subsections (1) and (2), a reference in this Act (other than\nsection 8) to an act or to a practice does not include a reference to\nthe act or practice so far as it involves the disclosure of personal\ninformation to:\n\n(a) the Australian Security Intelligence Organisation; or\n\n(b) the Australian Secret Intelligence Service.",
      "skos:definition": "Insert:\n\n(1A) Despite subsections (1) and (2), a reference in this Act (other than\nsection 8) to an act or to a practice does not include a reference to\nthe act or practice so far as it involves the disclosure of personal\ninformation to:\n\n(a) the Australian Security Intelligence Organisation; or\n\n(b) the Australian Secret Intelligence Service.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3-2-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-3-2-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "99f06500adfc074c72e00eb3c9c0d5eb646a212c0068ea579804e958a8aedb38",
      "skos:note": "Exempts disclosure of personal information to specified agencies"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 After subsection 7(1)",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "Insert:\n\n(1A) Despite subsections (1) and (2), a reference in this Act (other than\nsection 8) to an act or to a practice does not include a reference to\nthe act or practice so far as it involves the disclosure of personal\ninformation to:\n\n(a) the Australian Security Intelligence Organisation; or\n\n(b) the Australian Secret Intelligence Service."
    },
