    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-10-6",
      "@type": "cof:Section",
      "cof:title": "10 5 In this clause:",
      "values:kind": "section",
      "cof:pageNumber": 87,
      "values:originalText": "non-profit organisation means a non-profit organisation that has\nonly racial, ethnic, political, religious, philosophical, professional,\ntrade, or trade union aims.\n\nSchedule 2  Amendment of other Acts"
    },
