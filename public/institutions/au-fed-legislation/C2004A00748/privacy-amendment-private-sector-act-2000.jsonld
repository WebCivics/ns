      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.90",
      "values:originalText": "Insert:\n\n(1A) If the ACA is satisfied that the contravention of the industry code\nrelates directly or indirectly to a matter dealt with by the National\nPrivacy Principles (as defined in the Privacy Act 1988) or by an\napproved privacy code (as defined in that Act), the ACA must\nconsult the Privacy Commissioner before giving the direction.",
      "skos:definition": "Insert:\n\n(1A) If the ACA is satisfied that the contravention of the industry code\nrelates directly or indirectly to a matter dealt with by the National\nPrivacy Principles (as defined in the Privacy Act 1988) or by an\napproved privacy code (as defined in that Act), the ACA must\nconsult the Privacy Commissioner before giving the direction.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-11-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2e5dd3af9d66be003420d3bf8db7295cdbda291dafb35e4fd7b95bfe08d09c4f",
      "skos:note": "Consult Privacy Commissioner before giving direction if contravention relates to National Privacy Principles or approved privacy code."
    },
