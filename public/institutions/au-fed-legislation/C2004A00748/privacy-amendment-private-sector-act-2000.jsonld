    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-6-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 5 If an organisation holds personal information about an individual",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-6-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
