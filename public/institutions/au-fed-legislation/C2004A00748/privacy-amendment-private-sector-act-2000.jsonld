    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-133",
      "@type": "cml:Concept",
      "skos:prefLabel": "133 After subsection 97(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-133"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
