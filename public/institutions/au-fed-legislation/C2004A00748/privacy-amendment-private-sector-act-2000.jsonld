    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-18bh-ss-2",
      "@type": "cof:Section",
      "cof:title": "18BH(2) Review of operation of approved privacy code",
      "values:kind": "subsection",
      "cof:pageNumber": 48,
      "values:originalText": "(2) The Commissioner may do one or more of the following for the\npurposes of the review:\n\n(a) consider the process under the code for making and dealing\nwith complaints;\n\n(b) inspect the records of an adjudicator for the code;\n\n(c) consider the outcome of complaints dealt with under the\ncode;\n\n(d) interview an adjudicator for the code."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-18bh-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-18bh-ss-2"
      },
      "values:deonticStatus": {
