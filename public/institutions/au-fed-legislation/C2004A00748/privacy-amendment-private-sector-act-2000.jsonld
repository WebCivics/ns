    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "5B(3) Extra-territorial operation of Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-5b-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.8",
      "values:originalText": "(3) All of the following conditions must be met:\n\n(a) the organisation is not described in subsection (2);\n\n(b) the organisation carries on business in Australia or an\nexternal Territory;\n\n(c) the personal information was collected or held by the\norganisation in Australia or an external Territory, either\nbefore or at the time of the act or practice.\nPower to deal with complaints about overseas acts and practices",
      "skos:definition": "(3) All of the following conditions must be met:\n\n(a) the organisation is not described in subsection (2);\n\n(b) the organisation carries on business in Australia or an\nexternal Territory;\n\n(c) the personal information was collected or held by the\norganisation in Australia or an external Territory, either\nbefore or at the time of the act or practice.\nPower to deal with complaints about overseas acts and practices",
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-3-norm"
