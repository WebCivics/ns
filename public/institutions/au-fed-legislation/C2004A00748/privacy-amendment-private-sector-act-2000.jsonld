    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-1-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-1-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.76",
      "values:originalText": "3 At or before the time (or, if that is not practicable, as soon as\npracticable after) an organisation collects personal information\nabout an individual from the individual, the organisation must take\nreasonable steps to ensure that the individual is aware of:\n\n(a) the identity of the organisation and how to contact it; and\n\nAmendment of the Privacy Act 1988  Schedule 1\n\n(b) the fact that he or she is able to gain access to the\ninformation; and\n\n(c) the purposes for which the information is collected; and\n\n(d) the organisations (or the types of organisations) to which the\norganisation usually discloses information of that kind; and\n\n(e) any law that requires the particular information to be\ncollected; and\n\n(f) the main consequences (if any) for the individual if all or part\nof the information is not provided.",
      "skos:definition": "3 At or before the time (or, if that is not practicable, as soon as\npracticable after) an organisation collects personal information\nabout an individual from the individual, the organisation must take\nreasonable steps to ensure that the individual is aware of:\n\n(a) the identity of the organisation and how to contact it; and\n\nAmendment of the Privacy Act 1988  Schedule 1\n\n(b) the fact that he or she is able to gain access to the\ninformation; and\n\n(c) the purposes for which the information is collected; and\n\n(d) the organisations (or the types of organisations) to which the\norganisation usually discloses information of that kind; and\n\n(e) any law that requires the particular information to be\ncollected; and\n\n(f) the main consequences (if any) for the individual if all or part\nof the information is not provided.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-1-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-1-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "33ee9e454498d387d443b3ae507275e64e26bddd769ffbd414125eb6a105a6da",
      "skos:note": "Organisation must inform individual of personal information collection details.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-1-4",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "3 At or before the time (or, if that is not practicable, as soon as\npracticable after) an organisation collects personal information\nabout an individual from the individual, the organisation must take\nreasonable steps to ensure that the individual is aware of:\n\n(a) the identity of the organisation and how to contact it; and\n\nAmendment of the Privacy Act 1988  Schedule 1\n\n(b) the fact that he or she is able to gain access to the\ninformation; and\n\n(c) the purposes for which the information is collected; and\n\n(d) the organisations (or the types of organisations) to which the\norganisation usually discloses information of that kind; and\n\n(e) any law that requires the particular information to be\ncollected; and\n\n(f) the main consequences (if any) for the individual if all or part\nof the information is not provided."
    },
    {
