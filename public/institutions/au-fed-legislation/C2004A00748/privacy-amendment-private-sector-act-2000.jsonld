      "cml:premiseText": "18 years old",
      "cml:conclusionText": "Relative of the individual"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 6 In subclause 2.5:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-2-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.80",
      "values:originalText": "Amendment of the Privacy Act 1988  Schedule 1\n\nchild of an individual includes an adopted child, a step-child and a\nfoster-child, of the individual.\nparent of an individual includes a step-parent, adoptive parent and\na foster-parent, of the individual.\nrelative of an individual means a grandparent, grandchild, uncle,\naunt, nephew or niece, of the individual.\nsibling of an individual includes a half-brother, half-sister,\nadoptive brother, adoptive sister, step-brother, step-sister,\nfoster-brother and foster-sister, of the individual.",
      "skos:definition": "Amendment of the Privacy Act 1988  Schedule 1\n\nchild of an individual includes an adopted child, a step-child and a\nfoster-child, of the individual.\nparent of an individual includes a step-parent, adoptive parent and\na foster-parent, of the individual.\nrelative of an individual means a grandparent, grandchild, uncle,\naunt, nephew or niece, of the individual.\nsibling of an individual includes a half-brother, half-sister,\nadoptive brother, adoptive sister, step-brother, step-sister,\nfoster-brother and foster-sister, of the individual.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-7-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-7-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-7-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-2-7-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "9e4555418abd765c7d582ed21780211ffcb5f263eb2dc334082989f8eabdf9ae",
      "skos:note": "Defines family relationships for the purpose of the Privacy Act 1988"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-2-7",
      "@type": "cof:Section",
      "cof:title": "2 6 In subclause 2.5:",
      "values:kind": "section",
      "cof:pageNumber": 80,
      "values:originalText": "Amendment of the Privacy Act 1988  Schedule 1\n\nchild of an individual includes an adopted child, a step-child and a\nfoster-child, of the individual.\nparent of an individual includes a step-parent, adoptive parent and\na foster-parent, of the individual.\nrelative of an individual means a grandparent, grandchild, uncle,\naunt, nephew or niece, of the individual.\nsibling of an individual includes a half-brother, half-sister,\nadoptive brother, adoptive sister, step-brother, step-sister,\nfoster-brother and foster-sister, of the individual."
    },
