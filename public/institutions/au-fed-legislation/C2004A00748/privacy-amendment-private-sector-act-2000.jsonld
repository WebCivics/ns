    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80e",
      "@type": "cml:Concept",
      "skos:prefLabel": "80E Register of determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-80e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.72",
      "values:originalText": "(1) The Commissioner must keep a register of determinations made\nunder Division 1 or 2.\n\n(2) The Commissioner may decide the form of the register and how it\nis to be kept.\n\n(3) The Commissioner must make the register available to the public\nin the way that the Commissioner determines.\n\n(4) The Commissioner may charge fees for:\n\n(a) making the register available to the public; or\n\n(b) providing copies of, or extracts from, the register.",
      "skos:definition": "(1) The Commissioner must keep a register of determinations made\nunder Division 1 or 2.\n\n(2) The Commissioner may decide the form of the register and how it\nis to be kept.\n\n(3) The Commissioner must make the register available to the public\nin the way that the Commissioner determines.\n\n(4) The Commissioner may charge fees for:\n\n(a) making the register available to the public; or\n\n(b) providing copies of, or extracts from, the register.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80e-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80e-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80e-ss-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-80e-ss-4"
        }
      ],
      "cml:integrityHash": "7afcc2dee533d29a73f9e7cf9821bb4cb5d4887b9981e288f1d784b1d9cf4d02"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-80e",
      "@type": "cof:Section",
      "cof:title": "80E Register of determinations",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "(1) The Commissioner must keep a register of determinations made\nunder Division 1 or 2.\n\n(2) The Commissioner may decide the form of the register and how it\nis to be kept.\n\n(3) The Commissioner must make the register available to the public\nin the way that the Commissioner determines.\n\n(4) The Commissioner may charge fees for:\n\n(a) making the register available to the public; or\n\n(b) providing copies of, or extracts from, the register."
    },
