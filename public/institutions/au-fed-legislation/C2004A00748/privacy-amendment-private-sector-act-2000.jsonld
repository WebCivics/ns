    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-55a-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "55A(6) Proceedings in the Federal Court or Federal Magistrates Court",
