      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.52",
      "values:originalText": "Omit “For the purposes of this Part, the”, substitute “The”.",
      "skos:definition": "Omit “For the purposes of this Part, the”, substitute “The”.",
