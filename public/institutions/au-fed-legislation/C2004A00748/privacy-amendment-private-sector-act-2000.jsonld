      },
      "cml:operator": "Until",
      "cml:logicSummary": "Temporal until: The journalist's reasonable excuse holds until the time when giving information would reveal the identity of an informant.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
