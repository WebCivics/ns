    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-89",
      "@type": "cml:Concept",
      "skos:prefLabel": "89 After subsection 43(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-89"
      },
      "cml:curationStatus": {
