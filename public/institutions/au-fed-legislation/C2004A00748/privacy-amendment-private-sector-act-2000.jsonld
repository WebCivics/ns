    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-95c",
      "@type": "cml:Concept",
      "skos:prefLabel": "95C Disclosure of certain provisions of Commonwealth contracts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-95c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.75",
      "values:originalText": "If a person asks a party to a Commonwealth contract to be\ninformed of the content of provisions (if any) of the contract that\nare inconsistent with an approved privacy code binding a party to\nthe contract or with a National Privacy Principle, the party\nrequested must inform the person in writing of that content (if any).",
      "skos:definition": "If a person asks a party to a Commonwealth contract to be\ninformed of the content of provisions (if any) of the contract that\nare inconsistent with an approved privacy code binding a party to\nthe contract or with a National Privacy Principle, the party\nrequested must inform the person in writing of that content (if any).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-95c-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-95c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8437072d4da3799de4bf25928b59dc0ca13dbb9d726d84d5e55df634eeee4439",
      "skos:note": "Party must inform person of inconsistent contract provisions.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-95c",
      "@type": "cof:Section",
      "cof:title": "95C Disclosure of certain provisions of Commonwealth contracts",
      "values:kind": "section",
      "cof:pageNumber": 75,
      "values:originalText": "If a person asks a party to a Commonwealth contract to be\ninformed of the content of provisions (if any) of the contract that\nare inconsistent with an approved privacy code binding a party to\nthe contract or with a National Privacy Principle, the party\nrequested must inform the person in writing of that content (if any)."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-95c-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
