      }
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "47(4) At the end of section 8",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-47-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.33",
      "values:originalText": "(4) For the purposes of the application of this Act in relation to an\norganisation that is an unincorporated association:\n\n(a) an act done or practice engaged in by a member of the\ncommittee of management of the association is taken to have\nbeen done or engaged in by the organisation; and\n\n(b) a communication (including a complaint, notice, request or\ndisclosure of information) made to a member of the\ncommittee of management of the association is taken to have\nbeen made to the organisation.",
      "skos:definition": "(4) For the purposes of the application of this Act in relation to an\norganisation that is an unincorporated association:\n\n(a) an act done or practice engaged in by a member of the\ncommittee of management of the association is taken to have\nbeen done or engaged in by the organisation; and\n\n(b) a communication (including a complaint, notice, request or\ndisclosure of information) made to a member of the\ncommittee of management of the association is taken to have\nbeen made to the organisation.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-47-ss-4-logic-argumentation-3"
        }
      ],
      "cml:integrityHash": "cce01b137a29945dce9b680ccfaaf49c512fabcb239623203b3d1d7a8e69df17",
      "skos:note": "An act done by a member of the committee is taken to have been done by the organisation."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-47-ss-4",
      "@type": "cof:Section",
