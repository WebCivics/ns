    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "53A(3) Notice to be given to outsourcing agency",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-53a-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.58",
      "values:originalText": "(3) An agency that receives a recommendation from the Commissioner\nmust tell the Commissioner in writing of any action the agency\nproposes to take in relation to the recommendation. The agency\nmust do so within 60 days of receiving the recommendation.",
      "skos:definition": "(3) An agency that receives a recommendation from the Commissioner\nmust tell the Commissioner in writing of any action the agency\nproposes to take in relation to the recommendation. The agency\nmust do so within 60 days of receiving the recommendation.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53a"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53a-ss-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53a-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "45d1ca3c38669a363daa973ce17f9a579771b51292343add30311a2bbde7284f",
      "skos:note": "Agency must notify Commissioner of proposed action within 60 days.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-53a-ss-3",
      "@type": "cof:Section",
      "cof:title": "53A(3) Notice to be given to outsourcing agency",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(3) An agency that receives a recommendation from the Commissioner\nmust tell the Commissioner in writing of any action the agency\nproposes to take in relation to the recommendation. The agency\nmust do so within 60 days of receiving the recommendation."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-53a-ss-3-norm",
