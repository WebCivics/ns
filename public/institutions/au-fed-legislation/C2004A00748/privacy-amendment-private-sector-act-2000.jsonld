    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-67",
      "@type": "cml:Concept",
      "skos:prefLabel": "67 After subsection 27(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-67"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.50",
      "values:originalText": "Insert:\n\n(1A) To avoid doubt, the Commissioner is not subject to Part V in\nperforming functions, and exercising powers, conferred on an\nadjudicator by an approved privacy code under which the\nCommissioner has been appointed as an independent adjudicator to\nwhom complaints may be made.",
      "skos:definition": "Insert:\n\n(1A) To avoid doubt, the Commissioner is not subject to Part V in\nperforming functions, and exercising powers, conferred on an\nadjudicator by an approved privacy code under which the\nCommissioner has been appointed as an independent adjudicator to\nwhom complaints may be made.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-67-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-67-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4d2747b00f160804a18e5f0d43dc3f014b6bebcd02a488443e00636242d808d9",
      "skos:note": "Commissioner not subject to Part V in performing functions and exercising powers."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-67",
      "@type": "cof:Section",
      "cof:title": "67 After subsection 27(1)",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Insert:\n\n(1A) To avoid doubt, the Commissioner is not subject to Part V in\nperforming functions, and exercising powers, conferred on an\nadjudicator by an approved privacy code under which the\nCommissioner has been appointed as an independent adjudicator to\nwhom complaints may be made."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-67-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-67"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-67-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Commissioner has an obligation not to be subject to Part V.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-68",
      "@type": "cml:Concept",
      "skos:prefLabel": "68 At the end of section 27",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-68"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.50",
      "values:originalText": "Add:\n\n(3) Without limiting subsection (2), the Commissioner may, at the\nrequest of an organisation, examine the records of personal\n\nAmendment of the Privacy Act 1988  Schedule 1\n\ninformation maintained by the organisation, for the purpose of\nascertaining whether the records are maintained according to:\n\n(a) an approved privacy code that binds the organisation; or\n\n(b) to the extent (if any) that the organisation is not bound by an\napproved privacy code—the National Privacy Principles.",
      "skos:definition": "Add:\n\n(3) Without limiting subsection (2), the Commissioner may, at the\nrequest of an organisation, examine the records of personal\n\nAmendment of the Privacy Act 1988  Schedule 1\n\ninformation maintained by the organisation, for the purpose of\nascertaining whether the records are maintained according to:\n\n(a) an approved privacy code that binds the organisation; or\n\n(b) to the extent (if any) that the organisation is not bound by an\napproved privacy code—the National Privacy Principles.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-68-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-68-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1b7e379a57a6ee864278b9f1b4b41380bcb39f1988c7fd1fba5b1958ad9d79be",
      "skos:note": "Commissioner may examine records of an organisation upon request."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-68",
      "@type": "cof:Section",
      "cof:title": "68 At the end of section 27",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Add:\n\n(3) Without limiting subsection (2), the Commissioner may, at the\nrequest of an organisation, examine the records of personal\n\nAmendment of the Privacy Act 1988  Schedule 1\n\ninformation maintained by the organisation, for the purpose of\nascertaining whether the records are maintained according to:\n\n(a) an approved privacy code that binds the organisation; or\n\n(b) to the extent (if any) that the organisation is not bound by an\napproved privacy code—the National Privacy Principles."
    },
