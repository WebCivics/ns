    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-6ea-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6EA(6) Small business operators choosing to be treated as",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-6ea-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
