        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-3-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-5b-ss-3-logic-ltl-3"
        },
