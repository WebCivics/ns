    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Paragraph 27(1)(f)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.50",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(f) to provide (on request or on the Commissioner’s own\ninitiative) advice to a Minister, agency or organisation on any\nmatter relevant to the operation of this Act;\n\n(fa) to provide advice to an adjudicator for an approved privacy\ncode on any matter relevant to the operation of this Act or the\ncode, on request by the adjudicator;",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(f) to provide (on request or on the Commissioner’s own\ninitiative) advice to a Minister, agency or organisation on any\nmatter relevant to the operation of this Act;\n\n(fa) to provide advice to an adjudicator for an approved privacy\ncode on any matter relevant to the operation of this Act or the\ncode, on request by the adjudicator;",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-64-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-64-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8ef24caa72d10bc788e6c31b368b03cbe74b18036e322a41c8596178887cb017",
      "skos:note": "Provide advice on matters relevant to the operation of this Act.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-64",
      "@type": "cof:Section",
      "cof:title": "64 Paragraph 27(1)(f)",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(f) to provide (on request or on the Commissioner’s own\ninitiative) advice to a Minister, agency or organisation on any\nmatter relevant to the operation of this Act;\n\n(fa) to provide advice to an adjudicator for an approved privacy\ncode on any matter relevant to the operation of this Act or the\ncode, on request by the adjudicator;"
    },
