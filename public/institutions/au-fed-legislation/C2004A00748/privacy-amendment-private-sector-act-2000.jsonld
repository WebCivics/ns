      "skos:note": "Personal information must be held in a record for the Act to apply."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-16b-ss-2",
      "@type": "cof:Section",
      "cof:title": "16B(2) Personal information in records",
      "values:kind": "subsection",
