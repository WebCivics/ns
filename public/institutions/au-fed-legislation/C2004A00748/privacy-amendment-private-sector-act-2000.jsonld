        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The journalist has a reasonable excuse.",
      "cml:conclusionText": "There is an obligation to keep confidential the identity of an informant."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap: The journalist's reasonable excuse overlaps with the time when giving information would reveal the identity of an informant.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The journalist has a reasonable excuse.",
      "cml:conclusionText": "There is a temporal overlap: The journalist's reasonable excuse overlaps with the time when giving information would reveal the identity of an informant."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-106-logic-ltl-3",
      "@type": "cml:LogicApplication",
