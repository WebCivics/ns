    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-55a-ss-5",
      "@type": "cof:Section",
      "cof:title": "55A(5) Proceedings in the Federal Court or Federal Magistrates Court",
      "values:kind": "subsection",
      "cof:pageNumber": 61,
      "values:originalText": "(5) The court is to deal by way of a hearing de novo with the question\nwhether the respondent has engaged in conduct that constitutes an\ninterference with the privacy of the complainant.\n\nSchedule 1  Amendment of the Privacy Act 1988"
    },
