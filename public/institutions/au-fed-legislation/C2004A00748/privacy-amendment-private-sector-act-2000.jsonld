    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-4-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-4-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.94",
      "values:originalText": "The amendment of the Privacy Act 1988 made by this Schedule applies\nfor the purposes of determining the operation of that Act in relation to\nan act or practice, regardless of whether the act or practice occurred\nbefore or after the commencement of this Schedule.\n\n\nDisclosures to intelligence bodies  Schedule 3\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 12 April 2000\nSenate on 28 November 2000]\n\n(54/00)",
      "skos:definition": "The amendment of the Privacy Act 1988 made by this Schedule applies\nfor the purposes of determining the operation of that Act in relation to\nan act or practice, regardless of whether the act or practice occurred\nbefore or after the commencement of this Schedule.\n\n\nDisclosures to intelligence bodies  Schedule 3\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 12 April 2000\nSenate on 28 November 2000]\n\n(54/00)",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-4-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-4-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "399c214470ec4b97e5c70c4884626d25552198f4e057b531797d570ee76ff03c",
      "skos:note": "Amendment of Privacy Act 1988 applies to determining operation of that Act in relation to an act or practice."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-4-4",
      "@type": "cof:Section",
      "cof:title": "4 Application",
      "values:kind": "section",
