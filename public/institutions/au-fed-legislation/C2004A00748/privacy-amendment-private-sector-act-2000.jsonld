    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of use or disclosure",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Organisation must not use or disclose an identifier assigned to an individual."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-7-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Temporal interval for exceptions",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Exceptions apply if (a) the use or disclosure is necessary for the organisation to fulfil its obligations to the agency; or (b) one or more of paragraphs 2.1(e) to 2.1(h) (inclusive) apply to the use or disclosure; or (c) the use or disclosure is by a prescribed organisation of a prescribed identifier in prescribed circumstances."
    },
