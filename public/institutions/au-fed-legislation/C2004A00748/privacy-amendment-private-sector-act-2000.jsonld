    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-87",
      "@type": "cml:Concept",
      "skos:prefLabel": "87 Subsection 41(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-87"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.55",
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) If an act or practice may be an interference with the privacy of an\nindividual solely because it may breach:\n\n(a) Information Privacy Principle 7; or\n\n(b) National Privacy Principle 6, to the extent that it deals with\nthe correction of personal information; or\n\n(c) a provision of an approved privacy code that corresponds to\nNational Privacy Principle 6, to the extent that it deals with\nthe correction of personal information;\nthe Commissioner must not investigate the act or practice except to\nthe extent that it is an interference with the privacy of one or more\nindividuals each of whom is:\n\n(d) an Australian citizen; or\n\n(e) a person whose continued presence in Australia is not subject\nto a limitation as to time imposed by law.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(4) If an act or practice may be an interference with the privacy of an\nindividual solely because it may breach:\n\n(a) Information Privacy Principle 7; or\n\n(b) National Privacy Principle 6, to the extent that it deals with\nthe correction of personal information; or\n\n(c) a provision of an approved privacy code that corresponds to\nNational Privacy Principle 6, to the extent that it deals with\nthe correction of personal information;\nthe Commissioner must not investigate the act or practice except to\nthe extent that it is an interference with the privacy of one or more\nindividuals each of whom is:\n\n(d) an Australian citizen; or\n\n(e) a person whose continued presence in Australia is not subject\nto a limitation as to time imposed by law.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-87-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-87-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-87-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-87-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-87-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-87-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "59576f3270076a0d2f05178c898f120b6e0ae3f548384bd7db9cad18b2c7555d",
      "skos:note": "Commissioner must not investigate unless interference with privacy of Australian citizens or persons in Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-87",
      "@type": "cof:Section",
      "cof:title": "87 Subsection 41(4)",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) If an act or practice may be an interference with the privacy of an\nindividual solely because it may breach:\n\n(a) Information Privacy Principle 7; or\n\n(b) National Privacy Principle 6, to the extent that it deals with\nthe correction of personal information; or\n\n(c) a provision of an approved privacy code that corresponds to\nNational Privacy Principle 6, to the extent that it deals with\nthe correction of personal information;\nthe Commissioner must not investigate the act or practice except to\nthe extent that it is an interference with the privacy of one or more\nindividuals each of whom is:\n\n(d) an Australian citizen; or\n\n(e) a person whose continued presence in Australia is not subject\nto a limitation as to time imposed by law."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-87-norm",
