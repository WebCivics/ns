    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-111-ss-3b",
      "@type": "cof:Section",
      "cof:title": "111(3B) After subsection 68(3)",
      "values:kind": "subsection",
      "cof:pageNumber": 65,
      "values:originalText": "(3B) An entry by an authorised person with the consent of the occupier\nor person in charge is not lawful if the consent was not voluntary."
    },
