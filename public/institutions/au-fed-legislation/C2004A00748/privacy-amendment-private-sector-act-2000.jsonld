      "cml:premiseText": "Organisation must not collect sensitive information about an individual unless certain conditions are met."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-10-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Exceptions to prohibition of sensitive information collection",
      "cml:executionSurface": "modalities::logic::deontic",
