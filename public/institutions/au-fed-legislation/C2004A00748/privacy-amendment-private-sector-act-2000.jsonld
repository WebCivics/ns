        }
      ],
      "cml:integrityHash": "f01bb5deb429ae53c40564b314d771ddc5db5407dd4c3e6ce9c34af5c162a5a5",
      "skos:note": "Must make register available to public in specified way, but not beyond subsection (3)",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-6ea-ss-6",
      "@type": "cof:Section",
      "cof:title": "6EA(6) Small business operators choosing to be treated as",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(6) The Commissioner must make the register available to the public\nin the way that the Commissioner determines. However, the\nCommissioner must not make available to the public in the register\ninformation other than that described in subsection (3)."
    },
