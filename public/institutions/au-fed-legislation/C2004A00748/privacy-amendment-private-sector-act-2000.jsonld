      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-25-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasArrangement",
      "cml:logicSummary": "Has arrangement with another person.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Archives has entered into arrangements with a person other than a Commonwealth institution.",
      "cml:conclusionText": "There is an obligation to provide access to records."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-25-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "During the arrangement period, access is granted.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Archives has entered into arrangements with a person other than a Commonwealth institution during a specific period.",
      "cml:conclusionText": "Access to records is granted during this period."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-25-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:logicSummary": "Everywhere in the arrangement, access is granted.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Archives has entered into arrangements with a person other than a Commonwealth institution everywhere within the arrangement.",
      "cml:conclusionText": "Access to records is granted everywhere in the arrangement."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-25-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "through",
      "cml:logicSummary": "Through the arrangement, access is granted.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Archives has entered into arrangements with a person other than a Commonwealth institution through this specific mechanism.",
      "cml:conclusionText": "Access to records is granted through this mechanism."
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-25-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "by",
      "cml:logicSummary": "By the arrangement, access is granted.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Archives has entered into arrangements with a person other than a Commonwealth institution by this specific action.",
      "cml:conclusionText": "Access to records is granted by this action."
    },
