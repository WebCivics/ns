      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.7",
      "values:originalText": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nSchedule 1  Amendment of the Privacy Act 1988",
      "skos:definition": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nSchedule 1  Amendment of the Privacy Act 1988",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sec-4-norm"
        }
      ],
      "cml:integrityHash": "eeb9dc1c3e6fa254b86a5397b24b36fd958426b005a9937fc069fc7e5e5d3e02",
      "skos:note": "Amendment and repeal of Acts specified in Schedules"
    },
