      "cml:integrityHash": "2e19e6f8124e5f22f32a5c9fdd95fb660a1e2db35da8ae350549d18967f3d020",
      "skos:note": "Ensure consistency of directions and guidelines with relevant privacy principles."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-70",
      "@type": "cof:Section",
      "cof:title": "70 Paragraph 29(d)",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(d) ensure that his or her directions and guidelines are consistent\nwith whichever of the following (if any) are relevant:\n\n(i) the Information Privacy Principles;\n\n(ii) the National Privacy Principles;\n\n(iii)  the Code of Conduct and Part IIIA."
    },
