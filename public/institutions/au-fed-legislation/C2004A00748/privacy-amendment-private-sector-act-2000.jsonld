    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-2-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 At the end of subsection 118(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-2-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
