    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Anonymity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.84",
      "values:originalText": "Wherever it is lawful and practicable, individuals must have the\noption of not identifying themselves when entering transactions\nwith an organisation.\n\nAmendment of the Privacy Act 1988  Schedule 1",
      "skos:definition": "Wherever it is lawful and practicable, individuals must have the\noption of not identifying themselves when entering transactions\nwith an organisation.\n\nAmendment of the Privacy Act 1988  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-8-norm"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "67889564a23c90ba97f2a83097b57cd0233bf20c2f0edc4fabfce47b9b0de039",
      "skos:note": "Individuals must have the option of not identifying themselves when entering transactions with an organisation."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-3-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Anonymity",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "Wherever it is lawful and practicable, individuals must have the\noption of not identifying themselves when entering transactions\nwith an organisation.\n\nAmendment of the Privacy Act 1988  Schedule 1"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-8-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-8"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-3-sec-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
