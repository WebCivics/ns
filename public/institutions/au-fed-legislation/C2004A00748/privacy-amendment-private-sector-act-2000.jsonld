    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsection 6(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
