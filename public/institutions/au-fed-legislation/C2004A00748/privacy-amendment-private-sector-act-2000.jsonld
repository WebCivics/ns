    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-68a",
      "@type": "cml:Concept",
      "skos:prefLabel": "68A Identity cards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-68a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.65",
      "values:originalText": "(1) The Commissioner must issue to a person authorised for the\npurposes of section 68 an identity card in the form approved by the\nCommissioner. The identity card must contain a recent photograph\nof the authorised person.\n\n(2) As soon as practicable after the person ceases to be authorised, he\nor she must return the identity card to the Commissioner.\n\n(3) A person must not contravene subsection (2).\nPenalty: 1 penalty unit.",
      "skos:definition": "(1) The Commissioner must issue to a person authorised for the\npurposes of section 68 an identity card in the form approved by the\nCommissioner. The identity card must contain a recent photograph\nof the authorised person.\n\n(2) As soon as practicable after the person ceases to be authorised, he\nor she must return the identity card to the Commissioner.\n\n(3) A person must not contravene subsection (2).\nPenalty: 1 penalty unit.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-68a-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-68a-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-68a-ss-3"
        }
      ],
      "cml:integrityHash": "5a9e424a958b59e24a56905f56b50355b83be5567458a5bbd41a237c8adb5c74"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-68a",
      "@type": "cof:Section",
      "cof:title": "68A Identity cards",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "(1) The Commissioner must issue to a person authorised for the\npurposes of section 68 an identity card in the form approved by the\nCommissioner. The identity card must contain a recent photograph\nof the authorised person.\n\n(2) As soon as practicable after the person ceases to be authorised, he\nor she must return the identity card to the Commissioner.\n\n(3) A person must not contravene subsection (2).\nPenalty: 1 penalty unit."
    },
