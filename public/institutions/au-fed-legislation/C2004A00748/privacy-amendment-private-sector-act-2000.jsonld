      "cml:integrityHash": "ba7221c1a7ad41f9d537173fa1e65fdac361ffcc1e20a25858ebb8a17dbc36fb",
      "skos:note": "Definition of State contract"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Insert:\nState contract means a contract, to which a State or Territory or\nState or Territory authority is or was a party, under which services\nare to be, or were to be, provided to a State or Territory authority.\nNote:\nSee also subsection (9) about provision of services to a State or\nTerritory authority."
    },
