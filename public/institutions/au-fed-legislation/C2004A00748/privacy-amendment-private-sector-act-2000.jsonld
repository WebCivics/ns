      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.43",
      "values:originalText": "An organisation may apply in writing to the Commissioner for\napproval of a privacy code.",
      "skos:definition": "An organisation may apply in writing to the Commissioner for\napproval of a privacy code.",
      "cml:asserts": [
