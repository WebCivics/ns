      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Ability to complain",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 74(1C)",
      "cml:conclusionText": "Individual can complain"
    },
    {
      "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Subsection 36(7)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-private-sector-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-private-sector-act-2000.pdf, p.52",
      "values:originalText": "Repeal the subsection, substitute:\n\n(7) In the case of a complaint about an act or practice of an\norganisation, the organisation is the respondent.\nNote:\nSection 70A contains further rules about how this Part operates in\nrelation to respondent organisations that are not legal persons.\n\n(8) The respondent to a complaint about an act or practice described in\none of paragraphs 13(b) to (d) (inclusive), other than an act or\npractice of an agency or organisation, is the person who engaged in\nthe act or practice.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(7) In the case of a complaint about an act or practice of an\norganisation, the organisation is the respondent.\nNote:\nSection 70A contains further rules about how this Part operates in\nrelation to respondent organisations that are not legal persons.\n\n(8) The respondent to a complaint about an act or practice described in\none of paragraphs 13(b) to (d) (inclusive), other than an act or\npractice of an agency or organisation, is the person who engaged in\nthe act or practice.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-75-ss-7"
        },
        {
          "@id": "concept:privacy-amendment-private-sector-act-2000-sch-1-sec-75-ss-8"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-private-sector-act-2000#sch-1-sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Subsection 36(7)",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Repeal the subsection, substitute:\n\n(7) In the case of a complaint about an act or practice of an\norganisation, the organisation is the respondent.\nNote:\nSection 70A contains further rules about how this Part operates in\nrelation to respondent organisations that are not legal persons.\n\n(8) The respondent to a complaint about an act or practice described in\none of paragraphs 13(b) to (d) (inclusive), other than an act or\npractice of an agency or organisation, is the person who engaged in\nthe act or practice."
    },
