    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an interval between the current hearing and the next opportunity to negotiate a settlement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Court must adjourn the hearing for an appropriate opportunity to negotiate a settlement.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The court has the power to adjourn the hearing."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-3-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The parties' willingness to negotiate a settlement implies their willingness to compromise.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Negotiating a settlement implies that the parties are willing to compromise.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "The parties have made an attempt to negotiate a settlement."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-3-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Negotiating a settlement is a form of AI-assisted mediation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Settlement negotiation uses artificial intelligence.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The process of negotiating a settlement involves using AI."
    },
