concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-1 a cml:Concept ;
    skos:prefLabel "195AZ(1) Actions for infringement of moral rights"@en ;
    cml:realizedBy doc:sch-1-sec-195az-ss-1 ;
    cml:integrityHash "0663cff9ea8f9afdbc52567e891787d6d5d8b8e46251935852b7ab04f38343ff" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az ;
    skos:note "Jurisdiction of the Supreme Court in a matter arising under this Part is to be exercised by a single Judge. Preserves other rights of action in proceedings outside this Part Section 127 applies in respect of an action brought under this Part. Court may grant injunction, damages, declaration, apology, or removal of false attribution." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
