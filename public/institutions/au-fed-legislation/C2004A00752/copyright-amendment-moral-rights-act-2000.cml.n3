doc:sch-1-sec-195ax a cof:Section ;
    cof:title "195AX Acts or omissions outside Australia" ;
    values:kind "section" ;
    values:originalText "It is not an infringement of an author’s moral right in respect of a work to do, or omit to do, something outside Australia." ;
    cof:pageNumber "28"^^xsd:integer .

concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ay a cml:Concept ;
