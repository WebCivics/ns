concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ao a cml:Concept ;
    skos:prefLabel "195AO Infringement of right of attribution of authorship"@en ;
    cml:realizedBy doc:sch-1-sec-195ao ;
    values:originalText "Subject to this Division, a person infringes an author’s right of attribution of authorship in respect of a work if the person does, or authorises the doing of, an attributable act in respect of the work without the identification of the author in accordance with Division 2 as the author of the work." ;
    skos:definition "Subject to this Division, a person infringes an author’s right of attribution of authorship in respect of a work if the person does, or authorises the doing of, an attributable act in respect of the work without the identification of the author in accordance with Division 2 as the author of the work."@en ;
    cml:integrityHash "de65e3f315a51548e9381efbe643934da996d808bab064c65cb1f1b187dbaf9f" ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Infringement of authorship attribution right" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.17" ;
    cml:asserts concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ao-norm .
