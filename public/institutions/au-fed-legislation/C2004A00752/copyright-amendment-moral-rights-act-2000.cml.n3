    cml:operator "hasPermission" ;
    cml:logicSummary "Has permission to publish the work?" ;
    cml:premiseText "(b) to publish the work..." ;
    cml:conclusionText "...the attributable acts are the following:" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-194-ss-1 a cof:Section ;
    cof:title "194(1) Acts giving rise to right of attribution of authorship" ;
    values:kind "subsection" ;
    values:originalText "(1) If the work is a literary, dramatic or musical work, the attributable acts are the following:  (a) to reproduce the work in a material form;  (b) to publish the work;  (c) to perform the work in public;  (d) to transmit the work;  (e) to make an adaptation of the work." ;
    cof:pageNumber "10"^^xsd:integer .

concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-194-ss-2 a cml:Concept ;
    skos:prefLabel "194(2) Acts giving rise to right of attribution of authorship"@en ;
    cml:realizedBy doc:sch-1-sec-194-ss-2 ;
    values:originalText "(2) If the work is an artistic work, the attributable acts are the following:  Moral rights of authors  Schedule 1  (a) to reproduce the work in a material form;  (b) to publish the work;  (c) to exhibit the work to the public;  (d) to transmit the work." ;
    skos:definition "(2) If the work is an artistic work, the attributable acts are the following:  Moral rights of authors  Schedule 1  (a) to reproduce the work in a material form;  (b) to publish the work;  (c) to exhibit the work to the public;  (d) to transmit the work."@en ;
    cml:integrityHash "9833f0216087e34d5b46fdbf787124d5bf1a296225be6bd38db935b61ce5beb2" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-194 ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Attributable acts for artistic works" ;
    cml:curationStatus cml:Proposed ;
