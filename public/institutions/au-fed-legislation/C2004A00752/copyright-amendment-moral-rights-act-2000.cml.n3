doc:sch-1-sec-195aw-ss-1a a cof:Section ;
    cof:title "195AW(1A) Author’s consent to act or omission—films or works in films" ;
    values:kind "subsection" ;
    values:originalText "(1A) This section applies to a work that is:  (a) a cinematograph film; or  (b) a literary, dramatic, musical or artistic work as included in a cinematograph film." ;
    cof:pageNumber "26"^^xsd:integer .

concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-1 a cml:Concept ;
    skos:prefLabel "195AW(1) Author’s consent to act or omission—films or works in films"@en ;
    cml:realizedBy doc:sch-1-sec-195aw-ss-1 ;
    values:originalText "(1) It is not an infringement of a moral right of an author in respect of a work to do, or omit to do, something if the act or omission is within the scope of a written consent given by the author or a person representing the author." ;
    skos:definition "(1) It is not an infringement of a moral right of an author in respect of a work to do, or omit to do, something if the act or omission is within the scope of a written consent given by the author or a person representing the author."@en ;
    cml:integrityHash "ff31abe729ab3df986ad3f69ced687f2a73dd967bfdf077f7707e5383bbe6df8" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Author's consent required for acts or omissions related to films or works in films. Written consent is required for acts or omissions affecting an author's moral right. Consent under duress is invalid." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
