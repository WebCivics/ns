concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aj a cml:Concept ;
    skos:prefLabel "195AJ Derogatory treatment of literary, dramatic or musical work"@en ;
    cml:realizedBy doc:sch-1-sec-195aj ;
    values:originalText "In this Part: derogatory treatment, in relation to a literary, dramatic or musical work, means:  (a) the doing, in relation to the work, of anything that results in a material distortion of, the mutilation of, or a material alteration to, the work that is prejudicial to the author’s honour or reputation; or  (b) the doing of anything else in relation to the work that is prejudicial to the author’s honour or reputation." ;
    skos:definition "In this Part: derogatory treatment, in relation to a literary, dramatic or musical work, means:  (a) the doing, in relation to the work, of anything that results in a material distortion of, the mutilation of, or a material alteration to, the work that is prejudicial to the author’s honour or reputation; or  (b) the doing of anything else in relation to the work that is prejudicial to the author’s honour or reputation."@en ;
    cml:integrityHash "97ef68c30b41ff927358e235b13fda8dabe3c7f0f849a861c4f7b9dd2ff60a7a" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Derogatory treatment of literary, dramatic or musical work is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.15" ;
