    cml:logicSummary "Dealing with a copy of an altered film as if it were unaltered is false attribution." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-195ah-ss-1 a cof:Section ;
    cof:title "195AH(1) Act of false attribution of authorship of altered" ;
    values:kind "subsection" ;
    values:originalText "(1) If the work is a cinematograph film that has been altered by a person other than the maker of the film, it is an act of false attribution in relation to the director, the producer and the screenwriter of the film to deal with a copy of the film as so altered, as being a copy of the unaltered film, if, to the knowledge of the attributor, the copy of the film is not a copy of the unaltered film." ;
    cof:pageNumber "14"^^xsd:integer .

concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ah-ss-2 a cml:Concept ;
    skos:prefLabel "195AH(2) Act of false attribution of authorship of altered"@en ;
    cml:realizedBy doc:sch-1-sec-195ah-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply if:  (a) the effect of the alteration is insubstantial; or  (b) the alteration was required by law to be made, or was otherwise necessary to avoid a breach of any law.  Moral rights of authors  Schedule 1" ;
    skos:definition "(2) Subsection (1) does not apply if:  (a) the effect of the alteration is insubstantial; or  (b) the alteration was required by law to be made, or was otherwise necessary to avoid a breach of any law.  Moral rights of authors  Schedule 1"@en ;
    cml:integrityHash "9936230baa634a83c7fd15c7c48d42ad81455ae3ff564cf773132c0bf3cc9f51" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ah ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Exemption from moral rights for alterations required by law or necessary to avoid a breach of law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
