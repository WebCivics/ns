concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-3 a cml:Concept ;
    skos:prefLabel "195AZ(3) Actions for infringement of moral rights"@en ;
    cml:realizedBy doc:sch-1-sec-195az-ss-3 ;
    values:originalText "(3) An appeal lies from a decision of a court of a State or Territory under this Part:  (a) to the Federal Court of Australia; or  (b) by special leave of the High Court, to the High Court." ;
    skos:definition "(3) An appeal lies from a decision of a court of a State or Territory under this Part:  (a) to the Federal Court of Australia; or  (b) by special leave of the High Court, to the High Court."@en ;
    cml:integrityHash "bebb49d81c1b36c592388929a351611edbca13c6baa8c64523c9870b0ad6f45b" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Appeal from a decision of a court under this Part Damages recovered in other proceedings are to be taken into account. Court must consider negotiating a settlement before granting an injunction." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.28" ;
    cml:asserts concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-3-norm .
