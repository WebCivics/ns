concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-1 a cml:Concept ;
    skos:prefLabel "195AW(1) Author’s consent to act or omission—films or works in films"@en ;
    cml:realizedBy doc:sch-1-sec-195aw-ss-1 ;
    values:originalText "(1) This section applies to a literary, dramatic, musical or artistic work other than such a work as included in a cinematograph film.  Moral rights of authors  Schedule 1" ;
    skos:definition "(1) This section applies to a literary, dramatic, musical or artistic work other than such a work as included in a cinematograph film.  Moral rights of authors  Schedule 1"@en ;
    cml:integrityHash "0dd8a5e780ea61773bdb69643607b8d431ca9543b5c0efae378505e3ab1cbfaf" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Author's consent required for acts or omissions related to films or works in films. Written consent is required for acts or omissions affecting an author's moral right. Consent under duress is invalid." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.26" ;
    cml:asserts concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-1-norm .
