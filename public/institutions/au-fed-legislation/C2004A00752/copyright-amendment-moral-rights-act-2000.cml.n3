doc:sch-1-sec-195an-ss-1 a cof:Section ;
    cof:title "195AN(1) Exercise of moral rights" ;
    values:kind "subsection" ;
    values:originalText "(1) If the author of a work dies, the author’s moral rights (other than the right of integrity of authorship in respect of a cinematograph film) in respect of the work may be exercised and enforced by his or her legal personal representative." ;
    cof:pageNumber "16"^^xsd:integer .

concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195an-ss-2 a cml:Concept ;
    skos:prefLabel "195AN(2) Exercise of moral rights"@en ;
    cml:realizedBy doc:sch-1-sec-195an-ss-2 ;
    values:originalText "(2) If the affairs of the author of a work are lawfully administered by another person (except under a law for the relief of bankrupt or  Moral rights of authors  Schedule 1  insolvent debtors), the author’s moral rights may be exercised and enforced by the person administering his or her affairs." ;
    skos:definition "(2) If the affairs of the author of a work are lawfully administered by another person (except under a law for the relief of bankrupt or  Moral rights of authors  Schedule 1  insolvent debtors), the author’s moral rights may be exercised and enforced by the person administering his or her affairs."@en ;
    cml:integrityHash "160ca2caf04d747ff0eee8ba423cefa62b3cda43504a9677f510d97f3942590b" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195an ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Author's moral rights may be exercised and enforced by the person administering their affairs." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
