concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195at-ss-5 a cml:Concept ;
    skos:prefLabel "195AT(5) Certain treatment of works not to constitute an infringement"@en ;
    cml:realizedBy doc:sch-1-sec-195at-ss-5 ;
    values:originalText "(5) Anything done in good faith to restore or preserve a work is not, by that act alone, an infringement of the author’s right of integrity of authorship in respect of the work." ;
    skos:definition "(5) Anything done in good faith to restore or preserve a work is not, by that act alone, an infringement of the author’s right of integrity of authorship in respect of the work."@en ;
    cml:integrityHash "976c5714587e59afa77686ec510297fdd7ac6132faa7edb2743b9fe45f7e084e" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195at ;
    cof:pageNumber "21"^^xsd:integer ;
    skos:note "Good faith restoration or preservation of a work does not infringe author's right of integrity." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
