concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-1 a cml:Concept ;
    skos:prefLabel "195AZ(1) Actions for infringement of moral rights"@en ;
    cml:realizedBy doc:sch-1-sec-195az-ss-1 ;
    values:originalText "(1) Subject to this section, this Part does not affect any right of action or other remedy, whether civil or criminal, in proceedings brought otherwise than under this Part." ;
    skos:definition "(1) Subject to this section, this Part does not affect any right of action or other remedy, whether civil or criminal, in proceedings brought otherwise than under this Part."@en ;
    cml:integrityHash "97041edc2d76933026fa755e55249ebe1c9001d9d12b109e3189201655e73e20" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Jurisdiction of the Supreme Court in a matter arising under this Part is to be exercised by a single Judge. No effect on other remedies in proceedings under this Part Section 127 applies in respect of an action brought under this Part. Court may grant injunctions, damages, declaration, apology, or removal of false attribution in moral rights infringement action." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.28" ;
    cml:asserts concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-1-norm .
