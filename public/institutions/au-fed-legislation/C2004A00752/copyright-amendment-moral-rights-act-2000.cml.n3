concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195 a cml:Concept ;
    skos:prefLabel "195 Nature of the identification of author"@en ;
    cml:realizedBy doc:sch-1-sec-195 ;
    values:originalText "(1) Subject to subsection (2), the author of a work may be identified by any reasonable form of identification.  (2) If:  (a) the author of a work has made known, either generally or to a person who is required under this Part to identify the author, that the author wishes to be identified in a particular way; and  (b) the identification of the author in that way is reasonable in the circumstances; the identification is to be made in that way." ;
    skos:definition "(1) Subject to subsection (2), the author of a work may be identified by any reasonable form of identification.  (2) If:  (a) the author of a work has made known, either generally or to a person who is required under this Part to identify the author, that the author wishes to be identified in a particular way; and  (b) the identification of the author in that way is reasonable in the circumstances; the identification is to be made in that way."@en ;
    cml:integrityHash "6a0bb8676614588c39729248a417904d0cd1cc752b6275afca980c215cd17153" ;
    cof:pageNumber "11"^^xsd:integer ;
    cml:hasPart concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195-ss-1 ;
    cml:hasPart concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.11" .
