concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ab a cml:Concept ;
    skos:prefLabel "195AB What is a reasonably prominent identification"@en ;
    cml:realizedBy doc:sch-1-sec-195ab ;
    values:originalText "When a literary, dramatic, musical or artistic work is reproduced in a material form, an adaptation is made of a literary, dramatic or musical work, or a copy of a cinematograph film is made, an identification of the author is taken to be reasonably prominent if it is included on each reproduction of the work or of the adaptation or on each copy of the film, as the case may be, in such a way that a person acquiring the reproduction or copy will have notice of the author’s identity.  Schedule 1  Moral rights of authors" ;
    skos:definition "When a literary, dramatic, musical or artistic work is reproduced in a material form, an adaptation is made of a literary, dramatic or musical work, or a copy of a cinematograph film is made, an identification of the author is taken to be reasonably prominent if it is included on each reproduction of the work or of the adaptation or on each copy of the film, as the case may be, in such a way that a person acquiring the reproduction or copy will have notice of the author’s identity.  Schedule 1  Moral rights of authors"@en ;
    cml:integrityHash "61c8bf74affc8ff29e17f5a1bb512160c34fe5372bb95ad45dcbc86ad007fc03" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Identification of author's identity must be reasonably prominent in reproductions or copies." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.11" ;
    cml:asserts concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ab-norm .
