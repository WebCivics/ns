concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-3 a cml:Concept ;
    skos:prefLabel "195AW(3) Author’s consent to act or omission—films or works in films"@en ;
    cml:realizedBy doc:sch-1-sec-195aw-ss-3 ;
    values:originalText "(3) A consent may be given in relation to:  (a) a specified work or specified works existing when the consent is given; or  (b) a work or works of a particular description:  (i) the making of which has not begun; or  (ii) that is or are in the course of being made." ;
    skos:definition "(3) A consent may be given in relation to:  (a) a specified work or specified works existing when the consent is given; or  (b) a work or works of a particular description:  (i) the making of which has not begun; or  (ii) that is or are in the course of being made."@en ;
    cml:integrityHash "feff454dd0824b4e36a1c0ed78d6e1ba54e3f4daef78f024c73b0b46522b505f" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Consent must be given in relation to specified acts or omissions, works, or classes of acts/omissions. Consent may be given for specified works or works of a particular description." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
