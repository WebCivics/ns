    skos:prefLabel "192 Rights to be additional to other rights"@en ;
    cml:realizedBy doc:sch-1-sec-192 ;
    values:originalText "The moral rights of the author of a work are in addition to any other rights in relation to the work that the author or anyone else has under this Act." ;
