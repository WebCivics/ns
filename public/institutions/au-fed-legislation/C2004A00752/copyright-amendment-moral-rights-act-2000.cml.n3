concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-2 a cml:Concept ;
    skos:prefLabel "195AZ(2) Actions for infringement of moral rights"@en ;
    cml:realizedBy doc:sch-1-sec-195az-ss-2 ;
    values:originalText "(2) Any damages recovered in proceedings brought under this Part are to be taken into account in assessing damages in proceedings brought otherwise than under this Part and arising out of the same operation or transaction.  Moral rights of authors  Schedule 1" ;
    skos:definition "(2) Any damages recovered in proceedings brought under this Part are to be taken into account in assessing damages in proceedings brought otherwise than under this Part and arising out of the same operation or transaction.  Moral rights of authors  Schedule 1"@en ;
    cml:integrityHash "abb13d59a0b893ed181c2de96ceb93ec98b44a65f5cdcd95da732b41d4b1fb32" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Court may consider factors when granting relief for moral rights infringement. Damages recovered in one proceeding are taken into account in assessing damages in another proceeding arising out of the same operation or transaction. Decision of a court is final. Presumption of authorship for film director, producer or screenwriter" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.28" ;
    cml:asserts concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195az-ss-2-norm .
