concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ax a cml:Concept ;
    skos:prefLabel "195AX Acts or omissions outside Australia"@en ;
    cml:realizedBy doc:sch-1-sec-195ax ;
    values:originalText "It is not an infringement of an author’s moral right in respect of a work to do, or omit to do, something outside Australia." ;
    skos:definition "It is not an infringement of an author’s moral right in respect of a work to do, or omit to do, something outside Australia."@en ;
    cml:integrityHash "c6a381f628e42163549c73347ebbd17cb814bb1dc4b0540041853b79b220eaf5" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "No infringement of moral right outside Australia" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
