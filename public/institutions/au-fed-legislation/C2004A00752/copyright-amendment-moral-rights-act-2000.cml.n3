doc:sch-1-sec-195af-ss-1 a cof:Section ;
    cof:title "195AF(1) Acts of false attribution of authorship of cinematograph film" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if the work is a cinematograph film." ;
    cof:pageNumber "13"^^xsd:integer .

concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195af-ss-2 a cml:Concept ;
    skos:prefLabel "195AF(2) Acts of false attribution of authorship of cinematograph film"@en ;
    cml:realizedBy doc:sch-1-sec-195af-ss-2 ;
    values:originalText "(2) It is an act of false attribution in relation to the director, producer or screenwriter of the film:  (a) to insert or affix, or to authorise the inserting or affixing of, a person’s name on the film or on a copy of the film in such a way as to imply falsely that the person is the director, producer or screenwriter, as the case may be, of the film; or  (b) to deal with the film or a copy of the film if a person’s name has been so inserted or affixed on the film or a copy, as the case may be, and the attributor knows that the person is not the director, producer or screenwriter, as the case may be, of the film; or  (c) to transmit the film as being a film of which a person is the director, producer or screenwriter, as the case may be, if the attributor knows that the person is not the director, producer or screenwriter of the film.  Schedule 1  Moral rights of authors" ;
    skos:definition "(2) It is an act of false attribution in relation to the director, producer or screenwriter of the film:  (a) to insert or affix, or to authorise the inserting or affixing of, a person’s name on the film or on a copy of the film in such a way as to imply falsely that the person is the director, producer or screenwriter, as the case may be, of the film; or  (b) to deal with the film or a copy of the film if a person’s name has been so inserted or affixed on the film or a copy, as the case may be, and the attributor knows that the person is not the director, producer or screenwriter, as the case may be, of the film; or  (c) to transmit the film as being a film of which a person is the director, producer or screenwriter, as the case may be, if the attributor knows that the person is not the director, producer or screenwriter of the film.  Schedule 1  Moral rights of authors"@en ;
    cml:integrityHash "9b4b1dfeb6621dce474c3618e951467acbd8eb11a3874fb38768ee06ffdeda61" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195af ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "False attribution of authorship of cinematograph film" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.13" ;
    cml:asserts concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195af-ss-2-norm .
