concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195an-ss-4 a cml:Concept ;
    skos:prefLabel "195AN(4) Exercise of moral rights"@en ;
    cml:realizedBy doc:sch-1-sec-195an-ss-4 ;
    values:originalText "(4) If:  (a) a cinematograph film; or  (b) a literary, dramatic, musical or artistic work as included in a cinematograph film; has 2 or more authors, the authors may enter into a written co-authorship agreement by which each of them agrees not to exercise his or her right of integrity of authorship in respect of the film or work, as the case may be, except jointly with the other author or authors." ;
    skos:definition "(4) If:  (a) a cinematograph film; or  (b) a literary, dramatic, musical or artistic work as included in a cinematograph film; has 2 or more authors, the authors may enter into a written co-authorship agreement by which each of them agrees not to exercise his or her right of integrity of authorship in respect of the film or work, as the case may be, except jointly with the other author or authors."@en ;
    cml:integrityHash "130d68f4b67964ab71a68b6514ae911c7b4afd88d59e4f850753e40e9d7069bf" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195an ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Authors must agree not to exercise moral rights except jointly." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
