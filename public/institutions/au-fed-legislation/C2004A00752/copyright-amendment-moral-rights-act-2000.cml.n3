doc:sch-1-sec-195aw-ss-1 a cof:Section ;
    cof:title "195AW(1) Author’s consent to act or omission—films or works in films" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies to a literary, dramatic, musical or artistic work other than such a work as included in a cinematograph film.  Moral rights of authors  Schedule 1" ;
    cof:pageNumber "26"^^xsd:integer .

concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-2 a cml:Concept ;
    skos:prefLabel "195AW(2) Author’s consent to act or omission—films or works in films"@en ;
    cml:realizedBy doc:sch-1-sec-195aw-ss-2 ;
    values:originalText "(2) It is not an infringement of a moral right of an author in respect of a work to do, or omit to do, something if the act or omission is within the scope of a written consent genuinely given by the author or a person representing the author." ;
    skos:definition "(2) It is not an infringement of a moral right of an author in respect of a work to do, or omit to do, something if the act or omission is within the scope of a written consent genuinely given by the author or a person representing the author."@en ;
    cml:integrityHash "f5667aff479b234fb5fbf652152f3d02456b7caed5d9ea38fc046985b355f6fe" ;
    values:partOf concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Consent to act or omission—films or works in films Consent may be given in relation to all or any acts or omissions occurring before or after the consent is given. Written consent is required for acts or omissions affecting an author's moral right." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <copyright-amendment-moral-rights-act-2000.pdf> ;
    dc:source "copyright-amendment-moral-rights-act-2000.pdf, p.26" ;
    cml:asserts concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-2-norm .
