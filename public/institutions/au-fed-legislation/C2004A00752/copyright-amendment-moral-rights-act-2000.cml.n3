doc:sch-1-sec-195ac-ss-1 a cof:Section ;
    cof:title "195AC(1) Author’s right not to have authorship falsely attributed" ;
    values:kind "subsection" ;
    values:originalText "(1) The author of a work has a right not to have authorship of the work falsely attributed." ;
    cof:pageNumber "12"^^xsd:integer .

concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ac-ss-2 a cml:Concept ;
    skos:prefLabel "195AC(2) Author’s right not to have authorship falsely attributed"@en ;
    cml:realizedBy doc:sch-1-sec-195ac-ss-2 ;
    values:originalText "(2) The author’s right is the right not to have a person (the attributor) do, in respect of the work, any of the acts (the acts of false attribution) mentioned in the following provisions of this Division." ;
    skos:definition "(2) The author’s right is the right not to have a person (the attributor) do, in respect of the work, any of the acts (the acts of false attribution) mentioned in the following provisions of this Division."@en ;
    cml:integrityHash "c1c51a2d6d75beea193fa1cd6006abc57f73e29ac7f5d6402dcb49f897cd1549" ;
