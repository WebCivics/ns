concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195al a cml:Concept ;
    skos:prefLabel "195AL Derogatory treatment of cinematograph film"@en ;
    cml:realizedBy doc:sch-1-sec-195al ;
    values:originalText "In this Part: derogatory treatment, in relation to a cinematograph film, means:  (a) the doing, in relation to the film, of anything that results in a material distortion of, the mutilation of, or a material alteration to, the film that is prejudicial to the maker’s honour or reputation; or  (b) the doing of anything else in relation to the film that is prejudicial to the honour or reputation of the maker of the film." ;
    skos:definition "In this Part: derogatory treatment, in relation to a cinematograph film, means:  (a) the doing, in relation to the film, of anything that results in a material distortion of, the mutilation of, or a material alteration to, the film that is prejudicial to the maker’s honour or reputation; or  (b) the doing of anything else in relation to the film that is prejudicial to the honour or reputation of the maker of the film."@en ;
    cml:integrityHash "c519aa1d03a2c17928e8a0026831d4ac9834d7cf986acf5248823cf3573215ed" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Derogatory treatment of cinematograph film is prohibited." ;
    cml:curationStatus cml:Proposed ;
