      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ap",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AP Infringement of right not to have authorship falsely",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195ap"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.17",
      "values:originalText": "attributed\n\nSubject to this Division, a person infringes an author’s right not to\nhave authorship of a work falsely attributed if the person does an\nact of false attribution in respect of the work.",
      "skos:definition": "attributed\n\nSubject to this Division, a person infringes an author’s right not to\nhave authorship of a work falsely attributed if the person does an\nact of false attribution in respect of the work.",
      "cml:asserts": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ap-norm"
        }
      ],
      "cml:integrityHash": "1881c06ac1cc4954b6ebb41ceb68268170c2a68c14f56e8b180ab068b273efca",
      "skos:note": "Infringement of authorship falsely attributed"
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195ap",
      "@type": "cof:Section",
      "cof:title": "195AP Infringement of right not to have authorship falsely",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "attributed\n\nSubject to this Division, a person infringes an author’s right not to\nhave authorship of a work falsely attributed if the person does an\nact of false attribution in respect of the work."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ap-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ap"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
