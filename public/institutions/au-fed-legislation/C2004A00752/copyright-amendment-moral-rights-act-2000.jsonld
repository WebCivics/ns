    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ah",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AH Act of false attribution of authorship of altered",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195ah"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
