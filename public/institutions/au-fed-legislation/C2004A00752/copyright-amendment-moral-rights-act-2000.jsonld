      "skos:prefLabel": "195AW(5) Author’s consent to act or omission—films or works in films",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195aw-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.26",
      "values:originalText": "(5) A consent given for the benefit of the owner or prospective owner\nof copyright in the work or works to which it relates is presumed,\nunless the contrary intention appears in the consent instrument, to\nextend to his or her licensees and successors in title, and to any\npersons who are authorised by the owner or prospective owner, or\nby such a licensee or successor in title, to do acts comprised in the\ncopyright.\n195AWB  Consent invalidated by duress or false or misleading\nstatements",
      "skos:definition": "(5) A consent given for the benefit of the owner or prospective owner\nof copyright in the work or works to which it relates is presumed,\nunless the contrary intention appears in the consent instrument, to\nextend to his or her licensees and successors in title, and to any\npersons who are authorised by the owner or prospective owner, or\nby such a licensee or successor in title, to do acts comprised in the\ncopyright.\n195AWB  Consent invalidated by duress or false or misleading\nstatements",
