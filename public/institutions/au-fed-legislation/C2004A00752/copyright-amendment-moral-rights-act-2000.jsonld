    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AW(1) Author’s consent to act or omission—films or works in films",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195aw-ss-1"
      },
