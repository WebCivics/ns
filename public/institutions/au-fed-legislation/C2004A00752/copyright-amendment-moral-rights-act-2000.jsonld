    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195al",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AL Derogatory treatment of cinematograph film",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195al"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.16",
      "values:originalText": "In this Part:\nderogatory treatment, in relation to a cinematograph film, means:\n\n(a) the doing, in relation to the film, of anything that results in a\nmaterial distortion of, the mutilation of, or a material\nalteration to, the film that is prejudicial to the maker’s honour\nor reputation; or\n\n(b) the doing of anything else in relation to the film that is\nprejudicial to the honour or reputation of the maker of the\nfilm.",
      "skos:definition": "In this Part:\nderogatory treatment, in relation to a cinematograph film, means:\n\n(a) the doing, in relation to the film, of anything that results in a\nmaterial distortion of, the mutilation of, or a material\nalteration to, the film that is prejudicial to the maker’s honour\nor reputation; or\n\n(b) the doing of anything else in relation to the film that is\nprejudicial to the honour or reputation of the maker of the\nfilm.",
      "cml:asserts": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195al-norm"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195al-logic-deontic-1"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195al-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195al-logic-alleninterval-3"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195al-logic-cogai-4"
        }
      ],
      "cml:integrityHash": "c519aa1d03a2c17928e8a0026831d4ac9834d7cf986acf5248823cf3573215ed",
      "skos:note": "Derogatory treatment of cinematograph film is prohibited."
    },
