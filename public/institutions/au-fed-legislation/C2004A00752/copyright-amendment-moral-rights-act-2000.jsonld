    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195as-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AS(4) No infringement of right of integrity of authorship if",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195as-ss-4"
      },
