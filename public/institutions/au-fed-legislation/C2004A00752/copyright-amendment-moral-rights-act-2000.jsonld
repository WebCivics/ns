      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195at-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AT(3) Certain treatment of works not to constitute an infringement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195at-ss-3"
