      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.6",
      "values:originalText": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nMoral rights of authors  Schedule 1",
      "skos:definition": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nMoral rights of authors  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sec-3-norm"
        }
      ],
      "cml:integrityHash": "7da283b1c0973853959a2f52ad201da8b1ba930cca16c3e695ac49370f9375b3",
      "skos:note": "Schedules governing amendments and repeals of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nMoral rights of authors  Schedule 1"
    },
