    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ak",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AK Derogatory treatment of artistic work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195ak"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.15",
      "values:originalText": "In this Part:\nderogatory treatment, in relation to an artistic work, means:\n\n(a) the doing, in relation to the work, of anything that results in a\nmaterial distortion of, the destruction or mutilation of, or a\nmaterial alteration to, the work that is prejudicial to the\nauthor’s honour or reputation; or\n\n(b) an exhibition in public of the work that is prejudicial to the\nauthor’s honour or reputation because of the manner or place\nin which the exhibition occurs; or\n\n(c) the doing of anything else in relation to the work that is\nprejudicial to the author’s honour or reputation.\n\nSchedule 1  Moral rights of authors",
      "skos:definition": "In this Part:\nderogatory treatment, in relation to an artistic work, means:\n\n(a) the doing, in relation to the work, of anything that results in a\nmaterial distortion of, the destruction or mutilation of, or a\nmaterial alteration to, the work that is prejudicial to the\nauthor’s honour or reputation; or\n\n(b) an exhibition in public of the work that is prejudicial to the\nauthor’s honour or reputation because of the manner or place\nin which the exhibition occurs; or\n\n(c) the doing of anything else in relation to the work that is\nprejudicial to the author’s honour or reputation.\n\nSchedule 1  Moral rights of authors",
      "cml:asserts": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ak-norm"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ak-logic-deontic-1"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ak-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "3287c352640c2f607f1aee8b3259016d5ae0f0be734014229d8d2fbb11a795f8",
      "skos:note": "Derogatory treatment of artistic work is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195ak",
      "@type": "cof:Section",
      "cof:title": "195AK Derogatory treatment of artistic work",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "In this Part:\nderogatory treatment, in relation to an artistic work, means:\n\n(a) the doing, in relation to the work, of anything that results in a\nmaterial distortion of, the destruction or mutilation of, or a\nmaterial alteration to, the work that is prejudicial to the\nauthor’s honour or reputation; or\n\n(b) an exhibition in public of the work that is prejudicial to the\nauthor’s honour or reputation because of the manner or place\nin which the exhibition occurs; or\n\n(c) the doing of anything else in relation to the work that is\nprejudicial to the author’s honour or reputation.\n\nSchedule 1  Moral rights of authors"
    },
