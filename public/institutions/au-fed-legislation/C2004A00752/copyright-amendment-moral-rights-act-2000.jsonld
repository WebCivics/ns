        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-diffusion-9"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-cogai-10"
        }
      ],
      "cml:integrityHash": "e3a0dc7ce57ff30c88b87091e396f579af180dbee2f1c76262ba408e5969cb50",
      "skos:note": "Employee's consent to acts or omissions for employer's benefit Employee's consent to act or omission for employer's benefit"
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195aw-ss-4",
      "@type": "cof:Section",
      "cof:title": "195AW(4) Author’s consent to act or omission—films or works in films",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(4) A consent may be given by an employee for the benefit of his or\nher employer in relation to all or any acts or omissions (whether\noccurring before or after the consent is given) and in relation to all\nworks made or to be made by the employee in the course of his or\nher employment."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Employee's consent is an obligation for the employer's benefit",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employee gives their consent.",
      "cml:conclusionText": "The employer has an obligation to respect the employee's consent."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Employee's consent overlaps with works made during employment",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employee gives their consent.",
      "cml:conclusionText": "The employer must respect all works made by the employee during their employment."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Employer's benefit implies obligation to respect employee's consent",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employee gives their consent for the employer's benefit.",
      "cml:conclusionText": "The employer has an obligation to respect the employee's consent."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Employee's consent diffuses to all acts or omissions related to works made during employment",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employee gives their consent.",
      "cml:conclusionText": "All acts or omissions related to the employee's consent are subject to the employer's obligation."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "CogAI recognizes the employee's consent as a relevant factor in determining the employer's obligations",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employee gives their consent.",
      "cml:conclusionText": "The employer must consider the employee's consent when making decisions about acts or omissions related to works made during employment."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Employee's consent is an obligation for the employer.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employee has given their consent.",
      "cml:conclusionText": "The employer must provide a benefit to the employee."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-alleninterval-7",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Employee's consent overlaps with works made or to be made by the employee.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The employee has given their consent.",
      "cml:conclusionText": "The employer must provide a benefit to the employee."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-4-logic-argumentation-8",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Employee's consent implies that the employer must provide a benefit.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
