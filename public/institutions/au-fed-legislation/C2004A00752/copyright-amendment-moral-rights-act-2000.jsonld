    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-194",
      "@type": "cml:Concept",
      "skos:prefLabel": "194 Acts giving rise to right of attribution of authorship",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-194"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.10",
      "values:originalText": "(1) If the work is a literary, dramatic or musical work, the attributable\nacts are the following:\n\n(a) to reproduce the work in a material form;\n\n(b) to publish the work;\n\n(c) to perform the work in public;\n\n(d) to transmit the work;\n\n(e) to make an adaptation of the work.\n\n(2) If the work is an artistic work, the attributable acts are the\nfollowing:\n\nMoral rights of authors  Schedule 1\n\n(a) to reproduce the work in a material form;\n\n(b) to publish the work;\n\n(c) to exhibit the work to the public;\n\n(d) to transmit the work.\n\n(3) If the work is a cinematograph film, the attributable acts are the\nfollowing:\n\n(a) to make a copy of the film;\n\n(b) to exhibit the film in public;\n\n(c) to transmit the film.",
      "skos:definition": "(1) If the work is a literary, dramatic or musical work, the attributable\nacts are the following:\n\n(a) to reproduce the work in a material form;\n\n(b) to publish the work;\n\n(c) to perform the work in public;\n\n(d) to transmit the work;\n\n(e) to make an adaptation of the work.\n\n(2) If the work is an artistic work, the attributable acts are the\nfollowing:\n\nMoral rights of authors  Schedule 1\n\n(a) to reproduce the work in a material form;\n\n(b) to publish the work;\n\n(c) to exhibit the work to the public;\n\n(d) to transmit the work.\n\n(3) If the work is a cinematograph film, the attributable acts are the\nfollowing:\n\n(a) to make a copy of the film;\n\n(b) to exhibit the film in public;\n\n(c) to transmit the film.",
      "cml:hasPart": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-194-ss-1"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-194-ss-2"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-194-ss-3"
        }
      ],
      "cml:integrityHash": "e97377bf812e7c0c66c2215523d123421b8e30bd82461b7c8eef7fd8e94e6105"
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-194",
      "@type": "cof:Section",
      "cof:title": "194 Acts giving rise to right of attribution of authorship",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) If the work is a literary, dramatic or musical work, the attributable\nacts are the following:\n\n(a) to reproduce the work in a material form;\n\n(b) to publish the work;\n\n(c) to perform the work in public;\n\n(d) to transmit the work;\n\n(e) to make an adaptation of the work.\n\n(2) If the work is an artistic work, the attributable acts are the\nfollowing:\n\nMoral rights of authors  Schedule 1\n\n(a) to reproduce the work in a material form;\n\n(b) to publish the work;\n\n(c) to exhibit the work to the public;\n\n(d) to transmit the work.\n\n(3) If the work is a cinematograph film, the attributable acts are the\nfollowing:\n\n(a) to make a copy of the film;\n\n(b) to exhibit the film in public;\n\n(c) to transmit the film."
    },
