    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195am",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AM Duration of moral rights",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195am"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.16",
      "values:originalText": "(1) An author’s right of integrity of authorship in respect of a\ncinematograph film continues in force until the author dies.\n\n(2) An author’s right of integrity of authorship in respect of a work\nother than a cinematograph film continues in force until copyright\nceases to subsist in the work.\n\n(3) An author’s moral rights (other than the right of integrity of\nauthorship) in respect of a work continue in force until copyright\nceases to subsist in the work.",
      "skos:definition": "(1) An author’s right of integrity of authorship in respect of a\ncinematograph film continues in force until the author dies.\n\n(2) An author’s right of integrity of authorship in respect of a work\nother than a cinematograph film continues in force until copyright\nceases to subsist in the work.\n\n(3) An author’s moral rights (other than the right of integrity of\nauthorship) in respect of a work continue in force until copyright\nceases to subsist in the work.",
      "cml:hasPart": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195am-ss-1"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195am-ss-2"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195am-ss-3"
        }
      ],
      "cml:integrityHash": "bce6f66fab9d742177e3b85f87b72d3180163cdae745c12ccb0fbdad7f50b637"
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195am",
      "@type": "cof:Section",
      "cof:title": "195AM Duration of moral rights",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "(1) An author’s right of integrity of authorship in respect of a\ncinematograph film continues in force until the author dies.\n\n(2) An author’s right of integrity of authorship in respect of a work\nother than a cinematograph film continues in force until copyright\nceases to subsist in the work.\n\n(3) An author’s moral rights (other than the right of integrity of\nauthorship) in respect of a work continue in force until copyright\nceases to subsist in the work."
    },
