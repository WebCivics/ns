    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-193",
      "@type": "cml:Concept",
      "skos:prefLabel": "193 Author’s right of attribution of authorship",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-193"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
