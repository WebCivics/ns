    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aj",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AJ Derogatory treatment of literary, dramatic or musical work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195aj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.15",
      "values:originalText": "In this Part:\nderogatory treatment, in relation to a literary, dramatic or musical\nwork, means:\n\n(a) the doing, in relation to the work, of anything that results in a\nmaterial distortion of, the mutilation of, or a material\nalteration to, the work that is prejudicial to the author’s\nhonour or reputation; or\n\n(b) the doing of anything else in relation to the work that is\nprejudicial to the author’s honour or reputation.",
      "skos:definition": "In this Part:\nderogatory treatment, in relation to a literary, dramatic or musical\nwork, means:\n\n(a) the doing, in relation to the work, of anything that results in a\nmaterial distortion of, the mutilation of, or a material\nalteration to, the work that is prejudicial to the author’s\nhonour or reputation; or\n\n(b) the doing of anything else in relation to the work that is\nprejudicial to the author’s honour or reputation.",
      "cml:asserts": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aj-norm"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aj-logic-deontic-1"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aj-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "97ef68c30b41ff927358e235b13fda8dabe3c7f0f849a861c4f7b9dd2ff60a7a",
      "skos:note": "Derogatory treatment of literary, dramatic or musical work is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195aj",
      "@type": "cof:Section",
      "cof:title": "195AJ Derogatory treatment of literary, dramatic or musical work",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "In this Part:\nderogatory treatment, in relation to a literary, dramatic or musical\nwork, means:\n\n(a) the doing, in relation to the work, of anything that results in a\nmaterial distortion of, the mutilation of, or a material\nalteration to, the work that is prejudicial to the author’s\nhonour or reputation; or\n\n(b) the doing of anything else in relation to the work that is\nprejudicial to the author’s honour or reputation."
    },
