      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.25",
      "values:originalText": "(1) An author’s moral right in respect of a work is infringed by a\nperson who, in Australia, deals with an article if the person knew,\nor ought reasonably to have known, that the article was an\ninfringing article or, in respect of an imported article, would, if it\nhad been made in Australia, have been an infringing article.",
      "skos:definition": "(1) An author’s moral right in respect of a work is infringed by a\nperson who, in Australia, deals with an article if the person knew,\nor ought reasonably to have known, that the article was an\ninfringing article or, in respect of an imported article, would, if it\nhad been made in Australia, have been an infringing article.",
      "values:partOf": {
        "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195av"
      },
