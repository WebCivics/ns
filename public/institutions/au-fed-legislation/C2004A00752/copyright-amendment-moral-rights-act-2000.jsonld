        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Change, relocation, demolition or destruction of a building is carried out without notice.",
      "cml:conclusionText": "No infringement occurs."
    },
    {
