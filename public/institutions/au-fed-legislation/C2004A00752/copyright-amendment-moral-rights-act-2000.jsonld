      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.36",
      "values:originalText": "Part IX of the Copyright Act 1968 as in force immediately before the\ncommencement of this Schedule continues to apply, subject to section\n238 of that Act as in force immediately before that commencement, in\nrelation to acts done in respect of a literary, dramatic, musical or artistic\nwork before that commencement.\n\nConsequential amendments of the Copyright Act 1968  Schedule 2",
      "skos:definition": "Part IX of the Copyright Act 1968 as in force immediately before the\ncommencement of this Schedule continues to apply, subject to section\n238 of that Act as in force immediately before that commencement, in\nrelation to acts done in respect of a literary, dramatic, musical or artistic\nwork before that commencement.\n\nConsequential amendments of the Copyright Act 1968  Schedule 2",
      "cml:asserts": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-3-norm"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2e610bad80e7d34d90a97d2b3642c028e7554e67b0131a90e3e1cc7b9505f84e",
      "skos:note": "Continues to apply part of Copyright Act 1968"
    },
