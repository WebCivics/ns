          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195at-ss-3-norm"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195at-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ec8e33aea01baeff1dbba234c39b7c9ca146076862f2240b4d21950ac80f27f4",
      "skos:note": "Owner must comply with subsection (3A) if they cannot discover author's identity and location."
    },
