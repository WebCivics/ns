    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ao",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AO Infringement of right of attribution of authorship",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195ao"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "copyright-amendment-moral-rights-act-2000.pdf"
      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.17",
      "values:originalText": "Subject to this Division, a person infringes an author’s right of\nattribution of authorship in respect of a work if the person does, or\nauthorises the doing of, an attributable act in respect of the work\nwithout the identification of the author in accordance with Division\n2 as the author of the work.",
      "skos:definition": "Subject to this Division, a person infringes an author’s right of\nattribution of authorship in respect of a work if the person does, or\nauthorises the doing of, an attributable act in respect of the work\nwithout the identification of the author in accordance with Division\n2 as the author of the work.",
      "cml:asserts": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ao-norm"
        }
      ],
      "cml:integrityHash": "de65e3f315a51548e9381efbe643934da996d808bab064c65cb1f1b187dbaf9f",
      "skos:note": "Infringement of authorship attribution right"
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195ao",
      "@type": "cof:Section",
      "cof:title": "195AO Infringement of right of attribution of authorship",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Subject to this Division, a person infringes an author’s right of\nattribution of authorship in respect of a work if the person does, or\nauthorises the doing of, an attributable act in respect of the work\nwithout the identification of the author in accordance with Division\n2 as the author of the work."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ao-norm",
