      },
      "cml:operator": "Classify",
      "cml:logicSummary": "Classifies derogatory treatment as a violation of the author's honour or reputation.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
