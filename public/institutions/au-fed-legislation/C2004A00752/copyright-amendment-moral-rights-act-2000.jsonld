      },
      "dc:source": "copyright-amendment-moral-rights-act-2000.pdf, p.26",
      "values:originalText": "(1) This section applies to a literary, dramatic, musical or artistic work\nother than such a work as included in a cinematograph film.\n\nMoral rights of authors  Schedule 1",
      "skos:definition": "(1) This section applies to a literary, dramatic, musical or artistic work\nother than such a work as included in a cinematograph film.\n\nMoral rights of authors  Schedule 1",
      "values:partOf": {
        "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw"
      },
      "cml:asserts": [
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-1-norm"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-1-logic-deontic-2"
        },
        {
          "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195aw-ss-1-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "0dd8a5e780ea61773bdb69643607b8d431ca9543b5c0efae378505e3ab1cbfaf",
      "skos:note": "Author's consent required for acts or omissions related to films or works in films. Written consent is required for acts or omissions affecting an author's moral right. Consent under duress is invalid."
    },
