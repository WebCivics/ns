    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195au",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AU Infringement by importation for sale or other dealing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195au"
      },
      "cml:curationStatus": {
