    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195ai",
      "@type": "cml:Concept",
      "skos:prefLabel": "195AI Author’s right of integrity of authorship",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195ai"
