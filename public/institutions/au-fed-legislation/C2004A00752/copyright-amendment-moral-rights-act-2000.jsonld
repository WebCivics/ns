        }
      ],
      "cml:integrityHash": "38e1bed6611daec0197bdc96543daec393f64068e45cb2c38b12dc84f4fd1d3e",
      "skos:note": "No infringement of right of integrity of authorship if reasonable treatment"
    },
    {
      "@id": "https://ns.webcivics.net/values/copyright-amendment-moral-rights-act-2000#sch-1-sec-195as-ss-1",
      "@type": "cof:Section",
      "cof:title": "195AS(1) No infringement of right of integrity of authorship if",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(1) A person does not, by subjecting a work, or authorising a work to\nbe subjected, to derogatory treatment, infringe the author’s right of\nintegrity of authorship in respect of the work if the person\nestablishes that it was reasonable in all the circumstances to subject\nthe work to the treatment."
    },
    {
      "@id": "concept:copyright-amendment-moral-rights-act-2000-sch-1-sec-195as-ss-1-norm",
