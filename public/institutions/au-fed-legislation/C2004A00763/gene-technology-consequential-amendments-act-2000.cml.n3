concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-10a-ss-5 a cml:Concept ;
    skos:prefLabel "10A(5) Consultation with Gene Technology Regulator"@en ;
    cml:realizedBy doc:sch-1-sec-10a-ss-5 ;
    values:originalText "(5) If an advice from the Gene Technology Regulator is in force under section 10B in relation to a class of GM products, the Director is not required to notify the Regulator under this section in relation to:  (a) an assessment of an industrial chemical that is or contains a GM product belonging to that class; or  (b) an application for a permit in respect of an industrial chemical that is or contains a GM product belonging to that class." ;
    skos:definition "(5) If an advice from the Gene Technology Regulator is in force under section 10B in relation to a class of GM products, the Director is not required to notify the Regulator under this section in relation to:  (a) an assessment of an industrial chemical that is or contains a GM product belonging to that class; or  (b) an application for a permit in respect of an industrial chemical that is or contains a GM product belonging to that class."@en ;
    cml:integrityHash "cb6d027a6eca6103e67810c203cda14e864a3785c56da7ad88967176a03d0a37" ;
    values:partOf concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-10a ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Exemption from notification for certain GM product assessments and applications." ;
