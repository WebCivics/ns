concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-30e a cml:Concept ;
    skos:prefLabel "30E Secretary to take advice into account"@en ;
    cml:realizedBy doc:sch-1-sec-30e ;
    values:originalText "If the Secretary receives advice from the Gene Technology Regulator:  (a) in response to a notice under section 30C within the period specified in the notice; or  (b) under section 30D; the Secretary must:  (c) ensure that the advice is taken into account in making a decision on the application to which the notice relates, or on an application to which the advice under section 30D relates, as the case requires; and  (d) inform the Gene Technology Regulator of the decision on the application.  [Minister’s second reading speech made in— House of Representatives on 22 June 2000 Senate on 30 August 2000]  (106/00)" ;
    skos:definition "If the Secretary receives advice from the Gene Technology Regulator:  (a) in response to a notice under section 30C within the period specified in the notice; or  (b) under section 30D; the Secretary must:  (c) ensure that the advice is taken into account in making a decision on the application to which the notice relates, or on an application to which the advice under section 30D relates, as the case requires; and  (d) inform the Gene Technology Regulator of the decision on the application.  [Minister’s second reading speech made in— House of Representatives on 22 June 2000 Senate on 30 August 2000]  (106/00)"@en ;
    cml:integrityHash "6470a08ea44b818b828f4682588369a9bf59d0d77bd38392a9d862db55b33699" ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Secretary must take advice into account when making a decision on an application." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-consequential-amendments-act-2000.pdf> ;
