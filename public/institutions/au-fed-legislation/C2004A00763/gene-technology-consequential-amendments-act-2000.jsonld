          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-8a-ss-2"
        },
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-8a-ss-3"
        },
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-8a-ss-4"
        },
        {
