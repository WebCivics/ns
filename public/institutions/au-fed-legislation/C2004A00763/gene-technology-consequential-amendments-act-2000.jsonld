    {
      "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-30e",
      "@type": "cml:Concept",
      "skos:prefLabel": "30E Secretary to take advice into account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-consequential-amendments-act-2000#sch-1-sec-30e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-consequential-amendments-act-2000.pdf"
      },
      "dc:source": "gene-technology-consequential-amendments-act-2000.pdf, p.14",
      "values:originalText": "If the Secretary receives advice from the Gene Technology\nRegulator:\n\n(a) in response to a notice under section 30C within the period\nspecified in the notice; or\n\n(b) under section 30D;\nthe Secretary must:\n\n(c) ensure that the advice is taken into account in making a\ndecision on the application to which the notice relates, or on\nan application to which the advice under section 30D relates,\nas the case requires; and\n\n(d) inform the Gene Technology Regulator of the decision on the\napplication.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 22 June 2000\nSenate on 30 August 2000]\n\n(106/00)",
      "skos:definition": "If the Secretary receives advice from the Gene Technology\nRegulator:\n\n(a) in response to a notice under section 30C within the period\nspecified in the notice; or\n\n(b) under section 30D;\nthe Secretary must:\n\n(c) ensure that the advice is taken into account in making a\ndecision on the application to which the notice relates, or on\nan application to which the advice under section 30D relates,\nas the case requires; and\n\n(d) inform the Gene Technology Regulator of the decision on the\napplication.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 22 June 2000\nSenate on 30 August 2000]\n\n(106/00)",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-30e-norm"
        },
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-30e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6470a08ea44b818b828f4682588369a9bf59d0d77bd38392a9d862db55b33699",
      "skos:note": "Secretary must take advice into account when making a decision on an application."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-consequential-amendments-act-2000#sch-1-sec-30e",
      "@type": "cof:Section",
      "cof:title": "30E Secretary to take advice into account",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "If the Secretary receives advice from the Gene Technology\nRegulator:\n\n(a) in response to a notice under section 30C within the period\nspecified in the notice; or\n\n(b) under section 30D;\nthe Secretary must:\n\n(c) ensure that the advice is taken into account in making a\ndecision on the application to which the notice relates, or on\nan application to which the advice under section 30D relates,\nas the case requires; and\n\n(d) inform the Gene Technology Regulator of the decision on the\napplication.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 22 June 2000\nSenate on 30 August 2000]\n\n(106/00)"
    },
