      ],
      "cml:integrityHash": "e2cdebc4a7367bf9b797eb0f2b19c2e739c7643996f3d0b70383d11971f65c8a",
      "skos:note": "Director must seek advice from Gene Technology Regulator about GM products"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-consequential-amendments-act-2000#sch-1-sec-10b-ss-1",
      "@type": "cof:Section",
      "cof:title": "10B(1) Director may seek advice about classes of GM products",
      "values:kind": "subsection",
      "cof:pageNumber": 11,
      "values:originalText": "(1) The Director may request advice from the Gene Technology\nRegulator in relation to industrial chemicals that consist of, or that\n\nSchedule 1  Consequential amendments\n\ncontain, a GM product belonging to a class of GM products\nspecified in the request."
    },
