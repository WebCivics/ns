    {
      "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-11a",
      "@type": "cml:Concept",
      "skos:prefLabel": "11A Notices to be given to the Gene Technology Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-consequential-amendments-act-2000#sch-1-sec-11a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-consequential-amendments-act-2000.pdf"
      },
      "dc:source": "gene-technology-consequential-amendments-act-2000.pdf, p.10",
      "values:originalText": "If a provision of this Act requires the Authority to give a notice\nconcerning an existing or proposed food regulatory measure to the\nGene Technology Regulator, the Authority is only required to give\nthe notice if the food regulatory measure relates to food that is or\ncontains a GMO or a GM product.\nFreedom of Information Act 1982",
      "skos:definition": "If a provision of this Act requires the Authority to give a notice\nconcerning an existing or proposed food regulatory measure to the\nGene Technology Regulator, the Authority is only required to give\nthe notice if the food regulatory measure relates to food that is or\ncontains a GMO or a GM product.\nFreedom of Information Act 1982",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-11a-norm"
        },
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-11a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2bb129bdb201160df10b8855c9baf00044cb5254552efc2d5a7435e6f9c51ba1",
      "skos:note": "Notice requirement for GMO-related food regulatory measures"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-consequential-amendments-act-2000#sch-1-sec-11a",
      "@type": "cof:Section",
      "cof:title": "11A Notices to be given to the Gene Technology Regulator",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "If a provision of this Act requires the Authority to give a notice\nconcerning an existing or proposed food regulatory measure to the\nGene Technology Regulator, the Authority is only required to give\nthe notice if the food regulatory measure relates to food that is or\ncontains a GMO or a GM product.\nFreedom of Information Act 1982"
    },
