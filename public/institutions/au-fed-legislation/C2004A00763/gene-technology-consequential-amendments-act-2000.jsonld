      "dc:source": "gene-technology-consequential-amendments-act-2000.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nConsequential amendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nConsequential amendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sec-3-norm"
        }
      ],
      "cml:integrityHash": "699df8d3a757f0daef96bbae893c1b98d779989bb7de3ddc6122df98c7575785",
      "skos:note": "Amendments and repeals of Acts specified in Schedules"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-consequential-amendments-act-2000#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nConsequential amendments  Schedule 1"
    },
