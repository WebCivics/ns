    {
      "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-10c",
      "@type": "cml:Concept",
      "skos:prefLabel": "10C Director to take advice into account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-consequential-amendments-act-2000#sch-1-sec-10c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-consequential-amendments-act-2000.pdf"
      },
      "dc:source": "gene-technology-consequential-amendments-act-2000.pdf, p.12",
      "values:originalText": "If the Director receives advice from the Gene Technology\nRegulator:\n\n(a) in response to a notice under section 10A within the period\nspecified in the notice; or\n\n(b) under section 10B;\nthe Director must:\n\n(c) ensure that the advice is taken into account in undertaking the\nassessment, or in making a decision on the application for the\npermit, as the case requires; and\n\n(d) inform the Gene Technology Regulator of the assessment, or\nthe decision on the application, as the case requires.\nTherapeutic Goods Act 1989",
      "skos:definition": "If the Director receives advice from the Gene Technology\nRegulator:\n\n(a) in response to a notice under section 10A within the period\nspecified in the notice; or\n\n(b) under section 10B;\nthe Director must:\n\n(c) ensure that the advice is taken into account in undertaking the\nassessment, or in making a decision on the application for the\npermit, as the case requires; and\n\n(d) inform the Gene Technology Regulator of the assessment, or\nthe decision on the application, as the case requires.\nTherapeutic Goods Act 1989",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-10c-norm"
        },
        {
          "@id": "concept:gene-technology-consequential-amendments-act-2000-sch-1-sec-10c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b06ed9efb1a00ac729eebbbb6495ede765d4c0bb80b583e65541d4cc60b8543b",
      "skos:note": "Ensure advice from Gene Technology Regulator is taken into account when assessing applications."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-consequential-amendments-act-2000#sch-1-sec-10c",
      "@type": "cof:Section",
      "cof:title": "10C Director to take advice into account",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "If the Director receives advice from the Gene Technology\nRegulator:\n\n(a) in response to a notice under section 10A within the period\nspecified in the notice; or\n\n(b) under section 10B;\nthe Director must:\n\n(c) ensure that the advice is taken into account in undertaking the\nassessment, or in making a decision on the application for the\npermit, as the case requires; and\n\n(d) inform the Gene Technology Regulator of the assessment, or\nthe decision on the application, as the case requires.\nTherapeutic Goods Act 1989"
    },
