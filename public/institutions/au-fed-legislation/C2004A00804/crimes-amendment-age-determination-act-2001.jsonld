      "dc:source": "crimes-amendment-age-determination-act-2001.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nDetermining a person’s age  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nDetermining a person’s age  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-age-determination-act-2001-sec-3-norm"
        }
      ],
      "cml:integrityHash": "6e272380a894026c84bc26ceeef050d59a2967a94a3e2838d446125b8f743048",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
