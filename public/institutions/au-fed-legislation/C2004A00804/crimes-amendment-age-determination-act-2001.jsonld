    {
      "@id": "concept:crimes-amendment-age-determination-act-2001-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 After paragraph 23C(7)(f)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-age-determination-act-2001#sch-1-sec-2"
