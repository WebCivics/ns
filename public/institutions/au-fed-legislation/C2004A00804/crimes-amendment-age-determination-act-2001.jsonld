      "dc:source": "crimes-amendment-age-determination-act-2001.pdf, p.14",
      "values:originalText": "Insert:\n\n(fa) any time during which the questioning of the person is\nsuspended or delayed in order to allow the making of an\napplication under section 3ZQB or the carrying out of a\nprescribed procedure within the meaning of Division 4A of\nPart 1AA;\n\n\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 7 March 2001\nSenate on 4 April 2001]\n\n(20/01)",
      "skos:definition": "Insert:\n\n(fa) any time during which the questioning of the person is\nsuspended or delayed in order to allow the making of an\napplication under section 3ZQB or the carrying out of a\nprescribed procedure within the meaning of Division 4A of\nPart 1AA;\n\n\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 7 March 2001\nSenate on 4 April 2001]\n\n(20/01)",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-age-determination-act-2001-sch-1-sec-2-norm"
        },
        {
          "@id": "concept:crimes-amendment-age-determination-act-2001-sch-1-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4aeb848f50c25d6c7fe2e25550ecbd8a21b77b6be70ce4a6edf3439d0eee6cd0",
      "skos:note": "Prohibition on questioning during application or procedure"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-age-determination-act-2001#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 After paragraph 23C(7)(f)",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Insert:\n\n(fa) any time during which the questioning of the person is\nsuspended or delayed in order to allow the making of an\napplication under section 3ZQB or the carrying out of a\nprescribed procedure within the meaning of Division 4A of\nPart 1AA;\n\n\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 7 March 2001\nSenate on 4 April 2001]\n\n(20/01)"
    },
