concept:australian-citizenship-legislation-amendment-act-2002-sch-2-sec-3 a cml:Concept ;
    skos:prefLabel "3 After subsection 10B(1)"@en ;
    cml:realizedBy doc:sch-2-sec-3 ;
    values:originalText "Insert:  (1A) If the relevant person referred to in subsection (1) has attained the age of 18 years, the name of the relevant person must not be registered for the purposes of this section unless the Minister is satisfied that the relevant person is of good character. Note: The heading to section 10C is altered by omitting “over 18 years old” and substituting “aged 18 or over on 15 January 1992”." ;
    skos:definition "Insert:  (1A) If the relevant person referred to in subsection (1) has attained the age of 18 years, the name of the relevant person must not be registered for the purposes of this section unless the Minister is satisfied that the relevant person is of good character. Note: The heading to section 10C is altered by omitting “over 18 years old” and substituting “aged 18 or over on 15 January 1992”."@en ;
    cml:integrityHash "016246a76b890a6cb3c4dc52c0b6ec8645e92f5e7b44ef33202cc48d7a7b24c7" ;
    cof:pageNumber "8"^^xsd:integer ;
