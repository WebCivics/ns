    cml:operator "MUST" ;
    cml:logicSummary "Minister must register declaration and re-register person as Australian citizen." ;
    cml:premiseText "The Minister is required to register the declaration." ;
    cml:conclusionText "The person making the declaration again becomes an Australian citizen." ;
