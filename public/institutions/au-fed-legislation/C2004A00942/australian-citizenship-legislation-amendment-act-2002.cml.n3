concept:australian-citizenship-legislation-amendment-act-2002-sch-2-sec-28 a cml:Concept ;
    skos:prefLabel "28 Subsection 23B(2)"@en ;
    cml:realizedBy doc:sch-2-sec-28 ;
    values:originalText "Other amendments  Schedule 2 Amendments  Part 1  Repeal the subsection, substitute:  (2) If:  (a) a person makes a declaration under subsection (1); and  (b) the Minister is satisfied that the person is of good character; the person to whom the declaration is given must register the declaration in the prescribed manner and, on the registration of the declaration, the person making the declaration again becomes an Australian citizen." ;
    skos:definition "Other amendments  Schedule 2 Amendments  Part 1  Repeal the subsection, substitute:  (2) If:  (a) a person makes a declaration under subsection (1); and  (b) the Minister is satisfied that the person is of good character; the person to whom the declaration is given must register the declaration in the prescribed manner and, on the registration of the declaration, the person making the declaration again becomes an Australian citizen."@en ;
    cml:integrityHash "7b22148d512b0b31a5d06458959d9aa1a00560a2671709083f65a8d784bc039b" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Register declaration of good character to regain Australian citizenship." ;
