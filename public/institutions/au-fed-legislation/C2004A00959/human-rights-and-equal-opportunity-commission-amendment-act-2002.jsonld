      "dc:source": "human-rights-and-equal-opportunity-commission-amendment-act-2002.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-and-equal-opportunity-commission-amendment-act-2002-sec-3-norm"
        }
      ],
      "cml:integrityHash": "608ff0d9999c7428d7699666117ef2a05836db52e5f5dc72a5d7ce8dfd65f70d",
      "skos:note": "Amendments to Acts specified in a Schedule"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-and-equal-opportunity-commission-amendment-act-2002#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1"
    },
