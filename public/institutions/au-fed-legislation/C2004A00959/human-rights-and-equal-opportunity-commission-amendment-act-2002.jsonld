      "dc:source": "human-rights-and-equal-opportunity-commission-amendment-act-2002.pdf, p.7",
      "values:originalText": "Insert:\n\n(1A) Part IIB binds the Crown in right of the States.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 21 February 2002\nSenate on 13 March 2002]\n\n(34/02)",
      "skos:definition": "Insert:\n\n(1A) Part IIB binds the Crown in right of the States.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 21 February 2002\nSenate on 13 March 2002]\n\n(34/02)",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-and-equal-opportunity-commission-amendment-act-2002-sch-1-sec-1-norm"
