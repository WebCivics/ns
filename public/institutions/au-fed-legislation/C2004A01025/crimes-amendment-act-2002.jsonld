    {
      "@id": "concept:crimes-amendment-act-2002-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-act-2002#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-act-2002.pdf"
      },
      "dc:source": "crimes-amendment-act-2002.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nForensic procedures  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nForensic procedures  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-act-2002-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "4417ff37e5d54e5b5a5c7694952a6cd8aca9bf605c2054eb9abe7f3cea1ab183",
      "skos:note": "Amendment and repeal of Acts specified in Schedules"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-act-2002#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nForensic procedures  Schedule 1"
