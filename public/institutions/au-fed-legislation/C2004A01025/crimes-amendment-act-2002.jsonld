      "dc:source": "crimes-amendment-act-2002.pdf, p.6",
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\npassed by the Parliament and assented to. It will not be expanded to\ndeal with provisions inserted in this Act after assent.\n\n(2) Column 3 of the table is for additional information that is not part\nof this Act. This information may be included in any published\nversion of this Act.",
      "skos:definition": "Note:\nThis table relates only to the provisions of this Act as originally\npassed by the Parliament and assented to. It will not be expanded to\ndeal with provisions inserted in this Act after assent.\n\n(2) Column 3 of the table is for additional information that is not part\nof this Act. This information may be included in any published\nversion of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-act-2002-sec-1-3-norm"
        }
      ],
      "cml:integrityHash": "71b0778ea245e7b54da7cf985294744c0df95ec05e8616d87b3373e52057e04b",
      "skos:note": "Note on table limitations"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-act-2002#sec-1-3",
      "@type": "cof:Section",
      "cof:title": "1 January 2003",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\npassed by the Parliament and assented to. It will not be expanded to\ndeal with provisions inserted in this Act after assent.\n\n(2) Column 3 of the table is for additional information that is not part\nof this Act. This information may be included in any published\nversion of this Act."
    },
