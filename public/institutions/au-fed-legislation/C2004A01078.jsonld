    {
      "@id": "concept:c2004a01078-sch-2-sec-360-3-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2004a01078.pdf, p.17",
      "skos:note": "Taking or sending a firearm across state or territory boundaries without proper disposal is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "360(1) Section 360"
      },
      "wasDerivedFrom": "c2004a01078.pdf",
      "asserts": [
        "concept:c2004a01078-sch-2-sec-360-3-ss-1-norm",
        "concept:c2004a01078-sch-2-sec-360-3-ss-1-logic-deontic-1",
        "concept:c2004a01078-sch-2-sec-360-3-ss-1-logic-deontic-2",
        "concept:c2004a01078-sch-2-sec-360-3-ss-1-logic-alleninterval-3",
        "concept:c2004a01078-sch-2-sec-360-3-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "b89e1158e1172daa987d815cbfcb83688de86feb776349208b005467605a31de",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2004a01078#sch-2-sec-360-3-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:c2004a01078-sch-2-sec-360-3"
    },
    {
      "@id": "concept:c2004a01078-sch-2-sec-360-3-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must dispose of the firearm within a certain time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines a temporal interval for proper disposal of a firearm.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Between",
      "cml:premiseText": "(b) the person does so intending that the firearm will be disposed of in the other State or Territory..."
    },
    {
      "@id": "concept:c2004a01078-sch-2-sec-360-3-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Taking or sending a firearm across state or territory boundaries is an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits taking or sending a firearm across state or territory boundaries.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) in the course of trade or commerce among the States, between Territories or between a Territory and a State..."
    },
    {
      "@id": "concept:c2004a01078-sch-2-sec-360-3-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person has an obligation to dispose of the firearm properly.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes an obligation to dispose of a firearm properly.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(b) the person does so intending that the firearm will be disposed of in the other State or Territory..."
    },
    {
      "@id": "concept:c2004a01078-sch-2-sec-360-3-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must not know or be reckless about proper disposal of the firearm.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits knowing or recklessness about proper disposal of a firearm.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(c) the person knows that, or is reckless as to whether..."
    },
