    {
      "@id": "concept:c2004a01078-sch-1-sec-73-10",
      "@type": "cml:Concept",
      "dc:source": "c2004a01078.pdf, p.14",
      "skos:note": "Providing or possessing a travel or identity document to be used by someone who is not the rightful user is an offence.",
