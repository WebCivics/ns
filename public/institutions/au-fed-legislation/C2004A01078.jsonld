      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-9-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits providing or possessing a travel or identity document issued or altered dishonestly or as a result of threats.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The provision or possession of such a document is an offence."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-9-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits providing or possessing a travel or identity document issued or altered dishonestly or as a result of threats for personal gain.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The provision or possession of such a document is done with the intention of obtaining a benefit."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-9-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits providing or possessing a travel or identity document issued or altered dishonestly or as a result of threats to obtain a benefit for another person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The provision or possession of such a document is done with the intention of facilitating the entry of another person into a foreign country."
    },
