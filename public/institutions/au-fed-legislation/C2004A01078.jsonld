    {
      "@id": "concept:c2004a01078-sch-1-sec-73-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2004a01078.pdf, p.8",
      "skos:note": "Organising or facilitating entry into a foreign country without complying with local law is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "73(1) Section 73"
      },
      "wasDerivedFrom": "c2004a01078.pdf",
      "asserts": [
        "concept:c2004a01078-sch-1-sec-73-ss-1-norm",
        "concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-1",
        "concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-2",
        "concept:c2004a01078-sch-1-sec-73-ss-1-logic-alleninterval-3",
        "concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-4",
        "concept:c2004a01078-sch-1-sec-73-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "e35709674f4668eac36e33f10477def2fed965a35b10a8290a44e74bfad16f73",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2004a01078#sch-1-sec-73-ss-1",
