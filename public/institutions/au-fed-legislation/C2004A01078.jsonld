    {
      "@id": "concept:c2004a01078-sch-1-sec-73-2-ss-1-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (ii) the first person is reckless as to the danger of death or serious harm to the victim that arises from the conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines temporal interval for reckless conduct",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Between",
      "cml:premiseText": "(c) in committing the offence, the first person’s conduct: (i) gives rise to a danger of death or serious harm to the victim; and (ii) the first person is reckless as to the danger of death or serious harm to the victim that arises from the conduct."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person is guilty of an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits people smuggling with intent to exploit or subject to cruel treatment",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the first person commits the offence intending that the victim will be exploited after entry into the foreign country (whether by the first person or another);"
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-2-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person is guilty of an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits people smuggling with subject to cruel treatment",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(b) in committing the offence, the first person subjects the victim to cruel, inhuman or degrading treatment;"
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-2-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person is guilty of an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits people smuggling with reckless conduct",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(c) in committing the offence, the first person’s conduct: (i) gives rise to a danger of death or serious harm to the victim; and (ii) the first person is reckless as to the danger of death or serious harm to the victim that arises from the conduct."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-2-ss-1-logic-ltl-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (ii) the first person is reckless as to the danger of death or serious harm to the victim that arises from the conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
