    {
      "@id": "concept:c2004a01078-sch-1-sec-73-7-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2004a01078.pdf, p.12",
      "skos:note": "A travel or identity document is false if it purports to have been made in a certain form or on the authority of a person who did not authorise its making.",
