    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-deontic-1>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-deontic-1> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits action";
    <https://ns.webcivics.net/cml/premiseText> "(a) the first person organises or facilitates the entry of another person into a foreign country (whether or not via Australia); and";
    <https://ns.webcivics.net/cml/conclusionText> "(the first person is guilty of an offence if...)";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-deontic-2>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-deontic-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Imposes obligation on the first person to comply with local law";
    <https://ns.webcivics.net/cml/premiseText> "(b) the entry of the other person into the foreign country does not comply with the requirements under that country’s law for entry into the country; and";
    <https://ns.webcivics.net/cml/conclusionText> "(the first person is guilty of an offence if...)";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-alleninterval-3>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-alleninterval-3> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/AllenInterval>;
    <https://ns.webcivics.net/cml/operator> "Overlaps";
    <https://ns.webcivics.net/cml/logicSummary> "Defines temporal overlap between actions";
    <https://ns.webcivics.net/cml/premiseText> "(c) the other person is not a citizen or permanent resident of the foreign country; and";
    <https://ns.webcivics.net/cml/conclusionText> "(the first person is guilty of an offence if...)";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-deontic-4>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-deontic-4> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits obtaining benefits from facilitating entry into a foreign country";
    <https://ns.webcivics.net/cml/premiseText> "(d) the first person organises or facilitates the entry: (i) having obtained (whether directly or indirectly) a benefit to do so; or";
    <https://ns.webcivics.net/cml/conclusionText> "(the first person is guilty of an offence if...)";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-deontic-5>.
<https://ns.webcivics.net/concept/c2004a01078-sch-1-sec-73-ss-1-logic-deontic-5> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits obtaining benefits from facilitating entry into a foreign country with intention";
    <https://ns.webcivics.net/cml/premiseText> "(d) the first person organises or facilitates the entry: (ii) with the intention of obtaining (whether directly or indirectly) a benefit.";
    <https://ns.webcivics.net/cml/conclusionText> "(the first person is guilty of an offence if...)";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
