    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Imposes an obligation to dispose of a firearm properly.";
    <https://ns.webcivics.net/cml/premiseText> "(b) the person does so intending that the firearm will be disposed of in the other State or Territory...";
    <https://ns.webcivics.net/cml/conclusionText> "The person has an obligation to dispose of the firearm properly.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
