    <https://ns.webcivics.net/cml/logicSummary> "Prohibits taking or sending a firearm across state or territory boundaries.";
    <https://ns.webcivics.net/cml/premiseText> "(a) in the course of trade or commerce among the States, between Territories or between a Territory and a State...";
    <https://ns.webcivics.net/cml/conclusionText> "Taking or sending a firearm across state or territory boundaries is an offence.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
