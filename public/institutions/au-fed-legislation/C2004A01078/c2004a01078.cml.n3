concept:c2004a01078-sch-3-sec-7 a cml:Concept ;
    skos:prefLabel "7 The Schedule (subsection 135.2(2) of the Criminal Code)"@en ;
    cml:realizedBy doc:sch-3-sec-7 ;
    values:originalText "Repeal the subsection, substitute:  (2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity. Penalty: Imprisonment for 12 months.  (2A) Absolute liability applies to the paragraph (2)(b) element of the offence." ;
    skos:definition "Repeal the subsection, substitute:  (2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity. Penalty: Imprisonment for 12 months.  (2A) Absolute liability applies to the paragraph (2)(b) element of the offence."@en ;
    cml:integrityHash "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b" ;
    cof:pageNumber "20"^^xsd:integer ;
