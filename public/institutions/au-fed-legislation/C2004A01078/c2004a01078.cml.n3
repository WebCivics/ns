concept:c2004a01078-sch-3-sec-6 a cml:Concept ;
    skos:prefLabel "6 The Schedule (subsection 135.2(1) of the Criminal Code)"@en ;
    cml:realizedBy doc:sch-3-sec-6 ;
    values:originalText "Repeal the subsection, substitute:  (1) A person is guilty of an offence if:  (a) the person obtains a financial advantage for himself or herself from another person, knowing or believing that he or she is not eligible to receive that financial advantage; and  (b) the other person is a Commonwealth entity. Penalty: Imprisonment for 12 months.  Schedule 3  Other measures" ;
    skos:definition "Repeal the subsection, substitute:  (1) A person is guilty of an offence if:  (a) the person obtains a financial advantage for himself or herself from another person, knowing or believing that he or she is not eligible to receive that financial advantage; and  (b) the other person is a Commonwealth entity. Penalty: Imprisonment for 12 months.  Schedule 3  Other measures"@en ;
    cml:integrityHash "a9b1fdf16644d7b46c2eb7c9d4fd02fa5969c0b3433902093d8873ea257adf1f" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Obtain financial advantage from Commonwealth entity without eligibility" ;
    cml:curationStatus cml:Proposed ;
