concept:c2004a01078-sch-3-sec-57 a cml:Concept ;
    skos:prefLabel "57 Consent of the Immigration Minister"@en ;
    cml:realizedBy doc:sch-3-sec-57 ;
    values:originalText "If the Attorney-General proposes to consent to the transfer to Australia of a Tribunal prisoner, the Attorney-General must first obtain the consent of the Immigration Minister.  [Minister’s second reading speech made in— House of Representatives on 4 December 2002 Senate on 12 December 2002]  (252/02)" ;
    skos:definition "If the Attorney-General proposes to consent to the transfer to Australia of a Tribunal prisoner, the Attorney-General must first obtain the consent of the Immigration Minister.  [Minister’s second reading speech made in— House of Representatives on 4 December 2002 Senate on 12 December 2002]  (252/02)"@en ;
    cml:integrityHash "35d70bd399ca472f13738290100dcefa2c4697d6e630baa84292ed4fe3e5bb0e" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Consent of the Immigration Minister required for transfer to Australia" ;
