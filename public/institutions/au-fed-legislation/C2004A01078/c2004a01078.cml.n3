doc:sch-3-sec-7-ss-2 a cof:Section ;
    cof:title "7(2) The Schedule (subsection 135.2(2) of the Criminal Code)" ;
    values:kind "subsection" ;
    values:originalText "(2) A person is guilty of an offence if:  (a) the person obtains a financial advantage for another person from a third person, knowing or believing that the other person is not eligible to receive that financial advantage; and  (b) the third person is a Commonwealth entity. Penalty: Imprisonment for 12 months." ;
    cof:pageNumber "20"^^xsd:integer .

