concept:c2004a01078-sch-2-sec-360-4 a cml:Concept ;
    skos:prefLabel "360 4  Concurrent operation intended"@en ;
    cml:realizedBy doc:sch-2-sec-360-4 ;
    values:originalText "This Division is not intended to exclude or limit the concurrent operation of any law of a State or Territory.  Other measures  Schedule 3  Crimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)" ;
    skos:definition "This Division is not intended to exclude or limit the concurrent operation of any law of a State or Territory.  Other measures  Schedule 3  Crimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)"@en ;
