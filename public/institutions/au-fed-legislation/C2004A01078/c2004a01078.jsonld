      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The conduct occurs wholly outside Australia.",
      "cml:conclusionText": "The result of the conduct occurs, or is intended by the person to occur, outside Australia."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Occurs during conduct constituting the alleged offence.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The conduct occurs wholly outside Australia.",
      "cml:conclusionText": "A result of the conduct occurs, or is intended by the person to occur, outside Australia."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires jurisdictional requirement for committing an offence.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
