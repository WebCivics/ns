      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Imply",
      "cml:logicSummary": "Implies the act of people smuggling is a crime",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) A person (the first person) is guilty of an offence if...",
      "cml:conclusionText": "Penalty: Imprisonment for 20 years or 2,000 penalty units, or both."
    },
    {
