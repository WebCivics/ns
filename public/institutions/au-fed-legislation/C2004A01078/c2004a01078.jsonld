        }
      ],
      "cml:integrityHash": "7973a02eb76820754253c9ec4ff250f72c3af7da5cf5b14a420eaf6d72dd0a4a",
      "skos:note": "Acquires a firearm if purchases, hires, leases, or obtains physical control."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-2-sec-360-ss-2",
