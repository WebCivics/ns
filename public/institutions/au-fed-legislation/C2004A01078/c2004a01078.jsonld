    {
      "@id": "concept:c2004a01078-sch-3-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 At the end of section 13",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-3-sec-25"
      },
      "cml:curationStatus": {
