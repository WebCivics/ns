      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Requires recurring trace of obtaining financial advantage from Commonwealth entity",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
