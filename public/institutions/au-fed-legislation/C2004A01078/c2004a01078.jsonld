        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the first person organises or facilitates the entry: having obtained (whether directly or indirectly) a benefit to do so;",
      "cml:conclusionText": "Penalty: Imprisonment for 20 years or 2,000 penalty units, or both."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the act of obtaining a benefit through people smuggling with intention",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the first person organises or facilitates the entry: with the intention of obtaining (whether directly or indirectly) a benefit.",
      "cml:conclusionText": "Penalty: Imprisonment for 20 years or 2,000 penalty units, or both."
    },
    {
