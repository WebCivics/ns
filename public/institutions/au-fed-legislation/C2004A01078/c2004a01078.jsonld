    {
      "@id": "concept:c2004a01078-sec-4-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Transitional—items 1, 2 and 3 of Schedule 3",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sec-4-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a01078.pdf"
      },
      "dc:source": "c2004a01078.pdf, p.6",
      "values:originalText": "The amendments made by items 1, 2 and 3 of Schedule 3 apply to\nany sentence imposed after the commencement of those items,\n\n\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)\nwhether or not the offence concerned was committed before that\ncommencement.\n\nSchedule 1  People smuggling",
      "skos:definition": "The amendments made by items 1, 2 and 3 of Schedule 3 apply to\nany sentence imposed after the commencement of those items,\n\n\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)\nwhether or not the offence concerned was committed before that\ncommencement.\n\nSchedule 1  People smuggling",
      "cml:asserts": [
        {
          "@id": "concept:c2004a01078-sec-4-2-norm"
        }
      ],
      "cml:integrityHash": "f4c8110827fd0ddb07b79131c7da99435fe53c9d30dc20a1e65ff7c3d8dacdea",
      "skos:note": "Amendments apply to sentences imposed after commencement of Schedule 3 items"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sec-4-2",
      "@type": "cof:Section",
      "cof:title": "4 Transitional—items 1, 2 and 3 of Schedule 3",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "The amendments made by items 1, 2 and 3 of Schedule 3 apply to\nany sentence imposed after the commencement of those items,\n\n\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)\nwhether or not the offence concerned was committed before that\ncommencement.\n\nSchedule 1  People smuggling"
    },
