    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Threat is defined as a specific type of action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The term 'threat' is used in the legislation.",
      "cml:conclusionText": "A threat is an obligation to perform or refrain from performing a certain action."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-6-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is-a",
      "cml:logicSummary": "Threat is related to labour or services provision",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The definition of threat includes labour or services provision.",
      "cml:conclusionText": "A threat is related to the provision of labour or services by a person."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-6-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Threats are related to temporal intervals",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The definition of threat includes threats of force, deportation, and other actions.",
      "cml:conclusionText": "Threats occur during the provision of labour or services by a person."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-6-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "for-all",
      "cml:logicSummary": "Threats are related to all persons affected",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The definition of threat includes threats to cause deportation.",
      "cml:conclusionText": "All persons affected by the provision of labour or services may be threatened."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-6-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "iff",
      "cml:logicSummary": "Threats are related to diffusion of information",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The definition of threat includes threats of force and other actions.",
      "cml:conclusionText": "Threats may be diffused through the provision of labour or services by a person."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-6-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "is-a",
      "cml:logicSummary": "Threat is related to artificial intelligence",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The definition of threat includes threats of force and other actions.",
      "cml:conclusionText": "A threat is an action that may be performed by a person or an artificial agent."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "73 3  Aggravated offence of people smuggling (at least 5 people)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-73-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a01078.pdf"
      },
      "dc:source": "c2004a01078.pdf, p.10",
      "values:originalText": "(1) A person (the first person) is guilty of an offence if:\n\n(a) the first person organises or facilitates the entry of a group of\nat least 5 persons (the other persons) into a foreign country\n(whether or not via Australia); and\n\n(b) the entry of at least 5 of the other persons into the foreign\ncountry does not comply with the requirements under that\ncountry’s law for entry into that country; and\n\n(c) at least 5 of the other persons whose entry into the foreign\ncountry is covered by paragraph (b) are not citizens or\npermanent residents of the foreign country; and\n\n(d) the first person organises or facilitates the entry:\n\n(i) having obtained (whether directly or indirectly) a\nbenefit to do so; or\n\n(ii) with the intention of obtaining (whether directly or\nindirectly) a benefit.\nPenalty: Imprisonment for 20 years or 2,000 penalty units, or\nboth.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\n\n(3) If, on a trial for an offence against subsection (1), the trier of fact is\nnot satisfied that the defendant is guilty of that offence, but is\nsatisfied beyond reasonable doubt that the defendant is guilty of an\noffence against subsection 73.1(1), the trier of fact may find the\ndefendant not guilty of an offence against subsection (1) but guilty\nof an offence against subsection 73.1(1), so long as the defendant\nhas been accorded procedural fairness in relation to that finding of\nguilt.\n\nPeople smuggling  Schedule 1\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)",
      "skos:definition": "(1) A person (the first person) is guilty of an offence if:\n\n(a) the first person organises or facilitates the entry of a group of\nat least 5 persons (the other persons) into a foreign country\n(whether or not via Australia); and\n\n(b) the entry of at least 5 of the other persons into the foreign\ncountry does not comply with the requirements under that\ncountry’s law for entry into that country; and\n\n(c) at least 5 of the other persons whose entry into the foreign\ncountry is covered by paragraph (b) are not citizens or\npermanent residents of the foreign country; and\n\n(d) the first person organises or facilitates the entry:\n\n(i) having obtained (whether directly or indirectly) a\nbenefit to do so; or\n\n(ii) with the intention of obtaining (whether directly or\nindirectly) a benefit.\nPenalty: Imprisonment for 20 years or 2,000 penalty units, or\nboth.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\n\n(3) If, on a trial for an offence against subsection (1), the trier of fact is\nnot satisfied that the defendant is guilty of that offence, but is\nsatisfied beyond reasonable doubt that the defendant is guilty of an\noffence against subsection 73.1(1), the trier of fact may find the\ndefendant not guilty of an offence against subsection (1) but guilty\nof an offence against subsection 73.1(1), so long as the defendant\nhas been accorded procedural fairness in relation to that finding of\nguilt.\n\nPeople smuggling  Schedule 1\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)",
      "cml:hasPart": [
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-1"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-2"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-3"
        }
      ],
      "cml:integrityHash": "2fe80de175bd7871a329ed5a4506ee24989311ae80b73a77021edc98663181c1"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-73-3",
      "@type": "cof:Section",
      "cof:title": "73 3  Aggravated offence of people smuggling (at least 5 people)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) A person (the first person) is guilty of an offence if:\n\n(a) the first person organises or facilitates the entry of a group of\nat least 5 persons (the other persons) into a foreign country\n(whether or not via Australia); and\n\n(b) the entry of at least 5 of the other persons into the foreign\ncountry does not comply with the requirements under that\ncountry’s law for entry into that country; and\n\n(c) at least 5 of the other persons whose entry into the foreign\ncountry is covered by paragraph (b) are not citizens or\npermanent residents of the foreign country; and\n\n(d) the first person organises or facilitates the entry:\n\n(i) having obtained (whether directly or indirectly) a\nbenefit to do so; or\n\n(ii) with the intention of obtaining (whether directly or\nindirectly) a benefit.\nPenalty: Imprisonment for 20 years or 2,000 penalty units, or\nboth.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\n\n(3) If, on a trial for an offence against subsection (1), the trier of fact is\nnot satisfied that the defendant is guilty of that offence, but is\nsatisfied beyond reasonable doubt that the defendant is guilty of an\noffence against subsection 73.1(1), the trier of fact may find the\ndefendant not guilty of an offence against subsection (1) but guilty\nof an offence against subsection 73.1(1), so long as the defendant\nhas been accorded procedural fairness in relation to that finding of\nguilt.\n\nPeople smuggling  Schedule 1\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)"
    },
