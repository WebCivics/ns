      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires jurisdictional requirement for committing an offence.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person must be an Australian citizen or resident of Australia.",
      "cml:conclusionText": "The conduct constituting the alleged offence occurs wholly outside Australia."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
