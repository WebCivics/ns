      }
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "73 4  Jurisdictional requirement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-73-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a01078.pdf"
      },
      "dc:source": "c2004a01078.pdf, p.11",
      "values:originalText": "A person commits an offence against this Subdivision only if:\n\n(a) both:\n\n(i) the person is an Australian citizen or a resident of\nAustralia; and\n\n(ii) the conduct constituting the alleged offence occurs\nwholly outside Australia; or\n\n(b) both:\n\n(i) the conduct constituting the alleged offence occurs\nwholly or partly in Australia; and\n\n(ii) a result of the conduct occurs, or is intended by the\nperson to occur, outside Australia.",
      "skos:definition": "A person commits an offence against this Subdivision only if:\n\n(a) both:\n\n(i) the person is an Australian citizen or a resident of\nAustralia; and\n\n(ii) the conduct constituting the alleged offence occurs\nwholly outside Australia; or\n\n(b) both:\n\n(i) the conduct constituting the alleged offence occurs\nwholly or partly in Australia; and\n\n(ii) a result of the conduct occurs, or is intended by the\nperson to occur, outside Australia.",
      "cml:asserts": [
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-4-norm"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-deontic-1"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-deontic-2"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-alleninterval-3"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-ltl-4"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-4-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "bb4f454d8916fa83a2727efa1a7cb2b847427831f2281cddb8feb7ecff660410",
      "skos:note": "Jurisdictional requirement for committing an offence against this Subdivision."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-73-4",
      "@type": "cof:Section",
      "cof:title": "73 4  Jurisdictional requirement",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "A person commits an offence against this Subdivision only if:\n\n(a) both:\n\n(i) the person is an Australian citizen or a resident of\nAustralia; and\n\n(ii) the conduct constituting the alleged offence occurs\nwholly outside Australia; or\n\n(b) both:\n\n(i) the conduct constituting the alleged offence occurs\nwholly or partly in Australia; and\n\n(ii) a result of the conduct occurs, or is intended by the\nperson to occur, outside Australia."
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
