      ],
      "cml:integrityHash": "0f60299ce32bb624bee0b86857df6e0b794cdc2b010a808565f9c7fb3abd37f7",
      "skos:note": "Document purports to be a true copy of another document is treated as the original."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-73-7-ss-3",
      "@type": "cof:Section",
      "cof:title": "73(3) 7  Meaning of false travel or identity document",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(3) This section has effect as if a document that purports to be a true\ncopy of another document were the original document.\n\nPeople smuggling  Schedule 1\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)"
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-7-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2004a01078-sch-1-sec-73-7-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-7-ss-3-logic-deontic-1",
