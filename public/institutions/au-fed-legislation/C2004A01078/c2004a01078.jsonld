      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a01078.pdf"
      },
      "dc:source": "c2004a01078.pdf, p.23",
      "values:originalText": "Add:\n\n(2) If a request is made for the transfer of a prisoner (other than a\nTribunal prisoner) to Australia, the Attorney-General must consult\nwith the Immigration Minister about whether the prisoner:\n\n(a) is eligible under subsection (1) for a transfer to Australia; or\n\n(b) is likely to be eligible under subsection (1) for a transfer to\nAustralia at a future time specified by the Attorney-General\nfor the purposes of the consultation.",
      "skos:definition": "Add:\n\n(2) If a request is made for the transfer of a prisoner (other than a\nTribunal prisoner) to Australia, the Attorney-General must consult\nwith the Immigration Minister about whether the prisoner:\n\n(a) is eligible under subsection (1) for a transfer to Australia; or\n\n(b) is likely to be eligible under subsection (1) for a transfer to\nAustralia at a future time specified by the Attorney-General\nfor the purposes of the consultation.",
      "cml:asserts": [
        {
          "@id": "concept:c2004a01078-sch-3-sec-25-norm"
        },
        {
          "@id": "concept:c2004a01078-sch-3-sec-25-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "494102a3caf9f2f6afc2f80154407f09cf4ee354190d36810e8801887cacc9bb",
      "skos:note": "Consultation with Immigration Minister required for prisoner transfer request"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-3-sec-25",
      "@type": "cof:Section",
      "cof:title": "25 At the end of section 13",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Add:\n\n(2) If a request is made for the transfer of a prisoner (other than a\nTribunal prisoner) to Australia, the Attorney-General must consult\nwith the Immigration Minister about whether the prisoner:\n\n(a) is eligible under subsection (1) for a transfer to Australia; or\n\n(b) is likely to be eligible under subsection (1) for a transfer to\nAustralia at a future time specified by the Attorney-General\nfor the purposes of the consultation."
    },
