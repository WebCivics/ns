    {
      "@id": "concept:c2004a01078-sch-3-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 The Schedule (subsection 135.2(1) of the Criminal Code)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-3-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a01078.pdf"
      },
      "dc:source": "c2004a01078.pdf, p.19",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A person is guilty of an offence if:\n\n(a) the person obtains a financial advantage for himself or\nherself from another person, knowing or believing that he or\nshe is not eligible to receive that financial advantage; and\n\n(b) the other person is a Commonwealth entity.\nPenalty: Imprisonment for 12 months.\n\nSchedule 3  Other measures",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) A person is guilty of an offence if:\n\n(a) the person obtains a financial advantage for himself or\nherself from another person, knowing or believing that he or\nshe is not eligible to receive that financial advantage; and\n\n(b) the other person is a Commonwealth entity.\nPenalty: Imprisonment for 12 months.\n\nSchedule 3  Other measures",
      "cml:asserts": [
        {
          "@id": "concept:c2004a01078-sch-3-sec-6-norm"
        },
        {
          "@id": "concept:c2004a01078-sch-3-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a9b1fdf16644d7b46c2eb7c9d4fd02fa5969c0b3433902093d8873ea257adf1f",
      "skos:note": "Obtain financial advantage from Commonwealth entity without eligibility"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-3-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 The Schedule (subsection 135.2(1) of the Criminal Code)",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A person is guilty of an offence if:\n\n(a) the person obtains a financial advantage for himself or\nherself from another person, knowing or believing that he or\nshe is not eligible to receive that financial advantage; and\n\n(b) the other person is a Commonwealth entity.\nPenalty: Imprisonment for 12 months.\n\nSchedule 3  Other measures"
    },
