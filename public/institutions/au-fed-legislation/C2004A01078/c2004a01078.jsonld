    {
      "@id": "concept:c2004a01078-sch-1-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Crimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a01078.pdf"
      },
      "dc:source": "c2004a01078.pdf, p.14",
      "values:originalText": "Penalty: Imprisonment for 10 years or 1,000 penalty units, or\nboth.\n\n(2) For the purposes of subsection (1), a threat may be:\n\n(a) express or implied; or\n\n(b) conditional or unconditional.\n\n(3) For the purposes of subsection (1), dishonest means:\n\n(a) dishonest according to the standards of ordinary people; and\n\n(b) known by the defendant to be dishonest according to the\nstandards of ordinary people.\n\n(4) In a prosecution for an offence against this section, the\ndetermination of dishonesty is a matter for the trier of fact.",
      "skos:definition": "Penalty: Imprisonment for 10 years or 1,000 penalty units, or\nboth.\n\n(2) For the purposes of subsection (1), a threat may be:\n\n(a) express or implied; or\n\n(b) conditional or unconditional.\n\n(3) For the purposes of subsection (1), dishonest means:\n\n(a) dishonest according to the standards of ordinary people; and\n\n(b) known by the defendant to be dishonest according to the\nstandards of ordinary people.\n\n(4) In a prosecution for an offence against this section, the\ndetermination of dishonesty is a matter for the trier of fact.",
      "cml:hasPart": [
        {
          "@id": "concept:c2004a01078-sch-1-sec-10-ss-2"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-10-ss-3"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-10-ss-4"
        }
      ],
      "cml:integrityHash": "6dfb551e39a00464c6d968318a74ce967876fede876649d85930dbdecf12e573"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Crimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Penalty: Imprisonment for 10 years or 1,000 penalty units, or\nboth.\n\n(2) For the purposes of subsection (1), a threat may be:\n\n(a) express or implied; or\n\n(b) conditional or unconditional.\n\n(3) For the purposes of subsection (1), dishonest means:\n\n(a) dishonest according to the standards of ordinary people; and\n\n(b) known by the defendant to be dishonest according to the\nstandards of ordinary people.\n\n(4) In a prosecution for an offence against this section, the\ndetermination of dishonesty is a matter for the trier of fact."
    },
