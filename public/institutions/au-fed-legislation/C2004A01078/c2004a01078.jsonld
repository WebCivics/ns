    {
      "@id": "concept:c2004a01078-sch-3-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 Consent of the Immigration Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-3-sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a01078.pdf"
      },
      "dc:source": "c2004a01078.pdf, p.24",
      "values:originalText": "If the Attorney-General proposes to consent to the transfer to\nAustralia of a Tribunal prisoner, the Attorney-General must first\nobtain the consent of the Immigration Minister.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 4 December 2002\nSenate on 12 December 2002]\n\n(252/02)",
      "skos:definition": "If the Attorney-General proposes to consent to the transfer to\nAustralia of a Tribunal prisoner, the Attorney-General must first\nobtain the consent of the Immigration Minister.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 4 December 2002\nSenate on 12 December 2002]\n\n(252/02)",
      "cml:asserts": [
        {
          "@id": "concept:c2004a01078-sch-3-sec-57-norm"
        },
        {
          "@id": "concept:c2004a01078-sch-3-sec-57-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "35d70bd399ca472f13738290100dcefa2c4697d6e630baa84292ed4fe3e5bb0e",
      "skos:note": "Consent of the Immigration Minister required for transfer to Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-3-sec-57",
      "@type": "cof:Section",
      "cof:title": "57 Consent of the Immigration Minister",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "If the Attorney-General proposes to consent to the transfer to\nAustralia of a Tribunal prisoner, the Attorney-General must first\nobtain the consent of the Immigration Minister.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 4 December 2002\nSenate on 12 December 2002]\n\n(252/02)"
    },
