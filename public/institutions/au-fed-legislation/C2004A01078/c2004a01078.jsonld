    {
      "@id": "concept:c2004a01078-sch-3-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 The Schedule (subsection 135.2(2) of the Criminal Code)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-3-sec-7"
      },
      "cml:curationStatus": {
