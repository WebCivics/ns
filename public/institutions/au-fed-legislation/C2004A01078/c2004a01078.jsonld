      },
      "dc:source": "c2004a01078.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.",
      "cml:asserts": [
        {
          "@id": "concept:c2004a01078-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "7c3331a714a175340856fd5eafe68c12186249d586d2ac46c874546c4ade046f",
      "skos:note": "Amendment and repeal of Acts specified in Schedules"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms."
    },
