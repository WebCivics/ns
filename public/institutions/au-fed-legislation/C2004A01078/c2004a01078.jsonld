    {
      "@id": "concept:c2004a01078-sch-1-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Crimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-6"
