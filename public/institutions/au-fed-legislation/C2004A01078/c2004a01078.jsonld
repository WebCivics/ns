    {
      "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "73(3) 3  Aggravated offence of people smuggling (at least 5 people)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-73-3-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a01078.pdf"
      },
      "dc:source": "c2004a01078.pdf, p.10",
      "values:originalText": "(3) If, on a trial for an offence against subsection (1), the trier of fact is\nnot satisfied that the defendant is guilty of that offence, but is\nsatisfied beyond reasonable doubt that the defendant is guilty of an\noffence against subsection 73.1(1), the trier of fact may find the\ndefendant not guilty of an offence against subsection (1) but guilty\nof an offence against subsection 73.1(1), so long as the defendant\nhas been accorded procedural fairness in relation to that finding of\nguilt.\n\nPeople smuggling  Schedule 1\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)",
      "skos:definition": "(3) If, on a trial for an offence against subsection (1), the trier of fact is\nnot satisfied that the defendant is guilty of that offence, but is\nsatisfied beyond reasonable doubt that the defendant is guilty of an\noffence against subsection 73.1(1), the trier of fact may find the\ndefendant not guilty of an offence against subsection (1) but guilty\nof an offence against subsection 73.1(1), so long as the defendant\nhas been accorded procedural fairness in relation to that finding of\nguilt.\n\nPeople smuggling  Schedule 1\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)",
      "values:partOf": {
        "@id": "concept:c2004a01078-sch-1-sec-73-3"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-3-norm"
        },
        {
          "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "29987fdb4819f0dd0bdc32a1756f31eaea2ae6407e848b72fac393a3c70909b7",
      "skos:note": "Procedural fairness in relation to finding of guilt"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-1-sec-73-3-ss-3",
      "@type": "cof:Section",
      "cof:title": "73(3) 3  Aggravated offence of people smuggling (at least 5 people)",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(3) If, on a trial for an offence against subsection (1), the trier of fact is\nnot satisfied that the defendant is guilty of that offence, but is\nsatisfied beyond reasonable doubt that the defendant is guilty of an\noffence against subsection 73.1(1), the trier of fact may find the\ndefendant not guilty of an offence against subsection (1) but guilty\nof an offence against subsection 73.1(1), so long as the defendant\nhas been accorded procedural fairness in relation to that finding of\nguilt.\n\nPeople smuggling  Schedule 1\n\nCrimes Legislation Amendment (People Smuggling, Firearms Trafficking and Other Measures)"
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2004a01078-sch-1-sec-73-3-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
