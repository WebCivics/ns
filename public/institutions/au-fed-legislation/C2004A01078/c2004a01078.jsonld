        }
      ],
      "cml:integrityHash": "8cd435863dc4c4e6a701254631a7b241abc22fbd372537c3f235433453856a93",
      "skos:note": "A person carrying on a business in Australia of arranging for funds to be made available outside Australia."
    },
    {
