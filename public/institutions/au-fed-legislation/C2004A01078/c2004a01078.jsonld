      ],
      "cml:integrityHash": "bf1ff81ad3b5eafb0d18c9c75fe8a953a8cf2eb80f0efed61a66b9a3e446d3d0",
      "skos:note": "Obtaining financial advantage from Commonwealth entity for ineligible person"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a01078#sch-3-sec-7-ss-2",
      "@type": "cof:Section",
      "cof:title": "7(2) The Schedule (subsection 135.2(2) of the Criminal Code)",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(2) A person is guilty of an offence if:\n\n(a) the person obtains a financial advantage for another person\nfrom a third person, knowing or believing that the other\nperson is not eligible to receive that financial advantage; and\n\n(b) the third person is a Commonwealth entity.\nPenalty: Imprisonment for 12 months."
    },
    {
      "@id": "concept:c2004a01078-sch-3-sec-7-ss-2-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2004a01078-sch-3-sec-7-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2004a01078-sch-3-sec-7-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits obtaining financial advantage from Commonwealth entity for ineligible person",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the person obtains a financial advantage for another person\nfrom a third person, knowing or believing that the other\nperson is not eligible to receive that financial advantage;",
      "cml:conclusionText": "Imprisonment for 12 months."
    },
    {
      "@id": "concept:c2004a01078-sch-3-sec-7-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
