    {
      "@id": "concept:australian-capital-territory-legislation-amendment-act-2003-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 16(9)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-legislation-amendment-act-2003#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-legislation-amendment-act-2003.pdf"
      },
      "dc:source": "australian-capital-territory-legislation-amendment-act-2003.pdf, p.7",
      "values:originalText": "Repeal the subsection, substitute:\n\n(9) A person holding office, or acting as, Chief Executive of the Chief\nMinister’s Department must not be appointed as a Commissioner\nunder this section.\n\n(10) If the name of the office of Chief Executive, or of the Chief\nMinister’s Department, is changed, a reference in subsection (9) to\nthat office or Department is to be taken to be a reference to the\noffice or Department under the new name.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(9) A person holding office, or acting as, Chief Executive of the Chief\nMinister’s Department must not be appointed as a Commissioner\nunder this section.\n\n(10) If the name of the office of Chief Executive, or of the Chief\nMinister’s Department, is changed, a reference in subsection (9) to\nthat office or Department is to be taken to be a reference to the\noffice or Department under the new name.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-legislation-amendment-act-2003-sch-1-sec-1-ss-9"
        },
        {
          "@id": "concept:australian-capital-territory-legislation-amendment-act-2003-sch-1-sec-1-ss-10"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-legislation-amendment-act-2003#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 16(9)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the subsection, substitute:\n\n(9) A person holding office, or acting as, Chief Executive of the Chief\nMinister’s Department must not be appointed as a Commissioner\nunder this section.\n\n(10) If the name of the office of Chief Executive, or of the Chief\nMinister’s Department, is changed, a reference in subsection (9) to\nthat office or Department is to be taken to be a reference to the\noffice or Department under the new name."
    },
