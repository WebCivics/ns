      },
      "dc:source": "australian-capital-territory-legislation-amendment-act-2003.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAustralian Capital Territory (Self-Government) Act 1988  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAustralian Capital Territory (Self-Government) Act 1988  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-legislation-amendment-act-2003-sec-3-norm"
        },
        {
          "@id": "concept:australian-capital-territory-legislation-amendment-act-2003-sec-3-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "b88dcf8d3adaa8cd7eaa433c5b7ea4f7dc23003f11dca416c6911df485563345",
      "skos:note": "Schedules governing amendments and repeals of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-legislation-amendment-act-2003#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAustralian Capital Territory (Self-Government) Act 1988  Schedule 1"
    },
