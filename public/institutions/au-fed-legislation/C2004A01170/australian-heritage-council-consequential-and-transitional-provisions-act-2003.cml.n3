concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-12 a cml:Concept ;
    skos:prefLabel "12 Subparagraphs 27(7)(d)(i) and (ii) of Schedule 3"@en ;
    cml:realizedBy doc:sch-1-sec-12 ;
