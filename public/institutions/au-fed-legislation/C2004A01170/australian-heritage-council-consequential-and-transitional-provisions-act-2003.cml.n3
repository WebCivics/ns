concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-1 a cml:Concept ;
    skos:prefLabel "1 Meaning of Australian Heritage Commission"@en ;
    cml:realizedBy doc:sch-2-sec-1 ;
    values:originalText "In this Schedule: Australian Heritage Commission means the body established by section 6 of the Australian Heritage Commission Act 1975 as in force immediately before this Schedule commences." ;
    skos:definition "In this Schedule: Australian Heritage Commission means the body established by section 6 of the Australian Heritage Commission Act 1975 as in force immediately before this Schedule commences."@en ;
