concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-9 a cml:Concept ;
    skos:prefLabel "9 Final report on operations of the Australian Heritage"@en ;
    cml:realizedBy doc:sch-2-sec-9 ;
    values:originalText "Commission The first report under section 516 of the Environment Protection and Biodiversity Conservation Act 1999 given after this Schedule commences must include a report on the operations of the Australian Heritage Commission during the period:  (a) starting on the last 1 July before this Schedule commences; and  (b) ending when this Schedule commences." ;
    skos:definition "Commission The first report under section 516 of the Environment Protection and Biodiversity Conservation Act 1999 given after this Schedule commences must include a report on the operations of the Australian Heritage Commission during the period:  (a) starting on the last 1 July before this Schedule commences; and  (b) ending when this Schedule commences."@en ;
    cml:integrityHash "31cc769e65aab016edd2c62c60690ecd36102cb2fa8a1df1fc7e6fea504aee08" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Commission must include a report on operations of the Australian Heritage Commission." ;
    cml:curationStatus cml:Proposed ;
