      },
      "cml:premiseText": "land registration official, in relation to land, means...",
      "cml:conclusionText": "...the Registrar of Titles or other proper officer of the State or Territory in which the land is situated."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Land registration official's discretion",
      "cml:executionSurface": "modalities::logic::deontic",
