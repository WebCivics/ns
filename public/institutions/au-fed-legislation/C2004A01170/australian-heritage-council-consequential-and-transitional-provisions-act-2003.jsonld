    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-4-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Australian Heritage Council (Consequential and Transitional Provisions) Act 2003",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-1-sec-4-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.8",
      "values:originalText": "No. 86, 2003\n\nA gift of a place included\nin:\n(a) the National\nHeritage List, or the\nCommonwealth\nHeritage List, under\nthe Environment\nProtection and\nBiodiversity\nConservation Act\n1999; or\n(b) the Register of the\nNational Estate\nunder the Australian\nHeritage Council\nAct 2003.",
      "skos:definition": "No. 86, 2003\n\nA gift of a place included\nin:\n(a) the National\nHeritage List, or the\nCommonwealth\nHeritage List, under\nthe Environment\nProtection and\nBiodiversity\nConservation Act\n1999; or\n(b) the Register of the\nNational Estate\nunder the Australian\nHeritage Council\nAct 2003.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-4-2-norm"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-4-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "23c7bd3d618abaa8b24df47ecb3db648f51600ae519f0d6b45b0ad23ea520f6f",
      "skos:note": "Gift of a place included in certain heritage lists is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-1-sec-4-2",
      "@type": "cof:Section",
      "cof:title": "4 Australian Heritage Council (Consequential and Transitional Provisions) Act 2003",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "No. 86, 2003\n\nA gift of a place included\nin:\n(a) the National\nHeritage List, or the\nCommonwealth\nHeritage List, under\nthe Environment\nProtection and\nBiodiversity\nConservation Act\n1999; or\n(b) the Register of the\nNational Estate\nunder the Australian\nHeritage Council\nAct 2003."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-4-2-norm",
