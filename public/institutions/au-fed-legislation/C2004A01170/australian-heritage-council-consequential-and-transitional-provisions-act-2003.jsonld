      }
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.12",
      "values:originalText": "(1)\nThe Governor-General may make regulations prescribing matters:\n\nTransitional provisions  Schedule 2\n\n2003            9\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n(2)\nIn particular, the regulations may prescribe arrangements to deal with\nany issues of a transitional nature that may arise as a result of the repeal\nby this Act of the Australian Heritage Commission Act 1975.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 27 June 2002\nSenate on 15 November 2002]\n\n(151/02)",
      "skos:definition": "(1)\nThe Governor-General may make regulations prescribing matters:\n\nTransitional provisions  Schedule 2\n\n2003            9\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n(2)\nIn particular, the regulations may prescribe arrangements to deal with\nany issues of a transitional nature that may arise as a result of the repeal\nby this Act of the Australian Heritage Commission Act 1975.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 27 June 2002\nSenate on 15 November 2002]\n\n(151/02)",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-10-norm"
        }
      ],
      "cml:integrityHash": "dad4f4855d95600a25b650b8792cd725dd40dd20e01414b798f63c13d2abbab2",
      "skos:note": "Governor-General may make regulations"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Regulations",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "(1)\nThe Governor-General may make regulations prescribing matters:\n\nTransitional provisions  Schedule 2\n\n2003            9\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n(2)\nIn particular, the regulations may prescribe arrangements to deal with\nany issues of a transitional nature that may arise as a result of the repeal\nby this Act of the Australian Heritage Commission Act 1975.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 27 June 2002\nSenate on 15 November 2002]\n\n(151/02)"
    },
