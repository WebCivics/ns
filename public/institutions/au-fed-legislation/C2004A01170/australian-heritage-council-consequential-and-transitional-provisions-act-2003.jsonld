      },
      "cml:premiseText": "The text mentions specific commencement dates.",
      "cml:conclusionText": "The applicability clause involves two temporal intervals: before and after the specified dates."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Classifies the deontic type of the provision as Undertaking.",
