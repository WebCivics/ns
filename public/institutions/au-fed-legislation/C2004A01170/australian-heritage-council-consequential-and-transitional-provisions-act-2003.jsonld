      },
      "cml:premiseText": "The text describes a condition or circumstance under which the amendment applies.",
      "cml:conclusionText": "The provision is an undertaking that specifies when the amendment takes effect."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Identifies the argument underlying the applicability clause.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The text presents a logical connection between the commencement dates and the applicability of the amendment.",
      "cml:conclusionText": "The argument is that the amendment applies to gifts made after specific commencement dates."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-logic-n3logic-4",
