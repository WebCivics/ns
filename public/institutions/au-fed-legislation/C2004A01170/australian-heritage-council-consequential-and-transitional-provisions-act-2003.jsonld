    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Evidence on heritage values of a place",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-1-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.9",
      "values:originalText": "If a matter relating to heritage values of a place (within the\nmeaning of the Environment Protection and Biodiversity\nConservation Act 1999) is relevant to an inquiry:\n\n(a) the Secretary of the Department that administers that Act; or\n\n(b) an employee in that Department authorised in writing by the\nSecretary for the purposes of this section;\nmust give evidence about the matter to the inquiry.\nTelecommunications Act 1997",
      "skos:definition": "If a matter relating to heritage values of a place (within the\nmeaning of the Environment Protection and Biodiversity\nConservation Act 1999) is relevant to an inquiry:\n\n(a) the Secretary of the Department that administers that Act; or\n\n(b) an employee in that Department authorised in writing by the\nSecretary for the purposes of this section;\nmust give evidence about the matter to the inquiry.\nTelecommunications Act 1997",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-31-norm"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-31-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c0fe0377ef5bc6d713a045a166f94f8f785a14ac5741dea2e30023aedf519bad",
      "skos:note": "Secretary of Department must provide evidence about heritage values.",
      "dc:description": "true",
      "dc:references": [
        "Telecommunications Act 1997"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-1-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Evidence on heritage values of a place",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "If a matter relating to heritage values of a place (within the\nmeaning of the Environment Protection and Biodiversity\nConservation Act 1999) is relevant to an inquiry:\n\n(a) the Secretary of the Department that administers that Act; or\n\n(b) an employee in that Department authorised in writing by the\nSecretary for the purposes of this section;\nmust give evidence about the matter to the inquiry.\nTelecommunications Act 1997"
    },
    {
