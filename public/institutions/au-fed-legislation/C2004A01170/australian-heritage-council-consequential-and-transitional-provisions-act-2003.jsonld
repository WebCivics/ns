    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Meaning of Australian Heritage Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.10",
      "values:originalText": "In this Schedule:\nAustralian Heritage Commission means the body established by\nsection 6 of the Australian Heritage Commission Act 1975 as in force\nimmediately before this Schedule commences.",
      "skos:definition": "In this Schedule:\nAustralian Heritage Commission means the body established by\nsection 6 of the Australian Heritage Commission Act 1975 as in force\nimmediately before this Schedule commences.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-1-norm"
        }
      ],
      "cml:integrityHash": "80e0c5e643655471bb88d4f481a9daf7d5ff2090d18e4daeda11e5bd65fac49e",
      "skos:note": "Defines Australian Heritage Commission"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Meaning of Australian Heritage Commission",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "In this Schedule:\nAustralian Heritage Commission means the body established by\nsection 6 of the Australian Heritage Commission Act 1975 as in force\nimmediately before this Schedule commences."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-1-norm",
      "@type": "values:Obligation",
