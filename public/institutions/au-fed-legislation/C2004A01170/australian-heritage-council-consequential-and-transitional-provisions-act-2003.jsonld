    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Australian Heritage Council (Consequential and Transitional Provisions) Act 2003",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.12",
      "values:originalText": "No. 86, 2003\n(4)\nIn this item:\nassets official means the person or authority who, under a law of the\nCommonwealth, a State or a Territory, under a trust instrument or\notherwise, has responsibility for keeping a register in relation to assets\nof the kind concerned.",
      "skos:definition": "No. 86, 2003\n(4)\nIn this item:\nassets official means the person or authority who, under a law of the\nCommonwealth, a State or a Territory, under a trust instrument or\notherwise, has responsibility for keeping a register in relation to assets\nof the kind concerned.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-8-norm"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-8-logic-deontic-1"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-8-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "5cfcec846320a260cda22c505ad1832bc71fa8720807a916e71d87ea008d2456",
      "skos:note": "Definition of 'assets official'"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Australian Heritage Council (Consequential and Transitional Provisions) Act 2003",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "No. 86, 2003\n(4)\nIn this item:\nassets official means the person or authority who, under a law of the\nCommonwealth, a State or a Territory, under a trust instrument or\notherwise, has responsibility for keeping a register in relation to assets\nof the kind concerned."
    },
