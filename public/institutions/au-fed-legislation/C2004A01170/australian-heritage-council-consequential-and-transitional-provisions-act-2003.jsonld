      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nRepeals and amendments  Schedule 1\n\n2003            3",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nRepeals and amendments  Schedule 1\n\n2003            3",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sec-3-norm"
        }
      ],
      "cml:integrityHash": "326938689589aabe254dc1b7b50baa5415f1e6ea8ef67417e3eb3529a3107436",
      "skos:note": "Schedules for amendments and repeals"
    },
