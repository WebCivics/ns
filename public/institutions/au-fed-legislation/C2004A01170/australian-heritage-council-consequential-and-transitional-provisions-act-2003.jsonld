    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Exemption from stamp duty and other taxes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.12",
      "values:originalText": "Stamp duty or other tax is not payable under a law of a State or\nTerritory in respect of:\n\n(a) the transfer of an asset or liability under this Schedule; or\n\n(b) anything done (including a transaction entered into or an\ninstrument or document made, executed, lodged or given)\nbecause of such a transfer, or for a purpose connected with or\narising out of such a transfer.",
      "skos:definition": "Stamp duty or other tax is not payable under a law of a State or\nTerritory in respect of:\n\n(a) the transfer of an asset or liability under this Schedule; or\n\n(b) anything done (including a transaction entered into or an\ninstrument or document made, executed, lodged or given)\nbecause of such a transfer, or for a purpose connected with or\narising out of such a transfer.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-7-norm"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c150ba2d6ca0553d6f69278fdafb485aef854a699498ede1154cc7eed2fec84b",
      "skos:note": "Exemption from stamp duty and other taxes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Exemption from stamp duty and other taxes",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Stamp duty or other tax is not payable under a law of a State or\nTerritory in respect of:\n\n(a) the transfer of an asset or liability under this Schedule; or\n\n(b) anything done (including a transaction entered into or an\ninstrument or document made, executed, lodged or given)\nbecause of such a transfer, or for a purpose connected with or\narising out of such a transfer."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-7-norm",
      "@type": "values:Obligation",
