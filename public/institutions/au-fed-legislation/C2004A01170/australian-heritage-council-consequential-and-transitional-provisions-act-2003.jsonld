      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Expresses the applicability clause in a formal, logical notation.",
      "cml:executionSurface": "modalities::logic::n3_compiler",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
