    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Application of amendment of section 30-15",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-1-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.8",
      "values:originalText": "The amendment of section 30-15 of the Income Tax Assessment Act\n1997 applies to gifts made after the commencement of Divisions 1A\nand 3A of Part 15 of the Environment Protection and Biodiversity\nConservation Act 1999 and Part 5 of the Australian Heritage Council\nAct 2003.",
      "skos:definition": "The amendment of section 30-15 of the Income Tax Assessment Act\n1997 applies to gifts made after the commencement of Divisions 1A\nand 3A of Part 15 of the Environment Protection and Biodiversity\nConservation Act 1999 and Part 5 of the Australian Heritage Council\nAct 2003.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-norm"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-logic-alleninterval-1"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-logic-deontic-2"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-logic-argumentation-3"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-logic-n3logic-4"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "8a0ec8151940bdaab74a9333e8e567277370938d41b0b01388126902508a06eb",
      "skos:note": "Applicability of amendment to gifts made after specific commencement dates."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Application of amendment of section 30-15",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "The amendment of section 30-15 of the Income Tax Assessment Act\n1997 applies to gifts made after the commencement of Divisions 1A\nand 3A of Part 15 of the Environment Protection and Biodiversity\nConservation Act 1999 and Part 5 of the Australian Heritage Council\nAct 2003."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-1-sec-5-norm",
