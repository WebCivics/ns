      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Assets and liabilities of the Australian Heritage",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.10",
      "values:originalText": "Commission\n(1)\nWhen this Schedule commences, any rights, property or assets that,\nimmediately before that time, were vested in the Australian Heritage\nCommission are vested in the Commonwealth.\n(2)\nWhen this Schedule commences, the Commonwealth becomes liable to\npay and discharge any debts, liabilities or obligations of the Australian\nHeritage Commission that existed immediately before that time.",
      "skos:definition": "Commission\n(1)\nWhen this Schedule commences, any rights, property or assets that,\nimmediately before that time, were vested in the Australian Heritage\nCommission are vested in the Commonwealth.\n(2)\nWhen this Schedule commences, the Commonwealth becomes liable to\npay and discharge any debts, liabilities or obligations of the Australian\nHeritage Commission that existed immediately before that time.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-3-norm"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-3-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "16156ec1cef88b48948a5f609e78913b48e2892ad81d468a6cede5e5eabba103",
      "skos:note": "Vesting of rights, property and assets; liability for debts and obligations"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Assets and liabilities of the Australian Heritage",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Commission\n(1)\nWhen this Schedule commences, any rights, property or assets that,\nimmediately before that time, were vested in the Australian Heritage\nCommission are vested in the Commonwealth.\n(2)\nWhen this Schedule commences, the Commonwealth becomes liable to\npay and discharge any debts, liabilities or obligations of the Australian\nHeritage Commission that existed immediately before that time."
    },
