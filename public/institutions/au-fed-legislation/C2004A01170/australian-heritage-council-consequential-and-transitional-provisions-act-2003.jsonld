    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Final report on operations of the Australian Heritage",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.12",
      "values:originalText": "Commission\nThe first report under section 516 of the Environment Protection and\nBiodiversity Conservation Act 1999 given after this Schedule\ncommences must include a report on the operations of the Australian\nHeritage Commission during the period:\n\n(a) starting on the last 1 July before this Schedule commences;\nand\n\n(b) ending when this Schedule commences.",
      "skos:definition": "Commission\nThe first report under section 516 of the Environment Protection and\nBiodiversity Conservation Act 1999 given after this Schedule\ncommences must include a report on the operations of the Australian\nHeritage Commission during the period:\n\n(a) starting on the last 1 July before this Schedule commences;\nand\n\n(b) ending when this Schedule commences.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-9-norm"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "31cc769e65aab016edd2c62c60690ecd36102cb2fa8a1df1fc7e6fea504aee08",
      "skos:note": "Commission must include a report on operations of the Australian Heritage Commission."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Final report on operations of the Australian Heritage",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Commission\nThe first report under section 516 of the Environment Protection and\nBiodiversity Conservation Act 1999 given after this Schedule\ncommences must include a report on the operations of the Australian\nHeritage Commission during the period:\n\n(a) starting on the last 1 July before this Schedule commences;\nand\n\n(b) ending when this Schedule commences."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-9-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-9"
      },
      "values:deonticStatus": {
