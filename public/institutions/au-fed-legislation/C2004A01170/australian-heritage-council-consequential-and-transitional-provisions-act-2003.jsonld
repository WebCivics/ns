    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-8-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Pending proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-8-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-consequential-and-transitional-provisions-act-2003.pdf, p.12",
      "values:originalText": "If proceedings to which the Australian Heritage Commission is a party\nare pending in any court immediately before this Schedule commences,\nthe Commonwealth is substituted for the Australian Heritage\nCommission, when this Schedule commences, as a party to the\nproceedings.",
      "skos:definition": "If proceedings to which the Australian Heritage Commission is a party\nare pending in any court immediately before this Schedule commences,\nthe Commonwealth is substituted for the Australian Heritage\nCommission, when this Schedule commences, as a party to the\nproceedings.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-8-2-norm"
        },
        {
          "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-8-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dcbb923fcf606aed7f74c73c8e2b6766dbdfe2f4f07c61adb1409856b55c3379",
      "skos:note": "Substitution of Commonwealth as party to proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-consequential-and-transitional-provisions-act-2003#sch-2-sec-8-2",
      "@type": "cof:Section",
      "cof:title": "8 Pending proceedings",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "If proceedings to which the Australian Heritage Commission is a party\nare pending in any court immediately before this Schedule commences,\nthe Commonwealth is substituted for the Australian Heritage\nCommission, when this Schedule commences, as a party to the\nproceedings."
    },
    {
      "@id": "concept:australian-heritage-council-consequential-and-transitional-provisions-act-2003-sch-2-sec-8-2-norm",
      "@type": "values:Undertaking",
