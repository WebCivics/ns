doc:sec-6-ss-1 a cof:Section ;
    cof:title "6(1) Section 6" ;
    values:kind "subsection" ;
    values:originalText "(1) (c)” and substituting the words “in paragraph (1) (b), other than representative Commissioners ”; (c) by omitting from paragraph (a) of sub-section (5) the words “in the several States and in the Northern Territory” and substitut­ ing the words “in different parts of Australia ”; and (d) by omitting sub-section (6)." ;
    cof:pageNumber "2"^^xsd:integer .

concept:australian-heritage-commission-short-title-amendment-act-1976-sec-6-ss-2 a cml:Concept ;
    skos:prefLabel "6(2) Section 6"@en ;
    cml:realizedBy doc:sec-6-ss-2 ;
    values:originalText "(2) The person who was, immediately before the commencement of this Act, the Chairman of the Commission continues to be the Chairman of the Commission as if he had been appointed as the Chairman under the Principal Act as amended by this Act and holds office, subject to the Principal Act as amended by this Act, for the remainder of the period of his appointment under the Principal Act." ;
    skos:definition "(2) The person who was, immediately before the commencement of this Act, the Chairman of the Commission continues to be the Chairman of the Commission as if he had been appointed as the Chairman under the Principal Act as amended by this Act and holds office, subject to the Principal Act as amended by this Act, for the remainder of the period of his appointment under the Principal Act."@en ;
    cml:integrityHash "41aa7208cb0a57aee239244eb8d0e8d71dd7168dc3a8953558c260ba11f267fe" ;
    values:partOf concept:australian-heritage-commission-short-title-amendment-act-1976-sec-6 ;
    cof:pageNumber "2"^^xsd:integer ;
    skos:note "Continuation of Chairman's office upon commencement of Act" ;
