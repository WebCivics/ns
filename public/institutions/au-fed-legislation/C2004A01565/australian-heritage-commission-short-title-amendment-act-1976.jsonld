      "dc:source": "australian-heritage-commission-short-title-amendment-act-1976.pdf, p.3",
      "values:originalText": "The following provisions of the Principal Act are amended by omitting the word “Australia”\n(wherever occurring) and substituting the words “the Commonwealth ’ —\nSection 3(1) (definition of “authority of Australia”), 9, 12 (3), (7), (8) and (9), 17 (2), 30, 33\nand 42.",
      "skos:definition": "The following provisions of the Principal Act are amended by omitting the word “Australia”\n(wherever occurring) and substituting the words “the Commonwealth ’ —\nSection 3(1) (definition of “authority of Australia”), 9, 12 (3), (7), (8) and (9), 17 (2), 30, 33\nand 42.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-commission-short-title-amendment-act-1976-sec-1-norm"
        }
      ],
      "cml:integrityHash": "91030a46ff9f493225c7dd2874066f5cfc2512103daff73e8b6d721571b158f1",
      "skos:note": "Amendments to certain sections of the Principal Act"
    },
