    {
      "@id": "concept:australian-heritage-commission-short-title-amendment-act-1976-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Section 5",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-commission-short-title-amendment-act-1976#sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
