      },
      "cml:operator": "requires",
      "cml:premiseText": "(iii) in a case where paragraph (a) of that sub-section as so in force did not apply immediately before that commencement—either, but not both, of paragraphs (b) and (c) of that sub-section as so in force;"
    },
    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4-logic-deontic-4",
