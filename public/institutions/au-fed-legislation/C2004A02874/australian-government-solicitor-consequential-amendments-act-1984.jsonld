    },
    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "applies",
      "cml:logicSummary": "The obligation is triggered by the debtor's non-compliance with the notice.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the debtor has not made sufficient compliance with the notice for the purposes of that Act,",
      "cml:conclusionText": "sub-section 42 (1) of that Act applies in relation to the notice after that commencement."
    },
    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(3) Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-4-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-government-solicitor-consequential-amendments-act-1984.pdf"
      },
      "dc:source": "australian-government-solicitor-consequential-amendments-act-1984.pdf, p.2",
      "values:originalText": "(3) Where, at the time (in this sub-section referred to as the \"relevant\ntime\") when the amendment of the Crimes Act 1914 made by this Act comes\ninto operation—\n(a) an application has been made as mentioned in sub-section 20AA (6) of\nthat Act, being that sub-section as in force at any time before the\nrelevant time; and\n(b) notice in relation to the application has been served neither on the\nDirector of Public Prosecutions nor on the Deputy Crown Solicitor in\nthe State or Territory in which the application was made,\nthat sub-section, as amended by this Act, applies after the relevant time in\nrelation to the application.",
      "skos:definition": "(3) Where, at the time (in this sub-section referred to as the \"relevant\ntime\") when the amendment of the Crimes Act 1914 made by this Act comes\ninto operation—\n(a) an application has been made as mentioned in sub-section 20AA (6) of\nthat Act, being that sub-section as in force at any time before the\nrelevant time; and\n(b) notice in relation to the application has been served neither on the\nDirector of Public Prosecutions nor on the Deputy Crown Solicitor in\nthe State or Territory in which the application was made,\nthat sub-section, as amended by this Act, applies after the relevant time in\nrelation to the application.",
      "values:partOf": {
        "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-3-norm"
        },
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "66e0b094bbca2d3002bf10e2af573f34d37a0f206076633ddf7ed070c0a82e13",
      "skos:note": "Notice must be served on Director of Public Prosecutions and Deputy Crown Solicitor."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-4-ss-3",
      "@type": "cof:Section",
      "cof:title": "4(3) Section 4",
      "values:kind": "subsection",
      "cof:pageNumber": 2,
      "values:originalText": "(3) Where, at the time (in this sub-section referred to as the \"relevant\ntime\") when the amendment of the Crimes Act 1914 made by this Act comes\ninto operation—\n(a) an application has been made as mentioned in sub-section 20AA (6) of\nthat Act, being that sub-section as in force at any time before the\nrelevant time; and\n(b) notice in relation to the application has been served neither on the\nDirector of Public Prosecutions nor on the Deputy Crown Solicitor in\nthe State or Territory in which the application was made,\nthat sub-section, as amended by this Act, applies after the relevant time in\nrelation to the application."
    },
    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
