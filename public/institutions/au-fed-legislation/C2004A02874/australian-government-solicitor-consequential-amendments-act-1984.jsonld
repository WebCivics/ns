        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide notice to Director of Public Prosecutions and Deputy Crown Solicitor.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(4) Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-4-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-government-solicitor-consequential-amendments-act-1984.pdf"
      },
      "dc:source": "australian-government-solicitor-consequential-amendments-act-1984.pdf, p.2",
      "values:originalText": "(4) Where, at the commencement of this section—\n(a) an amount of compensation to which a person is entitled under section\n11 of the Lands Acquisition\nAct 1955 has been determined; and\n\nAustralian Government Solicitor (Consequential\nAmendments)\nNo. 10,1984\n(b) the person has, in relation to the compensation, complied with—\n(i) none of the paragraphs of sub-section 32 (1) of that Act,\nbeing that sub-section as in force immediately before that\ncommencement;\n(ii) in a case where paragraph (a) of that sub-section as so in force\napplied immediately before that commencement—one or more,\nbut not all, of the paragraphs of that sub-section as so in force;\nor\n(iii) in a case where paragraph (a) of that sub-section as so in force\ndid not apply immediately before that commencement—either,\nbut not both, of paragraphs (b) and (c) of that sub-section as so\nin force,\nsub-section 32 (1) of that Act as so in force applies after that commencement in\nrelation to the person in relation to the compensation and so applies, in a case\nwhere sub-paragraph (b) (ii) or (iii) of this sub-section applies, as if a reference\nto the Crown Solicitor in the paragraph, or in each paragraph, of sub-section\n32 (1) of that Act as so in force with which the person has not complied at that\ncommencement were a reference to the Secretary to the Attorney-General's\nDepartment or to a person authorized under sub-section 55E (4) of the\nJudiciary Act 1903.",
      "skos:definition": "(4) Where, at the commencement of this section—\n(a) an amount of compensation to which a person is entitled under section\n11 of the Lands Acquisition\nAct 1955 has been determined; and\n\nAustralian Government Solicitor (Consequential\nAmendments)\nNo. 10,1984\n(b) the person has, in relation to the compensation, complied with—\n(i) none of the paragraphs of sub-section 32 (1) of that Act,\nbeing that sub-section as in force immediately before that\ncommencement;\n(ii) in a case where paragraph (a) of that sub-section as so in force\napplied immediately before that commencement—one or more,\nbut not all, of the paragraphs of that sub-section as so in force;\nor\n(iii) in a case where paragraph (a) of that sub-section as so in force\ndid not apply immediately before that commencement—either,\nbut not both, of paragraphs (b) and (c) of that sub-section as so\nin force,\nsub-section 32 (1) of that Act as so in force applies after that commencement in\nrelation to the person in relation to the compensation and so applies, in a case\nwhere sub-paragraph (b) (ii) or (iii) of this sub-section applies, as if a reference\nto the Crown Solicitor in the paragraph, or in each paragraph, of sub-section\n32 (1) of that Act as so in force with which the person has not complied at that\ncommencement were a reference to the Secretary to the Attorney-General's\nDepartment or to a person authorized under sub-section 55E (4) of the\nJudiciary Act 1903.",
      "values:partOf": {
        "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4-norm"
        },
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4-logic-deontic-2"
        },
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4-logic-deontic-3"
        },
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4-logic-deontic-4"
        },
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4-logic-deontic-5"
        },
        {
          "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-4-logic-deontic-6"
        }
      ],
      "cml:integrityHash": "e7c86ea4f54ec040f98f7ba2b5e726c3c7cfb159172178349f160e93d9477776",
      "skos:note": "Compliance with certain paragraphs of sub-section 32 (1) of the Lands Acquisition Act 1955 is required."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-4-ss-4",
      "@type": "cof:Section",
      "cof:title": "4(4) Section 4",
      "values:kind": "subsection",
      "cof:pageNumber": 2,
      "values:originalText": "(4) Where, at the commencement of this section—\n(a) an amount of compensation to which a person is entitled under section\n11 of the Lands Acquisition\nAct 1955 has been determined; and\n\nAustralian Government Solicitor (Consequential\nAmendments)\nNo. 10,1984\n(b) the person has, in relation to the compensation, complied with—\n(i) none of the paragraphs of sub-section 32 (1) of that Act,\nbeing that sub-section as in force immediately before that\ncommencement;\n(ii) in a case where paragraph (a) of that sub-section as so in force\napplied immediately before that commencement—one or more,\nbut not all, of the paragraphs of that sub-section as so in force;\nor\n(iii) in a case where paragraph (a) of that sub-section as so in force\ndid not apply immediately before that commencement—either,\nbut not both, of paragraphs (b) and (c) of that sub-section as so\nin force,\nsub-section 32 (1) of that Act as so in force applies after that commencement in\nrelation to the person in relation to the compensation and so applies, in a case\nwhere sub-paragraph (b) (ii) or (iii) of this sub-section applies, as if a reference\nto the Crown Solicitor in the paragraph, or in each paragraph, of sub-section\n32 (1) of that Act as so in force with which the person has not complied at that\ncommencement were a reference to the Secretary to the Attorney-General's\nDepartment or to a person authorized under sub-section 55E (4) of the\nJudiciary Act 1903."
    },
