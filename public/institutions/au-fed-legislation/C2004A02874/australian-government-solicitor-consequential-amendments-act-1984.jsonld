      "cml:integrityHash": "10446341030b7781ff84dceee25c69825377285977b62b09fa0c7a2737d99f2a",
      "skos:note": "Authorized person under sub-section 55E (4) of the Judiciary Act 1903 or an officer of the Attorney-General's Department authorized in writing by the Secretary to represent the Director in relevant proceedings."
    },
