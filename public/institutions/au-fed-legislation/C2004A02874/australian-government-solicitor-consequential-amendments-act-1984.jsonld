      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-1903",
      "@type": "cml:Concept",
      "skos:prefLabel": "1903 \".",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-1903"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
