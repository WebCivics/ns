      "skos:note": "Application of certain amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Section 3",
      "values:kind": "section",
      "cof:pageNumber": 2,
      "values:originalText": "The Acts specified in the Schedule are amended as set out in that\nSchedule.\nApplication of certain amendments"
    },
    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-3-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
