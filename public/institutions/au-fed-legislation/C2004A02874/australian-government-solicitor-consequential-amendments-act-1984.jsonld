        }
      ],
      "cml:integrityHash": "df2a987bddaa957a284ae3a9b863e2a9edc966253d13fd7770133c5fdb44c74e",
      "skos:note": "Conditional commencement of section 34 of the Lands Acquisition Act 1955"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-4-ss-5",
      "@type": "cof:Section",
      "cof:title": "4(5) Section 4",
      "values:kind": "subsection",
      "cof:pageNumber": 2,
      "values:originalText": "(5) Where, at the commencement of this section, an amount of\ncompensation has been deposited in the Treasury under sub-section 33 (1) of\nthe Lands Acquisition\nAct 1955 and has not been paid to a person under\nsection 34 of that Act, being that section as in force at any time before that\ncommencement, that section, as amended by this Act, applies after that\ncommencement in relation to the amount."
    },
    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-5-norm",
