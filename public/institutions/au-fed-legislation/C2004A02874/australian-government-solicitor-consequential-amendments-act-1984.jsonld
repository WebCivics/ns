      "cml:logicSummary": "The obligation is triggered by the commencement of the section.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Where, at the commencement of this section—",
      "cml:conclusionText": "sub-section 42 (1) of that Act applies in relation to the notice after that commencement."
    },
    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
