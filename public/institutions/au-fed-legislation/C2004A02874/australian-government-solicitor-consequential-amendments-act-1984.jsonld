    {
      "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "4(5) Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-4-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-government-solicitor-consequential-amendments-act-1984.pdf"
      },
      "dc:source": "australian-government-solicitor-consequential-amendments-act-1984.pdf, p.2",
      "values:originalText": "(5) Where, at the commencement of this section, an amount of\ncompensation has been deposited in the Treasury under sub-section 33 (1) of\nthe Lands Acquisition\nAct 1955 and has not been paid to a person under\nsection 34 of that Act, being that section as in force at any time before that\ncommencement, that section, as amended by this Act, applies after that\ncommencement in relation to the amount.",
      "skos:definition": "(5) Where, at the commencement of this section, an amount of\ncompensation has been deposited in the Treasury under sub-section 33 (1) of\nthe Lands Acquisition\nAct 1955 and has not been paid to a person under\nsection 34 of that Act, being that section as in force at any time before that\ncommencement, that section, as amended by this Act, applies after that\ncommencement in relation to the amount.",
      "values:partOf": {
        "@id": "concept:australian-government-solicitor-consequential-amendments-act-1984-sec-4"
      },
      "cml:asserts": [
        {
