      "cml:integrityHash": "29711ccffdee7d5c311b53a1146d8cf175fd3cd9decd88840cdb334880d5e32e",
      "skos:note": "Section 58 of the Lands Acquisition Act 1955 applies after commencement in relation to land acquired under that Act by compulsory process."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-government-solicitor-consequential-amendments-act-1984#sec-4-ss-6",
