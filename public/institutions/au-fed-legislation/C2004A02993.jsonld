    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-10",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-amendment-act-1984.pdf, p.8",
      "skos:note": "A person adopted by an Australian citizen or jointly by two persons at least one of whom is an Australian citizen shall be an Australian citizen.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "10 Section 10"
      },
      "wasDerivedFrom": "australian-citizenship-amendment-act-1984.pdf",
      "asserts": [
        "concept:australian-citizenship-amendment-act-1984-sec-10-norm",
        "concept:australian-citizenship-amendment-act-1984-sec-10-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "9490c992574e659931114a9cf4d4d294120abddc48a381879aceba40711ae5ed",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-citizenship-amendment-act-1984#sec-10",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-10-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Implies that the person is an Australian citizen if adopted by an Australian citizen or jointly by two persons at least one of whom is an Australian citizen",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies"
    },
