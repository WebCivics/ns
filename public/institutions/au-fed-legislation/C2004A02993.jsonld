    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-5",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-amendment-act-1984.pdf, p.6",
      "skos:note": "A person who is not an Australian citizen shall be taken to be, or to have been, a permanent resident for the purposes of this Act.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "5 Section 5"
      },
