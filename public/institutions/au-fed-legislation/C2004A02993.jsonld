    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-15",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-amendment-act-1984.pdf, p.15",
      "skos:note": "A person who is an Australian citizen by virtue of a certificate of Australian citizenship cannot have been convicted of certain offences.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15 Section 15"
      },
      "wasDerivedFrom": "australian-citizenship-amendment-act-1984.pdf",
      "asserts": [
