    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-16",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-amendment-act-1984.pdf, p.16",
      "skos:note": "Amendments to Section 23 of the Principal Act regarding responsible parents and children's citizenship.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "16 Section 16"
      },
      "wasDerivedFrom": "australian-citizenship-amendment-act-1984.pdf",
      "asserts": [
        "concept:australian-citizenship-amendment-act-1984-sec-16-norm",
        "concept:australian-citizenship-amendment-act-1984-sec-16-logic-deontic-1",
        "concept:australian-citizenship-amendment-act-1984-sec-16-logic-alleninterval-2",
        "concept:australian-citizenship-amendment-act-1984-sec-16-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "2c38c93016f489c114fb9e977d765f19ca35760db70a974737f241a77561af67",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-citizenship-amendment-act-1984#sec-16",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-16-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The order takes effect at least 30 days after the responsible parent's death.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal interval during which the Minister's order takes effect.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(d) if the cessation referred to in paragraph (c) is by reason of the death of the responsible parent—at any time after that death."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-16-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The State must provide notice to the person before directing them to cease being an Australian citizen.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the State to ensure responsible parents maintain their children's citizenship.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The Minister shall cause to be served on the person, either personally or by post, a copy of that order."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-16-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister may direct children to cease being Australian citizens.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Grants permission to the Minister to direct children to cease being Australian citizens.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(3) Where, but for this sub-section— (a) a child would cease to be an Australian citizen under sub-section (1) as a consequence of a responsible parent of the child ceasing to be an Australian citizen;"
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-16-norm",
