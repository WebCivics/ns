      "@id": "concept:australian-citizenship-amendment-act-1984-sec-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person shall be taken to be, or to have been, a permanent resident.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The state takes on an obligation to consider a non-citizen as a permanent resident.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "takes",
      "cml:premiseText": "The person is not an Australian citizen."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person shall be taken to be, or to have been, a permanent resident.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The state is required to consider a non-citizen as a permanent resident if certain conditions are met.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "shall",
      "cml:premiseText": "The person meets the specified conditions."
    },
    {
