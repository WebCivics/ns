    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-17",
      "@type": "cml:Concept",
      "dc:description": "Statement and Declaration",
      "dc:source": "australian-citizenship-amendment-act-1984.pdf, p.16",
      "skos:note": "A person may make a statement and declaration to resume citizenship lost under section 17.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "17 Section 17"
      },
      "wasDerivedFrom": "australian-citizenship-amendment-act-1984.pdf",
      "asserts": [
        "concept:australian-citizenship-amendment-act-1984-sec-17-norm",
        "concept:australian-citizenship-amendment-act-1984-sec-17-logic-deontic-1",
        "concept:australian-citizenship-amendment-act-1984-sec-17-logic-epistemic-2",
        "concept:australian-citizenship-amendment-act-1984-sec-17-logic-ltl-3",
        "concept:australian-citizenship-amendment-act-1984-sec-17-logic-argumentation-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "21da873e3552dd8403b1b3efb3963158054f27ea32bae7c77838559407aa2bd6",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-citizenship-amendment-act-1984#sec-17",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-17-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If the person's circumstances are such that compel them to do the act, they may resume citizenship.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "Person's circumstances are such that compel them to do the act."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-17-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Resumption of citizenship is an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation"
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-17-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.8000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::epistemic",
      "cml:logicSummary": "The person must believe they would have suffered significant hardship or detriment if not for the act.",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Belief",
      "cml:premiseText": "Person believes they would have suffered significant hardship or detriment."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-17-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.7000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The person's circumstances must be such that compel them to do the act.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "Person's circumstances are such that compel them to do the act."
    },
