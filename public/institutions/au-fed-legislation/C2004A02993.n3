    cml:modality cml:Deontic ;
    values:partOf concept:australian-citizenship-amendment-act-1984-sec-5 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:australian-citizenship-amendment-act-1984-sec-5 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-5-logic-deontic-1 .
concept:australian-citizenship-amendment-act-1984-sec-5-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "takes" ;
    cml:logicSummary "The state takes on an obligation to consider a non-citizen as a permanent resident." ;
    cml:premiseText "The person is not an Australian citizen." ;
    cml:conclusionText "The person shall be taken to be, or to have been, a permanent resident." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-5 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-5-logic-descriptionlogic-2 .
concept:australian-citizenship-amendment-act-1984-sec-5-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "is" ;
    cml:logicSummary "The description of the person as a non-citizen implies that they are considered a permanent resident." ;
    cml:premiseText "The person is not an Australian citizen." ;
    cml:conclusionText "The person shall be taken to be, or to have been, a permanent resident." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-5 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-5-logic-ltl-3 .
concept:australian-citizenship-amendment-act-1984-sec-5-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "during" ;
    cml:logicSummary "The person's presence in Australia during the specified period implies that they are considered a permanent resident." ;
    cml:premiseText "The person was present in Australia during the specified period." ;
    cml:conclusionText "The person shall be taken to be, or to have been, a permanent resident." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-5 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-5-logic-deontic-4 .
concept:australian-citizenship-amendment-act-1984-sec-5-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "shall" ;
    cml:logicSummary "The state is required to consider a non-citizen as a permanent resident if certain conditions are met." ;
    cml:premiseText "The person meets the specified conditions." ;
    cml:conclusionText "The person shall be taken to be, or to have been, a permanent resident." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-5 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-5-logic-descriptionlogic-5 .
concept:australian-citizenship-amendment-act-1984-sec-5-logic-descriptionlogic-5 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "is" ;
    cml:logicSummary "The description of the person as a non-citizen implies that they are considered a permanent resident if certain conditions are met." ;
    cml:premiseText "The person meets the specified conditions." ;
    cml:conclusionText "The person shall be taken to be, or to have been, a permanent resident." ;
    cml:executionSurface "modalities::dl" ;
