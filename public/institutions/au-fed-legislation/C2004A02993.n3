concept:australian-citizenship-amendment-act-1984-sec-5 a cml:Concept ;
    skos:prefLabel "5 Section 5"@en ;
    cml:realizedBy doc:sec-5 ;
    cml:integrityHash "c624ad211276121879464cce59dc0c11d681288af536890e9b132e2174e448eb" ;
    skos:note "A person who is not an Australian citizen shall be taken to be, or to have been, a permanent resident for the purposes of this Act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-act-1984.pdf> ;
    dc:source "australian-citizenship-amendment-act-1984.pdf, p.6" ;
    cml:asserts concept:australian-citizenship-amendment-act-1984-sec-5-norm .
