concept:australian-citizenship-amendment-act-1984-sec-29 a cml:Concept ;
    skos:prefLabel "29 Section 29"@en ;
    cml:realizedBy doc:sec-29 ;
    values:originalText "Section 46 of the Principal Act is amended— (a) by omitting from sub-section (1) \"by the Minister (including a delegate of the Minister) may be issued\" and substituting \"under this Act may be issued by the Minister or\"; and (b) by omitting from sub-section (2) \"a person by authority of the Minister shall, unless it is proved not to have been issued by authority  Australian Citizenship Amendment No. 129, 1984 of the Minister (including a delegate of the Minister)\" and substituting \"the Minister or a person by authority of the Minister, shall, unless the contrary is proved\". Evidentiary certificates" ;
    skos:definition "Section 46 of the Principal Act is amended— (a) by omitting from sub-section (1) \"by the Minister (including a delegate of the Minister) may be issued\" and substituting \"under this Act may be issued by the Minister or\"; and (b) by omitting from sub-section (2) \"a person by authority of the Minister shall, unless it is proved not to have been issued by authority  Australian Citizenship Amendment No. 129, 1984 of the Minister (including a delegate of the Minister)\" and substituting \"the Minister or a person by authority of the Minister, shall, unless the contrary is proved\". Evidentiary certificates"@en ;
    cml:integrityHash "1efe0fc7870494918998d2e1d5cb2cdac734f4a9d1fadc93264fc9de091ef457" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "The Minister or a person by authority of the Minister shall, unless the contrary is proved." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-act-1984.pdf> ;
    dc:source "australian-citizenship-amendment-act-1984.pdf, p.19" ;
