concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-deontic-1 .
concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Continuity" ;
    cml:logicSummary "The person's citizenship status is continuous despite the repeal of a provision." ;
    cml:premiseText "The person was an Australian citizen before the repeal." ;
    cml:conclusionText "The person does not cease to be an Australian citizen." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-deontic-2 .
concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Continuity" ;
    cml:logicSummary "The person's citizenship status is continuous despite the repeal of a provision." ;
    cml:premiseText "The repeal of a provision does not affect the person's citizenship status." ;
    cml:conclusionText "The person does not cease to be an Australian citizen." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-epistemic-3 .
concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-epistemic-3 a cml:LogicApplication ;
    cml:modality cml:Epistemic ;
    cml:operator "Knowledge" ;
    cml:logicSummary "A person knows they are an Australian citizen before the repeal of a provision." ;
    cml:premiseText "The person was informed of their citizenship status." ;
    cml:conclusionText "The person does not cease to be an Australian citizen." ;
    cml:executionSurface "modalities::epistemic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-ltl-4 .
