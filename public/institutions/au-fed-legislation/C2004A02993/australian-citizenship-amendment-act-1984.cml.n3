concept:australian-citizenship-amendment-act-1984-sec-11 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-11-logic-deontic-5 .
concept:australian-citizenship-amendment-act-1984-sec-11-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Granting a certificate of Australian citizenship is an obligation on the Minister." ;
    cml:premiseText "The Minister may, in his discretion, grant a certificate of Australian citizenship to a person who satisfies the conditions." ;
    cml:conclusionText "The Minister has an obligation to grant a certificate of Australian citizenship to a person who satisfies the conditions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-11 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-11-logic-alleninterval-6 .
concept:australian-citizenship-amendment-act-1984-sec-11-logic-alleninterval-6 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The period during which a person has been present in Australia as a permanent resident is relevant to the application." ;
    cml:premiseText "Paragraphs (1) (d) and (e) do not apply in relation to— (a) a person who has completed not less than 3 months' relevant defence service;" ;
    cml:conclusionText "The period during which a person has been present in Australia as a permanent resident is relevant to the application." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-amendment-act-1984-sec-11 cml:asserts concept:australian-citizenship-amendment-act-1984-sec-11-logic-ltl-7 .
