doc:sec-26-3-ss-18 a cof:Section ;
    cof:title "26(18) January 1949 is registered at an Australian consulate for the purposes of" ;
    values:kind "subsection" ;
    values:originalText "(18) Section 47A of the amended Act applies to a certificate of Australian citizenship granted either before or after the commencing day." ;
    cof:pageNumber "23"^^xsd:integer .

