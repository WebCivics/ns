      "cml:premiseText": "Section 13(2)",
      "cml:conclusionText": "Maximum deferral period of 12 months"
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-11-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Granting a certificate of Australian citizenship is an obligation on the Minister.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister may, in his discretion, grant a certificate of Australian citizenship to a person who satisfies the conditions.",
      "cml:conclusionText": "The Minister has an obligation to grant a certificate of Australian citizenship to a person who satisfies the conditions."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-11-logic-alleninterval-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The period during which a person has been present in Australia as a permanent resident is relevant to the application.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Paragraphs (1) (d) and (e) do not apply in relation to—\n(a) a person who has completed not less than 3 months' relevant defence service;",
      "cml:conclusionText": "The period during which a person has been present in Australia as a permanent resident is relevant to the application."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-11-logic-ltl-7",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "A certificate of Australian citizenship may be granted until the end of the 5-year period.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Paragraph (1) (e) does not apply in relation to a person who was formerly an Australian citizen or who was born in Australia.",
      "cml:conclusionText": "A certificate of Australian citizenship may be granted until the end of the 5-year period."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-11-logic-deontic-8",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "The Minister has permission to grant a certificate of Australian citizenship to a person who satisfies the conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister may, in his discretion, grant a certificate of Australian citizenship to a person who satisfies the conditions.",
      "cml:conclusionText": "The Minister has permission to grant a certificate of Australian citizenship to a person who satisfies the conditions."
    },
    {
