      },
      "cml:premiseText": "Definition of relevant security in section 11(17)",
      "cml:conclusionText": "Security given by person with or without sureties"
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-11-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Minister may defer consideration of application",
      "cml:executionSurface": "modalities::logic::deontic",
