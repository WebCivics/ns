      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "Deferral period does not exceed 12 months",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
