    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-act-1984#sec-39-ss-1",
      "@type": "cof:Section",
      "cof:title": "39(1) Section 39",
      "values:kind": "subsection",
      "cof:pageNumber": 23,
      "values:originalText": "(1) In this section—\n\"amended Act\" means the Principal Act as amended by this Act;\n\"commencing day\" means the twenty-eighth day after the day on which this\nAct receives the Royal Assent."
    },
