    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 November 1964;",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-act-1984#sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-act-1984.pdf"
