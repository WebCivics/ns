      },
      "cml:premiseText": "Section 13(1)(a) and (b)",
      "cml:conclusionText": "Application may be deferred for up to 12 months"
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-11-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
