      "dc:source": "australian-citizenship-amendment-act-1984.pdf, p.3",
      "values:originalText": "The title of the Principal Act is amended by omitting all the words after\n\"Citizenship\".\n\nAustralian Citizenship Amendment\nNo. 129, 1984\nInterpretation",
      "skos:definition": "The title of the Principal Act is amended by omitting all the words after\n\"Citizenship\".\n\nAustralian Citizenship Amendment\nNo. 129, 1984\nInterpretation",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-act-1984-sec-3-norm"
        }
      ],
      "cml:integrityHash": "a32e0785600e95b30242487e7a74f68ff5f4024167df158dc9672b7dcd0a32d2",
      "skos:note": "Amend title of Principal Act by omitting words after 'Citizenship'"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-act-1984#sec-3",
      "@type": "cof:Section",
