    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continuity",
      "cml:logicSummary": "The person's citizenship status is continuous despite the repeal of a provision.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person was an Australian citizen before the repeal.",
      "cml:conclusionText": "The person does not cease to be an Australian citizen."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continuity",
      "cml:logicSummary": "The person's citizenship status is continuous despite the repeal of a provision.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The repeal of a provision does not affect the person's citizenship status.",
      "cml:conclusionText": "The person does not cease to be an Australian citizen."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Knowledge",
      "cml:logicSummary": "A person knows they are an Australian citizen before the repeal of a provision.",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person was informed of their citizenship status.",
      "cml:conclusionText": "The person does not cease to be an Australian citizen."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "The person's citizenship status continues until the repeal of a provision.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The repeal of a provision occurs at a specific time.",
      "cml:conclusionText": "The person does not cease to be an Australian citizen until the repeal of a provision."
    },
    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-26-3-ss-20-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Inference",
      "cml:logicSummary": "A person who was an Australian citizen before the repeal of a provision can infer they do not cease to be an Australian citizen.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person's citizenship status is defined by the Principal Act.",
      "cml:conclusionText": "The person does not cease to be an Australian citizen."
    },
