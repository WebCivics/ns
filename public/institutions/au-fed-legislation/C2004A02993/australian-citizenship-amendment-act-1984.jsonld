    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Section 32",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-act-1984#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-act-1984.pdf"
      },
      "dc:source": "australian-citizenship-amendment-act-1984.pdf, p.21",
      "values:originalText": "Section 50 of the Principal Act is amended—\n(a) by omitting paragraph\n(1) (a) and substituting the\nfollowing\nparagraph:\n\"(a)\nmake, or cause or permit to be made, a representation or\nstatement that is, to his knowledge, false or misleading in a\nmaterial particular; or\"; and\n(b) by omitting the penalty set out at the foot of sub-section (1) and\nsubstituting the following penalty:\n\"Penalty: $1,000 or imprisonment for 6 months, or both.\".\nReferences in Commonwealth and Territory laws to British subjects",
      "skos:definition": "Section 50 of the Principal Act is amended—\n(a) by omitting paragraph\n(1) (a) and substituting the\nfollowing\nparagraph:\n\"(a)\nmake, or cause or permit to be made, a representation or\nstatement that is, to his knowledge, false or misleading in a\nmaterial particular; or\"; and\n(b) by omitting the penalty set out at the foot of sub-section (1) and\nsubstituting the following penalty:\n\"Penalty: $1,000 or imprisonment for 6 months, or both.\".\nReferences in Commonwealth and Territory laws to British subjects",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-act-1984-sec-32-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-act-1984-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d8af4466f65e648a4f8482a2114c8cab7dccbebb6ec134de8a4d56605d9e3c77",
      "skos:note": "Amendment of Section 50 of the Principal Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-act-1984#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Section 32",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "Section 50 of the Principal Act is amended—\n(a) by omitting paragraph\n(1) (a) and substituting the\nfollowing\nparagraph:\n\"(a)\nmake, or cause or permit to be made, a representation or\nstatement that is, to his knowledge, false or misleading in a\nmaterial particular; or\"; and\n(b) by omitting the penalty set out at the foot of sub-section (1) and\nsubstituting the following penalty:\n\"Penalty: $1,000 or imprisonment for 6 months, or both.\".\nReferences in Commonwealth and Territory laws to British subjects"
    },
