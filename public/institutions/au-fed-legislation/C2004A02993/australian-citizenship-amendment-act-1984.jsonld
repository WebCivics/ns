    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Section 33",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-act-1984#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-act-1984.pdf"
      },
      "dc:source": "australian-citizenship-amendment-act-1984.pdf, p.21",
      "values:originalText": "Section 51 of the Principal Act is repealed.\nProvisions of this Act to be exclusive of State laws",
      "skos:definition": "Section 51 of the Principal Act is repealed.\nProvisions of this Act to be exclusive of State laws",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-act-1984-sec-33-norm"
