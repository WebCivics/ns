    {
      "@id": "concept:australian-citizenship-amendment-act-1984-sec-10-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implies that the person is an Australian citizen if adopted by an Australian citizen or jointly by two persons at least one of whom is an Australian citizen",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
