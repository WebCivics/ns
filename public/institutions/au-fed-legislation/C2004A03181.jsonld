        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(2) No law or instrument shall be of any force or effect in so far as it purports to require the reservation of any Bill for an Act of a State for the signification of Her Majesty's pleasure thereon."
    },
