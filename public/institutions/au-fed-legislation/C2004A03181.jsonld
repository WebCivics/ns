    {
      "@id": "concept:australia-act-1986-sec-11-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Leave granted by Australian court allows for post-commencement appeals",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Appeals can be instituted after commencement",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(i) pursuant to leave granted by an Australian court..."
    },
    {
      "@id": "concept:australia-act-1986-sec-11-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "appeals instituted before commencement are unaffected",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to maintain appeals",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Nothing in the foregoing provisions of this section..."
    },
    {
      "@id": "concept:australia-act-1986-sec-11-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Certain appeals are prohibited by the section",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Appeals that could not have been instituted or continued are prohibited",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "but this subsection shall not be construed as permitting or enabling..."
    },
    {
      "@id": "concept:australia-act-1986-sec-11-ss-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "State has an obligation to maintain appeals",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "State obligation to maintain appeals",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Nothing in the foregoing provisions of this section:"
    },
    {
      "@id": "concept:australia-act-1986-sec-11-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Special leave granted allows for post-commencement appeals",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Appeals can be instituted or continued after commencement",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrent",
      "cml:premiseText": "(ii) pursuant to special leave granted by Her Majesty in Council..."
    },
