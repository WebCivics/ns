concept:australia-act-1986-sec-8 a cml:Concept ;
    skos:prefLabel "8 State laws not subject to disallowance or suspension of operation"@en ;
    cml:realizedBy doc:sec-8 ;
    values:originalText "An Act of the Parliament of a State that has been assented to by the Governor of the State shall not, after the commencement of this Act, be subject to disallowance by Her Majesty, nor shall its operation be suspended pending the signification of Her Majesty’s pleasure thereon." ;
    skos:definition "An Act of the Parliament of a State that has been assented to by the Governor of the State shall not, after the commencement of this Act, be subject to disallowance by Her Majesty, nor shall its operation be suspended pending the signification of Her Majesty’s pleasure thereon."@en ;
    cml:integrityHash "42921b1bcdbffc77ff6ad617897eaa2b958f8f2c47d86af43057c6e0f84ce169" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "No disallowance or suspension of operation after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
