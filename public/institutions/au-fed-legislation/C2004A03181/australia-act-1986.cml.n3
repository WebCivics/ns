concept:australia-act-1986-sec-10 a cml:Concept ;
    skos:prefLabel "10 Termination of responsibility of United Kingdom Government in"@en ;
    cml:realizedBy doc:sec-10 ;
    values:originalText "relation to State matters  After the commencement of this Act Her Majesty’s Government in the United Kingdom shall have no responsibility for the government of any State.    Section 11" ;
    skos:definition "relation to State matters  After the commencement of this Act Her Majesty’s Government in the United Kingdom shall have no responsibility for the government of any State.    Section 11"@en ;
