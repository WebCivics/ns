concept:australia-act-1986-sec-4 a cml:Concept ;
    skos:prefLabel "4 Powers of State Parliaments in relation to merchant shipping"@en ;
    cml:realizedBy doc:sec-4 ;
    values:originalText "Sections 735 and 736 of the Act of the Parliament of the United Kingdom known as the Merchant Shipping Act 1894, in so far as they are part of the law of a State, are hereby repealed." ;
    skos:definition "Sections 735 and 736 of the Act of the Parliament of the United Kingdom known as the Merchant Shipping Act 1894, in so far as they are part of the law of a State, are hereby repealed."@en ;
    cml:integrityHash "ac6e89fa733fde92bcaa7147e3322910a5440e6b83a53e786bf502dc559b3a7e" ;
