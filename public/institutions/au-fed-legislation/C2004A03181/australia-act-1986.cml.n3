concept:australia-act-1986-sec-9 a cml:Concept ;
    skos:prefLabel "9 State laws not subject to withholding of assent or reservation"@en ;
    cml:realizedBy doc:sec-9 ;
    values:originalText "(1) No law or instrument shall be of any force or effect in so far as it purports to require the Governor of a State to withhold assent from any Bill for an Act of the State that has been passed in such manner and form as may from time to time be required by a law made by the Parliament of the State.  (2) No law or instrument shall be of any force or effect in so far as it purports to require the reservation of any Bill for an Act of a State for the signification of Her Majesty’s pleasure thereon." ;
    skos:definition "(1) No law or instrument shall be of any force or effect in so far as it purports to require the Governor of a State to withhold assent from any Bill for an Act of the State that has been passed in such manner and form as may from time to time be required by a law made by the Parliament of the State.  (2) No law or instrument shall be of any force or effect in so far as it purports to require the reservation of any Bill for an Act of a State for the signification of Her Majesty’s pleasure thereon."@en ;
    cml:integrityHash "4e2046808a69e8824beeed649076cf39dba40ca991ee64f1a6ce9c022a34963c" ;
    cof:pageNumber "8"^^xsd:integer ;
    cml:hasPart concept:australia-act-1986-sec-9-ss-1 ;
    cml:hasPart concept:australia-act-1986-sec-9-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
