concept:australia-act-1986-sec-12 a cml:Concept ;
    skos:prefLabel "12 Amendment of Statute of Westminster"@en ;
    cml:realizedBy doc:sec-12 ;
    values:originalText "Sections 4, 9(2) and (3) and 10(2) of the Statute of Westminster 1931, in so far as they are part of the law of the Commonwealth, of a State or of a Territory, are hereby repealed." ;
