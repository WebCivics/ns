    {
      "@id": "concept:c2004a03367-sec-47-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "One month after the commencement time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Must be published before one month after the commencement time",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BEFORE",
      "cml:premiseText": "Not later than one month after the commencement time..."
    },
    {
      "@id": "concept:c2004a03367-sec-47-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A notice in relation to that decision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If a decision was made under section 44, then a notice must be published",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "The former Commission had made a decision under section 44..."
    },
    {
      "@id": "concept:c2004a03367-sec-47-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A publication of a notice.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Is a publication of a notice",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS-A",
      "cml:premiseText": "The notice is in accordance with sub-section 46 (1) of that Act."
    },
    {
      "@id": "concept:c2004a03367-sec-47-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A notice in relation to that decision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must publish a notice",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Commission shall cause to be published..."
    },
    {
