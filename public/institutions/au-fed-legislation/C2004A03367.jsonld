      "@id": "concept:c2004a03367-sec-47-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2004a03367.pdf, p.33",
      "skos:note": "Publish a notice in relation to a decision made by the former Commission under section 44 of the Sex Discrimination Act 1984.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "47(1) Section 47"
      },
      "wasDerivedFrom": "c2004a03367.pdf",
