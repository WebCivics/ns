doc:sec-47-ss-1 a cof:Section ;
    cof:title "47(1) Section 47" ;
    values:kind "subsection" ;
    values:originalText "(1) Where— (a) before the commencement time, the former Commission had made a decision under section 44 of the Sex Discrimination Act 1984; and (b) at the commencement time, the former Commission had not complied with sub-section 46 (1) of that Act in relation to that decision,  Human Rights and Equal Opportunity Commission (Transitional Provisions and Consequential Amendments) No. 126, 1986 the Commission shall, not later than one month after the commencement time, cause to be published in the Gazette a notice in relation to that decision in accordance with sub-section 46 (1) of that Act." ;
    cof:pageNumber "33"^^xsd:integer .

concept:c2004a03367-sec-47-ss-2 a cml:Concept ;
    skos:prefLabel "47(2) Section 47"@en ;
    cml:realizedBy doc:sec-47-ss-2 ;
    values:originalText "(2) A notice in relation to a complaint, being a notice served on the Commissioner under sub-section 52 (4) of the Sex Discrimination Act 1984 before the commencement time, shall, after the commencement time, be deemed to require the Commissioner to refer the complaint to the Commission." ;
    skos:definition "(2) A notice in relation to a complaint, being a notice served on the Commissioner under sub-section 52 (4) of the Sex Discrimination Act 1984 before the commencement time, shall, after the commencement time, be deemed to require the Commissioner to refer the complaint to the Commission."@en ;
    cml:integrityHash "b3229461351b11d681448bafdb65a7c26db93185d72e5e85986f1bc485a283bc" ;
    values:partOf concept:c2004a03367-sec-47 ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Commissioner must refer complaint to Commission after notice served before commencement time." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
