concept:c2004a03367-sec-3 a cml:Concept ;
    skos:prefLabel "3 Section 3"@en ;
    cml:realizedBy doc:sec-3 ;
    values:originalText "In this Act, unless the contrary intention appears— \"commencement time\" means the commencement of this Act; \"Commission\" means the Human Rights and Equal Opportunity Commission established by the Commission Act; \"Commission Act\" means the Human Rights and Equal Opportunity Commission Act 1986; \"former Commission\" means the Human Rights Commission established by the repealed Act; \"former Commissioner\" means the Commissioner for Community Relations who held office under the Racial Discrimination Act 1975 immediately before the commencement time; \"repealed Act\" means the Human Rights Commission Act 1981." ;
    skos:definition "In this Act, unless the contrary intention appears— \"commencement time\" means the commencement of this Act; \"Commission\" means the Human Rights and Equal Opportunity Commission established by the Commission Act; \"Commission Act\" means the Human Rights and Equal Opportunity Commission Act 1986; \"former Commission\" means the Human Rights Commission established by the repealed Act; \"former Commissioner\" means the Commissioner for Community Relations who held office under the Racial Discrimination Act 1975 immediately before the commencement time; \"repealed Act\" means the Human Rights Commission Act 1981."@en ;
    cml:integrityHash "6a40828602548cb0d836a0a23a3ff3feb3436bf735f1aea1ff37ab5a067f7d2a" ;
    cof:pageNumber "5"^^xsd:integer ;
    skos:note "Definitions for terms used in the Act." ;
