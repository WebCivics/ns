concept:c2004a03367-sec-12 a cml:Concept ;
    skos:prefLabel "12 Section 12"@en ;
    cml:realizedBy doc:sec-12 ;
    values:originalText "Section 3 of the Principal Act is amended— (a) by omitting from sub-section (1) the definition of \"Commissioner\" and substituting the following definitions: \"'Commission' means the Human Rights and Equal Opportunity Commission established by the Human Rights and Equal Opportunity Commission Act 1986; 'Commissioner' means the Race Discrimination Commissioner appointed under section 29;\"; (b) by omitting from sub-section (1) the definition of \"Human Rights Commission\" and substituting the following definition: \"'Federal Court' means the Federal Court of Australia;\"; and (c) by inserting after the definition of \"member\" in sub-section (1) the following definition: \"'registered organisation' means an organisation registered pursuant to the Conciliation and Arbitration Act 1904;\"." ;
    skos:definition "Section 3 of the Principal Act is amended— (a) by omitting from sub-section (1) the definition of \"Commissioner\" and substituting the following definitions: \"'Commission' means the Human Rights and Equal Opportunity Commission established by the Human Rights and Equal Opportunity Commission Act 1986; 'Commissioner' means the Race Discrimination Commissioner appointed under section 29;\"; (b) by omitting from sub-section (1) the definition of \"Human Rights Commission\" and substituting the following definition: \"'Federal Court' means the Federal Court of Australia;\"; and (c) by inserting after the definition of \"member\" in sub-section (1) the following definition: \"'registered organisation' means an organisation registered pursuant to the Conciliation and Arbitration Act 1904;\"."@en ;
    cml:integrityHash "6530ecafd10d20a149b4cdb262eb55bfb171b252450bc1f6fc78c73d240e2840" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Amends definitions in Section 3 of the Principal Act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
