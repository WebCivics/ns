    cof:pageNumber "33"^^xsd:integer .

concept:c2004a03367-sec-47-ss-3 a cml:Concept ;
    skos:prefLabel "47(3) Section 47"@en ;
    cml:realizedBy doc:sec-47-ss-3 ;
    values:originalText "(3) Where— (a) within the period of days immediately preceding the commencement time, the former Commission served notice on a person under section 87 of the Sex Discrimination Act 1984; and (b) at the commencement time, the person had not complied with the requirement made by the notice, the requirement made by the notice shall, after the commencement time, be deemed to be a requirement to disclose to the Commission, before the expiration of the period of 28 days after the notice was served, the information specified in the notice." ;
    skos:definition "(3) Where— (a) within the period of days immediately preceding the commencement time, the former Commission served notice on a person under section 87 of the Sex Discrimination Act 1984; and (b) at the commencement time, the person had not complied with the requirement made by the notice, the requirement made by the notice shall, after the commencement time, be deemed to be a requirement to disclose to the Commission, before the expiration of the period of 28 days after the notice was served, the information specified in the notice."@en ;
    cml:integrityHash "ee8bd969498156134706e5002ea7de5a98aa5823117ff0cb67d09915dddf8fae" ;
    values:partOf concept:c2004a03367-sec-47 ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Requirement to disclose information after notice served" ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
