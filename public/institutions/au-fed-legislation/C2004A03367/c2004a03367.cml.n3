concept:c2004a03367-sec-32 a cml:Concept ;
    skos:prefLabel "32 Section 32"@en ;
    cml:realizedBy doc:sec-32 ;
    values:originalText "Where, before the commencement time, the former Commission had, under sub-section 23 (2) of the Racial Discrimination Act 1975, given its consent to a conciliation committee performing the former Commission's function of endeavouring to effect a settlement of a matter in accordance with sub-section 21 (1) of that Act, that consent shall, on and after the commencement time, be deemed to have been given by the Commission. Certificates by former Commission" ;
    skos:definition "Where, before the commencement time, the former Commission had, under sub-section 23 (2) of the Racial Discrimination Act 1975, given its consent to a conciliation committee performing the former Commission's function of endeavouring to effect a settlement of a matter in accordance with sub-section 21 (1) of that Act, that consent shall, on and after the commencement time, be deemed to have been given by the Commission. Certificates by former Commission"@en ;
    cml:integrityHash "7f37e9aa5255a9f484d4af59a0fb5a660fd40716f4250717c6ea69026ee123b1" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Consent given by former Commission is deemed valid after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2004a03367.pdf> ;
