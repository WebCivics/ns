doc:sec-46-ss-3 a cof:Section ;
    cof:title "46(3) Section 46" ;
    values:kind "subsection" ;
    values:originalText "(3) A reference in the Sex Discrimination Act 1984 to an act or thing done by or to, or an instrument made by or given to, the Commission or a member of the Commission under a provision of that Act shall be read as including a reference to an act or thing done by or to, or an instrument made by or given to, the former Commission or a member of the former Commission, as the case may be, before the commencement time, under the provision concerned." ;
    cof:pageNumber "33"^^xsd:integer .

