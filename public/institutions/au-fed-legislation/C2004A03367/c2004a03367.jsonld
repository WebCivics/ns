        },
        {
          "@id": "concept:c2004a03367-sec-47-ss-1-logic-diffusion-4"
        },
        {
          "@id": "concept:c2004a03367-sec-47-ss-1-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "5ef2de7d466b217a8bdad571492e5ecbc2a8d54abc071c8bd7bbdcea63f3a784",
      "skos:note": "Publish a notice in relation to a decision made by the former Commission under section 44 of the Sex Discrimination Act 1984."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-47-ss-1",
      "@type": "cof:Section",
      "cof:title": "47(1) Section 47",
      "values:kind": "subsection",
      "cof:pageNumber": 33,
      "values:originalText": "(1) Where—\n(a) before the commencement time, the former Commission had made\na decision under section 44 of the Sex Discrimination\nAct\n1984;\nand\n(b) at the commencement time, the former Commission had not\ncomplied with sub-section 46 (1) of that Act in relation to that\ndecision,\n\nHuman Rights and Equal Opportunity Commission\n(Transitional\nProvisions and Consequential Amendments)\nNo. 126, 1986\nthe Commission shall, not later than one month after the commencement\ntime, cause to be published in the Gazette\na notice in relation to that\ndecision in accordance with sub-section 46 (1) of that Act."
    },
