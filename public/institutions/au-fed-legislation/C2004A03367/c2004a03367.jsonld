          "@id": "concept:c2004a03367-sec-5-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d0d94bdfb6baee07795588b5dbaca21ec26b1d80b16fc6ba801e995941868169",
      "skos:note": "Exempts declarations from Commission Act from subsection (2)"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-5-ss-3",
      "@type": "cof:Section",
      "cof:title": "5(3) Section 5",
      "values:kind": "subsection",
      "cof:pageNumber": 5,
      "values:originalText": "(3) Sub-section (2) does not apply in relation to a reference to—\n(a) a declaration made by the Minister under section 18 of the\nCommission Act; or\n(b) a declaration made by the Minister under section 47 of the\nCommission Act."
    },
    {
      "@id": "concept:c2004a03367-sec-5-ss-3-norm",
