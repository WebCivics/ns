        }
      ],
      "cml:integrityHash": "08b2395cc58f71369435a63dc1105884a07a309155cb96888b224bd1459ab0ed",
      "skos:note": "Amendment of Section 2 of the Principal Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-11",
