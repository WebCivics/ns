    {
      "@id": "concept:c2004a03367-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Section 32",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.28",
      "values:originalText": "Where, before the commencement time, the former Commission had,\nunder sub-section 23 (2) of the Racial Discrimination\nAct 1975, given its\nconsent to a conciliation committee performing the former Commission's\nfunction of endeavouring to effect a settlement of a matter in accordance\nwith sub-section 21 (1) of that Act, that consent shall, on and after the\ncommencement time, be deemed to have been given by the Commission.\nCertificates by former Commission",
      "skos:definition": "Where, before the commencement time, the former Commission had,\nunder sub-section 23 (2) of the Racial Discrimination\nAct 1975, given its\nconsent to a conciliation committee performing the former Commission's\nfunction of endeavouring to effect a settlement of a matter in accordance\nwith sub-section 21 (1) of that Act, that consent shall, on and after the\ncommencement time, be deemed to have been given by the Commission.\nCertificates by former Commission",
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-32-norm"
        },
        {
          "@id": "concept:c2004a03367-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7f37e9aa5255a9f484d4af59a0fb5a660fd40716f4250717c6ea69026ee123b1",
      "skos:note": "Consent given by former Commission is deemed valid after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Section 32",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Where, before the commencement time, the former Commission had,\nunder sub-section 23 (2) of the Racial Discrimination\nAct 1975, given its\nconsent to a conciliation committee performing the former Commission's\nfunction of endeavouring to effect a settlement of a matter in accordance\nwith sub-section 21 (1) of that Act, that consent shall, on and after the\ncommencement time, be deemed to have been given by the Commission.\nCertificates by former Commission"
    },
    {
      "@id": "concept:c2004a03367-sec-32-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2004a03367-sec-32"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2004a03367-sec-32-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "DEEMED",
      "cml:logicSummary": "Validates consent given by former Commission.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2004a03367-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Section 33",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.28",
      "values:originalText": "Where—\n(a) before the commencement time, a person had received, in accordance\nwith sub-section 24 (3) of the Racial Discrimination\nAct 1975, a\ncertificate stating the matters referred to in paragraph 24 (3) (a) or\n(b) of that Act signed by a member of the former Commission or\nby the former Commissioner; and\n(b) at the commencement time, the person had not instituted a\nproceeding under sub-section 24 (1) of that Act,\nthen, for the purposes of the institution of any proceeding by the person\nafter the commencement time, the certificate so received by the person shall\nbe deemed to state the matters referred to in paragraph 24 (3) (a) or (b)\nof the Principal Act as amended by this Act and to have been signed by a\nmember of the Commission, or by the Race Discrimination Commissioner,\nas the case may be.\nDelegations by former Commission and former Commissioner",
      "skos:definition": "Where—\n(a) before the commencement time, a person had received, in accordance\nwith sub-section 24 (3) of the Racial Discrimination\nAct 1975, a\ncertificate stating the matters referred to in paragraph 24 (3) (a) or\n(b) of that Act signed by a member of the former Commission or\nby the former Commissioner; and\n(b) at the commencement time, the person had not instituted a\nproceeding under sub-section 24 (1) of that Act,\nthen, for the purposes of the institution of any proceeding by the person\nafter the commencement time, the certificate so received by the person shall\nbe deemed to state the matters referred to in paragraph 24 (3) (a) or (b)\nof the Principal Act as amended by this Act and to have been signed by a\nmember of the Commission, or by the Race Discrimination Commissioner,\nas the case may be.\nDelegations by former Commission and former Commissioner",
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-33-norm"
        },
        {
          "@id": "concept:c2004a03367-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a228ebf257516d6a5fd1a0e7a9ac77c25dcb981e598889f537c190c059894b7c",
      "skos:note": "Deemed certificate for Racial Discrimination Act 1975 proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Section 33",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Where—\n(a) before the commencement time, a person had received, in accordance\nwith sub-section 24 (3) of the Racial Discrimination\nAct 1975, a\ncertificate stating the matters referred to in paragraph 24 (3) (a) or\n(b) of that Act signed by a member of the former Commission or\nby the former Commissioner; and\n(b) at the commencement time, the person had not instituted a\nproceeding under sub-section 24 (1) of that Act,\nthen, for the purposes of the institution of any proceeding by the person\nafter the commencement time, the certificate so received by the person shall\nbe deemed to state the matters referred to in paragraph 24 (3) (a) or (b)\nof the Principal Act as amended by this Act and to have been signed by a\nmember of the Commission, or by the Race Discrimination Commissioner,\nas the case may be.\nDelegations by former Commission and former Commissioner"
    },
    {
      "@id": "concept:c2004a03367-sec-33-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2004a03367-sec-33"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2004a03367-sec-33-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Conditional commencement",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2004a03367-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Section 34",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.28",
      "values:originalText": "(1) Where—\n(a) before the commencement time, the former Commission had, under\nsub-section 40 (1) of the Racial Discrimination\nAct 1975, delegated\na power to a person (not being a member of the staff of the former\nCommission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\nthen, after the commencement time, the power of the Commission that\ncorresponds to the power delegated as mentioned in paragraph (a) shall for\nall purposes be deemed to have been delegated, under that sub-section, to\nthat person by the Commission in the terms of the delegation by the former\nCommission.\n(2) Where—\n(a) before the commencement time, the former Commissioner had,\nunder sub-section 40 (2) of the Racial Discrimination\nAct\n1975,\ndelegated a power to a person (not being a member of the staff of\nthe former Commission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\n\nHuman Rights and Equal Opportunity Commission\n(Transitional\nProvisions and Consequential Amendments)\nNo. 126, 1986\nthen, after the commencement time, the power exercisable by the Race\nDiscrimination Commissioner that corresponds to the power delegated as\nmentioned in paragraph (a) shall for all purposes be deemed to have been\ndelegated, under that sub-section, to that person by the Race Discrimination\nCommissioner in the terms of the delegation by the former Commissioner.",
      "skos:definition": "(1) Where—\n(a) before the commencement time, the former Commission had, under\nsub-section 40 (1) of the Racial Discrimination\nAct 1975, delegated\na power to a person (not being a member of the staff of the former\nCommission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\nthen, after the commencement time, the power of the Commission that\ncorresponds to the power delegated as mentioned in paragraph (a) shall for\nall purposes be deemed to have been delegated, under that sub-section, to\nthat person by the Commission in the terms of the delegation by the former\nCommission.\n(2) Where—\n(a) before the commencement time, the former Commissioner had,\nunder sub-section 40 (2) of the Racial Discrimination\nAct\n1975,\ndelegated a power to a person (not being a member of the staff of\nthe former Commission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\n\nHuman Rights and Equal Opportunity Commission\n(Transitional\nProvisions and Consequential Amendments)\nNo. 126, 1986\nthen, after the commencement time, the power exercisable by the Race\nDiscrimination Commissioner that corresponds to the power delegated as\nmentioned in paragraph (a) shall for all purposes be deemed to have been\ndelegated, under that sub-section, to that person by the Race Discrimination\nCommissioner in the terms of the delegation by the former Commissioner.",
      "cml:hasPart": [
        {
          "@id": "concept:c2004a03367-sec-34-ss-1"
        },
        {
          "@id": "concept:c2004a03367-sec-34-ss-2"
        }
      ],
      "cml:integrityHash": "43476d1796da1de5cca047e011f210f79324146530817b1f269c7ed7f58dfe3a"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Section 34",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "(1) Where—\n(a) before the commencement time, the former Commission had, under\nsub-section 40 (1) of the Racial Discrimination\nAct 1975, delegated\na power to a person (not being a member of the staff of the former\nCommission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\nthen, after the commencement time, the power of the Commission that\ncorresponds to the power delegated as mentioned in paragraph (a) shall for\nall purposes be deemed to have been delegated, under that sub-section, to\nthat person by the Commission in the terms of the delegation by the former\nCommission.\n(2) Where—\n(a) before the commencement time, the former Commissioner had,\nunder sub-section 40 (2) of the Racial Discrimination\nAct\n1975,\ndelegated a power to a person (not being a member of the staff of\nthe former Commission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\n\nHuman Rights and Equal Opportunity Commission\n(Transitional\nProvisions and Consequential Amendments)\nNo. 126, 1986\nthen, after the commencement time, the power exercisable by the Race\nDiscrimination Commissioner that corresponds to the power delegated as\nmentioned in paragraph (a) shall for all purposes be deemed to have been\ndelegated, under that sub-section, to that person by the Race Discrimination\nCommissioner in the terms of the delegation by the former Commissioner."
    },
