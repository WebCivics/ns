    {
      "@id": "concept:c2004a03367-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Section 17",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
