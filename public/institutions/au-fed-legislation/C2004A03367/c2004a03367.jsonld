    {
      "@id": "concept:c2004a03367-sec-5-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(3) Section 5",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-5-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.5",
      "values:originalText": "(3) Sub-section (2) does not apply in relation to a reference to—\n(a) a declaration made by the Minister under section 18 of the\nCommission Act; or\n(b) a declaration made by the Minister under section 47 of the\nCommission Act.",
      "skos:definition": "(3) Sub-section (2) does not apply in relation to a reference to—\n(a) a declaration made by the Minister under section 18 of the\nCommission Act; or\n(b) a declaration made by the Minister under section 47 of the\nCommission Act.",
      "values:partOf": {
