    {
      "@id": "concept:c2004a03367-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Section 11",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-11"
