      },
      "dc:source": "c2004a03367.pdf, p.7",
      "values:originalText": "Section 2 of the Principal Act is amended by omitting sub-section\n(3).\nInterpretation",
      "skos:definition": "Section 2 of the Principal Act is amended by omitting sub-section\n(3).\nInterpretation",
      "cml:asserts": [
        {
