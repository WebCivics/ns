      "dc:source": "c2004a03367.pdf, p.27",
      "values:originalText": "The Principal Act is amended as set out in the Schedule.\nOperation of Racial Discrimination Act",
      "skos:definition": "The Principal Act is amended as set out in the Schedule.\nOperation of Racial Discrimination Act",
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-30-norm"
        }
      ],
      "cml:integrityHash": "b93809b71c1ff7e1f5f3cc478e32edf4d81480990155187107d81dd90bd77357",
      "skos:note": "Amendment of Principal Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-30",
