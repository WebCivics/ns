      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-46-ss-4",
      "@type": "cof:Section",
      "cof:title": "46(4) Section 46",
      "values:kind": "subsection",
      "cof:pageNumber": 33,
      "values:originalText": "(4) The reference in paragraph 94 (2) (e) of the Sex\nDiscrimination\nAct 1984 to the Commission shall be read as including a reference to the\nformer Commission."
    },
