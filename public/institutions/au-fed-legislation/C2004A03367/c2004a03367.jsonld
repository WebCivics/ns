      },
      "cml:operator": ">=",
      "cml:logicSummary": "Defines commencement time relation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2004a03367-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 An",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.6",
      "values:originalText": "agreement\nor\ninstrument\nin force\nimmediately before\nthe\ncommencement time, being an agreement or instrument to which the former\nCommission was a party, has effect, after the commencement time, as if—\n(a) the Commission were substituted for the former Commission as a\nparty to the agreement or instrument; and\n(b) any reference in the agreement or instrument to the Human Rights\nCommission were (expect in relation to matters that occurred before\nthe commencement time) a reference to the Human Rights and\nEqual Opportunity Commission.\n\nHuman Rights and Equal Opportunity Commission (Transitional\nProvisions and Consequential Amendments)\nNo. 126, 1986\nObligation of secrecy",
      "skos:definition": "agreement\nor\ninstrument\nin force\nimmediately before\nthe\ncommencement time, being an agreement or instrument to which the former\nCommission was a party, has effect, after the commencement time, as if—\n(a) the Commission were substituted for the former Commission as a\nparty to the agreement or instrument; and\n(b) any reference in the agreement or instrument to the Human Rights\nCommission were (expect in relation to matters that occurred before\nthe commencement time) a reference to the Human Rights and\nEqual Opportunity Commission.\n\nHuman Rights and Equal Opportunity Commission (Transitional\nProvisions and Consequential Amendments)\nNo. 126, 1986\nObligation of secrecy",
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-7-norm"
        },
        {
          "@id": "concept:c2004a03367-sec-7-logic-deontic-1"
        },
        {
          "@id": "concept:c2004a03367-sec-7-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "c3f665c8400f92fcabb334dad1d87c55a1b97c351af43db2f49c61b76971204b",
      "skos:note": "Continuity of agreements and instruments after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-7",
      "@type": "cof:Section",
      "cof:title": "7 An",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "agreement\nor\ninstrument\nin force\nimmediately before\nthe\ncommencement time, being an agreement or instrument to which the former\nCommission was a party, has effect, after the commencement time, as if—\n(a) the Commission were substituted for the former Commission as a\nparty to the agreement or instrument; and\n(b) any reference in the agreement or instrument to the Human Rights\nCommission were (expect in relation to matters that occurred before\nthe commencement time) a reference to the Human Rights and\nEqual Opportunity Commission.\n\nHuman Rights and Equal Opportunity Commission (Transitional\nProvisions and Consequential Amendments)\nNo. 126, 1986\nObligation of secrecy"
    },
    {
      "@id": "concept:c2004a03367-sec-7-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2004a03367-sec-7"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2004a03367-sec-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "CONTINUITY",
      "cml:logicSummary": "Continuity of obligations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The agreement or instrument has effect as if the Commission were substituted for the former Commission.",
      "cml:conclusionText": "The obligation continues in force after commencement."
    },
    {
      "@id": "concept:c2004a03367-sec-7-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTINUITY",
      "cml:logicSummary": "Continuity of temporal intervals",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The agreement or instrument has effect immediately before the commencement time.",
      "cml:conclusionText": "The obligation continues in force after commencement."
    },
    {
      "@id": "concept:c2004a03367-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Notwithstanding the repeal effected by section 4, the provisions of",
      "cml:realizedBy": {
