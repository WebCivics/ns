      }
    },
    {
      "@id": "concept:c2004a03367-sec-47-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "47(4) Section 47",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-47-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.33",
      "values:originalText": "(4) Where—\n(a) before the commencement time, the former Commission had, under\nsub-section 104(1) of the Sex Discrimination\nAct 1984, delegated\na power to a person (not being a member, or a member of the staff,\nof the former Commission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\nthen, after the commencement time, the power of the Commission that\ncorresponds to the power delegated as mentioned in paragraph (a) shall for\nall purposes be deemed to have been delegated, under that sub-section, to\nthat person by the Commission in the terms of the delegation by the former\nCommission.",
      "skos:definition": "(4) Where—\n(a) before the commencement time, the former Commission had, under\nsub-section 104(1) of the Sex Discrimination\nAct 1984, delegated\na power to a person (not being a member, or a member of the staff,\nof the former Commission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\nthen, after the commencement time, the power of the Commission that\ncorresponds to the power delegated as mentioned in paragraph (a) shall for\nall purposes be deemed to have been delegated, under that sub-section, to\nthat person by the Commission in the terms of the delegation by the former\nCommission.",
      "values:partOf": {
        "@id": "concept:c2004a03367-sec-47"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-47-ss-4-norm"
        }
      ],
      "cml:integrityHash": "c55d6b2bc49e9771a799e92a16ff53c80b71f5c28c0ef6707cf0b4ecd1050212",
      "skos:note": "Delegation of power after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-47-ss-4",
      "@type": "cof:Section",
      "cof:title": "47(4) Section 47",
      "values:kind": "subsection",
      "cof:pageNumber": 33,
      "values:originalText": "(4) Where—\n(a) before the commencement time, the former Commission had, under\nsub-section 104(1) of the Sex Discrimination\nAct 1984, delegated\na power to a person (not being a member, or a member of the staff,\nof the former Commission); and\n(b) immediately before the commencement time, the delegation had not\nbeen revoked,\nthen, after the commencement time, the power of the Commission that\ncorresponds to the power delegated as mentioned in paragraph (a) shall for\nall purposes be deemed to have been delegated, under that sub-section, to\nthat person by the Commission in the terms of the delegation by the former\nCommission."
    },
    {
      "@id": "concept:c2004a03367-sec-47-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2004a03367-sec-47-ss-4"
      },
