    {
      "@id": "concept:c2004a03367-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.5",
      "values:originalText": "The Human Rights Commission\nAct 1981 is repealed.\nOperation of Commission Act, &c.",
      "skos:definition": "The Human Rights Commission\nAct 1981 is repealed.\nOperation of Commission Act, &c.",
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-4-norm"
        }
      ],
      "cml:integrityHash": "5410bf113a0dc8e0cc5a9da31187e2180276f5d06579a0612239f3ff4c654c64",
      "skos:note": "Repeal of Human Rights Commission Act 1981"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Section 4",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "The Human Rights Commission\nAct 1981 is repealed.\nOperation of Commission Act, &c."
    },
    {
      "@id": "concept:c2004a03367-sec-4-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
