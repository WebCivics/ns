    {
      "@id": "concept:c2004a03367-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Section 3",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.5",
      "values:originalText": "In this Act, unless the contrary intention appears—\n\"commencement time\" means the commencement of this Act;\n\"Commission\" means the Human\nRights and Equal\nOpportunity\nCommission established by the Commission Act;\n\"Commission Act\" means the Human\nRights\nand Equal\nOpportunity\nCommission\nAct 1986;\n\"former Commission\" means the Human Rights Commission established\nby the repealed Act;\n\"former\nCommissioner\" means the Commissioner\nfor\nCommunity\nRelations who held office under the Racial Discrimination\nAct 1975\nimmediately before the commencement time;\n\"repealed Act\" means the Human Rights Commission\nAct\n1981.",
      "skos:definition": "In this Act, unless the contrary intention appears—\n\"commencement time\" means the commencement of this Act;\n\"Commission\" means the Human\nRights and Equal\nOpportunity\nCommission established by the Commission Act;\n\"Commission Act\" means the Human\nRights\nand Equal\nOpportunity\nCommission\nAct 1986;\n\"former Commission\" means the Human Rights Commission established\nby the repealed Act;\n\"former\nCommissioner\" means the Commissioner\nfor\nCommunity\nRelations who held office under the Racial Discrimination\nAct 1975\nimmediately before the commencement time;\n\"repealed Act\" means the Human Rights Commission\nAct\n1981.",
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-3-norm"
        },
        {
          "@id": "concept:c2004a03367-sec-3-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "6a40828602548cb0d836a0a23a3ff3feb3436bf735f1aea1ff37ab5a067f7d2a",
      "skos:note": "Definitions for terms used in the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Section 3",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "In this Act, unless the contrary intention appears—\n\"commencement time\" means the commencement of this Act;\n\"Commission\" means the Human\nRights and Equal\nOpportunity\nCommission established by the Commission Act;\n\"Commission Act\" means the Human\nRights\nand Equal\nOpportunity\nCommission\nAct 1986;\n\"former Commission\" means the Human Rights Commission established\nby the repealed Act;\n\"former\nCommissioner\" means the Commissioner\nfor\nCommunity\nRelations who held office under the Racial Discrimination\nAct 1975\nimmediately before the commencement time;\n\"repealed Act\" means the Human Rights Commission\nAct\n1981."
    },
