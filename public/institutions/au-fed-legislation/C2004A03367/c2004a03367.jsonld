    {
      "@id": "concept:c2004a03367-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Section 9",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.7",
      "values:originalText": "Where an Act appropriates money for the purposes of, or in connection\nwith the activities of, the Human Rights Commission, references in that Act\nto the Human Rights Commission shall, after the commencement time, be\nread as references to the Human Rights and Equal Opportunity Commission.",
      "skos:definition": "Where an Act appropriates money for the purposes of, or in connection\nwith the activities of, the Human Rights Commission, references in that Act\nto the Human Rights Commission shall, after the commencement time, be\nread as references to the Human Rights and Equal Opportunity Commission.",
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-9-norm"
        },
        {
          "@id": "concept:c2004a03367-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8b7ab02fe8ac9dfeccc914d808f68cc71d58b737362362db305f4673bf56af18",
      "skos:note": "References to Human Rights Commission shall be read as references to Human Rights and Equal Opportunity Commission after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Section 9",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Where an Act appropriates money for the purposes of, or in connection\nwith the activities of, the Human Rights Commission, references in that Act\nto the Human Rights Commission shall, after the commencement time, be\nread as references to the Human Rights and Equal Opportunity Commission."
    },
