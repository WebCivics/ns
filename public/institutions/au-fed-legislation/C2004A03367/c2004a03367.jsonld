    },
    {
      "@id": "concept:c2004a03367-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Section 6",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2004a03367.pdf"
      },
      "dc:source": "c2004a03367.pdf, p.6",
      "values:originalText": "An arrangement in force immediately before the commencement time,\nbeing an arrangement made under section 11 of the repealed Act, has effect,\nafter the commencement time, for or in connection with the performance\nof functions or the exercise of powers pursuant to sub-section 5 (4) or (5)\nof this Act as if—\n(a) a reference in the arrangement to the Human Rights Commission\nwere (except in relation to matters that occurred before\nthe\ncommencement time) a reference to the Human Rights and Equal\nOpportunity Commission; and\n(b) a reference in the arrangement to the Human\nRights\nCommission\nAct 1981, or to a provision of that Act, were a reference to the\nHuman\nRights\nand Equal Opportunity\nCommission\nAct 1986, or\nto the corresponding provision of that last-mentioned Act, as the\ncase may be.\nReferences in agreements, &c, to former Commission",
      "skos:definition": "An arrangement in force immediately before the commencement time,\nbeing an arrangement made under section 11 of the repealed Act, has effect,\nafter the commencement time, for or in connection with the performance\nof functions or the exercise of powers pursuant to sub-section 5 (4) or (5)\nof this Act as if—\n(a) a reference in the arrangement to the Human Rights Commission\nwere (except in relation to matters that occurred before\nthe\ncommencement time) a reference to the Human Rights and Equal\nOpportunity Commission; and\n(b) a reference in the arrangement to the Human\nRights\nCommission\nAct 1981, or to a provision of that Act, were a reference to the\nHuman\nRights\nand Equal Opportunity\nCommission\nAct 1986, or\nto the corresponding provision of that last-mentioned Act, as the\ncase may be.\nReferences in agreements, &c, to former Commission",
      "cml:asserts": [
        {
          "@id": "concept:c2004a03367-sec-6-norm"
        },
        {
          "@id": "concept:c2004a03367-sec-6-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "30b1bfef702b2a98fe2114d879152ec38497c226a0de8b6a5a6c86c4eae36a8a",
      "skos:note": "Preserves arrangements made under repealed Act for certain purposes after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2004a03367#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Section 6",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "An arrangement in force immediately before the commencement time,\nbeing an arrangement made under section 11 of the repealed Act, has effect,\nafter the commencement time, for or in connection with the performance\nof functions or the exercise of powers pursuant to sub-section 5 (4) or (5)\nof this Act as if—\n(a) a reference in the arrangement to the Human Rights Commission\nwere (except in relation to matters that occurred before\nthe\ncommencement time) a reference to the Human Rights and Equal\nOpportunity Commission; and\n(b) a reference in the arrangement to the Human\nRights\nCommission\nAct 1981, or to a provision of that Act, were a reference to the\nHuman\nRights\nand Equal Opportunity\nCommission\nAct 1986, or\nto the corresponding provision of that last-mentioned Act, as the\ncase may be.\nReferences in agreements, &c, to former Commission"
    },
    {
      "@id": "concept:c2004a03367-sec-6-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
