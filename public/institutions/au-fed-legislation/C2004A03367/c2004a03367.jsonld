    {
      "@id": "concept:c2004a03367-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Section 36",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2004a03367#sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
