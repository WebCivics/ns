    {
      "@id": "concept:australian-capital-territory-stamp-duty-amendment-act-1986-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Schedule 1 to the Principal Act is amended—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-stamp-duty-amendment-act-1986#sec-4"
      },
      "cml:curationStatus": {
