doc:sec-36 a cof:Section ;
    cof:title "36 Section 36" ;
    values:kind "section" ;
    values:originalText "In spite of the amendments of section 82 of the Principal Act made by this Act, that section continues to apply in relation to persons who have been officers. By-laws" ;
    cof:pageNumber "20"^^xsd:integer .

