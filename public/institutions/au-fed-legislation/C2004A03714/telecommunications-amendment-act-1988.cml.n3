concept:telecommunications-amendment-act-1988-sec-28 a cml:Concept ;
    skos:prefLabel "28 Directions given to the Commission under section 7 of the Principal"@en ;
    cml:realizedBy doc:sec-28 ;
    values:originalText "Act with respect to the performance of its functions and the exercise of its powers (being directions in force immediately before the commencement of section 12 of this Act) have effect, after that commencement, as if they were directions given to the Board under section 23 of the Principal Act as amended by this Act in relation to the performance of the Corporation's functions and the exercise of the Corporation's powers. Delegations" ;
    skos:definition "Act with respect to the performance of its functions and the exercise of its powers (being directions in force immediately before the commencement of section 12 of this Act) have effect, after that commencement, as if they were directions given to the Board under section 23 of the Principal Act as amended by this Act in relation to the performance of the Corporation's functions and the exercise of the Corporation's powers. Delegations"@en ;
    cml:integrityHash "543b3c5399aba28607da0cd834b12719127faad89869f496ed6950186b5d2fb9" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Directions given to the Commission under section 7 have effect as if they were directions given to the Board." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
