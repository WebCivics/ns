doc:sec-1-2 a cof:Section ;
    cof:title "1 Section 1" ;
    values:kind "section" ;
    values:originalText "The following provisions are amended by omitting \"Commission\" (wherever occurring) and substituting \"Corporation\": Sections 3 (1) (definitions of \"authorized person\", \"telecommunications message\" and \"telecommunications system\"), 3 (2) (b) (iii) and (4), 5, 5A, 6 (2) (b) (iv), (3), (4) and (5), 8, 9, 10 (1), (2), (4) and (5), 10A, 11 (7), 12 (5) and (6), 13, 14, 15, 16, 17, 18, 19 and 20, 71 (3) and (4), 72, 72A (1), (2) and (8), 72B (1) and (2), 72c, 75, 76 (1) and (2), 80, 81 (1) and (4), 83 (1), 84 (3) (b), 85, 87, 88, 89 (2), 90, 92, 93, 94 (1), (2) (c), (3) and (4), 94A, 95, 96, 98 (2), (3) and (4), 99 (1C) and ( 1 D ) , 101, 103, 103A, 104, 105, 106, 107, 108, 109, 110, 110A and 110B." ;
    cof:pageNumber "21"^^xsd:integer .

concept:telecommunications-amendment-act-1988-sec-2-2 a cml:Concept ;
    skos:prefLabel "2 Section 2"@en ;
    cml:realizedBy doc:sec-2-2 ;
    values:originalText "The following provisions are amended by omitting \"Commission\" (wherever occurring) and substituting \"Board\": Sections 11 (4), (5) and (6), 12 (4) and (7), 71 (6) and 99 (1A) and (1B).  Telecommunications Amendment No. 121, 1988" ;
    skos:definition "The following provisions are amended by omitting \"Commission\" (wherever occurring) and substituting \"Board\": Sections 11 (4), (5) and (6), 12 (4) and (7), 71 (6) and 99 (1A) and (1B).  Telecommunications Amendment No. 121, 1988"@en ;
    cml:integrityHash "65fb523c56af10a910aefd1eac613cb05db7914a20331c1145a1ca8c590b9202" ;
    cof:pageNumber "21"^^xsd:integer ;
