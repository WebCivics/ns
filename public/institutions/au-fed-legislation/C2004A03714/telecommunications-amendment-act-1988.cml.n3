concept:telecommunications-amendment-act-1988-sec-35 a cml:Concept ;
    skos:prefLabel "35 Section 35"@en ;
    cml:realizedBy doc:sec-35 ;
    values:originalText "If section 14 of this Act commences before section 86 of the Industrial Relations (Consequential Provisions) Act 1988, Division 8 of Part V has effect as if: (a) references to the Service were references to the employees of the Corporation; (b) references to officers were omitted; and (c) references to an organization were a reference to an organization registered under the Conciliation and Arbitration Act 1904.  Telecommunications Amendment No. 121, 1988 Disclosure of contents of telecommunications message" ;
    skos:definition "If section 14 of this Act commences before section 86 of the Industrial Relations (Consequential Provisions) Act 1988, Division 8 of Part V has effect as if: (a) references to the Service were references to the employees of the Corporation; (b) references to officers were omitted; and (c) references to an organization were a reference to an organization registered under the Conciliation and Arbitration Act 1904.  Telecommunications Amendment No. 121, 1988 Disclosure of contents of telecommunications message"@en ;
    cml:integrityHash "b643f360178db6fc4b1568bff47a36011e3002a7ddf441716c4a7df5ba4ac6b2" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "References to certain entities are modified upon commencement of section 14." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
