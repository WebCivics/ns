    skos:prefLabel "1 Section 1"@en ;
    cml:realizedBy doc:sch-2-sec-1-3 ;
    values:originalText "On the commencement of section 12, the headings to the following sections of the Telecommunications Act 1975 are altered by omitting \"Commission\" and substituting  Telecommunications Amendment No. 121, 1988 NOTES—continued \"Corporation\": Sections 5, 6, 9, 10, 10A, 13, 14, 18, 20, 72B, 72C, 73, 92, 94, 96 and 105." ;
