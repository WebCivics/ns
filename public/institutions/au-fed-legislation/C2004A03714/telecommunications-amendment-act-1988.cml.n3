concept:telecommunications-amendment-act-1988-sec-33 a cml:Concept ;
    skos:prefLabel "33 Section 33"@en ;
    cml:realizedBy doc:sec-33 ;
    values:originalText "If section 14 of this Act commences before section 12 of this Act, the Principal Act as amended by this Act has effect, after the commencement of section 14 of this Act and until the commencement of section 12 of this Act, as if the heading to Division 1 of Part V were omitted. Divisions 2 to 7 of Part V etc." ;
    skos:definition "If section 14 of this Act commences before section 12 of this Act, the Principal Act as amended by this Act has effect, after the commencement of section 14 of this Act and until the commencement of section 12 of this Act, as if the heading to Division 1 of Part V were omitted. Divisions 2 to 7 of Part V etc."@en ;
    cml:integrityHash "bdf0404f512766d0c6a575a9af89987536342a8a9403392c6fb8c1039c6db8f8" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Conditional commencement of section 12 of this Act" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-amendment-act-1988.pdf> ;
    dc:source "telecommunications-amendment-act-1988.pdf, p.19" ;
    cml:asserts concept:telecommunications-amendment-act-1988-sec-33-norm .
