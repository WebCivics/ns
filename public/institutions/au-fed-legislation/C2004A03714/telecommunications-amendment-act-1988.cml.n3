concept:telecommunications-amendment-act-1988-sec-39 a cml:Concept ;
    skos:prefLabel "39 Section 39"@en ;
    cml:realizedBy doc:sec-39 ;
    values:originalText "Where an Act appropriates money for the purposes of, or in connection with the activities of, the Commission, references in that Act to the Commission shall, after the commencement of section 12 of this Act, be read as references to the Corporation.  Telecommunications Amendment No. 121, 1988 SCHEDULE 1 Section 23 CONSEQUENTIAL AND MINOR AMENDMENTS OF TELECOMMUNICATIONS ACT 1975" ;
    skos:definition "Where an Act appropriates money for the purposes of, or in connection with the activities of, the Commission, references in that Act to the Commission shall, after the commencement of section 12 of this Act, be read as references to the Corporation.  Telecommunications Amendment No. 121, 1988 SCHEDULE 1 Section 23 CONSEQUENTIAL AND MINOR AMENDMENTS OF TELECOMMUNICATIONS ACT 1975"@en ;
    cml:integrityHash "3352e29401e997775913b821bd9197091c7e8ad050bd27c65d6d56a380c6c7b7" ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "References to Commission after commencement of section 12 shall be read as references to Corporation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-amendment-act-1988.pdf> ;
    dc:source "telecommunications-amendment-act-1988.pdf, p.20" ;
    cml:asserts concept:telecommunications-amendment-act-1988-sec-39-norm .
