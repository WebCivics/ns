doc:sch-2-sec-2-2 a cof:Section ;
    cof:title "2 Section 2" ;
    values:kind "section" ;
    values:originalText "No. 114, 1979, as amended. For previous amendments, see No. 181, 1979; Nos. 114 and 116, 1983; Nos. 6 and 116, 1984; Nos. 8 and 63, 1985; No. 102, 1986; Nos. 89 and 120, 1987; and Nos. 5, 65 and 66, 1988. SECTION HEADINGS NOTES" ;
    cof:pageNumber "30"^^xsd:integer .

