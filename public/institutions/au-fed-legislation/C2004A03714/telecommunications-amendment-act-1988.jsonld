    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-35",
      "@type": "cml:Concept",
      "skos:prefLabel": "35 Section 35",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-35"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-act-1988.pdf"
      },
      "dc:source": "telecommunications-amendment-act-1988.pdf, p.19",
      "values:originalText": "If section 14 of this Act commences before section 86 of the Industrial\nRelations\n(Consequential\nProvisions)\nAct 1988, Division 8 of Part V has\neffect as if:\n(a) references to the Service were references to the employees of the\nCorporation;\n(b) references to officers were omitted; and\n(c) references to an organization were a reference to an organization\nregistered under the Conciliation\nand Arbitration\nAct\n1904.\n\nTelecommunications\nAmendment\nNo. 121, 1988\nDisclosure of contents of telecommunications message",
      "skos:definition": "If section 14 of this Act commences before section 86 of the Industrial\nRelations\n(Consequential\nProvisions)\nAct 1988, Division 8 of Part V has\neffect as if:\n(a) references to the Service were references to the employees of the\nCorporation;\n(b) references to officers were omitted; and\n(c) references to an organization were a reference to an organization\nregistered under the Conciliation\nand Arbitration\nAct\n1904.\n\nTelecommunications\nAmendment\nNo. 121, 1988\nDisclosure of contents of telecommunications message",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-35-norm"
        }
      ],
      "cml:integrityHash": "b643f360178db6fc4b1568bff47a36011e3002a7ddf441716c4a7df5ba4ac6b2",
      "skos:note": "References to certain entities are modified upon commencement of section 14."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-35",
      "@type": "cof:Section",
      "cof:title": "35 Section 35",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "If section 14 of this Act commences before section 86 of the Industrial\nRelations\n(Consequential\nProvisions)\nAct 1988, Division 8 of Part V has\neffect as if:\n(a) references to the Service were references to the employees of the\nCorporation;\n(b) references to officers were omitted; and\n(c) references to an organization were a reference to an organization\nregistered under the Conciliation\nand Arbitration\nAct\n1904.\n\nTelecommunications\nAmendment\nNo. 121, 1988\nDisclosure of contents of telecommunications message"
    },
