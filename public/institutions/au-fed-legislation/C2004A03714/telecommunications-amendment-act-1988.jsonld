      "cml:integrityHash": "55a99f01d63b7f3b3a50e033c644de811e04e563077419226c7d12935a034184",
      "skos:note": "Amendment of Section 11"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-11",
      "@type": "cof:Section",
