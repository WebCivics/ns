      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of providing space satellite facilities",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
