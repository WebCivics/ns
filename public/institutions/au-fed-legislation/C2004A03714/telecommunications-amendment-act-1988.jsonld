      }
    },
    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Section 23",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-act-1988.pdf"
      },
      "dc:source": "telecommunications-amendment-act-1988.pdf, p.17",
      "values:originalText": "(1) The Principal Act is amended as set out in Part I of\nSchedule 1.\n(2) The Principal Act is amended as set out in Part II of Schedule 1.\n(3) The Principal Act is amended as set out in Part III of Schedule 1.",
