      "cml:operator": "IMPLIES",
      "cml:logicSummary": "If the Commission is a listed corporation, it must provide executive officer accounts.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Commission is a listed corporation",
      "cml:conclusionText": "Executive officer accounts must be provided."
    },
    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-20-logic-dialectical-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Dialectical"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "If the Commission is taken to be a listed corporation, it must provide executive officer accounts.",
