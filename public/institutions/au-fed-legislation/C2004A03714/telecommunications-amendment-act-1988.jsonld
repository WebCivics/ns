    },
    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-38-ss-2-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Defines a temporal interval for commencement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If section 14 commences before section 12",
      "cml:conclusionText": "...and until the commencement of section 12"
    },
    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-39",
      "@type": "cml:Concept",
      "skos:prefLabel": "39 Section 39",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-39"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-act-1988.pdf"
      },
      "dc:source": "telecommunications-amendment-act-1988.pdf, p.20",
      "values:originalText": "Where an Act appropriates money for the purposes of, or in\nconnection with the activities of, the Commission, references in that Act to\nthe Commission shall, after the commencement of section 12 of this Act, be\nread as references to the Corporation.\n\nTelecommunications\nAmendment\nNo. 121, 1988\nSCHEDULE 1\nSection 23\nCONSEQUENTIAL AND MINOR AMENDMENTS OF\nTELECOMMUNICATIONS ACT 1975",
      "skos:definition": "Where an Act appropriates money for the purposes of, or in\nconnection with the activities of, the Commission, references in that Act to\nthe Commission shall, after the commencement of section 12 of this Act, be\nread as references to the Corporation.\n\nTelecommunications\nAmendment\nNo. 121, 1988\nSCHEDULE 1\nSection 23\nCONSEQUENTIAL AND MINOR AMENDMENTS OF\nTELECOMMUNICATIONS ACT 1975",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-39-norm"
        }
      ],
      "cml:integrityHash": "3352e29401e997775913b821bd9197091c7e8ad050bd27c65d6d56a380c6c7b7",
      "skos:note": "References to Commission after commencement of section 12 shall be read as references to Corporation."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-39",
      "@type": "cof:Section",
      "cof:title": "39 Section 39",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Where an Act appropriates money for the purposes of, or in\nconnection with the activities of, the Commission, references in that Act to\nthe Commission shall, after the commencement of section 12 of this Act, be\nread as references to the Corporation.\n\nTelecommunications\nAmendment\nNo. 121, 1988\nSCHEDULE 1\nSection 23\nCONSEQUENTIAL AND MINOR AMENDMENTS OF\nTELECOMMUNICATIONS ACT 1975"
    },
