      "dc:source": "telecommunications-amendment-act-1988.pdf, p.7",
      "values:originalText": "Section 11 of the Principal Act is amended by inserting in subsection\n(6) \"(other than prescribed rentals and charges)\" after \"this section\".",
      "skos:definition": "Section 11 of the Principal Act is amended by inserting in subsection\n(6) \"(other than prescribed rentals and charges)\" after \"this section\".",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-11-norm"
        }
