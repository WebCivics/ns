    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-2-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Section 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-2-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-act-1988.pdf"
      },
      "dc:source": "telecommunications-amendment-act-1988.pdf, p.21",
      "values:originalText": "The following provisions are amended\nby omitting\n\"Commission\"\n(wherever occurring) and substituting \"Board\":\nSections 11 (4), (5) and (6), 12 (4) and (7), 71 (6) and 99 (1A) and\n(1B).\n\nTelecommunications\nAmendment\nNo. 121, 1988",
      "skos:definition": "The following provisions are amended\nby omitting\n\"Commission\"\n(wherever occurring) and substituting \"Board\":\nSections 11 (4), (5) and (6), 12 (4) and (7), 71 (6) and 99 (1A) and\n(1B).\n\nTelecommunications\nAmendment\nNo. 121, 1988",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-2-2-norm"
        }
      ],
      "cml:integrityHash": "65fb523c56af10a910aefd1eac613cb05db7914a20331c1145a1ca8c590b9202",
      "skos:note": "Amendments to certain sections by omitting 'Commission' and substituting 'Board'"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Section 2",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "The following provisions are amended\nby omitting\n\"Commission\"\n(wherever occurring) and substituting \"Board\":\nSections 11 (4), (5) and (6), 12 (4) and (7), 71 (6) and 99 (1A) and\n(1B).\n\nTelecommunications\nAmendment\nNo. 121, 1988"
    },
    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-2-2-norm",
