    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Section 33",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-act-1988.pdf"
      },
      "dc:source": "telecommunications-amendment-act-1988.pdf, p.19",
      "values:originalText": "If section 14 of this Act commences before section 12 of this Act,\nthe Principal Act as amended by this Act has effect, after the commencement\nof section 14 of this Act and until the commencement of section 12 of this\nAct, as if the heading to Division 1 of Part V were omitted.\nDivisions 2 to 7 of Part V etc.",
      "skos:definition": "If section 14 of this Act commences before section 12 of this Act,\nthe Principal Act as amended by this Act has effect, after the commencement\nof section 14 of this Act and until the commencement of section 12 of this\nAct, as if the heading to Division 1 of Part V were omitted.\nDivisions 2 to 7 of Part V etc.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-33-norm"
        }
      ],
      "cml:integrityHash": "bdf0404f512766d0c6a575a9af89987536342a8a9403392c6fb8c1039c6db8f8",
      "skos:note": "Conditional commencement of section 12 of this Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Section 33",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "If section 14 of this Act commences before section 12 of this Act,\nthe Principal Act as amended by this Act has effect, after the commencement\nof section 14 of this Act and until the commencement of section 12 of this\nAct, as if the heading to Division 1 of Part V were omitted.\nDivisions 2 to 7 of Part V etc."
    },
    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-33-norm",
