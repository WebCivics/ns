    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 After section S of the Principal Act the following section is inserted:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-act-1988.pdf"
      },
      "dc:source": "telecommunications-amendment-act-1988.pdf, p.5",
      "values:originalText": "Subsidiary function\n\"5A. (1) It is a subsidiary function of the Commission to carry on,\noutside Australia, business relating to telecommunications.\n\"(2) The Commission shall not carry on the business of providing space\nsatellite facilities for use in telecommunications systems for neighbouring\nregions.\n\nTelecommunications\nAmendment\nNo. 121, 1988\n\"(3) In subsection (2), 'neighbouring regions' and 'space satellite' have\nthe same respective meanings as they have in the Satellite\nCommunications\nAct 1984.\".\nParticular powers of Commission",
      "skos:definition": "Subsidiary function\n\"5A. (1) It is a subsidiary function of the Commission to carry on,\noutside Australia, business relating to telecommunications.\n\"(2) The Commission shall not carry on the business of providing space\nsatellite facilities for use in telecommunications systems for neighbouring\nregions.\n\nTelecommunications\nAmendment\nNo. 121, 1988\n\"(3) In subsection (2), 'neighbouring regions' and 'space satellite' have\nthe same respective meanings as they have in the Satellite\nCommunications\nAct 1984.\".\nParticular powers of Commission",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-7-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f7b653dd0dae0022fb9d900ffda898a0bbc1181a3f5e6326d4a606589fac093b",
      "skos:note": "The Commission shall not carry on the business of providing space satellite facilities for use in telecommunications systems for neighbouring regions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-7",
      "@type": "cof:Section",
      "cof:title": "7 After section S of the Principal Act the following section is inserted:",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "Subsidiary function\n\"5A. (1) It is a subsidiary function of the Commission to carry on,\noutside Australia, business relating to telecommunications.\n\"(2) The Commission shall not carry on the business of providing space\nsatellite facilities for use in telecommunications systems for neighbouring\nregions.\n\nTelecommunications\nAmendment\nNo. 121, 1988\n\"(3) In subsection (2), 'neighbouring regions' and 'space satellite' have\nthe same respective meanings as they have in the Satellite\nCommunications\nAct 1984.\".\nParticular powers of Commission"
    },
    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-7-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
