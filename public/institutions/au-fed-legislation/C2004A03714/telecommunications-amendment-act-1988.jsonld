    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Section 6",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-act-1988.pdf"
      },
      "dc:source": "telecommunications-amendment-act-1988.pdf, p.5",
      "values:originalText": "Section 4 of the Principal Act is repealed and the following sections\nare substituted:\nAustralian Telecommunications Corporation\n\"4. The Australian Telecommunications Commission is, by this section,\npreserved, and continued in existence, under the name of the Australian\nTelecommunications Corporation.\nCorporation is body corporate etc.\n\"4A. The Corporation:\n(a) continues to be a body corporate;\n(b) shall have a seal;\n(c) may acquire, hold and dispose of real and personal property; and\n(d) may sue and be sued in its corporate name.\".",
      "skos:definition": "Section 4 of the Principal Act is repealed and the following sections\nare substituted:\nAustralian Telecommunications Corporation\n\"4. The Australian Telecommunications Commission is, by this section,\npreserved, and continued in existence, under the name of the Australian\nTelecommunications Corporation.\nCorporation is body corporate etc.\n\"4A. The Corporation:\n(a) continues to be a body corporate;\n(b) shall have a seal;\n(c) may acquire, hold and dispose of real and personal property; and\n(d) may sue and be sued in its corporate name.\".",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-6-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "519485224046fe859b0caf3131471ed25d7d1bd9d8918659be4cf0e39d5c6978",
      "skos:note": "The Australian Telecommunications Commission is preserved and continued in existence under the name of the Australian Telecommunications Corporation."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Section 6",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "Section 4 of the Principal Act is repealed and the following sections\nare substituted:\nAustralian Telecommunications Corporation\n\"4. The Australian Telecommunications Commission is, by this section,\npreserved, and continued in existence, under the name of the Australian\nTelecommunications Corporation.\nCorporation is body corporate etc.\n\"4A. The Corporation:\n(a) continues to be a body corporate;\n(b) shall have a seal;\n(c) may acquire, hold and dispose of real and personal property; and\n(d) may sue and be sued in its corporate name.\"."
    },
    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-6-norm",
      "@type": "values:Obligation",
      "cml:modality": {
