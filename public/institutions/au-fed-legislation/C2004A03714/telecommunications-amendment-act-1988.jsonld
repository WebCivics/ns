    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Section 25",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-25"
      },
