      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "allows",
      "cml:logicSummary": "Permitted action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "Interception by PABX equipment installers is allowed"
    },
