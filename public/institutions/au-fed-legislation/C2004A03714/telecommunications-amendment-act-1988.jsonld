      "dc:source": "telecommunications-amendment-act-1988.pdf, p.15",
      "values:originalText": "Section 73 of the Principal Act is amended by omitting from\nsubparagraph (3) (b) (i) \", as determined by the Minister for Finance,\".\nRepeal of section 74",
      "skos:definition": "Section 73 of the Principal Act is amended by omitting from\nsubparagraph (3) (b) (i) \", as determined by the Minister for Finance,\".\nRepeal of section 74",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-act-1988-sec-16-norm"
        }
