    {
      "@id": "concept:telecommunications-amendment-act-1988-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Section 38",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-act-1988#sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
