      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must be brought before a magistrate.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
