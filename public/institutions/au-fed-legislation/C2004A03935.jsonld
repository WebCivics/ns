    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Attorney-General must direct that a person be released from prison on parole.",
      "cml:modality": {
