    {
      "@id": "concept:crimes-legislation-amendment-act-sec-44-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Making such statements is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of false or misleading statements",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "An acceptable referee, or any other person, must not make a statement in an identification reference that is false or misleading in a material particular."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-44-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to provide accurate information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to provide accurate information",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "An acceptable referee, or any other person, must not omit from an identification reference any matter or thing without which the reference is misleading in a material particular."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-44-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to provide accurate information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to provide accurate information",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "An acceptable referee, or any other person, must not knowingly or recklessly omit from an identification reference any matter or thing without which the reference is misleading in a material particular."
