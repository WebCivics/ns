    {
      "@id": "concept:crimes-legislation-amendment-act-sec-15-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-act.pdf, p.38",
      "skos:note": "A person must be brought before a magistrate if arrested when the court is not sitting. Court must obtain and consider reports of psychiatrists with experience in diagnosis and treatment of mental illness.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15(1) Section 15"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-act.pdf",
