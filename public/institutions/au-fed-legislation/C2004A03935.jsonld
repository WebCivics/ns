    {
      "@id": "concept:crimes-legislation-amendment-act-sec-38-logic-alleninterval-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The declaration is effective between certain dates.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for reporting compliance with this Act.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "between",
      "cml:premiseText": "The Director may, by notice in the Gazette, declare the applicant to be an identifying cash dealer if satisfied that such a declaration would not be inconsistent with the objects of this Act."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-38-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The applicant must carry out the verification procedures.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to carry out verification procedures and report information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "The applicant undertakes to carry out the verification procedures under subsection 20(8)"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-38-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The applicant must report the information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to report information obtained by the applicant.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "The applicant undertakes to report under section 16 in relation to information obtained by the applicant as a result of carrying out the procedures mentioned in paragraph (a)"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-38-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The applicant must provide written reports.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to give written reports on compliance with this Act.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "The applicant undertakes to give the Director, in respect of such periods as are determined by the Director, written reports on the applicant's compliance with this Act."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-38-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Director has permission to take certain actions.",
