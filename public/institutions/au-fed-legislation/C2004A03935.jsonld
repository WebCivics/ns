    {
      "@id": "concept:crimes-legislation-amendment-act-sec-13",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-act.pdf, p.37",
      "skos:note": "A court is required to pass another sentence or make another order before passing a first-mentioned sentence or order in respect of a person convicted by that court for a federal offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "13 Section 13"
      },
