    cml:modality cml:Deontic ;
    cml:operator "obligation" ;
    cml:logicSummary "Obligation to report information obtained by the applicant." ;
    cml:premiseText "The applicant undertakes to report under section 16 in relation to information obtained by the applicant as a result of carrying out the procedures mentioned in paragraph (a)" ;
    cml:conclusionText "The applicant must report the information." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
