    cml:modality cml:Deontic ;
    cml:operator "obligation" ;
    cml:logicSummary "Obligation to carry out verification procedures and report information." ;
    cml:premiseText "The applicant undertakes to carry out the verification procedures under subsection 20(8)" ;
    cml:conclusionText "The applicant must carry out the verification procedures." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

