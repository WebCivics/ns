    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imprisonment obligation reduced for certain federal offences." ;
    cml:premiseText "Section 17a of the Principal Act is amended to reduce imprisonment for certain federal offences." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-act-sec-7 cml:asserts concept:crimes-legislation-amendment-act-sec-7-logic-alleninterval-2 .
concept:crimes-legislation-amendment-act-sec-7-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal relation" ;
    cml:logicSummary "Temporal relation between convictions and imprisonment." ;
    cml:premiseText "the court convicting the person must not, unless in the opinion of the court there are exceptional circumstances that warrant it, pass a sentence of imprisonment for that offence or any of those offences." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-act-sec-7 cml:asserts concept:crimes-legislation-amendment-act-sec-7-logic-ltl-3 .
concept:crimes-legislation-amendment-act-sec-7-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring trace" ;
    cml:logicSummary "Recurring trace of convictions and imprisonment." ;
    cml:premiseText "For the purpose only, under subsection (lA), of aggregating the value of property or money to which federal offences relate, a federal offence of which a person has not been convicted but which a court, with the consent of the person charged, has taken into account in passing sentence on the person for another federal offence, is to be treated as if it were a federal offence of which the person was convicted." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-act-sec-7 cml:asserts concept:crimes-legislation-amendment-act-sec-7-logic-diffusion-4 .
concept:crimes-legislation-amendment-act-sec-7-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffusion" ;
    cml:logicSummary "Diffusion of convictions and imprisonment through aggregation." ;
    cml:premiseText "This section applies subject to any contrary intention in the law creating the offence." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-act-sec-7 cml:asserts concept:crimes-legislation-amendment-act-sec-7-logic-deontic-5 .
concept:crimes-legislation-amendment-act-sec-7-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imprisonment obligation reduced for certain federal offences." ;
    cml:premiseText "Where a person is convicted of one or more federal offences relating to property, money or both, whose total value does not exceed $2,000; and the person has not previously been sentenced to imprisonment for any federal, State or Territory offence;" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


concept:crimes-legislation-amendment-act-sec-8 a cml:Concept ;
    skos:prefLabel "8 Section 8"@en ;
    cml:realizedBy doc:sec-8 ;
    cml:integrityHash "21e2756911b64d768ae807b53c8c35251aa4a6416adc57037b2eb05392f19b2d" ;
    skos:note "The Attorney-General must direct that a person be released from prison on parole at the end of the non-parole period. Court must direct when each federal sentence commences. Court must fix single non-parole period in respect of all federal sentences the person is to serve or complete. The offender must be of good behaviour and not violate any law during the licence period. Court must state reasons for not fixing non-parole period or making recognizance release order." ;
    dc:description "Reasons for decision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-act.pdf> ;
    dc:source "crimes-legislation-amendment-act.pdf, p.14" ;
    cml:asserts concept:crimes-legislation-amendment-act-sec-8-norm .
