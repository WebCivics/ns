concept:crimes-legislation-amendment-act-sec-17 cml:asserts concept:crimes-legislation-amendment-act-sec-17-logic-deontic-1 .
concept:crimes-legislation-amendment-act-sec-17-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If a person fails to pay, they are not imprisoned." ;
    cml:premiseText "Failure to pay" ;
    cml:conclusionText "No imprisonment" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-act-sec-17 cml:asserts concept:crimes-legislation-amendment-act-sec-17-logic-ltl-2 .
