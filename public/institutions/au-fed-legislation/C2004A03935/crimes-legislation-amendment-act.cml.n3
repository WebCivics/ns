concept:crimes-legislation-amendment-act-sec-7 cml:asserts concept:crimes-legislation-amendment-act-sec-7-logic-deontic-1 .
concept:crimes-legislation-amendment-act-sec-7-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "States that the State must pass a sentence of imprisonment for federal offences, unless exceptional circumstances warrant it." ;
    cml:premiseText "The court convicting the person must not, unless in the opinion of the court there are exceptional circumstances that warrant it, pass a sentence of imprisonment for that offence or any of those offences." ;
    cml:conclusionText "The State is obligated to pass a sentence of imprisonment for federal offences, unless exceptional circumstances warrant it." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-act-sec-7 cml:asserts concept:crimes-legislation-amendment-act-sec-7-logic-alleninterval-2 .
