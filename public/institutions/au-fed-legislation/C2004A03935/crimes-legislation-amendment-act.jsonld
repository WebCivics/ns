    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-30-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "30(4) Section 30",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-30-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.62",
      "values:originalText": "(4) Where, in relation to a federal sentence of imprisonment imposed\nupon a person before the day when section 9 of this Act commences, a\nminimum term of imprisonment (however described) has purportedly been\nfixed by operation of State or Territory legislation, that purported minimum\nterm of imprisonment is to be treated, for the purpose of this section, in the\nsame way as if it were a lesser term of imprisonment fixed by a court under\nsection 4 of the Commonwealth Prisoners Act 1967 in relation to that first-\nmentioned sentence.\nParole orders made under Commonwealth Prisoners Act 1967\nbefore commencing day",
      "skos:definition": "(4) Where, in relation to a federal sentence of imprisonment imposed\nupon a person before the day when section 9 of this Act commences, a\nminimum term of imprisonment (however described) has purportedly been\nfixed by operation of State or Territory legislation, that purported minimum\nterm of imprisonment is to be treated, for the purpose of this section, in the\nsame way as if it were a lesser term of imprisonment fixed by a court under\nsection 4 of the Commonwealth Prisoners Act 1967 in relation to that first-\nmentioned sentence.\nParole orders made under Commonwealth Prisoners Act 1967\nbefore commencing day",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-act-sec-30"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-30-ss-4-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-30-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0d921533877f1b34208145eb7d94e971d40d26c65a7523817530f85d4d3729b4",
      "skos:note": "Treats a purported minimum term of imprisonment fixed by State or Territory legislation as if it were a lesser term of imprisonment fixed by a court."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-30-ss-4",
      "@type": "cof:Section",
      "cof:title": "30(4) Section 30",
      "values:kind": "subsection",
      "cof:pageNumber": 62,
      "values:originalText": "(4) Where, in relation to a federal sentence of imprisonment imposed\nupon a person before the day when section 9 of this Act commences, a\nminimum term of imprisonment (however described) has purportedly been\nfixed by operation of State or Territory legislation, that purported minimum\nterm of imprisonment is to be treated, for the purpose of this section, in the\nsame way as if it were a lesser term of imprisonment fixed by a court under\nsection 4 of the Commonwealth Prisoners Act 1967 in relation to that first-\nmentioned sentence.\nParole orders made under Commonwealth Prisoners Act 1967\nbefore commencing day"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-30-ss-4-norm",
