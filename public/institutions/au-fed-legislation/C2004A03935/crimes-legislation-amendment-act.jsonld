    {
      "@id": "concept:crimes-legislation-amendment-act-sec-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Requires",
      "cml:logicSummary": "The law requires a court to pass another sentence or make another order.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
