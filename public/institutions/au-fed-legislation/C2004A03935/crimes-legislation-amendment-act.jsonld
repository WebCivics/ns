    {
      "@id": "concept:crimes-legislation-amendment-act-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Section 33",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.64",
      "values:originalText": "Nothing in this Part shall be taken to affect the application of a law\nof a State or Territory providing for the remission or reduction of State or\nTerritory non-parole periods of imprisonment to federal non-parole periods\nof imprisonment fixed in respect of federal sentences of imprisonment\nimposed before the commencing day.\nFurther consequential amendments",
      "skos:definition": "Nothing in this Part shall be taken to affect the application of a law\nof a State or Territory providing for the remission or reduction of State or\nTerritory non-parole periods of imprisonment to federal non-parole periods\nof imprisonment fixed in respect of federal sentences of imprisonment\nimposed before the commencing day.\nFurther consequential amendments",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-33-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8680a83fbd654c2ce9c7187ba5e44f7c332e980ba2a3a288a7c9550731129721",
      "skos:note": "No effect on State/Territory laws regarding remission of non-parole periods."
    },
