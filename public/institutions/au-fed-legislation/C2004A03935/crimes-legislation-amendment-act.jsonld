    {
      "@id": "concept:crimes-legislation-amendment-act-sec-47",
      "@type": "cml:Concept",
      "skos:prefLabel": "47 Section 47",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-47"
      },
      "cml:curationStatus": {
