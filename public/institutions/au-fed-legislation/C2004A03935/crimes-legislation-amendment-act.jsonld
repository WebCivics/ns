    {
      "@id": "concept:crimes-legislation-amendment-act-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Section 31",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.63",
      "values:originalText": "A parole order made under section 5 of the Commonwealth Prisoners\nAct 1967, being a parole order in force immediately before the commencing\nday, continues in force, with effect from the commencing day:\n(a) as if it had been made under section 19AL of the Principal Act as\namended by this Act; and\n(b) if the period of the parole order exceeds 5 years—as if the parole\nperiod ended on the commencing day or 5 years after the licence\nwas granted, whichever happens last.\nParole orders revoked or cancelled under Commonwealth Prisoners Act\n1967 before commencing day",
      "skos:definition": "A parole order made under section 5 of the Commonwealth Prisoners\nAct 1967, being a parole order in force immediately before the commencing\nday, continues in force, with effect from the commencing day:\n(a) as if it had been made under section 19AL of the Principal Act as\namended by this Act; and\n(b) if the period of the parole order exceeds 5 years—as if the parole\nperiod ended on the commencing day or 5 years after the licence\nwas granted, whichever happens last.\nParole orders revoked or cancelled under Commonwealth Prisoners Act\n1967 before commencing day",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-31-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-31-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2926a779b1675044d2f62ee3c09f43cdaa7e443b2ab8d4596a8a82c0ddd05324",
      "skos:note": "Parole order continues in force with effect from commencing day."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Section 31",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "A parole order made under section 5 of the Commonwealth Prisoners\nAct 1967, being a parole order in force immediately before the commencing\nday, continues in force, with effect from the commencing day:\n(a) as if it had been made under section 19AL of the Principal Act as\namended by this Act; and\n(b) if the period of the parole order exceeds 5 years—as if the parole\nperiod ended on the commencing day or 5 years after the licence\nwas granted, whichever happens last.\nParole orders revoked or cancelled under Commonwealth Prisoners Act\n1967 before commencing day"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-31-norm",
      "@type": "values:Obligation",
