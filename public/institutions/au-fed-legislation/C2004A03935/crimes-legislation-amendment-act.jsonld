    {
      "@id": "concept:crimes-legislation-amendment-act-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Section 5",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-5"
