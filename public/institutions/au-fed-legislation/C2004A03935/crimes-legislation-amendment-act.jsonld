    {
      "@id": "concept:crimes-legislation-amendment-act-sec-30-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "30(3) Section 30",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-30-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.62",
      "values:originalText": "(3) Where the term of a sentence of imprisonment in respect of which\na lesser term of imprisonment was fixed under section 4 of the\nCommonwealth Prisoners Act 1967, or the aggregate term of a number of\nsentences of imprisonment in respect of which lesser terms of imprisonment\nwere fixed under that section, is 3 years or less, then, for the purpose of the\napplication of the provisions of the Principal Act as amended by this Act,\nthat term, or the aggregate of those terms, as the case requires, is to be\ntaken to be more than 3 years but less than 10 years.",
      "skos:definition": "(3) Where the term of a sentence of imprisonment in respect of which\na lesser term of imprisonment was fixed under section 4 of the\nCommonwealth Prisoners Act 1967, or the aggregate term of a number of\nsentences of imprisonment in respect of which lesser terms of imprisonment\nwere fixed under that section, is 3 years or less, then, for the purpose of the\napplication of the provisions of the Principal Act as amended by this Act,\nthat term, or the aggregate of those terms, as the case requires, is to be\ntaken to be more than 3 years but less than 10 years.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-act-sec-30"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-30-ss-3-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-30-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1f6989263be559ea9f79ca403df6935f139c5ef1eb6f5febd49b438f3f38fc49",
      "skos:note": "Adjusts sentence length for application of provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-30-ss-3",
      "@type": "cof:Section",
      "cof:title": "30(3) Section 30",
      "values:kind": "subsection",
      "cof:pageNumber": 62,
      "values:originalText": "(3) Where the term of a sentence of imprisonment in respect of which\na lesser term of imprisonment was fixed under section 4 of the\nCommonwealth Prisoners Act 1967, or the aggregate term of a number of\nsentences of imprisonment in respect of which lesser terms of imprisonment\nwere fixed under that section, is 3 years or less, then, for the purpose of the\napplication of the provisions of the Principal Act as amended by this Act,\nthat term, or the aggregate of those terms, as the case requires, is to be\ntaken to be more than 3 years but less than 10 years."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-30-ss-3-norm",
