    {
      "@id": "concept:crimes-legislation-amendment-act-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Section 11",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-11"
