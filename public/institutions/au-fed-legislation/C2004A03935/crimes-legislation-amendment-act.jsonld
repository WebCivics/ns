      "cml:integrityHash": "2dd55b3a9dda6b31f21c3978f8f1e48df267d75a3759055b72df0821db75ee0c",
      "skos:note": "Imposes an obligation on the State to pass a sentence of imprisonment for federal offences, unless exceptional circumstances warrant it."
    },
