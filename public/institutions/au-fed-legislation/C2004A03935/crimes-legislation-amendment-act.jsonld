      },
      "cml:operator": "permission",
      "cml:logicSummary": "The Director of Public Prosecutions has permission to appeal against reductions in sentence or non-parole period if the offender fails to cooperate.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
