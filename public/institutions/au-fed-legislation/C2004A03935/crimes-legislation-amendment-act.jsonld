      },
      "cml:premiseText": "The offender undertook to cooperate with law enforcement agencies.",
      "cml:conclusionText": "The Director of Public Prosecutions may appeal."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-19-logic-descriptionlogic-2",
