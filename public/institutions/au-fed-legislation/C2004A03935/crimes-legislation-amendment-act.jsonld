      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-28-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "28(2) Section 28",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-28-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.60",
      "values:originalText": "(2) Subject to subsection (4), if a non-parole period is fixed as a result\nof an application under paragraph (1) (a), that non-parole period is to be\ntreated as having commenced on the commencement of the sentence of life\nimprisonment and is not to be such as would render the person concerned\neligible to be released on parole before the commencing day.",
      "skos:definition": "(2) Subject to subsection (4), if a non-parole period is fixed as a result\nof an application under paragraph (1) (a), that non-parole period is to be\ntreated as having commenced on the commencement of the sentence of life\nimprisonment and is not to be such as would render the person concerned\neligible to be released on parole before the commencing day.",
