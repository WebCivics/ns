    {
      "@id": "concept:crimes-legislation-amendment-act-sec-46",
      "@type": "cml:Concept",
      "skos:prefLabel": "46 Section 46",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-46"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.70",
      "values:originalText": "Section 25 of the Principal Act is amended by inserting after\nparagraph (1) (b) the following paragraph:\n“(ba) a person engaged under section 40a;”.\n\nCrimes Legislation Amendment (No. 2)\nNo. 4, 1990\nAccess to CTR information",
      "skos:definition": "Section 25 of the Principal Act is amended by inserting after\nparagraph (1) (b) the following paragraph:\n“(ba) a person engaged under section 40a;”.\n\nCrimes Legislation Amendment (No. 2)\nNo. 4, 1990\nAccess to CTR information",
      "cml:asserts": [
