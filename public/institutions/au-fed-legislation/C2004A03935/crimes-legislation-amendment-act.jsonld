    {
      "@id": "concept:crimes-legislation-amendment-act-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Section 15",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
