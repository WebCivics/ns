    {
      "@id": "concept:crimes-legislation-amendment-act-sec-44",
      "@type": "cml:Concept",
      "skos:prefLabel": "44 Section 44",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-44"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.69",
      "values:originalText": "Section 21 of the Principal Act is amended:\n(a) by omitting from subsection (1) “statutory declaration by an\nacceptable referee” and substituting “written reference by an\nacceptable referee, signed by the referee and”;\n(b) by omitting from paragraphs (1) (a) and (b) “declaration” and\nsubstituting “reference”;\n(c) by omitting from subsection (3) “a declaration by the referee to the\neffect that the statement” and substituting “a statement by the\nreferee to the effect that the reference”;\n(d) by inserting after subsection (3) the following subsection:\n“(3A) An acceptable referee, or any other person, must not,\nknowingly or recklessly:\n(a) make a statement in an identification reference that is false\nor misleading in a material particular; or\n\nCrimes Legislation Amendment (No. 2)\nNo. 4, 1990\n(b) omit from an identification reference any matter or thing\nwithout which the reference is misleading in a material\nparticular.\nPenalty: $10,000 or imprisonment for 4 years, or both.”.\nCash dealer to keep documents",
      "skos:definition": "Section 21 of the Principal Act is amended:\n(a) by omitting from subsection (1) “statutory declaration by an\nacceptable referee” and substituting “written reference by an\nacceptable referee, signed by the referee and”;\n(b) by omitting from paragraphs (1) (a) and (b) “declaration” and\nsubstituting “reference”;\n(c) by omitting from subsection (3) “a declaration by the referee to the\neffect that the statement” and substituting “a statement by the\nreferee to the effect that the reference”;\n(d) by inserting after subsection (3) the following subsection:\n“(3A) An acceptable referee, or any other person, must not,\nknowingly or recklessly:\n(a) make a statement in an identification reference that is false\nor misleading in a material particular; or\n\nCrimes Legislation Amendment (No. 2)\nNo. 4, 1990\n(b) omit from an identification reference any matter or thing\nwithout which the reference is misleading in a material\nparticular.\nPenalty: $10,000 or imprisonment for 4 years, or both.”.\nCash dealer to keep documents",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-44-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-44-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-44-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-44-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "f2839fcec757646b16b87e1567cdffe86cba25f9e26cbb066c88e5e4d45d4baa",
      "skos:note": "Making false or misleading statements in identification references is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-44",
      "@type": "cof:Section",
      "cof:title": "44 Section 44",
      "values:kind": "section",
      "cof:pageNumber": 69,
      "values:originalText": "Section 21 of the Principal Act is amended:\n(a) by omitting from subsection (1) “statutory declaration by an\nacceptable referee” and substituting “written reference by an\nacceptable referee, signed by the referee and”;\n(b) by omitting from paragraphs (1) (a) and (b) “declaration” and\nsubstituting “reference”;\n(c) by omitting from subsection (3) “a declaration by the referee to the\neffect that the statement” and substituting “a statement by the\nreferee to the effect that the reference”;\n(d) by inserting after subsection (3) the following subsection:\n“(3A) An acceptable referee, or any other person, must not,\nknowingly or recklessly:\n(a) make a statement in an identification reference that is false\nor misleading in a material particular; or\n\nCrimes Legislation Amendment (No. 2)\nNo. 4, 1990\n(b) omit from an identification reference any matter or thing\nwithout which the reference is misleading in a material\nparticular.\nPenalty: $10,000 or imprisonment for 4 years, or both.”.\nCash dealer to keep documents"
    },
