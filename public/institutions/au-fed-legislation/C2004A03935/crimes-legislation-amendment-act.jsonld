      "cml:logicSummary": "Recognizes the treatment of multiple orders as a single order by AI systems",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
