        }
      ],
      "cml:integrityHash": "b52335d78c7ae1339087eef9c34e43d57cdfb3d3b905288f0372520e5122db63",
      "skos:note": "Repeal of Commonwealth Prisoners Act 1967"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Section 29",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "The Commonwealth Prisoners Act 1967 is repealed.\nLesser terms of imprisonment fixed under Commonwealth Prisoners Act\n1967 before commencing day\n'"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-29-norm",
      "@type": "values:Undertaking",
