      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-17-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If a person fails to pay, they are not imprisoned.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Failure to pay",
      "cml:conclusionText": "No imprisonment"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-17-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "The obligation is until the payment is made.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Payment not made",
      "cml:conclusionText": "No imprisonment"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Section 18",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.56",
      "values:originalText": "Section 21D of the Principal Act is amended by adding at the end\nthe following subsection:\n“(2) This Part does not affect the operation of any other law of the\nCommonwealth, or of any law in force in a Territory, relating to the release\nof offenders.”.",
      "skos:definition": "Section 21D of the Principal Act is amended by adding at the end\nthe following subsection:\n“(2) This Part does not affect the operation of any other law of the\nCommonwealth, or of any law in force in a Territory, relating to the release\nof offenders.”.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-18-norm"
        }
      ],
      "cml:integrityHash": "40f2022d8f82650d9ba20b5b437a1de51260d0deb91edd350982ba543e93dbdc",
      "skos:note": "Amends Section 21D of the Principal Act to preserve operation of other laws."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Section 18",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "Section 21D of the Principal Act is amended by adding at the end\nthe following subsection:\n“(2) This Part does not affect the operation of any other law of the\nCommonwealth, or of any law in force in a Territory, relating to the release\nof offenders.”."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-18-norm",
