    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.26",
      "skos:note": "Any State that is not a Contracting State to the Convention may ratify this Protocol if at the same time it ratifies or accedes to the Convention in accordance with Article 15 thereof.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "2 Section 2"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-act-1991.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-norm",
        "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-deontic-1",
        "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-alleninterval-2",
        "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-argumentation-3",
        "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-diffusion-4",
        "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "583dcda323cc262a831fc6f590921a13fbd9b56ec73f0fe7ac957afad6298a01",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-legislation-amendment-act-1991#sch-1-sec-2-2",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The State meets at the same time as the Convention.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relationship between ratification and accession",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "MeetsAt",
      "cml:premiseText": "The State ratifies or accedes to the Convention at the same time."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The State accedes to the Convention if it ratifies the Protocol.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Ratification of Protocol implies accession to Convention",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "If the State ratifies the Protocol, then it accedes to the Convention."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The State is recognized as having ratified the Protocol and acceded to the Convention.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "State recognizes its own ratification and accession",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "The State recognizes its own ratification and accession."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The State is permitted to ratify the Protocol.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permission to ratify the Protocol",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:premiseText": "The State may ratify the Protocol."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The State's accession to the Convention is diffused from its ratification of the Protocol.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
