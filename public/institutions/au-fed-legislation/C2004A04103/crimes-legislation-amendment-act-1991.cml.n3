doc:sec-73-ss-1 a cof:Section ;
    cof:title "73(1) Section 73" ;
    values:kind "subsection" ;
    values:originalText "(1) The section 34 declaration in force immediately before the commencing day continues to have effect on and after that day as if: (a) it had been made under section 34 of the Principal Act, as amended by this Act; and (b) it declared the New South Wales Crime Commission to be an agency for the purposes of the Principal Act as so amended.  Crimes Legislation Amendment No. 28, 1991" ;
    cof:pageNumber "23"^^xsd:integer .

concept:crimes-legislation-amendment-act-1991-sec-73-ss-2 a cml:Concept ;
    skos:prefLabel "73(2) Section 73"@en ;
    cml:realizedBy doc:sec-73-ss-2 ;
    values:originalText "(2) Any warrant or other document given or issued under the Principal Act, and in force immediately before the commencing day, continues to have effect on and after that day as if it had been given or issued under the Principal Act, as amended by this Act, and for that purpose: (a) references in the warrant or document to the State Drug Crime Commission of New South Wales are taken to be references to the New South Wales Crime Commission; and (b) references in the warrant or document to the chief officer or Chairperson of the State Drug Crime Commission of New South Wales are taken to be references to the chief officer or Chairperson of the New South Wales Crime Commission; and (c) references in the warrant or document to a member, or member of the staff, of the State Drug Crime Commission of New South Wales are taken to be references to a member, or member of the staff, of the New South Wales Crime Commission." ;
    skos:definition "(2) Any warrant or other document given or issued under the Principal Act, and in force immediately before the commencing day, continues to have effect on and after that day as if it had been given or issued under the Principal Act, as amended by this Act, and for that purpose: (a) references in the warrant or document to the State Drug Crime Commission of New South Wales are taken to be references to the New South Wales Crime Commission; and (b) references in the warrant or document to the chief officer or Chairperson of the State Drug Crime Commission of New South Wales are taken to be references to the chief officer or Chairperson of the New South Wales Crime Commission; and (c) references in the warrant or document to a member, or member of the staff, of the State Drug Crime Commission of New South Wales are taken to be references to a member, or member of the staff, of the New South Wales Crime Commission."@en ;
    cml:integrityHash "459ca1f0623e6c4552533d7385be975125320ff45242ed77bf5505e82c772ee9" ;
    values:partOf concept:crimes-legislation-amendment-act-1991-sec-73 ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "References to State Drug Crime Commission of New South Wales are updated to refer to New South Wales Crime Commission." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-act-1991.pdf> ;
    dc:source "crimes-legislation-amendment-act-1991.pdf, p.23" ;
    cml:asserts concept:crimes-legislation-amendment-act-1991-sec-73-ss-2-norm .
