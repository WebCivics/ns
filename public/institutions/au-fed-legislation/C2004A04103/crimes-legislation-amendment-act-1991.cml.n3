concept:crimes-legislation-amendment-act-1991-sec-21 a cml:Concept ;
    skos:prefLabel "21 Section 21"@en ;
    cml:realizedBy doc:sec-21 ;
    values:originalText "Section 16 of the Principal Act is amended: (a) by inserting \", a customs officer (other than the ComptrollerGeneral of Customs)\" after \"an AFP member\" in the definition of \"investigating officer\" in subsection (6); (b) by adding at the end of paragraphs (a) and (c) of the definition of \"relevant authority\" in subsection (6) \"or\"; (c) by adding at the end of the definition of \"relevant authority\" in subsection (6) the following paragraph: \"(d) the Comptroller-General of Customs;\". Special provisions in relation to reports of suspect transactions" ;
    skos:definition "Section 16 of the Principal Act is amended: (a) by inserting \", a customs officer (other than the ComptrollerGeneral of Customs)\" after \"an AFP member\" in the definition of \"investigating officer\" in subsection (6); (b) by adding at the end of paragraphs (a) and (c) of the definition of \"relevant authority\" in subsection (6) \"or\"; (c) by adding at the end of the definition of \"relevant authority\" in subsection (6) the following paragraph: \"(d) the Comptroller-General of Customs;\". Special provisions in relation to reports of suspect transactions"@en ;
    cml:integrityHash "7c6b417ec095ce70d050a23c248ac2ff41586f4c3eb9d14b3e9aafeb6a48bf98" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Amends definition of \"investigating officer\" and adds \"Comptroller-General of Customs\"" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-act-1991.pdf> ;
