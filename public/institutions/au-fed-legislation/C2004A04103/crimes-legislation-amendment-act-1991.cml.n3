concept:crimes-legislation-amendment-act-1991-sec-1-2 a cml:Concept ;
    skos:prefLabel "1 Section 1"@en ;
    cml:realizedBy doc:sec-1-2 ;
    values:originalText "In Article 1 of the Convention, the following shall be added as new paragraph 1 bis: \"1 bis. Any person commits an offence if he unlawfully and intentionally, using any device, substance or weapon:  Crimes Legislation Amendment No. 28, 1991" ;
