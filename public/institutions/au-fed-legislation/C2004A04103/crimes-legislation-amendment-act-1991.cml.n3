concept:crimes-legislation-amendment-act-1991-sec-73-ss-4 a cml:Concept ;
    skos:prefLabel "73(4) Section 73"@en ;
    cml:realizedBy doc:sec-73-ss-4 ;
    values:originalText "(4) In this section: \"commencing day\" means the day on which subsection 61 (2) of this Act commences; \"section 34 declaration\" means a declaration made under section 34 of the Principal Act declaring the State Drug Crime Commission of New South Wales to be an agency for the purposes of that Act." ;
    skos:definition "(4) In this section: \"commencing day\" means the day on which subsection 61 (2) of this Act commences; \"section 34 declaration\" means a declaration made under section 34 of the Principal Act declaring the State Drug Crime Commission of New South Wales to be an agency for the purposes of that Act."@en ;
    cml:integrityHash "b00574bf66bdf1655fccf78d6addd3e67d787a2250aa15fd7e8ab26f94911431" ;
