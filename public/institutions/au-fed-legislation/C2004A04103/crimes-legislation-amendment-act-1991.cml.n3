concept:crimes-legislation-amendment-act-1991-sec-73-ss-3 a cml:Concept ;
    skos:prefLabel "73(3) Section 73"@en ;
    cml:realizedBy doc:sec-73-ss-3 ;
    values:originalText "(3) This section does not prevent the Minister from revoking under section 37 of the Principal Act, as amended by this Act, a declaration to which subsection (1) of this section applies." ;
    skos:definition "(3) This section does not prevent the Minister from revoking under section 37 of the Principal Act, as amended by this Act, a declaration to which subsection (1) of this section applies."@en ;
