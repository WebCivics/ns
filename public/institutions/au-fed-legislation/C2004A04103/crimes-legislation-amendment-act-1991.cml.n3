concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-5 a cml:Concept ;
    skos:prefLabel "1 Section 1"@en ;
    cml:realizedBy doc:sch-1-sec-1-5 ;
    values:originalText "The Depositaries shall promptly inform all signatory and acceding States to this Protocol and all signatory and acceding States to the Convention: (a) of the date of each signature and the date of deposit of each instrument of ratification of, or accession to, this Protocol, and (b) of the receipt of any notification of denunciation of this Protocol and the date thereof.  Crimes Legislation Amendment No. 28, 1991" ;
    skos:definition "The Depositaries shall promptly inform all signatory and acceding States to this Protocol and all signatory and acceding States to the Convention: (a) of the date of each signature and the date of deposit of each instrument of ratification of, or accession to, this Protocol, and (b) of the receipt of any notification of denunciation of this Protocol and the date thereof.  Crimes Legislation Amendment No. 28, 1991"@en ;
    cml:integrityHash "f71d08299fc8ae069bc34f40b367d4d94fade8c207d4c2fa2fe0593e556d9f6e" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "States must inform other States of certain events." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-act-1991.pdf> ;
    dc:source "crimes-legislation-amendment-act-1991.pdf, p.27" ;
