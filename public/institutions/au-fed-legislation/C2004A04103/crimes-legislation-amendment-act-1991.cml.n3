doc:sch-1-sec-2-3 a cof:Section ;
    cof:title "2 Section 2" ;
    values:kind "section" ;
    values:originalText "As soon as this Protocol enters into force, it shall be registered by the Depositaries pursuant to Article 102 of the Charter of the United Nations and pursuant to Article 83 of the Convention on International Civil Aviation (Chicago, 1944). Article VII" ;
    cof:pageNumber "27"^^xsd:integer .

