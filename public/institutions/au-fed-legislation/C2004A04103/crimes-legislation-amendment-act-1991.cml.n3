concept:crimes-legislation-amendment-act-1991-sec-5 a cml:Concept ;
    skos:prefLabel "5 Section 5"@en ;
    cml:realizedBy doc:sec-5 ;
    values:originalText "Section 9 of the Principal Act is amended: (a) by adding at the end of paragraph (1) (a) \"and\";  Crimes Legislation Amendment No. 28, 1991 (b) by inserting after paragraph (l)(ba) the following paragraph: \"(bb) when performing functions in an External Territory— the powers and duties conferred or imposed on a constable or an officer of police by or under any law (including the common law) of the Territory; and\". Commissioner and Deputy Commissioner" ;
    skos:definition "Section 9 of the Principal Act is amended: (a) by adding at the end of paragraph (1) (a) \"and\";  Crimes Legislation Amendment No. 28, 1991 (b) by inserting after paragraph (l)(ba) the following paragraph: \"(bb) when performing functions in an External Territory— the powers and duties conferred or imposed on a constable or an officer of police by or under any law (including the common law) of the Territory; and\". Commissioner and Deputy Commissioner"@en ;
    cml:integrityHash "ee88ae0b6c9b3f2e0468d0d4bf25f03fe8256c64635f152e526e919f93afe665" ;
    cof:pageNumber "5"^^xsd:integer ;
    skos:note "Add \"and\" at end of paragraph (1) and insert new paragraph (bb)" ;
    cml:curationStatus cml:Proposed ;
