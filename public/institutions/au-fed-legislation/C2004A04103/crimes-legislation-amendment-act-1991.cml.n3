concept:crimes-legislation-amendment-act-1991-sec-30 a cml:Concept ;
    skos:prefLabel "30 Section 30"@en ;
    cml:realizedBy doc:sec-30 ;
    values:originalText "Section 85ZL of the Principal Act is amended: (a) by inserting after paragraph (b) of the definition of \"law enforcement agency\" the following paragraph: \"(ba) the Australian Customs Service;\"; (b) by omitting paragraph (g) of the definition of \"law enforcement agency\" and substituting the following paragraph: \"(g) the New South Wales Crime Commission established under the New South Wales Crime Commission Act 1985 of New South Wales, or a similar body established under a law of another State;\"; (c) by omitting \"85ZP\" from the definition of \"spent\" and substituting \"85ZM\".  Crimes Legislation Amendment No. 28, 1991" ;
    skos:definition "Section 85ZL of the Principal Act is amended: (a) by inserting after paragraph (b) of the definition of \"law enforcement agency\" the following paragraph: \"(ba) the Australian Customs Service;\"; (b) by omitting paragraph (g) of the definition of \"law enforcement agency\" and substituting the following paragraph: \"(g) the New South Wales Crime Commission established under the New South Wales Crime Commission Act 1985 of New South Wales, or a similar body established under a law of another State;\"; (c) by omitting \"85ZP\" from the definition of \"spent\" and substituting \"85ZM\".  Crimes Legislation Amendment No. 28, 1991"@en ;
    cml:integrityHash "41e39e892b0fcb9088de9560c085c7162abde75ce3dc40f3b14aa455d5a9b60a" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Amends definition of law enforcement agency and spent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
