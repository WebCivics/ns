    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sch-1-sec-1-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act-1991.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.27",
      "values:originalText": "The Depositaries shall promptly inform all signatory and acceding\nStates to this Protocol and all signatory and acceding States to the\nConvention:\n(a) of the date of each signature and the date of deposit of each\ninstrument of ratification of, or accession to, this Protocol, and\n(b) of the receipt of any notification of denunciation of this Protocol\nand the date thereof.\n\nCrimes Legislation Amendment\nNo. 28, 1991",
      "skos:definition": "The Depositaries shall promptly inform all signatory and acceding\nStates to this Protocol and all signatory and acceding States to the\nConvention:\n(a) of the date of each signature and the date of deposit of each\ninstrument of ratification of, or accession to, this Protocol, and\n(b) of the receipt of any notification of denunciation of this Protocol\nand the date thereof.\n\nCrimes Legislation Amendment\nNo. 28, 1991",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-5-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f71d08299fc8ae069bc34f40b367d4d94fade8c207d4c2fa2fe0593e556d9f6e",
      "skos:note": "States must inform other States of certain events."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sch-1-sec-1-5",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "The Depositaries shall promptly inform all signatory and acceding\nStates to this Protocol and all signatory and acceding States to the\nConvention:\n(a) of the date of each signature and the date of deposit of each\ninstrument of ratification of, or accession to, this Protocol, and\n(b) of the receipt of any notification of denunciation of this Protocol\nand the date thereof.\n\nCrimes Legislation Amendment\nNo. 28, 1991"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "States have a duty to inform other States.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Section 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sch-1-sec-2-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act-1991.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.28",
      "values:originalText": "The Depositaries shall also notify the States referred to in\nparagraph 1 of the date on which this Protocol enters into force in\naccordance with Article VI.\nIN WITNESS WHEREOF the undersigned Plenipotentiaries, being\nduly authorized thereto by their Governments, have signed this Protocol.\nDONE at Montreal on the twenty-fourth day of February of the\nyear One Thousand Nine Hundred and Eighty-eight, in four originals,\neach being drawn up in four authentic texts in the English, French,\nRussian and Spanish languages.\nSCHEDULE 2\nSection 74\nAMENDMENTS OF OTHER ACTS",
      "skos:definition": "The Depositaries shall also notify the States referred to in\nparagraph 1 of the date on which this Protocol enters into force in\naccordance with Article VI.\nIN WITNESS WHEREOF the undersigned Plenipotentiaries, being\nduly authorized thereto by their Governments, have signed this Protocol.\nDONE at Montreal on the twenty-fourth day of February of the\nyear One Thousand Nine Hundred and Eighty-eight, in four originals,\neach being drawn up in four authentic texts in the English, French,\nRussian and Spanish languages.\nSCHEDULE 2\nSection 74\nAMENDMENTS OF OTHER ACTS",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-2-6-norm"
        }
      ],
      "cml:integrityHash": "5b356a88c742be6ce7163861d340ad0bd763db8471b54d9c7019c974c5c0b13d",
      "skos:note": "Notification of States on Protocol entry into force date"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sch-1-sec-2-6",
      "@type": "cof:Section",
      "cof:title": "2 Section 2",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "The Depositaries shall also notify the States referred to in\nparagraph 1 of the date on which this Protocol enters into force in\naccordance with Article VI.\nIN WITNESS WHEREOF the undersigned Plenipotentiaries, being\nduly authorized thereto by their Governments, have signed this Protocol.\nDONE at Montreal on the twenty-fourth day of February of the\nyear One Thousand Nine Hundred and Eighty-eight, in four originals,\neach being drawn up in four authentic texts in the English, French,\nRussian and Spanish languages.\nSCHEDULE 2\nSection 74\nAMENDMENTS OF OTHER ACTS"
    },
