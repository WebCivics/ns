      "@id": "concept:crimes-legislation-amendment-act-1991-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Section 61",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-61"
