      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.7",
      "values:originalText": "Section 28 of the Principal Act is amended:\n(a) by omitting from subsection (2) \"under Division 1\" and\nsubstituting \"as the Commissioner\";\n(b) by inserting after subsection (2) the following subsection:\n\"(2A) A person appointed as a Deputy Commissioner must,\nbefore starting to perform his or her duties, take or make the\nprescribed oath or affirmation before the Commissioner.\";\n(c) by omitting from subsection (3) \"a person authorized by the\nMinister\" and substituting \"the Commissioner or a person\nauthorised by the Commissioner\".\nSpecial leave of absence",
      "skos:definition": "Section 28 of the Principal Act is amended:\n(a) by omitting from subsection (2) \"under Division 1\" and\nsubstituting \"as the Commissioner\";\n(b) by inserting after subsection (2) the following subsection:\n\"(2A) A person appointed as a Deputy Commissioner must,\nbefore starting to perform his or her duties, take or make the\nprescribed oath or affirmation before the Commissioner.\";\n(c) by omitting from subsection (3) \"a person authorized by the\nMinister\" and substituting \"the Commissioner or a person\nauthorised by the Commissioner\".\nSpecial leave of absence",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-13-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "74c41eeb33fa30f19cdab3ade5939f06631a8b1c0217cbfe024e61cce62adb6e",
      "skos:note": "A person appointed as a Deputy Commissioner must take or make the prescribed oath or affirmation before starting to perform their duties."
    },
