    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Section 7",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-7"
      },
