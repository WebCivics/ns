    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-23-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 September 1971, to deal with such unlawful acts of violence at",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-23-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
