          "@id": "concept:crimes-legislation-amendment-act-1991-sec-18-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "ed60a7a1ca61d4db68c4b7f83b5382bb17d83e9800a65a7499e38c700b5ae302",
      "skos:note": "Review by Merit Protection and Review Agency in certain other cases"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-18",
