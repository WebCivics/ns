    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
