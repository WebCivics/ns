    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-1-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-1-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act-1991.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.25",
      "values:originalText": "In Article 1 of the Convention, the following shall be added as\nnew paragraph 1 bis:\n\"1 bis. Any person commits an offence if he unlawfully and\nintentionally, using any device, substance or weapon:\n\nCrimes Legislation Amendment\nNo. 28, 1991",
      "skos:definition": "In Article 1 of the Convention, the following shall be added as\nnew paragraph 1 bis:\n\"1 bis. Any person commits an offence if he unlawfully and\nintentionally, using any device, substance or weapon:\n\nCrimes Legislation Amendment\nNo. 28, 1991",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-1-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-1-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "20068eb8e77a04d526c75f7e083b58395264fa9c2ce4639bd20c49b2b3709ec5",
      "skos:note": "Unlawful use of devices, substances or weapons is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-1-2",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "In Article 1 of the Convention, the following shall be added as\nnew paragraph 1 bis:\n\"1 bis. Any person commits an offence if he unlawfully and\nintentionally, using any device, substance or weapon:\n\nCrimes Legislation Amendment\nNo. 28, 1991"
    },
