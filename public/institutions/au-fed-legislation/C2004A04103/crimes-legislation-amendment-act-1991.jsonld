    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Section 12",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
