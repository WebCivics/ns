    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Section 32",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act-1991.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.13",
      "values:originalText": "The title of the Principal Act is repealed and the following title\nis substituted:\n\"An Act to approve Australia's ratification of the Convention for the\nSuppression of Unlawful Acts against the Safety of Civil Aviation, and\nits accession to the supplementary Protocol, and to give effect to the\nConvention and the Protocol, and to create certain offences relating to\nunlawful acts against the safety of civil aviation and to acts of violence\nat airports\".\nInterpretation",
      "skos:definition": "The title of the Principal Act is repealed and the following title\nis substituted:\n\"An Act to approve Australia's ratification of the Convention for the\nSuppression of Unlawful Acts against the Safety of Civil Aviation, and\nits accession to the supplementary Protocol, and to give effect to the\nConvention and the Protocol, and to create certain offences relating to\nunlawful acts against the safety of civil aviation and to acts of violence\nat airports\".\nInterpretation",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-32-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ce3f53a2dea24b7199b377b6ae29967a6e1586549a9f2e2adf047bf3977a4d3d",
      "skos:note": "Repeals title and substitutes new title for Principal Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Section 32",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "The title of the Principal Act is repealed and the following title\nis substituted:\n\"An Act to approve Australia's ratification of the Convention for the\nSuppression of Unlawful Acts against the Safety of Civil Aviation, and\nits accession to the supplementary Protocol, and to give effect to the\nConvention and the Protocol, and to create certain offences relating to\nunlawful acts against the safety of civil aviation and to acts of violence\nat airports\".\nInterpretation"
    },
