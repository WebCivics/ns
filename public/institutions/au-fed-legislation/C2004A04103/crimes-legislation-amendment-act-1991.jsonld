      "@type": "cml:Concept",
      "skos:prefLabel": "27 After section 4K of the Principal Act the following section is",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-27"
      },
      "cml:curationStatus": {
