    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sch-1-sec-1-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
