    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Section 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-2"
      },
      "cml:curationStatus": {
