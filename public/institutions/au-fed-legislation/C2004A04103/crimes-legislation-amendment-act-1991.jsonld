    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Section 33",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act-1991.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.13",
      "values:originalText": "Section 3 of the Principal Act is amended:\n(a) by omitting \"the Schedule\" from the definition of \"Convention\"\nin subsection (1) and substituting \"Schedule 1\";\n(b) by inserting \"or 7 (2A) (a)\" after \"7 (2) (a)\" in the definition of\n\"Convention offence\" in subsection (1);\n(c) by inserting in subsection (1) the following definition:\n\" 'Protocol' means the Protocol for the Suppression of Unlawful\nActs of Violence at Airports Serving International Civil Aviation,\nSupplementary to the Convention for the Suppression of\nUnlawful Acts against the Safety of Civil Aviation, being the\nProtocol the English text of which is set out in Schedule 2;\".\nApproval of ratification of Convention and accession to Protocol",
      "skos:definition": "Section 3 of the Principal Act is amended:\n(a) by omitting \"the Schedule\" from the definition of \"Convention\"\nin subsection (1) and substituting \"Schedule 1\";\n(b) by inserting \"or 7 (2A) (a)\" after \"7 (2) (a)\" in the definition of\n\"Convention offence\" in subsection (1);\n(c) by inserting in subsection (1) the following definition:\n\" 'Protocol' means the Protocol for the Suppression of Unlawful\nActs of Violence at Airports Serving International Civil Aviation,\nSupplementary to the Convention for the Suppression of\nUnlawful Acts against the Safety of Civil Aviation, being the\nProtocol the English text of which is set out in Schedule 2;\".\nApproval of ratification of Convention and accession to Protocol",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-33-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-33-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-33-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "418ffb2ce1c546b8b1a11fbc199e540af1203b93053ee9375a43c68cb5034111",
      "skos:note": "Amends Section 3 of the Principal Act regarding Convention definitions and Protocol"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Section 33",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Section 3 of the Principal Act is amended:\n(a) by omitting \"the Schedule\" from the definition of \"Convention\"\nin subsection (1) and substituting \"Schedule 1\";\n(b) by inserting \"or 7 (2A) (a)\" after \"7 (2) (a)\" in the definition of\n\"Convention offence\" in subsection (1);\n(c) by inserting in subsection (1) the following definition:\n\" 'Protocol' means the Protocol for the Suppression of Unlawful\nActs of Violence at Airports Serving International Civil Aviation,\nSupplementary to the Convention for the Suppression of\nUnlawful Acts against the Safety of Civil Aviation, being the\nProtocol the English text of which is set out in Schedule 2;\".\nApproval of ratification of Convention and accession to Protocol"
    },
