      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.27",
      "values:originalText": "As soon as ten of the signatory States have deposited their\ninstruments of ratification of this Protocol, it shall enter into force\nbetween them on the thirtieth day after the date of the deposit of the\ntenth instrument of ratification. It shall enter into force for each State\nwhich deposits its instrument of ratification after that date on the\nthirtieth day after the deposit of its instrument of ratification.",
      "skos:definition": "As soon as ten of the signatory States have deposited their\ninstruments of ratification of this Protocol, it shall enter into force\nbetween them on the thirtieth day after the date of the deposit of the\ntenth instrument of ratification. It shall enter into force for each State\nwhich deposits its instrument of ratification after that date on the\nthirtieth day after the deposit of its instrument of ratification.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-2-logic-argumentation-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-2-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sch-1-sec-1-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "0f7e061e19cf0579928509db49bf50ee9b959aad662a5acbd6d777475cac60a7",
      "skos:note": "Protocol enters into force after deposit of tenth instrument of ratification."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sch-1-sec-1-2",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "As soon as ten of the signatory States have deposited their\ninstruments of ratification of this Protocol, it shall enter into force\nbetween them on the thirtieth day after the date of the deposit of the\ntenth instrument of ratification. It shall enter into force for each State\nwhich deposits its instrument of ratification after that date on the\nthirtieth day after the deposit of its instrument of ratification."
    },
