      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act-1991.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.7",
      "values:originalText": "Section 26D of the Principal Act is amended by omitting\nsubsection (4) and substituting the following subsection:\n\"(4) Where:\n(a) a person's appointment ends under section 26E; and\n(b) the person is re-appointed for a term starting immediately after\nthe end of that appointment;\nthe person's service is taken to be continuous.\".\nUndertakings and oaths or affirmations",
      "skos:definition": "Section 26D of the Principal Act is amended by omitting\nsubsection (4) and substituting the following subsection:\n\"(4) Where:\n(a) a person's appointment ends under section 26E; and\n(b) the person is re-appointed for a term starting immediately after\nthe end of that appointment;\nthe person's service is taken to be continuous.\".\nUndertakings and oaths or affirmations",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-12-norm"
        }
      ],
      "cml:integrityHash": "86914c13d93210121f9b1951d18ea503d37752097cb8dc4afd00c6a931e3d72d",
      "skos:note": "Amends section 26D of the Principal Act regarding continuous service upon re-appointment."
    },
    {
