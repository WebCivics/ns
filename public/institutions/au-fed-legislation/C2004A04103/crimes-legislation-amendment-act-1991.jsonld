    {
      "@id": "concept:crimes-legislation-amendment-act-1991-sec-73-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "73(4) Section 73",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-73-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act-1991.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.23",
      "values:originalText": "(4) In this section:\n\"commencing day\" means the day on which subsection 61 (2) of this\nAct commences;\n\"section 34 declaration\" means a declaration made under section 34 of\nthe Principal Act declaring the State Drug Crime Commission of New\nSouth Wales to be an agency for the purposes of that Act.",
      "skos:definition": "(4) In this section:\n\"commencing day\" means the day on which subsection 61 (2) of this\nAct commences;\n\"section 34 declaration\" means a declaration made under section 34 of\nthe Principal Act declaring the State Drug Crime Commission of New\nSouth Wales to be an agency for the purposes of that Act.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-act-1991-sec-73"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-73-ss-4-norm"
        }
      ],
      "cml:integrityHash": "b00574bf66bdf1655fccf78d6addd3e67d787a2250aa15fd7e8ab26f94911431",
      "skos:note": "Definitions for section 73"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act-1991#sec-73-ss-4",
      "@type": "cof:Section",
      "cof:title": "73(4) Section 73",
      "values:kind": "subsection",
      "cof:pageNumber": 23,
      "values:originalText": "(4) In this section:\n\"commencing day\" means the day on which subsection 61 (2) of this\nAct commences;\n\"section 34 declaration\" means a declaration made under section 34 of\nthe Principal Act declaring the State Drug Crime Commission of New\nSouth Wales to be an agency for the purposes of that Act."
    },
