      },
      "dc:source": "crimes-legislation-amendment-act-1991.pdf, p.11",
      "values:originalText": "inserted:\n\nCrimes Legislation Amendment\nNo. 28, 1991\nSpecified defences not to preclude other defences\n\"4L. Where a provision of a law of the Commonwealth provides a\ndefence to a particular offence, the provision does not, unless the\ncontrary intention appears, prevent the use of any defence that is\notherwise available.\".\nSearch warrants",
      "skos:definition": "inserted:\n\nCrimes Legislation Amendment\nNo. 28, 1991\nSpecified defences not to preclude other defences\n\"4L. Where a provision of a law of the Commonwealth provides a\ndefence to a particular offence, the provision does not, unless the\ncontrary intention appears, prevent the use of any defence that is\notherwise available.\".\nSearch warrants",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-1991-sec-27-norm"
        }
      ],
      "cml:integrityHash": "fcf8a4fc2270caffcfaf70400855ec56d83742e2ac7d517e08644fcad9597e18",
      "skos:note": "Provision does not prevent use of other available defences."
    },
