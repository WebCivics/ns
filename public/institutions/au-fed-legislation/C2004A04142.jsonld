        "concept:australian-capital-territory-electoral-amendment-act-1991-sec-11-logic-deontic-1",
        "concept:australian-capital-territory-electoral-amendment-act-1991-sec-11-logic-descriptionlogic-2"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
