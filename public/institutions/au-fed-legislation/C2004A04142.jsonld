    {
      "@id": "concept:australian-capital-territory-electoral-amendment-act-1991-sec-11",
      "@type": "cml:Concept",
      "dc:source": "australian-capital-territory-electoral-amendment-act-1991.pdf, p.3",
      "skos:note": "A voter who is entitled to assistance in casting a declaration vote for the election is entitled to the same assistance in casting a declaration vote for the referendum. Inserts Part 4—Referendum to Choose Electoral System after section 29 of the Principal Act.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "11 Section 11"
      },
      "wasDerivedFrom": "australian-capital-territory-electoral-amendment-act-1991.pdf",
