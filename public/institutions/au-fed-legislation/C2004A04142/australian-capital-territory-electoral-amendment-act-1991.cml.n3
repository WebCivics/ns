concept:australian-capital-territory-electoral-amendment-act-1991-sec-10 a cml:Concept ;
    skos:prefLabel "10 Section 10"@en ;
    cml:realizedBy doc:sec-10 ;
    values:originalText "Section 28 of the Principal Act is amended by adding at the end the following section: \"(4) The regulations may amend, omit or add to the modifications of the Commonwealth Electoral Act 1918 set out in Schedule 1.\"." ;
    skos:definition "Section 28 of the Principal Act is amended by adding at the end the following section: \"(4) The regulations may amend, omit or add to the modifications of the Commonwealth Electoral Act 1918 set out in Schedule 1.\"."@en ;
    cml:integrityHash "93729638786f8c55a963fefe078b2627cb38711c064479f486f2799bb47f7c82" ;
