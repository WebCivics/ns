concept:australian-capital-territory-electoral-amendment-act-1991-sec-6 a cml:Concept ;
    skos:prefLabel "6 Section 6"@en ;
    cml:realizedBy doc:sec-6 ;
    values:originalText "Section 16 of the Principal Act is amended: (a) by inserting in subsection (2) \"and Schedules 2 and 3\" after \"(inclusive)\"; (b) by omitting paragraph (2) (a); (c) by adding at the end of paragraph (6) (b) \"and\"; (d) by omitting from paragraph (6) (c) \"; and\"; (e) by omitting paragraph (6) (d). Voting at general elections" ;
    skos:definition "Section 16 of the Principal Act is amended: (a) by inserting in subsection (2) \"and Schedules 2 and 3\" after \"(inclusive)\"; (b) by omitting paragraph (2) (a); (c) by adding at the end of paragraph (6) (b) \"and\"; (d) by omitting from paragraph (6) (c) \"; and\"; (e) by omitting paragraph (6) (d). Voting at general elections"@en ;
    cml:integrityHash "01702f66749d115a46ffd56e79cfffe5e53681b18aefcf0b4779c0528be25e67" ;
    cof:pageNumber "2"^^xsd:integer ;
    skos:note "Voting at general elections is mandatory." ;
