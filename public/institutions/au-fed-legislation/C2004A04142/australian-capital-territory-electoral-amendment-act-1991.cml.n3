concept:australian-capital-territory-electoral-amendment-act-1991-sec-7 a cml:Concept ;
    skos:prefLabel "7 Section 7"@en ;
    cml:realizedBy doc:sec-7 ;
    values:originalText "Section 18 of the Principal Act is amended by adding at the end the following subsections: \"(2) Paragraph (l)(a) does not prevent the making of special provisions exempting certain persons who are in Antarctica or overseas from the compulsory voting requirement. Note: See section 245 of the Electoral Act. \"(3) Paragraph (l)(b) does not prevent the making of special provisions for persons who are so sight impaired or physically incapaciated or illerate that they cannot vote without assistance. Note: See section 234 of the Electoral Act.' . Counting votes: transfer of preferences of provisionally unsuccessful candidates etc." ;
    skos:definition "Section 18 of the Principal Act is amended by adding at the end the following subsections: \"(2) Paragraph (l)(a) does not prevent the making of special provisions exempting certain persons who are in Antarctica or overseas from the compulsory voting requirement. Note: See section 245 of the Electoral Act. \"(3) Paragraph (l)(b) does not prevent the making of special provisions for persons who are so sight impaired or physically incapaciated or illerate that they cannot vote without assistance. Note: See section 234 of the Electoral Act.' . Counting votes: transfer of preferences of provisionally unsuccessful candidates etc."@en ;
    cml:integrityHash "56ce45913d9f1bf476ff1e2e7f874d67828a060ea3e60678775cf446d92b326d" ;
    cof:pageNumber "2"^^xsd:integer ;
    skos:note "Exemptions from compulsory voting requirement" ;
    dc:references "sec-245" ;
    dc:references "sec-234" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-electoral-amendment-act-1991.pdf> ;
    dc:source "australian-capital-territory-electoral-amendment-act-1991.pdf, p.2" ;
