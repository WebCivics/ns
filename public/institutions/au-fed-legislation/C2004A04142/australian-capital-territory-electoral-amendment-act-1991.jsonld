        }
      ],
      "cml:integrityHash": "7aa28405b3785f727b01ff2a5e81ca107529ade287fa539fa5d2f3ff83853694",
      "skos:note": "Add Schedules 5 and 6 of this Act to the Principal Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-electoral-amendment-act-1991#sec-13",
