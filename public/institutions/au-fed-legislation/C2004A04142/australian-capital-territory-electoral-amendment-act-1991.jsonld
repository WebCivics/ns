    {
      "@id": "concept:australian-capital-territory-electoral-amendment-act-1991-sec-14-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "14(3) Section 14",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-electoral-amendment-act-1991#sec-14-ss-3"
      },
      "cml:curationStatus": {
