      "cml:integrityHash": "b26189b390b2fc65f4d2873bb803202bd2f3432622e811c3c34be7333f9e5dea",
      "skos:note": "Commission must inform a registered officer of terms within a certain timeframe. Registered officer must be registered after notice period.",
      "dc:description": "Notice in writing"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-electoral-amendment-act-1991#sec-15-ss-1",
      "@type": "cof:Section",
      "cof:title": "15(1) Section 15",
      "values:kind": "subsection",
