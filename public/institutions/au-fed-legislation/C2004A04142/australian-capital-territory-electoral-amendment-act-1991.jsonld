    {
      "@id": "concept:australian-capital-territory-electoral-amendment-act-1991-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Section 10",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-electoral-amendment-act-1991#sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
