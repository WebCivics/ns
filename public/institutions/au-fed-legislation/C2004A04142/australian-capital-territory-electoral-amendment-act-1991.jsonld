          "@id": "concept:australian-capital-territory-electoral-amendment-act-1991-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "56ce45913d9f1bf476ff1e2e7f874d67828a060ea3e60678775cf446d92b326d",
      "skos:note": "Exemptions from compulsory voting requirement",
