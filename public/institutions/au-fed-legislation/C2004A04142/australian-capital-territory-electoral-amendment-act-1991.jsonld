    {
      "@id": "concept:australian-capital-territory-electoral-amendment-act-1991-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Section 13",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-electoral-amendment-act-1991#sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
