      },
      "dc:source": "australian-capital-territory-electoral-amendment-act-1991.pdf, p.3",
      "values:originalText": "Section 28 of the Principal Act is amended by adding at the\nend the following section:\n\"(4) The regulations may amend, omit or add to the modifications\nof the Commonwealth Electoral Act 1918 set out in Schedule 1.\".",
      "skos:definition": "Section 28 of the Principal Act is amended by adding at the\nend the following section:\n\"(4) The regulations may amend, omit or add to the modifications\nof the Commonwealth Electoral Act 1918 set out in Schedule 1.\".",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-electoral-amendment-act-1991-sec-10-norm"
        }
      ],
      "cml:integrityHash": "93729638786f8c55a963fefe078b2627cb38711c064479f486f2799bb47f7c82",
      "skos:note": "Amendment of regulations regarding Commonwealth Electoral Act 1918"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-electoral-amendment-act-1991#sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Section 10",
      "values:kind": "section",
      "cof:pageNumber": 3,
      "values:originalText": "Section 28 of the Principal Act is amended by adding at the\nend the following section:\n\"(4) The regulations may amend, omit or add to the modifications\nof the Commonwealth Electoral Act 1918 set out in Schedule 1.\"."
    },
    {
      "@id": "concept:australian-capital-territory-electoral-amendment-act-1991-sec-10-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
