doc:sec-2-ss-5 a cof:Section ;
    cof:title "2(5) Section 2" ;
    values:kind "subsection" ;
    values:originalText "(5) If section 51 does not commence under subsection (3) within the period of 6 months beginning on the day on which this Act receives the Royal Assent, it commences on the first day after the end of that period." ;
    cof:pageNumber "3"^^xsd:integer .

