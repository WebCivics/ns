      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-act-sec-26"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-26-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "The court may extend the period of effect of a restraining order.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Section 27",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.12",
      "values:originalText": "The amendments made by sections 25 and 26 do not apply to\nan application made under subsection 28 (3) of the Principal Act before\nthe commencement of this section.\nAncillary orders",
      "skos:definition": "The amendments made by sections 25 and 26 do not apply to\nan application made under subsection 28 (3) of the Principal Act before\nthe commencement of this section.\nAncillary orders",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-27-norm"
        }
      ],
      "cml:integrityHash": "2b0f6ab9e12978eab9ca3373c226a5242f2f7419024c72d5683e35dd9c44f8a1",
      "skos:note": "Exemptions from amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Section 27",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "The amendments made by sections 25 and 26 do not apply to\nan application made under subsection 28 (3) of the Principal Act before\nthe commencement of this section.\nAncillary orders"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-27-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
