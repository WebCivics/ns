      "cml:integrityHash": "7ebc1631b1b21a0b8633b4196f999b2ce2dc61dcad41f374d980f5e1c85de648",
      "skos:note": "Definition of Principal Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-20",
