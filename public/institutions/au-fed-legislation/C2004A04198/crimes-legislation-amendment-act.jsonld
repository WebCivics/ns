    {
      "@id": "concept:crimes-legislation-amendment-act-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Section 10",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-10"
      },
      "cml:curationStatus": {
