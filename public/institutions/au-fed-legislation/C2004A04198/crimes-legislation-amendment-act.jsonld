      "skos:note": "Jurisdiction granted to State and Territory courts"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-50",
      "@type": "cof:Section",
      "cof:title": "50 Section 50",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "Section 66 of the Principal Act is amended:\n(a) by omitting from paragraph (1) (d) \"and\";\n(b) by omitting paragraph (e).\nState and Territory courts to have jurisdiction"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-50-norm",
