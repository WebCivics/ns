    {
      "@id": "concept:crimes-legislation-amendment-act-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Section 33",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.14",
      "values:originalText": "Section 7 of the Principal Act is amended:\n(a) by inserting after subsection (2) the following subsection:\n\"(2A) The regulations may make provision to the effect that\nthis Act applies to a specified foreign country in respect of\nobtaining access, for the purpose of international assistance in\ncriminal matters, to CTR information, subject to such\nlimitations, conditions, exceptions, qualifications or other\nmodifications as are specified in the regulations.\";\n(b) by inserting in subsection (3) \"or (2A), or in both of those\nsubsections,\" after \"subsection (2)\";\n(c) by adding at the end the following subsection:\n\"(4) In this section:\n'CTR information' has the same meaning as in the Cash Transaction\nReports Act 1988.\".",
      "skos:definition": "Section 7 of the Principal Act is amended:\n(a) by inserting after subsection (2) the following subsection:\n\"(2A) The regulations may make provision to the effect that\nthis Act applies to a specified foreign country in respect of\nobtaining access, for the purpose of international assistance in\ncriminal matters, to CTR information, subject to such\nlimitations, conditions, exceptions, qualifications or other\nmodifications as are specified in the regulations.\";\n(b) by inserting in subsection (3) \"or (2A), or in both of those\nsubsections,\" after \"subsection (2)\";\n(c) by adding at the end the following subsection:\n\"(4) In this section:\n'CTR information' has the same meaning as in the Cash Transaction\nReports Act 1988.\".",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-33-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d3d9654d51dee8fa59bedea7c6ba001b2a86cb81cda405ce29aada63a77381b9",
      "skos:note": "Amends Section 7 of the Principal Act to specify foreign countries for obtaining CTR information in international assistance in criminal matters."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Section 33",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Section 7 of the Principal Act is amended:\n(a) by inserting after subsection (2) the following subsection:\n\"(2A) The regulations may make provision to the effect that\nthis Act applies to a specified foreign country in respect of\nobtaining access, for the purpose of international assistance in\ncriminal matters, to CTR information, subject to such\nlimitations, conditions, exceptions, qualifications or other\nmodifications as are specified in the regulations.\";\n(b) by inserting in subsection (3) \"or (2A), or in both of those\nsubsections,\" after \"subsection (2)\";\n(c) by adding at the end the following subsection:\n\"(4) In this section:\n'CTR information' has the same meaning as in the Cash Transaction\nReports Act 1988.\"."
    },
