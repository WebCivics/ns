    {
      "@id": "concept:crimes-legislation-amendment-act-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Section 7",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.5",
      "values:originalText": "Section 49E of the Principal Act is amended:\n(a) by omitting from subsection (2) \"subsection (3)\" and substituting\n\"section 49EA\";\n(b) by omitting subsections (3) and (4).",
      "skos:definition": "Section 49E of the Principal Act is amended:\n(a) by omitting from subsection (2) \"subsection (3)\" and substituting\n\"section 49EA\";\n(b) by omitting subsections (3) and (4).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-7-norm"
        }
      ],
      "cml:integrityHash": "ffd16ddb516001422d27d32335f4fea5d92788caadb544c481528921c08b8b3d",
      "skos:note": "Amendment of Section 49E of the Principal Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Section 7",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "Section 49E of the Principal Act is amended:\n(a) by omitting from subsection (2) \"subsection (3)\" and substituting\n\"section 49EA\";\n(b) by omitting subsections (3) and (4)."
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-7-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-act-sec-7"
