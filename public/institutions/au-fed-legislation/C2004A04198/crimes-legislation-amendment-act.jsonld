    {
      "@id": "concept:crimes-legislation-amendment-act-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Section 30",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.13",
      "values:originalText": "Section 243E of the Principal Act is amended:\n(a) by inserting in subsection (1) \"one or more of the following\"\nafter \"against\";\n(b) by omitting paragraph (1) (c);\n(c) by omitting from paragraph (1) (d) \"or\".\nCourt may make further orders",
      "skos:definition": "Section 243E of the Principal Act is amended:\n(a) by inserting in subsection (1) \"one or more of the following\"\nafter \"against\";\n(b) by omitting paragraph (1) (c);\n(c) by omitting from paragraph (1) (d) \"or\".\nCourt may make further orders",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-30-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-act-sec-30-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6f04764ea5e813e38c39911a85cc531c32bbfe80941693bc8a52c618479ead41",
      "skos:note": "Court may make further orders after inserting certain phrases in subsection (1) of Section 243E."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Section 30",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Section 243E of the Principal Act is amended:\n(a) by inserting in subsection (1) \"one or more of the following\"\nafter \"against\";\n(b) by omitting paragraph (1) (c);\n(c) by omitting from paragraph (1) (d) \"or\".\nCourt may make further orders"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-30-norm",
