    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-8-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "must",
      "cml:logicSummary": "The DPP must give written notice to the owner and any other person with an interest.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (1)"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-8-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "to",
      "cml:logicSummary": "Notice is given to the owner and anyone else with a reason to believe they have an interest.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section (3)"
    },
    {
      "@id": "concept:crimes-legislation-amendment-act-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Section 9",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-act#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-act.pdf"
      },
      "dc:source": "crimes-legislation-amendment-act.pdf, p.6",
      "values:originalText": "Thie amendments made by sections 7 and 8 do not apply to an\napplication made under subsection 49E (3) of the Principal Act before\nthe commencement of this section.\nAncillary orders",
