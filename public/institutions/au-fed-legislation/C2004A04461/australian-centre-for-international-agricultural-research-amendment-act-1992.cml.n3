concept:australian-centre-for-international-agricultural-research-amendment-act-1992-sec-4 a cml:Concept ;
    skos:prefLabel "4 Section 4"@en ;
    cml:realizedBy doc:sec-4 ;
    values:originalText "Section 5 of the Principal Act is amended: (a) by omitting from paragraph (l)(b) \"in Australia\" (first occurring); (b) by adding at the end of subsection (1) the following word and paragraphs: \"; and (d) to establish and fund training schemes related to its research programs; and (e) to conduct and fund development activities related to its research programs; and (0 to fund international agricultural research centres.\". Constitution of Board" ;
    skos:definition "Section 5 of the Principal Act is amended: (a) by omitting from paragraph (l)(b) \"in Australia\" (first occurring); (b) by adding at the end of subsection (1) the following word and paragraphs: \"; and (d) to establish and fund training schemes related to its research programs; and (e) to conduct and fund development activities related to its research programs; and (0 to fund international agricultural research centres.\". Constitution of Board"@en ;
    cml:integrityHash "b3e84908beba4ec5f9bcc5b4e4bd8ad214ccffb81603afdc1c5c7c4cd0190aba" ;
    cof:pageNumber "2"^^xsd:integer ;
    skos:note "Amend Section 5 of the Principal Act" ;
