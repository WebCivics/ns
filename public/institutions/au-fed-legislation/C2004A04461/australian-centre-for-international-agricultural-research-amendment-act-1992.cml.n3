concept:australian-centre-for-international-agricultural-research-amendment-act-1992-sec-6 a cml:Concept ;
    skos:prefLabel "6 Section 6"@en ;
    cml:realizedBy doc:sec-6 ;
    values:originalText "Section 19 of the Principal Act is amended: (a) by omitting from paragraph (l)(c) \"Director, Australian Development Assistance Bureau\" and substituting \"DirectorGeneral, Australian International Development Assistance Bureau, or a person nominated by the Director-General\"; (b) by omitting from paragraph (l)(d) \"12 nor more than 16\" and substituting \"9 nor more than 11\"; (c) by omitting from paragraph (3)(b) \"minority\" and substituting \"number\"; (d) by omitting from paragraph (5)(c) \"12\" and substituting \"9\". Meetings of Council" ;
    skos:definition "Section 19 of the Principal Act is amended: (a) by omitting from paragraph (l)(c) \"Director, Australian Development Assistance Bureau\" and substituting \"DirectorGeneral, Australian International Development Assistance Bureau, or a person nominated by the Director-General\"; (b) by omitting from paragraph (l)(d) \"12 nor more than 16\" and substituting \"9 nor more than 11\"; (c) by omitting from paragraph (3)(b) \"minority\" and substituting \"number\"; (d) by omitting from paragraph (5)(c) \"12\" and substituting \"9\". Meetings of Council"@en ;
    cml:integrityHash "e36ca8ec470d58e5fbe585632a5441ba260b8a3da24bdddd51ec3cdfae58cbc3" ;
