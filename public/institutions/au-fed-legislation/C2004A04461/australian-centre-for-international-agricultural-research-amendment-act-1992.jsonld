    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-1992-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-1992#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
