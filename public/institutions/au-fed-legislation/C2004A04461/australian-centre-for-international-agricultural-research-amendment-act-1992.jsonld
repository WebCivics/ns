    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-1992-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Section 9",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-1992#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-1992.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-1992.pdf, p.3",
      "values:originalText": "Section 37 of the Principal Act is repealed and the following\nsection is substituted:\nLimit on certain contracts\n\"37.(1) The Centre must not enter a contract for the carrying out\nof agricultural research unless:\n(a) the Minister approves the contract; or\n(b) the contract's value does not exceed the amount (if any)\ndetermined in writing by the Minister for the purposes of this\nparagraph.\n\"(2) A determination made by the Minister under paragraph (1Kb)\nis a disallowable instrument for the purposes of section 46A of the Acts\nInterpretation Act 1901\".\nInsertion of new section",
      "skos:definition": "Section 37 of the Principal Act is repealed and the following\nsection is substituted:\nLimit on certain contracts\n\"37.(1) The Centre must not enter a contract for the carrying out\nof agricultural research unless:\n(a) the Minister approves the contract; or\n(b) the contract's value does not exceed the amount (if any)\ndetermined in writing by the Minister for the purposes of this\nparagraph.\n\"(2) A determination made by the Minister under paragraph (1Kb)\nis a disallowable instrument for the purposes of section 46A of the Acts\nInterpretation Act 1901\".\nInsertion of new section",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-1992-sec-9-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-1992-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3799b6f11370f74765da559fbdf54f982cc86debeaf9f7ed6129756002583b64",
      "skos:note": "The Centre must not enter contracts for agricultural research without Minister approval or under a value limit determined by the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-1992#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Section 9",
      "values:kind": "section",
      "cof:pageNumber": 3,
      "values:originalText": "Section 37 of the Principal Act is repealed and the following\nsection is substituted:\nLimit on certain contracts\n\"37.(1) The Centre must not enter a contract for the carrying out\nof agricultural research unless:\n(a) the Minister approves the contract; or\n(b) the contract's value does not exceed the amount (if any)\ndetermined in writing by the Minister for the purposes of this\nparagraph.\n\"(2) A determination made by the Minister under paragraph (1Kb)\nis a disallowable instrument for the purposes of section 46A of the Acts\nInterpretation Act 1901\".\nInsertion of new section"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-1992-sec-9-norm",
      "@type": "values:Prohibition",
