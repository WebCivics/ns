concept:crimes-and-other-legislation-amendment-act-1994-sec-4 a cml:Concept ;
    skos:prefLabel "4 Section 4"@en ;
    cml:realizedBy doc:sec-4 ;
    values:originalText "The objects of this Part are: (a) to provide that certain offences against the Crimes (Ships and Fixed Platforms) Act 1992 are to he regarded as acts of politically motivated violence; and (h) to allow the Director-General of Security to give a standing authorisation to an officer of ASIO to approve the persons who are to he able to exercise powers under warrants issued by the Attorney-General; and  Crimes and Other Legislation Amendment No. 182, 1994 (c) to allow officers of ASIO to apply for vacant positions in the Australian Public Service even though the positions have not been advertised as being open to the public. Definitions" ;
    skos:definition "The objects of this Part are: (a) to provide that certain offences against the Crimes (Ships and Fixed Platforms) Act 1992 are to he regarded as acts of politically motivated violence; and (h) to allow the Director-General of Security to give a standing authorisation to an officer of ASIO to approve the persons who are to he able to exercise powers under warrants issued by the Attorney-General; and  Crimes and Other Legislation Amendment No. 182, 1994 (c) to allow officers of ASIO to apply for vacant positions in the Australian Public Service even though the positions have not been advertised as being open to the public. Definitions"@en ;
    cml:integrityHash "cc68af4456b4035836432b7d77ec61ed33f3bf042817e0625ae47237a1e495c8" ;
    cof:pageNumber "4"^^xsd:integer ;
    skos:note "Allow Director-General of Security to give standing authorisation for ASIO officers." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-and-other-legislation-amendment-act-1994.pdf> ;
    dc:source "crimes-and-other-legislation-amendment-act-1994.pdf, p.4" ;
    cml:asserts concept:crimes-and-other-legislation-amendment-act-1994-sec-4-norm .
