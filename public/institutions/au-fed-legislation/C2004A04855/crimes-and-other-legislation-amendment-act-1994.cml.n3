    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-and-other-legislation-amendment-act-1994.pdf> ;
    dc:source "crimes-and-other-legislation-amendment-act-1994.pdf, p.13" .
