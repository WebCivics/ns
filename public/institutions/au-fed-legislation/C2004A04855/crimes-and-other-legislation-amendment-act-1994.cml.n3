doc:sec-4 a cof:Section ;
    cof:title "4 Section 4" ;
    values:kind "section" ;
    values:originalText "The objects of this Part are: (a) to provide that certain offences against the Crimes (Ships and Fixed Platforms) Act 1992 are to he regarded as acts of politically motivated violence; and (h) to allow the Director-General of Security to give a standing authorisation to an officer of ASIO to approve the persons who are to he able to exercise powers under warrants issued by the Attorney-General; and  Crimes and Other Legislation Amendment No. 182, 1994 (c) to allow officers of ASIO to apply for vacant positions in the Australian Public Service even though the positions have not been advertised as being open to the public. Definitions" ;
    cof:pageNumber "4"^^xsd:integer .

concept:crimes-and-other-legislation-amendment-act-1994-sec-5 a cml:Concept ;
    skos:prefLabel "5 Section 5"@en ;
    cml:realizedBy doc:sec-5 ;
    values:originalText "Section 4 of the Principal Act is amended by omitting \"or the Crimes (Hostages) Act 1989\" from paragraph (c) of the definition of \"politically motivated violence\" and substituting \", the Crimes (Hostages) Act 1989 or Division 1 of Part 2, or Part 3, of the Crimes (Ships and Fixed Platforms) Act 1992\". Repeal of section and substitution of new section" ;
    skos:definition "Section 4 of the Principal Act is amended by omitting \"or the Crimes (Hostages) Act 1989\" from paragraph (c) of the definition of \"politically motivated violence\" and substituting \", the Crimes (Hostages) Act 1989 or Division 1 of Part 2, or Part 3, of the Crimes (Ships and Fixed Platforms) Act 1992\". Repeal of section and substitution of new section"@en ;
    cml:integrityHash "9e4e1c1b38174622cb9722654d0c25166c7c3a4f83c5fdc5e25ee105e7dee6e4" ;
    cof:pageNumber "5"^^xsd:integer ;
    skos:note "Amendment of definition of politically motivated violence" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-and-other-legislation-amendment-act-1994.pdf> ;
    dc:source "crimes-and-other-legislation-amendment-act-1994.pdf, p.5" ;
    cml:asserts concept:crimes-and-other-legislation-amendment-act-1994-sec-5-norm .
