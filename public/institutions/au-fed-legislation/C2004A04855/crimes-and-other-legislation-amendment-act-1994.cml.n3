concept:crimes-and-other-legislation-amendment-act-1994-sec-28 a cml:Concept ;
    skos:prefLabel "28 Section 28"@en ;
    cml:realizedBy doc:sec-28 ;
    values:originalText "Section 24 of the Principal Act is amended by adding at the end the following subsection: \"(4) The reference in subsection (2) to the Governor of a State is, in respect of the Australian Capital Territory, a reference to the Governor-General.\". Application" ;
    skos:definition "Section 24 of the Principal Act is amended by adding at the end the following subsection: \"(4) The reference in subsection (2) to the Governor of a State is, in respect of the Australian Capital Territory, a reference to the Governor-General.\". Application"@en ;
    cml:integrityHash "ca2729112100bf7baf0fa240237f7cda750b95803438df0932d6d8e48114ee2e" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Amends Section 24 of the Principal Act by adding a new subsection (4) that modifies the reference to the Governor of a State in respect of the Australian Capital Territory." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-and-other-legislation-amendment-act-1994.pdf> ;
    dc:source "crimes-and-other-legislation-amendment-act-1994.pdf, p.13" ;
