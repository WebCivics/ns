doc:sec-2-ss-6 a cof:Section ;
    cof:title "2(6) Section 2" ;
    values:kind "subsection" ;
    values:originalText "(6) The amendment made by this Act to the Crimes Legislation Amendment Act 1992 is taken to have commenced on 8 January 1993 immediately after the commencement of section 34 of that Act." ;
    cof:pageNumber "3"^^xsd:integer .

concept:crimes-and-other-legislation-amendment-act-1994-sec-2-ss-7 a cml:Concept ;
    skos:prefLabel "2(7) Section 2"@en ;
    cml:realizedBy doc:sec-2-ss-7 ;
    values:originalText "(7) The amendments made by sections 25 and 28 to the Transfer of Prisoners Act 1983 do not take effect (except for the purposes of the making of a declaration under section 5 of that Act in relation to the Australian Capital Territory) until such a declaration is made." ;
