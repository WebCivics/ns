    {
      "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Section 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
