        }
      ],
      "cml:integrityHash": "158dc2c421b6e88bf70bb57d470d1cd147b376a4f31ab31d21b7d7ff9a961be1",
      "skos:note": "Exclusion from subsection (1) of Section 85ZKB"
    },
