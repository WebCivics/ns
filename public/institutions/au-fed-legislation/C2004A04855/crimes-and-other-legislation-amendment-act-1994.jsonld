      ],
      "cml:integrityHash": "3bdcb2df0eeb466343b0b557301e0f541ec2e9aa25b9b9448cffeb71bd7ce7e6",
      "skos:note": "Amends Section 23 of the Principal Act by substituting section numbers."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Section 27",
      "values:kind": "section",
