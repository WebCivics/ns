    {
      "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Section 28",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-act-1994.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-act-1994.pdf, p.13",
      "values:originalText": "Section 24 of the Principal Act is amended by adding at the end the\nfollowing subsection:\n\"(4) The reference in subsection (2) to the Governor of a State is, in\nrespect of the Australian Capital Territory, a reference to the\nGovernor-General.\".\nApplication",
      "skos:definition": "Section 24 of the Principal Act is amended by adding at the end the\nfollowing subsection:\n\"(4) The reference in subsection (2) to the Governor of a State is, in\nrespect of the Australian Capital Territory, a reference to the\nGovernor-General.\".\nApplication",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-28-norm"
        }
      ],
      "cml:integrityHash": "ca2729112100bf7baf0fa240237f7cda750b95803438df0932d6d8e48114ee2e",
      "skos:note": "Amends Section 24 of the Principal Act by adding a new subsection (4) that modifies the reference to the Governor of a State in respect of the Australian Capital Territory."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-28",
      "@type": "cof:Section",
      "cof:title": "28 Section 28",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Section 24 of the Principal Act is amended by adding at the end the\nfollowing subsection:\n\"(4) The reference in subsection (2) to the Governor of a State is, in\nrespect of the Australian Capital Territory, a reference to the\nGovernor-General.\".\nApplication"
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-28-norm",
