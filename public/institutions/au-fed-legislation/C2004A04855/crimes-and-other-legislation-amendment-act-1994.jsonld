        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c36a8b14654cd83a73c7007f3f92c3297515c51ec548459da7e4d8992450d330",
      "skos:note": "No imprisonment for failure to pay reparation, restitution or compensation"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-12",
      "@type": "cof:Section",
