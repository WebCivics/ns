      "dc:source": "crimes-and-other-legislation-amendment-act-1994.pdf, p.8",
      "values:originalText": "Section 19B of the Principal Act is amended by inserting in\nsubparagraph (1)(b)(i) \"cultural background.\" after \"antecedents.\".\nConditional release of offenders after conviction",
      "skos:definition": "Section 19B of the Principal Act is amended by inserting in\nsubparagraph (1)(b)(i) \"cultural background.\" after \"antecedents.\".\nConditional release of offenders after conviction",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-11-norm"
        },
