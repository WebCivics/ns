    {
      "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-act-1994.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-act-1994.pdf, p.4",
      "values:originalText": "The objects of this Part are:\n(a) to provide that certain offences against the Crimes (Ships and Fixed\nPlatforms) Act 1992 are to he regarded as acts of politically\nmotivated violence; and\n(h) to allow the Director-General of Security to give a standing\nauthorisation to an officer of ASIO to approve the persons who are\nto he able to exercise powers under warrants issued by the\nAttorney-General; and\n\nCrimes and Other Legislation Amendment No. 182, 1994\n(c) to allow officers of ASIO to apply for vacant positions in the\nAustralian Public Service even though the positions have not been\nadvertised as being open to the public.\nDefinitions",
      "skos:definition": "The objects of this Part are:\n(a) to provide that certain offences against the Crimes (Ships and Fixed\nPlatforms) Act 1992 are to he regarded as acts of politically\nmotivated violence; and\n(h) to allow the Director-General of Security to give a standing\nauthorisation to an officer of ASIO to approve the persons who are\nto he able to exercise powers under warrants issued by the\nAttorney-General; and\n\nCrimes and Other Legislation Amendment No. 182, 1994\n(c) to allow officers of ASIO to apply for vacant positions in the\nAustralian Public Service even though the positions have not been\nadvertised as being open to the public.\nDefinitions",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-4-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cc68af4456b4035836432b7d77ec61ed33f3bf042817e0625ae47237a1e495c8",
      "skos:note": "Allow Director-General of Security to give standing authorisation for ASIO officers."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Section 4",
      "values:kind": "section",
      "cof:pageNumber": 4,
      "values:originalText": "The objects of this Part are:\n(a) to provide that certain offences against the Crimes (Ships and Fixed\nPlatforms) Act 1992 are to he regarded as acts of politically\nmotivated violence; and\n(h) to allow the Director-General of Security to give a standing\nauthorisation to an officer of ASIO to approve the persons who are\nto he able to exercise powers under warrants issued by the\nAttorney-General; and\n\nCrimes and Other Legislation Amendment No. 182, 1994\n(c) to allow officers of ASIO to apply for vacant positions in the\nAustralian Public Service even though the positions have not been\nadvertised as being open to the public.\nDefinitions"
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-4-norm",
