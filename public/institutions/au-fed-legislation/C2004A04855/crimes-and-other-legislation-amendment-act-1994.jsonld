      "dc:source": "crimes-and-other-legislation-amendment-act-1994.pdf, p.14",
      "values:originalText": "The object of this Part is to make several minor amendments to\nvarious Acts.\nMinor amendments of other Acts",
      "skos:definition": "The object of this Part is to make several minor amendments to\nvarious Acts.\nMinor amendments of other Acts",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-30-norm"
        }
      ],
      "cml:integrityHash": "0e3241e3c8e4c6736e1a119038f6b465ed473f409d980e5df49d9b642026ef13",
      "skos:note": "Minor amendments to various Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Section 30",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The object of this Part is to make several minor amendments to\nvarious Acts.\nMinor amendments of other Acts"
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-30-norm",
