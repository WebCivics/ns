    {
      "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Section 20",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-act-1994.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-act-1994.pdf, p.10",
      "values:originalText": "Section 48A of the Principal Act is amended:\n(a) by inserting \"or 47B\" after \"47\":\n(b) by adding the following subsection:\n\"(2) If a person who is undergoing punishment for an offence\nagainst a law of the Commonwealth or of a Territory commits an\noffence against a law of a State or Territory that corresponds to\nsection 47 or 47B, the person is, upon being returned to lawful custody,\n\nCrimes and Other Legislation Amendment No. 182, 1994\nto undergo (in addition to any punishment imposed for the\ncorresponding offence and any other punishment that the person is\nrequired to undergo under the law of the State or Territory) the\npunishment that the person would have undergone for the\nfirst-mentioned offence if the person had not escaped.\".\nInterception devices prohibited",
      "skos:definition": "Section 48A of the Principal Act is amended:\n(a) by inserting \"or 47B\" after \"47\":\n(b) by adding the following subsection:\n\"(2) If a person who is undergoing punishment for an offence\nagainst a law of the Commonwealth or of a Territory commits an\noffence against a law of a State or Territory that corresponds to\nsection 47 or 47B, the person is, upon being returned to lawful custody,\n\nCrimes and Other Legislation Amendment No. 182, 1994\nto undergo (in addition to any punishment imposed for the\ncorresponding offence and any other punishment that the person is\nrequired to undergo under the law of the State or Territory) the\npunishment that the person would have undergone for the\nfirst-mentioned offence if the person had not escaped.\".\nInterception devices prohibited",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-20-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b8915c9677ccf269e98bd9f6c3452bfe7fd86fc55ba14db193bceb2e3482610c",
      "skos:note": "Interception devices are prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-act-1994#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Section 20",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Section 48A of the Principal Act is amended:\n(a) by inserting \"or 47B\" after \"47\":\n(b) by adding the following subsection:\n\"(2) If a person who is undergoing punishment for an offence\nagainst a law of the Commonwealth or of a Territory commits an\noffence against a law of a State or Territory that corresponds to\nsection 47 or 47B, the person is, upon being returned to lawful custody,\n\nCrimes and Other Legislation Amendment No. 182, 1994\nto undergo (in addition to any punishment imposed for the\ncorresponding offence and any other punishment that the person is\nrequired to undergo under the law of the State or Territory) the\npunishment that the person would have undergone for the\nfirst-mentioned offence if the person had not escaped.\".\nInterception devices prohibited"
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-act-1994-sec-20-norm",
