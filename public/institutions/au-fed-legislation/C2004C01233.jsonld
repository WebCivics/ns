      "@type": "cml:LogicApplication",
      "cml:conclusionText": "12 months imprisonment for refusal.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
