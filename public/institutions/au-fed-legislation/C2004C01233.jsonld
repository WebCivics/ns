      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is under sentence in relation to a prescribed offence or serious offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "A person serving a sentence that overlaps with the sentence imposed for a federal offence is also under sentence in relation to a prescribed offence or serious offence.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlapsWithSentence",
      "cml:premiseText": "(f) is subject to an order made under Division 9 of Part 1B;"
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is under sentence in relation to a prescribed offence or serious offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The person is under sentence in relation to a prescribed offence or serious offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "isUnderSentence",
      "cml:premiseText": "(a) is serving a sentence in a prison (including a gaol, lock-up or other place of detention); or (b) is serving a sentence of a kind, or subject to an order of a kind, provided for in subsection 20AB(1) as a sentence or order that may be passed or made by a court, under that section, in respect of a person convicted of a federal offence;"
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is under sentence in relation to a prescribed offence or serious offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "A person released under a parole order made under subsection 19AL(1) or (2) is also under sentence in relation to a prescribed offence or serious offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "isReleasedUnderParoleOrder",
      "cml:premiseText": "(c) is released under a parole order made under subsection 19AL(1) or (2);"
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is under sentence in relation to a prescribed offence or serious offence.",
      "cml:confidence": {
