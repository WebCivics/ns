      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Refusal is an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
