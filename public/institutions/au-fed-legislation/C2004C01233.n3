concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2 cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2-logic-deontic-1 .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "implies" ;
    cml:logicSummary "Offender's conviction offence is related to proposed forensic procedure" ;
    cml:premiseText "(ii) any other indictable offence arising out of the same circumstances; or (iii) any other indictable offence in respect of which the evidence likely to be obtained as a result of a proposed forensic procedure carried out on the suspect is likely to have probative value;" ;
    cml:conclusionText "Offender's conviction offence for which the offender was convicted and to which an application for an order authorising a forensic procedure relates." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

