concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-1 a cml:Concept ;
    skos:prefLabel "22(1) Crimes Amendment (Forensic Procedures) Act 2001"@en ;
    cml:realizedBy doc:sch-1-sec-22-2-ss-1 ;
    cml:integrityHash "2af72dd4c620c63ea1206ac82da827f2a8bd7f63274e65a351bb1b4928bfe5c0" ;
    values:partOf concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2 ;
    skos:note "Carry out forensic procedure on serious offender or prescribed offender without permission. Inform the offender of certain details about forensic procedure Offender must give informed consent to forensic procedure." ;
