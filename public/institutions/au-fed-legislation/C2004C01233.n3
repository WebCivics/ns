concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2 a cml:Concept ;
    skos:prefLabel "16 Crimes Amendment (Forensic Procedures) Act 2001"@en ;
    cml:realizedBy doc:sch-1-sec-16-2 ;
    cml:integrityHash "3797e1e25ee9fe8fd21ea0a410aea61e42c6673994b23895b0ec1a6fc29c6e19" ;
    skos:note "A person is under sentence in relation to a prescribed offence or serious offence if they meet certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-forensic-procedures-act-2001.pdf> ;
    dc:source "crimes-amendment-forensic-procedures-act-2001.pdf, p.16" ;
    cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-norm .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2 cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-1 .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "isUnderSentence" ;
    cml:logicSummary "The person is under sentence in relation to a prescribed offence or serious offence." ;
    cml:premiseText "(a) is serving a sentence in a prison (including a gaol, lock-up or other place of detention); or (b) is serving a sentence of a kind, or subject to an order of a kind, provided for in subsection 20AB(1) as a sentence or order that may be passed or made by a court, under that section, in respect of a person convicted of a federal offence;" ;
    cml:conclusionText "The person is under sentence in relation to a prescribed offence or serious offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2 cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-2 .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "isReleasedUnderParoleOrder" ;
    cml:logicSummary "A person released under a parole order made under subsection 19AL(1) or (2) is also under sentence in relation to a prescribed offence or serious offence." ;
    cml:premiseText "(c) is released under a parole order made under subsection 19AL(1) or (2);" ;
    cml:conclusionText "The person is under sentence in relation to a prescribed offence or serious offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2 cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-3 .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "isSubjectToConditionalRelease" ;
    cml:logicSummary "A person convicted and conditionally released as provided for in subsection 20(1) is also under sentence in relation to a prescribed offence or serious offence." ;
    cml:premiseText "(g) is convicted and conditionally released as provided for in subsection 20(1), either: (i) in the case of paragraph 20(1)(a)—without sentence being passed; or (ii) in the case of paragraph 20(1)(b)—after sentence has been passed." ;
    cml:conclusionText "The person is under sentence in relation to a prescribed offence or serious offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2 cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-alleninterval-4 .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-alleninterval-4 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "overlapsWithSentence" ;
    cml:logicSummary "A person serving a sentence that overlaps with the sentence imposed for a federal offence is also under sentence in relation to a prescribed offence or serious offence." ;
