<https://ns.webcivics.net/concept/crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-1> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "isUnderSentence";
    <https://ns.webcivics.net/cml/logicSummary> "The person is under sentence in relation to a prescribed offence or serious offence.";
    <https://ns.webcivics.net/cml/premiseText> "(a) is serving a sentence in a prison (including a gaol, lock-up or other place of detention); or (b) is serving a sentence of a kind, or subject to an order of a kind, provided for in subsection 20AB(1) as a sentence or order that may be passed or made by a court, under that section, in respect of a person convicted of a federal offence;";
    <https://ns.webcivics.net/cml/conclusionText> "The person is under sentence in relation to a prescribed offence or serious offence.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-2>.
<https://ns.webcivics.net/concept/crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-deontic-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "isReleasedUnderParoleOrder";
    <https://ns.webcivics.net/cml/logicSummary> "A person released under a parole order made under subsection 19AL(1) or (2) is also under sentence in relation to a prescribed offence or serious offence.";
    <https://ns.webcivics.net/cml/premiseText> "(c) is released under a parole order made under subsection 19AL(1) or (2);";
    <https://ns.webcivics.net/cml/conclusionText> "The person is under sentence in relation to a prescribed offence or serious offence.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
