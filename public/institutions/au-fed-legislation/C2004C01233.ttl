    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "isSubjectToConditionalRelease";
    <https://ns.webcivics.net/cml/logicSummary> "A person convicted and conditionally released as provided for in subsection 20(1) is also under sentence in relation to a prescribed offence or serious offence.";
    <https://ns.webcivics.net/cml/premiseText> "(g) is convicted and conditionally released as provided for in subsection 20(1), either: (i) in the case of paragraph 20(1)(a)—without sentence being passed; or (ii) in the case of paragraph 20(1)(b)—after sentence has been passed.";
    <https://ns.webcivics.net/cml/conclusionText> "The person is under sentence in relation to a prescribed offence or serious offence.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
