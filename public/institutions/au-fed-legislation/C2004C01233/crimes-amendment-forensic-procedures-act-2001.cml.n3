concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-2 a cml:Concept ;
    skos:prefLabel "22(2) Crimes Amendment (Forensic Procedures) Act 2001"@en ;
    cml:realizedBy doc:sch-1-sec-22-2-ss-2 ;
    values:originalText "(2) A forensic procedure may be carried out on a serious offender or prescribed offender who is a suspect only if authorised by and in accordance with Divisions 2 to 5." ;
    skos:definition "(2) A forensic procedure may be carried out on a serious offender or prescribed offender who is a suspect only if authorised by and in accordance with Divisions 2 to 5."@en ;
    cml:integrityHash "4f2f0bb23b19c9e651fd9c6940703345cef1673d4b161cb100e15f4059209145" ;
    values:partOf concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2 ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Authorisation required for forensic procedures on suspects Offender must be allowed to communicate with legal practitioner in private unless constable suspects reasonable grounds for evidence destruction." ;
