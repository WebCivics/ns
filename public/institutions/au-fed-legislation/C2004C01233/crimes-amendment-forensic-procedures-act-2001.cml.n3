concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2-ss-2 a cml:Concept ;
    skos:prefLabel "26(2) Crimes Amendment (Forensic Procedures) Act 2001"@en ;
    cml:realizedBy doc:sch-1-sec-26-2-ss-2 ;
    values:originalText "(2) In subsection (1), Division 6 person means a person who, under Division 6 as applied by section 23XWE, may carry out the forensic procedure." ;
    skos:definition "(2) In subsection (1), Division 6 person means a person who, under Division 6 as applied by section 23XWE, may carry out the forensic procedure."@en ;
    cml:integrityHash "362a05da63c94ba4c947d277b7f3d403fae6e6e43eda34d6830bf88d6a1e2bf9" ;
    values:partOf concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2 ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Offender must be provided with a copy of the record. Authorized applicant may apply for order to carry out non-intimate forensic procedure on child or incapable person who is a serious offender. Defines Division 6 person under Crimes Amendment (Forensic Procedures) Act 2001." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
