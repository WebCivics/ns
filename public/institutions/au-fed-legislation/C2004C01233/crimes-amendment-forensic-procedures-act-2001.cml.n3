concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-1 a cml:Concept ;
    skos:prefLabel "22(1) Crimes Amendment (Forensic Procedures) Act 2001"@en ;
    cml:realizedBy doc:sch-1-sec-22-2-ss-1 ;
    values:originalText "(1) An offender gives informed consent to a forensic procedure if the offender consents after a constable: (a) requests the offender to consent to the forensic procedure under section 23XWH; and (b) informs the offender about the forensic procedure in accordance with section 23XWJ; and (c) gives the offender the opportunity to communicate, or attempt to communicate, with a legal practitioner of the offender’s choice." ;
    skos:definition "(1) An offender gives informed consent to a forensic procedure if the offender consents after a constable: (a) requests the offender to consent to the forensic procedure under section 23XWH; and (b) informs the offender about the forensic procedure in accordance with section 23XWJ; and (c) gives the offender the opportunity to communicate, or attempt to communicate, with a legal practitioner of the offender’s choice."@en ;
    cml:integrityHash "53f2cf505f52fbc6b5807352feac0c5abc8375ede5393ce5c1e11ece4b0a6000" ;
    values:partOf concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2 ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Carry out forensic procedure on serious offender or prescribed offender without permission. Inform the offender of certain details about forensic procedure Offender must give informed consent to forensic procedure." ;
    dc:description "yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-forensic-procedures-act-2001.pdf> ;
