    cml:modality cml:Deontic ;
    cml:operator "isSubjectToConditionalRelease" ;
    cml:logicSummary "A person convicted and conditionally released as provided for in subsection 20(1) is also under sentence in relation to a prescribed offence or serious offence." ;
    cml:premiseText "(g) is convicted and conditionally released as provided for in subsection 20(1), either: (i) in the case of paragraph 20(1)(a)—without sentence being passed; or (ii) in the case of paragraph 20(1)(b)—after sentence has been passed." ;
    cml:conclusionText "The person is under sentence in relation to a prescribed offence or serious offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2 cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-alleninterval-4 .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-alleninterval-4 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "overlapsWithSentence" ;
    cml:logicSummary "A person serving a sentence that overlaps with the sentence imposed for a federal offence is also under sentence in relation to a prescribed offence or serious offence." ;
    cml:premiseText "(f) is subject to an order made under Division 9 of Part 1B;" ;
    cml:conclusionText "The person is under sentence in relation to a prescribed offence or serious offence." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2 cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-ltl-5 .
concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-16-2-logic-ltl-5 a cml:LogicApplication ;
