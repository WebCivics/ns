doc:sch-1-sec-2-ss-1 a cof:Section ;
    cof:title "2(1) After section 4" ;
    values:kind "subsection" ;
    values:originalText "(1) This section sets out the rules that apply if, under a law of the Commonwealth relating to criminal matters, a function or power that is neither judicial nor incidental to a judicial function or power, is conferred on one or more of the following persons: (a) a State or Territory judge; (b) a magistrate; (c) a Justice of the Peace or other person: (i) employed in a State or Territory court; and (ii) authorised to issue search warrants, or warrants of arrest. Note 1: Magistrate is defined in section 16C of the Acts Interpretation Act 1901. Note 2: Justice of the Peace is defined in paragraph 26(e) of the Acts Interpretation Act 1901.  Section 3 Crimes Amendment (Forensic Procedures) Act 2001                   7 Functions and powers conferred personally" ;
    cof:pageNumber "6"^^xsd:integer .

concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-2-ss-2 a cml:Concept ;
    skos:prefLabel "2(2) After section 4"@en ;
    cml:realizedBy doc:sch-1-sec-2-ss-2 ;
    values:originalText "(2) The function or power is conferred on the person only in a personal capacity and not, in the case of a State or Territory judge or magistrate, as a court or a member of a court. Function or power need not be accepted" ;
    skos:definition "(2) The function or power is conferred on the person only in a personal capacity and not, in the case of a State or Territory judge or magistrate, as a court or a member of a court. Function or power need not be accepted"@en ;
    cml:integrityHash "8da1c490ae5bf8f381733ae2f0974027c30ec6701049eb2350fb18edac37b861" ;
    values:partOf concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-2 ;
    cof:pageNumber "6"^^xsd:integer ;
    skos:note "Function or power is personal and not as a court or member of a court." ;
    cml:curationStatus cml:Proposed ;
