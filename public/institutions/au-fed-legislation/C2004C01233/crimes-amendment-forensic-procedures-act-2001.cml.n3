    cml:operator "isTracedBySentence" ;
    cml:logicSummary "A person serving a sentence that is traced by the sentence imposed for a federal offence is also under sentence in relation to a prescribed offence or serious offence." ;
    cml:premiseText "(f) is subject to an order made under Division 9 of Part 1B;" ;
    cml:conclusionText "The person is under sentence in relation to a prescribed offence or serious offence." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-16-2 a cof:Section ;
