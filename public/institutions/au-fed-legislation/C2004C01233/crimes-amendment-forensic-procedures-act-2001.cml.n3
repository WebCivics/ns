    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23yo-ss-1 cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23yo-ss-1-logic-alleninterval-3 .
