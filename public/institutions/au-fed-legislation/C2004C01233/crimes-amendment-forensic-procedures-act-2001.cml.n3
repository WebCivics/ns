concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2 a cml:Concept ;
    skos:prefLabel "14 Crimes Amendment (Forensic Procedures) Act 2001"@en ;
    cml:realizedBy doc:sch-1-sec-14-2 ;
    values:originalText "(ii) any other indictable offence arising out of the same circumstances; or (iii) any other indictable offence in respect of which the evidence likely to be obtained as a result of a proposed forensic procedure carried out on the suspect is likely to have probative value; or (b) in relation to an offender—the offence for which the offender was convicted and to which an application for an order authorising a forensic procedure relates." ;
    skos:definition "(ii) any other indictable offence arising out of the same circumstances; or (iii) any other indictable offence in respect of which the evidence likely to be obtained as a result of a proposed forensic procedure carried out on the suspect is likely to have probative value; or (b) in relation to an offender—the offence for which the offender was convicted and to which an application for an order authorising a forensic procedure relates."@en ;
    cml:integrityHash "0d55b67816b260660eca96d719a74f42591efb15af94b868d9999b69774f6196" ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Offender's conviction offence related to proposed forensic procedure" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-forensic-procedures-act-2001.pdf> ;
    dc:source "crimes-amendment-forensic-procedures-act-2001.pdf, p.14" ;
    cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2-norm .
