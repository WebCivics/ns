doc:sch-1-sec-24a a cof:Section ;
    cof:title "24A Subsection 23WA(1) (definition of order)" ;
    values:kind "section" ;
    values:originalText "Repeal the definition, substitute: order means: (a) in relation to a suspect—an order of a magistrate under section 23WS or interim order of a magistrate under section 23XA; or (b) in relation to an offender—an order of a judge or magistrate under section 23XWO; or (c) in relation to a volunteer—an order of a magistrate under section 23XWU." ;
    cof:pageNumber "12"^^xsd:integer .

