concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23xl a cml:Concept ;
    skos:prefLabel "23XL Taking of hair samples"@en ;
    cml:realizedBy doc:sch-1-sec-23xl ;
    values:originalText "A person is authorised to take a sample of hair of a suspect by removing the root of the hair only if: (a) the person takes only so much hair as the person believes is necessary for analysis of the sample, or other examination of the hair, to be carried out for the purpose of investigating the offence; and (b) each strand of hair is taken individually using the least painful technique known and available to the person.  Carrying out forensic procedures on suspects  Division 6 Section 23XL Crimes Amendment (Forensic Procedures) Act 2001                   19" ;
    skos:definition "A person is authorised to take a sample of hair of a suspect by removing the root of the hair only if: (a) the person takes only so much hair as the person believes is necessary for analysis of the sample, or other examination of the hair, to be carried out for the purpose of investigating the offence; and (b) each strand of hair is taken individually using the least painful technique known and available to the person.  Carrying out forensic procedures on suspects  Division 6 Section 23XL Crimes Amendment (Forensic Procedures) Act 2001                   19"@en ;
    cml:integrityHash "119dc2699b39aa7649bd21c0d8cf955f41217f2dda264344e13133383aee0313" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Authorisation for taking hair samples from suspects" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-forensic-procedures-act-2001.pdf> ;
    dc:source "crimes-amendment-forensic-procedures-act-2001.pdf, p.18" ;
    cml:asserts concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23xl-norm .
