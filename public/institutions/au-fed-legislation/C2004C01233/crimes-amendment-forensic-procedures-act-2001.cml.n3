concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2-ss-6 a cml:Concept ;
    skos:prefLabel "26(6) Crimes Amendment (Forensic Procedures) Act 2001"@en ;
    cml:realizedBy doc:sch-1-sec-26-2-ss-6 ;
    values:originalText "(6) A judge or magistrate may order the carrying out of a forensic procedure under this Division if satisfied that the carrying out of the forensic procedure is justified in all the circumstances." ;
