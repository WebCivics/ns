concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-54a a cml:Concept ;
    skos:prefLabel "54A Subsection 23XP(1)"@en ;
    cml:realizedBy doc:sch-1-sec-54a ;
    values:originalText "Omit “the taking of a hand print, finger print, foot print or toe print”, substitute “a non-intimate forensic procedure”. Note: The heading to section 23XP is altered by omitting “most” and substituting “intimate”." ;
    skos:definition "Omit “the taking of a hand print, finger print, foot print or toe print”, substitute “a non-intimate forensic procedure”. Note: The heading to section 23XP is altered by omitting “most” and substituting “intimate”."@en ;
    cml:integrityHash "005636754d0caf14ef66e5d0183f3fae27ad48515148178d98c453d1e8c134a9" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Omit 'the taking of a hand print, finger print, foot print or toe print' and substitute 'a non-intimate forensic procedure'." ;
    cml:curationStatus cml:Proposed ;
