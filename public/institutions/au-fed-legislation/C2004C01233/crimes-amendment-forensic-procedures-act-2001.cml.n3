    cml:hasPart concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-24-2-ss-1 ;
    cml:hasPart concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-24-2-ss-2 ;
    cml:hasPart concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-24-2-ss-1 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
