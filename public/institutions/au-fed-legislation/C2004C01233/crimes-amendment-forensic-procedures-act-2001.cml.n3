concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-24a a cml:Concept ;
    skos:prefLabel "24A Subsection 23WA(1) (definition of order)"@en ;
    cml:realizedBy doc:sch-1-sec-24a ;
    values:originalText "Repeal the definition, substitute: order means: (a) in relation to a suspect—an order of a magistrate under section 23WS or interim order of a magistrate under section 23XA; or (b) in relation to an offender—an order of a judge or magistrate under section 23XWO; or (c) in relation to a volunteer—an order of a magistrate under section 23XWU." ;
    skos:definition "Repeal the definition, substitute: order means: (a) in relation to a suspect—an order of a magistrate under section 23WS or interim order of a magistrate under section 23XA; or (b) in relation to an offender—an order of a judge or magistrate under section 23XWO; or (c) in relation to a volunteer—an order of a magistrate under section 23XWU."@en ;
    cml:integrityHash "9a73cd2db0e4368a2e8137d1930b1414e97b3caff440c88667fb0a1547610eca" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Definition of order" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-forensic-procedures-act-2001.pdf> ;
