    cml:hasPart concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-45-ss-6a ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-forensic-procedures-act-2001.pdf> ;
    dc:source "crimes-amendment-forensic-procedures-act-2001.pdf, p.18" .
