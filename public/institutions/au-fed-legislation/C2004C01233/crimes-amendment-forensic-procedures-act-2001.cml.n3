concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-6-2-ss-3 a cml:Concept ;
    skos:prefLabel "6(3) Section 6"@en ;
    cml:realizedBy doc:sch-1-sec-6-2-ss-3 ;
    values:originalText "(3) This section does not make it an offence for conduct to cause a matching that is not permitted by this Part if the matching is solely for the purposes of administering the DNA database system." ;
    skos:definition "(3) This section does not make it an offence for conduct to cause a matching that is not permitted by this Part if the matching is solely for the purposes of administering the DNA database system."@en ;
