      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.14",
      "values:originalText": "(ii) any other indictable offence arising out of the same\ncircumstances; or\n(iii) any other indictable offence in respect of which the\nevidence likely to be obtained as a result of a proposed\nforensic procedure carried out on the suspect is likely to\nhave probative value; or\n(b) in relation to an offender—the offence for which the offender\nwas convicted and to which an application for an order\nauthorising a forensic procedure relates.",
      "skos:definition": "(ii) any other indictable offence arising out of the same\ncircumstances; or\n(iii) any other indictable offence in respect of which the\nevidence likely to be obtained as a result of a proposed\nforensic procedure carried out on the suspect is likely to\nhave probative value; or\n(b) in relation to an offender—the offence for which the offender\nwas convicted and to which an application for an order\nauthorising a forensic procedure relates.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2-logic-linearlogic-2"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2-logic-alleninterval-3"
        },
