    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-34-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Crimes Amendment (Forensic Procedures) Act 2001",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-34-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.34",
      "values:originalText": "(b) there has been a breach of, or failure to comply with:\n(i) any provision of this Part in relation to a forensic\nprocedure carried out on the person (including, but not\nlimited to, any breach or failure to comply with a\nprovision requiring things to be done at any time before\nor after the forensic procedure is carried out); or\n(ii) any provision of Division 8A with respect to recording\nor use of information on the DNA database system.",
      "skos:definition": "(b) there has been a breach of, or failure to comply with:\n(i) any provision of this Part in relation to a forensic\nprocedure carried out on the person (including, but not\nlimited to, any breach or failure to comply with a\nprovision requiring things to be done at any time before\nor after the forensic procedure is carried out); or\n(ii) any provision of Division 8A with respect to recording\nor use of information on the DNA database system.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-34-2-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-34-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-34-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-34-2-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-34-2-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-34-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "1044e38dafe4bd2790ce9eba2eafe2c6eb19efadf0b090dc92c11549be66186b",
      "skos:note": "Failure to comply with provisions of Part or Division 8A"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-34-2",
      "@type": "cof:Section",
      "cof:title": "34 Crimes Amendment (Forensic Procedures) Act 2001",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "(b) there has been a breach of, or failure to comply with:\n(i) any provision of this Part in relation to a forensic\nprocedure carried out on the person (including, but not\nlimited to, any breach or failure to comply with a\nprovision requiring things to be done at any time before\nor after the forensic procedure is carried out); or\n(ii) any provision of Division 8A with respect to recording\nor use of information on the DNA database system."
    },
