    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Authorize",
      "cml:logicSummary": "Requires authorisation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "Offender must be allowed to communicate with legal practitioner.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 22(2) states that the constable must allow the offender to communicate...",
      "cml:conclusionText": "The constable must allow the offender to communicate with the legal practitioner in private."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must not",
      "cml:logicSummary": "Constable may request offender to consent to forensic procedure unless reasonable grounds for evidence destruction exist.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 23XWH states that a constable may request the offender to consent...",
      "cml:conclusionText": "The constable must not request the offender to consent to the forensic procedure unless there are reasonable grounds for evidence destruction."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-2-logic-epistemic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "May suspect",
      "cml:logicSummary": "Constable may suspect reasonable grounds for evidence destruction based on suspicion.",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 22(2) states that the constable suspects on reasonable grounds...",
      "cml:conclusionText": "The constable may suspect that there are reasonable grounds for evidence destruction."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-2-logic-ltl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Constable must be satisfied on balance of probabilities before requesting consent.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 23XWI states that the constable must be satisfied on the balance of probabilities...",
      "cml:conclusionText": "The constable must be satisfied on a recurring trace that the request for consent is justified."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-2-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "Offender has right to communicate with legal practitioner in private.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 22(2) states that the constable must allow the offender to communicate...",
      "cml:conclusionText": "The offender has a right to communicate with the legal practitioner in private."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-22-2-ss-2-logic-deontic-7",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must not",
      "cml:logicSummary": "Constable may request consent for forensic procedure unless justified.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 23XWH states that a constable may request the offender to consent...",
      "cml:conclusionText": "The constable must not request the offender to consent to the forensic procedure unless it is justified."
    },
