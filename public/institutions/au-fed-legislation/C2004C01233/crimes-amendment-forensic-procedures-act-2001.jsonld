      "cml:integrityHash": "ba789a03f0ea2d976e759e7a8312531c2ce7bac57b22972cc1baa0955b3b72a7",
      "skos:note": "Suspect's right to address the magistrate and cross-examine witnesses."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-45-ss-6",
      "@type": "cof:Section",
      "cof:title": "45(6) Subsection 23WX(6)",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(6) The suspect or his or her representative:\n(a) may call or cross-examine the applicant for the order; and\n(b) may, with the leave of the magistrate, call or cross-examine\nany other witnesses; and\n(c) may address the magistrate."
    },
