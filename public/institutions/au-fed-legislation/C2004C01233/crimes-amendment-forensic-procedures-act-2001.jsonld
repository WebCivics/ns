    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-41a",
      "@type": "cml:Concept",
      "skos:prefLabel": "41A Subsection 23WJ(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-41a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.17",
      "values:originalText": "Omit “the taking of a hand print, finger print, foot print or toe print”,\nsubstitute “a non-intimate forensic procedure”.\nNote:\nThe heading to subsection 23WJ(2) is altered by omitting “most” and substituting\n“intimate”.",
      "skos:definition": "Omit “the taking of a hand print, finger print, foot print or toe print”,\nsubstitute “a non-intimate forensic procedure”.\nNote:\nThe heading to subsection 23WJ(2) is altered by omitting “most” and substituting\n“intimate”.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-41a-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-41a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9db0fd387d8c9929731be6797d186e9e6138c5b56ce6fc1ad34793bca4fde5d7",
      "skos:note": "Omit 'the taking of a hand print, finger print, foot print or toe print' and substitute 'a non-intimate forensic procedure'."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-41a",
      "@type": "cof:Section",
      "cof:title": "41A Subsection 23WJ(2)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Omit “the taking of a hand print, finger print, foot print or toe print”,\nsubstitute “a non-intimate forensic procedure”.\nNote:\nThe heading to subsection 23WJ(2) is altered by omitting “most” and substituting\n“intimate”."
    },
