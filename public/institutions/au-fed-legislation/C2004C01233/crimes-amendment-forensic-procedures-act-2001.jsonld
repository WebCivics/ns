      "skos:note": "Omit 'is destroyed' and substitute with 'obtained as a result of the carrying out...'"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-59",
