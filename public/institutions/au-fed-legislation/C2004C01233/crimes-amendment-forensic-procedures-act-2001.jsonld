    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-83",
      "@type": "cml:Concept",
      "skos:prefLabel": "83 After paragraph 23YV(1)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-83"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
