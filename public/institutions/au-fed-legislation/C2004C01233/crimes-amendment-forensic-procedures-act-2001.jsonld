        }
      ],
      "cml:integrityHash": "0cf8b4a8f471018cc15560bc853e4f22947cb3c5810d8f1cb1e0c981ee4075db",
      "skos:note": "A judge or magistrate may order the carrying out of a forensic procedure under this Division if satisfied that the carrying out of the forensic procedure is justified in all the circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-26-2-ss-6",
      "@type": "cof:Section",
