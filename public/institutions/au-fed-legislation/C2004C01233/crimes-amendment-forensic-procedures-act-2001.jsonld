      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.26",
      "values:originalText": "(6) A judge or magistrate may order the carrying out of a forensic\nprocedure under this Division if satisfied that the carrying out of\nthe forensic procedure is justified in all the circumstances.",
      "skos:definition": "(6) A judge or magistrate may order the carrying out of a forensic\nprocedure under this Division if satisfied that the carrying out of\nthe forensic procedure is justified in all the circumstances.",
      "values:partOf": {
        "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2"
      },
