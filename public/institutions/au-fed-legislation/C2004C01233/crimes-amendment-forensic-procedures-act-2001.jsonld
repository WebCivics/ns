    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23xl",
      "@type": "cml:Concept",
      "skos:prefLabel": "23XL Taking of hair samples",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-23xl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.18",
      "values:originalText": "A person is authorised to take a sample of hair of a suspect by\nremoving the root of the hair only if:\n(a) the person takes only so much hair as the person believes is\nnecessary for analysis of the sample, or other examination of\nthe hair, to be carried out for the purpose of investigating the\noffence; and\n(b) each strand of hair is taken individually using the least\npainful technique known and available to the person.\n\nCarrying out forensic procedures on suspects  Division 6\nSection 23XL\nCrimes Amendment (Forensic Procedures) Act 2001                   19",
      "skos:definition": "A person is authorised to take a sample of hair of a suspect by\nremoving the root of the hair only if:\n(a) the person takes only so much hair as the person believes is\nnecessary for analysis of the sample, or other examination of\nthe hair, to be carried out for the purpose of investigating the\noffence; and\n(b) each strand of hair is taken individually using the least\npainful technique known and available to the person.\n\nCarrying out forensic procedures on suspects  Division 6\nSection 23XL\nCrimes Amendment (Forensic Procedures) Act 2001                   19",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23xl-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23xl-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "119dc2699b39aa7649bd21c0d8cf955f41217f2dda264344e13133383aee0313",
      "skos:note": "Authorisation for taking hair samples from suspects"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-23xl",
      "@type": "cof:Section",
      "cof:title": "23XL Taking of hair samples",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "A person is authorised to take a sample of hair of a suspect by\nremoving the root of the hair only if:\n(a) the person takes only so much hair as the person believes is\nnecessary for analysis of the sample, or other examination of\nthe hair, to be carried out for the purpose of investigating the\noffence; and\n(b) each strand of hair is taken individually using the least\npainful technique known and available to the person.\n\nCarrying out forensic procedures on suspects  Division 6\nSection 23XL\nCrimes Amendment (Forensic Procedures) Act 2001                   19"
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23xl-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23xl"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23xl-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
