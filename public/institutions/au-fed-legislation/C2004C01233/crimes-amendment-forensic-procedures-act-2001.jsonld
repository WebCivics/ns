      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.10",
      "values:originalText": "Insert:\nCommissioner means the Commissioner of the Australian Federal\nPolice and includes a constable or staff member to whom the\nCommissioner has delegated the functions and powers conferred or\nimposed on the Commissioner under this Act.\nNote:\nSee section 23YQ for the Commissioner’s power to delegate.",
      "skos:definition": "Insert:\nCommissioner means the Commissioner of the Australian Federal\nPolice and includes a constable or staff member to whom the\nCommissioner has delegated the functions and powers conferred or\nimposed on the Commissioner under this Act.\nNote:\nSee section 23YQ for the Commissioner’s power to delegate.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-7-norm"
        }
      ],
      "cml:integrityHash": "f80c835448210cb9fb5a0e18a9f76dce56f6336f5c352f2a405b2bb34e442da3",
      "skos:note": "Definition of Commissioner"
    },
    {
