        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2-ss-3-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "1df445703cb5bc10b8aaa94a6104872740c3fffb713e772a02019fbe418535ab",
      "skos:note": "Affidavit required for application under subsections (1) or (2) Order to permit forensic procedure",
      "dc:description": "affidavit"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-26-2-ss-3",
      "@type": "cof:Section",
      "cof:title": "26(3) Crimes Amendment (Forensic Procedures) Act 2001",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(3) If a judge or magistrate orders an offender who is not in a prison or\nanother place of detention to permit a forensic procedure to be\ncarried out, the judge or magistrate may order the offender to\nattend at a police station (or other place specified by the judge or\nmagistrate) within a period specified by the judge or magistrate to\nallow the forensic procedure to be carried out."
    },
