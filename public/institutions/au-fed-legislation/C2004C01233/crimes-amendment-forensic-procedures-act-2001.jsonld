      "skos:note": "Information from forensic material analysis may be placed on the DNA database system."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-41",
      "@type": "cof:Section",
