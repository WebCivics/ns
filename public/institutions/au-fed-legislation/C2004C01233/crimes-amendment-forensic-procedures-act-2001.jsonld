    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Crimes Amendment (Forensic Procedures) Act 2001",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-14-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
