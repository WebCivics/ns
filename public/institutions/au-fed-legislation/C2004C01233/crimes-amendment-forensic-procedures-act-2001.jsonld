        }
      ],
      "cml:integrityHash": "948c79adfe331f1396de9410b55f0b464b5a427569bd1de5498ec1f2ee0450a4"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-40-2",
