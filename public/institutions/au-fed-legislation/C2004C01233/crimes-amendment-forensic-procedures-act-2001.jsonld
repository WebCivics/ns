    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of refusing forensic procedure without reasonable excuse.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Offender bears evidential burden in relation to exception of reasonable excuse.",
      "cml:conclusionText": "Refusal is an offence."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Imprisonment",
      "cml:logicSummary": "Imprisonment for 12 months for refusing forensic procedure without reasonable excuse.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Offender is guilty of an offence if refuses or fails to permit procedure.",
      "cml:conclusionText": "Imprisonment for 12 months."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2-ss-4-logic-linearlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Refusal implies guilt and imprisonment.",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Offender's refusal implies guilt.",
      "cml:conclusionText": "Imprisonment follows refusal."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2-ss-4-logic-alleninterval-5",
