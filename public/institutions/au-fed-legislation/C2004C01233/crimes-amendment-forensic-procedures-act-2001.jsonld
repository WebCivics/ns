    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-24-2-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "24(1) Crimes Amendment (Forensic Procedures) Act 2001",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-24-2-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
