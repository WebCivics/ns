        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-14-2-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "0d55b67816b260660eca96d719a74f42591efb15af94b868d9999b69774f6196",
      "skos:note": "Offender's conviction offence related to proposed forensic procedure"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-14-2",
      "@type": "cof:Section",
      "cof:title": "14 Crimes Amendment (Forensic Procedures) Act 2001",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "(ii) any other indictable offence arising out of the same\ncircumstances; or\n(iii) any other indictable offence in respect of which the\nevidence likely to be obtained as a result of a proposed\nforensic procedure carried out on the suspect is likely to\nhave probative value; or\n(b) in relation to an offender—the offence for which the offender\nwas convicted and to which an application for an order\nauthorising a forensic procedure relates."
    },
    {
