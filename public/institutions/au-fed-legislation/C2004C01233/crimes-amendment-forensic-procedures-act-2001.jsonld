    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Subsection 23WX(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
