    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Part 1D (simplified outline)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.8",
      "values:originalText": "Section 3\nCrimes Amendment (Forensic Procedures) Act 2001                   9\nRepeal the simplified outline, substitute:\nSimplified outline of operation of Part\nThis Part provides for forensic procedures to be carried out on:\n•\nsuspects in relation to indictable offences (Divisions 3, 4 and\n5); and\n•\noffenders in relation to prescribed and serious offences\n(Division 6A); and\n•\nvolunteers (Division 6B).\nIf the carrying out of a forensic procedure is authorised under this\nPart, it must be carried out in accordance with rules and procedures\nset out in Division 6.\nIf a forensic procedure covered by this Part is carried out without\nproper authority under this Part, evidence obtained through the\nprocedure may be inadmissible in proceedings against the suspect\n(Division 7).\nThis Part also provides for:\n•\nthe establishing of a DNA database system (Division 8A); and\n•\noffences in relation to the DNA database system\n(Division 8A); and\n•\nthe protection of information stored in the DNA database\nsystem (Division 11); and\n•\nthe destruction of forensic material (Division 8A).",
      "skos:definition": "Section 3\nCrimes Amendment (Forensic Procedures) Act 2001                   9\nRepeal the simplified outline, substitute:\nSimplified outline of operation of Part\nThis Part provides for forensic procedures to be carried out on:\n•\nsuspects in relation to indictable offences (Divisions 3, 4 and\n5); and\n•\noffenders in relation to prescribed and serious offences\n(Division 6A); and\n•\nvolunteers (Division 6B).\nIf the carrying out of a forensic procedure is authorised under this\nPart, it must be carried out in accordance with rules and procedures\nset out in Division 6.\nIf a forensic procedure covered by this Part is carried out without\nproper authority under this Part, evidence obtained through the\nprocedure may be inadmissible in proceedings against the suspect\n(Division 7).\nThis Part also provides for:\n•\nthe establishing of a DNA database system (Division 8A); and\n•\noffences in relation to the DNA database system\n(Division 8A); and\n•\nthe protection of information stored in the DNA database\nsystem (Division 11); and\n•\nthe destruction of forensic material (Division 8A).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-4-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "10169ce6d35a0be695110a7c7c401c2a2410a93b97b5cb50179d663eccdaae07",
      "skos:note": "Forensic procedures must be carried out in accordance with rules and procedures set out in Division 6."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Part 1D (simplified outline)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Section 3\nCrimes Amendment (Forensic Procedures) Act 2001                   9\nRepeal the simplified outline, substitute:\nSimplified outline of operation of Part\nThis Part provides for forensic procedures to be carried out on:\n•\nsuspects in relation to indictable offences (Divisions 3, 4 and\n5); and\n•\noffenders in relation to prescribed and serious offences\n(Division 6A); and\n•\nvolunteers (Division 6B).\nIf the carrying out of a forensic procedure is authorised under this\nPart, it must be carried out in accordance with rules and procedures\nset out in Division 6.\nIf a forensic procedure covered by this Part is carried out without\nproper authority under this Part, evidence obtained through the\nprocedure may be inadmissible in proceedings against the suspect\n(Division 7).\nThis Part also provides for:\n•\nthe establishing of a DNA database system (Division 8A); and\n•\noffences in relation to the DNA database system\n(Division 8A); and\n•\nthe protection of information stored in the DNA database\nsystem (Division 11); and\n•\nthe destruction of forensic material (Division 8A)."
    },
