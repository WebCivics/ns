      "cml:integrityHash": "17c9b18641f17329409f6699767e307a73c39398d3391ecc8aef2d323b70b8df",
      "skos:note": "Constable must inform serious offender about non-intimate forensic procedure. Constable must ensure a written record is made and a copy is available to the serious offender.",
      "dc:description": "written record, copy of record"
    },
