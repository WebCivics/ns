    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-86",
      "@type": "cml:Concept",
      "skos:prefLabel": "86 At the end of section 23YV",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-86"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.50",
      "values:originalText": "Add:\n(5) If a written report tabled under subsection (3) identifies\ninadequacies in respect of the matters referred to in subsection (1):\n(a) the Minister must cause a further independent review to be\nundertaken within 2 years of the tabling of that report to\nascertain whether the inadequacies have been effectively\ndealt with; and\n\nInterjurisdictional enforcement  Division 11\nSection 23YUD\nCrimes Amendment (Forensic Procedures) Act 2001                   51\n(b) subsections (2), (3) and (4) apply in relation to the report of\nthat further review in the same manner as they apply in\nrespect of the report of the original review.",
      "skos:definition": "Add:\n(5) If a written report tabled under subsection (3) identifies\ninadequacies in respect of the matters referred to in subsection (1):\n(a) the Minister must cause a further independent review to be\nundertaken within 2 years of the tabling of that report to\nascertain whether the inadequacies have been effectively\ndealt with; and\n\nInterjurisdictional enforcement  Division 11\nSection 23YUD\nCrimes Amendment (Forensic Procedures) Act 2001                   51\n(b) subsections (2), (3) and (4) apply in relation to the report of\nthat further review in the same manner as they apply in\nrespect of the report of the original review.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-86-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-86-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5b37c75c3a908f20460e2a776a411d8eed995daecf840185d99024f45256593c",
      "skos:note": "Minister must cause a further independent review within 2 years if report identifies inadequacies."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-86",
      "@type": "cof:Section",
      "cof:title": "86 At the end of section 23YV",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Add:\n(5) If a written report tabled under subsection (3) identifies\ninadequacies in respect of the matters referred to in subsection (1):\n(a) the Minister must cause a further independent review to be\nundertaken within 2 years of the tabling of that report to\nascertain whether the inadequacies have been effectively\ndealt with; and\n\nInterjurisdictional enforcement  Division 11\nSection 23YUD\nCrimes Amendment (Forensic Procedures) Act 2001                   51\n(b) subsections (2), (3) and (4) apply in relation to the report of\nthat further review in the same manner as they apply in\nrespect of the report of the original review."
    },
