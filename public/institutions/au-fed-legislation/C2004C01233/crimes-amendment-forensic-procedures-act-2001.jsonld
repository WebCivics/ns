    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-2-sec-2"
      },
      "cml:curationStatus": {
