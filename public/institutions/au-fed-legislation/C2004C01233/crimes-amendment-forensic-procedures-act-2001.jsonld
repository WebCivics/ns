      "@type": "cml:Concept",
      "skos:prefLabel": "1 At the end of section 3ZL",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
