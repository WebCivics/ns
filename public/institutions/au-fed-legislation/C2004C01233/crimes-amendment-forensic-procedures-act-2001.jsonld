    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-2-sec-1-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 3(1) (definition of foreign restraining order)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-2-sec-1-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.52",
      "values:originalText": "Repeal the definition, substitute:\nforeign restraining order means an order:\n(a) made under the law of a foreign country in respect of an\noffence against the law of that country; and\n(b) which is, or purports to be, made for the purpose of\npreserving property (whether or not the order also purports to\ndo other things) including an order:\n(i) restraining a particular person or persons from dealing\nwith the property; or\n(ii) freezing the property; or\n(iii) directing the seizure of the property; or\n(iv) directing that the property be taken into official custody\nor control.",
      "skos:definition": "Repeal the definition, substitute:\nforeign restraining order means an order:\n(a) made under the law of a foreign country in respect of an\noffence against the law of that country; and\n(b) which is, or purports to be, made for the purpose of\npreserving property (whether or not the order also purports to\ndo other things) including an order:\n(i) restraining a particular person or persons from dealing\nwith the property; or\n(ii) freezing the property; or\n(iii) directing the seizure of the property; or\n(iv) directing that the property be taken into official custody\nor control.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-2-sec-1-2-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-2-sec-1-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-2-sec-1-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "9597d9ead610712e505a8228ca7519ba9c378164731c266183b501be860df43f",
      "skos:note": "Definition of foreign restraining order"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-2-sec-1-2",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 3(1) (definition of foreign restraining order)",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Repeal the definition, substitute:\nforeign restraining order means an order:\n(a) made under the law of a foreign country in respect of an\noffence against the law of that country; and\n(b) which is, or purports to be, made for the purpose of\npreserving property (whether or not the order also purports to\ndo other things) including an order:\n(i) restraining a particular person or persons from dealing\nwith the property; or\n(ii) freezing the property; or\n(iii) directing the seizure of the property; or\n(iv) directing that the property be taken into official custody\nor control."
    },
