    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23yn",
      "@type": "cml:Concept",
      "skos:prefLabel": "23YN Retention of electronic recordings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-23yn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.44",
      "values:originalText": "(1) A tape recording made by a constable in accordance with this Part\nthat is no longer required for investigative or evidentiary purposes\nmay be retained for such other purposes, and for such period, as the\nCommissioner directs.\n\nDNA database system  Division 8A\nSection 23YO\nCrimes Amendment (Forensic Procedures) Act 2001                   45\n(2) A recording that is retained under this section is to be stored so as\nto protect it against unauthorised access or use by any person.",
      "skos:definition": "(1) A tape recording made by a constable in accordance with this Part\nthat is no longer required for investigative or evidentiary purposes\nmay be retained for such other purposes, and for such period, as the\nCommissioner directs.\n\nDNA database system  Division 8A\nSection 23YO\nCrimes Amendment (Forensic Procedures) Act 2001                   45\n(2) A recording that is retained under this section is to be stored so as\nto protect it against unauthorised access or use by any person.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23yn-ss-1"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23yn-ss-2"
        }
      ],
      "cml:integrityHash": "67c50664c5ff4ea514063d30447e045dea7cef9ffa9ae5f3b1d5342d70ba0eb2"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-23yn",
      "@type": "cof:Section",
      "cof:title": "23YN Retention of electronic recordings",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "(1) A tape recording made by a constable in accordance with this Part\nthat is no longer required for investigative or evidentiary purposes\nmay be retained for such other purposes, and for such period, as the\nCommissioner directs.\n\nDNA database system  Division 8A\nSection 23YO\nCrimes Amendment (Forensic Procedures) Act 2001                   45\n(2) A recording that is retained under this section is to be stored so as\nto protect it against unauthorised access or use by any person."
    },
