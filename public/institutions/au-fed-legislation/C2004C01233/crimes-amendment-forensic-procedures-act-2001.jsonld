      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.44",
      "values:originalText": "Omit “ subsection (1) within 7 days after the material comes into\nexistence”, substitute:\nsubsection (1):\n(a) within 7 days after the material comes into existence; or\n(b) if the material is requested by the suspect, offender or\nvolunteer or the suspect’s, offender’s or volunteer’s interview\nfriend or legal representative, within 7 days of the request.",
      "skos:definition": "Omit “ subsection (1) within 7 days after the material comes into\nexistence”, substitute:\nsubsection (1):\n(a) within 7 days after the material comes into existence; or\n(b) if the material is requested by the suspect, offender or\nvolunteer or the suspect’s, offender’s or volunteer’s interview\nfriend or legal representative, within 7 days of the request.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-75-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-75-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "56536291ccce14ccc49d4ae29f7ea7e7b0bbdaac74f85d6020f54ea19ce7ef70",
      "skos:note": "Material must be provided within 7 days after existence or request.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Subsection 23YG(2)",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "Omit “ subsection (1) within 7 days after the material comes into\nexistence”, substitute:\nsubsection (1):\n(a) within 7 days after the material comes into existence; or\n(b) if the material is requested by the suspect, offender or\nvolunteer or the suspect’s, offender’s or volunteer’s interview\nfriend or legal representative, within 7 days of the request."
    },
