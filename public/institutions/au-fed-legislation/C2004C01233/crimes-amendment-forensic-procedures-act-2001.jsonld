          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-32-2-ss-3"
        }
      ],
      "cml:integrityHash": "03d115d1a461c59237f98559f2227858f9faa60510e58d7505028c79553d002f"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-32-2",
