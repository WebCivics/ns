      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.5",
      "values:originalText": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nSection 3",
      "skos:definition": "Subject to section 2, each Act that is specified in a Schedule to this\nAct is amended or repealed as set out in the applicable items in the\nSchedule concerned, and any other item in a Schedule to this Act\nhas effect according to its terms.\n\nSection 3",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-2-sec-3-norm"
        }
      ],
      "cml:integrityHash": "1991dffaa7d2f8a07374f9ac4e26f16e1f9c7e279b46e8de0a1612a680acd7c1",
      "skos:note": "Amendment and repeal of Acts specified in Schedules"
    },
