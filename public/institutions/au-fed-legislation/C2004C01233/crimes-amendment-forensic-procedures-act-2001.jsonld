      "cml:integrityHash": "1181640e2a56716114d64c9694163ada4baafe48ffda994bc37ec4b14fdbfef8",
      "skos:note": "Authorized applicant may apply for order to take fingerprints of a child or incapable person. Refusal to permit forensic procedure without reasonable excuse is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-26-2-ss-4",
