      "@type": "cml:Concept",
      "skos:prefLabel": "24(2) Crimes Amendment (Forensic Procedures) Act 2001",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-24-2-ss-2"
