        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Refusal precedes imprisonment.",
      "cml:conclusionText": "12 months imprisonment for refusal."
    },
