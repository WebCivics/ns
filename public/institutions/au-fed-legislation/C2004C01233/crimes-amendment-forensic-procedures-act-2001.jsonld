    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-36-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "36(7) At the end of section 23WA",
      "cml:realizedBy": {
