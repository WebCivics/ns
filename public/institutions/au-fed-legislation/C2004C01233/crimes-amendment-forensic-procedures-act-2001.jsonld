    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Subsection 23WA(1) (definition of authorised applicant)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-forensic-procedures-act-2001.pdf"
      },
      "dc:source": "crimes-amendment-forensic-procedures-act-2001.pdf, p.10",
      "values:originalText": "Repeal the definition, substitute:\nauthorised applicant for an order for the carrying out of a forensic\nprocedure means:\n(a) if the procedure will be carried out on a suspect—the\nconstable in charge of a police station or the investigating\nconstable in relation to a relevant offence; or\n(b) if the procedure will be carried out on an offender—the\nconstable in charge of a police station, the investigating\nconstable in relation to a relevant offence or the Director of\nPublic Prosecutions.",
      "skos:definition": "Repeal the definition, substitute:\nauthorised applicant for an order for the carrying out of a forensic\nprocedure means:\n(a) if the procedure will be carried out on a suspect—the\nconstable in charge of a police station or the investigating\nconstable in relation to a relevant offence; or\n(b) if the procedure will be carried out on an offender—the\nconstable in charge of a police station, the investigating\nconstable in relation to a relevant offence or the Director of\nPublic Prosecutions.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-6-norm"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-6-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-6-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "b289229874622b37979283cb9d01601ef0703e658656c92d0954d75ab0ff366c",
      "skos:note": "Defines authorized applicant for forensic procedure"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Subsection 23WA(1) (definition of authorised applicant)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Repeal the definition, substitute:\nauthorised applicant for an order for the carrying out of a forensic\nprocedure means:\n(a) if the procedure will be carried out on a suspect—the\nconstable in charge of a police station or the investigating\nconstable in relation to a relevant offence; or\n(b) if the procedure will be carried out on an offender—the\nconstable in charge of a police station, the investigating\nconstable in relation to a relevant offence or the Director of\nPublic Prosecutions."
    },
