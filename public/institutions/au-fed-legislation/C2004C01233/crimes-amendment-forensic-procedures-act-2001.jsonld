        }
      ],
      "cml:integrityHash": "acdc9385dcd99728fc2a8ae389a443d3bddda41705688946f91b6e9a76117a83",
      "skos:note": "Constable must make a record of order, date, and time when made. Ensure tape recording of information and offender responses.",
      "dc:description": "record of order, date, and time"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-24-2-ss-1",
      "@type": "cof:Section",
      "cof:title": "24(1) Crimes Amendment (Forensic Procedures) Act 2001",
      "values:kind": "subsection",
      "cof:pageNumber": 24,
      "values:originalText": "(1) The constable must, at the time of, or as soon as practicable after,\nmaking an order under section 23XWK, make a record of:\n(a) the order; and\n(b) the date and time when the order was made; and\n(c) the reasons for making it, and sign the record."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-24-2-ss-1-norm",
