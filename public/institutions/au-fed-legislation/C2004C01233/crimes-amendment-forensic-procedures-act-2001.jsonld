    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-26-2-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "26(6) Crimes Amendment (Forensic Procedures) Act 2001",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-26-2-ss-6"
