      ],
      "cml:integrityHash": "53f2cf505f52fbc6b5807352feac0c5abc8375ede5393ce5c1e11ece4b0a6000",
      "skos:note": "Carry out forensic procedure on serious offender or prescribed offender without permission. Inform the offender of certain details about forensic procedure Offender must give informed consent to forensic procedure.",
      "dc:description": "yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-22-2-ss-1",
      "@type": "cof:Section",
      "cof:title": "22(1) Crimes Amendment (Forensic Procedures) Act 2001",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(1) An offender gives informed consent to a forensic procedure if the\noffender consents after a constable:\n(a) requests the offender to consent to the forensic procedure\nunder section 23XWH; and\n(b) informs the offender about the forensic procedure in\naccordance with section 23XWJ; and\n(c) gives the offender the opportunity to communicate, or\nattempt to communicate, with a legal practitioner of the\noffender’s choice."
    },
