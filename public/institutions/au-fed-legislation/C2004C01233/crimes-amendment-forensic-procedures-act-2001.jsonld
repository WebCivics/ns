        }
      ],
      "cml:integrityHash": "dd965b6fecce332754bab144ec6590cb299e8b2f3c65afe824b3afe5aa3bc4b1",
      "skos:note": "Protection against unauthorized access or use of electronic recordings"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-forensic-procedures-act-2001#sch-1-sec-23yn-ss-2",
      "@type": "cof:Section",
      "cof:title": "23YN(2) Retention of electronic recordings",
      "values:kind": "subsection",
      "cof:pageNumber": 44,
      "values:originalText": "(2) A recording that is retained under this section is to be stored so as\nto protect it against unauthorised access or use by any person."
    },
    {
      "@id": "concept:crimes-amendment-forensic-procedures-act-2001-sch-1-sec-23yn-ss-2-norm",
      "@type": "values:Prohibition",
