doc:sec-7a a cof:Section ;
    cof:title "7A Acting Chief Justice" ;
    values:kind "section" ;
    values:originalText "Whenever:  (a) the Chief Justice is absent from Australia or from duty; or   Constitution and Jurisdiction of the Supreme Court  Part II  Section 7B  Australian Capital Territory Supreme Court Act 1933  (b) there is a vacancy in the office of Chief Justice; the next senior Judge who is in Australia and is able and willing to do so shall perform the duties, and may exercise the powers, of the Chief Justice." ;
    cof:pageNumber "10"^^xsd:integer .

concept:australian-capital-territory-supreme-court-act-1933-sec-7b a cml:Concept ;
    skos:prefLabel "7B Arrangement of business of Court"@en ;
    cml:realizedBy doc:sec-7b ;
    values:originalText "The Chief Justice is responsible for ensuring the orderly and expeditious discharge of the business of the Court and accordingly may, subject to this Act and to such consultation with the Judges as is appropriate and practicable, make arrangements as to the Judge or Judges who is or are to constitute the Court in particular matters or classes of matters." ;
    skos:definition "The Chief Justice is responsible for ensuring the orderly and expeditious discharge of the business of the Court and accordingly may, subject to this Act and to such consultation with the Judges as is appropriate and practicable, make arrangements as to the Judge or Judges who is or are to constitute the Court in particular matters or classes of matters."@en ;
    cml:integrityHash "9fa8979b5836bf8569abe0d37ff5e7e983317973c9844d0dffb33264c1de2442" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Ensure orderly and expeditious discharge of Court business" ;
    cml:curationStatus cml:Proposed ;
