concept:australian-capital-territory-supreme-court-act-1933-sec-7a a cml:Concept ;
    skos:prefLabel "7A Acting Chief Justice"@en ;
    cml:realizedBy doc:sec-7a ;
    values:originalText "Whenever:  (a) the Chief Justice is absent from Australia or from duty; or   Constitution and Jurisdiction of the Supreme Court  Part II  Section 7B  Australian Capital Territory Supreme Court Act 1933  (b) there is a vacancy in the office of Chief Justice; the next senior Judge who is in Australia and is able and willing to do so shall perform the duties, and may exercise the powers, of the Chief Justice." ;
    skos:definition "Whenever:  (a) the Chief Justice is absent from Australia or from duty; or   Constitution and Jurisdiction of the Supreme Court  Part II  Section 7B  Australian Capital Territory Supreme Court Act 1933  (b) there is a vacancy in the office of Chief Justice; the next senior Judge who is in Australia and is able and willing to do so shall perform the duties, and may exercise the powers, of the Chief Justice."@en ;
    cml:integrityHash "38f5e34658235ac0dcf8afef59d3518e68a2d83aef04dd87273936e121b48700" ;
    cof:pageNumber "10"^^xsd:integer ;
