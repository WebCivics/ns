    cof:title "44(1) Formal defects to be amended" ;
    values:kind "subsection" ;
    values:originalText "(1) No proceedings in the Supreme Court shall be invalidated by any formal defect or by any irregularity, unless the Court is of opinion that substantial injustice has been caused thereby and that the injustice cannot be remedied by an order of the Court." ;
    cof:pageNumber "35"^^xsd:integer .

concept:australian-capital-territory-supreme-court-act-1933-sec-44-ss-2 a cml:Concept ;
    skos:prefLabel "44(2) Formal defects to be amended"@en ;
    cml:realizedBy doc:sec-44-ss-2 ;
    values:originalText "(2) The Court or the Judge may make an order declaring that any proceeding is valid notwithstanding any such defect or irregularity." ;
    skos:definition "(2) The Court or the Judge may make an order declaring that any proceeding is valid notwithstanding any such defect or irregularity."@en ;
    cml:integrityHash "4e4a0455d17d02e71a5e1cdf04dcc969154bda33c1b6bcc23d949502b26d5def" ;
    values:partOf concept:australian-capital-territory-supreme-court-act-1933-sec-44 ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Court or Judge may declare proceeding valid despite defects." ;
