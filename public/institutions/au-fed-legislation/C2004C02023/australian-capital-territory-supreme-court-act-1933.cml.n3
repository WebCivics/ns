concept:australian-capital-territory-supreme-court-act-1933-sec-5 a cml:Concept ;
    skos:prefLabel "5 Interpretation"@en ;
    cml:realizedBy doc:sec-5 ;
    values:originalText "In this Act, unless the contrary intention appears: additional Judge means a Judge appointed under subsection (2) of section 7; cause includes any suit, and also includes criminal proceedings; Chief Justice means the Chief Justice of the Court, and includes a Judge for the time being performing the duties and exercising the powers of the Chief Justice; defendant includes any person against whom any relief is sought in a matter or who is required to attend the proceedings in a matter as a party thereto; Deputy Registrar means a Deputy Registrar of the Supreme Court; Deputy Sheriff means a Deputy Sheriff of the Territory; enactment has the same meaning as in section 3 of the Australian Capital Territory (Self-Government) Act 1988;" ;
    skos:definition "In this Act, unless the contrary intention appears: additional Judge means a Judge appointed under subsection (2) of section 7; cause includes any suit, and also includes criminal proceedings; Chief Justice means the Chief Justice of the Court, and includes a Judge for the time being performing the duties and exercising the powers of the Chief Justice; defendant includes any person against whom any relief is sought in a matter or who is required to attend the proceedings in a matter as a party thereto; Deputy Registrar means a Deputy Registrar of the Supreme Court; Deputy Sheriff means a Deputy Sheriff of the Territory; enactment has the same meaning as in section 3 of the Australian Capital Territory (Self-Government) Act 1988;"@en ;
    cml:integrityHash "8e63524f4769ee51200a17cd51d4da8f8c6fae13e1589203dc77cb63e07a9d57" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Definitions for terms used in the Act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-supreme-court-act-1933.pdf> ;
    dc:source "australian-capital-territory-supreme-court-act-1933.pdf, p.7" ;
    cml:asserts concept:australian-capital-territory-supreme-court-act-1933-sec-5-norm .
