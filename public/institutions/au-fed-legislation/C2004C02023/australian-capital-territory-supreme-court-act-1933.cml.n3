doc:sec-33f-ss-1 a cof:Section ;
    cof:title "33F(1) Acting appointments" ;
    values:kind "subsection" ;
    values:originalText "(1) The Governor-General may appoint a person who is eligible to be appointed as Master to act as the Master:  (a) during a vacancy in the office of Master (whether or not an appointment has previously been made to the office); or  (b) during any period when the Master is absent from duty or from Australia or is, for any other reason, unable to perform the duties of the office." ;
    cof:pageNumber "28"^^xsd:integer .

concept:australian-capital-territory-supreme-court-act-1933-sec-33f-ss-2 a cml:Concept ;
    skos:prefLabel "33F(2) Acting appointments"@en ;
    cml:realizedBy doc:sec-33f-ss-2 ;
    values:originalText "(2) A person appointed to act as Master shall not continue to act for more than 12 months." ;
