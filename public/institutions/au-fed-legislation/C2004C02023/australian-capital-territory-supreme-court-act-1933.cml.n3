concept:australian-capital-territory-supreme-court-act-1933-sec-9 a cml:Concept ;
    skos:prefLabel "9 Principal seat of court and sittings"@en ;
    cml:realizedBy doc:sec-9 ;
    values:originalText "(1) The Supreme Court may sit at Canberra, and at such other places in the Commonwealth as are from time to time specified by the Governor-General by notice in the Gazette.  (2) The times of the sittings of the Supreme Court shall be such as are from time to time specified by Rules of Court.  (3) The offices of the Supreme Court shall be at Canberra." ;
    skos:definition "(1) The Supreme Court may sit at Canberra, and at such other places in the Commonwealth as are from time to time specified by the Governor-General by notice in the Gazette.  (2) The times of the sittings of the Supreme Court shall be such as are from time to time specified by Rules of Court.  (3) The offices of the Supreme Court shall be at Canberra."@en ;
    cml:integrityHash "7d9779aa6ae44a44ab873d04e7faf6f13b2bbfe725d036def7543f1fb0a3d898" ;
    cof:pageNumber "16"^^xsd:integer ;
