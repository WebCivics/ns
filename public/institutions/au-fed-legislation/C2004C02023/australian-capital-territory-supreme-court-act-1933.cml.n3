concept:australian-capital-territory-supreme-court-act-1933-sec-53-ss-5 a cml:Concept ;
    skos:prefLabel "53(5) Indictable offences"@en ;
    cml:realizedBy doc:sec-53-ss-5 ;
    values:originalText "(5) The last preceding subsection does not authorize the inclusion of more than one count in the same information unless those counts are such as may lawfully be joined in the one information." ;
