    cof:title "39(3) Evidence by affidavit" ;
    values:kind "subsection" ;
    values:originalText "(3) An order under the last preceding subsection may be made subject to such conditions as the Court or Judge thinks just." ;
    cof:pageNumber "33"^^xsd:integer .

concept:australian-capital-territory-supreme-court-act-1933-sec-39-ss-4 a cml:Concept ;
    skos:prefLabel "39(4) Evidence by affidavit"@en ;
    cml:realizedBy doc:sec-39-ss-4 ;
    values:originalText "(4) The conditions referred to in the last preceding subsection may include a condition that copies of an affidavit by which any evidence is given be served on a party or parties to the matter and a condition that a person whose evidence is given by affidavit attend at the hearing for cross examination." ;
