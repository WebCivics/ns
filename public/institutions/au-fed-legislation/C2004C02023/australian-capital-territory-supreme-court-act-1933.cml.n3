    cml:hasPart concept:australian-capital-territory-supreme-court-act-1933-sec-53-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-supreme-court-act-1933.pdf> ;
    dc:source "australian-capital-territory-supreme-court-act-1933.pdf, p.37" .
