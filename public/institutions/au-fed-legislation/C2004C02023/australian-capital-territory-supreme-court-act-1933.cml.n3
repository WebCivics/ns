concept:australian-capital-territory-supreme-court-act-1933-sec-25 a cml:Concept ;
    skos:prefLabel "25 Rules of equity to prevail"@en ;
    cml:realizedBy doc:sec-25 ;
    values:originalText "In questions relating to the custody and education of infants and generally in all matters not particularly mentioned in this Act, in which there was formerly or is any conflict or variance between the rules of equity and the rules of the common law with reference to the same matter, the rules of equity shall prevail." ;
    skos:definition "In questions relating to the custody and education of infants and generally in all matters not particularly mentioned in this Act, in which there was formerly or is any conflict or variance between the rules of equity and the rules of the common law with reference to the same matter, the rules of equity shall prevail."@en ;
    cml:integrityHash "525819bc0e4a3b20486b97a9fa62de198b12d39714ce47c3a8582c87900b31b5" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Rules of equity prevail in conflicts with common law rules." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
