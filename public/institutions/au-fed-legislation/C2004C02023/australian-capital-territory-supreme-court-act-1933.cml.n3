doc:sec-5 a cof:Section ;
    cof:title "5 Interpretation" ;
    values:kind "section" ;
    values:originalText "In this Act, unless the contrary intention appears: additional Judge means a Judge appointed under subsection (2) of section 7; cause includes any suit, and also includes criminal proceedings; Chief Justice means the Chief Justice of the Court, and includes a Judge for the time being performing the duties and exercising the powers of the Chief Justice; defendant includes any person against whom any relief is sought in a matter or who is required to attend the proceedings in a matter as a party thereto; Deputy Registrar means a Deputy Registrar of the Supreme Court; Deputy Sheriff means a Deputy Sheriff of the Territory; enactment has the same meaning as in section 3 of the Australian Capital Territory (Self-Government) Act 1988;" ;
    cof:pageNumber "7"^^xsd:integer .

concept:australian-capital-territory-supreme-court-act-1933-sec-6 a cml:Concept ;
    skos:prefLabel "6 Establishment of Supreme Court"@en ;
    cml:realizedBy doc:sec-6 ;
    values:originalText "(1) There shall be a Supreme Court of the Territory which shall be known as the Supreme Court of the Australian Capital Territory.  (2) The Court shall be a superior court of record.  (3) The Court shall consist of the Chief Justice and not more than 2 other Judges appointed under subsection (1) of the next succeeding section and the additional Judge or Judges appointed under subsection (2) of that section." ;
    skos:definition "(1) There shall be a Supreme Court of the Territory which shall be known as the Supreme Court of the Australian Capital Territory.  (2) The Court shall be a superior court of record.  (3) The Court shall consist of the Chief Justice and not more than 2 other Judges appointed under subsection (1) of the next succeeding section and the additional Judge or Judges appointed under subsection (2) of that section."@en ;
    cml:integrityHash "06a8aeea9ccd44020bbfef03dee4a4f46a35d507ed53469cfdd1505be50bd5bb" ;
    cof:pageNumber "9"^^xsd:integer ;
    cml:hasPart concept:australian-capital-territory-supreme-court-act-1933-sec-6-ss-1 ;
    cml:hasPart concept:australian-capital-territory-supreme-court-act-1933-sec-6-ss-2 ;
    cml:hasPart concept:australian-capital-territory-supreme-court-act-1933-sec-6-ss-3 ;
