doc:sec-7aa-ss-2 a cof:Section ;
    cof:title "7AA(2) Appointments between 1 July 1990 and 30 June 1992" ;
    values:kind "subsection" ;
    values:originalText "(2) Such an appointment shall not be made unless, before tendering advice to the Governor-General, the Attorney-General has consulted with the Australian Capital Territory Executive." ;
    cof:pageNumber "10"^^xsd:integer .

