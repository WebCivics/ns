doc:sec-14-ss-1 a cof:Section ;
    cof:title "14(1) Trial without jury" ;
    values:kind "subsection" ;
    values:originalText "(1) In every suit in the Supreme Court, unless the Court or the Judge otherwise orders, the trial shall be by the Court without a jury." ;
    cof:pageNumber "18"^^xsd:integer .

concept:australian-capital-territory-supreme-court-act-1933-sec-14-ss-2 a cml:Concept ;
    skos:prefLabel "14(2) Trial without jury"@en ;
    cml:realizedBy doc:sec-14-ss-2 ;
    values:originalText "(2) The Supreme Court or the Judge may, if it appears just,, order specially that any action or any issue of fact in any suit shall be tried before the Court with a jury." ;
    skos:definition "(2) The Supreme Court or the Judge may, if it appears just,, order specially that any action or any issue of fact in any suit shall be tried before the Court with a jury."@en ;
