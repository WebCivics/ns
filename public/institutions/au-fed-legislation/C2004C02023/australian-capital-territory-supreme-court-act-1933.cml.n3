concept:australian-capital-territory-supreme-court-act-1933-sec-38 a cml:Concept ;
    skos:prefLabel "38 Manner of giving evidence"@en ;
    cml:realizedBy doc:sec-38 ;
    values:originalText "Except as otherwise provided by this Act by an Ordinance or by an enactment, or unless in any suit the parties agree to the contrary, evidence in any matter shall be given orally in open court." ;
    skos:definition "Except as otherwise provided by this Act by an Ordinance or by an enactment, or unless in any suit the parties agree to the contrary, evidence in any matter shall be given orally in open court."@en ;
    cml:integrityHash "71a46fb66c2d8dd63e3f6e7d3818633e0b60e4b5a858433da26d2881fb36e2eb" ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Oral evidence is required in open court, unless parties agree otherwise." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
