concept:australian-capital-territory-supreme-court-act-1933-sec-49 a cml:Concept ;
    skos:prefLabel "49 Date of process"@en ;
    cml:realizedBy doc:sec-49 ;
    values:originalText "All writs and process issued from the Supreme Court shall be dated as of the day on which they are issued." ;
    skos:definition "All writs and process issued from the Supreme Court shall be dated as of the day on which they are issued."@en ;
