concept:australian-capital-territory-supreme-court-act-1933-sec-54 a cml:Concept ;
    skos:prefLabel "54 Interest on judgments"@en ;
    cml:realizedBy doc:sec-54 ;
    values:originalText "A judgment debt under a judgment of the Court carries interest at such rate as is fixed by the Rules of Court from the date as of which the judgment is entered." ;
    skos:definition "A judgment debt under a judgment of the Court carries interest at such rate as is fixed by the Rules of Court from the date as of which the judgment is entered."@en ;
