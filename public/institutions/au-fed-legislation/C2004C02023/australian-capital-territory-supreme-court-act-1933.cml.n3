doc:sec-17 a cof:Section ;
    cof:title "17 Law and equity to be concurrently administered" ;
    values:kind "section" ;
    values:originalText "Subject to the express provisions of any other Act, in every civil cause or matter commenced in the Supreme Court law and equity shall be administered according to the provisions of sections 18 to 24 (inclusive) of this Act." ;
    cof:pageNumber "19"^^xsd:integer .

concept:australian-capital-territory-supreme-court-act-1933-sec-18 a cml:Concept ;
    skos:prefLabel "18 Equities of plaintiff"@en ;
    cml:realizedBy doc:sec-18 ;
    values:originalText "If a plaintiff or petitioner claims to be entitled to any equitable estate or right, or to relief on any equitable ground against any deed, instrument or contract, or against any right, title or claim whatsoever asserted by any defendant or respondent in the cause or matter, or to any relief founded upon a legal right, which could in England immediately before the commencement of the Judicature Act only have been given by a Court of Equity, the Supreme Court or the Judge shall give to the plaintiff or petitioner the same relief as ought then to have been given by the English Court of Chancery in a suit or proceeding for the like purpose properly instituted." ;
    skos:definition "If a plaintiff or petitioner claims to be entitled to any equitable estate or right, or to relief on any equitable ground against any deed, instrument or contract, or against any right, title or claim whatsoever asserted by any defendant or respondent in the cause or matter, or to any relief founded upon a legal right, which could in England immediately before the commencement of the Judicature Act only have been given by a Court of Equity, the Supreme Court or the Judge shall give to the plaintiff or petitioner the same relief as ought then to have been given by the English Court of Chancery in a suit or proceeding for the like purpose properly instituted."@en ;
    cml:integrityHash "f1c13af8a33b754cd067ef46a8984926fcda1e783307e6eb8e409103048cc3fa" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "The Supreme Court shall give the same relief as the English Court of Chancery." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-supreme-court-act-1933.pdf> ;
    dc:source "australian-capital-territory-supreme-court-act-1933.pdf, p.19" ;
    cml:asserts concept:australian-capital-territory-supreme-court-act-1933-sec-18-norm .
