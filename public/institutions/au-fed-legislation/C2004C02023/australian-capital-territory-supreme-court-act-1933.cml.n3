    skos:prefLabel "40 Appearance by barrister or solicitor"@en ;
    cml:realizedBy doc:sec-40 ;
    values:originalText "A party in a cause or matter may appear before the Supreme Court either personally or by a barrister or solicitor having the right to practise in the Court." ;
