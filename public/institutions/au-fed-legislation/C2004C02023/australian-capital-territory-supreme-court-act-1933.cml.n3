doc:sec-31-ss-1 a cof:Section ;
    cof:title "31(1) Powers and duties of Master" ;
    values:kind "subsection" ;
    values:originalText "(1) The Master has power to administer oaths, and may exercise such other powers, and shall perform such duties, as are assigned to the Master by or under an Act, Ordinance or enactment, by Rules of Court or by a special order of the court." ;
    cof:pageNumber "25"^^xsd:integer .

concept:australian-capital-territory-supreme-court-act-1933-sec-31-ss-2 a cml:Concept ;
    skos:prefLabel "31(2) Powers and duties of Master"@en ;
    cml:realizedBy doc:sec-31-ss-2 ;
    values:originalText "(2) Where, under a law of New South Wales that is continued in force in the Territory as a law of the Territory, a power is exercisable, or a duty is to be performed, or a thing is to be done, by the Master in Equity, it may be exercised, performed or done by:  (a) the Master; or  (b) at a time when there is no Master, the Registrar." ;
    skos:definition "(2) Where, under a law of New South Wales that is continued in force in the Territory as a law of the Territory, a power is exercisable, or a duty is to be performed, or a thing is to be done, by the Master in Equity, it may be exercised, performed or done by:  (a) the Master; or  (b) at a time when there is no Master, the Registrar."@en ;
    cml:integrityHash "17952e9742041fa739082acb2727d7cd033e712577941aa670d1706d04cc37cb" ;
