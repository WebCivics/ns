concept:australian-capital-territory-supreme-court-act-1933-sec-48 a cml:Concept ;
    skos:prefLabel "48 Use of Seals"@en ;
    cml:realizedBy doc:sec-48 ;
    values:originalText "All writs, commissions and process issued from the Supreme Court shall be in the name of the King, and shall be under the Seal of the Court or such other seal as is prescribed by Rules of Court, and shall be signed by the Registrar or other proper officer." ;
    skos:definition "All writs, commissions and process issued from the Supreme Court shall be in the name of the King, and shall be under the Seal of the Court or such other seal as is prescribed by Rules of Court, and shall be signed by the Registrar or other proper officer."@en ;
    cml:integrityHash "9d1e9aeb7af98501f4ebfa03a936627ee2b4d214c4e967b5d557c51440c6c9a7" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "All writs, commissions and process issued from the Supreme Court must be in the name of the King and signed by the Registrar." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-supreme-court-act-1933.pdf> ;
