concept:australian-capital-territory-supreme-court-act-1933-sec-43 a cml:Concept ;
    skos:prefLabel "43 Amendment of defect in proceedings"@en ;
    cml:realizedBy doc:sec-43 ;
    values:originalText "The Supreme Court or the Judge may at any time, and on such terms as it or he thinks just, amend any defect or error in any proceedings in the Court; and all necessary amendments shall be made for the purpose of determining the real questions in controversy or otherwise depending on the proceedings.   General Matters of Procedure  Part V  Section 44  Australian Capital Territory Supreme Court Act 1933" ;
    skos:definition "The Supreme Court or the Judge may at any time, and on such terms as it or he thinks just, amend any defect or error in any proceedings in the Court; and all necessary amendments shall be made for the purpose of determining the real questions in controversy or otherwise depending on the proceedings.   General Matters of Procedure  Part V  Section 44  Australian Capital Territory Supreme Court Act 1933"@en ;
    cml:integrityHash "02810e989cd941614ae868025a10cedb557db6ca93fa57e8499bee9b2e11c436" ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "Supreme Court or Judge may amend defects in proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-supreme-court-act-1933.pdf> ;
