concept:australian-capital-territory-supreme-court-act-1933-sec-17 a cml:Concept ;
    skos:prefLabel "17 Law and equity to be concurrently administered"@en ;
    cml:realizedBy doc:sec-17 ;
    values:originalText "Subject to the express provisions of any other Act, in every civil cause or matter commenced in the Supreme Court law and equity shall be administered according to the provisions of sections 18 to 24 (inclusive) of this Act." ;
    skos:definition "Subject to the express provisions of any other Act, in every civil cause or matter commenced in the Supreme Court law and equity shall be administered according to the provisions of sections 18 to 24 (inclusive) of this Act."@en ;
    cml:integrityHash "0693a33fbd5bc59722723ba75012b19cdbcad344d61e2abb1feb16851033f704" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Law and equity shall be administered concurrently in Supreme Court cases." ;
