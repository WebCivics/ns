      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Equities of plaintiff",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.19",
      "values:originalText": "If a plaintiff or petitioner claims to be entitled to any equitable\nestate or right, or to relief on any equitable ground against any\ndeed, instrument or contract, or against any right, title or claim\nwhatsoever asserted by any defendant or respondent in the cause or\nmatter, or to any relief founded upon a legal right, which could in\nEngland immediately before the commencement of the Judicature\nAct only have been given by a Court of Equity, the Supreme Court\nor the Judge shall give to the plaintiff or petitioner the same relief\nas ought then to have been given by the English Court of Chancery\nin a suit or proceeding for the like purpose properly instituted.",
      "skos:definition": "If a plaintiff or petitioner claims to be entitled to any equitable\nestate or right, or to relief on any equitable ground against any\ndeed, instrument or contract, or against any right, title or claim\nwhatsoever asserted by any defendant or respondent in the cause or\nmatter, or to any relief founded upon a legal right, which could in\nEngland immediately before the commencement of the Judicature\nAct only have been given by a Court of Equity, the Supreme Court\nor the Judge shall give to the plaintiff or petitioner the same relief\nas ought then to have been given by the English Court of Chancery\nin a suit or proceeding for the like purpose properly instituted.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-18-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f1c13af8a33b754cd067ef46a8984926fcda1e783307e6eb8e409103048cc3fa",
      "skos:note": "The Supreme Court shall give the same relief as the English Court of Chancery."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Equities of plaintiff",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "If a plaintiff or petitioner claims to be entitled to any equitable\nestate or right, or to relief on any equitable ground against any\ndeed, instrument or contract, or against any right, title or claim\nwhatsoever asserted by any defendant or respondent in the cause or\nmatter, or to any relief founded upon a legal right, which could in\nEngland immediately before the commencement of the Judicature\nAct only have been given by a Court of Equity, the Supreme Court\nor the Judge shall give to the plaintiff or petitioner the same relief\nas ought then to have been given by the English Court of Chancery\nin a suit or proceeding for the like purpose properly instituted."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-18-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-18"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-18-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The Supreme Court has an obligation to provide the same relief.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Equities of defendant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.19",
      "values:originalText": "If a defendant claims to be entitled to any equitable estate or right,\nor to relief on any equitable ground against any deed, instrument or\ncontract, or against any right, title or claim asserted by any plaintiff\nor petitioner in the cause or matter, or alleges any ground of\nequitable defence to any such claim of the plaintiff or petitioner,\nthe Supreme Court or the Judge shall give to every equitable estate,\nright or ground of relief so claimed, and to every equitable defence\nso alleged, the same effect by way of defence against the claim of\nthe plaintiff or petitioner, as the English Court of Chancery ought,\nimmediately before the commencement of the Judicature Act, to\nhave given if the like matters had been relied on by way of defence",
      "skos:definition": "If a defendant claims to be entitled to any equitable estate or right,\nor to relief on any equitable ground against any deed, instrument or\ncontract, or against any right, title or claim asserted by any plaintiff\nor petitioner in the cause or matter, or alleges any ground of\nequitable defence to any such claim of the plaintiff or petitioner,\nthe Supreme Court or the Judge shall give to every equitable estate,\nright or ground of relief so claimed, and to every equitable defence\nso alleged, the same effect by way of defence against the claim of\nthe plaintiff or petitioner, as the English Court of Chancery ought,\nimmediately before the commencement of the Judicature Act, to\nhave given if the like matters had been relied on by way of defence",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-19-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1389a4207fb1d2690d5be6b0c11468db5b4fabdfa3ad91f1d3428af36f8d47f8",
      "skos:note": "The Supreme Court or Judge must give effect to equitable estates, rights, and grounds of relief claimed by the defendant."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Equities of defendant",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "If a defendant claims to be entitled to any equitable estate or right,\nor to relief on any equitable ground against any deed, instrument or\ncontract, or against any right, title or claim asserted by any plaintiff\nor petitioner in the cause or matter, or alleges any ground of\nequitable defence to any such claim of the plaintiff or petitioner,\nthe Supreme Court or the Judge shall give to every equitable estate,\nright or ground of relief so claimed, and to every equitable defence\nso alleged, the same effect by way of defence against the claim of\nthe plaintiff or petitioner, as the English Court of Chancery ought,\nimmediately before the commencement of the Judicature Act, to\nhave given if the like matters had been relied on by way of defence"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-19-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-19"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-19-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide effect to equitable estates, rights, and grounds of relief.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Counter claims and third parties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.20",
      "values:originalText": "(1) The Supreme Court or the Judge shall have power to grant to any\ndefendant in respect of any equitable estate or right or other matter\nof equity, and also in respect of any legal estate, right or title\nclaimed or asserted by him:\n\n(a) all such relief against any plaintiff or petitioner as the\ndefendant has properly claimed by his pleading, and as the\nCourt or Judge might have granted in any suit instituted for\nthat purpose by that defendant against the same plaintiff or\npetitioner; and\n\n(b) all such relief relating to or connected with the original\nsubject of the cause or matter, claimed in like manner against\nany other person, whether already a party to the cause or\nmatter or not, who has been duly served with notice in\nwriting of the claim pursuant to Rules of Court, any\nOrdinance, any enactment or any order of the Court, as might\nproperly have been granted against that person if he had been\nmade a defendant to a cause duly instituted by the same\ndefendant for the like purpose.\n\n(2) Every person served with any such notice shall thenceforth be\ndeemed a party to the cause or matter with the same rights in\nrespect of his defence against the claim as if he had been duly sued\nin the ordinary way by the defendant.",
      "skos:definition": "(1) The Supreme Court or the Judge shall have power to grant to any\ndefendant in respect of any equitable estate or right or other matter\nof equity, and also in respect of any legal estate, right or title\nclaimed or asserted by him:\n\n(a) all such relief against any plaintiff or petitioner as the\ndefendant has properly claimed by his pleading, and as the\nCourt or Judge might have granted in any suit instituted for\nthat purpose by that defendant against the same plaintiff or\npetitioner; and\n\n(b) all such relief relating to or connected with the original\nsubject of the cause or matter, claimed in like manner against\nany other person, whether already a party to the cause or\nmatter or not, who has been duly served with notice in\nwriting of the claim pursuant to Rules of Court, any\nOrdinance, any enactment or any order of the Court, as might\nproperly have been granted against that person if he had been\nmade a defendant to a cause duly instituted by the same\ndefendant for the like purpose.\n\n(2) Every person served with any such notice shall thenceforth be\ndeemed a party to the cause or matter with the same rights in\nrespect of his defence against the claim as if he had been duly sued\nin the ordinary way by the defendant.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-20-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-20-ss-2"
        }
      ],
      "cml:integrityHash": "ece51440f45db50dcc425edf48973df69c928977cae1c80cb98d5f5a650715ab"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Counter claims and third parties",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "(1) The Supreme Court or the Judge shall have power to grant to any\ndefendant in respect of any equitable estate or right or other matter\nof equity, and also in respect of any legal estate, right or title\nclaimed or asserted by him:\n\n(a) all such relief against any plaintiff or petitioner as the\ndefendant has properly claimed by his pleading, and as the\nCourt or Judge might have granted in any suit instituted for\nthat purpose by that defendant against the same plaintiff or\npetitioner; and\n\n(b) all such relief relating to or connected with the original\nsubject of the cause or matter, claimed in like manner against\nany other person, whether already a party to the cause or\nmatter or not, who has been duly served with notice in\nwriting of the claim pursuant to Rules of Court, any\nOrdinance, any enactment or any order of the Court, as might\nproperly have been granted against that person if he had been\nmade a defendant to a cause duly instituted by the same\ndefendant for the like purpose.\n\n(2) Every person served with any such notice shall thenceforth be\ndeemed a party to the cause or matter with the same rights in\nrespect of his defence against the claim as if he had been duly sued\nin the ordinary way by the defendant."
    },
