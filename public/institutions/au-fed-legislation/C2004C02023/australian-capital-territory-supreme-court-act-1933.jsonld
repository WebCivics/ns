    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Principal seat of court and sittings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.16",
      "values:originalText": "(1) The Supreme Court may sit at Canberra, and at such other places in\nthe Commonwealth as are from time to time specified by the\nGovernor-General by notice in the Gazette.\n\n(2) The times of the sittings of the Supreme Court shall be such as are\nfrom time to time specified by Rules of Court.\n\n(3) The offices of the Supreme Court shall be at Canberra.",
      "skos:definition": "(1) The Supreme Court may sit at Canberra, and at such other places in\nthe Commonwealth as are from time to time specified by the\nGovernor-General by notice in the Gazette.\n\n(2) The times of the sittings of the Supreme Court shall be such as are\nfrom time to time specified by Rules of Court.\n\n(3) The offices of the Supreme Court shall be at Canberra.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-9-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-9-ss-2"
