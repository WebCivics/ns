    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7a",
      "@type": "cml:Concept",
      "skos:prefLabel": "7A Acting Chief Justice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-7a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.10",
      "values:originalText": "Whenever:\n\n(a) the Chief Justice is absent from Australia or from duty; or\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 7B\n\nAustralian Capital Territory Supreme Court Act 1933\n\n(b) there is a vacancy in the office of Chief Justice;\nthe next senior Judge who is in Australia and is able and willing to\ndo so shall perform the duties, and may exercise the powers, of the\nChief Justice.",
      "skos:definition": "Whenever:\n\n(a) the Chief Justice is absent from Australia or from duty; or\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 7B\n\nAustralian Capital Territory Supreme Court Act 1933\n\n(b) there is a vacancy in the office of Chief Justice;\nthe next senior Judge who is in Australia and is able and willing to\ndo so shall perform the duties, and may exercise the powers, of the\nChief Justice.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7a-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "38f5e34658235ac0dcf8afef59d3518e68a2d83aef04dd87273936e121b48700",
      "skos:note": "Duties of Acting Chief Justice"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-7a",
      "@type": "cof:Section",
      "cof:title": "7A Acting Chief Justice",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Whenever:\n\n(a) the Chief Justice is absent from Australia or from duty; or\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 7B\n\nAustralian Capital Territory Supreme Court Act 1933\n\n(b) there is a vacancy in the office of Chief Justice;\nthe next senior Judge who is in Australia and is able and willing to\ndo so shall perform the duties, and may exercise the powers, of the\nChief Justice."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7a-logic-deontic-1",
