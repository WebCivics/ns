    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ac",
      "@type": "cml:Concept",
      "skos:prefLabel": "8AC Manner in which question to be decided where jurisdiction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8ac"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.14",
      "values:originalText": "exercised by 3 or more Judges\n\nIf three or more Judges sitting together in accordance with\nsection 8AAA, 8AA or 8AB are divided in opinion as to the\ndecision to be given on any question, the question shall be decided\naccording to the opinion of the majority, if there is a majority, but\nif the Judges are equally divided in opinion:\n\n(a) in a case where a judgment of the Master is called in\nquestion—the judgment shall be affirmed; and\n\n(b) in any other case:\n\n(i) where a Judge or Judges appointed under\nsubsection 7(1) is or are sitting—the opinion of that\nJudge or of the senior of them, as the case may be,\nprevails; or\n\n(ii) where no such Judge is sitting—the opinion of the\nsenior additional Judge sitting prevails.",
      "skos:definition": "exercised by 3 or more Judges\n\nIf three or more Judges sitting together in accordance with\nsection 8AAA, 8AA or 8AB are divided in opinion as to the\ndecision to be given on any question, the question shall be decided\naccording to the opinion of the majority, if there is a majority, but\nif the Judges are equally divided in opinion:\n\n(a) in a case where a judgment of the Master is called in\nquestion—the judgment shall be affirmed; and\n\n(b) in any other case:\n\n(i) where a Judge or Judges appointed under\nsubsection 7(1) is or are sitting—the opinion of that\nJudge or of the senior of them, as the case may be,\nprevails; or\n\n(ii) where no such Judge is sitting—the opinion of the\nsenior additional Judge sitting prevails.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ac-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ac-logic-deontic-1"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ac-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ac-logic-argumentation-3"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ac-logic-diffusion-4"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ac-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "a09701c65871f0f18c39f491418892f88e50e40ae14aa32367c89d6551cac98c",
      "skos:note": "Judges' decision on a question is decided according to the majority opinion, with certain exceptions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8ac",
      "@type": "cof:Section",
      "cof:title": "8AC Manner in which question to be decided where jurisdiction",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "exercised by 3 or more Judges\n\nIf three or more Judges sitting together in accordance with\nsection 8AAA, 8AA or 8AB are divided in opinion as to the\ndecision to be given on any question, the question shall be decided\naccording to the opinion of the majority, if there is a majority, but\nif the Judges are equally divided in opinion:\n\n(a) in a case where a judgment of the Master is called in\nquestion—the judgment shall be affirmed; and\n\n(b) in any other case:\n\n(i) where a Judge or Judges appointed under\nsubsection 7(1) is or are sitting—the opinion of that\nJudge or of the senior of them, as the case may be,\nprevails; or\n\n(ii) where no such Judge is sitting—the opinion of the\nsenior additional Judge sitting prevails."
    },
