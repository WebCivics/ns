      ],
      "cml:integrityHash": "4be58f288c52b4a31830aa0096830d528f1f2fb883b8d8e93ea03a173518e490",
      "skos:note": "A party may appear before the Supreme Court by a barrister or solicitor."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-40",
