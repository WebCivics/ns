      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.36",
      "values:originalText": "All writs and process issued from the Supreme Court shall be dated\nas of the day on which they are issued.",
      "skos:definition": "All writs and process issued from the Supreme Court shall be dated\nas of the day on which they are issued.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-49-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-49-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "41a38f2681eb0d0090fbe2e965cee596537bd9d32cab0d124dff64ec2963eb2a",
      "skos:note": "All writs and process issued from the Supreme Court must be dated as of the day they are issued."
    },
    {
