      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Obligation to amend",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-44",
      "@type": "cml:Concept",
      "skos:prefLabel": "44 Formal defects to be amended",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-44"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.35",
      "values:originalText": "(1) No proceedings in the Supreme Court shall be invalidated by any\nformal defect or by any irregularity, unless the Court is of opinion\nthat substantial injustice has been caused thereby and that the\ninjustice cannot be remedied by an order of the Court.\n\n(2) The Court or the Judge may make an order declaring that any\nproceeding is valid notwithstanding any such defect or irregularity.",
      "skos:definition": "(1) No proceedings in the Supreme Court shall be invalidated by any\nformal defect or by any irregularity, unless the Court is of opinion\nthat substantial injustice has been caused thereby and that the\ninjustice cannot be remedied by an order of the Court.\n\n(2) The Court or the Judge may make an order declaring that any\nproceeding is valid notwithstanding any such defect or irregularity.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-44-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-44-ss-2"
        }
      ],
      "cml:integrityHash": "602e7bd6b8eddd045e819827450050d8975087cc4ead72304f18f4b384e68a5a"
    },
