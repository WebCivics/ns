    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-53-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "53(3) Indictable offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-53-ss-3"
