      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-25-logic-deontic-1",
      "@type": "cml:LogicApplication",
