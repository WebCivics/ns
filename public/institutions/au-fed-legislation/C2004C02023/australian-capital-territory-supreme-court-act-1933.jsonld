    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-54",
      "@type": "cml:Concept",
      "skos:prefLabel": "54 Interest on judgments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-54"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.39",
      "values:originalText": "A judgment debt under a judgment of the Court carries interest at\nsuch rate as is fixed by the Rules of Court from the date as of\nwhich the judgment is entered.",
      "skos:definition": "A judgment debt under a judgment of the Court carries interest at\nsuch rate as is fixed by the Rules of Court from the date as of\nwhich the judgment is entered.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-54-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-54-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7fc8faaabc216a01d6f3bbaa4fd6a6fdd1e5b571b1a41fd5c9b40ce23611d0b3",
      "skos:note": "Interest on judgments is payable at a rate fixed by the Rules of Court from the date of judgment entry."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-54",
      "@type": "cof:Section",
      "cof:title": "54 Interest on judgments",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "A judgment debt under a judgment of the Court carries interest at\nsuch rate as is fixed by the Rules of Court from the date as of\nwhich the judgment is entered."
    },
