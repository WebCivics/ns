    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33c",
      "@type": "cml:Concept",
      "skos:prefLabel": "33C Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.26",
      "values:originalText": "The Master may resign by writing signed and delivered to the\nGovernor-General.\n\n\nThe Master  Part III\n\nSection 33D\n\nAustralian Capital Territory Supreme Court Act 1933",
      "skos:definition": "The Master may resign by writing signed and delivered to the\nGovernor-General.\n\n\nThe Master  Part III\n\nSection 33D\n\nAustralian Capital Territory Supreme Court Act 1933",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33c-norm"
        }
      ],
      "cml:integrityHash": "49b0e0b3bc0ac668c0a32b9ee0c5fc02246b40c2dd911389b7a7157a302f74cd",
      "skos:note": "The Master may resign by writing signed and delivered to the Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33c",
      "@type": "cof:Section",
      "cof:title": "33C Resignation",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "The Master may resign by writing signed and delivered to the\nGovernor-General.\n\n\nThe Master  Part III\n\nSection 33D\n\nAustralian Capital Territory Supreme Court Act 1933"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33c-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
