    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Appointment of Master",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "(1) The Master shall be appointed by the Governor-General.\n\n(2) A person shall not be appointed as the Master unless the person has\nbeen enrolled as a legal practitioner of the High Court or of the\nSupreme Court of a State or Territory for not less than 5 years.\n\n(3) A person who has attained 65 years of age shall not be appointed\nas the Master."
    },
