          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33d-ss-4-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "dc2dae2a1b1571dd7b9fb36f794f84e0895dc1e9d5379131b66adbaf5263cc58",
      "skos:note": "Suspension terminates if statement is not laid before House or address under subsection (1) is not presented to Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33d-ss-4",
      "@type": "cof:Section",
      "cof:title": "33D(4) Removal from office",
      "values:kind": "subsection",
      "cof:pageNumber": 27,
      "values:originalText": "(4) The suspension terminates if:\n\n(a) at the end of 7 sitting days of a House of the Parliament after\nthe suspension, the statement has not been laid before that\nHouse; or\n\n(b) at the end of 15 sitting days of a House of the Parliament\nafter the day on which the statement has been laid before that\nHouse, an address under subsection (1) has not been\npresented to the Governor-General by that House."
    },
