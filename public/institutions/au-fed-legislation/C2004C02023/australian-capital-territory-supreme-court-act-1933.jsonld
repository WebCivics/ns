        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33f-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c8e0569408e365b6e670aae84f6d4b929813e9a4bc0f5c7233ff0b59db288144",
      "skos:note": "Person may continue acting until vacancy is filled."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33f-ss-3",
      "@type": "cof:Section",
      "cof:title": "33F(3) Acting appointments",
      "values:kind": "subsection",
      "cof:pageNumber": 28,
      "values:originalText": "(3) Where:\n\n(a) a person is acting under paragraph (1)(b); and\n\n(b) the office of Master becomes vacant;\nthen, subject to subsection (2), the person may continue to act until\nthe vacancy is filled."
    },
