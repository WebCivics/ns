    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-43",
      "@type": "cml:Concept",
      "skos:prefLabel": "43 Amendment of defect in proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-43"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.34",
      "values:originalText": "The Supreme Court or the Judge may at any time, and on such\nterms as it or he thinks just, amend any defect or error in any\nproceedings in the Court; and all necessary amendments shall be\nmade for the purpose of determining the real questions in\ncontroversy or otherwise depending on the proceedings.\n\n\nGeneral Matters of Procedure  Part V\n\nSection 44\n\nAustralian Capital Territory Supreme Court Act 1933",
      "skos:definition": "The Supreme Court or the Judge may at any time, and on such\nterms as it or he thinks just, amend any defect or error in any\nproceedings in the Court; and all necessary amendments shall be\nmade for the purpose of determining the real questions in\ncontroversy or otherwise depending on the proceedings.\n\n\nGeneral Matters of Procedure  Part V\n\nSection 44\n\nAustralian Capital Territory Supreme Court Act 1933",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-43-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-43-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "02810e989cd941614ae868025a10cedb557db6ca93fa57e8499bee9b2e11c436",
      "skos:note": "Supreme Court or Judge may amend defects in proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-43",
      "@type": "cof:Section",
      "cof:title": "43 Amendment of defect in proceedings",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "The Supreme Court or the Judge may at any time, and on such\nterms as it or he thinks just, amend any defect or error in any\nproceedings in the Court; and all necessary amendments shall be\nmade for the purpose of determining the real questions in\ncontroversy or otherwise depending on the proceedings.\n\n\nGeneral Matters of Procedure  Part V\n\nSection 44\n\nAustralian Capital Territory Supreme Court Act 1933"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-43-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-43"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-43-logic-deontic-1",
