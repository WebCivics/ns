    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-37-2",
      "@type": "cof:Section",
      "cof:title": "37 All’ powers’ and ‘functions ‘exercisable’ by,’ and all ‘",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "rights,’privileges, immunities, duties and liabilities belonging to,\nthe Sheriff of New South Wales in the State of New South Wales\nunder any law of that State which is continued in force in the\nTerritory as a law of the Territory, shall, in the Territory, be\nexercisable by and belong to the Sheriff of the Territory."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-37-2-norm",
