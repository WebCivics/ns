      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-42-ss-2-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-42-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0e15f7ac610791996eb6532329e83bd622caef2b5212faa860ed86ca90ae0f53",
      "skos:note": "Court may proceed with jurisdiction despite defendant's non-appearance."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-42-ss-2",
      "@type": "cof:Section",
      "cof:title": "42(2) Non-appearance or absence of some defendants",
      "values:kind": "subsection",
      "cof:pageNumber": 34,
      "values:originalText": "(2) When, in any suit of which the Supreme Court has jurisdiction, any\ndefendant is not a resident of, or found within, the Commonwealth,\nand does not voluntarily appear in the suit, the Court may\nnevertheless proceed to exercise its jurisdiction after such notice to\nthe defendant and upon such terms as are prescribed by Rules of\nCourt."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-42-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-42-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
