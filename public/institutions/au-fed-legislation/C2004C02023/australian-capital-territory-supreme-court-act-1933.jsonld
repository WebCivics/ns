    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Regulations relating to fees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.24",
      "values:originalText": "The Governor-General may make regulations:\n\n(a) prescribing the fees or other payments to be paid to officers\nof the Court in respect of proceedings in the Court, or of the\nservice or execution of the process of the Court by officers of\nthe Court; and\n\n(b) making provision, not inconsistent with this Act, necessary or\nconvenient to be made for and in relation to the payment or\nremission of any such fees or other payments.\n\n\nThe Master  Part III\n\nSection 30\n\nAustralian Capital Territory Supreme Court Act 1933",
      "skos:definition": "The Governor-General may make regulations:\n\n(a) prescribing the fees or other payments to be paid to officers\nof the Court in respect of proceedings in the Court, or of the\nservice or execution of the process of the Court by officers of\nthe Court; and\n\n(b) making provision, not inconsistent with this Act, necessary or\nconvenient to be made for and in relation to the payment or\nremission of any such fees or other payments.\n\n\nThe Master  Part III\n\nSection 30\n\nAustralian Capital Territory Supreme Court Act 1933",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-29-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-29-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7732bdffbefb77abe2ec77a0585e5f8e873c4103422c19239a094216d02d83a3",
      "skos:note": "Governor-General may make regulations regarding fees and payments."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Regulations relating to fees",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "The Governor-General may make regulations:\n\n(a) prescribing the fees or other payments to be paid to officers\nof the Court in respect of proceedings in the Court, or of the\nservice or execution of the process of the Court by officers of\nthe Court; and\n\n(b) making provision, not inconsistent with this Act, necessary or\nconvenient to be made for and in relation to the payment or\nremission of any such fees or other payments.\n\n\nThe Master  Part III\n\nSection 30\n\nAustralian Capital Territory Supreme Court Act 1933"
    },
