    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-9-ss-1",
      "@type": "cof:Section",
      "cof:title": "9(1) Principal seat of court and sittings",
      "values:kind": "subsection",
      "cof:pageNumber": 16,
      "values:originalText": "(1) The Supreme Court may sit at Canberra, and at such other places in\nthe Commonwealth as are from time to time specified by the\nGovernor-General by notice in the Gazette."
    },
