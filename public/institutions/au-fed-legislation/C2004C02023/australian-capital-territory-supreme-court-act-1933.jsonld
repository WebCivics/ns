    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 November 2009",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
