    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Equities appearing incidentally",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.20",
      "values:originalText": "The Supreme Court or the Judge shall take notice of all equitable\nestates, titles and rights, and all equitable duties and liabilities\nappearing incidentally in the course of any cause or matter, in the\nsame manner in which the English Court of Chancery would,\nimmediately before the commencement of the Judicature Act, have\ntaken notice of those matters in any suit or proceeding properly\ninstituted therein.\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 22\n\nAustralian Capital Territory Supreme Court Act 1933",
      "skos:definition": "The Supreme Court or the Judge shall take notice of all equitable\nestates, titles and rights, and all equitable duties and liabilities\nappearing incidentally in the course of any cause or matter, in the\nsame manner in which the English Court of Chancery would,\nimmediately before the commencement of the Judicature Act, have\ntaken notice of those matters in any suit or proceeding properly\ninstituted therein.\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 22\n\nAustralian Capital Territory Supreme Court Act 1933",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-21-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-21-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "17abe6662c204f8799232271598fc9a3291f7c2ce4ed29028be2c3bfcac47a65",
      "skos:note": "Notice of equitable estates and rights appearing incidentally in court proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Equities appearing incidentally",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "The Supreme Court or the Judge shall take notice of all equitable\nestates, titles and rights, and all equitable duties and liabilities\nappearing incidentally in the course of any cause or matter, in the\nsame manner in which the English Court of Chancery would,\nimmediately before the commencement of the Judicature Act, have\ntaken notice of those matters in any suit or proceeding properly\ninstituted therein.\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 22\n\nAustralian Capital Territory Supreme Court Act 1933"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-21-norm",
      "@type": "values:Obligation",
      "cml:modality": {
