    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Law and equity to be concurrently administered",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.19",
      "values:originalText": "Subject to the express provisions of any other Act, in every civil\ncause or matter commenced in the Supreme Court law and equity\nshall be administered according to the provisions of sections 18 to\n24 (inclusive) of this Act.",
      "skos:definition": "Subject to the express provisions of any other Act, in every civil\ncause or matter commenced in the Supreme Court law and equity\nshall be administered according to the provisions of sections 18 to\n24 (inclusive) of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-17-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-17-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0693a33fbd5bc59722723ba75012b19cdbcad344d61e2abb1feb16851033f704",
      "skos:note": "Law and equity shall be administered concurrently in Supreme Court cases."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Law and equity to be concurrently administered",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Subject to the express provisions of any other Act, in every civil\ncause or matter commenced in the Supreme Court law and equity\nshall be administered according to the provisions of sections 18 to\n24 (inclusive) of this Act."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-17-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
