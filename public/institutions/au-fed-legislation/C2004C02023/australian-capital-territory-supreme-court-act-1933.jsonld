    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Establishment of Supreme Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-6"
