      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Defence or stay instead of injunction or prohibition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.21",
      "values:originalText": "No cause or proceeding at any time pending in the Supreme Court\nshall be restrained by prohibition or injunction, but every matter of\nequity on which an injunction against the prosecution of any such\ncause or proceeding, if such cause or proceeding had been a suit or\nproceeding properly instituted in the English Court of Chancery for\nthe like purpose, might, immediately before the commencement of\nthe Judicature Act, have been obtained, whether unconditionally or\non any terms or conditions, may be relied on by way of defence\nthereto;\nProvided that:\n\n(a) nothing in this Act shall disable the Court, if it thinks fit so to\ndo, from directing a stay of proceedings in any cause or\nmatter pending before it; and\n\n(b) any person, whether a party or not to any such cause or\nmatter, who, if the cause or matter had been a suit or\nproceeding properly instituted in the English Court of\nChancery for the like purpose would, immediately before the\ncommencement of the Judicature Act, have been entitled to\napply to any court to restrain the prosecution thereof, or who\nmay be entitled to enforce, by attachment or otherwise, any\njudgment, decree, rule or order, in contravention of which all\nor any part of the proceedings in the cause or matter have\nbeen taken, may apply to the Court by motion in a summary\nway, for a stay of proceedings in the cause or matter, either\ngenerally, or so far as may be necessary for the purposes of\njustice, and the Court shall thereupon make such order as is\njust.",
      "skos:definition": "No cause or proceeding at any time pending in the Supreme Court\nshall be restrained by prohibition or injunction, but every matter of\nequity on which an injunction against the prosecution of any such\ncause or proceeding, if such cause or proceeding had been a suit or\nproceeding properly instituted in the English Court of Chancery for\nthe like purpose, might, immediately before the commencement of\nthe Judicature Act, have been obtained, whether unconditionally or\non any terms or conditions, may be relied on by way of defence\nthereto;\nProvided that:\n\n(a) nothing in this Act shall disable the Court, if it thinks fit so to\ndo, from directing a stay of proceedings in any cause or\nmatter pending before it; and\n\n(b) any person, whether a party or not to any such cause or\nmatter, who, if the cause or matter had been a suit or\nproceeding properly instituted in the English Court of\nChancery for the like purpose would, immediately before the\ncommencement of the Judicature Act, have been entitled to\napply to any court to restrain the prosecution thereof, or who\nmay be entitled to enforce, by attachment or otherwise, any\njudgment, decree, rule or order, in contravention of which all\nor any part of the proceedings in the cause or matter have\nbeen taken, may apply to the Court by motion in a summary\nway, for a stay of proceedings in the cause or matter, either\ngenerally, or so far as may be necessary for the purposes of\njustice, and the Court shall thereupon make such order as is\njust.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-22-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9d82ea2d58f7b210b2caa71a135746795375e56d03fa644eb7bcf59f8f7fcbb6",
      "skos:note": "No cause or proceeding can be restrained by prohibition or injunction."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Defence or stay instead of injunction or prohibition",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "No cause or proceeding at any time pending in the Supreme Court\nshall be restrained by prohibition or injunction, but every matter of\nequity on which an injunction against the prosecution of any such\ncause or proceeding, if such cause or proceeding had been a suit or\nproceeding properly instituted in the English Court of Chancery for\nthe like purpose, might, immediately before the commencement of\nthe Judicature Act, have been obtained, whether unconditionally or\non any terms or conditions, may be relied on by way of defence\nthereto;\nProvided that:\n\n(a) nothing in this Act shall disable the Court, if it thinks fit so to\ndo, from directing a stay of proceedings in any cause or\nmatter pending before it; and\n\n(b) any person, whether a party or not to any such cause or\nmatter, who, if the cause or matter had been a suit or\nproceeding properly instituted in the English Court of\nChancery for the like purpose would, immediately before the\ncommencement of the Judicature Act, have been entitled to\napply to any court to restrain the prosecution thereof, or who\nmay be entitled to enforce, by attachment or otherwise, any\njudgment, decree, rule or order, in contravention of which all\nor any part of the proceedings in the cause or matter have\nbeen taken, may apply to the Court by motion in a summary\nway, for a stay of proceedings in the cause or matter, either\ngenerally, or so far as may be necessary for the purposes of\njustice, and the Court shall thereupon make such order as is\njust."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-22-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
