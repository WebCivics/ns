    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "7AA Appointments between 1 July 1990 and 30 June 1992",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-7aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.10",
      "values:originalText": "(1) This section applies to an appointment made under section 7 on or\nafter 1 July 1990 at a time when this Act has not become an\nenactment within the meaning of the Australian Capital Territory\n(Self-Government) Act 1988.\n\n(2) Such an appointment shall not be made unless, before tendering\nadvice to the Governor-General, the Attorney-General has\nconsulted with the Australian Capital Territory Executive.\n\n(3) This section ceases to have effect on 1 July 1992.",
      "skos:definition": "(1) This section applies to an appointment made under section 7 on or\nafter 1 July 1990 at a time when this Act has not become an\nenactment within the meaning of the Australian Capital Territory\n(Self-Government) Act 1988.\n\n(2) Such an appointment shall not be made unless, before tendering\nadvice to the Governor-General, the Attorney-General has\nconsulted with the Australian Capital Territory Executive.\n\n(3) This section ceases to have effect on 1 July 1992.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7aa-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7aa-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7aa-ss-3"
        }
      ],
      "cml:integrityHash": "0678ea57f29bbdb0230b4a5e751d85878f1da78e712a4899cb5a2fb95aaa0f38"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-7aa",
      "@type": "cof:Section",
      "cof:title": "7AA Appointments between 1 July 1990 and 30 June 1992",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) This section applies to an appointment made under section 7 on or\nafter 1 July 1990 at a time when this Act has not become an\nenactment within the meaning of the Australian Capital Territory\n(Self-Government) Act 1988.\n\n(2) Such an appointment shall not be made unless, before tendering\nadvice to the Governor-General, the Attorney-General has\nconsulted with the Australian Capital Territory Executive.\n\n(3) This section ceases to have effect on 1 July 1992."
    },
