    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Trial without jury",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.18",
      "values:originalText": "(1) In every suit in the Supreme Court, unless the Court or the Judge\notherwise orders, the trial shall be by the Court without a jury.\n\n(2) The Supreme Court or the Judge may, if it appears just,, order\nspecially that any action or any issue of fact in any suit shall be\ntried before the Court with a jury.\n\n(3) The Supreme Court shall exercise the same jurisdiction as the\nSupreme Court of New South Wales sitting in Banco has, at the\ncommencement of this Act, to set aside a verdict or finding f a\njury, to enter judgment notwithstanding any such verdict or finding\nand to order a new trial after a trial with a jury.",
      "skos:definition": "(1) In every suit in the Supreme Court, unless the Court or the Judge\notherwise orders, the trial shall be by the Court without a jury.\n\n(2) The Supreme Court or the Judge may, if it appears just,, order\nspecially that any action or any issue of fact in any suit shall be\ntried before the Court with a jury.\n\n(3) The Supreme Court shall exercise the same jurisdiction as the\nSupreme Court of New South Wales sitting in Banco has, at the\ncommencement of this Act, to set aside a verdict or finding f a\njury, to enter judgment notwithstanding any such verdict or finding\nand to order a new trial after a trial with a jury.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-14-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-14-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-14-ss-3"
        }
      ],
      "cml:integrityHash": "1a0bdcc9a115918d98b0d538b3e00c60cfaed09e5e4dbb107cf088fb3f60eb60"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Trial without jury",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "(1) In every suit in the Supreme Court, unless the Court or the Judge\notherwise orders, the trial shall be by the Court without a jury.\n\n(2) The Supreme Court or the Judge may, if it appears just,, order\nspecially that any action or any issue of fact in any suit shall be\ntried before the Court with a jury.\n\n(3) The Supreme Court shall exercise the same jurisdiction as the\nSupreme Court of New South Wales sitting in Banco has, at the\ncommencement of this Act, to set aside a verdict or finding f a\njury, to enter judgment notwithstanding any such verdict or finding\nand to order a new trial after a trial with a jury."
    },
