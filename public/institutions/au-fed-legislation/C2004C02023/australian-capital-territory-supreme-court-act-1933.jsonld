      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.33",
      "values:originalText": "A party in a cause or matter may appear before the Supreme Court\neither personally or by a barrister or solicitor having the right to\npractise in the Court.",
      "skos:definition": "A party in a cause or matter may appear before the Supreme Court\neither personally or by a barrister or solicitor having the right to\npractise in the Court.",
