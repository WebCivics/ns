    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33d-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "33D(4) Removal from office",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33d-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
