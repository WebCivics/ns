    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8a",
      "@type": "cml:Concept",
      "skos:prefLabel": "8A Holding of other judicial offices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.15",
      "values:originalText": "A person may be a Judge of the Supreme Court notwithstanding\nthat he is also a Judge of another court created by the Parliament,\nor is also the holder of a judicial office in a Territory other than the\nAustralian Capital Territory, by virtue of an appointment made\neither before or after his appointment as a Judge of the Supreme\nCourt.",
      "skos:definition": "A person may be a Judge of the Supreme Court notwithstanding\nthat he is also a Judge of another court created by the Parliament,\nor is also the holder of a judicial office in a Territory other than the\nAustralian Capital Territory, by virtue of an appointment made\neither before or after his appointment as a Judge of the Supreme\nCourt.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8a-norm"
        }
      ],
      "cml:integrityHash": "93a56ae6a072a5475b65e89ef5b4d3f18844ebe0f1af7e112608f2d2245d9620",
      "skos:note": "A person may hold multiple judicial offices."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8a",
      "@type": "cof:Section",
      "cof:title": "8A Holding of other judicial offices",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "A person may be a Judge of the Supreme Court notwithstanding\nthat he is also a Judge of another court created by the Parliament,\nor is also the holder of a judicial office in a Territory other than the\nAustralian Capital Territory, by virtue of an appointment made\neither before or after his appointment as a Judge of the Supreme\nCourt."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8b",
      "@type": "cml:Concept",
      "skos:prefLabel": "8B Salary and allowances of Judges",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.15",
      "values:originalText": "(1) The Chief Justice and the other Judges appointed under\nsubsection (1) of section 7 shall receive salary, annual allowances\nand travelling allowances at such respective rates as are fixed from\ntime to time by the Parliament.\n\n(2) The salary and annual allowance to which a Judge is entitled under\nthis section accrue from day to day and are payable monthly.\n\n(3) An additional Judge shall be remunerated with the salary and\nannual allowance that he receives as a Judge of the other court or\ncourts of which he is a Judge.\n\n(4) The Consolidated Revenue Fund is appropriated to the extent\nnecessary for payment of salaries and allowances in accordance\nwith subsection (1).\n\n(5) Subject to subsection (6), a person who holds office as a Judge of\nthe Court by virtue of an appointment that took effect while he was\na Judge (including the Chief Judge) of the Federal Court of\nAustralia is not, while he continues to hold office both as a Judge\nof the Court and as a Judge (including the Chief Judge) of the\nFederal Court of Australia, entitled to receive salary or annual\nallowance as provided in subsection (1).",
      "skos:definition": "(1) The Chief Justice and the other Judges appointed under\nsubsection (1) of section 7 shall receive salary, annual allowances\nand travelling allowances at such respective rates as are fixed from\ntime to time by the Parliament.\n\n(2) The salary and annual allowance to which a Judge is entitled under\nthis section accrue from day to day and are payable monthly.\n\n(3) An additional Judge shall be remunerated with the salary and\nannual allowance that he receives as a Judge of the other court or\ncourts of which he is a Judge.\n\n(4) The Consolidated Revenue Fund is appropriated to the extent\nnecessary for payment of salaries and allowances in accordance\nwith subsection (1).\n\n(5) Subject to subsection (6), a person who holds office as a Judge of\nthe Court by virtue of an appointment that took effect while he was\na Judge (including the Chief Judge) of the Federal Court of\nAustralia is not, while he continues to hold office both as a Judge\nof the Court and as a Judge (including the Chief Judge) of the\nFederal Court of Australia, entitled to receive salary or annual\nallowance as provided in subsection (1).",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8b-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8b-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8b-ss-3"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8b-ss-4"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8b-ss-5"
        }
      ],
      "cml:integrityHash": "ad77fe825e5425b180837b604daef0b118218317a4b7bdbddac049c9a5c8db47"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8b",
      "@type": "cof:Section",
      "cof:title": "8B Salary and allowances of Judges",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "(1) The Chief Justice and the other Judges appointed under\nsubsection (1) of section 7 shall receive salary, annual allowances\nand travelling allowances at such respective rates as are fixed from\ntime to time by the Parliament.\n\n(2) The salary and annual allowance to which a Judge is entitled under\nthis section accrue from day to day and are payable monthly.\n\n(3) An additional Judge shall be remunerated with the salary and\nannual allowance that he receives as a Judge of the other court or\ncourts of which he is a Judge.\n\n(4) The Consolidated Revenue Fund is appropriated to the extent\nnecessary for payment of salaries and allowances in accordance\nwith subsection (1).\n\n(5) Subject to subsection (6), a person who holds office as a Judge of\nthe Court by virtue of an appointment that took effect while he was\na Judge (including the Chief Judge) of the Federal Court of\nAustralia is not, while he continues to hold office both as a Judge\nof the Court and as a Judge (including the Chief Judge) of the\nFederal Court of Australia, entitled to receive salary or annual\nallowance as provided in subsection (1)."
    },
