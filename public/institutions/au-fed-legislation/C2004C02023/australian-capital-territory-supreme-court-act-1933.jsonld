    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Rules of equity to prevail",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.22",
      "values:originalText": "In questions relating to the custody and education of infants and\ngenerally in all matters not particularly mentioned in this Act, in\nwhich there was formerly or is any conflict or variance between the\nrules of equity and the rules of the common law with reference to\nthe same matter, the rules of equity shall prevail.",
      "skos:definition": "In questions relating to the custody and education of infants and\ngenerally in all matters not particularly mentioned in this Act, in\nwhich there was formerly or is any conflict or variance between the\nrules of equity and the rules of the common law with reference to\nthe same matter, the rules of equity shall prevail.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-25-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-25-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "525819bc0e4a3b20486b97a9fa62de198b12d39714ce47c3a8582c87900b31b5",
      "skos:note": "Rules of equity prevail in conflicts with common law rules."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Rules of equity to prevail",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "In questions relating to the custody and education of infants and\ngenerally in all matters not particularly mentioned in this Act, in\nwhich there was formerly or is any conflict or variance between the\nrules of equity and the rules of the common law with reference to\nthe same matter, the rules of equity shall prevail."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-25-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
