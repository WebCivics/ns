          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ab-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c9aad3a0403c7404654d2eea7168ebecd89637229d8a5ae8a110bcd7bc269c49",
      "skos:note": "Jurisdiction of Court in a matter shall be exercised by not less than three Judges sitting together in Court."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8ab-ss-4",
      "@type": "cof:Section",
      "cof:title": "8AB(4) Power of Judge to order that jurisdiction in a matter be",
      "values:kind": "subsection",
