      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) Where, under a law of New South Wales that is continued in force\nin the Territory as a law of the Territory, a power is exercisable, or\na duty is to be performed, or a thing is to be done, by the Master in\nEquity...",
      "cml:conclusionText": "it may be exercised, performed or done by:\n(a) the Master; or\n(b) at a time when there is no Master, the Registrar."
    },
