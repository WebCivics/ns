    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-53-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "53(3A) Indictable offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-53-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.37",
      "values:originalText": "(3A) Nothing in subsection (1):\n\n(a) affects the power of the Director of Public Prosecutions to\nprosecute by information in his official name; or\n\n(b) affects, or shall be taken to have affected, the power of a\nSpecial Prosecutor to prosecute by information in his own\nname; an indictable offence triable before the Supreme Court.",
      "skos:definition": "(3A) Nothing in subsection (1):\n\n(a) affects the power of the Director of Public Prosecutions to\nprosecute by information in his official name; or\n\n(b) affects, or shall be taken to have affected, the power of a\nSpecial Prosecutor to prosecute by information in his own\nname; an indictable offence triable before the Supreme Court.",
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-53"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-53-ss-3a-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-53-ss-3a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a8efb55ce6840ff0b0cbe1c024587b846cf0898367c323ed1c22790f73c99768",
      "skos:note": "Preserves prosecution powers of Director and Special Prosecutor"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-53-ss-3a",
      "@type": "cof:Section",
      "cof:title": "53(3A) Indictable offences",
      "values:kind": "subsection",
      "cof:pageNumber": 37,
      "values:originalText": "(3A) Nothing in subsection (1):\n\n(a) affects the power of the Director of Public Prosecutions to\nprosecute by information in his official name; or\n\n(b) affects, or shall be taken to have affected, the power of a\nSpecial Prosecutor to prosecute by information in his own\nname; an indictable offence triable before the Supreme Court."
    },
