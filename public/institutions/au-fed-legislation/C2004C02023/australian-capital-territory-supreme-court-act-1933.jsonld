    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-47",
      "@type": "cml:Concept",
      "skos:prefLabel": "47 Seal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-47"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.36",
      "values:originalText": "The Supreme Court shall have and use as occasion requires a Seal,\nhaving inscribed thereon the words ‘The Seal of the Supreme Court\nof the Australian Capital Territory’. The Seal shall be kept in such\ncustody as the Chief Justice directs.",
      "skos:definition": "The Supreme Court shall have and use as occasion requires a Seal,\nhaving inscribed thereon the words ‘The Seal of the Supreme Court\nof the Australian Capital Territory’. The Seal shall be kept in such\ncustody as the Chief Justice directs.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-47-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-47-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "231417f1201b6a7f39c4b6577b4266a164e427fb582d14ce7175d4f200db426e",
      "skos:note": "The Supreme Court must use a Seal as occasion requires."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-47",
      "@type": "cof:Section",
      "cof:title": "47 Seal",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "The Supreme Court shall have and use as occasion requires a Seal,\nhaving inscribed thereon the words ‘The Seal of the Supreme Court\nof the Australian Capital Territory’. The Seal shall be kept in such\ncustody as the Chief Justice directs."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-47-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
