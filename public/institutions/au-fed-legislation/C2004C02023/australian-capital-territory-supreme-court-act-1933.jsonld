    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 Duty of receiver and manager",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.40",
      "values:originalText": "When, in any cause pending in the Supreme Court, a receiver or\nmanager appointed by the Court is in possession of any property,\nthe receiver or manager shall manage and deal with the property\naccording to the requirements of the laws of the State or part of the\nCommonwealth in which the property is situated, in the same\nmanner in which the owner or possessor thereof would be bound to\ndo if in possession thereof.",
      "skos:definition": "When, in any cause pending in the Supreme Court, a receiver or\nmanager appointed by the Court is in possession of any property,\nthe receiver or manager shall manage and deal with the property\naccording to the requirements of the laws of the State or part of the\nCommonwealth in which the property is situated, in the same\nmanner in which the owner or possessor thereof would be bound to\ndo if in possession thereof.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-57-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-57-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f8958bca616b66f341553a6e8151852eae3ea1e3e65556386e36d797b45cc30d",
      "skos:note": "Receiver or manager must manage and deal with property according to state laws."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-57",
      "@type": "cof:Section",
      "cof:title": "57 Duty of receiver and manager",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "When, in any cause pending in the Supreme Court, a receiver or\nmanager appointed by the Court is in possession of any property,\nthe receiver or manager shall manage and deal with the property\naccording to the requirements of the laws of the State or part of the\nCommonwealth in which the property is situated, in the same\nmanner in which the owner or possessor thereof would be bound to\ndo if in possession thereof."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-57-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-57"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-57-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "shall",
      "cml:logicSummary": "Expresses a duty obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-58",
      "@type": "cml:Concept",
      "skos:prefLabel": "58 Liability and protection of receivers and managers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-58"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.40",
      "values:originalText": "A receiver or manager of any property appointed by the Supreme\nCourt may, without the previous leave of the Court, be sued in\nrespect of any act or transaction of his in carrying on the business\nconnected with the property.\n59  Action by or against Sheriff etc.\n\nWhen the Sheriff or a Deputy Sheriff is a party to a cause in the\nSupreme Court, all writs, summonses, orders, warrants, precepts,\nprocess and commands in the cause which should in the ordinary\ncourse be directed to him shall be directed to such disinterested\nperson as the Court or the Judge appoints; and the person so\nappointed may execute and return them.\n\n\nEndnotes\n\nEndnote 1—Legislation history\n\nAustralian Capital Territory Supreme Court Act 1933\n\nEndnotes\n\nEndnote 1—Legislation history\nThis endnote sets out details of the legislation history of the Australian Capital\nTerritory Supreme Court Act 1933.\n\nAct\nNumber\nand year\nAssent\nCommencement\nApplication,\nsaving and\ntransitional\nprovisions\nAustralian Capital\nTerritory Supreme Court\nAct 1933\n34, 1933",
      "skos:definition": "A receiver or manager of any property appointed by the Supreme\nCourt may, without the previous leave of the Court, be sued in\nrespect of any act or transaction of his in carrying on the business\nconnected with the property.\n59  Action by or against Sheriff etc.\n\nWhen the Sheriff or a Deputy Sheriff is a party to a cause in the\nSupreme Court, all writs, summonses, orders, warrants, precepts,\nprocess and commands in the cause which should in the ordinary\ncourse be directed to him shall be directed to such disinterested\nperson as the Court or the Judge appoints; and the person so\nappointed may execute and return them.\n\n\nEndnotes\n\nEndnote 1—Legislation history\n\nAustralian Capital Territory Supreme Court Act 1933\n\nEndnotes\n\nEndnote 1—Legislation history\nThis endnote sets out details of the legislation history of the Australian Capital\nTerritory Supreme Court Act 1933.\n\nAct\nNumber\nand year\nAssent\nCommencement\nApplication,\nsaving and\ntransitional\nprovisions\nAustralian Capital\nTerritory Supreme Court\nAct 1933\n34, 1933",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-58-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-58-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1f8fee4219dac5c5c2853d01965c5d62a220f27d652ca44a8bc5a670ecb831bb",
      "skos:note": "A receiver or manager may be sued without previous leave of the Court."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-58",
      "@type": "cof:Section",
      "cof:title": "58 Liability and protection of receivers and managers",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "A receiver or manager of any property appointed by the Supreme\nCourt may, without the previous leave of the Court, be sued in\nrespect of any act or transaction of his in carrying on the business\nconnected with the property.\n59  Action by or against Sheriff etc.\n\nWhen the Sheriff or a Deputy Sheriff is a party to a cause in the\nSupreme Court, all writs, summonses, orders, warrants, precepts,\nprocess and commands in the cause which should in the ordinary\ncourse be directed to him shall be directed to such disinterested\nperson as the Court or the Judge appoints; and the person so\nappointed may execute and return them.\n\n\nEndnotes\n\nEndnote 1—Legislation history\n\nAustralian Capital Territory Supreme Court Act 1933\n\nEndnotes\n\nEndnote 1—Legislation history\nThis endnote sets out details of the legislation history of the Australian Capital\nTerritory Supreme Court Act 1933.\n\nAct\nNumber\nand year\nAssent\nCommencement\nApplication,\nsaving and\ntransitional\nprovisions\nAustralian Capital\nTerritory Supreme Court\nAct 1933\n34, 1933"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-58-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
