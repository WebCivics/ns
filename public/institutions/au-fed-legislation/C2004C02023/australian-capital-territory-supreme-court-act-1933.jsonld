    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Establishment of Supreme Court",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "(1) There shall be a Supreme Court of the Territory which shall be\nknown as the Supreme Court of the Australian Capital Territory.\n\n(2) The Court shall be a superior court of record.\n\n(3) The Court shall consist of the Chief Justice and not more than 2\nother Judges appointed under subsection (1) of the next succeeding\nsection and the additional Judge or Judges appointed under\nsubsection (2) of that section."
    },
