    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Common law and statutory rights and duties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.21",
      "values:originalText": "Subject to the provisions of this Act for giving effect to equitable\nrights and other matters of equity, the Supreme Court or the Judge\nshall give effect to all legal claims and demands, and all estates,\ntitles, rights, duties, obligations and liabilities existing under the\nlaw in force in the Territory, including common law and custom.",
      "skos:definition": "Subject to the provisions of this Act for giving effect to equitable\nrights and other matters of equity, the Supreme Court or the Judge\nshall give effect to all legal claims and demands, and all estates,\ntitles, rights, duties, obligations and liabilities existing under the\nlaw in force in the Territory, including common law and custom.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-23-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "314000f68733c8084cd3a6e9f55bba3414e344376362602f4850c0e1bf31a534",
      "skos:note": "Supreme Court or Judge must give effect to all legal claims and demands, estates, titles, rights, duties, obligations, and liabilities."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Common law and statutory rights and duties",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "Subject to the provisions of this Act for giving effect to equitable\nrights and other matters of equity, the Supreme Court or the Judge\nshall give effect to all legal claims and demands, and all estates,\ntitles, rights, duties, obligations and liabilities existing under the\nlaw in force in the Territory, including common law and custom."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-23-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-23"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-23-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to give effect to legal claims and demands.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-24-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Determination of matter completely and finally",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-24-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.22",
      "values:originalText": "The Supreme Court, in the exercise of the jurisdiction vested in it\nby this Act, shall, in every cause or matter pending before the\nCourt, grant, either absolutely or on such terms and conditions as\nthe Court thinks just, all such remedies whatsoever as any of the\nparties thereto may appear to be entitled to in respect of any legal\nor equitable claim properly brought forward by them in the cause\nor matter, so that, as far as possible, all matters in controversy\nbetween the parties may be completely and finally determined, and\nall multiplicity of legal proceedings concerning any of those\nmatters avoided.",
      "skos:definition": "The Supreme Court, in the exercise of the jurisdiction vested in it\nby this Act, shall, in every cause or matter pending before the\nCourt, grant, either absolutely or on such terms and conditions as\nthe Court thinks just, all such remedies whatsoever as any of the\nparties thereto may appear to be entitled to in respect of any legal\nor equitable claim properly brought forward by them in the cause\nor matter, so that, as far as possible, all matters in controversy\nbetween the parties may be completely and finally determined, and\nall multiplicity of legal proceedings concerning any of those\nmatters avoided.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-24-2-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-24-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "201c8d20cc27e7e18b5ab7453267fe78c1fa83611b4e2c99d239746056db32ec",
      "skos:note": "The Supreme Court must grant remedies in every cause or matter pending before the Court."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-24-2",
      "@type": "cof:Section",
      "cof:title": "24 Determination of matter completely and finally",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "The Supreme Court, in the exercise of the jurisdiction vested in it\nby this Act, shall, in every cause or matter pending before the\nCourt, grant, either absolutely or on such terms and conditions as\nthe Court thinks just, all such remedies whatsoever as any of the\nparties thereto may appear to be entitled to in respect of any legal\nor equitable claim properly brought forward by them in the cause\nor matter, so that, as far as possible, all matters in controversy\nbetween the parties may be completely and finally determined, and\nall multiplicity of legal proceedings concerning any of those\nmatters avoided."
    },
