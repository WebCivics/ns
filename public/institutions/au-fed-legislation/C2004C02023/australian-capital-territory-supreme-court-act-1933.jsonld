    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Sheriff",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.31",
      "values:originalText": "The Sheriff shall be charged with the service and execution of all\nwrits, summonses, orders, warrants, precepts, process, and\ncommands of the Supreme Court which are directed to him, and\nshall make such return thereof to the Court, together with the\nmanner of the execution thereof, as he is thereby required, and\nshall take receive and detain all persons who are committed to his\ncustody by the Court, and shall discharge all such persons when\nthereunto directed by the Court or by law.",
      "skos:definition": "The Sheriff shall be charged with the service and execution of all\nwrits, summonses, orders, warrants, precepts, process, and\ncommands of the Supreme Court which are directed to him, and\nshall make such return thereof to the Court, together with the\nmanner of the execution thereof, as he is thereby required, and\nshall take receive and detain all persons who are committed to his\ncustody by the Court, and shall discharge all such persons when\nthereunto directed by the Court or by law.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-36-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-36-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5590e8dcef51cd214f2dbf122be80a3210f2dc0cf1a1cd35fbfdcae49fdf4d77",
      "skos:note": "The Sheriff has an obligation to serve and execute court orders."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Sheriff",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "The Sheriff shall be charged with the service and execution of all\nwrits, summonses, orders, warrants, precepts, process, and\ncommands of the Supreme Court which are directed to him, and\nshall make such return thereof to the Court, together with the\nmanner of the execution thereof, as he is thereby required, and\nshall take receive and detain all persons who are committed to his\ncustody by the Court, and shall discharge all such persons when\nthereunto directed by the Court or by law."
    },
