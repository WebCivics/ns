    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33a",
      "@type": "cml:Concept",
      "skos:prefLabel": "33A Oath or affirmation of office",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.26",
      "values:originalText": "The Master shall, before proceeding to discharge the duties of the\noffice, take, before the Chief Justice or another Judge of the Court,\nan oath or affirmation in the following form:\n\n‘I,                               , do swear that I will be faithful and bear true\nallegiance to Her Majesty Queen Elizabeth the Second, Her Heirs\nand Successors according to law and that I will well and truly serve\nHer in the office of Master of the Supreme Court of the Australian\nCapital Territory, So help me God.’ or\n\n‘I,                               , do solemnly and sincerely promise and\ndeclare that I will be faithful and bear true allegiance to Her\nMajesty Queen Elizabeth the Second, Her Heirs and Successors\naccording to law and that I will well and truly serve Her in the\noffice of Master of the Supreme Court of the Australian Capital\nTerritory.’",
      "skos:definition": "The Master shall, before proceeding to discharge the duties of the\noffice, take, before the Chief Justice or another Judge of the Court,\nan oath or affirmation in the following form:\n\n‘I,                               , do swear that I will be faithful and bear true\nallegiance to Her Majesty Queen Elizabeth the Second, Her Heirs\nand Successors according to law and that I will well and truly serve\nHer in the office of Master of the Supreme Court of the Australian\nCapital Territory, So help me God.’ or\n\n‘I,                               , do solemnly and sincerely promise and\ndeclare that I will be faithful and bear true allegiance to Her\nMajesty Queen Elizabeth the Second, Her Heirs and Successors\naccording to law and that I will well and truly serve Her in the\noffice of Master of the Supreme Court of the Australian Capital\nTerritory.’",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33a-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9bf86fd9947bf043cac822aa497641ebb088a5d5857060c735750a0eb774c5d1",
      "skos:note": "Take an oath or affirmation before proceeding to discharge duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33a",
      "@type": "cof:Section",
      "cof:title": "33A Oath or affirmation of office",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "The Master shall, before proceeding to discharge the duties of the\noffice, take, before the Chief Justice or another Judge of the Court,\nan oath or affirmation in the following form:\n\n‘I,                               , do swear that I will be faithful and bear true\nallegiance to Her Majesty Queen Elizabeth the Second, Her Heirs\nand Successors according to law and that I will well and truly serve\nHer in the office of Master of the Supreme Court of the Australian\nCapital Territory, So help me God.’ or\n\n‘I,                               , do solemnly and sincerely promise and\ndeclare that I will be faithful and bear true allegiance to Her\nMajesty Queen Elizabeth the Second, Her Heirs and Successors\naccording to law and that I will well and truly serve Her in the\noffice of Master of the Supreme Court of the Australian Capital\nTerritory.’"
    },
