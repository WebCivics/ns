        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-16-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "949b422cfef6a8e9d607220533a230dac02db260cddf3f1eb6f4f257e76669a9",
      "skos:note": "Service of writs out of jurisdiction allowed"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Service of writs out of the jurisdiction of the Court",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Writs of summons issued out of the Supreme Court and notices of\nsuch writs may be served out of the jurisdiction of the Court in the\nmanner and to the extent provided by the Rules of Court."
    },
