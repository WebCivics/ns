    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Security of the peace and for good behaviour",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-55"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.39",
      "values:originalText": "A Judge, or, if three or more Judges are sitting together for the\npurpose of exercising jurisdiction of the Court that is exercisable\nby not less than three Judges, those Judges, shall have the like\nauthority to hold to security of the peace and for good behaviour in\nmatters arising under the laws of the Territory as may be lawfully\nexercised by a Judge of the Supreme Court of New South Wales in\ncases cognizable before him.",
      "skos:definition": "A Judge, or, if three or more Judges are sitting together for the\npurpose of exercising jurisdiction of the Court that is exercisable\nby not less than three Judges, those Judges, shall have the like\nauthority to hold to security of the peace and for good behaviour in\nmatters arising under the laws of the Territory as may be lawfully\nexercised by a Judge of the Supreme Court of New South Wales in\ncases cognizable before him.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-55-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-55-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "63c2455812f48bb972feace8801aa2f06b924f0e5f73f7c09f17ed485e2e2716",
      "skos:note": "Authority to hold security of the peace and for good behaviour."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-55",
      "@type": "cof:Section",
      "cof:title": "55 Security of the peace and for good behaviour",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "A Judge, or, if three or more Judges are sitting together for the\npurpose of exercising jurisdiction of the Court that is exercisable\nby not less than three Judges, those Judges, shall have the like\nauthority to hold to security of the peace and for good behaviour in\nmatters arising under the laws of the Territory as may be lawfully\nexercised by a Judge of the Supreme Court of New South Wales in\ncases cognizable before him."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-55-norm",
