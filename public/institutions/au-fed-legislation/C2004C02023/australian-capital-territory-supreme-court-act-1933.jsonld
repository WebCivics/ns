    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Matter heard at one place may be further dealt with at another",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.35",
      "values:originalText": "place\n\nWhen any cause or matter has been heard at a sitting of the\nSupreme Court held at any place the Court may pronounce\njudgment or give further hearing or consideration to the cause or\nmatter at a sitting of the Court held at another place, being a place\nat which the Court is empowered to sit.",
      "skos:definition": "place\n\nWhen any cause or matter has been heard at a sitting of the\nSupreme Court held at any place the Court may pronounce\njudgment or give further hearing or consideration to the cause or\nmatter at a sitting of the Court held at another place, being a place\nat which the Court is empowered to sit.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-45-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-45-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b580c7fcab6ef32651bf023afba1d0e2291940a7d5bd7cd675a167b1f84426fc",
      "skos:note": "Court may pronounce judgment or give further hearing at another place"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Matter heard at one place may be further dealt with at another",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "place\n\nWhen any cause or matter has been heard at a sitting of the\nSupreme Court held at any place the Court may pronounce\njudgment or give further hearing or consideration to the cause or\nmatter at a sitting of the Court held at another place, being a place\nat which the Court is empowered to sit."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-45-norm",
