    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33b",
      "@type": "cml:Concept",
      "skos:prefLabel": "33B Remuneration and allowances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.26",
      "values:originalText": "Subject to the Remuneration Tribunals Act 1973, the Master shall\nbe paid:\n\n(a) such remuneration as is determined by the Remuneration\nTribunal; and\n\n(b) such allowances as are prescribed.",
      "skos:definition": "Subject to the Remuneration Tribunals Act 1973, the Master shall\nbe paid:\n\n(a) such remuneration as is determined by the Remuneration\nTribunal; and\n\n(b) such allowances as are prescribed.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33b-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f893702bcbdf75af9c0e68ce97add10df905d0aa57571fe4fbbd89dac51d7621",
      "skos:note": "Master shall be paid remuneration and allowances determined by the Remuneration Tribunal."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33b",
      "@type": "cof:Section",
      "cof:title": "33B Remuneration and allowances",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Subject to the Remuneration Tribunals Act 1973, the Master shall\nbe paid:\n\n(a) such remuneration as is determined by the Remuneration\nTribunal; and\n\n(b) such allowances as are prescribed."
    },
    {
