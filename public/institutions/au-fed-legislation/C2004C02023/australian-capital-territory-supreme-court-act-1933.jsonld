      "cml:integrityHash": "7d9779aa6ae44a44ab873d04e7faf6f13b2bbfe725d036def7543f1fb0a3d898"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Principal seat of court and sittings",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "(1) The Supreme Court may sit at Canberra, and at such other places in\nthe Commonwealth as are from time to time specified by the\nGovernor-General by notice in the Gazette.\n\n(2) The times of the sittings of the Supreme Court shall be such as are\nfrom time to time specified by Rules of Court.\n\n(3) The offices of the Supreme Court shall be at Canberra."
    },
