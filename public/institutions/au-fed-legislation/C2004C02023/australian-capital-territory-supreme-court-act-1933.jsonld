    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "8AA Exercise of jurisdiction in relation to legal practitioners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.13",
      "values:originalText": "(1) The jurisdiction of the Supreme Court in the following matters\nshall be exercised by not less than three Judges sitting together in\nCourt:\n\n(a) an application under any Ordinance relating to legal\npractitioners for admission of a person to practise as a\nbarrister and solicitor, or as a barrister or as a solicitor, of the\nCourt;\n\n(b) any matter relating to the issue of, or the cancellation of, a\npractising certificate under any such Ordinance; and\n\n(c) any matter relating to the professional behaviour or conduct\nof a legal practitioner.",
      "skos:definition": "(1) The jurisdiction of the Supreme Court in the following matters\nshall be exercised by not less than three Judges sitting together in\nCourt:\n\n(a) an application under any Ordinance relating to legal\npractitioners for admission of a person to practise as a\nbarrister and solicitor, or as a barrister or as a solicitor, of the\nCourt;\n\n(b) any matter relating to the issue of, or the cancellation of, a\npractising certificate under any such Ordinance; and\n\n(c) any matter relating to the professional behaviour or conduct\nof a legal practitioner.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8aa-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "76aecbf930db40c773f36b02d5ca2bf6eea36628f84dcb64b7da8185babc2cd6",
      "skos:note": "Supreme Court jurisdiction over legal practitioners' admission and practising certificate issues."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8aa",
      "@type": "cof:Section",
      "cof:title": "8AA Exercise of jurisdiction in relation to legal practitioners",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) The jurisdiction of the Supreme Court in the following matters\nshall be exercised by not less than three Judges sitting together in\nCourt:\n\n(a) an application under any Ordinance relating to legal\npractitioners for admission of a person to practise as a\nbarrister and solicitor, or as a barrister or as a solicitor, of the\nCourt;\n\n(b) any matter relating to the issue of, or the cancellation of, a\npractising certificate under any such Ordinance; and\n\n(c) any matter relating to the professional behaviour or conduct\nof a legal practitioner."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8aa-norm",
      "@type": "values:Obligation",
