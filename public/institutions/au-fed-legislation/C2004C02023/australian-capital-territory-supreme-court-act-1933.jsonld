      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Date of process",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-49"
      },
      "cml:curationStatus": {
