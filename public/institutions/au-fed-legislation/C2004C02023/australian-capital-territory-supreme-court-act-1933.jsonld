    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-8ab-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "8AB(4) Power of Judge to order that jurisdiction in a matter be",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-8ab-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
