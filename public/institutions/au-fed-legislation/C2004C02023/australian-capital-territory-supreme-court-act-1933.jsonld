        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-46-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3b075a5bc543aa8d57c01585e835727157a6d6f3b19c8f6d6cca1fe3d4dca202",
      "skos:note": "The trial shall be had or continued at some particular place."
    },
    {
