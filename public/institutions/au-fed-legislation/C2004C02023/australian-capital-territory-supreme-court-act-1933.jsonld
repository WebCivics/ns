      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7b",
      "@type": "cml:Concept",
      "skos:prefLabel": "7B Arrangement of business of Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-7b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.11",
      "values:originalText": "The Chief Justice is responsible for ensuring the orderly and\nexpeditious discharge of the business of the Court and accordingly\nmay, subject to this Act and to such consultation with the Judges as\nis appropriate and practicable, make arrangements as to the Judge\nor Judges who is or are to constitute the Court in particular matters\nor classes of matters.",
      "skos:definition": "The Chief Justice is responsible for ensuring the orderly and\nexpeditious discharge of the business of the Court and accordingly\nmay, subject to this Act and to such consultation with the Judges as\nis appropriate and practicable, make arrangements as to the Judge\nor Judges who is or are to constitute the Court in particular matters\nor classes of matters.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7b-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9fa8979b5836bf8569abe0d37ff5e7e983317973c9844d0dffb33264c1de2442",
      "skos:note": "Ensure orderly and expeditious discharge of Court business"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-7b",
      "@type": "cof:Section",
      "cof:title": "7B Arrangement of business of Court",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "The Chief Justice is responsible for ensuring the orderly and\nexpeditious discharge of the business of the Court and accordingly\nmay, subject to this Act and to such consultation with the Judges as\nis appropriate and practicable, make arrangements as to the Judge\nor Judges who is or are to constitute the Court in particular matters\nor classes of matters."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7b-norm",
