    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-46",
      "@type": "cml:Concept",
      "skos:prefLabel": "46 Change of venue",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-46"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.35",
      "values:originalText": "The Supreme Court or the Judge may, at any stage of any suit\npending in the Court, direct that the trial shall be had or continued\nat some particular place, being a place at which the Court is",
      "skos:definition": "The Supreme Court or the Judge may, at any stage of any suit\npending in the Court, direct that the trial shall be had or continued\nat some particular place, being a place at which the Court is",
      "cml:asserts": [
