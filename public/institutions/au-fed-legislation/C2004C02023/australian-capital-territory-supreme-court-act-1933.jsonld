    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "7(1A) Appointment and tenure of Judges",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-7-ss-1a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.9",
      "values:originalText": "(1A) A person shall not be appointed under subsection (1) if he has\nattained the age of 70 years and a person shall not be so appointed\nunless he is or has been a Judge of a court created by the\nParliament or of a court of a State or has been enrolled as a legal\npractitioner of the High Court or of the Supreme Court of a State or\nTerritory for not less than 5 years.",
      "skos:definition": "(1A) A person shall not be appointed under subsection (1) if he has\nattained the age of 70 years and a person shall not be so appointed\nunless he is or has been a Judge of a court created by the\nParliament or of a court of a State or has been enrolled as a legal\npractitioner of the High Court or of the Supreme Court of a State or\nTerritory for not less than 5 years.",
      "values:partOf": {
        "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-7-ss-1a-norm"
        }
      ],
      "cml:integrityHash": "262c143726fc6d48eb3b0ed44475d0a2b4c45644cb08698ed82aa2b11d4c0740",
      "skos:note": "No person shall be appointed under subsection (1) if he has attained the age of 70 years."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-7-ss-1a",
      "@type": "cof:Section",
      "cof:title": "7(1A) Appointment and tenure of Judges",
      "values:kind": "subsection",
      "cof:pageNumber": 9,
      "values:originalText": "(1A) A person shall not be appointed under subsection (1) if he has\nattained the age of 70 years and a person shall not be so appointed\nunless he is or has been a Judge of a court created by the\nParliament or of a court of a State or has been enrolled as a legal\npractitioner of the High Court or of the Supreme Court of a State or\nTerritory for not less than 5 years."
    },
