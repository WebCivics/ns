    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-39-ss-4",
      "@type": "cof:Section",
      "cof:title": "39(4) Evidence by affidavit",
      "values:kind": "subsection",
      "cof:pageNumber": 33,
      "values:originalText": "(4) The conditions referred to in the last preceding subsection may\ninclude a condition that copies of an affidavit by which any\nevidence is given be served on a party or parties to the matter and a\ncondition that a person whose evidence is given by affidavit attend\nat the hearing for cross examination."
