    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Powers of Judge",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.39",
      "values:originalText": "Where, by any law of the State of New South Wales which is\ncontinued in force in the Territory as a law of the Territory, any\npower or function is vested in the Supreme Court of New South\nWales, or in a Judge of that Court, that power or function shall, in",
      "skos:definition": "Where, by any law of the State of New South Wales which is\ncontinued in force in the Territory as a law of the Territory, any\npower or function is vested in the Supreme Court of New South\nWales, or in a Judge of that Court, that power or function shall, in",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-56-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-56-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "92fc3f9beee15731876eacef8439fc9445b6ed97decd3ae26f7d1dd7a52979c3",
      "skos:note": "Vesting of power or function in Supreme Court of New South Wales or a Judge."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Powers of Judge",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "Where, by any law of the State of New South Wales which is\ncontinued in force in the Territory as a law of the Territory, any\npower or function is vested in the Supreme Court of New South\nWales, or in a Judge of that Court, that power or function shall, in"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-56-norm",
