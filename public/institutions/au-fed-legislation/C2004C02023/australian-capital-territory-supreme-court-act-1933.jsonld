      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Term of office",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "(1) The Master:\n\n(a) holds office on and from the day specified in the instrument\nof appointment; and\n\n(b) holds office, subject to this Act:"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33-norm",
