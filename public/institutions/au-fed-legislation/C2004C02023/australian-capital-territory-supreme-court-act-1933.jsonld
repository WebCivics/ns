        }
      ],
      "cml:integrityHash": "7065a9ad2139477248e39247ab4a6b27741586a7619a3b291585c505bf1f694a",
      "skos:note": "Governor-General determines terms and conditions of appointment not provided by Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-33e",
      "@type": "cof:Section",
      "cof:title": "33E Terms and conditions of appointment not provided for by Act",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "The Master holds office on such terms and conditions (if any) in\nrelation to matters not provided by this Act as are determined, in\nwriting, by the Governor-General."
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-33e-norm",
