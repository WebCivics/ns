        }
      ],
      "cml:integrityHash": "cbcfff6de7c436138884da279d52ec558f5cd80952690b9baaf644154faa348b",
      "skos:note": "Summon or arrest accused person upon information being filed without examination or commitment for trial."
    },
    {
