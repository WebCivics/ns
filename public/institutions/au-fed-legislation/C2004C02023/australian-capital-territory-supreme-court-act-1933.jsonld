    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Oath of allegiance and office by Judge",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.16",
      "values:originalText": "Each Judge shall, before proceeding to discharge the duties of the\noffice of Judge, take before the Governor-General, another Judge\nof the Court, a Justice of the High Court or a Judge of the Federal\nCourt of Australia an oath or affirmation of allegiance in\naccordance with the form in the Schedule to the Constitution of the\nCommonwealth, and also an oath or affirmation in accordance with\nthe following form:\n\n‘I, A.B., do swear that I will well and truly serve our Sovereign\nLord the King in the office of Chief Justice (or Judge) of the\nSupreme Court of the Australian Capital Territory, and I will do\nright to all manner of people according to law, without fear or\nfavour, affection or ill-will, So help me, God’; or\n\n‘I, A.B., do solemnly and sincerely promise and declare that I will\nwell and truly serve our Sovereign Lord the King in the office of\nChief Justice (or Judge) of the Supreme Court of the Australian\nCapital Territory, and I will do right to all manner of people\naccording to law, without fear or favour, affection or ill-will.’.\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 11\n\nAustralian Capital Territory Supreme Court Act 1933",
      "skos:definition": "Each Judge shall, before proceeding to discharge the duties of the\noffice of Judge, take before the Governor-General, another Judge\nof the Court, a Justice of the High Court or a Judge of the Federal\nCourt of Australia an oath or affirmation of allegiance in\naccordance with the form in the Schedule to the Constitution of the\nCommonwealth, and also an oath or affirmation in accordance with\nthe following form:\n\n‘I, A.B., do swear that I will well and truly serve our Sovereign\nLord the King in the office of Chief Justice (or Judge) of the\nSupreme Court of the Australian Capital Territory, and I will do\nright to all manner of people according to law, without fear or\nfavour, affection or ill-will, So help me, God’; or\n\n‘I, A.B., do solemnly and sincerely promise and declare that I will\nwell and truly serve our Sovereign Lord the King in the office of\nChief Justice (or Judge) of the Supreme Court of the Australian\nCapital Territory, and I will do right to all manner of people\naccording to law, without fear or favour, affection or ill-will.’.\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 11\n\nAustralian Capital Territory Supreme Court Act 1933",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-10-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7673e6bd528c228096e50bf579751a1662db55ba5c4a07fd1cc0dd0f4cc891fa",
      "skos:note": "Take oath of allegiance and office before proceeding to discharge duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Oath of allegiance and office by Judge",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Each Judge shall, before proceeding to discharge the duties of the\noffice of Judge, take before the Governor-General, another Judge\nof the Court, a Justice of the High Court or a Judge of the Federal\nCourt of Australia an oath or affirmation of allegiance in\naccordance with the form in the Schedule to the Constitution of the\nCommonwealth, and also an oath or affirmation in accordance with\nthe following form:\n\n‘I, A.B., do swear that I will well and truly serve our Sovereign\nLord the King in the office of Chief Justice (or Judge) of the\nSupreme Court of the Australian Capital Territory, and I will do\nright to all manner of people according to law, without fear or\nfavour, affection or ill-will, So help me, God’; or\n\n‘I, A.B., do solemnly and sincerely promise and declare that I will\nwell and truly serve our Sovereign Lord the King in the office of\nChief Justice (or Judge) of the Supreme Court of the Australian\nCapital Territory, and I will do right to all manner of people\naccording to law, without fear or favour, affection or ill-will.’.\n\n\nConstitution and Jurisdiction of the Supreme Court  Part II\n\nSection 11\n\nAustralian Capital Territory Supreme Court Act 1933"
    },
    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-10-norm",
