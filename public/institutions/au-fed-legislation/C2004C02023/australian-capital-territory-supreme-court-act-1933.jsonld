    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Appointment of Master",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
