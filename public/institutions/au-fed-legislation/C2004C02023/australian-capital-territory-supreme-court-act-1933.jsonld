    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 Use of Seals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-supreme-court-act-1933.pdf"
      },
      "dc:source": "australian-capital-territory-supreme-court-act-1933.pdf, p.36",
      "values:originalText": "All writs, commissions and process issued from the Supreme Court\nshall be in the name of the King, and shall be under the Seal of the\nCourt or such other seal as is prescribed by Rules of Court, and\nshall be signed by the Registrar or other proper officer.",
      "skos:definition": "All writs, commissions and process issued from the Supreme Court\nshall be in the name of the King, and shall be under the Seal of the\nCourt or such other seal as is prescribed by Rules of Court, and\nshall be signed by the Registrar or other proper officer.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-48-norm"
        },
        {
          "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-48-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9d1e9aeb7af98501f4ebfa03a936627ee2b4d214c4e967b5d557c51440c6c9a7",
      "skos:note": "All writs, commissions and process issued from the Supreme Court must be in the name of the King and signed by the Registrar."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-48",
      "@type": "cof:Section",
      "cof:title": "48 Use of Seals",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "All writs, commissions and process issued from the Supreme Court\nshall be in the name of the King, and shall be under the Seal of the\nCourt or such other seal as is prescribed by Rules of Court, and\nshall be signed by the Registrar or other proper officer."
    },
