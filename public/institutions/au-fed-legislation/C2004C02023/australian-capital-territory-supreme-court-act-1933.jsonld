    {
      "@id": "concept:australian-capital-territory-supreme-court-act-1933-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Appearance by barrister or solicitor",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-supreme-court-act-1933#sec-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
