    {
      "@id": "concept:c2005a00024-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2005a00024#sec-3-2"
      },
