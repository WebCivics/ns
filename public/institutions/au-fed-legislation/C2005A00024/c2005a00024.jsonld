    {
      "@id": "concept:c2005a00024-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Subsection 95(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2005a00024#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2005a00024.pdf"
      },
      "dc:source": "c2005a00024.pdf, p.8",
      "values:originalText": "Repeal the subsection, substitute:\n(2) Each NRS contract must provide for the relevant NRS provider to\nprepare service plans for so much of the NRS as is covered by the\ncontract. The service plan must include at least the following\nmatters:\n(a) timetables for the supply of so much of the NRS as is\ncovered by the contract;\n\nAmendments relating to the National Relay Service Schedule 1\nAmendments commencing on Royal Assent Part 1\nTelecommunications (Consumer Protection and Service Standards) Amendment (National Relay\n(b) performance standards to be met by the NRS provider.",
      "skos:definition": "Repeal the subsection, substitute:\n(2) Each NRS contract must provide for the relevant NRS provider to\nprepare service plans for so much of the NRS as is covered by the\ncontract. The service plan must include at least the following\nmatters:\n(a) timetables for the supply of so much of the NRS as is\ncovered by the contract;\n\nAmendments relating to the National Relay Service Schedule 1\nAmendments commencing on Royal Assent Part 1\nTelecommunications (Consumer Protection and Service Standards) Amendment (National Relay\n(b) performance standards to be met by the NRS provider.",
      "cml:asserts": [
        {
          "@id": "concept:c2005a00024-sch-1-sec-4-norm"
        },
        {
          "@id": "concept:c2005a00024-sch-1-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ebb0d6d41c1ae77e9c36a30afbdc2e7b44c6083b2f6921e2cd01fe75a294a823",
      "skos:note": "Must provide service plans for NRS covered by the contract",
      "dc:description": "timetables, performance standards"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2005a00024#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsection 95(2)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the subsection, substitute:\n(2) Each NRS contract must provide for the relevant NRS provider to\nprepare service plans for so much of the NRS as is covered by the\ncontract. The service plan must include at least the following\nmatters:\n(a) timetables for the supply of so much of the NRS as is\ncovered by the contract;\n\nAmendments relating to the National Relay Service Schedule 1\nAmendments commencing on Royal Assent Part 1\nTelecommunications (Consumer Protection and Service Standards) Amendment (National Relay\n(b) performance standards to be met by the NRS provider."
    },
    {
      "@id": "concept:c2005a00024-sch-1-sec-4-norm",
