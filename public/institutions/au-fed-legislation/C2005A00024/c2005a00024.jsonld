    {
      "@id": "concept:c2005a00024-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 94 (definition of NRS contract)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2005a00024#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2005a00024.pdf"
      },
      "dc:source": "c2005a00024.pdf, p.8",
      "values:originalText": "Repeal the definition, substitute:\nNRS contract means a contract under which the whole, or a part,\nof the National Relay Service is provided.",
      "skos:definition": "Repeal the definition, substitute:\nNRS contract means a contract under which the whole, or a part,\nof the National Relay Service is provided.",
      "cml:asserts": [
        {
          "@id": "concept:c2005a00024-sch-1-sec-1-norm"
        }
      ],
      "cml:integrityHash": "aedfb0dfdf5a3773a16c65b2b6e0002b88094532a0277e227682d61009ed90ef",
      "skos:note": "Definition of NRS contract"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2005a00024#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Section 94 (definition of NRS contract)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the definition, substitute:\nNRS contract means a contract under which the whole, or a part,\nof the National Relay Service is provided."
    },
