      },
      "dc:source": "c2005a00024.pdf, p.7",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments relating to the National Relay Service",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments relating to the National Relay Service",
      "cml:asserts": [
        {
          "@id": "concept:c2005a00024-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "d0be12e74cae27cde047836c732a70e29ef6971d7c3405bb3e4729216cce7c27",
      "skos:note": "Amendments and repeals of Acts specified in a Schedule"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2005a00024#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments relating to the National Relay Service"
    },
