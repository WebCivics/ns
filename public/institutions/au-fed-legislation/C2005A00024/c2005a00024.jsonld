        }
      ],
      "cml:integrityHash": "3edcdb3696b100712c3452826c4b2b26d3bf5c4a4adf85f167041b98438f336b",
      "skos:note": "Repeal paragraph, substitute with provision from a contract or multiple contracts."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2005a00024#sch-1-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Paragraph 95(1)(b)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the paragraph, substitute:\n(b) either:\n(i) is provided by a person under a contract with the\nCommonwealth; or\n(ii) is provided by 2 or more persons under contracts with\nthe Commonwealth (with each of the persons providing\na part of the service)."
    },
