      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Repeal the section, substitute:"
    },
    {
      "@id": "concept:c2005a00024-sch-1-sec-5-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
