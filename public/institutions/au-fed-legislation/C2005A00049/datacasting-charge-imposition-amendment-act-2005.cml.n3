doc:sch-2-sec-1 a cof:Section ;
    cof:title "1 Definitions" ;
    values:kind "section" ;
    values:originalText "In this Schedule: Imposition Act means the Datacasting Charge (Imposition) Act 1998. transition time means the commencement of this Schedule." ;
    cof:pageNumber "8"^^xsd:integer .

concept:datacasting-charge-imposition-amendment-act-2005-sch-2-sec-2 a cml:Concept ;
    skos:prefLabel "2 Continued effect of amount determinations"@en ;
    cml:realizedBy doc:sch-2-sec-2 ;
    values:originalText "A determination made by the ACA under subsection 7(1) of the Imposition Act that was in force immediately before the transition time has effect on and after the transition time as if it had been made by the ACMA under that subsection as amended by Schedule 1 to this Act. [Minister’s second reading speech made in— House of Representatives on 2 December 2004 Senate on 7 March 2005] (202/04)" ;
