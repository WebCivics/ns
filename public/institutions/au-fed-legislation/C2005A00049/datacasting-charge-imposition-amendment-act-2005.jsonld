    {
      "@id": "concept:datacasting-charge-imposition-amendment-act-2005-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Continued effect of amount determinations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/datacasting-charge-imposition-amendment-act-2005#sch-2-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "datacasting-charge-imposition-amendment-act-2005.pdf"
      },
      "dc:source": "datacasting-charge-imposition-amendment-act-2005.pdf, p.8",
      "values:originalText": "A determination made by the ACA under subsection 7(1) of the\nImposition Act that was in force immediately before the transition time\nhas effect on and after the transition time as if it had been made by the\nACMA under that subsection as amended by Schedule 1 to this Act.\n[Minister’s second reading speech made in—\nHouse of Representatives on 2 December 2004\nSenate on 7 March 2005]\n(202/04)",
      "skos:definition": "A determination made by the ACA under subsection 7(1) of the\nImposition Act that was in force immediately before the transition time\nhas effect on and after the transition time as if it had been made by the\nACMA under that subsection as amended by Schedule 1 to this Act.\n[Minister’s second reading speech made in—\nHouse of Representatives on 2 December 2004\nSenate on 7 March 2005]\n(202/04)",
      "cml:asserts": [
        {
          "@id": "concept:datacasting-charge-imposition-amendment-act-2005-sch-2-sec-2-norm"
        },
        {
          "@id": "concept:datacasting-charge-imposition-amendment-act-2005-sch-2-sec-2-logic-deontic-1"
        },
        {
          "@id": "concept:datacasting-charge-imposition-amendment-act-2005-sch-2-sec-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:datacasting-charge-imposition-amendment-act-2005-sch-2-sec-2-logic-ltl-3"
        },
        {
          "@id": "concept:datacasting-charge-imposition-amendment-act-2005-sch-2-sec-2-logic-diffusion-4"
        },
        {
          "@id": "concept:datacasting-charge-imposition-amendment-act-2005-sch-2-sec-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "13b9fd2bc256b068b569693d9a7d383c5a7c3701f3edd59fb1ef446f8e358971",
      "skos:note": "Continued effect of amount determinations"
    },
    {
      "@id": "https://ns.webcivics.net/values/datacasting-charge-imposition-amendment-act-2005#sch-2-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Continued effect of amount determinations",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "A determination made by the ACA under subsection 7(1) of the\nImposition Act that was in force immediately before the transition time\nhas effect on and after the transition time as if it had been made by the\nACMA under that subsection as amended by Schedule 1 to this Act.\n[Minister’s second reading speech made in—\nHouse of Representatives on 2 December 2004\nSenate on 7 March 2005]\n(202/04)"
    },
