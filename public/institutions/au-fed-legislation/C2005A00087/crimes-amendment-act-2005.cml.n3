concept:crimes-amendment-act-2005-sch-1-sec-7 a cml:Concept ;
    skos:prefLabel "7 After section 15XM"@en ;
    cml:realizedBy doc:sch-1-sec-7 ;
    values:originalText "Insert:  Schedule 1  Amendment of the Crimes Act 1914  15XMA  Requesting State agencies or Territory agencies to issue evidence of assumed identities etc. (1) An issuing agency that is a State agency of a particular State and that receives a request under section 15XL must comply with the request to the extent that the laws of the State require it to do so. (2) An issuing agency that is a Territory agency of a particular Territory and that receives a request under section 15XL must comply with the request to the extent that the laws of the Territory require it to do so. [Minister’s second reading speech made in— House of Representatives on 26 May 2005 Senate on 14 June 2005] (73/05)" ;
    skos:definition "Insert:  Schedule 1  Amendment of the Crimes Act 1914  15XMA  Requesting State agencies or Territory agencies to issue evidence of assumed identities etc. (1) An issuing agency that is a State agency of a particular State and that receives a request under section 15XL must comply with the request to the extent that the laws of the State require it to do so. (2) An issuing agency that is a Territory agency of a particular Territory and that receives a request under section 15XL must comply with the request to the extent that the laws of the Territory require it to do so. [Minister’s second reading speech made in— House of Representatives on 26 May 2005 Senate on 14 June 2005] (73/05)"@en ;
    cml:integrityHash "069e1fe43a78dc81a704e3a6c691ae2973277409f37bd1a0c940540fcb315fae" ;
    cof:pageNumber "7"^^xsd:integer ;
    cml:hasPart concept:crimes-amendment-act-2005-sch-1-sec-7-ss-1 ;
    cml:hasPart concept:crimes-amendment-act-2005-sch-1-sec-7-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-act-2005.pdf> ;
    dc:source "crimes-amendment-act-2005.pdf, p.7" .
