    {
      "@id": "concept:crimes-amendment-act-2005-sch-1-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 After section 15XM",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-act-2005#sch-1-sec-7"
