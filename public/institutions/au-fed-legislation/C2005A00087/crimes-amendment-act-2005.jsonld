      "dc:source": "crimes-amendment-act-2005.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Crimes Act 1914 Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Crimes Act 1914 Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-act-2005-sec-3-norm"
        }
      ],
      "cml:integrityHash": "499fef900d72323ceba39d3b7e71e283609acb508ae80ab5327e6c6cfc8b127e",
      "skos:note": "Amendment of Schedule 1 in the Crimes Act 1914"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-act-2005#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Crimes Act 1914 Schedule 1"
    },
