doc:sec-3-2 a cof:Section ;
    cof:title "3 Schedule(s)" ;
    values:kind "section" ;
    values:originalText "Each Act that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule concerned, and any other item in a Schedule to this Act has effect according to its terms.  Schedule 1  Amendment of the Criminal Code Act 1995" ;
    cof:pageNumber "7"^^xsd:integer .

