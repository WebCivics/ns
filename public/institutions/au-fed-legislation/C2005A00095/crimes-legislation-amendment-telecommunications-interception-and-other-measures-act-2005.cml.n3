concept:crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005-sch-2-sec-10-2 a cml:Concept ;
    skos:prefLabel "10 Crimes Legislation Amendment (Telecommunications Interception and Other"@en ;
    cml:realizedBy doc:sch-2-sec-10-2 ;
    values:originalText "(i) how many of those warrants involved the interception of a single telecommunications service; and  (ii) how many of those warrants involved the interception of between 2 and 5 telecommunications services; and  (iii) how many of those warrants involved the interception of between 6 and 10 telecommunications services; and  (iv) how many of those warrants involved the interception of more than 10 telecommunications services; and  (ec) in relation to all named person warrants issued during that year on application made by each agency or authority, the total number of telecommunication services intercepted under those warrants; and" ;
    skos:definition "(i) how many of those warrants involved the interception of a single telecommunications service; and  (ii) how many of those warrants involved the interception of between 2 and 5 telecommunications services; and  (iii) how many of those warrants involved the interception of between 6 and 10 telecommunications services; and  (iv) how many of those warrants involved the interception of more than 10 telecommunications services; and  (ec) in relation to all named person warrants issued during that year on application made by each agency or authority, the total number of telecommunication services intercepted under those warrants; and"@en ;
    cml:integrityHash "8559e7707adfd07a7cde92eb388ec01bb7d4ad17e9e0897c587758fa7ea1639e" ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Request for reporting on telecommunications services intercepted under warrants." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
