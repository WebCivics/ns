      "@type": "cml:Concept",
      "skos:prefLabel": "14 After paragraph 100(2)(e)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005#sch-2-sec-14"
