      "@type": "cml:Concept",
      "skos:prefLabel": "8 Subsection 5(1) (after paragraph (d) of the definition of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005#sch-2-sec-8-2"
