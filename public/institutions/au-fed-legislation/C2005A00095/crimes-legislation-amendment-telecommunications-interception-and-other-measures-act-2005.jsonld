    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005#sch-2-sec-6-ss-2f",
      "@type": "cof:Section",
      "cof:title": "6(2F) Crimes Legislation Amendment (Telecommunications Interception and Other Measures)",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(2F) If a person who is lawfully engaged in duties relating to the\nreceiving and handling of communications to or from an\nemergency service facility listens to or records a communication\npassing over a telecommunications system to or from the\nemergency service facility, the listening or recording does not, for\nthe purposes of this Act, constitute an interception of the\ncommunication."
    },
