      "dc:source": "crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005.pdf, p.7",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendment of the Criminal Code Act 1995",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendment of the Criminal Code Act 1995",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005-sec-3-2-norm"
        }
