    {
      "@id": "concept:crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005-sch-2-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Paragraph 6K(c)",
      "cml:realizedBy": {
