      "dc:source": "crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005.pdf, p.13",
      "values:originalText": "Insert:\n\n(ea) in relation to the applications of a kind referred to in\nparagraph (a), (b), (c), (d) or (e), the relevant statistics about\napplications of that kind that relate to named person\nwarrants; and\n\n(eb) in relation to all named person warrants issued during that\nyear on application made by each agency or authority:\n\nSchedule 2  Amendment of the Telecommunications (Interception) Act 1979",
      "skos:definition": "Insert:\n\n(ea) in relation to the applications of a kind referred to in\nparagraph (a), (b), (c), (d) or (e), the relevant statistics about\napplications of that kind that relate to named person\nwarrants; and\n\n(eb) in relation to all named person warrants issued during that\nyear on application made by each agency or authority:\n\nSchedule 2  Amendment of the Telecommunications (Interception) Act 1979",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005-sch-2-sec-12-norm"
        }
      ],
      "cml:integrityHash": "05c7d5bea54f2d268204a283c2e0813991fcc15731887246d2a34766480fb908",
      "skos:note": "Inserts new provisions about named person warrants into the Telecommunications (Interception) Act 1979."
    },
