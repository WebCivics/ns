      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005.pdf"
      },
      "dc:source": "crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005.pdf, p.13",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) a proceeding by way of an application for a restraining order,\nor an order that is ancillary to a restraining order, under a\nprescribed Act of the Commonwealth, a State or the\nAustralian Capital Territory.",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(c) a proceeding by way of an application for a restraining order,\nor an order that is ancillary to a restraining order, under a\nprescribed Act of the Commonwealth, a State or the\nAustralian Capital Territory.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005-sch-2-sec-9-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005-sch-2-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d141ac85c7ddabf1372699b188c5f8019f229addfb6a5df8bd7b7c83a7cb9c69",
      "skos:note": "Repeal paragraph and substitute with a proceeding by way of an application for a restraining order."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-telecommunications-interception-and-other-measures-act-2005#sch-2-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Paragraph 6K(c)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) a proceeding by way of an application for a restraining order,\nor an order that is ancillary to a restraining order, under a\nprescribed Act of the Commonwealth, a State or the\nAustralian Capital Territory."
    },
