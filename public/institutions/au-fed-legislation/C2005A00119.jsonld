    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) This clause applies to a draft variation of a final operational separation plan unless:  (a) the draft variation was given to the Minister as a result of a direction under subclause 56A(2); or  (b) both:  (i) Telstra had previously given the Minister a written outline of the draft variation; and  (ii) the Minister, by written notice given to Telstra, had informed Telstra that the Minister was satisfied that the draft variation was of a minor nature.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Draft variation of final operational separation plan must be given to the Minister after certain conditions are met",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(1) This clause applies to a draft variation of a final operational separation plan unless:  (a) the draft variation was given to the Minister as a result of a direction under subclause 56A(2); or  (b) both:  (i) Telstra had previously given the Minister a written outline of the draft variation; and  (ii) the Minister, by written notice given to Telstra, had informed Telstra that the Minister was satisfied that the draft variation was of a minor nature."
    },
