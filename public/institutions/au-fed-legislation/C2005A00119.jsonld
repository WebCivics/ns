      "cml:operator": "Diffuse",
      "cml:premiseText": "(2A) If:  (a) the Procedural Rules make provision for or in relation to a time limit for giving the information; and  (b) the person does not give the Commission the information within the time limit allowed by the Procedural Rules;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-21-ss-2a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The variation is rejected if the person does not provide information within the specified time interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Variation rejection is a recurring process based on information provided within time limit.",
