        "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-59-ss-1-logic-alleninterval-2",
        "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-59-ss-1-logic-deontic-3",
        "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-59-ss-1-logic-deontic-4"
      ],
