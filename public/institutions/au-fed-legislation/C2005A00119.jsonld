    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-59-ss-1",
      "@type": "cml:Concept",
      "dc:description": "(a) the action to be taken by Telstra to ensure that the contravention ceases; (b) the action to be taken by Telstra directed towards ensuring that there is no repetition of the contravention in the future; (c) the action to be taken by Telstra by way of reporting to the Minister on any action taken by it as mentioned in paragraph (a) or (b).",
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.46",
      "skos:note": "Matters to be set out in a draft or final rectification plan",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "59(1) Contents of draft or final rectification plan"
      },
      "wasDerivedFrom": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf",
