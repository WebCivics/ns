    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-69a-ss-2 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-69a-ss-3 ;
