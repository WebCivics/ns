doc:sch-11-sec-69b-ss-2 a cof:Section ;
    cof:title "69B(2) Review by the Australian Competition Tribunal of remedial" ;
    values:kind "subsection" ;
    values:originalText "(2) An application under this section for a review of a section 69A direction must be:  (a) in writing; and  (b) made within 7 days after the ACCC gave the direction. Review" ;
    cof:pageNumber "34"^^xsd:integer .

