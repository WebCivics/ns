concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-151cp a cml:Concept ;
    skos:prefLabel "151CP Operational separation for Telstra"@en ;
    cml:realizedBy doc:sch-11-sec-151cp ;
    values:originalText "(1) This section applies if Telstra has engaged in conduct in order to comply with a final operational separation plan in force under Part 8 of Schedule 1 to the Telecommunications Act 1997.  (2) In performing a function, or exercising a power, under this Part in relation to Telstra, the Commission must have regard to the conduct to the extent that the conduct is relevant." ;
    skos:definition "(1) This section applies if Telstra has engaged in conduct in order to comply with a final operational separation plan in force under Part 8 of Schedule 1 to the Telecommunications Act 1997.  (2) In performing a function, or exercising a power, under this Part in relation to Telstra, the Commission must have regard to the conduct to the extent that the conduct is relevant."@en ;
    cml:integrityHash "e796a998399d2dad4b4946369dec86d8a2fcfddafa1126339a4f4aeff2693db5" ;
    cof:pageNumber "50"^^xsd:integer ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-151cp-ss-1 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-151cp-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf> ;
