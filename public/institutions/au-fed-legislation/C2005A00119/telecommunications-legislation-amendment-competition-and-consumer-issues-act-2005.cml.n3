doc:sch-11-sec-57-ss-2 a cof:Section ;
    cof:title "57(2) Public comment—variation of final operational separation plan" ;
    values:kind "subsection" ;
    values:originalText "(2) Before giving the Minister a draft variation of a final operational separation plan under subclause 56(1), Telstra must:  (a) cause to be published in a newspaper circulating generally in each State, the Australian Capital Territory and the Northern Territory a notice:  (i) stating that Telstra has prepared a preliminary version of the draft variation; and  (ii) stating that a copy of the preliminary version will be available on Telstra’s Internet site throughout the period of 20 days after the publication of the notice; and  (iii) inviting persons to give written comments about the preliminary version to Telstra within 20 days after the publication of the notice; and  (b) make a copy of the preliminary version available on Telstra’s Internet site in accordance with the notice." ;
    cof:pageNumber "45"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-57-ss-3 a cml:Concept ;
    skos:prefLabel "57(3) Public comment—variation of final operational separation plan"@en ;
    cml:realizedBy doc:sch-11-sec-57-ss-3 ;
    values:originalText "(3) If persons have given written comments about the preliminary version in accordance with the notice, Telstra must ensure that the draft variation given to the Minister is accompanied by a copy of those comments." ;
    skos:definition "(3) If persons have given written comments about the preliminary version in accordance with the notice, Telstra must ensure that the draft variation given to the Minister is accompanied by a copy of those comments."@en ;
