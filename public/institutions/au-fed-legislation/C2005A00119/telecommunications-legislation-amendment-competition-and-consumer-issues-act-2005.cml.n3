concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-61-ss-5 a cml:Concept ;
    skos:prefLabel "61(5) Approval of draft by Minister"@en ;
    cml:realizedBy doc:sch-11-sec-61-ss-5 ;
    values:originalText "(5) If the Minister neither approves, nor refuses to approve, the plan before the end of the period of 90 days after the day on which the Minister received the draft plan, the Minister is taken, at the end of that period, to have approved the plan under subclause (2)." ;
    skos:definition "(5) If the Minister neither approves, nor refuses to approve, the plan before the end of the period of 90 days after the day on which the Minister received the draft plan, the Minister is taken, at the end of that period, to have approved the plan under subclause (2)."@en ;
    cml:integrityHash "c57620b1f073509fbc08ffa50eabb177f4605f9b5ddd149182ef81c6da02ac71" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-61 ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Minister's approval within 90 days is deemed approval." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf> ;
