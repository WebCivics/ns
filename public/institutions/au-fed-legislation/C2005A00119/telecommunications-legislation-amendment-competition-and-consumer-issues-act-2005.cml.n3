concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-2 a cml:Concept ;
    skos:prefLabel "2 Application of amendment"@en ;
    cml:realizedBy doc:sch-4-sec-2 ;
    values:originalText "The amendment of section 151BX of the Trade Practices Act 1974 made by this Schedule applies to a contravention of the competition rule if:  (a) in the case of a contravention that continued during a period—the period began after the commencement of this item; or  (b) otherwise—the contravention occurred after the commencement of this item.  Enforcement of conditions and limitations of exemption determinations and orders Schedule 5  Telecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005 No. 119, 2005            9" ;
    skos:definition "The amendment of section 151BX of the Trade Practices Act 1974 made by this Schedule applies to a contravention of the competition rule if:  (a) in the case of a contravention that continued during a period—the period began after the commencement of this item; or  (b) otherwise—the contravention occurred after the commencement of this item.  Enforcement of conditions and limitations of exemption determinations and orders Schedule 5  Telecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005 No. 119, 2005            9"@en ;
    cml:integrityHash "2fdda3420ffaf01ee1cb323cc47194eb7cd67298893814b72eaaff240f9eaf27" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Amendment applies to contraventions of competition rule after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
