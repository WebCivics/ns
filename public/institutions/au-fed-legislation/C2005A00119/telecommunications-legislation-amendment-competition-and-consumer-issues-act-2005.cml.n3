concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-18 a cml:Concept ;
    skos:prefLabel "18 After subsection 152CBC(1)"@en ;
    cml:realizedBy doc:sch-7-sec-18 ;
    values:originalText "Insert:  (1A) Before the Commission makes a decision under subsection (2) in relation to the undertaking, the person may, by written notice given to the Commission within the time allowed by the Procedural Rules, modify the undertaking, so long as the modification is a modification that, under the Procedural Rules, is taken to be of a minor nature.  Schedule 7  Procedural Rules" ;
    skos:definition "Insert:  (1A) Before the Commission makes a decision under subsection (2) in relation to the undertaking, the person may, by written notice given to the Commission within the time allowed by the Procedural Rules, modify the undertaking, so long as the modification is a modification that, under the Procedural Rules, is taken to be of a minor nature.  Schedule 7  Procedural Rules"@en ;
    cml:integrityHash "cc4a613b20966029b3a69df8bbb7877b0b29438e58a8290694fc7d6b396b59ca" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Modify undertaking before Commission decision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
