concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-3-sec-1 a cml:Concept ;
    skos:prefLabel "1 Paragraph 460(3)(a)"@en ;
    cml:realizedBy doc:sch-3-sec-1 ;
    values:originalText "Repeal the paragraph, substitute:  (a) that a variation of a numbering plan:  (i) will affect a number issued to a customer of a carriage service provider, being a customer located in a particular State; and  (ii) is not a variation that, under a written declaration made by the ACMA under this subparagraph, is taken to be a minor variation; or" ;
    skos:definition "Repeal the paragraph, substitute:  (a) that a variation of a numbering plan:  (i) will affect a number issued to a customer of a carriage service provider, being a customer located in a particular State; and  (ii) is not a variation that, under a written declaration made by the ACMA under this subparagraph, is taken to be a minor variation; or"@en ;
    cml:integrityHash "c688fc8e5c61bc56df1236bd3667656eba101fb1ee7aaf138a8c455da9b9d502" ;
    cof:pageNumber "11"^^xsd:integer ;
