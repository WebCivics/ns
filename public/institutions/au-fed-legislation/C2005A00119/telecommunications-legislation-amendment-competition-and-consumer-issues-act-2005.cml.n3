concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-58 a cml:Concept ;
    skos:prefLabel "58 Publication of final operational separation plan"@en ;
    cml:realizedBy doc:sch-11-sec-58 ;
    values:originalText "(1) As soon as practicable after a final operational separation plan comes into force, Telstra must make a copy of the plan available on Telstra’s Internet site.  (2) As soon as practicable after a variation of a final operational separation plan comes into force, Telstra must make a copy of the varied final operational separation plan available on Telstra’s Internet site." ;
    skos:definition "(1) As soon as practicable after a final operational separation plan comes into force, Telstra must make a copy of the plan available on Telstra’s Internet site.  (2) As soon as practicable after a variation of a final operational separation plan comes into force, Telstra must make a copy of the varied final operational separation plan available on Telstra’s Internet site."@en ;
    cml:integrityHash "cc4461965afe2824d561e6cb051d651a1d78f2d09f9fd3f26b6a6f8545a57b80" ;
    cof:pageNumber "46"^^xsd:integer ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-58-ss-1 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-58-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
