    cof:title "47(1) Designated interconnection services" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister may, by written instrument, declare that a specified eligible service is a designated interconnection service for the purposes of this Part." ;
    cof:pageNumber "27"^^xsd:integer .

