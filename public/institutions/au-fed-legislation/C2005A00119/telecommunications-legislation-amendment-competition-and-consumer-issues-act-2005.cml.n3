concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-11 a cml:Concept ;
    skos:prefLabel "11 After subsection 152BU(1)"@en ;
    cml:realizedBy doc:sch-7-sec-11 ;
    values:originalText "Insert:  (1A) Before the Commission makes a decision under subsection (2) in relation to the undertaking, the carrier or provider may, by written notice given to the Commission within the time allowed by the Procedural Rules, modify the undertaking, so long as the modification is a modification that, under the Procedural Rules, is taken to be of a minor nature." ;
    skos:definition "Insert:  (1A) Before the Commission makes a decision under subsection (2) in relation to the undertaking, the carrier or provider may, by written notice given to the Commission within the time allowed by the Procedural Rules, modify the undertaking, so long as the modification is a modification that, under the Procedural Rules, is taken to be of a minor nature."@en ;
    cml:integrityHash "b3c4f31c4ec640c3cb02f29ceacbb2ad514bee41225c508795610cdf32b7b3fd" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Carrier or provider may modify undertaking under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
