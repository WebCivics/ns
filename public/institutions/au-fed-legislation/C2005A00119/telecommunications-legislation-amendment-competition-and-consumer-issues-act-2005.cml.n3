doc:sch-11-sec-54-ss-5 a cof:Section ;
    cof:title "54(5) Approval of draft by Minister" ;
    values:kind "subsection" ;
    values:originalText "(5) If the Minister neither approves, nor refuses to approve, the plan before the end of the period of 90 days after the day on which the Minister received the draft plan, the Minister is taken, at the end of that period, to have approved the plan under subclause (2)." ;
    cof:pageNumber "42"^^xsd:integer .

