concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-69b-ss-5 a cml:Concept ;
    skos:prefLabel "69B(5) Review by the Australian Competition Tribunal of remedial"@en ;
    cml:realizedBy doc:sch-11-sec-69b-ss-5 ;
    values:originalText "(5) A decision by the Australian Competition Tribunal:  (a) affirming a section 69A direction; or  (b) setting aside a section 69A direction; or  (c) made in substitution for a section 69A direction; or  (d) varying a section 69A direction; is taken, for the purposes of this Act (other than this section), to be a decision of the ACCC. Conduct of review" ;
    skos:definition "(5) A decision by the Australian Competition Tribunal:  (a) affirming a section 69A direction; or  (b) setting aside a section 69A direction; or  (c) made in substitution for a section 69A direction; or  (d) varying a section 69A direction; is taken, for the purposes of this Act (other than this section), to be a decision of the ACCC. Conduct of review"@en ;
    cml:integrityHash "a9643cd569e7181f73d56d1c1979e515a7f383b2350f1ee9448377e8c4938afb" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-69b ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "A decision by the Australian Competition Tribunal is taken to be a decision of the ACCC for certain purposes." ;
    cml:curationStatus cml:Proposed ;
