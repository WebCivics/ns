concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-9-sec-1 a cml:Concept ;
    skos:prefLabel "1 Paragraph 152AB(2)(e)"@en ;
    cml:realizedBy doc:sch-9-sec-1 ;
    values:originalText "Repeal the paragraph, substitute:  (e) the objective of encouraging the economically efficient use of, and the economically efficient investment in:  (i) the infrastructure by which listed services are supplied; and  (ii) any other infrastructure by which listed services are, or are likely to become, capable of being supplied." ;
    skos:definition "Repeal the paragraph, substitute:  (e) the objective of encouraging the economically efficient use of, and the economically efficient investment in:  (i) the infrastructure by which listed services are supplied; and  (ii) any other infrastructure by which listed services are, or are likely to become, capable of being supplied."@en ;
    cml:integrityHash "6e19d2ef3dc11888c5fa071d8b405b8947b25b4a1744a55b4b78cab5f914936e" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Encourage economically efficient use of infrastructure for listed services." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
