      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 At the end of section 122",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-2-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.9",
      "values:originalText": "Add:\n\n(4) If:\n\n(a) at a time when an industry code (the original code) was\nregistered under this Part, a formal warning could have been\ngiven to a person under subsection (2) in respect of the\noriginal code; and\n\n(b) the original code has been replaced by another code that is\nregistered under this Part; and\n\n(c) the person could have been given a formal warning under\nsubsection (2) in respect of the replacement code, if the\nconduct concerned had occurred after the replacement code\nwas registered;\nthen, during the period when the replacement code is registered\nunder this Part, the person may be given a formal warning under\nsubsection (2) in respect of the replacement code.\n\nSchedule 2  Industry codes",
      "skos:definition": "Add:\n\n(4) If:\n\n(a) at a time when an industry code (the original code) was\nregistered under this Part, a formal warning could have been\ngiven to a person under subsection (2) in respect of the\noriginal code; and\n\n(b) the original code has been replaced by another code that is\nregistered under this Part; and\n\n(c) the person could have been given a formal warning under\nsubsection (2) in respect of the replacement code, if the\nconduct concerned had occurred after the replacement code\nwas registered;\nthen, during the period when the replacement code is registered\nunder this Part, the person may be given a formal warning under\nsubsection (2) in respect of the replacement code.\n\nSchedule 2  Industry codes",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-2-sec-2-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-2-sec-2-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-2-sec-2-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "576f63167dbbed8d7e3f20cd1f5ca1576f927a4309d13a47bcf3b34d15b1c91b",
      "skos:note": "May be given a formal warning under subsection (2) in respect of the replacement code during the period when the replacement code is registered under this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-2-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 At the end of section 122",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Add:\n\n(4) If:\n\n(a) at a time when an industry code (the original code) was\nregistered under this Part, a formal warning could have been\ngiven to a person under subsection (2) in respect of the\noriginal code; and\n\n(b) the original code has been replaced by another code that is\nregistered under this Part; and\n\n(c) the person could have been given a formal warning under\nsubsection (2) in respect of the replacement code, if the\nconduct concerned had occurred after the replacement code\nwas registered;\nthen, during the period when the replacement code is registered\nunder this Part, the person may be given a formal warning under\nsubsection (2) in respect of the replacement code.\n\nSchedule 2  Industry codes"
    },
