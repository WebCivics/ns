    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 At the end of section 61",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.32",
      "values:originalText": "Add:\n\n(2) At any time after the last day on which a report of a subsection\n61A(1) review was tabled in a House of the Parliament, the\nMinister may, by written instrument, declare that Part 8 of\nSchedule 1 ceases to have effect on a specified day. The specified\nday must not be earlier than the last day on which a resolution\ndisallowing the declaration could have been passed by a House of\nthe Parliament under section 42 of the Legislative Instruments Act\n2003.\nNote:\nA subsection 61A(1) review must be conducted before 1 July 2009.\n\n(3) A declaration under subsection (2) has effect accordingly.\n\n(4) A declaration under subsection (2) is a legislative instrument for\nthe purposes of the Legislative Instruments Act 2003.",
      "skos:definition": "Add:\n\n(2) At any time after the last day on which a report of a subsection\n61A(1) review was tabled in a House of the Parliament, the\nMinister may, by written instrument, declare that Part 8 of\nSchedule 1 ceases to have effect on a specified day. The specified\nday must not be earlier than the last day on which a resolution\ndisallowing the declaration could have been passed by a House of\nthe Parliament under section 42 of the Legislative Instruments Act\n2003.\nNote:\nA subsection 61A(1) review must be conducted before 1 July 2009.\n\n(3) A declaration under subsection (2) has effect accordingly.\n\n(4) A declaration under subsection (2) is a legislative instrument for\nthe purposes of the Legislative Instruments Act 2003.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-2-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-2-ss-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-2-ss-4"
        }
      ],
      "cml:integrityHash": "f552a1e79bdc74d313b3f0f000e309faa363c9b81f8db6b9d0fb2b41f0dcea48"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 At the end of section 61",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "Add:\n\n(2) At any time after the last day on which a report of a subsection\n61A(1) review was tabled in a House of the Parliament, the\nMinister may, by written instrument, declare that Part 8 of\nSchedule 1 ceases to have effect on a specified day. The specified\nday must not be earlier than the last day on which a resolution\ndisallowing the declaration could have been passed by a House of\nthe Parliament under section 42 of the Legislative Instruments Act\n2003.\nNote:\nA subsection 61A(1) review must be conducted before 1 July 2009.\n\n(3) A declaration under subsection (2) has effect accordingly.\n\n(4) A declaration under subsection (2) is a legislative instrument for\nthe purposes of the Legislative Instruments Act 2003."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-2-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2(2) At the end of section 61",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-2-ss-2"
      },
      "cml:curationStatus": {
