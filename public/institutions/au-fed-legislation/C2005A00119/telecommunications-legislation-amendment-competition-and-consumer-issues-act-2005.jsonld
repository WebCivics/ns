    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 After subsection 152CBB(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-7-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.19",
      "values:originalText": "Insert:\n\n(2A) If:\n\n(a) the Procedural Rules make provision for or in relation to a\ntime limit for giving the information; and\n\n(b) the person does not give the Commission the information\nwithin the time limit allowed by the Procedural Rules;\nthe Commission may, by written notice given to the person, reject\nthe undertaking.\n\n(2B) Subsection (2A) has effect despite anything in this Division.\n\n(2C) If the Commission makes a decision under subsection (2A) to\nreject the undertaking, subsection 152CBC(5) has effect as if the\ndecision had been made under subsection 152CBC(2).",
      "skos:definition": "Insert:\n\n(2A) If:\n\n(a) the Procedural Rules make provision for or in relation to a\ntime limit for giving the information; and\n\n(b) the person does not give the Commission the information\nwithin the time limit allowed by the Procedural Rules;\nthe Commission may, by written notice given to the person, reject\nthe undertaking.\n\n(2B) Subsection (2A) has effect despite anything in this Division.\n\n(2C) If the Commission makes a decision under subsection (2A) to\nreject the undertaking, subsection 152CBC(5) has effect as if the\ndecision had been made under subsection 152CBC(2).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-16-ss-2a"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-16-ss-2b"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-16-ss-2c"
        }
      ],
      "cml:integrityHash": "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-7-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 After subsection 152CBB(2)",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Insert:\n\n(2A) If:\n\n(a) the Procedural Rules make provision for or in relation to a\ntime limit for giving the information; and\n\n(b) the person does not give the Commission the information\nwithin the time limit allowed by the Procedural Rules;\nthe Commission may, by written notice given to the person, reject\nthe undertaking.\n\n(2B) Subsection (2A) has effect despite anything in this Division.\n\n(2C) If the Commission makes a decision under subsection (2A) to\nreject the undertaking, subsection 152CBC(5) has effect as if the\ndecision had been made under subsection 152CBC(2)."
    },
