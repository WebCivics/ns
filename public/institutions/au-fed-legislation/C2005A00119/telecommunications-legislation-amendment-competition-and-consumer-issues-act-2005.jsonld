    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.38",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nTelstra must prepare a draft operational separation plan. The\nplan must be directed towards the achievement of the aim and\nobjects of this Part.\n•\nA final operational separation plan is a draft operational\nseparation plan that has been approved by the Minister.\n•\nIf Telstra has contravened, or is contravening, a final\noperational separation plan, the Minister may require Telstra\nto prepare a draft rectification plan.\n•\nA final rectification plan is a draft rectification plan that has\nbeen approved by the Minister.\n•\nIf a final rectification plan is in force, Telstra must comply\nwith the plan.",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nTelstra must prepare a draft operational separation plan. The\nplan must be directed towards the achievement of the aim and\nobjects of this Part.\n•\nA final operational separation plan is a draft operational\nseparation plan that has been approved by the Minister.\n•\nIf Telstra has contravened, or is contravening, a final\noperational separation plan, the Minister may require Telstra\nto prepare a draft rectification plan.\n•\nA final rectification plan is a draft rectification plan that has\nbeen approved by the Minister.\n•\nIf a final rectification plan is in force, Telstra must comply\nwith the plan.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-49-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-49-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eff0c1aa9ad40c4fb84962a2d3b9279d2d277931b2e092002d5ed8a0f502aaec",
      "skos:note": "Prepare operational separation plans and comply with rectification plans.",
      "dc:description": "Draft operational separation plan, Draft rectification plan"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nTelstra must prepare a draft operational separation plan. The\nplan must be directed towards the achievement of the aim and\nobjects of this Part.\n•\nA final operational separation plan is a draft operational\nseparation plan that has been approved by the Minister.\n•\nIf Telstra has contravened, or is contravening, a final\noperational separation plan, the Minister may require Telstra\nto prepare a draft rectification plan.\n•\nA final rectification plan is a draft rectification plan that has\nbeen approved by the Minister.\n•\nIf a final rectification plan is in force, Telstra must comply\nwith the plan."
    },
