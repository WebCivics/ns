        }
      ],
      "cml:integrityHash": "dcdeef56eb1f71e642d6ef5d6f0beeca8782b1e5bf387564170c2ce14e41e46a",
      "skos:note": "Direct Telstra to vary the draft plan and provide it within 60 days.",
      "dc:description": "Variated draft plan"
    },
    {
