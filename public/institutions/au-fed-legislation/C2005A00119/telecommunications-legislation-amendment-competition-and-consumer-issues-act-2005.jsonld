      "skos:note": "A person may give an enforceable undertaking about compliance with the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-10-sec-572a",
      "@type": "cof:Section",
      "cof:title": "572A Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nA person may give the ACMA an enforceable undertaking\nabout compliance with this Act."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-10-sec-572a-norm",
