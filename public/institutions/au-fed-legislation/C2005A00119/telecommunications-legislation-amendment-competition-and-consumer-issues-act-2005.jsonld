    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-50",
      "@type": "cml:Concept",
      "skos:prefLabel": "50 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-50"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.38",
      "values:originalText": "In this Part:\nbusiness unit means a part of Telstra.\ndeclared network service has the meaning given by clause 50B.\ndesignated service has the meaning given by clause 50A.\ndraft operational separation plan means a draft operational\nseparation plan under Division 2.\ndraft rectification plan means a draft rectification plan under",
      "skos:definition": "In this Part:\nbusiness unit means a part of Telstra.\ndeclared network service has the meaning given by clause 50B.\ndesignated service has the meaning given by clause 50A.\ndraft operational separation plan means a draft operational\nseparation plan under Division 2.\ndraft rectification plan means a draft rectification plan under",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-50-norm"
        }
      ],
      "cml:integrityHash": "f0fa87984d8a2bcf36e4520c2161060ca44b12d37d6bb29efc22e5845593a6c5",
      "skos:note": "Definitions for Telstra business units and services"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-50",
      "@type": "cof:Section",
      "cof:title": "50 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "In this Part:\nbusiness unit means a part of Telstra.\ndeclared network service has the meaning given by clause 50B.\ndesignated service has the meaning given by clause 50A.\ndraft operational separation plan means a draft operational\nseparation plan under Division 2.\ndraft rectification plan means a draft rectification plan under"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-50-norm",
