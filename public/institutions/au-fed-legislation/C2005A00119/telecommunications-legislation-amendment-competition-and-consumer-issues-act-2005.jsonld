    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-8-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-8-sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.25",
      "values:originalText": "In this Part:\nactive declared service has the same meaning as in section 152AR\nof the Trade Practices Act 1974.\ndesignated interconnection service has the meaning given by\nclause 47.\neligible service has the same meaning as in section 152AL of the\nTrade Practices Act 1974.",
      "skos:definition": "In this Part:\nactive declared service has the same meaning as in section 152AR\nof the Trade Practices Act 1974.\ndesignated interconnection service has the meaning given by\nclause 47.\neligible service has the same meaning as in section 152AL of the\nTrade Practices Act 1974.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-8-sec-45-norm"
        }
      ],
      "cml:integrityHash": "49cc68fcc65fd2fce951351b2db74820383256a455c7a7ae4b95058f5afbd4dd",
      "skos:note": "Definitions for active declared service, designated interconnection service, and eligible service."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-8-sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "In this Part:\nactive declared service has the same meaning as in section 152AR\nof the Trade Practices Act 1974.\ndesignated interconnection service has the meaning given by\nclause 47.\neligible service has the same meaning as in section 152AL of the\nTrade Practices Act 1974."
    },
