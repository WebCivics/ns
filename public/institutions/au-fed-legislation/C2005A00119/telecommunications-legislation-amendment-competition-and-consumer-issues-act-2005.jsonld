    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Paragraph 151BX(3)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-4-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.12",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) in the case of a contravention of the competition rule—for\neach contravention:\n\n(i) if the contravention continued for more than 21 days—\nthe sum of $31 million and $3 million for each day in\nexcess of 21 that the contravention continued; or\n\n(ii) otherwise—the sum of $10 million and $1 million for\neach day that the contravention continued; or",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) in the case of a contravention of the competition rule—for\neach contravention:\n\n(i) if the contravention continued for more than 21 days—\nthe sum of $31 million and $3 million for each day in\nexcess of 21 that the contravention continued; or\n\n(ii) otherwise—the sum of $10 million and $1 million for\neach day that the contravention continued; or",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-1-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "af70cea670dd7fa4dbbc90ee7c05b92ee9819493e8cca9f1d617613ea4910b03",
      "skos:note": "Prohibit contraventions of the competition rule exceeding 21 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-4-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Paragraph 151BX(3)(a)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) in the case of a contravention of the competition rule—for\neach contravention:\n\n(i) if the contravention continued for more than 21 days—\nthe sum of $31 million and $3 million for each day in\nexcess of 21 that the contravention continued; or\n\n(ii) otherwise—the sum of $10 million and $1 million for\neach day that the contravention continued; or"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-1-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits contraventions of the competition rule exceeding 21 days.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Application of amendment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-4-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.12",
      "values:originalText": "The amendment of section 151BX of the Trade Practices Act 1974\nmade by this Schedule applies to a contravention of the competition rule\nif:\n\n(a) in the case of a contravention that continued during a\nperiod—the period began after the commencement of this\nitem; or\n\n(b) otherwise—the contravention occurred after the\ncommencement of this item.\n\nEnforcement of conditions and limitations of exemption determinations and orders\nSchedule 5\n\nTelecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005\nNo. 119, 2005            9",
      "skos:definition": "The amendment of section 151BX of the Trade Practices Act 1974\nmade by this Schedule applies to a contravention of the competition rule\nif:\n\n(a) in the case of a contravention that continued during a\nperiod—the period began after the commencement of this\nitem; or\n\n(b) otherwise—the contravention occurred after the\ncommencement of this item.\n\nEnforcement of conditions and limitations of exemption determinations and orders\nSchedule 5\n\nTelecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005\nNo. 119, 2005            9",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-2-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-4-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2fdda3420ffaf01ee1cb323cc47194eb7cd67298893814b72eaaff240f9eaf27",
      "skos:note": "Amendment applies to contraventions of competition rule after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-4-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Application of amendment",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "The amendment of section 151BX of the Trade Practices Act 1974\nmade by this Schedule applies to a contravention of the competition rule\nif:\n\n(a) in the case of a contravention that continued during a\nperiod—the period began after the commencement of this\nitem; or\n\n(b) otherwise—the contravention occurred after the\ncommencement of this item.\n\nEnforcement of conditions and limitations of exemption determinations and orders\nSchedule 5\n\nTelecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005\nNo. 119, 2005            9"
    },
