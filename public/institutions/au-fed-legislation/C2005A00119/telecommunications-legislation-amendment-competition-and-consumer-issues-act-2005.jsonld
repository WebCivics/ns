    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-54-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "54(8) Approval of draft by Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-54-ss-8"
