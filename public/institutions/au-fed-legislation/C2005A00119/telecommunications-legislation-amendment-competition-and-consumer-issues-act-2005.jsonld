    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Effect of approval",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-55"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.43",
      "values:originalText": "(1) If the Minister approves a draft operational separation plan, the\nplan becomes a final operational separation plan. The final\noperational separation plan comes into force at the time when\nTelstra is notified of the approval.\n\n(2) A final operational separation plan is not a legislative instrument\nfor the purposes of the Legislative Instruments Act 2003.\n\n(3) Compliance with a final operational separation plan is not a\ncondition of Telstra’s carrier licence.",
