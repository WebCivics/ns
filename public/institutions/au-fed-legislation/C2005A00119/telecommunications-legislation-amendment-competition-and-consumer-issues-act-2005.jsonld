    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-66",
      "@type": "cml:Concept",
      "skos:prefLabel": "66 Publication of final rectification plan",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-66"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.50",
      "values:originalText": "(1) As soon as practicable after a final rectification plan comes into\nforce, Telstra must make a copy of the plan available on Telstra’s\nInternet site.\n\n(2) As soon as practicable after a variation of a final rectification plan\ncomes into force, Telstra must make a copy of the varied final\nrectification plan available on Telstra’s Internet site.\nTrade Practices Act 1974",
      "skos:definition": "(1) As soon as practicable after a final rectification plan comes into\nforce, Telstra must make a copy of the plan available on Telstra’s\nInternet site.\n\n(2) As soon as practicable after a variation of a final rectification plan\ncomes into force, Telstra must make a copy of the varied final\nrectification plan available on Telstra’s Internet site.\nTrade Practices Act 1974",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-66-ss-1"
        },
        {
