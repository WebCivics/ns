      },
      "cml:premiseText": "Declared service is covered by a determination in force under section 152AQA or 152AQB.",
      "cml:conclusionText": "Commission is not required to observe procedural fairness."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-12-sec-1-logic-descriptionlogic-2",
