        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-56-ss-3"
        }
      ],
      "cml:integrityHash": "7166e86d203a1d914ffdbaa3f945342c405c2fe5c6be56407a2c6816cd686cca"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Variation of final operational separation plan",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "(1) This clause applies if:\n\n(a) a final operational separation plan is in force; and\n\n(b) Telstra gives the Minister a draft variation of the plan.\n\n(2) The Minister must:\n\n(a) approve the variation; or\n\n(b) refuse to approve the variation.\n\n(3) In deciding whether to approve the variation, the Minister must\nhave regard to the following matters:\n\nSchedule 11  Operational separation of Telstra"
    },
