      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-3-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Paragraph 460(3)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-3-sec-1"
      },
      "cml:curationStatus": {
