        }
      ],
      "cml:integrityHash": "a9643cd569e7181f73d56d1c1979e515a7f383b2350f1ee9448377e8c4938afb",
      "skos:note": "A decision by the Australian Competition Tribunal is taken to be a decision of the ACCC for certain purposes."
    },
