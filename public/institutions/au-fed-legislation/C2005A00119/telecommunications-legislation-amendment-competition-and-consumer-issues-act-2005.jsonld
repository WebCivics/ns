      "@type": "cof:Section",
      "cof:title": "22 Subsection 152CBH(3)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Omit “The Commission”, substitute “If the Procedural Rules do not\nmake provision for or in relation to a time limit for giving the\ninformation, the Commission”."
    },
