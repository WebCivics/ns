        }
      ],
      "cml:integrityHash": "942881e7ed71c55f7c7fb6138ef31ccbbbcf1fc1204ebf9911214e8b16cb82d3",
      "skos:note": "ACCC must provide information, reports, and assistance to the Tribunal as specified."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-69b-ss-6",
      "@type": "cof:Section",
      "cof:title": "69B(6) Review by the Australian Competition Tribunal of remedial",
      "values:kind": "subsection",
      "cof:pageNumber": 34,
      "values:originalText": "(6) For the purposes of a review by the Australian Competition\nTribunal under this section, the member of the Tribunal presiding\nat the review may require the ACCC to give such information,\nmake such reports and provide such other assistance to the\nTribunal as the member specifies."
    },
