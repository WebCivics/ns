    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-60",
      "@type": "cml:Concept",
      "skos:prefLabel": "60 Draft rectification plan to be given to Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-60"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.46",
      "values:originalText": "(1) This clause applies if Telstra has contravened, or is contravening, a\nfinal operational separation plan.\n\n(2) The Minister may give Telstra a written direction requiring Telstra\nto give the Minister a draft rectification plan that relates to that\ncontravention.\n\n(3) Telstra must comply with the direction within 90 days after the day\non which the direction was given.\n\nOperational separation of Telstra  Schedule 11\n\nTelecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005\nNo. 119, 2005            43\n\n(4) A direction under this clause is a legislative instrument for the\npurposes of the Legislative Instruments Act 2003.",
      "skos:definition": "(1) This clause applies if Telstra has contravened, or is contravening, a\nfinal operational separation plan.\n\n(2) The Minister may give Telstra a written direction requiring Telstra\nto give the Minister a draft rectification plan that relates to that\ncontravention.\n\n(3) Telstra must comply with the direction within 90 days after the day\non which the direction was given.\n\nOperational separation of Telstra  Schedule 11\n\nTelecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005\nNo. 119, 2005            43\n\n(4) A direction under this clause is a legislative instrument for the\npurposes of the Legislative Instruments Act 2003.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-60-ss-1"
        },
