    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 At the end of section 152CLA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-7-sec-24"
      },
