    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 After subsection 152BT(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-7-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
