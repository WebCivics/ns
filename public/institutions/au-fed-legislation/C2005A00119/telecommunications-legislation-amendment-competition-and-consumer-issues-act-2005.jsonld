      "skos:prefLabel": "69B(5) Review by the Australian Competition Tribunal of remedial",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-69b-ss-5"
