    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-50c",
      "@type": "cml:Concept",
      "skos:prefLabel": "50C Notional contracts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-50c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.40",
      "values:originalText": "For the purposes of this Part:\n\n(a) a notional contract (however described) between any of\nTelstra’s business units is to be treated as if it were an actual\ncontract; and\n\n(b) any terms and conditions (whether or not relating to price or\na method of ascertaining price) in such a notional contract are\nto be treated as if they were actual terms and conditions.",
      "skos:definition": "For the purposes of this Part:\n\n(a) a notional contract (however described) between any of\nTelstra’s business units is to be treated as if it were an actual\ncontract; and\n\n(b) any terms and conditions (whether or not relating to price or\na method of ascertaining price) in such a notional contract are\nto be treated as if they were actual terms and conditions.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-50c-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-50c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7b34a46c946c1dfdccda36a45add828a1e1123ffe9abbe8598fdcc4e63f64a5f",
      "skos:note": "Treat notional contracts as actual contracts for Telstra's business units."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-50c",
      "@type": "cof:Section",
      "cof:title": "50C Notional contracts",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "For the purposes of this Part:\n\n(a) a notional contract (however described) between any of\nTelstra’s business units is to be treated as if it were an actual\ncontract; and\n\n(b) any terms and conditions (whether or not relating to price or\na method of ascertaining price) in such a notional contract are\nto be treated as if they were actual terms and conditions."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-50c-norm",
