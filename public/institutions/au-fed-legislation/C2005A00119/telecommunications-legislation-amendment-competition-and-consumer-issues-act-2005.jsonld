      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.21",
      "values:originalText": "Add:\nProcedural Rules\n\n(8) Subsections (2) to (7) may be displaced or modified by the\nProcedural Rules.\n\n(9) The Procedural Rules may authorise the Commission to defer\nconsideration of an access dispute, in whole or in part.\n\n(10) Subsection (9) has effect despite anything in this Division.",
      "skos:definition": "Add:\nProcedural Rules\n\n(8) Subsections (2) to (7) may be displaced or modified by the\nProcedural Rules.\n\n(9) The Procedural Rules may authorise the Commission to defer\nconsideration of an access dispute, in whole or in part.\n\n(10) Subsection (9) has effect despite anything in this Division.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-7-sec-24-ss-8"
        },
        {
