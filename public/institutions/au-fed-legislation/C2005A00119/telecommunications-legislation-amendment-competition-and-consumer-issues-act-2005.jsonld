      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.11",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) that a variation of a numbering plan:\n\n(i) will affect a number issued to a customer of a carriage\nservice provider, being a customer located in a\nparticular State; and\n\n(ii) is not a variation that, under a written declaration made\nby the ACMA under this subparagraph, is taken to be a\nminor variation; or",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) that a variation of a numbering plan:\n\n(i) will affect a number issued to a customer of a carriage\nservice provider, being a customer located in a\nparticular State; and\n\n(ii) is not a variation that, under a written declaration made\nby the ACMA under this subparagraph, is taken to be a\nminor variation; or",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-3-sec-1-norm"
        }
      ],
      "cml:integrityHash": "c688fc8e5c61bc56df1236bd3667656eba101fb1ee7aaf138a8c455da9b9d502",
      "skos:note": "Repeal paragraph and substitute with a new provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-3-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Paragraph 460(3)(a)",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) that a variation of a numbering plan:\n\n(i) will affect a number issued to a customer of a carriage\nservice provider, being a customer located in a\nparticular State; and\n\n(ii) is not a variation that, under a written declaration made\nby the ACMA under this subparagraph, is taken to be a\nminor variation; or"
    },
