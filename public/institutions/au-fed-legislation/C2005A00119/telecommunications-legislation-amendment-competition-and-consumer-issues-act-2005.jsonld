    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-151cp",
      "@type": "cml:Concept",
      "skos:prefLabel": "151CP Operational separation for Telstra",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-151cp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.50",
      "values:originalText": "(1) This section applies if Telstra has engaged in conduct in order to\ncomply with a final operational separation plan in force under\nPart 8 of Schedule 1 to the Telecommunications Act 1997.\n\n(2) In performing a function, or exercising a power, under this Part in\nrelation to Telstra, the Commission must have regard to the\nconduct to the extent that the conduct is relevant.",
      "skos:definition": "(1) This section applies if Telstra has engaged in conduct in order to\ncomply with a final operational separation plan in force under\nPart 8 of Schedule 1 to the Telecommunications Act 1997.\n\n(2) In performing a function, or exercising a power, under this Part in\nrelation to Telstra, the Commission must have regard to the\nconduct to the extent that the conduct is relevant.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-151cp-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-151cp-ss-2"
        }
      ],
      "cml:integrityHash": "e796a998399d2dad4b4946369dec86d8a2fcfddafa1126339a4f4aeff2693db5"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-151cp",
      "@type": "cof:Section",
      "cof:title": "151CP Operational separation for Telstra",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "(1) This section applies if Telstra has engaged in conduct in order to\ncomply with a final operational separation plan in force under\nPart 8 of Schedule 1 to the Telecommunications Act 1997.\n\n(2) In performing a function, or exercising a power, under this Part in\nrelation to Telstra, the Commission must have regard to the\nconduct to the extent that the conduct is relevant."
    },
