    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-58",
      "@type": "cml:Concept",
      "skos:prefLabel": "58 Publication of final operational separation plan",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-58"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.46",
      "values:originalText": "(1) As soon as practicable after a final operational separation plan\ncomes into force, Telstra must make a copy of the plan available\non Telstra’s Internet site.\n\n(2) As soon as practicable after a variation of a final operational\nseparation plan comes into force, Telstra must make a copy of the\nvaried final operational separation plan available on Telstra’s\nInternet site.",
      "skos:definition": "(1) As soon as practicable after a final operational separation plan\ncomes into force, Telstra must make a copy of the plan available\non Telstra’s Internet site.\n\n(2) As soon as practicable after a variation of a final operational\nseparation plan comes into force, Telstra must make a copy of the\nvaried final operational separation plan available on Telstra’s\nInternet site.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-58-ss-1"
        },
        {
