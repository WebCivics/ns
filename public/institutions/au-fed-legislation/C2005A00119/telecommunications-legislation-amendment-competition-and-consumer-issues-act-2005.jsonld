      "cml:integrityHash": "ddba15c108ce04d1a69a1e32e16bdcb6fa2ef257f9e46863502f51d81dce05b8",
      "skos:note": "Promote transparency and equivalence in wholesale services supply"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-48-ss-1",
      "@type": "cof:Section",
      "cof:title": "48(1) Aim and objects",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(1) The aim of this Part is to promote the principles of transparency\nand equivalence in relation to the supply by Telstra of wholesale\neligible services.\nObjects"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-48-ss-1-norm",
