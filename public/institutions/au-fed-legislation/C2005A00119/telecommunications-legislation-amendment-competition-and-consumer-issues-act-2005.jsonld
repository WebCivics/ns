    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-9-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Paragraph 152AB(2)(e)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-9-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.28",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(e) the objective of encouraging the economically efficient use\nof, and the economically efficient investment in:\n\n(i) the infrastructure by which listed services are supplied;\nand\n\n(ii) any other infrastructure by which listed services are, or\nare likely to become, capable of being supplied.",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(e) the objective of encouraging the economically efficient use\nof, and the economically efficient investment in:\n\n(i) the infrastructure by which listed services are supplied;\nand\n\n(ii) any other infrastructure by which listed services are, or\nare likely to become, capable of being supplied.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-9-sec-1-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-9-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6e19d2ef3dc11888c5fa071d8b405b8947b25b4a1744a55b4b78cab5f914936e",
      "skos:note": "Encourage economically efficient use of infrastructure for listed services."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-9-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Paragraph 152AB(2)(e)",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(e) the objective of encouraging the economically efficient use\nof, and the economically efficient investment in:\n\n(i) the infrastructure by which listed services are supplied;\nand\n\n(ii) any other infrastructure by which listed services are, or\nare likely to become, capable of being supplied."
    },
