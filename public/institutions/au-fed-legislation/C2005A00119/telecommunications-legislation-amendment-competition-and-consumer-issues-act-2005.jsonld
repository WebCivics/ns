    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-8-sec-44a",
      "@type": "cml:Concept",
      "skos:prefLabel": "44A Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-8-sec-44a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.25",
      "values:originalText": "The following is a simplified outline of this Part:\n•\nIf a carriage service provider’s telecommunications network is\ninterconnected with a carrier’s telecommunications network,\nthe carrier must obtain a designated interconnection service\nfrom the carriage service provider for the purpose of ensuring\nany-to-any connectivity.",
      "skos:definition": "The following is a simplified outline of this Part:\n•\nIf a carriage service provider’s telecommunications network is\ninterconnected with a carrier’s telecommunications network,\nthe carrier must obtain a designated interconnection service\nfrom the carriage service provider for the purpose of ensuring\nany-to-any connectivity.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-8-sec-44a-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-8-sec-44a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "916cc4d9507327b47b2c2816738afd2e1c867f4813dab8e87168ee58870afb1d",
      "skos:note": "Carrier must obtain designated interconnection service from carriage service provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-8-sec-44a",
      "@type": "cof:Section",
      "cof:title": "44A Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "The following is a simplified outline of this Part:\n•\nIf a carriage service provider’s telecommunications network is\ninterconnected with a carrier’s telecommunications network,\nthe carrier must obtain a designated interconnection service\nfrom the carriage service provider for the purpose of ensuring\nany-to-any connectivity."
    },
    {
