    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-12-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 At the end of section 152CPA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-12-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.52",
      "values:originalText": "Add:\n\n(12) The Commission is not required to observe any requirements of\nprocedural fairness in relation to the variation under\nsubsection (10) of an interim determination if:\n\n(a) both:\n\n(i) the declared service is covered by a determination in\nforce under section 152AQA; and\n\n(ii) the price-related terms and conditions in the varied\ninterim determination are consistent with the\nprice-related terms and conditions in the\nsection 152AQA determination; or\n\n(b) both:\n\n(i) the declared service is covered by a determination in\nforce under section 152AQB; and\n\n(ii) the price-related terms and conditions in the varied\ninterim determination are consistent with the\nprice-related terms and conditions in the\nsection 152AQB determination.\nFor this purpose, price-related terms and conditions means terms\nand conditions relating to price or a method of ascertaining price.\n\nRemedial directions  Schedule 13\n\nTelecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005\nNo. 119, 2005            49",
      "skos:definition": "Add:\n\n(12) The Commission is not required to observe any requirements of\nprocedural fairness in relation to the variation under\nsubsection (10) of an interim determination if:\n\n(a) both:\n\n(i) the declared service is covered by a determination in\nforce under section 152AQA; and\n\n(ii) the price-related terms and conditions in the varied\ninterim determination are consistent with the\nprice-related terms and conditions in the\nsection 152AQA determination; or\n\n(b) both:\n\n(i) the declared service is covered by a determination in\nforce under section 152AQB; and\n\n(ii) the price-related terms and conditions in the varied\ninterim determination are consistent with the\nprice-related terms and conditions in the\nsection 152AQB determination.\nFor this purpose, price-related terms and conditions means terms\nand conditions relating to price or a method of ascertaining price.\n\nRemedial directions  Schedule 13\n\nTelecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005\nNo. 119, 2005            49",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-12-sec-3-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-12-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-12-sec-3-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "29486c042e61002bfee6b6ddb46d42d759d19c5f92c894daeeccb4fcb940a4c7",
      "skos:note": "The Commission is not required to observe procedural fairness in relation to the variation under subsection (10) of an interim determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-12-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 At the end of section 152CPA",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Add:\n\n(12) The Commission is not required to observe any requirements of\nprocedural fairness in relation to the variation under\nsubsection (10) of an interim determination if:\n\n(a) both:\n\n(i) the declared service is covered by a determination in\nforce under section 152AQA; and\n\n(ii) the price-related terms and conditions in the varied\ninterim determination are consistent with the\nprice-related terms and conditions in the\nsection 152AQA determination; or\n\n(b) both:\n\n(i) the declared service is covered by a determination in\nforce under section 152AQB; and\n\n(ii) the price-related terms and conditions in the varied\ninterim determination are consistent with the\nprice-related terms and conditions in the\nsection 152AQB determination.\nFor this purpose, price-related terms and conditions means terms\nand conditions relating to price or a method of ascertaining price.\n\nRemedial directions  Schedule 13\n\nTelecommunications Legislation Amendment (Competition and Consumer Issues) Act 2005\nNo. 119, 2005            49"
    },
