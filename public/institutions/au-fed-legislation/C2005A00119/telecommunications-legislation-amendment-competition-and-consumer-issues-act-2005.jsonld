      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.41",
      "values:originalText": "Telstra must give the Minister a draft operational separation plan\nwithin 90 days after the commencement of this clause.",
      "skos:definition": "Telstra must give the Minister a draft operational separation plan\nwithin 90 days after the commencement of this clause.",
