      "cml:premiseText": "(10) A variation of a final rectification plan is not a legislative instrument for the purposes of the Legislative Instruments Act 2003.",
      "cml:conclusionText": "It is forbidden to classify a variation of a final rectification plan as a legislative instrument."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-63-ss-10-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Conditional obligation",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
