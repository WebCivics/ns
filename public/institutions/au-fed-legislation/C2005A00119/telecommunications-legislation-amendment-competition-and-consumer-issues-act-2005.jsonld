      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005.pdf, p.11",
      "values:originalText": "The amendments made by this Schedule do not apply in relation to a\nvariation of a numbering plan if a notice relating to the variation was\npublished under paragraph 460(3)(c) of the Telecommunications Act\n1997 before the commencement of this item.\n\nSchedule 4  Penalties for breaches of the competition rule",
      "skos:definition": "The amendments made by this Schedule do not apply in relation to a\nvariation of a numbering plan if a notice relating to the variation was\npublished under paragraph 460(3)(c) of the Telecommunications Act\n1997 before the commencement of this item.\n\nSchedule 4  Penalties for breaches of the competition rule",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-3-sec-4-norm"
        }
      ],
      "cml:integrityHash": "56c9cdffedb0ce8bd90698fdde0c226f6b4752b5e0b526b1f2fa9ac0f8bd86f6",
      "skos:note": "Exemptions from amendments for certain variations of numbering plans"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-3-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Application of amendments",
      "values:kind": "section",
