    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005-sch-11-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Draft operational separation plan to be given to Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-52"
      },
      "cml:curationStatus": {
