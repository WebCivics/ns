        }
      ],
      "cml:integrityHash": "b4162c61d915b5495853cd62df57065ddde6372bf4c180514b1558e08d5f29a5",
      "skos:note": "Direct Telstra to vary the draft plan and provide it within 60 days.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-issues-act-2005#sch-11-sec-54-ss-8",
      "@type": "cof:Section",
      "cof:title": "54(8) Approval of draft by Minister",
      "values:kind": "subsection",
      "cof:pageNumber": 42,
      "values:originalText": "(8) If the Minister refuses to approve the plan, the Minister may, by\nwritten notice given to Telstra, direct Telstra to:\n\n(a) vary the draft plan in accordance with the direction; and\n\n(b) give the varied draft plan to the Minister under subclause (1).\nTelstra must give the varied draft plan to the Minister within 60\ndays after the day on which the direction was given."
    },
