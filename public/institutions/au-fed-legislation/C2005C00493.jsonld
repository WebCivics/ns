      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-federal-police-and-other-legislation-amendment-act-2004#sch-3-sec-4aa-ss-1a",
      "cml:schemaVersion": "2",
