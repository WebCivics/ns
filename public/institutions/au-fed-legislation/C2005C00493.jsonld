      "skos:note": "Identify State offences with a federal aspect",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "4AA(1A) State offences that have a federal aspect"
      },
      "wasDerivedFrom": "australian-federal-police-and-other-legislation-amendment-act-2004.pdf",
