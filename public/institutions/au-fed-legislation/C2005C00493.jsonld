      "@id": "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-federal-police-and-other-legislation-amendment-act-2004.pdf, p.46",
      "skos:note": "A State offence has a federal aspect if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "42(1) Australian Federal Police and Other Legislation Amendment Act"
      },
      "wasDerivedFrom": "australian-federal-police-and-other-legislation-amendment-act-2004.pdf",
      "asserts": [
        "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-norm",
        "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-1",
        "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42-ss-1-logic-deontic-2",
