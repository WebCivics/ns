    {
      "@id": "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The definition of a protective service offence is greater than or equal to the Criminal Code section 91.1",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Definition includes offences against certain sections and Acts",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The definition of a protective service offence includes offences against section 91.1 of the Criminal Code."
    },
    {
      "@id": "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If an offence falls under Division 72 of the Criminal Code, it implies that the Australian Federal Police is performing protective service functions",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Definition implies certain conditions for an offence to be considered a protective service offence",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The definition of a protective service offence includes offences against Division 72 of the Criminal Code that relates to a person, place or thing in respect of which the Australian Federal Police is performing protective service functions."
    },
    {
      "@id": "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There exists an offence that falls under the definition of a protective service offence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Definition is related to the Australian Federal Police's role",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "is",
      "cml:premiseText": "The definition of a protective service offence is related to the Australian Federal Police's performance of protective service functions."
    },
    {
      "@id": "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There exists an offence that falls under the definition of a protective service offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Protective service offence is defined",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "The Australian Federal Police is performing protective service functions."
    },
    {
      "@id": "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The definition of a protective service offence is a subset of the Crimes Act 1914",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition includes offences against various Acts and sections",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is-a",
      "cml:premiseText": "The definition of a protective service offence includes offences against section 24AB, 29, 46 (other than paragraph b), 47, 47A, 79, 89 or 89A of the Crimes Act 1914."
    },
    {
      "@id": "concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-7-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The definition of a protective service offence is and includes multiple conditions",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Definition includes multiple conditions for an offence to be considered a protective service offence",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "and",
      "cml:premiseText": "The definition of a protective service offence includes offences against section 6 of the Crimes Act 1914, or section 11.1 or 11.4 of the Criminal Code that relates to an offence mentioned in paragraph (a)"
    },
