    <https://ns.webcivics.net/cml/logicSummary> "Definition includes offences against certain sections and Acts";
    <https://ns.webcivics.net/cml/premiseText> "The definition of a protective service offence includes offences against section 91.1 of the Criminal Code.";
    <https://ns.webcivics.net/cml/conclusionText> "The definition of a protective service offence is greater than or equal to the Criminal Code section 91.1";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
