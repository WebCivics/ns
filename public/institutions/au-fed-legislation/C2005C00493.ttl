    <http://www.w3.org/2004/02/skos/core#prefLabel> "42(1) Australian Federal Police and Other Legislation Amendment Act"@en;
    <https://ns.webcivics.net/cml/realizedBy> <https://ns.webcivics.net/values/australian-federal-police-and-other-legislation-amendment-act-2004#sch-3-sec-42-ss-1>;
    <https://ns.webcivics.net/cml/integrityHash> "7021436beb0e922c0506b8719f76e4139c52bee38a7d0b986d5ef77200f054e0";
    <https://ns.webcivics.net/values/partOf> <https://ns.webcivics.net/concept/australian-federal-police-and-other-legislation-amendment-act-2004-sch-3-sec-42>;
    <http://www.w3.org/2004/02/skos/core#note> "A State offence has a federal aspect if certain conditions are met.";
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>;
    <https://ns.webcivics.net/cml/schemaVersion> "2";
    <https://ns.webcivics.net/cml/proposedBy> <https://ns.webcivics.net/tools/legis2cml>;
