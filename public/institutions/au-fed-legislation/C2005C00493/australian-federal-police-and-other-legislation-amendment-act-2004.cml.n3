concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-35 a cml:Concept ;
    skos:prefLabel "35 At the end of section 40B"@en ;
    cml:realizedBy doc:sch-1-sec-35 ;
    values:originalText "Add: Note 1: A person who is currently a protective service officer may be declared to be a member if the person ceases to be a protective service officer. Note 2: This section does not prevent a protective service officer from being appointed as a special member." ;
    skos:definition "Add: Note 1: A person who is currently a protective service officer may be declared to be a member if the person ceases to be a protective service officer. Note 2: This section does not prevent a protective service officer from being appointed as a special member."@en ;
