concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-46 a cml:Concept ;
    skos:prefLabel "46 After section 64AA"@en ;
    cml:realizedBy doc:sch-1-sec-46 ;
    values:originalText "Insert: 64AAB  Suspended AFP employees who are protective service officers  If an AFP employee who is a protective service officer is suspended from duties under the regulations, the protective service officer must not, while the suspension is in force, exercise any power conferred on a protective service officer by this Act or any other law of the Commonwealth or of a Territory. Penalty: Imprisonment for 2 years." ;
    skos:definition "Insert: 64AAB  Suspended AFP employees who are protective service officers  If an AFP employee who is a protective service officer is suspended from duties under the regulations, the protective service officer must not, while the suspension is in force, exercise any power conferred on a protective service officer by this Act or any other law of the Commonwealth or of a Territory. Penalty: Imprisonment for 2 years."@en ;
    cml:integrityHash "49eb0a2a185bc831ed6d469c38049af43ba695988306f841fb5cd1f26ef4a262" ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "Prohibits AFP employees from exercising powers while suspended." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-and-other-legislation-amendment-act-2004.pdf> ;
