    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Commissioner may appoint special protective service officer." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
