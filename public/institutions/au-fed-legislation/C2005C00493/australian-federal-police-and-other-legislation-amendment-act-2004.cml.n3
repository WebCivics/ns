doc:sec-10-3 a cof:Section ;
    cof:title "10 Schedule 2," ;
    values:kind "section" ;
    values:originalText "item 8 The later of: (a) the day on which this Act receives the Royal Assent; and (b) immediately after the commencement of section 3 of the Legislative Instruments Act 2003. However, the provision(s) do not commence at all if the event mentioned in paragraph (b) does not occur." ;
    cof:pageNumber "7"^^xsd:integer .

