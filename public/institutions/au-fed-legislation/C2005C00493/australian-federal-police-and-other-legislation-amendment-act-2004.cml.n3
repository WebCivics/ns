concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-69e a cml:Concept ;
    skos:prefLabel "69E Commissioner may charge for certain protective services"@en ;
    cml:realizedBy doc:sch-1-sec-69e ;
    values:originalText "(1) If services are provided by a protective service officer or a special protective service officer at the request of a person other than:  (a) a person holding office under the Commonwealth; or  (b) a Commonwealth authority; the Commissioner may charge for the services.  Schedule 1  Amendment of the Australian Federal Police Act 1979" ;
    skos:definition "(1) If services are provided by a protective service officer or a special protective service officer at the request of a person other than:  (a) a person holding office under the Commonwealth; or  (b) a Commonwealth authority; the Commissioner may charge for the services.  Schedule 1  Amendment of the Australian Federal Police Act 1979"@en ;
    cml:integrityHash "23c8c5f2620ed8f24e337e5fe8fe2408d84c9f6d01860e8ffc4c8af44df4c950" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Commissioner may charge for certain protective services" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-and-other-legislation-amendment-act-2004.pdf> ;
