    cml:hasPart concept:australian-federal-police-and-other-legislation-amendment-act-2004-sec-4-3-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-and-other-legislation-amendment-act-2004.pdf> ;
    dc:source "australian-federal-police-and-other-legislation-amendment-act-2004.pdf, p.8" .
