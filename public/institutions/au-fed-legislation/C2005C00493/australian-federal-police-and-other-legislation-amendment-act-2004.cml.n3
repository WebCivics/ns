concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-28-2 a cml:Concept ;
    skos:prefLabel "28 Australian Federal Police and Other Legislation Amendment Act"@en ;
    cml:realizedBy doc:sch-1-sec-28-2 ;
    values:originalText "(b) an unintentional omission of the defendant. Note: The defendant bears a legal burden in relation to the matter in subsection (3). See section 13.4 of the Criminal Code.  (4) The Commissioner must take such steps as are necessary to enable protective service officers to whom subsection (1) applies to comply with that subsection." ;
    skos:definition "(b) an unintentional omission of the defendant. Note: The defendant bears a legal burden in relation to the matter in subsection (3). See section 13.4 of the Criminal Code.  (4) The Commissioner must take such steps as are necessary to enable protective service officers to whom subsection (1) applies to comply with that subsection."@en ;
    cml:integrityHash "fc865aa63293f9c51a9f713fc5c6487f95d00cdec24ebab9c902787be502d42b" ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "The Commissioner must take steps to enable protective service officers to comply with subsection (1)." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
