concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-14n a cml:Concept ;
    skos:prefLabel "14N Relationship of Division to other laws"@en ;
    cml:realizedBy doc:sch-1-sec-14n ;
    values:originalText "The powers conferred, and duties imposed, by this Division on protective service officers, members and special members are in addition to, and not in derogation of, any other powers conferred, or duties imposed, by any other law of the Commonwealth or the law of a State or Territory, and this Division is not intended to exclude or limit the operation of any other law of the Commonwealth or the law of a State or Territory in so far as it is capable of operating concurrently with this Division." ;
    skos:definition "The powers conferred, and duties imposed, by this Division on protective service officers, members and special members are in addition to, and not in derogation of, any other powers conferred, or duties imposed, by any other law of the Commonwealth or the law of a State or Territory, and this Division is not intended to exclude or limit the operation of any other law of the Commonwealth or the law of a State or Territory in so far as it is capable of operating concurrently with this Division."@en ;
    cml:integrityHash "93c50057199178bfb1710bc0dcb3c7ef58a46cef9dae5ffd3fcf8fc0867c70eb" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "No other laws can limit or exclude the operation of this Division." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-federal-police-and-other-legislation-amendment-act-2004.pdf> ;
    dc:source "australian-federal-police-and-other-legislation-amendment-act-2004.pdf, p.27" ;
    cml:asserts concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-14n-norm .
