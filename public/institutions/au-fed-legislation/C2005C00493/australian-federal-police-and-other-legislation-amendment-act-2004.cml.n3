doc:sch-3-sec-13 a cof:Section ;
    cof:title "13 Subsection 23WA(1) (definition of indictable offence)" ;
    values:kind "section" ;
    values:originalText "Repeal the definition, substitute: indictable offence means:  (a) an indictable offence against a law of the Commonwealth; or  (b) a State offence that has a federal aspect and that is an indictable offence against the law of that State." ;
    cof:pageNumber "50"^^xsd:integer .

