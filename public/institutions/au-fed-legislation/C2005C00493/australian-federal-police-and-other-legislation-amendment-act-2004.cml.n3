doc:sch-1-sec-40ec a cof:Section ;
    cof:title "40EC Special protective service officers" ;
    values:kind "section" ;
    values:originalText "The Commissioner may, on such terms and conditions as the Commissioner determines in writing, appoint a person as a special protective service officer of the Australian Federal Police to assist in performing the protective service functions of the Australian Federal Police." ;
    cof:pageNumber "29"^^xsd:integer .

concept:australian-federal-police-and-other-legislation-amendment-act-2004-sch-1-sec-40ed a cml:Concept ;
    skos:prefLabel "40ED Powers and duties of special protective service officers"@en ;
    cml:realizedBy doc:sch-1-sec-40ed ;
    values:originalText "A special protective service officer has:  (a) any powers and duties that are expressly conferred or imposed on special protective service officers under a provision of this Act or any other Act; and  (b) such of the powers and duties conferred or imposed on protective service officers as are specified in his or her instrument of appointment." ;
    skos:definition "A special protective service officer has:  (a) any powers and duties that are expressly conferred or imposed on special protective service officers under a provision of this Act or any other Act; and  (b) such of the powers and duties conferred or imposed on protective service officers as are specified in his or her instrument of appointment."@en ;
    cml:integrityHash "bfd205790e27c92d3e9ac7064004edb12d9456704523a2b06df8a6ff9c9e5c1a" ;
    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Special protective service officers have powers and duties expressly conferred or imposed under this Act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
