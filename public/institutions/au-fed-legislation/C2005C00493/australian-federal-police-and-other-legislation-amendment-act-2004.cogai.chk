  operator: if-and-only-if;
  summary: States the condition for a State offence to have a federal aspect.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (1) For the purposes of this Act, a State offence has a federal aspect if...;
  @action: ...the provision would have been a valid law of the Commonwealth;;
}

