concept:australian-broadcasting-corporation-amendment-act-2006-sch-1-sec-11 a cml:Concept ;
    skos:prefLabel "11 Cessation of staff-elected Director and deputy"@en ;
    cml:realizedBy doc:sch-1-sec-11 ;
    values:originalText "Schedule 1  Amendments  (1) Any person who is the staff-elected Director immediately before the commencement of item 2 of this Schedule ceases, by force of this subitem, to be a member of the Board on the commencement of that item. (2) Any person who is the deputy of the staff-elected Director immediately before the commencement of item 5 of this Schedule ceases, by force of this subitem, to be the deputy of the staff-elected Director on the commencement of that item.  [Minister’s second reading speech made in— Senate on 29 March 2006 House of Representatives on 24 May 2006]  (38/06)" ;
    skos:definition "Schedule 1  Amendments  (1) Any person who is the staff-elected Director immediately before the commencement of item 2 of this Schedule ceases, by force of this subitem, to be a member of the Board on the commencement of that item. (2) Any person who is the deputy of the staff-elected Director immediately before the commencement of item 5 of this Schedule ceases, by force of this subitem, to be the deputy of the staff-elected Director on the commencement of that item.  [Minister’s second reading speech made in— Senate on 29 March 2006 House of Representatives on 24 May 2006]  (38/06)"@en ;
    cml:integrityHash "233dae0b862d787c76d014c78b19ca079747a1c1eda6b8467b110b84d87d1d28" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Cessation of staff-elected Director and deputy upon commencement of Schedule item 2 or 5." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-broadcasting-corporation-amendment-act-2006.pdf> ;
    dc:source "australian-broadcasting-corporation-amendment-act-2006.pdf, p.7" ;
    cml:asserts concept:australian-broadcasting-corporation-amendment-act-2006-sch-1-sec-11-norm .
