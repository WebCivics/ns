    {
      "@id": "concept:australian-broadcasting-corporation-amendment-act-2006-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-amendment-act-2006#sec-3"
      },
