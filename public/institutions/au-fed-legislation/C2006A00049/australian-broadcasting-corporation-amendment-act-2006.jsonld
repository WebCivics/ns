    {
      "@id": "concept:australian-broadcasting-corporation-amendment-act-2006-sch-1-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Cessation of staff-elected Director and deputy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-amendment-act-2006#sch-1-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-amendment-act-2006.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-amendment-act-2006.pdf, p.7",
      "values:originalText": "Schedule 1  Amendments\n\n(1)\nAny person who is the staff-elected Director immediately before the\ncommencement of item 2 of this Schedule ceases, by force of this\nsubitem, to be a member of the Board on the commencement of that\nitem.\n(2)\nAny person who is the deputy of the staff-elected Director immediately\nbefore the commencement of item 5 of this Schedule ceases, by force of\nthis subitem, to be the deputy of the staff-elected Director on the\ncommencement of that item.\n\n[Minister’s second reading speech made in—\nSenate on 29 March 2006\nHouse of Representatives on 24 May 2006]\n\n(38/06)",
      "skos:definition": "Schedule 1  Amendments\n\n(1)\nAny person who is the staff-elected Director immediately before the\ncommencement of item 2 of this Schedule ceases, by force of this\nsubitem, to be a member of the Board on the commencement of that\nitem.\n(2)\nAny person who is the deputy of the staff-elected Director immediately\nbefore the commencement of item 5 of this Schedule ceases, by force of\nthis subitem, to be the deputy of the staff-elected Director on the\ncommencement of that item.\n\n[Minister’s second reading speech made in—\nSenate on 29 March 2006\nHouse of Representatives on 24 May 2006]\n\n(38/06)",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-amendment-act-2006-sch-1-sec-11-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-amendment-act-2006-sch-1-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "233dae0b862d787c76d014c78b19ca079747a1c1eda6b8467b110b84d87d1d28",
      "skos:note": "Cessation of staff-elected Director and deputy upon commencement of Schedule item 2 or 5."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-amendment-act-2006#sch-1-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Cessation of staff-elected Director and deputy",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Schedule 1  Amendments\n\n(1)\nAny person who is the staff-elected Director immediately before the\ncommencement of item 2 of this Schedule ceases, by force of this\nsubitem, to be a member of the Board on the commencement of that\nitem.\n(2)\nAny person who is the deputy of the staff-elected Director immediately\nbefore the commencement of item 5 of this Schedule ceases, by force of\nthis subitem, to be the deputy of the staff-elected Director on the\ncommencement of that item.\n\n[Minister’s second reading speech made in—\nSenate on 29 March 2006\nHouse of Representatives on 24 May 2006]\n\n(38/06)"
    },
    {
      "@id": "concept:australian-broadcasting-corporation-amendment-act-2006-sch-1-sec-11-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
