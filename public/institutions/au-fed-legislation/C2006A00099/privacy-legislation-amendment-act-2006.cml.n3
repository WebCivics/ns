concept:privacy-legislation-amendment-act-2006-sch-2-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 6(1)"@en ;
    cml:realizedBy doc:sch-2-sec-1 ;
    values:originalText "Insert: genetic relative of an individual (the first individual) means another individual who is related to the first individual by blood, including but not limited to a sibling, a parent or a descendant of the first individual." ;
