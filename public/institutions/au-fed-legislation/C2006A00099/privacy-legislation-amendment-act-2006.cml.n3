    cml:modality cml:Deontic ;
    cml:operator "must" ;
    cml:logicSummary "Organisation has a duty to reasonably believe use or disclosure is necessary" ;
    cml:premiseText "the organisation has obtained the genetic information in the course of providing a health service to the individual" ;
    cml:conclusionText "the use or disclosure is necessary to prevent serious threat to life, health or safety of genetic relative" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-legislation-amendment-act-2006-sch-2-sec-5 cml:asserts concept:privacy-legislation-amendment-act-2006-sch-2-sec-5-logic-alleninterval-2 .
