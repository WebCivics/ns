    {
      "@id": "concept:privacy-legislation-amendment-act-2006-sch-2-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 After paragraph 2.1(e) of Schedule 3",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-act-2006#sch-2-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-legislation-amendment-act-2006.pdf"
      },
      "dc:source": "privacy-legislation-amendment-act-2006.pdf, p.9",
      "values:originalText": "Insert:\n\n(ea) if the information is genetic information and the organisation\nhas obtained the genetic information in the course of\nproviding a health service to the individual:\n\n(i) the organisation reasonably believes that the use or\ndisclosure is necessary to lessen or prevent a serious\nthreat to the life, health or safety (whether or not the\nthreat is imminent) of an individual who is a genetic\nrelative of the individual to whom the genetic\ninformation relates; and\n\n(ii) the use or disclosure is conducted in accordance with\nguidelines approved by the Commissioner under\nsection 95AA for the purposes of this subparagraph; and\n\n(iii) in the case of disclosure—the recipient of the genetic\ninformation is a genetic relative of the individual; or\n\n\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 22 June 2006\nSenate on 4 September 2006]\n\n(98/06)",
      "skos:definition": "Insert:\n\n(ea) if the information is genetic information and the organisation\nhas obtained the genetic information in the course of\nproviding a health service to the individual:\n\n(i) the organisation reasonably believes that the use or\ndisclosure is necessary to lessen or prevent a serious\nthreat to the life, health or safety (whether or not the\nthreat is imminent) of an individual who is a genetic\nrelative of the individual to whom the genetic\ninformation relates; and\n\n(ii) the use or disclosure is conducted in accordance with\nguidelines approved by the Commissioner under\nsection 95AA for the purposes of this subparagraph; and\n\n(iii) in the case of disclosure—the recipient of the genetic\ninformation is a genetic relative of the individual; or\n\n\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 22 June 2006\nSenate on 4 September 2006]\n\n(98/06)",
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-act-2006-sch-2-sec-5-norm"
        },
        {
          "@id": "concept:privacy-legislation-amendment-act-2006-sch-2-sec-5-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-legislation-amendment-act-2006-sch-2-sec-5-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-legislation-amendment-act-2006-sch-2-sec-5-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-legislation-amendment-act-2006-sch-2-sec-5-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "9f1f2dfc8484fde6ddd66a63b07a2d37b9dab7160b76fc2eb3245e0fe44d6474",
      "skos:note": "Organisation must reasonably believe use or disclosure is necessary to prevent serious threat to life, health or safety of genetic relative."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-act-2006#sch-2-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 After paragraph 2.1(e) of Schedule 3",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Insert:\n\n(ea) if the information is genetic information and the organisation\nhas obtained the genetic information in the course of\nproviding a health service to the individual:\n\n(i) the organisation reasonably believes that the use or\ndisclosure is necessary to lessen or prevent a serious\nthreat to the life, health or safety (whether or not the\nthreat is imminent) of an individual who is a genetic\nrelative of the individual to whom the genetic\ninformation relates; and\n\n(ii) the use or disclosure is conducted in accordance with\nguidelines approved by the Commissioner under\nsection 95AA for the purposes of this subparagraph; and\n\n(iii) in the case of disclosure—the recipient of the genetic\ninformation is a genetic relative of the individual; or\n\n\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 22 June 2006\nSenate on 4 September 2006]\n\n(98/06)"
    },
