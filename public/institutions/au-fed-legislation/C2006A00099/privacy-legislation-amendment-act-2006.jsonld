      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Organisation has a duty to reasonably believe use or disclosure is necessary",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
