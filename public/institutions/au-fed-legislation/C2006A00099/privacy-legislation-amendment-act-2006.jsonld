      },
      "cml:premiseText": "the organisation has obtained the genetic information in the course of providing a health service to the individual",
      "cml:conclusionText": "the use or disclosure is conducted in accordance with guidelines approved by the Commissioner under section 95AA"
    },
    {
      "@id": "concept:privacy-legislation-amendment-act-2006-sch-2-sec-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Use or disclosure must cease when threat has passed",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the organisation reasonably believes that the use or disclosure is necessary to prevent serious threat to life, health or safety of genetic relative",
      "cml:conclusionText": "the use or disclosure is conducted in accordance with guidelines approved by the Commissioner under section 95AA"
    },
    {
      "@id": "concept:privacy-legislation-amendment-act-2006-sch-2-sec-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Recipient of genetic information must be a genetic relative",
      "cml:executionSurface": "modalities::logic::deontic",
