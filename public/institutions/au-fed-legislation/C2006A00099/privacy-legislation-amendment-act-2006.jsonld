      "dc:source": "privacy-legislation-amendment-act-2006.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments relating to collection of health information  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments relating to collection of health information  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-act-2006-sec-3-norm"
        }
      ],
      "cml:integrityHash": "f0f4b811c260fc6e9421145df08e2d9a1b92734ad4bed78c6865363e2a9d05f6",
      "skos:note": "Amendments to Acts specified in Schedules"
    },
