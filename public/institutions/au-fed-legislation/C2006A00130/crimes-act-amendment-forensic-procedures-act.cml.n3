doc:sch-1-sec-20-ss-4 a cof:Section ;
    cof:title "20(4) After section 23YDAC" ;
    values:kind "subsection" ;
    values:originalText "(4) No part of the Commonwealth DNA database system, and no information obtained from the Commonwealth DNA database system, forms part of a State/Territory DNA database system by reason only of any integration referred to in subsection (1)." ;
    cof:pageNumber "10"^^xsd:integer .

concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-20-ss-5 a cml:Concept ;
    skos:prefLabel "20(5) After section 23YDAC"@en ;
    cml:realizedBy doc:sch-1-sec-20-ss-5 ;
    values:originalText "(5) The existence of the Commonwealth DNA database system or a State/Territory DNA database system is not affected by reason only of any integration referred to in subsection (1)." ;
    skos:definition "(5) The existence of the Commonwealth DNA database system or a State/Territory DNA database system is not affected by reason only of any integration referred to in subsection (1)."@en ;
