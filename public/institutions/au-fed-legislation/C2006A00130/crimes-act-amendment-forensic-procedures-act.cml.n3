concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-52 a cml:Concept ;
    skos:prefLabel "52 Transitional"@en ;
    cml:realizedBy doc:sch-1-sec-52 ;
    values:originalText "For the purposes of the application of Part ID of the Crimes Act 1914 after the commencement of this item, a reference to the Commonwealth DNA database system is taken, in relation to a thing that happened before that commencement, to include a reference to the DNA database system (within the meaning of that Act as in force immediately before that commencement).  [Minister’s second reading speech made in— Senate on 21 June 2006 House of Representatives on 18 October 2006]  (99/06)    Crimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006            13" ;
    skos:definition "For the purposes of the application of Part ID of the Crimes Act 1914 after the commencement of this item, a reference to the Commonwealth DNA database system is taken, in relation to a thing that happened before that commencement, to include a reference to the DNA database system (within the meaning of that Act as in force immediately before that commencement).  [Minister’s second reading speech made in— Senate on 21 June 2006 House of Representatives on 18 October 2006]  (99/06)    Crimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006            13"@en ;
    cml:integrityHash "73d8297bfd461a22a72dec00a0ef958e901e503ff0ebc4df85c412012526e568" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Transitional provision for application of Part ID of the Crimes Act 1914" ;
    cml:curationStatus cml:Proposed ;
