concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-7 a cml:Concept ;
    skos:prefLabel "7 At the end of Subdivision D of Division 6 of Part ID"@en ;
    cml:realizedBy doc:sch-1-sec-7 ;
    values:originalText "Add: 23XSA  Presence of prison officers  If:  (a) a particular suspect is being detained in prison; and  (b) a forensic procedure is to be carried out on the suspect (whether or not the forensic procedure is to be carried out in prison); one or more prison officers may be present while the forensic procedure is carried out." ;
    skos:definition "Add: 23XSA  Presence of prison officers  If:  (a) a particular suspect is being detained in prison; and  (b) a forensic procedure is to be carried out on the suspect (whether or not the forensic procedure is to be carried out in prison); one or more prison officers may be present while the forensic procedure is carried out."@en ;
    cml:integrityHash "84669d47a57c33caf95075087d01d71d6630f61b40dcc338e0abd3f7c07287bb" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Presence of prison officers during forensic procedure" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
