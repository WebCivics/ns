    {
      "@id": "concept:crimes-act-amendment-forensic-procedures-act-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-amendment-forensic-procedures-act.pdf"
      },
      "dc:source": "crimes-act-amendment-forensic-procedures-act.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nCrimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006            3",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nCrimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006            3",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-amendment-forensic-procedures-act-sec-3-norm"
        }
      ],
      "cml:integrityHash": "366331cb5437d67fa33d84932c9990006b13cb0783a7a896025349b35e05e739",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nCrimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006            3"
    },
