    {
      "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-6-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Crimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-6-2"
      },
      "cml:curationStatus": {
