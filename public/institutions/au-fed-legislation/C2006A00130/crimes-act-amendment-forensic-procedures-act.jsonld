      "cml:logicSummary": "Defines the scope of the term",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "for the purposes of a corresponding law.",
      "cml:conclusionText": "The term applies to databases for law enforcement purposes."
    },
