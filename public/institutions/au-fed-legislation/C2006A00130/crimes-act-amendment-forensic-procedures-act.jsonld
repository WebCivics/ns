    {
      "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Transitional",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-52"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-amendment-forensic-procedures-act.pdf"
      },
      "dc:source": "crimes-act-amendment-forensic-procedures-act.pdf, p.16",
      "values:originalText": "For the purposes of the application of Part ID of the Crimes Act 1914\nafter the commencement of this item, a reference to the Commonwealth\nDNA database system is taken, in relation to a thing that happened\nbefore that commencement, to include a reference to the DNA database\nsystem (within the meaning of that Act as in force immediately before\nthat commencement).\n\n[Minister’s second reading speech made in—\nSenate on 21 June 2006\nHouse of Representatives on 18 October 2006]\n\n(99/06)\n\n\n\nCrimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006            13",
      "skos:definition": "For the purposes of the application of Part ID of the Crimes Act 1914\nafter the commencement of this item, a reference to the Commonwealth\nDNA database system is taken, in relation to a thing that happened\nbefore that commencement, to include a reference to the DNA database\nsystem (within the meaning of that Act as in force immediately before\nthat commencement).\n\n[Minister’s second reading speech made in—\nSenate on 21 June 2006\nHouse of Representatives on 18 October 2006]\n\n(99/06)\n\n\n\nCrimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006            13",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-52-norm"
        }
      ],
      "cml:integrityHash": "73d8297bfd461a22a72dec00a0ef958e901e503ff0ebc4df85c412012526e568",
      "skos:note": "Transitional provision for application of Part ID of the Crimes Act 1914"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-52",
      "@type": "cof:Section",
      "cof:title": "52 Transitional",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "For the purposes of the application of Part ID of the Crimes Act 1914\nafter the commencement of this item, a reference to the Commonwealth\nDNA database system is taken, in relation to a thing that happened\nbefore that commencement, to include a reference to the DNA database\nsystem (within the meaning of that Act as in force immediately before\nthat commencement).\n\n[Minister’s second reading speech made in—\nSenate on 21 June 2006\nHouse of Representatives on 18 October 2006]\n\n(99/06)\n\n\n\nCrimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006            13"
    },
