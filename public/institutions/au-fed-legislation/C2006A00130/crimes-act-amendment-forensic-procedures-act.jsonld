      },
      "dc:source": "crimes-act-amendment-forensic-procedures-act.pdf, p.10",
      "values:originalText": "and, if the material is forensic material, information that may\nbe used to identify the person from whose forensic material\neach DNA profile was derived; and\n\n(b) a statistical index (in so far as it relates to forensic material\ntaken in accordance with this Part); and\n\n(c) any other index prescribed by the regulations for the\npurposes of this definition.",
      "skos:definition": "and, if the material is forensic material, information that may\nbe used to identify the person from whose forensic material\neach DNA profile was derived; and\n\n(b) a statistical index (in so far as it relates to forensic material\ntaken in accordance with this Part); and\n\n(c) any other index prescribed by the regulations for the\npurposes of this definition.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-6-2-norm"
        },
        {
          "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-6-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c9e110c329014bde4e8c9bf62b37a1c9fa71df92c7dbbc050c29dae64e3567b",
      "skos:note": "Requires disclosure of information for forensic DNA profiles."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-6-2",
      "@type": "cof:Section",
      "cof:title": "6 Crimes Act Amendment (Forensic Procedures) Act (No. 1) 2006       No. 130, 2006",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "and, if the material is forensic material, information that may\nbe used to identify the person from whose forensic material\neach DNA profile was derived; and\n\n(b) a statistical index (in so far as it relates to forensic material\ntaken in accordance with this Part); and\n\n(c) any other index prescribed by the regulations for the\npurposes of this definition."
    },
