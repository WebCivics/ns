    {
      "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Section 23YDAC",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-amendment-forensic-procedures-act.pdf"
      },
      "dc:source": "crimes-act-amendment-forensic-procedures-act.pdf, p.9",
      "values:originalText": "Insert:\nCommonwealth DNA database system means a database (whether\nin computerised or other form and however described) containing:\n\n(a) the following indexes of DNA profiles (in so far as they\nrelate to material taken or obtained by a Commonwealth\nagency):\n\n(i) a crime scene index;\n\n(ii) a missing persons index;\n\n(iii) an unknown deceased persons index;\n\n(iv) a serious offenders index;\n\n(v) a volunteers (unlimited purposes) index;\n\n(vi) a volunteers (limited purposes) index;\n\n(vii) a suspects index;\n\nSchedule 1  Amendments",
      "skos:definition": "Insert:\nCommonwealth DNA database system means a database (whether\nin computerised or other form and however described) containing:\n\n(a) the following indexes of DNA profiles (in so far as they\nrelate to material taken or obtained by a Commonwealth\nagency):\n\n(i) a crime scene index;\n\n(ii) a missing persons index;\n\n(iii) an unknown deceased persons index;\n\n(iv) a serious offenders index;\n\n(v) a volunteers (unlimited purposes) index;\n\n(vi) a volunteers (limited purposes) index;\n\n(vii) a suspects index;\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-14-norm"
        }
      ],
      "cml:integrityHash": "9289cd02e644e5239a73643157518870826a68baab541605005a691af23c7256",
      "skos:note": "Defines Commonwealth DNA database system"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Section 23YDAC",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Insert:\nCommonwealth DNA database system means a database (whether\nin computerised or other form and however described) containing:\n\n(a) the following indexes of DNA profiles (in so far as they\nrelate to material taken or obtained by a Commonwealth\nagency):\n\n(i) a crime scene index;\n\n(ii) a missing persons index;\n\n(iii) an unknown deceased persons index;\n\n(iv) a serious offenders index;\n\n(v) a volunteers (unlimited purposes) index;\n\n(vi) a volunteers (limited purposes) index;\n\n(vii) a suspects index;\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-14-norm",
