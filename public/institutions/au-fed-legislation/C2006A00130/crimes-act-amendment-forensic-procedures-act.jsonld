    {
      "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 At the end of Subdivision D of Division 6 of Part ID",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-amendment-forensic-procedures-act.pdf"
      },
      "dc:source": "crimes-act-amendment-forensic-procedures-act.pdf, p.8",
      "values:originalText": "Add:\n23XSA  Presence of prison officers\n\nIf:\n\n(a) a particular suspect is being detained in prison; and\n\n(b) a forensic procedure is to be carried out on the suspect\n(whether or not the forensic procedure is to be carried out in\nprison);\none or more prison officers may be present while the forensic\nprocedure is carried out.",
      "skos:definition": "Add:\n23XSA  Presence of prison officers\n\nIf:\n\n(a) a particular suspect is being detained in prison; and\n\n(b) a forensic procedure is to be carried out on the suspect\n(whether or not the forensic procedure is to be carried out in\nprison);\none or more prison officers may be present while the forensic\nprocedure is carried out.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-7-norm"
        },
        {
          "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "84669d47a57c33caf95075087d01d71d6630f61b40dcc338e0abd3f7c07287bb",
      "skos:note": "Presence of prison officers during forensic procedure"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 At the end of Subdivision D of Division 6 of Part ID",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Add:\n23XSA  Presence of prison officers\n\nIf:\n\n(a) a particular suspect is being detained in prison; and\n\n(b) a forensic procedure is to be carried out on the suspect\n(whether or not the forensic procedure is to be carried out in\nprison);\none or more prison officers may be present while the forensic\nprocedure is carried out."
    },
