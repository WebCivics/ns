    {
      "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-43b",
      "@type": "cml:Concept",
      "skos:prefLabel": "43B After subsection 23YUD(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-43b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-act-amendment-forensic-procedures-act.pdf"
      },
      "dc:source": "crimes-act-amendment-forensic-procedures-act.pdf, p.15",
      "values:originalText": "Insert:\n\n(1AA) Subject to subsection (1B), an arrangement with a participating\njurisdiction under subsection (1A) may deal with:\n\n(a) CrimTrac comparing information transmitted in accordance\nwith that arrangement with other information on NCIDD; and\n\n(b) CrimTrac identifying matches that are found because of such\ncomparisons and CrimTrac transmitting information arising\nfrom such matches to that participating jurisdiction.\n\n(1AB) Subsection (1AA) does not limit subsection (1A).",
      "skos:definition": "Insert:\n\n(1AA) Subject to subsection (1B), an arrangement with a participating\njurisdiction under subsection (1A) may deal with:\n\n(a) CrimTrac comparing information transmitted in accordance\nwith that arrangement with other information on NCIDD; and\n\n(b) CrimTrac identifying matches that are found because of such\ncomparisons and CrimTrac transmitting information arising\nfrom such matches to that participating jurisdiction.\n\n(1AB) Subsection (1AA) does not limit subsection (1A).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-act-amendment-forensic-procedures-act-sch-1-sec-43b-norm"
        }
      ],
      "cml:integrityHash": "74b69e85d66841ccdef129e6916779ad62db641c21268f949260fe9b87bba9b4",
      "skos:note": "Defines an arrangement with a participating jurisdiction under subsection (1A)"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-act-amendment-forensic-procedures-act#sch-1-sec-43b",
      "@type": "cof:Section",
      "cof:title": "43B After subsection 23YUD(1A)",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Insert:\n\n(1AA) Subject to subsection (1B), an arrangement with a participating\njurisdiction under subsection (1A) may deal with:\n\n(a) CrimTrac comparing information transmitted in accordance\nwith that arrangement with other information on NCIDD; and\n\n(b) CrimTrac identifying matches that are found because of such\ncomparisons and CrimTrac transmitting information arising\nfrom such matches to that participating jurisdiction.\n\n(1AB) Subsection (1AA) does not limit subsection (1A)."
    },
