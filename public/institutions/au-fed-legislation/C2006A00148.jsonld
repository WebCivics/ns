      "@type": "cml:Concept",
      "dc:source": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf, p.7",
      "skos:note": "Definition of 'duty of confidence'",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "80G(1) Interpretation"
      },
      "wasDerivedFrom": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf",
      "asserts": [
        "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80g-ss-1-norm",
