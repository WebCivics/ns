        "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80g-ss-1-logic-descriptionlogic-2",
        "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80g-ss-1-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "45c9d05c3dfc2899046e50caf6ab3f06d9041f41f547fa964d537e577d7d1d9c",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80g-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80g"
    },
    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80g-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Australian citizen has a duty of confidence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Definition of duty of confidence",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "duty of confidence means any duty or obligation arising under the common law or at equity"
    },
    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80g-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "duty of confidence does not include legal professional privilege",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exclusion of legal professional privilege",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "but does not include legal professional privilege"
    },
    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80g-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Australian citizen has an emergency declaration if declared by the Minister for Home Affairs",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition of 'emergency declaration'",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is defined as",
      "cml:premiseText": "emergency declaration means a declaration under section 80J or 80K"
    },
