    cml:operator "Recognizes" ;
    cml:logicSummary "Identifies the State as a legal entity with obligations under Part operation in relation to trade or commerce" ;
    cml:premiseText "(3) This Part also has the effect..." ;
    cml:conclusionText "...in relation to trade or commerce:" ;
