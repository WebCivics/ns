    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80p-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "80P(6) Authorisation of collection, use and disclosure of personal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80p-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf"
      },
      "dc:source": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf, p.10",
      "values:originalText": "(6) A collection, use or disclose of personal information by an officer\nor employee of an agency in the course of duty as an officer or\nemployee is authorised by subsection (1) only if the officer or\nemployee is authorised by the agency to collect, use or disclose the\npersonal information.",
      "skos:definition": "(6) A collection, use or disclose of personal information by an officer\nor employee of an agency in the course of duty as an officer or\nemployee is authorised by subsection (1) only if the officer or\nemployee is authorised by the agency to collect, use or disclose the\npersonal information.",
      "values:partOf": {
        "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80p"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80p-ss-6-norm"
        },
        {
          "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80p-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b18e9992134b42d55422626dcf584b063424614ee184806e64d54b2dd610ea39",
      "skos:note": "Authorized collection, use and disclosure of personal information by agency officers or employees."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80p-ss-6",
      "@type": "cof:Section",
      "cof:title": "80P(6) Authorisation of collection, use and disclosure of personal",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(6) A collection, use or disclose of personal information by an officer\nor employee of an agency in the course of duty as an officer or\nemployee is authorised by subsection (1) only if the officer or\nemployee is authorised by the agency to collect, use or disclose the\npersonal information."
    },
    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80p-ss-6-norm",
