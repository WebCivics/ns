          "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80p-ss-7-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80p-ss-7-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "0b2878d7f6462f1347d98521e7629e6c1e10e2e3142430a35b0d67feba840473",
      "skos:note": "Definition of designated secrecy provision and entity."
    },
    {
