      "dc:source": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nPrivacy Act 1988  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nPrivacy Act 1988  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sec-3-norm"
        }
      ],
      "cml:integrityHash": "6f159225d3593548356ef327dcfd6b1e62a8829cc1c4e93cb4a6907525c2bfab",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sec-3",
