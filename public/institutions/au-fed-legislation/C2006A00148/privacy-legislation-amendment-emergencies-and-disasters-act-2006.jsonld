    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80f",
      "@type": "cml:Concept",
      "skos:prefLabel": "80F Object",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf"
      },
      "dc:source": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf, p.7",
      "values:originalText": "The object of this Part is to make special provision for the\ncollection, use and disclosure of personal information in\nemergencies and disasters.",
      "skos:definition": "The object of this Part is to make special provision for the\ncollection, use and disclosure of personal information in\nemergencies and disasters.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80f-norm"
        }
      ],
      "cml:integrityHash": "76c11b8407aac16c57ef6cfb401cbeffb479a12fda21481b920180a49f302702",
      "skos:note": "Special provision for personal information collection, use and disclosure in emergencies and disasters."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80f",
      "@type": "cof:Section",
      "cof:title": "80F Object",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "The object of this Part is to make special provision for the\ncollection, use and disclosure of personal information in\nemergencies and disasters."
    },
    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80f-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80f"
