    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80r",
      "@type": "cml:Concept",
      "skos:prefLabel": "80R Operation of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80r"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf"
      },
      "dc:source": "privacy-legislation-amendment-emergencies-and-disasters-act-2006.pdf, p.13",
      "values:originalText": "(1) The operation of this Part is not limited by a secrecy provision of\nany other law of the Commonwealth (whether made before or after\nthe commencement of this Act) except to the extent that the\nsecrecy provision expressly excludes the operation of this section.\nNote:\nSection 3 provides for the concurrent operation of State and Territory\nlaws.\n\n(2) Nothing in this Part is to be taken to require an entity to collect, use\nor disclose personal information.\n\nSchedule 1  Privacy Act 1988",
      "skos:definition": "(1) The operation of this Part is not limited by a secrecy provision of\nany other law of the Commonwealth (whether made before or after\nthe commencement of this Act) except to the extent that the\nsecrecy provision expressly excludes the operation of this section.\nNote:\nSection 3 provides for the concurrent operation of State and Territory\nlaws.\n\n(2) Nothing in this Part is to be taken to require an entity to collect, use\nor disclose personal information.\n\nSchedule 1  Privacy Act 1988",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80r-ss-1"
        },
        {
