    },
    {
      "@id": "concept:privacy-legislation-amendment-emergencies-and-disasters-act-2006-sch-1-sec-80g-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "80G(2) Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80g-ss-2"
      },
      "cml:curationStatus": {
