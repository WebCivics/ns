      "cml:integrityHash": "eac3fdcd7b10ecfda8c5c2f64d8277d4dc1eb7b7085417a347948c94305b3951",
      "skos:note": "No entity is required to collect, use or disclose personal information."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80r-ss-2",
      "@type": "cof:Section",
      "cof:title": "80R(2) Operation of Part",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(2) Nothing in this Part is to be taken to require an entity to collect, use\nor disclose personal information.\n\nSchedule 1  Privacy Act 1988"
    },
