        }
      ],
      "cml:integrityHash": "24fda42d3875bcca2745364554d7513d209c02071acc0d21bbbd6874a4eb8545",
      "skos:note": "Minister must consult other minister before making a declaration under this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80k-ss-2",
      "@type": "cof:Section",
      "cof:title": "80K(2) Declaration of emergency—events outside Australia",
      "values:kind": "subsection",
      "cof:pageNumber": 9,
      "values:originalText": "(2) The Minister must consult the Minister administering the\nDiplomatic Privileges and Immunities Act 1967 before the Minister\nmakes a declaration under this section.\nNote:\nA declaration under this section is merely a trigger for the operation of\nthis Part and is not directly related to any other legislative or\nnon-legislative scheme about emergencies.\n\nSchedule 1  Privacy Act 1988"
    },
