    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-emergencies-and-disasters-act-2006#sch-1-sec-80t-ss-3",
      "@type": "cof:Section",
      "cof:title": "80T(3) Compensation for acquisition of property—constitutional safety",
      "values:kind": "subsection",
      "cof:pageNumber": 15,
      "values:originalText": "(3) In this section:\nacquisition of property has the same meaning as in paragraph\n51(xxxi) of the Constitution.\njust terms has the same meaning as in paragraph 51(xxxi) of the\nConstitution.\n\nSchedule 2  Australian Security Intelligence Organisation Act 1979"
    },
