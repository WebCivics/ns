        "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r-logic-deontic-4",
        "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "4f7a0f617eed6505107583d66b3a8fdd57326c272b50e432a99f7db3956cc4de",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-295r",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The act or omission breaches a condition of the authorisation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Condition breach is a necessary condition for the offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "breach",
      "cml:premiseText": "The person does an act or omits to do an act."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is subject to a penalty for breaching the condition.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Offence results in penalty.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "penalty",
      "cml:premiseText": "A person commits an offence if the act or omission breaches a condition of the authorisation."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The authorisation is a necessary condition for the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorisation is a necessary condition for the offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "authorisation",
      "cml:premiseText": "A person commits an offence if the person does an act or omits to do an act and the act or omission breaches a condition of the authorisation."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is subject to an offence for breaching the condition.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Offence is a consequence of breaching the condition.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "offence",
      "cml:premiseText": "A person commits an offence if the act or omission breaches a condition of the authorisation."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The penalty for the offence is 60 penalty units.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Penalty unit is a measure of penalty.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "penaltyUnit",
      "cml:premiseText": "A person commits an offence if the act or omission breaches a condition of the authorisation."
    },
