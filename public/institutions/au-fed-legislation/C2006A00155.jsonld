    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.15",
      "skos:note": "Breach of authorisation condition results in an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "295R Offence of breaching a condition"
      },
      "wasDerivedFrom": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf",
      "asserts": [
        "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295r-norm",
