concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295g a cml:Concept ;
    skos:prefLabel "295G Varying or revoking authorisations"@en ;
    cml:realizedBy doc:sch-1-sec-295g ;
    values:originalText "The scheme may make provision for the variation or revocation of authorisations. For example, the variation may be the imposition of new conditions or the variation or removal of existing conditions." ;
    skos:definition "The scheme may make provision for the variation or revocation of authorisations. For example, the variation may be the imposition of new conditions or the variation or removal of existing conditions."@en ;
