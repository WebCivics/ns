concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a a cml:Concept ;
    skos:prefLabel "299A Integrated public number database"@en ;
    cml:realizedBy doc:sch-1-sec-299a ;
    values:originalText "Public number directory  (1) If:  (a) information or a document is disclosed to a person as permitted by subsection 285(1A); and  (b) the disclosure is for a purpose covered by subparagraph 285(1A)(c)(ii); then:  (c) during the period the person holds an authorisation in force under the integrated public number database scheme in relation to the information or document—the person must not  Amendments  Schedule 1" ;
    skos:definition "Public number directory  (1) If:  (a) information or a document is disclosed to a person as permitted by subsection 285(1A); and  (b) the disclosure is for a purpose covered by subparagraph 285(1A)(c)(ii); then:  (c) during the period the person holds an authorisation in force under the integrated public number database scheme in relation to the information or document—the person must not  Amendments  Schedule 1"@en ;
    cml:integrityHash "e747f5207e2d8a22d9cd20554bafa8227fdee5f2f536aeb67fc790af7fab726f" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Must not disclose information or document during the period holding an authorisation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-amendment-integrated-public-number-database-act-2006.pdf> ;
    dc:source "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.16" ;
    cml:asserts concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-norm .
