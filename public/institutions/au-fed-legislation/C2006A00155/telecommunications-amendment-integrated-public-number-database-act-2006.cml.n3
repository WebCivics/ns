doc:sch-1-sec-8-ss-3 a cof:Section ;
    cof:title "8(3) At the end of section 285" ;
    values:kind "subsection" ;
    values:originalText "(3) The Minister may, by legislative instrument, specify kinds of research for the purposes of subparagraph (1A)(c)(iv). The Minister must not specify a kind of research unless the Minister is satisfied that the kind of research is in the public interest. Additional information in public number directory" ;
    cof:pageNumber "10"^^xsd:integer .

