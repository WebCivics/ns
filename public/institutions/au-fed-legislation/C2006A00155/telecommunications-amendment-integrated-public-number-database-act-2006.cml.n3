concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295d a cml:Concept ;
    skos:prefLabel "295D Scope of authorisations"@en ;
    cml:realizedBy doc:sch-1-sec-295d ;
    values:originalText "The scheme may make provision for authorisations to be in respect of:  (a) all information or documents that satisfy the matters referred to in paragraphs 285(1A)(a) and (b); or  (b) specified information or specified documents that satisfy those matters." ;
    skos:definition "The scheme may make provision for authorisations to be in respect of:  (a) all information or documents that satisfy the matters referred to in paragraphs 285(1A)(a) and (b); or  (b) specified information or specified documents that satisfy those matters."@en ;
