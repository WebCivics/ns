concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295f a cml:Concept ;
    skos:prefLabel "295F Conditions"@en ;
    cml:realizedBy doc:sch-1-sec-295f ;
    values:originalText "The scheme may make provision for the imposition of conditions on the grant of authorisations. Note 1: Section 295P also allows the Minister to determine that authorisations are granted subject to conditions. Note 2: Section 295R creates an offence for breaching a condition of an authorisation." ;
    skos:definition "The scheme may make provision for the imposition of conditions on the grant of authorisations. Note 1: Section 295P also allows the Minister to determine that authorisations are granted subject to conditions. Note 2: Section 295R creates an offence for breaching a condition of an authorisation."@en ;
    cml:integrityHash "33ecff21ef44475b4cce7d96335ecb94b3447d25bb1288e7d33a168ed31b3b3e" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Conditions for authorisation grant" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
