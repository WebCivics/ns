    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295t",
      "@type": "cml:Concept",
      "skos:prefLabel": "295T Formal warnings for breaching a condition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-295t"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.15",
      "values:originalText": "The ACMA may issue a formal warning if the ACMA is satisfied\nthat a person has contravened, or is contravening, a condition of an\nauthorisation in force under the integrated public number database\nscheme.\n\nSchedule 1  Amendments",
      "skos:definition": "The ACMA may issue a formal warning if the ACMA is satisfied\nthat a person has contravened, or is contravening, a condition of an\nauthorisation in force under the integrated public number database\nscheme.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295t-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295t-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "38c68bde0dab70a76e35e39168d8b31476eba31580dda28327aba58f87a915a7",
      "skos:note": "Issue formal warning for breaching a condition"
    },
