      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.6",
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if any of the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day on which this Act\nreceives the Royal Assent, they commence\non the first day after the end of that period.",
      "skos:definition": "A single day to be fixed by Proclamation.\nHowever, if any of the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day on which this Act\nreceives the Royal Assent, they commence\non the first day after the end of that period.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sec-2-2-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sec-2-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "05723b99f61c730dc290e9137195db47bb87652c5e033f920741917537092fd6",
      "skos:note": "Commencement provision for provisions not commenced within 6 months"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if any of the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day on which this Act\nreceives the Royal Assent, they commence\non the first day after the end of that period."
    },
