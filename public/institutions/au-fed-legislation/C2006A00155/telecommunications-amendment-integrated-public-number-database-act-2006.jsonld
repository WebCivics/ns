    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 After paragraph 1(m) of Schedule 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-11"
