    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295g",
      "@type": "cml:Concept",
      "skos:prefLabel": "295G Varying or revoking authorisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-295g"
      },
      "cml:curationStatus": {
