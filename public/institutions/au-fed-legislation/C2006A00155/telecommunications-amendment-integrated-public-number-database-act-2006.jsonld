    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sec-2-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sec-2-2"
      },
