    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295h",
      "@type": "cml:Concept",
      "skos:prefLabel": "295H Scheme may confer administrative powers on the ACMA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-295h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
