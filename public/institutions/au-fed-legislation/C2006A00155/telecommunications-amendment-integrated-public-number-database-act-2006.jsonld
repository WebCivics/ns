      "@type": "cof:Section",
      "cof:title": "295G Varying or revoking authorisations",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "The scheme may make provision for the variation or revocation of\nauthorisations. For example, the variation may be the imposition of\nnew conditions or the variation or removal of existing conditions."
    },
