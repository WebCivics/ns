    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295a",
      "@type": "cml:Concept",
      "skos:prefLabel": "295A ACMA to make integrated public number database scheme",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-295a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.11",
      "values:originalText": "The ACMA must, by legislative instrument, make a scheme (the\nintegrated public number database scheme) for the granting of\nauthorisations for the purposes of paragraph 285(1A)(d).\nNote 1:\nThe ACMA may make determinations fixing charges for any matter in\nrelation to which expenses are incurred by the ACMA under the\nscheme: see section 60 of the Australian Communications and Media\nAuthority Act 2005.\nNote 2:\nVarious decisions under the scheme are reviewable: see section 555\nand paragraphs 1(ma) to (md) of Schedule 4.",
      "skos:definition": "The ACMA must, by legislative instrument, make a scheme (the\nintegrated public number database scheme) for the granting of\nauthorisations for the purposes of paragraph 285(1A)(d).\nNote 1:\nThe ACMA may make determinations fixing charges for any matter in\nrelation to which expenses are incurred by the ACMA under the\nscheme: see section 60 of the Australian Communications and Media\nAuthority Act 2005.\nNote 2:\nVarious decisions under the scheme are reviewable: see section 555\nand paragraphs 1(ma) to (md) of Schedule 4.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295a-norm"
        }
      ],
      "cml:integrityHash": "0fa3859277ffc78f226da000e1ed992ac4f4a1bf8e1dd21ff91c8af52ebfda3b",
      "skos:note": "ACMA must make integrated public number database scheme"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-295a",
      "@type": "cof:Section",
      "cof:title": "295A ACMA to make integrated public number database scheme",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "The ACMA must, by legislative instrument, make a scheme (the\nintegrated public number database scheme) for the granting of\nauthorisations for the purposes of paragraph 285(1A)(d).\nNote 1:\nThe ACMA may make determinations fixing charges for any matter in\nrelation to which expenses are incurred by the ACMA under the\nscheme: see section 60 of the Australian Communications and Media\nAuthority Act 2005.\nNote 2:\nVarious decisions under the scheme are reviewable: see section 555\nand paragraphs 1(ma) to (md) of Schedule 4."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295a-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
