      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.17",
      "values:originalText": "Insert:\n\n(ma) a decision under the integrated public number database\nscheme to refuse to grant a person an authorisation;\n\n(mb) a decision under the integrated public number database\nscheme to impose conditions on the grant of an authorisation;\n\n(mc) a decision under the integrated public number database\nscheme to vary or revoke an authorisation;\n\n(md) a decision under the integrated public number database\nscheme specified in an instrument under section 295Q;",
      "skos:definition": "Insert:\n\n(ma) a decision under the integrated public number database\nscheme to refuse to grant a person an authorisation;\n\n(mb) a decision under the integrated public number database\nscheme to impose conditions on the grant of an authorisation;\n\n(mc) a decision under the integrated public number database\nscheme to vary or revoke an authorisation;\n\n(md) a decision under the integrated public number database\nscheme specified in an instrument under section 295Q;",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-11-norm"
        }
      ],
      "cml:integrityHash": "0bf16e82e4af571b806309313f0bb88c4bf82081cee12d8c724f35d7845d8494",
      "skos:note": "Inserts provisions for decision-making under the integrated public number database scheme."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 After paragraph 1(m) of Schedule 4",
      "values:kind": "section",
