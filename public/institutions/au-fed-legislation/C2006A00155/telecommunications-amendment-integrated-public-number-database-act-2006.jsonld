      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.12",
      "values:originalText": "The scheme may make provision for the imposition of conditions\non the grant of authorisations.\nNote 1:\nSection 295P also allows the Minister to determine that authorisations\nare granted subject to conditions.\nNote 2:\nSection 295R creates an offence for breaching a condition of an\nauthorisation.",
      "skos:definition": "The scheme may make provision for the imposition of conditions\non the grant of authorisations.\nNote 1:\nSection 295P also allows the Minister to determine that authorisations\nare granted subject to conditions.\nNote 2:\nSection 295R creates an offence for breaching a condition of an\nauthorisation.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295f-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295f-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "33ecff21ef44475b4cce7d96335ecb94b3447d25bb1288e7d33a168ed31b3b3e",
      "skos:note": "Conditions for authorisation grant"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-295f",
      "@type": "cof:Section",
      "cof:title": "295F Conditions",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "The scheme may make provision for the imposition of conditions\non the grant of authorisations.\nNote 1:\nSection 295P also allows the Minister to determine that authorisations\nare granted subject to conditions.\nNote 2:\nSection 295R creates an offence for breaching a condition of an\nauthorisation."
    },
