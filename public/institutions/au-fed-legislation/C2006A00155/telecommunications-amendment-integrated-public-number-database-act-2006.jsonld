      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.8",
      "values:originalText": "Insert:\nbusiness includes a venture or concern in trade or commerce,\nwhether or not conducted on a regular, repetitive or continuous\nbasis.\nNote:\nThe following heading to subsection 285(2) is inserted “Definitions”.\n\nAmendments  Schedule 1\n\n2006            5",
