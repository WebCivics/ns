      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.12",
      "values:originalText": "The scheme may make provision for the variation or revocation of\nauthorisations. For example, the variation may be the imposition of\nnew conditions or the variation or removal of existing conditions.",
      "skos:definition": "The scheme may make provision for the variation or revocation of\nauthorisations. For example, the variation may be the imposition of\nnew conditions or the variation or removal of existing conditions.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-295g-norm"
        }
      ],
      "cml:integrityHash": "4b6c8e726a4af40d02bd32d5869b33d2a2fa24d8dc4a0d55528f51b205ee6282",
      "skos:note": "Provision for varying or revoking authorisations"
    },
    {
