    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a",
      "@type": "cml:Concept",
      "skos:prefLabel": "299A Integrated public number database",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-299a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2006.pdf, p.16",
      "values:originalText": "Public number directory\n\n(1) If:\n\n(a) information or a document is disclosed to a person as\npermitted by subsection 285(1A); and\n\n(b) the disclosure is for a purpose covered by subparagraph\n285(1A)(c)(ii);\nthen:\n\n(c) during the period the person holds an authorisation in force\nunder the integrated public number database scheme in\nrelation to the information or document—the person must not\n\nAmendments  Schedule 1",
      "skos:definition": "Public number directory\n\n(1) If:\n\n(a) information or a document is disclosed to a person as\npermitted by subsection 285(1A); and\n\n(b) the disclosure is for a purpose covered by subparagraph\n285(1A)(c)(ii);\nthen:\n\n(c) during the period the person holds an authorisation in force\nunder the integrated public number database scheme in\nrelation to the information or document—the person must not\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-logic-diffusion-4"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "e747f5207e2d8a22d9cd20554bafa8227fdee5f2f536aeb67fc790af7fab726f",
      "skos:note": "Must not disclose information or document during the period holding an authorisation."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2006#sch-1-sec-299a",
      "@type": "cof:Section",
      "cof:title": "299A Integrated public number database",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Public number directory\n\n(1) If:\n\n(a) information or a document is disclosed to a person as\npermitted by subsection 285(1A); and\n\n(b) the disclosure is for a purpose covered by subparagraph\n285(1A)(c)(ii);\nthen:\n\n(c) during the period the person holds an authorisation in force\nunder the integrated public number database scheme in\nrelation to the information or document—the person must not\n\nAmendments  Schedule 1"
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustNot",
      "cml:logicSummary": "Prohibition",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Disclosure is for a purpose covered by subparagraph 285(1A)(c)(ii);",
      "cml:conclusionText": "The person must not disclose the information or document."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2006-sch-1-sec-299a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
