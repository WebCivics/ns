      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval: The period the person holds an authorisation in force under the integrated public number database scheme.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "During the period the person holds an authorisation in force under the integrated public number database scheme in relation to the information or document—the person must not disclose the information or document;",
      "cml:conclusionText": "The person must not disclose the information or document during this temporal interval."
    },
