    {
      "@id": "concept:crimes-amendment-bail-and-sentencing-act-2006-sch-1-sec-5h",
      "@type": "cml:Concept",
      "skos:prefLabel": "5H At the end of section 23WO",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-bail-and-sentencing-act-2006#sch-1-sec-5h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
