    {
      "@id": "concept:crimes-amendment-bail-and-sentencing-act-2006-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 After subsection 16A(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-bail-and-sentencing-act-2006#sch-1-sec-5"
      },
      "cml:curationStatus": {
