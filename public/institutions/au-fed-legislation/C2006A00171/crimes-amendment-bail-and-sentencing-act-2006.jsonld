      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-bail-and-sentencing-act-2006.pdf"
      },
      "dc:source": "crimes-amendment-bail-and-sentencing-act-2006.pdf, p.10",
      "values:originalText": "Add:\n\n(4) Without limiting the matters that the senior constable may take into\naccount in considering, for the purposes of paragraph (3)(e), the\nintrusiveness of the forensic procedure, the senior constable must\n(where appropriate) take into account the religious beliefs of the\nsuspect.",
      "skos:definition": "Add:\n\n(4) Without limiting the matters that the senior constable may take into\naccount in considering, for the purposes of paragraph (3)(e), the\nintrusiveness of the forensic procedure, the senior constable must\n(where appropriate) take into account the religious beliefs of the\nsuspect.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-bail-and-sentencing-act-2006-sch-1-sec-5h-norm"
        },
        {
          "@id": "concept:crimes-amendment-bail-and-sentencing-act-2006-sch-1-sec-5h-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-amendment-bail-and-sentencing-act-2006-sch-1-sec-5h-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-amendment-bail-and-sentencing-act-2006-sch-1-sec-5h-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-amendment-bail-and-sentencing-act-2006-sch-1-sec-5h-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-amendment-bail-and-sentencing-act-2006-sch-1-sec-5h-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "2c7f7de9f73606e2080a7f861036e13c02b38a0e25738cdb568da0a81a9a71b1",
      "skos:note": "Senior constable must consider suspect's religious beliefs when determining intrusiveness of forensic procedure."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-bail-and-sentencing-act-2006#sch-1-sec-5h",
      "@type": "cof:Section",
      "cof:title": "5H At the end of section 23WO",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Add:\n\n(4) Without limiting the matters that the senior constable may take into\naccount in considering, for the purposes of paragraph (3)(e), the\nintrusiveness of the forensic procedure, the senior constable must\n(where appropriate) take into account the religious beliefs of the\nsuspect."
    },
