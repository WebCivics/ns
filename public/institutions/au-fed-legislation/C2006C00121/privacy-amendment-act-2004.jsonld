      "dc:source": "privacy-amendment-act-2004.pdf, p.6",
      "values:originalText": "Insert:\n\n(1A) Paragraph (1)(a) does not apply in relation to National Privacy\nPrinciple 9.\nNote:\nBecause of subsection (1A), the extra-territorial application of\nNational Privacy Principle 9 is not limited by the citizenship etc.\nrequirement of paragraph (1)(a).",
      "skos:definition": "Insert:\n\n(1A) Paragraph (1)(a) does not apply in relation to National Privacy\nPrinciple 9.\nNote:\nBecause of subsection (1A), the extra-territorial application of\nNational Privacy Principle 9 is not limited by the citizenship etc.\nrequirement of paragraph (1)(a).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-act-2004-sch-1-sec-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-act-2004-sch-1-sec-2-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-act-2004-sch-1-sec-2-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "e91bce9605e710335a583077fcb6bf62eed7f2360a925cb0057d80440e31b560",
      "skos:note": "National Privacy Principle 9 is not limited by the citizenship requirement."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-act-2004#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 After subsection 5B(1)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Insert:\n\n(1A) Paragraph (1)(a) does not apply in relation to National Privacy\nPrinciple 9.\nNote:\nBecause of subsection (1A), the extra-territorial application of\nNational Privacy Principle 9 is not limited by the citizenship etc.\nrequirement of paragraph (1)(a)."
    },
