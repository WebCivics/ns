        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An approved privacy code covers exempt acts or practices, and the Act applies in relation to the code as if those acts or practices were not exempt.",
      "cml:conclusionText": "The approved privacy code is during the application of the Act."
    },
    {
      "@id": "concept:privacy-amendment-act-2004-sch-1-sec-6-ss-2-logic-ltl-3",
