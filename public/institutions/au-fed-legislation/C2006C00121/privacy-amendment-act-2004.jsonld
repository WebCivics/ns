      "dc:source": "privacy-amendment-act-2004.pdf, p.6",
      "values:originalText": "Omit “the act”, substitute “subject to subsection (1A), the act”.",
      "skos:definition": "Omit “the act”, substitute “subject to subsection (1A), the act”.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-act-2004-sch-1-sec-1-norm"
        }
      ],
      "cml:integrityHash": "1961a2164320e1eedab066ebb7e61876cd2ce6f57044f8718e5e145c59456355",
      "skos:note": "Omit 'the act' and substitute with 'subject to subsection (1A), the act'."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-act-2004#sch-1-sec-1",
