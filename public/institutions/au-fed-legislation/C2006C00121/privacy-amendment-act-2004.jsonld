    {
      "@id": "concept:privacy-amendment-act-2004-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 After subsection 5B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-act-2004#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-act-2004.pdf"
