      "dc:source": "privacy-amendment-act-2004.pdf, p.6",
      "values:originalText": "The amendments made by items 1 and 2 apply to acts done, or practices\nengaged in, after the commencement of this Part.\n\nAmendment of the Privacy Act 1988  Schedule 1\nExtension of correction rights to non-Australians  Part 2\n\nPrivacy Amendment Act 2004                 3",
      "skos:definition": "The amendments made by items 1 and 2 apply to acts done, or practices\nengaged in, after the commencement of this Part.\n\nAmendment of the Privacy Act 1988  Schedule 1\nExtension of correction rights to non-Australians  Part 2\n\nPrivacy Amendment Act 2004                 3",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-act-2004-sch-1-sec-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-act-2004-sch-1-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7cc6eb052b5aea7f77f6a8a97d6ef4d0bd16f699ff34a964dbfead2a0f1f9aac",
      "skos:note": "Amendments apply to acts done after commencement of Part."
    },
    {
