    {
      "@id": "concept:privacy-amendment-act-2004-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-act-2004#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-act-2004.pdf"
      },
      "dc:source": "privacy-amendment-act-2004.pdf, p.5",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendment of the Privacy Act 1988",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendment of the Privacy Act 1988",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-act-2004-sec-3-norm"
        }
      ],
      "cml:integrityHash": "f9f81994e0f126fe6bb3c6ca4661bdcebd868f32c574f0042c85a668a3a9cd83",
      "skos:note": "Schedules for amendment or repeal of specified Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-act-2004#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendment of the Privacy Act 1988"
    },
