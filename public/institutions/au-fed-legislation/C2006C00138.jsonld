      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The order is represented as a legal obligation in the knowledge base.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
