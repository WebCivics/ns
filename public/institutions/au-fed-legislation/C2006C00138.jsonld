    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-2-ss-3a-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must attend the police station at a specified time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relationship between the order and the action.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "(3A) The judge or magistrate may also make any other orders that are reasonably necessary..."
    },
    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-2-ss-3a-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must attend the police station at a specified time if ordered to do so.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of the order on the person's actions.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(3A) The judge or magistrate may also make any other orders that are reasonably necessary..."
    },
