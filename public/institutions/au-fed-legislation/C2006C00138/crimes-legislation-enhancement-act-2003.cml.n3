concept:crimes-legislation-enhancement-act-2003-sch-2-sec-14 a cml:Concept ;
    skos:prefLabel "14 Crimes Legislation Enhancement Act 2003"@en ;
    cml:realizedBy doc:sch-2-sec-14 ;
    values:originalText "(2A) Where an authorised person causes a person to be taken into custody on board an aircraft that is engaged in a flight that ends in a foreign country, the authorised person must cause the person:  (a) to be delivered into the custody of a member, however described, of a police force of that foreign country; and  (b) to be held in custody until the person can be so delivered. Crimes Legislation Amendment Act (No. 2) 1989" ;
    skos:definition "(2A) Where an authorised person causes a person to be taken into custody on board an aircraft that is engaged in a flight that ends in a foreign country, the authorised person must cause the person:  (a) to be delivered into the custody of a member, however described, of a police force of that foreign country; and  (b) to be held in custody until the person can be so delivered. Crimes Legislation Amendment Act (No. 2) 1989"@en ;
    cml:integrityHash "8bd8e99b0dd8efa9788c2ec1c0bed5dabcf903fe0b03c583416324c906469897" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Must deliver person to foreign police custody and hold in custody until delivered." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-enhancement-act-2003.pdf> ;
    dc:source "crimes-legislation-enhancement-act-2003.pdf, p.18" ;
    cml:asserts concept:crimes-legislation-enhancement-act-2003-sch-2-sec-14-norm .
concept:crimes-legislation-enhancement-act-2003-sch-2-sec-14-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-legislation-enhancement-act-2003-sch-2-sec-14 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
