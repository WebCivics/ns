    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Crimes Legislation Enhancement Act 2003",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-enhancement-act-2003.pdf"
      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.12",
      "values:originalText": "However, the court may not impose a pecuniary penalty greater\nthan the penalty that could have been imposed if the offence had\nbeen prosecuted on indictment.\n\n(3) This section has effect subject to any contrary intention indicated\nby the law creating the offence.\n\n(4) Without limiting subsection (3), this section does not apply to an\nindictable offence:\n\n(a) created by a law that provides that the offence may be heard\nand determined by a court of summary jurisdiction; or\n\n(b) described in subsection 4J(4) (about offences relating to\nproperty valued at $5,000 or less).",
      "skos:definition": "However, the court may not impose a pecuniary penalty greater\nthan the penalty that could have been imposed if the offence had\nbeen prosecuted on indictment.\n\n(3) This section has effect subject to any contrary intention indicated\nby the law creating the offence.\n\n(4) Without limiting subsection (3), this section does not apply to an\nindictable offence:\n\n(a) created by a law that provides that the offence may be heard\nand determined by a court of summary jurisdiction; or\n\n(b) described in subsection 4J(4) (about offences relating to\nproperty valued at $5,000 or less).",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-8-ss-3"
        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-8-ss-4"
        }
      ],
      "cml:integrityHash": "42c282aec8bb93052561ccaa8ac99d8c045b09067519a906a4449eed31c6109a"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Crimes Legislation Enhancement Act 2003",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "However, the court may not impose a pecuniary penalty greater\nthan the penalty that could have been imposed if the offence had\nbeen prosecuted on indictment.\n\n(3) This section has effect subject to any contrary intention indicated\nby the law creating the offence.\n\n(4) Without limiting subsection (3), this section does not apply to an\nindictable offence:\n\n(a) created by a law that provides that the offence may be heard\nand determined by a court of summary jurisdiction; or\n\n(b) described in subsection 4J(4) (about offences relating to\nproperty valued at $5,000 or less)."
    },
