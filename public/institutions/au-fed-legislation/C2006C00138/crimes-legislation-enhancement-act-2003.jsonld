        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-7b-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "7266d71271c673f21301d88f73fa5bbb2706f69b5bc58136d78b4ec63a27236b",
      "skos:note": "Repeal definition, substitute corresponding law means a law that relates to forensic procedures and DNA databases."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-1-sec-7b",
      "@type": "cof:Section",
      "cof:title": "7B Section 23YUA (definition of corresponding law)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the definition, substitute:\ncorresponding law means a law that:\n\n(a) relates to the carrying out of forensic procedures and DNA\ndatabases; and\n\n(b) either:\n\n(i) substantially corresponds to this Part; or\n\n(ii) is prescribed by the regulations for the purposes of this\ndefinition."
    },
