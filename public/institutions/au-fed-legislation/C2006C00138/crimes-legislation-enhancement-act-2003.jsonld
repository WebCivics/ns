    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sec-3-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sec-3-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-enhancement-act-2003.pdf"
      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.8",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Crimes Act 1914  Schedule 1\nTaking offenders’ fingerprints and photographs  Part 1\n\nCrimes Legislation Enhancement Act 2003                 5",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Crimes Act 1914  Schedule 1\nTaking offenders’ fingerprints and photographs  Part 1\n\nCrimes Legislation Enhancement Act 2003                 5",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sec-3-13-norm"
        }
      ],
      "cml:integrityHash": "e6c0443833a1d8cb1894b18590eb73ece628c929320953c1b7f3056a7b882d52",
      "skos:note": "Amendment of Schedule 1 in the Crimes Act 1914"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sec-3-13",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Crimes Act 1914  Schedule 1\nTaking offenders’ fingerprints and photographs  Part 1\n\nCrimes Legislation Enhancement Act 2003                 5"
    },
