    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Crimes Legislation Enhancement Act 2003",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-2-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-enhancement-act-2003.pdf"
      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.18",
      "values:originalText": "(2A) Where an authorised person causes a person to be taken into\ncustody on board an aircraft that is engaged in a flight that ends in\na foreign country, the authorised person must cause the person:\n\n(a) to be delivered into the custody of a member, however\ndescribed, of a police force of that foreign country; and\n\n(b) to be held in custody until the person can be so delivered.\nCrimes Legislation Amendment Act (No. 2) 1989",
      "skos:definition": "(2A) Where an authorised person causes a person to be taken into\ncustody on board an aircraft that is engaged in a flight that ends in\na foreign country, the authorised person must cause the person:\n\n(a) to be delivered into the custody of a member, however\ndescribed, of a police force of that foreign country; and\n\n(b) to be held in custody until the person can be so delivered.\nCrimes Legislation Amendment Act (No. 2) 1989",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-14-norm"
        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8bd8e99b0dd8efa9788c2ec1c0bed5dabcf903fe0b03c583416324c906469897",
      "skos:note": "Must deliver person to foreign police custody and hold in custody until delivered."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-2-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Crimes Legislation Enhancement Act 2003",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "(2A) Where an authorised person causes a person to be taken into\ncustody on board an aircraft that is engaged in a flight that ends in\na foreign country, the authorised person must cause the person:\n\n(a) to be delivered into the custody of a member, however\ndescribed, of a police force of that foreign country; and\n\n(b) to be held in custody until the person can be so delivered.\nCrimes Legislation Amendment Act (No. 2) 1989"
    },
