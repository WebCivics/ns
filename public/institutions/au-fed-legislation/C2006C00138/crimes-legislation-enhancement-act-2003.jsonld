      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.20",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) The testimony must purport to be signed or certified by a judge,\nmagistrate or officer in or of the foreign country to which the\nrequest was made.\nInternational War Crimes Tribunals Act 1995",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) The testimony must purport to be signed or certified by a judge,\nmagistrate or officer in or of the foreign country to which the\nrequest was made.\nInternational War Crimes Tribunals Act 1995",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-7-norm"
        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-7-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-7-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "49e23f927c76ac88af98015fdfe1995b3d418b8864bad4faaa57b067e69fcab0",
      "skos:note": "Repeal subsection and substitute with new provision requiring testimony to be signed or certified by a judge, magistrate, or officer in the foreign country."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-2-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Subsection 22(2)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) The testimony must purport to be signed or certified by a judge,\nmagistrate or officer in or of the foreign country to which the\nrequest was made.\nInternational War Crimes Tribunals Act 1995"
    },
