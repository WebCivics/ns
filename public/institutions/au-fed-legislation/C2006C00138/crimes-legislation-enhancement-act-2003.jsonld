    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-2-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-enhancement-act-2003.pdf"
      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.21",
      "values:originalText": "The amendment made by item 12 applies in relation to the escape of a\nperson after the commencement of this item, whether or not the person\nwas in custody from before that commencement or was arrested before\nthat commencement.\nLaw and Justice Legislation Amendment Act (No. 2) 1994",
      "skos:definition": "The amendment made by item 12 applies in relation to the escape of a\nperson after the commencement of this item, whether or not the person\nwas in custody from before that commencement or was arrested before\nthat commencement.\nLaw and Justice Legislation Amendment Act (No. 2) 1994",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-13-norm"
        }
      ],
      "cml:integrityHash": "9da1fd90e33a8c1acd43ddb3b0a4f4aa5573855db7e4548f218010b718218932",
      "skos:note": "Amendment applies in relation to escape of a person after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-2-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Application",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "The amendment made by item 12 applies in relation to the escape of a\nperson after the commencement of this item, whether or not the person\nwas in custody from before that commencement or was arrested before\nthat commencement.\nLaw and Justice Legislation Amendment Act (No. 2) 1994"
    },
