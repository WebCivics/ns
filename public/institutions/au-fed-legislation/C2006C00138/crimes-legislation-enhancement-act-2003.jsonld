    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sec-23-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 July 1998",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sec-23-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-enhancement-act-2003.pdf"
      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.8",
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\npassed by the Parliament and assented to. It will not be expanded to\ndeal with provisions inserted in this Act after assent.\n\n(2) Column 3 of the table is for additional information that is not part\nof this Act. This information may be included in any published\nversion of this Act.\n\n(3) If a provision covered by item 11A of the table does not commence\nwithin the period of 6 months beginning on the day on which this\nAct receives the Royal Assent, it commences on the first day after\nthe end of that period.",
      "skos:definition": "Note:\nThis table relates only to the provisions of this Act as originally\npassed by the Parliament and assented to. It will not be expanded to\ndeal with provisions inserted in this Act after assent.\n\n(2) Column 3 of the table is for additional information that is not part\nof this Act. This information may be included in any published\nversion of this Act.\n\n(3) If a provision covered by item 11A of the table does not commence\nwithin the period of 6 months beginning on the day on which this\nAct receives the Royal Assent, it commences on the first day after\nthe end of that period.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sec-23-4-ss-2"
        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sec-23-4-ss-3"
        }
      ],
      "cml:integrityHash": "1557b7fb64ce666895f56386154841112fd674ea7757c86371dded382cf4abea"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sec-23-4",
      "@type": "cof:Section",
      "cof:title": "23 July 1998",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\npassed by the Parliament and assented to. It will not be expanded to\ndeal with provisions inserted in this Act after assent.\n\n(2) Column 3 of the table is for additional information that is not part\nof this Act. This information may be included in any published\nversion of this Act.\n\n(3) If a provision covered by item 11A of the table does not commence\nwithin the period of 6 months beginning on the day on which this\nAct receives the Royal Assent, it commences on the first day after\nthe end of that period."
    },
