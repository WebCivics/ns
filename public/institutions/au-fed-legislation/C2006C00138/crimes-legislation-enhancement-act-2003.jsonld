    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Subsection 22(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-2-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
