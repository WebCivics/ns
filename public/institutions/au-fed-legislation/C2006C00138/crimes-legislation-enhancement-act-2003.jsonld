      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.13",
      "values:originalText": "Repeal the definition.",
      "skos:definition": "Repeal the definition.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-7c-norm"
        }
      ],
      "cml:integrityHash": "b59404361671ad06ec8926108f9ea23ee505ede55250ca43258a4f35d6ac990f",
      "skos:note": "Repeal the definition of DNA database"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-1-sec-7c",
      "@type": "cof:Section",
      "cof:title": "7C Section 23YUA (definition of DNA database)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the definition."
    },
    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-7c-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-7c"
      },
