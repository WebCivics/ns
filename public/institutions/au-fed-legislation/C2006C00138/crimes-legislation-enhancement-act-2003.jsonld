    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-7b",
      "@type": "cml:Concept",
      "skos:prefLabel": "7B Section 23YUA (definition of corresponding law)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-1-sec-7b"
