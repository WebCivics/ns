      ],
      "cml:integrityHash": "eac1f031fe5df0d94ebeae6db12c565fde49a66621e10d3e1917101a904dccb2",
      "skos:note": "Court may hear and determine indictable offence under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-1-sec-4ja-ss-1",
      "@type": "cof:Section",
      "cof:title": "4JA(1) Some indictable offences punishable by fine only may be dealt",
      "values:kind": "subsection",
      "cof:pageNumber": 11,
      "values:originalText": "(1) A court of summary jurisdiction may hear and determine an\nindictable offence if:\n\n(a) the offence is not punishable by imprisonment; and\n\n(b) the pecuniary penalty for the offence is not more than 600\npenalty units for an individual or 3,000 penalty units for a\nbody corporate; and\n\n(c) the defendant and prosecution consent."
    },
