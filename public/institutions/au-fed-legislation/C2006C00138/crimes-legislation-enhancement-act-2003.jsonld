    {
      "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-20-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Crimes Legislation Enhancement Act 2003",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-2-sec-20-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-enhancement-act-2003.pdf"
      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.24",
      "values:originalText": "authority includes a body or person that:\n\n(a) under a law of a State, may issue a warrant for the arrest and\nreturn to custody or detention of a person, following the\nrevocation or cancellation of:\n\n(i) a parole order; or\n\n(ii) an order for conditional release; or\n\n(iii) an order for home detention; or\n\n(iv) an order for periodic detention; or\n\n(v) any other order for the release of a person from custody;\nor\n\n(vi) any other order of a kind prescribed by the regulations;\nand\n\n(b) is prescribed by the regulations.\ntribunal does not include a body or person of a kind referred to in\nthe definition of authority in this section.\nwarrant includes a warrant issued by a body or person that is an\nauthority for the purposes of this Part.\n\nTechnical corrections relating to Part numbering in the Crimes Act 1914  Schedule 3\nCorrections relating to Part 1AA of the Crimes Act 1914  Part 1\n\nCrimes Legislation Enhancement Act 2003                 21",
      "skos:definition": "authority includes a body or person that:\n\n(a) under a law of a State, may issue a warrant for the arrest and\nreturn to custody or detention of a person, following the\nrevocation or cancellation of:\n\n(i) a parole order; or\n\n(ii) an order for conditional release; or\n\n(iii) an order for home detention; or\n\n(iv) an order for periodic detention; or\n\n(v) any other order for the release of a person from custody;\nor\n\n(vi) any other order of a kind prescribed by the regulations;\nand\n\n(b) is prescribed by the regulations.\ntribunal does not include a body or person of a kind referred to in\nthe definition of authority in this section.\nwarrant includes a warrant issued by a body or person that is an\nauthority for the purposes of this Part.\n\nTechnical corrections relating to Part numbering in the Crimes Act 1914  Schedule 3\nCorrections relating to Part 1AA of the Crimes Act 1914  Part 1\n\nCrimes Legislation Enhancement Act 2003                 21",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-20-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-20-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-2-sec-20-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "2dd227c5481d73bfaa59a8eef9d8f12f916061339d78c078b6d3da8e7589b801",
      "skos:note": "Authority includes bodies or persons that may issue warrants for arrest and return to custody."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-2-sec-20-2",
      "@type": "cof:Section",
      "cof:title": "20 Crimes Legislation Enhancement Act 2003",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "authority includes a body or person that:\n\n(a) under a law of a State, may issue a warrant for the arrest and\nreturn to custody or detention of a person, following the\nrevocation or cancellation of:\n\n(i) a parole order; or\n\n(ii) an order for conditional release; or\n\n(iii) an order for home detention; or\n\n(iv) an order for periodic detention; or\n\n(v) any other order for the release of a person from custody;\nor\n\n(vi) any other order of a kind prescribed by the regulations;\nand\n\n(b) is prescribed by the regulations.\ntribunal does not include a body or person of a kind referred to in\nthe definition of authority in this section.\nwarrant includes a warrant issued by a body or person that is an\nauthority for the purposes of this Part.\n\nTechnical corrections relating to Part numbering in the Crimes Act 1914  Schedule 3\nCorrections relating to Part 1AA of the Crimes Act 1914  Part 1\n\nCrimes Legislation Enhancement Act 2003                 21"
    },
