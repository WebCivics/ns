      "skos:prefLabel": "3 Paragraph 3ZM(3)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-1-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-enhancement-act-2003.pdf"
      },
      "dc:source": "crimes-legislation-enhancement-act-2003.pdf, p.10",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) if he or she refuses to take part in the parade:\n\n(i) evidence of the refusal may be given in later\nproceedings relating to an offence, for the purpose of\nexplaining why an identification parade was not held;\nand\n\n(ii) evidence may be given in such proceedings of any\nidentification of the suspect by a witness as a result of\nhaving seen a photograph or having seen the suspect\notherwise than during an identification parade; and\n\nAmendment of the Crimes Act 1914  Schedule 1\nDealing summarily with some indictable offences  Part 3\n\nCrimes Legislation Enhancement Act 2003                 7",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) if he or she refuses to take part in the parade:\n\n(i) evidence of the refusal may be given in later\nproceedings relating to an offence, for the purpose of\nexplaining why an identification parade was not held;\nand\n\n(ii) evidence may be given in such proceedings of any\nidentification of the suspect by a witness as a result of\nhaving seen a photograph or having seen the suspect\notherwise than during an identification parade; and\n\nAmendment of the Crimes Act 1914  Schedule 1\nDealing summarily with some indictable offences  Part 3\n\nCrimes Legislation Enhancement Act 2003                 7",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-3-norm"
        },
        {
          "@id": "concept:crimes-legislation-enhancement-act-2003-sch-1-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5f8355782bbcf852af04af4b699613924a3242ff8f012482f6a5c23d6d5bfe70",
      "skos:note": "Refusal to participate in a parade cannot be used as evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-enhancement-act-2003#sch-1-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Paragraph 3ZM(3)(b)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) if he or she refuses to take part in the parade:\n\n(i) evidence of the refusal may be given in later\nproceedings relating to an offence, for the purpose of\nexplaining why an identification parade was not held;\nand\n\n(ii) evidence may be given in such proceedings of any\nidentification of the suspect by a witness as a result of\nhaving seen a photograph or having seen the suspect\notherwise than during an identification parade; and\n\nAmendment of the Crimes Act 1914  Schedule 1\nDealing summarily with some indictable offences  Part 3\n\nCrimes Legislation Enhancement Act 2003                 7"
    },
