concept:crimes-amendment-enforcement-of-fines-act-1998-sch-1-sec-2 a cml:Concept ;
    skos:prefLabel "2 Transitional provision"@en ;
    cml:realizedBy doc:sch-1-sec-2 ;
    values:originalText "An arrangement made under subsection 3B(1) of the Crimes Act 1914 before the commencement of this Act continues in force after that commencement as if the arrangement had been made under subsection 3B(1) of that Act as in force immediately after that commencement." ;
    skos:definition "An arrangement made under subsection 3B(1) of the Crimes Act 1914 before the commencement of this Act continues in force after that commencement as if the arrangement had been made under subsection 3B(1) of that Act as in force immediately after that commencement."@en ;
