concept:crimes-amendment-enforcement-of-fines-act-1998-sch-1-sec-8 a cml:Concept ;
    skos:prefLabel "8 Application"@en ;
    cml:realizedBy doc:sch-1-sec-8 ;
    values:originalText "The amendments of section 15A of the Crimes Act 1914 made by this Act apply in relation to a fine regardless of whether it was imposed before, on or after the commencement of this Act." ;
    skos:definition "The amendments of section 15A of the Crimes Act 1914 made by this Act apply in relation to a fine regardless of whether it was imposed before, on or after the commencement of this Act."@en ;
