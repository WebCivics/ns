      },
      "dc:source": "crimes-amendment-enforcement-of-fines-act-1998.pdf, p.6",
      "values:originalText": "An arrangement made under subsection 3B(1) of the Crimes Act 1914\nbefore the commencement of this Act continues in force after that\ncommencement as if the arrangement had been made under subsection\n3B(1) of that Act as in force immediately after that commencement.",
      "skos:definition": "An arrangement made under subsection 3B(1) of the Crimes Act 1914\nbefore the commencement of this Act continues in force after that\ncommencement as if the arrangement had been made under subsection\n3B(1) of that Act as in force immediately after that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-enforcement-of-fines-act-1998-sch-1-sec-2-norm"
        }
      ],
      "cml:integrityHash": "cfdee404b69af300c1266a4fe46e79702e4ba72b576a731bf3526ddb23d2b563",
      "skos:note": "Continuation of arrangements made under subsection 3B(1) of the Crimes Act 1914 after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-enforcement-of-fines-act-1998#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Transitional provision",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "An arrangement made under subsection 3B(1) of the Crimes Act 1914\nbefore the commencement of this Act continues in force after that\ncommencement as if the arrangement had been made under subsection\n3B(1) of that Act as in force immediately after that commencement."
    },
