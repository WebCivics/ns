      "dc:source": "crimes-amendment-enforcement-of-fines-act-1998.pdf, p.5",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendment of the Crimes Act 1914",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendment of the Crimes Act 1914",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-enforcement-of-fines-act-1998-sec-3-norm"
        }
      ],
      "cml:integrityHash": "c6bfddcf9c42dc2d1d9771ec222e61e024a63b12373049c2d6a3115021f90d37",
      "skos:note": "Schedules amendment and repeal provisions for Acts specified in them."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-enforcement-of-fines-act-1998#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendment of the Crimes Act 1914"
    },
