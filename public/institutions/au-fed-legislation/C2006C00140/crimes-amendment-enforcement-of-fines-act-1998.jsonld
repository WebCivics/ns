    {
      "@id": "concept:crimes-amendment-enforcement-of-fines-act-1998-sch-1-sec-4-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Crimes Amendment (Enforcement of Fines) Act 1998",
