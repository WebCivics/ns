    {
      "@id": "concept:crimes-amendment-enforcement-of-fines-act-1998-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 3B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-enforcement-of-fines-act-1998#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-enforcement-of-fines-act-1998.pdf"
      },
      "dc:source": "crimes-amendment-enforcement-of-fines-act-1998.pdf, p.6",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) The Governor-General may make arrangements with the Governor\nof a State, the Government of the Australian Capital Territory, the\nAdministrator of the Northern Territory or the Administrator of\nNorfolk Island for:\n\n(a) officers of the State or Territory to exercise powers and\nperform functions; and\n\n(b) facilities and procedures of the State or Territory to be made\navailable;\nin relation to the carrying out or enforcement under this Act of\norders made under this Act or another Act.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) The Governor-General may make arrangements with the Governor\nof a State, the Government of the Australian Capital Territory, the\nAdministrator of the Northern Territory or the Administrator of\nNorfolk Island for:\n\n(a) officers of the State or Territory to exercise powers and\nperform functions; and\n\n(b) facilities and procedures of the State or Territory to be made\navailable;\nin relation to the carrying out or enforcement under this Act of\norders made under this Act or another Act.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-enforcement-of-fines-act-1998-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:crimes-amendment-enforcement-of-fines-act-1998-sch-1-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7bcb232b3d317444994faad76e43fa21af63abffbd7e9df6d14b91828833afdc",
      "skos:note": "Arrange with states and territories for officers to exercise powers and perform functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-enforcement-of-fines-act-1998#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 3B(1)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) The Governor-General may make arrangements with the Governor\nof a State, the Government of the Australian Capital Territory, the\nAdministrator of the Northern Territory or the Administrator of\nNorfolk Island for:\n\n(a) officers of the State or Territory to exercise powers and\nperform functions; and\n\n(b) facilities and procedures of the State or Territory to be made\navailable;\nin relation to the carrying out or enforcement under this Act of\norders made under this Act or another Act."
    },
