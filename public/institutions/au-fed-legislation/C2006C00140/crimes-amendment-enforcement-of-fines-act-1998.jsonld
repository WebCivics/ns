    {
      "@id": "concept:crimes-amendment-enforcement-of-fines-act-1998-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-enforcement-of-fines-act-1998#sec-3"
      },
