    {
      "@id": "concept:crimes-amendment-enforcement-of-fines-act-1998-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Transitional provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-enforcement-of-fines-act-1998#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
