      "@type": "cml:LogicApplication",
      "cml:conclusionText": "H is reasonable in the circumstances.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If G is an intelligence or security officer, then H is reasonable in the circumstances for the purpose of performing that duty.",
