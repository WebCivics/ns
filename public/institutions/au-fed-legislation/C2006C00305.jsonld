    {
      "@id": "concept:act-sch-1-sec-474-29-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The sender commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits sending unsolicited sexual messages to minors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the sender uses a carriage service to transmit a communication to another person (the recipient); and (b) the sender does this with the intention of procuring the recipient to engage in, or submit to, sexual activity with another person;"
    },
    {
      "@id": "concept:act-sch-1-sec-474-29-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The sender commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits sending unsolicited messages to minors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(c) the recipient is someone who is, or who the sender believes to be, under 16 years of age;"
    },
    {
      "@id": "concept:act-sch-1-sec-474-29-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The sender commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits sending messages in the presence of minors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(e) the sender intends that the sexual activity referred to in paragraph (b) will take place in the presence of: (i) the sender; or (ii) another person who is, or who the sender believes to be, at least 18 years of age;"
    },
