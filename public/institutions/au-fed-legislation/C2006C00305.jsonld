      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.56",
      "skos:note": "Making a threat of contamination with intent to cause public alarm or economic loss is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "50(2) Crimes Legislation Amendment (Telecommunications Offences and"
      },
