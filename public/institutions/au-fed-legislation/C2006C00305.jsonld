      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If I is a law enforcement officer, then J is not criminally responsible if K is reasonable in the circumstances for the purpose of performing that duty.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "I is a law enforcement officer."
