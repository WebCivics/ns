    {
      "@id": "concept:act-sch-2-sec-50-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...(x) the loss is a loss to the Commonwealth or a Commonwealth authority;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The threat must be made in Australia for the contamination offence to apply.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(x) the person makes the threat outside Australia and the goods have been produced, manufactured, assembled or otherwise processed in Australia;"
    },
    {
      "@id": "concept:act-sch-2-sec-50-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is guilty of an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Making a threat of contamination with intent to cause public alarm or economic loss is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "The person makes a threat that goods will be contaminated."
    },
    {
      "@id": "concept:act-sch-2-sec-50-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...(vii) the goods are in the course of, or intended for, constitutional trade and commerce;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The person making the threat has permission to do so if they are a constitutional corporation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(vii) the loss takes the form of detriment to constitutional trade and commerce;"
    },
    {
      "@id": "concept:act-sch-2-sec-50-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the person does so with intent...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The person making the threat has an obligation to provide information about the contamination.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(2) A person is guilty of an offence if:"
    },
