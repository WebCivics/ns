      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval between connecting and committing an offence",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "between identifiable temporal intervals",
      "cml:premiseText": "connects equipment to a telecommunications network; and intends by this to commit, or to facilitate the commission of, an offence"
    },
    {
      "@id": "concept:act-sch-1-sec-474-14-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A person is guilty of an offence if:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Guilty of an offence",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "guilt",
      "cml:premiseText": "(a) the person: (i) connects equipment to a telecommunications network; and (ii) intends by this to commit, or to facilitate the commission of, an offence"
    },
    {
      "@id": "concept:act-sch-1-sec-474-14-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Serious offence against a law of the Commonwealth, a State or a Territory",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "serious offence",
      "cml:premiseText": "(b) the offence is: (i) a serious offence against a law of the Commonwealth, a State or a Territory; or (ii) a serious offence against a foreign law"
    },
    {
      "@id": "concept:act-sch-1-sec-474-14-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
