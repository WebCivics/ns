      "@type": "cml:LogicApplication",
      "cml:conclusionText": "B is not criminally responsible.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If A is a law enforcement officer, then B is not criminally responsible.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "A is a law enforcement officer."
    },
    {
      "@id": "concept:act-sch-1-sec-474-21-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "D is not criminally responsible.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If C is an intelligence or security officer, then D is not criminally responsible.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "C is an intelligence or security officer."
    },
    {
      "@id": "concept:act-sch-1-sec-474-21-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "F is reasonable in the circumstances.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If E is a law enforcement officer, then F is reasonable in the circumstances for the purpose of performing that duty.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "E is a law enforcement officer."
