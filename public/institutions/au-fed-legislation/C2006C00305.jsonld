    {
      "@id": "concept:act-sch-1-sec-474-5-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Imprisonment for 1 year.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Establishes temporal relation between communication reception and imprisonment.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "(1) A person is guilty of an offence if:  (a) a communication is in the course of telecommunications carriage; and  (b) the person causes the communication to be received by a person or carriage service other than the person or service to whom it is directed."
    },
