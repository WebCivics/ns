        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Conditional reasoning based on context",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "If the material is of a medical, legal or scientific character, then it should be considered less offensive."
    },
    {
      "@id": "concept:act-sch-1-sec-473-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Material should be considered offensive if the AI determines it to be so.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Artificial intelligence analysis of material's content",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "by",
      "cml:premiseText": "The carriage service's AI can analyze the material's content and determine its offensiveness."
    },
    {
      "@id": "concept:act-sch-1-sec-473-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Material should be considered offensive if it violates these standards.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Moral obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "should",
      "cml:premiseText": "Reasonable adults generally accept certain standards of morality, decency and propriety."
    },
    {
      "@id": "concept:act-sch-1-sec-473-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Material should be considered offensive if it has a significant impact on public opinion.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Spread of information and its impact on public opinion",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "through",
      "cml:premiseText": "The material's spread through the carriage service can influence public opinion."
    },
