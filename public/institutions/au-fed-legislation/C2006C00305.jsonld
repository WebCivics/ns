      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.34",
      "skos:note": "Law enforcement officer or intelligence officer not criminally responsible for using a carriage service to access child pornography material if acting in the course of their duties.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "474(3) Section 474"
      },
