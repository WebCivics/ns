    <https://ns.webcivics.net/cml/integrityHash> "b4defcc814773d03b5de2ad0e74beea411670d40ab09452234c78b654df041de";
    <http://www.w3.org/2004/02/skos/core#note> "Possessing or bringing prohibited goods into Australia is an offence.";
