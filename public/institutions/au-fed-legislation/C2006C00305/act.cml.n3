concept:act-sch-1-sec-474-12 a cml:Concept ;
    skos:prefLabel "474 12  Producing, supplying or obtaining data or a device with"@en ;
    cml:realizedBy doc:sch-1-sec-474-12 ;
    values:originalText "intent to copy an account identifier  (1) A person is guilty of an offence if:  (a) the person produces, supplies or obtains any thing or data; and  (b) the person does so with the intention that the thing or data be used:  (i) by the person; or  (ii) by another person;  in committing an offence against subsection 474.10(1) (copying subscription-specific secure data from an account identifier) or 474.10(2) (copying subscription-specific secure data onto an account identifier). Penalty: Imprisonment for 2 years.  Telecommunications offences  Schedule 1" ;
    skos:definition "intent to copy an account identifier  (1) A person is guilty of an offence if:  (a) the person produces, supplies or obtains any thing or data; and  (b) the person does so with the intention that the thing or data be used:  (i) by the person; or  (ii) by another person;  in committing an offence against subsection 474.10(1) (copying subscription-specific secure data from an account identifier) or 474.10(2) (copying subscription-specific secure data onto an account identifier). Penalty: Imprisonment for 2 years.  Telecommunications offences  Schedule 1"@en ;
    cml:integrityHash "62527805c639ccbee314cbd8bdc3c0b9bd0a94ca9344a34db2578468816d8358" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Producing, supplying or obtaining data with intent to copy an account identifier is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.27" ;
    cml:asserts concept:act-sch-1-sec-474-12-norm .
