    cml:operator "Inference" ;
    cml:logicSummary "Defence for assisting in detecting prohibited content or developing content filtering technology" ;
    cml:premiseText "Assisting in detecting prohibited content or developing content filtering technology" ;
    cml:conclusionText "Automatically applying the defence to similar situations" ;
