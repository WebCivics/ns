doc:sch-1-sec-21 a cof:Section ;
    cof:title "21 Dictionary in the Criminal Code" ;
    values:kind "section" ;
    values:originalText "Insert: data held in a computer includes:  (a) data held in any removable data storage device for the time being held in a computer; or  (b) data held in a data storage device on a computer network of which the computer forms a part." ;
    cof:pageNumber "48"^^xsd:integer .

concept:act-sch-1-sec-22-2 a cml:Concept ;
    skos:prefLabel "22 Dictionary in the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-22-2 ;
    values:originalText "Insert: data storage device means a thing (for example, a disk or file server) containing, or designed to contain, data for use by a computer." ;
