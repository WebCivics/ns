concept:act-sch-1-sec-473 a cml:Concept ;
    skos:prefLabel "473 1  Definitions"@en ;
    cml:realizedBy doc:sch-1-sec-473 ;
    values:originalText "In this Part: access in relation to material includes:  (a) the display of the material by a computer or any other output of the material from a computer; or  (b) the copying or moving of the material to any place in a computer or to a data storage device; or  (c) in the case of material that is a program—the execution of the program. account identifier means:  (a) something that:  (i) contains subscription-specific secure data; and  (ii) is installed, or capable of being installed, in a mobile telecommunications device; or  (b) anything else that:  (i) allows a particular mobile telecommunications account to be identified; and  (ii) is prescribed by the regulations as an account identifier for the purposes of this Part. Note: Paragraph (a)—This would include a SIM card.  Telecommunications offences  Schedule 1" ;
    skos:definition "In this Part: access in relation to material includes:  (a) the display of the material by a computer or any other output of the material from a computer; or  (b) the copying or moving of the material to any place in a computer or to a data storage device; or  (c) in the case of material that is a program—the execution of the program. account identifier means:  (a) something that:  (i) contains subscription-specific secure data; and  (ii) is installed, or capable of being installed, in a mobile telecommunications device; or  (b) anything else that:  (i) allows a particular mobile telecommunications account to be identified; and  (ii) is prescribed by the regulations as an account identifier for the purposes of this Part. Note: Paragraph (a)—This would include a SIM card.  Telecommunications offences  Schedule 1"@en ;
    cml:integrityHash "fd7266ad2afd51c393ae0f1c2b31bd353b79802b18f697b1afb7cfe6ebcb2ccc" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Defines access in relation to material, account identifier, and execution of a program." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.9" ;
    cml:asserts concept:act-sch-1-sec-473-norm .
