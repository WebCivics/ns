    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits making false statements about contamination of goods." ;
    cml:premiseText "The person makes a statement that the person believes to be false." ;
    cml:conclusionText "The person is guilty of an offence if..." ;
