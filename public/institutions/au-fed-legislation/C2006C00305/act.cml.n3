doc:sch-3-sec-480-5-ss-2 a cof:Section ;
    cof:title "480(2) 5  Possession or control of thing with intent to dishonestly obtain" ;
    values:kind "subsection" ;
    values:originalText "(2) A person may be found guilty of an offence against subsection (1) even if committing the offence against section 480.4 (dishonestly obtaining or dealing in personal financial information) is impossible." ;
    cof:pageNumber "62"^^xsd:integer .

