concept:act-sch-4-sec-1 a cml:Concept ;
    skos:prefLabel "1 At the end of section 11.2 of the Criminal Code"@en ;
    cml:realizedBy doc:sch-4-sec-1 ;
    values:originalText "Add:  (7) If the trier of fact is satisfied beyond reasonable doubt that a person either:  (a) is guilty of a particular offence otherwise than because of the operation of subsection (1); or  (b) is guilty of that offence because of the operation of subsection (1); but is not able to determine which, the trier of fact may nonetheless find the person guilty of that offence." ;
    skos:definition "Add:  (7) If the trier of fact is satisfied beyond reasonable doubt that a person either:  (a) is guilty of a particular offence otherwise than because of the operation of subsection (1); or  (b) is guilty of that offence because of the operation of subsection (1); but is not able to determine which, the trier of fact may nonetheless find the person guilty of that offence."@en ;
    cml:integrityHash "0c933b4f119b32945ab78a18868f3fdc840a50830632406fca6d24d67340be43" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "If the trier of fact is satisfied beyond reasonable doubt that a person is guilty of an offence, they may find them guilty." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
