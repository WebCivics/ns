concept:act-sch-1-sec-474 a cml:Concept ;
    skos:prefLabel "474 1  Dishonesty"@en ;
    cml:realizedBy doc:sch-1-sec-474 ;
    values:originalText "(1) For the purposes of this Subdivision, dishonest means:  (a) dishonest according to the standards of ordinary people; and  (b) known by the defendant to be dishonest according to the standards of ordinary people.  (2) In a prosecution for an offence against this Subdivision, the determination of dishonesty is a matter for the trier of fact." ;
    skos:definition "(1) For the purposes of this Subdivision, dishonest means:  (a) dishonest according to the standards of ordinary people; and  (b) known by the defendant to be dishonest according to the standards of ordinary people.  (2) In a prosecution for an offence against this Subdivision, the determination of dishonesty is a matter for the trier of fact."@en ;
    cml:integrityHash "3ca821c0746be43243e353a24b467ca7f68ac6c394b181a643a6521f0f91f4fc" ;
    cof:pageNumber "17"^^xsd:integer ;
