    cml:logicSummary "Wrongful delivery of communications spreads to others." ;
    cml:premiseText "(1) A person is guilty of an offence if:  (a) a communication is in the course of telecommunications carriage; and  (b) the person causes the communication to be received by a person or carriage service other than the person or service to whom it is directed." ;
    cml:conclusionText "(1) A wrongful delivery of communications spreads to others if they receive the communication." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-1-sec-474-5-ss-1 cml:asserts concept:act-sch-1-sec-474-5-ss-1-logic-cogai-5 .
concept:act-sch-1-sec-474-5-ss-1-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Anomaly" ;
    cml:logicSummary "Wrongful delivery of communications is an anomaly in telecommunications carriage." ;
    cml:premiseText "(1) A person is guilty of an offence if:  (a) a communication is in the course of telecommunications carriage; and  (b) the person causes the communication to be received by a person or carriage service other than the person or service to whom it is directed." ;
    cml:conclusionText "(1) A wrongful delivery of communications is an anomaly if it deviates from the intended recipient." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
