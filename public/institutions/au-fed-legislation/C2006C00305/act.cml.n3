concept:act-sch-1-sec-474-15-ss-3 a cml:Concept ;
    skos:prefLabel "474(3) 15  Using a carriage service to make a threat"@en ;
    cml:realizedBy doc:sch-1-sec-474-15-ss-3 ;
    values:originalText "(3) In a prosecution for an offence against this section, it is not necessary to prove that the person receiving the threat actually feared that the threat would be carried out. Definitions" ;
    skos:definition "(3) In a prosecution for an offence against this section, it is not necessary to prove that the person receiving the threat actually feared that the threat would be carried out. Definitions"@en ;
    cml:integrityHash "8f326378c71e0ec6ffced1599064b65fd8968a5a39de2ff9fa03710a1ba92522" ;
    values:partOf concept:act-sch-1-sec-474-15 ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "No proof of fear required in threat prosecution" ;
    cml:curationStatus cml:Proposed ;
