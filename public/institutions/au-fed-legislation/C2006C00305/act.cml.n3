    skos:prefLabel "474(2) Section 474"@en ;
    cml:realizedBy doc:sch-1-sec-474-8-ss-2 ;
    values:originalText "(2) A person may be found guilty of an offence against subsection (1) even if committing the offence against subsection 474.7(1) (modification of a telecommunications device identifier) is impossible." ;
    skos:definition "(2) A person may be found guilty of an offence against subsection (1) even if committing the offence against subsection 474.7(1) (modification of a telecommunications device identifier) is impossible."@en ;
    cml:integrityHash "a0fb201c3cd8b2c11974c724e1804d9a2c44d137448c255f8403471fc8050ca4" ;
