concept:act-sch-3-sec-480-2 a cml:Concept ;
    skos:prefLabel "480 2  Dishonesty"@en ;
    cml:realizedBy doc:sch-3-sec-480-2 ;
    values:originalText "(1) For the purposes of this Part, dishonest means:  (a) dishonest according to the standards of ordinary people; and  (b) known by the defendant to be dishonest according to the standards of ordinary people.  (2) In a prosecution for an offence against this Part, the determination of dishonesty is a matter for the trier of fact." ;
    skos:definition "(1) For the purposes of this Part, dishonest means:  (a) dishonest according to the standards of ordinary people; and  (b) known by the defendant to be dishonest according to the standards of ordinary people.  (2) In a prosecution for an offence against this Part, the determination of dishonesty is a matter for the trier of fact."@en ;
    cml:integrityHash "caddf7210ea03ffcb1a3a6cc62e7557c2085ecefdceea7aca562e5154ef8ff4e" ;
    cof:pageNumber "61"^^xsd:integer ;
