concept:act-sch-5-sec-3 a cml:Concept ;
    skos:prefLabel "3 Subsection 233B(1)"@en ;
    cml:realizedBy doc:sch-5-sec-3 ;
    values:originalText "Repeal the subsection, substitute:  (1) A person commits an offence if:  (a) the person:  (i) possesses goods on board a ship or aircraft; or  (ii) brings goods into Australia; or  (iii) imports goods into Australia; or  (iv) possesses goods that have been imported into Australia in contravention of this Act; or  (v) conveys goods that have been imported into Australia in contravention of this Act; or  (vi) possesses goods that are reasonably suspected of having been imported into Australia in contravention of this Act; or  Amendment of other Acts  Schedule 5  Crimes Legislation Amendment (Telecommunications Offences and Other Measures) Act (No. 2) 2004                    61  (vii) fails to disclose to an officer on demand any knowledge in his or her possession or power concerning the importation or intended importation, or bringing or intended bringing, into Australia of goods; and  (b) the goods are a prohibited import to which this section applies.  (1AAB) Subparagraph (1)(a)(i), (ii), (iv), (v) or (vi) does not apply if the person proves that the person had a reasonable excuse for doing the act referred to in that subparagraph.  (1AAC) A person commits an offence if:  (a) the person:  (i) exports goods from Australia; or  (ii) fails to disclose to an officer on demand any knowledge in his or her possession or power concerning the exportation or intended exportation from Australia of goods; and  (b) the goods are a prohibited export to which this section applies." ;
    skos:definition "Repeal the subsection, substitute:  (1) A person commits an offence if:  (a) the person:  (i) possesses goods on board a ship or aircraft; or  (ii) brings goods into Australia; or  (iii) imports goods into Australia; or  (iv) possesses goods that have been imported into Australia in contravention of this Act; or  (v) conveys goods that have been imported into Australia in contravention of this Act; or  (vi) possesses goods that are reasonably suspected of having been imported into Australia in contravention of this Act; or  Amendment of other Acts  Schedule 5  Crimes Legislation Amendment (Telecommunications Offences and Other Measures) Act (No. 2) 2004                    61  (vii) fails to disclose to an officer on demand any knowledge in his or her possession or power concerning the importation or intended importation, or bringing or intended bringing, into Australia of goods; and  (b) the goods are a prohibited import to which this section applies.  (1AAB) Subparagraph (1)(a)(i), (ii), (iv), (v) or (vi) does not apply if the person proves that the person had a reasonable excuse for doing the act referred to in that subparagraph.  (1AAC) A person commits an offence if:  (a) the person:  (i) exports goods from Australia; or  (ii) fails to disclose to an officer on demand any knowledge in his or her possession or power concerning the exportation or intended exportation from Australia of goods; and  (b) the goods are a prohibited export to which this section applies."@en ;
    cml:integrityHash "b4defcc814773d03b5de2ad0e74beea411670d40ab09452234c78b654df041de" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Possessing or bringing prohibited goods into Australia is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.66" ;
    cml:asserts concept:act-sch-5-sec-3-norm .
concept:act-sch-5-sec-3-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-5-sec-3 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-5-sec-3 cml:asserts concept:act-sch-5-sec-3-logic-deontic-1 .
concept:act-sch-5-sec-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits possessing or bringing prohibited goods into Australia." ;
    cml:premiseText "The person possesses goods on board a ship or aircraft; or brings goods into Australia; or imports goods into Australia; or possesses goods that have been imported into Australia in contravention of this Act;" ;
    cml:conclusionText "An offence is committed if the person possesses or brings prohibited goods into Australia." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-3 cml:asserts concept:act-sch-5-sec-3-logic-deontic-2 .
concept:act-sch-5-sec-3-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits exporting prohibited goods from Australia." ;
    cml:premiseText "(a) The person exports goods from Australia; or fails to disclose to an officer on demand any knowledge in his or her possession or power concerning the exportation or intended exportation from Australia of goods;" ;
    cml:conclusionText "An offence is committed if the person exports prohibited goods from Australia." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-3 cml:asserts concept:act-sch-5-sec-3-logic-deontic-3 .
concept:act-sch-5-sec-3-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Justify" ;
    cml:logicSummary "Justifies the prohibition on possessing or bringing prohibited goods into Australia." ;
    cml:premiseText "(1AAB) Subparagraph (1)(a)(i), (ii), (iv), (v) or (vi) does not apply if the person proves that the person had a reasonable excuse for doing the act referred to in that subparagraph." ;
    cml:conclusionText "The person may justify their action if they have a reasonable excuse." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-5-sec-3 a cof:Section ;
    cof:title "3 Subsection 233B(1)" ;
    values:kind "section" ;
    values:originalText "Repeal the subsection, substitute:  (1) A person commits an offence if:  (a) the person:  (i) possesses goods on board a ship or aircraft; or  (ii) brings goods into Australia; or  (iii) imports goods into Australia; or  (iv) possesses goods that have been imported into Australia in contravention of this Act; or  (v) conveys goods that have been imported into Australia in contravention of this Act; or  (vi) possesses goods that are reasonably suspected of having been imported into Australia in contravention of this Act; or  Amendment of other Acts  Schedule 5  Crimes Legislation Amendment (Telecommunications Offences and Other Measures) Act (No. 2) 2004                    61  (vii) fails to disclose to an officer on demand any knowledge in his or her possession or power concerning the importation or intended importation, or bringing or intended bringing, into Australia of goods; and  (b) the goods are a prohibited import to which this section applies.  (1AAB) Subparagraph (1)(a)(i), (ii), (iv), (v) or (vi) does not apply if the person proves that the person had a reasonable excuse for doing the act referred to in that subparagraph.  (1AAC) A person commits an offence if:  (a) the person:  (i) exports goods from Australia; or  (ii) fails to disclose to an officer on demand any knowledge in his or her possession or power concerning the exportation or intended exportation from Australia of goods; and  (b) the goods are a prohibited export to which this section applies." ;
    cof:pageNumber "66"^^xsd:integer .

