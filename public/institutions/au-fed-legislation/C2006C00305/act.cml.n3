doc:sch-1-sec-474-ss-1 a cof:Section ;
    cof:title "474(1) 1  Dishonesty" ;
    values:kind "subsection" ;
    values:originalText "(1) For the purposes of this Subdivision, dishonest means:  (a) dishonest according to the standards of ordinary people; and  (b) known by the defendant to be dishonest according to the standards of ordinary people." ;
