concept:act-sch-1-sec-30-2 a cml:Concept ;
    skos:prefLabel "30 Saving—existing regulations respecting interception"@en ;
    cml:realizedBy doc:sch-1-sec-30-2 ;
    values:originalText "devices (1) Regulations made for the purposes of paragraph 85ZKB(2)(c) of the Crimes Act 1914 and in force immediately before the commencement of item 1 of this Schedule continue in force as if they had been made for the purposes of subsection 474.4(3) of the Criminal Code as enacted by that item. (2) Subitem (1) does not prevent amendment or repeal of the regulations referred to in that subitem." ;
    skos:definition "devices (1) Regulations made for the purposes of paragraph 85ZKB(2)(c) of the Crimes Act 1914 and in force immediately before the commencement of item 1 of this Schedule continue in force as if they had been made for the purposes of subsection 474.4(3) of the Criminal Code as enacted by that item. (2) Subitem (1) does not prevent amendment or repeal of the regulations referred to in that subitem."@en ;
    cml:integrityHash "ef33d6da58d87ad610aef502873a305bfc669a9f79e69df72c868f9f5c1d421a" ;
    cof:pageNumber "52"^^xsd:integer ;
    skos:note "Regulations respecting interception continue in force after commencement." ;
