      ],
      "cml:integrityHash": "17c0b6a1b3cd86a217fabc6ddc69a666e291d0ea709da4010aae7962cbca962d",
      "skos:note": "Possessing child abuse material for use through a carriage service in good faith to assist the Australian Broadcasting Authority"
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-27",
      "@type": "cof:Section",
      "cof:title": "474 23 (possessing etc. child abuse material for use through a",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "carriage service) if the person engages in the conduct in good faith\nfor the sole purpose of:\n\n(a) assisting the Australian Broadcasting Authority to detect:\n\nTelecommunications offences  Schedule 1"
    },
    {
      "@id": "concept:act-sch-1-sec-474-27-norm",
      "@type": "values:Obligation",
      "cml:modality": {
