      "cml:operator": "Overlap",
      "cml:logicSummary": "Communications may overlap in time.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
