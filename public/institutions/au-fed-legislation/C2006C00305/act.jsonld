      },
      "cml:premiseText": "A person is not criminally responsible for an offence against subsection (1).",
      "cml:conclusionText": "The person is not criminally responsible if the person is: ..."
    },
    {
      "@id": "concept:act-sch-1-sec-474-11-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If A, then B.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
