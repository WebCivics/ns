    {
      "@id": "concept:act-sch-1-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Crimes Legislation Amendment (Telecommunications Offences and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
