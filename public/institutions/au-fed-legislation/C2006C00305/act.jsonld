      "cml:logicSummary": "A person acting on behalf of a carriage service provider is liable for certain actions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
