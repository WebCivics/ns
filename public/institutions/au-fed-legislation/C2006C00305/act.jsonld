      },
      "dc:source": "act.pdf, p.37",
      "values:originalText": "carriage service) if the person engages in the conduct in good faith\nfor the sole purpose of:\n\n(a) assisting the Australian Broadcasting Authority to detect:\n\nTelecommunications offences  Schedule 1",
      "skos:definition": "carriage service) if the person engages in the conduct in good faith\nfor the sole purpose of:\n\n(a) assisting the Australian Broadcasting Authority to detect:\n\nTelecommunications offences  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-474-27-norm"
