    },
    {
      "@id": "concept:act-sch-1-sec-474-25-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:act-sch-1-sec-474-25-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:act-sch-1-sec-474-25-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits possessing child abuse material for use through a carriage service.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A person is not criminally responsible for an offence against section 474.22 (using a carriage service for child abuse material) or",
      "cml:conclusionText": "(3) A person is not criminally responsible for an offence against section 474.22 (using a carriage service for child abuse material) or"
    },
    {
      "@id": "concept:act-sch-1-sec-474-25-ss-3-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits possessing child abuse material for use through a carriage service.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A person is not criminally responsible for an offence against section 474.22 (using a carriage service for child abuse material) or",
      "cml:conclusionText": "(3) A person is not criminally responsible for an offence against section 474.22 (using a carriage service for child abuse material) or"
    },
    {
      "@id": "concept:act-sch-1-sec-474-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "474 23 (possessing etc. child abuse material for use through a",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.37",
      "values:originalText": "carriage service) if:\n\n(a) the person is, at the time of the offence, a law enforcement\nofficer, or an intelligence or security officer, acting in the\ncourse of his or her duties; and\n\n(b) the conduct of the person is reasonable in the circumstances\nfor the purpose of performing that duty.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3).\n\n(4) A person is not criminally responsible for an offence against\nsection 474.22 (using a carriage service for child abuse material) or",
      "skos:definition": "carriage service) if:\n\n(a) the person is, at the time of the offence, a law enforcement\nofficer, or an intelligence or security officer, acting in the\ncourse of his or her duties; and\n\n(b) the conduct of the person is reasonable in the circumstances\nfor the purpose of performing that duty.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3).\n\n(4) A person is not criminally responsible for an offence against\nsection 474.22 (using a carriage service for child abuse material) or",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-474-26-norm"
        },
        {
          "@id": "concept:act-sch-1-sec-474-26-logic-deontic-1"
        },
        {
          "@id": "concept:act-sch-1-sec-474-26-logic-alleninterval-2"
        },
        {
          "@id": "concept:act-sch-1-sec-474-26-logic-deontic-3"
        },
        {
          "@id": "concept:act-sch-1-sec-474-26-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "a8fbdd4f9d941e86c9a3f18ee21ea6a55a150a120acf4789f525445ee3ffa8f1",
      "skos:note": "Law enforcement and intelligence officers are not criminally responsible for possessing child abuse material if it is reasonable in the circumstances for their duty."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-26",
      "@type": "cof:Section",
      "cof:title": "474 23 (possessing etc. child abuse material for use through a",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "carriage service) if:\n\n(a) the person is, at the time of the offence, a law enforcement\nofficer, or an intelligence or security officer, acting in the\ncourse of his or her duties; and\n\n(b) the conduct of the person is reasonable in the circumstances\nfor the purpose of performing that duty.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3).\n\n(4) A person is not criminally responsible for an offence against\nsection 474.22 (using a carriage service for child abuse material) or"
    },
    {
      "@id": "concept:act-sch-1-sec-474-26-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:act-sch-1-sec-474-26"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:act-sch-1-sec-474-26-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "exemption",
      "cml:logicSummary": "Exemptions from criminal liability",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Law enforcement and intelligence officers are acting in the course of their duties.",
      "cml:conclusionText": "They are not criminally responsible for possessing child abuse material."
    },
    {
      "@id": "concept:act-sch-1-sec-474-26-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "The exemption only applies during the course of official duties",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is, at the time of the offence, a law enforcement officer, or an intelligence or security officer, acting in the course of his or her duties.",
      "cml:conclusionText": "This subsection does not apply to possession outside of official duties."
    },
    {
      "@id": "concept:act-sch-1-sec-474-26-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "permission",
      "cml:logicSummary": "Law enforcement and intelligence officers are permitted to possess child abuse material in certain circumstances",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person is not criminally responsible for an offence against section 474.22 (using a carriage service for child abuse material) or",
      "cml:conclusionText": "This subsection permits law enforcement and intelligence officers to possess child abuse material under certain conditions."
    },
    {
      "@id": "concept:act-sch-1-sec-474-26-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "exemption",
      "cml:logicSummary": "Law enforcement and intelligence officers are exempt from criminal liability for possessing child abuse material in certain circumstances",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person is not criminally responsible for an offence against section 474.22 (using a carriage service for child abuse material) or",
      "cml:conclusionText": "This subsection exempts law enforcement and intelligence officers from criminal liability for possessing child abuse material under certain conditions."
    },
    {
      "@id": "concept:act-sch-1-sec-474-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "474 23 (possessing etc. child abuse material for use through a",
