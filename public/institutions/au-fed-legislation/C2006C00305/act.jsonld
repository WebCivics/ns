    {
      "@id": "concept:act-sch-1-sec-474-10-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "474(2) 10  Copying subscription-specific secure data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-10-ss-2"
      },
