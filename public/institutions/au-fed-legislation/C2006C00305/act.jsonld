      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.64",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) the person engages in conduct; and\n\n(aa) as a result of that conduct, the person obtains a financial\nadvantage for himself or herself from another person; and\n\n(ab) the person knows or believes that he or she is not eligible to\nreceive that financial advantage; and",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) the person engages in conduct; and\n\n(aa) as a result of that conduct, the person obtains a financial\nadvantage for himself or herself from another person; and\n\n(ab) the person knows or believes that he or she is not eligible to\nreceive that financial advantage; and",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-4-sec-3-norm"
        },
        {
          "@id": "concept:act-sch-4-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "31f611a0506e2a3fd9e25e6038715c2245f3ca398fb4f4286629441edc9faef9",
      "skos:note": "Prohibit obtaining a financial advantage from another person when not eligible."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-4-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Paragraph 135.2(1)(a) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 64,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) the person engages in conduct; and\n\n(aa) as a result of that conduct, the person obtains a financial\nadvantage for himself or herself from another person; and\n\n(ab) the person knows or believes that he or she is not eligible to\nreceive that financial advantage; and"
    },
