      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.65",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) Subsection (1) does not apply, and the person is not criminally\nresponsible for the offence in those circumstances, if the Act is\nexpressly to the contrary effect.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) Subsection (1) does not apply, and the person is not criminally\nresponsible for the offence in those circumstances, if the Act is\nexpressly to the contrary effect.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-4-sec-5-norm"
