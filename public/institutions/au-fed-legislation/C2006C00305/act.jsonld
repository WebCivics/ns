      "@id": "concept:act-sch-1-sec-474-33-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "474(8) 27(2)(c) or (3)(f) was represented to the sender as being:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-33-ss-8"
      },
      "cml:curationStatus": {
