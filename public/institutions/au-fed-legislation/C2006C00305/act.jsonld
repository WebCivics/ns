      "cml:premiseText": "(a) that the facility is owned or operated by a carrier, a carriage service provider or a nominated carrier;"
    },
    {
      "@id": "concept:act-sch-1-sec-474-6-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Information Spread",
      "cml:logicSummary": "Information spread about facility ownership and operation",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) that the carriage service is supplied by a carriage service provider."
    },
    {
      "@id": "concept:act-sch-1-sec-474-6-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "474(5) 6  Interference with facilities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-6-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
