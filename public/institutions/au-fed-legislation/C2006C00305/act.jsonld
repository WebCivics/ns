      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If A, then B.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Acting with the consent of that carrier.",
      "cml:conclusionText": "The person is not criminally responsible if the person is acting with the consent of that carrier."
    },
    {
      "@id": "concept:act-sch-1-sec-474-11-ss-4-logic-alleninterval-4",
