      "cml:premiseText": "the matter in this subsection, see subsection 13.3(3).",
      "cml:conclusionText": "The person bears an evidential burden in relation to the matter in this subsection."
    },
    {
      "@id": "concept:act-sch-1-sec-474-11-ss-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
