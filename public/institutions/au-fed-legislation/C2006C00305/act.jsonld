    },
    {
      "@id": "concept:act-sch-1-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Crimes Legislation Amendment (Telecommunications Offences and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.38",
      "values:originalText": "Other Measures) Act (No. 2) 2004\n\n(i) prohibited content (within the meaning of Schedule 5 to\nthe Broadcasting Services Act 1992); or\n\n(ii) potential prohibited content (within the meaning of that\nSchedule);\n\nin the performance of the Authority’s functions under that\nSchedule; or\n\n(b) manufacturing or developing, or updating, content filtering\ntechnology (including software) in accordance with:\n\n(i) a recognised alternative access-prevention arrangement\n(within the meaning of clause 40 of Schedule 5 to the\nBroadcasting Services Act 1992); or\n\n(ii) a designated alternative access-prevention arrangement\n(within the meaning of clause 60 of that Schedule).\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3).",
      "skos:definition": "Other Measures) Act (No. 2) 2004\n\n(i) prohibited content (within the meaning of Schedule 5 to\nthe Broadcasting Services Act 1992); or\n\n(ii) potential prohibited content (within the meaning of that\nSchedule);\n\nin the performance of the Authority’s functions under that\nSchedule; or\n\n(b) manufacturing or developing, or updating, content filtering\ntechnology (including software) in accordance with:\n\n(i) a recognised alternative access-prevention arrangement\n(within the meaning of clause 40 of Schedule 5 to the\nBroadcasting Services Act 1992); or\n\n(ii) a designated alternative access-prevention arrangement\n(within the meaning of clause 60 of that Schedule).\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3).",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-32-norm"
        },
        {
          "@id": "concept:act-sch-1-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2139ea33d8b09ba1d846ab86a34e37c43ce2d9b6465ea6eddd0af406c61d8194",
      "skos:note": "Prohibits manufacturing or developing content filtering technology without a recognised alternative access-prevention arrangement."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Crimes Legislation Amendment (Telecommunications Offences and",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Other Measures) Act (No. 2) 2004\n\n(i) prohibited content (within the meaning of Schedule 5 to\nthe Broadcasting Services Act 1992); or\n\n(ii) potential prohibited content (within the meaning of that\nSchedule);\n\nin the performance of the Authority’s functions under that\nSchedule; or\n\n(b) manufacturing or developing, or updating, content filtering\ntechnology (including software) in accordance with:\n\n(i) a recognised alternative access-prevention arrangement\n(within the meaning of clause 40 of Schedule 5 to the\nBroadcasting Services Act 1992); or\n\n(ii) a designated alternative access-prevention arrangement\n(within the meaning of clause 60 of that Schedule).\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3)."
    },
    {
      "@id": "concept:act-sch-1-sec-32-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:act-sch-1-sec-32"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:act-sch-1-sec-32-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits an action.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:act-sch-1-sec-474-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "474 25  Obligations of Internet service providers and Internet",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.38",
      "values:originalText": "content hosts\n\nA person commits an offence if the person:\n\n(a) is an Internet service provider or an Internet content host; and\n\n(b) is aware that the service provided by the person can be used\nto access particular material that the person has reasonable\ngrounds to believe is:\n\n(i) child pornography material; or\n\n(ii) child abuse material; and\n\n(c) does not refer details of the material to the Australian Federal\nPolice within a reasonable time after becoming aware of the\nexistence of the material.\nPenalty: 100 penalty units.",
      "skos:definition": "content hosts\n\nA person commits an offence if the person:\n\n(a) is an Internet service provider or an Internet content host; and\n\n(b) is aware that the service provided by the person can be used\nto access particular material that the person has reasonable\ngrounds to believe is:\n\n(i) child pornography material; or\n\n(ii) child abuse material; and\n\n(c) does not refer details of the material to the Australian Federal\nPolice within a reasonable time after becoming aware of the\nexistence of the material.\nPenalty: 100 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-474-28-norm"
        },
        {
          "@id": "concept:act-sch-1-sec-474-28-logic-deontic-1"
        },
        {
          "@id": "concept:act-sch-1-sec-474-28-logic-alleninterval-2"
        },
        {
          "@id": "concept:act-sch-1-sec-474-28-logic-ltl-3"
        },
        {
          "@id": "concept:act-sch-1-sec-474-28-logic-diffusion-4"
        },
        {
          "@id": "concept:act-sch-1-sec-474-28-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "5efb425fb0c008f724909deb08813adc1bb6a0233a75a0c436e5e52de20a56db",
      "skos:note": "Failure to report child abuse material to the Australian Federal Police is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-28",
      "@type": "cof:Section",
      "cof:title": "474 25  Obligations of Internet service providers and Internet",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "content hosts\n\nA person commits an offence if the person:\n\n(a) is an Internet service provider or an Internet content host; and\n\n(b) is aware that the service provided by the person can be used\nto access particular material that the person has reasonable\ngrounds to believe is:\n\n(i) child pornography material; or\n\n(ii) child abuse material; and\n\n(c) does not refer details of the material to the Australian Federal\nPolice within a reasonable time after becoming aware of the\nexistence of the material.\nPenalty: 100 penalty units."
    },
    {
      "@id": "concept:act-sch-1-sec-474-28-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:act-sch-1-sec-474-28"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:act-sch-1-sec-474-28-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of failing to report child abuse material.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is an Internet service provider or content host.",
      "cml:conclusionText": "The person must not refer details of the material."
    },
    {
      "@id": "concept:act-sch-1-sec-474-28-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Temporal interval for reporting child abuse material.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person must report child abuse material within a reasonable time after becoming aware of its existence.",
      "cml:conclusionText": "A reasonable time is required to report child abuse material."
    },
    {
      "@id": "concept:act-sch-1-sec-474-28-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:logicSummary": "Recurring trace for reporting child abuse material.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person must report child abuse material repeatedly if it becomes available.",
      "cml:conclusionText": "Reporting child abuse material is a recurring task."
    },
    {
      "@id": "concept:act-sch-1-sec-474-28-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffusion",
      "cml:logicSummary": "Diffusion of the provision to others.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The provision must be communicated to others who are affected by it.",
      "cml:conclusionText": "The provision is diffused to others."
    },
    {
      "@id": "concept:act-sch-1-sec-474-28-logic-cogai-5",
