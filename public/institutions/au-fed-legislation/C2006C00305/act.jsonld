      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Imposes a prohibition.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
