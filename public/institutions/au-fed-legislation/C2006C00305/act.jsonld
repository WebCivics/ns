    {
      "@id": "concept:act-sch-1-sec-30-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Saving—existing regulations respecting interception",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-30-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
