        }
      ],
      "cml:integrityHash": "b5ea96e0f57e012d078104864f2736384545822ffa5923081e12db75669ed69a",
      "skos:note": "Members of the public not purchasing or using goods or similar things; steps taken to avoid public alarm or anxiety."
    },
    {
