    {
      "@id": "concept:act-sch-1-sec-474-10-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "474(3) 10  Copying subscription-specific secure data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-10-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
