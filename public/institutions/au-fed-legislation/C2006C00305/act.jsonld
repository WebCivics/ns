      },
      "cml:premiseText": "An employee or agent of that carrier who is acting on behalf of that carrier; ...",
      "cml:conclusionText": "The person is not criminally responsible if the person is an employee or agent of that carrier who is acting on behalf of that carrier."
    },
    {
      "@id": "concept:act-sch-1-sec-474-11-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
