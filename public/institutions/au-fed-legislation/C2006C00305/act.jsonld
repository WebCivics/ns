    {
      "@id": "concept:act-sch-5-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsection 38ZA(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-5-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.68",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) Subject to subsection (2), if a police officer seizes a thing while\nexecuting a warrant issued under Division 2, he or she must:\n\n(a) inform the Attorney-General that the thing has been so\nseized; and\n\n(b) retain the thing pending the Attorney-General’s direction\nunder subsection (4) about how to deal with the thing; and\n\n(c) comply with any such direction that the Attorney-General\ngives.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) Subject to subsection (2), if a police officer seizes a thing while\nexecuting a warrant issued under Division 2, he or she must:\n\n(a) inform the Attorney-General that the thing has been so\nseized; and\n\n(b) retain the thing pending the Attorney-General’s direction\nunder subsection (4) about how to deal with the thing; and\n\n(c) comply with any such direction that the Attorney-General\ngives.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-5-sec-12-norm"
        },
        {
          "@id": "concept:act-sch-5-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7716cea9da2506257d87f9a1e8aaf62031a314dcc0a0efb5b197d23b0cbc8845",
      "skos:note": "Police officer must inform Attorney-General and comply with direction on seized thing.",
      "dc:description": "Information about seizure of thing, Compliance with Attorney-General's direction"
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-5-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Subsection 38ZA(1)",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) Subject to subsection (2), if a police officer seizes a thing while\nexecuting a warrant issued under Division 2, he or she must:\n\n(a) inform the Attorney-General that the thing has been so\nseized; and\n\n(b) retain the thing pending the Attorney-General’s direction\nunder subsection (4) about how to deal with the thing; and\n\n(c) comply with any such direction that the Attorney-General\ngives."
    },
