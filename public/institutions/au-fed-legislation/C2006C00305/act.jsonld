    {
      "@id": "concept:act-sch-3-sec-480-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "480 2  Dishonesty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-3-sec-480-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.61",
      "values:originalText": "(1) For the purposes of this Part, dishonest means:\n\n(a) dishonest according to the standards of ordinary people; and\n\n(b) known by the defendant to be dishonest according to the\nstandards of ordinary people.\n\n(2) In a prosecution for an offence against this Part, the determination\nof dishonesty is a matter for the trier of fact.",
      "skos:definition": "(1) For the purposes of this Part, dishonest means:\n\n(a) dishonest according to the standards of ordinary people; and\n\n(b) known by the defendant to be dishonest according to the\nstandards of ordinary people.\n\n(2) In a prosecution for an offence against this Part, the determination\nof dishonesty is a matter for the trier of fact.",
      "cml:hasPart": [
        {
          "@id": "concept:act-sch-3-sec-480-2-ss-1"
        },
        {
          "@id": "concept:act-sch-3-sec-480-2-ss-2"
        }
      ],
