    {
      "@id": "concept:act-sch-2-sec-380-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "380 4  Making false statements about contamination of goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-2-sec-380-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.57",
      "values:originalText": "Offence based on implied nationhood power\n\n(1) A person is guilty of an offence if:\n\n(a) the person makes a statement that the person believes to be\nfalse; and\n\n(b) the person does so with the intention of inducing the person\nto whom the statement is made or others to believe that\ngoods have been contaminated; and\n\n(c) the person does so with intent:\n\n(i) to cause public alarm or anxiety in Australia; or\n\n(ii) to cause widespread, or nationally significant, economic\nloss in Australia through public awareness of the\ncontamination, or possible contamination, of the goods;\nor\n\n(iii) to cause harm to, or create a risk of harm to, public\nhealth in Australia.\nPenalty: Imprisonment for 10 years.\n\nContamination offence  Schedule 2",
      "skos:definition": "Offence based on implied nationhood power\n\n(1) A person is guilty of an offence if:\n\n(a) the person makes a statement that the person believes to be\nfalse; and\n\n(b) the person does so with the intention of inducing the person\nto whom the statement is made or others to believe that\ngoods have been contaminated; and\n\n(c) the person does so with intent:\n\n(i) to cause public alarm or anxiety in Australia; or\n\n(ii) to cause widespread, or nationally significant, economic\nloss in Australia through public awareness of the\ncontamination, or possible contamination, of the goods;\nor\n\n(iii) to cause harm to, or create a risk of harm to, public\nhealth in Australia.\nPenalty: Imprisonment for 10 years.\n\nContamination offence  Schedule 2",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-2-sec-380-4-norm"
        },
        {
          "@id": "concept:act-sch-2-sec-380-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "412033fbc318ad20aaa6e770b60eb850b3bb174143e6d9221fabb1de37633352",
      "skos:note": "Making false statements about contamination of goods is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-2-sec-380-4",
      "@type": "cof:Section",
      "cof:title": "380 4  Making false statements about contamination of goods",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "Offence based on implied nationhood power\n\n(1) A person is guilty of an offence if:\n\n(a) the person makes a statement that the person believes to be\nfalse; and\n\n(b) the person does so with the intention of inducing the person\nto whom the statement is made or others to believe that\ngoods have been contaminated; and\n\n(c) the person does so with intent:\n\n(i) to cause public alarm or anxiety in Australia; or\n\n(ii) to cause widespread, or nationally significant, economic\nloss in Australia through public awareness of the\ncontamination, or possible contamination, of the goods;\nor\n\n(iii) to cause harm to, or create a risk of harm to, public\nhealth in Australia.\nPenalty: Imprisonment for 10 years.\n\nContamination offence  Schedule 2"
    },
