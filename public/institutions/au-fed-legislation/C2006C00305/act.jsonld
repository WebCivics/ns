      "cml:integrityHash": "65e9b53f762eaecbd1646d065f556bbed0c96e73f028868751597a575fcb1a03",
      "skos:note": "Amendment applies to prosecutions brought after commencement of item."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-4-sec-2",
