    {
      "@id": "concept:act-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.8",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nTelecommunications offences  Schedule 1\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    3",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nTelecommunications offences  Schedule 1\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    3",
      "cml:asserts": [
        {
          "@id": "concept:act-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "f0696621716504cfd9acf93f575c298488dc4908cb0463c285628007139f9d56",
      "skos:note": "Amends or repeals Acts specified in a Schedule according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nTelecommunications offences  Schedule 1\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    3"
    },
