    {
      "@id": "concept:act-sch-1-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Crimes Legislation Amendment (Telecommunications Offences and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-16"
      },
