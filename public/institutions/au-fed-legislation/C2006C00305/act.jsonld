    {
      "@id": "concept:act-sch-4-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Paragraph 135.2(1)(a) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-4-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
