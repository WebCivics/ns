        }
      ],
      "cml:integrityHash": "70719854dfa00c09ece83b775c3f4460984b1e899137f68516fb24a9be21d0fb",
      "skos:note": "Crimes Legislation Amendment (Telecommunications Offences and Other Measures) Act (No. 2) 2004"
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-2-sec-48",
