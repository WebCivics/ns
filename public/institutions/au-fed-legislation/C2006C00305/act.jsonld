    {
      "@id": "concept:act-sch-1-sec-474-6-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "474(6) 6  Interference with facilities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-6-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
