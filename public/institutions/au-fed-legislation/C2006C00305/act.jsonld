        }
      ],
      "cml:integrityHash": "74958a2c0c44e1c87d156f6cb258b001cd771b7e0ee25c94ac7a060bcd4dfef8",
      "skos:note": "Defendant bears evidential burden in relation to the matter in this subsection."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-11-ss-5",
