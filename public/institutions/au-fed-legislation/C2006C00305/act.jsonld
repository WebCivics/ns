    {
      "@id": "concept:act-sch-1-sec-473-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "473 4  Determining whether material is offensive",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-473-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.16",
      "values:originalText": "The matters to be taken into account in deciding for the purposes of\nthis Part whether reasonable persons would regard particular\nmaterial, or a particular use of a carriage service, as being, in all\nthe circumstances, offensive, include:\n\n(a) the standards of morality, decency and propriety generally\naccepted by reasonable adults; and\n\n(b) the literary, artistic or educational merit (if any) of the\nmaterial; and\n\n(c) the general character of the material (including whether it is\nof a medical, legal or scientific character).\n\nTelecommunications offences  Schedule 1\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    11",
      "skos:definition": "The matters to be taken into account in deciding for the purposes of\nthis Part whether reasonable persons would regard particular\nmaterial, or a particular use of a carriage service, as being, in all\nthe circumstances, offensive, include:\n\n(a) the standards of morality, decency and propriety generally\naccepted by reasonable adults; and\n\n(b) the literary, artistic or educational merit (if any) of the\nmaterial; and\n\n(c) the general character of the material (including whether it is\nof a medical, legal or scientific character).\n\nTelecommunications offences  Schedule 1\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    11",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-473-4-norm"
        }
      ],
      "cml:integrityHash": "da702e16f3ed73d8b95a77b6b9dbc72a2bf3a608a871b6ad539aa00e3746893d",
      "skos:note": "Consider standards of morality, decency and propriety when deciding if material is offensive."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-473-4",
      "@type": "cof:Section",
      "cof:title": "473 4  Determining whether material is offensive",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "The matters to be taken into account in deciding for the purposes of\nthis Part whether reasonable persons would regard particular\nmaterial, or a particular use of a carriage service, as being, in all\nthe circumstances, offensive, include:\n\n(a) the standards of morality, decency and propriety generally\naccepted by reasonable adults; and\n\n(b) the literary, artistic or educational merit (if any) of the\nmaterial; and\n\n(c) the general character of the material (including whether it is\nof a medical, legal or scientific character).\n\nTelecommunications offences  Schedule 1\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    11"
    },
    {
      "@id": "concept:act-sch-1-sec-473-4-norm",
