      "cml:conclusionText": "...between 2 Territories."
    },
    {
      "@id": "concept:act-sch-2-sec-380-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "380(2) 1  Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-2-sec-380-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
