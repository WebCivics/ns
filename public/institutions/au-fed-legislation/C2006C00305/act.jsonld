    {
      "@id": "concept:act-sch-1-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Crimes Legislation Amendment (Telecommunications Offences and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.44",
      "values:originalText": "Other Measures) Act (No. 2) 2004\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection, see subsection 13.3(3).\n\n(3) In determining whether the defendant had the belief referred to in\nsubsection (1) or (2), the jury may take into account whether the\nalleged belief was reasonable in the circumstances.",
      "skos:definition": "Other Measures) Act (No. 2) 2004\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection, see subsection 13.3(3).\n\n(3) In determining whether the defendant had the belief referred to in\nsubsection (1) or (2), the jury may take into account whether the\nalleged belief was reasonable in the circumstances.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-38-norm"
        },
        {
          "@id": "concept:act-sch-1-sec-38-logic-deontic-1"
        },
        {
          "@id": "concept:act-sch-1-sec-38-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "8b45b74fe44599d4cce99b16657767ee75f8e1e396d01bb58f659f93796b2127",
      "skos:note": "Defendant bears evidential burden in relation to the matter in this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-38",
      "@type": "cof:Section",
      "cof:title": "38 Crimes Legislation Amendment (Telecommunications Offences and",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "Other Measures) Act (No. 2) 2004\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection, see subsection 13.3(3).\n\n(3) In determining whether the defendant had the belief referred to in\nsubsection (1) or (2), the jury may take into account whether the\nalleged belief was reasonable in the circumstances."
    },
