    {
      "@id": "concept:act-sch-3-sec-480-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "480 6  Importation of thing with intent to dishonestly obtain or deal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-3-sec-480-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.62",
      "values:originalText": "in personal financial information\n\nA person is guilty of an offence if the person:\n\n(a) imports a thing into Australia; and\n\n(b) does so with the intention that the thing be used:\n\n(i) by the person; or\n\n(ii) by another person;\n\nin committing an offence against section 480.3 (dishonestly\nobtaining or dealing in personal financial information) or to\nfacilitate the commission of that offence.\nPenalty: Imprisonment for 3 years.\n\nOther amendments of the Criminal Code  Schedule 4\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    57",
      "skos:definition": "in personal financial information\n\nA person is guilty of an offence if the person:\n\n(a) imports a thing into Australia; and\n\n(b) does so with the intention that the thing be used:\n\n(i) by the person; or\n\n(ii) by another person;\n\nin committing an offence against section 480.3 (dishonestly\nobtaining or dealing in personal financial information) or to\nfacilitate the commission of that offence.\nPenalty: Imprisonment for 3 years.\n\nOther amendments of the Criminal Code  Schedule 4\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    57",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-3-sec-480-6-norm"
        },
        {
          "@id": "concept:act-sch-3-sec-480-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "894ca488191cd9e221bd0ec7aaea5760b499a5e72258e83e815055d31281694b",
      "skos:note": "Importation of thing with intent to dishonestly obtain or deal is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-3-sec-480-6",
      "@type": "cof:Section",
      "cof:title": "480 6  Importation of thing with intent to dishonestly obtain or deal",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "in personal financial information\n\nA person is guilty of an offence if the person:\n\n(a) imports a thing into Australia; and\n\n(b) does so with the intention that the thing be used:\n\n(i) by the person; or\n\n(ii) by another person;\n\nin committing an offence against section 480.3 (dishonestly\nobtaining or dealing in personal financial information) or to\nfacilitate the commission of that offence.\nPenalty: Imprisonment for 3 years.\n\nOther amendments of the Criminal Code  Schedule 4\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    57"
    },
    {
      "@id": "concept:act-sch-3-sec-480-6-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:act-sch-3-sec-480-6"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:act-sch-3-sec-480-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the importation of thing with intent to dishonestly obtain or deal.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:act-sch-4-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 At the end of section 11.2 of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-4-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
