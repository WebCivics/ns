      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.52",
      "values:originalText": "devices\n(1)\nRegulations made for the purposes of paragraph 85ZKB(2)(c) of the\nCrimes Act 1914 and in force immediately before the commencement of\nitem 1 of this Schedule continue in force as if they had been made for\nthe purposes of subsection 474.4(3) of the Criminal Code as enacted by\nthat item.\n(2)\nSubitem (1) does not prevent amendment or repeal of the regulations\nreferred to in that subitem.",
      "skos:definition": "devices\n(1)\nRegulations made for the purposes of paragraph 85ZKB(2)(c) of the\nCrimes Act 1914 and in force immediately before the commencement of\nitem 1 of this Schedule continue in force as if they had been made for\nthe purposes of subsection 474.4(3) of the Criminal Code as enacted by\nthat item.\n(2)\nSubitem (1) does not prevent amendment or repeal of the regulations\nreferred to in that subitem.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-30-2-norm"
        },
        {
          "@id": "concept:act-sch-1-sec-30-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ef33d6da58d87ad610aef502873a305bfc669a9f79e69df72c868f9f5c1d421a",
      "skos:note": "Regulations respecting interception continue in force after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-30-2",
      "@type": "cof:Section",
      "cof:title": "30 Saving—existing regulations respecting interception",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "devices\n(1)\nRegulations made for the purposes of paragraph 85ZKB(2)(c) of the\nCrimes Act 1914 and in force immediately before the commencement of\nitem 1 of this Schedule continue in force as if they had been made for\nthe purposes of subsection 474.4(3) of the Criminal Code as enacted by\nthat item.\n(2)\nSubitem (1) does not prevent amendment or repeal of the regulations\nreferred to in that subitem."
    },
