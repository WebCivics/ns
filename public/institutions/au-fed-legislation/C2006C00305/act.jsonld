      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.63",
      "values:originalText": "Add:\n\n(7) If the trier of fact is satisfied beyond reasonable doubt that a person\neither:\n\n(a) is guilty of a particular offence otherwise than because of the\noperation of subsection (1); or\n\n(b) is guilty of that offence because of the operation of\nsubsection (1);\nbut is not able to determine which, the trier of fact may nonetheless\nfind the person guilty of that offence.",
      "skos:definition": "Add:\n\n(7) If the trier of fact is satisfied beyond reasonable doubt that a person\neither:\n\n(a) is guilty of a particular offence otherwise than because of the\noperation of subsection (1); or\n\n(b) is guilty of that offence because of the operation of\nsubsection (1);\nbut is not able to determine which, the trier of fact may nonetheless\nfind the person guilty of that offence.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-4-sec-1-norm"
        },
        {
          "@id": "concept:act-sch-4-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0c933b4f119b32945ab78a18868f3fdc840a50830632406fca6d24d67340be43",
      "skos:note": "If the trier of fact is satisfied beyond reasonable doubt that a person is guilty of an offence, they may find them guilty."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-4-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 At the end of section 11.2 of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "Add:\n\n(7) If the trier of fact is satisfied beyond reasonable doubt that a person\neither:\n\n(a) is guilty of a particular offence otherwise than because of the\noperation of subsection (1); or\n\n(b) is guilty of that offence because of the operation of\nsubsection (1);\nbut is not able to determine which, the trier of fact may nonetheless\nfind the person guilty of that offence."
    },
    {
