    {
      "@id": "concept:act-sch-2-sec-380-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "380 3  Threatening to contaminate goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-2-sec-380-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
