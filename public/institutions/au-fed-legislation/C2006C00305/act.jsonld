    {
      "@id": "concept:act-sch-1-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Paragraph 471.12(b) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.46",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) the person does so in a way (whether by the method of use or\nthe content of a communication, or both) that reasonable\npersons would regard as being, in all the circumstances,\nmenacing, harassing or offensive.",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) the person does so in a way (whether by the method of use or\nthe content of a communication, or both) that reasonable\npersons would regard as being, in all the circumstances,\nmenacing, harassing or offensive.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-7-norm"
        },
        {
          "@id": "concept:act-sch-1-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e13bc5b6d581185ab4f9ac1c94c059313770d504fb90bc8c3ec0cac9e825a8eb",
      "skos:note": "Repeal paragraph and substitute with a new prohibition on menacing, harassing or offensive behavior."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Paragraph 471.12(b) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) the person does so in a way (whether by the method of use or\nthe content of a communication, or both) that reasonable\npersons would regard as being, in all the circumstances,\nmenacing, harassing or offensive."
    },
