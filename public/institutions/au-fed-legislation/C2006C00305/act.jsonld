    {
      "@id": "concept:act-sch-2-sec-380-2-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "380(2) 2  Contaminating goods",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-2-sec-380-2-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
