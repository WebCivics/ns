    {
      "@id": "concept:act-sch-1-sec-473-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "473 Section 473",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-473-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
