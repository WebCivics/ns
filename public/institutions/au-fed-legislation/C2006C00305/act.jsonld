    {
      "@id": "concept:act-sch-1-sec-474-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "474 27  Using a carriage service to “groom” persons under 16 years",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
