    {
      "@id": "concept:act-sch-1-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Crimes Legislation Amendment (Telecommunications Offences and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.26",
      "values:originalText": "Other Measures) Act (No. 2) 2004\n\n(a) the person is, at the time of the offence, a law enforcement\nofficer, or an intelligence or security officer, acting in the\ncourse of his or her duties; and\n\n(b) the conduct of the person is reasonable in the circumstances\nfor the purpose of performing that duty.\nNote 1:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3).\nNote 2:\nThis subsection merely creates a defence to an offence against\nsubsection (1) or (2) and does not operate to authorise any conduct\nthat requires a warrant under some other law.",
      "skos:definition": "Other Measures) Act (No. 2) 2004\n\n(a) the person is, at the time of the offence, a law enforcement\nofficer, or an intelligence or security officer, acting in the\ncourse of his or her duties; and\n\n(b) the conduct of the person is reasonable in the circumstances\nfor the purpose of performing that duty.\nNote 1:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3).\nNote 2:\nThis subsection merely creates a defence to an offence against\nsubsection (1) or (2) and does not operate to authorise any conduct\nthat requires a warrant under some other law.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-20-norm"
        },
        {
          "@id": "concept:act-sch-1-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6b7e72be623d6cdf49314f0484eabf47ab4e797ec46f0ec44fd2421bc5c01ec1",
      "skos:note": "Defence for law enforcement or intelligence officers acting in the course of their duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Crimes Legislation Amendment (Telecommunications Offences and",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Other Measures) Act (No. 2) 2004\n\n(a) the person is, at the time of the offence, a law enforcement\nofficer, or an intelligence or security officer, acting in the\ncourse of his or her duties; and\n\n(b) the conduct of the person is reasonable in the circumstances\nfor the purpose of performing that duty.\nNote 1:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection, see subsection 13.3(3).\nNote 2:\nThis subsection merely creates a defence to an offence against\nsubsection (1) or (2) and does not operate to authorise any conduct\nthat requires a warrant under some other law."
    },
    {
      "@id": "concept:act-sch-1-sec-20-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:act-sch-1-sec-20"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
