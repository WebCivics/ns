    {
      "@id": "concept:act-sch-1-sec-474-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "474 16  Using a carriage service for a hoax threat",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.31",
      "values:originalText": "A person is guilty of an offence if:\n\n(a) the person uses a carriage service to send a communication;\nand\n\n(b) the person does so with the intention of inducing a false\nbelief that an explosive, or a dangerous or harmful substance\nor thing, has been or will be left in any place.\nPenalty: Imprisonment for 10 years.",
      "skos:definition": "A person is guilty of an offence if:\n\n(a) the person uses a carriage service to send a communication;\nand\n\n(b) the person does so with the intention of inducing a false\nbelief that an explosive, or a dangerous or harmful substance\nor thing, has been or will be left in any place.\nPenalty: Imprisonment for 10 years.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-1-sec-474-16-norm"
        },
        {
          "@id": "concept:act-sch-1-sec-474-16-logic-deontic-1"
        },
        {
          "@id": "concept:act-sch-1-sec-474-16-logic-deontic-2"
        },
        {
          "@id": "concept:act-sch-1-sec-474-16-logic-linearlogic-3"
        },
        {
          "@id": "concept:act-sch-1-sec-474-16-logic-alleninterval-4"
        },
        {
          "@id": "concept:act-sch-1-sec-474-16-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "6ffcf3d1485318eece1826fb734fdb977278f9c5f9a6c26b3699ca92d19f631d",
      "skos:note": "Using a carriage service to send a hoax threat is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-16",
      "@type": "cof:Section",
      "cof:title": "474 16  Using a carriage service for a hoax threat",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "A person is guilty of an offence if:\n\n(a) the person uses a carriage service to send a communication;\nand\n\n(b) the person does so with the intention of inducing a false\nbelief that an explosive, or a dangerous or harmful substance\nor thing, has been or will be left in any place.\nPenalty: Imprisonment for 10 years."
    },
    {
