      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits the use of a carriage service for a hoax threat.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
