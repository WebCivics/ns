      ],
      "cml:integrityHash": "0885b7454fe16611dcf07650fd88a05e042f5f4951fe09a117eed6aead1e8f94",
      "skos:note": "Dishonesty defined as dishonest according to ordinary people's standards."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-3-sec-480-2-ss-1",
      "@type": "cof:Section",
      "cof:title": "480(1) 2  Dishonesty",
      "values:kind": "subsection",
      "cof:pageNumber": 61,
      "values:originalText": "(1) For the purposes of this Part, dishonest means:\n\n(a) dishonest according to the standards of ordinary people; and\n\n(b) known by the defendant to be dishonest according to the\nstandards of ordinary people."
    },
