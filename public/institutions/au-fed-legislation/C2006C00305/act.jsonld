          "@id": "concept:act-sch-1-sec-474-10-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "762b57b3381e40df3ff26de14cb11370e268e02e3d38a3c1356e701639cc424b",
      "skos:note": "Copying subscription-specific secure data onto a new account identifier is prohibited."
    },
    {
