    {
      "@id": "concept:act-sch-1-sec-474-7-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "474(2) 7  Modification etc. of a telecommunications device identifier",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-7-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
