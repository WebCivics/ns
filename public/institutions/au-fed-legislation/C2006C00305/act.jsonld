    {
      "@id": "concept:act-sch-1-sec-474-33-ss-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If it is impossible for the sexual activity to take place, then guilty of an offence against section 474.26 or 474.27.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(8) A person may be found guilty of an offence against section 474.26\nor 474.27 even if it is impossible for the sexual activity referred to\nin that section to take place.",
      "cml:conclusionText": "A person may not be found guilty of an offence against section 474.26 or 474.27 unless it is possible for the sexual activity to take place."
    },
    {
      "@id": "concept:act-sch-1-sec-474-33-ss-9",
