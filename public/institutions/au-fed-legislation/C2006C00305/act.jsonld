    {
      "@id": "concept:act-sch-1-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Crimes Legislation Amendment (Telecommunications Offences and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
