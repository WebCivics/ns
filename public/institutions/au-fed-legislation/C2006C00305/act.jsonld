      ],
      "cml:integrityHash": "17eaf666158d8d588eb60b6a498a7c4579ac8518fbb08e97d6883d7069339fb9",
      "skos:note": "Repeal subsection, substitute with new provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-4-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Subsection 9.3(2) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) Subsection (1) does not apply, and the person is not criminally\nresponsible for the offence in those circumstances, if the Act is\nexpressly to the contrary effect."
    },
