    {
      "@id": "concept:act-sch-3-sec-480-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "480 3  Constitutional application of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-3-sec-480-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.61",
      "values:originalText": "This Part applies to personal financial information only if:\n\n(a) the funds concerned represent amounts that have been\ndeposited with or lent to, or are otherwise to be provided or\nmade available by, an ADI or a constitutional corporation; or\n\n(b) the credit or other financial benefits concerned are provided,\nor made available, by an ADI or a constitutional corporation.",
      "skos:definition": "This Part applies to personal financial information only if:\n\n(a) the funds concerned represent amounts that have been\ndeposited with or lent to, or are otherwise to be provided or\nmade available by, an ADI or a constitutional corporation; or\n\n(b) the credit or other financial benefits concerned are provided,\nor made available, by an ADI or a constitutional corporation.",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-3-sec-480-3-norm"
        },
        {
          "@id": "concept:act-sch-3-sec-480-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "889c2e9561f623b484f811845f4758203f635ab0fb360f0fd50aaf3229958a1f",
      "skos:note": "Personal financial information applies to ADI or constitutional corporation funds or benefits."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-3-sec-480-3",
      "@type": "cof:Section",
      "cof:title": "480 3  Constitutional application of this Part",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "This Part applies to personal financial information only if:\n\n(a) the funds concerned represent amounts that have been\ndeposited with or lent to, or are otherwise to be provided or\nmade available by, an ADI or a constitutional corporation; or\n\n(b) the credit or other financial benefits concerned are provided,\nor made available, by an ADI or a constitutional corporation."
    },
    {
      "@id": "concept:act-sch-3-sec-480-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:act-sch-3-sec-480-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:act-sch-3-sec-480-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "appliesTo",
      "cml:logicSummary": "Personal financial information applies to ADI or constitutional corporation funds or benefits.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:act-sch-3-sec-480-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "480 4  Dishonestly obtaining or dealing in personal financial",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-3-sec-480-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.61",
      "values:originalText": "information\n\nA person is guilty of an offence if the person:\n\n(a) dishonestly obtains, or deals in, personal financial\ninformation; and\n\n(b) obtains, or deals in, that information without the consent of\nthe person to whom the information relates.\nPenalty: Imprisonment for 5 years.\n\nFinancial information offences  Schedule 3",
      "skos:definition": "information\n\nA person is guilty of an offence if the person:\n\n(a) dishonestly obtains, or deals in, personal financial\ninformation; and\n\n(b) obtains, or deals in, that information without the consent of\nthe person to whom the information relates.\nPenalty: Imprisonment for 5 years.\n\nFinancial information offences  Schedule 3",
      "cml:asserts": [
        {
          "@id": "concept:act-sch-3-sec-480-4-norm"
        },
        {
          "@id": "concept:act-sch-3-sec-480-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c723671bedb8d3146c32636ae146d623a728ada26334f5a4cb357ba549b3da58",
      "skos:note": "Dishonestly obtaining or dealing in personal financial information is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/act#sch-3-sec-480-4",
      "@type": "cof:Section",
      "cof:title": "480 4  Dishonestly obtaining or dealing in personal financial",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "information\n\nA person is guilty of an offence if the person:\n\n(a) dishonestly obtains, or deals in, personal financial\ninformation; and\n\n(b) obtains, or deals in, that information without the consent of\nthe person to whom the information relates.\nPenalty: Imprisonment for 5 years.\n\nFinancial information offences  Schedule 3"
    },
    {
      "@id": "concept:act-sch-3-sec-480-4-norm",
