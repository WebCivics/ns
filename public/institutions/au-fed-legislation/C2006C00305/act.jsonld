    {
      "@id": "concept:act-sch-1-sec-474-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "474 27",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-474-32"
