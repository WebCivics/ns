    {
      "@id": "concept:act-sch-1-sec-475-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "475 2  Geographical jurisdiction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/act#sch-1-sec-475-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "act.pdf"
      },
      "dc:source": "act.pdf, p.44",
      "values:originalText": "Section 15.1 (extended geographical jurisdiction—category A)\napplies to each offence against this Part.\n\nTelecommunications offences  Schedule 1\n\nCrimes Legislation Amendment (Telecommunications Offences and Other\nMeasures) Act (No. 2) 2004                    39",
