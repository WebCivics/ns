      "skos:prefLabel": {
        "@language": "en",
        "@value": "5 Certificates relating to vesting of assets other than land"
      },
      "wasDerivedFrom": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf",
      "asserts": [
        "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-5-norm",
