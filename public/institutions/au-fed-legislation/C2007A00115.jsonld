    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8",
      "@type": "cml:Concept",
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.26",
      "skos:note": "References to Centre or Director taken to be references to CEO or Commonwealth",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "8 References in instruments"
      },
      "wasDerivedFrom": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf",
      "asserts": [
        "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-norm",
        "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-1",
        "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-2",
        "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "eb65a9da5b2d313eb981ba43dde99d923562bc570efde18825b82fc1188d79e6",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-8",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the instrument has effect from the commencement time as if the reference were a reference to the CEO.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If an instrument contains a reference to the Centre or Director, it has effect from the commencement time as if the reference were a reference to the CEO.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "an instrument is in force immediately before the commencement time; and the instrument contains a reference to the Centre or to the Director;"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "subitem (1), (2) or (3) does not apply in relation to a specified reference.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Minister may, by writing, determine that subitem (1), (2) or (3) does not apply in relation to a specified reference;",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "the Minister may, by writing, determine that subitem (1), (2) or (3);"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the reference is to be read as a reference to the Commonwealth as necessary to give effect to item 2 or 3, as the case requires.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "However, if an instrument is in force immediately before the commencement time; and the instrument relates to assets or liabilities covered by item 2 or 3; and the instrument refers to the Centre or to the Director;",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "an instrument is in force immediately before the commencement time; and the instrument relates to assets or liabilities covered by item 2 or 3; and the instrument refers to the Centre or to the Director;"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-norm",
