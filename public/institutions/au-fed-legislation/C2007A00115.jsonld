      "cml:operator": "during",
      "cml:premiseText": "(a) any land vests in the Commonwealth under this Part."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(ii) states that the land has become vested in the Commonwealth under this Part.",
      "cml:confidence": {
