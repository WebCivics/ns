    cml:hasPart concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-14-ss-3 ;
    cml:hasPart concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-14-ss-4 ;
    cml:curationStatus cml:Proposed ;
