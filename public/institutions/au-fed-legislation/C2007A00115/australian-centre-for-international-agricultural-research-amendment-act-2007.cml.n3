doc:sch-2-sec-2 a cof:Section ;
    cof:title "2 Vesting of assets of Centre" ;
    values:kind "section" ;
    values:originalText "(1) This item applies to the assets of the Centre immediately before the commencement time. (2) At the commencement time, the assets to which this item applies cease to be assets of the Centre and become assets of the Commonwealth without any conveyance, transfer or assignment. The Commonwealth becomes the successor in law in relation to these assets." ;
    cof:pageNumber "24"^^xsd:integer .

concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-3 a cml:Concept ;
    skos:prefLabel "3 Vesting of liabilities of Centre"@en ;
    cml:realizedBy doc:sch-2-sec-3 ;
    values:originalText "(1) This item applies to the liabilities of the Centre immediately before the commencement time. (2) At the commencement time, the liabilities to which this item applies cease to be liabilities of the Centre and become liabilities of the Commonwealth without any conveyance, transfer or assignment. The Commonwealth becomes the successor in law in relation to these liabilities." ;
    skos:definition "(1) This item applies to the liabilities of the Centre immediately before the commencement time. (2) At the commencement time, the liabilities to which this item applies cease to be liabilities of the Centre and become liabilities of the Commonwealth without any conveyance, transfer or assignment. The Commonwealth becomes the successor in law in relation to these liabilities."@en ;
    cml:integrityHash "e8468db3ccb3c30dca0d8c4f5892685cfd9494f057f3c7fdd3735fd345eeef6f" ;
    cof:pageNumber "24"^^xsd:integer ;
