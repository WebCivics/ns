doc:sch-1-sec-16k-ss-2 a cof:Section ;
    cof:title "16K(2) Directions by the Minister" ;
    values:kind "subsection" ;
    values:originalText "(2) In giving a direction, the Minister must have regard to any relevant advice that he or she may have received from the Council under section 18." ;
    cof:pageNumber "15"^^xsd:integer .

