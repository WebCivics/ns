concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29c-ss-2-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Governor-General has an obligation to terminate CEO appointment under specified conditions" ;
    cml:premiseText "(a) the CEO becomes bankrupt; or (b) the CEO is absent for 14 consecutive days; or (c) the CEO engages in paid employment outside duties" ;
    cml:conclusionText "The Governor-General must terminate the appointment of the CEO" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-29c-ss-2 a cof:Section ;
    cof:title "29C(2) Termination of appointment" ;
    values:kind "subsection" ;
    values:originalText "(2) The Governor-General must terminate the appointment of the CEO if:  (a) the CEO:  (i) becomes bankrupt; or  (ii) applies to take the benefit of any law for the relief of bankrupt or insolvent debtors; or  (iii) compounds with his or her creditors; or  (iv) makes an assignment of his or her remuneration for the benefit of his or her creditors; or  (b) the CEO is absent, except on leave of absence, for 14 consecutive days or for 28 days in any 12 months; or  (c) the CEO engages, except with the Minister’s approval, in paid employment outside the duties of his or her office; or  (d) the CEO fails, without reasonable excuse, to comply with section 29D." ;
    cof:pageNumber "18"^^xsd:integer .

concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29d a cml:Concept ;
    skos:prefLabel "29D Disclosure of interests"@en ;
    cml:realizedBy doc:sch-1-sec-29d ;
    values:originalText "The CEO must give written notice to the Minister of any direct or indirect pecuniary interest that the CEO has or acquires and that conflicts or could conflict with the proper performance of the CEO’s functions.  Amendments  Schedule 1" ;
    skos:definition "The CEO must give written notice to the Minister of any direct or indirect pecuniary interest that the CEO has or acquires and that conflicts or could conflict with the proper performance of the CEO’s functions.  Amendments  Schedule 1"@en ;
    cml:integrityHash "eeb9455f4a8f6fa090b3bf5c368e374bf17270593d2936537fc8461a84e4e816" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Disclosure of pecuniary interests by CEO" ;
    dc:description "Written notice" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
