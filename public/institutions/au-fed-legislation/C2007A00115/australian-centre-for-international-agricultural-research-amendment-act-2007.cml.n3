concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-6 a cml:Concept ;
    skos:prefLabel "6 Substitution of Commonwealth as a party to pending"@en ;
    cml:realizedBy doc:sch-2-sec-6 ;
    values:originalText "proceedings If any proceedings to which the Centre was a party were pending in any court or tribunal immediately before the commencement time, the Commonwealth is substituted for the Centre, from the commencement time, as a party to the proceedings." ;
    skos:definition "proceedings If any proceedings to which the Centre was a party were pending in any court or tribunal immediately before the commencement time, the Commonwealth is substituted for the Centre, from the commencement time, as a party to the proceedings."@en ;
