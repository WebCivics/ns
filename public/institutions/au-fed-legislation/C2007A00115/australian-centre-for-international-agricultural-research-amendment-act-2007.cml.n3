concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-35 a cml:Concept ;
    skos:prefLabel "35 Purposes of the Account"@en ;
    cml:realizedBy doc:sch-1-sec-35 ;
    values:originalText "(1) This section sets out the purposes of the Account.  (2) Amounts standing to the credit of the Account may be debited for the following purposes:  (a) in payment or discharge of the costs, expenses and other obligations incurred by the Commonwealth in the performance of the functions of the CEO or of the staff of the Centre referred to in section 30;  (b) in payment of any remuneration and allowances payable to any person under this Act." ;
    skos:definition "(1) This section sets out the purposes of the Account.  (2) Amounts standing to the credit of the Account may be debited for the following purposes:  (a) in payment or discharge of the costs, expenses and other obligations incurred by the Commonwealth in the performance of the functions of the CEO or of the staff of the Centre referred to in section 30;  (b) in payment of any remuneration and allowances payable to any person under this Act."@en ;
    cml:integrityHash "63d5866744c743c1c3fa44f76dc1913dc58bcc830d768dcf19eb25a032c9e250" ;
    cof:pageNumber "20"^^xsd:integer ;
