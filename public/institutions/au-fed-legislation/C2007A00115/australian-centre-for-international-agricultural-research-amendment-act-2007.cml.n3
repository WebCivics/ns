doc:sch-1-sec-16b-ss-1 a cof:Section ;
    cof:title "16B(1) Disclosure of interests" ;
    values:kind "subsection" ;
    values:originalText "(1) A Commissioner must give written notice to the Minister of any direct or indirect pecuniary interest that the Commissioner has or acquires and that conflicts or could conflict with the proper performance of the Commissioner’s functions. Disclosure to Commission" ;
    cof:pageNumber "12"^^xsd:integer .

