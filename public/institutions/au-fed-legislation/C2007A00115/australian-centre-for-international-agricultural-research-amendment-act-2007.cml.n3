concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-7 a cml:Concept ;
    skos:prefLabel "7 Transfer of custody of Centre or Board records"@en ;
    cml:realizedBy doc:sch-2-sec-7 ;
    values:originalText "(1) This item applies to any records or documents that, immediately before the commencement time, were in the custody of the Centre or the Board. (2) The records and documents are to be transferred into the custody of the CEO at or after the commencement time.  Schedule 2  Transitional provisions" ;
    skos:definition "(1) This item applies to any records or documents that, immediately before the commencement time, were in the custody of the Centre or the Board. (2) The records and documents are to be transferred into the custody of the CEO at or after the commencement time.  Schedule 2  Transitional provisions"@en ;
    cml:integrityHash "568c26f7e2aaf3f323af2e88fe3632466387221a778100e6f41d90843d36ff68" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Transfer of custody of Centre or Board records" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
