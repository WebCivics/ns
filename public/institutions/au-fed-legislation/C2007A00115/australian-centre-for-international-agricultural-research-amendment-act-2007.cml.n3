    cml:conclusionText "The reference is to be read as a reference to the Commonwealth." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8 cml:asserts concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-3 .
