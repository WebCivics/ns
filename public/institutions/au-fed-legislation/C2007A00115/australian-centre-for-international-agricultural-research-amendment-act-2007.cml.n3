    cml:logicSummary "The Minister may provide otherwise in relation to specified references." ;
    cml:premiseText "The Minister may, by writing, determine that subitem (1), (2) or (3): does not apply in relation to a specified reference;" ;
    cml:conclusionText "The Minister may override the application of subitem (1), (2) or (3)." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
