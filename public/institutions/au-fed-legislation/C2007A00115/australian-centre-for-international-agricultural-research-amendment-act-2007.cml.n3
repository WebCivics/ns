doc:sch-1-sec-14-ss-2 a cof:Section ;
    cof:title "14(2) Subsections 5(2) and (3)" ;
    values:kind "subsection" ;
    values:originalText "(2) The CEO must, in performing his or her functions with respect to agricultural research, have regard to the need for persons or institutions in developing countries to share in that research." ;
    cof:pageNumber "8"^^xsd:integer .

