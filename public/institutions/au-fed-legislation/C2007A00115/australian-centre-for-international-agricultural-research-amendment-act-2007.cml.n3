concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-24-2 a cml:Concept ;
    skos:prefLabel "24 Appointment of CEO"@en ;
    cml:realizedBy doc:sch-1-sec-24-2 ;
    values:originalText "(1) The CEO is to be appointed by the Governor-General by written instrument.  (2) The CEO holds office for the period specified in the instrument of appointment. The period must not exceed 7 years.  (3) A person may be appointed as both the CEO and a Commissioner (including the Chair)." ;
    skos:definition "(1) The CEO is to be appointed by the Governor-General by written instrument.  (2) The CEO holds office for the period specified in the instrument of appointment. The period must not exceed 7 years.  (3) A person may be appointed as both the CEO and a Commissioner (including the Chair)."@en ;
    cml:integrityHash "82c443f47fceb29457769d28b8f8873a274993fb29332e46ec58bf2091e5fb4a" ;
    cof:pageNumber "16"^^xsd:integer ;
