concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-14 a cml:Concept ;
    skos:prefLabel "14 Subsections 5(2) and (3)"@en ;
    cml:realizedBy doc:sch-1-sec-14 ;
    values:originalText "Repeal the subsections, substitute:  (2) The CEO must, in performing his or her functions with respect to agricultural research, have regard to the need for persons or institutions in developing countries to share in that research.  (3) Nothing in this section authorises, or permits, the CEO to carry out research on behalf of the Commonwealth.  (4) The CEO must, in performing his or her functions, comply with any directions given to the CEO under section 5A." ;
    skos:definition "Repeal the subsections, substitute:  (2) The CEO must, in performing his or her functions with respect to agricultural research, have regard to the need for persons or institutions in developing countries to share in that research.  (3) Nothing in this section authorises, or permits, the CEO to carry out research on behalf of the Commonwealth.  (4) The CEO must, in performing his or her functions, comply with any directions given to the CEO under section 5A."@en ;
    cml:integrityHash "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d" ;
    cof:pageNumber "8"^^xsd:integer ;
