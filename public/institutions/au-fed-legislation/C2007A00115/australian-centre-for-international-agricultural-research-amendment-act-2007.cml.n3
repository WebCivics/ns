concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-17 a cml:Concept ;
    skos:prefLabel "17 Certificates taken to be authentic"@en ;
    cml:realizedBy doc:sch-2-sec-17 ;
    values:originalText "A document that appears to be a certificate made or issued under a particular provision of this Schedule:  (a) is taken to be such a certificate; and  (b) is taken to have been properly given; unless the contrary is established." ;
    skos:definition "A document that appears to be a certificate made or issued under a particular provision of this Schedule:  (a) is taken to be such a certificate; and  (b) is taken to have been properly given; unless the contrary is established."@en ;
    cml:integrityHash "30271d23ea521132757788d1bf15e71a45e31d0bddd1f448d16be52fcf3c43a5" ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "A document is taken to be a certificate if it appears to be one." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
