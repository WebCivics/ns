doc:sch-1-sec-26 a cof:Section ;
    cof:title "26 Terms and conditions—general" ;
    values:kind "section" ;
    values:originalText "The CEO holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the Governor-General.  Amendments  Schedule 1" ;
    cof:pageNumber "16"^^xsd:integer .

