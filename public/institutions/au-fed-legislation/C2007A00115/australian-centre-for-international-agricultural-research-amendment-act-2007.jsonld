    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Credits to the Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.20",
      "values:originalText": "There must be credited to the Account amounts equal to the\nfollowing:\n\n(a) all money appropriated by the Parliament for the purposes of\nthe Account;\n\n(b) other money received by the Commonwealth in relation to\nthe performance of the functions of the CEO;\n\n(c) amounts of any gifts given or bequests made for the purposes\nof the Account.\nNote:\nAn Appropriation Act provides for amounts to be credited to a Special\nAccount if any of the purposes of the Account is a purpose that is\ncovered by an item in the Appropriation Act.",
      "skos:definition": "There must be credited to the Account amounts equal to the\nfollowing:\n\n(a) all money appropriated by the Parliament for the purposes of\nthe Account;\n\n(b) other money received by the Commonwealth in relation to\nthe performance of the functions of the CEO;\n\n(c) amounts of any gifts given or bequests made for the purposes\nof the Account.\nNote:\nAn Appropriation Act provides for amounts to be credited to a Special\nAccount if any of the purposes of the Account is a purpose that is\ncovered by an item in the Appropriation Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-34-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-34-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "663ea291dac97b2c9f498a09b07d28cde3c528c3b57f82414a466ca357fbf566",
      "skos:note": "Must credit specified amounts to the Account",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Credits to the Account",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "There must be credited to the Account amounts equal to the\nfollowing:\n\n(a) all money appropriated by the Parliament for the purposes of\nthe Account;\n\n(b) other money received by the Commonwealth in relation to\nthe performance of the functions of the CEO;\n\n(c) amounts of any gifts given or bequests made for the purposes\nof the Account.\nNote:\nAn Appropriation Act provides for amounts to be credited to a Special\nAccount if any of the purposes of the Account is a purpose that is\ncovered by an item in the Appropriation Act."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-34-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-34"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-34-logic-deontic-1",
