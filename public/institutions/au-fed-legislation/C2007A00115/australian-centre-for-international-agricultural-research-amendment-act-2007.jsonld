      }
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-35",
      "@type": "cml:Concept",
      "skos:prefLabel": "35 Purposes of the Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-35"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.20",
      "values:originalText": "(1) This section sets out the purposes of the Account.\n\n(2) Amounts standing to the credit of the Account may be debited for\nthe following purposes:\n\n(a) in payment or discharge of the costs, expenses and other\nobligations incurred by the Commonwealth in the\nperformance of the functions of the CEO or of the staff of the\nCentre referred to in section 30;\n\n(b) in payment of any remuneration and allowances payable to\nany person under this Act.",
      "skos:definition": "(1) This section sets out the purposes of the Account.\n\n(2) Amounts standing to the credit of the Account may be debited for\nthe following purposes:\n\n(a) in payment or discharge of the costs, expenses and other\nobligations incurred by the Commonwealth in the\nperformance of the functions of the CEO or of the staff of the\nCentre referred to in section 30;\n\n(b) in payment of any remuneration and allowances payable to\nany person under this Act.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-35-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-35-ss-2"
        }
      ],
      "cml:integrityHash": "63d5866744c743c1c3fa44f76dc1913dc58bcc830d768dcf19eb25a032c9e250"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-35",
      "@type": "cof:Section",
      "cof:title": "35 Purposes of the Account",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "(1) This section sets out the purposes of the Account.\n\n(2) Amounts standing to the credit of the Account may be debited for\nthe following purposes:\n\n(a) in payment or discharge of the costs, expenses and other\nobligations incurred by the Commonwealth in the\nperformance of the functions of the CEO or of the staff of the\nCentre referred to in section 30;\n\n(b) in payment of any remuneration and allowances payable to\nany person under this Act."
    },
