    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29d",
      "@type": "cml:Concept",
      "skos:prefLabel": "29D Disclosure of interests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-29d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.18",
      "values:originalText": "The CEO must give written notice to the Minister of any direct or\nindirect pecuniary interest that the CEO has or acquires and that\nconflicts or could conflict with the proper performance of the\nCEO’s functions.\n\nAmendments  Schedule 1",
      "skos:definition": "The CEO must give written notice to the Minister of any direct or\nindirect pecuniary interest that the CEO has or acquires and that\nconflicts or could conflict with the proper performance of the\nCEO’s functions.\n\nAmendments  Schedule 1",
      "cml:asserts": [
