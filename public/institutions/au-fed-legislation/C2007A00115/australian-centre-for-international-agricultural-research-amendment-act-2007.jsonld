    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-9-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Functions of the Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-9-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.10",
      "values:originalText": "The functions of the Commission are:\n\n(a) to provide advice to the Minister in relation to the\nformulation of programs of the kind referred to in paragraph\n5(1)(a); and\n\n(b) to provide advice to the Minister in relation to the funding of\nthings referred to in paragraphs 5(1)(d), (e) and (f); and\n\n(c) to provide advice to the Minister on program and funding\npriorities; and\n\n(d) to provide advice to the Minister, on the Minister’s request,\non any other matter relating to this Act.",
      "skos:definition": "The functions of the Commission are:\n\n(a) to provide advice to the Minister in relation to the\nformulation of programs of the kind referred to in paragraph\n5(1)(a); and\n\n(b) to provide advice to the Minister in relation to the funding of\nthings referred to in paragraphs 5(1)(d), (e) and (f); and\n\n(c) to provide advice to the Minister on program and funding\npriorities; and\n\n(d) to provide advice to the Minister, on the Minister’s request,\non any other matter relating to this Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-9-2-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-9-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c21ef0479a788231aa726aeaf84ad7757e579d0858246c7e4c49e2ea296ecfbc",
      "skos:note": "The Commission must provide advice to the Minister on certain matters.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-9-2",
      "@type": "cof:Section",
      "cof:title": "9 Functions of the Commission",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "The functions of the Commission are:\n\n(a) to provide advice to the Minister in relation to the\nformulation of programs of the kind referred to in paragraph\n5(1)(a); and\n\n(b) to provide advice to the Minister in relation to the funding of\nthings referred to in paragraphs 5(1)(d), (e) and (f); and\n\n(c) to provide advice to the Minister on program and funding\npriorities; and\n\n(d) to provide advice to the Minister, on the Minister’s request,\non any other matter relating to this Act."
    },
