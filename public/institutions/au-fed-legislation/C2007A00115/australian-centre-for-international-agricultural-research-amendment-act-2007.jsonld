      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.17",
      "values:originalText": "The CEO must not engage in paid employment outside the duties\nof his or her office without the Minister’s approval.",
      "skos:definition": "The CEO must not engage in paid employment outside the duties\nof his or her office without the Minister’s approval.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-28-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-28-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9de04192cdde7d7192d10bd5f5028cafd662b2028f313dbfdacd50280b01d90c",
      "skos:note": "Prohibition on paid employment outside office duties without approval"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-28",
      "@type": "cof:Section",
      "cof:title": "28 CEO not to engage in paid employment",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "The CEO must not engage in paid employment outside the duties\nof his or her office without the Minister’s approval."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-28-norm",
