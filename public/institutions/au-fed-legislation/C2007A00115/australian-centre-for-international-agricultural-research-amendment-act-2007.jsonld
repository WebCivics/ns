    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Certificates taken to be authentic",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.32",
      "values:originalText": "A document that appears to be a certificate made or issued under a\nparticular provision of this Schedule:\n\n(a) is taken to be such a certificate; and\n\n(b) is taken to have been properly given;\nunless the contrary is established.",
      "skos:definition": "A document that appears to be a certificate made or issued under a\nparticular provision of this Schedule:\n\n(a) is taken to be such a certificate; and\n\n(b) is taken to have been properly given;\nunless the contrary is established.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-17-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-17-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "30271d23ea521132757788d1bf15e71a45e31d0bddd1f448d16be52fcf3c43a5",
      "skos:note": "A document is taken to be a certificate if it appears to be one."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Certificates taken to be authentic",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "A document that appears to be a certificate made or issued under a\nparticular provision of this Schedule:\n\n(a) is taken to be such a certificate; and\n\n(b) is taken to have been properly given;\nunless the contrary is established."
    },
    {
