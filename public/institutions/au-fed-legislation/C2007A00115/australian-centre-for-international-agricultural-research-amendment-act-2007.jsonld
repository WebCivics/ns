    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Remuneration and allowances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.17",
      "values:originalText": "(1) The CEO is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the CEO is to be paid the\nremuneration that is prescribed by the regulations.\n\n(2) The CEO is to be paid the allowances that are prescribed by the\nregulations.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "skos:definition": "(1) The CEO is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the CEO is to be paid the\nremuneration that is prescribed by the regulations.\n\n(2) The CEO is to be paid the allowances that are prescribed by the\nregulations.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-27-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-27-ss-2"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-27-ss-3"
        }
      ],
      "cml:integrityHash": "b112ee6c5cf2d16a9c1a7e4f975fbabb39f4367c32937f812510824081755b5b"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Remuneration and allowances",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "(1) The CEO is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the CEO is to be paid the\nremuneration that is prescribed by the regulations.\n\n(2) The CEO is to be paid the allowances that are prescribed by the\nregulations.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973."
    },
