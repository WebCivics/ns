    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Staff of the Centre",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.30",
      "values:originalText": "(1)\nA person who was a member of the staff of the Centre immediately\nbefore the commencement time is taken, at the commencement time, to\nhave been engaged by the CEO as a member of the staff of the Centre.\n(2)\nThe person is taken to have been engaged on the same terms and\nconditions as applied to the person immediately before the\ncommencement time.\n(3)\nThis item does not prevent those terms and conditions being varied after\nthe commencement time.",
      "skos:definition": "(1)\nA person who was a member of the staff of the Centre immediately\nbefore the commencement time is taken, at the commencement time, to\nhave been engaged by the CEO as a member of the staff of the Centre.\n(2)\nThe person is taken to have been engaged on the same terms and\nconditions as applied to the person immediately before the\ncommencement time.\n(3)\nThis item does not prevent those terms and conditions being varied after\nthe commencement time.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-12-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "12312d4066a4a52b25534d9f20c8891845fbe709d8e0e5c1d42e04133ac356a0",
      "skos:note": "Staff engagement upon commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Staff of the Centre",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "(1)\nA person who was a member of the staff of the Centre immediately\nbefore the commencement time is taken, at the commencement time, to\nhave been engaged by the CEO as a member of the staff of the Centre.\n(2)\nThe person is taken to have been engaged on the same terms and\nconditions as applied to the person immediately before the\ncommencement time.\n(3)\nThis item does not prevent those terms and conditions being varied after\nthe commencement time."
    },
