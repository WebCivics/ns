    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Exemption from stamp duty and other State or Territory",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.32",
      "values:originalText": "taxes\nNo stamp duty or other tax is payable under a law of a State or Territory\nin respect of, or in respect of anything connected with:\n\n(a) the transfer of an asset or liability under this Schedule; or\n\n(b) the operation of this Schedule in any other respect.",
      "skos:definition": "taxes\nNo stamp duty or other tax is payable under a law of a State or Territory\nin respect of, or in respect of anything connected with:\n\n(a) the transfer of an asset or liability under this Schedule; or\n\n(b) the operation of this Schedule in any other respect.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-15-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-15-logic-deontic-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-15-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "75f719af5859196349970ee550836f01c0a39b384baee0a1aff221b980670af2",
      "skos:note": "No stamp duty or tax is payable under this Schedule in respect of the transfer of an asset or liability."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Exemption from stamp duty and other State or Territory",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "taxes\nNo stamp duty or other tax is payable under a law of a State or Territory\nin respect of, or in respect of anything connected with:\n\n(a) the transfer of an asset or liability under this Schedule; or\n\n(b) the operation of this Schedule in any other respect."
    },
