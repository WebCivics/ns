        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-35-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ca4fe9982b6d2ab847b6c85267843a9e31b61a5f579a8f6a040a35f32b660f3e",
      "skos:note": "Debit amounts for costs and expenses incurred by the Commonwealth in performing CEO functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-35-ss-2",
