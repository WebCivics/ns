      "cof:title": "10(2) Appointment of Commissioners",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(2) A Commissioner holds office for the period specified in the\ninstrument of appointment. The period must not exceed 3 years."
    },
