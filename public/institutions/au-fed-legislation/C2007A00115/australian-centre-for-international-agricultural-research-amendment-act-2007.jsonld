      "cml:conclusionText": "The instrument has effect from the commencement time as if the reference were a reference to the Commission."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-8-logic-deontic-4",
      "@type": "cml:LogicApplication",
