    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-10-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Appointment of Commissioners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-10-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.10",
      "values:originalText": "(1) A Commissioner is to be appointed by the Governor-General by\nwritten instrument.\n\n(2) A Commissioner holds office for the period specified in the\ninstrument of appointment. The period must not exceed 3 years.\n\n(3) A person cannot be appointed as a Commissioner if the person is a\nmember of the Council.",
      "skos:definition": "(1) A Commissioner is to be appointed by the Governor-General by\nwritten instrument.\n\n(2) A Commissioner holds office for the period specified in the\ninstrument of appointment. The period must not exceed 3 years.\n\n(3) A person cannot be appointed as a Commissioner if the person is a\nmember of the Council.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-10-2-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-10-2-ss-2"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-10-2-ss-3"
        }
      ],
      "cml:integrityHash": "4ddeff593c48464cdf5b069d47a905d460f1458c42ce4d5c93d4676bceb27587"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-10-2",
      "@type": "cof:Section",
      "cof:title": "10 Appointment of Commissioners",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) A Commissioner is to be appointed by the Governor-General by\nwritten instrument.\n\n(2) A Commissioner holds office for the period specified in the\ninstrument of appointment. The period must not exceed 3 years.\n\n(3) A person cannot be appointed as a Commissioner if the person is a\nmember of the Council."
    },
