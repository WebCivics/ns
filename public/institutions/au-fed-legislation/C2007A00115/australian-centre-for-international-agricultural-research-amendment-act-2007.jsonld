    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-35-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "35(2) Purposes of the Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-35-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
