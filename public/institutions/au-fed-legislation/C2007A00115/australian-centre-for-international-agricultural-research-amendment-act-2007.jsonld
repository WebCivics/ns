    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-24-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Appointment of CEO",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-24-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.16",
      "values:originalText": "(1) The CEO is to be appointed by the Governor-General by written\ninstrument.\n\n(2) The CEO holds office for the period specified in the instrument of\nappointment. The period must not exceed 7 years.\n\n(3) A person may be appointed as both the CEO and a Commissioner\n(including the Chair).",
      "skos:definition": "(1) The CEO is to be appointed by the Governor-General by written\ninstrument.\n\n(2) The CEO holds office for the period specified in the instrument of\nappointment. The period must not exceed 7 years.\n\n(3) A person may be appointed as both the CEO and a Commissioner\n(including the Chair).",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-24-2-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-24-2-ss-2"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-24-2-ss-3"
        }
      ],
      "cml:integrityHash": "82c443f47fceb29457769d28b8f8873a274993fb29332e46ec58bf2091e5fb4a"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-24-2",
      "@type": "cof:Section",
      "cof:title": "24 Appointment of CEO",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "(1) The CEO is to be appointed by the Governor-General by written\ninstrument.\n\n(2) The CEO holds office for the period specified in the instrument of\nappointment. The period must not exceed 7 years.\n\n(3) A person may be appointed as both the CEO and a Commissioner\n(including the Chair)."
    },
