      "@type": "cml:Concept",
      "skos:prefLabel": "2007 27",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-2007-5"
