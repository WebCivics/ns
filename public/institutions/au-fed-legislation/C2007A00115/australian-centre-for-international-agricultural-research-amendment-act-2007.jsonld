    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Delegation by Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.32",
      "values:originalText": "(1)\nThe Minister may, by writing, delegate all or any of his or her powers\nand functions under this Schedule to the CEO.\n\nTransitional provisions  Schedule 2\nOther matters  Part 5",
      "skos:definition": "(1)\nThe Minister may, by writing, delegate all or any of his or her powers\nand functions under this Schedule to the CEO.\n\nTransitional provisions  Schedule 2\nOther matters  Part 5",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-18-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bd558124080d32986859d2bebe87ecbec189ef0999aa298d8173da6b693d548e",
      "skos:note": "The Minister may delegate powers and functions to the CEO."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Delegation by Minister",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "(1)\nThe Minister may, by writing, delegate all or any of his or her powers\nand functions under this Schedule to the CEO.\n\nTransitional provisions  Schedule 2\nOther matters  Part 5"
    },
