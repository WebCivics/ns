    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-8-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Constitution of the Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-8-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.9",
      "values:originalText": "The Commission consists of:\n\n(a) a Chair; and\n\n(b) 6 other Commissioners.\n\nSchedule 1  Amendments\n\n6            Australian Centre for International Agricultural Research Amendment Act 2007       No.\n115, 2007",
      "skos:definition": "The Commission consists of:\n\n(a) a Chair; and\n\n(b) 6 other Commissioners.\n\nSchedule 1  Amendments\n\n6            Australian Centre for International Agricultural Research Amendment Act 2007       No.\n115, 2007",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-8-2-norm"
        }
      ],
      "cml:integrityHash": "b67dd89c4e8639aa2794ea33a26bc2493e42eccb13c26e1fd01760b840d7f3fb",
      "skos:note": "Defines Commission structure"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-8-2",
      "@type": "cof:Section",
      "cof:title": "8 Constitution of the Commission",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "The Commission consists of:\n\n(a) a Chair; and\n\n(b) 6 other Commissioners.\n\nSchedule 1  Amendments\n\n6            Australian Centre for International Agricultural Research Amendment Act 2007       No.\n115, 2007"
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-8-2-norm",
