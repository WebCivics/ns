    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29e-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "exclusion",
      "cml:logicSummary": "Exclusion of direction by the Commission",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO is not subject to direction by the Commission.",
      "cml:conclusionText": "The CEO's performance of functions and exercise of powers are exempt from Commission direction."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29e-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relationship between CEO's exemption and Commission direction",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO is not subject to direction by the Commission in relation to certain matters.",
      "cml:conclusionText": "The CEO's performance of functions and exercise of powers are exempt from Commission direction during the period when they relate to certain matters."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29e-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Temporal relationship between CEO's exemption and Commission direction",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO is not subject to direction by the Commission in relation to certain matters.",
      "cml:conclusionText": "The CEO's performance of functions and exercise of powers are exempt from Commission direction until they relate to certain matters."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29e-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if-then",
      "cml:logicSummary": "Conditional relationship between CEO's exemption and Commission direction",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO is not subject to direction by the Commission in relation to certain matters.",
      "cml:conclusionText": "If the CEO's performance of functions relates to certain matters, then they are exempt from Commission direction."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29e-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "classification",
      "cml:logicSummary": "Classification of CEO's exemption as a rule",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO is not subject to direction by the Commission in relation to certain matters.",
      "cml:conclusionText": "The CEO's performance of functions and exercise of powers are exempt from Commission direction if they relate to certain matters, which can be classified as a rule."
    },
