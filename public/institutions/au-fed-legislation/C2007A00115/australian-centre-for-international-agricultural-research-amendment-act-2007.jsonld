    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Subsections 5(2) and (3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.8",
      "values:originalText": "Repeal the subsections, substitute:\n\n(2) The CEO must, in performing his or her functions with respect to\nagricultural research, have regard to the need for persons or\ninstitutions in developing countries to share in that research.\n\n(3) Nothing in this section authorises, or permits, the CEO to carry out\nresearch on behalf of the Commonwealth.\n\n(4) The CEO must, in performing his or her functions, comply with\nany directions given to the CEO under section 5A.",
      "skos:definition": "Repeal the subsections, substitute:\n\n(2) The CEO must, in performing his or her functions with respect to\nagricultural research, have regard to the need for persons or\ninstitutions in developing countries to share in that research.\n\n(3) Nothing in this section authorises, or permits, the CEO to carry out\nresearch on behalf of the Commonwealth.\n\n(4) The CEO must, in performing his or her functions, comply with\nany directions given to the CEO under section 5A.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-14-ss-2"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-14-ss-3"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-14-ss-4"
        }
      ],
      "cml:integrityHash": "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Subsections 5(2) and (3)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the subsections, substitute:\n\n(2) The CEO must, in performing his or her functions with respect to\nagricultural research, have regard to the need for persons or\ninstitutions in developing countries to share in that research.\n\n(3) Nothing in this section authorises, or permits, the CEO to carry out\nresearch on behalf of the Commonwealth.\n\n(4) The CEO must, in performing his or her functions, comply with\nany directions given to the CEO under section 5A."
    },
