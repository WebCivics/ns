    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.33",
      "values:originalText": "(1)\nThe Governor-General may make regulations prescribing matters:\n\n(a) required or permitted by this Schedule to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Schedule.\n(2)\nThe Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to the amendments or repeals made by Schedule 1\nto this Act.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 10 May 2007\nSenate on 12 June 2007]\n\n(50/07)",
      "skos:definition": "(1)\nThe Governor-General may make regulations prescribing matters:\n\n(a) required or permitted by this Schedule to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Schedule.\n(2)\nThe Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to the amendments or repeals made by Schedule 1\nto this Act.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 10 May 2007\nSenate on 12 June 2007]\n\n(50/07)",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-19-norm"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9e5c8313285eee9fcc6b1aa3d690db790f901ae2f2ba4d1627312375d9cf5706",
      "skos:note": "Regulations may be prescribed by the Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Regulations",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "(1)\nThe Governor-General may make regulations prescribing matters:\n\n(a) required or permitted by this Schedule to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Schedule.\n(2)\nThe Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to the amendments or repeals made by Schedule 1\nto this Act.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 10 May 2007\nSenate on 12 June 2007]\n\n(50/07)"
    },
