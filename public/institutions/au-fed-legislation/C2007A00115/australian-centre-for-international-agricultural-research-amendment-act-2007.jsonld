    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29a",
      "@type": "cml:Concept",
      "skos:prefLabel": "29A Leave of absence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-29a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.17",
      "values:originalText": "(1) The CEO has the recreation leave entitlements that are determined\nby the Remuneration Tribunal.\n\nSchedule 1  Amendments\n\n14            Australian Centre for International Agricultural Research Amendment Act 2007       No.\n115, 2007\n\n(2) The Minister may grant the CEO leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.",
      "skos:definition": "(1) The CEO has the recreation leave entitlements that are determined\nby the Remuneration Tribunal.\n\nSchedule 1  Amendments\n\n14            Australian Centre for International Agricultural Research Amendment Act 2007       No.\n115, 2007\n\n(2) The Minister may grant the CEO leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29a-ss-1"
        },
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-29a-ss-2"
        }
      ],
      "cml:integrityHash": "a68c3dac2561e59f779699a271a42d2e8cd9a4d053e3c14fcc96ea3e3ff8247e"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-29a",
      "@type": "cof:Section",
      "cof:title": "29A Leave of absence",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "(1) The CEO has the recreation leave entitlements that are determined\nby the Remuneration Tribunal.\n\nSchedule 1  Amendments\n\n14            Australian Centre for International Agricultural Research Amendment Act 2007       No.\n115, 2007\n\n(2) The Minister may grant the CEO leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines."
    },
