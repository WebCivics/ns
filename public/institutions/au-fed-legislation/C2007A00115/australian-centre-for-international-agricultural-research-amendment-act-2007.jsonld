    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-16b",
      "@type": "cml:Concept",
      "skos:prefLabel": "16B Disclosure of interests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-1-sec-16b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.12",
      "values:originalText": "Disclosure to Minister\n\n(1) A Commissioner must give written notice to the Minister of any\ndirect or indirect pecuniary interest that the Commissioner has or\nacquires and that conflicts or could conflict with the proper\nperformance of the Commissioner’s functions.\nDisclosure to Commission\n\n(2) A Commissioner who has a direct or indirect pecuniary interest in\na matter being considered or about to be considered by the\nCommission must disclose the nature of the interest to a meeting of\nthe Commission.\n\n(3) The disclosure under subsection (2) must be made as soon as\npossible after the relevant facts have come to the Commissioner’s\nknowledge.\n\n(4) The disclosure under subsection (2) must be recorded in the\nminutes of the meeting of the Commission.\n\n(5) The Commissioner:\n\nAmendments  Schedule 1\n\n2007            9\n\n(a) must not be present during any deliberation by the\nCommission on the matter; and\n\n(b) must not take part in any decision of the Commission with\nrespect to the matter.",
      "skos:definition": "Disclosure to Minister\n\n(1) A Commissioner must give written notice to the Minister of any\ndirect or indirect pecuniary interest that the Commissioner has or\nacquires and that conflicts or could conflict with the proper\nperformance of the Commissioner’s functions.\nDisclosure to Commission\n\n(2) A Commissioner who has a direct or indirect pecuniary interest in\na matter being considered or about to be considered by the\nCommission must disclose the nature of the interest to a meeting of\nthe Commission.\n\n(3) The disclosure under subsection (2) must be made as soon as\npossible after the relevant facts have come to the Commissioner’s\nknowledge.\n\n(4) The disclosure under subsection (2) must be recorded in the\nminutes of the meeting of the Commission.\n\n(5) The Commissioner:\n\nAmendments  Schedule 1\n\n2007            9\n\n(a) must not be present during any deliberation by the\nCommission on the matter; and\n\n(b) must not take part in any decision of the Commission with\nrespect to the matter.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-1-sec-16b-ss-1"
        },
