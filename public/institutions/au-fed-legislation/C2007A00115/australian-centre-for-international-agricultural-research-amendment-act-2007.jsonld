    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Substitution of Commonwealth as a party to pending",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf"
      },
      "dc:source": "australian-centre-for-international-agricultural-research-amendment-act-2007.pdf, p.25",
      "values:originalText": "proceedings\nIf any proceedings to which the Centre was a party were pending in any\ncourt or tribunal immediately before the commencement time, the\nCommonwealth is substituted for the Centre, from the commencement\ntime, as a party to the proceedings.",
      "skos:definition": "proceedings\nIf any proceedings to which the Centre was a party were pending in any\ncourt or tribunal immediately before the commencement time, the\nCommonwealth is substituted for the Centre, from the commencement\ntime, as a party to the proceedings.",
      "cml:asserts": [
        {
          "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-6-norm"
        }
      ],
      "cml:integrityHash": "8ef07ec2275f363aaf9e8d534a8259890ed49cc9c2c8ed56040399dec170aa9b",
      "skos:note": "Substitution of Commonwealth as a party to pending proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-centre-for-international-agricultural-research-amendment-act-2007#sch-2-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Substitution of Commonwealth as a party to pending",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "proceedings\nIf any proceedings to which the Centre was a party were pending in any\ncourt or tribunal immediately before the commencement time, the\nCommonwealth is substituted for the Centre, from the commencement\ntime, as a party to the proceedings."
    },
    {
      "@id": "concept:australian-centre-for-international-agricultural-research-amendment-act-2007-sch-2-sec-6-norm",
      "@type": "values:Undertaking",
