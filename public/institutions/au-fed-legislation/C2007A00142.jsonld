      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the request has effect after that commencement as if it were a request made under that subsection after that commencement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Preserves the effect of requests and authorizations.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Preservation",
      "cml:premiseText": "(a) a request was made under subsection 40(1) of the Australian Citizenship Act 2007 before the commencement of this item;"
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-13-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the request has effect after that commencement as if it were a request made under that subsection after that commencement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Preserves the effect of authorizations.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Preservation",
      "cml:premiseText": "(2) An authorisation in force under subsection 40(3) or (4) of the Australian Citizenship Act 2007 immediately before the commencement of this item has effect after that commencement as if it were an authorisation made under that subsection immediately after that commencement."
    },
