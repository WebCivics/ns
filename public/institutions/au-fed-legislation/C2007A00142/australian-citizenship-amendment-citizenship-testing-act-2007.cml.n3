concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-23a-ss-3 a cml:Concept ;
    skos:prefLabel "23A(3) Citizenship test"@en ;
    cml:realizedBy doc:sch-1-sec-23a-ss-3 ;
    values:originalText "(3) A determination under subsection (1) may set out the eligibility criteria a person must satisfy to be able to sit the test. Note: The eligibility criteria for sitting the test cannot be inconsistent with this Act and in particular subsection 21(2) (about the general eligibility criteria for becoming an Australian citizen)." ;
    skos:definition "(3) A determination under subsection (1) may set out the eligibility criteria a person must satisfy to be able to sit the test. Note: The eligibility criteria for sitting the test cannot be inconsistent with this Act and in particular subsection 21(2) (about the general eligibility criteria for becoming an Australian citizen)."@en ;
    cml:integrityHash "31a055f901f65d3cb8194eb898d83298aa113b67e923f1d1a6bf53397030b2d3" ;
    values:partOf concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-23a ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Eligibility criteria for sitting the test must satisfy subsection 21(2)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
