    {
      "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Subsection 40(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sch-1-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
