      "cml:integrityHash": "a28b6ee8a458ab3d73bfe615e50b53a077943c0c1d5b0b44a7dc2aab0f865330",
      "skos:note": "Must have sat a test approved in a determination under section 23A and successfully completed it."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sch-1-sec-4-ss-2a",
      "@type": "cof:Section",
      "cof:title": "4(2A) Subsection 21(2)",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(2A) Paragraphs (2)(d), (e) and (f) are taken to be satisfied if and only if\nthe Minister is satisfied that the person has, before making the\napplication:\n\n(a) sat a test approved in a determination under section 23A; and\n\n(b) successfully completed that test (worked out in accordance\nwith that determination)."
    },
