    {
      "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Transitional",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sch-1-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-testing-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-testing-act-2007.pdf, p.10",
      "values:originalText": "(1)\nIf:\n\n(a) a request was made under subsection 40(1) of the Australian\nCitizenship Act 2007 before the commencement of this item;\nand\n\n(b) the request had not been complied with before that\ncommencement;\nthe request has effect after that commencement as if it were a request\nmade under that subsection after that commencement.\n\nAmendments  Schedule 1\n\n(2)\nAn authorisation in force under subsection 40(3) or (4) of the Australian\nCitizenship Act 2007 immediately before the commencement of this\nitem has effect after that commencement as if it were an authorisation\nmade under that subsection immediately after that commencement.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2007\nSenate on 8 August 2007]\n\n(103/07)",
      "skos:definition": "(1)\nIf:\n\n(a) a request was made under subsection 40(1) of the Australian\nCitizenship Act 2007 before the commencement of this item;\nand\n\n(b) the request had not been complied with before that\ncommencement;\nthe request has effect after that commencement as if it were a request\nmade under that subsection after that commencement.\n\nAmendments  Schedule 1\n\n(2)\nAn authorisation in force under subsection 40(3) or (4) of the Australian\nCitizenship Act 2007 immediately before the commencement of this\nitem has effect after that commencement as if it were an authorisation\nmade under that subsection immediately after that commencement.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2007\nSenate on 8 August 2007]\n\n(103/07)",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-13-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-13-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-13-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "ac04226fbb77aa751ec365256c08e2995c190ab26bada1a2732ae56cd31413a0",
      "skos:note": "Preserves effect of requests and authorizations made before commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sch-1-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Transitional",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1)\nIf:\n\n(a) a request was made under subsection 40(1) of the Australian\nCitizenship Act 2007 before the commencement of this item;\nand\n\n(b) the request had not been complied with before that\ncommencement;\nthe request has effect after that commencement as if it were a request\nmade under that subsection after that commencement.\n\nAmendments  Schedule 1\n\n(2)\nAn authorisation in force under subsection 40(3) or (4) of the Australian\nCitizenship Act 2007 immediately before the commencement of this\nitem has effect after that commencement as if it were an authorisation\nmade under that subsection immediately after that commencement.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2007\nSenate on 8 August 2007]\n\n(103/07)"
    },
