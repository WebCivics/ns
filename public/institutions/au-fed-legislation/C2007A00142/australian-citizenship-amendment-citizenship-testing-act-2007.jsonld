    {
      "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-testing-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-testing-act-2007.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sec-3-norm"
        }
      ],
      "cml:integrityHash": "608ff0d9999c7428d7699666117ef2a05836db52e5f5dc72a5d7ce8dfd65f70d",
      "skos:note": "Amendments to Acts specified in a Schedule"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1"
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sec-3-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sec-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 2A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-testing-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-testing-act-2007.pdf, p.7",
      "values:originalText": "Omit:\nThe third is citizenship by conferral. Generally, you would need to\nbe a permanent resident and willing to make a pledge of\ncommitment to apply for citizenship by conferral. There are some\nless common circumstances in which you can apply for citizenship\nby conferral. Citizenship by conferral is covered by Subdivision B.\nsubstitute:\nThe third is citizenship by conferral. Generally, you would need to\nbe a permanent resident and willing to make a pledge of\ncommitment to apply for citizenship by conferral. You may need to\nsuccessfully complete a citizenship test. There are some less\ncommon circumstances in which you can apply for citizenship by\nconferral. Citizenship by conferral is covered by Subdivision B.",
      "skos:definition": "Omit:\nThe third is citizenship by conferral. Generally, you would need to\nbe a permanent resident and willing to make a pledge of\ncommitment to apply for citizenship by conferral. There are some\nless common circumstances in which you can apply for citizenship\nby conferral. Citizenship by conferral is covered by Subdivision B.\nsubstitute:\nThe third is citizenship by conferral. Generally, you would need to\nbe a permanent resident and willing to make a pledge of\ncommitment to apply for citizenship by conferral. You may need to\nsuccessfully complete a citizenship test. There are some less\ncommon circumstances in which you can apply for citizenship by\nconferral. Citizenship by conferral is covered by Subdivision B.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "913445effb48a19d499aaaaf1b04f7a5c19e80c004807e16b4c364a8a43f9b4f",
      "skos:note": "Citizenship by conferral requires a pledge of commitment."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Section 2A",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit:\nThe third is citizenship by conferral. Generally, you would need to\nbe a permanent resident and willing to make a pledge of\ncommitment to apply for citizenship by conferral. There are some\nless common circumstances in which you can apply for citizenship\nby conferral. Citizenship by conferral is covered by Subdivision B.\nsubstitute:\nThe third is citizenship by conferral. Generally, you would need to\nbe a permanent resident and willing to make a pledge of\ncommitment to apply for citizenship by conferral. You may need to\nsuccessfully complete a citizenship test. There are some less\ncommon circumstances in which you can apply for citizenship by\nconferral. Citizenship by conferral is covered by Subdivision B."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
