      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-testing-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-testing-act-2007.pdf, p.9",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) For the purposes of the Minister being satisfied of the identity of:\n\n(a) a person in relation to an application under this Part; or\n\n(b) a person who has sought to sit a test approved in a\ndetermination under section 23A;\nthe following persons may request the person, in writing, to\nprovide one or more specified personal identifiers:\n\n(c) the Minister;\n\n(d) a person authorised under subsection (3);\n\nSchedule 1  Amendments\n\n(e) a person who is included in a class of persons authorised\nunder subsection (4).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) For the purposes of the Minister being satisfied of the identity of:\n\n(a) a person in relation to an application under this Part; or\n\n(b) a person who has sought to sit a test approved in a\ndetermination under section 23A;\nthe following persons may request the person, in writing, to\nprovide one or more specified personal identifiers:\n\n(c) the Minister;\n\n(d) a person authorised under subsection (3);\n\nSchedule 1  Amendments\n\n(e) a person who is included in a class of persons authorised\nunder subsection (4).",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-6-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-6-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-testing-act-2007-sch-1-sec-6-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "76e8fb08a6e45a34136af0c05a3023953e1e8445d7d35ae0ce67bd630f354a2a",
      "skos:note": "Request for personal identifiers from individuals",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-testing-act-2007#sch-1-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Subsection 40(1)",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) For the purposes of the Minister being satisfied of the identity of:\n\n(a) a person in relation to an application under this Part; or\n\n(b) a person who has sought to sit a test approved in a\ndetermination under section 23A;\nthe following persons may request the person, in writing, to\nprovide one or more specified personal identifiers:\n\n(c) the Minister;\n\n(d) a person authorised under subsection (3);\n\nSchedule 1  Amendments\n\n(e) a person who is included in a class of persons authorised\nunder subsection (4)."
    },
