concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59e a cml:Concept ;
    skos:prefLabel "59E Disclosure with consent"@en ;
    cml:realizedBy doc:sch-1-sec-59e ;
    values:originalText "An ACMA official may disclose authorised disclosure information that relates to the affairs of a person if:  (a) the person has consented to the disclosure; and  (b) the disclosure is in accordance with that consent.  Schedule 1  Amendments" ;
    skos:definition "An ACMA official may disclose authorised disclosure information that relates to the affairs of a person if:  (a) the person has consented to the disclosure; and  (b) the disclosure is in accordance with that consent.  Schedule 1  Amendments"@en ;
