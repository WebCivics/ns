doc:sch-1-sec-59h-ss-1 a cof:Section ;
    cof:title "59H(1) Disclosure authorised by regulations" ;
    values:kind "subsection" ;
    values:originalText "(1) The regulations may:  (a) authorise an ACMA official to disclose authorised disclosure information in specified circumstances; and  (b) provide that the Chair may, by writing, impose conditions to be complied with in relation to the disclosure of authorised disclosure information in those circumstances." ;
    cof:pageNumber "12"^^xsd:integer .

concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59h-ss-2 a cml:Concept ;
    skos:prefLabel "59H(2) Disclosure authorised by regulations"@en ;
    cml:realizedBy doc:sch-1-sec-59h-ss-2 ;
    values:originalText "(2) An instrument made under regulations made for the purposes of paragraph (1)(b) that imposes conditions relating to one particular disclosure identified in the instrument is not a legislative instrument." ;
    skos:definition "(2) An instrument made under regulations made for the purposes of paragraph (1)(b) that imposes conditions relating to one particular disclosure identified in the instrument is not a legislative instrument."@en ;
    cml:integrityHash "ca82a1c2e1d96c0001a8aa2834a506b3cf6f120fe9bcddf7005772b0f657e322" ;
    values:partOf concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59h ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "An instrument made under regulations must not impose conditions on disclosure." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
