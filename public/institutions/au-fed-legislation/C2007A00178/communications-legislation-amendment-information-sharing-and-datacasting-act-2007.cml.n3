concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-9 a cml:Concept ;
    skos:prefLabel "9 Application of amendment"@en ;
    cml:realizedBy doc:sch-1-sec-9 ;
    values:originalText "The amendment of the Datacasting Charge (Imposition) Act 1998 made by this Division applies to the financial year starting on 1 July 2007 and later financial years.    Communications Legislation Amendment (Information Sharing and Datacasting) Act 2007 No. 178, 2007            11  [Minister’s second reading speech made in— House of Representatives on 20 June 2007 Senate on 17 August 2007]  (116/07)" ;
    skos:definition "The amendment of the Datacasting Charge (Imposition) Act 1998 made by this Division applies to the financial year starting on 1 July 2007 and later financial years.    Communications Legislation Amendment (Information Sharing and Datacasting) Act 2007 No. 178, 2007            11  [Minister’s second reading speech made in— House of Representatives on 20 June 2007 Senate on 17 August 2007]  (116/07)"@en ;
    cml:integrityHash "900ea1c5b101c729c39d6e5faaa648e88878ab7ca99f46478f890dff2a15f8ce" ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Amendment applies to financial years starting on 1 July 2007 and later." ;
