      "cml:integrityHash": "a85a45923db3a387f12b1eccbede4142ab57ab3251da0bc78ba9f5402c90afb3",
      "skos:note": "Note on table limitations"
    },
    {
      "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sec-29-2",
      "@type": "cof:Section",
      "cof:title": "29 September",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\npassed by both Houses of the Parliament and assented to. It will not be\nexpanded to deal with provisions inserted in this Act after assent.\n\n(2) Column 3 of the table contains additional information that is not\npart of this Act. Information in this column may be added to or\nedited in any published version of this Act."
    },
