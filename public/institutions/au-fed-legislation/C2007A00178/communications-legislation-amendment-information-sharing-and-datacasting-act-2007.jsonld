      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf"
      },
      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.11",
      "values:originalText": "An ACMA official may disclose authorised disclosure information\nthat relates to the affairs of a person if:\n\n(a) the person has consented to the disclosure; and\n\n(b) the disclosure is in accordance with that consent.\n\nSchedule 1  Amendments",
      "skos:definition": "An ACMA official may disclose authorised disclosure information\nthat relates to the affairs of a person if:\n\n(a) the person has consented to the disclosure; and\n\n(b) the disclosure is in accordance with that consent.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59e-norm"
        },
