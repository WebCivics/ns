    {
      "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59a",
      "@type": "cml:Concept",
      "skos:prefLabel": "59A Disclosure to Ministers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf"
      },
      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.9",
      "values:originalText": "(1) An ACMA official may disclose authorised disclosure information\nto the Minister.\n\n(2) An ACMA official may disclose to a Minister authorised\ndisclosure information that relates to a matter arising under a\nprovision of an Act that is administered by that Minister.\n\n(3) Subsection (2) does not limit subsection (1).",
      "skos:definition": "(1) An ACMA official may disclose authorised disclosure information\nto the Minister.\n\n(2) An ACMA official may disclose to a Minister authorised\ndisclosure information that relates to a matter arising under a\nprovision of an Act that is administered by that Minister.\n\n(3) Subsection (2) does not limit subsection (1).",
      "cml:hasPart": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59a-ss-1"
        },
