      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.10",
      "values:originalText": "(a) the Secretary of the Department that is administered by that\nMinister; or\n\n(b) an APS employee in that Department who is authorised, in\nwriting, by the Secretary of that Department for the purposes\nof this subsection.\n\n(3) Subsection (2) does not limit subsection (1).",
      "skos:definition": "(a) the Secretary of the Department that is administered by that\nMinister; or\n\n(b) an APS employee in that Department who is authorised, in\nwriting, by the Secretary of that Department for the purposes\nof this subsection.\n\n(3) Subsection (2) does not limit subsection (1).",
      "cml:asserts": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-2007-norm"
        }
      ],
      "cml:integrityHash": "ca19a36b58df79e6487c76949803a7a2dba40f14bf4123eea9dd76408a83664c",
      "skos:note": "Authorized APS employee may use Secretary's name"
    },
    {
      "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-2007",
      "@type": "cof:Section",
      "cof:title": "2007 No. 178, 2007",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(a) the Secretary of the Department that is administered by that\nMinister; or\n\n(b) an APS employee in that Department who is authorised, in\nwriting, by the Secretary of that Department for the purposes\nof this subsection.\n\n(3) Subsection (2) does not limit subsection (1)."
    },
