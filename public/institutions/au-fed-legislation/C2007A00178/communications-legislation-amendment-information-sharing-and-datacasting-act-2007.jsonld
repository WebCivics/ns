    {
      "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sec-3-2"
      },
