    {
      "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59k",
      "@type": "cml:Concept",
      "skos:prefLabel": "59K Relationship with Part 13 of the Telecommunications Act 1997",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf"
      },
      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.12",
      "values:originalText": "This Part does not authorise a disclosure of information that is\nprohibited by Part 13 of the Telecommunications Act 1997.\nNote:\nSubsection 299(1) (in Part 13) of the Telecommunications Act 1997\nprohibits an ACMA official who has received information as\ndescribed in that subsection from disclosing the information, except in\ncertain circumstances.\n\nAmendments  Schedule 1\nDisclosure by ACMA officials  Part 1\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            9",
      "skos:definition": "This Part does not authorise a disclosure of information that is\nprohibited by Part 13 of the Telecommunications Act 1997.\nNote:\nSubsection 299(1) (in Part 13) of the Telecommunications Act 1997\nprohibits an ACMA official who has received information as\ndescribed in that subsection from disclosing the information, except in\ncertain circumstances.\n\nAmendments  Schedule 1\nDisclosure by ACMA officials  Part 1\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            9",
      "cml:asserts": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59k-norm"
        },
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59k-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fa627d27703dfc6610b237e3c8e42d243ae0da1a48f2642b1f69167a1a305266",
      "skos:note": "Disclosure of information prohibited by Part 13 of the Telecommunications Act 1997"
    },
    {
      "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59k",
      "@type": "cof:Section",
      "cof:title": "59K Relationship with Part 13 of the Telecommunications Act 1997",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "This Part does not authorise a disclosure of information that is\nprohibited by Part 13 of the Telecommunications Act 1997.\nNote:\nSubsection 299(1) (in Part 13) of the Telecommunications Act 1997\nprohibits an ACMA official who has received information as\ndescribed in that subsection from disclosing the information, except in\ncertain circumstances.\n\nAmendments  Schedule 1\nDisclosure by ACMA officials  Part 1\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            9"
    },
