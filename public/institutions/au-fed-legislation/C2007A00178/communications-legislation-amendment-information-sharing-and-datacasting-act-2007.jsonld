      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf"
      },
      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.14",
      "values:originalText": "The amendment of the Datacasting Charge (Imposition) Act 1998 made\nby this Division applies to the financial year starting on 1 July 2007 and\nlater financial years.\n\n\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            11\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 20 June 2007\nSenate on 17 August 2007]\n\n(116/07)",
      "skos:definition": "The amendment of the Datacasting Charge (Imposition) Act 1998 made\nby this Division applies to the financial year starting on 1 July 2007 and\nlater financial years.\n\n\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            11\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 20 June 2007\nSenate on 17 August 2007]\n\n(116/07)",
      "cml:asserts": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-9-norm"
        }
      ],
      "cml:integrityHash": "900ea1c5b101c729c39d6e5faaa648e88878ab7ca99f46478f890dff2a15f8ce",
      "skos:note": "Amendment applies to financial years starting on 1 July 2007 and later."
    },
    {
      "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Application of amendment",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The amendment of the Datacasting Charge (Imposition) Act 1998 made\nby this Division applies to the financial year starting on 1 July 2007 and\nlater financial years.\n\n\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            11\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 20 June 2007\nSenate on 17 August 2007]\n\n(116/07)"
    },
