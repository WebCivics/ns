    {
      "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Application of amendment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-9"
      },
      "cml:curationStatus": {
