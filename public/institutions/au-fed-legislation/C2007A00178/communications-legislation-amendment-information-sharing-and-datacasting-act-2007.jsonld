    {
      "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59l",
      "@type": "cml:Concept",
      "skos:prefLabel": "59L Delegation of Chair’s powers under this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf"
      },
      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.13",
      "values:originalText": "(1) The Chair may, by writing, delegate to a member any or all of the\nChair’s functions and powers under:\n\n(a) this Part; or\n\n(b) regulations made for the purposes of section 59H.\n\n(2) In performing a function, or exercising a power, delegated under\nsubsection (1), the delegate must comply with any directions of the\nChair.",
      "skos:definition": "(1) The Chair may, by writing, delegate to a member any or all of the\nChair’s functions and powers under:\n\n(a) this Part; or\n\n(b) regulations made for the purposes of section 59H.\n\n(2) In performing a function, or exercising a power, delegated under\nsubsection (1), the delegate must comply with any directions of the\nChair.",
      "cml:hasPart": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59l-ss-1"
        },
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59l-ss-2"
        }
      ],
      "cml:integrityHash": "c59079e2c20c6f669c66723baa63b04d4b3f4c4a85d85a52ccb6e851585b2a27"
    },
    {
      "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59l",
      "@type": "cof:Section",
      "cof:title": "59L Delegation of Chair’s powers under this Part",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) The Chair may, by writing, delegate to a member any or all of the\nChair’s functions and powers under:\n\n(a) this Part; or\n\n(b) regulations made for the purposes of section 59H.\n\n(2) In performing a function, or exercising a power, delegated under\nsubsection (1), the delegate must comply with any directions of the\nChair."
    },
