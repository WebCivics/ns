      },
      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            3\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            3\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "3109ea9728dd1f7ae51bff306f76dcf7eb2dcaa8a42c659a38906a8113a395dc",
      "skos:note": "Amendments and repeals of Acts specified in a Schedule."
    },
    {
      "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nCommunications Legislation Amendment (Information Sharing and Datacasting) Act 2007\nNo. 178, 2007            3\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments"
    },
