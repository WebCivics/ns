    {
      "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59c",
      "@type": "cml:Concept",
      "skos:prefLabel": "59C Disclosure to Royal Commissions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf"
      },
      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.10",
      "values:originalText": "(1) An ACMA official may disclose authorised disclosure information\nto a Royal Commission (within the meaning of the Royal\nCommissions Act 1902).\n\n(2) The Chair may, by writing, impose conditions to be complied with\nin relation to authorised disclosure information disclosed under\nsubsection (1).\n\n(3) An instrument made under subsection (2) that imposes conditions\nrelating to one particular disclosure identified in the instrument is\nnot a legislative instrument.\n\n(4) Otherwise, an instrument made under subsection (2) is a legislative\ninstrument.",
      "skos:definition": "(1) An ACMA official may disclose authorised disclosure information\nto a Royal Commission (within the meaning of the Royal\nCommissions Act 1902).\n\n(2) The Chair may, by writing, impose conditions to be complied with\nin relation to authorised disclosure information disclosed under\nsubsection (1).\n\n(3) An instrument made under subsection (2) that imposes conditions\nrelating to one particular disclosure identified in the instrument is\nnot a legislative instrument.\n\n(4) Otherwise, an instrument made under subsection (2) is a legislative\ninstrument.",
      "cml:hasPart": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59c-ss-1"
        },
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59c-ss-2"
        },
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59c-ss-3"
        },
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59c-ss-4"
        }
      ],
      "cml:integrityHash": "2a78471e37b339c45f99e97d4782e72884a7dcccaf0d6e715dddd105e2e9dd26"
    },
    {
      "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59c",
      "@type": "cof:Section",
      "cof:title": "59C Disclosure to Royal Commissions",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) An ACMA official may disclose authorised disclosure information\nto a Royal Commission (within the meaning of the Royal\nCommissions Act 1902).\n\n(2) The Chair may, by writing, impose conditions to be complied with\nin relation to authorised disclosure information disclosed under\nsubsection (1).\n\n(3) An instrument made under subsection (2) that imposes conditions\nrelating to one particular disclosure identified in the instrument is\nnot a legislative instrument.\n\n(4) Otherwise, an instrument made under subsection (2) is a legislative\ninstrument."
    },
