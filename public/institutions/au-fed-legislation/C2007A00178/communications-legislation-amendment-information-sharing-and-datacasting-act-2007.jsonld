    {
      "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59g",
      "@type": "cml:Concept",
      "skos:prefLabel": "59G Disclosure of summaries and statistics",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf"
      },
      "dc:source": "communications-legislation-amendment-information-sharing-and-datacasting-act-2007.pdf, p.12",
      "values:originalText": "An ACMA official may disclose:\n\n(a) summaries of authorised disclosure information that are not\nlikely to enable the identification of a person; and\n\n(b) statistics derived from authorised disclosure information that\nare not likely to enable the identification of a person.",
      "skos:definition": "An ACMA official may disclose:\n\n(a) summaries of authorised disclosure information that are not\nlikely to enable the identification of a person; and\n\n(b) statistics derived from authorised disclosure information that\nare not likely to enable the identification of a person.",
      "cml:asserts": [
        {
          "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59g-norm"
        }
      ],
      "cml:integrityHash": "4a18fc2d134b3b8e0b7fef7682c575c525debf01c7d018f2ab793b29b9b53676",
      "skos:note": "Disclosure of summaries and statistics"
    },
    {
      "@id": "https://ns.webcivics.net/values/communications-legislation-amendment-information-sharing-and-datacasting-act-2007#sch-1-sec-59g",
      "@type": "cof:Section",
      "cof:title": "59G Disclosure of summaries and statistics",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "An ACMA official may disclose:\n\n(a) summaries of authorised disclosure information that are not\nlikely to enable the identification of a person; and\n\n(b) statistics derived from authorised disclosure information that\nare not likely to enable the identification of a person."
    },
    {
      "@id": "concept:communications-legislation-amendment-information-sharing-and-datacasting-act-2007-sch-1-sec-59g-norm",
