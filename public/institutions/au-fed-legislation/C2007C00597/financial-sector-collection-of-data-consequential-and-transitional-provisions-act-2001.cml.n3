doc:sch-2-sec-7 a cof:Section ;
    cof:title "7 Subsection 56(1)" ;
    values:kind "section" ;
    values:originalText "Insert: registered entity means a corporation that is, or has at any time been, a registered entity within the meaning of the Financial Sector (Collection of Data) Act 2001." ;
    cof:pageNumber "9"^^xsd:integer .

