    cml:hasPart concept:financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001-sch-2-sec-78-2-ss-3 ;
    cml:hasPart concept:financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001-sch-2-sec-78-2-ss-4 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
