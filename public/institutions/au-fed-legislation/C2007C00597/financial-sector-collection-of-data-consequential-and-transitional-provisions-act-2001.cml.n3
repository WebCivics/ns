doc:sch-2-sec-78-2-ss-1 a cof:Section ;
    cof:title "78(1) Company’s financial statements to be prima facie evidence of" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if:  (a) a company registered under the Life Insurance Act 1995 had, under the Financial Sector (Collection of Data) Act 2001, given to APRA copies of financial statements for, or as at the end of, a particular accounting period; and  (b) an amount is shown in those statements as the total net liabilities in respect of all of the company’s contracts of life insurance as at the end of the accounting period." ;
    cof:pageNumber "30"^^xsd:integer .

