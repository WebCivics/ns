concept:financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001-sch-2-sec-6-2 a cml:Concept ;
    skos:prefLabel "6 Financial Sector (Collection of Data—Consequential and Transitional"@en ;
    cml:realizedBy doc:sch-2-sec-6-2 ;
    values:originalText "Provisions) Act 2001  (b) is determined by APRA under section 57 to be a document that does not contain confidential information; it is not an offence to disclose the document, or any information contained in the document, to any person (including to disclose the document by making it available for inspection by the public or to disclose the information by making a document containing the information so available). Note: A defendant bears an evidential burden in relation to matters in subsection (5C) (see section 13.3(3) of the Criminal Code)." ;
    skos:definition "Provisions) Act 2001  (b) is determined by APRA under section 57 to be a document that does not contain confidential information; it is not an offence to disclose the document, or any information contained in the document, to any person (including to disclose the document by making it available for inspection by the public or to disclose the information by making a document containing the information so available). Note: A defendant bears an evidential burden in relation to matters in subsection (5C) (see section 13.3(3) of the Criminal Code)."@en ;
    cml:integrityHash "48a5c65109eda0d1f522d2bb06c11a8c971deb46d88aaeeb52f1e9b065249686" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Disclosure of confidential information is permitted." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001.pdf> ;
    dc:source "financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001.pdf, p.10" ;
    cml:asserts concept:financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001-sch-2-sec-6-2-norm .
