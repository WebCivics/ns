concept:financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001-sch-2-sec-45 a cml:Concept ;
    skos:prefLabel "45 Application"@en ;
    cml:realizedBy doc:sch-2-sec-45 ;
    values:originalText "The amendments made by this Part apply only on and after the day on which the reporting standards determined under section 13 of the Financial Sector (Collection of Data) Act 2001 begin to apply under section 15 of that Act to financial sector entities (within the meaning of that Act) whose sole or principal business in Australia is insurance business (within the meaning of the Insurance Act 1973).  Schedule 2  Amendments" ;
    skos:definition "The amendments made by this Part apply only on and after the day on which the reporting standards determined under section 13 of the Financial Sector (Collection of Data) Act 2001 begin to apply under section 15 of that Act to financial sector entities (within the meaning of that Act) whose sole or principal business in Australia is insurance business (within the meaning of the Insurance Act 1973).  Schedule 2  Amendments"@en ;
    cml:integrityHash "8fe1026ca1069da992937bc8493f72ecf00e0043c6c29407481a37026089cf36" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Amendments apply on and after a specific date to financial sector entities with sole or principal business in insurance." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001.pdf> ;
