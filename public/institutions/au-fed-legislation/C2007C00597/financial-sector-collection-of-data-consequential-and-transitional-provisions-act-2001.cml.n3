concept:financial-sector-collection-of-data-consequential-and-transitional-provisions-act-2001-sch-2-sec-18 a cml:Concept ;
    skos:prefLabel "18 Application"@en ;
    cml:realizedBy doc:sch-2-sec-18 ;
    values:originalText "(1) The amendments made by this Part apply to a financial sector entity (within the meaning of the Financial Sector (Collection of Data) Act 2001) that is a body referred to in subitem (2) only on and after the day on which the reporting standards determined under section 13 of that Act begin to apply under section 15 of that Act to a class or kind of financial sector entities in which that body is included. (2) The bodies are:  Schedule 2  Amendments" ;
    skos:definition "(1) The amendments made by this Part apply to a financial sector entity (within the meaning of the Financial Sector (Collection of Data) Act 2001) that is a body referred to in subitem (2) only on and after the day on which the reporting standards determined under section 13 of that Act begin to apply under section 15 of that Act to a class or kind of financial sector entities in which that body is included. (2) The bodies are:  Schedule 2  Amendments"@en ;
    cml:integrityHash "ddd0a85f61d36e4ee822f9594ec15daad4b691d1911c5735930a4d56462ef25d" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Application of amendments to financial sector entities" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
