    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.74",
      "skos:note": "The Attorney-General may issue a warrant for the interception of communications.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "9(1) Subsection 11B(1)"
      },
      "wasDerivedFrom": "telecommunications-interception-amendment-act-2006.pdf",
      "asserts": [
        "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-norm",
        "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-deontic-1",
        "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-descriptionlogic-2",
        "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-alleninterval-3",
        "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-ltl-4",
        "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-deontic-5",
        "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-deontic-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "0bfc905c4843c65dcd15e7e58bda478dad594e937196f722e1a2c64d43e114db",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-interception-amendment-act-2006#sch-3-sec-9-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The warrant must be issued before the specified timeframe expires.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The warrant is issued within a specific timeframe.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "The Attorney-General is satisfied that the interception is necessary within a certain timeframe."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A warrant can be issued for the interception of communications.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permission granted by the Attorney-General.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:premiseText": "The Attorney-General may issue a warrant."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Attorney-General must issue a warrant if requested by the Director-General of Security.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Attorney-General has an obligation to issue a warrant if requested by the Director-General of Security.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The Director-General of Security gives a notice in writing to the Attorney-General requesting the Attorney-General to issue a warrant."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Attorney-General has permission to issue a warrant for the interception of communications.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Attorney-General has permission to issue a warrant for the interception of communications.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "The Attorney-General may, under his or her hand, issue a warrant in respect of a person."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Foreign intelligence is a matter specified in the notice.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Communications intercepted under this section are related to foreign intelligence.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:premiseText": "The warrant is issued for the purpose of obtaining foreign intelligence."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The warrant can be renewed for recurring interceptions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The warrant can be renewed for recurring interceptions.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "The Attorney-General may issue a warrant under this section authorising persons approved under section 12."
    },
