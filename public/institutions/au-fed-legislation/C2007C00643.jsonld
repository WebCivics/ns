    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person has no liability under this Act",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No limitation implies obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(1) This Part does not limit any liability (whether criminal or civil)"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must provide remedial relief even if convicted of an offence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No limitation implies obligation to provide remedial relief",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(1) This Part does not limit any liability (whether criminal or civil)"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must provide remedial relief even if they have other liabilities under this Act or other laws",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No limitation implies obligation to provide remedial relief for other liabilities",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(1) This Part does not limit any liability (whether criminal or civil)"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must provide remedial relief even if they have other liabilities under this Act or other laws, regardless of whether they are convicted of an offence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No limitation implies obligation to provide remedial relief for all liabilities",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(1) This Part does not limit any liability (whether criminal or civil)"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must provide remedial relief even if they have other liabilities under this Act or other laws, regardless of whether they are convicted of an offence and regardless of the type of liability",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
