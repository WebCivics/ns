    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.76",
      "skos:note": "The Attorney-General must not issue a warrant for interception of communications unless certain conditions are met.",
