    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Organisation must consider the practicability of interception at the time of application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Justification for warrant issuance requires consideration of practicable methods at the time of application",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Interception of communications made to or from a telecommunications service used, or likely to be used, by that person or foreign organisation would not otherwise be practicable."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Attorney-General must not issue a warrant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of warrant issuance without justification",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "The Attorney-General must issue a warrant."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Organisation must consider the foreign organisation's telecommunications services used or likely to be used.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Justification for warrant issuance requires consideration of foreign organisation's telecommunications services used or likely to be used",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "Interception of communications made to or from a telecommunications service used, or likely to be used, by that person or foreign organisation would not otherwise be practicable."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Organisation must consider its resources at the time of application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Justification for warrant issuance requires consideration of Organisation's resources at the time of application",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "There are no other practicable methods available to the Organisation at the time of making the application."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Organisation must consider the person or foreign organisation's telecommunications services used or likely to be used.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Justification for warrant issuance requires consideration of person or foreign organisation's telecommunications services used or likely to be used",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:premiseText": "Interception of communications made to or from a telecommunications service used, or likely to be used, by that person or foreign organisation would not otherwise be practicable."
    },
