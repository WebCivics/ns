    cof:pageNumber "88"^^xsd:integer ;
    skos:note "Ensure discontinuation of communications interceptions upon warrant revocation or proposed revocation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
