concept:telecommunications-interception-amendment-act-2006-sch-1-sec-149 a cml:Concept ;
    skos:prefLabel "149 Evidence that is otherwise inadmissible"@en ;
    cml:realizedBy doc:sch-1-sec-149 ;
    values:originalText "This Part does not render:  (a) information; or  (b) any record that was obtained by accessing a stored communication (whether or not in contravention of subsection 108(1)); admissible in evidence in a proceeding to a greater extent than it would have been admissible in evidence in that proceeding if this Part had not been enacted." ;
    skos:definition "This Part does not render:  (a) information; or  (b) any record that was obtained by accessing a stored communication (whether or not in contravention of subsection 108(1)); admissible in evidence in a proceeding to a greater extent than it would have been admissible in evidence in that proceeding if this Part had not been enacted."@en ;
    cml:integrityHash "6ad78a3f26e5c2532795ae3eb7a7e0f2eb8bbf93a2ac6873090536b6aff7d5c4" ;
    cof:pageNumber "37"^^xsd:integer ;
    skos:note "Exemptions from admissibility of evidence" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.37" ;
    cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-1-sec-149-norm .
