concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167 a cml:Concept ;
    skos:prefLabel "167 No limitation on other liability"@en ;
    cml:realizedBy doc:sch-1-sec-167 ;
    values:originalText "No limitation  (1) This Part does not limit any liability (whether criminal or civil) that a person has under any other provision of this Act or under any other law. Remedial relief even if defendant convicted of offence  (2) An application under subsection 165(3) or (4) may be made even if the defendant referred to in that subsection has been convicted of an offence under, or arising out of, this Act." ;
    skos:definition "No limitation  (1) This Part does not limit any liability (whether criminal or civil) that a person has under any other provision of this Act or under any other law. Remedial relief even if defendant convicted of offence  (2) An application under subsection 165(3) or (4) may be made even if the defendant referred to in that subsection has been convicted of an offence under, or arising out of, this Act."@en ;
    cml:integrityHash "18dae6580069428b312ee1c7f4fcfa82027a095a85e50cf6255b5aba7558ce01" ;
    cof:pageNumber "48"^^xsd:integer ;
    cml:hasPart concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-1 ;
    cml:hasPart concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
