concept:telecommunications-interception-amendment-act-2006-sch-3-sec-3 a cml:Concept ;
    skos:prefLabel "3 Subsection 5(1)"@en ;
    cml:realizedBy doc:sch-3-sec-3 ;
    values:originalText "Insert: telecommunications number means the address used by a carrier for the purposes of directing a communication to its intended destination and identifying the origin of the communication, and includes:  (a) a telephone number; and  (b) a mobile telephone number; and  (c) a unique identifier for a telecommunications device (for example, an electronic serial number or a Media Access Control address); and  (d) a user account identifier; and  (e) an Internet Protocol address; and  (f) an email address." ;
    skos:definition "Insert: telecommunications number means the address used by a carrier for the purposes of directing a communication to its intended destination and identifying the origin of the communication, and includes:  (a) a telephone number; and  (b) a mobile telephone number; and  (c) a unique identifier for a telecommunications device (for example, an electronic serial number or a Media Access Control address); and  (d) a user account identifier; and  (e) an Internet Protocol address; and  (f) an email address."@en ;
    cml:integrityHash "753cd5380f3ae148077e6c4b25db7f538c1810c9b85522616bd71bb0148501ff" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Definition of telecommunications number" ;
    cml:curationStatus cml:Proposed ;
