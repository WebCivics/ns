concept:telecommunications-interception-amendment-act-2006-sch-1-sec-145 a cml:Concept ;
    skos:prefLabel "145 Evidence that has been given in exempt proceeding"@en ;
    cml:realizedBy doc:sch-1-sec-145 ;
    values:originalText "If information is given in evidence in an exempt proceeding under section 143 or 144, that information, or any part of that information, may later be given in evidence in any proceeding. Note: This section was inserted as a response to the decision of the Court of Appeal of New South Wales in Wood v Beves (1997) 92 A Crim R 209.  Schedule 1  Stored communications" ;
    skos:definition "If information is given in evidence in an exempt proceeding under section 143 or 144, that information, or any part of that information, may later be given in evidence in any proceeding. Note: This section was inserted as a response to the decision of the Court of Appeal of New South Wales in Wood v Beves (1997) 92 A Crim R 209.  Schedule 1  Stored communications"@en ;
    cml:integrityHash "9647581ba24cf03ad2f158915175b4b276e99ddbe1548714b9cb08f22762a051" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Permits reuse of exempt proceeding evidence in other proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.35" ;
    cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-1-sec-145-norm .
