concept:telecommunications-interception-amendment-act-2006-sch-4-sec-7 a cml:Concept ;
    skos:prefLabel "7 Subsection 5D(1)"@en ;
    cml:realizedBy doc:sch-4-sec-7 ;
    values:originalText "Repeal the subsection, substitute: General types of serious offences  (1) An offence is a serious offence if it is:  (a) a murder, or an offence of a kind equivalent to murder; or  Class 1 and class 2 offences  Schedule 4 Amendments  Part 1  Telecommunications (Interception) Amendment Act 2006                   77  (b) a kidnapping, or an offence of a kind equivalent to kidnapping; or  (c) an offence against Division 307 of the Criminal Code; or  (d) an offence constituted by conduct involving an act or acts of terrorism; or  (e) an offence against Division 72, 101, 102 or 103 of the Criminal Code; or  (f) except for the purposes of an application for a warrant by an agency other than the ACC, an offence in relation to which the ACC is conducting a special investigation. Note: The heading to section 5D is replaced by the heading “Serious offences”." ;
    skos:definition "Repeal the subsection, substitute: General types of serious offences  (1) An offence is a serious offence if it is:  (a) a murder, or an offence of a kind equivalent to murder; or  Class 1 and class 2 offences  Schedule 4 Amendments  Part 1  Telecommunications (Interception) Amendment Act 2006                   77  (b) a kidnapping, or an offence of a kind equivalent to kidnapping; or  (c) an offence against Division 307 of the Criminal Code; or  (d) an offence constituted by conduct involving an act or acts of terrorism; or  (e) an offence against Division 72, 101, 102 or 103 of the Criminal Code; or  (f) except for the purposes of an application for a warrant by an agency other than the ACC, an offence in relation to which the ACC is conducting a special investigation. Note: The heading to section 5D is replaced by the heading “Serious offences”."@en ;
    cml:integrityHash "7bc5e1c7edf92ee7628bb5459a37ce47b17f2f7e229ef1439bb4a4b4b27d9eff" ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Defines serious offences" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.80" ;
