concept:telecommunications-interception-amendment-act-2006-sch-3-sec-18 a cml:Concept ;
    skos:prefLabel "18 Paragraph 46A(1)(d)"@en ;
    cml:realizedBy doc:sch-3-sec-18 ;
    values:originalText "Repeal the paragraph, substitute:  (d) information that would be likely to be obtained by intercepting under a warrant:  (i) communications made to or from any telecommunications service that the person is using, or is likely to use; or  (ii) communications made by means of a particular telecommunications device that a person is using, or is likely to use;  Schedule 3  Equipment-based interception" ;
    skos:definition "Repeal the paragraph, substitute:  (d) information that would be likely to be obtained by intercepting under a warrant:  (i) communications made to or from any telecommunications service that the person is using, or is likely to use; or  (ii) communications made by means of a particular telecommunications device that a person is using, or is likely to use;  Schedule 3  Equipment-based interception"@en ;
    cml:integrityHash "e7f179e5f0124500ae758d0f300af814b4884479748933dada10c115a1f0a40f" ;
    cof:pageNumber "77"^^xsd:integer ;
    skos:note "Repeal paragraph and substitute with prohibition on intercepting communications." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.77" ;
    cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-3-sec-18-norm .
