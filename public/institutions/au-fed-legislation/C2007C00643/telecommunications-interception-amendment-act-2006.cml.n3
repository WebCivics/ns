concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12 cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-6 .
concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-6 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Right" ;
    cml:logicSummary "Justification for warrant issuance requires consideration of person or foreign organisation's telecommunications services used or likely to be used" ;
    cml:premiseText "Interception of communications made to or from a telecommunications service used, or likely to be used, by that person or foreign organisation would not otherwise be practicable." ;
    cml:conclusionText "The Organisation must consider the person or foreign organisation's telecommunications services used or likely to be used." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-3-sec-12 a cof:Section ;
    cof:title "12 At the end of section 11B (before the note)" ;
    values:kind "section" ;
    values:originalText "Add:  (3) The Attorney-General must not issue a warrant that authorises interception of communications made by means of a telecommunications device identified in the warrant unless he or she is satisfied that:  (a) there are no other practicable methods available to the Organisation at the time of making the application to identify the telecommunications services used, or likely to be used, by the person or foreign organisation in respect of whom or which the warrant would be issued; or  (b) interception of communications made to or from a telecommunications service used, or likely to be used, by that person or foreign organisation would not otherwise be practicable." ;
    cof:pageNumber "76"^^xsd:integer .

