concept:telecommunications-interception-amendment-act-2006-sch-1-sec-131 a cml:Concept ;
    skos:prefLabel "131 Certified copies of stored communications warrants"@en ;
    cml:realizedBy doc:sch-1-sec-131 ;
    values:originalText "A document certified in writing by a certifying officer of an enforcement agency to be a true copy of a stored communications warrant is to be received in evidence in an exempt proceeding as if it were the original warrant." ;
    skos:definition "A document certified in writing by a certifying officer of an enforcement agency to be a true copy of a stored communications warrant is to be received in evidence in an exempt proceeding as if it were the original warrant."@en ;
    cml:integrityHash "375efcf44ee65fb7e0efce1f2d3c39119605f51fa868b8a81592a021595298d4" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Exempt proceeding must receive certified copy of stored communications warrant as if it were the original." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
