concept:telecommunications-interception-amendment-act-2006-sch-1-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 5(1)"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Insert: stored communication means a communication that:  (a) is not passing over a telecommunications system; and  (b) is held on equipment that is operated by, and is in the possession of, a carrier; and  (c) cannot be accessed on that equipment, by a person who is not a party to the communication, without the assistance of an employee of the carrier." ;
    skos:definition "Insert: stored communication means a communication that:  (a) is not passing over a telecommunications system; and  (b) is held on equipment that is operated by, and is in the possession of, a carrier; and  (c) cannot be accessed on that equipment, by a person who is not a party to the communication, without the assistance of an employee of the carrier."@en ;
    cml:integrityHash "4824a5b5a660dd81f9b5859136361b12902b4141f2ae600c2485f8092556b96e" ;
