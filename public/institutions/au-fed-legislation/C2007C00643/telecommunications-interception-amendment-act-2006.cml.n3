concept:telecommunications-interception-amendment-act-2006-sch-1-sec-114 a cml:Concept ;
    skos:prefLabel "114 Information to be given on telephone applications"@en ;
    cml:realizedBy doc:sch-1-sec-114 ;
    values:originalText "The information given to an issuing authority in connection with a telephone application to the issuing authority:  (a) must include particulars of the urgent circumstances because of which the person making the application on the agency’s  Schedule 1  Stored communications" ;
    skos:definition "The information given to an issuing authority in connection with a telephone application to the issuing authority:  (a) must include particulars of the urgent circumstances because of which the person making the application on the agency’s  Schedule 1  Stored communications"@en ;
