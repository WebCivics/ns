    values:originalText "(3) The warrant may be issued in relation to the investigation of more than one serious contravention." ;
    skos:definition "(3) The warrant may be issued in relation to the investigation of more than one serious contravention."@en ;
    cml:integrityHash "4671951117927a6375e25f4881eec9bc5b1b87d4b9f2c060a7a0e3601c375b16" ;
