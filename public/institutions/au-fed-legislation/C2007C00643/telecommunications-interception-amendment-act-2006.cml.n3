concept:telecommunications-interception-amendment-act-2006-sch-1-sec-161 a cml:Concept ;
    skos:prefLabel "161 Annual report by Minister about stored communications"@en ;
    cml:realizedBy doc:sch-1-sec-161 ;
    values:originalText "warrants  The Minister must, as soon as practicable after each 30 June, cause to be prepared a written report that relates to the year ending on that 30 June and complies with this Division." ;
    skos:definition "warrants  The Minister must, as soon as practicable after each 30 June, cause to be prepared a written report that relates to the year ending on that 30 June and complies with this Division."@en ;
