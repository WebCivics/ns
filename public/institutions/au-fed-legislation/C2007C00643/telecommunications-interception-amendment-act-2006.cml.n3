concept:telecommunications-interception-amendment-act-2006-sch-3-sec-20 a cml:Concept ;
    skos:prefLabel "20 Paragraph 46A(2)(a)"@en ;
    cml:realizedBy doc:sch-3-sec-20 ;
    values:originalText "Repeal the paragraph, substitute:  (a) how much the privacy of any person or persons would be likely to be interfered with by intercepting under a warrant:  (i) communications made to or from any telecommunications service used, or likely to be used, by the person in respect of whom the warrant is sought; or  (ii) communications made by means of a particular telecommunications device used, or likely to be used, by the person in respect of whom the warrant is sought;  as the case requires; and" ;
    skos:definition "Repeal the paragraph, substitute:  (a) how much the privacy of any person or persons would be likely to be interfered with by intercepting under a warrant:  (i) communications made to or from any telecommunications service used, or likely to be used, by the person in respect of whom the warrant is sought; or  (ii) communications made by means of a particular telecommunications device used, or likely to be used, by the person in respect of whom the warrant is sought;  as the case requires; and"@en ;
    cml:integrityHash "50df18e4a178db7b138ffba8af5ace56e87489663403309791500851fe2966f3" ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Specify the scope of interception under a warrant" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.78" ;
