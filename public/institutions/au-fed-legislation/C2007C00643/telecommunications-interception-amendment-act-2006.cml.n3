doc:sch-1-sec-8-ss-3 a cof:Section ;
    cof:title "8(3) Telecommunications (Interception) Amendment Act 2006" ;
    values:kind "subsection" ;
    values:originalText "(3) A person’s appointment ceases to have effect if:  (a) the person ceases to be a person whom the Minister could appoint under this section; or  (b) the Minister, by writing, revokes the appointment." ;
    cof:pageNumber "12"^^xsd:integer .

