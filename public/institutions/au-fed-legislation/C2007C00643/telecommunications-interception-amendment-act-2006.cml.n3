doc:sch-1-sec-5g-ss-2 a cof:Section ;
    cof:title "5G(2) The intended recipient of a communication" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not limit the circumstances in which a communication may be taken to be accessible to its intended recipient for the purposes of this Act." ;
    cof:pageNumber "10"^^xsd:integer .

