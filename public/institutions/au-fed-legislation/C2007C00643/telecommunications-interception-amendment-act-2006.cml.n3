concept:telecommunications-interception-amendment-act-2006-sch-1-sec-119-ss-5 a cml:Concept ;
    skos:prefLabel "119(5) Duration of stored communications warrants"@en ;
    cml:realizedBy doc:sch-1-sec-119-ss-5 ;
    values:originalText "(5) However, if the further warrant relates to the same telecommunications service as the previous warrant, it must not be issued within 3 days after the day on which the previous warrant was executed or (if subsection (2) applies) was last executed." ;
    skos:definition "(5) However, if the further warrant relates to the same telecommunications service as the previous warrant, it must not be issued within 3 days after the day on which the previous warrant was executed or (if subsection (2) applies) was last executed."@en ;
