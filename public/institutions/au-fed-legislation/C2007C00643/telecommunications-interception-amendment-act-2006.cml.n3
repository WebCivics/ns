concept:telecommunications-interception-amendment-act-2006-sch-1-sec-6eb a cml:Concept ;
    skos:prefLabel "6EB Stored communications warrant information"@en ;
    cml:realizedBy doc:sch-1-sec-6eb ;
    values:originalText "A reference in this Act to stored communications warrant information is a reference to:  (a) information about any of the following:  (i) an application for a stored communications warrant;  (ii) the issue of a stored communications warrant;  (iii) the existence or non-existence of a stored communications warrant;  (iv) the expiry of a stored communications warrant; or  (b) any other information that is likely to enable the identification of:  (i) the telecommunications service to which a stored communications warrant relates; or  (ii) a person specified in a stored communications warrant as a person using or likely to use the telecommunications service to which the warrant relates." ;
    skos:definition "A reference in this Act to stored communications warrant information is a reference to:  (a) information about any of the following:  (i) an application for a stored communications warrant;  (ii) the issue of a stored communications warrant;  (iii) the existence or non-existence of a stored communications warrant;  (iv) the expiry of a stored communications warrant; or  (b) any other information that is likely to enable the identification of:  (i) the telecommunications service to which a stored communications warrant relates; or  (ii) a person specified in a stored communications warrant as a person using or likely to use the telecommunications service to which the warrant relates."@en ;
    cml:integrityHash "33b092c941ac9f6e9586fd5a68eea3d61923448d46ca68a790bd14162ebca7ab" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Information about stored communications warrant applications, issues, existence, and expiry." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
