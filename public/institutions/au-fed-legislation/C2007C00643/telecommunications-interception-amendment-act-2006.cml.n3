concept:telecommunications-interception-amendment-act-2006-sch-2-sec-66 a cml:Concept ;
    skos:prefLabel "66 Telecommunications (Interception) Amendment Act 2006"@en ;
    cml:realizedBy doc:sch-2-sec-66 ;
    values:originalText "(ed) in relation to applications of a kind referred to in paragraph (a), (b), (c), (d) or (e), the relevant statistics about applications of that kind that relate to warrants in relation to which subparagraph 46(1)(d)(ii) would apply if the warrants were issued; and  (ee) how many Part 2-5 warrants issued during that year on application made by the agency or authority were warrants in relation to which subparagraph 46(1)(d)(ii) applied; and  (ef) how many Part 2-5 warrants renewed during that year on application made by the agency or authority were warrants in relation to which subparagraph 46(1)(d)(ii) applied; and" ;
    skos:definition "(ed) in relation to applications of a kind referred to in paragraph (a), (b), (c), (d) or (e), the relevant statistics about applications of that kind that relate to warrants in relation to which subparagraph 46(1)(d)(ii) would apply if the warrants were issued; and  (ee) how many Part 2-5 warrants issued during that year on application made by the agency or authority were warrants in relation to which subparagraph 46(1)(d)(ii) applied; and  (ef) how many Part 2-5 warrants renewed during that year on application made by the agency or authority were warrants in relation to which subparagraph 46(1)(d)(ii) applied; and"@en ;
    cml:integrityHash "585d5a79cba108646c73263cc706964bfd6064ca2700a0ea53772db7d55f0261" ;
    cof:pageNumber "70"^^xsd:integer ;
    skos:note "Relevant statistics about applications of a kind referred to in subparagraph 46(1)(d)(ii) must be provided." ;
    dc:description "True" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
