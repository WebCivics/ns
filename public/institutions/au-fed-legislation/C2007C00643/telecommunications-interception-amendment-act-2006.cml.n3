concept:telecommunications-interception-amendment-act-2006-sch-5-sec-25 a cml:Concept ;
    skos:prefLabel "25 Saving provision"@en ;
    cml:realizedBy doc:sch-5-sec-25 ;
    values:originalText "The General Register of Warrants kept by the Commissioner of Police before the commencement of this item is taken, after that commencement, to be the General Register of Warrants kept by the Secretary of the Department." ;
