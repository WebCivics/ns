concept:telecommunications-interception-amendment-act-2006-sch-5-sec-80 a cml:Concept ;
    skos:prefLabel "80 Commonwealth agencies to keep documents connected with issue"@en ;
    cml:realizedBy doc:sch-5-sec-80 ;
    values:originalText "of warrants  The chief officer of a Commonwealth agency must cause to be kept in the agency’s records:  (a) each warrant issued to the agency; and  (b) a copy of each notification under paragraph 53(1)(b) of the issue of such a warrant, being a notification given to the Secretary of the Department; and  (c) each instrument revoking such a warrant; and  (d) a copy of each certificate issued under subsection 61(4) by a certifying officer of the agency; and  (e) each authorisation by the chief officer under subsection 66(2).  Schedule 5  Transfer of functions" ;
    skos:definition "of warrants  The chief officer of a Commonwealth agency must cause to be kept in the agency’s records:  (a) each warrant issued to the agency; and  (b) a copy of each notification under paragraph 53(1)(b) of the issue of such a warrant, being a notification given to the Secretary of the Department; and  (c) each instrument revoking such a warrant; and  (d) a copy of each certificate issued under subsection 61(4) by a certifying officer of the agency; and  (e) each authorisation by the chief officer under subsection 66(2).  Schedule 5  Transfer of functions"@en ;
    cml:integrityHash "674d83448c8fcdcc27aa9cc22b6a9a4e8adf9b0f986be034a4962b02ec4662be" ;
    cof:pageNumber "89"^^xsd:integer ;
    skos:note "Keep documents connected with issue of warrants" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.89" ;
    cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-5-sec-80-norm .
