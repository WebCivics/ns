doc:sch-1-sec-154-ss-1 a cof:Section ;
    cof:title "154(1) Ombudsman’s general powers" ;
    values:kind "subsection" ;
    values:originalText "(1) Subject to section 133, the Ombudsman’s powers under the Ombudsman Act 1976 extend to an inspection by the Ombudsman under this Division as if the inspection were an investigation by the Ombudsman under that Act." ;
    cof:pageNumber "39"^^xsd:integer .

concept:telecommunications-interception-amendment-act-2006-sch-1-sec-154-ss-2 a cml:Concept ;
    skos:prefLabel "154(2) Ombudsman’s general powers"@en ;
    cml:realizedBy doc:sch-1-sec-154-ss-2 ;
    values:originalText "(2) The exercise of those powers in relation to an inspection by the Ombudsman under this Division is taken, for all purposes, to be an exercise of powers under the Ombudsman Act 1976." ;
    skos:definition "(2) The exercise of those powers in relation to an inspection by the Ombudsman under this Division is taken, for all purposes, to be an exercise of powers under the Ombudsman Act 1976."@en ;
