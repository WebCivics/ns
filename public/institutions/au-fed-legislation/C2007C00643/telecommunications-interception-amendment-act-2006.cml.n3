doc:sch-4-sec-13 a cof:Section ;
    cof:title "13 At the end of section 5D" ;
    values:kind "section" ;
    values:originalText "Add:  (7) An offence is also a serious offence if it is an offence constituted by receiving or assisting a person who is, to the offender’s knowledge, guilty of a serious offence mentioned in subsection (1),  Schedule 4  Class 1 and class 2 offences" ;
    cof:pageNumber "81"^^xsd:integer .

