concept:telecommunications-interception-amendment-act-2006-sch-1-sec-168 a cml:Concept ;
    skos:prefLabel "168 Concurrent operation of State and Territory laws"@en ;
    cml:realizedBy doc:sch-1-sec-168 ;
    values:originalText "This Part is not intended to exclude or limit the operation of a law of a State or Territory that is capable of operating concurrently with this Part." ;
    skos:definition "This Part is not intended to exclude or limit the operation of a law of a State or Territory that is capable of operating concurrently with this Part."@en ;
    cml:integrityHash "c3ab4572a33a313757d5e4ad0988c2c53d20856f07d4908f2a0f95248075c91f" ;
    cof:pageNumber "48"^^xsd:integer ;
    skos:note "No exclusion or limitation of State/Territory laws" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
