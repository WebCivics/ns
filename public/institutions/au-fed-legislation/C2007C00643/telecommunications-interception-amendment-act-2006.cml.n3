concept:telecommunications-interception-amendment-act-2006-sch-5-sec-26 a cml:Concept ;
    skos:prefLabel "26 Subsection 81B(1)"@en ;
    cml:realizedBy doc:sch-5-sec-26 ;
    values:originalText "Repeal the subsection, substitute:  (1) Within 3 months after the commencement of Schedule 5 to the Telecommunications (Interception) Amendment Act 2006, the Secretary of the Department must deliver the General Register to the Minister for inspection." ;
    skos:definition "Repeal the subsection, substitute:  (1) Within 3 months after the commencement of Schedule 5 to the Telecommunications (Interception) Amendment Act 2006, the Secretary of the Department must deliver the General Register to the Minister for inspection."@en ;
