concept:telecommunications-interception-amendment-act-2006-sch-2-sec-10 a cml:Concept ;
    skos:prefLabel "10 Subsection 49(3)"@en ;
    cml:realizedBy doc:sch-2-sec-10 ;
    values:originalText "Omit “a period of up to 90 days”, substitute: a period of:  (a) if subparagraph 46(1)(d)(ii) applies—up to 45 days; or  (b) otherwise—up to 90 days." ;
