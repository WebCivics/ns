concept:telecommunications-interception-amendment-act-2006-sch-1-sec-6aa a cml:Concept ;
    skos:prefLabel "6AA Accessing a stored communication"@en ;
    cml:realizedBy doc:sch-1-sec-6aa ;
    values:originalText "For the purposes of this Act, accessing a stored communication consists of listening to, reading or recording such a communication, by means of equipment operated by a carrier, without the knowledge of the intended recipient of the communication." ;
    skos:definition "For the purposes of this Act, accessing a stored communication consists of listening to, reading or recording such a communication, by means of equipment operated by a carrier, without the knowledge of the intended recipient of the communication."@en ;
    cml:integrityHash "fe5132aa077549d34ba314a77cd3faee89d9beff16c86608cec9ca75e1b1027c" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Accessing a stored communication without knowledge of the recipient is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.11" ;
