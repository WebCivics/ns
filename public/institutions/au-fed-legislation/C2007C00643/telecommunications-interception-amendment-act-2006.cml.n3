concept:telecommunications-interception-amendment-act-2006-sch-5-sec-47 a cml:Concept ;
    skos:prefLabel "47 Limit on authority conferred by warrant"@en ;
    cml:realizedBy doc:sch-5-sec-47 ;
    values:originalText "A warrant issued under section 46 or 46A does not authorise the interception of communications passing over a telecommunications system that a carrier operates unless:  (a) notification of the issue of the warrant has been received by or on behalf of the Managing Director of the carrier under subsection 60(1); and  (b) the interception takes place as a result of action taken by an employee of the carrier." ;
    skos:definition "A warrant issued under section 46 or 46A does not authorise the interception of communications passing over a telecommunications system that a carrier operates unless:  (a) notification of the issue of the warrant has been received by or on behalf of the Managing Director of the carrier under subsection 60(1); and  (b) the interception takes place as a result of action taken by an employee of the carrier."@en ;
    cml:integrityHash "eed21d0232645b87f307c3d77b75b84a8ec6b750f36e3d12fe2019b7ff66d785" ;
    cof:pageNumber "86"^^xsd:integer ;
    skos:note "Limit on authority conferred by warrant" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.86" ;
    cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-5-sec-47-norm .
