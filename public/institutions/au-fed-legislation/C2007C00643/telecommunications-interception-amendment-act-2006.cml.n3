concept:telecommunications-interception-amendment-act-2006-sch-5-sec-34 a cml:Concept ;
    skos:prefLabel "34 Saving provision"@en ;
    cml:realizedBy doc:sch-5-sec-34 ;
    values:originalText "A notice given under section 81E of the Telecommunications (Interception) Act 1979 that had effect immediately before the commencement of this Schedule has effect after that commencement as if it were a notice by the Secretary requiring the information concerned to be given to the Secretary.  Transfer of functions  Schedule 5  Telecommunications (Interception) Amendment Act 2006                   89" ;
    skos:definition "A notice given under section 81E of the Telecommunications (Interception) Act 1979 that had effect immediately before the commencement of this Schedule has effect after that commencement as if it were a notice by the Secretary requiring the information concerned to be given to the Secretary.  Transfer of functions  Schedule 5  Telecommunications (Interception) Amendment Act 2006                   89"@en ;
    cml:integrityHash "8588bbb201556d7b82393c954011a7b017856c65a4a80a7614de7a111f1c1690" ;
    cof:pageNumber "92"^^xsd:integer ;
    skos:note "Notice given under section 81E of the Telecommunications (Interception) Act 1979 has effect after commencement as if it were a notice by the Secretary." ;
    cml:curationStatus cml:Proposed ;
