concept:telecommunications-interception-amendment-act-2006-sch-3-sec-2 a cml:Concept ;
    skos:prefLabel "2 Subsection 5(1)"@en ;
    cml:realizedBy doc:sch-3-sec-2 ;
    values:originalText "Insert: telecommunications device means a terminal device that is capable of being used for transmitting or receiving a communication over a telecommunications system." ;
    skos:definition "Insert: telecommunications device means a terminal device that is capable of being used for transmitting or receiving a communication over a telecommunications system."@en ;
    cml:integrityHash "11700502cead130f019c54ece865d15b3bf4b8bb04ae159e3a256b5069b524bb" ;
