doc:sch-4-sec-32 a cof:Section ;
    cof:title "32 Continuation of warrants under sections 45 and 45A" ;
    values:kind "section" ;
    values:originalText "(1) A warrant that was issued before the commencement of this Schedule under section 45 of the Telecommunications (Interception) Act 1979 and that was in force immediately before that commencement continues in force after that commencement as if it had been issued under section 46 of that Act. (2) A warrant that was issued before the commencement of this Schedule under section 45A of the Telecommunications (Interception) Act 1979 and that was in force immediately before that commencement continues in force after that commencement as if it had been issued under section 46A of that Act." ;
    cof:pageNumber "84"^^xsd:integer .

concept:telecommunications-interception-amendment-act-2006-sch-4-sec-33 a cml:Concept ;
    skos:prefLabel "33 Warrants under sections 46, 46A and 48 unaffected"@en ;
    cml:realizedBy doc:sch-4-sec-33 ;
    values:originalText "The amendments of sections 46, 46A and 48 of the Telecommunications (Interception) Act 1979 made by this Schedule do not affect the validity of warrants issued under those sections before the commencement of this Schedule.  Class 1 and class 2 offences  Schedule 4 Transitional provisions  Part 2  Telecommunications (Interception) Amendment Act 2006                   81" ;
    skos:definition "The amendments of sections 46, 46A and 48 of the Telecommunications (Interception) Act 1979 made by this Schedule do not affect the validity of warrants issued under those sections before the commencement of this Schedule.  Class 1 and class 2 offences  Schedule 4 Transitional provisions  Part 2  Telecommunications (Interception) Amendment Act 2006                   81"@en ;
    cml:integrityHash "38824961a08cca560837ff4e453226ba8d66587cf8adb3cca6c21dd229eca7f5" ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Warrants under sections 46, 46A and 48 unaffected" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
