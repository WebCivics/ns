concept:telecommunications-interception-amendment-act-2006-sch-3-sec-6q a cml:Concept ;
    skos:prefLabel "6Q Identification of telecommunications device"@en ;
    cml:realizedBy doc:sch-3-sec-6q ;
    values:originalText "For the purposes of this Act, a telecommunications device may be identified by:  Equipment-based interception  Schedule 3  Telecommunications (Interception) Amendment Act 2006                   69  (a) a unique telecommunications number assigned to it from time to time; or  (b) any other unique identifying factor." ;
    skos:definition "For the purposes of this Act, a telecommunications device may be identified by:  Equipment-based interception  Schedule 3  Telecommunications (Interception) Amendment Act 2006                   69  (a) a unique telecommunications number assigned to it from time to time; or  (b) any other unique identifying factor."@en ;
    cml:integrityHash "fe6675169557677c39e899a85fbffdc6ff012f3ff320789c88844f9a44002aa1" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "A telecommunications device must be identified by a unique identifier." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
