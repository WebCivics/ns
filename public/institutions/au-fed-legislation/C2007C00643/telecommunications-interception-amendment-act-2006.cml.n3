concept:telecommunications-interception-amendment-act-2006-sch-5-sec-14 a cml:Concept ;
    skos:prefLabel "14 Subsection 58(1)"@en ;
    cml:realizedBy doc:sch-5-sec-14 ;
    values:originalText "Repeal the subsection, substitute:  (1) The chief officer of an agency must, on the revocation or proposed revocation of a warrant issued to the agency, forthwith take such steps as are necessary to ensure that interceptions of communications under the warrant are discontinued." ;
    skos:definition "Repeal the subsection, substitute:  (1) The chief officer of an agency must, on the revocation or proposed revocation of a warrant issued to the agency, forthwith take such steps as are necessary to ensure that interceptions of communications under the warrant are discontinued."@en ;
