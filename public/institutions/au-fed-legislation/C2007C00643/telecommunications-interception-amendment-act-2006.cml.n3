doc:sch-1-sec-168 a cof:Section ;
    cof:title "168 Concurrent operation of State and Territory laws" ;
    values:kind "section" ;
    values:originalText "This Part is not intended to exclude or limit the operation of a law of a State or Territory that is capable of operating concurrently with this Part." ;
    cof:pageNumber "48"^^xsd:integer .

concept:telecommunications-interception-amendment-act-2006-sch-1-sec-169 a cml:Concept ;
    skos:prefLabel "169 State or Territory courts—jurisdictional limits"@en ;
    cml:realizedBy doc:sch-1-sec-169 ;
    values:originalText "This Part does not enable an inferior court of a State or Territory to grant remedial relief of a kind that the court is unable to grant under the law of that State or Territory." ;
    skos:definition "This Part does not enable an inferior court of a State or Territory to grant remedial relief of a kind that the court is unable to grant under the law of that State or Territory."@en ;
    cml:integrityHash "0ded6e42698722b2507238c29f1d9ec4edc797b98820dd3a6ce0ae709f419cce" ;
    cof:pageNumber "48"^^xsd:integer ;
    skos:note "No inferior court can grant remedial relief beyond its jurisdiction." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
