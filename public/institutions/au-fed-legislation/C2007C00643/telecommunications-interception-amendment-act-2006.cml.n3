    cml:conclusionText "The communication is accessible to its intended recipient everywhere if it meets one of these conditions." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

