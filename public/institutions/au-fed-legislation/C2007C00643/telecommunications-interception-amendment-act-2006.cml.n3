concept:telecommunications-interception-amendment-act-2006-sch-1-sec-126 a cml:Concept ;
    skos:prefLabel "126 Limit on authority conferred by warrant"@en ;
    cml:realizedBy doc:sch-1-sec-126 ;
    values:originalText "A stored communications warrant does not authorise access to stored communications unless notification of the issue of the warrant has been received under section 121 by or on behalf of the Managing Director of the carrier holding the stored communications." ;
    skos:definition "A stored communications warrant does not authorise access to stored communications unless notification of the issue of the warrant has been received under section 121 by or on behalf of the Managing Director of the carrier holding the stored communications."@en ;
    cml:integrityHash "53c1391c0f67a776189d5771943fbfe61b1afb38df9bee31746083b50af20038" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Notification required for access to stored communications" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-amendment-act-2006.pdf> ;
    dc:source "telecommunications-interception-amendment-act-2006.pdf, p.24" ;
    cml:asserts concept:telecommunications-interception-amendment-act-2006-sch-1-sec-126-norm .
