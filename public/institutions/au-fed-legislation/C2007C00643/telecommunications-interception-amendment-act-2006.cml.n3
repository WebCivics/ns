concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5e-ss-1 a cml:Concept ;
    skos:prefLabel "5E(1) Serious contraventions"@en ;
    cml:realizedBy doc:sch-1-sec-5e-ss-1 ;
    values:originalText "(1) For the purposes of this Act, a communication:  (a) is taken to start passing over a telecommunications system when it is sent or transmitted by the person sending the communication; and  (b) is taken to continue to pass over the system until it becomes accessible to the intended recipient of the communication." ;
    skos:definition "(1) For the purposes of this Act, a communication:  (a) is taken to start passing over a telecommunications system when it is sent or transmitted by the person sending the communication; and  (b) is taken to continue to pass over the system until it becomes accessible to the intended recipient of the communication."@en ;
    cml:integrityHash "91aad5d541ee066771e318af3a0d400f1dcd41ad511bdea7ae0596f219f231c1" ;
    values:partOf concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5e ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Definition of communication start and end Serious contraventions are prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
