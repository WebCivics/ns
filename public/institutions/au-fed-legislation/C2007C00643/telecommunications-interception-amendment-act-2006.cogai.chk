  operator: hasAccess;
  summary: Has access to communication;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (a) has been received by the telecommunications service provided to the intended recipient; or (b) is under the control of the intended recipient; or (c) has been delivered to the telecommunications service provided to the intended recipient.;
