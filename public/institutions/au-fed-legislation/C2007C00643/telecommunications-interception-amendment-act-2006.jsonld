      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.92",
      "values:originalText": "A notice given under section 81E of the Telecommunications\n(Interception) Act 1979 that had effect immediately before the\ncommencement of this Schedule has effect after that commencement as\nif it were a notice by the Secretary requiring the information concerned\nto be given to the Secretary.\n\nTransfer of functions  Schedule 5\n\nTelecommunications (Interception) Amendment Act 2006                   89",
      "skos:definition": "A notice given under section 81E of the Telecommunications\n(Interception) Act 1979 that had effect immediately before the\ncommencement of this Schedule has effect after that commencement as\nif it were a notice by the Secretary requiring the information concerned\nto be given to the Secretary.\n\nTransfer of functions  Schedule 5\n\nTelecommunications (Interception) Amendment Act 2006                   89",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-34-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-34-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8588bbb201556d7b82393c954011a7b017856c65a4a80a7614de7a111f1c1690",
      "skos:note": "Notice given under section 81E of the Telecommunications (Interception) Act 1979 has effect after commencement as if it were a notice by the Secretary."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-34",
      "@type": "cof:Section",
