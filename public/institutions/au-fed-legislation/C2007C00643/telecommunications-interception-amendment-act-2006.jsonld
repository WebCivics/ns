    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-6q",
      "@type": "cml:Concept",
      "skos:prefLabel": "6Q Identification of telecommunications device",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-6q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.72",
      "values:originalText": "For the purposes of this Act, a telecommunications device may be\nidentified by:\n\nEquipment-based interception  Schedule 3\n\nTelecommunications (Interception) Amendment Act 2006                   69\n\n(a) a unique telecommunications number assigned to it from\ntime to time; or\n\n(b) any other unique identifying factor.",
      "skos:definition": "For the purposes of this Act, a telecommunications device may be\nidentified by:\n\nEquipment-based interception  Schedule 3\n\nTelecommunications (Interception) Amendment Act 2006                   69\n\n(a) a unique telecommunications number assigned to it from\ntime to time; or\n\n(b) any other unique identifying factor.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-6q-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-6q-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fe6675169557677c39e899a85fbffdc6ff012f3ff320789c88844f9a44002aa1",
      "skos:note": "A telecommunications device must be identified by a unique identifier."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-6q",
      "@type": "cof:Section",
      "cof:title": "6Q Identification of telecommunications device",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "For the purposes of this Act, a telecommunications device may be\nidentified by:\n\nEquipment-based interception  Schedule 3\n\nTelecommunications (Interception) Amendment Act 2006                   69\n\n(a) a unique telecommunications number assigned to it from\ntime to time; or\n\n(b) any other unique identifying factor."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-6q-norm",
