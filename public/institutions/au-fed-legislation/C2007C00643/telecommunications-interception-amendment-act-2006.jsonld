      },
      "cml:premiseText": "There are no other practicable methods available to the Organisation at the time of making the application.",
      "cml:conclusionText": "The Organisation must consider its resources at the time of application."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Right",
      "cml:logicSummary": "Justification for warrant issuance requires consideration of person or foreign organisation's telecommunications services used or likely to be used",
      "cml:executionSurface": "modalities::logic::deontic",
