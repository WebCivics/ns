    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-134",
      "@type": "cml:Concept",
      "skos:prefLabel": "134 Dealing in stored communications warrant information for the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-134"
      },
      "cml:curationStatus": {
