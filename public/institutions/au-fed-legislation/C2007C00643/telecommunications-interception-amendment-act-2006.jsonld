    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5g-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Includes AFP employees and their superiors.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) In addition to the person who is the intended recipient of a communication under subsection (1), if a communication is addressed to a person at an address on a computer network operated by or on behalf of the Australian Federal Police, each of the following is also an intended recipient of the communication for the purposes of this Act:",
      "cml:conclusionText": "(a) any AFP employee responsible for operating, protecting and maintaining the network;"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5g-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Includes enforcement personnel.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) In addition to the person who is the intended recipient of a communication under subsection (1), if a communication is addressed to a person at an address on a computer network operated by or on behalf of the Australian Federal Police, each of the following is also an intended recipient of the communication for the purposes of this Act:",
      "cml:conclusionText": "(b) any AFP employee responsible for enforcement of the professional standards of the Australian Federal Police;"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5g-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "During the operation and maintenance of the network.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
