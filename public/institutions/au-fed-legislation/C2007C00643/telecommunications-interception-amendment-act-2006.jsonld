        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-119-ss-1-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "4bc4a5df21a14df1d8d4504bf6c0bfbec7f35cd72e16aa230f06ad7372caede3",
      "skos:note": "A stored communications warrant remains in force until it is first executed or the end of 5 days after its issue, whichever occurs sooner."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-119-ss-1",
      "@type": "cof:Section",
      "cof:title": "119(1) Duration of stored communications warrants",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(1) A stored communications warrant remains in force:\n\n(a) until it is first executed; or\n\n(b) until the end of the period of 5 days after the day on which it\nwas issued;\nwhichever occurs sooner."
    },
