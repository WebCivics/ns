    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-114",
      "@type": "cml:Concept",
      "skos:prefLabel": "114 Information to be given on telephone applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-114"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.17",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\n\nSchedule 1  Stored communications",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\n\nSchedule 1  Stored communications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-114-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-114-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a5d340c424883fddf4df2b835e7391867393520114a0569d0b2300c939f85f1e",
      "skos:note": "Must provide information on telephone applications",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-114",
      "@type": "cof:Section",
      "cof:title": "114 Information to be given on telephone applications",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the agency’s\n\nSchedule 1  Stored communications"
    },
