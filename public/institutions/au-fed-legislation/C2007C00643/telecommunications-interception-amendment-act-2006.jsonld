    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-137-ss-3",
      "@type": "cof:Section",
      "cof:title": "137(3) Communicating information obtained by Organisation",
      "values:kind": "subsection",
      "cof:pageNumber": 31,
      "values:originalText": "(3) A person to whom foreign intelligence information has been\ncommunicated:\n\n(a) in accordance with subsection (1); or\n\n(b) in accordance with an approval given under this subsection;\nmay communicate that information to such persons, and in such\nmanner, as are approved in writing by the Attorney-General."
