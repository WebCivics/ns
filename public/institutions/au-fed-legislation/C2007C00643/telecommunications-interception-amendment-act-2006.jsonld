    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 At the end of section 9A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.74",
      "values:originalText": "Add:\n\n(3) The Attorney-General must not issue a warrant that authorises\ninterception of communications made by means of a\ntelecommunications device identified in the warrant unless he or\nshe is satisfied that:\n\n(a) there are no other practicable methods available to the\nOrganisation at the time of making the application to identify\nthe telecommunications services used, or likely to be used,\nby the person in respect of whom the warrant would be\nissued; or\n\n(b) interception of communications made to or from a\ntelecommunications service used, or likely to be used, by that\nperson would not otherwise be practicable.",
      "skos:definition": "Add:\n\n(3) The Attorney-General must not issue a warrant that authorises\ninterception of communications made by means of a\ntelecommunications device identified in the warrant unless he or\nshe is satisfied that:\n\n(a) there are no other practicable methods available to the\nOrganisation at the time of making the application to identify\nthe telecommunications services used, or likely to be used,\nby the person in respect of whom the warrant would be\nissued; or\n\n(b) interception of communications made to or from a\ntelecommunications service used, or likely to be used, by that\nperson would not otherwise be practicable.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-8-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-8-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-8-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "bfed6ae4f5651f61be20d1516215e8ae5c1f5a13a2b430f40468a2b504b09e17",
      "skos:note": "The Attorney-General must not issue a warrant for interception of communications without satisfying certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 At the end of section 9A",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "Add:\n\n(3) The Attorney-General must not issue a warrant that authorises\ninterception of communications made by means of a\ntelecommunications device identified in the warrant unless he or\nshe is satisfied that:\n\n(a) there are no other practicable methods available to the\nOrganisation at the time of making the application to identify\nthe telecommunications services used, or likely to be used,\nby the person in respect of whom the warrant would be\nissued; or\n\n(b) interception of communications made to or from a\ntelecommunications service used, or likely to be used, by that\nperson would not otherwise be practicable."
    },
