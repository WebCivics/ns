      "cml:integrityHash": "618fabc9ed0c280b981d03c0419fe70c2cac2b2b2af4f096dee867d524adbc39",
      "skos:note": "Ombudsman's powers under the Ombudsman Act 1976 extend to an inspection by the Ombudsman."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-154-ss-1",
