    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 At the end of subsection 9(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-2"
      },
      "cml:curationStatus": {
