      "cml:integrityHash": "b4fe93c6dedb5744511ae9b2776f27a19a31c2a03a3a724164854e8ca028a542",
      "skos:note": "A reasonable excuse is a valid reason for obstruction or hindering."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-132-ss-2",
      "@type": "cof:Section",
      "cof:title": "132(2) Obstruction",
      "values:kind": "subsection",
      "cof:pageNumber": 27,
      "values:originalText": "(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code)."
    },
