      "cml:integrityHash": "53e306050c42b939842f34f4afef8ec6555ca25c9c699fc5af373d5addf6972f",
      "skos:note": "Intended recipients of a communication addressed to an AFP employee or the Australian Federal Police. No limitation on accessibility for the purposes of this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-5g-ss-2",
      "@type": "cof:Section",
      "cof:title": "5G(2) The intended recipient of a communication",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(2) Subsection (1) does not limit the circumstances in which a\ncommunication may be taken to be accessible to its intended\nrecipient for the purposes of this Act."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5g-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
