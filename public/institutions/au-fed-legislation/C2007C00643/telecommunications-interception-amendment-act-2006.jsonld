    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-148",
      "@type": "cml:Concept",
      "skos:prefLabel": "148 Stored communications warrant information inadmissible",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-148"
      },
      "cml:curationStatus": {
