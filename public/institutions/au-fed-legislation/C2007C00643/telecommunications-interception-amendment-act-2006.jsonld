    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 At the end of section 11B (before the note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.76",
      "values:originalText": "Add:\n\n(3) The Attorney-General must not issue a warrant that authorises\ninterception of communications made by means of a\ntelecommunications device identified in the warrant unless he or\nshe is satisfied that:\n\n(a) there are no other practicable methods available to the\nOrganisation at the time of making the application to identify\nthe telecommunications services used, or likely to be used,\nby the person or foreign organisation in respect of whom or\nwhich the warrant would be issued; or\n\n(b) interception of communications made to or from a\ntelecommunications service used, or likely to be used, by that\nperson or foreign organisation would not otherwise be\npracticable.",
      "skos:definition": "Add:\n\n(3) The Attorney-General must not issue a warrant that authorises\ninterception of communications made by means of a\ntelecommunications device identified in the warrant unless he or\nshe is satisfied that:\n\n(a) there are no other practicable methods available to the\nOrganisation at the time of making the application to identify\nthe telecommunications services used, or likely to be used,\nby the person or foreign organisation in respect of whom or\nwhich the warrant would be issued; or\n\n(b) interception of communications made to or from a\ntelecommunications service used, or likely to be used, by that\nperson or foreign organisation would not otherwise be\npracticable.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-alleninterval-3"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-4"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-5"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-deontic-6"
        }
      ],
      "cml:integrityHash": "b81e3459a5ff791e8108252b30bf530c863acf226b0387f0a75cdc0867bdf26e",
      "skos:note": "The Attorney-General must not issue a warrant for interception of communications unless certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 At the end of section 11B (before the note)",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "Add:\n\n(3) The Attorney-General must not issue a warrant that authorises\ninterception of communications made by means of a\ntelecommunications device identified in the warrant unless he or\nshe is satisfied that:\n\n(a) there are no other practicable methods available to the\nOrganisation at the time of making the application to identify\nthe telecommunications services used, or likely to be used,\nby the person or foreign organisation in respect of whom or\nwhich the warrant would be issued; or\n\n(b) interception of communications made to or from a\ntelecommunications service used, or likely to be used, by that\nperson or foreign organisation would not otherwise be\npracticable."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
