    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167",
      "@type": "cml:Concept",
      "skos:prefLabel": "167 No limitation on other liability",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-167"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.48",
      "values:originalText": "No limitation\n\n(1) This Part does not limit any liability (whether criminal or civil) that\na person has under any other provision of this Act or under any\nother law.\nRemedial relief even if defendant convicted of offence\n\n(2) An application under subsection 165(3) or (4) may be made even if\nthe defendant referred to in that subsection has been convicted of\nan offence under, or arising out of, this Act.",
      "skos:definition": "No limitation\n\n(1) This Part does not limit any liability (whether criminal or civil) that\na person has under any other provision of this Act or under any\nother law.\nRemedial relief even if defendant convicted of offence\n\n(2) An application under subsection 165(3) or (4) may be made even if\nthe defendant referred to in that subsection has been convicted of\nan offence under, or arising out of, this Act.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-167-ss-2"
        }
      ],
      "cml:integrityHash": "18dae6580069428b312ee1c7f4fcfa82027a095a85e50cf6255b5aba7558ce01"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-167",
      "@type": "cof:Section",
      "cof:title": "167 No limitation on other liability",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "No limitation\n\n(1) This Part does not limit any liability (whether criminal or civil) that\na person has under any other provision of this Act or under any\nother law.\nRemedial relief even if defendant convicted of offence\n\n(2) An application under subsection 165(3) or (4) may be made even if\nthe defendant referred to in that subsection has been convicted of\nan offence under, or arising out of, this Act."
    },
