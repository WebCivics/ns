    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-66",
      "@type": "cml:Concept",
      "skos:prefLabel": "66 Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-66"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.70",
      "values:originalText": "(ed) in relation to applications of a kind referred to in\nparagraph (a), (b), (c), (d) or (e), the relevant statistics about\napplications of that kind that relate to warrants in relation to\nwhich subparagraph 46(1)(d)(ii) would apply if the warrants\nwere issued; and\n\n(ee) how many Part 2-5 warrants issued during that year on\napplication made by the agency or authority were warrants in\nrelation to which subparagraph 46(1)(d)(ii) applied; and\n\n(ef) how many Part 2-5 warrants renewed during that year on\napplication made by the agency or authority were warrants in\nrelation to which subparagraph 46(1)(d)(ii) applied; and",
      "skos:definition": "(ed) in relation to applications of a kind referred to in\nparagraph (a), (b), (c), (d) or (e), the relevant statistics about\napplications of that kind that relate to warrants in relation to\nwhich subparagraph 46(1)(d)(ii) would apply if the warrants\nwere issued; and\n\n(ee) how many Part 2-5 warrants issued during that year on\napplication made by the agency or authority were warrants in\nrelation to which subparagraph 46(1)(d)(ii) applied; and\n\n(ef) how many Part 2-5 warrants renewed during that year on\napplication made by the agency or authority were warrants in\nrelation to which subparagraph 46(1)(d)(ii) applied; and",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-66-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-66-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "585d5a79cba108646c73263cc706964bfd6064ca2700a0ea53772db7d55f0261",
      "skos:note": "Relevant statistics about applications of a kind referred to in subparagraph 46(1)(d)(ii) must be provided.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-66",
