        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General may, under his or her hand, issue a warrant in respect of a person.",
      "cml:conclusionText": "The Attorney-General has permission to issue a warrant for the interception of communications."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "9(1A) Subsection 11B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-9-ss-1a"
      },
      "cml:curationStatus": {
