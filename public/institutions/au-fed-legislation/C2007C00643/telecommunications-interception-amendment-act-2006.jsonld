    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-129-ss-3",
      "@type": "cof:Section",
      "cof:title": "129(3) Evidentiary certificates relating to actions by carriers",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
