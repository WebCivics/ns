          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-163-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c01f72332811aec2d3ed126e44474682c88ddef765f8dc341232420c20905d0d",
      "skos:note": "Report must provide information about arrests made on lawful accessed information",
      "dc:description": "Yes"
    },
    {
