    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
