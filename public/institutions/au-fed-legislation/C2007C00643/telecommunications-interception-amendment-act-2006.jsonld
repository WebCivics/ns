    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Subsection 58(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.88",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) The chief officer of an agency must, on the revocation or proposed\nrevocation of a warrant issued to the agency, forthwith take such\nsteps as are necessary to ensure that interceptions of\ncommunications under the warrant are discontinued.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) The chief officer of an agency must, on the revocation or proposed\nrevocation of a warrant issued to the agency, forthwith take such\nsteps as are necessary to ensure that interceptions of\ncommunications under the warrant are discontinued.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-14-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e6c2170987c67a0167def1528fcc65db12d552f8abd086a72ed305b95569e193",
      "skos:note": "Ensure discontinuation of communications interceptions upon warrant revocation or proposed revocation."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Subsection 58(1)",
      "values:kind": "section",
      "cof:pageNumber": 88,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) The chief officer of an agency must, on the revocation or proposed\nrevocation of a warrant issued to the agency, forthwith take such\nsteps as are necessary to ensure that interceptions of\ncommunications under the warrant are discontinued."
    },
