    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Subsection 81B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-26"
      },
      "cml:curationStatus": {
