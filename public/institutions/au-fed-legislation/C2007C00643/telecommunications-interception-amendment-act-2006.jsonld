      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.34",
      "values:originalText": "A person to whom information has, in accordance with subsection\n135(4), section 139, subsection 140(2) or this section, been\ncommunicated for a purpose, or for 2 or more purposes, may:\n\n(a) communicate that information to another person; or\n\n(b) make use of, or make a record of, that information;\nfor that purpose, or for one or more of those purposes, and for no\nother purpose.",
      "skos:definition": "A person to whom information has, in accordance with subsection\n135(4), section 139, subsection 140(2) or this section, been\ncommunicated for a purpose, or for 2 or more purposes, may:\n\n(a) communicate that information to another person; or\n\n(b) make use of, or make a record of, that information;\nfor that purpose, or for one or more of those purposes, and for no\nother purpose.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-142-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-142-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e0aed56cfb0546a3bf1f569e8980f5d119a1f75371ce1d85888d8c4f7e376951",
      "skos:note": "Recipient may communicate or use information for specified purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-142",
      "@type": "cof:Section",
      "cof:title": "142 Further dealing by recipient of certain information",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "A person to whom information has, in accordance with subsection\n135(4), section 139, subsection 140(2) or this section, been\ncommunicated for a purpose, or for 2 or more purposes, may:\n\n(a) communicate that information to another person; or\n\n(b) make use of, or make a record of, that information;\nfor that purpose, or for one or more of those purposes, and for no\nother purpose."
    },
