    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After subparagraph 9(1)(a)(i)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
