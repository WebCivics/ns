      ],
      "cml:integrityHash": "6a9226988fe2bc4e04e62972736e3475e1b951f7a0e1657c16084e5e438dd45f",
      "skos:note": "Giving information obtained by accessing a stored communication in contravention of subsection 108(1) in evidence in a proceeding."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-146-ss-1",
      "@type": "cof:Section",
      "cof:title": "146(1) Giving information in evidence in civil proceedings for remedial",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(1) A person may give information obtained by accessing a stored\ncommunication in contravention of subsection 108(1) in evidence\nin a proceeding by way of an application under section 165 for\nremedial relief in respect of:\n\n(a) the access; or\n\n(b) the communication (in contravention of section 133) of\ninformation obtained by the access."
    },
