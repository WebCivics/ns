    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.18",
      "values:originalText": "behalf thinks it necessary to make the application by\ntelephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, section 112 or 113 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "skos:definition": "behalf thinks it necessary to make the application by\ntelephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, section 112 or 113 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-14-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-14-logic-deontic-1"
