      },
      "cml:premiseText": "An offence is a serious offence if it is...",
      "cml:conclusionText": "Division 72, 101, 102 or 103 of the Criminal Code"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-7-logic-ltl-2",
