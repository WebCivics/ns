    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-123-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "123(2) What happens when stored communications warrants are",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-123-ss-2"
      },
      "cml:curationStatus": {
