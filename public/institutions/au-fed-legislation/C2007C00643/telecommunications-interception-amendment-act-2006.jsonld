      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.91",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the General Register to\nthe Minister for inspection.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the General Register to\nthe Minister for inspection.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-26-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-26-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-26-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "cc81f42a1cd151109c7e20bdd6d20611ef2657000b5091d0ab5b1485e75b652a",
      "skos:note": "Deliver General Register to Minister for inspection within 3 months after commencement of Schedule 5."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Subsection 81B(1)",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the General Register to\nthe Minister for inspection."
    },
