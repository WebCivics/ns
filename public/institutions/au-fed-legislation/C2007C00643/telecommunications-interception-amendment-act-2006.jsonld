    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-140",
      "@type": "cml:Concept",
      "skos:prefLabel": "140 Dealing with information if access suspected to be unlawful",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-140"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.33",
      "values:originalText": "(1) A person may communicate information to the Attorney-General,\nthe Director of Public Prosecutions, the Commissioner of Police or\nthe Chief Executive Officer of the ACC if:\n\n(a) the information was obtained by accessing a stored\ncommunication; and\n\n(b) the person suspects on reasonable grounds that the\ninformation may tend to establish that an offence of the\nfollowing kind (a suspected offence) has been committed:\n\n(i) an offence against subsection 108(1) constituted by the\naccess, or by authorising, suffering or permitting, or\ndoing an act or thing to enable, the access;\n\n(ii) an offence against section 133 constituted by\ncommunicating to a person, making use of, making a\nrecord of, or giving in evidence in a proceeding,\ninformation obtained by the access;\n\n(iii) an ancillary offence relating to an offence of a kind\nreferred to in subparagraph (i) or (ii) of this paragraph.\n\nSchedule 1  Stored communications",
      "skos:definition": "(1) A person may communicate information to the Attorney-General,\nthe Director of Public Prosecutions, the Commissioner of Police or\nthe Chief Executive Officer of the ACC if:\n\n(a) the information was obtained by accessing a stored\ncommunication; and\n\n(b) the person suspects on reasonable grounds that the\ninformation may tend to establish that an offence of the\nfollowing kind (a suspected offence) has been committed:\n\n(i) an offence against subsection 108(1) constituted by the\naccess, or by authorising, suffering or permitting, or\ndoing an act or thing to enable, the access;\n\n(ii) an offence against section 133 constituted by\ncommunicating to a person, making use of, making a\nrecord of, or giving in evidence in a proceeding,\ninformation obtained by the access;\n\n(iii) an ancillary offence relating to an offence of a kind\nreferred to in subparagraph (i) or (ii) of this paragraph.\n\nSchedule 1  Stored communications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-140-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-140-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c1201002989ba71cec32781ec7ef21bba7842bb2749a75ce4f89edff8518790c",
      "skos:note": "Reporting suspected unlawful access of stored communications to authorities."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-140",
      "@type": "cof:Section",
      "cof:title": "140 Dealing with information if access suspected to be unlawful",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "(1) A person may communicate information to the Attorney-General,\nthe Director of Public Prosecutions, the Commissioner of Police or\nthe Chief Executive Officer of the ACC if:\n\n(a) the information was obtained by accessing a stored\ncommunication; and\n\n(b) the person suspects on reasonable grounds that the\ninformation may tend to establish that an offence of the\nfollowing kind (a suspected offence) has been committed:\n\n(i) an offence against subsection 108(1) constituted by the\naccess, or by authorising, suffering or permitting, or\ndoing an act or thing to enable, the access;\n\n(ii) an offence against section 133 constituted by\ncommunicating to a person, making use of, making a\nrecord of, or giving in evidence in a proceeding,\ninformation obtained by the access;\n\n(iii) an ancillary offence relating to an offence of a kind\nreferred to in subparagraph (i) or (ii) of this paragraph.\n\nSchedule 1  Stored communications"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-140-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-140"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-140-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to report",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Reasonable grounds suspected",
      "cml:conclusionText": "Reporting required"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.34",
      "values:originalText": "(2) A person to whom the information is communicated in accordance\nwith subsection (1) may communicate to another person, make use\nof, or make a record of, some or all of the information for a\npurpose (or 2 or more purposes) connected with:\n\n(a) an investigation of a suspected offence; or\n\n(b) the making by an authority, body or person of a decision\nwhether or not to begin a proceeding by way of a prosecution\nfor a suspected offence; or\n\n(c) a proceeding by way of a prosecution for a suspected\noffence;\nand for no other purpose.",
      "skos:definition": "(2) A person to whom the information is communicated in accordance\nwith subsection (1) may communicate to another person, make use\nof, or make a record of, some or all of the information for a\npurpose (or 2 or more purposes) connected with:\n\n(a) an investigation of a suspected offence; or\n\n(b) the making by an authority, body or person of a decision\nwhether or not to begin a proceeding by way of a prosecution\nfor a suspected offence; or\n\n(c) a proceeding by way of a prosecution for a suspected\noffence;\nand for no other purpose.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-30-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-30-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-30-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-30-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-30-logic-diffusion-4"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-30-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "38e397c633487c256494dddc10dcf18148b59c4dae8600b5ecadaf97f483a8d1",
      "skos:note": "Communicating intercepted information for specific purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Telecommunications (Interception) Amendment Act 2006",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "(2) A person to whom the information is communicated in accordance\nwith subsection (1) may communicate to another person, make use\nof, or make a record of, some or all of the information for a\npurpose (or 2 or more purposes) connected with:\n\n(a) an investigation of a suspected offence; or\n\n(b) the making by an authority, body or person of a decision\nwhether or not to begin a proceeding by way of a prosecution\nfor a suspected offence; or\n\n(c) a proceeding by way of a prosecution for a suspected\noffence;\nand for no other purpose."
    },
