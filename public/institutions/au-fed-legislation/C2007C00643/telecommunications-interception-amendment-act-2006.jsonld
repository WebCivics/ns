    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-47",
      "@type": "cml:Concept",
      "skos:prefLabel": "47 Limit on authority conferred by warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-47"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.86",
      "values:originalText": "A warrant issued under section 46 or 46A does not authorise the\ninterception of communications passing over a telecommunications\nsystem that a carrier operates unless:\n\n(a) notification of the issue of the warrant has been received by\nor on behalf of the Managing Director of the carrier under\nsubsection 60(1); and\n\n(b) the interception takes place as a result of action taken by an\nemployee of the carrier.",
      "skos:definition": "A warrant issued under section 46 or 46A does not authorise the\ninterception of communications passing over a telecommunications\nsystem that a carrier operates unless:\n\n(a) notification of the issue of the warrant has been received by\nor on behalf of the Managing Director of the carrier under\nsubsection 60(1); and\n\n(b) the interception takes place as a result of action taken by an\nemployee of the carrier.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-47-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-47-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eed21d0232645b87f307c3d77b75b84a8ec6b750f36e3d12fe2019b7ff66d785",
      "skos:note": "Limit on authority conferred by warrant"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-47",
      "@type": "cof:Section",
      "cof:title": "47 Limit on authority conferred by warrant",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "A warrant issued under section 46 or 46A does not authorise the\ninterception of communications passing over a telecommunications\nsystem that a carrier operates unless:\n\n(a) notification of the issue of the warrant has been received by\nor on behalf of the Managing Director of the carrier under\nsubsection 60(1); and\n\n(b) the interception takes place as a result of action taken by an\nemployee of the carrier."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-47-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-47"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-47-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits interception of communications without carrier notification",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Notification required for warrant issuance",
      "cml:conclusionText": "Interception prohibited"
    },
