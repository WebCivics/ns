    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 5(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.8",
      "values:originalText": "Insert:\nstored communication means a communication that:\n\n(a) is not passing over a telecommunications system; and\n\n(b) is held on equipment that is operated by, and is in the\npossession of, a carrier; and\n\n(c) cannot be accessed on that equipment, by a person who is not\na party to the communication, without the assistance of an\nemployee of the carrier.",
      "skos:definition": "Insert:\nstored communication means a communication that:\n\n(a) is not passing over a telecommunications system; and\n\n(b) is held on equipment that is operated by, and is in the\npossession of, a carrier; and\n\n(c) cannot be accessed on that equipment, by a person who is not\na party to the communication, without the assistance of an\nemployee of the carrier.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-1-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "4824a5b5a660dd81f9b5859136361b12902b4141f2ae600c2485f8092556b96e",
      "skos:note": "Definition of stored communication"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 5(1)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Insert:\nstored communication means a communication that:\n\n(a) is not passing over a telecommunications system; and\n\n(b) is held on equipment that is operated by, and is in the\npossession of, a carrier; and\n\n(c) cannot be accessed on that equipment, by a person who is not\na party to the communication, without the assistance of an\nemployee of the carrier."
    },
