        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-6-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "dbae5e77231c52a302fc116064ff9ddc767fbd0c573570327f6bc829b25d0c7b",
      "skos:note": "Saving provision for warrants issued under subsection 9A(1) of the Telecommunications (Interception) Act 1979."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "The repeal and substitution of subsection 9A(1) of the\nTelecommunications (Interception) Act 1979 by this Schedule does not\naffect the validity of a warrant issued under that subsection before the\ncommencement of this Schedule."
    },
