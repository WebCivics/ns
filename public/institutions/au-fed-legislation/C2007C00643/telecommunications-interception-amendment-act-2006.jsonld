      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.72",
      "values:originalText": "Insert:\ntelecommunications number means the address used by a carrier\nfor the purposes of directing a communication to its intended\ndestination and identifying the origin of the communication, and\nincludes:\n\n(a) a telephone number; and\n\n(b) a mobile telephone number; and\n\n(c) a unique identifier for a telecommunications device (for\nexample, an electronic serial number or a Media Access\nControl address); and\n\n(d) a user account identifier; and\n\n(e) an Internet Protocol address; and\n\n(f) an email address.",
      "skos:definition": "Insert:\ntelecommunications number means the address used by a carrier\nfor the purposes of directing a communication to its intended\ndestination and identifying the origin of the communication, and\nincludes:\n\n(a) a telephone number; and\n\n(b) a mobile telephone number; and\n\n(c) a unique identifier for a telecommunications device (for\nexample, an electronic serial number or a Media Access\nControl address); and\n\n(d) a user account identifier; and\n\n(e) an Internet Protocol address; and\n\n(f) an email address.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-3-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-3-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-3-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "753cd5380f3ae148077e6c4b25db7f538c1810c9b85522616bd71bb0148501ff",
      "skos:note": "Definition of telecommunications number"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Subsection 5(1)",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "Insert:\ntelecommunications number means the address used by a carrier\nfor the purposes of directing a communication to its intended\ndestination and identifying the origin of the communication, and\nincludes:\n\n(a) a telephone number; and\n\n(b) a mobile telephone number; and\n\n(c) a unique identifier for a telecommunications device (for\nexample, an electronic serial number or a Media Access\nControl address); and\n\n(d) a user account identifier; and\n\n(e) an Internet Protocol address; and\n\n(f) an email address."
    },
