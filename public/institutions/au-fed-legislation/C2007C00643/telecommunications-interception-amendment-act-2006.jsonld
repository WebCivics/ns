    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
