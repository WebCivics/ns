    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-149",
      "@type": "cml:Concept",
      "skos:prefLabel": "149 Evidence that is otherwise inadmissible",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-149"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.37",
      "values:originalText": "This Part does not render:\n\n(a) information; or\n\n(b) any record that was obtained by accessing a stored\ncommunication (whether or not in contravention of\nsubsection 108(1));\nadmissible in evidence in a proceeding to a greater extent than it\nwould have been admissible in evidence in that proceeding if this\nPart had not been enacted.",
      "skos:definition": "This Part does not render:\n\n(a) information; or\n\n(b) any record that was obtained by accessing a stored\ncommunication (whether or not in contravention of\nsubsection 108(1));\nadmissible in evidence in a proceeding to a greater extent than it\nwould have been admissible in evidence in that proceeding if this\nPart had not been enacted.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-149-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-149-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6ad78a3f26e5c2532795ae3eb7a7e0f2eb8bbf93a2ac6873090536b6aff7d5c4",
      "skos:note": "Exemptions from admissibility of evidence"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-149",
      "@type": "cof:Section",
      "cof:title": "149 Evidence that is otherwise inadmissible",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "This Part does not render:\n\n(a) information; or\n\n(b) any record that was obtained by accessing a stored\ncommunication (whether or not in contravention of\nsubsection 108(1));\nadmissible in evidence in a proceeding to a greater extent than it\nwould have been admissible in evidence in that proceeding if this\nPart had not been enacted."
    },
