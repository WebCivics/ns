      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Attorney-General must issue a warrant.",
      "cml:conclusionText": "The Attorney-General must not issue a warrant."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-12-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "Justification for warrant issuance requires identification of telecommunications services used or likely to be used",
      "cml:executionSurface": "modalities::dl",
