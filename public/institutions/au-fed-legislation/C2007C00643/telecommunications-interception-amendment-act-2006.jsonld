      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.88",
      "values:originalText": "Transfer of functions  Schedule 5\n\nTelecommunications (Interception) Amendment Act 2006                   85\nA certificate issued under subsection 61(3) of the Telecommunications\n(Interception) Act 1979 that had effect immediately before the repeal of\nthat subsection by this Act has effect after that repeal as if that\nsubsection had not been repealed.",
      "skos:definition": "Transfer of functions  Schedule 5\n\nTelecommunications (Interception) Amendment Act 2006                   85\nA certificate issued under subsection 61(3) of the Telecommunications\n(Interception) Act 1979 that had effect immediately before the repeal of\nthat subsection by this Act has effect after that repeal as if that\nsubsection had not been repealed.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-19-norm"
        }
      ],
      "cml:integrityHash": "33bec8976783281b57824ac70b190ba69b1e9042d5b919f7cd65dd5ce329d422",
      "skos:note": "Preserves effect of certificate issued under subsection 61(3) of the Telecommunications (Interception) Act 1979."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 88,
      "values:originalText": "Transfer of functions  Schedule 5\n\nTelecommunications (Interception) Amendment Act 2006                   85\nA certificate issued under subsection 61(3) of the Telecommunications\n(Interception) Act 1979 that had effect immediately before the repeal of\nthat subsection by this Act has effect after that repeal as if that\nsubsection had not been repealed."
    },
