    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.30",
      "values:originalText": "Stored communications warrant information\n\n(5) An employee of a carrier may, in the performance of his or her\nduties as such an employee, communicate or make use of, or cause\nto be communicated, stored communications warrant information\nif:\n\n(a) the employee does so in the performance of his or her duties\nas such an employee; and\n\n(b) the information is reasonably necessary to enable access to a\nstored communication under a stored communications\nwarrant.\n\n(6) An employee of a carrier may communicate or cause to be\ncommunicated to another carrier, or to an employee of another\ncarrier, stored communications warrant information if the\ninformation is reasonably necessary to enable access to a stored\ncommunication under a stored communications warrant.",
      "skos:definition": "Stored communications warrant information\n\n(5) An employee of a carrier may, in the performance of his or her\nduties as such an employee, communicate or make use of, or cause\nto be communicated, stored communications warrant information\nif:\n\n(a) the employee does so in the performance of his or her duties\nas such an employee; and\n\n(b) the information is reasonably necessary to enable access to a\nstored communication under a stored communications\nwarrant.\n\n(6) An employee of a carrier may communicate or cause to be\ncommunicated to another carrier, or to an employee of another\ncarrier, stored communications warrant information if the\ninformation is reasonably necessary to enable access to a stored\ncommunication under a stored communications warrant.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-26-ss-5"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-26-ss-6"
        }
      ],
      "cml:integrityHash": "bfe7ecd68700c05b06d10c19c3031696f896c0acc4f1c337885eb71f843e3c7f"
    },
