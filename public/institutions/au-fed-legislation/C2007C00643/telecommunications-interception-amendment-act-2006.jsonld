    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-113",
      "@type": "cml:Concept",
      "skos:prefLabel": "113 Affidavits to accompany written applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-113"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.17",
      "values:originalText": "(1) The application must, if it is in writing, be accompanied by an\naffidavit complying with this section.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subsection (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, but\nfor this subsection, this section would have required an affidavit\naccompanying the application to set out.",
      "skos:definition": "(1) The application must, if it is in writing, be accompanied by an\naffidavit complying with this section.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subsection (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, but\nfor this subsection, this section would have required an affidavit\naccompanying the application to set out.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-113-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-113-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-113-ss-3"
        }
      ],
      "cml:integrityHash": "cc17e997c274c4ba0fd7ad4003a0674f6bedce1ba40d97a251be7f9147f77ac3"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-113",
      "@type": "cof:Section",
      "cof:title": "113 Affidavits to accompany written applications",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "(1) The application must, if it is in writing, be accompanied by an\naffidavit complying with this section.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subsection (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, but\nfor this subsection, this section would have required an affidavit\naccompanying the application to set out."
    },
