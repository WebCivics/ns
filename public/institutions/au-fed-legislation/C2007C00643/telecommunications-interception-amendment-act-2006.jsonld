      "cml:premiseText": "The Director-General of Security gives a notice in writing to the Attorney-General requesting the Attorney-General to issue a warrant.",
      "cml:conclusionText": "The Attorney-General must issue a warrant if requested by the Director-General of Security."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "The Attorney-General has permission to issue a warrant for the interception of communications.",
