        }
      ],
      "cml:integrityHash": "7f1d4856e47879df31249499693187506833948fb69773d612b9bd0b3f9bb6cc",
      "skos:note": "Communication is accessible to its intended recipient if it has been received, stored under control, or delivered. Defines intended recipient of a communication"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-5g-ss-1",
      "@type": "cof:Section",
      "cof:title": "5G(1) The intended recipient of a communication",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(1) For the purposes of this Act, a communication is accessible to its\nintended recipient if it:\n\n(a) has been received by the telecommunications service\nprovided to the intended recipient; or\n\nStored communications  Schedule 1\nPrincipal amendments  Part 1\n\nTelecommunications (Interception) Amendment Act 2006                   7\n\n(b) is under the control of the intended recipient; or\n\n(c) has been delivered to the telecommunications service\nprovided to the intended recipient."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5g-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5g-ss-1"
