      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-5g-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasAccess",
      "cml:logicSummary": "Has access to communication",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) has been received by the telecommunications service provided to the intended recipient; or (b) is under the control of the intended recipient; or (c) has been delivered to the telecommunications service provided to the intended recipient.",
      "cml:conclusionText": "The communication is accessible to its intended recipient if it meets one of these conditions."
    },
