    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.74",
      "values:originalText": "The repeal and substitution of subsection 9A(1) of the\nTelecommunications (Interception) Act 1979 by this Schedule does not\naffect the validity of a warrant issued under that subsection before the\ncommencement of this Schedule.",
      "skos:definition": "The repeal and substitution of subsection 9A(1) of the\nTelecommunications (Interception) Act 1979 by this Schedule does not\naffect the validity of a warrant issued under that subsection before the\ncommencement of this Schedule.",
