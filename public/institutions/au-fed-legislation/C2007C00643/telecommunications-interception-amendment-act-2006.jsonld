    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Subsection 81D(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.92",
      "values:originalText": "Repeal the subsection, substitute:\nOriginal submission\n\n(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the Special Register to\nthe Minister for inspection by the Minister.",
      "skos:definition": "Repeal the subsection, substitute:\nOriginal submission\n\n(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the Special Register to\nthe Minister for inspection by the Minister.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-30-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-30-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dd9e666b3aded118af87d0d5ba1948b6329b7acf2126595c29e4b3649588b467",
      "skos:note": "Deliver Special Register to Minister within 3 months after Schedule 5 commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Subsection 81D(1)",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "Repeal the subsection, substitute:\nOriginal submission\n\n(1) Within 3 months after the commencement of Schedule 5 to the\nTelecommunications (Interception) Amendment Act 2006, the\nSecretary of the Department must deliver the Special Register to\nthe Minister for inspection by the Minister."
    },
