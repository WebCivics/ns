    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Pending applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.84",
      "values:originalText": "(1)\nThe Telecommunications (Interception) Act 1979 as amended by this\nSchedule applies to applications made before the commencement of this\nSchedule for warrants under section 45 of that Act that:\n\n(a) were made before the commencement of this Schedule; and\n\n(b) were not refused or withdrawn before that commencement;\nas if they were applications made for warrants under section 46 of that\nAct.\n(2)\nThe Telecommunications (Interception) Act 1979 as amended by this\nSchedule applies to applications made before the commencement of this\nSchedule for warrants under section 45A of that Act that:\n\n(a) were made before the commencement of this Schedule; and\n\n(b) were not refused or withdrawn before that commencement;\nas if they were applications made for warrants under section 46A of that\nAct.",
      "skos:definition": "(1)\nThe Telecommunications (Interception) Act 1979 as amended by this\nSchedule applies to applications made before the commencement of this\nSchedule for warrants under section 45 of that Act that:\n\n(a) were made before the commencement of this Schedule; and\n\n(b) were not refused or withdrawn before that commencement;\nas if they were applications made for warrants under section 46 of that\nAct.\n(2)\nThe Telecommunications (Interception) Act 1979 as amended by this\nSchedule applies to applications made before the commencement of this\nSchedule for warrants under section 45A of that Act that:\n\n(a) were made before the commencement of this Schedule; and\n\n(b) were not refused or withdrawn before that commencement;\nas if they were applications made for warrants under section 46A of that\nAct.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-31-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-31-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "8b4236d58bb220aa4c796e2be08c384cfb1830edb58b2a6740dcc9596d77acf2",
      "skos:note": "Application of amended Telecommunications (Interception) Act 1979 to pending warrant applications"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Pending applications",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "(1)\nThe Telecommunications (Interception) Act 1979 as amended by this\nSchedule applies to applications made before the commencement of this\nSchedule for warrants under section 45 of that Act that:\n\n(a) were made before the commencement of this Schedule; and\n\n(b) were not refused or withdrawn before that commencement;\nas if they were applications made for warrants under section 46 of that\nAct.\n(2)\nThe Telecommunications (Interception) Act 1979 as amended by this\nSchedule applies to applications made before the commencement of this\nSchedule for warrants under section 45A of that Act that:\n\n(a) were made before the commencement of this Schedule; and\n\n(b) were not refused or withdrawn before that commencement;\nas if they were applications made for warrants under section 46A of that\nAct."
    },
