      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.28",
      "values:originalText": "purposes of Part 3-2, 3-3, 3-5 or 3-6\n\nA person may, for the purposes of Part 3-2, 3-3, 3-5 or 3-6:\n\n(a) communicate stored communications warrant information to\nanother person; or\n\n(b) make use of stored communications warrant information; or\n\n(c) make a record of stored communications warrant\ninformation; or\n\n(d) give stored communications warrant information in evidence\nin a proceeding.",
      "skos:definition": "purposes of Part 3-2, 3-3, 3-5 or 3-6\n\nA person may, for the purposes of Part 3-2, 3-3, 3-5 or 3-6:\n\n(a) communicate stored communications warrant information to\nanother person; or\n\n(b) make use of stored communications warrant information; or\n\n(c) make a record of stored communications warrant\ninformation; or\n\n(d) give stored communications warrant information in evidence\nin a proceeding.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-134-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-134-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "209ffba61368334c5e8ba422d62ad440763a6659144be39142e39c89daf81ab6",
      "skos:note": "Permits communication, use, recording, and evidence of stored communications warrant information."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-134",
      "@type": "cof:Section",
      "cof:title": "134 Dealing in stored communications warrant information for the",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "purposes of Part 3-2, 3-3, 3-5 or 3-6\n\nA person may, for the purposes of Part 3-2, 3-3, 3-5 or 3-6:\n\n(a) communicate stored communications warrant information to\nanother person; or\n\n(b) make use of stored communications warrant information; or\n\n(c) make a record of stored communications warrant\ninformation; or\n\n(d) give stored communications warrant information in evidence\nin a proceeding."
    },
