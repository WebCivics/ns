    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.91",
      "values:originalText": "The General Register of Warrants kept by the Commissioner of Police\nbefore the commencement of this item is taken, after that\ncommencement, to be the General Register of Warrants kept by the\nSecretary of the Department.",
      "skos:definition": "The General Register of Warrants kept by the Commissioner of Police\nbefore the commencement of this item is taken, after that\ncommencement, to be the General Register of Warrants kept by the\nSecretary of the Department.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-25-norm"
        }
      ],
      "cml:integrityHash": "768f4928bbc23649c4536bf63afe09f5afe0d2acbf5cf808bf1e0723a6619221",
      "skos:note": "Saving provision for General Register of Warrants"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "The General Register of Warrants kept by the Commissioner of Police\nbefore the commencement of this item is taken, after that\ncommencement, to be the General Register of Warrants kept by the\nSecretary of the Department."
    },
