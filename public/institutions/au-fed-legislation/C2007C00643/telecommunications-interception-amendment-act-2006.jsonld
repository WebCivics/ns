    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.12",
      "values:originalText": "(a) a judge of a court created by the Parliament; or\n\n(b) a Federal Magistrate; or\n\n(c) a magistrate;\nmay, by writing, consent to be appointed by the Minister under\nsubsection (1).\n\n(3) A person’s appointment ceases to have effect if:\n\n(a) the person ceases to be a person whom the Minister could\nappoint under this section; or\n\n(b) the Minister, by writing, revokes the appointment.\n\n(4) An issuing authority has, in relation to the performance or exercise\nof a function or power conferred on an issuing authority by this\nAct, the same protection and immunity as a Justice of the High\nCourt has in relation to proceedings in the High Court.",
      "skos:definition": "(a) a judge of a court created by the Parliament; or\n\n(b) a Federal Magistrate; or\n\n(c) a magistrate;\nmay, by writing, consent to be appointed by the Minister under\nsubsection (1).\n\n(3) A person’s appointment ceases to have effect if:\n\n(a) the person ceases to be a person whom the Minister could\nappoint under this section; or\n\n(b) the Minister, by writing, revokes the appointment.\n\n(4) An issuing authority has, in relation to the performance or exercise\nof a function or power conferred on an issuing authority by this\nAct, the same protection and immunity as a Justice of the High\nCourt has in relation to proceedings in the High Court.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-8-ss-3"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-8-ss-4"
        }
      ],
      "cml:integrityHash": "2695136c1a8fd2a3371dd5d1477dea0bae908a4b7e679d8e89f84c84ab2d641f"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Telecommunications (Interception) Amendment Act 2006",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "(a) a judge of a court created by the Parliament; or\n\n(b) a Federal Magistrate; or\n\n(c) a magistrate;\nmay, by writing, consent to be appointed by the Minister under\nsubsection (1).\n\n(3) A person’s appointment ceases to have effect if:\n\n(a) the person ceases to be a person whom the Minister could\nappoint under this section; or\n\n(b) the Minister, by writing, revokes the appointment.\n\n(4) An issuing authority has, in relation to the performance or exercise\nof a function or power conferred on an issuing authority by this\nAct, the same protection and immunity as a Justice of the High\nCourt has in relation to proceedings in the High Court."
    },
    {
