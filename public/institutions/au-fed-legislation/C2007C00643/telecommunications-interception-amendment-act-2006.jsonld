    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Paragraph 46A(1)(d)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
