      }
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Warrants under sections 46, 46A and 48 unaffected",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.84",
      "values:originalText": "The amendments of sections 46, 46A and 48 of the Telecommunications\n(Interception) Act 1979 made by this Schedule do not affect the validity\nof warrants issued under those sections before the commencement of\nthis Schedule.\n\nClass 1 and class 2 offences  Schedule 4\nTransitional provisions  Part 2\n\nTelecommunications (Interception) Amendment Act 2006                   81",
      "skos:definition": "The amendments of sections 46, 46A and 48 of the Telecommunications\n(Interception) Act 1979 made by this Schedule do not affect the validity\nof warrants issued under those sections before the commencement of\nthis Schedule.\n\nClass 1 and class 2 offences  Schedule 4\nTransitional provisions  Part 2\n\nTelecommunications (Interception) Amendment Act 2006                   81",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-33-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "38824961a08cca560837ff4e453226ba8d66587cf8adb3cca6c21dd229eca7f5",
      "skos:note": "Warrants under sections 46, 46A and 48 unaffected"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Warrants under sections 46, 46A and 48 unaffected",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "The amendments of sections 46, 46A and 48 of the Telecommunications\n(Interception) Act 1979 made by this Schedule do not affect the validity\nof warrants issued under those sections before the commencement of\nthis Schedule.\n\nClass 1 and class 2 offences  Schedule 4\nTransitional provisions  Part 2\n\nTelecommunications (Interception) Amendment Act 2006                   81"
    },
