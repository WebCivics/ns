    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 After paragraph 11B(2)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.76",
      "values:originalText": "Insert:\n\n(ba) if the warrant would authorise interception of\ncommunications made by means of a telecommunications\ndevice identified in the warrant—must include details\nsufficient to identify the telecommunications device that the\nperson or foreign organisation is using, or is likely to use;\nand",
      "skos:definition": "Insert:\n\n(ba) if the warrant would authorise interception of\ncommunications made by means of a telecommunications\ndevice identified in the warrant—must include details\nsufficient to identify the telecommunications device that the\nperson or foreign organisation is using, or is likely to use;\nand",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-11-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-11-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-11-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "3ca26ce85252d13ebf7c19ea63b35da1478e7fedbb33590706feae8bf220acb4",
      "skos:note": "Details sufficient to identify telecommunications device must be included in warrant."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 After paragraph 11B(2)(b)",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "Insert:\n\n(ba) if the warrant would authorise interception of\ncommunications made by means of a telecommunications\ndevice identified in the warrant—must include details\nsufficient to identify the telecommunications device that the\nperson or foreign organisation is using, or is likely to use;\nand"
    },
