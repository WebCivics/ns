    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-10-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "10(4) Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-10-ss-4"
