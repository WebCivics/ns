    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Continuation of warrants under sections 45 and 45A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.84",
      "values:originalText": "(1)\nA warrant that was issued before the commencement of this Schedule\nunder section 45 of the Telecommunications (Interception) Act 1979\nand that was in force immediately before that commencement continues\nin force after that commencement as if it had been issued under\nsection 46 of that Act.\n(2)\nA warrant that was issued before the commencement of this Schedule\nunder section 45A of the Telecommunications (Interception) Act 1979\nand that was in force immediately before that commencement continues\nin force after that commencement as if it had been issued under\nsection 46A of that Act.",
      "skos:definition": "(1)\nA warrant that was issued before the commencement of this Schedule\nunder section 45 of the Telecommunications (Interception) Act 1979\nand that was in force immediately before that commencement continues\nin force after that commencement as if it had been issued under\nsection 46 of that Act.\n(2)\nA warrant that was issued before the commencement of this Schedule\nunder section 45A of the Telecommunications (Interception) Act 1979\nand that was in force immediately before that commencement continues\nin force after that commencement as if it had been issued under\nsection 46A of that Act.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-32-norm"
        }
      ],
      "cml:integrityHash": "5aae22d6b2b45a6626080c4afb5c065d692560372f422dacda84b8ba60cc198b",
      "skos:note": "Continuation of warrants under sections 45 and 45A"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Continuation of warrants under sections 45 and 45A",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "(1)\nA warrant that was issued before the commencement of this Schedule\nunder section 45 of the Telecommunications (Interception) Act 1979\nand that was in force immediately before that commencement continues\nin force after that commencement as if it had been issued under\nsection 46 of that Act.\n(2)\nA warrant that was issued before the commencement of this Schedule\nunder section 45A of the Telecommunications (Interception) Act 1979\nand that was in force immediately before that commencement continues\nin force after that commencement as if it had been issued under\nsection 46A of that Act."
    },
