    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-110-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "110(2) Enforcement agencies may apply for stored communications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-110-ss-2"
      },
      "cml:curationStatus": {
