    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 5(1) (subparagraph (a)(v) of the definition of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-1"
      },
      "cml:curationStatus": {
