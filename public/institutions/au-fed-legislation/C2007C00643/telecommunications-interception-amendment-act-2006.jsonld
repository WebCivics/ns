    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-108",
      "@type": "cml:Concept",
      "skos:prefLabel": "108 Stored communications not to be accessed",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-108"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.13",
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person:\n\n(i) accesses a stored communication; or\n\n(ii) authorises, suffers or permits another person to access a\nstored communication; or\n\nSchedule 1  Stored communications",
      "skos:definition": "(1) A person commits an offence if:\n\n(a) the person:\n\n(i) accesses a stored communication; or\n\n(ii) authorises, suffers or permits another person to access a\nstored communication; or\n\nSchedule 1  Stored communications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-108-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-108-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "610ee9467247c4037e8dc27dd3a41f09cd36b9964729a3806e2e224a0694dcef",
      "skos:note": "Accessing or authorizing access to stored communications is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-108",
      "@type": "cof:Section",
      "cof:title": "108 Stored communications not to be accessed",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person:\n\n(i) accesses a stored communication; or\n\n(ii) authorises, suffers or permits another person to access a\nstored communication; or\n\nSchedule 1  Stored communications"
    },
