          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-165-ss-5-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "a7c62bdb1417a3658b44fb5316d187fe4ae101af08063ef4cc4468f4e5e18eae",
      "skos:note": "Court may grant remedial relief to an aggrieved person if convicted of unlawful access or communication."
    },
    {
