    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 After subsection 60(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.79",
      "values:originalText": "Insert:\n\n(4A) Where:\n\n(a) the Managing Director of a carrier has been informed, under\nsubsection (1), of the issue of a named person warrant; and\n\n(b) the warrant is a warrant that authorises interception of\ncommunications made by means of a telecommunications\ndevice identified in the warrant; and\n\n(c) it is proposed, under the warrant, to intercept, by means of a\ntelecommunications device, communications made to or\nfrom a telecommunications service operated by the carrier;\nand\n\n(d) the device was not identified in the warrant;\na certifying person must cause the Managing Director of the carrier\nto be given, as soon as practicable, a description in writing of the\ndevice sufficient to identify it.",
      "skos:definition": "Insert:\n\n(4A) Where:\n\n(a) the Managing Director of a carrier has been informed, under\nsubsection (1), of the issue of a named person warrant; and\n\n(b) the warrant is a warrant that authorises interception of\ncommunications made by means of a telecommunications\ndevice identified in the warrant; and\n\n(c) it is proposed, under the warrant, to intercept, by means of a\ntelecommunications device, communications made to or\nfrom a telecommunications service operated by the carrier;\nand\n\n(d) the device was not identified in the warrant;\na certifying person must cause the Managing Director of the carrier\nto be given, as soon as practicable, a description in writing of the\ndevice sufficient to identify it.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-23-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-23-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-23-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "48e43656bf3670c2a78aa36fdc6215c5970ca4b3cbcc9a41fd03a1f141e0b9be",
      "skos:note": "Certifying person must provide description of device to Managing Director of carrier.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 After subsection 60(4)",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "Insert:\n\n(4A) Where:\n\n(a) the Managing Director of a carrier has been informed, under\nsubsection (1), of the issue of a named person warrant; and\n\n(b) the warrant is a warrant that authorises interception of\ncommunications made by means of a telecommunications\ndevice identified in the warrant; and\n\n(c) it is proposed, under the warrant, to intercept, by means of a\ntelecommunications device, communications made to or\nfrom a telecommunications service operated by the carrier;\nand\n\n(d) the device was not identified in the warrant;\na certifying person must cause the Managing Director of the carrier\nto be given, as soon as practicable, a description in writing of the\ndevice sufficient to identify it."
    },
