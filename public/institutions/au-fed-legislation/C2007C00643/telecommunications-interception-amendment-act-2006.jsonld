      "cml:integrityHash": "89add04a59f9faa804f22b2e5e0e483cb2ea36826fbb3f15ef7e9b4315fd9dd5",
      "skos:note": "An offence is also a serious offence if it is an offence constituted by receiving or assisting a person who is, to the offender’s knowledge, guilty of a serious offence mentioned in subsection (1),"
    },
