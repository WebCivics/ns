    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-122-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Duty to inform and revoke warrant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Chief officer has issued the warrant.",
      "cml:conclusionText": "Inform and revoke warrant."
    },
    {
