    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-6eb",
      "@type": "cml:Concept",
      "skos:prefLabel": "6EB Stored communications warrant information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-6eb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.12",
      "values:originalText": "A reference in this Act to stored communications warrant\ninformation is a reference to:\n\n(a) information about any of the following:\n\n(i) an application for a stored communications warrant;\n\n(ii) the issue of a stored communications warrant;\n\n(iii) the existence or non-existence of a stored\ncommunications warrant;\n\n(iv) the expiry of a stored communications warrant; or\n\n(b) any other information that is likely to enable the\nidentification of:\n\n(i) the telecommunications service to which a stored\ncommunications warrant relates; or\n\n(ii) a person specified in a stored communications warrant\nas a person using or likely to use the\ntelecommunications service to which the warrant\nrelates.",
      "skos:definition": "A reference in this Act to stored communications warrant\ninformation is a reference to:\n\n(a) information about any of the following:\n\n(i) an application for a stored communications warrant;\n\n(ii) the issue of a stored communications warrant;\n\n(iii) the existence or non-existence of a stored\ncommunications warrant;\n\n(iv) the expiry of a stored communications warrant; or\n\n(b) any other information that is likely to enable the\nidentification of:\n\n(i) the telecommunications service to which a stored\ncommunications warrant relates; or\n\n(ii) a person specified in a stored communications warrant\nas a person using or likely to use the\ntelecommunications service to which the warrant\nrelates.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-6eb-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-6eb-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-6eb-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "33b092c941ac9f6e9586fd5a68eea3d61923448d46ca68a790bd14162ebca7ab",
      "skos:note": "Information about stored communications warrant applications, issues, existence, and expiry."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-6eb",
      "@type": "cof:Section",
      "cof:title": "6EB Stored communications warrant information",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "A reference in this Act to stored communications warrant\ninformation is a reference to:\n\n(a) information about any of the following:\n\n(i) an application for a stored communications warrant;\n\n(ii) the issue of a stored communications warrant;\n\n(iii) the existence or non-existence of a stored\ncommunications warrant;\n\n(iv) the expiry of a stored communications warrant; or\n\n(b) any other information that is likely to enable the\nidentification of:\n\n(i) the telecommunications service to which a stored\ncommunications warrant relates; or\n\n(ii) a person specified in a stored communications warrant\nas a person using or likely to use the\ntelecommunications service to which the warrant\nrelates."
    },
