    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sec-2-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Schedules 1 to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sec-2-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.5",
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if any of the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day on which this Act\nreceives the Royal Assent, they commence\non the first day after the end of that period.",
      "skos:definition": "A single day to be fixed by Proclamation.\nHowever, if any of the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day on which this Act\nreceives the Royal Assent, they commence\non the first day after the end of that period.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sec-2-2-norm"
        }
      ],
      "cml:integrityHash": "05723b99f61c730dc290e9137195db47bb87652c5e033f920741917537092fd6",
      "skos:note": "Commencement of provisions within 6 months"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedules 1 to",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if any of the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day on which this Act\nreceives the Royal Assent, they commence\non the first day after the end of that period."
    },
