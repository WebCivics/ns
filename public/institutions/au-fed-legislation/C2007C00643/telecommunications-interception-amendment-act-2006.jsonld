    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-117",
      "@type": "cml:Concept",
      "skos:prefLabel": "117 What stored communications warrants authorise",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-117"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.19",
      "values:originalText": "A stored communications warrant authorises persons approved\nunder subsection 127(2) in respect of the warrant to access, subject\nto any conditions or restrictions that are specified in the warrant, a\nstored communication:\n\n(a) that was made by the person in respect of whom the warrant\nwas issued; or\n\nSchedule 1  Stored communications",
      "skos:definition": "A stored communications warrant authorises persons approved\nunder subsection 127(2) in respect of the warrant to access, subject\nto any conditions or restrictions that are specified in the warrant, a\nstored communication:\n\n(a) that was made by the person in respect of whom the warrant\nwas issued; or\n\nSchedule 1  Stored communications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-117-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-117-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "20e7bf7336fe6e0831e1cd9e3e110b7a514208be1e2f0f5e25ac5b65b408296a",
      "skos:note": "Authorises access to stored communication under specified conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-117",
      "@type": "cof:Section",
      "cof:title": "117 What stored communications warrants authorise",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "A stored communications warrant authorises persons approved\nunder subsection 127(2) in respect of the warrant to access, subject\nto any conditions or restrictions that are specified in the warrant, a\nstored communication:\n\n(a) that was made by the person in respect of whom the warrant\nwas issued; or\n\nSchedule 1  Stored communications"
    },
