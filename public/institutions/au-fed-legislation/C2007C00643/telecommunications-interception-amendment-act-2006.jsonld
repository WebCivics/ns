    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-143",
      "@type": "cml:Concept",
      "skos:prefLabel": "143 Giving information in evidence in exempt proceeding",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-143"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.34",
      "values:originalText": "(1) A person may give lawfully accessed information (other than\nforeign intelligence information) in evidence in an exempt\nproceeding.\n\n(2) For the purposes of applying subsection (1) in relation to\ninformation, the question whether or not a stored communication\n\nStored communications  Schedule 1\nPrincipal amendments  Part 1\n\nTelecommunications (Interception) Amendment Act 2006                   31\nwas accessed in contravention of subsection 108(1) may be\ndetermined on the balance of probabilities.\n\n(3) A person may give stored communications warrant information in\nevidence in an exempt proceeding.",
      "skos:definition": "(1) A person may give lawfully accessed information (other than\nforeign intelligence information) in evidence in an exempt\nproceeding.\n\n(2) For the purposes of applying subsection (1) in relation to\ninformation, the question whether or not a stored communication\n\nStored communications  Schedule 1\nPrincipal amendments  Part 1\n\nTelecommunications (Interception) Amendment Act 2006                   31\nwas accessed in contravention of subsection 108(1) may be\ndetermined on the balance of probabilities.\n\n(3) A person may give stored communications warrant information in\nevidence in an exempt proceeding.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-143-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-143-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-143-ss-3"
        }
      ],
      "cml:integrityHash": "ca1938734b630f54d272e4bf3ffb003dbe0641d72bba2849db7c12eedfe12803"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-143",
      "@type": "cof:Section",
      "cof:title": "143 Giving information in evidence in exempt proceeding",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "(1) A person may give lawfully accessed information (other than\nforeign intelligence information) in evidence in an exempt\nproceeding.\n\n(2) For the purposes of applying subsection (1) in relation to\ninformation, the question whether or not a stored communication\n\nStored communications  Schedule 1\nPrincipal amendments  Part 1\n\nTelecommunications (Interception) Amendment Act 2006                   31\nwas accessed in contravention of subsection 108(1) may be\ndetermined on the balance of probabilities.\n\n(3) A person may give stored communications warrant information in\nevidence in an exempt proceeding."
    },
