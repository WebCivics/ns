    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-124",
      "@type": "cml:Concept",
      "skos:prefLabel": "124 Access to additional telecommunications services under stored",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-124"
      },
      "cml:curationStatus": {
