      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.92",
      "values:originalText": "The Special Register of Warrants kept by the Commissioner of Police\nbefore the commencement of this item is taken, after that\ncommencement, to be the Special Register of Warrants kept by the\nSecretary of the Department.",
      "skos:definition": "The Special Register of Warrants kept by the Commissioner of Police\nbefore the commencement of this item is taken, after that\ncommencement, to be the Special Register of Warrants kept by the\nSecretary of the Department.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-29-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-29-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "72246796e13b28bda0c16b9320c9e2de2d25bc6100a2d73765c40a8e3c6e9524",
      "skos:note": "Saving provision for Special Register of Warrants"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-5-sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "The Special Register of Warrants kept by the Commissioner of Police\nbefore the commencement of this item is taken, after that\ncommencement, to be the Special Register of Warrants kept by the\nSecretary of the Department."
    },
