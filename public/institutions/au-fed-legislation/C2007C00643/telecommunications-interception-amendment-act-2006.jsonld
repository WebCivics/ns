      }
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits issuing of warrants",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subparagraph (a)(ia)",
      "cml:conclusionText": "subsection (3)"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 At the end of section 9",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.68",
      "values:originalText": "Add:\n\n(3) The Attorney-General must not issue a warrant in a case in which\nsubparagraph (1)(a)(ia) applies unless he or she is satisfied that:\n\n(a) the Organisation has exhausted all other practicable methods\nof identifying the telecommunications services used, or likely\nto be used, by the other person referred to in\nsubparagraph (1)(a)(ia); or\n\n(b) interception of communications made to or from a\ntelecommunications service used or likely to be used by that\nperson would not otherwise be possible.",
      "skos:definition": "Add:\n\n(3) The Attorney-General must not issue a warrant in a case in which\nsubparagraph (1)(a)(ia) applies unless he or she is satisfied that:\n\n(a) the Organisation has exhausted all other practicable methods\nof identifying the telecommunications services used, or likely\nto be used, by the other person referred to in\nsubparagraph (1)(a)(ia); or\n\n(b) interception of communications made to or from a\ntelecommunications service used or likely to be used by that\nperson would not otherwise be possible.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-3-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9b2cb3abd546cdc2b68b3a96f1f8cbfcd7187566b659caae72f7e45ff53a60c1",
      "skos:note": "The Attorney-General must not issue a warrant in certain cases."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 At the end of section 9",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "Add:\n\n(3) The Attorney-General must not issue a warrant in a case in which\nsubparagraph (1)(a)(ia) applies unless he or she is satisfied that:\n\n(a) the Organisation has exhausted all other practicable methods\nof identifying the telecommunications services used, or likely\nto be used, by the other person referred to in\nsubparagraph (1)(a)(ia); or\n\n(b) interception of communications made to or from a\ntelecommunications service used or likely to be used by that\nperson would not otherwise be possible."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
