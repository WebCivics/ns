      },
      "cml:operator": "May",
      "cml:logicSummary": "Permission granted by the Attorney-General.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
