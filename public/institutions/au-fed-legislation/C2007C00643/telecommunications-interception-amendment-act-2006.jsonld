      "skos:note": "Restricts issuing of warrants under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 At the end of subsection 9(1)",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "Add:\nNote:\nSubparagraph (a)(ia)—subsection (3) restricts the issuing of warrants\nif subparagraph (a)(ia) applies."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-2-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
