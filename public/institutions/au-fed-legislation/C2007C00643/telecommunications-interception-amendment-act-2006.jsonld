    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-163",
      "@type": "cml:Concept",
      "skos:prefLabel": "163 Report to contain information about effectiveness of warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-163"
      },
