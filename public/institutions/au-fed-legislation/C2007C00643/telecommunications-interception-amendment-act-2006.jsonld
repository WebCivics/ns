    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Subsection 49(3)",
      "values:kind": "section",
      "cof:pageNumber": 69,
      "values:originalText": "Omit “a period of up to 90 days”, substitute:\na period of:\n\n(a) if subparagraph 46(1)(d)(ii) applies—up to 45 days; or\n\n(b) otherwise—up to 90 days."
    },
