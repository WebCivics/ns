      },
      "cml:premiseText": "The Attorney-General may issue a warrant.",
      "cml:conclusionText": "A warrant can be issued for the interception of communications."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:logicSummary": "Communications intercepted under this section are related to foreign intelligence.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The warrant is issued for the purpose of obtaining foreign intelligence.",
      "cml:conclusionText": "Foreign intelligence is a matter specified in the notice."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-9-ss-1-logic-alleninterval-3",
