    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-126",
      "@type": "cml:Concept",
      "skos:prefLabel": "126 Limit on authority conferred by warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-126"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.24",
      "values:originalText": "A stored communications warrant does not authorise access to\nstored communications unless notification of the issue of the\nwarrant has been received under section 121 by or on behalf of the\nManaging Director of the carrier holding the stored\ncommunications.",
      "skos:definition": "A stored communications warrant does not authorise access to\nstored communications unless notification of the issue of the\nwarrant has been received under section 121 by or on behalf of the\nManaging Director of the carrier holding the stored\ncommunications.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-126-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-126-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "53c1391c0f67a776189d5771943fbfe61b1afb38df9bee31746083b50af20038",
      "skos:note": "Notification required for access to stored communications"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-126",
      "@type": "cof:Section",
      "cof:title": "126 Limit on authority conferred by warrant",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "A stored communications warrant does not authorise access to\nstored communications unless notification of the issue of the\nwarrant has been received under section 121 by or on behalf of the\nManaging Director of the carrier holding the stored\ncommunications."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-126-norm",
      "@type": "values:Obligation",
      "cml:modality": {
