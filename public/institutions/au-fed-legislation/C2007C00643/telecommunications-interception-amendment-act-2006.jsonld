          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-10-ss-3"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-10-ss-4"
        }
      ],
      "cml:integrityHash": "6558cae769754c871f0e8349d66ded5ac57bc2c3e0b7d4d0ff9740531d81c907"
    },
