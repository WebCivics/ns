      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.68",
      "values:originalText": "Insert:\n\n(ia) the means by which a person receives or sends a\ncommunication from or to another person who is\nengaged in, or reasonably suspected by the\nDirector-General of Security of being engaged in, or of\nbeing likely to engage in, such activities; or",
      "skos:definition": "Insert:\n\n(ia) the means by which a person receives or sends a\ncommunication from or to another person who is\nengaged in, or reasonably suspected by the\nDirector-General of Security of being engaged in, or of\nbeing likely to engage in, such activities; or",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-1-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-1-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "c6c5b4cfc492fe7879c243d8918eee972dd642b41d3a975fa662fa754f39d391",
      "skos:note": "Requires means for communication with suspected security activities"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 After subparagraph 9(1)(a)(i)",
      "values:kind": "section",
