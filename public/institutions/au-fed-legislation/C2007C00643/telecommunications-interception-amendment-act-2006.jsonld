      "cml:conclusionText": "...may communicate to another person, make use of, or make a record of..."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-30-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
