    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Subsection 7(9)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.82",
      "values:originalText": "Repeal the subsection, substitute:\n\n(9) The doing of an act mentioned in subparagraph (4)(b)(ii) or (iii) or\n(5)(b)(ii) or (iii) in a particular case is taken to constitute a serious\noffence, even if it would not constitute a serious offence apart from\nthis subsection.\nNote:\nSee subsection (6). A Part 2-5 warrant can only be issued for the\npurposes of an investigation relating to the commission of a serious\noffence.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(9) The doing of an act mentioned in subparagraph (4)(b)(ii) or (iii) or\n(5)(b)(ii) or (iii) in a particular case is taken to constitute a serious\noffence, even if it would not constitute a serious offence apart from\nthis subsection.\nNote:\nSee subsection (6). A Part 2-5 warrant can only be issued for the\npurposes of an investigation relating to the commission of a serious\noffence.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-16-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-16-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-16-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "71300dca699a918e0f06bb9c6f7a69bdf50ab5451f969082195833cce8627380",
      "skos:note": "Repeal of subsection and substitution with new provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Subsection 7(9)",
      "values:kind": "section",
      "cof:pageNumber": 82,
      "values:originalText": "Repeal the subsection, substitute:\n\n(9) The doing of an act mentioned in subparagraph (4)(b)(ii) or (iii) or\n(5)(b)(ii) or (iii) in a particular case is taken to constitute a serious\noffence, even if it would not constitute a serious offence apart from\nthis subsection.\nNote:\nSee subsection (6). A Part 2-5 warrant can only be issued for the\npurposes of an investigation relating to the commission of a serious\noffence."
    },
