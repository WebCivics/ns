    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-166",
      "@type": "cml:Concept",
      "skos:prefLabel": "166 Limitation periods etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-166"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.47",
      "values:originalText": "Access—civil court remedy\n\n(1) An application under subsection 165(3) for the grant of remedial\nrelief in respect of an access is to be made within 6 years after the\naccess took place.\nCommunication—civil court remedy\n\n(2) An application under subsection 165(4) for the grant of remedial\nrelief in respect of a communication of information is to be made\nwithin 6 years after the communication.\nCriminal court remedies\n\n(3) An application under subsection 165(5) or (6) for the grant of\nremedial relief is not subject to any limitation period, but is to be\nmade as soon as practicable after the conviction concerned.\n\nSchedule 1  Stored communications",
      "skos:definition": "Access—civil court remedy\n\n(1) An application under subsection 165(3) for the grant of remedial\nrelief in respect of an access is to be made within 6 years after the\naccess took place.\nCommunication—civil court remedy\n\n(2) An application under subsection 165(4) for the grant of remedial\nrelief in respect of a communication of information is to be made\nwithin 6 years after the communication.\nCriminal court remedies\n\n(3) An application under subsection 165(5) or (6) for the grant of\nremedial relief is not subject to any limitation period, but is to be\nmade as soon as practicable after the conviction concerned.\n\nSchedule 1  Stored communications",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-166-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-166-ss-2"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-166-ss-3"
        }
      ],
      "cml:integrityHash": "b162d104e39a6aa1a43457a569e964924e12d1253237d75fd05c880edc3b78c0"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-166",
      "@type": "cof:Section",
      "cof:title": "166 Limitation periods etc.",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "Access—civil court remedy\n\n(1) An application under subsection 165(3) for the grant of remedial\nrelief in respect of an access is to be made within 6 years after the\naccess took place.\nCommunication—civil court remedy\n\n(2) An application under subsection 165(4) for the grant of remedial\nrelief in respect of a communication of information is to be made\nwithin 6 years after the communication.\nCriminal court remedies\n\n(3) An application under subsection 165(5) or (6) for the grant of\nremedial relief is not subject to any limitation period, but is to be\nmade as soon as practicable after the conviction concerned.\n\nSchedule 1  Stored communications"
    },
