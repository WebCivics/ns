    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-42-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "42(8) Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-42-ss-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
