    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-145",
      "@type": "cml:Concept",
      "skos:prefLabel": "145 Evidence that has been given in exempt proceeding",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-145"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.35",
      "values:originalText": "If information is given in evidence in an exempt proceeding under\nsection 143 or 144, that information, or any part of that\ninformation, may later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nSchedule 1  Stored communications",
      "skos:definition": "If information is given in evidence in an exempt proceeding under\nsection 143 or 144, that information, or any part of that\ninformation, may later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nSchedule 1  Stored communications",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-145-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-145-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9647581ba24cf03ad2f158915175b4b276e99ddbe1548714b9cb08f22762a051",
      "skos:note": "Permits reuse of exempt proceeding evidence in other proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-145",
      "@type": "cof:Section",
      "cof:title": "145 Evidence that has been given in exempt proceeding",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "If information is given in evidence in an exempt proceeding under\nsection 143 or 144, that information, or any part of that\ninformation, may later be given in evidence in any proceeding.\nNote:\nThis section was inserted as a response to the decision of the Court of\nAppeal of New South Wales in Wood v Beves (1997) 92 A Crim R\n209.\n\nSchedule 1  Stored communications"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-145-norm",
