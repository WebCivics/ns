    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-122-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits chief officer from revoking warrant without informing other agencies.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The chief officer of an enforcement agency may at any time, by writing signed by him or her...",
      "cml:conclusionText": "The chief officer may not revoke the warrant."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-122-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes an obligation on the chief officer to inform other agencies before revoking a warrant.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The chief officer of an enforcement agency may at any time, by writing signed by him or her...",
      "cml:conclusionText": "The chief officer must inform other agencies before revoking a warrant."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-122-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Defines the temporal interval for informing other agencies before revoking a warrant.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The chief officer of an enforcement agency may at any time, by writing signed by him or her...",
      "cml:conclusionText": "The chief officer must inform other agencies within the defined temporal interval."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-122-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Grants permission to the chief officer to revoke a warrant after informing other agencies.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The chief officer of an enforcement agency may at any time, by writing signed by him or her...",
      "cml:conclusionText": "The chief officer is permitted to revoke a warrant after informing other agencies."
    },
    {
