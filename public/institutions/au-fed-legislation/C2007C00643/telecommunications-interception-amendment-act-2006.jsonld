    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 At the end of section 5D",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-13"
