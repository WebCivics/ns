    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-119-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:logicSummary": "The warrant holds until the end of 5 days after its issue.",
