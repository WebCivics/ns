      "@type": "cml:Concept",
      "skos:prefLabel": "72 Telecommunications (Interception) Amendment Act 2006",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-72"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.76",
      "values:originalText": "The repeal and substitution of subsection 11B(1) of the\nTelecommunications (Interception) Act 1979 by this Schedule does not\naffect the validity of a warrant issued under that subsection before the\ncommencement of this Schedule.",
      "skos:definition": "The repeal and substitution of subsection 11B(1) of the\nTelecommunications (Interception) Act 1979 by this Schedule does not\naffect the validity of a warrant issued under that subsection before the\ncommencement of this Schedule.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-72-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-72-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c860956c05079a2bd182e34bb641878284e0cd62e2f592bd394af306c37a0382",
      "skos:note": "Validity of warrants issued under subsection 11B(1) of the Telecommunications (Interception) Act 1979"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-72",
      "@type": "cof:Section",
      "cof:title": "72 Telecommunications (Interception) Amendment Act 2006",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "The repeal and substitution of subsection 11B(1) of the\nTelecommunications (Interception) Act 1979 by this Schedule does not\naffect the validity of a warrant issued under that subsection before the\ncommencement of this Schedule."
    },
