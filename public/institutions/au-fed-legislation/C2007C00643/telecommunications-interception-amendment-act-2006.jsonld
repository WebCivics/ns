      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.86",
      "values:originalText": "permitted purpose)\nOmit “the Chief Executive Officer of the ACC by subsections 80(2),\n81(2) and 81(3)”, substitute “the chief officer of a Commonwealth\nagency by sections 80 and 81”.",
      "skos:definition": "permitted purpose)\nOmit “the Chief Executive Officer of the ACC by subsections 80(2),\n81(2) and 81(3)”, substitute “the chief officer of a Commonwealth\nagency by sections 80 and 81”.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-5-sec-1-norm"
        }
      ],
