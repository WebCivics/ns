    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-142",
      "@type": "cml:Concept",
      "skos:prefLabel": "142 Further dealing by recipient of certain information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-142"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
