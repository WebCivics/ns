    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-131",
      "@type": "cml:Concept",
      "skos:prefLabel": "131 Certified copies of stored communications warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-131"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.27",
      "values:originalText": "A document certified in writing by a certifying officer of an\nenforcement agency to be a true copy of a stored communications\nwarrant is to be received in evidence in an exempt proceeding as if\nit were the original warrant.",
      "skos:definition": "A document certified in writing by a certifying officer of an\nenforcement agency to be a true copy of a stored communications\nwarrant is to be received in evidence in an exempt proceeding as if\nit were the original warrant.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-131-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-131-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "375efcf44ee65fb7e0efce1f2d3c39119605f51fa868b8a81592a021595298d4",
      "skos:note": "Exempt proceeding must receive certified copy of stored communications warrant as if it were the original."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-131",
      "@type": "cof:Section",
      "cof:title": "131 Certified copies of stored communications warrants",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "A document certified in writing by a certifying officer of an\nenforcement agency to be a true copy of a stored communications\nwarrant is to be received in evidence in an exempt proceeding as if\nit were the original warrant."
    },
