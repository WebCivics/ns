      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.58",
      "values:originalText": "Before “A reference in this Act”, insert “(1)”.",
      "skos:definition": "Before “A reference in this Act”, insert “(1)”.",
      "cml:asserts": [
