      },
      "cml:operator": "=",
      "cml:logicSummary": "Duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An offence is a serious offence if it is...",
      "cml:conclusionText": "an offence against Division 72, 101, 102 or 103 of the Criminal Code"
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-7-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
