    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Subsection 5(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-3-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
