      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.77",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(d) information that would be likely to be obtained by\nintercepting under a warrant:\n\n(i) communications made to or from any\ntelecommunications service that the person is using, or\nis likely to use; or\n\n(ii) communications made by means of a particular\ntelecommunications device that a person is using, or is\nlikely to use;\n\nSchedule 3  Equipment-based interception",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(d) information that would be likely to be obtained by\nintercepting under a warrant:\n\n(i) communications made to or from any\ntelecommunications service that the person is using, or\nis likely to use; or\n\n(ii) communications made by means of a particular\ntelecommunications device that a person is using, or is\nlikely to use;\n\nSchedule 3  Equipment-based interception",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-18-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-18-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-3-sec-18-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "e7f179e5f0124500ae758d0f300af814b4884479748933dada10c115a1f0a40f",
      "skos:note": "Repeal paragraph and substitute with prohibition on intercepting communications."
    },
