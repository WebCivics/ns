    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 At the end of section 46",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.69",
      "values:originalText": "Add:\n\n(3) The Judge or nominated AAT member must not issue a warrant in\na case in which subparagraph (1)(d)(ii) applies unless he or she is\nsatisfied that:\n\n(a) the agency has exhausted all other practicable methods of\nidentifying the telecommunications services used, or likely to\nbe used, by the person involved in the offence or offences\nreferred to in paragraph (1)(d); or\n\n(b) interception of communications made to or from a\ntelecommunications service used or likely to be used by that\nperson would not otherwise be possible.",
      "skos:definition": "Add:\n\n(3) The Judge or nominated AAT member must not issue a warrant in\na case in which subparagraph (1)(d)(ii) applies unless he or she is\nsatisfied that:\n\n(a) the agency has exhausted all other practicable methods of\nidentifying the telecommunications services used, or likely to\nbe used, by the person involved in the offence or offences\nreferred to in paragraph (1)(d); or\n\n(b) interception of communications made to or from a\ntelecommunications service used or likely to be used by that\nperson would not otherwise be possible.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-9-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "78aee6d2c9a856d6ecc139ff8789d26566c956dd2a89b7ae0d593cc35e4fbe71",
      "skos:note": "No warrant can be issued unless certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-2-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 At the end of section 46",
      "values:kind": "section",
      "cof:pageNumber": 69,
      "values:originalText": "Add:\n\n(3) The Judge or nominated AAT member must not issue a warrant in\na case in which subparagraph (1)(d)(ii) applies unless he or she is\nsatisfied that:\n\n(a) the agency has exhausted all other practicable methods of\nidentifying the telecommunications services used, or likely to\nbe used, by the person involved in the offence or offences\nreferred to in paragraph (1)(d); or\n\n(b) interception of communications made to or from a\ntelecommunications service used or likely to be used by that\nperson would not otherwise be possible."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-2-sec-9-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
