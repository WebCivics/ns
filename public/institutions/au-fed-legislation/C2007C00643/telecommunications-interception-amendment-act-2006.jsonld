    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-169",
      "@type": "cml:Concept",
      "skos:prefLabel": "169 State or Territory courts—jurisdictional limits",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-169"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.48",
      "values:originalText": "This Part does not enable an inferior court of a State or Territory to\ngrant remedial relief of a kind that the court is unable to grant\nunder the law of that State or Territory.",
      "skos:definition": "This Part does not enable an inferior court of a State or Territory to\ngrant remedial relief of a kind that the court is unable to grant\nunder the law of that State or Territory.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-169-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-169-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0ded6e42698722b2507238c29f1d9ec4edc797b98820dd3a6ce0ae709f419cce",
      "skos:note": "No inferior court can grant remedial relief beyond its jurisdiction."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-169",
      "@type": "cof:Section",
      "cof:title": "169 State or Territory courts—jurisdictional limits",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "This Part does not enable an inferior court of a State or Territory to\ngrant remedial relief of a kind that the court is unable to grant\nunder the law of that State or Territory."
    },
    {
