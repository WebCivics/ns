        }
      ],
      "cml:integrityHash": "90c13f3b99ecb375a745a55a6b72c395d86ff3b369a4bb0f95c0aa2a3aefe775",
      "skos:note": "Obstructing another person acting under a stored communications warrant is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-132-ss-1",
      "@type": "cof:Section",
      "cof:title": "132(1) Obstruction",
      "values:kind": "subsection",
      "cof:pageNumber": 27,
      "values:originalText": "(1) A person commits an offence if the person obstructs or hinders\nanother person acting under a stored communications warrant.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both."
    },
