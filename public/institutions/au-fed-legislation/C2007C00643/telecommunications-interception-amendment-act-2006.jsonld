    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Renewals of warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.85",
      "values:originalText": "To avoid doubt, a warrant issued after the commencement of this\nSchedule under section 46 or 46A of the Telecommunications\n(Interception) Act 1979 may be, for the purposes of that Act, a renewal\nof a warrant issued before that commencement under section 45 or 45A\nof that Act.\n\nSchedule 5  Transfer of functions",
      "skos:definition": "To avoid doubt, a warrant issued after the commencement of this\nSchedule under section 46 or 46A of the Telecommunications\n(Interception) Act 1979 may be, for the purposes of that Act, a renewal\nof a warrant issued before that commencement under section 45 or 45A\nof that Act.\n\nSchedule 5  Transfer of functions",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-34-norm"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-34-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-34-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-34-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-34-logic-diffusion-4"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-4-sec-34-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "353fb8b73c1e42d3b84b34737273d0f8dd587ffb459d5c1253b3e78e80c77072",
      "skos:note": "Renewal of warrants issued after commencement under section 46 or 46A"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-4-sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Renewals of warrants",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "To avoid doubt, a warrant issued after the commencement of this\nSchedule under section 46 or 46A of the Telecommunications\n(Interception) Act 1979 may be, for the purposes of that Act, a renewal\nof a warrant issued before that commencement under section 45 or 45A\nof that Act.\n\nSchedule 5  Transfer of functions"
    },
