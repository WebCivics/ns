        }
      ],
      "cml:integrityHash": "3621ce29d1990b0135646e312fdeb38110a38ba99a11850fa19583011c193b4d",
      "skos:note": "Chief officer must inform Managing Director of revocation and provide certified copy.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-123-ss-2",
