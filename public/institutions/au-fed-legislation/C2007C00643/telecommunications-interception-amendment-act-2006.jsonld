    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-132",
      "@type": "cml:Concept",
      "skos:prefLabel": "132 Obstruction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-132"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-amendment-act-2006.pdf"
      },
      "dc:source": "telecommunications-interception-amendment-act-2006.pdf, p.27",
      "values:originalText": "(1) A person commits an offence if the person obstructs or hinders\nanother person acting under a stored communications warrant.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\n\n(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).",
      "skos:definition": "(1) A person commits an offence if the person obstructs or hinders\nanother person acting under a stored communications warrant.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\n\n(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-132-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-132-ss-2"
        }
      ],
      "cml:integrityHash": "3691e9068da3abb7bb886d152303eec26e598c608d434ef6afb2016a5f56e053"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-amendment-act-2006#sch-1-sec-132",
      "@type": "cof:Section",
      "cof:title": "132 Obstruction",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "(1) A person commits an offence if the person obstructs or hinders\nanother person acting under a stored communications warrant.\nPenalty: Imprisonment for 6 months or 30 penalty units, or both.\n\n(2) Subsection (1) does not apply if the person obstructing or hindering\nhas a reasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code)."
    },
    {
      "@id": "concept:telecommunications-interception-amendment-act-2006-sch-1-sec-132-ss-1",
