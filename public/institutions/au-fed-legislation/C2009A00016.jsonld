      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of disclosing or using information without permission.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) A person commits an offence if:  (a) information is disclosed to the person as permitted by subsection 295V(1) or (2) or 295W(1); and  (b) the person uses or discloses the information; and  (c) the use or disclosure referred to in paragraph (b) of this subsection is not for a purpose connected with persons being alerted to the emergency or likely emergency concerned."
    },
