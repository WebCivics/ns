    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf, p.12",
      "skos:note": "Disclosing information without permission is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "8 Telecommunications Amendment (Integrated Public Number Database) Act 2009       No."
      },
      "wasDerivedFrom": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf",
      "asserts": [
        "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-norm",
