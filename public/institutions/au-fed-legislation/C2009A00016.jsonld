        "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-alleninterval-2",
        "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-ltl-3",
        "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-cogai-4",
        "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-shacl-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "dc8645eedc2658230923edd56c30b9c604c43ebdd321761165424c4ce4d03ce2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-8",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition applies to a specific time period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines a temporal interval for the prohibition.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "The provision specifies a penalty of imprisonment for 2 years."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition can be represented using knowledge representation techniques.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Represents knowledge about the prohibition in a formal way.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge Representation",
      "cml:premiseText": "The provision specifies conditions under which disclosure is permitted."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The use or disclosure referred to in paragraph (b) of this subsection is not for a purpose connected with persons being alerted to an emergency or a likely emergency.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits disclosure of information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Information is disclosed to the person as permitted by subsection 295V(4) or 295W(3); and"
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition applies to cases where disclosure is not permitted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Defines a recurring trace for the prohibition.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:premiseText": "The provision specifies conditions under which disclosure is permitted."
    },
    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-8-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision can be validated against a set of rules.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:logicSummary": "Validates the provision against a set of rules.",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "Validation",
      "cml:premiseText": "The provision specifies conditions under which disclosure is permitted."
    },
