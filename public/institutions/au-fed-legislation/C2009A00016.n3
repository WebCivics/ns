concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295za-ss-1 cml:asserts concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295za-ss-1-logic-deontic-1 .
concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295za-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of disclosing or using information without permission." ;
    cml:premiseText "(1) A person commits an offence if:  (a) information is disclosed to the person as permitted by subsection 295V(1) or (2) or 295W(1); and  (b) the person uses or discloses the information; and  (c) the use or disclosure referred to in paragraph (b) of this subsection is not for a purpose connected with persons being alerted to the emergency or likely emergency concerned." ;
    cml:conclusionText "(Penalty: Imprisonment for 2 years.)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


