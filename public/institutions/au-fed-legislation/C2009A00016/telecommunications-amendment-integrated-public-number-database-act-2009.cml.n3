concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-302a-ss-2 a cml:Concept ;
    skos:prefLabel "302A(2) Location dependent carriage services"@en ;
    cml:realizedBy doc:sch-1-sec-302a-ss-2 ;
    values:originalText "(2) In this section: location dependent carriage service means a carriage service that depends for its provision on the availability of information about the addresses of end users of the carriage service." ;
    skos:definition "(2) In this section: location dependent carriage service means a carriage service that depends for its provision on the availability of information about the addresses of end users of the carriage service."@en ;
