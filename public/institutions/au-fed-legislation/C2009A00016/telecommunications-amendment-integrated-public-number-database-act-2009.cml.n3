doc:sch-1-sec-295y a cof:Section ;
    cof:title "295Y Coronial and other inquiries" ;
    values:kind "section" ;
    values:originalText "The disclosure of relevant information to:  (a) a coronial inquiry; or  Amendments  Schedule 1 Data for emergency warnings  Part 1  2009            7  (b) another inquiry specified by the Minister administering the Administrative Decisions (Judicial Review) Act 1977, by legislative instrument, for the purposes of this paragraph; in relation to an emergency or likely emergency is taken, for the purposes of this Division, to be a disclosure for a purpose connected with persons being alerted to the emergency or likely emergency concerned." ;
    cof:pageNumber "10"^^xsd:integer .

concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295z a cml:Concept ;
    skos:prefLabel "295Z Offence—use or disclosure of information by emergency"@en ;
    cml:realizedBy doc:sch-1-sec-295z ;
    values:originalText "management persons  An emergency management person commits an offence if:  (a) the person uses or discloses relevant information; and  (b) the use or disclosure is not permitted under section 295V. Penalty: Imprisonment for 2 years." ;
    skos:definition "management persons  An emergency management person commits an offence if:  (a) the person uses or discloses relevant information; and  (b) the use or disclosure is not permitted under section 295V. Penalty: Imprisonment for 2 years."@en ;
