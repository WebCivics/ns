concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295ze a cml:Concept ;
    skos:prefLabel "295ZE Commonwealth immunity"@en ;
    cml:realizedBy doc:sch-1-sec-295ze ;
    values:originalText "No action, suit or proceeding lies against the Commonwealth in relation to loss, damage or injury to any person or property as a result of the use or disclosure of relevant information:  (a) for a purpose connected with persons being alerted to an emergency or a likely emergency; or  (b) for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency." ;
    skos:definition "No action, suit or proceeding lies against the Commonwealth in relation to loss, damage or injury to any person or property as a result of the use or disclosure of relevant information:  (a) for a purpose connected with persons being alerted to an emergency or a likely emergency; or  (b) for the purpose of reasonable testing of whether, in the event of an emergency occurring, persons would be able to be alerted to that emergency."@en ;
    cml:integrityHash "bce3f90d3e5812652c3d8967f6bd608c78d2a30982a214abc4ca9693f6706e62" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "No action can be taken against the Commonwealth in relation to loss, damage or injury resulting from the use or disclosure of relevant information for specific purposes." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-amendment-integrated-public-number-database-act-2009.pdf> ;
    dc:source "telecommunications-amendment-integrated-public-number-database-act-2009.pdf, p.13" ;
    cml:asserts concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295ze-norm .
