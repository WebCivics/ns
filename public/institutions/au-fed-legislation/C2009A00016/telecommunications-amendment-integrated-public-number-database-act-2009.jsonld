        }
      ],
      "cml:integrityHash": "003197d2e74a2f897d1e267477c7a9d91ca09389dfa63fcc391fc4b954f95890",
      "skos:note": "Disclosing information to others without permission is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295za-ss-2",
      "@type": "cof:Section",
      "cof:title": "295ZA(2) Offence—use or disclosure of information by other persons",
      "values:kind": "subsection",
      "cof:pageNumber": 11,
      "values:originalText": "(2) A person commits an offence if:\n\n(a) information is disclosed to the person as permitted by\nsubsection 295V(3) or 295W(2); and\n\n(b) the person uses or discloses the information; and\n\n(c) the use or disclosure referred to in paragraph (b) of this\nsubsection is not for the purpose of reasonable testing of\nwhether, in the event of an emergency occurring, persons\nwould be able to be alerted to that emergency.\nPenalty: Imprisonment for 2 years."
    },
