      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf, p.11",
      "values:originalText": "management persons\n\nAn emergency management person commits an offence if:\n\n(a) the person uses or discloses relevant information; and\n\n(b) the use or disclosure is not permitted under section 295V.\nPenalty: Imprisonment for 2 years.",
      "skos:definition": "management persons\n\nAn emergency management person commits an offence if:\n\n(a) the person uses or discloses relevant information; and\n\n(b) the use or disclosure is not permitted under section 295V.\nPenalty: Imprisonment for 2 years.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295z-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295z-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "70e4142d375014cdec740b413d6c7f20f6cb60dba46983728289cb2347568f45",
      "skos:note": "Using or disclosing relevant information without permission under section 295V is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295z",
      "@type": "cof:Section",
      "cof:title": "295Z Offence—use or disclosure of information by emergency",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "management persons\n\nAn emergency management person commits an offence if:\n\n(a) the person uses or discloses relevant information; and\n\n(b) the use or disclosure is not permitted under section 295V.\nPenalty: Imprisonment for 2 years."
    },
