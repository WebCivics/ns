    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295ze",
      "@type": "cml:Concept",
      "skos:prefLabel": "295ZE Commonwealth immunity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295ze"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf, p.13",
      "values:originalText": "No action, suit or proceeding lies against the Commonwealth in\nrelation to loss, damage or injury to any person or property as a\nresult of the use or disclosure of relevant information:\n\n(a) for a purpose connected with persons being alerted to an\nemergency or a likely emergency; or\n\n(b) for the purpose of reasonable testing of whether, in the event\nof an emergency occurring, persons would be able to be\nalerted to that emergency.",
      "skos:definition": "No action, suit or proceeding lies against the Commonwealth in\nrelation to loss, damage or injury to any person or property as a\nresult of the use or disclosure of relevant information:\n\n(a) for a purpose connected with persons being alerted to an\nemergency or a likely emergency; or\n\n(b) for the purpose of reasonable testing of whether, in the event\nof an emergency occurring, persons would be able to be\nalerted to that emergency.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295ze-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295ze-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bce3f90d3e5812652c3d8967f6bd608c78d2a30982a214abc4ca9693f6706e62",
      "skos:note": "No action can be taken against the Commonwealth in relation to loss, damage or injury resulting from the use or disclosure of relevant information for specific purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295ze",
      "@type": "cof:Section",
      "cof:title": "295ZE Commonwealth immunity",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "No action, suit or proceeding lies against the Commonwealth in\nrelation to loss, damage or injury to any person or property as a\nresult of the use or disclosure of relevant information:\n\n(a) for a purpose connected with persons being alerted to an\nemergency or a likely emergency; or\n\n(b) for the purpose of reasonable testing of whether, in the event\nof an emergency occurring, persons would be able to be\nalerted to that emergency."
    },
