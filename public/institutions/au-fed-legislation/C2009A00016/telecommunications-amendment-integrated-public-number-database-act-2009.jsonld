      "cml:integrityHash": "837e3c01a699153d50f434a15cfaa85ed33976d20970c81f3c06a93d76217cab",
      "skos:note": "Use or disclosure of information by emergency management for a purpose connected with persons being alerted to a likely emergency."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295v-ss-1",
      "@type": "cof:Section",
      "cof:title": "295V(1) Use or disclosure of information by emergency management",
      "values:kind": "subsection",
      "cof:pageNumber": 9,
      "values:originalText": "(1) If an emergency management person believes on reasonable\ngrounds that an emergency is likely to occur, the person may use or\ndisclose relevant information (other than the names of persons) for\na purpose connected with persons being alerted to that likely\nemergency.\nActual emergencies"
    },
