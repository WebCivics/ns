          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295zd-ss-1"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295zd-ss-2"
        }
      ],
      "cml:integrityHash": "5b41590595ee6033051fce48e140dfc0e6fed76eda8a64fd712de03892679d56"
    },
    {
