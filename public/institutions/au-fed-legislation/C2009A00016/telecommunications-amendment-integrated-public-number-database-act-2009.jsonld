    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295y",
      "@type": "cml:Concept",
      "skos:prefLabel": "295Y Coronial and other inquiries",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295y"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf, p.10",
      "values:originalText": "The disclosure of relevant information to:\n\n(a) a coronial inquiry; or\n\nAmendments  Schedule 1\nData for emergency warnings  Part 1\n\n2009            7\n\n(b) another inquiry specified by the Minister administering the\nAdministrative Decisions (Judicial Review) Act 1977, by\nlegislative instrument, for the purposes of this paragraph;\nin relation to an emergency or likely emergency is taken, for the\npurposes of this Division, to be a disclosure for a purpose\nconnected with persons being alerted to the emergency or likely\nemergency concerned.",
      "skos:definition": "The disclosure of relevant information to:\n\n(a) a coronial inquiry; or\n\nAmendments  Schedule 1\nData for emergency warnings  Part 1\n\n2009            7\n\n(b) another inquiry specified by the Minister administering the\nAdministrative Decisions (Judicial Review) Act 1977, by\nlegislative instrument, for the purposes of this paragraph;\nin relation to an emergency or likely emergency is taken, for the\npurposes of this Division, to be a disclosure for a purpose\nconnected with persons being alerted to the emergency or likely\nemergency concerned.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295y-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295y-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "09baca9f88537b073cb2fa01c44c1f42a01cd343a77d3b922c52cd139f6b09e9",
      "skos:note": "Disclosure of relevant information to specified inquiries."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295y",
      "@type": "cof:Section",
      "cof:title": "295Y Coronial and other inquiries",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "The disclosure of relevant information to:\n\n(a) a coronial inquiry; or\n\nAmendments  Schedule 1\nData for emergency warnings  Part 1\n\n2009            7\n\n(b) another inquiry specified by the Minister administering the\nAdministrative Decisions (Judicial Review) Act 1977, by\nlegislative instrument, for the purposes of this paragraph;\nin relation to an emergency or likely emergency is taken, for the\npurposes of this Division, to be a disclosure for a purpose\nconnected with persons being alerted to the emergency or likely\nemergency concerned."
    },
