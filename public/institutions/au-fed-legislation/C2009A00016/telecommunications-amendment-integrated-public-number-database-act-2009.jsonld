    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295x",
      "@type": "cml:Concept",
      "skos:prefLabel": "295X Effect on telecommunications network",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf, p.10",
      "values:originalText": "In using or disclosing information that is permitted by\nsection 295V or 295W, a person must take reasonable steps to\nensure that the use or disclosure does not adversely affect the\noperation of a telecommunications network.",
      "skos:definition": "In using or disclosing information that is permitted by\nsection 295V or 295W, a person must take reasonable steps to\nensure that the use or disclosure does not adversely affect the\noperation of a telecommunications network.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295x-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295x-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ed1178f0d6ab9574d1c7f4e4ee92fd76cb11283e71a41042522b3c01915c3a9f",
      "skos:note": "Must take reasonable steps to ensure no adverse effect on telecommunications network."
    },
    {
