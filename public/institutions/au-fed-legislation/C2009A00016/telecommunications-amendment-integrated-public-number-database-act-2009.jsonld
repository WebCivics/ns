    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295zc",
      "@type": "cml:Concept",
      "skos:prefLabel": "295ZC Annual reports to the ACMA and Privacy Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295zc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf"
      },
      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf, p.12",
      "values:originalText": "If an emergency management person discloses relevant\ninformation during a financial year, the person must, within 2\nmonths after the end of that financial year, give a written report to\nthe ACMA and to the Privacy Commissioner that covers the\nfollowing matters in relation to each such disclosure:\n\n(a) if the disclosure occurred under subsection 295V(1) or (2)—a\ndescription of the emergency or likely emergency concerned\nand its location;\n\n(b) in any case—the number of telephone numbers that were\ndisclosed and the day that disclosure occurred;\n\nAmendments  Schedule 1\nData for emergency warnings  Part 1\n\n2009            9\n\n(c) in any case—the number of persons to whom the emergency\nmanagement person disclosed those numbers and the purpose\nof each disclosure (whether the disclosure occurred in that\nfinancial year or the following financial year).",
      "skos:definition": "If an emergency management person discloses relevant\ninformation during a financial year, the person must, within 2\nmonths after the end of that financial year, give a written report to\nthe ACMA and to the Privacy Commissioner that covers the\nfollowing matters in relation to each such disclosure:\n\n(a) if the disclosure occurred under subsection 295V(1) or (2)—a\ndescription of the emergency or likely emergency concerned\nand its location;\n\n(b) in any case—the number of telephone numbers that were\ndisclosed and the day that disclosure occurred;\n\nAmendments  Schedule 1\nData for emergency warnings  Part 1\n\n2009            9\n\n(c) in any case—the number of persons to whom the emergency\nmanagement person disclosed those numbers and the purpose\nof each disclosure (whether the disclosure occurred in that\nfinancial year or the following financial year).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295zc-norm"
        },
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295zc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9ac5423858d108ca2bbe12564e2c99ffadf2bdb59b5719a8658bef1146626e17",
      "skos:note": "Annual report to ACMA and Privacy Commissioner within 2 months after end of financial year for disclosure of relevant information.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295zc",
      "@type": "cof:Section",
      "cof:title": "295ZC Annual reports to the ACMA and Privacy Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "If an emergency management person discloses relevant\ninformation during a financial year, the person must, within 2\nmonths after the end of that financial year, give a written report to\nthe ACMA and to the Privacy Commissioner that covers the\nfollowing matters in relation to each such disclosure:\n\n(a) if the disclosure occurred under subsection 295V(1) or (2)—a\ndescription of the emergency or likely emergency concerned\nand its location;\n\n(b) in any case—the number of telephone numbers that were\ndisclosed and the day that disclosure occurred;\n\nAmendments  Schedule 1\nData for emergency warnings  Part 1\n\n2009            9\n\n(c) in any case—the number of persons to whom the emergency\nmanagement person disclosed those numbers and the purpose\nof each disclosure (whether the disclosure occurred in that\nfinancial year or the following financial year)."
    },
