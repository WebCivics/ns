    {
      "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sch-1-sec-295z",
      "@type": "cml:Concept",
      "skos:prefLabel": "295Z Offence—use or disclosure of information by emergency",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-amendment-integrated-public-number-database-act-2009#sch-1-sec-295z"
      },
      "cml:curationStatus": {
