      "dc:source": "telecommunications-amendment-integrated-public-number-database-act-2009.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nData for emergency warnings  Part 1\n\n2009            3",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nData for emergency warnings  Part 1\n\n2009            3",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-amendment-integrated-public-number-database-act-2009-sec-3-norm"
        }
      ],
      "cml:integrityHash": "7d13c12e6c9c6fbd21727202d8477b28b314e3125905945ee03db07a8e47377a",
      "skos:note": "Amendments to Acts specified in a Schedule"
    },
