      ],
      "cml:integrityHash": "f09a3bbc92e0bc0b8582d8c95659ad70e4c0f99610560a4f4d24fda2dea935e9",
      "skos:note": "Must provide written report to Minister and ACMA with certain information after disclosure.",
      "dc:description": "Yes"
    },
    {
