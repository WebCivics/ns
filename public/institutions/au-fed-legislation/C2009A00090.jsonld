    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is eligible to become an Australian citizen if they were a permanent resident at the time of application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Residency requirement during application period",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The person must have been a permanent resident at the time of application."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is eligible to become an Australian citizen if the Minister is satisfied that the person meets the requirements.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Citizenship eligibility obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "The Minister must satisfy certain conditions for citizenship."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person is eligible to become an Australian citizen if the Minister is satisfied that the person meets the requirements.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Application processing permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasPermission",
      "cml:premiseText": "The Minister has discretion to approve or reject applications."
