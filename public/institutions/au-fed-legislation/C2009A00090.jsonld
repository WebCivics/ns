      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person aged under 18 is eligible to become an Australian citizen if the Minister is satisfied that the person meets the requirements.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
