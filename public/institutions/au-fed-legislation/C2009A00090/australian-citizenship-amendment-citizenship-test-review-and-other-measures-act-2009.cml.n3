concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-3 a cml:Concept ;
    skos:prefLabel "3 Paragraph 21(3)(d)"@en ;
    cml:realizedBy doc:sch-1-sec-3 ;
    values:originalText "Repeal the paragraph, substitute:  (d) has a permanent or enduring physical or mental incapacity, at the time the person made the application, that means the person:  (i) is not capable of understanding the nature of the application at that time; or  (ii) is not capable of demonstrating a basic knowledge of the English language at that time; or  (iii) is not capable of demonstrating an adequate knowledge of Australia and of the responsibilities and privileges of Australian citizenship at that time; and  Schedule 1  Amendments relating to citizenship test review etc." ;
    skos:definition "Repeal the paragraph, substitute:  (d) has a permanent or enduring physical or mental incapacity, at the time the person made the application, that means the person:  (i) is not capable of understanding the nature of the application at that time; or  (ii) is not capable of demonstrating a basic knowledge of the English language at that time; or  (iii) is not capable of demonstrating an adequate knowledge of Australia and of the responsibilities and privileges of Australian citizenship at that time; and  Schedule 1  Amendments relating to citizenship test review etc."@en ;
    cml:integrityHash "54708a65d19fb336deeda32495aaf813e06917ba0f7fd02571d52b21adec6ddf" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "A person must demonstrate a basic knowledge of English, Australia, and Australian citizenship to apply." ;
    dc:description "Basic knowledge" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
