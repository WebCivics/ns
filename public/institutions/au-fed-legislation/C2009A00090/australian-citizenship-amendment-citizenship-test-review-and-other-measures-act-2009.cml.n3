concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-2-sec-2009-ss-5 a cml:Concept ;
    skos:prefLabel "2009(5) No. 90, 2009"@en ;
    cml:realizedBy doc:sch-2-sec-2009-ss-5 ;
    values:originalText "(5) For the purposes of paragraph (1)(g), the Minister may treat a period as one in which the applicant was not present in Australia as an unlawful non-citizen if the Minister considers the applicant was present in Australia during that period but, because of an administrative error, was an unlawful non-citizen during that period." ;
    skos:definition "(5) For the purposes of paragraph (1)(g), the Minister may treat a period as one in which the applicant was not present in Australia as an unlawful non-citizen if the Minister considers the applicant was present in Australia during that period but, because of an administrative error, was an unlawful non-citizen during that period."@en ;
    cml:integrityHash "7d5011406870654823a819736665daad769e45618c15d46b151cf2964dbd2588" ;
    values:partOf concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-2-sec-2009 ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "The Minister may treat a period as unlawful non-citizen if an administrative error occurred." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
