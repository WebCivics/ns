    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Temporal relation between periods of presence and absence" ;
    cml:premiseText "The person was not present in Australia during that period but was present in Australia during another period" ;
    cml:conclusionText "Treat the period as an unlawful non-citizen if administrative error occurred" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
