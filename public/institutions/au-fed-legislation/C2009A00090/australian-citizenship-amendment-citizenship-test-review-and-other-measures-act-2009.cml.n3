concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-2-sec-22b-ss-3 a cml:Concept ;
    skos:prefLabel "22B(3) Special residence requirement—persons engaged in particular"@en ;
    cml:realizedBy doc:sch-2-sec-22b-ss-3 ;
    values:originalText "(3) The Minister may decide that subsection (2) does not apply in relation to the person if, taking into account the circumstances that resulted in the person’s confinement, the Minister is satisfied that it would be unreasonable for that subsection to apply in relation to the person. Ministerial discretion—administrative error" ;
    skos:definition "(3) The Minister may decide that subsection (2) does not apply in relation to the person if, taking into account the circumstances that resulted in the person’s confinement, the Minister is satisfied that it would be unreasonable for that subsection to apply in relation to the person. Ministerial discretion—administrative error"@en ;
    cml:integrityHash "fa9e91168a48f5594e0bc6d69127992ea600a9f7f22c9280575b99c1c1d5224c" ;
    values:partOf concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-2-sec-22b ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Minister's discretion to waive subsection (2) application" ;
    cml:curationStatus cml:Proposed ;
