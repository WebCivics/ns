doc:sch-1-sec-7 a cof:Section ;
    cof:title "7 Paragraph 26(1)(b)" ;
    values:kind "section" ;
    values:originalText "Repeal the paragraph, substitute:  (b) has a permanent or enduring physical or mental incapacity, at the time the person made the application to become an Australian citizen, that means the person:  (i) is not capable of understanding the nature of the application at that time; or  (ii) is not capable of demonstrating a basic knowledge of the English language at that time; or  (iii) is not capable of demonstrating an adequate knowledge of Australia and of the responsibilities and privileges of Australian citizenship at that time; or" ;
    cof:pageNumber "8"^^xsd:integer .

concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-8 a cml:Concept ;
    skos:prefLabel "8 Subsection 46(1A)"@en ;
    cml:realizedBy doc:sch-1-sec-8 ;
    values:originalText "Repeal the subsection, substitute:  Amendments relating to citizenship test review etc.  Schedule 1  Australian Citizenship Amendment (Citizenship Test Review and Other Measures) Act 2009 No. 90, 2009            5  (1A) For applications made under section 21 by persons who, in order to be eligible to become an Australian citizen under subsection 21(2), must have sat a test approved in a determination under section 23A, the fee prescribed by the regulations may include a component that relates to the sitting of that test." ;
    skos:definition "Repeal the subsection, substitute:  Amendments relating to citizenship test review etc.  Schedule 1  Australian Citizenship Amendment (Citizenship Test Review and Other Measures) Act 2009 No. 90, 2009            5  (1A) For applications made under section 21 by persons who, in order to be eligible to become an Australian citizen under subsection 21(2), must have sat a test approved in a determination under section 23A, the fee prescribed by the regulations may include a component that relates to the sitting of that test."@en ;
    cml:integrityHash "ee1fd5897197e627a756fb1029b53eb4ce4d24ad4cad60f3b3404e0c9624bf6c" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Fee for test sitting may include a component related to the test." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
