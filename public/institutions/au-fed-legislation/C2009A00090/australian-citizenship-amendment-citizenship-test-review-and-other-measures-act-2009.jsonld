      "skos:note": "Defines periods for sitting and completing a test"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 After subsection 23A(5)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Insert:\nPeriod for sitting and completing the test\n\n(5A) A determination under subsection (1) may provide for the period\nwithin which a person must start the test and for the period within\nwhich a person must complete the test."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-6-norm",
