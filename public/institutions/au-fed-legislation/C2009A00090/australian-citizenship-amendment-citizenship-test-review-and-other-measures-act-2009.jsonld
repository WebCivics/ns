      "skos:prefLabel": "22B(5) Special residence requirement—persons engaged in particular",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-2-sec-22b-ss-5"
      },
