    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sec-3-2"
      },
      "cml:curationStatus": {
