    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Subsection 21(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf, p.8",
      "values:originalText": "Repeal the subsection, substitute:\nPerson aged under 18\n\n(5) A person is eligible to become an Australian citizen if the Minister\nis satisfied that the person:\n\n(a) is aged under 18 at the time the person made the application;\nand\n\n(b) is a permanent resident:\n\n(i) at the time the person made the application; and\n\n(ii) at the time of the Minister’s decision on the application.",
      "skos:definition": "Repeal the subsection, substitute:\nPerson aged under 18\n\n(5) A person is eligible to become an Australian citizen if the Minister\nis satisfied that the person:\n\n(a) is aged under 18 at the time the person made the application;\nand\n\n(b) is a permanent resident:\n\n(i) at the time the person made the application; and\n\n(ii) at the time of the Minister’s decision on the application.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-logic-ltl-3"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-logic-deontic-4"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "239a968cdec90f4d99c49b069f61d2845c337a30b160b9f379874ca8cef8babe",
      "skos:note": "Eligibility for Australian citizenship based on age and residency."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Subsection 21(5)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the subsection, substitute:\nPerson aged under 18\n\n(5) A person is eligible to become an Australian citizen if the Minister\nis satisfied that the person:\n\n(a) is aged under 18 at the time the person made the application;\nand\n\n(b) is a permanent resident:\n\n(i) at the time the person made the application; and\n\n(ii) at the time of the Minister’s decision on the application."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-5"
      },
      "values:deonticStatus": {
