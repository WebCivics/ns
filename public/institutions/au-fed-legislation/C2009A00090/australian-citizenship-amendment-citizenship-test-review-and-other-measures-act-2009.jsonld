      "cml:premiseText": "(a) and (b)",
      "cml:conclusionText": "(d)"
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Paragraph 21(3)(d)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf, p.7",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(d) has a permanent or enduring physical or mental incapacity, at\nthe time the person made the application, that means the\nperson:\n\n(i) is not capable of understanding the nature of the\napplication at that time; or\n\n(ii) is not capable of demonstrating a basic knowledge of\nthe English language at that time; or\n\n(iii) is not capable of demonstrating an adequate knowledge\nof Australia and of the responsibilities and privileges of\nAustralian citizenship at that time; and\n\nSchedule 1  Amendments relating to citizenship test review etc.",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(d) has a permanent or enduring physical or mental incapacity, at\nthe time the person made the application, that means the\nperson:\n\n(i) is not capable of understanding the nature of the\napplication at that time; or\n\n(ii) is not capable of demonstrating a basic knowledge of\nthe English language at that time; or\n\n(iii) is not capable of demonstrating an adequate knowledge\nof Australia and of the responsibilities and privileges of\nAustralian citizenship at that time; and\n\nSchedule 1  Amendments relating to citizenship test review etc.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-3-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-3-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "54708a65d19fb336deeda32495aaf813e06917ba0f7fd02571d52b21adec6ddf",
      "skos:note": "A person must demonstrate a basic knowledge of English, Australia, and Australian citizenship to apply.",
      "dc:description": "Basic knowledge"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Paragraph 21(3)(d)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(d) has a permanent or enduring physical or mental incapacity, at\nthe time the person made the application, that means the\nperson:\n\n(i) is not capable of understanding the nature of the\napplication at that time; or\n\n(ii) is not capable of demonstrating a basic knowledge of\nthe English language at that time; or\n\n(iii) is not capable of demonstrating an adequate knowledge\nof Australia and of the responsibilities and privileges of\nAustralian citizenship at that time; and\n\nSchedule 1  Amendments relating to citizenship test review etc."
    },
