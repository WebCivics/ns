    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Paragraph 26(1)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf, p.8",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) has a permanent or enduring physical or mental incapacity, at\nthe time the person made the application to become an\nAustralian citizen, that means the person:\n\n(i) is not capable of understanding the nature of the\napplication at that time; or\n\n(ii) is not capable of demonstrating a basic knowledge of\nthe English language at that time; or\n\n(iii) is not capable of demonstrating an adequate knowledge\nof Australia and of the responsibilities and privileges of\nAustralian citizenship at that time; or",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) has a permanent or enduring physical or mental incapacity, at\nthe time the person made the application to become an\nAustralian citizen, that means the person:\n\n(i) is not capable of understanding the nature of the\napplication at that time; or\n\n(ii) is not capable of demonstrating a basic knowledge of\nthe English language at that time; or\n\n(iii) is not capable of demonstrating an adequate knowledge\nof Australia and of the responsibilities and privileges of\nAustralian citizenship at that time; or",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-7-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-7-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-7-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-7-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "c2168b7167a53f3fc120de4ad8b3aad0c4f8e5a89edc67d601bbc0b1ecf389d1",
      "skos:note": "Citizenship application inadmissible due to permanent or enduring physical or mental incapacity"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Paragraph 26(1)(b)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) has a permanent or enduring physical or mental incapacity, at\nthe time the person made the application to become an\nAustralian citizen, that means the person:\n\n(i) is not capable of understanding the nature of the\napplication at that time; or\n\n(ii) is not capable of demonstrating a basic knowledge of\nthe English language at that time; or\n\n(iii) is not capable of demonstrating an adequate knowledge\nof Australia and of the responsibilities and privileges of\nAustralian citizenship at that time; or"
    },
