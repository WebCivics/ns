        }
      ],
      "cml:integrityHash": "3a5440f08768036f89d5e3154d3308baec0690f0f0ca671f2427e68ddad27bfd"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-2-sec-2009",
