      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments relating to citizenship test review etc.  Schedule 1\n\nAustralian Citizenship Amendment (Citizenship Test Review and Other Measures) Act 2009\nNo. 90, 2009            3",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments relating to citizenship test review etc.  Schedule 1\n\nAustralian Citizenship Amendment (Citizenship Test Review and Other Measures) Act 2009\nNo. 90, 2009            3",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "1d3a2802d6a07cf9b9d99d640a933dd23279554cd745e5bad2357694872f4061",
      "skos:note": "Schedules amendment and repeal rules"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments relating to citizenship test review etc.  Schedule 1\n\nAustralian Citizenship Amendment (Citizenship Test Review and Other Measures) Act 2009\nNo. 90, 2009            3"
    },
