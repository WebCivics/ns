    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 21(2A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009.pdf, p.7",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2A) Paragraphs (2)(d), (e) and (f) are taken to be satisfied if and only if\nthe Minister is satisfied that the following apply:\n\n(a) the person has sat a test approved in a determination under\nsection 23A;\n\n(b) the person was eligible to sit that test (worked out in\naccordance with that determination);\n\n(c) the person started that test within the period worked out in\naccordance with that determination and completed that test\nwithin the period (the relevant test period) worked out in\naccordance with that determination;\n\n(d) the person successfully completed that test (worked out in\naccordance with that determination) within the relevant test\nperiod.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2A) Paragraphs (2)(d), (e) and (f) are taken to be satisfied if and only if\nthe Minister is satisfied that the following apply:\n\n(a) the person has sat a test approved in a determination under\nsection 23A;\n\n(b) the person was eligible to sit that test (worked out in\naccordance with that determination);\n\n(c) the person started that test within the period worked out in\naccordance with that determination and completed that test\nwithin the period (the relevant test period) worked out in\naccordance with that determination;\n\n(d) the person successfully completed that test (worked out in\naccordance with that determination) within the relevant test\nperiod.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-2-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9bfff5777d61cc9be9835658bf27924aca7b09c0a0de4a11702dd694b00be7f4",
      "skos:note": "Eligibility for test completion is conditional on meeting specific requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsection 21(2A)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2A) Paragraphs (2)(d), (e) and (f) are taken to be satisfied if and only if\nthe Minister is satisfied that the following apply:\n\n(a) the person has sat a test approved in a determination under\nsection 23A;\n\n(b) the person was eligible to sit that test (worked out in\naccordance with that determination);\n\n(c) the person started that test within the period worked out in\naccordance with that determination and completed that test\nwithin the period (the relevant test period) worked out in\naccordance with that determination;\n\n(d) the person successfully completed that test (worked out in\naccordance with that determination) within the relevant test\nperiod."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-test-review-and-other-measures-act-2009-sch-1-sec-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
