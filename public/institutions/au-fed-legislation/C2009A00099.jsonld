    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-58e-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Authorized personnel have a temporal interval for accessing the document.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for authorized access",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "The Tribunal must return the document to a person within a certain time frame."
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-58e-ss-3-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Authorized access implies non-disclosure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of authorized access on disclosure",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "If a person is authorized to access the document, then they must not be disclosed."
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-58e-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Authorized access is inferred from the Tribunal's decision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Inference of authorized access from Tribunal decision",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "The Tribunal's decision implies that a person is authorized to access the document."
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-58e-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Unauthorized persons are prohibited from accessing the document.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of disclosure",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Tribunal must not disclose document contents."
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-58e-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Unauthorized disclosure is contained by returning the document to an authorized person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Containment of unauthorized disclosure",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Containment",
      "cml:premiseText": "The Tribunal must contain unauthorized disclosure by returning the document to a person who is authorized."
    },
