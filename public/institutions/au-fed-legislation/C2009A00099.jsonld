    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-2009-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal must have regard to...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Tribunal has a duty to consider certain factors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(1) In determining whether the Tribunal is satisfied that it is desirable to make an order or orders under subsection 35(2) of the Administrative Appeals Tribunal Act 1975, the Tribunal must:"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-2009-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal must consider the necessity of avoiding disclosure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Tribunal has a duty to avoid disclosure of exempt matter.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) have regard to: (i) the necessity of avoiding the disclosure to the applicant of exempt matter contained in a document to which the proceedings relate;"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-2009-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal must consider the necessity of avoiding disclosure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Tribunal has a duty to avoid disclosure of information of a certain kind.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) have regard to: (ii) the necessity of avoiding the disclosure to the applicant of information of the kind referred to in subsection 25(1);"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-2009-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal must give particular weight to certain submissions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Tribunal has a duty to give particular weight to certain submissions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(b) where the proceedings relate to a document that is claimed to be an exempt document under section 33—give particular weight to a submission made by an agency or a Minister that it is desirable to make the order or orders under subsection 35(2) of the Administrative Appeals Tribunal Act 1975"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-2009-4-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal must avoid disclosure that could cause damage or divulge confidential information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Tribunal has a duty to avoid disclosure that could cause damage or divulge confidential information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(b) where the proceedings relate to a document that is claimed to be an exempt document under section 33—give particular weight to a submission made by an agency or a Minister that it is desirable to make the order or orders under subsection 35(2) of the Administrative Appeals Tribunal Act 1975"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-2009-4-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal must make an order if certain conditions are met.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Tribunal has a duty to make an order if certain conditions are met.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(b) where the proceedings relate to a document that is claimed to be an exempt document under section 33—give particular weight to a submission made by an agency or a Minister that it is desirable to make the order or orders under subsection 35(2) of the Administrative Appeals Tribunal Act 1975"
    },
