    <https://ns.webcivics.net/cml/operator> "MUST";
    <https://ns.webcivics.net/cml/logicSummary> "Tribunal has a duty to avoid disclosure of information of a certain kind.";
    <https://ns.webcivics.net/cml/premiseText> "(a) have regard to: (ii) the necessity of avoiding the disclosure to the applicant of information of the kind referred to in subsection 25(1);";
    <https://ns.webcivics.net/cml/conclusionText> "The Tribunal must consider the necessity of avoiding disclosure.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
