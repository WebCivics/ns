    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "MUST";
    <https://ns.webcivics.net/cml/logicSummary> "Tribunal has a duty to avoid disclosure of exempt matter.";
    <https://ns.webcivics.net/cml/premiseText> "(a) have regard to: (i) the necessity of avoiding the disclosure to the applicant of exempt matter contained in a document to which the proceedings relate;";
    <https://ns.webcivics.net/cml/conclusionText> "The Tribunal must consider the necessity of avoiding disclosure.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
