doc:sch-2-sec-55a-ss-4 a cof:Section ;
    cof:title "55A(4) Automatic stay of certain decisions on appeal" ;
    values:kind "subsection" ;
    values:originalText "(4) If the Archives appeals to the Federal Court of Australia from the decision of the Tribunal and the appeal in relation to the decision is determined by the Federal Magistrates Court, the stay continues to have effect until the earlier of:  (a) the time at which the decision of the Federal Magistrates Court on the appeal takes effect; and  (b) the time otherwise determined by the Federal Magistrates Court." ;
    cof:pageNumber "24"^^xsd:integer .

concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-55a-ss-5 a cml:Concept ;
    skos:prefLabel "55A(5) Automatic stay of certain decisions on appeal"@en ;
    cml:realizedBy doc:sch-2-sec-55a-ss-5 ;
    values:originalText "(5) Nothing in this section affects the power of the Federal Court of Australia or the Federal Magistrates Court to make orders under section 44A of the Administrative Appeals Tribunal Act 1975 in relation to matters other than staying the decision of the Tribunal." ;
    skos:definition "(5) Nothing in this section affects the power of the Federal Court of Australia or the Federal Magistrates Court to make orders under section 44A of the Administrative Appeals Tribunal Act 1975 in relation to matters other than staying the decision of the Tribunal."@en ;
