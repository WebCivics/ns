concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-53 a cml:Concept ;
    skos:prefLabel "53 Interpretation"@en ;
    cml:realizedBy doc:sch-1-sec-53 ;
    values:originalText "For the purposes of this Part, unless the contrary intention appears, a claim that a document would, if it exists, be an exempt document under section 33, 33A, 34 or 35 is to be deemed to be a claim that the document is an exempt document under that section despite the fact that the existence or non-existence of the document is not acknowledged." ;
    skos:definition "For the purposes of this Part, unless the contrary intention appears, a claim that a document would, if it exists, be an exempt document under section 33, 33A, 34 or 35 is to be deemed to be a claim that the document is an exempt document under that section despite the fact that the existence or non-existence of the document is not acknowledged."@en ;
    cml:integrityHash "aef46ce875c8269add4bb8bc1c970b5d14051f79e22b8a6735ca66bf9e621493" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Deems a claim that a document is exempt under certain sections as an obligation to acknowledge the existence or non-existence of the document." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf> ;
    dc:source "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf, p.8" ;
    cml:asserts concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-53-norm .
