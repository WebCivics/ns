doc:sch-2-sec-2009-2-ss-9 a cof:Section ;
    cof:title "2009(9) No. 99, 2009" ;
    values:kind "subsection" ;
    values:originalText "(9) The Tribunal must allow the Inspector-General a period within which to consider the records mentioned in paragraphs (6)(a) to (d) that is reasonable having regard to:  (a) the nature of the evidence that the Inspector-General has been requested to give; and  (b) the time required by the Inspector-General to perform the Inspector-General’s other functions." ;
    cof:pageNumber "22"^^xsd:integer .

