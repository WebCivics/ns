concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-5 a cml:Concept ;
    skos:prefLabel "50A(5) Inspector-General of Intelligence and Security must be"@en ;
    cml:realizedBy doc:sch-2-sec-50a-ss-5 ;
    values:originalText "(5) The Inspector-General must comply with a request under subsection (2) or (3) unless, in the opinion of the Inspector-General, the Inspector-General is not appropriately qualified to give evidence on the matters in relation to which the Inspector-General has been requested to give evidence." ;
    skos:definition "(5) The Inspector-General must comply with a request under subsection (2) or (3) unless, in the opinion of the Inspector-General, the Inspector-General is not appropriately qualified to give evidence on the matters in relation to which the Inspector-General has been requested to give evidence."@en ;
    cml:integrityHash "7f55350be52b4769164f20b6cd4a0dcfc7b1989a0e34ed2dd3a60f449ab9545e" ;
    values:partOf concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "Inspector-General must comply with a request unless not appropriately qualified." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
