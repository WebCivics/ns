concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-15 a cml:Concept ;
    skos:prefLabel "15 Subsection 58B(1)"@en ;
    cml:realizedBy doc:sch-1-sec-15 ;
    values:originalText "Repeal the subsection, substitute:  (1) If an application is made to the Tribunal for the review of a decision refusing to grant access to a document in accordance with a request, being a document that is claimed to be an exempt document under section 33 or 34, then the Tribunal must be constituted in accordance with subsection (2) for the purposes of any proceeding in relation to the application. Note: The heading to section 58B is replaced by the heading “Constitution of Tribunal for proceedings about certain exempt documents”." ;
    skos:definition "Repeal the subsection, substitute:  (1) If an application is made to the Tribunal for the review of a decision refusing to grant access to a document in accordance with a request, being a document that is claimed to be an exempt document under section 33 or 34, then the Tribunal must be constituted in accordance with subsection (2) for the purposes of any proceeding in relation to the application. Note: The heading to section 58B is replaced by the heading “Constitution of Tribunal for proceedings about certain exempt documents”."@en ;
    cml:integrityHash "ff54cc0ccd1581a587d5f0db9029a3ebd1fb9c559d031836d6921f5cba762186" ;
    cof:pageNumber "8"^^xsd:integer ;
