        }
      ],
      "cml:integrityHash": "2cb8a7e84749577cf211a868a01939356d341693d8b761aa0669ecea497c1679",
      "skos:note": "Rehearsal of proceeding if member ceases to be available"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-3-sec-2009-ss-10",
      "@type": "cof:Section",
      "cof:title": "2009(10) No. 99, 2009",
      "values:kind": "subsection",
      "cof:pageNumber": 28,
      "values:originalText": "(10) If, before the proceeding has been completed, one of the members\nconstituting the Division for the purposes of the proceeding has\nceased to be available for the purposes of the proceeding the\nproceeding is to be reheard by the Division as reconstituted in\naccordance with this section.\nRegard may be had to record of previous proceeding"
    },
