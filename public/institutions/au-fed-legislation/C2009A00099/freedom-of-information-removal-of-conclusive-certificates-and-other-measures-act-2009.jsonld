    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-5-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Believes",
      "cml:logicSummary": "Inspector-General's belief in qualification",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
