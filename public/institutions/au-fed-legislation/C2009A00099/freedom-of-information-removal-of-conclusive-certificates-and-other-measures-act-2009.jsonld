    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-22-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Application provision—item 18",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-2-sec-22-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf"
      },
      "dc:source": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf, p.26",
      "values:originalText": "The amendment made by item 18 of this Schedule does not apply to a\nrecord, or a part of a record, if:\n\n(a) the record is in the open access period; and\n\n(b) one of the following applies:\n\n(i) in relation to the record—a certificate issued under\nsection 34 of the Archives Act 1983 (as in force\nimmediately before the commencement of this\nSchedule) is in force in respect of the record;\n\n(ii) in relation to the part of the record—the part of the\nrecord is identified in accordance with subsection 34(2)\nof that Act (as in force immediately before the\ncommencement of this Schedule) in a certificate issued\nunder section 34 of that Act (as in force immediately\nbefore the commencement of this Schedule).\nNote:\nA certificate ceases to be in force if it is revoked by force of subitem\n20(2).\n\nAdministrative Appeals Tribunal Act 1975  Schedule 3\n\nFreedom of Information (Removal of Conclusive Certificates and Other Measures) Act 2009\nNo. 99, 2009            23",
      "skos:definition": "The amendment made by item 18 of this Schedule does not apply to a\nrecord, or a part of a record, if:\n\n(a) the record is in the open access period; and\n\n(b) one of the following applies:\n\n(i) in relation to the record—a certificate issued under\nsection 34 of the Archives Act 1983 (as in force\nimmediately before the commencement of this\nSchedule) is in force in respect of the record;\n\n(ii) in relation to the part of the record—the part of the\nrecord is identified in accordance with subsection 34(2)\nof that Act (as in force immediately before the\ncommencement of this Schedule) in a certificate issued\nunder section 34 of that Act (as in force immediately\nbefore the commencement of this Schedule).\nNote:\nA certificate ceases to be in force if it is revoked by force of subitem\n20(2).\n\nAdministrative Appeals Tribunal Act 1975  Schedule 3\n\nFreedom of Information (Removal of Conclusive Certificates and Other Measures) Act 2009\nNo. 99, 2009            23",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-22-2-norm"
        },
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-22-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "78298c20f936abe9f1fc7be8912e70bae191a7e1ae0d3fe00276eee84600c54b",
      "skos:note": "Exemption from application of amendment for records in open access period or with certificate issued under Archives Act 1983"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-2-sec-22-2",
      "@type": "cof:Section",
      "cof:title": "22 Application provision—item 18",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "The amendment made by item 18 of this Schedule does not apply to a\nrecord, or a part of a record, if:\n\n(a) the record is in the open access period; and\n\n(b) one of the following applies:\n\n(i) in relation to the record—a certificate issued under\nsection 34 of the Archives Act 1983 (as in force\nimmediately before the commencement of this\nSchedule) is in force in respect of the record;\n\n(ii) in relation to the part of the record—the part of the\nrecord is identified in accordance with subsection 34(2)\nof that Act (as in force immediately before the\ncommencement of this Schedule) in a certificate issued\nunder section 34 of that Act (as in force immediately\nbefore the commencement of this Schedule).\nNote:\nA certificate ceases to be in force if it is revoked by force of subitem\n20(2).\n\nAdministrative Appeals Tribunal Act 1975  Schedule 3\n\nFreedom of Information (Removal of Conclusive Certificates and Other Measures) Act 2009\nNo. 99, 2009            23"
    },
