    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Subsection 64(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-1-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf"
      },
      "dc:source": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf, p.15",
      "values:originalText": "Omit all the words after “return the document to the person by whom it\nwas produced without permitting”, substitute:\n\na person to have access to the document, or disclosing the contents\nof the document to a person, unless the person is:\n\n(a) a member of the Tribunal as constituted for the purposes of\nthe proceeding; or\n\n(b) a member of the staff of the Tribunal in the course of the\nperformance of his or her duties as a member of that staff; or\n\n(c) in the circumstances permitted under paragraph 60A(6)(a)—\nthe Inspector-General of Intelligence and Security.\nNote:\nThe Tribunal is not entitled, under this section, to require production\nof documents that are exempt under section 33 or 34, but is entitled to\ndo so under section 58E if the Tribunal is not satisfied by evidence on\naffidavit or otherwise that the document is an exempt document.",
      "skos:definition": "Omit all the words after “return the document to the person by whom it\nwas produced without permitting”, substitute:\n\na person to have access to the document, or disclosing the contents\nof the document to a person, unless the person is:\n\n(a) a member of the Tribunal as constituted for the purposes of\nthe proceeding; or\n\n(b) a member of the staff of the Tribunal in the course of the\nperformance of his or her duties as a member of that staff; or\n\n(c) in the circumstances permitted under paragraph 60A(6)(a)—\nthe Inspector-General of Intelligence and Security.\nNote:\nThe Tribunal is not entitled, under this section, to require production\nof documents that are exempt under section 33 or 34, but is entitled to\ndo so under section 58E if the Tribunal is not satisfied by evidence on\naffidavit or otherwise that the document is an exempt document.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-29-norm"
        },
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-29-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "24f0d736b16cf4548593156059892af9593f7ddc8163b6688736a7969e634a45",
      "skos:note": "Prohibit disclosure of document contents to unauthorized persons."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-1-sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Subsection 64(2)",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Omit all the words after “return the document to the person by whom it\nwas produced without permitting”, substitute:\n\na person to have access to the document, or disclosing the contents\nof the document to a person, unless the person is:\n\n(a) a member of the Tribunal as constituted for the purposes of\nthe proceeding; or\n\n(b) a member of the staff of the Tribunal in the course of the\nperformance of his or her duties as a member of that staff; or\n\n(c) in the circumstances permitted under paragraph 60A(6)(a)—\nthe Inspector-General of Intelligence and Security.\nNote:\nThe Tribunal is not entitled, under this section, to require production\nof documents that are exempt under section 33 or 34, but is entitled to\ndo so under section 58E if the Tribunal is not satisfied by evidence on\naffidavit or otherwise that the document is an exempt document."
    },
