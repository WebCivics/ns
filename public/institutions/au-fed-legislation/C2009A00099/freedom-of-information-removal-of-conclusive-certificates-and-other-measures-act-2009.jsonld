    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "50A(7) Inspector-General of Intelligence and Security must be",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-2-sec-50a-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf"
      },
      "dc:source": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf, p.20",
      "values:originalText": "(7) The Inspector-General must permit a person who would be entitled\nto inspect a record mentioned in paragraphs (6)(a) to (d) if it were\nnot in the possession of the Inspector-General to inspect the record\nat all reasonable times as the person would be so entitled.",
      "skos:definition": "(7) The Inspector-General must permit a person who would be entitled\nto inspect a record mentioned in paragraphs (6)(a) to (d) if it were\nnot in the possession of the Inspector-General to inspect the record\nat all reasonable times as the person would be so entitled.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-7-norm"
        },
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b5e96ece56114a8397009e0e715b5427fbabe6a5dff2ca52e8ac614552cfbb56",
      "skos:note": "Permit inspection at reasonable times"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-2-sec-50a-ss-7",
      "@type": "cof:Section",
      "cof:title": "50A(7) Inspector-General of Intelligence and Security must be",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(7) The Inspector-General must permit a person who would be entitled\nto inspect a record mentioned in paragraphs (6)(a) to (d) if it were\nnot in the possession of the Inspector-General to inspect the record\nat all reasonable times as the person would be so entitled."
    },
