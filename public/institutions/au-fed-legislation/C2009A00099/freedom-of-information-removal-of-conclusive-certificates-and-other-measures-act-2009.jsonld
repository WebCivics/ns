      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf"
      },
      "dc:source": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf, p.10",
      "values:originalText": "Add “unless the Tribunal orders, on the application of the agency or the\nMinister concerned, that it would not be appropriate to do so in the\ncircumstances”.",
      "skos:definition": "Add “unless the Tribunal orders, on the application of the agency or the\nMinister concerned, that it would not be appropriate to do so in the\ncircumstances”.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-20-norm"
        },
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d26bf1a6a0007f81a89928ee86a6324efa19c2a5036cbb3ca62f97c039aca964",
      "skos:note": "Agency or Minister may request Tribunal to order otherwise."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-1-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 At the end of subsection 59A(3)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Add “unless the Tribunal orders, on the application of the agency or the\nMinister concerned, that it would not be appropriate to do so in the\ncircumstances”."
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-20-norm",
