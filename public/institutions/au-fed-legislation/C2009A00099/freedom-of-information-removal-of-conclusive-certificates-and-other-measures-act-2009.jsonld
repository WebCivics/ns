      "cml:integrityHash": "126886e6a7fe95cf3789e487a71d37c44c4d6166d16881e3b5c7396a5c2fa4da",
      "skos:note": "Tribunal must hear evidence from Archives and Commonwealth institutions."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-2-sec-50a-ss-4",
      "@type": "cof:Section",
      "cof:title": "50A(4) Inspector-General of Intelligence and Security must be",
