    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 After subsection 7(2A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-1-sec-2"
