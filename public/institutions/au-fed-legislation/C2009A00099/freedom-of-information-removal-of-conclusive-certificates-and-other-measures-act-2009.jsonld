    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Tribunal must hear evidence",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Tribunal is required to hear evidence",
      "cml:conclusionText": "Evidence from Archives and Commonwealth institutions must be heard"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Evidence from Archives and Commonwealth institutions must be heard within Tribunal's hearing",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Tribunal's hearing is a temporal interval",
      "cml:conclusionText": "Archives and Commonwealth institutions' evidence must be heard within Tribunal's hearing interval"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-4-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Tribunal's hearing of Archives and Commonwealth institutions implies their relevance to the case",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Tribunal's hearing is relevant to the case",
      "cml:conclusionText": "Archives and Commonwealth institutions' evidence is relevant to the case"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_DIFFUSED_IN",
      "cml:logicSummary": "Tribunal's obligation to hear Archives and Commonwealth institutions is diffused to its agents",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Tribunal has an obligation to hear evidence",
      "cml:conclusionText": "Agents of Tribunal must also hear evidence from Archives and Commonwealth institutions"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-2-sec-50a-ss-4-logic-cogai-5",
