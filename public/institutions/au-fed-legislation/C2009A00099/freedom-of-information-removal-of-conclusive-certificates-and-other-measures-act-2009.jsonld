    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-1-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Section 58A",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the section."
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-14-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
