      }
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Subsection 58B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-1-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf"
      },
      "dc:source": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf, p.8",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) If an application is made to the Tribunal for the review of a\ndecision refusing to grant access to a document in accordance with\na request, being a document that is claimed to be an exempt\ndocument under section 33 or 34, then the Tribunal must be\nconstituted in accordance with subsection (2) for the purposes of\nany proceeding in relation to the application.\nNote:\nThe heading to section 58B is replaced by the heading “Constitution of Tribunal for\nproceedings about certain exempt documents”.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) If an application is made to the Tribunal for the review of a\ndecision refusing to grant access to a document in accordance with\na request, being a document that is claimed to be an exempt\ndocument under section 33 or 34, then the Tribunal must be\nconstituted in accordance with subsection (2) for the purposes of\nany proceeding in relation to the application.\nNote:\nThe heading to section 58B is replaced by the heading “Constitution of Tribunal for\nproceedings about certain exempt documents”.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-15-norm"
