    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-53",
      "@type": "cml:Concept",
      "skos:prefLabel": "53 Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-1-sec-53"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf"
      },
      "dc:source": "freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009.pdf, p.8",
      "values:originalText": "For the purposes of this Part, unless the contrary intention appears,\na claim that a document would, if it exists, be an exempt document\nunder section 33, 33A, 34 or 35 is to be deemed to be a claim that\nthe document is an exempt document under that section despite the\nfact that the existence or non-existence of the document is not\nacknowledged.",
      "skos:definition": "For the purposes of this Part, unless the contrary intention appears,\na claim that a document would, if it exists, be an exempt document\nunder section 33, 33A, 34 or 35 is to be deemed to be a claim that\nthe document is an exempt document under that section despite the\nfact that the existence or non-existence of the document is not\nacknowledged.",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-53-norm"
        },
        {
          "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-53-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aef46ce875c8269add4bb8bc1c970b5d14051f79e22b8a6735ca66bf9e621493",
      "skos:note": "Deems a claim that a document is exempt under certain sections as an obligation to acknowledge the existence or non-existence of the document."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009#sch-1-sec-53",
      "@type": "cof:Section",
      "cof:title": "53 Interpretation",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "For the purposes of this Part, unless the contrary intention appears,\na claim that a document would, if it exists, be an exempt document\nunder section 33, 33A, 34 or 35 is to be deemed to be a claim that\nthe document is an exempt document under that section despite the\nfact that the existence or non-existence of the document is not\nacknowledged."
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-53-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-53"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-removal-of-conclusive-certificates-and-other-measures-act-2009-sch-1-sec-53-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes an obligation on the state to acknowledge the existence or non-existence of a document.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
