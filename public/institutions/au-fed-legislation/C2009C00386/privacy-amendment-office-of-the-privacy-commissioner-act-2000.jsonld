        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 96 of the Privacy Act 1988 was amended by item 7 of this Schedule",
      "cml:conclusionText": "Section 96 still applies"
    },
    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
