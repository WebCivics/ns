          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-14-norm"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "09b0b0a394d0d3ac8ffc287f16df9ff6d70a3f73083a432284239ab265ab22fd",
      "skos:note": "Omit “staff and” from section heading."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sch-1-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Section 43A",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Omit “staff and”.\nNote:\nThe heading to section 43A is altered by omitting “staff and”.\n\nOffice of the Privacy Commissioner  Schedule 1\nTransitional  Part 3\n\nPrivacy Amendment (Office of the Privacy Commissioner) Act 2000                   5"
    },
    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-14-norm",
      "@type": "values:Prohibition",
