      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The amendment does not affect persons who were staff before the item commenced",
      "cml:conclusionText": "Section 96 still applies to those persons"
    },
    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-logic-argumentation-3",
