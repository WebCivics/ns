    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf, p.5",
      "values:originalText": "(1) Subject to subsection (2), this Act commences on a day to be fixed\nby Proclamation.\n\n(2) If this Act does not commence under subsection (1) within the\nperiod of 6 months beginning on the day on which this Act\nreceives the Royal Assent, it commences on the first day after the\nend of that period.",
      "skos:definition": "(1) Subject to subsection (2), this Act commences on a day to be fixed\nby Proclamation.\n\n(2) If this Act does not commence under subsection (1) within the\nperiod of 6 months beginning on the day on which this Act\nreceives the Royal Assent, it commences on the first day after the\nend of that period.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sec-2-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sec-2-ss-2"
        }
      ],
      "cml:integrityHash": "04c96794f4f001b79dc8665a387243424a79bbb9ec5bf840d725f2212e52fa36"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Commencement",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "(1) Subject to subsection (2), this Act commences on a day to be fixed\nby Proclamation.\n\n(2) If this Act does not commence under subsection (1) within the\nperiod of 6 months beginning on the day on which this Act\nreceives the Royal Assent, it commences on the first day after the\nend of that period."
    },
