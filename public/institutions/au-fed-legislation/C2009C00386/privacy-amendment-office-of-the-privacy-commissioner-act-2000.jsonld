    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Section 43A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sch-1-sec-14"
      },
      "cml:curationStatus": {
