    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sec-3"
