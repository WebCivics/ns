      "dc:source": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf, p.5",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Office of the Privacy Commissioner",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Office of the Privacy Commissioner",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sec-3-norm"
        }
      ],
      "cml:integrityHash": "22379eec1bfb6952390eb04b378161c8645926d7d6584849c42ff0782f708762",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
