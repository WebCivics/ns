    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-26a",
      "@type": "cml:Concept",
      "skos:prefLabel": "26A Staff and consultants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sch-1-sec-26a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf, p.6",
      "values:originalText": "(1) The staff necessary to assist the Commissioner must be persons\nappointed or employed under the Public Service Act 1922.\n\n(2) The Commissioner has all the powers of, or exercisable by, a\nSecretary under that Act, so far as those powers relate to the branch\nof the Australian Public Service comprising the staff mentioned in\nsubsection (1), as if that branch were a separate Department of the\nAustralian Public Service.\n\nOffice of the Privacy Commissioner  Schedule 1\nPrivacy Act 1988  Part 1\n\nPrivacy Amendment (Office of the Privacy Commissioner) Act 2000                   3\n\n(3) The Commissioner may engage as consultants persons with\nsuitable qualifications and experience. The terms and conditions on\nwhich a consultant is engaged are as determined by the\nCommissioner.",
      "skos:definition": "(1) The staff necessary to assist the Commissioner must be persons\nappointed or employed under the Public Service Act 1922.\n\n(2) The Commissioner has all the powers of, or exercisable by, a\nSecretary under that Act, so far as those powers relate to the branch\nof the Australian Public Service comprising the staff mentioned in\nsubsection (1), as if that branch were a separate Department of the\nAustralian Public Service.\n\nOffice of the Privacy Commissioner  Schedule 1\nPrivacy Act 1988  Part 1\n\nPrivacy Amendment (Office of the Privacy Commissioner) Act 2000                   3\n\n(3) The Commissioner may engage as consultants persons with\nsuitable qualifications and experience. The terms and conditions on\nwhich a consultant is engaged are as determined by the\nCommissioner.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-26a-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-26a-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-26a-ss-3"
        }
      ],
      "cml:integrityHash": "347d135b6521dcd27b991f7e0eb0e817cb5f5b580793467e1252561976851657"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sch-1-sec-26a",
      "@type": "cof:Section",
      "cof:title": "26A Staff and consultants",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "(1) The staff necessary to assist the Commissioner must be persons\nappointed or employed under the Public Service Act 1922.\n\n(2) The Commissioner has all the powers of, or exercisable by, a\nSecretary under that Act, so far as those powers relate to the branch\nof the Australian Public Service comprising the staff mentioned in\nsubsection (1), as if that branch were a separate Department of the\nAustralian Public Service.\n\nOffice of the Privacy Commissioner  Schedule 1\nPrivacy Act 1988  Part 1\n\nPrivacy Amendment (Office of the Privacy Commissioner) Act 2000                   3\n\n(3) The Commissioner may engage as consultants persons with\nsuitable qualifications and experience. The terms and conditions on\nwhich a consultant is engaged are as determined by the\nCommissioner."
    },
