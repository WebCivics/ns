    },
    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Section 96 still applies to pre-commencement staff",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sch-1-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf, p.9",
      "values:originalText": "Despite the amendment of section 96 of the Privacy Act 1988 by item 7\nof this Schedule, that section continues to apply, in relation to persons\nwho, at any time before this item commenced, were staff referred to in\nsection 43 of the Human Rights and Equal Opportunity Commission Act\n1986, as if the amendment had not been made.\nNote 1: Section 96 of the Privacy Act 1988 is about non-disclosure of private information.\nNote 2: The Human Rights and Equal Opportunity Act 1986 has been renamed the Australian\nHuman Rights Commission Act 1986. See Part 1 of Schedule 3 to the Disability\nDiscrimination and Other Human Rights Legislation Amendment Act 2009.\n\nSchedule 2  Consequential amendment",
      "skos:definition": "Despite the amendment of section 96 of the Privacy Act 1988 by item 7\nof this Schedule, that section continues to apply, in relation to persons\nwho, at any time before this item commenced, were staff referred to in\nsection 43 of the Human Rights and Equal Opportunity Commission Act\n1986, as if the amendment had not been made.\nNote 1: Section 96 of the Privacy Act 1988 is about non-disclosure of private information.\nNote 2: The Human Rights and Equal Opportunity Act 1986 has been renamed the Australian\nHuman Rights Commission Act 1986. See Part 1 of Schedule 3 to the Disability\nDiscrimination and Other Human Rights Legislation Amendment Act 2009.\n\nSchedule 2  Consequential amendment",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-norm"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-logic-argumentation-3"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "c80e045bdfe8577fa951a5327c25b54d3b5d3e7f7434b8e62117d10f716c53d3",
      "skos:note": "Section 96 still applies to pre-commencement staff"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-office-of-the-privacy-commissioner-act-2000#sch-1-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Section 96 still applies to pre-commencement staff",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Despite the amendment of section 96 of the Privacy Act 1988 by item 7\nof this Schedule, that section continues to apply, in relation to persons\nwho, at any time before this item commenced, were staff referred to in\nsection 43 of the Human Rights and Equal Opportunity Commission Act\n1986, as if the amendment had not been made.\nNote 1: Section 96 of the Privacy Act 1988 is about non-disclosure of private information.\nNote 2: The Human Rights and Equal Opportunity Act 1986 has been renamed the Australian\nHuman Rights Commission Act 1986. See Part 1 of Schedule 3 to the Disability\nDiscrimination and Other Human Rights Legislation Amendment Act 2009.\n\nSchedule 2  Consequential amendment"
    },
    {
      "@id": "concept:privacy-amendment-office-of-the-privacy-commissioner-act-2000-sch-1-sec-15-norm",
