      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf"
      },
      "dc:source": "privacy-amendment-office-of-the-privacy-commissioner-act-2000.pdf, p.8",
      "values:originalText": "Omit “staff and”.\nNote:\nThe heading to section 43A is altered by omitting “staff and”.\n\nOffice of the Privacy Commissioner  Schedule 1\nTransitional  Part 3\n\nPrivacy Amendment (Office of the Privacy Commissioner) Act 2000                   5",
      "skos:definition": "Omit “staff and”.\nNote:\nThe heading to section 43A is altered by omitting “staff and”.\n\nOffice of the Privacy Commissioner  Schedule 1\nTransitional  Part 3\n\nPrivacy Amendment (Office of the Privacy Commissioner) Act 2000                   5",
      "cml:asserts": [
