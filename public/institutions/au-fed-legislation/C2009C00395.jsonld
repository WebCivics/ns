      "cml:logicSummary": "Respects temporal overlap between Article 17 and Australian Human Rights Commission Act 1986",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1) Sexual conduct involving only consenting adults acting in private"
    },
