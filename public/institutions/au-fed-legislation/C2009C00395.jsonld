      "@id": "concept:human-rights-sexual-conduct-act-1994-sec-4-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "is not to be subject, by or under any law of the Commonwealth, a State or a Territory, to any arbitrary interference with privacy within the meaning of Article 17 of the International Covenant on Civil and Political Rights.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
