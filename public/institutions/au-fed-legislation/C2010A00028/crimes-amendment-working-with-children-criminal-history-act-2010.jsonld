      "dc:source": "crimes-amendment-working-with-children-criminal-history-act-2010.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2010A00028\n\nAmendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2010A00028\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-working-with-children-criminal-history-act-2010-sec-3-norm"
        }
      ],
      "cml:integrityHash": "4283cbcc78489f2614c0b3b1e00e7d18491abc29480cd60c06c1c438ab83c997",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
