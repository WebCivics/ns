      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.45",
      "skos:note": "Sending explicit sexual content to minors is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "471(1) Section 471"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
