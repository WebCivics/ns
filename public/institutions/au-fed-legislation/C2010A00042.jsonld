        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-37-ss-2-logic-diffusion-4",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-37-ss-2-logic-cogai-5"
      ],
      "cml:curationStatus": {
