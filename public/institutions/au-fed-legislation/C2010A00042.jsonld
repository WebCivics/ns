      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between Australia and the offence location",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The person must have been in Australia at the time of the offence."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Prosecution is only allowed within these boundaries.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Recognition of jurisdictional boundaries",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "The law recognizes jurisdictional boundaries between Australia and other jurisdictions."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If not, prosecution is not allowed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to prosecute within Australia",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The person must be an Australian citizen, resident, or incorporated body corporate."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "However, prosecution within Australia is still required.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion of prosecution to other jurisdictions",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "Prosecution may be allowed in other jurisdictions if the offence was committed outside Australia."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If not, prosecution is not allowed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring trace of prosecution within Australia",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "The person must be prosecuted within a reasonable time after the offence."
