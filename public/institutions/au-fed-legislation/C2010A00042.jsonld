    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.19",
      "skos:note": "Engaging in conduct to procure a child to engage in sexual activity outside Australia is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "272(1) Section 272"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-norm",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-deontic-1",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-alleninterval-2",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-ltl-3",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "6ca4060d160c51328052dce52e4938bf20420a2044f9a33028587307cfd22441",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-legislation-amendment-sexual-offences-against-children-act-2010#sch-1-sec-272-15-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15"
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct and sexual activity must occur within the same temporal interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Requires temporal overlap between conduct and sexual activity",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal overlap",
      "cml:premiseText": "(i) the conduct referred to in paragraph (a) occurs wholly or partly outside Australia;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits conduct",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the person engages in conduct in relation to another person (the child); and (b) the person does so with the intention of procuring the child to engage in sexual activity..."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is obligated to prevent the conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes an obligation to prevent conduct",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Penalty: Imprisonment for 15 years."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct and sexual activity must occur within the same temporal interval, with the child outside Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Requires a recurring trace of conduct and sexual activity",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:premiseText": "(ii) the child is outside Australia when the conduct referred to in paragraph (a) occurs;"
    },
