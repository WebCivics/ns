    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-10-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.33",
      "skos:note": "Conduct is of public benefit if necessary for or of assistance in enforcing a law.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "273(2) Section 273"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
