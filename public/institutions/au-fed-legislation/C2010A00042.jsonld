    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-13-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.16",
      "skos:note": "Engaging in sexual intercourse with a young person under 18 and in a position of trust or authority is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "272(1) Section 272"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-13-ss-1-norm",
