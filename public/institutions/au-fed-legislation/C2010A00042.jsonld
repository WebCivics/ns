    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.42",
      "skos:note": "A person is not criminally responsible for an offence against section 471.19 or 471.20 if the conduct is of public benefit and does not extend beyond what is of public benefit.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "471(1) Section 471"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-norm",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-1",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-alleninterval-2",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-ltl-3",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-4",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "1835333bc91f510b1a447a10a6c31a7c91ca99cd1c94afb170ebd0549f0664d4",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-legislation-amendment-sexual-offences-against-children-act-2010#sch-1-sec-471-6-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6"
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct overlaps with the public benefit.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Conduct overlaps with public benefit",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(a) is of public benefit; and (b) does not extend beyond what is of public benefit."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is not criminally responsible for the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to not be criminally responsible for an offence against section 471.19 or 471.20 if the conduct is of public benefit and does not extend beyond what is of public benefit.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) A person is not criminally responsible for an offence against section 471.19 (using a postal or similar service for child abuse material) or 471.20 (possessing etc. child abuse material for use through a postal or similar service) because of engaging in particular conduct if the conduct:  (a) is of public benefit; and  (b) does not extend beyond what is of public benefit."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must determine whether the conduct is of public benefit.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to determine whether conduct is of public benefit",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "In determining whether the person is, under this subsection, not criminally responsible for the offence, the question whether the conduct is of public benefit is a question of fact and the person’s motives in engaging in the conduct are irrelevant."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The defendant must bear the evidential burden.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to bear evidential burden",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "A defendant bears an evidential burden in relation to the matter in this subsection, see subsection 13.3(3)."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct is recurring if it extends beyond the public benefit.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Conduct is recurring if it extends beyond public benefit",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(b) does not extend beyond what is of public benefit."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-6-ss-1-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
