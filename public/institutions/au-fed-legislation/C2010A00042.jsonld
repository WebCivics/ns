    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.11",
      "skos:note": "Engaging in sexual intercourse with a child under 16 outside Australia is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "272(1) Section 272"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1-norm",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1-logic-deontic-1",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1-logic-alleninterval-2",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1-logic-ltl-3",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "af486877fea55a9ca5b5c531a6d9fa2010bff6d3bc1ae2b2fefbcac020c54cfa",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-legislation-amendment-sexual-offences-against-children-act-2010#sch-1-sec-272-9-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9"
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition applies to acts performed outside Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal interval for the prohibition.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(c) the sexual intercourse is engaged in outside Australia."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The act is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits the act.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the person engages in sexual intercourse with another person (the child); and (b) the child is under 16; and (c) the sexual intercourse is engaged in outside Australia."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The act is prohibited and punishable by imprisonment for 20 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Reiterates the prohibition.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(Penalty: Imprisonment for 20 years.)"
    },
    {
