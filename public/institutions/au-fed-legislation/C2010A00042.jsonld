      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...is an offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Making it easier to procure a child to engage in sexual activity outside Australia is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the person engages in conduct in relation to another person (the child); and (b) the person does so with the intention of making it easier to procure the child to engage in sexual activity..."
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-16-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...one or more of the following apply:",
      "cml:confidence": {
