    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.40",
      "skos:note": "A person is not criminally responsible for an offence against section 471.16 or 471.17 if the conduct is of public benefit and does not extend beyond what is of public benefit.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "471(1) Section 471"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3-ss-1-norm",
        "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3-ss-1-logic-deontic-1"
      ],
      "cml:curationStatus": {
