    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-10-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.33",
      "skos:note": "A person is not criminally responsible for an offence against section 273.5 or 273.6 if the conduct is of public benefit.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "273(1) Section 273"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
