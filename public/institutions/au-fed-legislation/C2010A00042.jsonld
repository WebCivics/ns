      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Conduct is not of public benefit"
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-10-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
