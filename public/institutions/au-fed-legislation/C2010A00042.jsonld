    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-3-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.40",
      "skos:note": "Conduct is of public benefit if necessary for or of assistance in enforcing a law, monitoring compliance, administering justice, or approved research.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "471(2) Section 471"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
