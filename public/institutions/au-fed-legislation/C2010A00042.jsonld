    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-10-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Not criminally responsible",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If a person's conduct is of public benefit, they are not criminally responsible.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Conduct is of public benefit"
    },
    {
      "@id": "concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-10-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Not criminally responsible",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "A person's conduct is of public benefit if and only if they are not criminally responsible.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Iff",
      "cml:premiseText": "Conduct is of public benefit"
