      "skos:note": "Arrest before consent is given for certain offenses.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "272(2) Section 272"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf",
      "asserts": [
