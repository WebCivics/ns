<https://ns.webcivics.net/concept/crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-474-7-ss-2-logic-deontic-1> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits conduct with a child using a carriage service.";
    <https://ns.webcivics.net/cml/premiseText> "(2) A person (the defendant) commits an offence if:  (a) the defendant engages in conduct in relation to another person (the child); and  (b) that conduct causes the child to engage in sexual activity with another person (the participant) using a carriage service; and  (c) the child is under 16 years of age when the sexual activity is engaged in; and  (d) the participant is at least 18 years of age when the sexual activity is engaged in.";
    <https://ns.webcivics.net/cml/conclusionText> "Penalty: Imprisonment for 15 years.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
