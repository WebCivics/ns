    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits conduct";
    <https://ns.webcivics.net/cml/premiseText> "(a) the person engages in conduct in relation to another person (the child); and (b) the person does so with the intention of procuring the child to engage in sexual activity...";
    <https://ns.webcivics.net/cml/conclusionText> "The conduct is prohibited.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-alleninterval-2>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-15-ss-1-logic-alleninterval-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/AllenInterval>;
    <https://ns.webcivics.net/cml/operator> "Temporal overlap";
    <https://ns.webcivics.net/cml/logicSummary> "Requires temporal overlap between conduct and sexual activity";
    <https://ns.webcivics.net/cml/premiseText> "(i) the conduct referred to in paragraph (a) occurs wholly or partly outside Australia;";
    <https://ns.webcivics.net/cml/conclusionText> "The conduct and sexual activity must occur within the same temporal interval.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
