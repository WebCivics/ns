    <https://ns.webcivics.net/cml/operator> "Prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits sending explicit sexual content to minors.";
    <https://ns.webcivics.net/cml/premiseText> "(a) the sender causes an article to be carried by a postal or similar service to another person (the recipient); and (b) the sender does this with the intention of procuring the recipient to engage in sexual activity with the sender; and (c) the recipient is someone who is, or who the sender believes to be, under 16; and (d) the sender is at least 18.";
    <https://ns.webcivics.net/cml/conclusionText> "Imprisonment for 15 years.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
