    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/LTL>;
    <https://ns.webcivics.net/cml/operator> "Recurring trace";
    <https://ns.webcivics.net/cml/logicSummary> "Requires a recurring trace of conduct and sexual activity";
    <https://ns.webcivics.net/cml/premiseText> "(ii) the child is outside Australia when the conduct referred to in paragraph (a) occurs;";
    <https://ns.webcivics.net/cml/conclusionText> "The conduct and sexual activity must occur within the same temporal interval, with the child outside Australia.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::temporal_ltl";
