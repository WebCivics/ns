concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-45 a cml:Concept ;
    skos:prefLabel "45 Subsection 474.28(1) of the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-45 ;
    values:originalText "Repeal the subsection (not including the notes), substitute: Age-related issues—application of absolute liability  (1) For the purposes of an offence against this Subdivision, absolute liability applies to the physical element of circumstance of the offence that:  (a) in the case of an offence against section 474.25A—the child is under 16 years of age; and  (b) in the case of an offence against section 474.26, 474.27 or" ;
    skos:definition "Repeal the subsection (not including the notes), substitute: Age-related issues—application of absolute liability  (1) For the purposes of an offence against this Subdivision, absolute liability applies to the physical element of circumstance of the offence that:  (a) in the case of an offence against section 474.25A—the child is under 16 years of age; and  (b) in the case of an offence against section 474.26, 474.27 or"@en ;
    cml:integrityHash "51f97b85edc04b4b087829460431ef88e48c1bd5be9390a9e3b5c6f0416cb41c" ;
    cof:pageNumber "58"^^xsd:integer ;
