concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-2-sec-23za a cml:Concept ;
    skos:prefLabel "23ZA Application"@en ;
    cml:realizedBy doc:sch-2-sec-23za ;
    values:originalText "This Part applies to a thing (the forfeitable thing) that is:  (a) child abuse material; or  (b) child pornography material; or ComLaw Authoritative Act C2010A00042  Schedule 2  Forfeiture of child sex material  66            Crimes Legislation Amendment (Sexual Offences Against Children) Act 2010       No. 42, 2010  (c) any of the following that contains child abuse material or child pornography material:  (i) a computer;  (ii) a data storage device;  (iii) another piece of electronic equipment." ;
    skos:definition "This Part applies to a thing (the forfeitable thing) that is:  (a) child abuse material; or  (b) child pornography material; or ComLaw Authoritative Act C2010A00042  Schedule 2  Forfeiture of child sex material  66            Crimes Legislation Amendment (Sexual Offences Against Children) Act 2010       No. 42, 2010  (c) any of the following that contains child abuse material or child pornography material:  (i) a computer;  (ii) a data storage device;  (iii) another piece of electronic equipment."@en ;
    cml:integrityHash "ea5b1931b89a534a199b8acd642fca11313395c2261bc23083b49c6397a6780f" ;
    cof:pageNumber "69"^^xsd:integer ;
    skos:note "Forfeiture of child sex material applies to specified things" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
