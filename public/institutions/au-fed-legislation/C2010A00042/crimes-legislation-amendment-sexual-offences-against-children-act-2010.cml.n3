    cof:pageNumber "26"^^xsd:integer ;
    skos:note "A person must give evidence at the courtroom or other place in Australia where the court is sitting." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
