doc:sch-1-sec-474-17-ss-5 a cof:Section ;
    cof:title "474(5) Section 474" ;
    values:kind "subsection" ;
    values:originalText "(5) It is a defence to a prosecution for an offence against section 474.26, 474.27 or 474.27A if the defendant proves that, at the time the communication was transmitted, he or she believed that the recipient was at least 16 years of age. Note: A defendant bears a legal burden in relation to the matter in this subsection, see section 13.4. Trier of fact may take into account whether belief reasonable" ;
    cof:pageNumber "61"^^xsd:integer .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-474-17-ss-6 a cml:Concept ;
    skos:prefLabel "474(6) Section 474"@en ;
    cml:realizedBy doc:sch-1-sec-474-17-ss-6 ;
    values:originalText "(6) In determining whether the defendant had the belief mentioned in one of the preceding subsections of this section, the trier of fact may take into account whether the alleged belief was reasonable in the circumstances." ;
    skos:definition "(6) In determining whether the defendant had the belief mentioned in one of the preceding subsections of this section, the trier of fact may take into account whether the alleged belief was reasonable in the circumstances."@en ;
    cml:integrityHash "060729e013c4b73e54a4a66cca8f3a3045423f532aefd67c1c3e42c36ae6c10a" ;
    values:partOf concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-474-17 ;
    cof:pageNumber "61"^^xsd:integer ;
    skos:note "Triers of fact may consider the reasonableness of an alleged belief in determining whether a defendant had such a belief." ;
    cml:curationStatus cml:Proposed ;
