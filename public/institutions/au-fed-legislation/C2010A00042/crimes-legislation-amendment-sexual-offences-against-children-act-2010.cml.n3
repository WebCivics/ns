concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471 a cml:Concept ;
    skos:prefLabel "471 16  Using a postal or similar service for child pornography"@en ;
    cml:realizedBy doc:sch-1-sec-471 ;
    values:originalText "material  (1) A person commits an offence if:  (a) the person causes an article to be carried by a postal or similar service; and  (b) the article is, or contains, child pornography material. Penalty: Imprisonment for 15 years.  (2) A person commits an offence if:  (a) the person requests another person to cause an article to be carried by a postal or similar service; and  (b) the article is, or contains, child pornography material. Penalty: Imprisonment for 15 years." ;
    skos:definition "material  (1) A person commits an offence if:  (a) the person causes an article to be carried by a postal or similar service; and  (b) the article is, or contains, child pornography material. Penalty: Imprisonment for 15 years.  (2) A person commits an offence if:  (a) the person requests another person to cause an article to be carried by a postal or similar service; and  (b) the article is, or contains, child pornography material. Penalty: Imprisonment for 15 years."@en ;
    cml:integrityHash "40b30b4e8f0d137056ac497e859ea198c1a00db4267d1ade9c458d04024e2981" ;
    cof:pageNumber "39"^^xsd:integer ;
