concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-71 a cml:Concept ;
    skos:prefLabel "71 Application"@en ;
    cml:realizedBy doc:sch-1-sec-71 ;
    values:originalText "Despite the amendments made by items 65, 68, 69 and 70, sections 15Y and 15YT of the Crimes Act 1914, as in force immediately before the commencement of this item, continue to apply in relation to an offence against Part IIIA of that Act, as in force before that commencement. Surveillance Devices Act 2004" ;
    skos:definition "Despite the amendments made by items 65, 68, 69 and 70, sections 15Y and 15YT of the Crimes Act 1914, as in force immediately before the commencement of this item, continue to apply in relation to an offence against Part IIIA of that Act, as in force before that commencement. Surveillance Devices Act 2004"@en ;
    cml:integrityHash "2fee46b5c1c0b294c164c84170d92058c75eed6402f4ec6d5b6050f1d8326134" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Sections 15Y and 15YT of the Crimes Act 1914 continue to apply in relation to an offence against Part IIIA." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
