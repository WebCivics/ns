doc:sch-1-sec-10 a cof:Section ;
    cof:title "10 Dictionary in the Criminal Code" ;
    values:kind "section" ;
    values:originalText "Insert: sexual activity means:  (a) sexual intercourse; or  (b) any other activity of a sexual or indecent nature (including an indecent assault) that involves the human body, or bodily actions or functions (whether or not that activity involves physical contact between people). Note: See also the definition of engage in sexual activity." ;
    cof:pageNumber "37"^^xsd:integer .

