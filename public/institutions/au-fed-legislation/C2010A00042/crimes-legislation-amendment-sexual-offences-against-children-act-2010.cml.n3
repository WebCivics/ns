concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-10 a cml:Concept ;
    skos:prefLabel "10 Dictionary in the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-10 ;
    values:originalText "Insert: sexual activity means:  (a) sexual intercourse; or  (b) any other activity of a sexual or indecent nature (including an indecent assault) that involves the human body, or bodily actions or functions (whether or not that activity involves physical contact between people). Note: See also the definition of engage in sexual activity." ;
    skos:definition "Insert: sexual activity means:  (a) sexual intercourse; or  (b) any other activity of a sexual or indecent nature (including an indecent assault) that involves the human body, or bodily actions or functions (whether or not that activity involves physical contact between people). Note: See also the definition of engage in sexual activity."@en ;
    cml:integrityHash "5e9cdeddbd4775cc11adb4de755f8884d4bf58cc82c43267dafc7f244e667f9a" ;
    cof:pageNumber "37"^^xsd:integer ;
    skos:note "Defines sexual activity for the Criminal Code" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
