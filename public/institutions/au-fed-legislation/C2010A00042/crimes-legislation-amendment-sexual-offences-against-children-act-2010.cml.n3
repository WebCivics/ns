doc:sch-2-sec-23ze-ss-2 a cof:Section ;
    cof:title "23ZE(2) Effect of forfeiture under this Part" ;
    values:kind "subsection" ;
    values:originalText "(2) The Commonwealth is liable to pay the person a reasonable amount of compensation for the forfeiture." ;
    cof:pageNumber "75"^^xsd:integer .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-2-sec-23ze-ss-3 a cml:Concept ;
    skos:prefLabel "23ZE(3) Effect of forfeiture under this Part"@en ;
    cml:realizedBy doc:sch-2-sec-23ze-ss-3 ;
    values:originalText "(3) If the Commonwealth and the person do not agree on the amount of the compensation, the person may institute proceedings in a court of competent jurisdiction of a State or Territory for the recovery from the Commonwealth of such reasonable amount of compensation as the court determines." ;
