concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-9 a cml:Concept ;
    skos:prefLabel "273 8  Alternative verdict if aggravated offence not proven"@en ;
    cml:realizedBy doc:sch-1-sec-273-9 ;
    values:originalText "If, on a trial for an offence (the aggravated offence) against subsection 273.7(1), the trier of fact:  (a) is not satisfied that the defendant is guilty of the aggravated offence; but  (b) is satisfied beyond reasonable doubt that he or she is guilty of an offence against section 273.5 or 273.6; it may find the defendant not guilty of the aggravated offence but guilty of the offence against section 273.5 or 273.6, so long as the defendant has been accorded procedural fairness in relation to that finding of guilt. Subdivision C—Defences" ;
    skos:definition "If, on a trial for an offence (the aggravated offence) against subsection 273.7(1), the trier of fact:  (a) is not satisfied that the defendant is guilty of the aggravated offence; but  (b) is satisfied beyond reasonable doubt that he or she is guilty of an offence against section 273.5 or 273.6; it may find the defendant not guilty of the aggravated offence but guilty of the offence against section 273.5 or 273.6, so long as the defendant has been accorded procedural fairness in relation to that finding of guilt. Subdivision C—Defences"@en ;
    cml:integrityHash "91735de8d68dea4e038a077892a6dd45980d7a493e0d878f41a414a8054c2778" ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "If defendant is not guilty of aggravated offence, but guilty of other offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
    dc:source "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.33" ;
    cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-9-norm .
