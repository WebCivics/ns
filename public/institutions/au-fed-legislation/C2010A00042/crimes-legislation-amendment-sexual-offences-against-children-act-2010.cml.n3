concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-4 a cml:Concept ;
    skos:prefLabel "471 19  Using a postal or similar service for child abuse material"@en ;
    cml:realizedBy doc:sch-1-sec-471-4 ;
    values:originalText "(1) A person commits an offence if:  (a) the person causes an article to be carried by a postal or similar service; and  (b) the article is, or contains, child abuse material. Penalty: Imprisonment for 15 years.  (2) A person commits an offence if:  (a) the person requests another person to cause an article to be carried by a postal or similar service; and  (b) the article is, or contains, child abuse material. Penalty: Imprisonment for 15 years." ;
    skos:definition "(1) A person commits an offence if:  (a) the person causes an article to be carried by a postal or similar service; and  (b) the article is, or contains, child abuse material. Penalty: Imprisonment for 15 years.  (2) A person commits an offence if:  (a) the person requests another person to cause an article to be carried by a postal or similar service; and  (b) the article is, or contains, child abuse material. Penalty: Imprisonment for 15 years."@en ;
    cml:integrityHash "ef03d9ecf65ab6aecb7901c183cc5984c1503d595cfcbf89cf99f6f547b3afb3" ;
    cof:pageNumber "41"^^xsd:integer ;
