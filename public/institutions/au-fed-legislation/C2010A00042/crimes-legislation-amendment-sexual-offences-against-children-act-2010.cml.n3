concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-5 a cml:Concept ;
    skos:prefLabel "273 4  Saving of other laws"@en ;
    cml:realizedBy doc:sch-1-sec-273-5 ;
    values:originalText "This Division is not intended to exclude or limit the operation of any other law of the Commonwealth or any law of a State or Territory. ComLaw Authoritative Act C2010A00042  Amendments relating to sexual offences against children  Schedule 1 Amendments relating to child sex offences outside Australia  Part 1  Subdivision B—Offences committed overseas involving child pornography material or child abuse material" ;
    skos:definition "This Division is not intended to exclude or limit the operation of any other law of the Commonwealth or any law of a State or Territory. ComLaw Authoritative Act C2010A00042  Amendments relating to sexual offences against children  Schedule 1 Amendments relating to child sex offences outside Australia  Part 1  Subdivision B—Offences committed overseas involving child pornography material or child abuse material"@en ;
    cml:integrityHash "140921dc3554170e13ece09b1e7d130fd4d27a2d6a356bf52fd00ecbf39c1635" ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Saving of other laws" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
