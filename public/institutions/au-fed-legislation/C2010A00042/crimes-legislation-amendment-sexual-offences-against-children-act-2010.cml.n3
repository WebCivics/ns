doc:sch-1-sec-272-12-ss-3 a cof:Section ;
    cof:title "272(3) 11  Persistent sexual abuse of child outside Australia" ;
    values:kind "subsection" ;
    values:originalText "(3) To avoid doubt, a person does not commit the underlying offence for the purposes of subsection (1) if the person has a defence to the underlying offence. Offence or conduct need not be the same" ;
