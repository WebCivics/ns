concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-10 a cml:Concept ;
    skos:prefLabel "471 23  Alternative verdict if aggravated offence not proven"@en ;
    cml:realizedBy doc:sch-1-sec-471-10 ;
    values:originalText "If, on a trial for an offence (the aggravated offence) against subsection 471.22(1), the trier of fact:  (a) is not satisfied that the defendant is guilty of the aggravated offence; but  (b) is satisfied beyond reasonable doubt that he or she is guilty of an offence (the underlying offence) against section 471.16," ;
    skos:definition "If, on a trial for an offence (the aggravated offence) against subsection 471.22(1), the trier of fact:  (a) is not satisfied that the defendant is guilty of the aggravated offence; but  (b) is satisfied beyond reasonable doubt that he or she is guilty of an offence (the underlying offence) against section 471.16,"@en ;
    cml:integrityHash "9c19b514db06aaea0e1bab1b0aa4815c4152de38df8f62d9adfcbaede0290e36" ;
    cof:pageNumber "44"^^xsd:integer ;
    skos:note "If not satisfied that defendant is guilty of aggravated offence, but satisfied beyond reasonable doubt of underlying offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
