doc:sch-1-sec-273-3-ss-1 a cof:Section ;
    cof:title "273(1) 2A  Consent to commencement of proceedings where defendant" ;
    values:kind "subsection" ;
    values:originalText "(1) Proceedings for an offence against this Division must not be commenced without the consent of the Attorney-General if the defendant was under 18 at the time he or she allegedly engaged in the conduct constituting the offence." ;
    cof:pageNumber "30"^^xsd:integer .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-3-ss-2 a cml:Concept ;
    skos:prefLabel "273(2) 2A  Consent to commencement of proceedings where defendant"@en ;
    cml:realizedBy doc:sch-1-sec-273-3-ss-2 ;
    values:originalText "(2) However, a person may be arrested for, charged with, or remanded in custody or on bail in connection with, such an offence before the necessary consent has been given." ;
