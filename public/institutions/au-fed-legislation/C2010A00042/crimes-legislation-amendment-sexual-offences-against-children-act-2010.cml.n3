    cml:hasPart concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-12-ss-6 ;
    cml:hasPart concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-12-ss-7 ;
    cml:curationStatus cml:Proposed ;
