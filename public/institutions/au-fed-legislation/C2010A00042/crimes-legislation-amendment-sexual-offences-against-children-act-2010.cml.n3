concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-2-sec-23zg a cml:Concept ;
    skos:prefLabel "23ZG Delegation by head of police force"@en ;
    cml:realizedBy doc:sch-2-sec-23zg ;
    values:originalText "The head of a police force (including the Commissioner) may, by writing, delegate to a constable who is a member of the force all or any of the head’s powers, functions and duties under this Part." ;
    skos:definition "The head of a police force (including the Commissioner) may, by writing, delegate to a constable who is a member of the force all or any of the head’s powers, functions and duties under this Part."@en ;
