concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-35 a cml:Concept ;
    skos:prefLabel "272 29  Double jeopardy"@en ;
    cml:realizedBy doc:sch-1-sec-272-35 ;
    values:originalText "If a person has been convicted or acquitted in a country outside Australia of an offence against the law of that country in respect of any conduct, the person cannot be convicted of an offence against this Division in respect of that conduct." ;
    skos:definition "If a person has been convicted or acquitted in a country outside Australia of an offence against the law of that country in respect of any conduct, the person cannot be convicted of an offence against this Division in respect of that conduct."@en ;
    cml:integrityHash "076e6e67fe11b1fb2179eb0b6fd5f3097f1be28091e226bb7708cf7b1bbefca1" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Double jeopardy protection for convictions outside Australia" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
