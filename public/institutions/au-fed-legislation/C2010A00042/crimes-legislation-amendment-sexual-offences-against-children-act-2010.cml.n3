concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-7 a cml:Concept ;
    skos:prefLabel "272 6  Who can be prosecuted for an offence committed outside"@en ;
    cml:realizedBy doc:sch-1-sec-272-7 ;
    values:originalText "Australia  A person must not be charged with an offence against this Division that the person allegedly committed wholly outside Australia unless, at the time of the offence, the person was:  (a) an Australian citizen; or  (b) a resident of Australia; or  (c) a body corporate incorporated by or under a law of the Commonwealth or of a State or Territory; or  (d) any other body corporate that carries on its activities principally in Australia." ;
    skos:definition "Australia  A person must not be charged with an offence against this Division that the person allegedly committed wholly outside Australia unless, at the time of the offence, the person was:  (a) an Australian citizen; or  (b) a resident of Australia; or  (c) a body corporate incorporated by or under a law of the Commonwealth or of a State or Territory; or  (d) any other body corporate that carries on its activities principally in Australia."@en ;
    cml:integrityHash "85b69c7e85258ad30d5d2660fb836d31f34fece7f86a63c24355e60bb41d2152" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Only certain individuals can be prosecuted for an offence committed outside Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
