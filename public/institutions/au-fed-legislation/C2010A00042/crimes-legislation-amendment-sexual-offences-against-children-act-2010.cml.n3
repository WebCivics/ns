concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-30 a cml:Concept ;
    skos:prefLabel "272 26  Other laws about foreign evidence not affected"@en ;
    cml:realizedBy doc:sch-1-sec-272-30 ;
    values:originalText "This Subdivision does not prevent any other law about taking evidence of a witness outside Australia from applying for the purposes of a proceeding for an offence against this Division. ComLaw Authoritative Act C2010A00042  Amendments relating to sexual offences against children  Schedule 1 Amendments relating to child sex offences outside Australia  Part 1  Subdivision E—Other rules about conduct of trials" ;
    skos:definition "This Subdivision does not prevent any other law about taking evidence of a witness outside Australia from applying for the purposes of a proceeding for an offence against this Division. ComLaw Authoritative Act C2010A00042  Amendments relating to sexual offences against children  Schedule 1 Amendments relating to child sex offences outside Australia  Part 1  Subdivision E—Other rules about conduct of trials"@en ;
    cml:integrityHash "f1b5db12194d5b2b60708c9468b92e168ce94879785e722dc88d7c2ddccd4311" ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "No effect on other laws about foreign evidence" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
