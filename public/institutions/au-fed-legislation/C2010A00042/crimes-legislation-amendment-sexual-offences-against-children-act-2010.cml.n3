concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-8-ss-4 a cml:Concept ;
    skos:prefLabel "273(4) 7  Aggravated offence—offence involving conduct on 3 or more"@en ;
    cml:realizedBy doc:sch-1-sec-273-8-ss-4 ;
    values:originalText "(4) For the purposes of subsection (1), it is immaterial whether the offence, or the conduct constituting the offence, is the same on each occasion. Double jeopardy etc." ;
    skos:definition "(4) For the purposes of subsection (1), it is immaterial whether the offence, or the conduct constituting the offence, is the same on each occasion. Double jeopardy etc."@en ;
