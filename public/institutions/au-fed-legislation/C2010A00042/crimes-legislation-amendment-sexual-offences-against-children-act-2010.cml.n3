doc:sch-1-sec-272-18 a cof:Section ;
    cof:title "272 17  Defence based on valid and genuine marriage" ;
    values:kind "section" ;
    values:originalText "Offences involving engaging in sexual intercourse or other sexual activity with child or young person  (1) It is a defence to a prosecution for an offence against subsection" ;
    cof:pageNumber "22"^^xsd:integer .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-19 a cml:Concept ;
    skos:prefLabel "272 8(1), 272.9(1), 272.12(1) or 272.13(1) if the defendant proves"@en ;
    cml:realizedBy doc:sch-1-sec-272-19 ;
    values:originalText "that:  (a) at the time of the sexual intercourse or sexual activity, there existed between the defendant and the child or the young person a marriage that was valid, or recognised as valid, under the law of:  (i) the place where the marriage was solemnised; or  (ii) the place where the offence was committed; or  (iii) the place of the defendant’s residence or domicile; and  (b) when it was solemnised, the marriage was genuine. Note: A defendant bears a legal burden in relation to the matter in this subsection, see section 13.4. Offences involving procuring or “grooming” child for sexual activity  (2) It is a defence to a prosecution for an offence against subsection" ;
    skos:definition "that:  (a) at the time of the sexual intercourse or sexual activity, there existed between the defendant and the child or the young person a marriage that was valid, or recognised as valid, under the law of:  (i) the place where the marriage was solemnised; or  (ii) the place where the offence was committed; or  (iii) the place of the defendant’s residence or domicile; and  (b) when it was solemnised, the marriage was genuine. Note: A defendant bears a legal burden in relation to the matter in this subsection, see section 13.4. Offences involving procuring or “grooming” child for sexual activity  (2) It is a defence to a prosecution for an offence against subsection"@en ;
    cml:integrityHash "5f023d955131bee60a07ff1bfd828a4f4dcb014f5b3dbe7e4d552fb323794fd8" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Defendant must prove marriage was valid at time of sexual intercourse." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
    dc:source "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.22" ;
