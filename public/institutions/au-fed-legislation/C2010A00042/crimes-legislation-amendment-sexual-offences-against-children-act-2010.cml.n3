concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-32 a cml:Concept ;
    skos:prefLabel "272 28  Alternative verdicts"@en ;
    cml:realizedBy doc:sch-1-sec-272-32 ;
    values:originalText "If, on a trial for an offence (the column 1 offence) against a provision referred to in column 1 of an item in the following table, the trier of fact:  (a) is not satisfied that the defendant is guilty of the column 1 offence; but  (b) is satisfied beyond reasonable doubt that he or she is guilty of an offence (the column 2 offence) against a provision referred to in column 2 of that item; it may find the defendant not guilty of the column 1 offence but guilty of the column 2 offence, so long as the defendant has been accorded procedural fairness in relation to that finding of guilt. ComLaw Authoritative Act C2010A00042  Schedule 1  Amendments relating to sexual offences against children" ;
    skos:definition "If, on a trial for an offence (the column 1 offence) against a provision referred to in column 1 of an item in the following table, the trier of fact:  (a) is not satisfied that the defendant is guilty of the column 1 offence; but  (b) is satisfied beyond reasonable doubt that he or she is guilty of an offence (the column 2 offence) against a provision referred to in column 2 of that item; it may find the defendant not guilty of the column 1 offence but guilty of the column 2 offence, so long as the defendant has been accorded procedural fairness in relation to that finding of guilt. ComLaw Authoritative Act C2010A00042  Schedule 1  Amendments relating to sexual offences against children"@en ;
    cml:integrityHash "b85354b75155c5acb51822d07b7a9d803a40274cf7b3246d15aafa95051b87b2" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Trier of fact must find defendant guilty of column 2 offence if satisfied beyond reasonable doubt." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
    dc:source "crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf, p.27" ;
    cml:asserts concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-32-norm .
