doc:sch-1-sec-273-8-ss-1 a cof:Section ;
    cof:title "273(1) 7  Aggravated offence—offence involving conduct on 3 or more" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence against this section if:  (a) the person commits an offence against either of the following provisions on 3 or more separate occasions:  (i) section 273.5 (possessing etc. child pornography material outside Australia);  (ii) section 273.6 (possessing etc. child abuse material outside Australia); and  (b) the commission of each such offence involves 2 or more people. Penalty: Imprisonment for 25 years." ;
    cof:pageNumber "32"^^xsd:integer .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-8-ss-2 a cml:Concept ;
    skos:prefLabel "273(2) 7  Aggravated offence—offence involving conduct on 3 or more"@en ;
    cml:realizedBy doc:sch-1-sec-273-8-ss-2 ;
    values:originalText "(2) There is no fault element for any of the physical elements described in paragraph (1)(a) other than the fault elements (however described), if any, for the offence against section 273.5 or 273.6." ;
    skos:definition "(2) There is no fault element for any of the physical elements described in paragraph (1)(a) other than the fault elements (however described), if any, for the offence against section 273.5 or 273.6."@en ;
    cml:integrityHash "60ea7bab4392af033736cb22404481010eb90bb3f1a921aa9b07fc949748695b" ;
    values:partOf concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-8 ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "No fault element for physical elements other than those for specific related offences." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
