concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-29 a cml:Concept ;
    skos:prefLabel "272 25  Expenses"@en ;
    cml:realizedBy doc:sch-1-sec-272-29 ;
    values:originalText "A court may make such orders as are just for payment of expenses incurred in connection with giving evidence under a direction by the court under this Subdivision." ;
    skos:definition "A court may make such orders as are just for payment of expenses incurred in connection with giving evidence under a direction by the court under this Subdivision."@en ;
