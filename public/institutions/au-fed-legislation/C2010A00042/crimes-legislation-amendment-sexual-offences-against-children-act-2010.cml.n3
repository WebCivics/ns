concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-471-18 a cml:Concept ;
    skos:prefLabel "471 Section 471"@en ;
    cml:realizedBy doc:sch-1-sec-471-18 ;
    values:originalText "24(2) or (3) or 471.25(2) or (3) if the defendant proves that, at the time he or she caused the article to be carried, the defendant believed that the participant was under 18. Note: A defendant bears a legal burden in relation to the matter in this subsection, see section 13.4. ComLaw Authoritative Act C2010A00042  Schedule 1  Amendments relating to sexual offences against children" ;
    skos:definition "24(2) or (3) or 471.25(2) or (3) if the defendant proves that, at the time he or she caused the article to be carried, the defendant believed that the participant was under 18. Note: A defendant bears a legal burden in relation to the matter in this subsection, see section 13.4. ComLaw Authoritative Act C2010A00042  Schedule 1  Amendments relating to sexual offences against children"@en ;
    cml:integrityHash "19461f10c115bb5226aac35355fe282eb7b8f1421e17f49ccfc919f20c849d03" ;
    cof:pageNumber "49"^^xsd:integer ;
    skos:note "Defendant bears legal burden if participant is under 18." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
