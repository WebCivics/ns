concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-11 a cml:Concept ;
    skos:prefLabel "11 2A (joint commission)."@en ;
    cml:realizedBy doc:sch-1-sec-11 ;
    values:originalText "(3) Section 11.1 (attempt) does not apply to an offence against:  (a) section 272.14 (procuring child to engage in sexual activity outside Australia); or  (b) section 272.15 (“grooming” child to engage in sexual activity outside Australia); or  (c) section 272.20 (preparing for or planning offence against this Division).  (4) Section 11.4 (incitement) does not apply to an offence against this Division.  (5) Section 11.5 (conspiracy) does not apply to an offence against section 272.19 (encouraging offence against this Division). ComLaw Authoritative Act C2010A00042  Amendments relating to sexual offences against children  Schedule 1 Amendments relating to child sex offences outside Australia  Part 1" ;
    skos:definition "(3) Section 11.1 (attempt) does not apply to an offence against:  (a) section 272.14 (procuring child to engage in sexual activity outside Australia); or  (b) section 272.15 (“grooming” child to engage in sexual activity outside Australia); or  (c) section 272.20 (preparing for or planning offence against this Division).  (4) Section 11.4 (incitement) does not apply to an offence against this Division.  (5) Section 11.5 (conspiracy) does not apply to an offence against section 272.19 (encouraging offence against this Division). ComLaw Authoritative Act C2010A00042  Amendments relating to sexual offences against children  Schedule 1 Amendments relating to child sex offences outside Australia  Part 1"@en ;
    cml:integrityHash "30a156ed09e41eb6415d4a7a6b4dfc823a6e3dd3a9756d2a92fd92bd9f007c8c" ;
    cof:pageNumber "10"^^xsd:integer ;
    cml:hasPart concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-11-ss-3 ;
    cml:hasPart concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-11-ss-4 ;
    cml:hasPart concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-11-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
