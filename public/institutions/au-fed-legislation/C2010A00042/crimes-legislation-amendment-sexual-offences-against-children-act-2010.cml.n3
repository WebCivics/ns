concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-16 a cml:Concept ;
    skos:prefLabel "273 15  Other laws about foreign evidence not affected"@en ;
    cml:realizedBy doc:sch-1-sec-273-16 ;
    values:originalText "This Subdivision does not prevent any other law about taking evidence of a witness outside Australia from applying for the purposes of a proceeding for an offence against this Division." ;
    skos:definition "This Subdivision does not prevent any other law about taking evidence of a witness outside Australia from applying for the purposes of a proceeding for an offence against this Division."@en ;
