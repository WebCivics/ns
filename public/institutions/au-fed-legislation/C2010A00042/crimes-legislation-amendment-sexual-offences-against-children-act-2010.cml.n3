concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-8-ss-5 a cml:Concept ;
    skos:prefLabel "273(5) 7  Aggravated offence—offence involving conduct on 3 or more"@en ;
    cml:realizedBy doc:sch-1-sec-273-8-ss-5 ;
    values:originalText "(5) A person who has been convicted or acquitted of an offence (the aggravated offence) against this section may not be convicted of an offence against section 273.5 or 273.6 in relation to the conduct that constituted the aggravated offence." ;
    skos:definition "(5) A person who has been convicted or acquitted of an offence (the aggravated offence) against this section may not be convicted of an offence against section 273.5 or 273.6 in relation to the conduct that constituted the aggravated offence."@en ;
