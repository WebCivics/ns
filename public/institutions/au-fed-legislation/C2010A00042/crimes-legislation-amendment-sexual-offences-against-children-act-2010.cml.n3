concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-474-4 a cml:Concept ;
    skos:prefLabel "474 24B  Alternative verdict if aggravated offence not proven"@en ;
    cml:realizedBy doc:sch-1-sec-474-4 ;
    values:originalText "If, on a trial for an offence (the aggravated offence) against subsection 474.24A(1), the trier of fact:  (a) is not satisfied that the defendant is guilty of the aggravated offence; but ComLaw Authoritative Act C2010A00042  Schedule 1  Amendments relating to sexual offences against children" ;
    skos:definition "If, on a trial for an offence (the aggravated offence) against subsection 474.24A(1), the trier of fact:  (a) is not satisfied that the defendant is guilty of the aggravated offence; but ComLaw Authoritative Act C2010A00042  Schedule 1  Amendments relating to sexual offences against children"@en ;
    cml:integrityHash "5e7216e002dd812ac56df6c05a09545c31e0083f9b691bcf3cee9ca96a49eb16" ;
    cof:pageNumber "53"^^xsd:integer ;
    skos:note "If not satisfied that defendant is guilty of aggravated offence, verdict must be not proven." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
