concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-273-2 a cml:Concept ;
    skos:prefLabel "273 2  Who can be prosecuted for an offence committed outside"@en ;
    cml:realizedBy doc:sch-1-sec-273-2 ;
    values:originalText "Australia  A person must not be charged with an offence against this Division that the person allegedly committed outside Australia unless, at the time of the offence, the person was:  (a) an Australian citizen; or  (b) a resident of Australia; or  (c) a body corporate incorporated by or under a law of the Commonwealth or of a State or Territory; or  (d) any other body corporate that carries on its activities principally in Australia." ;
    skos:definition "Australia  A person must not be charged with an offence against this Division that the person allegedly committed outside Australia unless, at the time of the offence, the person was:  (a) an Australian citizen; or  (b) a resident of Australia; or  (c) a body corporate incorporated by or under a law of the Commonwealth or of a State or Territory; or  (d) any other body corporate that carries on its activities principally in Australia."@en ;
    cml:integrityHash "c5e186fe70c9c2c3c0a366d8389ec28f99c1cfb313edea25fbe5b7b30282eba3" ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Only Australian citizens, residents, or corporations with primary activities in Australia can be prosecuted for an offence committed outside Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
