concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-6 a cml:Concept ;
    skos:prefLabel "6 Dictionary in the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-6 ;
    values:originalText "Insert: ComLaw Authoritative Act C2010A00042  Amendments relating to sexual offences against children  Schedule 1 Amendments relating to child sex offences outside Australia  Part 1  engage in sexual activity: without limiting when a person engages in sexual activity, a person is taken to engage in sexual activity if the person is in the presence of another person (including by a means of communication that allows the person to see or hear the other person) while the other person engages in sexual activity." ;
    skos:definition "Insert: ComLaw Authoritative Act C2010A00042  Amendments relating to sexual offences against children  Schedule 1 Amendments relating to child sex offences outside Australia  Part 1  engage in sexual activity: without limiting when a person engages in sexual activity, a person is taken to engage in sexual activity if the person is in the presence of another person (including by a means of communication that allows the person to see or hear the other person) while the other person engages in sexual activity."@en ;
    cml:integrityHash "0db048ba31a86f59a9fe9cfea38e58f9d7255f147a8b39c820d8c75b18e5cc28" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "A person is taken to engage in sexual activity if they are present with another person engaging in sexual activity." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
