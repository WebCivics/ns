concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-9 a cml:Concept ;
    skos:prefLabel "272 8  Sexual intercourse with child outside Australia"@en ;
    cml:realizedBy doc:sch-1-sec-272-9 ;
    values:originalText "Engaging in sexual intercourse with child  (1) A person commits an offence if:  (a) the person engages in sexual intercourse with another person (the child); and  (b) the child is under 16; and  (c) the sexual intercourse is engaged in outside Australia. Penalty: Imprisonment for 20 years. Causing child to engage in sexual intercourse in presence of defendant  (2) A person commits an offence if:  (a) the person engages in conduct in relation to another person (the child); and ComLaw Authoritative Act C2010A00042  Schedule 1  Amendments relating to sexual offences against children" ;
    skos:definition "Engaging in sexual intercourse with child  (1) A person commits an offence if:  (a) the person engages in sexual intercourse with another person (the child); and  (b) the child is under 16; and  (c) the sexual intercourse is engaged in outside Australia. Penalty: Imprisonment for 20 years. Causing child to engage in sexual intercourse in presence of defendant  (2) A person commits an offence if:  (a) the person engages in conduct in relation to another person (the child); and ComLaw Authoritative Act C2010A00042  Schedule 1  Amendments relating to sexual offences against children"@en ;
    cml:integrityHash "8c250a92669990c2edc251ff1a591ab13d6a46d576a8a7a3571bbaf4aadac276" ;
    cof:pageNumber "11"^^xsd:integer ;
