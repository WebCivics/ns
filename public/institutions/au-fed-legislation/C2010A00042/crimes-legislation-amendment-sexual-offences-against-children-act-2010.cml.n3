doc:sch-1-sec-272-31-ss-3 a cof:Section ;
    cof:title "272(3) 27  Evidence relating to a person’s age" ;
    values:kind "subsection" ;
    values:originalText "(3) Subsection (2) does not make any other kind of evidence inadmissible, and does not affect a prosecutor’s duty to do all he or she can to adduce the best possible evidence for determining the question." ;
    cof:pageNumber "27"^^xsd:integer .

concept:crimes-legislation-amendment-sexual-offences-against-children-act-2010-sch-1-sec-272-31-ss-4 a cml:Concept ;
    skos:prefLabel "272(4) 27  Evidence relating to a person’s age"@en ;
    cml:realizedBy doc:sch-1-sec-272-31-ss-4 ;
    values:originalText "(4) If, on a trial for an offence against this Division, evidence may be treated as admissible because of subsection (2), the court must warn the jury that it must be satisfied beyond reasonable doubt in determining the question." ;
    skos:definition "(4) If, on a trial for an offence against this Division, evidence may be treated as admissible because of subsection (2), the court must warn the jury that it must be satisfied beyond reasonable doubt in determining the question."@en ;
    cml:integrityHash "ca0dd4108b85c41e4619d3f444f66e429c3075c5c402189ef24242352dfebf1b" ;
