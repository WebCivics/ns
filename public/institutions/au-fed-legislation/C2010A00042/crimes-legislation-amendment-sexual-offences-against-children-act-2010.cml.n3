    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Double jeopardy protection for convictions outside Australia" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-sexual-offences-against-children-act-2010.pdf> ;
