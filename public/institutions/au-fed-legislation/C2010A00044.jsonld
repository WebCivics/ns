      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits terms that permit unilateral determination of contract breach or interpretation, limit vicarious liability, assign contracts without consent, limit right to sue, limit evidence, or impose evidential burden.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(h) a term that permits, or has the effect of permitting, one party unilaterally to determine whether the contract has been breached or to interpret its meaning;"
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-8-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits terms that limit vicarious liability for agents.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(i) a term that limits, or has the effect of limiting, one party’s vicarious liability for its agents;"
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-8-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits terms that permit assignment of contracts without consent.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(j) a term that permits, or has the effect of permitting, one party to assign the contract to the detriment of another party without that other party’s consent;"
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-8-logic-deontic-4",
      "@type": "cml:LogicApplication",
