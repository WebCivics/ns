      "cml:logicSummary": "Prohibits terms that limit right to sue.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(k) a term that limits, or has the effect of limiting, one party’s right to sue another party;"
    },
