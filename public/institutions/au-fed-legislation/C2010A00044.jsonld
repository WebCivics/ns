    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-12bk-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The factors are BETWEEN the party's bargaining power and the transaction.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Factors relate to specific characteristics of parties or transactions.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "(a) whether one of the parties has all or most of the bargaining power relating to the transaction;"
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-12bk-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Court MUST consider the specified factors.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must consider specific factors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Court may take into account such matters as it thinks relevant."
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-12bk-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court MUST consider the specified terms.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must consider specified terms in contracts.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(b) whether the contract was prepared by one party before any discussion relating to the transaction occurred between the parties;"
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-12bk-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court MUST provide the specified opportunities.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must consider specified opportunities for negotiation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(d) whether another party was given an effective opportunity to negotiate the terms of the contract that were not the terms referred to in subsection 12BI(1);"
    },
