    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-3-ss-1",
      "@type": "cml:Concept",
      "dc:source": "trade-practices-amendment-australian-consumer-law-act.pdf, p.10",
      "skos:note": "A term of a consumer contract is unfair if it would cause a significant imbalance in the parties' rights and obligations arising under the contract.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "3(1) Meaning of unfair"
      },
      "wasDerivedFrom": "trade-practices-amendment-australian-consumer-law-act.pdf",
      "asserts": [
        "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-3-ss-1-norm",
        "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-3-ss-1-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "26a9692268abb2f68c8a31365ba0523e0c01215217db715f749d1696cbb2cdd8",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:trade-practices-amendment-australian-consumer-law-act#sch-2-sec-3-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-3"
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-3-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the State to ensure fairness in consumer contracts.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) A term of a consumer contract is unfair if:  (a) it would cause a significant imbalance in the parties' rights and obligations arising under the contract; and  (b) it is not reasonably necessary in order to protect the legitimate interests of the party who would be advantaged by the term; and  (c) it would cause detriment (whether financial or otherwise) to a party if it were to be applied or relied on."
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-3-ss-1-norm",
      "@type": "doc:Obligation",
