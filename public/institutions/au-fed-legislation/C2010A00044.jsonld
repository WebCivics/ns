      "cml:conclusionText": "...the Australian Capital Territory or the Northern Territory;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies territories into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "participating Territory means a Territory that is a party to the Intergovernmental Agreement for the Australian Consumer Law."
    },
