    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-7-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The factors contain information about the specific characteristics of a party or transaction.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Factors relate to specific characteristics of a party or transaction.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:premiseText": "(e) whether the terms of the contract (other than the terms referred to in section 5(1)) take into account the specific characteristics of another party or the particular transaction;"
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-7-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Court MUST consider the specified factors.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must consider specific factors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Court may take into account such matters as it thinks relevant."
    },
    {
      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-7-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A court MUST consider all relevant matters when determining if a contract is standard form.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court must consider all relevant matters.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "A court may take into account such matters as it thinks relevant, but MUST take into account the following:"
    },
