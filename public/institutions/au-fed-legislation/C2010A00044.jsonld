      "@id": "concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-7-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A court MUST consider all additional matters when determining if a contract is standard form.",
