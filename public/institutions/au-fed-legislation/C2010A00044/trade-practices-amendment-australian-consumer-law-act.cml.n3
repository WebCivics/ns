    cml:hasPart concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-20-ss-1 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
