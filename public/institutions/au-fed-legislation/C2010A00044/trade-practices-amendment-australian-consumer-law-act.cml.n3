doc:sch-3-sec-64-ss-1 a cof:Section ;
    cof:title "64(1) Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010       No. 44," ;
    values:kind "subsection" ;
    values:originalText "(1) A person who is given a substantiation notice must comply with it within the substantiation notice compliance period for the notice." ;
    cof:pageNumber "68"^^xsd:integer .

concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-64-ss-2 a cml:Concept ;
