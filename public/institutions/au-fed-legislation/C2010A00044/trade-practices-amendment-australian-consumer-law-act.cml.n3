concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-37 a cml:Concept ;
    skos:prefLabel "37 At the end of section 12GD"@en ;
    cml:realizedBy doc:sch-3-sec-37 ;
    values:originalText "Add:  (9) A reference in this section to a contravention of a provision of this Division includes a reference to applying or relying on, or purporting to apply or rely on, a term of a consumer contract that the Court has declared under section 12GND to be an unfair term." ;
    skos:definition "Add:  (9) A reference in this section to a contravention of a provision of this Division includes a reference to applying or relying on, or purporting to apply or rely on, a term of a consumer contract that the Court has declared under section 12GND to be an unfair term."@en ;
    cml:integrityHash "ca962ed45dd7a4fba94eb159c70c7cfaf22795914fcc76db08b2de029c61de48" ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Reference to unfair term in consumer contract is a contravention of this Division." ;
    cml:curationStatus cml:Proposed ;
