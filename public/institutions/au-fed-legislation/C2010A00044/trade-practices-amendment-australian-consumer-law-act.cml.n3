doc:sch-3-sec-12bg-ss-2 a cof:Section ;
    cof:title "12BG(2) Meaning of unfair" ;
    values:kind "subsection" ;
    values:originalText "(2) In determining whether a term of a consumer contract is unfair under subsection (1), a court may take into account such matters as it thinks relevant, but must take into account the following:  (b) the extent to which the term is transparent;  (c) the contract as a whole." ;
    cof:pageNumber "54"^^xsd:integer .

concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-12bg-ss-3 a cml:Concept ;
    skos:prefLabel "12BG(3) Meaning of unfair"@en ;
    cml:realizedBy doc:sch-3-sec-12bg-ss-3 ;
    values:originalText "(3) A term is transparent if the term is:  (a) expressed in reasonably plain language; and  (b) legible; and  (c) presented clearly; and  (d) readily available to any party affected by the term." ;
    skos:definition "(3) A term is transparent if the term is:  (a) expressed in reasonably plain language; and  (b) legible; and  (c) presented clearly; and  (d) readily available to any party affected by the term."@en ;
