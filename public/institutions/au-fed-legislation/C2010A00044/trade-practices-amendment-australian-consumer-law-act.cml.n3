concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-9 a cml:Concept ;
    skos:prefLabel "9 After paragraph 6(2)(c)"@en ;
    cml:realizedBy doc:sch-2-sec-9 ;
    values:originalText "Insert:  (ca) any reference in Part 2 of the Australian Consumer Law to a contract were, by express provision, confined to a contract made:  (i) in the course of, or in relation to, trade or commerce between Australia and places outside Australia; or  (ii) in the course of, or in relation to, trade or commerce among the States; or  (iii) in the course of, or in relation to, trade or commerce within a Territory, between a State and a Territory or between two Territories; and" ;
    skos:definition "Insert:  (ca) any reference in Part 2 of the Australian Consumer Law to a contract were, by express provision, confined to a contract made:  (i) in the course of, or in relation to, trade or commerce between Australia and places outside Australia; or  (ii) in the course of, or in relation to, trade or commerce among the States; or  (iii) in the course of, or in relation to, trade or commerce within a Territory, between a State and a Territory or between two Territories; and"@en ;
    cml:integrityHash "71388e5dfcb11521802450308f2964941a6c30da64b27e6a7ee5c65fb4bc46eb" ;
    cof:pageNumber "16"^^xsd:integer ;
