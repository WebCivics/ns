doc:sch-3-sec-58-ss-1 a cof:Section ;
    cof:title "58(1) Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010       No. 44," ;
    values:kind "subsection" ;
    values:originalText "(1) A body corporate (the first body), or a body corporate related to the first body, must not indemnify a person (whether by agreement or by making a payment and whether directly or through an interposed entity) against any of the following liabilities incurred as an officer of the first body:  (a) a liability to pay a pecuniary penalty under section 12GBA;  (b) legal costs incurred in defending or resisting proceedings in which the person is found to have such a liability. Penalty: 25 penalty units." ;
    cof:pageNumber "62"^^xsd:integer .

concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-58-ss-2 a cml:Concept ;
    skos:prefLabel "58(2) Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010       No. 44,"@en ;
    cml:realizedBy doc:sch-3-sec-58-ss-2 ;
    values:originalText "(2) For the purposes of subsection (1), the outcome of proceedings is the outcome of the proceedings and any appeal in relation to the proceedings." ;
    skos:definition "(2) For the purposes of subsection (1), the outcome of proceedings is the outcome of the proceedings and any appeal in relation to the proceedings."@en ;
    cml:integrityHash "89c247d250913569a3fcc2293a498f9fba5da31fc37582299fe7126ae5f45522" ;
    values:partOf concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-58 ;
