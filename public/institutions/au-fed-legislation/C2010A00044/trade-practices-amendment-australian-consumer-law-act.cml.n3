concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-28 a cml:Concept ;
    skos:prefLabel "28 Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010       No. 44,"@en ;
    cml:realizedBy doc:sch-2-sec-28 ;
    values:originalText "(c) does not have a commercial relationship with the other person other than for the purpose of:  (i) publishing claims or representations promoting, or apparently intended to promote, the other person’s business or other activities; or  (ii) the other person supplying goods or services, or selling or granting interests in land (within the meaning of section 53A), to the person." ;
    skos:definition "(c) does not have a commercial relationship with the other person other than for the purpose of:  (i) publishing claims or representations promoting, or apparently intended to promote, the other person’s business or other activities; or  (ii) the other person supplying goods or services, or selling or granting interests in land (within the meaning of section 53A), to the person."@en ;
    cml:integrityHash "649da2d5e734a5c385312e72d0aeabe7578c1fe9c0597501121a98a2f3cde2a1" ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "Does not have a commercial relationship with another person for purposes other than publishing or supplying goods/services." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <trade-practices-amendment-australian-consumer-law-act.pdf> ;
