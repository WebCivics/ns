    cml:premiseText "ASIC must refund" ;
    cml:conclusionText "to the person an amount equal to the amount paid" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-3-sec-74-ss-7 a cof:Section ;
    cof:title "74(7) Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010       No. 44," ;
    values:kind "subsection" ;
    values:originalText "(7) If the infringement notice is withdrawn after the person has paid the penalty specified in the infringement notice, ASIC must refund to the person an amount equal to the amount paid. ComLaw Authoritative Act C2010A00044  Schedule 3  Amendment of corporations legislation" ;
    cof:pageNumber "78"^^xsd:integer .

