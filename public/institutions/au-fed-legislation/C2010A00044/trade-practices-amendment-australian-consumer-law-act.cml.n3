concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-47 a cml:Concept ;
    skos:prefLabel "47 Subsection 12GNB(2)"@en ;
    cml:realizedBy doc:sch-3-sec-47 ;
    values:originalText "Repeal the subsection, substitute:  (2) An order under subsection (1) may be made against:  (a) if subparagraph (1)(a)(i) applies—the person who engaged in the contravening conduct, or a person involved in that conduct; or  (b) if subparagraph (1)(a)(ii) applies—a party to the contract who is advantaged by the declared term." ;
    skos:definition "Repeal the subsection, substitute:  (2) An order under subsection (1) may be made against:  (a) if subparagraph (1)(a)(i) applies—the person who engaged in the contravening conduct, or a person involved in that conduct; or  (b) if subparagraph (1)(a)(ii) applies—a party to the contract who is advantaged by the declared term."@en ;
    cml:integrityHash "677fc5346d5113ec3ad2321dad2906c3d3fc15b7e732257454634f6dcd76d51f" ;
    cof:pageNumber "82"^^xsd:integer ;
