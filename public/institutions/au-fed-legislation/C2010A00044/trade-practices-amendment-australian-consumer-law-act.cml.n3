concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-18 a cml:Concept ;
    skos:prefLabel "18 Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010       No. 44,"@en ;
    cml:realizedBy doc:sch-2-sec-18 ;
    values:originalText "140  When an application law imposes a duty  For the purposes of this Division, an application law imposes a duty on a Commonwealth entity if:  (a) the law confers a function or power on the entity; and  (b) the circumstances in which the function or power is conferred give rise to an obligation on the entity to perform the function or to exercise the power." ;
    skos:definition "140  When an application law imposes a duty  For the purposes of this Division, an application law imposes a duty on a Commonwealth entity if:  (a) the law confers a function or power on the entity; and  (b) the circumstances in which the function or power is conferred give rise to an obligation on the entity to perform the function or to exercise the power."@en ;
    cml:integrityHash "db397ae7079a3e961f2142b8ec8707f5b8a831e225cd5327ca8ff16738276217" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Duty imposed on Commonwealth entities under certain conditions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <trade-practices-amendment-australian-consumer-law-act.pdf> ;
