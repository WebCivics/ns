concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-12bl a cml:Concept ;
    skos:prefLabel "12BL Contracts to which this Part does not apply"@en ;
    cml:realizedBy doc:sch-3-sec-12bl ;
    values:originalText "This Part does not apply to a consumer contract that is the constitution of a company, managed investment scheme or other kind of body. 12BM  Contraventions of this Subdivision etc.  Conduct is not taken, for the purposes of this Act, to contravene this Subdivision (or this Division) merely because of subsection 12BF(1)." ;
    skos:definition "This Part does not apply to a consumer contract that is the constitution of a company, managed investment scheme or other kind of body. 12BM  Contraventions of this Subdivision etc.  Conduct is not taken, for the purposes of this Act, to contravene this Subdivision (or this Division) merely because of subsection 12BF(1)."@en ;
    cml:integrityHash "9f1a82046d7fe48d206633cf2964b13c5c2bf49a148c36d52a41d67efd0609c2" ;
