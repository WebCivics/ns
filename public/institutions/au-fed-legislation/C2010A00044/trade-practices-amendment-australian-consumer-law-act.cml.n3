concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-65 a cml:Concept ;
    skos:prefLabel "65 Subsection 87AAA(5)"@en ;
    cml:realizedBy doc:sch-2-sec-65 ;
    values:originalText "Repeal the subsection, substitute:  (5) An application under subsection (1) may be made at any time within 6 years after the day on which:  (a) if subparagraph (1)(a)(i) applies—the cause of action that relates to the contravening conduct accrues; or  (b) if subparagraph (1)(a)(ii) applies—the declaration is made." ;
    skos:definition "Repeal the subsection, substitute:  (5) An application under subsection (1) may be made at any time within 6 years after the day on which:  (a) if subparagraph (1)(a)(i) applies—the cause of action that relates to the contravening conduct accrues; or  (b) if subparagraph (1)(a)(ii) applies—the declaration is made."@en ;
    cml:integrityHash "ed787203633ee81fcbaecf00f4fa8578aae33b23c23582d08c149d557a25d0d8" ;
    cof:pageNumber "51"^^xsd:integer ;
