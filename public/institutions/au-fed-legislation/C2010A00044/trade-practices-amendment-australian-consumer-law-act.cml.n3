    values:partOf concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-74 ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Right to withdraw infringement notice Infringement notice compliance period is 28 days after notice issuance." ;
    cml:curationStatus cml:Proposed ;
