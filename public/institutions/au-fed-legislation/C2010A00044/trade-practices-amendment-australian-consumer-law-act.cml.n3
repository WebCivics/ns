concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-43 a cml:Concept ;
    skos:prefLabel "43 After subsection 80(1B)"@en ;
    cml:realizedBy doc:sch-2-sec-43 ;
    values:originalText "Insert:  (1C) A reference in paragraph (1)(a) to a contravention of a provision of the Australian Consumer Law includes a reference to applying or relying on, or purporting to apply or rely on, a term of a consumer contract that the Court has declared under section 87AC to be an unfair term." ;
    skos:definition "Insert:  (1C) A reference in paragraph (1)(a) to a contravention of a provision of the Australian Consumer Law includes a reference to applying or relying on, or purporting to apply or rely on, a term of a consumer contract that the Court has declared under section 87AC to be an unfair term."@en ;
    cml:integrityHash "bf0d694b70aa173bf01eb3864b363d96392c5f3fc96de63688ea0656fea5cf43" ;
    cof:pageNumber "49"^^xsd:integer ;
    skos:note "Reference to contravention of consumer contract term declared unfair by Court." ;
