concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-73 a cml:Concept ;
    skos:prefLabel "73 At the end of section 87A"@en ;
    cml:realizedBy doc:sch-2-sec-73 ;
    values:originalText "Add:  (9) A reference in paragraph (1)(b) or (d) to a contravention of a provision of the Australian Consumer Law includes a reference to applying or relying on, or purporting to apply or rely on, a term of a consumer contract that the Court has declared under section 87AC to be an unfair term." ;
    skos:definition "Add:  (9) A reference in paragraph (1)(b) or (d) to a contravention of a provision of the Australian Consumer Law includes a reference to applying or relying on, or purporting to apply or rely on, a term of a consumer contract that the Court has declared under section 87AC to be an unfair term."@en ;
    cml:integrityHash "5630d0944807d84ffd9702d6b7f478ccaaa7a98ac71a4c40deadf4104d022520" ;
    cof:pageNumber "52"^^xsd:integer ;
    skos:note "Reference to contravention of a provision of the Australian Consumer Law includes reference to applying or relying on, or purporting to apply or rely on, an unfair term declared by the Court." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <trade-practices-amendment-australian-consumer-law-act.pdf> ;
    dc:source "trade-practices-amendment-australian-consumer-law-act.pdf, p.52" ;
