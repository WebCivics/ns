doc:sch-3-sec-42 a cof:Section ;
    cof:title "42 At the end of section 12GM" ;
    values:kind "section" ;
    values:originalText "Add:  (10) A reference in this section to a contravention of a provision of this Division includes a reference to applying or relying on, or purporting to apply or rely on, a term of a consumer contract that the Court has declared under section 12GND to be an unfair term." ;
    cof:pageNumber "81"^^xsd:integer .

