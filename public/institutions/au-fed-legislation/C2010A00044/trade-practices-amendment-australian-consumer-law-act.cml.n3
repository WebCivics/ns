doc:sch-2-sec-87zh-ss-1 a cof:Section ;
    cof:title "87ZH(1) Effect of compliance with an infringement notice" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if:  (a) an infringement notice for an alleged contravention of an infringement notice provision is issued to a person; and  (b) the person pays the penalty specified in the infringement notice within the infringement notice compliance period and in accordance with the notice; and  (c) the infringement notice is not withdrawn under section 87ZK." ;
    cof:pageNumber "42"^^xsd:integer .

concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-87zh-ss-2 a cml:Concept ;
    skos:prefLabel "87ZH(2) Effect of compliance with an infringement notice"@en ;
    cml:realizedBy doc:sch-2-sec-87zh-ss-2 ;
    values:originalText "(2) The person is not, merely because of the payment, regarded as:  (a) having contravened the infringement notice provision; or  (b) having been convicted of an offence constituted by the same conduct that constituted the alleged contravention of the infringement notice provision." ;
    skos:definition "(2) The person is not, merely because of the payment, regarded as:  (a) having contravened the infringement notice provision; or  (b) having been convicted of an offence constituted by the same conduct that constituted the alleged contravention of the infringement notice provision."@en ;
    cml:integrityHash "16fbc9ac02028b029a65b9add6887e2c82a1b7384a857d423cd5861e232f035c" ;
    values:partOf concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-87zh ;
    cof:pageNumber "42"^^xsd:integer ;
    skos:note "No obligation to be regarded as having contravened the infringement notice provision after payment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <trade-practices-amendment-australian-consumer-law-act.pdf> ;
    dc:source "trade-practices-amendment-australian-consumer-law-act.pdf, p.42" ;
    cml:asserts concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-87zh-ss-2-norm .
