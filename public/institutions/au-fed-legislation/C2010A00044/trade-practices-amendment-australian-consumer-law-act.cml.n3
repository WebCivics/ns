concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-87zm a cml:Concept ;
    skos:prefLabel "87ZM Extending periods for complying with substantiation notices"@en ;
    cml:realizedBy doc:sch-2-sec-87zm ;
    values:originalText "(1) A person who has been given a substantiation notice may, at any time within 21 days after the notice was given to the person, apply in writing to the Commission for an extension of the period for complying with the notice.  (2) The Commission may, by written notice given to the person, extend the period within which the person must comply with the notice." ;
    skos:definition "(1) A person who has been given a substantiation notice may, at any time within 21 days after the notice was given to the person, apply in writing to the Commission for an extension of the period for complying with the notice.  (2) The Commission may, by written notice given to the person, extend the period within which the person must comply with the notice."@en ;
    cml:integrityHash "4bd57fc2c4ae958bd87cf80be6de33701c0cc5b0fdd458b7ef4ab55352b9d217" ;
    cof:pageNumber "32"^^xsd:integer ;
