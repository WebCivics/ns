    cml:hasPart concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-58-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <trade-practices-amendment-australian-consumer-law-act.pdf> ;
    dc:source "trade-practices-amendment-australian-consumer-law-act.pdf, p.62" .
