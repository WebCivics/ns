concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-142 a cml:Concept ;
    skos:prefLabel "142 No doubling-up of liabilities"@en ;
    cml:realizedBy doc:sch-2-sec-142 ;
    values:originalText "(1) If:  (a) an act or omission is an offence against this Act and is also an offence against an application law; and  (b) the offender has been punished for the offence under the application law; the offender is not liable to be punished for the offence against this Act.  (2) If a person has been ordered to pay a pecuniary penalty under an application law, the person is not liable to a pecuniary penalty under this Act in respect of the same conduct." ;
    skos:definition "(1) If:  (a) an act or omission is an offence against this Act and is also an offence against an application law; and  (b) the offender has been punished for the offence under the application law; the offender is not liable to be punished for the offence against this Act.  (2) If a person has been ordered to pay a pecuniary penalty under an application law, the person is not liable to a pecuniary penalty under this Act in respect of the same conduct."@en ;
    cml:integrityHash "d08c45e6ae438948f06ada57fc775162e217ad194c9ea00c1dc39128e9479077" ;
    cof:pageNumber "22"^^xsd:integer ;
    cml:hasPart concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-142-ss-1 ;
    cml:hasPart concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-142-ss-2 ;
