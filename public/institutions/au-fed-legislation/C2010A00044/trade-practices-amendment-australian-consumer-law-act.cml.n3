concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-87zk-ss-7 a cml:Concept ;
    skos:prefLabel "87ZK(7) Withdrawal of an infringement notice"@en ;
    cml:realizedBy doc:sch-2-sec-87zk-ss-7 ;
    values:originalText "(7) If the infringement notice is withdrawn after the person has paid the penalty specified in the infringement notice, the Commission must refund to the person an amount equal to the amount paid." ;
    skos:definition "(7) If the infringement notice is withdrawn after the person has paid the penalty specified in the infringement notice, the Commission must refund to the person an amount equal to the amount paid."@en ;
    cml:integrityHash "c611dee7257d2eb059cec61d3f29dba340c7743569f051e736ba606e8a934ecb" ;
    values:partOf concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-87zk ;
    cof:pageNumber "44"^^xsd:integer ;
    skos:note "Commission must refund amount paid if infringement notice is withdrawn after payment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
