doc:sch-2-sec-135-ss-1 a cof:Section ;
    cof:title "135(1) The applied Australian Consumer Law" ;
    values:kind "subsection" ;
    values:originalText "(1) The applied Australian Consumer Law consists of:  (a) Schedule 2; and  (b) the remaining provisions of this Act (except sections 2A, 4KB, 5, 6 and 172), so far as they relate to Schedule 2; and  (c) the regulations under this Act, so far as they relate to any provision covered by paragraph (a) or (b)." ;
    cof:pageNumber "19"^^xsd:integer .

concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-135-ss-2 a cml:Concept ;
    skos:prefLabel "135(2) The applied Australian Consumer Law"@en ;
    cml:realizedBy doc:sch-2-sec-135-ss-2 ;
    values:originalText "(2) For the purpose of forming part of the applied Australian Consumer Law, the provisions referred to in paragraphs (1)(b) and ComLaw Authoritative Act C2010A00044  Schedule 1  The Australian Consumer Law" ;
    skos:definition "(2) For the purpose of forming part of the applied Australian Consumer Law, the provisions referred to in paragraphs (1)(b) and ComLaw Authoritative Act C2010A00044  Schedule 1  The Australian Consumer Law"@en ;
