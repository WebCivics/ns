    cml:premiseText "(2) This Subdivision does not:  (a) require an infringement notice to be issued to a person for an alleged contravention of an infringement notice provision;" ;
    cml:conclusionText "No infringement notice required." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

