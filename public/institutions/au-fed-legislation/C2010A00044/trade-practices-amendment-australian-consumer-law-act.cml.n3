doc:sch-3-sec-12bf-ss-2 a cof:Section ;
    cof:title "12BF(2) Unfair terms of consumer contracts" ;
    values:kind "subsection" ;
    values:originalText "(2) The contract continues to bind the parties if it is capable of operating without the unfair term." ;
    cof:pageNumber "54"^^xsd:integer .

concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-12bf-ss-3 a cml:Concept ;
    skos:prefLabel "12BF(3) Unfair terms of consumer contracts"@en ;
    cml:realizedBy doc:sch-3-sec-12bf-ss-3 ;
    values:originalText "(3) A consumer contract is a contract at least one of the parties to which is an individual whose acquisition of what is supplied under the contract is wholly or predominantly an acquisition for personal, domestic or household use or consumption." ;
    skos:definition "(3) A consumer contract is a contract at least one of the parties to which is an individual whose acquisition of what is supplied under the contract is wholly or predominantly an acquisition for personal, domestic or household use or consumption."@en ;
