concept:trade-practices-amendment-australian-consumer-law-act-sch-2-sec-41 a cml:Concept ;
    skos:prefLabel "41 Paragraph 80(1)(a)"@en ;
    cml:realizedBy doc:sch-2-sec-41 ;
    values:originalText "Repeal the paragraph, substitute:  (a) a contravention of any of the following provisions:  (i) a provision of Part IV, IVA, IVB, V or VC;  (ii) a provision of the Australian Consumer Law; or Note: This item does not commence at all if Schedule 1 to the Statute Stocktake (Regulatory and Other Laws) Act 2009 does not commence. (See table item 6 in subsection 2(1) of this Act.)" ;
    skos:definition "Repeal the paragraph, substitute:  (a) a contravention of any of the following provisions:  (i) a provision of Part IV, IVA, IVB, V or VC;  (ii) a provision of the Australian Consumer Law; or Note: This item does not commence at all if Schedule 1 to the Statute Stocktake (Regulatory and Other Laws) Act 2009 does not commence. (See table item 6 in subsection 2(1) of this Act.)"@en ;
    cml:integrityHash "127a822dc30064d31428f8881b9959417f8e3d17eddb006848e4c9fd2e40bfd3" ;
    cof:pageNumber "49"^^xsd:integer ;
