concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-74-ss-5 a cml:Concept ;
    skos:prefLabel "74(5) Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010       No. 44,"@en ;
    cml:realizedBy doc:sch-3-sec-74-ss-5 ;
    values:originalText "(5) The withdrawal notice must state:  (a) the name and address of the person; and  (b) the day on which the infringement notice was issued to the person; and  (c) that the infringement notice is withdrawn; and  (d) that proceedings under Subdivision G (sections 12GA to 12GO) may be started or continued against the person in relation to:  (i) the alleged contravention of the infringement notice provision; or  (ii) an offence constituted by the same conduct that constituted the alleged contravention. Time limit for giving withdrawal notices" ;
    skos:definition "(5) The withdrawal notice must state:  (a) the name and address of the person; and  (b) the day on which the infringement notice was issued to the person; and  (c) that the infringement notice is withdrawn; and  (d) that proceedings under Subdivision G (sections 12GA to 12GO) may be started or continued against the person in relation to:  (i) the alleged contravention of the infringement notice provision; or  (ii) an offence constituted by the same conduct that constituted the alleged contravention. Time limit for giving withdrawal notices"@en ;
    cml:integrityHash "7ce1fceb5fe87ac29758e6bc9d81355d1b73a17adcf4393e0d020b4501ed9fc1" ;
    values:partOf concept:trade-practices-amendment-australian-consumer-law-act-sch-3-sec-74 ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Withdrawal notice must state certain information. Failure to comply with subsection (4) does not affect the validity of the extension." ;
    dc:description "name and address of the person, day on which infringement notice was issued, that proceedings may be started or continued against the person" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
