    cml:realizedBy doc:sch-3-sec-56-ss-1 ;
    values:originalText "(1) ASIC may institute a proceeding in the Court for the recovery on behalf of the Commonwealth of a pecuniary penalty referred to in section 12GBA." ;
    skos:definition "(1) ASIC may institute a proceeding in the Court for the recovery on behalf of the Commonwealth of a pecuniary penalty referred to in section 12GBA."@en ;
