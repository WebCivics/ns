    cml:logicSummary "Prohibits the use of terms with specific effects." ;
    cml:premiseText "(h) a term that permits, or has the effect of permitting, one party unilaterally to determine whether the contract has been breached or to interpret its meaning;" ;
    cml:conclusionText "No such term is permitted." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
