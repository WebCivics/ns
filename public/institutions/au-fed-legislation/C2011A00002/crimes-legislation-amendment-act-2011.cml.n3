concept:crimes-legislation-amendment-act-2011-sch-2-sec-4 a cml:Concept ;
    skos:prefLabel "4 Transitional provision for item 3"@en ;
    cml:realizedBy doc:sch-2-sec-4 ;
    values:originalText "Despite subsection 46A(4) of the Australian Crime Commission Act 2002 (as inserted by item 3 of this Schedule), the first notification under that subsection must relate to arrangements made during the period:  (a) starting at the commencement of this item; and  (b) ending at the end of the first 30 June or 31 December (as the case requires) after that time." ;
    skos:definition "Despite subsection 46A(4) of the Australian Crime Commission Act 2002 (as inserted by item 3 of this Schedule), the first notification under that subsection must relate to arrangements made during the period:  (a) starting at the commencement of this item; and  (b) ending at the end of the first 30 June or 31 December (as the case requires) after that time."@en ;
    cml:integrityHash "7afe5e3460d24d66ec67c7e80263520e634218b9701163e3ab2d4bcfa72e2111" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Defines the period for notification under subsection 46A(4) of the Australian Crime Commission Act 2002." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-act-2011.pdf> ;
    dc:source "crimes-legislation-amendment-act-2011.pdf, p.13" ;
    cml:asserts concept:crimes-legislation-amendment-act-2011-sch-2-sec-4-norm .
