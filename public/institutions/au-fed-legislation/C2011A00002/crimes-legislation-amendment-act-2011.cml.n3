    cof:title "5 Subsection 5(1) (at the end of paragraph (aa) of the" ;
    values:kind "section" ;
    values:originalText "definition of permitted purpose) Add:  (iii) an investigation of, or an inquiry into, alleged misbehaviour, or alleged improper conduct, of a member of the staff referred to in subsection 47(1) of the Australian Crime Commission Act 2002; or  (iv) a report on such an investigation or inquiry; or  (v) the making by a person of a decision, following such an investigation or inquiry, in relation to the employment of such a staff member (including a decision to terminate the staff member’s employment); or  (vi) a review (whether by way of appeal or otherwise) of such a decision; or" ;
    cof:pageNumber "10"^^xsd:integer .

concept:crimes-legislation-amendment-act-2011-sch-1-sec-6 a cml:Concept ;
    skos:prefLabel "6 After paragraph 68(c)"@en ;
    cml:realizedBy doc:sch-1-sec-6 ;
    values:originalText "Insert:  (ca) if:  (i) the information relates, or appears to relate, to an act or omission by a member of the staff of the ACC that may give rise to a decision by the Chief Executive Officer of the ACC to terminate the employment of the staff member; and  (ii) the originating agency is not the ACC;  to the Chief Executive Officer of the ACC; and" ;
    skos:definition "Insert:  (ca) if:  (i) the information relates, or appears to relate, to an act or omission by a member of the staff of the ACC that may give rise to a decision by the Chief Executive Officer of the ACC to terminate the employment of the staff member; and  (ii) the originating agency is not the ACC;  to the Chief Executive Officer of the ACC; and"@en ;
    cml:integrityHash "cc7ff1eda71ede37c2b4120ba35177e7eaf1ed589409d3db8f9d813bff473ba5" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Must provide information to Chief Executive Officer if certain conditions apply" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
