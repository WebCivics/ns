concept:crimes-legislation-amendment-act-2011-sch-1-sec-7 a cml:Concept ;
    skos:prefLabel "7 Application"@en ;
    cml:realizedBy doc:sch-1-sec-7 ;
    values:originalText "ComLaw Authoritative Act C2011A00002  Amendments relating to ACC dismissal powers  Schedule 1 Amendment of the Telecommunications (Interception and Access) Act 1979  Part 2  The Telecommunications (Interception and Access) Act 1979, as amended by this Part, applies in relation to the communication, use and making of a record of information, and the giving of information in evidence in proceedings, on or after the commencement of this item, whether the information was obtained before or after that commencement. ComLaw Authoritative Act C2011A00002  Schedule 1  Amendments relating to ACC dismissal powers" ;
    skos:definition "ComLaw Authoritative Act C2011A00002  Amendments relating to ACC dismissal powers  Schedule 1 Amendment of the Telecommunications (Interception and Access) Act 1979  Part 2  The Telecommunications (Interception and Access) Act 1979, as amended by this Part, applies in relation to the communication, use and making of a record of information, and the giving of information in evidence in proceedings, on or after the commencement of this item, whether the information was obtained before or after that commencement. ComLaw Authoritative Act C2011A00002  Schedule 1  Amendments relating to ACC dismissal powers"@en ;
    cml:integrityHash "33efea1df0004fb368add43a9580d8a1a071ac5c2ef9f7bb3b511a53db6f7fbb" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Applicability of amended Telecommunications Act" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-act-2011.pdf> ;
    dc:source "crimes-legislation-amendment-act-2011.pdf, p.10" ;
    cml:asserts concept:crimes-legislation-amendment-act-2011-sch-1-sec-7-norm .
