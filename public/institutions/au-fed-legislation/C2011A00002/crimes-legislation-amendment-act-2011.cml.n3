concept:crimes-legislation-amendment-act-2011-sch-3-sec-44 a cml:Concept ;
    skos:prefLabel "44 Application of this Part"@en ;
    cml:realizedBy doc:sch-3-sec-44 ;
    values:originalText "The amendment made by this Part applies to any person who, after this Part commences, is taken into lawful custody in respect of an offence that is punishable by imprisonment for a period of 12 months or more. ComLaw Authoritative Act C2011A00002  Amendments relating to special payments to AFP appointees  Schedule 4" ;
    skos:definition "The amendment made by this Part applies to any person who, after this Part commences, is taken into lawful custody in respect of an offence that is punishable by imprisonment for a period of 12 months or more. ComLaw Authoritative Act C2011A00002  Amendments relating to special payments to AFP appointees  Schedule 4"@en ;
    cml:integrityHash "923f367862196f152c3b61455b5542c916d7a88d53862775ca8483dddcffa9f0" ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Applicable to persons taken into custody after Part commencement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-act-2011.pdf> ;
    dc:source "crimes-legislation-amendment-act-2011.pdf, p.26" ;
