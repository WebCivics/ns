concept:crimes-legislation-amendment-act-2011-sch-2-sec-13 a cml:Concept ;
    skos:prefLabel "13 At the end of section 46G"@en ;
    cml:realizedBy doc:sch-2-sec-13 ;
    values:originalText "Add: ComLaw Authoritative Act C2011A00002  Amendments relating to appointment of ACC examiners  Schedule 2  Part-time examiners  (2) A part-time examiner must not engage in any paid employment that, in the CEO’s opinion, conflicts or may conflict with the proper performance of his or her duties.  (3) The CEO may, by written notice given to a part-time examiner, require the examiner to give the CEO the details specified in the notice, about the examiner’s employment, by the time specified in the notice. The examiner must comply with the requirement." ;
    skos:definition "Add: ComLaw Authoritative Act C2011A00002  Amendments relating to appointment of ACC examiners  Schedule 2  Part-time examiners  (2) A part-time examiner must not engage in any paid employment that, in the CEO’s opinion, conflicts or may conflict with the proper performance of his or her duties.  (3) The CEO may, by written notice given to a part-time examiner, require the examiner to give the CEO the details specified in the notice, about the examiner’s employment, by the time specified in the notice. The examiner must comply with the requirement."@en ;
    cml:integrityHash "b5fb3effbe7aa4f109d4fc48b9bca5f9950c6d925e3af938b4bd9cb637caa597" ;
    cof:pageNumber "14"^^xsd:integer ;
    cml:hasPart concept:crimes-legislation-amendment-act-2011-sch-2-sec-13-ss-2 ;
    cml:hasPart concept:crimes-legislation-amendment-act-2011-sch-2-sec-13-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-act-2011.pdf> ;
    dc:source "crimes-legislation-amendment-act-2011.pdf, p.14" .
