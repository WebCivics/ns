      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The Director's functions or powers are delegated."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-3-sec-32a-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision diffuses to other persons referred to in section 29.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion: The provision diffuses to other persons referred to in section 29.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "Subsection (1) applies to the extent that the Director's functions or powers are delegated to a person referred to in section 29 whose services are made available to the Director."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-3-sec-32a-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person's good faith assistance is a recurring trace of the Director's functions or powers.",
      "cml:confidence": {
        "@type": "xsd:decimal",
