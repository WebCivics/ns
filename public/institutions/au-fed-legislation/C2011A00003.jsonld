    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Dealing with one’s own identification information overlaps with section 372's application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes a temporal relationship between the exemption and section 372's application.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The exemption applies to dealing with one’s own identification information at any time."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Dealing with one’s own identification information is recognized as exempt from section 372's application by artificial intelligence systems.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Describes the recognition of the exemption by artificial intelligence systems.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "Artificial intelligence systems recognize the exemption for dealing with one’s own identification information."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Section 372 does not apply to dealing in the first person’s own identification information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes an obligation on the state to exempt individuals from section 372's application.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The state is required to exempt individuals from section 372's application for dealing with their own identification information."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Dealing with one’s own identification information diffuses to other individuals who are exempt from section 372's application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Describes the diffusion of the exemption to other individuals or contexts.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "The exemption diffuses to other individuals who deal with their own identification information."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Dealing with one’s own identification information is recurrently exempt from section 372's application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes a recurring relationship between the exemption and section 372's application.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:premiseText": "The exemption applies to dealing with one’s own identification information repeatedly."
    },
