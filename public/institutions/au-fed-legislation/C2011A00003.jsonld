    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-3-sec-32a-ss-1",
      "@type": "cml:Concept",
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.34",
      "skos:note": "No civil action against certain persons in good faith performance of functions under the Act.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "32A(1) Immunity from civil proceedings"
      },
      "wasDerivedFrom": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf",
      "asserts": [
