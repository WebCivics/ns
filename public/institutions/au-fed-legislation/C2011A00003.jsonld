    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46",
      "@type": "cml:Concept",
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.25",
      "skos:note": "Aiding prisoner to escape is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "46 Aiding prisoner to escape"
      },
      "wasDerivedFrom": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf",
      "asserts": [
        "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46-norm",
        "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "da2902dca27682eb483833194250ca5ccbddf41c6586717c735506544436ca7a",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-46",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A person (the first person) commits an offence if:  (a) another person (the prisoner) is in criminal detention; and  (b) the first person aids the prisoner:  (i) to escape from that detention; or  (ii) to attempt to escape from that detention; and  (c) the prisoner escapes, or attempts to escape, from that detention; and  (d) the detention is lawful federal criminal detention.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits aiding a prisoner to escape.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) A person (the first person) commits an offence if:  (a) another person (the prisoner) is in criminal detention; and  (b) the first person aids the prisoner:  (i) to escape from that detention; or  (ii) to attempt to escape from that detention; and  (c) the prisoner escapes, or attempts to escape, from that detention; and  (d) the detention is lawful federal criminal detention."
    },
