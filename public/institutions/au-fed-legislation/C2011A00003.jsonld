      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The Act prohibits the use of listed documents for identity verification purposes."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The listed documents are prohibited for identity verification purposes.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies personal identification documents as prohibited for identity verification purposes.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classify",
      "cml:premiseText": "The Act classifies the following documents as prohibited for identity verification: (f) a voice print; (g) a credit or debit card, its number, or data stored or encrypted on it; (h) a financial account number, user name or password; (i) a digital signature; (j) a series of numbers or letters (or both) intended for use as a means of personal identification; (k) an ABN."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "All relevant authorities must not use listed documents for identity verification purposes.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffuses the prohibition of using listed documents for identity verification purposes.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Prohibition Diffusion",
      "cml:premiseText": "The Act diffuses the prohibition of using listed documents for identity verification purposes to all relevant authorities."
    },
