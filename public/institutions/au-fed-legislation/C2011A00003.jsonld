    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-370-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Identification information is required during the use of identification documentation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Identifies the time period during which identification information must be provided.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "A person must provide identification information when using identification documentation."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-370-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must provide identification information to avoid pretending to be someone else.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implies that a person must provide identification information to avoid pretending to be someone else.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "A person who uses identification documentation must pretend to be themselves."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-370-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must provide identification information to be recognized by their identification information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Recognizes that a person must provide identification information when using identification documentation.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:premiseText": "A person who uses identification documentation can be identified by their identification information."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-370-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person must provide identification information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requires identification information to be provided.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:premiseText": "Identification documentation contains or incorporates identification information."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-370-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Identification documentation is a document containing identification information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Identifies a subclass of documents that contain identification information.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is-a",
      "cml:premiseText": "Identification documentation is capable of being used by a person for the purpose of pretending to be, or passing the person off as, another person."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-370-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The diffusion of identification documentation does not require a person to provide identification information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffuses the requirement that a person must provide identification information when using identification documentation.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:premiseText": "Identification documentation is capable of being used by a person for the purpose of pretending to be, or passing the person off as, another person."
    },
