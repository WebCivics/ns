    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes an obligation on the state to exempt individuals from section 372's application." ;
    cml:premiseText "The state is required to exempt individuals from section 372's application for dealing with their own identification information." ;
    cml:conclusionText "Section 372 does not apply to dealing in the first person’s own identification information." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

