    cml:modality cml:Diffusion ;
    cml:operator "Prohibition Diffusion" ;
    cml:logicSummary "Diffuses the prohibition of using listed documents for identity verification purposes." ;
    cml:premiseText "The Act diffuses the prohibition of using listed documents for identity verification purposes to all relevant authorities." ;
    cml:conclusionText "All relevant authorities must not use listed documents for identity verification purposes." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4 cml:asserts concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-cogai-6 .
