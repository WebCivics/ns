    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Prohibition" ;
    cml:logicSummary "Prohibits the use of listed documents during a specific time period." ;
    cml:premiseText "The Act prohibits the use of listed documents from January 1, 2012 to December 31, 2015." ;
    cml:conclusionText "No listed document may be used for identity verification between January 1, 2012 and December 31, 2015." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

