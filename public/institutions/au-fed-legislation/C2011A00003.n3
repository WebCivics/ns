    cml:modality cml:AllenInterval ;
    cml:operator "Overlap" ;
    cml:logicSummary "Temporal overlap between judge's or magistrate's actions and oppressive behavior" ;
    cml:premiseText "(judge or magistrate is required or authorised by law to admit a person accused of an offence to bail)" ;
    cml:conclusionText "The temporal overlap between the judge's or magistrate's actions and their oppressive behavior must be greater than 0." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

