    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the use of listed documents for identity verification." ;
    cml:premiseText "The Act prohibits the use of listed documents for identity verification purposes." ;
    cml:conclusionText "No listed document may be used for identity verification." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4 cml:asserts concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-descriptionlogic-2 .
concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "Classify" ;
    cml:logicSummary "Classifies personal identification documents as prohibited for identity verification purposes." ;
    cml:premiseText "The Act classifies the following documents as prohibited for identity verification: (f) a voice print; (g) a credit or debit card, its number, or data stored or encrypted on it; (h) a financial account number, user name or password; (i) a digital signature; (j) a series of numbers or letters (or both) intended for use as a means of personal identification; (k) an ABN." ;
    cml:conclusionText "The listed documents are prohibited for identity verification purposes." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4 cml:asserts concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-alleninterval-3 .
