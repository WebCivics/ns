    cml:conclusionText "All relevant authorities must be aware of the prohibition of using listed documents for identity verification purposes." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


