    cml:modality cml:DescriptionLogic ;
    cml:operator "Classify" ;
    cml:logicSummary "Classifies personal identification documents as prohibited for identity verification purposes." ;
    cml:premiseText "The Act classifies the following documents as prohibited for identity verification: (f) a voice print; (g) a credit or debit card, its number, or data stored or encrypted on it; (h) a financial account number, user name or password; (i) a digital signature; (j) a series of numbers or letters (or both) intended for use as a means of personal identification; (k) an ABN." ;
    cml:conclusionText "The listed documents are prohibited for identity verification purposes." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

