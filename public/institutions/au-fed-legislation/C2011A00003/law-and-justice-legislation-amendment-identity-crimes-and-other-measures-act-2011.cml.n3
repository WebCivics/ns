    cml:hasPart concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-2011-6-ss-4 ;
    cml:hasPart concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-2011-6-ss-1 ;
    cml:hasPart concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-2011-6-ss-2 ;
