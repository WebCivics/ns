concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-15 a cml:Concept ;
    skos:prefLabel "15 Subsections 43(1) and (2)"@en ;
    cml:realizedBy doc:sch-2-sec-15 ;
    values:originalText "Repeal the subsections, substitute:  (1) A person commits an offence if:  (a) the person attempts to obstruct, to prevent, to pervert or to defeat the course of justice in relation to a judicial power; and  (b) the judicial power is the judicial power of the Commonwealth. Penalty: Imprisonment for 10 years.  (2) Absolute liability applies to the paragraph (1)(b) element of the offence. Note: For absolute liability, see section 6.2 of the Criminal Code." ;
    skos:definition "Repeal the subsections, substitute:  (1) A person commits an offence if:  (a) the person attempts to obstruct, to prevent, to pervert or to defeat the course of justice in relation to a judicial power; and  (b) the judicial power is the judicial power of the Commonwealth. Penalty: Imprisonment for 10 years.  (2) Absolute liability applies to the paragraph (1)(b) element of the offence. Note: For absolute liability, see section 6.2 of the Criminal Code."@en ;
    cml:integrityHash "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d" ;
    cof:pageNumber "23"^^xsd:integer ;
