doc:sch-2-sec-34-ss-1 a cof:Section ;
    cof:title "34(1) Judge or magistrate acting oppressively or when interested" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if:  (a) the person is a judge or magistrate; and  (b) the judge or magistrate is required or authorised by law to admit a person accused of an offence to bail; and ComLaw Authoritative Act C2011A00003  Administration of justice offences  Schedule 2 Amendment of the Crimes Act 1914  Part 1  Law and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011       No. 3, 2011            13  (c) the judge or magistrate requires excessive and unreasonable bail; and  (d) the requirement is an abuse of the judge’s or magistrate’s office; and  (e) the offence referred to in paragraph (b) is an offence against a law of the Commonwealth. Penalty: Imprisonment for 2 years." ;
    cof:pageNumber "16"^^xsd:integer .

concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-34-ss-2 a cml:Concept ;
    skos:prefLabel "34(2) Judge or magistrate acting oppressively or when interested"@en ;
    cml:realizedBy doc:sch-2-sec-34-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply if the judge or magistrate has a reasonable excuse. Note: A defendant bears an evidential burden in relation to the matter in subsection (2) (see subsection 13.3(3) of the Criminal Code)." ;
    skos:definition "(2) Subsection (1) does not apply if the judge or magistrate has a reasonable excuse. Note: A defendant bears an evidential burden in relation to the matter in subsection (2) (see subsection 13.3(3) of the Criminal Code)."@en ;
    cml:integrityHash "8d46ba5d4c4e8758b2f7327bdf88adf3e58a570f700785706d35c614afbd6a51" ;
    values:partOf concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-34 ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Defendant bears evidential burden in relation to a reasonable excuse." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
