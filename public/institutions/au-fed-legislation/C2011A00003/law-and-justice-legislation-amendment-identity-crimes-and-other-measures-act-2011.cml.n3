concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-8 a cml:Concept ;
    skos:prefLabel "8 Law and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011"@en ;
    cml:realizedBy doc:sch-1-sec-8 ;
    values:originalText "No. 3, 2011  (b) subject to subsection (2)—any proceedings (whether civil or criminal) have been or can be taken against a person for or in relation to the dealing, or are pending.  (2) The magistrate must not issue a certificate under section 375.1 if doing so would prejudice any proceedings.  (3) The certificate is not admissible in any proceedings." ;
    skos:definition "No. 3, 2011  (b) subject to subsection (2)—any proceedings (whether civil or criminal) have been or can be taken against a person for or in relation to the dealing, or are pending.  (2) The magistrate must not issue a certificate under section 375.1 if doing so would prejudice any proceedings.  (3) The certificate is not admissible in any proceedings."@en ;
    cml:integrityHash "3a6c84e21520f88f8911ffa56a2d36b7f48b7b30898970a20569023425a84897" ;
    cof:pageNumber "12"^^xsd:integer ;
    cml:hasPart concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-8-ss-2 ;
    cml:hasPart concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-8-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf> ;
    dc:source "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.12" .
doc:sch-1-sec-8 a cof:Section ;
    cof:title "8 Law and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011" ;
    values:kind "section" ;
    values:originalText "No. 3, 2011  (b) subject to subsection (2)—any proceedings (whether civil or criminal) have been or can be taken against a person for or in relation to the dealing, or are pending.  (2) The magistrate must not issue a certificate under section 375.1 if doing so would prejudice any proceedings.  (3) The certificate is not admissible in any proceedings." ;
    cof:pageNumber "12"^^xsd:integer .

