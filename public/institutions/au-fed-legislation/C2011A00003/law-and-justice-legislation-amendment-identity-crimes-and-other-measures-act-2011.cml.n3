concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-34-ss-4 a cml:Concept ;
    skos:prefLabel "34(4) Judge or magistrate acting oppressively or when interested"@en ;
    cml:realizedBy doc:sch-2-sec-34-ss-4 ;
    values:originalText "(4) A person commits an offence if:  (a) the person is a judge or magistrate; and  (b) the judge or magistrate perversely exercises jurisdiction in a matter; and  (c) the judge or magistrate has a personal interest in the matter; and  (d) the jurisdiction is federal jurisdiction. Penalty: Imprisonment for 2 years." ;
    skos:definition "(4) A person commits an offence if:  (a) the person is a judge or magistrate; and  (b) the judge or magistrate perversely exercises jurisdiction in a matter; and  (c) the judge or magistrate has a personal interest in the matter; and  (d) the jurisdiction is federal jurisdiction. Penalty: Imprisonment for 2 years."@en ;
    cml:integrityHash "66fcff2dea61b0f6b8a8bb4f39130821b5990cb083f4a7307cd347a75aa4c8d9" ;
    values:partOf concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-34 ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Committing an offence for perversely exercising jurisdiction in a matter with personal interest." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
