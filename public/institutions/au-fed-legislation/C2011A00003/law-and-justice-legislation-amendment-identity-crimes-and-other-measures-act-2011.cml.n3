concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-375-2 a cml:Concept ;
    skos:prefLabel "375 2  Content of certificate"@en ;
    cml:realizedBy doc:sch-1-sec-375-2 ;
    values:originalText "(1) A certificate issued under section 375.1 must:  (a) identify the victim; and  (b) describe the dealing in identification information.  (2) The certificate may contain such other information as the magistrate considers appropriate.  (3) The certificate must not identify the dealer." ;
    skos:definition "(1) A certificate issued under section 375.1 must:  (a) identify the victim; and  (b) describe the dealing in identification information.  (2) The certificate may contain such other information as the magistrate considers appropriate.  (3) The certificate must not identify the dealer."@en ;
    cml:integrityHash "9b517d06b23875d844a455a591999ab37a5ab42200e16abece149f0684a4cccc" ;
    cof:pageNumber "11"^^xsd:integer ;
