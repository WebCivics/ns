doc:sch-2-sec-2011-6-ss-4 a cof:Section ;
    cof:title "2011(4) No. 3, 2011" ;
    values:kind "subsection" ;
    values:originalText "(4) The first person may be found guilty of the offence even if the prisoner has not been prosecuted for, or has not been found guilty of, an offence in relation to the escape or attempted escape. 46A  Aiding prisoner to escape—conveying thing into prison etc." ;
    cof:pageNumber "26"^^xsd:integer .

concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-2011-6-ss-1 a cml:Concept ;
    skos:prefLabel "2011(1) No. 3, 2011"@en ;
    cml:realizedBy doc:sch-2-sec-2011-6-ss-1 ;
    values:originalText "(1) A person (the first person) commits an offence if:  (a) another person (the prisoner) is in criminal detention; and  (b) the first person conveys a thing into a prison, lock-up or other place of criminal detention; and  (c) the first person does so with the intention of facilitating the escape of the prisoner from the prison, lock-up or other place; and  (d) the detention is lawful federal criminal detention. Penalty: Imprisonment for 5 years." ;
    skos:definition "(1) A person (the first person) commits an offence if:  (a) another person (the prisoner) is in criminal detention; and  (b) the first person conveys a thing into a prison, lock-up or other place of criminal detention; and  (c) the first person does so with the intention of facilitating the escape of the prisoner from the prison, lock-up or other place; and  (d) the detention is lawful federal criminal detention. Penalty: Imprisonment for 5 years."@en ;
    cml:integrityHash "1b504625a2ab0dec312cb57139ef2934add1a83ea7d20152ffc5104eb3e58dec" ;
    values:partOf concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-2011-6 ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Conveying a thing into a prison with the intention of facilitating escape is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
