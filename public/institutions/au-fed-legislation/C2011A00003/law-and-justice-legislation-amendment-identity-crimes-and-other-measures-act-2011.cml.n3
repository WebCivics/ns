concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-375-4 a cml:Concept ;
    skos:prefLabel "375 4  Power conferred on magistrate personally"@en ;
    cml:realizedBy doc:sch-1-sec-375-4 ;
    values:originalText "(1) Power is conferred by this Division on a magistrate only in a personal capacity and not as a court or a member of a court.  (2) The magistrate need not accept the power conferred.  (3) A magistrate exercising a power under this Division has the same protection and immunity as if he or she were exercising that power as, or as a member of, the court of which the magistrate is a member." ;
    skos:definition "(1) Power is conferred by this Division on a magistrate only in a personal capacity and not as a court or a member of a court.  (2) The magistrate need not accept the power conferred.  (3) A magistrate exercising a power under this Division has the same protection and immunity as if he or she were exercising that power as, or as a member of, the court of which the magistrate is a member."@en ;
    cml:integrityHash "93cb386fde2718e716feb9f67151f81617a90f1652ea9415ba389eba2f2f0b34" ;
    cof:pageNumber "12"^^xsd:integer ;
