    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes an obligation on individuals to not escape from lawful federal criminal detention." ;
    cml:premiseText "(a) the person is in criminal detention; and (b) the person escapes from that detention;" ;
    cml:conclusionText "...and (c) the detention is lawful federal criminal detention." ;
