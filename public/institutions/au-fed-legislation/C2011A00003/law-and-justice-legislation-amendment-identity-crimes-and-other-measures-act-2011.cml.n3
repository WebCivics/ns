concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46 a cml:Concept ;
    skos:prefLabel "46 Aiding prisoner to escape"@en ;
    cml:realizedBy doc:sch-2-sec-46 ;
    values:originalText "(1) A person (the first person) commits an offence if:  (a) another person (the prisoner) is in criminal detention; and  (b) the first person aids the prisoner:  (i) to escape from that detention; or  (ii) to attempt to escape from that detention; and  (c) the prisoner escapes, or attempts to escape, from that detention; and  (d) the detention is lawful federal criminal detention. ComLaw Authoritative Act C2011A00003  Schedule 2  Administration of justice offences" ;
    skos:definition "(1) A person (the first person) commits an offence if:  (a) another person (the prisoner) is in criminal detention; and  (b) the first person aids the prisoner:  (i) to escape from that detention; or  (ii) to attempt to escape from that detention; and  (c) the prisoner escapes, or attempts to escape, from that detention; and  (d) the detention is lawful federal criminal detention. ComLaw Authoritative Act C2011A00003  Schedule 2  Administration of justice offences"@en ;
    cml:integrityHash "da2902dca27682eb483833194250ca5ccbddf41c6586717c735506544436ca7a" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Aiding prisoner to escape is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf> ;
    dc:source "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.25" ;
    cml:asserts concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46-norm .
