law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-6 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-1-sec-4;
  logic: DescriptionLogic;
  operator: Classify;
  summary: Classifies personal identification documents as prohibited for identity verification purposes.;
  executionSurface: modalities::dl;
  curationStatus: Proposed;
  @condition: The Act classifies the following documents as prohibited for identity verification: (f) a voice print; (g) a credit or debit card, its number, or data stored or encrypted on it; (h) a financial account number, user name or password; (i) a digital signature; (j) a series of numbers or letters (or both) intended for use as a means of personal identification; (k) an ABN.;
  @action: The listed documents are prohibited for identity verification purposes.;
}

