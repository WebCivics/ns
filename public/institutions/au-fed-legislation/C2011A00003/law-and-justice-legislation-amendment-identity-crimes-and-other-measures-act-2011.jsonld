      "@type": "cml:Concept",
      "skos:prefLabel": "2011 No. 3, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-2011-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
