      "cml:integrityHash": "f0b4a4f65d3a195ec5326b7ef014257dabc7f8cb9834ce6b54a50fed835409ba",
      "skos:note": "No attempt is an offence against this Division."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-372-6",
