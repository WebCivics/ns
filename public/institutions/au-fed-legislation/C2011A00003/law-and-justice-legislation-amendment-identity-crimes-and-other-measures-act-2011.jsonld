        }
      ],
      "cml:integrityHash": "c92bdcc440f48382cd375944708314b81daad934b6eb23f153412f2a17fa14f9",
      "skos:note": "Prevents a person from attending as a witness or producing evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-2011-4",
      "@type": "cof:Section",
      "cof:title": "2011 No. 3, 2011",
      "values:kind": "section",
