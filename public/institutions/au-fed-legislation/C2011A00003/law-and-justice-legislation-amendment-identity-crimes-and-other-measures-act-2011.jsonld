    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 Harbouring etc. an escapee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.28",
      "values:originalText": "(1) A person (the first person) commits an offence if:\n\n(a) the first person knows that another person (the escapee) has\nescaped from a place where the other person was held in\ncriminal detention; and\n\n(b) the first person harbours, maintains or employs the escapee;\nand\n\n(c) the detention was lawful federal criminal detention.\nPenalty: Imprisonment for 5 years.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "skos:definition": "(1) A person (the first person) commits an offence if:\n\n(a) the first person knows that another person (the escapee) has\nescaped from a place where the other person was held in\ncriminal detention; and\n\n(b) the first person harbours, maintains or employs the escapee;\nand\n\n(c) the detention was lawful federal criminal detention.\nPenalty: Imprisonment for 5 years.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "cml:hasPart": [
