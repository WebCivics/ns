    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-39",
      "@type": "cml:Concept",
      "skos:prefLabel": "39 Destroying evidence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-39"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.21",
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person knows that a book, document or thing of any kind\nis, or may be, required in evidence in a judicial proceeding;\nand\n\n(b) the person:\n\n(i) destroys the book, document or thing; or\n\n(ii) renders the book, document or thing illegible,\nundecipherable or incapable of identification; and\n\n(c) the person does so with the intention of preventing the book,\ndocument or thing from being used in evidence; and\n\n(d) the judicial proceeding is a federal judicial proceeding.\nPenalty: Imprisonment for 5 years.\n\n(2) Absolute liability applies to the paragraph (1)(d) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "skos:definition": "(1) A person commits an offence if:\n\n(a) the person knows that a book, document or thing of any kind\nis, or may be, required in evidence in a judicial proceeding;\nand\n\n(b) the person:\n\n(i) destroys the book, document or thing; or\n\n(ii) renders the book, document or thing illegible,\nundecipherable or incapable of identification; and\n\n(c) the person does so with the intention of preventing the book,\ndocument or thing from being used in evidence; and\n\n(d) the judicial proceeding is a federal judicial proceeding.\nPenalty: Imprisonment for 5 years.\n\n(2) Absolute liability applies to the paragraph (1)(d) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "cml:hasPart": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-39-ss-1"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-39-ss-2"
        }
      ],
      "cml:integrityHash": "ccd709eb484715fd9b0e95a74a579760ef1bb7b39628d785e7eb9e69565ea1bb"
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-39",
      "@type": "cof:Section",
      "cof:title": "39 Destroying evidence",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person knows that a book, document or thing of any kind\nis, or may be, required in evidence in a judicial proceeding;\nand\n\n(b) the person:\n\n(i) destroys the book, document or thing; or\n\n(ii) renders the book, document or thing illegible,\nundecipherable or incapable of identification; and\n\n(c) the person does so with the intention of preventing the book,\ndocument or thing from being used in evidence; and\n\n(d) the judicial proceeding is a federal judicial proceeding.\nPenalty: Imprisonment for 5 years.\n\n(2) Absolute liability applies to the paragraph (1)(d) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code."
    },
