        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-35-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d7aba4bafd987ddbac8ccabffbb5c6306c0636379ed25e9adbf37b683152a372",
      "skos:note": "Giving false testimony in a federal judicial proceeding is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-35-ss-1",
      "@type": "cof:Section",
      "cof:title": "35(1) Giving false testimony",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person gives false testimony touching a matter; and\n\n(b) the person does so:\n\n(i) in a judicial proceeding; or\n\n(ii) with the intention of instituting a judicial proceeding;\nand\n\n(c) the matter is material in the judicial proceeding; and\n\n(d) the judicial proceeding is a federal judicial proceeding.\nPenalty: Imprisonment for 5 years."
    },
