      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.12",
      "values:originalText": "(2) The magistrate must not issue a certificate under section 375.1 if\ndoing so would prejudice any proceedings.",
      "skos:definition": "(2) The magistrate must not issue a certificate under section 375.1 if\ndoing so would prejudice any proceedings.",
      "values:partOf": {
        "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-8"
      },
      "cml:asserts": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-8-ss-2-norm"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-8-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1a022e988c73d6959633574634d60c34b0bdf38a655372664814ad96dc84f591",
      "skos:note": "Magistrate cannot issue certificate under section 375.1 if it would prejudice proceedings."
    },
    {
