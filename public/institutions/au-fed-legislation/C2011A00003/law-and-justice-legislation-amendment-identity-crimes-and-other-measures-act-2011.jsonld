    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-45-ss-2",
      "@type": "cof:Section",
      "cof:title": "45(2) Inserting advertisements without authority of court",
      "values:kind": "subsection",
      "cof:pageNumber": 24,
      "values:originalText": "(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code."
    },
