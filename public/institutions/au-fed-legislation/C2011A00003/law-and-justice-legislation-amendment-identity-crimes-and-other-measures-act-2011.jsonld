    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Inserting advertisements without authority of court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.24",
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person inserts in the Gazette, or in a newspaper, an\nadvertisement purporting to be published under the authority\nof a court; and\n\n(b) the person does so:\n\n(i) without authority; or\n\n(ii) knowing the advertisement to be false in any material\nparticular; and\n\n(c) the advertisement purports to be published under the\nauthority of:\n\n(i) a federal court; or\n\n(ii) a court exercising federal jurisdiction; or\n\n(iii) a court of a Territory.\nPenalty: Imprisonment for 2 years.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "skos:definition": "(1) A person commits an offence if:\n\n(a) the person inserts in the Gazette, or in a newspaper, an\nadvertisement purporting to be published under the authority\nof a court; and\n\n(b) the person does so:\n\n(i) without authority; or\n\n(ii) knowing the advertisement to be false in any material\nparticular; and\n\n(c) the advertisement purports to be published under the\nauthority of:\n\n(i) a federal court; or\n\n(ii) a court exercising federal jurisdiction; or\n\n(iii) a court of a Territory.\nPenalty: Imprisonment for 2 years.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "cml:hasPart": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-45-ss-1"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-45-ss-2"
        }
      ],
      "cml:integrityHash": "5a026af76951648e24b31fb7b7353a6ed94a8ed9a36513676a040310e2cdeade"
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Inserting advertisements without authority of court",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person inserts in the Gazette, or in a newspaper, an\nadvertisement purporting to be published under the authority\nof a court; and\n\n(b) the person does so:\n\n(i) without authority; or\n\n(ii) knowing the advertisement to be false in any material\nparticular; and\n\n(c) the advertisement purports to be published under the\nauthority of:\n\n(i) a federal court; or\n\n(ii) a court exercising federal jurisdiction; or\n\n(iii) a court of a Territory.\nPenalty: Imprisonment for 2 years.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code."
    },
