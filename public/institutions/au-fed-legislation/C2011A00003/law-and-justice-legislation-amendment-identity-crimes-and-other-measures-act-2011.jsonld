          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-6-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7cf6e372994793ec687b3d0e561fb4963e60962e2600d6069cec0ca107b1cbe5",
      "skos:note": "Must be a barrister or solicitor on the specified rolls."
    },
