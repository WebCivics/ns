    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-3-sec-2011",
      "@type": "cml:Concept",
      "skos:prefLabel": "2011 No. 3, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-3-sec-2011"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.34",
      "values:originalText": "(g) subsections 6(2A), (2B) and (2C);\n\n(h) subsections 9(7), (8A) and (8B);\n\n(i) other provisions of this Act prescribed by the regulations for\nthe purposes of this paragraph.\n\n(1C) If a function is delegated under subsection (1B) to a person, the\nperson need not accept the function delegated.",
      "skos:definition": "(g) subsections 6(2A), (2B) and (2C);\n\n(h) subsections 9(7), (8A) and (8B);\n\n(i) other provisions of this Act prescribed by the regulations for\nthe purposes of this paragraph.\n\n(1C) If a function is delegated under subsection (1B) to a person, the\nperson need not accept the function delegated.",
      "cml:asserts": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-3-sec-2011-norm"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-3-sec-2011-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b96b4e50b6fcba839f3d8301a4c08c023ee28c2776e4585e50400e49bba3c155",
      "skos:note": "Delegation of function is not mandatory."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-3-sec-2011",
      "@type": "cof:Section",
      "cof:title": "2011 No. 3, 2011",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "(g) subsections 6(2A), (2B) and (2C);\n\n(h) subsections 9(7), (8A) and (8B);\n\n(i) other provisions of this Act prescribed by the regulations for\nthe purposes of this paragraph.\n\n(1C) If a function is delegated under subsection (1B) to a person, the\nperson need not accept the function delegated."
    },
