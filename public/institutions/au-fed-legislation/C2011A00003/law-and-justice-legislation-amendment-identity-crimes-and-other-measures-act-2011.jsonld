      },
      "cml:premiseText": "(b) the first person conveys a thing into a prison, lock-up or other place of criminal detention;",
      "cml:conclusionText": "Conveying a thing into a prison with the intention of facilitating escape is an offence."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-2011-6-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
