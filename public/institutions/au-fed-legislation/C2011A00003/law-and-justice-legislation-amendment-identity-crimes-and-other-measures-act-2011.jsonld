        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-375-4-ss-3"
        }
      ],
      "cml:integrityHash": "93cb386fde2718e716feb9f67151f81617a90f1652ea9415ba389eba2f2f0b34"
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-375-4",
      "@type": "cof:Section",
      "cof:title": "375 4  Power conferred on magistrate personally",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "(1) Power is conferred by this Division on a magistrate only in a\npersonal capacity and not as a court or a member of a court.\n\n(2) The magistrate need not accept the power conferred.\n\n(3) A magistrate exercising a power under this Division has the same\nprotection and immunity as if he or she were exercising that power\nas, or as a member of, the court of which the magistrate is a\nmember."
    },
