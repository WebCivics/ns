    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Section 183",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.30",
      "values:originalText": "Repeal the section, substitute:\n183  Aiding persons to escape etc.\n\nSections 46, 46A, 47A, 47C and 48 of the Crimes Act 1914 have\neffect as if:\n\n(a) arrest pursuant to this Act were arrest in respect of an offence\nagainst a law of the Commonwealth; and\n\n(b) custody while in Australia pursuant to this Act were custody\nin respect of an offence against a law of the Commonwealth.\nInternational Transfer of Prisoners Act 1997",
      "skos:definition": "Repeal the section, substitute:\n183  Aiding persons to escape etc.\n\nSections 46, 46A, 47A, 47C and 48 of the Crimes Act 1914 have\neffect as if:\n\n(a) arrest pursuant to this Act were arrest in respect of an offence\nagainst a law of the Commonwealth; and\n\n(b) custody while in Australia pursuant to this Act were custody\nin respect of an offence against a law of the Commonwealth.\nInternational Transfer of Prisoners Act 1997",
      "cml:asserts": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-23-norm"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "980eabb844ab9369d321d91f6607adbcaab22f8ed414feb3ea041af1fff0658d",
      "skos:note": "Repeal sections of the Crimes Act 1914 and substitute with new provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Section 183",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "Repeal the section, substitute:\n183  Aiding persons to escape etc.\n\nSections 46, 46A, 47A, 47C and 48 of the Crimes Act 1914 have\neffect as if:\n\n(a) arrest pursuant to this Act were arrest in respect of an offence\nagainst a law of the Commonwealth; and\n\n(b) custody while in Australia pursuant to this Act were custody\nin respect of an offence against a law of the Commonwealth.\nInternational Transfer of Prisoners Act 1997"
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-23-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
