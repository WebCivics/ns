    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-370",
      "@type": "cml:Concept",
      "skos:prefLabel": "370 1  Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-370"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.7",
      "values:originalText": "In this Code:\ndeal, in identification information, includes make, supply or use\nany such information.\nidentification documentation means any document or other thing\nthat:\n\n(a) contains or incorporates identification information; and\n\n(b) is capable of being used by a person for the purpose of\npretending to be, or passing the person off as, another person\n(whether living, dead, real or fictitious).\nidentification information means information, or a document,\nrelating to a person (whether living, dead, real or fictitious) that is\ncapable of being used (whether alone or in conjunction with other\ninformation or documents) to identify or purportedly identify the\nperson, including any of the following:\n\n(a) a name or address;\n\n(b) a date or place of birth, whether the person is married or has\na de facto partner, relatives’ identity or similar information;\n\n(c) a driver’s licence or driver’s licence number;\n\n(d) a passport or passport number;\n\n(e) biometric data;\nComLaw Authoritative Act C2011A00003\n\nSchedule 1  Identity crimes",
      "skos:definition": "In this Code:\ndeal, in identification information, includes make, supply or use\nany such information.\nidentification documentation means any document or other thing\nthat:\n\n(a) contains or incorporates identification information; and\n\n(b) is capable of being used by a person for the purpose of\npretending to be, or passing the person off as, another person\n(whether living, dead, real or fictitious).\nidentification information means information, or a document,\nrelating to a person (whether living, dead, real or fictitious) that is\ncapable of being used (whether alone or in conjunction with other\ninformation or documents) to identify or purportedly identify the\nperson, including any of the following:\n\n(a) a name or address;\n\n(b) a date or place of birth, whether the person is married or has\na de facto partner, relatives’ identity or similar information;\n\n(c) a driver’s licence or driver’s licence number;\n\n(d) a passport or passport number;\n\n(e) biometric data;\nComLaw Authoritative Act C2011A00003\n\nSchedule 1  Identity crimes",
      "cml:asserts": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-370-norm"
