        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the first person harbours, maintains or employs the escapee;",
      "cml:conclusionText": "The first person commits an offence if..."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-48-ss-1-logic-deontic-3",
