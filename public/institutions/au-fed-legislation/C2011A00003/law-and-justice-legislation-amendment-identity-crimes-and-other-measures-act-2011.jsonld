    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46",
      "@type": "cml:Concept",
      "skos:prefLabel": "46 Aiding prisoner to escape",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-46"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.25",
      "values:originalText": "(1) A person (the first person) commits an offence if:\n\n(a) another person (the prisoner) is in criminal detention; and\n\n(b) the first person aids the prisoner:\n\n(i) to escape from that detention; or\n\n(ii) to attempt to escape from that detention; and\n\n(c) the prisoner escapes, or attempts to escape, from that\ndetention; and\n\n(d) the detention is lawful federal criminal detention.\nComLaw Authoritative Act C2011A00003\n\nSchedule 2  Administration of justice offences",
      "skos:definition": "(1) A person (the first person) commits an offence if:\n\n(a) another person (the prisoner) is in criminal detention; and\n\n(b) the first person aids the prisoner:\n\n(i) to escape from that detention; or\n\n(ii) to attempt to escape from that detention; and\n\n(c) the prisoner escapes, or attempts to escape, from that\ndetention; and\n\n(d) the detention is lawful federal criminal detention.\nComLaw Authoritative Act C2011A00003\n\nSchedule 2  Administration of justice offences",
      "cml:asserts": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46-norm"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "da2902dca27682eb483833194250ca5ccbddf41c6586717c735506544436ca7a",
      "skos:note": "Aiding prisoner to escape is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-46",
      "@type": "cof:Section",
      "cof:title": "46 Aiding prisoner to escape",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "(1) A person (the first person) commits an offence if:\n\n(a) another person (the prisoner) is in criminal detention; and\n\n(b) the first person aids the prisoner:\n\n(i) to escape from that detention; or\n\n(ii) to attempt to escape from that detention; and\n\n(c) the prisoner escapes, or attempts to escape, from that\ndetention; and\n\n(d) the detention is lawful federal criminal detention.\nComLaw Authoritative Act C2011A00003\n\nSchedule 2  Administration of justice offences"
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-46-norm",
