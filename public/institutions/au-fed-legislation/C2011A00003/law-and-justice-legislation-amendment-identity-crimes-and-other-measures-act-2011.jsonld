      "@type": "cml:Concept",
      "skos:prefLabel": "372 3  Possession of equipment used to make identification",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-372-3"
