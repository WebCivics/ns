    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-375-4-ss-3",
      "@type": "cof:Section",
      "cof:title": "375(3) 4  Power conferred on magistrate personally",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(3) A magistrate exercising a power under this Division has the same\nprotection and immunity as if he or she were exercising that power\nas, or as a member of, the court of which the magistrate is a\nmember."
    },
