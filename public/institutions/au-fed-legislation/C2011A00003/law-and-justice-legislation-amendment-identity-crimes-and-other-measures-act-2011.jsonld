    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the use of listed documents for identity verification.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act prohibits the use of listed documents for identity verification purposes.",
      "cml:conclusionText": "No listed document may be used for identity verification."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classify",
      "cml:logicSummary": "Classifies personal identification documents as prohibited for identity verification purposes.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act classifies the following documents as prohibited for identity verification: (f) a voice print; (g) a credit or debit card, its number, or data stored or encrypted on it; (h) a financial account number, user name or password; (i) a digital signature; (j) a series of numbers or letters (or both) intended for use as a means of personal identification; (k) an ABN.",
      "cml:conclusionText": "The listed documents are prohibited for identity verification purposes."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Prohibition",
      "cml:logicSummary": "Prohibits the use of listed documents during a specific time period.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act prohibits the use of listed documents from January 1, 2012 to December 31, 2015.",
      "cml:conclusionText": "No listed document may be used for identity verification between January 1, 2012 and December 31, 2015."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Temporal Prohibition",
      "cml:logicSummary": "Prohibits the use of listed documents during a specific time period.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act prohibits the use of listed documents from January 1, 2012 to December 31, 2015.",
      "cml:conclusionText": "No listed document may be used for identity verification between January 1, 2012 and December 31, 2015."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Prohibition Diffusion",
      "cml:logicSummary": "Diffuses the prohibition of using listed documents for identity verification purposes.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act diffuses the prohibition of using listed documents for identity verification purposes to all relevant authorities.",
      "cml:conclusionText": "All relevant authorities must not use listed documents for identity verification purposes."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Prohibition Cognition",
      "cml:logicSummary": "Cognizes the prohibition of using listed documents for identity verification purposes.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act cognizes the prohibition of using listed documents for identity verification purposes and requires all relevant authorities to be aware of it.",
      "cml:conclusionText": "All relevant authorities must be aware of the prohibition of using listed documents for identity verification purposes."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372",
      "@type": "cml:Concept",
      "skos:prefLabel": "372 1  Dealing in identification information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-372"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.8",
      "values:originalText": "(1) A person (the first person) commits an offence if:\n\n(a) the first person deals in identification information; and\n\n(b) the first person intends that any person (the user) (whether or\nnot the first person) will use the identification information to\npretend to be, or to pass the user off as, another person\n(whether living, dead, real or fictitious) for the purpose of:\n\n(i) committing an offence; or\n\n(ii) facilitating the commission of an offence; and\n\n(c) the offence referred to in paragraph (b) is an indictable\noffence against a law of the Commonwealth.\nPenalty: Imprisonment for 5 years.\nNote:\nDeal, in identification information, includes make, supply or use any\nsuch information. See section 370.1.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2.\n\n(3) This section applies:\n\n(a) even if:\n\n(i) committing the offence referred to in paragraph (1)(b) is\nimpossible; or\n\n(ii) the offence referred to in paragraph (1)(b) is to be\ncommitted at a later time; and\nComLaw Authoritative Act C2011A00003\n\nIdentity crimes  Schedule 1\nMain amendments  Part 1\n\nLaw and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011       No.\n3, 2011            5\n\n(b) whether or not the person to whom the identification\ninformation concerned relates consented to the dealing in the\nidentification information.\n\n(4) This section does not apply to dealing in the first person’s own\nidentification information.",
      "skos:definition": "(1) A person (the first person) commits an offence if:\n\n(a) the first person deals in identification information; and\n\n(b) the first person intends that any person (the user) (whether or\nnot the first person) will use the identification information to\npretend to be, or to pass the user off as, another person\n(whether living, dead, real or fictitious) for the purpose of:\n\n(i) committing an offence; or\n\n(ii) facilitating the commission of an offence; and\n\n(c) the offence referred to in paragraph (b) is an indictable\noffence against a law of the Commonwealth.\nPenalty: Imprisonment for 5 years.\nNote:\nDeal, in identification information, includes make, supply or use any\nsuch information. See section 370.1.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2.\n\n(3) This section applies:\n\n(a) even if:\n\n(i) committing the offence referred to in paragraph (1)(b) is\nimpossible; or\n\n(ii) the offence referred to in paragraph (1)(b) is to be\ncommitted at a later time; and\nComLaw Authoritative Act C2011A00003\n\nIdentity crimes  Schedule 1\nMain amendments  Part 1\n\nLaw and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011       No.\n3, 2011            5\n\n(b) whether or not the person to whom the identification\ninformation concerned relates consented to the dealing in the\nidentification information.\n\n(4) This section does not apply to dealing in the first person’s own\nidentification information.",
      "cml:hasPart": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-1"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-2"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-3"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-4"
        }
      ],
      "cml:integrityHash": "18f6b587928093f0dc25d32910dcdcd9476757c7261434eb562621161ff3e95c"
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-372",
      "@type": "cof:Section",
      "cof:title": "372 1  Dealing in identification information",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "(1) A person (the first person) commits an offence if:\n\n(a) the first person deals in identification information; and\n\n(b) the first person intends that any person (the user) (whether or\nnot the first person) will use the identification information to\npretend to be, or to pass the user off as, another person\n(whether living, dead, real or fictitious) for the purpose of:\n\n(i) committing an offence; or\n\n(ii) facilitating the commission of an offence; and\n\n(c) the offence referred to in paragraph (b) is an indictable\noffence against a law of the Commonwealth.\nPenalty: Imprisonment for 5 years.\nNote:\nDeal, in identification information, includes make, supply or use any\nsuch information. See section 370.1.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2.\n\n(3) This section applies:\n\n(a) even if:\n\n(i) committing the offence referred to in paragraph (1)(b) is\nimpossible; or\n\n(ii) the offence referred to in paragraph (1)(b) is to be\ncommitted at a later time; and\nComLaw Authoritative Act C2011A00003\n\nIdentity crimes  Schedule 1\nMain amendments  Part 1\n\nLaw and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011       No.\n3, 2011            5\n\n(b) whether or not the person to whom the identification\ninformation concerned relates consented to the dealing in the\nidentification information.\n\n(4) This section does not apply to dealing in the first person’s own\nidentification information."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-ss-1",
