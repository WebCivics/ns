    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-375-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "375 4  Power conferred on magistrate personally",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-375-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.12",
      "values:originalText": "(1) Power is conferred by this Division on a magistrate only in a\npersonal capacity and not as a court or a member of a court.\n\n(2) The magistrate need not accept the power conferred.\n\n(3) A magistrate exercising a power under this Division has the same\nprotection and immunity as if he or she were exercising that power\nas, or as a member of, the court of which the magistrate is a\nmember.",
      "skos:definition": "(1) Power is conferred by this Division on a magistrate only in a\npersonal capacity and not as a court or a member of a court.\n\n(2) The magistrate need not accept the power conferred.\n\n(3) A magistrate exercising a power under this Division has the same\nprotection and immunity as if he or she were exercising that power\nas, or as a member of, the court of which the magistrate is a\nmember.",
      "cml:hasPart": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-375-4-ss-1"
