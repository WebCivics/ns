      ],
      "cml:integrityHash": "5380b9f3129c90cdc6d3473986b806fb116c91b9b8c8d999572f95b2f4a8eb49",
      "skos:note": "Judge or magistrate acting oppressively or when interested"
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-34-ss-1",
      "@type": "cof:Section",
      "cof:title": "34(1) Judge or magistrate acting oppressively or when interested",
      "values:kind": "subsection",
      "cof:pageNumber": 16,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person is a judge or magistrate; and\n\n(b) the judge or magistrate is required or authorised by law to\nadmit a person accused of an offence to bail; and\nComLaw Authoritative Act C2011A00003\n\nAdministration of justice offences  Schedule 2\nAmendment of the Crimes Act 1914  Part 1\n\nLaw and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011       No.\n3, 2011            13\n\n(c) the judge or magistrate requires excessive and unreasonable\nbail; and\n\n(d) the requirement is an abuse of the judge’s or magistrate’s\noffice; and\n\n(e) the offence referred to in paragraph (b) is an offence against a\nlaw of the Commonwealth.\nPenalty: Imprisonment for 2 years."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-34-ss-1-norm",
      "@type": "values:Prohibition",
