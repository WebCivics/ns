    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "372 2  Possession of identification information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-372-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.9",
      "values:originalText": "(1) A person (the first person) commits an offence if:\n\n(a) the first person possesses identification information; and\n\n(b) the first person intends that any person (whether or not the\nfirst person) will use the identification information to engage\nin conduct; and\n\n(c) the conduct referred to in paragraph (b) constitutes an offence\nagainst section 372.1.\nPenalty: Imprisonment for 3 years.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2.\n\n(3) This section applies whether or not the person to whom the\nidentification information concerned relates consented to the\npossession of the identification information.\n\n(4) This section does not apply to the possession of the first person’s\nown identification information.",
      "skos:definition": "(1) A person (the first person) commits an offence if:\n\n(a) the first person possesses identification information; and\n\n(b) the first person intends that any person (whether or not the\nfirst person) will use the identification information to engage\nin conduct; and\n\n(c) the conduct referred to in paragraph (b) constitutes an offence\nagainst section 372.1.\nPenalty: Imprisonment for 3 years.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2.\n\n(3) This section applies whether or not the person to whom the\nidentification information concerned relates consented to the\npossession of the identification information.\n\n(4) This section does not apply to the possession of the first person’s\nown identification information.",
      "cml:hasPart": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-2-ss-1"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-2-ss-2"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-2-ss-3"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-2-ss-4"
        }
      ],
      "cml:integrityHash": "67df11c8413d97ac0f884a970a2c085d707b4b2d2b9f4d6417571d2f45fa5277"
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-372-2",
      "@type": "cof:Section",
      "cof:title": "372 2  Possession of identification information",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "(1) A person (the first person) commits an offence if:\n\n(a) the first person possesses identification information; and\n\n(b) the first person intends that any person (whether or not the\nfirst person) will use the identification information to engage\nin conduct; and\n\n(c) the conduct referred to in paragraph (b) constitutes an offence\nagainst section 372.1.\nPenalty: Imprisonment for 3 years.\n\n(2) Absolute liability applies to the paragraph (1)(c) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2.\n\n(3) This section applies whether or not the person to whom the\nidentification information concerned relates consented to the\npossession of the identification information.\n\n(4) This section does not apply to the possession of the first person’s\nown identification information."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-372-2-ss-1",
