        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-49-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9e0eaa2e56704c3fb28e6f309dc81605cf329beb967a3d74a1436f956f0860a5",
      "skos:note": "Receiving, removing, retaining, concealing or disposing of property attached under court process with intention to hinder or defeat attachment is an offence."
    },
