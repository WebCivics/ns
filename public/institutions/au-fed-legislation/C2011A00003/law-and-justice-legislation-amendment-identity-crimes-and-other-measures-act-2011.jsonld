    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-5-sec-2011",
      "@type": "cml:Concept",
      "skos:prefLabel": "2011 No. 3, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-5-sec-2011"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.40",
      "values:originalText": "(1A) If the Commissioner is satisfied that a person (other than an AFP\nappointee) has, by his or her bravery, or other conspicuous\nconduct, in assisting the Australian Federal Police, merited a\nprescribed award, the Commissioner may confer the award on that\nperson.",
      "skos:definition": "(1A) If the Commissioner is satisfied that a person (other than an AFP\nappointee) has, by his or her bravery, or other conspicuous\nconduct, in assisting the Australian Federal Police, merited a\nprescribed award, the Commissioner may confer the award on that\nperson.",
      "cml:asserts": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-5-sec-2011-norm"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-5-sec-2011-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "02e2a38c321a9f3d7664236274d7615ad55b34236ec8daf773fa3535e4a52ebe",
      "skos:note": "Award conferred on person for bravery or conspicuous conduct."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-5-sec-2011",
      "@type": "cof:Section",
      "cof:title": "2011 No. 3, 2011",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "(1A) If the Commissioner is satisfied that a person (other than an AFP\nappointee) has, by his or her bravery, or other conspicuous\nconduct, in assisting the Australian Federal Police, merited a\nprescribed award, the Commissioner may confer the award on that\nperson."
    },
