    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 Corruption of witnesses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-37"
