      "cml:integrityHash": "86a72bfa637ef53568796d2301727bae90d11508ec19965ec5a5d82385617daa",
      "skos:note": "Leaving prison without permission is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-47b-ss-1",
