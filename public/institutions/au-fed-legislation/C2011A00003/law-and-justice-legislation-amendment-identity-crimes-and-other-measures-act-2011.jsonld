    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Subsections 43(1) and (2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-15"
      },
      "cml:curationStatus": {
