      "@type": "cml:Concept",
      "skos:prefLabel": "372(3) 1  Dealing in identification information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-372-ss-3"
