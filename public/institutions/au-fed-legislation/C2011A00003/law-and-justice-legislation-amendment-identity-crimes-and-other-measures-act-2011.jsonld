      "cml:integrityHash": "8d46ba5d4c4e8758b2f7327bdf88adf3e58a570f700785706d35c614afbd6a51",
      "skos:note": "Defendant bears evidential burden in relation to a reasonable excuse."
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-34-ss-2",
      "@type": "cof:Section",
      "cof:title": "34(2) Judge or magistrate acting oppressively or when interested",
      "values:kind": "subsection",
      "cof:pageNumber": 16,
      "values:originalText": "(2) Subsection (1) does not apply if the judge or magistrate has a\nreasonable excuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code)."
    },
