    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-47b",
      "@type": "cml:Concept",
      "skos:prefLabel": "47B Person unlawfully at large",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-47b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.27",
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person was in criminal detention in a prison, lock-up or\nother place of criminal detention; and\n\n(b) the detention was lawful federal criminal detention; and\n\n(c) in accordance with a permission given under a law of a State\nor Territory (other than the Australian Capital Territory), the\nperson leaves the prison, lock-up or other place; and\n\n(d) the person refuses, or fails, to return to the prison, lock-up or\nother place in accordance with that permission.\nPenalty: Imprisonment for 5 years.\n\n(2) Absolute liability applies to the paragraph (1)(b) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.\n\n(3) Paragraph (1)(d) does not apply if the person has a reasonable\nexcuse.\nComLaw Authoritative Act C2011A00003\n\nSchedule 2  Administration of justice offences",
      "skos:definition": "(1) A person commits an offence if:\n\n(a) the person was in criminal detention in a prison, lock-up or\nother place of criminal detention; and\n\n(b) the detention was lawful federal criminal detention; and\n\n(c) in accordance with a permission given under a law of a State\nor Territory (other than the Australian Capital Territory), the\nperson leaves the prison, lock-up or other place; and\n\n(d) the person refuses, or fails, to return to the prison, lock-up or\nother place in accordance with that permission.\nPenalty: Imprisonment for 5 years.\n\n(2) Absolute liability applies to the paragraph (1)(b) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.\n\n(3) Paragraph (1)(d) does not apply if the person has a reasonable\nexcuse.\nComLaw Authoritative Act C2011A00003\n\nSchedule 2  Administration of justice offences",
      "cml:hasPart": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-47b-ss-1"
        },
