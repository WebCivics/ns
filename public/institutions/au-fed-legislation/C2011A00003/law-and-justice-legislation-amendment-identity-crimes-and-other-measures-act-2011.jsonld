    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-14-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Subsections 42(1) and (2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-14-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.22",
      "values:originalText": "Repeal the subsections, substitute:\n\n(1) A person commits an offence if:\nComLaw Authoritative Act C2011A00003\n\nAdministration of justice offences  Schedule 2\nAmendment of the Crimes Act 1914  Part 1\n\nLaw and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011       No.\n3, 2011            19\n\n(a) the person conspires with another person to obstruct, to\nprevent, to pervert or to defeat the course of justice in\nrelation to a judicial power; and\n\n(b) the judicial power is the judicial power of the\nCommonwealth.\nPenalty: Imprisonment for 10 years.\n\n(2) Absolute liability applies to the paragraph (1)(b) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "skos:definition": "Repeal the subsections, substitute:\n\n(1) A person commits an offence if:\nComLaw Authoritative Act C2011A00003\n\nAdministration of justice offences  Schedule 2\nAmendment of the Crimes Act 1914  Part 1\n\nLaw and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011       No.\n3, 2011            19\n\n(a) the person conspires with another person to obstruct, to\nprevent, to pervert or to defeat the course of justice in\nrelation to a judicial power; and\n\n(b) the judicial power is the judicial power of the\nCommonwealth.\nPenalty: Imprisonment for 10 years.\n\n(2) Absolute liability applies to the paragraph (1)(b) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code.",
      "cml:hasPart": [
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-14-2-ss-1"
        },
        {
          "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-2-sec-14-2-ss-2"
        }
      ],
      "cml:integrityHash": "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d"
    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-2-sec-14-2",
      "@type": "cof:Section",
      "cof:title": "14 Subsections 42(1) and (2)",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "Repeal the subsections, substitute:\n\n(1) A person commits an offence if:\nComLaw Authoritative Act C2011A00003\n\nAdministration of justice offences  Schedule 2\nAmendment of the Crimes Act 1914  Part 1\n\nLaw and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011       No.\n3, 2011            19\n\n(a) the person conspires with another person to obstruct, to\nprevent, to pervert or to defeat the course of justice in\nrelation to a judicial power; and\n\n(b) the judicial power is the judicial power of the\nCommonwealth.\nPenalty: Imprisonment for 10 years.\n\n(2) Absolute liability applies to the paragraph (1)(b) element of the\noffence.\nNote:\nFor absolute liability, see section 6.2 of the Criminal Code."
    },
