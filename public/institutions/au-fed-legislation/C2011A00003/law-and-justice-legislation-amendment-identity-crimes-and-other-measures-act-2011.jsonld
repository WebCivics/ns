    },
    {
      "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Law and Justice Legislation Amendment (Identity Crimes and Other Measures) Act 2011",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "No. 3, 2011\n\n(f) a voice print;\n\n(g) a credit or debit card, its number, or data stored or encrypted\non it;\n\n(h) a financial account number, user name or password;\n\n(i) a digital signature;\n\n(j) a series of numbers or letters (or both) intended for use as a\nmeans of personal identification;\n\n(k) an ABN."
    },
    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-1-sec-4-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
