    {
      "@id": "concept:law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011-sch-4-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 After subsection 130(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011#sch-4-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf"
      },
      "dc:source": "law-and-justice-legislation-amendment-identity-crimes-and-other-measures-act-2011.pdf, p.36",
      "values:originalText": "Insert:\n\n(3A) Paragraph (3)(a) does not apply to AUSTRAC information that:\n\n(a) was obtained under section 41; or\n\n(b) was obtained under section 49, in so far as that section relates\nto a communication under section 41; or\n\n(c) was obtained under section 16 of the Financial Transaction\nReports Act 1988.",
