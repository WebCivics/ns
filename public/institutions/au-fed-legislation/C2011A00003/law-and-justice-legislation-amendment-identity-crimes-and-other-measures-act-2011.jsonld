      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the first person does so with the intention of facilitating the escape of the prisoner from the prison, lock-up or other place;",
      "cml:conclusionText": "Conveying a thing into a prison with the intention of facilitating escape is an offence."
    },
    {
