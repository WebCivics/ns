    cml:modality cml:LTL ;
    cml:operator "has an ordered trace" ;
    cml:logicSummary "The text mentions specific factors that must be considered in a particular order, such as the relative strengths of the bargaining positions." ;
    cml:premiseText "(a) the relative strengths of the bargaining positions of the supplier and the service recipient; and" ;
    cml:conclusionText "...the extent to which the supplier unreasonably failed to disclose to the service recipient:  (i) any intended conduct of the supplier that might affect the interests of the service recipient;" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:competition-and-consumer-legislation-amendment-act-2011-sch-2-sec-12cc-ss-1 cml:asserts concept:competition-and-consumer-legislation-amendment-act-2011-sch-2-sec-12cc-ss-1-logic-deontic-4 .
