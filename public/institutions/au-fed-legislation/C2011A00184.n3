    cml:modality cml:AllenInterval ;
    cml:operator "has a temporal relation" ;
    cml:logicSummary "The text mentions specific time-related factors, such as the amount for which the service recipient could have acquired identical or equivalent financial services." ;
    cml:premiseText "(e) the amount for which, and the circumstances under which, the service recipient could have acquired identical or ComLaw Authoritative Act C2011A00184  Unconscionable conduct  Schedule 2  equivalent financial services from a person other than the" ;
    cml:conclusionText "...the extent to which the supplier’s conduct towards the service recipient was consistent with the supplier’s conduct in similar transactions between the supplier and other like service recipients;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

