    cml:modality cml:Deontic ;
    cml:operator "may have regard to" ;
    cml:logicSummary "Court may consider various factors when determining whether a person has contravened section 12CB." ;
    cml:premiseText "(1) Without limiting the matters to which the court may have regard for the purpose of determining..." ;
    cml:conclusionText "...the court may have regard to:  (a) the relative strengths of the bargaining positions of the supplier and the service recipient; and" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
