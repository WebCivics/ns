    {
      "@id": "concept:competition-and-consumer-legislation-amendment-act-2011-sch-2-sec-12cc-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "12CC(2) Matters the court may have regard to for the purposes of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-legislation-amendment-act-2011#sch-2-sec-12cc-ss-2"
      },
