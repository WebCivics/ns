          "@id": "concept:competition-and-consumer-legislation-amendment-act-2011-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "eba1e169ac2eed3777d1281ec8399a0382ab141f29a8a8cb1202fd8fa45476bb",
      "skos:note": "Schedules apply to Acts"
    },
