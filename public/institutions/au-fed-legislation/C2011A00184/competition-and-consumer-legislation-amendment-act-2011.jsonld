      "@id": "concept:competition-and-consumer-legislation-amendment-act-2011-sec-2-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-legislation-amendment-act-2011#sec-2-2"
