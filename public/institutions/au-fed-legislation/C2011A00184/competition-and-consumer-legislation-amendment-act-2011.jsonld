      "@id": "https://ns.webcivics.net/values/competition-and-consumer-legislation-amendment-act-2011#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Sections 12CB and 12CC",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Repeal the sections, substitute:"
    },
    {
      "@id": "concept:competition-and-consumer-legislation-amendment-act-2011-sch-2-sec-1-norm",
