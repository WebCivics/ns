    {
      "@id": "concept:competition-and-consumer-legislation-amendment-act-2011-sch-2-sec-21-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "21(3) Unconscionable conduct in connection with goods or services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-legislation-amendment-act-2011#sch-2-sec-21-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-legislation-amendment-act-2011.pdf"
      },
      "dc:source": "competition-and-consumer-legislation-amendment-act-2011.pdf, p.14",
      "values:originalText": "(3) For the purpose of determining whether a person has contravened\nsubsection (1):\n\n(a) the court must not have regard to any circumstances that\nwere not reasonably foreseeable at the time of the alleged\ncontravention; and\n\n(b) the court may have regard to conduct engaged in, or\ncircumstances existing, before the commencement of this\nsection.",
      "skos:definition": "(3) For the purpose of determining whether a person has contravened\nsubsection (1):\n\n(a) the court must not have regard to any circumstances that\nwere not reasonably foreseeable at the time of the alleged\ncontravention; and\n\n(b) the court may have regard to conduct engaged in, or\ncircumstances existing, before the commencement of this\nsection.",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-legislation-amendment-act-2011-sch-2-sec-21"
      },
      "cml:asserts": [
        {
