      "dc:source": "competition-and-consumer-legislation-amendment-act-2011.pdf, p.6",
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 2 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period.",
      "skos:definition": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 2 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-legislation-amendment-act-2011-sec-2-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-legislation-amendment-act-2011-sec-2-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "04a163be2e457c5828a6ac0b11f5931cf65a174d0d1b383f244f1f7efc817212",
      "skos:note": "Conditional commencement of provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-legislation-amendment-act-2011#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 2 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period."
    },
