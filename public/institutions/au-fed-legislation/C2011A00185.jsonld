    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-1",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-amendment-act.pdf, p.14",
      "skos:note": "Disclosure of information by a corporation to a person is permitted if the information relates to goods or services supplied or likely to be supplied, or acquired or likely to be acquired.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "10(1) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011"
      },
      "wasDerivedFrom": "competition-and-consumer-amendment-act.pdf",
      "asserts": [
        "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-1-norm",
        "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-1-logic-deontic-1",
        "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-1-logic-alleninterval-2"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "3053c30fdae265e32e0bc672940bca655c8d4da90a6f670909101a62b67b55e2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
