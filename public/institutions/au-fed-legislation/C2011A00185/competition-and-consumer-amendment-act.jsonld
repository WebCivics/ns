    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(1) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-16-2-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-act.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-act.pdf, p.20",
      "values:originalText": "(1) A disclosure of information by a person is a private disclosure to\ncompetitors, in relation to a particular market, if the disclosure is to\none or more competitors or potential competitors of the person in\nthat market, and is not to any other person.\nNote:\nThe effect of section 44ZZU must be taken into account in working\nout whether the disclosure is to one or more competitors or potential\ncompetitors, and is not to any other person.\nAnti-avoidance",
      "skos:definition": "(1) A disclosure of information by a person is a private disclosure to\ncompetitors, in relation to a particular market, if the disclosure is to\none or more competitors or potential competitors of the person in\nthat market, and is not to any other person.\nNote:\nThe effect of section 44ZZU must be taken into account in working\nout whether the disclosure is to one or more competitors or potential\ncompetitors, and is not to any other person.\nAnti-avoidance",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1-logic-deontic-2"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1-logic-deontic-3"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1-logic-deontic-4"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-1-logic-alleninterval-5"
        }
      ],
      "cml:integrityHash": "7ec4877d3adb37097aa132c78df83580c43e1f32ababd5f7365a8574ad20f17e",
      "skos:note": "Disclosure of information to a person's agent is taken to have been made by the discloser to that person. Disclosure of information to competitors or potential competitors is private."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-16-2-ss-1",
