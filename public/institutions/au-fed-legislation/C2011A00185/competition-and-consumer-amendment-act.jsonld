        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-6-2-ss-5d-logic-diffusion-4"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-6-2-ss-5d-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "2e62afb378ad5174a1222337eb02f097f6c3904da3a592051a2a862dcd4bdf2c",
      "skos:note": "Commission cannot make a determination granting an authorization under subsection 88(6A) unless certain conditions are met."
    },
