    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-8-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "8(1) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-8-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-act.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-act.pdf, p.12",
      "values:originalText": "(1) Sections 44ZZW and 44ZZX do not apply to the disclosure of\ninformation by a corporation if:\n\n(a) the disclosure is authorised by or under a law of the\nCommonwealth, a State or a Territory; and\n\n(b) the disclosure occurs before the end of 10 years after the day\non which the Competition and Consumer Amendment Act\n(No. 1) 2011 receives the Royal Assent.\nNote:\nThis subsection has effect in addition to:\n(a) subsection (6) (which covers compliance with continuous\ndisclosure requirements of the Corporations Act 2001); and\n(b) subsection 51(1) (which covers things authorised by certain\nlaws).\nDisclosure to related bodies corporate",
      "skos:definition": "(1) Sections 44ZZW and 44ZZX do not apply to the disclosure of\ninformation by a corporation if:\n\n(a) the disclosure is authorised by or under a law of the\nCommonwealth, a State or a Territory; and\n\n(b) the disclosure occurs before the end of 10 years after the day\non which the Competition and Consumer Amendment Act\n(No. 1) 2011 receives the Royal Assent.\nNote:\nThis subsection has effect in addition to:\n(a) subsection (6) (which covers compliance with continuous\ndisclosure requirements of the Corporations Act 2001); and\n(b) subsection 51(1) (which covers things authorised by certain\nlaws).\nDisclosure to related bodies corporate",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-8"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-8-ss-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-8-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5e8b965f0672639f46e7415880c00e9ddd34137fcf344e4abfeac0dbc7d97289",
      "skos:note": "Disclosure of information by a corporation is permitted if authorized by law."
    },
