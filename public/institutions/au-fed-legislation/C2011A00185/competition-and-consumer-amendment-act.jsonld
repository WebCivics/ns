      }
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-22-ss-3b",
      "@type": "cml:Concept",
      "skos:prefLabel": "22(3B) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-22-ss-3b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-act.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-act.pdf, p.26",
      "values:originalText": "(3B) Section 44ZZW does not apply to the disclosure of information by\na person to another person if:\n\n(a) one of the persons is a credit provider, and the other person\nprovides a credit service, within the meaning of the National\nConsumer Credit Protection Act 2009; and\n\n(b) the disclosure is made in the course of the relationship\nbetween the persons in their capacities as credit provider and\nprovider of a credit service.\nDisclosure relating to acquisition of shares or assets",
      "skos:definition": "(3B) Section 44ZZW does not apply to the disclosure of information by\na person to another person if:\n\n(a) one of the persons is a credit provider, and the other person\nprovides a credit service, within the meaning of the National\nConsumer Credit Protection Act 2009; and\n\n(b) the disclosure is made in the course of the relationship\nbetween the persons in their capacities as credit provider and\nprovider of a credit service.\nDisclosure relating to acquisition of shares or assets",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-22"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-22-ss-3b-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-22-ss-3b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0c7d0b9e9881809308b00fef5d68dfe9e7da546e6769b34b95fdfd55c0836f31",
      "skos:note": "Disclosure of information by a credit provider to another person providing a credit service is permitted."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-22-ss-3b",
      "@type": "cof:Section",
