      "cml:conclusionText": "(d) the disclosure of the information to the recipients is taken to have been made by the corporation;"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-4-ss-3-logic-ltl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "during",
      "cml:logicSummary": "The disclosure of information occurs during the intermediary's action.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a corporation makes a disclosure of information to a person (the intermediary); and (b) the corporation makes the disclosure to the intermediary for the purpose of the intermediary disclosing (or arranging for the disclosure of) the information to one or more other persons; and (c) the information is so disclosed to one or more of those other persons (the recipients);",
      "cml:conclusionText": "(d) the disclosure of the information to the recipients is taken to have been made by the corporation;"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-4-ss-3-logic-diffusion-6",
