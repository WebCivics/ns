      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-8-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "8(5) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-8-ss-5"
      },
      "cml:curationStatus": {
