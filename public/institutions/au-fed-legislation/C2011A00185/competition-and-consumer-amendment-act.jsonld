    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-5-ss-6c",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(6C) After subsection 88(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-5-ss-6c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-act.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-act.pdf, p.17",
      "values:originalText": "(6C) An application made to the Commission under subsection (6A) for\nan authorisation in relation to a particular disclosure of information\nmay be expressed to be made also in relation to one or more other\nsimilar disclosures of information. If an application is so\nexpressed, the Commission may grant a single authorisation in\nrespect of all the disclosures or may grant separate authorisations\nin respect of any one or more of the disclosures.\nComLaw Authoritative Act C2011A00185\n\nSchedule 1  Amendments",
      "skos:definition": "(6C) An application made to the Commission under subsection (6A) for\nan authorisation in relation to a particular disclosure of information\nmay be expressed to be made also in relation to one or more other\nsimilar disclosures of information. If an application is so\nexpressed, the Commission may grant a single authorisation in\nrespect of all the disclosures or may grant separate authorisations\nin respect of any one or more of the disclosures.\nComLaw Authoritative Act C2011A00185\n\nSchedule 1  Amendments",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-5"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-5-ss-6c-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-5-ss-6c-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-5-ss-6c-logic-linearlogic-2"
        }
      ],
      "cml:integrityHash": "8e76a21e673dbc34fa58c04ad3508c6d94a616f62da6df41fd471cf6bb5bd0b6",
      "skos:note": "Commission may grant a single authorisation in respect of all the disclosures or separate authorisations for any one or more of the disclosures."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-5-ss-6c",
      "@type": "cof:Section",
      "cof:title": "5(6C) After subsection 88(6)",
      "values:kind": "subsection",
      "cof:pageNumber": 17,
      "values:originalText": "(6C) An application made to the Commission under subsection (6A) for\nan authorisation in relation to a particular disclosure of information\nmay be expressed to be made also in relation to one or more other\nsimilar disclosures of information. If an application is so\nexpressed, the Commission may grant a single authorisation in\nrespect of all the disclosures or may grant separate authorisations\nin respect of any one or more of the disclosures.\nComLaw Authoritative Act C2011A00185\n\nSchedule 1  Amendments"
    },
