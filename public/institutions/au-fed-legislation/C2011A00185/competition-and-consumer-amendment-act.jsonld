    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-20-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "20(5) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-20-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-act.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-act.pdf, p.24",
      "values:originalText": "(5) Sections 44ZZW and 44ZZX do not apply to the disclosure of\ninformation by a person if:\n\n(a) the person has given the Commission a notice under\nsubsection 93(1) describing conduct; and\n\n(b) the disclosure is conduct described in the notice; and\n\n(c) the notice is in force under section 93.\nCompliance with continuous disclosure requirements of the\nCorporations Act 2001",
      "skos:definition": "(5) Sections 44ZZW and 44ZZX do not apply to the disclosure of\ninformation by a person if:\n\n(a) the person has given the Commission a notice under\nsubsection 93(1) describing conduct; and\n\n(b) the disclosure is conduct described in the notice; and\n\n(c) the notice is in force under section 93.\nCompliance with continuous disclosure requirements of the\nCorporations Act 2001",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-20"
      },
