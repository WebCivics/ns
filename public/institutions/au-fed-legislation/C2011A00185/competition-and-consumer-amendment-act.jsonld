        }
      ],
      "cml:integrityHash": "2da9f7cc66e290da00fb1be38bae41b447f5900dbf0d6f848f30250d0155cd7a",
      "skos:note": "Disclosure of information by a person is permitted if certain conditions are met."
    },
    {
