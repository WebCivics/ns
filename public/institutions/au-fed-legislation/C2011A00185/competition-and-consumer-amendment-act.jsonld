          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6"
        }
      ],
      "cml:integrityHash": "3ebc6dce4a1d1b1e4e8030ac315a05a75c0497e59bd4f993fde3053d78c986e1"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-24",
