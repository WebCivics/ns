      ],
      "cml:integrityHash": "50e5696f09d15f6ef971bf4b8d8cff423b2ffda6b09fb762155fe2e9927a7205",
      "skos:note": "Disclosure of information by a corporation to a person is disregarded if due to an accident, default of another person, or some other cause beyond the control of the corporation. Exemption for first regulations made under subsection (1)"
    },
