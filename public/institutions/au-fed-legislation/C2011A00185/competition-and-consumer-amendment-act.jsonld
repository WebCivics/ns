          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-12-ss-6-logic-deontic-3"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-12-ss-6-logic-deontic-4"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-12-ss-6-logic-deontic-5"
        },
