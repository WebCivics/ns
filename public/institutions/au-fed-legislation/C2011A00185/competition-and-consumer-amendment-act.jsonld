    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
