      "cml:conclusionText": "Disclosure disregarded"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
