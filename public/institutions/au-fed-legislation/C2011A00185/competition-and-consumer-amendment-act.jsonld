          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-8-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3634672a89f7fafbdcf83bf2ec92afa2396cfc952dc77a7dd216b1c4af0d5578",
      "skos:note": "Disclosure of information to related bodies corporate is permitted."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-8-ss-2",
      "@type": "cof:Section",
      "cof:title": "8(2) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "values:kind": "subsection",
