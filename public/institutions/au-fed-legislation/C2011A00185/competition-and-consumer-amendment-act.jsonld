          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-3b"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-4"
        }
      ],
      "cml:integrityHash": "a306cec66ad3178cf90e313460d2ef8246b676c3bb5e4b75d4637f4045592dbc"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-10",
      "@type": "cof:Section",
