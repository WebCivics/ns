    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-16-2-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(2) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-16-2-ss-2"
