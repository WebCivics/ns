          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-20-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5b43ac71905ce94155554690bf231f2246e3498335727bba744d3aa3133f8588",
      "skos:note": "Disclosure of information is permitted under certain conditions."
    },
    {
