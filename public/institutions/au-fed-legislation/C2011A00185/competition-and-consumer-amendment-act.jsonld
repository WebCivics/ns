    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-20-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "20(6) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-20-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-act.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-act.pdf, p.24",
      "values:originalText": "(6) Sections 44ZZW and 44ZZX do not apply to the disclosure of\ninformation by a person if the disclosure is made for the purpose of\ncomplying with Chapter 6CA of the Corporations Act 2001.\nComLaw Authoritative Act C2011A00185\n\nSchedule 1  Amendments",
      "skos:definition": "(6) Sections 44ZZW and 44ZZX do not apply to the disclosure of\ninformation by a person if the disclosure is made for the purpose of\ncomplying with Chapter 6CA of the Corporations Act 2001.\nComLaw Authoritative Act C2011A00185\n\nSchedule 1  Amendments",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-20"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-20-ss-6-norm"
        }
      ],
      "cml:integrityHash": "72b9bc7727a9055e569ba3969efee5bb5476de3ea71e31b5ca7e2458148adbe1",
      "skos:note": "Exemption from disclosure of information for compliance with Corporations Act 2001 Chapter 6CA"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-20-ss-6",
      "@type": "cof:Section",
      "cof:title": "20(6) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "values:kind": "subsection",
      "cof:pageNumber": 24,
      "values:originalText": "(6) Sections 44ZZW and 44ZZX do not apply to the disclosure of\ninformation by a person if the disclosure is made for the purpose of\ncomplying with Chapter 6CA of the Corporations Act 2001.\nComLaw Authoritative Act C2011A00185\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-20-ss-6-norm",
      "@type": "values:Permission",
      "cml:modality": {
