        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If:\n\n(a) proceedings are brought against a person in respect of section 44ZZW or 44ZZX; and\n\n(b) the person seeks to rely on subsection 44ZZU(2) or (4), or on a subsection of section 44ZZY or 44ZZZ;",
      "cml:conclusionText": "The person bears an evidential burden."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-24-ss-6-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Person must provide evidence if seeking to rely on subsections of section 44ZZY or 44ZZZ",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
