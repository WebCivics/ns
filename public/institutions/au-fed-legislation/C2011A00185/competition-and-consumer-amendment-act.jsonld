          "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-2-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "db4492d3364da45575224ddce81f02b48f16f63063496eb1f63ca2944c8683d5",
      "skos:note": "Disclosure of information by a corporation to a person is permitted if the person is a competitor or potential competitor and the corporation did not know, and could not reasonably be expected to have known, that the person was such a competitor or potential competitor."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act#sch-1-sec-10-ss-2",
      "@type": "cof:Section",
      "cof:title": "10(2) Competition and Consumer Amendment Act (No. 1) 2011       No. 185, 2011",
      "values:kind": "subsection",
      "cof:pageNumber": 14,
      "values:originalText": "(2) Section 44ZZW does not apply to the disclosure of information by\na corporation to a person if:\n\n(a) the person is a competitor or potential competitor of the\ncorporation in the market referred to in that section; and\n\n(b) the corporation did not know, and could not reasonably be\nexpected to have known, that the person was such a\ncompetitor or potential competitor.\nDisclosure to participants in joint venture"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-2-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Permission to disclose information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is a competitor or potential competitor.",
      "cml:conclusionText": "Disclosure of information is permitted."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Temporal interval for disclosure of information",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Disclosure of information by the corporation to the person.",
      "cml:conclusionText": "The temporal interval for disclosure is from now until the corporation knows or reasonably expects to know that the person is a competitor or potential competitor."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-2-logic-diffusion-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Diffusion of information about competitors and potential competitors",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The disclosure of information by the corporation to the person.",
      "cml:conclusionText": "Information about competitors and potential competitors is diffused through the market."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-2-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:logicSummary": "Inference from disclosure of information",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The corporation did not know, and could not reasonably be expected to have known, that the person was such a competitor or potential competitor.",
      "cml:conclusionText": "The inference is that the person is a competitor or potential competitor."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-sch-1-sec-10-ss-2-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "Validate",
      "cml:logicSummary": "Validation of disclosure of information",
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:confidence": {
