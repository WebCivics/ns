      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits disclosure of information that could compromise the security of the individual.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(d) there is a risk that disclosure of the information will reveal that the individual is undergoing such assessment;"
    },
    {
      "@id": "concept:act-sch-3-sec-84-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits disclosure of information that could lead to the individual being included in the NWPP.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(c) if the individual were included in the NWPP following that assessment, the individual would be a Commonwealth participant or a Territory participant;"
    },
