    },
    {
      "@id": "concept:act-sch-3-sec-71-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to apply the Act to pre-commencement permissions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
