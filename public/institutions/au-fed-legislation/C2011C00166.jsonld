      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person does not commit an offence against this Division unless...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Part of the conduct must occur in Australia",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "wholly or partly",
      "cml:premiseText": "The conduct constituting the alleged offence occurs wholly or partly in Australia"
    },
    {
      "@id": "concept:act-sch-5-sec-400-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the conduct constituting the alleged offence occurs wholly or partly in Australia; or wholly or partly on board an Australian aircraft or an Australian ship;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
