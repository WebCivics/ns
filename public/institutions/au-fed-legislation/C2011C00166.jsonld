    {
      "@id": "concept:act-sch-1-sec-36-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The payment of compensation overlaps with the temporal interval during which it is payable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between payment and compensation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "There are cases in which compensation is payable by the Commonwealth."
    },
    {
      "@id": "concept:act-sch-1-sec-36-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If payment is made, then the Commonwealth has an obligation to pay compensation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Payment implies obligation to pay compensation",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "There are cases in which compensation is payable by the Commonwealth."
    },
    {
      "@id": "concept:act-sch-1-sec-36-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth recognizes its obligation to pay compensation in these cases.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Commonwealth recognizes obligation to pay compensation",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "There are cases in which compensation is payable by the Commonwealth."
    },
    {
      "@id": "concept:act-sch-1-sec-36-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth has an obligation to pay compensation in these cases.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to pay compensation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "There are cases in which compensation is payable by the Commonwealth."
    },
    {
      "@id": "concept:act-sch-1-sec-36-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The payment of compensation differs from the concept of compensation itself.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Payment and compensation differ in meaning",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "DiffersFrom",
      "cml:premiseText": "There are cases in which compensation is payable by the Commonwealth."
    },
