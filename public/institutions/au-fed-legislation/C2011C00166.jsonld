      "cml:logicSummary": "Recurring applicability of the Act to pre-commencement permissions",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:premiseText": "The Act applies on and after its commencement in relation to a pre-commencement permission."
