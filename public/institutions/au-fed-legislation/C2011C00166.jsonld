      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The magistrate must grant the order",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
