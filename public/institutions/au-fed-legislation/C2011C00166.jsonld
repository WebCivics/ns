      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:premiseText": "Post-commencement permission means a permission given under paragraph 16(1)(b) of the Witness Protection Act 1994, as in force at the commencement of this item."
    },
    {
      "@id": "concept:act-sch-3-sec-71-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Pre-commencement permissions are classified as such.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classification of post-commencement and pre-commencement permissions as such",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:premiseText": "Pre-commencement permission means a permission given under paragraph 16(1)(b) of the Witness Protection Act 1994 before the commencement of this item."
    },
    {
