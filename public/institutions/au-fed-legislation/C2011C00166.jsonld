      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits disclosure of information about an individual undergoing NWPP assessment.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the person discloses information about an individual; and (b) the individual is undergoing assessment for inclusion in the NWPP at the time the information is disclosed;"
    },
    {
      "@id": "concept:act-sch-3-sec-84-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
