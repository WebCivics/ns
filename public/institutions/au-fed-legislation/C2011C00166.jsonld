      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Act applies to pre-commencement permissions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
