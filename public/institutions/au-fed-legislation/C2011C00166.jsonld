      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.99",
      "skos:note": "Court must hold proceedings in private and make orders to suppress publication of evidence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "28(2) Identity of participant not to be disclosed in court proceedings"
      },
      "wasDerivedFrom": "act.pdf",
