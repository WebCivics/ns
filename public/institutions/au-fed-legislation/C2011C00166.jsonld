      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Grant order during reasonable grounds for suspecting evidential material is held in or accessible from the computer or data storage device",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(2) The magistrate may grant the order if the magistrate is satisfied that: ... (a) there are reasonable grounds for suspecting that evidential material is held in, or is accessible from, the computer or data storage device;"
    },
    {
      "@id": "concept:act-sch-2-sec-70-ss-2-logic-deontic-1",
