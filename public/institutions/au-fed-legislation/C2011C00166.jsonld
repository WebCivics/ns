      "cml:logicSummary": "Part of the conduct must occur on board an Australian aircraft or ship",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "wholly or partly",
      "cml:premiseText": "(i) wholly or partly in Australia; (ii) wholly or partly on board an Australian aircraft or an Australian ship"
    },
    {
      "@id": "concept:act-sch-5-sec-400-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the conduct constituting the alleged offence occurs wholly outside Australia...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Conduct must occur outside Australia",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "wholly outside",
      "cml:premiseText": "(b) the conduct constituting the alleged offence occurs wholly outside Australia..."
    },
