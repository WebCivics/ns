    {
      "@id": "concept:act-sch-1-sec-36-2",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.42",
      "skos:note": "Financial institutions must not provide information about transactions without a monitoring order.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "36 Crimes Legislation Amendment (Serious and Organised Crime) Act"
      },
      "wasDerivedFrom": "act.pdf",
