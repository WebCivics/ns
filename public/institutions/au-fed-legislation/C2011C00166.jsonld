    {
      "@id": "concept:act-sch-4-sec-102-ss-2",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.108",
      "skos:note": "A person commits an offence if they associate with another person engaging in conduct that constitutes an offence against any law. Exempts conduct from punishment for related offenses within a 7-day window.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "102(2) Crimes Legislation Amendment (Serious and Organised Crime) Act"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
        "concept:act-sch-4-sec-102-ss-2-norm",
        "concept:act-sch-4-sec-102-ss-2-logic-deontic-1",
        "concept:act-sch-4-sec-102-ss-2-logic-alleninterval-2",
        "concept:act-sch-4-sec-102-ss-2-logic-ltl-3",
        "concept:act-sch-4-sec-102-ss-2-logic-deontic-4",
        "concept:act-sch-4-sec-102-ss-2-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": [
        "f3e60c5f1358fdb055181f12926d052d4975a854f9eeabb907f87265fc51713c",
        "1fa82fbf745d5fdf326a7b2289c138eb9c122fb0045694cdab42d76222f4156e"
      ],
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:act#sch-4-sec-102-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:act-sch-4-sec-102"
    },
    {
      "@id": "concept:act-sch-4-sec-102-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conviction occurred before the association.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Establishes a temporal relation between the conviction and the association.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:premiseText": "(a) the first person has previously been convicted of an offence against subsection (1); and (b) the first person associates with another person (the second person);"
    },
    {
      "@id": "concept:act-sch-4-sec-102-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person commits an offence if they associate with another person engaging in conduct that constitutes an offence against any law.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to not associate with another person engaging in conduct that constitutes an offence against any law.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(a) the first person has previously been convicted of an offence against subsection (1); and (b) the first person associates with another person (the second person);"
    },
    {
      "@id": "concept:act-sch-4-sec-102-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first person is obligated not to facilitate the engagement or proposed engagement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to not engage in conduct that constitutes an offence against any law.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(d) the association facilitates the engagement or proposed engagement by the second person in the second person’s conduct;"
    },
    {
      "@id": "concept:act-sch-4-sec-102-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes obligation on the state.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation"
    },
    {
      "@id": "concept:act-sch-4-sec-102-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The association and the conduct are recurring traces.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Establishes a recurring trace of the association and the conduct.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:premiseText": "(c) the second person engages, or proposes to engage, in conduct (the second person’s conduct) that constitutes, or is part of conduct constituting, an offence against any law;"
    },
    {
      "@id": "concept:act-sch-4-sec-102-ss-2-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:State",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:act-sch-4-sec-102-ss-2"
    },
    {
      "@id": "concept:act-sch-4-sec-102-ss-3",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.108",
      "skos:note": "Knowledge is a fault element for certain crimes.",
      "skos:prefLabel": {
