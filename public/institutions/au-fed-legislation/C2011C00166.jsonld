      },
      "cml:operator": "must",
      "cml:premiseText": "(2) The magistrate may grant the order if the magistrate is satisfied that: ... (a) there are reasonable grounds for suspecting that evidential material is held in, or is accessible from, the computer or data storage device;"
    },
    {
      "@id": "concept:act-sch-2-sec-70-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The magistrate can refuse to grant the order",
