      "cml:premiseText": "The Act applies on and after its commencement in relation to a pre-commencement permission."
    },
    {
      "@id": "concept:act-sch-3-sec-71-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Pre-commencement permission is classified as such.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
