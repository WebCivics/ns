    <https://ns.webcivics.net/cml/operator> "Temporal relation";
    <https://ns.webcivics.net/cml/logicSummary> "Establishes a temporal relation between the conviction and the association.";
    <https://ns.webcivics.net/cml/premiseText> "(a) the first person has previously been convicted of an offence against subsection (1); and (b) the first person associates with another person (the second person);";
    <https://ns.webcivics.net/cml/conclusionText> "The conviction occurred before the association.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
