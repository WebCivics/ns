    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Obligation to not associate with another person engaging in conduct that constitutes an offence against any law.";
    <https://ns.webcivics.net/cml/premiseText> "(a) the first person has previously been convicted of an offence against subsection (1); and (b) the first person associates with another person (the second person);";
    <https://ns.webcivics.net/cml/conclusionText> "The first person commits an offence if they associate with another person engaging in conduct that constitutes an offence against any law.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
