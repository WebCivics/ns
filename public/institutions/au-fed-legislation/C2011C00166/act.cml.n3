doc:sch-1-sec-40-ss-2 a cof:Section ;
    cof:title "40(2) After section 92" ;
    values:kind "subsection" ;
    values:originalText "(2) However, the *DPP need not give a notice to a person under subsection (1) if the person has made:  (a) an application for an *extension order in relation to the property; and  (b) an application under section 30, 31 or 94 in relation to the property." ;
    cof:pageNumber "18"^^xsd:integer .

