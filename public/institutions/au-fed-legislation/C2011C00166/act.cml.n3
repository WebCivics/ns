concept:act-sch-7-sec-34e a cml:Concept ;
    skos:prefLabel "34E Examiner may withdraw contempt application"@en ;
    cml:realizedBy doc:sch-7-sec-34e ;
    values:originalText "(1) An examiner may at any time withdraw an application in relation to a person under subsection 34B(1).  (2) If:  (a) the examiner does so; and  (b) the person is in detention under section 34D; the person must be released from detention immediately. ComLaw Authoritative Act C2011C00166  Schedule 7  Amendments relating to the Australian Crime Commission" ;
    skos:definition "(1) An examiner may at any time withdraw an application in relation to a person under subsection 34B(1).  (2) If:  (a) the examiner does so; and  (b) the person is in detention under section 34D; the person must be released from detention immediately. ComLaw Authoritative Act C2011C00166  Schedule 7  Amendments relating to the Australian Crime Commission"@en ;
    cml:integrityHash "b3cb2e1eba64b44b8d61a40d2f7f2fd19e59296807eb1a6fbe98a1be3a0d2e14" ;
    cof:pageNumber "135"^^xsd:integer ;
    cml:hasPart concept:act-sch-7-sec-34e-ss-1 ;
    cml:hasPart concept:act-sch-7-sec-34e-ss-2 ;
