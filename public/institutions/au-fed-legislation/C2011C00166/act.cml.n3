concept:act-sch-6-sec-2 a cml:Concept ;
    skos:prefLabel "2 Application of section 20BI of the Crimes Act 1914"@en ;
    cml:realizedBy doc:sch-6-sec-2 ;
    values:originalText "Section 20BI of the Crimes Act 1914 (as amended by this Schedule) applies to findings made before, on or after the commencement of that section." ;
