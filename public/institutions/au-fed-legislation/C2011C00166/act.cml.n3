    skos:prefLabel "168 Application"@en ;
    cml:realizedBy doc:sch-1-sec-168 ;
    values:originalText "Section 19 of the Proceeds of Crime Act 2002, as amended by this Part, applies in relation to restraining orders applied for on or after the commencement of this item, whether the conduct constituting the offence concerned occurred or occurs before, on or after that commencement." ;
