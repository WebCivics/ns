concept:act-sch-1-sec-48 a cml:Concept ;
    skos:prefLabel "48 At the end of section 93"@en ;
    cml:realizedBy doc:sch-1-sec-48 ;
    values:originalText "Add:  (4) If the court makes the *extension order, the *DPP must take reasonable steps to give any person who has or claims, or whom the DPP reasonably believes may have, an *interest in the property to which the order relates a written notice stating:  (a) the date on which the property will be forfeited under this Part, in accordance with the extension order, unless it is excluded from forfeiture; and  (b) the effect of subsections (2) and (3)." ;
    skos:definition "Add:  (4) If the court makes the *extension order, the *DPP must take reasonable steps to give any person who has or claims, or whom the DPP reasonably believes may have, an *interest in the property to which the order relates a written notice stating:  (a) the date on which the property will be forfeited under this Part, in accordance with the extension order, unless it is excluded from forfeiture; and  (b) the effect of subsections (2) and (3)."@en ;
    cml:integrityHash "f8d36968a7debe7f4e64017d66715fb85a409551fc059d6dc51bfa8579ad5e7b" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Provide written notice to persons with an interest in forfeited property" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.19" ;
    cml:asserts concept:act-sch-1-sec-48-norm .
concept:act-sch-1-sec-48-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-1-sec-48 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
