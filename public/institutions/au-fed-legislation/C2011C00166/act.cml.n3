    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to not associate with another person engaging in conduct that constitutes an offence against any law." ;
    cml:premiseText "(a) the first person has previously been convicted of an offence against subsection (1); and (b) the first person associates with another person (the second person);" ;
    cml:conclusionText "The first person commits an offence if they associate with another person engaging in conduct that constitutes an offence against any law." ;
