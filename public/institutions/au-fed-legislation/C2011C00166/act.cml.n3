concept:act-sch-4-sec-390-4 a cml:Concept ;
    skos:prefLabel "390 4  Supporting a criminal organisation"@en ;
    cml:realizedBy doc:sch-4-sec-390-4 ;
    values:originalText "(1) A person commits an offence if:  (a) the person provides material support or resources to an organisation or a member of an organisation; and  (b) either: ComLaw Authoritative Act C2011C00166  Schedule 4  Criminal organisation and association offences" ;
    skos:definition "(1) A person commits an offence if:  (a) the person provides material support or resources to an organisation or a member of an organisation; and  (b) either: ComLaw Authoritative Act C2011C00166  Schedule 4  Criminal organisation and association offences"@en ;
    cml:integrityHash "ad5d802c9cd8ec37d46bcce6582dda7d7e2874edc26f94e2b3f856d2ccb76d10" ;
    cof:pageNumber "109"^^xsd:integer ;
    skos:note "Providing material support or resources to a criminal organisation is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
