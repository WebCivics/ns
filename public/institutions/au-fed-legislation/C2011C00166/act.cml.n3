    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Temporal relation between investigation and offence" ;
    cml:premiseText "Australian Crime Commission Act 2002" ;
    cml:conclusionText "Investigated by Australian Crime Commission during the same period as the offence" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

