concept:act-sch-2-sec-13 a cml:Concept ;
    skos:prefLabel "13 After subsection 3K(3)"@en ;
    cml:realizedBy doc:sch-2-sec-13 ;
    values:originalText "Insert:  (3AA) The executing officer need not comply with paragraph (3)(a) or (b) if he or she believes on reasonable grounds that to do so might:  (a) endanger the safety of a person; or  (b) prejudice an investigation or prosecution." ;
    skos:definition "Insert:  (3AA) The executing officer need not comply with paragraph (3)(a) or (b) if he or she believes on reasonable grounds that to do so might:  (a) endanger the safety of a person; or  (b) prejudice an investigation or prosecution."@en ;
    cml:integrityHash "e2c7caa58e85a68e4a88b48910adb01a660065eac5ee1bc1ce71bc4e2d49a7fe" ;
    cof:pageNumber "73"^^xsd:integer ;
    skos:note "Executing officer need not comply with certain conditions under reasonable grounds." ;
