    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "Prohibition on divulging or communicating information." ;
    cml:premiseText "The person has the information as a result of the performance of functions or duties, or the exercise of powers, under this Act." ;
    cml:conclusionText "The person must not divulge or communicate the information." ;
    cml:executionSurface "modalities::logic::deontic" ;
