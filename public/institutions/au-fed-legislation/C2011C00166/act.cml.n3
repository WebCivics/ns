    cml:modality cml:Deontic ;
    cml:operator "if" ;
    cml:logicSummary "Conditional obligation" ;
    cml:premiseText "Investigated by Australian Federal Police or Australian Crime Commission" ;
    cml:conclusionText "Offence is taken to be a State offence with a federal aspect" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

