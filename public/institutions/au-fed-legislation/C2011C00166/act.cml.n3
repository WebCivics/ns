concept:act-sch-3-sec-22-2 a cml:Concept ;
    skos:prefLabel "22 Offences relating to Commonwealth or Territory participants"@en ;
    cml:realizedBy doc:sch-3-sec-22-2 ;
    values:originalText "Disclosure of information about Commonwealth or Territory participant  (1) A person commits an offence if:  (a) the person discloses information about an individual; and  (b) the individual is a participant; and  (c) the individual is a Commonwealth participant or a Territory participant; and  (d) either or both of the following apply:  (i) the individual has a current NWPP identity at the time the information is disclosed and the information is about ComLaw Authoritative Act C2011C00166  Witness protection  Schedule 3 Amendments  Part 1  Crimes Legislation Amendment (Serious and Organised Crime) Act (No. 2)" ;
    skos:definition "Disclosure of information about Commonwealth or Territory participant  (1) A person commits an offence if:  (a) the person discloses information about an individual; and  (b) the individual is a participant; and  (c) the individual is a Commonwealth participant or a Territory participant; and  (d) either or both of the following apply:  (i) the individual has a current NWPP identity at the time the information is disclosed and the information is about ComLaw Authoritative Act C2011C00166  Witness protection  Schedule 3 Amendments  Part 1  Crimes Legislation Amendment (Serious and Organised Crime) Act (No. 2)"@en ;
    cml:integrityHash "157ceadb4ff91941d5d8ad386a3d582f2b9ad033ef2a09952233d416efaa1a52" ;
    cof:pageNumber "88"^^xsd:integer ;
    skos:note "Disclosing information about a participant without a current NWPP identity is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.88" ;
