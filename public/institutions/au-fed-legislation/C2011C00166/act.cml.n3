concept:act-sch-2-sec-11 a cml:Concept ;
    skos:prefLabel "11 Application"@en ;
    cml:realizedBy doc:sch-2-sec-11 ;
    values:originalText "The amendments made by this Part apply in relation to:  (a) a thing seized before, on or after the commencement of this Part; and  (b) a document produced before, on or after the commencement of this Part. ComLaw Authoritative Act C2011C00166  Search warrants  Schedule 2 Use of equipment under warrant  Part 2  Crimes Legislation Amendment (Serious and Organised Crime) Act (No. 2)" ;
    skos:definition "The amendments made by this Part apply in relation to:  (a) a thing seized before, on or after the commencement of this Part; and  (b) a document produced before, on or after the commencement of this Part. ComLaw Authoritative Act C2011C00166  Search warrants  Schedule 2 Use of equipment under warrant  Part 2  Crimes Legislation Amendment (Serious and Organised Crime) Act (No. 2)"@en ;
    cml:integrityHash "7c1a8b5009f185cd2d7880a72927e6ab954ace7fde0b0df68758adda985a8d9a" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Amendments apply to things seized or documents produced before, on, or after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
