doc:sch-1-sec-155-ss-4a a cof:Section ;
    cof:title "155(4A) After subsection 39(4)" ;
    values:kind "subsection" ;
    values:originalText "(4A) The court may, at any time before finally determining the application, direct the *DPP to give or publish notice of the application to a specified person or class of persons. The court may also specify the time and manner in which the notice is to be given or published." ;
    cof:pageNumber "45"^^xsd:integer .

concept:act-sch-1-sec-155-ss-4b a cml:Concept ;
    skos:prefLabel "155(4B) After subsection 39(4)"@en ;
    cml:realizedBy doc:sch-1-sec-155-ss-4b ;
    values:originalText "(4B) If the court makes the ancillary order after a request under subsection (3A), the *DPP must give written notice to any person whom the DPP reasonably believes may be affected by the order." ;
    skos:definition "(4B) If the court makes the ancillary order after a request under subsection (3A), the *DPP must give written notice to any person whom the DPP reasonably believes may be affected by the order."@en ;
