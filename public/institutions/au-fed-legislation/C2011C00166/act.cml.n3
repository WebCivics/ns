concept:act-sch-1-sec-2010-12 a cml:Concept ;
    skos:prefLabel "2010 33"@en ;
    cml:realizedBy doc:sch-1-sec-2010-12 ;
    values:originalText "(a) at least 14 days after the day on which the *production order is made; or  (b) if the magistrate who makes the production order is satisfied that it is appropriate, having regard to the matters specified in subsection (3), to specify an earlier time—at least 3 days after the day on which the production order is made.  (3) The matters to which the magistrate must have regard for the purposes of deciding whether an earlier time is appropriate under paragraph (2)(b) are:  (a) the urgency of the situation; and  (b) any hardship that may be caused to the person required by the *production order to produce documents or make documents available." ;
    skos:definition "(a) at least 14 days after the day on which the *production order is made; or  (b) if the magistrate who makes the production order is satisfied that it is appropriate, having regard to the matters specified in subsection (3), to specify an earlier time—at least 3 days after the day on which the production order is made.  (3) The matters to which the magistrate must have regard for the purposes of deciding whether an earlier time is appropriate under paragraph (2)(b) are:  (a) the urgency of the situation; and  (b) any hardship that may be caused to the person required by the *production order to produce documents or make documents available."@en ;
    cml:integrityHash "464c77580908bfede451d6d0b0ceec267811a294c0063ff44c0cf766e9b3971f" ;
    cof:pageNumber "39"^^xsd:integer ;
    skos:note "Specify an earlier time for production order, at least 3 days after its issuance." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.39" ;
    cml:asserts concept:act-sch-1-sec-2010-12-norm .
concept:act-sch-1-sec-2010-12-norm a values:Permission ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-1-sec-2010-12 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
