concept:act-sch-1-sec-85 a cml:Concept ;
    skos:prefLabel "85 Subsection 146(3)"@en ;
    cml:realizedBy doc:sch-1-sec-85 ;
    values:originalText "Repeal the subsection, substitute:  (3) A *pecuniary penalty order made in relation to a person’s conviction of an offence is discharged if:  (a) the person’s conviction of the offence is subsequently *quashed; and  (b) the order does not relate to any other offence; and  (c) the offence is not a *serious offence." ;
    skos:definition "Repeal the subsection, substitute:  (3) A *pecuniary penalty order made in relation to a person’s conviction of an offence is discharged if:  (a) the person’s conviction of the offence is subsequently *quashed; and  (b) the order does not relate to any other offence; and  (c) the offence is not a *serious offence."@en ;
    cml:integrityHash "d6d556786b16756c10f1374b3c742e104650ec5156923800b79ddfb486744a4b" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Discharge pecuniary penalty order under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
