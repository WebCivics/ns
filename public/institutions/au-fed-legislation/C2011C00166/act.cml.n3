doc:sch-2-sec-3m-ss-1 a cof:Section ;
    cof:title "3M(1) Compensation for damage to electronic equipment" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if:  (a) as a result of equipment being operated as mentioned in section 3K, 3L or 3LAA:  (i) damage is caused to the equipment; or  (ii) damage is caused to data recorded on the equipment or data access to which was obtained from the operation of the equipment; or  (iii) programs associated with the use of the equipment, or with the use of the data, are damaged or corrupted; and  (b) the damage or corruption occurs because:  (i) insufficient care was exercised in selecting the person who was to operate the equipment; or  (ii) insufficient care was exercised by the person operating the equipment." ;
    cof:pageNumber "77"^^xsd:integer .

concept:act-sch-2-sec-3m-ss-2 a cml:Concept ;
    skos:prefLabel "3M(2) Compensation for damage to electronic equipment"@en ;
    cml:realizedBy doc:sch-2-sec-3m-ss-2 ;
    values:originalText "(2) The Commonwealth must pay the owner of the equipment, or the user of the data or programs, such reasonable compensation for the ComLaw Authoritative Act C2011C00166  Schedule 2  Search warrants" ;
    skos:definition "(2) The Commonwealth must pay the owner of the equipment, or the user of the data or programs, such reasonable compensation for the ComLaw Authoritative Act C2011C00166  Schedule 2  Search warrants"@en ;
    cml:integrityHash "497f2e10a2876e6d1279b0a8d12ca495f5d02b6ba79c3757f87dbc251ba1b79e" ;
    values:partOf concept:act-sch-2-sec-3m ;
    cof:pageNumber "77"^^xsd:integer ;
    skos:note "The Commonwealth must pay reasonable compensation for damage to electronic equipment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
