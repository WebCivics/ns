concept:act-sch-7-sec-34a a cml:Concept ;
    skos:prefLabel "34A Contempt of the ACC"@en ;
    cml:realizedBy doc:sch-7-sec-34a ;
    values:originalText "A person is in contempt of the ACC if he or she:  (a) when appearing as a witness at an examination before an examiner:  (i) refuses or fails to take an oath or affirmation when required to do so under section 28; or  (ii) refuses or fails to answer a question that he or she is required to answer by the examiner; or ComLaw Authoritative Act C2011C00166  Amendments relating to the Australian Crime Commission  Schedule 7 Main amendments  Part 1  Crimes Legislation Amendment (Serious and Organised Crime) Act (No. 2)" ;
    skos:definition "A person is in contempt of the ACC if he or she:  (a) when appearing as a witness at an examination before an examiner:  (i) refuses or fails to take an oath or affirmation when required to do so under section 28; or  (ii) refuses or fails to answer a question that he or she is required to answer by the examiner; or ComLaw Authoritative Act C2011C00166  Amendments relating to the Australian Crime Commission  Schedule 7 Main amendments  Part 1  Crimes Legislation Amendment (Serious and Organised Crime) Act (No. 2)"@en ;
    cml:integrityHash "636e1afbc6b5d970e29c989a0a9f18e303aafe4bdb9167cebf34111371debddf" ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "Refusal to take an oath or answer questions is contempt of the ACC." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
