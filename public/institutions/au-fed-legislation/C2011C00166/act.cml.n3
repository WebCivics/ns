    cml:modality cml:Deontic ;
    cml:operator "Permit" ;
    cml:logicSummary "Specify an earlier time for production order." ;
    cml:premiseText "(3) The matters to which the magistrate must have regard for the purposes of deciding whether an earlier time is appropriate under paragraph (2)(b) are:" ;
    cml:conclusionText "...the *production order to produce documents or make documents available." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
