concept:act-sch-1-sec-33 a cml:Concept ;
    skos:prefLabel "33 At the end of subsection 79(3)"@en ;
    cml:realizedBy doc:sch-1-sec-33 ;
    values:originalText "Add “However, the DPP need not do so until it has had a reasonable opportunity to conduct *examinations in relation to the application.”." ;
    skos:definition "Add “However, the DPP need not do so until it has had a reasonable opportunity to conduct *examinations in relation to the application.”."@en ;
    cml:integrityHash "97dc4ce81b04908d5c837b908adc6588e80ec45a352bc4a3e88e825a8f5745ff" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "DPP need not conduct examinations until it has had a reasonable opportunity." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
