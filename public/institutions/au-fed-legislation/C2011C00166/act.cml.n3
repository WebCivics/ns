doc:sch-3-sec-82-ss-6 a cof:Section ;
    cof:title "82(6) Crimes Legislation Amendment (Serious and Organised Crime) Act" ;
    values:kind "subsection" ;
    values:originalText "(6) The notice:  (a) must be in writing; and  (b) must require the participant to return to the Commissioner, within 10 days of the giving of the notice, all documents provided to the participant that relate to:  (i) the participant’s current NWPP identity; and  (ii) any former NWPP identity of the participant that is not being restored." ;
    cof:pageNumber "88"^^xsd:integer .

concept:act-sch-3-sec-82-ss-7 a cml:Concept ;
    skos:prefLabel "82(7) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-3-sec-82-ss-7 ;
    values:originalText "(7) A person commits an offence if:  (a) the person is given a notice under subsection (6); and  (b) the person refuses or fails to comply with the notice. Penalty: 10 penalty units." ;
    skos:definition "(7) A person commits an offence if:  (a) the person is given a notice under subsection (6); and  (b) the person refuses or fails to comply with the notice. Penalty: 10 penalty units."@en ;
    cml:integrityHash "2a0d8c5414e415b3549629d19cb6bc372c974c7b3fd3ed7070117479c7337d9b" ;
    values:partOf concept:act-sch-3-sec-82 ;
    cof:pageNumber "88"^^xsd:integer ;
    skos:note "Refusal to comply with notice results in offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
