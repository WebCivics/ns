    cof:pageNumber "21"^^xsd:integer .

concept:act-sch-1-sec-2010-3-ss-2 a cml:Concept ;
    skos:prefLabel "2010(2) 15"@en ;
    cml:realizedBy doc:sch-1-sec-2010-3-ss-2 ;
    values:originalText "(2) An order under this section must:  (a) specify the proportion found by the court under paragraph (1)(d); and  (b) direct the Commonwealth, once the property has vested absolutely in it, to:  (i) if the property has not been disposed of—dispose of the property; and  (ii) pay the applicant an amount equal to that proportion of the difference between the amount received from disposing of the property and the sum of any payments of the kind referred to in paragraph 100(1)(b) in connection with the forfeiture." ;
    skos:definition "(2) An order under this section must:  (a) specify the proportion found by the court under paragraph (1)(d); and  (b) direct the Commonwealth, once the property has vested absolutely in it, to:  (i) if the property has not been disposed of—dispose of the property; and  (ii) pay the applicant an amount equal to that proportion of the difference between the amount received from disposing of the property and the sum of any payments of the kind referred to in paragraph 100(1)(b) in connection with the forfeiture."@en ;
