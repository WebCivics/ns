concept:act-sch-3-sec-64 a cml:Concept ;
    skos:prefLabel "64 Subsection 27(1)"@en ;
    cml:realizedBy doc:sch-3-sec-64 ;
    values:originalText "Repeal the subsection, substitute:  (1) If:  (a) a participant is to be a witness, under the participant’s current NWPP identity, in a criminal proceeding; and  (b) the participant has a criminal record under his or her original identity or any former NWPP identity; the participant must notify the Commissioner that the participant is to be a witness in the proceeding." ;
    skos:definition "Repeal the subsection, substitute:  (1) If:  (a) a participant is to be a witness, under the participant’s current NWPP identity, in a criminal proceeding; and  (b) the participant has a criminal record under his or her original identity or any former NWPP identity; the participant must notify the Commissioner that the participant is to be a witness in the proceeding."@en ;
    cml:integrityHash "2ac881271c27a522bd89a403acdc032584b45a4aedc140254852d8814de026d9" ;
    cof:pageNumber "98"^^xsd:integer ;
