doc:sch-1-sec-161 a cof:Section ;
    cof:title "161 Application" ;
    values:kind "section" ;
    values:originalText "Section 64 of the Proceeds of Crime Act 2002, as amended by this Part, applies in relation to forfeiture orders applied for on or after the commencement of this item, whether the conduct constituting the offence concerned occurred or occurs before, on or after that commencement." ;
    cof:pageNumber "47"^^xsd:integer .

