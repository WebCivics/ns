concept:act-sch-2-sec-16 a cml:Concept ;
    skos:prefLabel "16 Subsection 3L(1)"@en ;
    cml:realizedBy doc:sch-2-sec-16 ;
    values:originalText "Repeal the subsection, substitute:  (1) The executing officer or a constable assisting may operate electronic equipment at the warrant premises to access data (including data not held at the premises) if he or she suspects on reasonable grounds that the data constitutes evidential material. Note: A constable can obtain an order requiring a person with knowledge of a computer or computer system to provide assistance: see section 3LA. ComLaw Authoritative Act C2011C00166  Schedule 2  Search warrants" ;
    skos:definition "Repeal the subsection, substitute:  (1) The executing officer or a constable assisting may operate electronic equipment at the warrant premises to access data (including data not held at the premises) if he or she suspects on reasonable grounds that the data constitutes evidential material. Note: A constable can obtain an order requiring a person with knowledge of a computer or computer system to provide assistance: see section 3LA. ComLaw Authoritative Act C2011C00166  Schedule 2  Search warrants"@en ;
    cml:integrityHash "04f9d01bbf2b2d05a7a37c3594b0620a129f8e82faf0dc283621414fe8a78e2d" ;
    cof:pageNumber "73"^^xsd:integer ;
    skos:note "Executing officer or constable may operate electronic equipment to access data at warrant premises." ;
    cml:curationStatus cml:Proposed ;
