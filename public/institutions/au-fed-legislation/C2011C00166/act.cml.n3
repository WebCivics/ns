    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Examinations may overlap with other application processes" ;
    cml:premiseText "The examinations may occur concurrently with other aspects of the application process." ;
    cml:conclusionText "However, the DPP need not do so until it has had a reasonable opportunity." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

