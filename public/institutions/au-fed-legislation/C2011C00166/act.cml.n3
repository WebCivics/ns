concept:act-sch-1-sec-147 a cml:Concept ;
    skos:prefLabel "147 Section 338 (definition of account)"@en ;
    cml:realizedBy doc:sch-1-sec-147 ;
    values:originalText "Repeal the definition, substitute: account means any facility or arrangement through which a *financial institution accepts deposits or allows withdrawals and includes:  (a) a facility or arrangement for: ComLaw Authoritative Act C2011C00166  Proceeds of crime  Schedule 1 Notices  Part 4  Crimes Legislation Amendment (Serious and Organised Crime) Act (No. 2)" ;
    skos:definition "Repeal the definition, substitute: account means any facility or arrangement through which a *financial institution accepts deposits or allows withdrawals and includes:  (a) a facility or arrangement for: ComLaw Authoritative Act C2011C00166  Proceeds of crime  Schedule 1 Notices  Part 4  Crimes Legislation Amendment (Serious and Organised Crime) Act (No. 2)"@en ;
    cml:integrityHash "985952aa92b4c1b6606ef439fe6321bc206666329ecf06862c1fd47c2b421ff8" ;
    cof:pageNumber "42"^^xsd:integer ;
    skos:note "Definition of account" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
