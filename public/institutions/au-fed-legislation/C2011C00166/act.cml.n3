    cof:pageNumber "42"^^xsd:integer .

concept:act-sch-1-sec-2010-14 a cml:Concept ;
    skos:prefLabel "2010 37"@en ;
    cml:realizedBy doc:sch-1-sec-2010-14 ;
    values:originalText "(i) a *fixed term deposit; or  (ii) a safety deposit box; and  (b) a credit card account; and  (c) a loan account (other than a credit card account); and  (d) an account held in the form of units in:  (i) a cash management trust; or  (ii) a trust of a kind prescribed by the regulations; and  (e) a closed account. To avoid doubt, it is immaterial whether:  (f) an account has a nil balance; or  (g) any transactions have been allowed in relation to an account." ;
    skos:definition "(i) a *fixed term deposit; or  (ii) a safety deposit box; and  (b) a credit card account; and  (c) a loan account (other than a credit card account); and  (d) an account held in the form of units in:  (i) a cash management trust; or  (ii) a trust of a kind prescribed by the regulations; and  (e) a closed account. To avoid doubt, it is immaterial whether:  (f) an account has a nil balance; or  (g) any transactions have been allowed in relation to an account."@en ;
    cml:integrityHash "566d2a08495fad5e977e216368ebff52cc93732c7853deee1591f12a4d71c08f" ;
    cof:pageNumber "43"^^xsd:integer ;
    skos:note "List of accounts subject to restrictions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
