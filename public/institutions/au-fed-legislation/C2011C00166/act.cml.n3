concept:act-sch-3-sec-3aa a cml:Concept ;
    skos:prefLabel "3AA Declaration of complementary witness protection law"@en ;
    cml:realizedBy doc:sch-3-sec-3aa ;
    values:originalText "For the purposes of this Act, the Minister may, by legislative instrument, declare a law of a State or Territory to be a complementary witness protection law." ;
