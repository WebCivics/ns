concept:act-sch-3-sec-22-ss-7 a cml:Concept ;
    skos:prefLabel "22(7) At the end of section 13"@en ;
    cml:realizedBy doc:sch-3-sec-22-ss-7 ;
    values:originalText "(7) When the Commissioner first takes action under subsection (5) in respect of a former participant who was a participant under section 10 or 10A, the Commissioner must give the Immigration Secretary, or an officer nominated by that Secretary, written notice that he or she has taken that action." ;
    skos:definition "(7) When the Commissioner first takes action under subsection (5) in respect of a former participant who was a participant under section 10 or 10A, the Commissioner must give the Immigration Secretary, or an officer nominated by that Secretary, written notice that he or she has taken that action."@en ;
    cml:integrityHash "db493a7ea3fb7bd1fd449eda77528e8981f18672155c87033e283cdf917261ea" ;
    values:partOf concept:act-sch-3-sec-22 ;
    cof:pageNumber "83"^^xsd:integer ;
    skos:note "Written notice must be given to the Immigration Secretary" ;
    dc:description "Notice" ;
    cml:curationStatus cml:Proposed ;
