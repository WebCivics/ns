concept:act-sch-1-sec-19 a cml:Concept ;
    skos:prefLabel "19 Application"@en ;
    cml:realizedBy doc:sch-1-sec-19 ;
    values:originalText "Division 3 of Part 2-1 of the Proceeds of Crime Act 2002, as amended by this Part, applies in relation to restraining orders applied for on or after the commencement of this item, whether the conduct constituting the offence concerned occurred or occurs before, on or after that commencement." ;
    skos:definition "Division 3 of Part 2-1 of the Proceeds of Crime Act 2002, as amended by this Part, applies in relation to restraining orders applied for on or after the commencement of this item, whether the conduct constituting the offence concerned occurred or occurs before, on or after that commencement."@en ;
    cml:integrityHash "fbaae3a3cf32102c6c20d3662918eeef42183654a10b108ec592ba459bbecc5d" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Division 3 of Part 2-1 applies to restraining orders applied for on or after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
