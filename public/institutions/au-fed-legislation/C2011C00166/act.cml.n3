concept:act-sch-1-sec-197a a cml:Concept ;
    skos:prefLabel "197A Giving false or misleading answers or documents"@en ;
    cml:realizedBy doc:sch-1-sec-197a ;
    values:originalText "A person commits an offence if:  (a) the person is attending an *examination; and  (b) the person gives an answer or produces a document in the examination; and  (c) the answer or document:  (i) is false or misleading; or  (ii) omits any matter or thing without which it is misleading. Penalty: Imprisonment for 2 years or 120 penalty units, or both." ;
    skos:definition "A person commits an offence if:  (a) the person is attending an *examination; and  (b) the person gives an answer or produces a document in the examination; and  (c) the answer or document:  (i) is false or misleading; or  (ii) omits any matter or thing without which it is misleading. Penalty: Imprisonment for 2 years or 120 penalty units, or both."@en ;
    cml:integrityHash "342d04656b1b4111784de23ce9bcb0e28e86c43f8a16494fb03d299435ae5756" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Giving false or misleading answers or documents in an examination is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.36" ;
    cml:asserts concept:act-sch-1-sec-197a-norm .
