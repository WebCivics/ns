doc:sch-7-sec-6 a cof:Section ;
    cof:title "6 Subsection 4A(6) (definition of intelligence operation)" ;
    values:kind "section" ;
    values:originalText "Repeal the definition, substitute: intelligence operation means an operation that is primarily directed towards the collection, correlation, analysis or dissemination of criminal information and intelligence relating to relevant criminal activity, but that may involve the investigation of matters relating to relevant criminal activity." ;
    cof:pageNumber "131"^^xsd:integer .

