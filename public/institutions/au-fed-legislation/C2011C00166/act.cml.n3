doc:sch-1-sec-85 a cof:Section ;
    cof:title "85 Subsection 146(3)" ;
    values:kind "section" ;
    values:originalText "Repeal the subsection, substitute:  (3) A *pecuniary penalty order made in relation to a person’s conviction of an offence is discharged if:  (a) the person’s conviction of the offence is subsequently *quashed; and  (b) the order does not relate to any other offence; and  (c) the offence is not a *serious offence." ;
    cof:pageNumber "28"^^xsd:integer .

