concept:act-sch-3-sec-58 a cml:Concept ;
    skos:prefLabel "58 After paragraph 26(1)(b)"@en ;
    cml:realizedBy doc:sch-3-sec-58 ;
    values:originalText "Insert:  ; or (c) to divulge or communicate to or before such a body information, if:  (i) the information is about the identity of, or disclosure of the information is such as to reveal the identity of, an AFP employee or special member of the Australian Federal Police who is involved in the operation of the NWPP; and  (ii) the person has the information as a result of the performance of functions or duties, or the exercise of powers, under this Act;" ;
    skos:definition "Insert:  ; or (c) to divulge or communicate to or before such a body information, if:  (i) the information is about the identity of, or disclosure of the information is such as to reveal the identity of, an AFP employee or special member of the Australian Federal Police who is involved in the operation of the NWPP; and  (ii) the person has the information as a result of the performance of functions or duties, or the exercise of powers, under this Act;"@en ;
    cml:integrityHash "10657989450cf787c5eb5078783e5055783ad3d6aed09f8229b6e423c0a953ac" ;
    cof:pageNumber "97"^^xsd:integer ;
    skos:note "Prohibition on divulging or communicating information about AFP employees involved in NWPP operation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
