    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-3-sec-2010-5-ss-2 cml:asserts concept:act-sch-3-sec-2010-5-ss-2-logic-deontic-4 .
concept:act-sch-3-sec-2010-5-ss-2-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes an obligation on individuals to refrain from disclosing information about those undergoing assessment." ;
    cml:premiseText "(2) A person commits an offence if:  (a) the person discloses information about an individual; and  (b) the individual is undergoing assessment for inclusion in the NWPP at the time the information is disclosed; and  (c) if the individual were included in the NWPP following that assessment, the individual would be a Commonwealth participant or a Territory participant; and  (d) there is a risk that disclosure of the information will reveal that the individual is undergoing such assessment." ;
    cml:conclusionText "Penalty: Imprisonment for 2 years." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-3-sec-2010-5-ss-2 a cof:Section ;
    cof:title "2010(2) 83" ;
    values:kind "subsection" ;
    values:originalText "(2) A person commits an offence if:  (a) the person discloses information about an individual; and  (b) the individual is undergoing assessment for inclusion in the NWPP at the time the information is disclosed; and  (c) if the individual were included in the NWPP following that assessment, the individual would be a Commonwealth participant or a Territory participant; and  (d) there is a risk that disclosure of the information will reveal that the individual is undergoing such assessment. Penalty: Imprisonment for 2 years. Disclosure of information that may compromise security of Commonwealth or Territory participant" ;
    cof:pageNumber "89"^^xsd:integer .

concept:act-sch-3-sec-2010-5-ss-3 a cml:Concept ;
    skos:prefLabel "2010(3) 83"@en ;
    cml:realizedBy doc:sch-3-sec-2010-5-ss-3 ;
    values:originalText "(3) A person commits an offence if:  (a) the person discloses information about an individual; and  (b) the individual is a participant; and  (c) the individual is a Commonwealth participant or a Territory participant; and  (d) either or both of the following apply:  (i) the individual has a current NWPP identity at the time the information is disclosed and the information is about the original identity or a former NWPP identity of the individual;  (ii) there is a risk that disclosure of the information will reveal that the individual is a participant; and  (e) there is a risk that disclosure of the information will compromise the security of the individual. Penalty: Imprisonment for 10 years. ComLaw Authoritative Act C2011C00166  Schedule 3  Witness protection" ;
    skos:definition "(3) A person commits an offence if:  (a) the person discloses information about an individual; and  (b) the individual is a participant; and  (c) the individual is a Commonwealth participant or a Territory participant; and  (d) either or both of the following apply:  (i) the individual has a current NWPP identity at the time the information is disclosed and the information is about the original identity or a former NWPP identity of the individual;  (ii) there is a risk that disclosure of the information will reveal that the individual is a participant; and  (e) there is a risk that disclosure of the information will compromise the security of the individual. Penalty: Imprisonment for 10 years. ComLaw Authoritative Act C2011C00166  Schedule 3  Witness protection"@en ;
    cml:integrityHash "275a80f41d77cc49a22a8a138679101ed1b165c43a77b3530cedc8849068fac9" ;
    values:partOf concept:act-sch-3-sec-2010-5 ;
    cof:pageNumber "89"^^xsd:integer ;
    skos:note "Disclosing information about an individual who is a participant or has a current NWPP identity can lead to imprisonment for 10 years." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
