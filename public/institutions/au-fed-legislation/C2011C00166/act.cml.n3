concept:act-sch-1-sec-22 a cml:Concept ;
    skos:prefLabel "22 Paragraphs 73(1)(c), (d) and (e)"@en ;
    cml:realizedBy doc:sch-1-sec-22 ;
    values:originalText "Repeal the paragraphs, substitute:  (c) if the forfeiture order was (or the forfeiture order applied for would be) made under section 47 or 49—the court is satisfied that the applicant’s interest in the property is neither of the following:  (i) *proceeds of *unlawful activity;  (ii) if an offence on which the order was (or would be) based is a *serious offence—an instrument of any serious offence; and  (d) if the forfeiture order was (or the forfeiture order applied for would be) made under section 48—the court is satisfied that the applicant’s interest in the property is neither proceeds nor an instrument of any of the offences to which the forfeiture order or forfeiture application relates. ComLaw Authoritative Act C2011C00166  Schedule 1  Proceeds of crime" ;
    skos:definition "Repeal the paragraphs, substitute:  (c) if the forfeiture order was (or the forfeiture order applied for would be) made under section 47 or 49—the court is satisfied that the applicant’s interest in the property is neither of the following:  (i) *proceeds of *unlawful activity;  (ii) if an offence on which the order was (or would be) based is a *serious offence—an instrument of any serious offence; and  (d) if the forfeiture order was (or the forfeiture order applied for would be) made under section 48—the court is satisfied that the applicant’s interest in the property is neither proceeds nor an instrument of any of the offences to which the forfeiture order or forfeiture application relates. ComLaw Authoritative Act C2011C00166  Schedule 1  Proceeds of crime"@en ;
    cml:integrityHash "399cd00259da2c0bc19166a900f786b3d2b9d8fec716b4a17e7ddc9bcad9921d" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Court must satisfy conditions before forfeiting property" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.13" ;
    cml:asserts concept:act-sch-1-sec-22-norm .
