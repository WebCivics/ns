concept:act-sch-1-sec-60 a cml:Concept ;
    skos:prefLabel "60 Paragraph 102(1)(b)"@en ;
    cml:realizedBy doc:sch-1-sec-60 ;
    values:originalText "Repeal the paragraph, substitute:  (b) the court is satisfied that:  (i) the applicant had an interest in the property before the forfeiture of the property; and  (ii) the applicant’s interest in the property is neither *proceeds of unlawful activity nor an *instrument of unlawful activity; and  (iii) the applicant’s interest in the property was lawfully acquired;" ;
    skos:definition "Repeal the paragraph, substitute:  (b) the court is satisfied that:  (i) the applicant had an interest in the property before the forfeiture of the property; and  (ii) the applicant’s interest in the property is neither *proceeds of unlawful activity nor an *instrument of unlawful activity; and  (iii) the applicant’s interest in the property was lawfully acquired;"@en ;
