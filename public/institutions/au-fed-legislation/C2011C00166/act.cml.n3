doc:sch-2-sec-64-ss-1 a cof:Section ;
    cof:title "64(1) Crimes Legislation Amendment (Serious and Organised Crime) Act" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commissioner must take reasonable steps to return a thing seized under Division 3A if the owner requests the return of the thing." ;
