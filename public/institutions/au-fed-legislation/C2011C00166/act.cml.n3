concept:act-sch-5-sec-26 a cml:Concept ;
    skos:prefLabel "26 Section 5 (definition of stored value card)"@en ;
    cml:realizedBy doc:sch-5-sec-26 ;
    values:originalText "Repeal the definition, substitute: stored value card does not include a debit card or credit card but includes a portable device (other than a debit card or credit card) that:  (a) is capable of:  (i) storing monetary value in a form other than physical currency; or  (ii) being used to gain access to monetary value stored in such a form; and  (b) is of a kind prescribed by the regulations." ;
    skos:definition "Repeal the definition, substitute: stored value card does not include a debit card or credit card but includes a portable device (other than a debit card or credit card) that:  (a) is capable of:  (i) storing monetary value in a form other than physical currency; or  (ii) being used to gain access to monetary value stored in such a form; and  (b) is of a kind prescribed by the regulations."@en ;
    cml:integrityHash "d7e542396280e618ef014af00206d021f4e77b7f090077078cdc913554dabfbc" ;
    cof:pageNumber "123"^^xsd:integer ;
    skos:note "Defines stored value card, excluding debit and credit cards." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
