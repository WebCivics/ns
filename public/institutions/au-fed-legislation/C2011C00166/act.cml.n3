concept:act-sch-1-sec-95 a cml:Concept ;
    skos:prefLabel "95 Paragraph 335(6)(a)"@en ;
    cml:realizedBy doc:sch-1-sec-95 ;
    values:originalText "Repeal the paragraph, substitute:  (a) the order would, if made, be one of the following orders relating to an offence of which a person has been convicted:  (i) a *restraining order under section 17;  (ii) a *forfeiture order under section 48;  (iii) a *pecuniary penalty order under subparagraph 116(1)(b)(i); and" ;
    skos:definition "Repeal the paragraph, substitute:  (a) the order would, if made, be one of the following orders relating to an offence of which a person has been convicted:  (i) a *restraining order under section 17;  (ii) a *forfeiture order under section 48;  (iii) a *pecuniary penalty order under subparagraph 116(1)(b)(i); and"@en ;
    cml:integrityHash "bbe71816b03aaa609737633288af2a2705f0cd246ad7bb7d865d6bce94900c2b" ;
    cof:pageNumber "30"^^xsd:integer ;
