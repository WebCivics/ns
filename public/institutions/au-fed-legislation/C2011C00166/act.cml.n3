    cml:modality cml:Deontic ;
    cml:operator "Permission" ;
    cml:logicSummary "DPP's discretion to delay examinations" ;
    cml:premiseText "The DPP may delay conducting examinations if necessary." ;
    cml:conclusionText "However, the DPP need not do so until it has had a reasonable opportunity." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

