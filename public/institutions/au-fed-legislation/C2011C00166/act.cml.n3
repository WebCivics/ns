concept:act-sch-4-sec-2010-3 a cml:Concept ;
    skos:prefLabel "2010 101"@en ;
    cml:realizedBy doc:sch-4-sec-2010-3 ;
    values:originalText "(iii) within a Territory, between a State and a Territory or between 2 Territories; or  (g) involved:  (i) banking (other than State banking not extending beyond the limits of the State concerned); or  (ii) insurance (other than State insurance not extending beyond the limits of the State concerned); or  (h) relates to a matter outside Australia; or  (i) relates to a matter in respect of which an international agreement to which Australia is a party imposes obligations to which effect could be given by the creation of an offence against the domestic laws of the parties to the agreement; or  (j) relates to a matter that affects the relations between Australia and another country or countries or is otherwise a subject of international concern.  (5) Subsection (4) does not limit paragraph (2)(c). Subdivision B—Offences" ;
    skos:definition "(iii) within a Territory, between a State and a Territory or between 2 Territories; or  (g) involved:  (i) banking (other than State banking not extending beyond the limits of the State concerned); or  (ii) insurance (other than State insurance not extending beyond the limits of the State concerned); or  (h) relates to a matter outside Australia; or  (i) relates to a matter in respect of which an international agreement to which Australia is a party imposes obligations to which effect could be given by the creation of an offence against the domestic laws of the parties to the agreement; or  (j) relates to a matter that affects the relations between Australia and another country or countries or is otherwise a subject of international concern.  (5) Subsection (4) does not limit paragraph (2)(c). Subdivision B—Offences"@en ;
    cml:integrityHash "2e9d12b6258199b56b0d2a1211ea659008e52ab5e33b434cf76c44e35c7a7075" ;
    cof:pageNumber "107"^^xsd:integer ;
