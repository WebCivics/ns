    cml:modality cml:Deontic ;
    cml:operator "Permit" ;
    cml:logicSummary "Specify an earlier time for production order." ;
    cml:premiseText "(a) at least 14 days after the day on which the *production order is made;" ;
    cml:conclusionText "(b) if the magistrate who makes the production order is satisfied..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

