    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-13-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The adjustment overlaps with the conditions under which imposing an unjustifiable hardship would be unacceptable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "An adjustment is reasonable if it overlaps with the conditions under which imposing an unjustifiable hardship would be unacceptable.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Imposing an unjustifiable hardship would be unacceptable during this time period."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The adjustment is not reasonable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If making the adjustment would impose an unjustifiable hardship, then it is not a reasonable adjustment.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "Making the adjustment would impose an unjustifiable hardship."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-13-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The adjustment is not reasonable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "A reasonable adjustment is one that does not impose an unjustifiable hardship.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Not",
      "cml:premiseText": "The adjustment imposes an unjustifiable hardship."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-13-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The adjustment diffuses the conditions under which imposing an unjustifiable hardship would be unacceptable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "An adjustment is reasonable if it diffuses the conditions under which imposing an unjustifiable hardship would be unacceptable.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "Imposing an unjustifiable hardship will diffuse to this point."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-13-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The adjustment will eventually not impose an unjustifiable hardship.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "An adjustment is reasonable if it will eventually not impose an unjustifiable hardship.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Eventually",
      "cml:premiseText": "Imposing an unjustifiable hardship will eventually occur."
    },
