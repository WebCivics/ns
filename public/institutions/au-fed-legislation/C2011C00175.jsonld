    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-13",
      "@type": "cml:Concept",
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.10",
      "skos:note": "An adjustment is reasonable unless it imposes an unjustifiable hardship.",
