    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-8-2-ss-2-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Discriminator's failure to make reasonable adjustments occurs between the time they require or propose to require the aggrieved person to comply with a requirement or condition and the time the aggrieved person would be able to comply.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Discriminator's failure to make reasonable adjustments occurs between the time they require or propose to require the aggrieved person to comply with a requirement or condition and the time the aggrieved person would be able to comply.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Between",
      "cml:premiseText": "(a) the discriminator requires, or proposes to require, the aggrieved person to comply with a requirement or condition;"
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-8-2-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The discriminator must make reasonable adjustments for the aggrieved person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Discriminator has a duty to make reasonable adjustments.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:premiseText": "(a) the discriminator requires, or proposes to require, the aggrieved person to comply with a requirement or condition;"
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-8-2-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The discriminator must not make unreasonable demands on the aggrieved person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Discriminator has a duty to not discriminate against the aggrieved person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:premiseText": "(b) because of the disability, the aggrieved person would comply, or would be able to comply, with the requirement or condition only if the discriminator made reasonable adjustments for the person;"
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-8-2-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The discriminator must comply with the requirement or condition if it does not disadvantage persons with the disability.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Discriminator has a duty to comply with the requirement or condition if it does not disadvantage persons with the disability.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:premiseText": "(c) the failure to make reasonable adjustments has, or is likely to have, the effect of disadvantaging persons with the disability;"
    },
