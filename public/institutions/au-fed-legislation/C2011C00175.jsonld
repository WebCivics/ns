    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-22-2-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The request for evidence must occur during the specified conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes a temporal relationship between events.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The discriminator requests or requires evidence from the person with the disability during certain conditions."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-22-2-ss-6-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The animal is not trained to meet standards of hygiene and behaviour.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Describes a relationship between an agent and its training.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "isTrainedTo",
      "cml:premiseText": "The person with the disability neither produces evidence that the animal is trained to meet standards of hygiene and behaviour."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-22-2-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person with the disability can be discriminated against if certain conditions are met.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits discrimination against a person with a disability under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:premiseText": "The discriminator is not allowed to discriminate against the person with the disability."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-22-2-ss-6-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The request for evidence must occur until the specified conditions are met.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes a temporal relationship between events.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:premiseText": "The person with the disability neither produces evidence that the animal is an assistance animal nor produces evidence that the animal is trained to meet standards of hygiene and behaviour."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-22-2-ss-6-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The animal does not have a value.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:logicSummary": "Describes a relationship between a value and a node.",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "hasValue",
      "cml:premiseText": "The person with the disability neither produces evidence that the animal is an assistance animal nor produces evidence that the animal is trained to meet standards of hygiene and behaviour."
    },
