    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-8-2-ss-2",
      "@type": "cml:Concept",
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.12",
      "skos:note": "Discriminator must make reasonable adjustments for the aggrieved person.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "8(2) Disability Discrimination and Other Human Rights Legislation"
      },
      "wasDerivedFrom": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf",
