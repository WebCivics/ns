    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-22-2-ss-6",
      "@type": "cml:Concept",
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.26",
      "skos:note": "Discrimination against a person with a disability is not unlawful if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "22(6) Disability Discrimination and Other Human Rights Legislation"
      },
      "wasDerivedFrom": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf",
      "asserts": [
