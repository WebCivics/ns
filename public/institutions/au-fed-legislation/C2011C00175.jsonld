      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "45bb017e3469625e94e58dc6c93360a6d9e9a7cb3a34763eb4817cd7891a787d",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
