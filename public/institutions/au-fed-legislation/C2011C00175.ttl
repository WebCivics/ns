    <https://ns.webcivics.net/cml/operator> "during";
    <https://ns.webcivics.net/cml/logicSummary> "Describes a temporal relationship between events.";
    <https://ns.webcivics.net/cml/premiseText> "The discriminator requests or requires evidence from the person with the disability during certain conditions.";
    <https://ns.webcivics.net/cml/conclusionText> "The request for evidence must occur during the specified conditions.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
