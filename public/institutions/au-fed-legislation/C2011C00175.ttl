    <https://ns.webcivics.net/cml/operator> "forbid";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits discrimination against a person with a disability under certain conditions.";
    <https://ns.webcivics.net/cml/premiseText> "The discriminator is not allowed to discriminate against the person with the disability.";
    <https://ns.webcivics.net/cml/conclusionText> "The person with the disability can be discriminated against if certain conditions are met.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
