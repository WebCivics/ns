concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-4 a cml:Concept ;
    skos:prefLabel "4 Subsection 4(1)"@en ;
    cml:realizedBy doc:sch-2-sec-4 ;
    values:originalText "Insert: Disabilities Convention means the Convention on the Rights of Persons with Disabilities, done at New York on 30 March 2007, as in force for Australia. Note: The text of the Convention is set out in Australian Treaty Series 2008 No. 12 ([2008] ATS 12). In 2008, the text of a Convention in the Australian Treaty Series was accessible through the Australian Treaties Library on the AustLII website (www.austlii.edu.au)." ;
    skos:definition "Insert: Disabilities Convention means the Convention on the Rights of Persons with Disabilities, done at New York on 30 March 2007, as in force for Australia. Note: The text of the Convention is set out in Australian Treaty Series 2008 No. 12 ([2008] ATS 12). In 2008, the text of a Convention in the Australian Treaty Series was accessible through the Australian Treaties Library on the AustLII website (www.austlii.edu.au)."@en ;
    cml:integrityHash "fbdd419c2a67d1ab1a13125c285b9cef5a4bf7cdebf50e6f9cc9c0820180be7f" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Definition of Disabilities Convention" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
