    cof:title "54A(2) Assistance animals" ;
    values:kind "subsection" ;
    values:originalText "(2) This Part does not render it unlawful for a person to request or to require that the assistance animal remain under the control of:  (a) the person with the disability; or  (b) another person on behalf of the person with the disability." ;
    cof:pageNumber "25"^^xsd:integer .

