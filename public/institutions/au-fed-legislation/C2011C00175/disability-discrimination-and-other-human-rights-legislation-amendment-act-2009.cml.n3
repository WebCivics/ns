concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-159 a cml:Concept ;
    skos:prefLabel "159 Subsection 48(1)"@en ;
    cml:realizedBy doc:sch-3-sec-159 ;
    values:originalText "Repeal the subsection, substitute:  (1) Subsection (2) applies in relation to any of the following persons:  (a) the Commission;  (b) a member of the Commission;  (c) a person acting for or on behalf of:  (i) the Commission; or  (ii) a member of the Commission.  (2) The person is not liable to an action or other proceeding for damages for or in relation to an act done, or omitted to be done, in good faith in performance, or purported performance, of any function, or in exercise or purported exercise of any power, conferred on the Commission or the member." ;
    skos:definition "Repeal the subsection, substitute:  (1) Subsection (2) applies in relation to any of the following persons:  (a) the Commission;  (b) a member of the Commission;  (c) a person acting for or on behalf of:  (i) the Commission; or  (ii) a member of the Commission.  (2) The person is not liable to an action or other proceeding for damages for or in relation to an act done, or omitted to be done, in good faith in performance, or purported performance, of any function, or in exercise or purported exercise of any power, conferred on the Commission or the member."@en ;
    cml:integrityHash "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b" ;
    cof:pageNumber "50"^^xsd:integer ;
    cml:hasPart concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-159-ss-1 ;
    cml:hasPart concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-159-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
