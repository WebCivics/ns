concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-40 a cml:Concept ;
    skos:prefLabel "40 Subsection 21(2)"@en ;
    cml:realizedBy doc:sch-2-sec-40 ;
    values:originalText "Repeal the subsection, substitute:  (2) This Part does not require an employment agency to ensure that an employer complies with this Act.  (3) Subsection (2) does not affect the operation of section 122 (which applies if an employment agency causes, instructs, induces, aids or permits an employer to do an unlawful act)." ;
    skos:definition "Repeal the subsection, substitute:  (2) This Part does not require an employment agency to ensure that an employer complies with this Act.  (3) Subsection (2) does not affect the operation of section 122 (which applies if an employment agency causes, instructs, induces, aids or permits an employer to do an unlawful act)."@en ;
    cml:integrityHash "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b" ;
    cof:pageNumber "18"^^xsd:integer ;
