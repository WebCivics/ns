concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4 a cml:Concept ;
    skos:prefLabel "54A(4) Assistance animals"@en ;
    cml:realizedBy doc:sch-2-sec-54a-ss-4 ;
    values:originalText "(4) This Part does not render it unlawful for a person (the discriminator) to discriminate against the person with the disability on the ground of the disability, if:  (a) the discriminator reasonably suspects that the assistance animal has an infectious disease; and  (b) the discrimination is reasonably necessary to protect public health or the health of other animals." ;
    skos:definition "(4) This Part does not render it unlawful for a person (the discriminator) to discriminate against the person with the disability on the ground of the disability, if:  (a) the discriminator reasonably suspects that the assistance animal has an infectious disease; and  (b) the discrimination is reasonably necessary to protect public health or the health of other animals."@en ;
    cml:integrityHash "6f11cf64ed61c56fb6c89ff8f7ea16d9566bd8c6e6fec224a92f6fdf0d7a78c2" ;
    values:partOf concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Discrimination against a person with a disability is prohibited if the discriminator reasonably suspects an infectious disease and the discrimination is necessary to protect public health or animal health." ;
    cml:curationStatus cml:Proposed ;
