concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-132 a cml:Concept ;
    skos:prefLabel "132 Subsection 23(2)"@en ;
    cml:realizedBy doc:sch-3-sec-132 ;
    values:originalText "Repeal the subsection, substitute:  (2) A person commits an offence if:  (a) the person has been served with a notice under subsection 21(5); and  (b) the person:  (i) refuses or fails to comply with the notice; or  (ii) when attending before a member in compliance with the notice, refuses or fails to answer a question that is required by the member to be answered. Penalty: 10 penalty units." ;
    skos:definition "Repeal the subsection, substitute:  (2) A person commits an offence if:  (a) the person has been served with a notice under subsection 21(5); and  (b) the person:  (i) refuses or fails to comply with the notice; or  (ii) when attending before a member in compliance with the notice, refuses or fails to answer a question that is required by the member to be answered. Penalty: 10 penalty units."@en ;
    cml:integrityHash "72e7a2ea22feb2e09dbd00f05712dc88753c3b6005ede09d9ffeed7109f0cc06" ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Refusal to comply with notice results in an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf> ;
