doc:sch-2-sec-5-2-ss-2 a cof:Section ;
    cof:title "5(2) Direct disability discrimination" ;
    values:kind "subsection" ;
    values:originalText "(2) For the purposes of this Act, a person (the discriminator) also discriminates against another person (the aggrieved person) on the ground of a disability of the aggrieved person if:  (a) the discriminator does not make, or proposes not to make, reasonable adjustments for the person; and  (b) the failure to make the reasonable adjustments has, or would have, the effect that the aggrieved person is, because of the disability, treated less favourably than a person without the disability would be treated in circumstances that are not materially different." ;
    cof:pageNumber "11"^^xsd:integer .

concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-5-2-ss-3 a cml:Concept ;
    skos:prefLabel "5(3) Direct disability discrimination"@en ;
    cml:realizedBy doc:sch-2-sec-5-2-ss-3 ;
    values:originalText "(3) For the purposes of this section, circumstances are not materially different because of the fact that, because of the disability, the aggrieved person requires adjustments." ;
    skos:definition "(3) For the purposes of this section, circumstances are not materially different because of the fact that, because of the disability, the aggrieved person requires adjustments."@en ;
