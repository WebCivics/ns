concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-2009-9 a cml:Concept ;
    skos:prefLabel "2009 27"@en ;
    cml:realizedBy doc:sch-2-sec-2009-9 ;
    values:originalText "Note: A person does not comply with an industrial instrument for the purpose of subsection (1) if that person purports to comply with a provision of that instrument that is void (for example, a term of a pre-reform certified agreement is void to the extent that it contains prohibited content prescribed for section 356 of the Workplace Relations Act 1996 (see section 358 of that Act)). Accordingly, the exemption under this subsection for acting in direct compliance with such an instrument would not apply in such circumstances." ;
    skos:definition "Note: A person does not comply with an industrial instrument for the purpose of subsection (1) if that person purports to comply with a provision of that instrument that is void (for example, a term of a pre-reform certified agreement is void to the extent that it contains prohibited content prescribed for section 356 of the Workplace Relations Act 1996 (see section 358 of that Act)). Accordingly, the exemption under this subsection for acting in direct compliance with such an instrument would not apply in such circumstances."@en ;
    cml:integrityHash "cbefd2f0813cf89364c448ac8387c94a4b96a1b31fa2c4a9d5efa4cba75fdc63" ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Exemption under subsection (1) does not apply if the person purports to comply with a void provision of an industrial instrument." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
