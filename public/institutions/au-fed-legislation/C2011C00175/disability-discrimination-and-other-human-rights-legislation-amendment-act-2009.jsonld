    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-12-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Disability Discrimination and Other Human Rights Legislation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-12-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.16",
      "values:originalText": "Amendment Act 2009\n\n(e) any relevant action plans given to the Commission under\nsection 64.\nExample: One of the circumstances covered by paragraph (1)(a) is the nature of\nthe benefit or detriment likely to accrue to, or to be suffered by, the\ncommunity.\n\n(2) For the purposes of this Act, the burden of proving that something\nwould impose unjustifiable hardship lies on the person claiming\nunjustifiable hardship.",
      "skos:definition": "Amendment Act 2009\n\n(e) any relevant action plans given to the Commission under\nsection 64.\nExample: One of the circumstances covered by paragraph (1)(a) is the nature of\nthe benefit or detriment likely to accrue to, or to be suffered by, the\ncommunity.\n\n(2) For the purposes of this Act, the burden of proving that something\nwould impose unjustifiable hardship lies on the person claiming\nunjustifiable hardship.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-12-2-norm"
        }
      ],
      "cml:integrityHash": "eb6a32718616382848a8dbc338501748342711427cc3f6a6d64a3334f07c020b",
      "skos:note": "Burden of proof for unjustifiable hardship"
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-12-2",
      "@type": "cof:Section",
      "cof:title": "12 Disability Discrimination and Other Human Rights Legislation",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Amendment Act 2009\n\n(e) any relevant action plans given to the Commission under\nsection 64.\nExample: One of the circumstances covered by paragraph (1)(a) is the nature of\nthe benefit or detriment likely to accrue to, or to be suffered by, the\ncommunity.\n\n(2) For the purposes of this Act, the burden of proving that something\nwould impose unjustifiable hardship lies on the person claiming\nunjustifiable hardship."
    },
