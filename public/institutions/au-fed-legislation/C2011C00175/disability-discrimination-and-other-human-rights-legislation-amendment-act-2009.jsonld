    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-30-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Requests for information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-30-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.21",
      "values:originalText": "(1) This section applies in relation to a person (the first person) if,\nunder Division 1 or this Division, it would be unlawful for the first\nperson, in doing a particular act, to discriminate against another\nperson on the ground of a disability of the other person.\n\n(2) It is unlawful for the first person to request or require the other\nperson to provide information (whether by completing a form or\notherwise) if:\n\nSchedule 2  Disability discrimination",
      "skos:definition": "(1) This section applies in relation to a person (the first person) if,\nunder Division 1 or this Division, it would be unlawful for the first\nperson, in doing a particular act, to discriminate against another\nperson on the ground of a disability of the other person.\n\n(2) It is unlawful for the first person to request or require the other\nperson to provide information (whether by completing a form or\notherwise) if:\n\nSchedule 2  Disability discrimination",
      "cml:hasPart": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-30-2-ss-1"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-30-2-ss-2"
        }
      ],
      "cml:integrityHash": "37b1d834078fd6e5729502567de59cac8e101b19ca3716e226bc050e7800cc75"
    },
