        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-148-logic-diffusion-4"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-148-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "9f8724bcb1b90fb7d3344843dcdc45099b713a240aefa99b22f092ee0a5f6572",
      "skos:note": "Application of Human Rights and Equal Opportunity Commission Act 1986 to complaints made before, on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-148",
      "@type": "cof:Section",
      "cof:title": "148 Application",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "Subparagraph 32(3)(c)(vii) of the Human Rights and Equal Opportunity\nCommission Act 1986, as added by this Part, applies in relation to\ncomplaints made to the Commission before, on or after the\ncommencement of this Part."
    },
