    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-152",
      "@type": "cml:Concept",
      "skos:prefLabel": "152 At the end of section 46PF",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-152"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.49",
      "values:originalText": "Add:\n\n(5) The President may decide not to inquire into the complaint, or, if\nthe President has started inquiring into the complaint, may decide\nnot to continue to inquire into the complaint, if:\n\n(a) the President is satisfied that the person aggrieved by the\nalleged unlawful discrimination does not want the President\nto inquire, or to continue to inquire, into the complaint; or\n\n(b) the President is satisfied that the complaint has been settled\nor resolved.",
      "skos:definition": "Add:\n\n(5) The President may decide not to inquire into the complaint, or, if\nthe President has started inquiring into the complaint, may decide\nnot to continue to inquire into the complaint, if:\n\n(a) the President is satisfied that the person aggrieved by the\nalleged unlawful discrimination does not want the President\nto inquire, or to continue to inquire, into the complaint; or\n\n(b) the President is satisfied that the complaint has been settled\nor resolved.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-152-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-152-logic-deontic-1"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-152-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "1e7ef8bb978f04709865298ea5325541ed56f2f6beebbd8d564948efebb87567",
      "skos:note": "The President may decide not to inquire into a complaint under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-152",
      "@type": "cof:Section",
      "cof:title": "152 At the end of section 46PF",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Add:\n\n(5) The President may decide not to inquire into the complaint, or, if\nthe President has started inquiring into the complaint, may decide\nnot to continue to inquire into the complaint, if:\n\n(a) the President is satisfied that the person aggrieved by the\nalleged unlawful discrimination does not want the President\nto inquire, or to continue to inquire, into the complaint; or\n\n(b) the President is satisfied that the complaint has been settled\nor resolved."
    },
