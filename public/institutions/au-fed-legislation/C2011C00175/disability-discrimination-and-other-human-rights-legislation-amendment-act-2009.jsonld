    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "54A(3) Assistance animals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-54a-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
