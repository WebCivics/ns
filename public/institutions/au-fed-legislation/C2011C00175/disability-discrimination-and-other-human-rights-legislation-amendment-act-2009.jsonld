      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.48",
      "values:originalText": "Subparagraph 32(3)(c)(vii) of the Human Rights and Equal Opportunity\nCommission Act 1986, as added by this Part, applies in relation to\ncomplaints made to the Commission before, on or after the\ncommencement of this Part.",
      "skos:definition": "Subparagraph 32(3)(c)(vii) of the Human Rights and Equal Opportunity\nCommission Act 1986, as added by this Part, applies in relation to\ncomplaints made to the Commission before, on or after the\ncommencement of this Part.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-148-norm"
        },
