      "@type": "cof:Section",
      "cof:title": "153 Application",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Subsection 46PF(5) of the Human Rights and Equal Opportunity\nCommission Act 1986, as added by this Part, applies in relation to\ncomplaints referred to the President before, on or after the\ncommencement of this Part."
    },
