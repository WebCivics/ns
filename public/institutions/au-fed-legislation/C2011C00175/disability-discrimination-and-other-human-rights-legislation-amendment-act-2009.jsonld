      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-132",
      "@type": "cml:Concept",
      "skos:prefLabel": "132 Subsection 23(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-132"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.47",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) A person commits an offence if:\n\n(a) the person has been served with a notice under subsection\n21(5); and\n\n(b) the person:\n\n(i) refuses or fails to comply with the notice; or\n\n(ii) when attending before a member in compliance with the\nnotice, refuses or fails to answer a question that is\nrequired by the member to be answered.\nPenalty: 10 penalty units.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) A person commits an offence if:\n\n(a) the person has been served with a notice under subsection\n21(5); and\n\n(b) the person:\n\n(i) refuses or fails to comply with the notice; or\n\n(ii) when attending before a member in compliance with the\nnotice, refuses or fails to answer a question that is\nrequired by the member to be answered.\nPenalty: 10 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-132-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-132-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "72e7a2ea22feb2e09dbd00f05712dc88753c3b6005ede09d9ffeed7109f0cc06",
      "skos:note": "Refusal to comply with notice results in an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-132",
      "@type": "cof:Section",
      "cof:title": "132 Subsection 23(2)",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) A person commits an offence if:\n\n(a) the person has been served with a notice under subsection\n21(5); and\n\n(b) the person:\n\n(i) refuses or fails to comply with the notice; or\n\n(ii) when attending before a member in compliance with the\nnotice, refuses or fails to answer a question that is\nrequired by the member to be answered.\nPenalty: 10 penalty units."
    },
