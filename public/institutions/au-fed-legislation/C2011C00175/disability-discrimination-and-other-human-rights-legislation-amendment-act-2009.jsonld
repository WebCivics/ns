      "cml:integrityHash": "d36c58a54d51a9c50287d6652cda68832ec3fda3a9bc44ba4cfaec6bf9646713",
      "skos:note": "An assistance animal may be under the control of a person even if it is not under the person’s direct physical control."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-54a-ss-3",
      "@type": "cof:Section",
      "cof:title": "54A(3) Assistance animals",
      "values:kind": "subsection",
      "cof:pageNumber": 25,
      "values:originalText": "(3) For the purposes of subsection (2), an assistance animal may be\nunder the control of a person even if it is not under the person’s\ndirect physical control."
    },
