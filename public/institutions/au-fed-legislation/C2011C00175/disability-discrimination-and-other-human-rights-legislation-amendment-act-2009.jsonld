    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-29a",
      "@type": "cml:Concept",
      "skos:prefLabel": "29A Unjustifiable hardship",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-29a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.21",
      "values:originalText": "This Division (other than section 30) does not render it unlawful\nfor a person (the discriminator) to discriminate against another\nperson on the ground of a disability of the other person if avoiding\nthe discrimination would impose an unjustifiable hardship on the\ndiscriminator.",
      "skos:definition": "This Division (other than section 30) does not render it unlawful\nfor a person (the discriminator) to discriminate against another\nperson on the ground of a disability of the other person if avoiding\nthe discrimination would impose an unjustifiable hardship on the\ndiscriminator.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-29a-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-29a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6cbb29a06bae227cdab9e31aee9460d6cb1d1b2f4cd4c7ae6bbc51fa2460c54e",
      "skos:note": "No discrimination is unlawful if it would impose an unjustifiable hardship on the discriminator."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-29a",
      "@type": "cof:Section",
      "cof:title": "29A Unjustifiable hardship",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "This Division (other than section 30) does not render it unlawful\nfor a person (the discriminator) to discriminate against another\nperson on the ground of a disability of the other person if avoiding\nthe discrimination would impose an unjustifiable hardship on the\ndiscriminator."
    },
