      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.25",
      "values:originalText": "Divisions 1, 2 and 2A do not:\n\n(a) affect discriminatory provisions in:\n\n(i) the Migration Act 1958; or\n\n(ii) a legislative instrument made under that Act; or\n\n(b) render unlawful anything that is permitted or required to be\ndone by that Act or instrument.",
      "skos:definition": "Divisions 1, 2 and 2A do not:\n\n(a) affect discriminatory provisions in:\n\n(i) the Migration Act 1958; or\n\n(ii) a legislative instrument made under that Act; or\n\n(b) render unlawful anything that is permitted or required to be\ndone by that Act or instrument.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-52-2-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-52-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "250f4a7cafc280d1d03b105400d7d66fe414f08ca280514f39552cc0e4cd2ad3",
      "skos:note": "Does not affect discriminatory provisions in the Migration Act 1958 or a legislative instrument made under that Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-52-2",
      "@type": "cof:Section",
      "cof:title": "52 Migration",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Divisions 1, 2 and 2A do not:\n\n(a) affect discriminatory provisions in:\n\n(i) the Migration Act 1958; or\n\n(ii) a legislative instrument made under that Act; or\n\n(b) render unlawful anything that is permitted or required to be\ndone by that Act or instrument."
    },
