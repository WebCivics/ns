    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "54A(4) Assistance animals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-54a-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.25",
      "values:originalText": "(4) This Part does not render it unlawful for a person (the\ndiscriminator) to discriminate against the person with the disability\non the ground of the disability, if:\n\n(a) the discriminator reasonably suspects that the assistance\nanimal has an infectious disease; and\n\n(b) the discrimination is reasonably necessary to protect public\nhealth or the health of other animals.",
      "skos:definition": "(4) This Part does not render it unlawful for a person (the\ndiscriminator) to discriminate against the person with the disability\non the ground of the disability, if:\n\n(a) the discriminator reasonably suspects that the assistance\nanimal has an infectious disease; and\n\n(b) the discrimination is reasonably necessary to protect public\nhealth or the health of other animals.",
      "values:partOf": {
        "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a"
      },
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4-logic-ltl-3"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4-logic-deontic-4"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "6f11cf64ed61c56fb6c89ff8f7ea16d9566bd8c6e6fec224a92f6fdf0d7a78c2",
      "skos:note": "Discrimination against a person with a disability is prohibited if the discriminator reasonably suspects an infectious disease and the discrimination is necessary to protect public health or animal health."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-54a-ss-4",
      "@type": "cof:Section",
      "cof:title": "54A(4) Assistance animals",
      "values:kind": "subsection",
      "cof:pageNumber": 25,
      "values:originalText": "(4) This Part does not render it unlawful for a person (the\ndiscriminator) to discriminate against the person with the disability\non the ground of the disability, if:\n\n(a) the discriminator reasonably suspects that the assistance\nanimal has an infectious disease; and\n\n(b) the discrimination is reasonably necessary to protect public\nhealth or the health of other animals."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-54a-ss-4-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
