    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-2009",
      "@type": "cml:Concept",
      "skos:prefLabel": "2009 11",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-2009"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
