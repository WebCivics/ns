      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.46",
      "values:originalText": "Subparagraph 20(2)(c)(vii) of the Human Rights and Equal Opportunity\nCommission Act 1986, as added by this Part, applies in relation to\ncomplaints made to the Commission before, on or after the\ncommencement of this Part.",
      "skos:definition": "Subparagraph 20(2)(c)(vii) of the Human Rights and Equal Opportunity\nCommission Act 1986, as added by this Part, applies in relation to\ncomplaints made to the Commission before, on or after the\ncommencement of this Part.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-130-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-130-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2158a51e761ea8471c67efd1884ed2916c0c916d4f0fc0fecd5a1d7cdc9c0e66",
      "skos:note": "Application of Human Rights and Equal Opportunity Commission Act 1986 to complaints made before, on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-130",
      "@type": "cof:Section",
      "cof:title": "130 Application",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "Subparagraph 20(2)(c)(vii) of the Human Rights and Equal Opportunity\nCommission Act 1986, as added by this Part, applies in relation to\ncomplaints made to the Commission before, on or after the\ncommencement of this Part."
    },
