    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-4-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-4-sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.7",
      "values:originalText": "(1) Each Act, and each set of regulations, that is specified in a\nSchedule to this Act is amended or repealed as set out in the\napplicable items in the Schedule concerned, and any other item in a\nSchedule to this Act has effect according to its terms.\n\n(2) The amendment of any regulation under subsection (1) does not\nprevent the regulation, as so amended, from being amended or\nrepealed by the Governor-General.\n\nSchedule 1  Age discrimination",
      "skos:definition": "(1) Each Act, and each set of regulations, that is specified in a\nSchedule to this Act is amended or repealed as set out in the\napplicable items in the Schedule concerned, and any other item in a\nSchedule to this Act has effect according to its terms.\n\n(2) The amendment of any regulation under subsection (1) does not\nprevent the regulation, as so amended, from being amended or\nrepealed by the Governor-General.\n\nSchedule 1  Age discrimination",
      "cml:hasPart": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-4-sec-3-2-ss-1"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-4-sec-3-2-ss-2"
        }
      ],
      "cml:integrityHash": "c93d3bb651bdbb91647158e00ce7b1bcf23c068a31badd397457265e9727e98b"
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-4-sec-3-2",
