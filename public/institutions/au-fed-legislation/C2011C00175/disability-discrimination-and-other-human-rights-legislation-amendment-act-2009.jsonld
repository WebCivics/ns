    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-2009-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "2009 27",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-2009-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.31",
      "values:originalText": "Note:\nA person does not comply with an industrial instrument for the\npurpose of subsection (1) if that person purports to comply with a\nprovision of that instrument that is void (for example, a term of a\npre-reform certified agreement is void to the extent that it contains\nprohibited content prescribed for section 356 of the Workplace\nRelations Act 1996 (see section 358 of that Act)). Accordingly, the\nexemption under this subsection for acting in direct compliance with\nsuch an instrument would not apply in such circumstances.",
      "skos:definition": "Note:\nA person does not comply with an industrial instrument for the\npurpose of subsection (1) if that person purports to comply with a\nprovision of that instrument that is void (for example, a term of a\npre-reform certified agreement is void to the extent that it contains\nprohibited content prescribed for section 356 of the Workplace\nRelations Act 1996 (see section 358 of that Act)). Accordingly, the\nexemption under this subsection for acting in direct compliance with\nsuch an instrument would not apply in such circumstances.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-2009-9-norm"
        }
      ],
      "cml:integrityHash": "cbefd2f0813cf89364c448ac8387c94a4b96a1b31fa2c4a9d5efa4cba75fdc63",
      "skos:note": "Exemption under subsection (1) does not apply if the person purports to comply with a void provision of an industrial instrument."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-2009-9",
      "@type": "cof:Section",
      "cof:title": "2009 27",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Note:\nA person does not comply with an industrial instrument for the\npurpose of subsection (1) if that person purports to comply with a\nprovision of that instrument that is void (for example, a term of a\npre-reform certified agreement is void to the extent that it contains\nprohibited content prescribed for section 356 of the Workplace\nRelations Act 1996 (see section 358 of that Act)). Accordingly, the\nexemption under this subsection for acting in direct compliance with\nsuch an instrument would not apply in such circumstances."
    },
