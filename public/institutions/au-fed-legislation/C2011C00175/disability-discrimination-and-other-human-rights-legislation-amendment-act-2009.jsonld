      "cml:integrityHash": "28319a215adba4a8a203c616eedc7cc022b3f5447d8a2e316a1c6eafe0bf4312",
      "skos:note": "This section applies in relation to a person with a disability who has an assistance animal."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-54a-ss-1",
      "@type": "cof:Section",
      "cof:title": "54A(1) Assistance animals",
      "values:kind": "subsection",
      "cof:pageNumber": 25,
      "values:originalText": "(1) This section applies in relation to a person with a disability who\nhas an assistance animal.\nNote:\nFor when a person with a disability has an assistance animal, see\nsubsections 9(2) and (4)."
    },
