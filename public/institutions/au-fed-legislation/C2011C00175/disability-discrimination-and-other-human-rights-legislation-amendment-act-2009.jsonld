      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.49",
      "values:originalText": "The amendment of subsection 46PO(2) of the Human Rights and Equal\nOpportunity Commission Act 1986 made by this Part applies in relation\nto a notice issued under subsection 46PH(2) of that Act:\n\n(a) within 28 days before the commencement of this Part; or\n\n(b) on or after the commencement of this Part.",
      "skos:definition": "The amendment of subsection 46PO(2) of the Human Rights and Equal\nOpportunity Commission Act 1986 made by this Part applies in relation\nto a notice issued under subsection 46PH(2) of that Act:\n\n(a) within 28 days before the commencement of this Part; or\n\n(b) on or after the commencement of this Part.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-155-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-155-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "e045e7b390d0cae210de6145de003d9ca7b811579c76153b81626826452dac71",
      "skos:note": "Amendment applies within 28 days before or on commencement of Part."
    },
    {
