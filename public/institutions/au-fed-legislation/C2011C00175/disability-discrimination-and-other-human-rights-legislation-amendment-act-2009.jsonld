    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Subsection 4(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
