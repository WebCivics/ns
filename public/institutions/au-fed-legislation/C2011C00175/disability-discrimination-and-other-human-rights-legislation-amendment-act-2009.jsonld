      "@type": "cml:Concept",
      "skos:prefLabel": "52 Migration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-52-2"
      },
      "cml:curationStatus": {
