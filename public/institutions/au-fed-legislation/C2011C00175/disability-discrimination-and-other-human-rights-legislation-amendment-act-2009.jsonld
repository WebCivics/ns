    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-63",
      "@type": "cml:Concept",
      "skos:prefLabel": "63 Saving—disability standards",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-63"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.23",
      "values:originalText": "(1)\nThis item applies in relation to a disability standard:\n\n(a) made under section 31 of the Disability Discrimination Act\n1992; and\n\n(b) in force immediately before the commencement of this Part.\n(2)\nThe disability standard has effect, from the commencement of this Part,\nas if it had been made under that section as amended by this Part.",
      "skos:definition": "(1)\nThis item applies in relation to a disability standard:\n\n(a) made under section 31 of the Disability Discrimination Act\n1992; and\n\n(b) in force immediately before the commencement of this Part.\n(2)\nThe disability standard has effect, from the commencement of this Part,\nas if it had been made under that section as amended by this Part.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-63-norm"
        }
      ],
      "cml:integrityHash": "325c09d4c60a864bed6aa8e13778ec5034c9173d8422a3b8a02aeac0c95cfb74",
      "skos:note": "Saving—disability standards"
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-63",
      "@type": "cof:Section",
      "cof:title": "63 Saving—disability standards",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "(1)\nThis item applies in relation to a disability standard:\n\n(a) made under section 31 of the Disability Discrimination Act\n1992; and\n\n(b) in force immediately before the commencement of this Part.\n(2)\nThe disability standard has effect, from the commencement of this Part,\nas if it had been made under that section as amended by this Part."
    },
