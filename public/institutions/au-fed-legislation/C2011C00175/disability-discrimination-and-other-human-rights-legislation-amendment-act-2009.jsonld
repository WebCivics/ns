    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-177",
      "@type": "cml:Concept",
      "skos:prefLabel": "177 Subsection 45(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-177"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.52",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1A) Subsection (1) applies in relation to any of the following persons:\n\n(a) the Commission;\n\n(b) the Commissioner or another member of the Commission;\n\n(c) a person acting under the direction or authority of:\n\n(i) the Commission; or\n\n(ii) the Commissioner or another member of the\nCommission;\n\n(d) a person acting under a delegation under section 40.\n\n(1) The person is not liable to an action or other proceeding for\ndamages for or in relation to an act done, or omitted to be done, in\ngood faith in the performance, or purported performance, of any\nfunction, or in the exercise or purported exercise of any power or\nauthority, conferred on the Commission, the Commissioner or the\nother member of the Commission.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1A) Subsection (1) applies in relation to any of the following persons:\n\n(a) the Commission;\n\n(b) the Commissioner or another member of the Commission;\n\n(c) a person acting under the direction or authority of:\n\n(i) the Commission; or\n\n(ii) the Commissioner or another member of the\nCommission;\n\n(d) a person acting under a delegation under section 40.\n\n(1) The person is not liable to an action or other proceeding for\ndamages for or in relation to an act done, or omitted to be done, in\ngood faith in the performance, or purported performance, of any\nfunction, or in the exercise or purported exercise of any power or\nauthority, conferred on the Commission, the Commissioner or the\nother member of the Commission.",
      "cml:hasPart": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-177-ss-1a"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-177-ss-1"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-177",
      "@type": "cof:Section",
      "cof:title": "177 Subsection 45(1)",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1A) Subsection (1) applies in relation to any of the following persons:\n\n(a) the Commission;\n\n(b) the Commissioner or another member of the Commission;\n\n(c) a person acting under the direction or authority of:\n\n(i) the Commission; or\n\n(ii) the Commissioner or another member of the\nCommission;\n\n(d) a person acting under a delegation under section 40.\n\n(1) The person is not liable to an action or other proceeding for\ndamages for or in relation to an act done, or omitted to be done, in\ngood faith in the performance, or purported performance, of any\nfunction, or in the exercise or purported exercise of any power or\nauthority, conferred on the Commission, the Commissioner or the\nother member of the Commission."
    },
