      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf"
      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.9",
      "values:originalText": "Insert:\nDisabilities Convention means the Convention on the Rights of\nPersons with Disabilities, done at New York on 30 March 2007, as\nin force for Australia.\nNote:\nThe text of the Convention is set out in Australian Treaty Series 2008\nNo. 12 ([2008] ATS 12). In 2008, the text of a Convention in the\nAustralian Treaty Series was accessible through the Australian\nTreaties Library on the AustLII website (www.austlii.edu.au).",
      "skos:definition": "Insert:\nDisabilities Convention means the Convention on the Rights of\nPersons with Disabilities, done at New York on 30 March 2007, as\nin force for Australia.\nNote:\nThe text of the Convention is set out in Australian Treaty Series 2008\nNo. 12 ([2008] ATS 12). In 2008, the text of a Convention in the\nAustralian Treaty Series was accessible through the Australian\nTreaties Library on the AustLII website (www.austlii.edu.au).",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-4-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-4-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "fbdd419c2a67d1ab1a13125c285b9cef5a4bf7cdebf50e6f9cc9c0820180be7f",
      "skos:note": "Definition of Disabilities Convention"
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsection 4(1)",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Insert:\nDisabilities Convention means the Convention on the Rights of\nPersons with Disabilities, done at New York on 30 March 2007, as\nin force for Australia.\nNote:\nThe text of the Convention is set out in Australian Treaty Series 2008\nNo. 12 ([2008] ATS 12). In 2008, the text of a Convention in the\nAustralian Treaty Series was accessible through the Australian\nTreaties Library on the AustLII website (www.austlii.edu.au)."
    },
