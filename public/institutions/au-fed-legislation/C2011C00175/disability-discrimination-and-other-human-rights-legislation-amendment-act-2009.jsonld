      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-4-sec-9-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires relation between identifiable temporal intervals for conditional commencement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Later of two dates specified in paragraph (a) and (b)",
      "cml:conclusionText": "Temporal interval relation required"
    },
