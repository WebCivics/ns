      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.26",
      "values:originalText": "This Part applies in relation to a person (the action planner) who,\nunder Part 2, is prohibited from discriminating against another\nperson on the ground of a disability of the other person.",
      "skos:definition": "This Part applies in relation to a person (the action planner) who,\nunder Part 2, is prohibited from discriminating against another\nperson on the ground of a disability of the other person.",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-59-2-norm"
        },
