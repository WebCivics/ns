    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-10-2",
      "@type": "cof:Section",
      "cof:title": "10 Disability Discrimination and Other Human Rights Legislation",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Amendment Act 2009\nNote:\nThe combined effect of sections 7 and 8 is that this Act applies in\nrelation to a person who has an associate who has a carer, assistant,\nassistance animal or disability aid in the same way as it applies in\nrelation to a person with a disability."
    },
