      "skos:note": "Prohibition on discrimination against persons with disabilities."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-59-2",
      "@type": "cof:Section",
      "cof:title": "59 Scope",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "This Part applies in relation to a person (the action planner) who,\nunder Part 2, is prohibited from discriminating against another\nperson on the ground of a disability of the other person."
    },
