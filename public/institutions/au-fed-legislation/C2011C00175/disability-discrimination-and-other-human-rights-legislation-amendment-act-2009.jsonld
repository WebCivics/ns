      },
      "dc:source": "disability-discrimination-and-other-human-rights-legislation-amendment-act-2009.pdf, p.36",
      "values:originalText": "Omit “Human Rights and Equal Opportunity Commission Act 1986”,\nsubstitute “Australian Human Rights Commission Act 1986”.\nNote:\nThis item amends the short title of the Act. If another amendment of the Act is\ndescribed by reference to the Act’s previous short title, that other amendment has effect\nafter the commencement of this item as an amendment of the Act under its amended\nshort title (see section 10 of the Acts Interpretation Act 1901).",
      "skos:definition": "Omit “Human Rights and Equal Opportunity Commission Act 1986”,\nsubstitute “Australian Human Rights Commission Act 1986”.\nNote:\nThis item amends the short title of the Act. If another amendment of the Act is\ndescribed by reference to the Act’s previous short title, that other amendment has effect\nafter the commencement of this item as an amendment of the Act under its amended\nshort title (see section 10 of the Acts Interpretation Act 1901).",
      "cml:asserts": [
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-35-norm"
        },
        {
          "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-3-sec-35-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9883baff762b6be74defaa7685760793d80f05a3b451f84a86e11e36db653be0",
      "skos:note": "Amend short title of Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-35",
      "@type": "cof:Section",
      "cof:title": "35 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "Omit “Human Rights and Equal Opportunity Commission Act 1986”,\nsubstitute “Australian Human Rights Commission Act 1986”.\nNote:\nThis item amends the short title of the Act. If another amendment of the Act is\ndescribed by reference to the Act’s previous short title, that other amendment has effect\nafter the commencement of this item as an amendment of the Act under its amended\nshort title (see section 10 of the Acts Interpretation Act 1901)."
    },
