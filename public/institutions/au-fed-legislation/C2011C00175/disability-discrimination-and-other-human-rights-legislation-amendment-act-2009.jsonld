      "cml:integrityHash": "2ae703f8672ccfd9f1afb530036d144d6c386fb2d9f10b89b666ebdc9e5e439d",
      "skos:note": "An adjustment is reasonable unless it imposes an unjustifiable hardship."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-2-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Subsection 4(1)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Insert:\nreasonable adjustment: an adjustment to be made by a person is a\nreasonable adjustment unless making the adjustment would\nimpose an unjustifiable hardship on the person."
    },
    {
      "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-13-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:disability-discrimination-and-other-human-rights-legislation-amendment-act-2009-sch-2-sec-13"
      },
