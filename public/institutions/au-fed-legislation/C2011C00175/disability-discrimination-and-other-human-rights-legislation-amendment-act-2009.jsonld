        }
      ],
      "cml:integrityHash": "2611c7973b3e4b5453a582944eaff89b823336eb567e548b3c7a7a53528600b6",
      "skos:note": "Subsections of Human Rights and Equal Opportunity Commission Act apply to declarations made after or before commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/disability-discrimination-and-other-human-rights-legislation-amendment-act-2009#sch-3-sec-158",
      "@type": "cof:Section",
      "cof:title": "158 Application",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "(1)\nSubsection 47(2) of the Human Rights and Equal Opportunity\nCommission Act 1986, as amended by this Part, applies to declarations\nmade after the commencement of this Part.\n(2)\nSubsection 47(3) of the Human Rights and Equal Opportunity\nCommission Act 1986, as amended by this Part, applies to declarations\nmade before, on or after the commencement of this Part."
    },
