concept:national-crime-authority-status-and-rights-of-former-chairman-act-1984-sec-4 a cml:Concept ;
    skos:prefLabel "4 Application"@en ;
    cml:realizedBy doc:sec-4 ;
    values:originalText "This Act applies in relation to the Honourable Donald Gerard Stewart, being the person holding office at the commencement of this Act as the Chairman of the National Crime Authority, but so applies only if he has, whether before or after the commencement of this Act, resigned his office as a Judge of the Supreme Court of New South Wales." ;
    skos:definition "This Act applies in relation to the Honourable Donald Gerard Stewart, being the person holding office at the commencement of this Act as the Chairman of the National Crime Authority, but so applies only if he has, whether before or after the commencement of this Act, resigned his office as a Judge of the Supreme Court of New South Wales."@en ;
    cml:integrityHash "978b474bcb4b458dc243bdefe2ccb52515f5be5f52345c2c7e76d634d731aed2" ;
    cof:pageNumber "6"^^xsd:integer ;
    skos:note "The Act applies only if the Chairman of the National Crime Authority has resigned his office as a Judge of the Supreme Court of New South Wales." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
