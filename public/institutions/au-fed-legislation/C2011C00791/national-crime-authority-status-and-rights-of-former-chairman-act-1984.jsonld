      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "national-crime-authority-status-and-rights-of-former-chairman-act-1984.pdf"
      },
      "dc:source": "national-crime-authority-status-and-rights-of-former-chairman-act-1984.pdf, p.6",
      "values:originalText": "This Act applies in relation to the Honourable Donald Gerard\nStewart, being the person holding office at the commencement of\nthis Act as the Chairman of the National Crime Authority, but so\napplies only if he has, whether before or after the commencement\nof this Act, resigned his office as a Judge of the Supreme Court of\nNew South Wales.",
      "skos:definition": "This Act applies in relation to the Honourable Donald Gerard\nStewart, being the person holding office at the commencement of\nthis Act as the Chairman of the National Crime Authority, but so\napplies only if he has, whether before or after the commencement\nof this Act, resigned his office as a Judge of the Supreme Court of\nNew South Wales.",
      "cml:asserts": [
        {
          "@id": "concept:national-crime-authority-status-and-rights-of-former-chairman-act-1984-sec-4-norm"
        },
        {
          "@id": "concept:national-crime-authority-status-and-rights-of-former-chairman-act-1984-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "978b474bcb4b458dc243bdefe2ccb52515f5be5f52345c2c7e76d634d731aed2",
      "skos:note": "The Act applies only if the Chairman of the National Crime Authority has resigned his office as a Judge of the Supreme Court of New South Wales."
    },
    {
      "@id": "https://ns.webcivics.net/values/national-crime-authority-status-and-rights-of-former-chairman-act-1984#sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Application",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "This Act applies in relation to the Honourable Donald Gerard\nStewart, being the person holding office at the commencement of\nthis Act as the Chairman of the National Crime Authority, but so\napplies only if he has, whether before or after the commencement\nof this Act, resigned his office as a Judge of the Supreme Court of\nNew South Wales."
    },
