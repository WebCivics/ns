    {
      "@id": "concept:national-crime-authority-status-and-rights-of-former-chairman-act-1984-sec-9-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "9(2) Modification of Administrative Appeals Tribunal Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/national-crime-authority-status-and-rights-of-former-chairman-act-1984#sec-9-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "national-crime-authority-status-and-rights-of-former-chairman-act-1984.pdf"
      },
      "dc:source": "national-crime-authority-status-and-rights-of-former-chairman-act-1984.pdf, p.9",
      "values:originalText": "(2) If the Honourable Donald Gerard Stewart is appointed to hold\noffice as a full-time Deputy President of the Administrative\nAppeals Tribunal by an appointment that takes effect at a time\nwhen he holds the office of Chairman of the National Crime\nAuthority then, while he holds the second-mentioned office, he is\nnot entitled to receive any remuneration in respect of his holding\nthe first-mentioned office except to the extent (if any) to which the\nremuneration that, but for this subsection, would be payable to him\nin respect of his holding the first-mentioned office exceeds the\nremuneration payable to him in respect of his holding the\nsecond-mentioned office.",
      "skos:definition": "(2) If the Honourable Donald Gerard Stewart is appointed to hold\noffice as a full-time Deputy President of the Administrative\nAppeals Tribunal by an appointment that takes effect at a time\nwhen he holds the office of Chairman of the National Crime\nAuthority then, while he holds the second-mentioned office, he is\nnot entitled to receive any remuneration in respect of his holding\nthe first-mentioned office except to the extent (if any) to which the\nremuneration that, but for this subsection, would be payable to him\nin respect of his holding the first-mentioned office exceeds the\nremuneration payable to him in respect of his holding the\nsecond-mentioned office.",
      "values:partOf": {
        "@id": "concept:national-crime-authority-status-and-rights-of-former-chairman-act-1984-sec-9"
      },
      "cml:asserts": [
        {
          "@id": "concept:national-crime-authority-status-and-rights-of-former-chairman-act-1984-sec-9-ss-2-norm"
        },
        {
          "@id": "concept:national-crime-authority-status-and-rights-of-former-chairman-act-1984-sec-9-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e62c1c2f4f1725c2bcd50f1209929cbcc41454cd957929bdb1ab728341fc3d36",
      "skos:note": "No remuneration for holding both offices"
    },
    {
      "@id": "https://ns.webcivics.net/values/national-crime-authority-status-and-rights-of-former-chairman-act-1984#sec-9-ss-2",
      "@type": "cof:Section",
      "cof:title": "9(2) Modification of Administrative Appeals Tribunal Act",
      "values:kind": "subsection",
      "cof:pageNumber": 9,
      "values:originalText": "(2) If the Honourable Donald Gerard Stewart is appointed to hold\noffice as a full-time Deputy President of the Administrative\nAppeals Tribunal by an appointment that takes effect at a time\nwhen he holds the office of Chairman of the National Crime\nAuthority then, while he holds the second-mentioned office, he is\nnot entitled to receive any remuneration in respect of his holding\nthe first-mentioned office except to the extent (if any) to which the\nremuneration that, but for this subsection, would be payable to him\nin respect of his holding the first-mentioned office exceeds the\nremuneration payable to him in respect of his holding the\nsecond-mentioned office."
    },
