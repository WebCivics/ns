    {
      "@id": "concept:national-crime-authority-status-and-rights-of-former-chairman-act-1984-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/national-crime-authority-status-and-rights-of-former-chairman-act-1984#sec-4"
      },
      "cml:curationStatus": {
