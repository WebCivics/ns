      "@type": "cml:Concept",
      "skos:prefLabel": "9(3) Modification of Administrative Appeals Tribunal Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/national-crime-authority-status-and-rights-of-former-chairman-act-1984#sec-9-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
