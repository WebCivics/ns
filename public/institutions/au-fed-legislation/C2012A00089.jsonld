      "cml:logicSummary": "Forbids certain actions by the Commissioner",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:premiseText": "(d) if the Commissioner is absent, except on leave of absence, for 14 consecutive days or for 28 days in any 12 months;"
    },
    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-8-logic-deontic-3",
