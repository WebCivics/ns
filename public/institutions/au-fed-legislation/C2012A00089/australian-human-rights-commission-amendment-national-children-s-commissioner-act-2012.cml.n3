concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46ml-ss-4 a cml:Concept ;
    skos:prefLabel "46ML(4) National Children’s Commissioner may obtain information"@en ;
    cml:realizedBy doc:sch-1-sec-46ml-ss-4 ;
    values:originalText "(4) A Commonwealth government agency must not, in response to a requirement under this section:  (a) give information in a manner that would reveal the identity of a particular individual; or  (b) produce a document that reveals the identity of a particular individual; unless the individual has consented to the giving of the information or the production of the document." ;
    skos:definition "(4) A Commonwealth government agency must not, in response to a requirement under this section:  (a) give information in a manner that would reveal the identity of a particular individual; or  (b) produce a document that reveals the identity of a particular individual; unless the individual has consented to the giving of the information or the production of the document."@en ;
    cml:integrityHash "3610cac9a553bc2d864f6da1f24f2cb721a612a3801a7e305398b92b2562571b" ;
    values:partOf concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46ml ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Cannot give information revealing individual's identity without consent" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
