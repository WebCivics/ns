doc:sch-1-sec-46ml-ss-6 a cof:Section ;
    cof:title "46ML(6) National Children’s Commissioner may obtain information" ;
    values:kind "subsection" ;
    values:originalText "(6) In this section: Commonwealth government agency means:  (a) a Department or authority of the Commonwealth; or  (b) a person who performs the functions of, or performs functions within, a Department or authority of the Commonwealth." ;
    cof:pageNumber "12"^^xsd:integer .

concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mm a cml:Concept ;
    skos:prefLabel "46MM National Children’s Commissioner must give information to"@en ;
    cml:realizedBy doc:sch-1-sec-46mm ;
    values:originalText "the Commission  The National Children’s Commissioner must give to the Commission such information as the Commission from time to time requires relating to the operations of the Commissioner under this Part." ;
