concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-8 a cml:Concept ;
    skos:prefLabel "8 Australian Human Rights Commission Amendment (National Children’s Commissioner)"@en ;
    cml:realizedBy doc:sch-1-sec-8 ;
    values:originalText "(i) becomes bankrupt; or  (ii) applies to take the benefit of any law for the relief of bankrupt or insolvent debtors; or  (iii) compounds with his or her creditors; or  (iv) makes an assignment of remuneration for the benefit of his or her creditors; or  (d) if the Commissioner is absent, except on leave of absence, for 14 consecutive days or for 28 days in any 12 months; or  (e) if the Commissioner engages in paid employment contrary to section 46MH." ;
    skos:definition "(i) becomes bankrupt; or  (ii) applies to take the benefit of any law for the relief of bankrupt or insolvent debtors; or  (iii) compounds with his or her creditors; or  (iv) makes an assignment of remuneration for the benefit of his or her creditors; or  (d) if the Commissioner is absent, except on leave of absence, for 14 consecutive days or for 28 days in any 12 months; or  (e) if the Commissioner engages in paid employment contrary to section 46MH."@en ;
    cml:integrityHash "3a7bd5196641cc7a4b30a550fefaaa741e74ab212be99dee098dc696d3c5ae9c" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Prohibition on certain actions by the Commissioner" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
