concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mk a cml:Concept ;
    skos:prefLabel "46MK Other terms and conditions"@en ;
    cml:realizedBy doc:sch-1-sec-46mk ;
    values:originalText "The National Children’s Commissioner holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the Governor-General." ;
    skos:definition "The National Children’s Commissioner holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the Governor-General."@en ;
