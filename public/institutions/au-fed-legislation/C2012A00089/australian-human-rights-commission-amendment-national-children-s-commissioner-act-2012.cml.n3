    cof:pageNumber "10"^^xsd:integer ;
    skos:note "The National Children’s Commissioner must hold office for a period not exceeding 7 years." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
