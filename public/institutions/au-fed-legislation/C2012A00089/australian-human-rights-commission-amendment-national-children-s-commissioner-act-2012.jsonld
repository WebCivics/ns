      ],
      "cml:integrityHash": "dc27d294ce195dbcd21cd547bd5e6e477eff69a472e51e404e9d85fd8e24f229",
      "skos:note": "Minister must be satisfied about qualifications, knowledge or experience of appointee."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46mc-ss-2",
      "@type": "cof:Section",
      "cof:title": "46MC(2) Appointment of National Children’s Commissioner",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(2) A person must not be appointed as the National Children’s\nCommissioner unless the Minister is satisfied that the person has\nappropriate qualifications, knowledge or experience."
    },
    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mc-ss-2-norm",
