    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mc",
      "@type": "cml:Concept",
      "skos:prefLabel": "46MC Appointment of National Children’s Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46mc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf"
      },
      "dc:source": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf, p.10",
      "values:originalText": "(1) The National Children’s Commissioner is to be appointed by the\nGovernor-General by written instrument, on a full-time basis.\n\n(2) A person must not be appointed as the National Children’s\nCommissioner unless the Minister is satisfied that the person has\nappropriate qualifications, knowledge or experience.",
      "skos:definition": "(1) The National Children’s Commissioner is to be appointed by the\nGovernor-General by written instrument, on a full-time basis.\n\n(2) A person must not be appointed as the National Children’s\nCommissioner unless the Minister is satisfied that the person has\nappropriate qualifications, knowledge or experience.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mc-ss-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mc-ss-2"
        }
      ],
      "cml:integrityHash": "fe2e70352bedab8fc5fe38424f0b8a8c6a4d20e5e153d3388192d7da80685ba2"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46mc",
      "@type": "cof:Section",
      "cof:title": "46MC Appointment of National Children’s Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) The National Children’s Commissioner is to be appointed by the\nGovernor-General by written instrument, on a full-time basis.\n\n(2) A person must not be appointed as the National Children’s\nCommissioner unless the Minister is satisfied that the person has\nappropriate qualifications, knowledge or experience."
    },
