      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mi",
      "@type": "cml:Concept",
      "skos:prefLabel": "46MI Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46mi"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf"
      },
      "dc:source": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf, p.11",
      "values:originalText": "(1) The National Children’s Commissioner may resign his or her\nappointment by giving the Governor-General a written resignation.\n\n(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day.",
      "skos:definition": "(1) The National Children’s Commissioner may resign his or her\nappointment by giving the Governor-General a written resignation.\n\n(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mi-ss-1"
        },
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mi-ss-2"
        }
      ],
      "cml:integrityHash": "6633f4cbf84f262b6ebfb8b019c2d924bd416e56385a253e0c4684ba5166e39d"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46mi",
      "@type": "cof:Section",
      "cof:title": "46MI Resignation",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "(1) The National Children’s Commissioner may resign his or her\nappointment by giving the Governor-General a written resignation.\n\n(2) The resignation takes effect on the day it is received by the\nGovernor-General or, if a later day is specified in the resignation,\non that later day."
    },
