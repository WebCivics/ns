    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Australian Human Rights Commission Amendment (National Children’s Commissioner)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf"
      },
      "dc:source": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf, p.12",
      "values:originalText": "(i) becomes bankrupt; or\n\n(ii) applies to take the benefit of any law for the relief of\nbankrupt or insolvent debtors; or\n\n(iii) compounds with his or her creditors; or\n\n(iv) makes an assignment of remuneration for the benefit of\nhis or her creditors; or\n\n(d) if the Commissioner is absent, except on leave of absence,\nfor 14 consecutive days or for 28 days in any 12 months; or\n\n(e) if the Commissioner engages in paid employment contrary to\nsection 46MH.",
      "skos:definition": "(i) becomes bankrupt; or\n\n(ii) applies to take the benefit of any law for the relief of\nbankrupt or insolvent debtors; or\n\n(iii) compounds with his or her creditors; or\n\n(iv) makes an assignment of remuneration for the benefit of\nhis or her creditors; or\n\n(d) if the Commissioner is absent, except on leave of absence,\nfor 14 consecutive days or for 28 days in any 12 months; or\n\n(e) if the Commissioner engages in paid employment contrary to\nsection 46MH.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-8-norm"
        },
