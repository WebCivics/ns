        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A person must not be appointed...",
      "cml:conclusionText": "The Minister's satisfaction remains valid until the appointee starts their term."
    },
    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mc-ss-2-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Satisfaction implies appointment",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A person must not be appointed...",
      "cml:conclusionText": "If the Minister is satisfied, then the appointee can be appointed."
    },
    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mc-ss-2-logic-diffusion-5",
