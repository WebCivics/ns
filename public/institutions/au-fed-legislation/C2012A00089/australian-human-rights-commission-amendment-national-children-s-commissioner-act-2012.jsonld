      "skos:prefLabel": "8 Application of amendment made by item 6",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-8-2"
      },
