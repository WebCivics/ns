        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46mb-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
