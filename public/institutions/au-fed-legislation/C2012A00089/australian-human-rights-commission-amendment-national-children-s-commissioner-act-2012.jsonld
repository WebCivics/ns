    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mj",
      "@type": "cml:Concept",
      "skos:prefLabel": "46MJ Termination of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46mj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf"
      },
      "dc:source": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf, p.11",
      "values:originalText": "The Governor-General may terminate the appointment of the\nNational Children’s Commissioner:\n\n(a) for misbehaviour; or\n\n(b) if the Commissioner is unable to perform the duties of his or\nher office because of physical or mental incapacity; or\n\n(c) if the Commissioner:\nComLaw Authoritative Act C2012A00089\n\nSchedule 1  National Children’s Commissioner",
      "skos:definition": "The Governor-General may terminate the appointment of the\nNational Children’s Commissioner:\n\n(a) for misbehaviour; or\n\n(b) if the Commissioner is unable to perform the duties of his or\nher office because of physical or mental incapacity; or\n\n(c) if the Commissioner:\nComLaw Authoritative Act C2012A00089\n\nSchedule 1  National Children’s Commissioner",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mj-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mj-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e8ffbb18a30bf0b36b8ca493ec209e386a7c7c4aac2fa4bf4fe4caaa2bb48c86",
      "skos:note": "The Governor-General may terminate the appointment of the National Children’s Commissioner."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46mj",
      "@type": "cof:Section",
      "cof:title": "46MJ Termination of appointment",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "The Governor-General may terminate the appointment of the\nNational Children’s Commissioner:\n\n(a) for misbehaviour; or\n\n(b) if the Commissioner is unable to perform the duties of his or\nher office because of physical or mental incapacity; or\n\n(c) if the Commissioner:\nComLaw Authoritative Act C2012A00089\n\nSchedule 1  National Children’s Commissioner"
    },
