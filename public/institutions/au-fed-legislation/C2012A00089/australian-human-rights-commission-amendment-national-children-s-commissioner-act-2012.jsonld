      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf"
      },
      "dc:source": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf, p.15",
      "values:originalText": "The amendment made by item 6 applies in relation to proceedings:\n\n(a) that commence on or after the commencement of that item;\nor\n\n(b) that commenced before the commencement of that item, and\nthat had not been completed by that commencement.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 23 May 2012\nSenate on 21 June 2012]\n\n(79/12)\nComLaw Authoritative Act C2012A00089",
      "skos:definition": "The amendment made by item 6 applies in relation to proceedings:\n\n(a) that commence on or after the commencement of that item;\nor\n\n(b) that commenced before the commencement of that item, and\nthat had not been completed by that commencement.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 23 May 2012\nSenate on 21 June 2012]\n\n(79/12)\nComLaw Authoritative Act C2012A00089",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-8-2-norm"
