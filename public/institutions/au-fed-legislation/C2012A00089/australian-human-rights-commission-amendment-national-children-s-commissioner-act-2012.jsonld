      "cml:conclusionText": "The Minister's satisfaction affects the appointment decision."
    },
    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46md",
      "@type": "cml:Concept",
      "skos:prefLabel": "46MD Period of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46md"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf"
      },
      "dc:source": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf, p.10",
      "values:originalText": "The National Children’s Commissioner holds office for the period\nspecified in the instrument of appointment. The period must not\nexceed 7 years.\nNote:\nFor re-appointment, see section 33AA of the Acts Interpretation Act\n1901.",
      "skos:definition": "The National Children’s Commissioner holds office for the period\nspecified in the instrument of appointment. The period must not\nexceed 7 years.\nNote:\nFor re-appointment, see section 33AA of the Acts Interpretation Act\n1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46md-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46md-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d0fd1bd4ea1e2509c90f3b3c386e44ac6e349b2063b0246bb2cf1fbacb4d433e",
      "skos:note": "The National Children’s Commissioner must hold office for a period not exceeding 7 years."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46md",
      "@type": "cof:Section",
      "cof:title": "46MD Period of appointment",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "The National Children’s Commissioner holds office for the period\nspecified in the instrument of appointment. The period must not\nexceed 7 years.\nNote:\nFor re-appointment, see section 33AA of the Acts Interpretation Act\n1901."
    },
    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46md-norm",
