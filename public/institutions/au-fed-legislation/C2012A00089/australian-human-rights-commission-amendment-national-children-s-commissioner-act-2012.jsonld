    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46me",
      "@type": "cml:Concept",
      "skos:prefLabel": "46ME Acting appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46me"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf"
      },
      "dc:source": "australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012.pdf, p.10",
      "values:originalText": "The Minister may, by written instrument, appoint a person to act as\nthe National Children’s Commissioner:\n\n(a) during a vacancy in the office of the Commissioner (whether\nor not an appointment has previously been made to the\noffice); or\n\n(b) during any period, or during all periods, when the\nCommissioner:\n\n(i) is absent from duty or from Australia; or\n\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nSee also sections 20, 33AB and 33A of the Acts Interpretation Act\n1901.",
      "skos:definition": "The Minister may, by written instrument, appoint a person to act as\nthe National Children’s Commissioner:\n\n(a) during a vacancy in the office of the Commissioner (whether\nor not an appointment has previously been made to the\noffice); or\n\n(b) during any period, or during all periods, when the\nCommissioner:\n\n(i) is absent from duty or from Australia; or\n\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nSee also sections 20, 33AB and 33A of the Acts Interpretation Act\n1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46me-norm"
        },
        {
          "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46me-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2c5bce62cfc035fcf3506a83de4b51ef646cd9c5f6241eb23401fa5044e55069",
      "skos:note": "The Minister may appoint a person to act as the National Children’s Commissioner."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012#sch-1-sec-46me",
      "@type": "cof:Section",
      "cof:title": "46ME Acting appointment",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "The Minister may, by written instrument, appoint a person to act as\nthe National Children’s Commissioner:\n\n(a) during a vacancy in the office of the Commissioner (whether\nor not an appointment has previously been made to the\noffice); or\n\n(b) during any period, or during all periods, when the\nCommissioner:\n\n(i) is absent from duty or from Australia; or\n\n(ii) is, for any reason, unable to perform the duties of the\noffice.\nNote:\nSee also sections 20, 33AB and 33A of the Acts Interpretation Act\n1901."
    },
    {
