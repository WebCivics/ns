    {
      "@id": "concept:australian-human-rights-commission-amendment-national-children-s-commissioner-act-2012-sch-1-sec-46mc-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Satisfaction period is between appointment and start of term",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
