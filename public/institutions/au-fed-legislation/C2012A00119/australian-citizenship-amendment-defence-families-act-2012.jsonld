    {
      "@id": "concept:australian-citizenship-amendment-defence-families-act-2012-sch-1-sec-23-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "23(3) Defence service requirement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-defence-families-act-2012#sch-1-sec-23-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-defence-families-act-2012.pdf"
      },
      "dc:source": "australian-citizenship-amendment-defence-families-act-2012.pdf, p.7",
      "values:originalText": "(3) If:\n\n(a) a person (the defence person) was granted, on or after 1 July\n2007, a visa prescribed by the regulations; and\nComLaw Authoritative Act C2012A00119\n\nSchedule 1  Amendments\n\n(b) the defence person dies while undertaking service in the\nPermanent Forces or the Reserves; and\n\n(c) another person (the relative) was a member of the family unit\nof the defence person when the defence person was granted\nthe visa; and\n\n(d) immediately before the death of the defence person, the\nrelative held a visa of that kind because the relative was a\nmember of the family unit of the defence person;\nthe relative satisfies the defence service requirement for the\npurposes of section 21.\nDefinitions",
      "skos:definition": "(3) If:\n\n(a) a person (the defence person) was granted, on or after 1 July\n2007, a visa prescribed by the regulations; and\nComLaw Authoritative Act C2012A00119\n\nSchedule 1  Amendments\n\n(b) the defence person dies while undertaking service in the\nPermanent Forces or the Reserves; and\n\n(c) another person (the relative) was a member of the family unit\nof the defence person when the defence person was granted\nthe visa; and\n\n(d) immediately before the death of the defence person, the\nrelative held a visa of that kind because the relative was a\nmember of the family unit of the defence person;\nthe relative satisfies the defence service requirement for the\npurposes of section 21.\nDefinitions",
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-defence-families-act-2012-sch-1-sec-23"
      },
