      "dc:source": "australian-citizenship-amendment-defence-families-act-2012.pdf, p.6",
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period.",
      "skos:definition": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-defence-families-act-2012-sec-2-2-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-defence-families-act-2012-sec-2-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "c0b874ae7d8c17443923b584a9aa7b9ff9e0c97fd56c9d47f77e7d54fbe999b0",
      "skos:note": "Conditional commencement of provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-defence-families-act-2012#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period."
    },
