      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the person has undertaken a total of at least 90 days service on which he or she was required for, and attended and was entitled to be paid for, duty in one or more of the Reserves (whether or not that service was continuous);"
    },
    {
      "@id": "concept:australian-citizenship-amendment-defence-families-act-2012-sch-1-sec-23-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "The person is medically unfit for service.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the person: (i) was discharged from service undertaken in one of the Permanent Forces or the Reserves as medically unfit for that service; and (ii) became so unfit because of service undertaken in any of the Permanent Forces or the Reserves."
    },
    {
      "@id": "concept:australian-citizenship-amendment-defence-families-act-2012-sch-1-sec-23-ss-4-logic-linearlogic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "and",
      "cml:logicSummary": "The person has completed relevant defence service if they have undertaken a total of at least 90 days service in one or more of the Permanent Forces or the Reserves.",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the person has undertaken a total of at least 90 days service in one or more of the Permanent Forces (whether or not that service was continuous); or (b) the person has undertaken a total of at least 90 days service on which he or she was required for, and attended and was entitled to be paid for, duty in one or more of the Reserves (whether or not that service was continuous);"
    },
    {
      "@id": "concept:australian-citizenship-amendment-defence-families-act-2012-sch-1-sec-23-ss-4-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is defined as",
      "cml:logicSummary": "A person undertakes service in the Permanent Forces or the Reserves only if they are appointed, enlisted or transferred into any of the Permanent Forces or the Reserves.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "service: a person undertakes service in the Permanent Forces or the Reserves only if the person is appointed, enlisted or transferred into any of the Permanent Forces or the Reserves."
    },
