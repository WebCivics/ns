      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The credit contract was entered into within the period in which an assessment needed to be made.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "(6) Subsection (7) applies if:  (c) the court is satisfied that, at any time in the period in which an assessment needed to be made to comply with section 128 in relation to the illegal contract:"
    },
    {
      "@id": "concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-2-sec-11-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits entering into or increasing credit contracts for reverse mortgages that are not suitable for the debtor.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(6) Subsection (7) applies if:  (a) the defendant is a credit provider who has contravened section 133 by entering into, or increasing the credit limit of, a credit contract (the illegal contract) that is not a credit contract for a reverse mortgage; and"
    },
    {
      "@id": "concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-2-sec-11-ss-6-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The court is obligated to let the plaintiff reside in the place.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligate",
      "cml:premiseText": "(6) Subsection (7) applies if:  (d) the plaintiff, or ASIC on behalf of the plaintiff, applies for an order under this section to let the plaintiff reside in the place to prevent or reduce loss or damage suffered or likely to be suffered by the plaintiff vacating the place."
    },
    {
      "@id": "concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-2-sec-11-ss-6-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The debtor would have been eligible to enter into a credit contract for the reverse mortgage.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(6) Subsection (7) applies if:  (ii) the debtor would have been eligible to enter into a credit contract for the reverse mortgage; and"
    },
