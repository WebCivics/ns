      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits removal or disposal of mortgaged goods without permission.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
