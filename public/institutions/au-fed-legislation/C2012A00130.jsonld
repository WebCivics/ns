      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(a) there is a change to an existing consumer lease that results in further goods being provided; or (b) the change, deferral, waiver or postponement is made in accordance with this Code or the existing consumer lease;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
