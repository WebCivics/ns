      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The circumstances under which the credit provider may take possession of mortgaged goods overlap with the debtor's or mortgagor's actions.",
