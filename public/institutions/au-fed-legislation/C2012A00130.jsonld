      "@id": "concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179q-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person who contravenes an order under this section is prohibited from committing an offence.",
