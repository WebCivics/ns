    cml:modality cml:Deontic ;
    cml:operator "Must" ;
    cml:logicSummary "Mandatory obligation" ;
    cml:premiseText "(a) when the fee or charge is paid by the lessee to the lessor, the third party amount is not ascertainable;" ;
