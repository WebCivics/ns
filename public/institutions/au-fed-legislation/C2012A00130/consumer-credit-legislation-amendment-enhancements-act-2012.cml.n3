doc:sch-2-sec-13a-ss-4 a cof:Section ;
    cof:title "13A(4) Reverse mortgages" ;
    values:kind "subsection" ;
    values:originalText "(4) ASIC may by legislative instrument declare specified kinds of arrangements involving a credit contract and a mortgage over a dwelling or land securing a debtor’s obligations under the contract to be reverse mortgages." ;
    cof:pageNumber "32"^^xsd:integer .

