concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179d-ss-5 a cml:Concept ;
    skos:prefLabel "179D(5) Requirements to be met before lessor can enforce consumer"@en ;
    cml:realizedBy doc:sch-5-sec-179d-ss-5 ;
    values:originalText "(5) Subsection (1) is an offence of strict liability. Note: For strict liability, see section 6.1 of the Criminal Code." ;
    skos:definition "(5) Subsection (1) is an offence of strict liability. Note: For strict liability, see section 6.1 of the Criminal Code."@en ;
