concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-2-sec-86c a cml:Concept ;
    skos:prefLabel "86C Credit provider must pay debtor excess of receipt over adjusted"@en ;
    cml:realizedBy doc:sch-2-sec-86c ;
    values:originalText "market value for reverse mortgaged property  If the amount received by the credit provider exceeds the adjusted market value for the reverse mortgaged property, the credit provider must pay the excess to the debtor. Note 1: If the credit provider contravenes this requirement, the court may order the credit provider to compensate anyone affected by the contravention: see section 124. Note 2: This section does not apply in some cases: see section 86E." ;
    skos:definition "market value for reverse mortgaged property  If the amount received by the credit provider exceeds the adjusted market value for the reverse mortgaged property, the credit provider must pay the excess to the debtor. Note 1: If the credit provider contravenes this requirement, the court may order the credit provider to compensate anyone affected by the contravention: see section 124. Note 2: This section does not apply in some cases: see section 86E."@en ;
    cml:integrityHash "89801f6c30576c6979c0c7abce1ae935b63b4fcbee45f2f21c86f97f7039da0d" ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Credit provider must pay excess to debtor" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
