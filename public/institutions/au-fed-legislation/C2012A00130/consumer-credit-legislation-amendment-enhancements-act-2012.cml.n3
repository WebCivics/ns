concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-151 a cml:Concept ;
    skos:prefLabel "151 Obligation to assess unsuitability"@en ;
    cml:realizedBy doc:sch-1-sec-151 ;
    values:originalText "A licensee must not:  (a) enter a consumer lease with a consumer who will be the lessee under the lease; or  (b) make an unconditional representation to a consumer that the licensee considers that the consumer is eligible to enter a consumer lease with the licensee; on a day (the lease day) unless the licensee has, within 90 days (or other period prescribed by the regulations) before the lease day:  (c) made an assessment that:  (i) is in accordance with section 152; and  (ii) covers a period in which the lease day occurs; and  (d) made the inquiries and verification in accordance with section 130. Civil penalty: 2,000 penalty units." ;
    skos:definition "A licensee must not:  (a) enter a consumer lease with a consumer who will be the lessee under the lease; or  (b) make an unconditional representation to a consumer that the licensee considers that the consumer is eligible to enter a consumer lease with the licensee; on a day (the lease day) unless the licensee has, within 90 days (or other period prescribed by the regulations) before the lease day:  (c) made an assessment that:  (i) is in accordance with section 152; and  (ii) covers a period in which the lease day occurs; and  (d) made the inquiries and verification in accordance with section 130. Civil penalty: 2,000 penalty units."@en ;
    cml:integrityHash "587e7bb139c9672e651bc52e0372ed93d30c04ea074811c0d45367163b11a55b" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Licensee must not enter a consumer lease with an eligible consumer without assessment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
