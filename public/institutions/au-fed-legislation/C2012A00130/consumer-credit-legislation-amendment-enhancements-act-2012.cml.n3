doc:sch-5-sec-179u-ss-3 a cof:Section ;
    cof:title "179U(3) False or misleading representations" ;
    values:kind "subsection" ;
    values:originalText "(3) A person who suffers loss as a result of a contravention of this section by another person may recover the amount of the loss from: ComLaw Authoritative Act C2012A00130  Schedule 5  Consumer leases  (a) that other person; or  (b) any other person involved in the contravention." ;
    cof:pageNumber "103"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179v a cml:Concept ;
    skos:prefLabel "179V Harassment"@en ;
    cml:realizedBy doc:sch-5-sec-179v ;
    values:originalText "A lessor or supplier must not harass a person in attempting to get that person to:  (a) apply for a consumer lease; or  (b) enter into a consumer lease or a related transaction. Criminal penalty: 100 penalty units." ;
