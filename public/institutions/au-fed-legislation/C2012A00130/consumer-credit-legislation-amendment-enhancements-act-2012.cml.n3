doc:sch-5-sec-175e-ss-3 a cof:Section ;
    cof:title "175E(3) Statement of amount owing and other matters" ;
    values:kind "subsection" ;
    values:originalText "(3) A statement under this section may be given orally but if the request for the statement is made in writing the statement must be given in writing." ;
    cof:pageNumber "80"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175e-ss-4 a cml:Concept ;
    skos:prefLabel "175E(4) Statement of amount owing and other matters"@en ;
    cml:realizedBy doc:sch-5-sec-175e-ss-4 ;
    values:originalText "(4) In the case of joint lessees, the statement under this section need only be given to a lessee who requests the statement and not, despite section 194, to each joint lessee." ;
    skos:definition "(4) In the case of joint lessees, the statement under this section need only be given to a lessee who requests the statement and not, despite section 194, to each joint lessee."@en ;
