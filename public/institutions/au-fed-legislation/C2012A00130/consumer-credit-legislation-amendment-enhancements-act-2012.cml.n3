concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-7-sec-289 a cml:Concept ;
    skos:prefLabel "289 Application of amendment relating to repairs"@en ;
    cml:realizedBy doc:sch-7-sec-289 ;
