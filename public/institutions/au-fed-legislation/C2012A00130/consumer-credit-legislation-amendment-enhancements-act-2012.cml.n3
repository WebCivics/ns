concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-2-sec-15 a cml:Concept ;
    skos:prefLabel "15 At the end of section 26 of the National Credit Code"@en ;
    cml:realizedBy doc:sch-2-sec-15 ;
    values:originalText "Add:  (6) A credit contract for a reverse mortgage may not prohibit an early payment that:  (a) is made in the circumstances described in paragraph 86A(1)(a); and  (b) is of the amount described in paragraph 86A(1)(b)." ;
