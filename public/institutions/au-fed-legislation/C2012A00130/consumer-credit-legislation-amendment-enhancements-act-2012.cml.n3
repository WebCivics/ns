concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-30 a cml:Concept ;
    skos:prefLabel "30 Subsection 204(1) of the National Credit Code (definition"@en ;
    cml:realizedBy doc:sch-5-sec-30 ;
    values:originalText "of enforcement proceedings) Repeal the definition, substitute: enforcement proceedings means:  (a) for a credit contract, consumer lease or guarantee— proceedings in a court to recover a payment due under the contract, lease or guarantee; or  (b) for a consumer lease or mortgage—taking possession of property under the lease or mortgage; or  (c) for a mortgage—taking any other action to enforce the mortgage." ;
    skos:definition "of enforcement proceedings) Repeal the definition, substitute: enforcement proceedings means:  (a) for a credit contract, consumer lease or guarantee— proceedings in a court to recover a payment due under the contract, lease or guarantee; or  (b) for a consumer lease or mortgage—taking possession of property under the lease or mortgage; or  (c) for a mortgage—taking any other action to enforce the mortgage."@en ;
    cml:integrityHash "e7a862de1f532cbd0529c2c0308f78865b36d9c305936f584fdc90f047f302ba" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "Defines enforcement proceedings for credit contracts, consumer leases, and mortgages." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
