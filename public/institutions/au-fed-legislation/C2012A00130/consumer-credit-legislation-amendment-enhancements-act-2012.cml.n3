concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-2-sec-133dc a cml:Concept ;
    skos:prefLabel "133DC Making reverse mortgage information statement available"@en ;
    cml:realizedBy doc:sch-2-sec-133dc ;
    values:originalText "on website of credit provider or credit assistance provider When this section applies  (1) This section applies if a licensee:  (a) is:  (i) a person who provides, or holds himself or herself out as able to provide, credit assistance relating to credit contracts for reverse mortgages; or  (ii) a credit provider under one or more credit contracts for a reverse mortgages; and  (b) has a website that provides information about such contracts. ComLaw Authoritative Act C2012A00130  Schedule 2  Reverse mortgages" ;
    skos:definition "on website of credit provider or credit assistance provider When this section applies  (1) This section applies if a licensee:  (a) is:  (i) a person who provides, or holds himself or herself out as able to provide, credit assistance relating to credit contracts for reverse mortgages; or  (ii) a credit provider under one or more credit contracts for a reverse mortgages; and  (b) has a website that provides information about such contracts. ComLaw Authoritative Act C2012A00130  Schedule 2  Reverse mortgages"@en ;
    cml:integrityHash "84b6c8794cd2849748eb7c1eea5036b084ec4937838c199bc98a30d0ac87222d" ;
    cof:pageNumber "37"^^xsd:integer ;
    skos:note "Make reverse mortgage information statement available on website." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.37" ;
