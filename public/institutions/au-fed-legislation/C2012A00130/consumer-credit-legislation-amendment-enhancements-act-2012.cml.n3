doc:sch-5-sec-179k-ss-1 a cof:Section ;
    cof:title "179K(1) Postponement by court" ;
    values:kind "subsection" ;
    values:originalText "(1) If the lessee is unable to negotiate a postponement, the lessee may apply to the court for a postponement." ;
    cof:pageNumber "99"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179k-ss-2 a cml:Concept ;
    skos:prefLabel "179K(2) Postponement by court"@en ;
    cml:realizedBy doc:sch-5-sec-179k-ss-2 ;
    values:originalText "(2) After allowing the applicant and the lessor a reasonable opportunity to be heard, the court may:  (a) order the postponement to which the application relates; or  (b) refuse to order the postponement; or  (c) make such other orders as it thinks fit." ;
    skos:definition "(2) After allowing the applicant and the lessor a reasonable opportunity to be heard, the court may:  (a) order the postponement to which the application relates; or  (b) refuse to order the postponement; or  (c) make such other orders as it thinks fit."@en ;
