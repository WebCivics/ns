doc:sch-5-sec-175g-ss-1 a cof:Section ;
    cof:title "175G(1) Disputed accounts" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a liability is entered against a lessee under a consumer lease; and  (b) the lessee, by written notice to the lessor, disputes the liability; then the lessor must give the lessee a written notice explaining in reasonable detail how the liability arises." ;
    cof:pageNumber "81"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g-ss-2 a cml:Concept ;
    skos:prefLabel "175G(2) Disputed accounts"@en ;
    cml:realizedBy doc:sch-5-sec-175g-ss-2 ;
    values:originalText "(2) A written notice need not be given if the lessor agrees with the lessee as to the disputed amount and gives the lessee a written notice advising of the agreed liability." ;
    skos:definition "(2) A written notice need not be given if the lessor agrees with the lessee as to the disputed amount and gives the lessee a written notice advising of the agreed liability."@en ;
    cml:integrityHash "2fa434a79861f158bd9854d2d6a50b0b61a443647778baa050d4223e85ae80b2" ;
    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Lessor must provide written notice of agreed liability." ;
    dc:description "yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
