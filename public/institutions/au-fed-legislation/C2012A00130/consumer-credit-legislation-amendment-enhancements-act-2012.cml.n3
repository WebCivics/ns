concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-178a a cml:Concept ;
    skos:prefLabel "178A Termination before goods have been provided"@en ;
    cml:realizedBy doc:sch-5-sec-178a ;
    values:originalText "(1) If:  (a) a consumer lease has been entered into; and  (b) the goods hired under the lease have not been provided; then the lessee may, by written notice to the lessor, terminate the lease.  (2) Nothing in subsection (1) prevents the lessor from retaining or requiring payment of fees or charges incurred before the termination and which would have been payable under the consumer lease." ;
    skos:definition "(1) If:  (a) a consumer lease has been entered into; and  (b) the goods hired under the lease have not been provided; then the lessee may, by written notice to the lessor, terminate the lease.  (2) Nothing in subsection (1) prevents the lessor from retaining or requiring payment of fees or charges incurred before the termination and which would have been payable under the consumer lease."@en ;
    cml:integrityHash "5492ee1107fb39ea8915e3f8c63ad4045593de9a9f0eb9dce54d759b7557e6d1" ;
    cof:pageNumber "91"^^xsd:integer ;
    cml:hasPart concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-178a-ss-1 ;
    cml:hasPart concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-178a-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.91" .
