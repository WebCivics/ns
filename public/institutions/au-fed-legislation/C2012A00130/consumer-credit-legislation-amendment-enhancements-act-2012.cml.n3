    cml:logicSummary "Prohibits urgent action that would protect the goods." ;
    cml:premiseText "(b) urgent action is necessary to protect the goods." ;
    cml:conclusionText "The credit provider may take possession of mortgaged goods under certain circumstances." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

