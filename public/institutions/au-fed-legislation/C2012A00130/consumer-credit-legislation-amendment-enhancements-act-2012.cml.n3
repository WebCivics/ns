concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-4-sec-6 a cml:Concept ;
    skos:prefLabel "6 After subsection 24(1) of the National Credit Code"@en ;
    cml:realizedBy doc:sch-4-sec-6 ;
    values:originalText "Insert:  (1A) A credit provider must not:  (a) enter into a small amount credit contract on terms imposing a monetary liability prohibited by subsection 23A(1); or  (b) require or accept payment of an amount in respect of a monetary liability that cannot be imposed consistently with this Code. Criminal penalty: 100 penalty units." ;
    skos:definition "Insert:  (1A) A credit provider must not:  (a) enter into a small amount credit contract on terms imposing a monetary liability prohibited by subsection 23A(1); or  (b) require or accept payment of an amount in respect of a monetary liability that cannot be imposed consistently with this Code. Criminal penalty: 100 penalty units."@en ;
    cml:integrityHash "fd26194c294da96b78a41e44d2d5d652acd1c887f35495e409ca5ab858977a60" ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "Credit provider must not enter into a small amount credit contract with prohibited terms." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.62" ;
