concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175f a cml:Concept ;
    skos:prefLabel "175F Court may order statement of account to be provided"@en ;
    cml:realizedBy doc:sch-5-sec-175f ;
    values:originalText "If a statement of account is not provided within the time required by this Subdivision, the court may, on the application of the lessee, ComLaw Authoritative Act C2012A00130  Consumer leases  Schedule 5  order the lessor to provide the statement or itself determine the amounts in relation to which the statement was sought." ;
    skos:definition "If a statement of account is not provided within the time required by this Subdivision, the court may, on the application of the lessee, ComLaw Authoritative Act C2012A00130  Consumer leases  Schedule 5  order the lessor to provide the statement or itself determine the amounts in relation to which the statement was sought."@en ;
    cml:integrityHash "1ebd6e067f95725f33f446860a8de93a9c824b83c86e535dcf189ffdefafedfd" ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Court may order statement of account to be provided if not done so within the required time." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
