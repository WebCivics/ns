doc:sch-2-sec-185a-ss-2 a cof:Section ;
    cof:title "185A(2) Records of nominations of persons to occupy reverse" ;
    values:kind "subsection" ;
    values:originalText "(2) A person commits an offence if:  (a) the person is subject to a requirement under subsection (1); and  (b) the person engages in conduct; and  (c) the person’s conduct contravenes the requirement. Criminal penalty: 50 penalty units. ComLaw Authoritative Act C2012A00130  Schedule 3  Short-term and small amount credit contracts" ;
    cof:pageNumber "51"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-3-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 5(1)"@en ;
    cml:realizedBy doc:sch-3-sec-1 ;
    values:originalText "Insert: short-term credit contract: a credit contract is a short-term credit contract if:  (a) the contract is not a continuing credit contract; and  (b) the credit provider under the contract is not an ADI; and  (c) the credit limit of the contract is $2,000 (or such other amount as is prescribed by the regulations) or less; and  (d) the term of the contract is 15 days or less; and  (e) the contract meets any other requirements prescribed by the regulations." ;
    skos:definition "Insert: short-term credit contract: a credit contract is a short-term credit contract if:  (a) the contract is not a continuing credit contract; and  (b) the credit provider under the contract is not an ADI; and  (c) the credit limit of the contract is $2,000 (or such other amount as is prescribed by the regulations) or less; and  (d) the term of the contract is 15 days or less; and  (e) the contract meets any other requirements prescribed by the regulations."@en ;
    cml:integrityHash "9887b883669781dd7048b9d6229ef452188e6ce71875da95e42fa026512ed7dd" ;
    cof:pageNumber "52"^^xsd:integer ;
