concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-3-sec-14 a cml:Concept ;
    skos:prefLabel "14 Paragraph 180(1)(b)"@en ;
    cml:realizedBy doc:sch-3-sec-14 ;
    values:originalText "Repeal the paragraph, substitute: ComLaw Authoritative Act C2012A00130  Schedule 3  Short-term and small amount credit contracts  (b) the engaging in the activity contravenes any of the following:  (i) section 29 (which requires the holding of a licence);  (ii) section 124A (which prohibits the provision of credit assistance in relation to short-term credit contracts);  (iii) section 133CA (which prohibits credit providers from entering into short-term credit contracts etc.);" ;
    skos:definition "Repeal the paragraph, substitute: ComLaw Authoritative Act C2012A00130  Schedule 3  Short-term and small amount credit contracts  (b) the engaging in the activity contravenes any of the following:  (i) section 29 (which requires the holding of a licence);  (ii) section 124A (which prohibits the provision of credit assistance in relation to short-term credit contracts);  (iii) section 133CA (which prohibits credit providers from entering into short-term credit contracts etc.);"@en ;
    cml:integrityHash "08d666a8b705f78289bb0b518e2cd1d513e65b4bdce12f702dbb1b5f628e4418" ;
    cof:pageNumber "59"^^xsd:integer ;
    skos:note "Engaging in activity contravenes certain sections." ;
