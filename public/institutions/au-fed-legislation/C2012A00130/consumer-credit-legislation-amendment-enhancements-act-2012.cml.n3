concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g-ss-7 a cml:Concept ;
    skos:prefLabel "175G(7) Disputed accounts"@en ;
    cml:realizedBy doc:sch-5-sec-175g-ss-7 ;
    values:originalText "(7) If an application is made to the court under this section within 30 days after the day the written explanation is given, the lessor must not, without leave of the court, begin enforcement proceedings on the basis of a default arising from the disputed liability. ComLaw Authoritative Act C2012A00130  Schedule 5  Consumer leases  Criminal penalty: 50 penalty units." ;
    skos:definition "(7) If an application is made to the court under this section within 30 days after the day the written explanation is given, the lessor must not, without leave of the court, begin enforcement proceedings on the basis of a default arising from the disputed liability. ComLaw Authoritative Act C2012A00130  Schedule 5  Consumer leases  Criminal penalty: 50 penalty units."@en ;
    cml:integrityHash "14ae2d6986eb61c01f17231856691de3187e3ef3335313025b45f6ce82ab61ca" ;
    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Lessor cannot begin enforcement proceedings without court leave." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
