doc:sch-1-sec-89a-ss-3 a cof:Section ;
    cof:title "89A(3) Effect of hardship notices on enforcement" ;
    values:kind "subsection" ;
    values:originalText "(3) However, the credit provider may take possession of mortgaged goods if the credit provider reasonably believes that:  (a) the debtor or mortgagor has removed or disposed of the mortgaged goods, or intends to remove or dispose of them, without the credit provider’s permission; or  (b) urgent action is necessary to protect the goods." ;
    cof:pageNumber "10"^^xsd:integer .

