concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g-ss-4 a cml:Concept ;
    skos:prefLabel "175G(4) Disputed accounts"@en ;
    cml:realizedBy doc:sch-5-sec-175g-ss-4 ;
    values:originalText "(4) In the case of a consumer lease in respect of which a statement of account need not be and is not given for the period to which the disputed liability relates, the notice of dispute must be given to the lessor not later than 3 months after the day the lease ends." ;
    skos:definition "(4) In the case of a consumer lease in respect of which a statement of account need not be and is not given for the period to which the disputed liability relates, the notice of dispute must be given to the lessor not later than 3 months after the day the lease ends."@en ;
    cml:integrityHash "bcb0db2f82874eec34e1ee160ea67faebdfef532581ce367f8ea171046015b68" ;
    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Notice of dispute must be given to the lessor within 3 months after lease ends." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.81" ;
    cml:asserts concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g-ss-4-norm .
