doc:sch-1-sec-160e-ss-2 a cof:Section ;
    cof:title "160E(2) Requirements for giving authorisation to employer" ;
    values:kind "subsection" ;
    values:originalText "(2) If the credit contract or consumer lease is of a kind prescribed by the regulations, the credit provider or lessor must give the employer a statement, in the form prescribed by the regulations for that kind of contract or lease, with the instrument. Civil penalty: 2,000 penalty units. Credit provider or lessor must give 7 days’ notice to defaulting debtor or lessee" ;
    cof:pageNumber "23"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-160e-ss-3 a cml:Concept ;
    skos:prefLabel "160E(3) Requirements for giving authorisation to employer"@en ;
    cml:realizedBy doc:sch-1-sec-160e-ss-3 ;
    values:originalText "(3) If the debtor or lessee is in default under the credit contract or consumer lease, the credit provider or lessor must give the debtor or lessee at least 7 days’ notice, in a form prescribed by the regulations, of the intention of the credit provider or lessor to give the instrument to the employer. Civil penalty: 2,000 penalty units." ;
    skos:definition "(3) If the debtor or lessee is in default under the credit contract or consumer lease, the credit provider or lessor must give the debtor or lessee at least 7 days’ notice, in a form prescribed by the regulations, of the intention of the credit provider or lessor to give the instrument to the employer. Civil penalty: 2,000 penalty units."@en ;
    cml:integrityHash "f0d5f79c13d4528476e2e8186632c8cff91a2098b4fddc687c78b3ba06773bfd" ;
    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-160e ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "Credit provider/lessor must give debtor/lessee at least 7 days' notice before giving instrument to employer." ;
    dc:description "Notice" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
