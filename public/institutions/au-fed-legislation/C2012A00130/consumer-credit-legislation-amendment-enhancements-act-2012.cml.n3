concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-4 a cml:Concept ;
    skos:prefLabel "4 Subsection 74(2) of the National Credit Code"@en ;
    cml:realizedBy doc:sch-1-sec-4 ;
    values:originalText "Repeal the subsection, substitute:  (2) The court may, after allowing the applicant, the credit provider and any guarantor a reasonable opportunity to be heard:  (a) by order change the credit contract (but not so as to reduce the amount ultimately payable by the debtor to the credit provider under the contract), and make such other orders as it thinks fit; or  (b) refuse to change the credit contract." ;
    skos:definition "Repeal the subsection, substitute:  (2) The court may, after allowing the applicant, the credit provider and any guarantor a reasonable opportunity to be heard:  (a) by order change the credit contract (but not so as to reduce the amount ultimately payable by the debtor to the credit provider under the contract), and make such other orders as it thinks fit; or  (b) refuse to change the credit contract."@en ;
    cml:integrityHash "b39917cf8f45bc1a9747f3f0fc03792c9fbe6043a32d6ce2321499250e4a8257" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Court may change credit contract after hearing parties." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.10" ;
    cml:asserts concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-4-norm .
