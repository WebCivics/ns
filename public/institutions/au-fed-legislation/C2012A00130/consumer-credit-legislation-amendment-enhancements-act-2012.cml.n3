doc:sch-5-sec-175g-ss-4 a cof:Section ;
    cof:title "175G(4) Disputed accounts" ;
    values:kind "subsection" ;
    values:originalText "(4) In the case of a consumer lease in respect of which a statement of account need not be and is not given for the period to which the disputed liability relates, the notice of dispute must be given to the lessor not later than 3 months after the day the lease ends." ;
    cof:pageNumber "81"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g-ss-5 a cml:Concept ;
    skos:prefLabel "175G(5) Disputed accounts"@en ;
    cml:realizedBy doc:sch-5-sec-175g-ss-5 ;
    values:originalText "(5) The lessor must not begin enforcement proceedings on the basis of a default arising from the disputed liability until the period of 30 days, starting on the day the lessor gives the written explanation or advice as to agreement, has expired. Criminal penalty: 50 penalty units." ;
    skos:definition "(5) The lessor must not begin enforcement proceedings on the basis of a default arising from the disputed liability until the period of 30 days, starting on the day the lessor gives the written explanation or advice as to agreement, has expired. Criminal penalty: 50 penalty units."@en ;
    cml:integrityHash "68383639bfd875cbb69d256cf60a960efeb4323abbbc3f13337f1c2adc1bfa87" ;
    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175g ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Must not begin enforcement proceedings within 30 days of written explanation or advice as to agreement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.81" ;
