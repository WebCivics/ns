concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179k-ss-3 a cml:Concept ;
    skos:prefLabel "179K(3) Postponement by court"@en ;
    cml:realizedBy doc:sch-5-sec-179k-ss-3 ;
    values:originalText "(3) The court may, if it thinks it appropriate in the circumstances, stay any enforcement proceedings under the consumer lease until the application has been determined." ;
