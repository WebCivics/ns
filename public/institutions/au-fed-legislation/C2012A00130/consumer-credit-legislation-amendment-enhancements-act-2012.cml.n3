doc:sch-5-sec-179a-ss-4 a cof:Section ;
    cof:title "179A(4) Statement of amount payable on termination" ;
    values:kind "subsection" ;
    values:originalText "(4) In the case of joint lessees, the statement need only be given to the lessee who requests the statement and not, despite section 194, to each joint lessee." ;
    cof:pageNumber "91"^^xsd:integer .

