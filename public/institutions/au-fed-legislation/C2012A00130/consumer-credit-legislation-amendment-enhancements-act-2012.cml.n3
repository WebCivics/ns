concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-3-sec-3 a cml:Concept ;
    skos:prefLabel "3 At the end of section 111"@en ;
    cml:realizedBy doc:sch-3-sec-3 ;
    values:originalText "Add: ComLaw Authoritative Act C2012A00130  Short-term and small amount credit contracts  Schedule 3  Division 7 prohibits a licensee from providing credit assistance to a consumer in relation to short-term credit contracts. It also imposes requirements on a licensee who makes representations about providing credit assistance in relation to small amount credit contracts." ;
    skos:definition "Add: ComLaw Authoritative Act C2012A00130  Short-term and small amount credit contracts  Schedule 3  Division 7 prohibits a licensee from providing credit assistance to a consumer in relation to short-term credit contracts. It also imposes requirements on a licensee who makes representations about providing credit assistance in relation to small amount credit contracts."@en ;
    cml:integrityHash "89c057831f9f001a4a8af05a9f8f711619ceb82ee5ff1330d2ad48fbe049ba31" ;
    cof:pageNumber "52"^^xsd:integer ;
    skos:note "Division 7 prohibits a licensee from providing credit assistance to a consumer in relation to short-term credit contracts." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.52" ;
    cml:asserts concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-3-sec-3-norm .
