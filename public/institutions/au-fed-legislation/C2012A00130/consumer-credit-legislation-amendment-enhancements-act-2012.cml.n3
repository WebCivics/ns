concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-14 a cml:Concept ;
    skos:prefLabel "14 Subsection 173(1) of the National Credit Code"@en ;
    cml:realizedBy doc:sch-5-sec-14 ;
    values:originalText "Repeal the subsection, substitute:  (1) A consumer lease must be in the form of a written lease document:  (a) signed by the lessor and the lessee; and  (b) containing the information required by this Division.  (1A) Subject to subsection (2), a consumer lease may consist of one or more separate documents." ;
    skos:definition "Repeal the subsection, substitute:  (1) A consumer lease must be in the form of a written lease document:  (a) signed by the lessor and the lessee; and  (b) containing the information required by this Division.  (1A) Subject to subsection (2), a consumer lease may consist of one or more separate documents."@en ;
    cml:integrityHash "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b" ;
    cof:pageNumber "77"^^xsd:integer ;
