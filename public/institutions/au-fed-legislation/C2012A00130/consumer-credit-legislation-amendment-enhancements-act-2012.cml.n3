doc:sch-4-sec-32b-ss-4a a cof:Section ;
    cof:title "32B(4A) Calculation of annual cost rate" ;
    values:kind "subsection" ;
    values:originalText "(4A) Despite subsection (3), the regulations may provide that a specified amount, or an amount included in a specified class, is not an amount referred to in paragraph (3)(a) or (b). Tolerances and assumptions etc." ;
    cof:pageNumber "67"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-4-sec-32b-ss-5 a cml:Concept ;
