doc:sch-5-sec-178a-ss-1 a cof:Section ;
    cof:title "178A(1) Termination before goods have been provided" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a consumer lease has been entered into; and  (b) the goods hired under the lease have not been provided; then the lessee may, by written notice to the lessor, terminate the lease." ;
    cof:pageNumber "91"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-178a-ss-2 a cml:Concept ;
    skos:prefLabel "178A(2) Termination before goods have been provided"@en ;
    cml:realizedBy doc:sch-5-sec-178a-ss-2 ;
    values:originalText "(2) Nothing in subsection (1) prevents the lessor from retaining or requiring payment of fees or charges incurred before the termination and which would have been payable under the consumer lease." ;
    skos:definition "(2) Nothing in subsection (1) prevents the lessor from retaining or requiring payment of fees or charges incurred before the termination and which would have been payable under the consumer lease."@en ;
    cml:integrityHash "3055d417495f2911579ed5de6980818567a0d0e0f5337d71a41bb19303e12024" ;
    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-178a ;
    cof:pageNumber "91"^^xsd:integer ;
    skos:note "Lessor may retain or require payment of fees incurred before termination." ;
