concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-40 a cml:Concept ;
    skos:prefLabel "40 Changes etc. under contracts"@en ;
    cml:realizedBy doc:sch-1-sec-40 ;
    values:originalText "If:  (a) there is:  (i) a change to an existing credit contract that results in further credit being provided; or  (ii) a deferral or waiver of an amount under an existing credit contract; or  (iii) a postponement relating to an existing credit contract; and  (b) the change, deferral, waiver or postponement is made in accordance with this Code or the existing credit contract; then the change, deferral, waiver or postponement is not to be treated as creating a new credit contract for the purposes of this Code." ;
    skos:definition "If:  (a) there is:  (i) a change to an existing credit contract that results in further credit being provided; or  (ii) a deferral or waiver of an amount under an existing credit contract; or  (iii) a postponement relating to an existing credit contract; and  (b) the change, deferral, waiver or postponement is made in accordance with this Code or the existing credit contract; then the change, deferral, waiver or postponement is not to be treated as creating a new credit contract for the purposes of this Code."@en ;
    cml:integrityHash "b18c531f18615b0adbf886c324b688ae41381145262693b734506870a0eac842" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Change, deferral, waiver, or postponement of credit contract not creating new contract." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.28" ;
    cml:asserts concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-40-norm .
