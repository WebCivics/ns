concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179w a cml:Concept ;
    skos:prefLabel "179W Application of certain Code provisions to consumer leases"@en ;
    cml:realizedBy doc:sch-5-sec-179w ;
    values:originalText "(1) Part 12 (relating to miscellaneous matters) and subsection 204(2) (definition of associated) apply in relation to a consumer lease in the same way as they apply in relation to a credit contract.  (2) For the purposes of the application of those provisions:  (a) references to a credit provider are to be read as references to a lessor; and  (b) references to a debtor are to be read as references to a lessee; and  (c) references to a credit contract or contract are to be read as references to a consumer lease; and  (d) references to a linked credit provider are to be read as references to a linked lessor." ;
    skos:definition "(1) Part 12 (relating to miscellaneous matters) and subsection 204(2) (definition of associated) apply in relation to a consumer lease in the same way as they apply in relation to a credit contract.  (2) For the purposes of the application of those provisions:  (a) references to a credit provider are to be read as references to a lessor; and  (b) references to a debtor are to be read as references to a lessee; and  (c) references to a credit contract or contract are to be read as references to a consumer lease; and  (d) references to a linked credit provider are to be read as references to a linked lessor."@en ;
    cml:integrityHash "a5b694e82575def193d88b2872e374968e99c6f3998606f7ef416288aa518b54" ;
    cof:pageNumber "104"^^xsd:integer ;
    cml:hasPart concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179w-ss-1 ;
    cml:hasPart concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179w-ss-2 ;
