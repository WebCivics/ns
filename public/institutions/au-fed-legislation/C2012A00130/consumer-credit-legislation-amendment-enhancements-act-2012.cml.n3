concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-15 a cml:Concept ;
    skos:prefLabel "15 After subsection 173(2) of the National Credit Code"@en ;
    cml:realizedBy doc:sch-5-sec-15 ;
    values:originalText "Insert:  (2A) In the case of a lease document consisting of more than one document, it is sufficient compliance with this section if one of the documents is duly signed and the other documents are referred to in the signed document." ;
    skos:definition "Insert:  (2A) In the case of a lease document consisting of more than one document, it is sufficient compliance with this section if one of the documents is duly signed and the other documents are referred to in the signed document."@en ;
