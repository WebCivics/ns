    skos:definition "Insert: Some defaults are not a basis for a default notice  (7A) So far as a notice purporting to be a default notice relates to an alleged default under a credit contract for a reverse mortgage that ComLaw Authoritative Act C2012A00130  Schedule 2  Reverse mortgages"@en ;
    cml:integrityHash "94610c3ac883eaf33819bae259c3e5c008d6c02d9031c882aa565775375a2fcd" ;
