concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-2-sec-5 a cml:Concept ;
    skos:prefLabel "5 Subsection 204(1) of the National Credit Code"@en ;
    cml:realizedBy doc:sch-2-sec-5 ;
    values:originalText "Insert: bridging finance contract: a credit contract is a bridging finance contract if:  (a) when the contract is made, the debtor:  (i) reasonably expects to receive a lump sum before the term of the contract ends; and  (ii) intends to discharge the debtor’s obligations under the contract so far as possible with that sum; and  (aa) the term of the contract is 2 years or less; and  (b) the conditions (if any) prescribed by the regulations are met." ;
    skos:definition "Insert: bridging finance contract: a credit contract is a bridging finance contract if:  (a) when the contract is made, the debtor:  (i) reasonably expects to receive a lump sum before the term of the contract ends; and  (ii) intends to discharge the debtor’s obligations under the contract so far as possible with that sum; and  (aa) the term of the contract is 2 years or less; and  (b) the conditions (if any) prescribed by the regulations are met."@en ;
    cml:integrityHash "8b6da495413e6c4388115d296dbdcc4c52a6d62fa6d1b7dd5e9b6f066000ce3b" ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Debtors must reasonably expect to receive a lump sum before the contract ends and intend to discharge their obligations with that sum." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.33" ;
    cml:asserts concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-2-sec-5-norm .
