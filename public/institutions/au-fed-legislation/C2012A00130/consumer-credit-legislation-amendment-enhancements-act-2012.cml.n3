    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175e ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Must provide statement to a requesting lessee, not all joint lessees." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
