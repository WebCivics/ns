concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-3-sec-4 a cml:Concept ;
    skos:prefLabel "4 After subsection 117(1)"@en ;
    cml:realizedBy doc:sch-3-sec-4 ;
    values:originalText "Insert:  (1A) If:  (a) the credit contract is a small amount credit contract; and  (b) the consumer holds (whether alone or jointly with another person) an account with an ADI into which income payable to the consumer is credited; the licensee must, in verifying the consumer’s financial situation for the purposes of paragraph 115(1)(d), obtain and consider account statements that cover at least the immediately preceding period of 90 days.  (1B) Subsection (1A) does not limit paragraph (1)(c) of this section." ;
    skos:definition "Insert:  (1A) If:  (a) the credit contract is a small amount credit contract; and  (b) the consumer holds (whether alone or jointly with another person) an account with an ADI into which income payable to the consumer is credited; the licensee must, in verifying the consumer’s financial situation for the purposes of paragraph 115(1)(d), obtain and consider account statements that cover at least the immediately preceding period of 90 days.  (1B) Subsection (1A) does not limit paragraph (1)(c) of this section."@en ;
    cml:integrityHash "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4" ;
    cof:pageNumber "53"^^xsd:integer ;
