concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-5 a cml:Concept ;
    skos:prefLabel "5 Subparagraphs 88(3)(f)(i) and (ii) of the National Credit"@en ;
    cml:realizedBy doc:sch-1-sec-5 ;
    values:originalText "Code Repeal the subparagraphs, substitute:  (i) give a hardship notice under section 72; or  (ii) give a postponement request under section 94; or" ;
