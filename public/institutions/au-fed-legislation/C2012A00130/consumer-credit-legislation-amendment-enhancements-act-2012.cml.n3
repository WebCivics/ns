concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-28 a cml:Concept ;
    skos:prefLabel "28 Subsection 124(2) of the National Credit Code"@en ;
    cml:realizedBy doc:sch-1-sec-28 ;
    values:originalText "Repeal the subsection, substitute:  (2) An application for the exercise of the court’s powers under this section may be made by:  (a) a person affected by the contravention; or  (b) ASIC on behalf of a person affected by the contravention, if the person has consented in writing to ASIC making the application; or  (c) ASIC (on its own behalf). ComLaw Authoritative Act C2012A00130  Schedule 1  Enhancements" ;
    skos:definition "Repeal the subsection, substitute:  (2) An application for the exercise of the court’s powers under this section may be made by:  (a) a person affected by the contravention; or  (b) ASIC on behalf of a person affected by the contravention, if the person has consented in writing to ASIC making the application; or  (c) ASIC (on its own behalf). ComLaw Authoritative Act C2012A00130  Schedule 1  Enhancements"@en ;
    cml:integrityHash "ade50468bfa47a8c25a3e8e8d647c40c15919116e20db0d42dce15560d4e923f" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Allow for an application by a person affected, ASIC on behalf of a person affected with consent, or ASIC alone." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.25" ;
    cml:asserts concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-1-sec-28-norm .
