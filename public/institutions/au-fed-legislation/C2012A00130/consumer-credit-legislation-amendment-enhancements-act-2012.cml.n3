doc:sch-5-sec-175b-ss-2 a cof:Section ;
    cof:title "175B(2) Fees or charges in relation to third parties" ;
    values:kind "subsection" ;
    values:originalText "(2) If, when the fee or charge is paid by the lessee to the lessor, the third party amount is ascertainable, then the amount of the fee or charge must not exceed the third party amount. Third party amount not ascertainable at time of lessee payment" ;
    cof:pageNumber "78"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175b-ss-3 a cml:Concept ;
    skos:prefLabel "175B(3) Fees or charges in relation to third parties"@en ;
    cml:realizedBy doc:sch-5-sec-175b-ss-3 ;
    values:originalText "(3) If: ComLaw Authoritative Act C2012A00130  Consumer leases  Schedule 5  (a) when the fee or charge is paid by the lessee to the lessor, the third party amount is not ascertainable; and  (b) after the fee or charge is paid, the lessor ascertains the third party amount; and  (c) the third party amount is less than the amount of the fee or charge paid; then the lessor must refund or credit the difference to the lessee. Determining third party amount" ;
    skos:definition "(3) If: ComLaw Authoritative Act C2012A00130  Consumer leases  Schedule 5  (a) when the fee or charge is paid by the lessee to the lessor, the third party amount is not ascertainable; and  (b) after the fee or charge is paid, the lessor ascertains the third party amount; and  (c) the third party amount is less than the amount of the fee or charge paid; then the lessor must refund or credit the difference to the lessee. Determining third party amount"@en ;
    cml:integrityHash "a20cc076441a3811812f88c6e86235d489744fa02151d143cbe30d1dd52b7604" ;
    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175b ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Refund difference if third party amount is less than fee or charge paid" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
