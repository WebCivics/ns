concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-35 a cml:Concept ;
    skos:prefLabel "35 Subsection 204(1) of the National Credit Code"@en ;
    cml:realizedBy doc:sch-5-sec-35 ;
    values:originalText "Insert: on demand facility means a credit contract or mortgage under which:  (a) the total amount outstanding under the contract or mortgage is repayable at any time on demand by the credit provider; and  (b) there is no agreement, arrangement or understanding between the credit provider and the debtor or mortgagor that repayment will only be demanded on the occurrence or non-occurrence of a particular event." ;
    skos:definition "Insert: on demand facility means a credit contract or mortgage under which:  (a) the total amount outstanding under the contract or mortgage is repayable at any time on demand by the credit provider; and  (b) there is no agreement, arrangement or understanding between the credit provider and the debtor or mortgagor that repayment will only be demanded on the occurrence or non-occurrence of a particular event."@en ;
    cml:integrityHash "c7fb27dc5d59365271aa9de477ac88b5c11749f01e1fd183166a5a2fdf50a054" ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "Demand facility is prohibited under subsection 204(1) of the National Credit Code." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
