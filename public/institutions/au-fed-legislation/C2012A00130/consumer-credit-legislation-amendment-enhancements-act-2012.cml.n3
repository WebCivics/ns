doc:sch-5-sec-179r-ss-1 a cof:Section ;
    cof:title "179R(1) Recovery of enforcement expenses" ;
    values:kind "subsection" ;
    values:originalText "(1) A lessor must not recover or seek to recover enforcement expenses from a lessee in excess of those reasonably incurred by the lessor. Enforcement expenses of a lessor extend to those reasonably incurred by the use of the staff and facilities of the lessor." ;
    cof:pageNumber "101"^^xsd:integer .

concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179r-ss-2 a cml:Concept ;
    skos:prefLabel "179R(2) Recovery of enforcement expenses"@en ;
    cml:realizedBy doc:sch-5-sec-179r-ss-2 ;
    values:originalText "(2) Any provision of the consumer lease that appears to confer a greater right is void. If enforcement expenses are in fact recovered in excess of this limitation, they may be recovered back." ;
    skos:definition "(2) Any provision of the consumer lease that appears to confer a greater right is void. If enforcement expenses are in fact recovered in excess of this limitation, they may be recovered back."@en ;
    cml:integrityHash "58b74284ebb9986c6f95c7b16f6db967d1cb2645d4830d711ce811189cded944" ;
    values:partOf concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-179r ;
    cof:pageNumber "101"^^xsd:integer ;
    skos:note "Prohibits consumer lease provisions from conferring greater rights than specified." ;
