concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175j a cml:Concept ;
    skos:prefLabel "175J Changes etc. under consumer leases"@en ;
    cml:realizedBy doc:sch-5-sec-175j ;
    values:originalText "If:  (a) there is:  (i) a change to an existing consumer lease that results in further goods being provided; or  (ii) a deferral or waiver of an amount under an existing consumer lease; or  (iii) a postponement relating to an existing consumer lease; and  (b) the change, deferral, waiver or postponement is made in accordance with this Code or the existing consumer lease; ComLaw Authoritative Act C2012A00130  Consumer leases  Schedule 5  then the change, deferral, waiver or postponement is not to be treated as creating a new consumer lease or a credit contract for the purposes of this Code." ;
    skos:definition "If:  (a) there is:  (i) a change to an existing consumer lease that results in further goods being provided; or  (ii) a deferral or waiver of an amount under an existing consumer lease; or  (iii) a postponement relating to an existing consumer lease; and  (b) the change, deferral, waiver or postponement is made in accordance with this Code or the existing consumer lease; ComLaw Authoritative Act C2012A00130  Consumer leases  Schedule 5  then the change, deferral, waiver or postponement is not to be treated as creating a new consumer lease or a credit contract for the purposes of this Code."@en ;
    cml:integrityHash "0c5079fa53467ae0abfa2490c53a809b2160b9ba91dc60d2e18eb0f6b5268bcd" ;
    cof:pageNumber "82"^^xsd:integer ;
    skos:note "Change, deferral, waiver, or postponement of an existing consumer lease is not treated as creating a new consumer lease." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <consumer-credit-legislation-amendment-enhancements-act-2012.pdf> ;
    dc:source "consumer-credit-legislation-amendment-enhancements-act-2012.pdf, p.82" ;
    cml:asserts concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175j-norm .
