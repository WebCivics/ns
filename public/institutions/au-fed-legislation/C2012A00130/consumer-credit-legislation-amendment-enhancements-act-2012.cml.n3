    cml:premiseText "The fee amount must be disregarded." ;
    cml:conclusionText "The first amount of credit is reduced by the fee amount." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

