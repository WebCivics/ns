concept:consumer-credit-legislation-amendment-enhancements-act-2012-sch-5-sec-175a a cml:Concept ;
    skos:prefLabel "175A Prohibited consumer lease fees or charges"@en ;
    cml:realizedBy doc:sch-5-sec-175a ;
    values:originalText "The regulations may specify:  (a) consumer lease fees or charges; or  (b) classes of consumer lease fees or charges; that are prohibited for the purposes of this Code." ;
    skos:definition "The regulations may specify:  (a) consumer lease fees or charges; or  (b) classes of consumer lease fees or charges; that are prohibited for the purposes of this Code."@en ;
    cml:integrityHash "0db6ef37f5f8ca4397893be0f201774c5457e9de531ffa8d8b43ab20d8a2c3d2" ;
