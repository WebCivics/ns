    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-376-4-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.33",
      "skos:note": "Using a false identification to obtain an air passenger ticket is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "376(2) Section 376"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-376-4-ss-2-norm",
        "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-376-4-ss-2-logic-deontic-1"
      ],
      "cml:curationStatus": {
