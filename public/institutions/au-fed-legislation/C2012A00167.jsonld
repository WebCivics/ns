      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits possession or conduct in relation to the substance or plant.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(iv) possession or conduct in relation to the substance or plant is proscribed under a law of a State, a Territory or a foreign country that has purposes similar to those of this Part;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permits possession or conduct in relation to the substance or plant under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(ii) taking the substance or plant would have a physical or mental effect substantially similar to that caused by taking a serious drug that is already listed;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-logic-deontic-4",
