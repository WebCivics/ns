        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes an obligation on the person to take certain actions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(iii) the substance or plant has the capacity to cause physiological dependence;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-logic-deontic-5",
