      },
      "cml:integrityHash": "414a2d1c5740b9bb7bad7994749bbdde1cfb2152fd5ebce342af0103291bbd21",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-2-sec-376-4-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-376-4"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-376-4-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The use of a false identification to obtain an air passenger ticket is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of using a false identification to obtain an air passenger ticket.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(2) A person (the defendant) commits an offence if:  (a) the defendant takes a flight using an air passenger ticket; and  (b) identification information was used (whether by the defendant or another person) to obtain the ticket; and  (c) the information resulted in the identification of a person as a passenger on the flight; and  (d) the information is false in relation to the defendant; and  (e) the flight is a constitutional flight. Penalty: Imprisonment for 12 months."
    },
