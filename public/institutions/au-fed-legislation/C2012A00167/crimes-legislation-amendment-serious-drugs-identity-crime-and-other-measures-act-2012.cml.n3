doc:sch-1-sec-301-23-ss-1 a cof:Section ;
    cof:title "301(1) 17  Emergency determinations—publication" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister must, on or before the day on which a determination under this Subdivision is registered (within the meaning of the Legislative Instruments Act 2003):  (a) make a public announcement of the determination; and  (b) cause a copy of the announcement to be published:  (i) on the internet; and  (ii) in a newspaper circulating in each State, the Australian Capital Territory and the Northern Territory." ;
    cof:pageNumber "20"^^xsd:integer .

