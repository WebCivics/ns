concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-14 a cml:Concept ;
    skos:prefLabel "301 8  Serious drug precursors—conditions for listing by regulation"@en ;
    cml:realizedBy doc:sch-1-sec-301-14 ;
    values:originalText "Before a regulation is made listing a substance as a controlled precursor or a border controlled precursor, the Minister must be satisfied that there is a risk that the substance will be used to unlawfully manufacture a controlled drug (other than a determined controlled drug)." ;
    skos:definition "Before a regulation is made listing a substance as a controlled precursor or a border controlled precursor, the Minister must be satisfied that there is a risk that the substance will be used to unlawfully manufacture a controlled drug (other than a determined controlled drug)."@en ;
    cml:integrityHash "d1619219ac385552b4481d51addf2605007297c9eb6946de273253692f473280" ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Risk assessment required before listing a substance as a controlled precursor." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf> ;
