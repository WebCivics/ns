concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-3um-ss-5 a cml:Concept ;
    skos:prefLabel "3UM(5) Identity information at airports—requirements"@en ;
    cml:realizedBy doc:sch-2-sec-3um-ss-5 ;
    values:originalText "(5) If the constable is not in uniform, the constable must give the suspect any of the following information if requested by the suspect:  (a) the constable’s name;  (b) the address of the constable’s place of duty;  (c) the constable’s identification number (if any);  (d) if the constable has no identification number—the constable’s rank." ;
    skos:definition "(5) If the constable is not in uniform, the constable must give the suspect any of the following information if requested by the suspect:  (a) the constable’s name;  (b) the address of the constable’s place of duty;  (c) the constable’s identification number (if any);  (d) if the constable has no identification number—the constable’s rank."@en ;
    cml:integrityHash "d4d235834a84870fc97d46aa6e8232ab7bf04d70cad353700f5383e036b1a29c" ;
    values:partOf concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-3um ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Must provide suspect with certain information if requested." ;
    dc:description "true" ;
