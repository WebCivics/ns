concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-3-sec-4 a cml:Concept ;
    skos:prefLabel "4 Subsection 156(3)"@en ;
    cml:realizedBy doc:sch-3-sec-4 ;
    values:originalText "Repeal the subsection, substitute:  (3) The Minister must not refer the ACLEI corruption issue to the Integrity Commissioner for investigation under Division 3 if the ACLEI corruption issue relates to the conduct of:  (a) the Integrity Commissioner; or  (b) an Assistant Integrity Commissioner." ;
    skos:definition "Repeal the subsection, substitute:  (3) The Minister must not refer the ACLEI corruption issue to the Integrity Commissioner for investigation under Division 3 if the ACLEI corruption issue relates to the conduct of:  (a) the Integrity Commissioner; or  (b) an Assistant Integrity Commissioner."@en ;
    cml:integrityHash "3e0f03fb66cd9eeae11f7c4de12d34ba17880e8733042f0f02bfa5b5dfc9c3b7" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Cannot refer ACLEI corruption issue to Integrity Commissioner for investigation under Division 3 if it relates to the conduct of the Integrity Commissioner or an Assistant Integrity Commissioner." ;
    cml:curationStatus cml:Proposed ;
