doc:sch-2-sec-26-ss-3 a cof:Section ;
    cof:title "26(3) Crimes Legislation Amendment (Serious Drugs, Identity Crime and Other Measures)" ;
    values:kind "subsection" ;
    values:originalText "(3) A person commits an offence if:  (a) the person is subject to a requirement under subsection 3UM(4); and  (b) the person engages in conduct; and  (c) the conduct breaches the requirement. Penalty: 5 penalty units." ;
    cof:pageNumber "30"^^xsd:integer .

concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-26-ss-4 a cml:Concept ;
