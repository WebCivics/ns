doc:sch-2-sec-370-2-ss-2 a cof:Section ;
    cof:title "370(2) 3  Concurrent operation intended" ;
    values:kind "subsection" ;
    values:originalText "(2) Without limiting subsection (1), this Part is not intended to exclude or limit the concurrent operation of a law of a State or Territory that makes:  (a) an act or omission that is an offence against a provision of this Part; or  (b) a similar act or omission; an offence against the law of the State or Territory." ;
    cof:pageNumber "23"^^xsd:integer .

concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-370-2-ss-3 a cml:Concept ;
    skos:prefLabel "370(3) 3  Concurrent operation intended"@en ;
    cml:realizedBy doc:sch-2-sec-370-2-ss-3 ;
    values:originalText "(3) Subsection (2) applies even if the law of the State or Territory does any one or more of the following:  (a) provides for a penalty for the offence that differs from the penalty provided for in this Part;  (b) provides for a fault element in relation to the offence that differs from the fault elements applicable to the offence under this Part; ComLaw Authoritative Act C2012A00167  Schedule 2  Identity crime and air travel" ;
    skos:definition "(3) Subsection (2) applies even if the law of the State or Territory does any one or more of the following:  (a) provides for a penalty for the offence that differs from the penalty provided for in this Part;  (b) provides for a fault element in relation to the offence that differs from the fault elements applicable to the offence under this Part; ComLaw Authoritative Act C2012A00167  Schedule 2  Identity crime and air travel"@en ;
    cml:integrityHash "ce1f92b86594503c3b1902b80937ba2492f8f8cb155840a464edd2b223e52e94" ;
    values:partOf concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-370-2 ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "Penalty and fault element differences do not affect applicability of subsection (2)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf> ;
