    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Concurrent laws overlap in time and space" ;
    cml:premiseText "This Part does not exclude or limit concurrent operation of a law." ;
    cml:conclusionText "Concurrent laws overlap." ;
