    cml:modality cml:Diffusion ;
    cml:operator "Spread" ;
    cml:logicSummary "The prohibition on referring ACLEI corruption issue to Integrity Commissioner for investigation under Division 3 spreads to all related issues if they relate to the conduct of the Integrity Commissioner or an Assistant Integrity Commissioner." ;
