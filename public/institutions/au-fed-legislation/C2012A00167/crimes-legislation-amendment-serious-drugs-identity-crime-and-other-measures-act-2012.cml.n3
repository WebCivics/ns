    cof:pageNumber "32"^^xsd:integer .

concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-28-ss-2 a cml:Concept ;
    skos:prefLabel "28(2) Crimes Legislation Amendment (Serious Drugs, Identity Crime and Other Measures)"@en ;
    cml:realizedBy doc:sch-2-sec-28-ss-2 ;
    values:originalText "(2) A person (the defendant) commits an offence if:  (a) the defendant takes a flight using an air passenger ticket; and  (b) identification information was used (whether by the defendant or another person) to obtain the ticket; and  (c) the information resulted in the identification of a person as a passenger on the flight; and  (d) the information is false in relation to the defendant; and  (e) a carriage service was used (whether by the defendant or another person) to obtain the ticket; and  (f) the flight starts or ends within Australia. Penalty: Imprisonment for 12 months. General" ;
    skos:definition "(2) A person (the defendant) commits an offence if:  (a) the defendant takes a flight using an air passenger ticket; and  (b) identification information was used (whether by the defendant or another person) to obtain the ticket; and  (c) the information resulted in the identification of a person as a passenger on the flight; and  (d) the information is false in relation to the defendant; and  (e) a carriage service was used (whether by the defendant or another person) to obtain the ticket; and  (f) the flight starts or ends within Australia. Penalty: Imprisonment for 12 months. General"@en ;
    cml:integrityHash "34899bc0579ab2a46194db4398e2bce9d0c81181ac93b48365b38eb9ce935991" ;
    values:partOf concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-28 ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "Taking a flight using an air passenger ticket with false identification information is prohibited." ;
