          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-16-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e81ee31909b8e6e7cad978680cfe2c8b73589488ece0541d5c5fc0697b3277eb",
      "skos:note": "Defines commercial quantity of serious drugs and precursors"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301-16",
