      "cml:integrityHash": "3e0f03fb66cd9eeae11f7c4de12d34ba17880e8733042f0f02bfa5b5dfc9c3b7",
      "skos:note": "Cannot refer ACLEI corruption issue to Integrity Commissioner for investigation under Division 3 if it relates to the conduct of the Integrity Commissioner or an Assistant Integrity Commissioner."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-3-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsection 156(3)",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The Minister must not refer the ACLEI corruption issue to the\nIntegrity Commissioner for investigation under Division 3 if the\nACLEI corruption issue relates to the conduct of:\n\n(a) the Integrity Commissioner; or\n\n(b) an Assistant Integrity Commissioner."
    },
