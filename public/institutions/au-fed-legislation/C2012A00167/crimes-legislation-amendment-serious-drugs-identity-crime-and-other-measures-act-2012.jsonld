    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "301 12  Meaning of trafficable quantity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.17",
      "values:originalText": "For the purposes of this Part, a trafficable quantity of a controlled\ndrug or a controlled plant is a quantity not less than that provided\nby the following table:\n\nTrafficable quantities of controlled drugs and plants\nItem\nControlled drug or\nplant\nTrafficable quantity (minimum)\nA controlled drug\n(other than a drug\nanalogue) or a\ncontrolled plant\nEither:\n(a) the quantity listed as a trafficable quantity of\nthe drug or plant in a regulation made for the\npurposes of this section; or\n(b) the quantity determined as a trafficable\nquantity of the drug or plant by the Minister\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs",
      "skos:definition": "For the purposes of this Part, a trafficable quantity of a controlled\ndrug or a controlled plant is a quantity not less than that provided\nby the following table:\n\nTrafficable quantities of controlled drugs and plants\nItem\nControlled drug or\nplant\nTrafficable quantity (minimum)\nA controlled drug\n(other than a drug\nanalogue) or a\ncontrolled plant\nEither:\n(a) the quantity listed as a trafficable quantity of\nthe drug or plant in a regulation made for the\npurposes of this section; or\n(b) the quantity determined as a trafficable\nquantity of the drug or plant by the Minister\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-18-norm"
        },
