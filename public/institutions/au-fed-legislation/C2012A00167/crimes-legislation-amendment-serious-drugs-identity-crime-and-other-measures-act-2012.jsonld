    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Crimes Legislation Amendment (Serious Drugs, Identity Crime and Other Measures)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-10-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.14",
      "values:originalText": "(b) one or more of the following conditions is met:\n\n(i) taking the substance or plant would create a risk of\ndeath or serious harm;\n\n(ii) taking the substance or plant would have a physical or\nmental effect substantially similar to that caused by\ntaking a serious drug that is already listed;\n\n(iii) the substance or plant has the capacity to cause\nphysiological dependence;\n\n(iv) possession or conduct in relation to the substance or\nplant is proscribed under a law of a State, a Territory or\na foreign country that has purposes similar to those of\nthis Part;\n\n(v) the substance or plant poses a substantial risk to the\nhealth or safety of the public.",
      "skos:definition": "(b) one or more of the following conditions is met:\n\n(i) taking the substance or plant would create a risk of\ndeath or serious harm;\n\n(ii) taking the substance or plant would have a physical or\nmental effect substantially similar to that caused by\ntaking a serious drug that is already listed;\n\n(iii) the substance or plant has the capacity to cause\nphysiological dependence;\n\n(iv) possession or conduct in relation to the substance or\nplant is proscribed under a law of a State, a Territory or\na foreign country that has purposes similar to those of\nthis Part;\n\n(v) the substance or plant poses a substantial risk to the\nhealth or safety of the public.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-logic-deontic-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-logic-deontic-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-10-2-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "36bad11cf8605c06a393f47dafef7ebffd5e96961c346c086c2729d56c5e0837",
      "skos:note": "Possession or conduct in relation to the substance or plant is proscribed under a law of a State, a Territory or a foreign country that has purposes similar to those of this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-10-2",
      "@type": "cof:Section",
      "cof:title": "10 Crimes Legislation Amendment (Serious Drugs, Identity Crime and Other Measures)",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "(b) one or more of the following conditions is met:\n\n(i) taking the substance or plant would create a risk of\ndeath or serious harm;\n\n(ii) taking the substance or plant would have a physical or\nmental effect substantially similar to that caused by\ntaking a serious drug that is already listed;\n\n(iii) the substance or plant has the capacity to cause\nphysiological dependence;\n\n(iv) possession or conduct in relation to the substance or\nplant is proscribed under a law of a State, a Territory or\na foreign country that has purposes similar to those of\nthis Part;\n\n(v) the substance or plant poses a substantial risk to the\nhealth or safety of the public."
    },
