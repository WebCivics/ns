      },
      "cml:premiseText": "Minister must make a determination.",
      "cml:conclusionText": "Minister may not make a determination."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-20-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Minister has an obligation to make a determination only if there is an imminent and substantial risk.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There is an imminent and substantial risk that the substance will be used to unlawfully manufacture a controlled drug.",
      "cml:conclusionText": "Minister must make a determination."
    },
    {
