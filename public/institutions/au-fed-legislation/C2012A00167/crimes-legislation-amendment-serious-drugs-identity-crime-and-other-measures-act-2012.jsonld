        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:logicSummary": "Conditional obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A determination can be made for paragraph (d)",
      "cml:conclusionText": "If a determination is made, then the substance is a border controlled precursor under section 301.14"
    },
