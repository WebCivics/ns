      ],
      "cml:integrityHash": "8113c380b57f573ff358cbf38c363c39363a42e1da21b584e5943edd8ebab7a3",
      "skos:note": "Minister must be satisfied that substance or plant is likely to be taken without appropriate medical supervision."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301-13",
      "@type": "cof:Section",
      "cof:title": "301 7  Serious drugs—conditions for listing by regulation",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Before a regulation is made listing a substance or plant as a serious\ndrug for the purposes of this Part, the Minister must be satisfied\nthat:\n\n(a) the substance or plant is likely to be taken without\nappropriate medical supervision; and\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs"
    },
