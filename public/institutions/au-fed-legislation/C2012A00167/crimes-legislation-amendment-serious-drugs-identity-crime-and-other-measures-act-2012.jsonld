    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-14-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Crimes Legislation Amendment (Serious Drugs, Identity Crime and Other Measures)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-14-2"
      },
      "cml:curationStatus": {
