        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister is required to make a regulation listing a substance or plant as a serious drug.",
      "cml:conclusionText": "The Minister must be satisfied that the substance or plant is likely to be taken without appropriate medical supervision."
    },
    {
