    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "301 8  Serious drug precursors—conditions for listing by regulation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.14",
      "values:originalText": "Before a regulation is made listing a substance as a controlled\nprecursor or a border controlled precursor, the Minister must be\nsatisfied that there is a risk that the substance will be used to\nunlawfully manufacture a controlled drug (other than a determined\ncontrolled drug).",
      "skos:definition": "Before a regulation is made listing a substance as a controlled\nprecursor or a border controlled precursor, the Minister must be\nsatisfied that there is a risk that the substance will be used to\nunlawfully manufacture a controlled drug (other than a determined\ncontrolled drug).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-14-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d1619219ac385552b4481d51addf2605007297c9eb6946de273253692f473280",
      "skos:note": "Risk assessment required before listing a substance as a controlled precursor."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301-14",
      "@type": "cof:Section",
      "cof:title": "301 8  Serious drug precursors—conditions for listing by regulation",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Before a regulation is made listing a substance as a controlled\nprecursor or a border controlled precursor, the Minister must be\nsatisfied that there is a risk that the substance will be used to\nunlawfully manufacture a controlled drug (other than a determined\ncontrolled drug)."
    },
