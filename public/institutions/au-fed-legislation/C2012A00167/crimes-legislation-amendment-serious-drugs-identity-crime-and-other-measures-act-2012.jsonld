    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-370-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Definition of a term",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "foreign indictable offence means an offence against a law of a foreign country or part of a foreign country that is constituted by conduct that, if engaged in in Australia, would constitute an indictable offence against a law of the Commonwealth."
    },
