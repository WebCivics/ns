      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.13",
      "values:originalText": "Before a regulation is made listing a substance or plant as a serious\ndrug for the purposes of this Part, the Minister must be satisfied\nthat:\n\n(a) the substance or plant is likely to be taken without\nappropriate medical supervision; and\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs",
      "skos:definition": "Before a regulation is made listing a substance or plant as a serious\ndrug for the purposes of this Part, the Minister must be satisfied\nthat:\n\n(a) the substance or plant is likely to be taken without\nappropriate medical supervision; and\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-13-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-13-logic-deontic-1"
