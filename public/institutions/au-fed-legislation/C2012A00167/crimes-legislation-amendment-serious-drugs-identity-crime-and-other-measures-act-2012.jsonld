    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-2-sec-26-ss-3",
      "@type": "cof:Section",
      "cof:title": "26(3) Crimes Legislation Amendment (Serious Drugs, Identity Crime and Other Measures)",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(3) A person commits an offence if:\n\n(a) the person is subject to a requirement under subsection\n3UM(4); and\n\n(b) the person engages in conduct; and\n\n(c) the conduct breaches the requirement.\nPenalty: 5 penalty units."
    },
