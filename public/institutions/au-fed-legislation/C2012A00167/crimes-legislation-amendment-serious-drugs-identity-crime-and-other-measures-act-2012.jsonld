      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.7",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "31898fd60107fff31b21d70760d9ee6c60e0bd836fefed1546438d9af9f52d74",
      "skos:note": "Amends or repeals Acts specified in a Schedule according to its terms."
    },
