    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "301 4  Meaning of border controlled drug",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.12",
      "values:originalText": "For the purposes of this Part, a border controlled drug is a\nsubstance, other than a growing plant, that is:\n\n(a) listed by a regulation as a border controlled drug; or\n\n(b) a drug analogue of a listed border controlled drug; or\n\n(c) determined by the Minister as a border controlled drug under\nsection 301.13 (which deals with emergency determinations\nof serious drugs).\nNote 1:\nSome conditions must be satisfied before:\n(a) a regulation can be made for paragraph (a) (see section 301.7); or\n(b) a determination can be made for paragraph (c) (see subsection",
