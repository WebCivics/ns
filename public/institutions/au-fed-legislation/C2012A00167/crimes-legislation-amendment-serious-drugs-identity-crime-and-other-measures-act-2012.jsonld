      ],
      "cml:integrityHash": "4204cbec77bb28c925ecdc9ee07e021abcad1a2e70f9e9c8fd20e0f2257c1c8c",
      "skos:note": "Public announcement and publication of emergency determination"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301-23-ss-1",
      "@type": "cof:Section",
      "cof:title": "301(1) 17  Emergency determinations—publication",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(1) The Minister must, on or before the day on which a determination\nunder this Subdivision is registered (within the meaning of the\nLegislative Instruments Act 2003):\n\n(a) make a public announcement of the determination; and\n\n(b) cause a copy of the announcement to be published:\n\n(i) on the internet; and\n\n(ii) in a newspaper circulating in each State, the Australian\nCapital Territory and the Northern Territory."
    },
