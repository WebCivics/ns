    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Application—offences committed after commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.22",
      "values:originalText": "The amendments made by this Schedule apply in relation to offences\nagainst Part 9.1 of the Criminal Code that are committed on or after the\ncommencement of Part 1 of this Schedule.\nNote:\nFor the commencement of Part 1 of this Schedule, see section 2 of this Act.",
      "skos:definition": "The amendments made by this Schedule apply in relation to offences\nagainst Part 9.1 of the Criminal Code that are committed on or after the\ncommencement of Part 1 of this Schedule.\nNote:\nFor the commencement of Part 1 of this Schedule, see section 2 of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-23-norm"
        }
      ],
      "cml:integrityHash": "259a07380f229e7f0a78789e8f6c55c4e7893bfe57007ca2c828a76c4636a8fe",
      "skos:note": "Amendments apply to offences committed after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Application—offences committed after commencement",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "The amendments made by this Schedule apply in relation to offences\nagainst Part 9.1 of the Criminal Code that are committed on or after the\ncommencement of Part 1 of this Schedule.\nNote:\nFor the commencement of Part 1 of this Schedule, see section 2 of this Act."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-23-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-23"
