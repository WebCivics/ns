      "skos:prefLabel": "26 Crimes Legislation Amendment (Serious Drugs, Identity Crime and Other Measures)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-2-sec-26"
