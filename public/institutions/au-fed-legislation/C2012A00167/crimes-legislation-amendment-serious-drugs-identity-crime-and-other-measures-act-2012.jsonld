    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "301 10  Meaning of commercial quantity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012.pdf, p.15",
      "values:originalText": "For the purposes of this Part, a commercial quantity of a serious\ndrug, controlled precursor or border controlled precursor is a\nquantity not less than that provided by the following table:\n\nCommercial quantities of serious drugs and precursors\nItem\nSerious drug or\nprecursor\nCommercial quantity (minimum)\nA serious drug (other\nthan a drug analogue),\ncontrolled precursor or\nborder controlled\nprecursor\nEither:\n(a) the quantity listed as a commercial quantity of\nthe drug or precursor in a regulation made for\nthe purposes of this section; or\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs",
      "skos:definition": "For the purposes of this Part, a commercial quantity of a serious\ndrug, controlled precursor or border controlled precursor is a\nquantity not less than that provided by the following table:\n\nCommercial quantities of serious drugs and precursors\nItem\nSerious drug or\nprecursor\nCommercial quantity (minimum)\nA serious drug (other\nthan a drug analogue),\ncontrolled precursor or\nborder controlled\nprecursor\nEither:\n(a) the quantity listed as a commercial quantity of\nthe drug or precursor in a regulation made for\nthe purposes of this section; or\nComLaw Authoritative Act C2012A00167\n\nSchedule 1  Serious drugs",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301-16-norm"
