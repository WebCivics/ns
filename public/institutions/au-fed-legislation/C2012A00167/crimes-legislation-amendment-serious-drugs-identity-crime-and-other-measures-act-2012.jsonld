          "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-2-sec-3un-ss-2"
        }
      ],
      "cml:integrityHash": "fa5cf71545e64adb03f76f71cde2d67156789bcc34371506dc9aa8171ca6da21"
    },
