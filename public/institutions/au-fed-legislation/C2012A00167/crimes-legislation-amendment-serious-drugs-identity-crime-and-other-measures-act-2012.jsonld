    {
      "@id": "concept:crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012-sch-1-sec-301",
      "@type": "cml:Concept",
      "skos:prefLabel": "301 1  Meaning of controlled drug",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-drugs-identity-crime-and-other-measures-act-2012#sch-1-sec-301"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
