        "@id": "cml:AllenInterval"
      },
      "cml:operator": "STARTS-DURING",
      "cml:premiseText": "The document is given to the Commissioner in accordance with Subdivision 60-C (Annual financial reports) or 60-D."
    },
    {
      "@id": "concept:c2012a00169-sch-1-sec-10-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner MUST treat the documents as information statements.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Commissioner has an obligation to treat the documents as information statements.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Commissioner is required to treat certain documents as information statements for a financial year."
    },
    {
      "@id": "concept:c2012a00169-sch-1-sec-10-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The registered entity MUST notify the Commissioner that the documents have been treated as information statements.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The registered entity must notify the Commissioner that the documents have been treated as information statements.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Commissioner has treated the documents as information statements for a financial year."
    },
    {
      "@id": "concept:c2012a00169-sch-1-sec-10-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner MUST treat the reports as annual financial reports for a registered entity.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Commissioner must treat the reports as annual financial reports for a registered entity.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The report covers the financial operations of a registered entity for a financial year."
    },
