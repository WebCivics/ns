    {
      "@id": "concept:c2012a00169-sch-2-sec-1-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Hospital carried on by society or association can only start after the society or association is registered.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "<",
      "cml:premiseText": "Society or association must be registered before carrying on a hospital."
    },
    {
      "@id": "concept:c2012a00169-sch-2-sec-1-3-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If society or association is not a registered charity, then hospital carried on by society or association is invalid.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "=>",
      "cml:premiseText": "Society or association being a registered charity implies that hospital carried on by society or association is valid."
    },
    {
      "@id": "concept:c2012a00169-sch-2-sec-1-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If society or association is not a registered charity, then hospital carried on by society or association cannot be automated.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Implication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "=>",
      "cml:premiseText": "Society or association being a registered charity implies that hospital carried on by society or association can be automated."
    },
    {
      "@id": "concept:c2012a00169-sch-2-sec-1-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Hospital carried on by society or association is not valid if it is not a registered charity.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Mandatory condition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "*",
      "cml:premiseText": "Society or association must be a registered charity."
    },
    {
      "@id": "concept:c2012a00169-sch-2-sec-1-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If society or association is not a registered charity, then hospital carried on by society or association cannot be shared with others.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
