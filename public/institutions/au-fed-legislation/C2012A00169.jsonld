    {
      "@id": "concept:c2012a00169-sch-3-sec-4-ss-2",
      "@type": "cml:Concept",
      "dc:source": "c2012a00169.pdf, p.92",
      "skos:note": "Reference to appealing to a designated court is permitted if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "4(2) At the end of section 14ZZ"
      },
      "wasDerivedFrom": "c2012a00169.pdf",
      "asserts": [
        "concept:c2012a00169-sch-3-sec-4-ss-2-norm",
        "concept:c2012a00169-sch-3-sec-4-ss-2-logic-deontic-1",
        "concept:c2012a00169-sch-3-sec-4-ss-2-logic-descriptionlogic-2",
        "concept:c2012a00169-sch-3-sec-4-ss-2-logic-deontic-3",
        "concept:c2012a00169-sch-3-sec-4-ss-2-logic-descriptionlogic-4",
        "concept:c2012a00169-sch-3-sec-4-ss-2-logic-deontic-5",
        "concept:c2012a00169-sch-3-sec-4-ss-2-logic-descriptionlogic-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "3dd883dcb935fe6f1add1fc19d7253381453e8a3aa4bc54436c524ba137fe602",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2012a00169#sch-3-sec-4-ss-2",
