    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/DescriptionLogic>;
    <https://ns.webcivics.net/cml/operator> "Classify";
    <https://ns.webcivics.net/cml/logicSummary> "Classification of courts within the Australian Charities and Not-for-profits Commission Act 2012.";
    <https://ns.webcivics.net/cml/premiseText> "designated court means the Federal Court of Australia or a Supreme Court of a State or Territory that has jurisdiction in relation to matters arising under that Act.";
    <https://ns.webcivics.net/cml/conclusionText> "the Federal Court of Australia or a Supreme Court of a State or Territory";
