    cof:pageNumber "66"^^xsd:integer .

concept:c2012a00169-sch-2-sec-125 a cml:Concept ;
    skos:prefLabel "125 Transitional provision—applications for endorsement"@en ;
    cml:realizedBy doc:sch-2-sec-125 ;
    values:originalText "An application for endorsement:  (a) made under paragraph 176-1(1)(b) or 176-5(1)(b) of the A New Tax System (Goods and Services Tax) Act 1999 before the commencement of this item; and  (b) not withdrawn or finally dealt with before that commencement; is taken, from that commencement, to have been made under paragraph 176-1(1)(b) of that Act as amended by this Schedule." ;
    skos:definition "An application for endorsement:  (a) made under paragraph 176-1(1)(b) or 176-5(1)(b) of the A New Tax System (Goods and Services Tax) Act 1999 before the commencement of this item; and  (b) not withdrawn or finally dealt with before that commencement; is taken, from that commencement, to have been made under paragraph 176-1(1)(b) of that Act as amended by this Schedule."@en ;
    cml:integrityHash "abae2bfaeeb1fb566a4b5c40b0113cdd8adb549bd0ec9ffef3cd82177e15f9e1" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Application for endorsement taken as made under amended Act" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
