concept:c2012a00169-sch-2-sec-192 a cml:Concept ;
    skos:prefLabel "192 Paragraph 8(2)(a)"@en ;
    cml:realizedBy doc:sch-2-sec-192 ;
    values:originalText "Repeal the paragraph, substitute:  (a) any provision of the governing rules (within the meaning of the Australian Charities and Not-for-profits Commission Act 2012) of a registered charity, if the provision:  (i) confers charitable benefits; or  (ii) enables charitable benefits to be conferred;  on persons of a particular race, colour or national or ethnic origin; or Sex Discrimination Act 1984" ;
    skos:definition "Repeal the paragraph, substitute:  (a) any provision of the governing rules (within the meaning of the Australian Charities and Not-for-profits Commission Act 2012) of a registered charity, if the provision:  (i) confers charitable benefits; or  (ii) enables charitable benefits to be conferred;  on persons of a particular race, colour or national or ethnic origin; or Sex Discrimination Act 1984"@en ;
    cml:integrityHash "e02b5ba5d922a8bd2f97a408490d00d5f6c1aa70950faafa6bca9a08a8442d29" ;
    cof:pageNumber "85"^^xsd:integer ;
    skos:note "Repeal of provisions conferring charitable benefits on persons of a particular race, colour or national or ethnic origin." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2012a00169.pdf> ;
