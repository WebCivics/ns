concept:c2012a00169-sch-2-sec-166 a cml:Concept ;
    skos:prefLabel "166 Paragraphs 45B(9)(b) and (c) of Schedule 1"@en ;
    cml:realizedBy doc:sch-2-sec-166 ;
    values:originalText "Repeal the paragraphs, substitute:  (b) both of the following subparagraphs apply:  (i) the person who required or requires the covenant to be given was or is, at that time, a registered charity;  (ii) the covenant was or is required to be given for or in accordance with the purposes or objects of that registered charity; or  (c) both of the following subparagraphs apply:  (i) the covenant was or is required to be given in pursuance of a legally enforceable requirement made by a registered charity; ComLaw Authoritative Act C2012A00169  References to charities etc.  Schedule 2 Other amendments  Part 7  Australian Charities and Not-for-profits Commission (Consequential and Transitional) Act 2012 No. 169, 2012            75  (ii) that legally enforceable requirement was or is made for or in accordance with the purposes or objects of that registered charity." ;
    skos:definition "Repeal the paragraphs, substitute:  (b) both of the following subparagraphs apply:  (i) the person who required or requires the covenant to be given was or is, at that time, a registered charity;  (ii) the covenant was or is required to be given for or in accordance with the purposes or objects of that registered charity; or  (c) both of the following subparagraphs apply:  (i) the covenant was or is required to be given in pursuance of a legally enforceable requirement made by a registered charity; ComLaw Authoritative Act C2012A00169  References to charities etc.  Schedule 2 Other amendments  Part 7  Australian Charities and Not-for-profits Commission (Consequential and Transitional) Act 2012 No. 169, 2012            75  (ii) that legally enforceable requirement was or is made for or in accordance with the purposes or objects of that registered charity."@en ;
    cml:integrityHash "769e24824539396b1141f8d246e1b28aebde5fc55c7e6205bf4e365d0e684ac6" ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Registered charities must provide covenants for their purposes." ;
