concept:c2012a00169-sch-2-sec-60-2 a cml:Concept ;
    skos:prefLabel "60 Australian Charities and Not-for-profits Commission (Consequential and Transitional)"@en ;
    cml:realizedBy doc:sch-2-sec-60-2 ;
    values:originalText "(b) the entity has applied for that endorsement in accordance with Division 426 in Schedule 1 to the Taxation Administration Act 1953.  (2) An entity is entitled to be endorsed as a charity if the entity:  (a) is an *ACNC-registered charity; and  (b) has an *ABN." ;
    skos:definition "(b) the entity has applied for that endorsement in accordance with Division 426 in Schedule 1 to the Taxation Administration Act 1953.  (2) An entity is entitled to be endorsed as a charity if the entity:  (a) is an *ACNC-registered charity; and  (b) has an *ABN."@en ;
    cml:integrityHash "7de443ab92d7c62af596e955e87874988c7f6d28eba523e3bdf6107675119867" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Entity must apply for endorsement in accordance with Division 426." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2012a00169.pdf> ;
    dc:source "c2012a00169.pdf, p.66" ;
