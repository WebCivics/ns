    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibition of discriminatory provisions." ;
    cml:premiseText "Repeal the paragraph, substitute:  (a) any provision of the governing rules (within the meaning of the Australian Charities and Not-for-profits Commission Act 2012) of a registered charity..." ;
    cml:conclusionText "No charitable benefits can be conferred on persons of a particular race, colour or national or ethnic origin." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

