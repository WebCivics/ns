concept:c2012a00169-sch-2-sec-66-2 a cml:Concept ;
    skos:prefLabel "66 Australian Charities and Not-for-profits Commission (Consequential and Transitional)"@en ;
    cml:realizedBy doc:sch-2-sec-66-2 ;
    values:originalText "Goods, as prescribed by by-law, that have been donated or bequeathed: (a) by a person, company or organisation domiciled or established outside Australia; and (b) to an organisation established in Australia that is: (i) a registered charity; or (ii) a library, museum, gallery or institution, gifts to which are deductible because it is covered by item 12.1.2, 12.1.3, 12.1.4 or 12.1.5 of the table in subsection 30-100(1) of the Income Tax Assessment Act" ;
    skos:definition "Goods, as prescribed by by-law, that have been donated or bequeathed: (a) by a person, company or organisation domiciled or established outside Australia; and (b) to an organisation established in Australia that is: (i) a registered charity; or (ii) a library, museum, gallery or institution, gifts to which are deductible because it is covered by item 12.1.2, 12.1.3, 12.1.4 or 12.1.5 of the table in subsection 30-100(1) of the Income Tax Assessment Act"@en ;
    cml:integrityHash "1e1fecce47dcb9d09773ff37d135d0d3c4232b2ee6d36ecf21b6a5b05d809335" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Goods donated or bequeathed to a registered charity or certain institutions are exempt from tax." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
