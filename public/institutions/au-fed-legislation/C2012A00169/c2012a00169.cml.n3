    skos:prefLabel "46 Subparagraph 58(1)(a)(ii)"@en ;
    cml:realizedBy doc:sch-2-sec-46-2 ;
    values:originalText "Repeal the subparagraph, substitute:  (ii) a registered religious institution; or  (iii) a company that is registered under the Australian Charities and Not-for-profits Commission Act 2012 and does not meet the description of the subtype of entity in column 2 of item 3 of the table in subsection 25-5(5) of that Act; or  (iv) a non-profit company that is not an ACNC type of entity;" ;
    skos:definition "Repeal the subparagraph, substitute:  (ii) a registered religious institution; or  (iii) a company that is registered under the Australian Charities and Not-for-profits Commission Act 2012 and does not meet the description of the subtype of entity in column 2 of item 3 of the table in subsection 25-5(5) of that Act; or  (iv) a non-profit company that is not an ACNC type of entity;"@en ;
