    cml:modality cml:Deontic ;
    values:partOf concept:c2012a00169-sch-1-sec-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:c2012a00169-sch-1-sec-2 cml:asserts concept:c2012a00169-sch-1-sec-2-logic-deontic-1 .
concept:c2012a00169-sch-1-sec-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Must" ;
    cml:logicSummary "Entity must meet conditions to be registered." ;
    cml:premiseText "Item 3 or 4 of the Schedule does not apply" ;
    cml:conclusionText "Entity is registered as a charity." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

