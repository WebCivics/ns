concept:c2012a00169-sch-1-sec-12 cml:asserts concept:c2012a00169-sch-1-sec-12-logic-descriptionlogic-5 .
concept:c2012a00169-sch-1-sec-12-logic-descriptionlogic-5 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Classifies entities into types" ;
    cml:premiseText "...the subtype of entity mentioned in column 2 of item 6 of that table as long as each..." ;
    cml:conclusionText "...for as long as each of the institutions included in the institution sub-entity is an institution whose principal activity is to promote the prevention or the control of diseases in human beings;" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-12 a cof:Section ;
    cof:title "12 Australian Charities and Not-for-profits Commission (Consequential and Transitional)" ;
    values:kind "section" ;
    values:originalText "(a) the Commissioner of Taxation is treated as having endorsed the institution sub-entity mentioned in paragraph 4B(1)(c) under subsection 123C(1) of the Fringe Benefits Tax Assessment Act 1986 as a public benevolent institution; and  (b) the Commissioner of the ACNC is treated as having registered the institution sub-entity on the commencement day under Division 30 of the ACNC Act as:  (i) the type of entity mentioned in column 1 of item 1 of the table in subsection 25-5(5) of that Act (charity); and  (ii) the subtype of entity mentioned in column 2 of item 6 of that table (public benevolent institution). ACNC Act (7) For the purposes of the ACNC Act:  (a) the institution sub-entity mentioned in paragraph 4B(1)(b) of this Schedule is treated as being the subtype of entity mentioned in column 2 of item 5 of the table in subsection 25-5(5) of that Act for as long as each of the institutions included in the institution sub-entity is an institution whose principal activity is to promote the prevention or the control of diseases in human beings; and  (b) the institution sub-entity mentioned in paragraph 4B(1)(c) of this Schedule is treated as being the subtype of entity mentioned in column 2 of item 6 of that table as long as each of the institutions included in the institution sub-entity is a public benevolent institution." ;
    cof:pageNumber "18"^^xsd:integer .

concept:c2012a00169-sch-1-sec-4e a cml:Concept ;
    skos:prefLabel "4E Regulations"@en ;
    cml:realizedBy doc:sch-1-sec-4e ;
    values:originalText "The regulations may, for the purpose of giving effect to this Division, provide for how this Schedule, the ACNC Act or the taxation law applies in relation to the non-institution sub-entity or an institution sub-entity." ;
    skos:definition "The regulations may, for the purpose of giving effect to this Division, provide for how this Schedule, the ACNC Act or the taxation law applies in relation to the non-institution sub-entity or an institution sub-entity."@en ;
