concept:c2012a00169-sch-2-sec-162 a cml:Concept ;
    skos:prefLabel "162 Paragraphs 45B(9)(b) and (c)"@en ;
    cml:realizedBy doc:sch-2-sec-162 ;
    values:originalText "Repeal the paragraphs, substitute:  (b) both of the following subparagraphs apply:  (i) the person who required or requires the covenant to be given was or is, at that time, a registered charity;  (ii) the covenant was or is required to be given for or in accordance with the purposes or objects of that registered charity; or  (c) both of the following subparagraphs apply:  (i) the covenant was or is required to be given in pursuance of a legally enforceable requirement made by a registered charity; ComLaw Authoritative Act C2012A00169  Schedule 2  References to charities etc." ;
    skos:definition "Repeal the paragraphs, substitute:  (b) both of the following subparagraphs apply:  (i) the person who required or requires the covenant to be given was or is, at that time, a registered charity;  (ii) the covenant was or is required to be given for or in accordance with the purposes or objects of that registered charity; or  (c) both of the following subparagraphs apply:  (i) the covenant was or is required to be given in pursuance of a legally enforceable requirement made by a registered charity; ComLaw Authoritative Act C2012A00169  Schedule 2  References to charities etc."@en ;
    cml:integrityHash "b1e4c5d0d770f1429a1192fdfb6ae911ce623315477033e13831a4fe714d96f6" ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Registered charities must provide covenants." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2012a00169.pdf> ;
