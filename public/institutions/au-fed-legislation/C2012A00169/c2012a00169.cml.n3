concept:c2012a00169-sch-2-sec-124 a cml:Concept ;
    skos:prefLabel "124 Transitional provision—endorsements as charities"@en ;
    cml:realizedBy doc:sch-2-sec-124 ;
    values:originalText "An entity that, just before the commencement of this item, was endorsed:  (a) as a charitable institution under subsection 176-1(1) of the A New Tax System (Goods and Services Tax) Act 1999; or  (b) as a trustee of a charitable fund under subsection 176-5(1) of that Act; is taken, from that commencement, to have been endorsed as a charity under subsection 176-1(1) of that Act, as amended by this Schedule." ;
    skos:definition "An entity that, just before the commencement of this item, was endorsed:  (a) as a charitable institution under subsection 176-1(1) of the A New Tax System (Goods and Services Tax) Act 1999; or  (b) as a trustee of a charitable fund under subsection 176-5(1) of that Act; is taken, from that commencement, to have been endorsed as a charity under subsection 176-1(1) of that Act, as amended by this Schedule."@en ;
    cml:integrityHash "801324a7ae725002da47a397ad15cb05bad04d42ca9fdd0d408759027ba99597" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Entity endorsement as charity" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2012a00169.pdf> ;
    dc:source "c2012a00169.pdf, p.66" ;
