concept:c2012a00169-sch-3-sec-17 a cml:Concept ;
    skos:prefLabel "17 After subsection 426-65(2) in Schedule 1"@en ;
    cml:realizedBy doc:sch-3-sec-17 ;
    values:originalText "Insert:  (2A) If the endorsed entity is also registered under the Australian Charities and Not-for-profits Commission Act 2012 as an entity of a particular type or subtype, the *Australian Business Registrar may also enter in the *Australian Business Register:  (a) a statement that the entity is so registered; and ComLaw Authoritative Act C2012A00169  Amendments consequential on the establishment of the ACNC  Schedule 3 Amendments commencing at the same time as the Australian Charities and Not-forprofits Commission Act 2012  Part 1  Australian Charities and Not-for-profits Commission (Consequential and Transitional) Act 2012 No. 169, 2012            89  (b) a statement as to the date of effect of the registration.  (2B) The *Australian Business Registrar may remove the statements from the *Australian Business Register if the registration is revoked under the Australian Charities and Not-for-profits Commission Act 2012. Tax Laws Amendment (2009 Measures No. 5) Act 2009" ;
    skos:definition "Insert:  (2A) If the endorsed entity is also registered under the Australian Charities and Not-for-profits Commission Act 2012 as an entity of a particular type or subtype, the *Australian Business Registrar may also enter in the *Australian Business Register:  (a) a statement that the entity is so registered; and ComLaw Authoritative Act C2012A00169  Amendments consequential on the establishment of the ACNC  Schedule 3 Amendments commencing at the same time as the Australian Charities and Not-forprofits Commission Act 2012  Part 1  Australian Charities and Not-for-profits Commission (Consequential and Transitional) Act 2012 No. 169, 2012            89  (b) a statement as to the date of effect of the registration.  (2B) The *Australian Business Registrar may remove the statements from the *Australian Business Register if the registration is revoked under the Australian Charities and Not-for-profits Commission Act 2012. Tax Laws Amendment (2009 Measures No. 5) Act 2009"@en ;
    cml:integrityHash "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4" ;
    cof:pageNumber "94"^^xsd:integer ;
    cml:hasPart concept:c2012a00169-sch-3-sec-17-ss-2a ;
    cml:hasPart concept:c2012a00169-sch-3-sec-17-ss-2b ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2012a00169.pdf> ;
