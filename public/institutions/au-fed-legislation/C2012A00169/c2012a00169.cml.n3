concept:c2012a00169-sch-2-sec-144 a cml:Concept ;
    skos:prefLabel "144 Paragraph 34(1)(a)"@en ;
    cml:realizedBy doc:sch-2-sec-144 ;
    values:originalText "Repeal the paragraph, substitute:  (a) affect a provision of the governing rules (within the meaning of the Australian Charities and Not-for-profits Commission Act 2012) of a registered charity, if the provision:  (i) confers charitable benefits; or  (ii) enables charitable benefits to be conferred;  wholly or in part on persons of a particular age; or" ;
    skos:definition "Repeal the paragraph, substitute:  (a) affect a provision of the governing rules (within the meaning of the Australian Charities and Not-for-profits Commission Act 2012) of a registered charity, if the provision:  (i) confers charitable benefits; or  (ii) enables charitable benefits to be conferred;  wholly or in part on persons of a particular age; or"@en ;
    cml:integrityHash "b20a9176b4d5a2e63ddcfa01202f15afd99dea52411a98e6cf37206c0eaf6a71" ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "Repeal paragraph 34(1)(a) and substitute with a new provision that affects charitable benefits." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2012a00169.pdf> ;
    dc:source "c2012a00169.pdf, p.74" ;
    cml:asserts concept:c2012a00169-sch-2-sec-144-norm .
