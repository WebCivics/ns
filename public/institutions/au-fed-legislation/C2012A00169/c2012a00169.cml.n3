concept:c2012a00169-sch-2-sec-38-2 a cml:Concept ;
    skos:prefLabel "38 Paragraph 50-110(5)(b)"@en ;
    cml:realizedBy doc:sch-2-sec-38-2 ;
    values:originalText "Repeal the paragraph, substitute:  (b) if item 1.1 of the table in section 50-5 covers the entity:  (i) the entity must not have carried on any activities as a charity; and  (ii) there must be reasonable grounds for believing that the entity will meet the relevant conditions referred to in the column headed “Special conditions” of item 1.1 of the table; or" ;
    skos:definition "Repeal the paragraph, substitute:  (b) if item 1.1 of the table in section 50-5 covers the entity:  (i) the entity must not have carried on any activities as a charity; and  (ii) there must be reasonable grounds for believing that the entity will meet the relevant conditions referred to in the column headed “Special conditions” of item 1.1 of the table; or"@en ;
    cml:integrityHash "0dcb8b7c48b3c27fd75da23e524b34ea5c71fe02615020e7cbe9459eef946a7f" ;
    cof:pageNumber "54"^^xsd:integer ;
    skos:note "Entity must not carry on charity activities without reasonable grounds." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
