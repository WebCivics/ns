doc:sch-1-sec-12 a cof:Section ;
    cof:title "12 Application of amendments" ;
    values:kind "section" ;
    values:originalText "(1) The amendments of the Freedom of Information Act 1982 made by this Schedule apply in relation to a request made under section 15 of that Act that is received after the commencement of this item. (2) The amendments of the Freedom of Information Act 1982 made by this Schedule also apply in relation to a request made under section 15 of that Act that was received during the period:  (a) commencing on the day after the Bill for this Act was introduced into the House of Representatives; and  (b) ending immediately before the commencement of this item; ComLaw Authoritative Act C2012A00177  Amendments  Schedule 1  if the agency or Minister to whom the request was made has not made a decision on the request, or has not been taken to have made a decision on the request, before the commencement of this item. Privacy Act 1988" ;
    cof:pageNumber "10"^^xsd:integer .

concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-13 a cml:Concept ;
    skos:prefLabel "13 Subsection 34(1)"@en ;
    cml:realizedBy doc:sch-1-sec-13 ;
    values:originalText "Omit all the words after “last-mentioned document”, substitute:  to be:  (a) an exempt document by virtue of section 33 or subsection 37(1) or 45A(1) of the Freedom of Information Act 1982; or  (b) an exempt document to the extent referred to in subsection 45A(2) or (3) of that Act.  [Minister’s second reading speech made in— House of Representatives on 10 October 2012 Senate on 30 October 2012]  (182/12) ComLaw Authoritative Act C2012A00177" ;
    skos:definition "Omit all the words after “last-mentioned document”, substitute:  to be:  (a) an exempt document by virtue of section 33 or subsection 37(1) or 45A(1) of the Freedom of Information Act 1982; or  (b) an exempt document to the extent referred to in subsection 45A(2) or (3) of that Act.  [Minister’s second reading speech made in— House of Representatives on 10 October 2012 Senate on 30 October 2012]  (182/12) ComLaw Authoritative Act C2012A00177"@en ;
    cml:integrityHash "80fc54049829bcd8f98863ae80c7172bac93ceb7a34e8d3f7430dafeeff3e349" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Omit all words after 'last-mentioned document' and substitute with exemptions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
