concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12 a cml:Concept ;
    skos:prefLabel "12 Application of amendments"@en ;
    cml:realizedBy doc:sch-1-sec-12 ;
    values:originalText "(1) The amendments of the Freedom of Information Act 1982 made by this Schedule apply in relation to a request made under section 15 of that Act that is received after the commencement of this item. (2) The amendments of the Freedom of Information Act 1982 made by this Schedule also apply in relation to a request made under section 15 of that Act that was received during the period:  (a) commencing on the day after the Bill for this Act was introduced into the House of Representatives; and  (b) ending immediately before the commencement of this item; ComLaw Authoritative Act C2012A00177  Amendments  Schedule 1  if the agency or Minister to whom the request was made has not made a decision on the request, or has not been taken to have made a decision on the request, before the commencement of this item. Privacy Act 1988" ;
    skos:definition "(1) The amendments of the Freedom of Information Act 1982 made by this Schedule apply in relation to a request made under section 15 of that Act that is received after the commencement of this item. (2) The amendments of the Freedom of Information Act 1982 made by this Schedule also apply in relation to a request made under section 15 of that Act that was received during the period:  (a) commencing on the day after the Bill for this Act was introduced into the House of Representatives; and  (b) ending immediately before the commencement of this item; ComLaw Authoritative Act C2012A00177  Amendments  Schedule 1  if the agency or Minister to whom the request was made has not made a decision on the request, or has not been taken to have made a decision on the request, before the commencement of this item. Privacy Act 1988"@en ;
    cml:integrityHash "899e8f599546e2a3532be58267748d7ee5f2f65652ff9d789d04327dbc909982" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Amendments of the Freedom of Information Act 1982 apply to requests received after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf> ;
    dc:source "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf, p.10" ;
    cml:asserts concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-norm .
