    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-45a-ss-3 a cof:Section ;
    cof:title "45A(3) Parliamentary Budget Office documents" ;
    values:kind "subsection" ;
    values:originalText "(3) A document is an exempt document to the extent that it contains information the disclosure of which would reveal that a confidential request has been made to the Parliamentary Budget Officer or the Parliamentary Budget Office, unless the existence of the request has been disclosed by the Senator or Member of the House of Representatives who made the request. ComLaw Authoritative Act C2012A00177  Amendments  Schedule 1  Exceptions" ;
    cof:pageNumber "8"^^xsd:integer .

concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-4 a cml:Concept ;
    skos:prefLabel "45A(4) Parliamentary Budget Office documents"@en ;
    cml:realizedBy doc:sch-1-sec-45a-ss-4 ;
    values:originalText "(4) A document is not an exempt document only because it is attached to a document to which subsection (1), (2) or (3) applies. Note: However, the attachment itself may be an exempt document." ;
    skos:definition "(4) A document is not an exempt document only because it is attached to a document to which subsection (1), (2) or (3) applies. Note: However, the attachment itself may be an exempt document."@en ;
