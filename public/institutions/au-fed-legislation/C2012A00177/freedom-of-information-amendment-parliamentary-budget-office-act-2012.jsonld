      "dc:source": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012A00177\n\nAmendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012A00177\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sec-3-norm"
        }
      ],
      "cml:integrityHash": "4f90dbd023a535a434110a4b10553066b8968b7803eb188aa142fc5d8cd17ca0",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012A00177\n\nAmendments  Schedule 1"
    },
