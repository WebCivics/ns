      },
      "cml:operator": "not",
      "cml:logicSummary": "Negation of exemption",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Document is exempt",
      "cml:conclusionText": "Document is not exempt"
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "45A(5) Parliamentary Budget Office documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-45a-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf"
      },
      "dc:source": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf, p.8",
      "values:originalText": "(5) Information in a document to which subsection (1), (2) or (3)\napplies is not exempt matter because of this section if the\ninformation has been made publicly available by the Parliamentary\nBudget Officer:\n\n(a) under section 64U of the Parliamentary Service Act 1999; or\n\n(b) in a statement made under subsection 64V(4) of that Act.",
      "skos:definition": "(5) Information in a document to which subsection (1), (2) or (3)\napplies is not exempt matter because of this section if the\ninformation has been made publicly available by the Parliamentary\nBudget Officer:\n\n(a) under section 64U of the Parliamentary Service Act 1999; or\n\n(b) in a statement made under subsection 64V(4) of that Act.",
      "values:partOf": {
        "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a"
      },
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-5-norm"
        },
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f8e58d0647e51f556b86eea2c46424b8e8a920bbbaa7e2052e4264e368b205ed",
      "skos:note": "Information made publicly available by the Parliamentary Budget Officer is not exempt matter."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-45a-ss-5",
      "@type": "cof:Section",
      "cof:title": "45A(5) Parliamentary Budget Office documents",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(5) Information in a document to which subsection (1), (2) or (3)\napplies is not exempt matter because of this section if the\ninformation has been made publicly available by the Parliamentary\nBudget Officer:\n\n(a) under section 64U of the Parliamentary Service Act 1999; or\n\n(b) in a statement made under subsection 64V(4) of that Act."
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to disclose information made publicly available by the Parliamentary Budget Officer.",
      "cml:executionSurface": "modalities::logic::deontic",
