      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Defines temporal interval for application",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) commencing on the day after the Bill was introduced into the House of Representatives; and (b) ending immediately before the commencement of this item."
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Defines temporal interval for application",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) commencing on the day after the Bill was introduced into the House of Representatives; and (b) ending immediately before the commencement of this item."
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obliges",
      "cml:logicSummary": "Imposes duty to make decision on request",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "if the agency or Minister to whom the request was made has not made a decision on the request, or has not been taken to have made a decision on the request, before the commencement of this item."
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obliges",
      "cml:logicSummary": "Imposes duty to make decision on request",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "before the commencement of this item."
    },
    {
