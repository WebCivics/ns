    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "45A(6) Parliamentary Budget Office documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-45a-ss-6"
      },
      "cml:curationStatus": {
