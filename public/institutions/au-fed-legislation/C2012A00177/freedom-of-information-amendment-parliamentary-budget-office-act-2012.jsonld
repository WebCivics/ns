    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf"
      },
      "dc:source": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf, p.10",
      "values:originalText": "(1)\nThe amendments of the Freedom of Information Act 1982 made by this\nSchedule apply in relation to a request made under section 15 of that\nAct that is received after the commencement of this item.\n(2)\nThe amendments of the Freedom of Information Act 1982 made by this\nSchedule also apply in relation to a request made under section 15 of\nthat Act that was received during the period:\n\n(a) commencing on the day after the Bill for this Act was\nintroduced into the House of Representatives; and\n\n(b) ending immediately before the commencement of this item;\nComLaw Authoritative Act C2012A00177\n\nAmendments  Schedule 1\n\nif the agency or Minister to whom the request was made has not made a\ndecision on the request, or has not been taken to have made a decision\non the request, before the commencement of this item.\nPrivacy Act 1988",
      "skos:definition": "(1)\nThe amendments of the Freedom of Information Act 1982 made by this\nSchedule apply in relation to a request made under section 15 of that\nAct that is received after the commencement of this item.\n(2)\nThe amendments of the Freedom of Information Act 1982 made by this\nSchedule also apply in relation to a request made under section 15 of\nthat Act that was received during the period:\n\n(a) commencing on the day after the Bill for this Act was\nintroduced into the House of Representatives; and\n\n(b) ending immediately before the commencement of this item;\nComLaw Authoritative Act C2012A00177\n\nAmendments  Schedule 1\n\nif the agency or Minister to whom the request was made has not made a\ndecision on the request, or has not been taken to have made a decision\non the request, before the commencement of this item.\nPrivacy Act 1988",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-norm"
        },
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-logic-alleninterval-1"
        },
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-logic-ltl-2"
        },
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-logic-deontic-3"
        },
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "899e8f599546e2a3532be58267748d7ee5f2f65652ff9d789d04327dbc909982",
      "skos:note": "Amendments of the Freedom of Information Act 1982 apply to requests received after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1)\nThe amendments of the Freedom of Information Act 1982 made by this\nSchedule apply in relation to a request made under section 15 of that\nAct that is received after the commencement of this item.\n(2)\nThe amendments of the Freedom of Information Act 1982 made by this\nSchedule also apply in relation to a request made under section 15 of\nthat Act that was received during the period:\n\n(a) commencing on the day after the Bill for this Act was\nintroduced into the House of Representatives; and\n\n(b) ending immediately before the commencement of this item;\nComLaw Authoritative Act C2012A00177\n\nAmendments  Schedule 1\n\nif the agency or Minister to whom the request was made has not made a\ndecision on the request, or has not been taken to have made a decision\non the request, before the commencement of this item.\nPrivacy Act 1988"
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-12"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
