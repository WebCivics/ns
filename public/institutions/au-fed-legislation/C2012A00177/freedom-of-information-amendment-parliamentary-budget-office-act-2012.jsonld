        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-6-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "8d6bb01eb8d74a3f10b0495b51933b6ebd721caade3a53d1a71fe297ab786605",
      "skos:note": "Information made publicly available by Senator or MP is not exempt."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-45a-ss-6",
      "@type": "cof:Section",
      "cof:title": "45A(6) Parliamentary Budget Office documents",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(6) Information in a document to which subsection (1), (2) or (3)\napplies is not exempt matter because of this section if the\ninformation has been made publicly available by the Senator or\nMember of the House of Representatives who made the\nconfidential request to which the document relates."
    },
