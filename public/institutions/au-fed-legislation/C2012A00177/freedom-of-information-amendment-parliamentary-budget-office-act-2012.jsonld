    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 25(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf"
      },
      "dc:source": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf, p.7",
      "values:originalText": "Omit all the words after “last-mentioned document”, substitute:\n\nto be:\n\n(a) an exempt document by virtue of section 33 or subsection\n37(1) or 45A(1); or\n\n(b) an exempt document to the extent referred to in subsection\n45A(2) or (3).",
      "skos:definition": "Omit all the words after “last-mentioned document”, substitute:\n\nto be:\n\n(a) an exempt document by virtue of section 33 or subsection\n37(1) or 45A(1); or\n\n(b) an exempt document to the extent referred to in subsection\n45A(2) or (3).",
      "cml:asserts": [
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0d99c6f0fd7d46ee8c7be0c11ee407eec041c92abf1eb9e8bddc325a61479e6e",
      "skos:note": "Omit all words after 'last-mentioned document' and substitute with exemptions."
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 25(1)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit all the words after “last-mentioned document”, substitute:\n\nto be:\n\n(a) an exempt document by virtue of section 33 or subsection\n37(1) or 45A(1); or\n\n(b) an exempt document to the extent referred to in subsection\n45A(2) or (3)."
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-1-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits omitting words after 'last-mentioned document'",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 25(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf"
      },
      "dc:source": "freedom-of-information-amendment-parliamentary-budget-office-act-2012.pdf, p.7",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) If a request relates to a document that is, or if it existed would be,\nof a kind referred to in subsection (1), the agency or Minister\ndealing with the request may give notice in writing to the applicant\nthat the agency or the Minister (as the case may be) neither\nconfirms nor denies the existence, as a document of the agency or\nan official document of the Minister, of such a document but that,\nassuming the existence of such a document, it would be:\n\n(a) an exempt document by virtue of section 33 or subsection\n37(1) or 45A(1); or\n\n(b) an exempt document to the extent referred to in subsection\n45A(2) or (3).\n\n(3) If a notice is given under subsection (2) of this section:\n\n(a) section 26 applies as if the decision to give the notice were a\ndecision referred to in that section; and\n\n(b) the decision is taken, for the purposes of Part VI, to be a\ndecision refusing to grant access to the document in\naccordance with the request referred to in subsection (2) of\nthis section, for the reason that the document would, if it\nexisted, be:\n\n(i) an exempt document by virtue of section 33 or\nsubsection 37(1) or 45A(1); or\nComLaw Authoritative Act C2012A00177\n\nSchedule 1  Amendments\n\n4            Freedom of Information Amendment (Parliamentary Budget Office) Act 2012       No.\n177, 2012\n\n(ii) an exempt document to the extent referred to in\nsubsection 45A(2) or (3).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) If a request relates to a document that is, or if it existed would be,\nof a kind referred to in subsection (1), the agency or Minister\ndealing with the request may give notice in writing to the applicant\nthat the agency or the Minister (as the case may be) neither\nconfirms nor denies the existence, as a document of the agency or\nan official document of the Minister, of such a document but that,\nassuming the existence of such a document, it would be:\n\n(a) an exempt document by virtue of section 33 or subsection\n37(1) or 45A(1); or\n\n(b) an exempt document to the extent referred to in subsection\n45A(2) or (3).\n\n(3) If a notice is given under subsection (2) of this section:\n\n(a) section 26 applies as if the decision to give the notice were a\ndecision referred to in that section; and\n\n(b) the decision is taken, for the purposes of Part VI, to be a\ndecision refusing to grant access to the document in\naccordance with the request referred to in subsection (2) of\nthis section, for the reason that the document would, if it\nexisted, be:\n\n(i) an exempt document by virtue of section 33 or\nsubsection 37(1) or 45A(1); or\nComLaw Authoritative Act C2012A00177\n\nSchedule 1  Amendments\n\n4            Freedom of Information Amendment (Parliamentary Budget Office) Act 2012       No.\n177, 2012\n\n(ii) an exempt document to the extent referred to in\nsubsection 45A(2) or (3).",
      "cml:hasPart": [
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-2-ss-2"
        },
        {
          "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-2-ss-3"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsection 25(2)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) If a request relates to a document that is, or if it existed would be,\nof a kind referred to in subsection (1), the agency or Minister\ndealing with the request may give notice in writing to the applicant\nthat the agency or the Minister (as the case may be) neither\nconfirms nor denies the existence, as a document of the agency or\nan official document of the Minister, of such a document but that,\nassuming the existence of such a document, it would be:\n\n(a) an exempt document by virtue of section 33 or subsection\n37(1) or 45A(1); or\n\n(b) an exempt document to the extent referred to in subsection\n45A(2) or (3).\n\n(3) If a notice is given under subsection (2) of this section:\n\n(a) section 26 applies as if the decision to give the notice were a\ndecision referred to in that section; and\n\n(b) the decision is taken, for the purposes of Part VI, to be a\ndecision refusing to grant access to the document in\naccordance with the request referred to in subsection (2) of\nthis section, for the reason that the document would, if it\nexisted, be:\n\n(i) an exempt document by virtue of section 33 or\nsubsection 37(1) or 45A(1); or\nComLaw Authoritative Act C2012A00177\n\nSchedule 1  Amendments\n\n4            Freedom of Information Amendment (Parliamentary Budget Office) Act 2012       No.\n177, 2012\n\n(ii) an exempt document to the extent referred to in\nsubsection 45A(2) or (3)."
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-2-ss-2",
