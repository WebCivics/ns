      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-45a-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
