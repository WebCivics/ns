    {
      "@id": "concept:freedom-of-information-amendment-parliamentary-budget-office-act-2012-sch-1-sec-2-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "2(3) Subsection 25(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/freedom-of-information-amendment-parliamentary-budget-office-act-2012#sch-1-sec-2-ss-3"
      },
      "cml:curationStatus": {
