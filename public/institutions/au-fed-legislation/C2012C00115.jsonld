      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits acquiring or using an assumed identity without authority.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(2) An authorised civilian commits an offence..."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15lb-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Authorised civilians must acquire or use assumed identities in accordance with authority and supervisor directions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on authorised civilians to acquire or use assumed identities in accordance with authority and supervisor directions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(2) An authorised civilian commits an offence..."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15lb-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Authorised civilians must not be reckless about assumed identities.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits reckless behaviour by authorised civilians regarding assumed identities.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(2) An authorised civilian commits an offence..."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15lb-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Supervisors must provide authority and directions for authorised civilians regarding assumed identities.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the supervisor to provide authority and directions for authorised civilians regarding assumed identities.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(2) An authorised civilian commits an offence..."
    },
