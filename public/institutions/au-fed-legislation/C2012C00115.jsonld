      },
      "partOf": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ha-ss-2"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hb",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.88",
      "skos:note": "The Commonwealth must indemnify a participant in a controlled operation against any civil liability.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15HB Indemnification of participants against civil liability"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf",
