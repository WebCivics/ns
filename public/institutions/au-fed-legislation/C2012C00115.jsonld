      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.144",
      "skos:note": "A charge against a person for an offence is outstanding until it is finally dealt with in one of the following ways.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15MC When a charge is outstanding or pending"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc-norm",
