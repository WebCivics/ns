      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner or a Deputy Commissioner during the investigation of the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The investigation of the offence to which the controlled operation relates is within the functions of the Australian Federal Police.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(a) if the operation is a major controlled operation and the investigation of the offence to which the controlled operation relates is within the functions of the Australian Federal Police—the Commissioner or a Deputy Commissioner;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gf-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner or a Deputy Commissioner, or any AFP authorising officer, or any ACC authorising officer, or any ACLEI authorising officer.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
