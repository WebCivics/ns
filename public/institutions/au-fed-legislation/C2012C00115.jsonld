        "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-12-logic-alleninterval-2",
        "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-12-logic-ltl-3",
        "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-12-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "310a93124eb3d6f860b246db278744a9c390b2febb26b8678762861c76d31398",
      "cml:proposedBy": {
