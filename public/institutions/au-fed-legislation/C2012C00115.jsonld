      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Acquiring or using an assumed identity without authority is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the person is an authorised person (other than an authorised civilian); and (b) the person acquires evidence of, or uses, an assumed identity;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15lb-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "and (c) the acquisition or use is not both: (i) in accordance with an authority; and (ii) in the course of duty;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The person must be an authorised person to acquire or use an assumed identity.",
      "cml:modality": {
