      },
      "realizedBy": "doc:crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-12",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-12-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct must occur before or at the same time as the commencement of the operation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The conduct must overlap with the commencement of the operation.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1) This item applies to a participant in an operation authorised under a State controlled operations law if:"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-12-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The participant is not criminally responsible if they meet these conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Participant has an obligation to comply with conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The participant engaged in conduct, whether before, on or after commencement, in the course of, and for the purposes of, the operation."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-12-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The participant is permitted to engage in conduct that meets these conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Participant has permission to engage in conduct if it meets certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "(2) Despite any other law of the Commonwealth, the participant is not criminally responsible for the Commonwealth offence, if:"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-12-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct must occur repeatedly over time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The conduct must repeat over time.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "(b) The participant engaged in conduct, whether before, on or after commencement, in the course of, and for the purposes of, the operation;"
    },
