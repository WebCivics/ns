        "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc-logic-ltl-4",
        "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "a323a80088e604f8fd6121918d20d2dbdd91129771e578fdd0a540aba29f72f6",
      "cml:proposedBy": {
