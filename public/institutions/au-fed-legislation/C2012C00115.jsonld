      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The document is admissible in any legal proceedings.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Admission of the document as evidence in legal proceedings.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Admission",
      "cml:premiseText": "The document purports to be an authority granted under a State controlled operations law."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person granting the authority was satisfied of the facts they were required to be satisfied of.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Proof of the facts required to grant the authority.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Proof",
      "cml:premiseText": "In the absence of evidence to the contrary, the document is proof in any proceedings."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person granting the authority is authorized to grant the authority.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorization of the person granting the authority.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Authorization",
      "cml:premiseText": "The person granting the authority was satisfied of the facts they were required to be satisfied of."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The document is admissible in any legal proceedings if it purports to be an authority granted under a State controlled operations law.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Implication of the document's authenticity on its admissibility.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "If the document purports to be an authority granted under a State controlled operations law, then it is admissible in any legal proceedings."
    },
