        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "(1) A court with *proceeds jurisdiction may make an order (an unexplained wealth order) requiring a person to pay an amount to the Commonwealth..."
    },
