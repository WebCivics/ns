      "realizedBy": "doc:crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-148-ss-11",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The crime overlaps with the order in time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal overlap between the crime and the order.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(11) A person commits an offence if:  (a) an order has been made under subsection (8), (9) or (10); and  (b) the person engages in conduct; and  (c) the conduct contravenes the order."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conduct is a crime.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits conduct that contravenes an order.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(11) A person commits an offence if:  (a) an order has been made under subsection (8), (9) or (10); and  (b) the person engages in conduct; and  (c) the conduct contravenes the order."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual is obligated to comply with the order.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes an obligation on individuals to comply with the order.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(11) A person commits an offence if:  (a) an order has been made under subsection (8), (9) or (10); and  (b) the person engages in conduct; and  (c) the conduct contravenes the order."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The crime repeats indefinitely.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Defines the repeating nature of the crime.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "(11) A person commits an offence if:  (a) an order has been made under subsection (8), (9) or (10); and  (b) the person engages in conduct; and  (c) the conduct contravenes the order."
    },
