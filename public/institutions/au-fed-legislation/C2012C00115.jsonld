    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Charge can be pending until it is finally dealt with.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(i) the person has been arrested for the offence, unless the person has been later released without being charged with an offence;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Holds true for charges against a person for an offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:premiseText": "(a) a charge against a person for an offence is outstanding until the charge is finally dealt with in any of the following ways:"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Holds true for allegations of professional misconduct.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:premiseText": "(c) an allegation of professional misconduct against a person is outstanding if the allegation has not been finally dealt with in accordance with the procedures that apply for the purposes of dealing with an allegation of that kind."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Holds true for charges against a person for an offence.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:premiseText": "(iii) the person is discharged by a court following a committal hearing;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mc-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Charge can be pending until it is finally dealt with.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:premiseText": "(ii) a summons to appear before a court to answer a charge for the offence has been served on the person;"
