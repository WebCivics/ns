    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.62",
      "skos:note": "Disregard evidence obtained from criminal activity under certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15GA(2) Relationship to other laws and matters"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-norm",
