        "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ga-ss-2-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "1f1c2cb23224f1dc734c47db4d75e4e47495b9f8214e50f96da0d4361e4a2668",
      "cml:proposedBy": {
