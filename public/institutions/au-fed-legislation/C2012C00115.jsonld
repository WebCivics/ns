      "skos:note": "Any of the following is an authorising officer for a controlled operation.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15GF(1) Meaning of authorising officer etc."
      },
      "wasDerivedFrom": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf",
