    <https://ns.webcivics.net/cml/premiseText> "The participant engaged in conduct, whether before, on or after commencement, in the course of, and for the purposes of, the operation.";
    <https://ns.webcivics.net/cml/conclusionText> "The participant is not criminally responsible if they meet these conditions.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
