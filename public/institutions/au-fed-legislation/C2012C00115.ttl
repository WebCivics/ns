    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Right";
    <https://ns.webcivics.net/cml/logicSummary> "Grants law enforcement officers and certain other persons the right to engage in activities without liability";
    <https://ns.webcivics.net/cml/premiseText> "The exemption grants law enforcement officers who take an active part in a controlled operation the right to engage in the commission of a Commonwealth offence or an offence against a law of a State or Territory.";
    <https://ns.webcivics.net/cml/conclusionText> "Law enforcement officers have the right to engage in the commission of a Commonwealth offence or an offence against a law of a State or Territory without liability.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
