    <https://ns.webcivics.net/cml/operator> "must";
    <https://ns.webcivics.net/cml/logicSummary> "Participant must not induce a Commonwealth offence or an offence under a law of a State or Territory.";
    <https://ns.webcivics.net/cml/premiseText> "(c) the conduct does not involve the participant intentionally inducing a person to commit a Commonwealth offence or an offence under a law of a State or Territory that the person would not otherwise have intended to commit;";
    <https://ns.webcivics.net/cml/conclusionText> "The participant must not induce.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ha-ss-2> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ha-ss-2-logic-deontic-4>.
