    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "must";
    <https://ns.webcivics.net/cml/logicSummary> "Participant must not engage in conduct likely to cause death or serious injury.";
    <https://ns.webcivics.net/cml/premiseText> "(d) the conduct does not involve the participant engaging in any conduct that is likely to:  (i) cause the death of, or serious injury to, any person; or  (ii) involve the commission of a sexual offence against any person;";
    <https://ns.webcivics.net/cml/conclusionText> "The participant must not engage.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
