    <https://ns.webcivics.net/cml/operator> "Exemption";
    <https://ns.webcivics.net/cml/logicSummary> "Exempts individuals from liability";
    <https://ns.webcivics.net/cml/premiseText> "Law enforcement officers and certain other persons are exempt from criminal liability and civil liability.";
    <https://ns.webcivics.net/cml/conclusionText> "No liability for the individual.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15g> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15g-logic-deontic-2>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15g-logic-deontic-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Permission";
    <https://ns.webcivics.net/cml/logicSummary> "Permits law enforcement officers and certain other persons to engage in activities without liability";
    <https://ns.webcivics.net/cml/premiseText> "The exemption permits law enforcement officers who take an active part in a controlled operation to engage in the commission of a Commonwealth offence or an offence against a law of a State or Territory.";
    <https://ns.webcivics.net/cml/conclusionText> "Law enforcement officers are permitted to engage in the commission of a Commonwealth offence or an offence against a law of a State or Territory without liability.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15g> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15g-logic-deontic-3>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15g-logic-deontic-3> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Imposes an obligation on law enforcement officers and certain other persons to take part in controlled operations";
    <https://ns.webcivics.net/cml/premiseText> "The exemption requires law enforcement officers who take an active part in a controlled operation to engage in the commission of a Commonwealth offence or an offence against a law of a State or Territory.";
    <https://ns.webcivics.net/cml/conclusionText> "Law enforcement officers have an obligation to take part in controlled operations.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
