    <https://ns.webcivics.net/cml/operator> "Repeats";
    <https://ns.webcivics.net/cml/logicSummary> "The conduct must repeat over time.";
    <https://ns.webcivics.net/cml/premiseText> "(b) The participant engaged in conduct, whether before, on or after commencement, in the course of, and for the purposes of, the operation;";
    <https://ns.webcivics.net/cml/conclusionText> "The conduct must occur repeatedly over time.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::temporal_ltl";
    <https://ns.webcivics.net/cml/confidence> 0.5000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
