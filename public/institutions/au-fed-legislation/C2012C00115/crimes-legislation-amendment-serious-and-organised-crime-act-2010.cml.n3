concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gb a cml:Concept ;
    skos:prefLabel "15GB Concurrent operation of State and Territory laws"@en ;
    cml:realizedBy doc:sch-3-sec-15gb ;
    values:originalText "It is the intention of the Parliament that this Part is not to apply to the exclusion of a law of a State or Territory to the extent that the law is capable of operating concurrently with this Part." ;
    skos:definition "It is the intention of the Parliament that this Part is not to apply to the exclusion of a law of a State or Territory to the extent that the law is capable of operating concurrently with this Part."@en ;
    cml:integrityHash "095a481045f51af36f1b8b8e6a073feffbf5a009b4a3b8c59f372f6b5c187f24" ;
