concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-156 a cml:Concept ;
    skos:prefLabel "156 Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-3-sec-156 ;
    values:originalText "(e) section 15ML (disclosure of operative’s identity to presiding officer);  (f) section 15MM (disclosure of operative’s identity etc. despite certificate);  (g) section 15MN (application for leave—joinder as respondent);  (h) section 15MO (directions to jury);  (i) section 15MP (adjournment for appeal decision);  (j) section 15MS (disclosure offences);  (k) section 15MT (evidentiary certificates)." ;
    skos:definition "(e) section 15ML (disclosure of operative’s identity to presiding officer);  (f) section 15MM (disclosure of operative’s identity etc. despite certificate);  (g) section 15MN (application for leave—joinder as respondent);  (h) section 15MO (directions to jury);  (i) section 15MP (adjournment for appeal decision);  (j) section 15MS (disclosure offences);  (k) section 15MT (evidentiary certificates)."@en ;
    cml:integrityHash "7a2248927970744cc64aa67cfe720b06e99b122e3b43f5a373eff6cda2b08873" ;
    cof:pageNumber "160"^^xsd:integer ;
    skos:note "Prohibition of disclosure of operative's identity" ;
