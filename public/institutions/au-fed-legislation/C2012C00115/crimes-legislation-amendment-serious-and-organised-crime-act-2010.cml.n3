concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-10-2 a cml:Concept ;
    skos:prefLabel "10 Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-1-sec-10-2 ;
    values:originalText "(3) The court must make the order under subsection (1) without notice having been given to any person if the *DPP requests the court to do so." ;
    skos:definition "(3) The court must make the order under subsection (1) without notice having been given to any person if the *DPP requests the court to do so."@en ;
