concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-4-2-ss-4 a cml:Concept ;
    skos:prefLabel "4(4) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
