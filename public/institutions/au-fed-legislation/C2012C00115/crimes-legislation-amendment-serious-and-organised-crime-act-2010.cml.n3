    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-9 ;
    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-10 ;
