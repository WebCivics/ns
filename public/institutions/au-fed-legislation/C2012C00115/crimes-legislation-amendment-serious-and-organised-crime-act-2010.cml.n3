concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kn a cml:Concept ;
    skos:prefLabel "15KN Protection from criminal liability—officers of issuing agencies"@en ;
    cml:realizedBy doc:sch-3-sec-15kn ;
    values:originalText "The chief officer, or an officer, of an issuing agency who does something that, apart from this section, would be a Commonwealth offence or an offence against a law of a State or Territory, is not criminally responsible for the offence if the thing is done to comply with a request under section 15KI or a direction under section 15KL." ;
    skos:definition "The chief officer, or an officer, of an issuing agency who does something that, apart from this section, would be a Commonwealth offence or an offence against a law of a State or Territory, is not criminally responsible for the offence if the thing is done to comply with a request under section 15KI or a direction under section 15KL."@en ;
    cml:integrityHash "d1a96bd73cebd41654d1462876f24377daa68a53d81fea9951c573421a58959c" ;
    cof:pageNumber "126"^^xsd:integer ;
    skos:note "Request under section 15KI or direction under section 15KL exempts officers from criminal liability." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
