doc:sch-3-sec-148-ss-11 a cof:Section ;
    cof:title "148(11) Crimes Legislation Amendment (Serious and Organised Crime) Act" ;
    values:kind "subsection" ;
    values:originalText "(11) A person commits an offence if:  (a) an order has been made under subsection (8), (9) or (10); and  (b) the person engages in conduct; and  (c) the conduct contravenes the order. Penalty: Imprisonment for 2 years." ;
    cof:pageNumber "152"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-12 a cml:Concept ;
    skos:prefLabel "148(12) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-3-sec-148-ss-12 ;
    values:originalText "(12) Subsection (11) does not limit the court’s powers, including, but not limited to, the court’s power to punish for contempt." ;
    skos:definition "(12) Subsection (11) does not limit the court’s powers, including, but not limited to, the court’s power to punish for contempt."@en ;
    cml:integrityHash "d67c5b6f56273925bde0fabad1795a6ae325836c86d02d25a80507630d438e5e" ;
    values:partOf concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148 ;
    cof:pageNumber "152"^^xsd:integer ;
    skos:note "Court's power to punish for contempt is not limited by subsection (11)" ;
    cml:curationStatus cml:Proposed ;
