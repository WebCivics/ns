concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-30-ss-6 a cml:Concept ;
    skos:prefLabel "30(6) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-2-sec-30-ss-6 ;
    values:originalText "(6) If the applicant does not comply with subsection (5), the *freezing order is taken never to have had effect." ;
