concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-31 a cml:Concept ;
    skos:prefLabel "31 Application of new section 149"@en ;
    cml:realizedBy doc:sch-2-sec-31 ;
    values:originalText "Section 149 of the Proceeds of Crime Act 2002 as amended by this Part applies in relation to pecuniary penalty orders applied for after the commencement of that section, whether the conduct constituting the offence concerned occurred or occurs before, on or after that commencement." ;
    skos:definition "Section 149 of the Proceeds of Crime Act 2002 as amended by this Part applies in relation to pecuniary penalty orders applied for after the commencement of that section, whether the conduct constituting the offence concerned occurred or occurs before, on or after that commencement."@en ;
    cml:integrityHash "8a4836d00ae0174585205686e9a1cfef239698e49005eda31d59467126dd603c" ;
