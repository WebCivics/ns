concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-149 a cml:Concept ;
    skos:prefLabel "149 Court may confirm pecuniary penalty order"@en ;
    cml:realizedBy doc:sch-2-sec-149 ;
    values:originalText "The court may confirm the *pecuniary penalty order if the court is satisfied that, when the *DPP applied for the order, the court could have made the order without relying on the person’s conviction that was *quashed." ;
    skos:definition "The court may confirm the *pecuniary penalty order if the court is satisfied that, when the *DPP applied for the order, the court could have made the order without relying on the person’s conviction that was *quashed."@en ;
    cml:integrityHash "35d09728d62440152d8787fcfbafd080f872343d515ca673382e140889b2d500" ;
    cof:pageNumber "46"^^xsd:integer ;
    skos:note "Court may confirm pecuniary penalty order if satisfied" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
