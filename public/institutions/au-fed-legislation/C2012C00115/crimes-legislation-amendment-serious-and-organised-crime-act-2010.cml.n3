concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-20 a cml:Concept ;
    skos:prefLabel "20 Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-1-sec-20 ;
    values:originalText "(ea) a document relevant to identifying, locating or quantifying the property of a person, if it is reasonable to suspect that the total value of the person’s *wealth exceeds the value of the person’s wealth that was *lawfully acquired;  (eb) a document relevant to identifying or locating any document necessary for the transfer of property of such a person;" ;
    skos:definition "(ea) a document relevant to identifying, locating or quantifying the property of a person, if it is reasonable to suspect that the total value of the person’s *wealth exceeds the value of the person’s wealth that was *lawfully acquired;  (eb) a document relevant to identifying or locating any document necessary for the transfer of property of such a person;"@en ;
    cml:integrityHash "f3f8ef0fb1dc7a61fe4a3c15319348f44e7a4cd2b5ecaf06a410df68f299843a" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Requires document for identifying or locating property of a person with suspected excessive wealth." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
