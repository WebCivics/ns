    values:partOf concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-30 ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "The applicant must complete a form and provide specific information. Magistrate may require communication by voice and further information." ;
    dc:description "Yes" ;
