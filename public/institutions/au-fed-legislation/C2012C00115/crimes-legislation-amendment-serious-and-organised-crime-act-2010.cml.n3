concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15h a cml:Concept ;
    skos:prefLabel "15H Defect in authority"@en ;
    cml:realizedBy doc:sch-3-sec-15h ;
    values:originalText "An application for an authority or variation of an authority, and any authority or variation of an authority granted on the basis of such an application, is not invalidated by any defect, other than a defect that affects the application, authority or variation in a material particular. ComLaw Authoritative Act C2012C00115  Schedule 3  Amendments relating to controlled operations, assumed identities and witness identity protection" ;
    skos:definition "An application for an authority or variation of an authority, and any authority or variation of an authority granted on the basis of such an application, is not invalidated by any defect, other than a defect that affects the application, authority or variation in a material particular. ComLaw Authoritative Act C2012C00115  Schedule 3  Amendments relating to controlled operations, assumed identities and witness identity protection"@en ;
    cml:integrityHash "bf0cf87db220dfd1e090178e3ce729b585f679f9a2761da1e46cc7c0b84f9348" ;
    cof:pageNumber "87"^^xsd:integer ;
    skos:note "An application for an authority or variation of an authority is not invalidated by any defect, other than a defect that affects the application, authority or variation in a material part." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
    dc:source "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.87" ;
