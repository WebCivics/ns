    cof:pageNumber "136"^^xsd:integer ;
    skos:note "Minister must exclude information from report if advised by chief officer." ;
    dc:description "Report to each House of Parliament within 15 sitting days" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
