doc:sch-1-sec-6-ss-4a a cof:Section ;
    cof:title "6(4A) Crimes Legislation Amendment (Serious and Organised Crime) Act" ;
    values:kind "subsection" ;
    values:originalText "(4A) If the court refuses to make a *restraining order under subsection (1), it may make any order as to costs it considers appropriate, including costs on an indemnity basis. Risk of property being disposed of etc." ;
    cof:pageNumber "10"^^xsd:integer .

