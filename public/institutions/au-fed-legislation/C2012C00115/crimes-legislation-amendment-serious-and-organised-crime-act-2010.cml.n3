concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-30-ss-5 a cml:Concept ;
    skos:prefLabel "30(5) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-2-sec-30-ss-5 ;
    values:originalText "(5) If, before the magistrate made the *freezing order, the applicant did not give the magistrate an affidavit supporting the application and meeting the description in section 15C, the applicant must do so by the time by which the applicant must give the magistrate the form of freezing order completed by the applicant." ;
    skos:definition "(5) If, before the magistrate made the *freezing order, the applicant did not give the magistrate an affidavit supporting the application and meeting the description in section 15C, the applicant must do so by the time by which the applicant must give the magistrate the form of freezing order completed by the applicant."@en ;
    cml:integrityHash "1070df264e7e57f6c15b9a7a843dfb806c97bb5834fb741b9164946238b3cda3" ;
    values:partOf concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-30 ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "Must provide affidavit by a certain time" ;
    dc:description "affidavit supporting the application and meeting the description in section 15C" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
