concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15f a cml:Concept ;
    skos:prefLabel "15F Unsigned freezing orders in court proceedings"@en ;
    cml:realizedBy doc:sch-2-sec-15f ;
    values:originalText "If:  (a) it is material, in any proceedings, for a court to be satisfied that a *freezing order applied for under section 15D was duly made; and  (b) the form of freezing order signed by the magistrate is not produced in evidence; the court must assume that the order was not duly made unless the contrary is proved." ;
    skos:definition "If:  (a) it is material, in any proceedings, for a court to be satisfied that a *freezing order applied for under section 15D was duly made; and  (b) the form of freezing order signed by the magistrate is not produced in evidence; the court must assume that the order was not duly made unless the contrary is proved."@en ;
    cml:integrityHash "4d823a13345cd38b7ef1ca1e7257b74c6a9aca55d1e29a52f616f66193fe3c07" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Court must assume freezing order was not duly made unless proved" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
    dc:source "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.35" ;
    cml:asserts concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15f-norm .
