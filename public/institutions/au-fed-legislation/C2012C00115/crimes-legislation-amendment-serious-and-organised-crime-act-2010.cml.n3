doc:sch-3-sec-98-ss-5 a cof:Section ;
    cof:title "98(5) Crimes Legislation Amendment (Serious and Organised Crime) Act" ;
    values:kind "subsection" ;
    values:originalText "(5) A report must not disclose any information that identifies any person involved in an operation or that is likely to lead to such a person being identified." ;
    cof:pageNumber "102"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-98-ss-6 a cml:Concept ;
    skos:prefLabel "98(6) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-3-sec-98-ss-6 ;
    values:originalText "(6) Nothing in this section requires particulars of a controlled operation to be included in a report for a year if the operation had not been completed as at 30 June in that year, but the particulars must instead be included in the report for the year in which the operation is completed." ;
    skos:definition "(6) Nothing in this section requires particulars of a controlled operation to be included in a report for a year if the operation had not been completed as at 30 June in that year, but the particulars must instead be included in the report for the year in which the operation is completed."@en ;
    cml:integrityHash "1334ebd8a54136952a335e3ab35f22e5ad8bc1ed5a445b9a84831e7f11a4fa59" ;
    values:partOf concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-98 ;
    cof:pageNumber "102"^^xsd:integer ;
    skos:note "Particulars of a controlled operation must be included in a report for the year in which the operation is completed." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
