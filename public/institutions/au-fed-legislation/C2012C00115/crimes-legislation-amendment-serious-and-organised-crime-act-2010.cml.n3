    cof:pageNumber "34"^^xsd:integer ;
    skos:note "Inform applicant of freezing order terms and signing time. Application for freezing order must include required information and may be made before affidavit is sworn." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
