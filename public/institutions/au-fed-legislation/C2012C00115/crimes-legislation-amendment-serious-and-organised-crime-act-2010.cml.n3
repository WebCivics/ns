concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-150 a cml:Concept ;
    skos:prefLabel "150 Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-3-sec-150 ;
    values:originalText "(3) If a court allows a person to join the application as a respondent under subsection (2), the court must allow the person, or the person’s legal representative, to appear and be heard." ;
    skos:definition "(3) If a court allows a person to join the application as a respondent under subsection (2), the court must allow the person, or the person’s legal representative, to appear and be heard."@en ;
    cml:integrityHash "60ed4181b47466a790ac81343d906b9b6703293836a4c076b5665eda5a154036" ;
    cof:pageNumber "154"^^xsd:integer ;
    skos:note "Court must allow person or legal representative to appear and be heard if joined as respondent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
