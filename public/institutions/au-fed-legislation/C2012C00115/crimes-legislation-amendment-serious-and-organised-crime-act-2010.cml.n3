doc:sch-4-sec-18 a cof:Section ;
    cof:title "18 Application" ;
    values:kind "section" ;
    values:originalText "Subsections 5D(3AA) and (9) of the Telecommunications (Interception and Access) Act 1979 apply whether the conduct constituting the offences concerned was engaged in before or after the commencement of this item." ;
    cof:pageNumber "175"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-4-sec-18a a cml:Concept ;
    skos:prefLabel "18A Subsection 5(1)"@en ;
    cml:realizedBy doc:sch-4-sec-18a ;
    values:originalText "Insert: organised crime control law means a law of a State, a purpose of which is to combat organised crime or restrict the activities of criminal organisations, that provides for:  (a) the declaration of an organisation as a declared organisation; or  (b) the making of orders described as control orders or interim control orders in relation to members of criminal organisations." ;
    skos:definition "Insert: organised crime control law means a law of a State, a purpose of which is to combat organised crime or restrict the activities of criminal organisations, that provides for:  (a) the declaration of an organisation as a declared organisation; or  (b) the making of orders described as control orders or interim control orders in relation to members of criminal organisations."@en ;
    cml:integrityHash "add1f032dd85468f0b0492cd43e8bb2ff52670eb71f5ac18533b6d22021a7e0a" ;
    cof:pageNumber "175"^^xsd:integer ;
    skos:note "Declaration of an organisation as a declared organisation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
