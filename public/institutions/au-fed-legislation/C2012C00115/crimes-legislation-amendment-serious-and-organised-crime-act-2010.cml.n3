concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179h a cml:Concept ;
    skos:prefLabel "179H Effect of property vesting in an insolvency trustee"@en ;
    cml:realizedBy doc:sch-1-sec-179h ;
    values:originalText "In assessing the value of property of a person, property is taken to continue to be the *person’s property if it vests in any of the following:  (a) in relation to a bankruptcy—the trustee of the estate of the bankrupt;  (b) in relation to a composition or scheme of arrangement under Division 6 of Part IV of the Bankruptcy Act 1966—the trustee of the composition or scheme of arrangement;  (c) in relation to a personal insolvency agreement under Part X of the Bankruptcy Act 1966—the trustee of the agreement;  (d) in relation to the estate of a deceased person in respect of which an order has been made under Part XI of the Bankruptcy Act 1966—the trustee of the estate." ;
    skos:definition "In assessing the value of property of a person, property is taken to continue to be the *person’s property if it vests in any of the following:  (a) in relation to a bankruptcy—the trustee of the estate of the bankrupt;  (b) in relation to a composition or scheme of arrangement under Division 6 of Part IV of the Bankruptcy Act 1966—the trustee of the composition or scheme of arrangement;  (c) in relation to a personal insolvency agreement under Part X of the Bankruptcy Act 1966—the trustee of the agreement;  (d) in relation to the estate of a deceased person in respect of which an order has been made under Part XI of the Bankruptcy Act 1966—the trustee of the estate."@en ;
    cml:integrityHash "1e7bfc7862e1bf3923ffc17c4487c3d74734f922b9937f5f0a299a2990465e61" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Property vests in trustee upon insolvency" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
