doc:sch-3-sec-15la-ss-2 a cof:Section ;
    cof:title "15LA(2) Application of this Part to authorities under corresponding" ;
    values:kind "subsection" ;
    values:originalText "(2) Sections 15KN, 15KQ and 15KR apply to anything done in relation to a corresponding authority as if:  (a) the corresponding authority were an authority granted under section 15KB; and ComLaw Authoritative Act C2012C00115  Schedule 3  Amendments relating to controlled operations, assumed identities and witness identity protection" ;
    cof:pageNumber "133"^^xsd:integer .

