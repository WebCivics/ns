concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hu a cml:Concept ;
    skos:prefLabel "15HU Offence"@en ;
    cml:realizedBy doc:sch-3-sec-15hu ;
    values:originalText "A person commits an offence if:  (a) the person is required under section 15HT to attend before an inspecting officer, to give information or to answer questions; and  (b) the person refuses or fails to do so. Penalty: Imprisonment for 6 months." ;
    skos:definition "A person commits an offence if:  (a) the person is required under section 15HT to attend before an inspecting officer, to give information or to answer questions; and  (b) the person refuses or fails to do so. Penalty: Imprisonment for 6 months."@en ;
    cml:integrityHash "d0fb89dc9d677a3e54b913a428602bf9776e15bc4ef710173b799adcc29e03f3" ;
    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Refusal to attend before an inspecting officer is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
