    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mu-ss-2 ;
    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mu-ss-3 ;
