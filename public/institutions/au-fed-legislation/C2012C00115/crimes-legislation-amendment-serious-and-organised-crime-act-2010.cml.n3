doc:sch-1-sec-179t-ss-2 a cof:Section ;
    cof:title "179T(2) Amounts exceeding the court’s jurisdiction" ;
    values:kind "subsection" ;
    values:originalText "(2) The certificate may be registered, in accordance with the regulations, in a court having jurisdiction with respect to the recovery of debts of an amount equal to the amount of the relevant order." ;
    cof:pageNumber "23"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179t-ss-3 a cml:Concept ;
    skos:prefLabel "179T(3) Amounts exceeding the court’s jurisdiction"@en ;
    cml:realizedBy doc:sch-1-sec-179t-ss-3 ;
    values:originalText "(3) Upon registration in a court, the certificate is enforceable in all respects as a final judgment of the court in favour of the Commonwealth." ;
