    cml:integrityHash "84b7e3eca76ff27b90f992f01136fdba455805fb51d72673aaf6d563488a5199" ;
    values:partOf concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179p ;
