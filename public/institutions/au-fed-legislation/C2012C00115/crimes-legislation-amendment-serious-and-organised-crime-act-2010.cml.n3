concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-38 a cml:Concept ;
    skos:prefLabel "38 Section 338 (definition of suspect)"@en ;
    cml:realizedBy doc:sch-1-sec-38 ;
    values:originalText "Insert: suspect means:  (a) in relation to a *restraining order (other than a restraining order made under section 20A) or a *confiscation order (other than an *unexplained wealth order)—the person who:  (i) has been convicted of; or  (ii) has been *charged with, or is proposed to be charged with; or  (iii) if the order is a restraining order—is suspected of having committed; or  (iv) if the order is a confiscation order—committed;  the offence or offences to which the order relates; or  (b) in relation to a restraining order made under section 20A or an unexplained wealth order—the person whose *total wealth is suspected of exceeding the value of *wealth that was *lawfully acquired." ;
    skos:definition "Insert: suspect means:  (a) in relation to a *restraining order (other than a restraining order made under section 20A) or a *confiscation order (other than an *unexplained wealth order)—the person who:  (i) has been convicted of; or  (ii) has been *charged with, or is proposed to be charged with; or  (iii) if the order is a restraining order—is suspected of having committed; or  (iv) if the order is a confiscation order—committed;  the offence or offences to which the order relates; or  (b) in relation to a restraining order made under section 20A or an unexplained wealth order—the person whose *total wealth is suspected of exceeding the value of *wealth that was *lawfully acquired."@en ;
    cml:integrityHash "3487e4eb90cb0017f6833926c10baf77b04b6437fe0ca4cb2dd820f69672ead9" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Defines 'suspect' in relation to restraining orders and confiscation orders." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
