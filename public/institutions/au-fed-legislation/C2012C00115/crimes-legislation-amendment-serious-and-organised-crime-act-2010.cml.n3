    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn-ss-5 ;
    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn-ss-6 ;
    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn-ss-7 ;
