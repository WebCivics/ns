doc:sch-3-sec-80-ss-6 a cof:Section ;
    cof:title "80(6) Crimes Legislation Amendment (Serious and Organised Crime) Act" ;
    values:kind "subsection" ;
    values:originalText "(6) The nominated Tribunal member may require the applicant to provide such information concerning the proposed variation as is necessary for the nominated Tribunal member’s proper consideration of the application." ;
    cof:pageNumber "84"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-80-ss-7 a cml:Concept ;
