concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ht-ss-3 a cml:Concept ;
    skos:prefLabel "15HT(3) Power to obtain relevant information"@en ;
    cml:realizedBy doc:sch-3-sec-15ht-ss-3 ;
    values:originalText "(3) The Ombudsman may, by writing given to the law enforcement officer, require the officer to attend:  (a) before a specified inspecting officer; and  (b) at a specified place; and  (c) within a specified period or at a specified time on a specified day; to answer questions relevant to the inspection." ;
    skos:definition "(3) The Ombudsman may, by writing given to the law enforcement officer, require the officer to attend:  (a) before a specified inspecting officer; and  (b) at a specified place; and  (c) within a specified period or at a specified time on a specified day; to answer questions relevant to the inspection."@en ;
    cml:integrityHash "544b07aac30b61e74632fa247122705ed6b3a3e1775255cb5f745c338b2bd60b" ;
    values:partOf concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ht ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "The Ombudsman may require a law enforcement officer to attend an inspection." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
