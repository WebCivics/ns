concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kg a cml:Concept ;
    skos:prefLabel "15KG Making entries in register of births, deaths or marriages"@en ;
    cml:realizedBy doc:sch-3-sec-15kg ;
    values:originalText "The chief officer of:  (a) a law enforcement agency; or  (b) an intelligence agency; may apply, under a corresponding assumed identity law, to the Supreme Court of a State or Territory of a participating jurisdiction for an order that an entry be made in a register of births, deaths or marriages under the relevant law of that jurisdiction in relation to the acquisition of an assumed identity under an authority or corresponding authority." ;
    skos:definition "The chief officer of:  (a) a law enforcement agency; or  (b) an intelligence agency; may apply, under a corresponding assumed identity law, to the Supreme Court of a State or Territory of a participating jurisdiction for an order that an entry be made in a register of births, deaths or marriages under the relevant law of that jurisdiction in relation to the acquisition of an assumed identity under an authority or corresponding authority."@en ;
    cml:integrityHash "068d56b5fd81e679f0cf4a44345d4f4c4c6fcb5668ea82ea6f3ad193542376ac" ;
    cof:pageNumber "123"^^xsd:integer ;
    skos:note "Chief officer may apply for order to make entry in register of births, deaths or marriages." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
