doc:sch-3-sec-15ka-ss-4 a cof:Section ;
    cof:title "15KA(4) Application for authority to acquire or use assumed identity" ;
    values:kind "subsection" ;
    values:originalText "(4) A separate application must be made in respect of each assumed identity to be acquired or used." ;
