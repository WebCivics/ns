concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-45a a cml:Concept ;
    skos:prefLabel "45A Cessation of restraining orders relating to unexplained wealth"@en ;
    cml:realizedBy doc:sch-1-sec-45a ;
    values:originalText "(1) A *restraining order made under section 20A ceases to be in force if, within 28 days after the order was made, no application for an *unexplained wealth order has been made in relation to the *suspect to whom the restraining order relates.  (2) A *restraining order made under section 20A ceases to be in force if:  (a) an application for an *unexplained wealth order is made in relation to the *suspect to whom the restraining order relates; and  (b) the application is made within 28 days after the making of the restraining order; and  (c) the court refuses to make the unexplained wealth order; and  (d) one of the following applies: ComLaw Authoritative Act C2012C00115  Schedule 1  Unexplained wealth" ;
    skos:definition "(1) A *restraining order made under section 20A ceases to be in force if, within 28 days after the order was made, no application for an *unexplained wealth order has been made in relation to the *suspect to whom the restraining order relates.  (2) A *restraining order made under section 20A ceases to be in force if:  (a) an application for an *unexplained wealth order is made in relation to the *suspect to whom the restraining order relates; and  (b) the application is made within 28 days after the making of the restraining order; and  (c) the court refuses to make the unexplained wealth order; and  (d) one of the following applies: ComLaw Authoritative Act C2012C00115  Schedule 1  Unexplained wealth"@en ;
    cml:integrityHash "ae540fe17ee928092399a3fed1e1351a969dc20918eab02e3aa30925e6e01963" ;
    cof:pageNumber "11"^^xsd:integer ;
    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-45a-ss-1 ;
    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-45a-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
    dc:source "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.11" .
doc:sch-1-sec-45a a cof:Section ;
    cof:title "45A Cessation of restraining orders relating to unexplained wealth" ;
    values:kind "section" ;
    values:originalText "(1) A *restraining order made under section 20A ceases to be in force if, within 28 days after the order was made, no application for an *unexplained wealth order has been made in relation to the *suspect to whom the restraining order relates.  (2) A *restraining order made under section 20A ceases to be in force if:  (a) an application for an *unexplained wealth order is made in relation to the *suspect to whom the restraining order relates; and  (b) the application is made within 28 days after the making of the restraining order; and  (c) the court refuses to make the unexplained wealth order; and  (d) one of the following applies: ComLaw Authoritative Act C2012C00115  Schedule 1  Unexplained wealth" ;
    cof:pageNumber "11"^^xsd:integer .

