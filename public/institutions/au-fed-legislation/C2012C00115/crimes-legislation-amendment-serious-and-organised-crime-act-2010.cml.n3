concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-336a a cml:Concept ;
    skos:prefLabel "336A Meaning of property or wealth being lawfully acquired"@en ;
    cml:realizedBy doc:sch-1-sec-336a ;
    values:originalText "For the purposes of this Act, property or *wealth is lawfully acquired only if:  (a) the property or wealth was lawfully acquired; and  (b) the consideration given for the property or wealth was lawfully acquired." ;
    skos:definition "For the purposes of this Act, property or *wealth is lawfully acquired only if:  (a) the property or wealth was lawfully acquired; and  (b) the consideration given for the property or wealth was lawfully acquired."@en ;
    cml:integrityHash "767c48f78aec53cb7fc5eb50d59f68763eef394f5217ecf0d1d37a67a69db084" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Property or wealth is lawfully acquired if it was and the consideration for it was." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
