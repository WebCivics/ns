concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-120 a cml:Concept ;
    skos:prefLabel "120 Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-3-sec-120 ;
    values:originalText "(2) The chief officer must apply for an order under the corresponding assumed identity law to cancel the entry within 28 days after the day the authority ceases to be in force." ;
    skos:definition "(2) The chief officer must apply for an order under the corresponding assumed identity law to cancel the entry within 28 days after the day the authority ceases to be in force."@en ;
    cml:integrityHash "2c936a05798c0b24bfcfb55d2483e74f8e691ddc93649328c40ff22242a94d3a" ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "Chief officer must apply for order to cancel entry within 28 days." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
