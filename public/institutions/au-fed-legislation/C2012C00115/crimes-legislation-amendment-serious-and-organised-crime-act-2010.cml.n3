    cml:modality cml:LTL ;
    cml:operator "Repeats" ;
    cml:logicSummary "Defines the repeating nature of the crime." ;
    cml:premiseText "(11) A person commits an offence if:  (a) an order has been made under subsection (8), (9) or (10); and  (b) the person engages in conduct; and  (c) the conduct contravenes the order." ;
    cml:conclusionText "The crime repeats indefinitely." ;
    cml:executionSurface "modalities::temporal_ltl" ;
