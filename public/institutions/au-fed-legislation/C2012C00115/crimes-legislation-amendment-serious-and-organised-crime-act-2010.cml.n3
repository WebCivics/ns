doc:sch-3-sec-72-ss-4 a cof:Section ;
    cof:title "72(4) Crimes Legislation Amendment (Serious and Organised Crime) Act" ;
    values:kind "subsection" ;
    values:originalText "(4) An authority must not identify persons for the purposes of paragraph (1)(e) or (2)(e) by identifying a class of persons." ;
    cof:pageNumber "76"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gl a cml:Concept ;
    skos:prefLabel "15GL Written record of urgent authority must be issued"@en ;
    cml:realizedBy doc:sch-3-sec-15gl ;
    values:originalText "If an authorising officer grants an urgent authority, the authorising officer must, within 7 days, issue a written record of the urgent authority that complies with subsection 15GK(2) to the principal law enforcement officer for the controlled operation." ;
    skos:definition "If an authorising officer grants an urgent authority, the authorising officer must, within 7 days, issue a written record of the urgent authority that complies with subsection 15GK(2) to the principal law enforcement officer for the controlled operation."@en ;
