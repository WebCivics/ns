concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-32 a cml:Concept ;
    skos:prefLabel "32 Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-2-sec-32 ;
    values:originalText "(ii) omits any matter or thing without which the statement is misleading; and  (c) the statement is made in, or in connection with, an application for a *freezing order. Penalty: Imprisonment for 2 years or 120 penalty units, or both." ;
    skos:definition "(ii) omits any matter or thing without which the statement is misleading; and  (c) the statement is made in, or in connection with, an application for a *freezing order. Penalty: Imprisonment for 2 years or 120 penalty units, or both."@en ;
    cml:integrityHash "ff82ad32f41371c64f421324fe8beb3a93f563c8c32256b0ac78273c8b90478d" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Omits any matter or thing without which the statement is misleading when making an application for a freezing order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
