concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15l a cml:Concept ;
    skos:prefLabel "15L Offence for contravening freezing orders"@en ;
    cml:realizedBy doc:sch-2-sec-15l ;
    values:originalText "A *financial institution commits an offence if:  (a) the institution allows a withdrawal from an *account with the institution; and  (b) there is a *freezing order relating to the account; and  (c) allowing the withdrawal contravenes the order. Penalty: Imprisonment for 5 years or 300 penalty units or both." ;
    skos:definition "A *financial institution commits an offence if:  (a) the institution allows a withdrawal from an *account with the institution; and  (b) there is a *freezing order relating to the account; and  (c) allowing the withdrawal contravenes the order. Penalty: Imprisonment for 5 years or 300 penalty units or both."@en ;
    cml:integrityHash "44e7902c092862ea6d19eba5671657afd26af55e91db5364da9c1462292a88d9" ;
    cof:pageNumber "38"^^xsd:integer ;
    skos:note "Allowing withdrawal from account with freezing order is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
