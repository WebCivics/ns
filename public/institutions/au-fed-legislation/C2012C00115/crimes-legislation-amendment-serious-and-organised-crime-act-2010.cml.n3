concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ht-ss-5 a cml:Concept ;
    skos:prefLabel "15HT(5) Power to obtain relevant information"@en ;
    cml:realizedBy doc:sch-3-sec-15ht-ss-5 ;
    values:originalText "(5) The place, and the period or the time and day, specified in a requirement under this section, must be reasonable having regard to the circumstances in which the requirement is made. ComLaw Authoritative Act C2012C00115  Schedule 3  Amendments relating to controlled operations, assumed identities and witness identity protection" ;
    skos:definition "(5) The place, and the period or the time and day, specified in a requirement under this section, must be reasonable having regard to the circumstances in which the requirement is made. ComLaw Authoritative Act C2012C00115  Schedule 3  Amendments relating to controlled operations, assumed identities and witness identity protection"@en ;
    cml:integrityHash "9255e21f6e3c2678d25bd25681c60cfbd20f78e87cdc31ad82975e10d68cd099" ;
    values:partOf concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ht ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "Requirement for reasonable time and day in information requests" ;
    cml:curationStatus cml:Proposed ;
