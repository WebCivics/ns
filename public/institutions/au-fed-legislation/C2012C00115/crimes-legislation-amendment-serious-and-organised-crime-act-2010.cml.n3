concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-20a a cml:Concept ;
    skos:prefLabel "20A Restraining orders—unexplained wealth"@en ;
    cml:realizedBy doc:sch-1-sec-20a ;
    values:originalText "When a restraining order must be made  (1) A court with *proceeds jurisdiction may order that:  (a) property must not be disposed of or otherwise dealt with by any person; or  (b) property must not be disposed of or otherwise dealt with by any person except in the manner and circumstances specified in the order; ComLaw Authoritative Act C2012C00115  Schedule 1  Unexplained wealth" ;
    skos:definition "When a restraining order must be made  (1) A court with *proceeds jurisdiction may order that:  (a) property must not be disposed of or otherwise dealt with by any person; or  (b) property must not be disposed of or otherwise dealt with by any person except in the manner and circumstances specified in the order; ComLaw Authoritative Act C2012C00115  Schedule 1  Unexplained wealth"@en ;
    cml:integrityHash "6237ba3de4df5068cea935cb2b48c0a17f346c356abc5537bfd872745b553f9d" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Restrict property disposal or handling without court order" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
    dc:source "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.7" ;
    cml:asserts concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-20a-norm .
