concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179u a cml:Concept ;
    skos:prefLabel "179U Parliamentary supervision"@en ;
    cml:realizedBy doc:sch-1-sec-179u ;
    values:originalText "(1) The operation of this Part and section 20A is subject to the oversight of the Parliamentary Joint Committee on the Australian Crime Commission (the Committee).  (2) The Committee may require the Australian Crime Commission, the Australian Federal Police, the *DPP or any other federal agency or authority that is the recipient of any material disclosed as the result of the operation of this Part to appear before it from time to time to give evidence." ;
    skos:definition "(1) The operation of this Part and section 20A is subject to the oversight of the Parliamentary Joint Committee on the Australian Crime Commission (the Committee).  (2) The Committee may require the Australian Crime Commission, the Australian Federal Police, the *DPP or any other federal agency or authority that is the recipient of any material disclosed as the result of the operation of this Part to appear before it from time to time to give evidence."@en ;
    cml:integrityHash "6a51ba7f4cbbe586c87ecffe9869147ed5cd03f3c33b7e43eeb6aab8aa8eca60" ;
    cof:pageNumber "23"^^xsd:integer ;
