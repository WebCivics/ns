concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11 a cml:Concept ;
    skos:prefLabel "148(11) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-3-sec-148-ss-11 ;
    values:originalText "(11) A person commits an offence if:  (a) an order has been made under subsection (8), (9) or (10); and  (b) the person engages in conduct; and  (c) the conduct contravenes the order. Penalty: Imprisonment for 2 years." ;
    skos:definition "(11) A person commits an offence if:  (a) an order has been made under subsection (8), (9) or (10); and  (b) the person engages in conduct; and  (c) the conduct contravenes the order. Penalty: Imprisonment for 2 years."@en ;
    cml:integrityHash "1fb7ab2a4453122a2c5eb9dae37f83b946bc3ca2209e17b9064a091e32661f89" ;
    values:partOf concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148 ;
    cof:pageNumber "152"^^xsd:integer ;
    skos:note "Engaging in conduct that contravenes an order made under subsections (8), (9) or (10) is a crime." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf> ;
