concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kd a cml:Concept ;
    skos:prefLabel "15KD Period of authority"@en ;
    cml:realizedBy doc:sch-3-sec-15kd ;
    values:originalText "(1) An authority for an authorised person (other than an authorised civilian of a kind covered by paragraph 15KC(2)(h)) remains in force until cancelled under section 15KE.  (2) An authority for an authorised civilian of a kind covered by paragraph 15KC(2)(h) remains in force until the end of the period specified in the authority in accordance with subparagraph 15KC(2)(h)(iii), unless the authority is cancelled sooner under section 15KE." ;
    skos:definition "(1) An authority for an authorised person (other than an authorised civilian of a kind covered by paragraph 15KC(2)(h)) remains in force until cancelled under section 15KE.  (2) An authority for an authorised civilian of a kind covered by paragraph 15KC(2)(h) remains in force until the end of the period specified in the authority in accordance with subparagraph 15KC(2)(h)(iii), unless the authority is cancelled sooner under section 15KE."@en ;
    cml:integrityHash "e3669a2a2ede48e0ae5569ba798aef78c850d83894a880fdc2b9a250bd8198ab" ;
    cof:pageNumber "121"^^xsd:integer ;
    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kd-ss-1 ;
    cml:hasPart concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kd-ss-2 ;
