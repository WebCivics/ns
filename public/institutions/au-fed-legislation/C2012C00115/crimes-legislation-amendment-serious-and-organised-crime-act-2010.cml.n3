doc:sch-1-sec-179r-ss-2 a cof:Section ;
    cof:title "179R(2) Enforcement of an unexplained wealth order" ;
    values:kind "subsection" ;
    values:originalText "(2) An *unexplained wealth order against a person may be enforced as if it were an order made in civil proceedings instituted by the Commonwealth against the person to recover a debt due by the person to the Commonwealth." ;
    cof:pageNumber "21"^^xsd:integer .

