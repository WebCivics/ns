doc:sch-3-sec-15ki-ss-4 a cof:Section ;
    cof:title "15KI(4) Request for evidence of assumed identity" ;
    values:kind "subsection" ;
    values:originalText "(4) The request must include:  (a) the date of the authority granted under section 15KB; and  (b) details of the assumed identity authorised; and  (c) details of any evidence of the assumed identity that may be acquired under the authority." ;
    cof:pageNumber "124"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ki-ss-5 a cml:Concept ;
    skos:prefLabel "15KI(5) Request for evidence of assumed identity"@en ;
    cml:realizedBy doc:sch-3-sec-15ki-ss-5 ;
    values:originalText "(5) A request must not be made under this section for an entry in a register of births, deaths or marriages." ;
