doc:sch-1-sec-18-ss-4 a cof:Section ;
    cof:title "18(4) Crimes Legislation Amendment (Serious and Organised Crime) Act" ;
    values:kind "subsection" ;
    values:originalText "(4) If the *DPP applies for an order under subsection (1) relating to particular property, the DPP must give written notice of the application to:  (a) the person who is subject to the *unexplained wealth order; and  (b) any person whom the DPP has reason to believe may have an *interest in the property." ;
    cof:pageNumber "22"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-18-ss-5 a cml:Concept ;
    skos:prefLabel "18(5) Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-1-sec-18-ss-5 ;
    values:originalText "(5) The person who is subject to the *unexplained wealth order, and any person who claims an *interest in the property, may appear and adduce evidence at the hearing of the application." ;
    skos:definition "(5) The person who is subject to the *unexplained wealth order, and any person who claims an *interest in the property, may appear and adduce evidence at the hearing of the application."@en ;
