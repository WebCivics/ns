concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6 cml:asserts concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-alleninterval-2 .
concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Defines a temporal interval during which the person must not engage in conduct that contravenes an order." ;
    cml:premiseText "(a) an order has been made under subsection (1), (4) or (5); and (b) the person engages in conduct; and (c) the conduct contravenes the order." ;
    cml:conclusionText "The person commits an offence if they engage in conduct that contravenes an order during this temporal interval." ;
    cml:executionSurface "modalities::interval_reasoning" ;
