    cof:pageNumber "121"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ke a cml:Concept ;
    skos:prefLabel "15KE Variation or cancellation of authority"@en ;
    cml:realizedBy doc:sch-3-sec-15ke ;
    values:originalText "(1) The chief officer of an agency:  (a) may, at any time, vary or cancel an authority that was granted by the chief officer of the agency; and  (b) must cancel the authority if the chief officer is satisfied (on a review under section 15KF or otherwise) that use of the assumed identity is no longer necessary. Note: Section 15KW modifies the effect of this provision if control of the authority is transferred. ComLaw Authoritative Act C2012C00115  Schedule 3  Amendments relating to controlled operations, assumed identities and witness identity protection" ;
    skos:definition "(1) The chief officer of an agency:  (a) may, at any time, vary or cancel an authority that was granted by the chief officer of the agency; and  (b) must cancel the authority if the chief officer is satisfied (on a review under section 15KF or otherwise) that use of the assumed identity is no longer necessary. Note: Section 15KW modifies the effect of this provision if control of the authority is transferred. ComLaw Authoritative Act C2012C00115  Schedule 3  Amendments relating to controlled operations, assumed identities and witness identity protection"@en ;
    cml:integrityHash "d81bfdd9c5e515f1c1dbaad782614781d9015cc041ecec02d143bd3443fcf6b1" ;
    cof:pageNumber "121"^^xsd:integer ;
    skos:note "Chief officer may vary or cancel authority at any time." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
