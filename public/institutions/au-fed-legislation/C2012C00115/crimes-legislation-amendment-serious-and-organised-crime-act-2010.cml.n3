    cof:pageNumber "116"^^xsd:integer .

concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-114 a cml:Concept ;
    skos:prefLabel "114 Crimes Legislation Amendment (Serious and Organised Crime) Act"@en ;
    cml:realizedBy doc:sch-3-sec-114 ;
    values:originalText "(6) The chief officer may require the applicant to give such additional information concerning the application as is necessary for the chief officer’s proper consideration of the application. Note: The chief officer may delegate functions under this section—see section 15LH." ;
    skos:definition "(6) The chief officer may require the applicant to give such additional information concerning the application as is necessary for the chief officer’s proper consideration of the application. Note: The chief officer may delegate functions under this section—see section 15LH."@en ;
    cml:integrityHash "0c6e63d692ef8b524947f8a09713b1614af25ff9dc2197f432d25025ea096977" ;
