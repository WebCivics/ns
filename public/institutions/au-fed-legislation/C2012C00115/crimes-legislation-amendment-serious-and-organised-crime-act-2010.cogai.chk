crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15g-logic-300 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-3-sec-15g;
  logic: Deontic;
  operator: Permission;
  summary: Permits law enforcement officers and certain other persons to engage in activities without liability;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: The exemption permits law enforcement officers who take an active part in a controlled operation to engage in the commission of a Commonwealth offence or an offence against a law of a State or Territory.;
  @action: Law enforcement officers are permitted to engage in the commission of a Commonwealth offence or an offence against a law of a State or Territory without liability.;
}

crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15g-logic-301 {
