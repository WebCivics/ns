    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.24",
      "values:originalText": "(ea) a document relevant to identifying, locating or quantifying\nthe property of a person, if it is reasonable to suspect that the\ntotal value of the person’s *wealth exceeds the value of the\nperson’s wealth that was *lawfully acquired;\n\n(eb) a document relevant to identifying or locating any document\nnecessary for the transfer of property of such a person;",
      "skos:definition": "(ea) a document relevant to identifying, locating or quantifying\nthe property of a person, if it is reasonable to suspect that the\ntotal value of the person’s *wealth exceeds the value of the\nperson’s wealth that was *lawfully acquired;\n\n(eb) a document relevant to identifying or locating any document\nnecessary for the transfer of property of such a person;",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-20-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f3f8ef0fb1dc7a61fe4a3c15319348f44e7a4cd2b5ecaf06a410df68f299843a",
      "skos:note": "Requires document for identifying or locating property of a person with suspected excessive wealth."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "(ea) a document relevant to identifying, locating or quantifying\nthe property of a person, if it is reasonable to suspect that the\ntotal value of the person’s *wealth exceeds the value of the\nperson’s wealth that was *lawfully acquired;\n\n(eb) a document relevant to identifying or locating any document\nnecessary for the transfer of property of such a person;"
    },
