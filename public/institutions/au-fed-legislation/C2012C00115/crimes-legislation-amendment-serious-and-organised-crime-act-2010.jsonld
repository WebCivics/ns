    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179a",
      "@type": "cml:Concept",
      "skos:prefLabel": "179A Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.12",
      "values:originalText": "This Part provides for the making of certain orders relating to\nunexplained wealth.\nA preliminary unexplained wealth order requires a person to attend\ncourt for the purpose of enabling the court to decide whether to\nmake an unexplained wealth order against the person.\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\nAn unexplained wealth order is an order requiring the person to\npay an amount equal to so much of the person’s total wealth as the\nperson cannot satisfy the court is not derived from certain offences.",
      "skos:definition": "This Part provides for the making of certain orders relating to\nunexplained wealth.\nA preliminary unexplained wealth order requires a person to attend\ncourt for the purpose of enabling the court to decide whether to\nmake an unexplained wealth order against the person.\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\nAn unexplained wealth order is an order requiring the person to\npay an amount equal to so much of the person’s total wealth as the\nperson cannot satisfy the court is not derived from certain offences.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179a-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "da8e138f07baa17d1679cb6fa076dedd528b284b7c299197018d0a17bb10bb8d",
      "skos:note": "Requires a person to attend court for the purpose of deciding whether to make an unexplained wealth order."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179a",
      "@type": "cof:Section",
      "cof:title": "179A Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "This Part provides for the making of certain orders relating to\nunexplained wealth.\nA preliminary unexplained wealth order requires a person to attend\ncourt for the purpose of enabling the court to decide whether to\nmake an unexplained wealth order against the person.\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\nAn unexplained wealth order is an order requiring the person to\npay an amount equal to so much of the person’s total wealth as the\nperson cannot satisfy the court is not derived from certain offences."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
