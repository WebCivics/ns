    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-142-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "142(7) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-142-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.146",
      "values:originalText": "(7) A witness identity protection certificate is not a legislative\ninstrument.\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "skos:definition": "(7) A witness identity protection certificate is not a legislative\ninstrument.\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-142"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-142-ss-7-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-142-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cbcc4ed7bb7035efb238235e16352efc605526d91e0e0f129fc6c299a90e5780",
      "skos:note": "A witness identity protection certificate is not a legislative instrument."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-142-ss-7",
      "@type": "cof:Section",
      "cof:title": "142(7) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "subsection",
      "cof:pageNumber": 146,
      "values:originalText": "(7) A witness identity protection certificate is not a legislative\ninstrument.\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-142-ss-7-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
