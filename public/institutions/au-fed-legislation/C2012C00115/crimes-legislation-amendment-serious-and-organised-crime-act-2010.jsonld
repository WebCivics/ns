    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hi",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HI Effect of section 15HH on other laws relating to criminal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hi"
      },
      "cml:curationStatus": {
