    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hq-ss-1",
      "@type": "cof:Section",
      "cof:title": "15HQ(1) General register",
      "values:kind": "subsection",
      "cof:pageNumber": 103,
      "values:originalText": "(1) The chief officer of each authorising agency must cause a general\nregister to be kept."
    },
