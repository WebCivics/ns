    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-30-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "30(3) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-30-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
