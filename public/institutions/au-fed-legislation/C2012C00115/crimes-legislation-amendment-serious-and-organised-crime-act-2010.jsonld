    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gn",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GN Commencement and duration of authorities",
      "cml:realizedBy": {
