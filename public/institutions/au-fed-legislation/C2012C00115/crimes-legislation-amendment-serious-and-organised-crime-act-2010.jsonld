    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-4-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-4-sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-4-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "d1aba2b7bdb48b6a21bc969988d63f1a766200eca05915087c4912559eebae28",
      "skos:note": "Schedules amendment and repeal rules"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-4-sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010"
    },
