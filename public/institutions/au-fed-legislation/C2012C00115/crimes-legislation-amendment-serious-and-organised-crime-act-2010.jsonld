        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gu-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f129ed77ce9073a5ce84529902fa5fc3521a809405dbbca268f49172da8a3eee",
      "skos:note": "Prohibition on making multiple urgent variation applications without formal variation application."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gu-ss-4",
