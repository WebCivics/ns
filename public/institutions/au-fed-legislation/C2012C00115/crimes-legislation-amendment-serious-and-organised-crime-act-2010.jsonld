    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179eb",
      "@type": "cml:Concept",
      "skos:prefLabel": "179EB Costs",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179eb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.16",
      "values:originalText": "If the court refuses to make a *preliminary unexplained wealth\norder or an *unexplained wealth order, it may make any order as to\ncosts it considers appropriate, including costs on an indemnity\nbasis.",
      "skos:definition": "If the court refuses to make a *preliminary unexplained wealth\norder or an *unexplained wealth order, it may make any order as to\ncosts it considers appropriate, including costs on an indemnity\nbasis.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179eb-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179eb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "67fbeb104ad310936b08b5fd21e3314520b0baabdccbc4c642ea1bdf45c056d4",
      "skos:note": "Court may make order for costs on an indemnity basis if preliminary or unexplained wealth orders are refused."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179eb",
      "@type": "cof:Section",
      "cof:title": "179EB Costs",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "If the court refuses to make a *preliminary unexplained wealth\norder or an *unexplained wealth order, it may make any order as to\ncosts it considers appropriate, including costs on an indemnity\nbasis."
    },
