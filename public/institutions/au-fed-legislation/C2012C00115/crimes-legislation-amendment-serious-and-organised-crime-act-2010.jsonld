      "cml:integrityHash": "11b7b8c5811594177e64e811d4152f69c4f2e4aad6f93d194ac23c7287a71610",
      "skos:note": "Magistrate must issue freezing order if urgent and delay would frustrate effectiveness."
    },
    {
