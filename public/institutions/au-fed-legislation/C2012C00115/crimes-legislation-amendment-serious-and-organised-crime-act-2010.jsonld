    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-114",
      "@type": "cml:Concept",
      "skos:prefLabel": "114 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-114"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.118",
      "values:originalText": "(6) The chief officer may require the applicant to give such additional\ninformation concerning the application as is necessary for the chief\nofficer’s proper consideration of the application.\nNote:\nThe chief officer may delegate functions under this section—see\nsection 15LH.",
      "skos:definition": "(6) The chief officer may require the applicant to give such additional\ninformation concerning the application as is necessary for the chief\nofficer’s proper consideration of the application.\nNote:\nThe chief officer may delegate functions under this section—see\nsection 15LH.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-114-norm"
        },
        {
