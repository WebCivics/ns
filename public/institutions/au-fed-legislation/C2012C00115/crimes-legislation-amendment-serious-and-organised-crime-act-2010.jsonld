        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-70-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-70-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "90989ab014002ca019fbb3ff8e415730865dfdc1ae9944d816dfd36624352885",
      "skos:note": "Subsequent authority must be formal if granted in respect of a controlled operation with previous authority."
    },
    {
