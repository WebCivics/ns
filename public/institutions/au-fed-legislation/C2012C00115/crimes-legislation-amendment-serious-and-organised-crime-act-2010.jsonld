    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kb-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KB(5) Determination of applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kb-ss-5"
      },
      "cml:curationStatus": {
