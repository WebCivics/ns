      "cml:integrityHash": "36376f9ce2c3654555db175242a1f448004aa5c98e60565a27c9c9c2afd75164",
      "skos:note": "Definition of 'person involved in the proceeding'"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-148-ss-3",
      "@type": "cof:Section",
      "cof:title": "148(3) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "subsection",
      "cof:pageNumber": 152,
      "values:originalText": "(3) In this section:\nperson involved in the proceeding has the same meaning as in\nsubsection 15MJ(3)."
    },
