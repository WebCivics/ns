        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-4-sec-14-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "412bd309f127f4410969ff666b6f324cec95d6f83d16fb806f034040607d54ab",
      "skos:note": "Associating with a criminal organisation or member is prohibited."
    },
    {
