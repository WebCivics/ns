      "@type": "cml:Concept",
      "skos:prefLabel": "18(4) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-18-ss-4"
      },
      "cml:curationStatus": {
