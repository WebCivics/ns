    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gl",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GL Written record of urgent authority must be issued",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gl"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.76",
      "values:originalText": "If an authorising officer grants an urgent authority, the authorising\nofficer must, within 7 days, issue a written record of the urgent\nauthority that complies with subsection 15GK(2) to the principal\nlaw enforcement officer for the controlled operation.",
      "skos:definition": "If an authorising officer grants an urgent authority, the authorising\nofficer must, within 7 days, issue a written record of the urgent\nauthority that complies with subsection 15GK(2) to the principal\nlaw enforcement officer for the controlled operation.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gl-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gl-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e6b788e320e361fb64c726750e337a9408560be43af3cfed52d7bb193c5a80d7",
      "skos:note": "Authorising officer must issue written record of urgent authority within 7 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gl",
      "@type": "cof:Section",
      "cof:title": "15GL Written record of urgent authority must be issued",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "If an authorising officer grants an urgent authority, the authorising\nofficer must, within 7 days, issue a written record of the urgent\nauthority that complies with subsection 15GK(2) to the principal\nlaw enforcement officer for the controlled operation."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gl-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gl"
      },
      "values:deonticStatus": {
