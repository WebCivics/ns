        }
      ],
      "cml:integrityHash": "0b26c634e4cbbd7eff38f1d1a3e17dba3b59b98abe17bec6547f1d1bebe814c5"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-8-2",
