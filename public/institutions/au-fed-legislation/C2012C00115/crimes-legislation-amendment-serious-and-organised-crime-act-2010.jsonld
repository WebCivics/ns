    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-128",
      "@type": "cml:Concept",
      "skos:prefLabel": "128 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-128"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.132",
      "values:originalText": "Note 1:\nThe chief officer may delegate functions under this section—see\nsection 15LH.\nNote 2:\nSection 15KW modifies the effect of this provision if control of the\nauthority is transferred.\n\n(3) The request must state that it is a request under this section.\n\n(4) A request must not be made under this section for an entry in a\nregister of births, deaths or marriages.",
      "skos:definition": "Note 1:\nThe chief officer may delegate functions under this section—see\nsection 15LH.\nNote 2:\nSection 15KW modifies the effect of this provision if control of the\nauthority is transferred.\n\n(3) The request must state that it is a request under this section.\n\n(4) A request must not be made under this section for an entry in a\nregister of births, deaths or marriages.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-128-ss-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-128-ss-4"
        }
      ],
      "cml:integrityHash": "e498f40d0b9f2fb6e793b9044698b18159c88fc1d103c3692dc94f7dd5fdf37a"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-128",
      "@type": "cof:Section",
      "cof:title": "128 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "section",
      "cof:pageNumber": 132,
      "values:originalText": "Note 1:\nThe chief officer may delegate functions under this section—see\nsection 15LH.\nNote 2:\nSection 15KW modifies the effect of this provision if control of the\nauthority is transferred.\n\n(3) The request must state that it is a request under this section.\n\n(4) A request must not be made under this section for an entry in a\nregister of births, deaths or marriages."
    },
