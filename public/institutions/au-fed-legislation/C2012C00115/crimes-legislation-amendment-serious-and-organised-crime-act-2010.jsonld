        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15j-ss-3"
        }
      ],
      "cml:integrityHash": "9756757b8c6dd29422388434c0fda529a4a8b5bc95d590808b958a1d60325117"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15j",
