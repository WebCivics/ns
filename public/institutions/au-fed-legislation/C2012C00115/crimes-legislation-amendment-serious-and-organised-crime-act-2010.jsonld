      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires a person to attend court.",
