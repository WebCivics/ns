    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15lc-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15LC(3) Disclosing information about assumed identity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15lc-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
