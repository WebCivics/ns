    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Application of amendment of subparagraph 49(1)(c)(iv)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-52"
      },
      "cml:curationStatus": {
