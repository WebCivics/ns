    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179r",
      "@type": "cml:Concept",
      "skos:prefLabel": "179R Enforcement of an unexplained wealth order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179r"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.21",
      "values:originalText": "(1) An amount payable by a person to the Commonwealth under an\n*unexplained wealth order is a civil debt due by the person to the\nCommonwealth.\n\n(2) An *unexplained wealth order against a person may be enforced as\nif it were an order made in civil proceedings instituted by the\nCommonwealth against the person to recover a debt due by the\nperson to the Commonwealth.\n\n(3) The debt arising from the order is taken to be a judgment debt.\n\n(4) If an *unexplained wealth order is made against a person after the\nperson’s death, this section has effect as if the person had died on\nthe day after the order was made.",
      "skos:definition": "(1) An amount payable by a person to the Commonwealth under an\n*unexplained wealth order is a civil debt due by the person to the\nCommonwealth.\n\n(2) An *unexplained wealth order against a person may be enforced as\nif it were an order made in civil proceedings instituted by the\nCommonwealth against the person to recover a debt due by the\nperson to the Commonwealth.\n\n(3) The debt arising from the order is taken to be a judgment debt.\n\n(4) If an *unexplained wealth order is made against a person after the\nperson’s death, this section has effect as if the person had died on\nthe day after the order was made.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179r-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179r-ss-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179r-ss-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179r-ss-4"
        }
      ],
      "cml:integrityHash": "2cbc25c5d969e5f331f5f7e07ebbe2923180ef79d8444eba7e7eb1a1dd29afff"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179r",
      "@type": "cof:Section",
      "cof:title": "179R Enforcement of an unexplained wealth order",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "(1) An amount payable by a person to the Commonwealth under an\n*unexplained wealth order is a civil debt due by the person to the\nCommonwealth.\n\n(2) An *unexplained wealth order against a person may be enforced as\nif it were an order made in civil proceedings instituted by the\nCommonwealth against the person to recover a debt due by the\nperson to the Commonwealth.\n\n(3) The debt arising from the order is taken to be a judgment debt.\n\n(4) If an *unexplained wealth order is made against a person after the\nperson’s death, this section has effect as if the person had died on\nthe day after the order was made."
    },
