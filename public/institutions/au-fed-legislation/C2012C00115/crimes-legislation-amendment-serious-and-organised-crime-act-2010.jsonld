    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HY Ombudsman not to be sued",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hy"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.110",
      "values:originalText": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nDivision.",
      "skos:definition": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nDivision.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy-logic-linearlogic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy-logic-alleninterval-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "938264042476b3210f275dc2f647b74c15512c09be81763d2798f287ca38cff7",
      "skos:note": "Ombudsman not liable to action for acts done in good faith"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hy",
      "@type": "cof:Section",
      "cof:title": "15HY Ombudsman not to be sued",
      "values:kind": "section",
      "cof:pageNumber": 110,
      "values:originalText": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nDivision."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hy"
      },
      "values:deonticStatus": {
