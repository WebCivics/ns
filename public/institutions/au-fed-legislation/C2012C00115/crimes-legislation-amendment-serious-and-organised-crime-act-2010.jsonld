    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179sa-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "179SA(2) Legal expenses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179sa-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.22",
      "values:originalText": "(2) The court may require that a costs assessor certify that legal\nexpenses have been properly incurred before permitting the\npayment of expenses from the disposal of any property covered by\nan order under subsection (1) and may make any further or\nancillary orders it considers appropriate.",
      "skos:definition": "(2) The court may require that a costs assessor certify that legal\nexpenses have been properly incurred before permitting the\npayment of expenses from the disposal of any property covered by\nan order under subsection (1) and may make any further or\nancillary orders it considers appropriate.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179sa"
      },
      "cml:asserts": [
