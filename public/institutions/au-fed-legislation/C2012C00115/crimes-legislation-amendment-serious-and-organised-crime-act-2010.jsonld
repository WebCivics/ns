    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15f",
      "@type": "cml:Concept",
      "skos:prefLabel": "15F Unsigned freezing orders in court proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.35",
      "values:originalText": "If:\n\n(a) it is material, in any proceedings, for a court to be satisfied\nthat a *freezing order applied for under section 15D was duly\nmade; and\n\n(b) the form of freezing order signed by the magistrate is not\nproduced in evidence;\nthe court must assume that the order was not duly made unless the\ncontrary is proved.",
      "skos:definition": "If:\n\n(a) it is material, in any proceedings, for a court to be satisfied\nthat a *freezing order applied for under section 15D was duly\nmade; and\n\n(b) the form of freezing order signed by the magistrate is not\nproduced in evidence;\nthe court must assume that the order was not duly made unless the\ncontrary is proved.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15f-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15f-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4d823a13345cd38b7ef1ca1e7257b74c6a9aca55d1e29a52f616f66193fe3c07",
      "skos:note": "Court must assume freezing order was not duly made unless proved"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15f",
      "@type": "cof:Section",
      "cof:title": "15F Unsigned freezing orders in court proceedings",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "If:\n\n(a) it is material, in any proceedings, for a court to be satisfied\nthat a *freezing order applied for under section 15D was duly\nmade; and\n\n(b) the form of freezing order signed by the magistrate is not\nproduced in evidence;\nthe court must assume that the order was not duly made unless the\ncontrary is proved."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15f-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15f"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15f-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits court from assuming order was made",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Court must assume order was made unless proved",
      "cml:conclusionText": "Order not assumed"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15g",
      "@type": "cml:Concept",
      "skos:prefLabel": "15G Offence for making false statements in applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.35",
      "values:originalText": "A person commits an offence if:\n\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n\n(b) the statement:\n\n(i) is false or misleading; or\nComLaw Authoritative Act C2012C00115\n\nSchedule 2  Other amendments relating to proceeds of crime",
      "skos:definition": "A person commits an offence if:\n\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n\n(b) the statement:\n\n(i) is false or misleading; or\nComLaw Authoritative Act C2012C00115\n\nSchedule 2  Other amendments relating to proceeds of crime",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15g-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8072385fe7fa0724a545c6f6d2dbc5d2f04925864eb70f4bfee6831fc069d589",
      "skos:note": "Making false statements in applications is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15g",
      "@type": "cof:Section",
      "cof:title": "15G Offence for making false statements in applications",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "A person commits an offence if:\n\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n\n(b) the statement:\n\n(i) is false or misleading; or\nComLaw Authoritative Act C2012C00115\n\nSchedule 2  Other amendments relating to proceeds of crime"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15g-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15g"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15g-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits making false statements in applications.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.36",
      "values:originalText": "(ii) omits any matter or thing without which the statement is\nmisleading; and\n\n(c) the statement is made in, or in connection with, an\napplication for a *freezing order.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both.",
      "skos:definition": "(ii) omits any matter or thing without which the statement is\nmisleading; and\n\n(c) the statement is made in, or in connection with, an\napplication for a *freezing order.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-32-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ff82ad32f41371c64f421324fe8beb3a93f563c8c32256b0ac78273c8b90478d",
      "skos:note": "Omits any matter or thing without which the statement is misleading when making an application for a freezing order."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "(ii) omits any matter or thing without which the statement is\nmisleading; and\n\n(c) the statement is made in, or in connection with, an\napplication for a *freezing order.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-32-norm",
      "@type": "values:Prohibition",
