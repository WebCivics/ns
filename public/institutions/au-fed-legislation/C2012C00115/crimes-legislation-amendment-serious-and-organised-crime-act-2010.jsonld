    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 After subsection 322(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.26",
      "values:originalText": "Insert:\n\n(4A) Despite subsections (2) and (3), in the case of an *unexplained\nwealth order, or an order under section 179S that relates to an\nunexplained wealth order, the person may appeal against the\ntargeted order in the same manner as if:\n\n(a) the person had been convicted of one of the following:\n\n(i) an offence against a law of the Commonwealth;\n\n(ii) a *foreign indictable offence;\n\n(iii) a *State offence that has a federal aspect; and\n\n(b) the targeted order were, or were part of, the sentence imposed\non the person in respect of the offence.",
      "skos:definition": "Insert:\n\n(4A) Despite subsections (2) and (3), in the case of an *unexplained\nwealth order, or an order under section 179S that relates to an\nunexplained wealth order, the person may appeal against the\ntargeted order in the same manner as if:\n\n(a) the person had been convicted of one of the following:\n\n(i) an offence against a law of the Commonwealth;\n\n(ii) a *foreign indictable offence;\n\n(iii) a *State offence that has a federal aspect; and\n\n(b) the targeted order were, or were part of, the sentence imposed\non the person in respect of the offence.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-27-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-27-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2f50788b983669235932280655bd26fdcad81663a37e99bf3d518d1076ad8a35",
      "skos:note": "Appeal against unexplained wealth order or related order"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-27",
      "@type": "cof:Section",
      "cof:title": "27 After subsection 322(4)",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Insert:\n\n(4A) Despite subsections (2) and (3), in the case of an *unexplained\nwealth order, or an order under section 179S that relates to an\nunexplained wealth order, the person may appeal against the\ntargeted order in the same manner as if:\n\n(a) the person had been convicted of one of the following:\n\n(i) an offence against a law of the Commonwealth;\n\n(ii) a *foreign indictable offence;\n\n(iii) a *State offence that has a federal aspect; and\n\n(b) the targeted order were, or were part of, the sentence imposed\non the person in respect of the offence."
    },
