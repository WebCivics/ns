      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kh-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Mandatory duty on the state to update registers.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-120",
      "@type": "cml:Concept",
      "skos:prefLabel": "120 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-120"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.124",
      "values:originalText": "(2) The chief officer must apply for an order under the corresponding\nassumed identity law to cancel the entry within 28 days after the\nday the authority ceases to be in force.",
      "skos:definition": "(2) The chief officer must apply for an order under the corresponding\nassumed identity law to cancel the entry within 28 days after the\nday the authority ceases to be in force.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-120-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-120-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2c936a05798c0b24bfcfb55d2483e74f8e691ddc93649328c40ff22242a94d3a",
      "skos:note": "Chief officer must apply for order to cancel entry within 28 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-120",
      "@type": "cof:Section",
      "cof:title": "120 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "section",
      "cof:pageNumber": 124,
      "values:originalText": "(2) The chief officer must apply for an order under the corresponding\nassumed identity law to cancel the entry within 28 days after the\nday the authority ceases to be in force."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-120-norm",
