      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) An authority must be:\n\n(a) in writing in the form approved by the chief officer; and\n\n(b) signed by the person granting it."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kc-ss-1-logic-deontic-5",
