    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-106",
      "@type": "cml:Concept",
      "skos:prefLabel": "106 Subsection 42(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-106"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.60",
      "values:originalText": "Repeal the subsection, substitute:\n\n(5) The court may revoke the *restraining order if satisfied that:\n\n(a) there are no grounds on which to make the order at the time\nof considering the application to revoke the order; or\n\n(b) it is otherwise in the interests of justice to do so.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(5) The court may revoke the *restraining order if satisfied that:\n\n(a) there are no grounds on which to make the order at the time\nof considering the application to revoke the order; or\n\n(b) it is otherwise in the interests of justice to do so.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-106-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-106-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c83ffbcafbbe6cbba8120516fa072269dd539abd94c4424e046c92a6347e3f61",
      "skos:note": "Court may revoke restraining order under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-106",
      "@type": "cof:Section",
      "cof:title": "106 Subsection 42(5)",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "Repeal the subsection, substitute:\n\n(5) The court may revoke the *restraining order if satisfied that:\n\n(a) there are no grounds on which to make the order at the time\nof considering the application to revoke the order; or\n\n(b) it is otherwise in the interests of justice to do so."
    },
    {
