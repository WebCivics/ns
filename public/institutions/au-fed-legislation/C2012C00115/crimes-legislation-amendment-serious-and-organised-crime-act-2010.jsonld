      "@type": "cml:Concept",
      "skos:prefLabel": "15HV(5) Ombudsman to be given information and access despite other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hv-ss-5"
      },
      "cml:curationStatus": {
