    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mr-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15MR(3) Permission to give information disclosing operative’s identity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15mr-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.156",
      "values:originalText": "(3) The permission:\n\n(a) must name the person who may give the information; and\n\n(b) must name the person to whom the information may be\ngiven; and\n\n(c) must state the information that may be given; and\n\n(d) may state how the information may be given.\nNote:\nThe chief officer may delegate functions under this section—see\nsection 15MX.",
      "skos:definition": "(3) The permission:\n\n(a) must name the person who may give the information; and\n\n(b) must name the person to whom the information may be\ngiven; and\n\n(c) must state the information that may be given; and\n\n(d) may state how the information may be given.\nNote:\nThe chief officer may delegate functions under this section—see\nsection 15MX.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mr"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mr-ss-3-norm"
        }
      ],
      "cml:integrityHash": "1aadf1b3f312a1ab322c457108791b8b1680039ccb8649d2f552d4363e84cac7",
      "skos:note": "Permission to give information disclosing operative’s identity"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15mr-ss-3",
      "@type": "cof:Section",
      "cof:title": "15MR(3) Permission to give information disclosing operative’s identity",
      "values:kind": "subsection",
      "cof:pageNumber": 156,
      "values:originalText": "(3) The permission:\n\n(a) must name the person who may give the information; and\n\n(b) must name the person to whom the information may be\ngiven; and\n\n(c) must state the information that may be given; and\n\n(d) may state how the information may be given.\nNote:\nThe chief officer may delegate functions under this section—see\nsection 15MX."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mr-ss-3-norm",
