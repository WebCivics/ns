    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15h",
      "@type": "cml:Concept",
      "skos:prefLabel": "15H Defect in authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.87",
      "values:originalText": "An application for an authority or variation of an authority, and any\nauthority or variation of an authority granted on the basis of such\nan application, is not invalidated by any defect, other than a defect\nthat affects the application, authority or variation in a material\nparticular.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "skos:definition": "An application for an authority or variation of an authority, and any\nauthority or variation of an authority granted on the basis of such\nan application, is not invalidated by any defect, other than a defect\nthat affects the application, authority or variation in a material\nparticular.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15h-norm"
        }
      ],
      "cml:integrityHash": "bf0cf87db220dfd1e090178e3ce729b585f679f9a2761da1e46cc7c0b84f9348",
      "skos:note": "An application for an authority or variation of an authority is not invalidated by any defect, other than a defect that affects the application, authority or variation in a material part."
    },
    {
