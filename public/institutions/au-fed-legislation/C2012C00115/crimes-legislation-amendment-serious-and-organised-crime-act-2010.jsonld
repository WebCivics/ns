      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-156",
      "@type": "cml:Concept",
      "skos:prefLabel": "156 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-156"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.160",
      "values:originalText": "(e) section 15ML (disclosure of operative’s identity to presiding\nofficer);\n\n(f) section 15MM (disclosure of operative’s identity etc. despite\ncertificate);\n\n(g) section 15MN (application for leave—joinder as respondent);\n\n(h) section 15MO (directions to jury);\n\n(i) section 15MP (adjournment for appeal decision);\n\n(j) section 15MS (disclosure offences);\n\n(k) section 15MT (evidentiary certificates).",
      "skos:definition": "(e) section 15ML (disclosure of operative’s identity to presiding\nofficer);\n\n(f) section 15MM (disclosure of operative’s identity etc. despite\ncertificate);\n\n(g) section 15MN (application for leave—joinder as respondent);\n\n(h) section 15MO (directions to jury);\n\n(i) section 15MP (adjournment for appeal decision);\n\n(j) section 15MS (disclosure offences);\n\n(k) section 15MT (evidentiary certificates).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-156-norm"
        },
        {
