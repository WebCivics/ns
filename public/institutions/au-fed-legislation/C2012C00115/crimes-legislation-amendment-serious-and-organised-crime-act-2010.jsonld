    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-140",
      "@type": "cml:Concept",
      "skos:prefLabel": "140 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-140"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.144",
      "values:originalText": "(c) the discovery, exchange, production, inspection or disclosure\nof intended evidence, documents and reports of persons\nintended to be called by a party to give evidence;\n\n(d) a sentencing proceeding;\n\n(e) an appeal proceeding;\n\n(f) a proceeding with respect to any matter in which a person\nseeks a writ of mandamus or prohibition or an injunction\nagainst an officer or officers of the Commonwealth (within\nthe meaning of subsection 39B(1B) of the Judiciary Act\n1903) in relation to:\n\n(i) a decision to prosecute a person for one or more\noffences against a law of the Commonwealth; or\n\n(ii) a related criminal justice process decision (within the\nmeaning of subsection 39B(3) of that Act);\n\n(g) any other pre-trial, interlocutory or post-trial proceeding\nprescribed by regulations for the purposes of this paragraph.",
      "skos:definition": "(c) the discovery, exchange, production, inspection or disclosure\nof intended evidence, documents and reports of persons\nintended to be called by a party to give evidence;\n\n(d) a sentencing proceeding;\n\n(e) an appeal proceeding;\n\n(f) a proceeding with respect to any matter in which a person\nseeks a writ of mandamus or prohibition or an injunction\nagainst an officer or officers of the Commonwealth (within\nthe meaning of subsection 39B(1B) of the Judiciary Act\n1903) in relation to:\n\n(i) a decision to prosecute a person for one or more\noffences against a law of the Commonwealth; or\n\n(ii) a related criminal justice process decision (within the\nmeaning of subsection 39B(3) of that Act);\n\n(g) any other pre-trial, interlocutory or post-trial proceeding\nprescribed by regulations for the purposes of this paragraph.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-140-norm"
        },
        {
