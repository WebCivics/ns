      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kx",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KX Requests to a participating jurisdiction for evidence of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kx"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.131",
      "values:originalText": "assumed identity\n\n(1) This section applies if an authority granted under section 15KB\nauthorises a request under this section.\n\n(2) The chief officer of a law enforcement agency or an intelligence\nagency who grants the authority may request the chief officer of an\nissuing agency of a participating jurisdiction stated in the authority\nto:\n\n(a) produce evidence of the assumed identity in accordance with\nthe authority; and\n\n(b) give evidence of the assumed identity to the following:\n\n(i) the authorised person named in the authority;\n\n(ii) an officer of the law enforcement agency or the\nintelligence agency who is named in the request.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "skos:definition": "assumed identity\n\n(1) This section applies if an authority granted under section 15KB\nauthorises a request under this section.\n\n(2) The chief officer of a law enforcement agency or an intelligence\nagency who grants the authority may request the chief officer of an\nissuing agency of a participating jurisdiction stated in the authority\nto:\n\n(a) produce evidence of the assumed identity in accordance with\nthe authority; and\n\n(b) give evidence of the assumed identity to the following:\n\n(i) the authorised person named in the authority;\n\n(ii) an officer of the law enforcement agency or the\nintelligence agency who is named in the request.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kx-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kx-ss-2"
        }
