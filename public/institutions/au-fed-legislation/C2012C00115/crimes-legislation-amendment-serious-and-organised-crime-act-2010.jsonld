      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.152",
      "values:originalText": "(11) A person commits an offence if:\n\n(a) an order has been made under subsection (8), (9) or (10); and\n\n(b) the person engages in conduct; and\n\n(c) the conduct contravenes the order.\nPenalty: Imprisonment for 2 years.",
      "skos:definition": "(11) A person commits an offence if:\n\n(a) an order has been made under subsection (8), (9) or (10); and\n\n(b) the person engages in conduct; and\n\n(c) the conduct contravenes the order.\nPenalty: Imprisonment for 2 years.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-deontic-4"
        }
