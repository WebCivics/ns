    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-74",
      "@type": "cml:Concept",
      "skos:prefLabel": "74 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-74"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.78",
      "values:originalText": "(4) A formal authority must not be varied in such a way that the period\nof effect of the authority will, after the variation is made, exceed 3\nmonths (including any previous extensions).\n\n(5) An authority must not be varied unless the authorising officer is\nsatisfied on reasonable grounds that the variation will not authorise\na significant alteration of the nature of the controlled operation\nconcerned.\n\n(6) A variation is not a legislative instrument.",
      "skos:definition": "(4) A formal authority must not be varied in such a way that the period\nof effect of the authority will, after the variation is made, exceed 3\nmonths (including any previous extensions).\n\n(5) An authority must not be varied unless the authorising officer is\nsatisfied on reasonable grounds that the variation will not authorise\na significant alteration of the nature of the controlled operation\nconcerned.\n\n(6) A variation is not a legislative instrument.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-74-ss-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-74-ss-5"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-74-ss-6"
        }
      ],
      "cml:integrityHash": "9fcdd27d90af99487ed34b848bf9f21aaa17dfe22618cbdf174e7dbd17a64194"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-74",
      "@type": "cof:Section",
      "cof:title": "74 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "section",
      "cof:pageNumber": 78,
      "values:originalText": "(4) A formal authority must not be varied in such a way that the period\nof effect of the authority will, after the variation is made, exceed 3\nmonths (including any previous extensions).\n\n(5) An authority must not be varied unless the authorising officer is\nsatisfied on reasonable grounds that the variation will not authorise\na significant alteration of the nature of the controlled operation\nconcerned.\n\n(6) A variation is not a legislative instrument."
    },
