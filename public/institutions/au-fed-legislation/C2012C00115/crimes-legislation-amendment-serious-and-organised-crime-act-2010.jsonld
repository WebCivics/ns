    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "146(5) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-146-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.150",
      "values:originalText": "(5) To avoid doubt, subsection (4) does not prevent the taking of a\ntranscript of court proceedings, but the court may make an order\nfor how the transcript is to be dealt with, including an order\nsuppressing its publication.",
      "skos:definition": "(5) To avoid doubt, subsection (4) does not prevent the taking of a\ntranscript of court proceedings, but the court may make an order\nfor how the transcript is to be dealt with, including an order\nsuppressing its publication.",
      "values:partOf": {
