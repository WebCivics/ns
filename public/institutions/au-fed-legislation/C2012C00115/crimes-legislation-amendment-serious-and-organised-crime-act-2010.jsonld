    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mp-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "15MP(5) Appeals and adjournments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15mp-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.154",
      "values:originalText": "(5) A party to the proceedings, the operative to whom the certificate\nrelates or the chief officer who gave the certificate may apply to\nthe original court for an adjournment:\n\n(a) to appeal against the decision of the original court to give or\nrefuse leave, or to make or refuse to make the order; or\n\n(b) to decide whether to appeal or seek leave to appeal against\nthe decision.",
      "skos:definition": "(5) A party to the proceedings, the operative to whom the certificate\nrelates or the chief officer who gave the certificate may apply to\nthe original court for an adjournment:\n\n(a) to appeal against the decision of the original court to give or\nrefuse leave, or to make or refuse to make the order; or\n\n(b) to decide whether to appeal or seek leave to appeal against\nthe decision.",
      "values:partOf": {
