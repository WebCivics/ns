      "@type": "cml:Concept",
      "skos:prefLabel": "15GP(7) Application to appropriate authorising officer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gp-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
