    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15mq-ss-2",
      "@type": "cof:Section",
      "cof:title": "15MQ(2) Witness identity protection certificate—cancellation",
      "values:kind": "subsection",
