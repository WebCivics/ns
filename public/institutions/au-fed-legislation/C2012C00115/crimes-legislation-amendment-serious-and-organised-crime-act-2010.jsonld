    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-108",
      "@type": "cml:Concept",
      "skos:prefLabel": "108 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-108"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
