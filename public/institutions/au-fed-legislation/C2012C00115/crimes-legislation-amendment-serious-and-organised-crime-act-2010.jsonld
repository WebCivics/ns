      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gm",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GM Change of principal law enforcement officer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gm"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.76",
      "values:originalText": "If an authorising officer in relation to a controlled operation\nbecomes satisfied that the principal law enforcement officer for the\ncontrolled operation ceases for any reason to have responsibility\nfor the controlled operation:\n\n(a) the authorising officer may, by instrument in writing,\nnominate another person as the principal law enforcement\nofficer for the controlled operation; and\n\n(b) with effect from the execution of the instrument or such later\ntime as is specified in the instrument, that other person\nbecomes the principal law enforcement officer for the\ncontrolled operation.",
      "skos:definition": "If an authorising officer in relation to a controlled operation\nbecomes satisfied that the principal law enforcement officer for the\ncontrolled operation ceases for any reason to have responsibility\nfor the controlled operation:\n\n(a) the authorising officer may, by instrument in writing,\nnominate another person as the principal law enforcement\nofficer for the controlled operation; and\n\n(b) with effect from the execution of the instrument or such later\ntime as is specified in the instrument, that other person\nbecomes the principal law enforcement officer for the\ncontrolled operation.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gm-norm"
        }
      ],
      "cml:integrityHash": "04216488789e68fb33f4865f2866a9072baa8a11645cb086d5428392de9a25c3",
      "skos:note": "Authorising officer may nominate another person as principal law enforcement officer."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gm",
      "@type": "cof:Section",
      "cof:title": "15GM Change of principal law enforcement officer",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "If an authorising officer in relation to a controlled operation\nbecomes satisfied that the principal law enforcement officer for the\ncontrolled operation ceases for any reason to have responsibility\nfor the controlled operation:\n\n(a) the authorising officer may, by instrument in writing,\nnominate another person as the principal law enforcement\nofficer for the controlled operation; and\n\n(b) with effect from the execution of the instrument or such later\ntime as is specified in the instrument, that other person\nbecomes the principal law enforcement officer for the\ncontrolled operation."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gm-norm",
