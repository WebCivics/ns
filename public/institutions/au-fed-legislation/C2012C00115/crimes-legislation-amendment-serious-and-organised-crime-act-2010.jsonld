        }
      ],
      "cml:integrityHash": "13de39abfa5f17c960cabae0d4dbf40b4b85365368755c4cb763ec146ff2d10c",
      "skos:note": "Section 15HH does not apply to certain laws relating to criminal investigation."
    },
    {
