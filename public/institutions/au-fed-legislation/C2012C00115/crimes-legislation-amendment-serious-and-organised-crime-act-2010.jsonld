    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15mq-ss-1",
      "@type": "cof:Section",
      "cof:title": "15MQ(1) Witness identity protection certificate—cancellation",
      "values:kind": "subsection",
      "cof:pageNumber": 155,
      "values:originalText": "(1) This section applies if the chief officer of a law enforcement\nagency gives a witness identity protection certificate for an\noperative in relation to a proceeding."
    },
