      },
      "cml:premiseText": "(b) for each authority under this Part granted by an authorising officer of the agency:"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hq-ss-2-logic-deontic-4",
