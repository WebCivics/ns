      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.11",
      "values:originalText": "Add:\nNote 2:\nIf there is an unexplained wealth order that relates to a restraining\norder under section 20A, the court may also order the Official Trustee\nto pay an amount equal to the unexplained wealth amount out of\nproperty covered by the restraining order: see section 282A.",
      "skos:definition": "Add:\nNote 2:\nIf there is an unexplained wealth order that relates to a restraining\norder under section 20A, the court may also order the Official Trustee\nto pay an amount equal to the unexplained wealth amount out of\nproperty covered by the restraining order: see section 282A.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-10-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0e9a3cef6e7db510b4d197cbcc7245ed8787beffab64bb46c892e832072024ae",
      "skos:note": "Court may order Official Trustee to pay unexplained wealth amount out of property covered by restraining order."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 At the end of subsection 39(1) (after the note)",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Add:\nNote 2:\nIf there is an unexplained wealth order that relates to a restraining\norder under section 20A, the court may also order the Official Trustee\nto pay an amount equal to the unexplained wealth amount out of\nproperty covered by the restraining order: see section 282A."
    },
