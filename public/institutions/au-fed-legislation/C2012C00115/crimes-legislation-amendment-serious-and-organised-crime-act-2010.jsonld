    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-12-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-12-2"
