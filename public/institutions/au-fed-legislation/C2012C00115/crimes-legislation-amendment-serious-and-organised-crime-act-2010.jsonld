      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.46",
      "values:originalText": "Section 149 of the Proceeds of Crime Act 2002 as amended by this Part\napplies in relation to pecuniary penalty orders applied for after the\ncommencement of that section, whether the conduct constituting the\noffence concerned occurred or occurs before, on or after that\ncommencement.",
      "skos:definition": "Section 149 of the Proceeds of Crime Act 2002 as amended by this Part\napplies in relation to pecuniary penalty orders applied for after the\ncommencement of that section, whether the conduct constituting the\noffence concerned occurred or occurs before, on or after that\ncommencement.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-31-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-31-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "8a4836d00ae0174585205686e9a1cfef239698e49005eda31d59467126dd603c",
      "skos:note": "Commencement of section 149 of the Proceeds of Crime Act 2002"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Application of new section 149",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "Section 149 of the Proceeds of Crime Act 2002 as amended by this Part\napplies in relation to pecuniary penalty orders applied for after the\ncommencement of that section, whether the conduct constituting the\noffence concerned occurred or occurs before, on or after that\ncommencement."
    },
