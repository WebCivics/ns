      "cml:premiseText": "(b) a charge against a person for an offence is pending if the person has not yet been charged with the offence, but:"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mb-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
