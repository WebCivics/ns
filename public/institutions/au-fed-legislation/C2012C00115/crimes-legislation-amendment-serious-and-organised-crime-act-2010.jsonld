    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.165",
      "values:originalText": "In this Part:\ncommencement means the commencement of this item.\nState controlled operations law means:\n\n(a) a law of a State or Territory; or\n\n(b) a provision or provisions of a law of a State or Territory;\nprescribed by the regulations for the purposes of this definition.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "skos:definition": "In this Part:\ncommencement means the commencement of this item.\nState controlled operations law means:\n\n(a) a law of a State or Territory; or\n\n(b) a provision or provisions of a law of a State or Territory;\nprescribed by the regulations for the purposes of this definition.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-16-norm"
        }
      ],
      "cml:integrityHash": "93560a0b78f460f907a8ae7f10711ad0338e4c5dfacf677843e9e176fa012a33",
      "skos:note": "Defines commencement and State controlled operations law."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 165,
      "values:originalText": "In this Part:\ncommencement means the commencement of this item.\nState controlled operations law means:\n\n(a) a law of a State or Territory; or\n\n(b) a provision or provisions of a law of a State or Territory;\nprescribed by the regulations for the purposes of this definition.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection"
    },
