      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes obligation on the State to protect authorised persons from criminal liability.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The section establishes a duty on the State to protect authorised persons from criminal liability.",
      "cml:conclusionText": "If an authorised person performs specific actions, they are not criminally responsible for the offence."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Establishes a temporal relationship between the performance of actions by authorised persons and their protection from criminal liability.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The section specifies that doing something would not be an offence if the assumed identity were the person's real identity.",
      "cml:conclusionText": "There is an overlap between the performance of actions by authorised persons and their protection from criminal liability."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Establishes a logical relationship between the performance of actions by authorised persons and their protection from criminal liability.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If an authorised person performs specific actions, they are not criminally responsible for the offence.",
      "cml:conclusionText": "The State has a duty to protect authorised persons from criminal liability if they perform specific actions."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Propagation",
      "cml:logicSummary": "Establishes a logical relationship between the protection of authorised persons and the prevention of offences.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The section establishes a duty on the State to protect authorised persons from criminal liability.",
      "cml:conclusionText": "The protection of authorised persons from criminal liability propagates to prevent offences."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:logicSummary": "Establishes a logical relationship between the performance of actions by authorised persons and their protection from criminal liability using artificial intelligence.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The section defines an authorised person as someone who performs specific actions in accordance with authority.",
      "cml:conclusionText": "Artificial intelligence can be used to infer the protection of authorised persons from criminal liability."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kr",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KR Protection from criminal liability—third parties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kr"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.127",
      "values:originalText": "If a person does something that, apart from this section, would be a\nCommonwealth offence or an offence under a law of a State or\nTerritory, the person is not criminally responsible for the offence\nif:\n\n(a) the person is a Commonwealth officer; and\n\n(b) the thing is done in the course of the person’s duty; and\n\n(c) the chief officer who granted the authority has authorised the\ndoing of the thing; and\n\n(d) if an authorised person had done the thing in accordance with\nan authority, the authorised person would not have been\ncriminally responsible for the offence because of the\napplication of section 15KQ.",
      "skos:definition": "If a person does something that, apart from this section, would be a\nCommonwealth offence or an offence under a law of a State or\nTerritory, the person is not criminally responsible for the offence\nif:\n\n(a) the person is a Commonwealth officer; and\n\n(b) the thing is done in the course of the person’s duty; and\n\n(c) the chief officer who granted the authority has authorised the\ndoing of the thing; and\n\n(d) if an authorised person had done the thing in accordance with\nan authority, the authorised person would not have been\ncriminally responsible for the offence because of the\napplication of section 15KQ.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kr-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kr-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "846e9533787bfc2e8b828f0512ed1dc0cc8582bfdf70a5169c0874dd95c57286",
      "skos:note": "Protection from criminal liability for third parties performing official duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kr",
      "@type": "cof:Section",
      "cof:title": "15KR Protection from criminal liability—third parties",
      "values:kind": "section",
      "cof:pageNumber": 127,
      "values:originalText": "If a person does something that, apart from this section, would be a\nCommonwealth offence or an offence under a law of a State or\nTerritory, the person is not criminally responsible for the offence\nif:\n\n(a) the person is a Commonwealth officer; and\n\n(b) the thing is done in the course of the person’s duty; and\n\n(c) the chief officer who granted the authority has authorised the\ndoing of the thing; and\n\n(d) if an authorised person had done the thing in accordance with\nan authority, the authorised person would not have been\ncriminally responsible for the offence because of the\napplication of section 15KQ."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kr-norm",
