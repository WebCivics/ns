        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ha-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "841e4eeab4b108edf4c9754ddc29dde05a51904dde93232497dba48de5426e1e",
      "skos:note": "Participant in controlled operation must comply with Commonwealth/State law."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15ha-ss-1",
      "@type": "cof:Section",
      "cof:title": "15HA(1) Protection from criminal responsibility for controlled conduct",
      "values:kind": "subsection",
      "cof:pageNumber": 88,
      "values:originalText": "(1) This section applies if:\n\n(a) a participant in a controlled operation engages in conduct in\nthe course of, and for the purposes of, the controlled\noperation; and\n\n(b) engaging in that conduct is a Commonwealth offence or an\noffence against a law of a State or Territory."
    },
    {
