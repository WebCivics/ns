          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-142-ss-7"
        }
      ],
      "cml:integrityHash": "eeeca05df6004f600dfb9b94446a387a9d95dbfa7c8b4ea2459e1adaf6991672"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-142",
