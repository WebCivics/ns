    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gc",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GC Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.63",
      "values:originalText": "In this Part:\nACC authorising officer has the meaning given by subsection\n15GF(4).\nACLEI authorising officer has the meaning given by subsection\n15GF(5).\nAFP authorising officer has the meaning given by subsection\n15GF(3).\nappropriate authorising officer, for a controlled operation\nauthorised under this Part, means the following:\n\n(a) if the authority to conduct the controlled operation was\ngranted by an AFP authorising officer—any AFP authorising\nofficer;\n\n(b) if the authority to conduct the controlled operation was\ngranted by an ACC authorising officer—any ACC\nauthorising officer;\n\n(c) if the authority to conduct the controlled operation was\ngranted by an ACLEI authorising officer—any ACLEI\nauthorising officer.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "skos:definition": "In this Part:\nACC authorising officer has the meaning given by subsection\n15GF(4).\nACLEI authorising officer has the meaning given by subsection\n15GF(5).\nAFP authorising officer has the meaning given by subsection\n15GF(3).\nappropriate authorising officer, for a controlled operation\nauthorised under this Part, means the following:\n\n(a) if the authority to conduct the controlled operation was\ngranted by an AFP authorising officer—any AFP authorising\nofficer;\n\n(b) if the authority to conduct the controlled operation was\ngranted by an ACC authorising officer—any ACC\nauthorising officer;\n\n(c) if the authority to conduct the controlled operation was\ngranted by an ACLEI authorising officer—any ACLEI\nauthorising officer.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gc-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gc-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "151b5bf84c1381bd1a078f0d105c8927db8fb6be27d10466ecc3ddb82a551ab9",
      "skos:note": "Definitions for controlled operations"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gc",
      "@type": "cof:Section",
      "cof:title": "15GC Definitions",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "In this Part:\nACC authorising officer has the meaning given by subsection\n15GF(4).\nACLEI authorising officer has the meaning given by subsection\n15GF(5).\nAFP authorising officer has the meaning given by subsection\n15GF(3).\nappropriate authorising officer, for a controlled operation\nauthorised under this Part, means the following:\n\n(a) if the authority to conduct the controlled operation was\ngranted by an AFP authorising officer—any AFP authorising\nofficer;\n\n(b) if the authority to conduct the controlled operation was\ngranted by an ACC authorising officer—any ACC\nauthorising officer;\n\n(c) if the authority to conduct the controlled operation was\ngranted by an ACLEI authorising officer—any ACLEI\nauthorising officer.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gc-norm",
