    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-150",
      "@type": "cml:Concept",
      "skos:prefLabel": "150 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-150"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.154",
      "values:originalText": "(3) If a court allows a person to join the application as a respondent\nunder subsection (2), the court must allow the person, or the\nperson’s legal representative, to appear and be heard.",
      "skos:definition": "(3) If a court allows a person to join the application as a respondent\nunder subsection (2), the court must allow the person, or the\nperson’s legal representative, to appear and be heard.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-150-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-150-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "60ed4181b47466a790ac81343d906b9b6703293836a4c076b5665eda5a154036",
      "skos:note": "Court must allow person or legal representative to appear and be heard if joined as respondent."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-150",
      "@type": "cof:Section",
      "cof:title": "150 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "section",
      "cof:pageNumber": 154,
      "values:originalText": "(3) If a court allows a person to join the application as a respondent\nunder subsection (2), the court must allow the person, or the\nperson’s legal representative, to appear and be heard."
    },
