    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15a",
      "@type": "cml:Concept",
      "skos:prefLabel": "15A Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.31",
      "values:originalText": "A freezing order can be made against an account with a financial\ninstitution if:\n\n(a)\nthere are grounds to suspect the account balance\nreflects proceeds or an instrument of certain\noffences; and\nComLaw Authoritative Act C2012C00115\n\nSchedule 2  Other amendments relating to proceeds of crime",
      "skos:definition": "A freezing order can be made against an account with a financial\ninstitution if:\n\n(a)\nthere are grounds to suspect the account balance\nreflects proceeds or an instrument of certain\noffences; and\nComLaw Authoritative Act C2012C00115\n\nSchedule 2  Other amendments relating to proceeds of crime",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15a-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15a-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15a-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15a-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15a-logic-diffusion-4"
        }
      ],
      "cml:integrityHash": "6efbfa28940ef9892e3b69f3390857260e7fbd019c469e0882de496d310db074",
      "skos:note": "Grounds for freezing an account exist"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15a",
      "@type": "cof:Section",
      "cof:title": "15A Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "A freezing order can be made against an account with a financial\ninstitution if:\n\n(a)\nthere are grounds to suspect the account balance\nreflects proceeds or an instrument of certain\noffences; and\nComLaw Authoritative Act C2012C00115\n\nSchedule 2  Other amendments relating to proceeds of crime"
    },
