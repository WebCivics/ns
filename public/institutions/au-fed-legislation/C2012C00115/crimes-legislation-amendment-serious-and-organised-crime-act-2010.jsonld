    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hj-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HJ(2) Protection from criminal responsibility for certain ancillary",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hj-ss-2"
