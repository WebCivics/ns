      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.50",
      "values:originalText": "The amendment of subparagraph 49(1)(c)(iv) of the Proceeds of Crime\nAct 2002 made by this Part applies in relation to applications made on\nor after the commencement of the amendment for a forfeiture order,\nwhether the conduct constituting the offence concerned occurred or\noccurs before, on or after that commencement.",
      "skos:definition": "The amendment of subparagraph 49(1)(c)(iv) of the Proceeds of Crime\nAct 2002 made by this Part applies in relation to applications made on\nor after the commencement of the amendment for a forfeiture order,\nwhether the conduct constituting the offence concerned occurred or\noccurs before, on or after that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-52-norm"
        }
      ],
      "cml:integrityHash": "3820a8625589f28f57fb4e28077793db17d799f546d4c18ce0f829ac61daf171",
      "skos:note": "Amendment applies to applications made on or after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-52",
      "@type": "cof:Section",
      "cof:title": "52 Application of amendment of subparagraph 49(1)(c)(iv)",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "The amendment of subparagraph 49(1)(c)(iv) of the Proceeds of Crime\nAct 2002 made by this Part applies in relation to applications made on\nor after the commencement of the amendment for a forfeiture order,\nwhether the conduct constituting the offence concerned occurred or\noccurs before, on or after that commencement."
    },
