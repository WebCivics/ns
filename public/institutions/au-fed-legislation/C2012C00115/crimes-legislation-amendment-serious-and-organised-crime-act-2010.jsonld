    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-60",
      "@type": "cml:Concept",
      "skos:prefLabel": "60 Application of amendments of sections 73 and 85",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-60"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.51",
      "values:originalText": "The amendments of sections 73 and 85 of the Proceeds of Crime Act\n2002 made by this Part apply in relation to forfeiture orders applied for\non or after the commencement of the amendments, whether the conduct\nconstituting the offence concerned occurred or occurs before, on or after\nthat commencement.",
      "skos:definition": "The amendments of sections 73 and 85 of the Proceeds of Crime Act\n2002 made by this Part apply in relation to forfeiture orders applied for\non or after the commencement of the amendments, whether the conduct\nconstituting the offence concerned occurred or occurs before, on or after\nthat commencement.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-60-norm"
        }
      ],
      "cml:integrityHash": "4b771874d811b7eb5bfd359bae723281bc31f644594ec9179f128ed0f8f7a312",
      "skos:note": "Application of amendments of sections 73 and 85"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-60",
      "@type": "cof:Section",
      "cof:title": "60 Application of amendments of sections 73 and 85",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "The amendments of sections 73 and 85 of the Proceeds of Crime Act\n2002 made by this Part apply in relation to forfeiture orders applied for\non or after the commencement of the amendments, whether the conduct\nconstituting the offence concerned occurred or occurs before, on or after\nthat commencement."
    },
