      "cml:integrityHash": "e5b2b4c9e47bb36cf184472572a2888ae3789474cd5cc8e5a17e344fc21793f5",
      "skos:note": "An unexplained wealth order against a person may be enforced as if it were an order made in civil proceedings instituted by the Commonwealth."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179r-ss-2",
      "@type": "cof:Section",
      "cof:title": "179R(2) Enforcement of an unexplained wealth order",
      "values:kind": "subsection",
      "cof:pageNumber": 21,
      "values:originalText": "(2) An *unexplained wealth order against a person may be enforced as\nif it were an order made in civil proceedings instituted by the\nCommonwealth against the person to recover a debt due by the\nperson to the Commonwealth."
    },
