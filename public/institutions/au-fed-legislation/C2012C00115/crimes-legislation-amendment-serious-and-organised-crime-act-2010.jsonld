      "cml:integrityHash": "1fb7ab2a4453122a2c5eb9dae37f83b946bc3ca2209e17b9064a091e32661f89",
      "skos:note": "Engaging in conduct that contravenes an order made under subsections (8), (9) or (10) is a crime."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-148-ss-11",
      "@type": "cof:Section",
      "cof:title": "148(11) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "subsection",
      "cof:pageNumber": 152,
      "values:originalText": "(11) A person commits an offence if:\n\n(a) an order has been made under subsection (8), (9) or (10); and\n\n(b) the person engages in conduct; and\n\n(c) the conduct contravenes the order.\nPenalty: Imprisonment for 2 years."
    },
