      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.163",
      "values:originalText": "investigation\nItem 12 does not apply to a person’s conduct that is, or could have been,\nauthorised under a Commonwealth law or a law of a State or Territory\nrelating to the following:\n\n(a) arrest or detention of individuals;\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "skos:definition": "investigation\nItem 12 does not apply to a person’s conduct that is, or could have been,\nauthorised under a Commonwealth law or a law of a State or Territory\nrelating to the following:\n\n(a) arrest or detention of individuals;\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-13-norm"
        }
      ],
      "cml:integrityHash": "7ff25a64cdc0625ee1e2df5b33f81c9bd214d72aa354e9d3fb611110de64ce2e",
      "skos:note": "Item 12 does not apply to certain conduct authorized under Commonwealth or State laws."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-13",
      "@type": "cof:Section",
