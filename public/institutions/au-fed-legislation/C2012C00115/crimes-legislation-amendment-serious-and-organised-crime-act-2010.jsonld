    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kw-ss-5",
      "@type": "cof:Section",
      "cof:title": "15KW(5) Consequences of transfer of control of authorities",
      "values:kind": "subsection",
      "cof:pageNumber": 130,
      "values:originalText": "(5) Section 15KL (which deals with cancellation of evidence of\nassumed identity) has effect as if the chief officer of the receiving\nagency had made the request under section 15KI."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kw-ss-5-norm",
      "@type": "values:Undertaking",
