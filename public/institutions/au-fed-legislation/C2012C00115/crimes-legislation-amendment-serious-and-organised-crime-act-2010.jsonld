      ],
      "cml:integrityHash": "291cbb5d04c866060db5b55141997d2fd83b9a66fd0abfcb0580caf2d5e39d31",
      "skos:note": "Continues application of Crimes Act 1914 after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Controlled operations authorised before commencement",
      "values:kind": "section",
      "cof:pageNumber": 166,
      "values:originalText": "continue under old law\n(1)\nDespite the repeals and amendments made by this Part, the Crimes Act\n1914, as in force immediately before the commencement of this item,\ncontinues to apply after that commencement, in relation to a\npre-commencement controlled operation, as if those repeals and\namendments had not happened.\n(2)\nIn this item:\npre-commencement controlled operation means a controlled operation\nauthorised under Part IAB of the Crimes Act 1914 before the\ncommencement of this item, whether or not the pre-commencement\ncontrolled operation had been completed as at that commencement."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-17-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-17"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-17-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "continues",
      "cml:logicSummary": "Continues application of Crimes Act 1914.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Repeals and amendments made by this Part do not affect the continued application of the Crimes Act 1914.",
      "cml:conclusionText": "The Crimes Act 1914 continues to apply after commencement."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-17-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "subclassOf",
      "cml:logicSummary": "Continues application of Crimes Act 1914 as if repeals and amendments had not happened.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Pre-commencement controlled operation is a subclass of the crimes covered by the Crimes Act 1914.",
      "cml:conclusionText": "The Crimes Act 1914 continues to apply after commencement in relation to pre-commencement controlled operations."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-17-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Continues application of Crimes Act 1914 during the period of pre-commencement controlled operation.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The commencement of this item marks the beginning of a new period for which the Crimes Act 1914 does not apply.",
      "cml:conclusionText": "The Crimes Act 1914 continues to apply after commencement in relation to pre-commencement controlled operations during that period."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-17-logic-ltl-4",
