    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-98-ss-5",
      "@type": "cof:Section",
      "cof:title": "98(5) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "subsection",
      "cof:pageNumber": 102,
      "values:originalText": "(5) A report must not disclose any information that identifies any\nperson involved in an operation or that is likely to lead to such a\nperson being identified."
    },
