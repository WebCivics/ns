        }
      ],
      "cml:integrityHash": "94ed52d295dd13f0930a545f97d3208e8f64b227fee79201ebe4c790866d735b",
      "skos:note": "Assumed identities—authorisations taken to be authority"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Assumed identities—authorisations taken to be authority",
      "values:kind": "section",
      "cof:pageNumber": 166,
      "values:originalText": "under new law\n(1)\nThis item applies to an authorisation that was granted under\nsection 15XG of the Crimes Act 1914 immediately before the\ncommencement of this item.\n(2)\nThe authorisation has effect, after the commencement of this item, as if\nit were an authority granted under section 15KB as inserted by this\nSchedule."
    },
