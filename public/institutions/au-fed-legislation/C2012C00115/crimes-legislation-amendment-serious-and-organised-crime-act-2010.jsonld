    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mh",
      "@type": "cml:Concept",
      "skos:prefLabel": "15MH Filing and notification",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15mh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.149",
      "values:originalText": "(1) A witness identity protection certificate for an operative in relation\nto a proceeding must be filed in the court before the operative gives\nevidence in the proceeding.\n\n(2) The person who files the certificate must give a copy of it to each\nparty to the proceeding at least 14 days (or the shorter period\nagreed to by the party) before the day the operative is to give\nevidence.\n\n(3) The court may order the person filing the certificate to give a copy\nof it to a person stated in the order.\n\n(4) This section applies subject to section 15MI.",
      "skos:definition": "(1) A witness identity protection certificate for an operative in relation\nto a proceeding must be filed in the court before the operative gives\nevidence in the proceeding.\n\n(2) The person who files the certificate must give a copy of it to each\nparty to the proceeding at least 14 days (or the shorter period\nagreed to by the party) before the day the operative is to give\nevidence.\n\n(3) The court may order the person filing the certificate to give a copy\nof it to a person stated in the order.\n\n(4) This section applies subject to section 15MI.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mh-ss-1"
        },
