      },
      "cml:premiseText": "No court order under section 15MK.",
      "cml:conclusionText": "No adverse inferences."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mo-ss-2-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
