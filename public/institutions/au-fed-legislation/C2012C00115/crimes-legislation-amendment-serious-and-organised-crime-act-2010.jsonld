        }
      ],
      "cml:integrityHash": "d075e18cf92c072e3e2e9746e0bd7580aba699f1cc5f8a946d4e860638db094b",
      "skos:note": "Party may apply for adjournment to appeal against original court's decision."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15mp-ss-5",
