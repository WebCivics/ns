    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hx",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HX Delegation by Ombudsman",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hx"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.110",
      "values:originalText": "(1) The Ombudsman may, by written instrument, delegate to an APS\nemployee responsible to the Ombudsman all or any of the\nOmbudsman’s powers under this Division, other than a power to\nreport to the Minister.\n\n(2) A delegate must, upon request by a person affected by the exercise\nof any power delegated to the delegate, produce the instrument of\ndelegation, or a copy of the instrument, for inspection by the\nperson.",
      "skos:definition": "(1) The Ombudsman may, by written instrument, delegate to an APS\nemployee responsible to the Ombudsman all or any of the\nOmbudsman’s powers under this Division, other than a power to\nreport to the Minister.\n\n(2) A delegate must, upon request by a person affected by the exercise\nof any power delegated to the delegate, produce the instrument of\ndelegation, or a copy of the instrument, for inspection by the\nperson.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hx-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hx-ss-2"
        }
      ],
      "cml:integrityHash": "56dff243c44c7e7c2debc15c6da110d0a56ce470259772afb2287a5367def37e"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hx",
      "@type": "cof:Section",
      "cof:title": "15HX Delegation by Ombudsman",
      "values:kind": "section",
      "cof:pageNumber": 110,
      "values:originalText": "(1) The Ombudsman may, by written instrument, delegate to an APS\nemployee responsible to the Ombudsman all or any of the\nOmbudsman’s powers under this Division, other than a power to\nreport to the Minister.\n\n(2) A delegate must, upon request by a person affected by the exercise\nof any power delegated to the delegate, produce the instrument of\ndelegation, or a copy of the instrument, for inspection by the\nperson."
    },
