    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HN(5) Chief officers’ annual reports to Minister and Ombudsman",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hn-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.100",
      "values:originalText": "(5) Nothing in this section requires particulars of a controlled\noperation to be included in a report for a year if the operation had\nnot been completed as at 30 June in that year, but the particulars\nmust instead be included in the report for the year in which the\noperation is completed.",
      "skos:definition": "(5) Nothing in this section requires particulars of a controlled\noperation to be included in a report for a year if the operation had\nnot been completed as at 30 June in that year, but the particulars\nmust instead be included in the report for the year in which the\noperation is completed.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn-ss-5-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4951dc8d4f06bfd91a34ce511d7d0499f7ae6cff6d80489e5ab77f0a1073d93b",
      "skos:note": "Annual reports must include particulars of a controlled operation when completed.",
      "dc:description": "Yes"
    },
    {
