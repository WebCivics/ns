      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.46",
      "values:originalText": "Repeal the subparagraphs, substitute:\n\n(ii) proceeds of a serious offence, or an instrument of a\nserious offence, that a person is reasonably suspected of\nhaving committed;\nComLaw Authoritative Act C2012C00115\n\nOther amendments relating to proceeds of crime  Schedule 2\nRemoval of 6-year time limit  Part 2\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "skos:definition": "Repeal the subparagraphs, substitute:\n\n(ii) proceeds of a serious offence, or an instrument of a\nserious offence, that a person is reasonably suspected of\nhaving committed;\nComLaw Authoritative Act C2012C00115\n\nOther amendments relating to proceeds of crime  Schedule 2\nRemoval of 6-year time limit  Part 2\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-33-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e498e9900d7f8432b47a54c390fae9e1396066d140f9acd0d4ec5b5d8f07359b",
      "skos:note": "Repeal subparagraphs and substitute with proceeds of serious offence or instrument."
    },
