    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "146(6) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-146-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.150",
      "values:originalText": "(6) A person commits an offence if:\n\n(a) an order has been made under subsection (1), (4) or (5); and\n\n(b) the person engages in conduct; and\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\n\n(c) the conduct contravenes the order.\nPenalty: Imprisonment for 2 years.",
      "skos:definition": "(6) A person commits an offence if:\n\n(a) an order has been made under subsection (1), (4) or (5); and\n\n(b) the person engages in conduct; and\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\n\n(c) the conduct contravenes the order.\nPenalty: Imprisonment for 2 years.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "eef1c5f4bf7d65c3f7b8cb18fb46c3366bbb4c87c28d3f207fc6a828c90c8877",
      "skos:note": "Engaging in conduct that contravenes an order is a crime."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-146-ss-6",
      "@type": "cof:Section",
      "cof:title": "146(6) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "subsection",
      "cof:pageNumber": 150,
      "values:originalText": "(6) A person commits an offence if:\n\n(a) an order has been made under subsection (1), (4) or (5); and\n\n(b) the person engages in conduct; and\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\n\n(c) the conduct contravenes the order.\nPenalty: Imprisonment for 2 years."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-norm",
      "@type": "values:Prohibition",
