    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15h-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "15H(4) Offences relating to orders made under section 15E",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15h-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.36",
      "values:originalText": "(4) A person commits an offence if:\n\n(a) the person gives a magistrate a form of *freezing order under\nsection 15E relating to a *financial institution; and\n\n(b) the person does so after presenting to the financial institution\na document purporting to be a form of the freezing order; and\n\n(c) the form given to the magistrate is not in the same form as\nthe document presented to the financial institution.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both.",
      "skos:definition": "(4) A person commits an offence if:\n\n(a) the person gives a magistrate a form of *freezing order under\nsection 15E relating to a *financial institution; and\n\n(b) the person does so after presenting to the financial institution\na document purporting to be a form of the freezing order; and\n\n(c) the form given to the magistrate is not in the same form as\nthe document presented to the financial institution.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15h"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15h-ss-4-norm"
        },
