    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 At the end of section 335",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.26",
      "values:originalText": "Add:\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\nPreliminary unexplained wealth orders and unexplained wealth\norders\n\n(7) The courts that have proceeds jurisdiction for a *preliminary\nunexplained wealth order or an *unexplained wealth order are those\nof any State or Territory with jurisdiction to deal with criminal\nmatters on indictment.",
      "skos:definition": "Add:\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\nPreliminary unexplained wealth orders and unexplained wealth\norders\n\n(7) The courts that have proceeds jurisdiction for a *preliminary\nunexplained wealth order or an *unexplained wealth order are those\nof any State or Territory with jurisdiction to deal with criminal\nmatters on indictment.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-29-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-29-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d3e1aabbc89087e24d803b37449c3ea9cf9b8f696c8851f10226c92bd6045c8e",
      "skos:note": "States and Territories with jurisdiction to deal with criminal matters on indictment have proceeds jurisdiction for preliminary unexplained wealth orders or unexplained wealth orders."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-29",
      "@type": "cof:Section",
      "cof:title": "29 At the end of section 335",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Add:\nComLaw Authoritative Act C2012C00115\n\nUnexplained wealth  Schedule 1\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010\nPreliminary unexplained wealth orders and unexplained wealth\norders\n\n(7) The courts that have proceeds jurisdiction for a *preliminary\nunexplained wealth order or an *unexplained wealth order are those\nof any State or Territory with jurisdiction to deal with criminal\nmatters on indictment."
    },
