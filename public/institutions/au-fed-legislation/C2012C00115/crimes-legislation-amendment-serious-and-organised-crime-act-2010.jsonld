      "@type": "cml:Concept",
      "skos:prefLabel": "14 Subsection 5(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-4-sec-14"
