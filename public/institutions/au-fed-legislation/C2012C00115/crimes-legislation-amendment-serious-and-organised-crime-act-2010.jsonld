      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.90",
      "values:originalText": "(3) For the purposes of this section, a person is reckless about the\nexistence of the variation or cancellation of an authority if:\n\n(a) the person is aware of a substantial risk that the variation or\ncancellation has happened; and\n\n(b) having regard to the circumstances known to the person, it is\nunjustifiable to take the risk that the authority has not been\nvaried or cancelled.",
      "skos:definition": "(3) For the purposes of this section, a person is reckless about the\nexistence of the variation or cancellation of an authority if:\n\n(a) the person is aware of a substantial risk that the variation or\ncancellation has happened; and\n\n(b) having regard to the circumstances known to the person, it is\nunjustifiable to take the risk that the authority has not been\nvaried or cancelled.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hd"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hd-ss-3-norm"
        },
