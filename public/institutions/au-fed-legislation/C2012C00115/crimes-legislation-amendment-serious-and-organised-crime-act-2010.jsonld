    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits conduct that contravenes an order.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an order has been made under subsection (1), (4) or (5); and\n(b) the person engages in conduct; and\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The person commits an offence if the conduct contravenes the order."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Defines a temporal interval during which the person must not engage in conduct that contravenes an order.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an order has been made under subsection (1), (4) or (5); and\n(b) the person engages in conduct; and\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The person commits an offence if they engage in conduct that contravenes an order during this temporal interval."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:logicSummary": "Defines a recurring pattern of conduct that must be avoided by the person.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an order has been made under subsection (1), (4) or (5); and\n(b) the person engages in conduct; and\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The person commits an offence if they engage in this recurring pattern of conduct that contravenes an order."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Defines a process by which the person's conduct is diffused into the environment.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an order has been made under subsection (1), (4) or (5); and\n(b) the person engages in conduct; and\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The person commits an offence if their conduct is diffused into the environment by this process."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-146-ss-6-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognises",
      "cml:logicSummary": "Defines a cognitive function that recognises the person's conduct as contravening an order.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an order has been made under subsection (1), (4) or (5); and\n(b) the person engages in conduct; and\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The person commits an offence if this cognitive function recognises their conduct as contravening an order."
    },
