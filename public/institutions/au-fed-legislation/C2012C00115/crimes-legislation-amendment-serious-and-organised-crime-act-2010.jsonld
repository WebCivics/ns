      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.93",
      "values:originalText": "investigation\n\nSection 15HH does not apply to a person’s conduct that is, or could\nhave been, authorised under a Commonwealth law or a law of a\nState or Territory relating to the following:\n\n(a) arrest or detention of individuals;\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "skos:definition": "investigation\n\nSection 15HH does not apply to a person’s conduct that is, or could\nhave been, authorised under a Commonwealth law or a law of a\nState or Territory relating to the following:\n\n(a) arrest or detention of individuals;\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hi-norm"
        },
        {
