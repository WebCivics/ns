    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-149",
      "@type": "cml:Concept",
      "skos:prefLabel": "149 Court may confirm pecuniary penalty order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-149"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.46",
      "values:originalText": "The court may confirm the *pecuniary penalty order if the court is\nsatisfied that, when the *DPP applied for the order, the court could\nhave made the order without relying on the person’s conviction\nthat was *quashed.",
      "skos:definition": "The court may confirm the *pecuniary penalty order if the court is\nsatisfied that, when the *DPP applied for the order, the court could\nhave made the order without relying on the person’s conviction\nthat was *quashed.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-149-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-149-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "35d09728d62440152d8787fcfbafd080f872343d515ca673382e140889b2d500",
      "skos:note": "Court may confirm pecuniary penalty order if satisfied"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-149",
      "@type": "cof:Section",
      "cof:title": "149 Court may confirm pecuniary penalty order",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "The court may confirm the *pecuniary penalty order if the court is\nsatisfied that, when the *DPP applied for the order, the court could\nhave made the order without relying on the person’s conviction\nthat was *quashed."
    },
