      },
      "cml:premiseText": "Exclusion must occur before the report is laid before Parliament.",
      "cml:conclusionText": "Temporal relationship established."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ld-ss-3",
