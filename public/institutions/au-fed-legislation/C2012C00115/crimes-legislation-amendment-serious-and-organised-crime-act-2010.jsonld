    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-66",
      "@type": "cml:Concept",
      "skos:prefLabel": "66 At the end of subsection 223(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-66"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.52",
      "values:originalText": "Add:\n\n; (e) a person who is or forms part of an authority with one or\nmore functions under this Act for the purpose of facilitating\nthe authority’s performance of its functions under this Act;\n\n(f) a person who is or forms part of an authority of the\nCommonwealth, or of a State, Territory or foreign country,\nthat has a function of investigating or prosecuting crimes\nagainst a law of the Commonwealth, State, Territory or\ncountry for the purpose of assisting in the prevention,\ninvestigation or prosecution of a crime against that law;\n\n(g) a person in the Australian Taxation Office for the purpose of\nprotecting public revenue.",
      "skos:definition": "Add:\n\n; (e) a person who is or forms part of an authority with one or\nmore functions under this Act for the purpose of facilitating\nthe authority’s performance of its functions under this Act;\n\n(f) a person who is or forms part of an authority of the\nCommonwealth, or of a State, Territory or foreign country,\nthat has a function of investigating or prosecuting crimes\nagainst a law of the Commonwealth, State, Territory or\ncountry for the purpose of assisting in the prevention,\ninvestigation or prosecution of a crime against that law;\n\n(g) a person in the Australian Taxation Office for the purpose of\nprotecting public revenue.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-66-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-66-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "011602deca3c1836a157b269a472f0e8c109406e511ca0a8ca670d1de3f0c453",
      "skos:note": "List of persons with functions under the Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-66",
      "@type": "cof:Section",
      "cof:title": "66 At the end of subsection 223(4)",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Add:\n\n; (e) a person who is or forms part of an authority with one or\nmore functions under this Act for the purpose of facilitating\nthe authority’s performance of its functions under this Act;\n\n(f) a person who is or forms part of an authority of the\nCommonwealth, or of a State, Territory or foreign country,\nthat has a function of investigating or prosecuting crimes\nagainst a law of the Commonwealth, State, Territory or\ncountry for the purpose of assisting in the prevention,\ninvestigation or prosecution of a crime against that law;\n\n(g) a person in the Australian Taxation Office for the purpose of\nprotecting public revenue."
    },
