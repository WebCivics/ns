    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gg-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GG(4) Minister may nominate AAT members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gg-ss-4"
