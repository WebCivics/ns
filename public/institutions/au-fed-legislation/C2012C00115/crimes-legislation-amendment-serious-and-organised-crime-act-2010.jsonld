    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gb",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GB Concurrent operation of State and Territory laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.63",
      "values:originalText": "It is the intention of the Parliament that this Part is not to apply to\nthe exclusion of a law of a State or Territory to the extent that the\nlaw is capable of operating concurrently with this Part.",
      "skos:definition": "It is the intention of the Parliament that this Part is not to apply to\nthe exclusion of a law of a State or Territory to the extent that the\nlaw is capable of operating concurrently with this Part.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gb-norm"
        }
      ],
      "cml:integrityHash": "095a481045f51af36f1b8b8e6a073feffbf5a009b4a3b8c59f372f6b5c187f24",
      "skos:note": "Concurrent operation of State and Territory laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gb",
      "@type": "cof:Section",
      "cof:title": "15GB Concurrent operation of State and Territory laws",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "It is the intention of the Parliament that this Part is not to apply to\nthe exclusion of a law of a State or Territory to the extent that the\nlaw is capable of operating concurrently with this Part."
    },
    {
