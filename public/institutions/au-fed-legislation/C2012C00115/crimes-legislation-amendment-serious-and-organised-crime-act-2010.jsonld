    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-266a",
      "@type": "cml:Concept",
      "skos:prefLabel": "266A Disclosure",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-266a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
