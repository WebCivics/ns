    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kp",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KP Assumed identity may be acquired and used",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.126",
      "values:originalText": "A person may acquire or use an assumed identity if:\n\n(a) the person is an authorised person (other than an authorised\ncivilian) and the acquisition or use is:\n\n(i) in accordance with an authority; and\n\n(ii) in the course of duty; or\n\n(b) the person is an authorised civilian and the acquisition or use\nis in accordance with:\n\n(i) an authority; and\n\n(ii) any direction by the person’s supervisor under the\nauthority.\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "skos:definition": "A person may acquire or use an assumed identity if:\n\n(a) the person is an authorised person (other than an authorised\ncivilian) and the acquisition or use is:\n\n(i) in accordance with an authority; and\n\n(ii) in the course of duty; or\n\n(b) the person is an authorised civilian and the acquisition or use\nis in accordance with:\n\n(i) an authority; and\n\n(ii) any direction by the person’s supervisor under the\nauthority.\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "cml:asserts": [
