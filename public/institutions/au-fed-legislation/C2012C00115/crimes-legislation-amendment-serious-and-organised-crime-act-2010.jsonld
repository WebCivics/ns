        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gp-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GP(4) Application to appropriate authorising officer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gp-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.78",
      "values:originalText": "(4) More than one application for a variation under this section may be\nmade in respect of the same authority. However, if an urgent\nvariation of authority was granted as a result of an application\nunder this section, the next application must be a formal variation\napplication.\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "skos:definition": "(4) More than one application for a variation under this section may be\nmade in respect of the same authority. However, if an urgent\nvariation of authority was granted as a result of an application\nunder this section, the next application must be a formal variation\napplication.\nComLaw Authoritative Act C2012C00115\n\nAmendments relating to controlled operations, assumed identities and witness identity\nprotection  Schedule 3\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "values:partOf": {
