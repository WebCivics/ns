      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Conditional authorization",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Authority to use assumed identity in foreign country is conditional on satisfaction of reasonable necessity."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-116-ss-6-logic-alleninterval-2",
