    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kn",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KN Protection from criminal liability—officers of issuing agencies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kn"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.126",
      "values:originalText": "The chief officer, or an officer, of an issuing agency who does\nsomething that, apart from this section, would be a Commonwealth\noffence or an offence against a law of a State or Territory, is not\ncriminally responsible for the offence if the thing is done to\ncomply with a request under section 15KI or a direction under\nsection 15KL.",
      "skos:definition": "The chief officer, or an officer, of an issuing agency who does\nsomething that, apart from this section, would be a Commonwealth\noffence or an offence against a law of a State or Territory, is not\ncriminally responsible for the offence if the thing is done to\ncomply with a request under section 15KI or a direction under\nsection 15KL.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kn-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kn-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kn-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kn-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kn-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kn-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "d1a96bd73cebd41654d1462876f24377daa68a53d81fea9951c573421a58959c",
      "skos:note": "Request under section 15KI or direction under section 15KL exempts officers from criminal liability."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kn",
      "@type": "cof:Section",
      "cof:title": "15KN Protection from criminal liability—officers of issuing agencies",
      "values:kind": "section",
      "cof:pageNumber": 126,
      "values:originalText": "The chief officer, or an officer, of an issuing agency who does\nsomething that, apart from this section, would be a Commonwealth\noffence or an offence against a law of a State or Territory, is not\ncriminally responsible for the offence if the thing is done to\ncomply with a request under section 15KI or a direction under\nsection 15KL."
    },
