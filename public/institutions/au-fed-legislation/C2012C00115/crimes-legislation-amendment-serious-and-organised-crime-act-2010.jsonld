    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.32",
      "values:originalText": "(b)\na magistrate is satisfied that, unless the order is\nmade, there is a risk that the balance of the account\nwill be reduced so that a person will not be\ndeprived of all or some of the proceeds or\ninstrument.",
      "skos:definition": "(b)\na magistrate is satisfied that, unless the order is\nmade, there is a risk that the balance of the account\nwill be reduced so that a person will not be\ndeprived of all or some of the proceeds or\ninstrument.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-28-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-28-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "711abf27e927d138a36eae157da38186067885f5cf1c4a86c37cb162fe550f27",
      "skos:note": "Magistrate must ensure balance of account is maintained to prevent deprivation of proceeds or instrument."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-28",
      "@type": "cof:Section",
      "cof:title": "28 Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "(b)\na magistrate is satisfied that, unless the order is\nmade, there is a risk that the balance of the account\nwill be reduced so that a person will not be\ndeprived of all or some of the proceeds or\ninstrument."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-28-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
