      ],
      "cml:integrityHash": "09de274859d56a77f48921539b5489663a7d77ad13129c8c7dea06bc09977eb9",
      "skos:note": "Intention to commit an offence is required for guilt."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-4-sec-166-ss-4",
      "@type": "cof:Section",
      "cof:title": "166(4) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "subsection",
      "cof:pageNumber": 170,
      "values:originalText": "(4) For a person to be guilty of an offence because of the operation of\nthis section, the person and at least one other party to the\nagreement must have intended that an offence would be committed\nunder the agreement.\nAgreement may be non-verbal etc."
    },
