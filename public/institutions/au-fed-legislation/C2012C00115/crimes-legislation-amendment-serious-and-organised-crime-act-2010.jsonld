    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kd",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KD Period of authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.121",
      "values:originalText": "(1) An authority for an authorised person (other than an authorised\ncivilian of a kind covered by paragraph 15KC(2)(h)) remains in\nforce until cancelled under section 15KE.\n\n(2) An authority for an authorised civilian of a kind covered by\nparagraph 15KC(2)(h) remains in force until the end of the period\nspecified in the authority in accordance with subparagraph\n15KC(2)(h)(iii), unless the authority is cancelled sooner under\nsection 15KE.",
      "skos:definition": "(1) An authority for an authorised person (other than an authorised\ncivilian of a kind covered by paragraph 15KC(2)(h)) remains in\nforce until cancelled under section 15KE.\n\n(2) An authority for an authorised civilian of a kind covered by\nparagraph 15KC(2)(h) remains in force until the end of the period\nspecified in the authority in accordance with subparagraph\n15KC(2)(h)(iii), unless the authority is cancelled sooner under\nsection 15KE.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kd-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kd-ss-2"
        }
      ],
      "cml:integrityHash": "e3669a2a2ede48e0ae5569ba798aef78c850d83894a880fdc2b9a250bd8198ab"
    },
    {
