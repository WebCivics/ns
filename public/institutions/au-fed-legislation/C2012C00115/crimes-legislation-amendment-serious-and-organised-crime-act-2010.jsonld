    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hs-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HS(5) Inspection of records by the Ombudsman",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hs-ss-5"
      },
      "cml:curationStatus": {
