    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15gs",
      "@type": "cml:Concept",
      "skos:prefLabel": "15GS Form of variation of authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gs"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
