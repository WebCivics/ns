      "@type": "cml:Concept",
      "skos:prefLabel": "148(7) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-148-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
