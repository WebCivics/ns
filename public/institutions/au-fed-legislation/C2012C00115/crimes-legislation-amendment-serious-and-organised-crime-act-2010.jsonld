    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Section 338 (definition of suspect)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.28",
      "values:originalText": "Insert:\nsuspect means:\n\n(a) in relation to a *restraining order (other than a restraining\norder made under section 20A) or a *confiscation order (other\nthan an *unexplained wealth order)—the person who:\n\n(i) has been convicted of; or\n\n(ii) has been *charged with, or is proposed to be charged\nwith; or\n\n(iii) if the order is a restraining order—is suspected of\nhaving committed; or\n\n(iv) if the order is a confiscation order—committed;\n\nthe offence or offences to which the order relates; or\n\n(b) in relation to a restraining order made under section 20A or\nan unexplained wealth order—the person whose *total wealth\nis suspected of exceeding the value of *wealth that was\n*lawfully acquired.",
      "skos:definition": "Insert:\nsuspect means:\n\n(a) in relation to a *restraining order (other than a restraining\norder made under section 20A) or a *confiscation order (other\nthan an *unexplained wealth order)—the person who:\n\n(i) has been convicted of; or\n\n(ii) has been *charged with, or is proposed to be charged\nwith; or\n\n(iii) if the order is a restraining order—is suspected of\nhaving committed; or\n\n(iv) if the order is a confiscation order—committed;\n\nthe offence or offences to which the order relates; or\n\n(b) in relation to a restraining order made under section 20A or\nan unexplained wealth order—the person whose *total wealth\nis suspected of exceeding the value of *wealth that was\n*lawfully acquired.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-38-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-38-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-38-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "3487e4eb90cb0017f6833926c10baf77b04b6437fe0ca4cb2dd820f69672ead9",
      "skos:note": "Defines 'suspect' in relation to restraining orders and confiscation orders."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-38",
      "@type": "cof:Section",
      "cof:title": "38 Section 338 (definition of suspect)",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Insert:\nsuspect means:\n\n(a) in relation to a *restraining order (other than a restraining\norder made under section 20A) or a *confiscation order (other\nthan an *unexplained wealth order)—the person who:\n\n(i) has been convicted of; or\n\n(ii) has been *charged with, or is proposed to be charged\nwith; or\n\n(iii) if the order is a restraining order—is suspected of\nhaving committed; or\n\n(iv) if the order is a confiscation order—committed;\n\nthe offence or offences to which the order relates; or\n\n(b) in relation to a restraining order made under section 20A or\nan unexplained wealth order—the person whose *total wealth\nis suspected of exceeding the value of *wealth that was\n*lawfully acquired."
    },
