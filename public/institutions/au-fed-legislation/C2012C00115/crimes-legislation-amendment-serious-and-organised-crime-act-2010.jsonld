    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-336a",
      "@type": "cml:Concept",
      "skos:prefLabel": "336A Meaning of property or wealth being lawfully acquired",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-336a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.27",
      "values:originalText": "For the purposes of this Act, property or *wealth is lawfully\nacquired only if:\n\n(a) the property or wealth was lawfully acquired; and\n\n(b) the consideration given for the property or wealth was\nlawfully acquired.",
      "skos:definition": "For the purposes of this Act, property or *wealth is lawfully\nacquired only if:\n\n(a) the property or wealth was lawfully acquired; and\n\n(b) the consideration given for the property or wealth was\nlawfully acquired.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-336a-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-336a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "767c48f78aec53cb7fc5eb50d59f68763eef394f5217ecf0d1d37a67a69db084",
      "skos:note": "Property or wealth is lawfully acquired if it was and the consideration for it was."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-336a",
      "@type": "cof:Section",
      "cof:title": "336A Meaning of property or wealth being lawfully acquired",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "For the purposes of this Act, property or *wealth is lawfully\nacquired only if:\n\n(a) the property or wealth was lawfully acquired; and\n\n(b) the consideration given for the property or wealth was\nlawfully acquired."
    },
