    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KQ Protection from criminal liability—authorised persons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.127",
      "values:originalText": "If an authorised person does something that, apart from this\nsection, would be a Commonwealth offence or an offence under a\nlaw of a State or Territory, the person is not criminally responsible\nfor the offence if:\n\n(a) the thing is done in the course of acquiring or using an\nassumed identity in accordance with an authority; and\n\n(b) the thing is done:\n\n(i) in the case of an authorised intelligence officer, an\nauthorised law enforcement officer or an authorised\nforeign officer—in the course of his or her duty; or\n\n(ii) in the case of an authorised civilian—in accordance\nwith any direction by his or her supervisor under the\nauthority; and\n\n(c) doing the thing would not be an offence if the assumed\nidentity were the person’s real identity.",
      "skos:definition": "If an authorised person does something that, apart from this\nsection, would be a Commonwealth offence or an offence under a\nlaw of a State or Territory, the person is not criminally responsible\nfor the offence if:\n\n(a) the thing is done in the course of acquiring or using an\nassumed identity in accordance with an authority; and\n\n(b) the thing is done:\n\n(i) in the case of an authorised intelligence officer, an\nauthorised law enforcement officer or an authorised\nforeign officer—in the course of his or her duty; or\n\n(ii) in the case of an authorised civilian—in accordance\nwith any direction by his or her supervisor under the\nauthority; and\n\n(c) doing the thing would not be an offence if the assumed\nidentity were the person’s real identity.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-argumentation-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kq-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "fa20f7f271b9ddf087d38a30b1d807a974d4ccdeb11e49f539bcbcbe5e160501",
      "skos:note": "Protection from criminal liability for authorised persons performing specific actions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kq",
      "@type": "cof:Section",
      "cof:title": "15KQ Protection from criminal liability—authorised persons",
      "values:kind": "section",
      "cof:pageNumber": 127,
      "values:originalText": "If an authorised person does something that, apart from this\nsection, would be a Commonwealth offence or an offence under a\nlaw of a State or Territory, the person is not criminally responsible\nfor the offence if:\n\n(a) the thing is done in the course of acquiring or using an\nassumed identity in accordance with an authority; and\n\n(b) the thing is done:\n\n(i) in the case of an authorised intelligence officer, an\nauthorised law enforcement officer or an authorised\nforeign officer—in the course of his or her duty; or\n\n(ii) in the case of an authorised civilian—in accordance\nwith any direction by his or her supervisor under the\nauthority; and\n\n(c) doing the thing would not be an offence if the assumed\nidentity were the person’s real identity."
    },
    {
