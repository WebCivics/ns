    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15lg-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15LG(3) Audit of records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15lg-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
