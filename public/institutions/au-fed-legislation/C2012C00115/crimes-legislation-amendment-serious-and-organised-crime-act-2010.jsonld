    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hv-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HV(3) Ombudsman to be given information and access despite other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hv-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
