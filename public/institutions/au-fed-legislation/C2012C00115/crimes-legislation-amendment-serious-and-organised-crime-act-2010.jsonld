        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-18-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "46f1e7f83dd6701397e51e1a7cf82c404dff7b5659902dec48eee41f2b60a577",
      "skos:note": "DPP must give written notice of application to person subject to unexplained wealth order and any person with interest in property.",
      "dc:description": "written notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-18-ss-4",
      "@type": "cof:Section",
      "cof:title": "18(4) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(4) If the *DPP applies for an order under subsection (1) relating to\nparticular property, the DPP must give written notice of the\napplication to:\n\n(a) the person who is subject to the *unexplained wealth order;\nand\n\n(b) any person whom the DPP has reason to believe may have an\n*interest in the property."
    },
