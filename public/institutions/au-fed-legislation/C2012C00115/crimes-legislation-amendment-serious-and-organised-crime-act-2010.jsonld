      "@type": "cml:Concept",
      "skos:prefLabel": "42 Application of amendments of sections 18 and 19",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-42-2"
