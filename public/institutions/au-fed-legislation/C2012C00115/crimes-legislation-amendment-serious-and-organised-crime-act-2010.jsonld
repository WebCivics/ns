      },
      "cml:operator": "must",
      "cml:logicSummary": "Participant must not engage in conduct likely to cause death or serious injury.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the conduct does not involve the participant engaging in any\nconduct that is likely to:\n\n(i) cause the death of, or serious injury to, any person; or\n\n(ii) involve the commission of a sexual offence against any\nperson;",
      "cml:conclusionText": "The participant must not engage."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ha-ss-2-logic-deontic-5",
