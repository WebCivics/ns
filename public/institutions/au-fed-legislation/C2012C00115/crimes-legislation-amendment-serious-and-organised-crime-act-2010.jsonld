    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HN(6) Chief officers’ annual reports to Minister and Ombudsman",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hn-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.100",
      "values:originalText": "(6) If a report relates, in whole or in part, to the work or activities of\nthe ACC under a corresponding State controlled operations law,\nthe Minister must, as soon as practicable after the report is laid\nbefore each House of the Parliament, send a copy of the report to\nthe State or Territory Minister with responsibility for the\ncorresponding State controlled operations law.",
      "skos:definition": "(6) If a report relates, in whole or in part, to the work or activities of\nthe ACC under a corresponding State controlled operations law,\nthe Minister must, as soon as practicable after the report is laid\nbefore each House of the Parliament, send a copy of the report to\nthe State or Territory Minister with responsibility for the\ncorresponding State controlled operations law.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hn"
      },
      "cml:asserts": [
