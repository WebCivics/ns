      },
      "cml:premiseText": "(b) the participant is identified in the authority as a person\nauthorised to engage in controlled conduct for the purposes\nof the controlled operation;",
      "cml:conclusionText": "The participant is authorized."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ha-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
