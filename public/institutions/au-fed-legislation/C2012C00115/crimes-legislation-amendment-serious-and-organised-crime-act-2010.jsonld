      "cml:premiseText": "(2) A person commits an offence if...",
      "cml:conclusionText": "Penalty: Imprisonment for 10 years."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15lc-ss-3",
      "@type": "cml:Concept",
