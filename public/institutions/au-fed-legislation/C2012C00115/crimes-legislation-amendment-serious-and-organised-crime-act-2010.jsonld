    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15md",
      "@type": "cml:Concept",
      "skos:prefLabel": "15MD Application of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15md"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.145",
      "values:originalText": "(1) This Part applies to a proceeding in which an operative is, or may\nbe, required to give evidence obtained as an operative.\n\n(2) To avoid doubt, this Part does not affect the operation of any law in\nrelation to the protection of a person who gives, or intends to give,\nevidence in a proceeding.\n\n(3) To avoid doubt, this Part does not, other than as expressly\nprovided, limit the power of a court to control proceedings in\nrelation to a matter before it.",
      "skos:definition": "(1) This Part applies to a proceeding in which an operative is, or may\nbe, required to give evidence obtained as an operative.\n\n(2) To avoid doubt, this Part does not affect the operation of any law in\nrelation to the protection of a person who gives, or intends to give,\nevidence in a proceeding.\n\n(3) To avoid doubt, this Part does not, other than as expressly\nprovided, limit the power of a court to control proceedings in\nrelation to a matter before it.",
      "cml:hasPart": [
