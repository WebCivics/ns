    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-71",
      "@type": "cml:Concept",
      "skos:prefLabel": "71 Application of amendments of Chapter 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-71"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.56",
      "values:originalText": "The amendments of Chapter 4 of the Proceeds of Crime Act 2002 made\nby this Part apply in relation to costs that:\n\n(a) were incurred by legal aid commissions before, on or after\nthe commencement of the amendments; and\n\n(b) if they were incurred before that commencement, had not\nbeen paid to the commissions before that commencement.\nComLaw Authoritative Act C2012C00115\n\nOther amendments relating to proceeds of crime  Schedule 2\nTechnical amendments  Part 6\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "skos:definition": "The amendments of Chapter 4 of the Proceeds of Crime Act 2002 made\nby this Part apply in relation to costs that:\n\n(a) were incurred by legal aid commissions before, on or after\nthe commencement of the amendments; and\n\n(b) if they were incurred before that commencement, had not\nbeen paid to the commissions before that commencement.\nComLaw Authoritative Act C2012C00115\n\nOther amendments relating to proceeds of crime  Schedule 2\nTechnical amendments  Part 6\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-71-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-71-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-71-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "d62a6abf513e66ada623055b44213b34e3f71d1e2787925d57de87e4ad26e393",
      "skos:note": "Amendments apply to costs incurred before or on commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-71",
      "@type": "cof:Section",
      "cof:title": "71 Application of amendments of Chapter 4",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "The amendments of Chapter 4 of the Proceeds of Crime Act 2002 made\nby this Part apply in relation to costs that:\n\n(a) were incurred by legal aid commissions before, on or after\nthe commencement of the amendments; and\n\n(b) if they were incurred before that commencement, had not\nbeen paid to the commissions before that commencement.\nComLaw Authoritative Act C2012C00115\n\nOther amendments relating to proceeds of crime  Schedule 2\nTechnical amendments  Part 6\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010"
    },
    {
