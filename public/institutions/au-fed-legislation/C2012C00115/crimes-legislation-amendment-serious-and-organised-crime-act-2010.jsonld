    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mm",
      "@type": "cml:Concept",
      "skos:prefLabel": "15MM Disclosure of operative’s identity etc. despite certificate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15mm"
      },
      "cml:curationStatus": {
