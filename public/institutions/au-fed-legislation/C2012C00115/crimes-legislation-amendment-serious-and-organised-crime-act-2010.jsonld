    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ku-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "15KU(3) Effect of being unaware of variation or cancellation of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15ku-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.128",
      "values:originalText": "(3) For the purposes of this section, a person is reckless about the\nexistence of the variation or cancellation of an authority or\nauthorisation if:\n\n(a) the person is aware of a substantial risk that the variation or\ncancellation has happened; and\n\n(b) having regard to the circumstances known to the person, it is\nunjustifiable to take the risk that the authority has not been\nvaried or cancelled.",
      "skos:definition": "(3) For the purposes of this section, a person is reckless about the\nexistence of the variation or cancellation of an authority or\nauthorisation if:\n\n(a) the person is aware of a substantial risk that the variation or\ncancellation has happened; and\n\n(b) having regard to the circumstances known to the person, it is\nunjustifiable to take the risk that the authority has not been\nvaried or cancelled.",
