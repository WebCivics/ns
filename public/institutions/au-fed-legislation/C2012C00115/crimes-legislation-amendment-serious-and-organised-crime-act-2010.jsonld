      "cml:integrityHash": "4ce034b408f7cb0fccb2a31bb6b53a76f92a3537a2b94afb973739d17e23f1f8",
      "skos:note": "Authorising officer may require applicant to provide information."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gp-ss-7",
      "@type": "cof:Section",
      "cof:title": "15GP(7) Application to appropriate authorising officer",
      "values:kind": "subsection",
      "cof:pageNumber": 78,
      "values:originalText": "(7) The authorising officer to whom the application is made may\nrequire the applicant to provide such information concerning the\nproposed variation as is necessary for the authorising officer’s\nproper consideration of the application."
    },
