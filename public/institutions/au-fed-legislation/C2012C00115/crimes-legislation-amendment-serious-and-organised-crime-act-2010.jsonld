    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179d",
      "@type": "cof:Section",
      "cof:title": "179D Notice of revocation of a preliminary unexplained wealth",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "order\n\nIf a *preliminary unexplained wealth order is revoked under\nsection 179C, the *DPP must give written notice of the revocation\nto the applicant for the revocation."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179d-norm",
