        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The authority to use the assumed identity in a foreign country is conditional on satisfaction of reasonable necessity."
    },
