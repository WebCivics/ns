    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-4-sec-166-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "166(8) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-4-sec-166-ss-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.170",
      "values:originalText": "(8) Any special liability provisions that apply to the joint offence apply\nalso for the purposes of determining whether a person is guilty of\nthat offence because of the operation of this section.\nNote:\nThe heading to section 11.3 of the Criminal Code is replaced by the heading\n“Commission by proxy”.",
      "skos:definition": "(8) Any special liability provisions that apply to the joint offence apply\nalso for the purposes of determining whether a person is guilty of\nthat offence because of the operation of this section.\nNote:\nThe heading to section 11.3 of the Criminal Code is replaced by the heading\n“Commission by proxy”.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-4-sec-166"
      },
      "cml:asserts": [
