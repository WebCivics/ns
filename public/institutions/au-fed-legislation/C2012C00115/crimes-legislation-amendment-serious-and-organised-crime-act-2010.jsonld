    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15l",
      "@type": "cml:Concept",
      "skos:prefLabel": "15L Offence for contravening freezing orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.38",
      "values:originalText": "A *financial institution commits an offence if:\n\n(a) the institution allows a withdrawal from an *account with the\ninstitution; and\n\n(b) there is a *freezing order relating to the account; and\n\n(c) allowing the withdrawal contravenes the order.\nPenalty: Imprisonment for 5 years or 300 penalty units or both.",
      "skos:definition": "A *financial institution commits an offence if:\n\n(a) the institution allows a withdrawal from an *account with the\ninstitution; and\n\n(b) there is a *freezing order relating to the account; and\n\n(c) allowing the withdrawal contravenes the order.\nPenalty: Imprisonment for 5 years or 300 penalty units or both.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15l-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "44e7902c092862ea6d19eba5671657afd26af55e91db5364da9c1462292a88d9",
      "skos:note": "Allowing withdrawal from account with freezing order is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15l",
      "@type": "cof:Section",
      "cof:title": "15L Offence for contravening freezing orders",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "A *financial institution commits an offence if:\n\n(a) the institution allows a withdrawal from an *account with the\ninstitution; and\n\n(b) there is a *freezing order relating to the account; and\n\n(c) allowing the withdrawal contravenes the order.\nPenalty: Imprisonment for 5 years or 300 penalty units or both."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15l-norm",
