    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15ld-ss-3",
      "@type": "cof:Section",
      "cof:title": "15LD(3) Reports about authorities for assumed identities etc.—law",
      "values:kind": "subsection",
      "cof:pageNumber": 136,
      "values:originalText": "(3) The Minister must exclude information from the report if satisfied\non the advice of the chief officer of any of the grounds set out in\nsubsection (2) and must cause a copy of the report to be laid before\neach House of the Parliament within 15 sitting days of that House\nafter the day on which the Minister receives the report."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15ld-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
