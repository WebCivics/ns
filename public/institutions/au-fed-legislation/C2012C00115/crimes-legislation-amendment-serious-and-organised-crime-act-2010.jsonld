      "cml:integrityHash": "f27602c2dff38f980f3f64fb77f42da52d9d2d0c8d491923cd69be773ed87bf0",
      "skos:note": "Court control over proceedings is not limited by this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15md-ss-3",
      "@type": "cof:Section",
      "cof:title": "15MD(3) Application of Part",
      "values:kind": "subsection",
      "cof:pageNumber": 145,
      "values:originalText": "(3) To avoid doubt, this Part does not, other than as expressly\nprovided, limit the power of a court to control proceedings in\nrelation to a matter before it."
    },
