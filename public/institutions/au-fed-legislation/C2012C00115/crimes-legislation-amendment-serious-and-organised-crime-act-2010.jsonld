      "cml:integrityHash": "1d677b96d503671301af83c90c4dae06378cd9eebf75e22939de40f7d2bfa473",
      "skos:note": "Authority must appoint an officer to supervise the use of assumed identity."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15kb-ss-3",
      "@type": "cof:Section",
      "cof:title": "15KB(3) Determination of applications",
      "values:kind": "subsection",
      "cof:pageNumber": 118,
      "values:originalText": "(3) If an authority is granted for an authorised civilian, the chief officer\nmust appoint an officer of the law enforcement agency or the\nintelligence agency (as the case may be) to supervise the\nacquisition or use of the assumed identity by the authorised\ncivilian."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15kb-ss-3-norm",
