      "skos:note": "Authorises disclosure of information for certain purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-65",
      "@type": "cof:Section",
      "cof:title": "65 At the end of section 8",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Add:\n\n(2) Chapter 3 also authorises the disclosure, to certain authorities for\ncertain purposes, of information obtained under that Chapter or\ncertain other provisions (see Part 3-6)."
    },
