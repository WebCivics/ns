    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits conduct that contravenes an order.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(11) A person commits an offence if:\n\n(a) an order has been made under subsection (8), (9) or (10); and\n\n(b) the person engages in conduct; and\n\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The conduct is a crime."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Defines the temporal overlap between the crime and the order.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(11) A person commits an offence if:\n\n(a) an order has been made under subsection (8), (9) or (10); and\n\n(b) the person engages in conduct; and\n\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The crime overlaps with the order in time."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:logicSummary": "Defines the repeating nature of the crime.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(11) A person commits an offence if:\n\n(a) an order has been made under subsection (8), (9) or (10); and\n\n(b) the person engages in conduct; and\n\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The crime repeats indefinitely."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-148-ss-11-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes an obligation on individuals to comply with the order.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(11) A person commits an offence if:\n\n(a) an order has been made under subsection (8), (9) or (10); and\n\n(b) the person engages in conduct; and\n\n(c) the conduct contravenes the order.",
      "cml:conclusionText": "The individual is obligated to comply with the order."
    },
    {
