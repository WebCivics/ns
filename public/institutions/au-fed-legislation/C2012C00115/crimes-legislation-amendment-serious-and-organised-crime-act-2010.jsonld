    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179h",
      "@type": "cml:Concept",
      "skos:prefLabel": "179H Effect of property vesting in an insolvency trustee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.18",
      "values:originalText": "In assessing the value of property of a person, property is taken to\ncontinue to be the *person’s property if it vests in any of the\nfollowing:\n\n(a) in relation to a bankruptcy—the trustee of the estate of the\nbankrupt;\n\n(b) in relation to a composition or scheme of arrangement under\nDivision 6 of Part IV of the Bankruptcy Act 1966—the\ntrustee of the composition or scheme of arrangement;\n\n(c) in relation to a personal insolvency agreement under Part X\nof the Bankruptcy Act 1966—the trustee of the agreement;\n\n(d) in relation to the estate of a deceased person in respect of\nwhich an order has been made under Part XI of the\nBankruptcy Act 1966—the trustee of the estate.",
      "skos:definition": "In assessing the value of property of a person, property is taken to\ncontinue to be the *person’s property if it vests in any of the\nfollowing:\n\n(a) in relation to a bankruptcy—the trustee of the estate of the\nbankrupt;\n\n(b) in relation to a composition or scheme of arrangement under\nDivision 6 of Part IV of the Bankruptcy Act 1966—the\ntrustee of the composition or scheme of arrangement;\n\n(c) in relation to a personal insolvency agreement under Part X\nof the Bankruptcy Act 1966—the trustee of the agreement;\n\n(d) in relation to the estate of a deceased person in respect of\nwhich an order has been made under Part XI of the\nBankruptcy Act 1966—the trustee of the estate.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179h-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179h-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1e7bfc7862e1bf3923ffc17c4487c3d74734f922b9937f5f0a299a2990465e61",
      "skos:note": "Property vests in trustee upon insolvency"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-179h",
      "@type": "cof:Section",
      "cof:title": "179H Effect of property vesting in an insolvency trustee",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "In assessing the value of property of a person, property is taken to\ncontinue to be the *person’s property if it vests in any of the\nfollowing:\n\n(a) in relation to a bankruptcy—the trustee of the estate of the\nbankrupt;\n\n(b) in relation to a composition or scheme of arrangement under\nDivision 6 of Part IV of the Bankruptcy Act 1966—the\ntrustee of the composition or scheme of arrangement;\n\n(c) in relation to a personal insolvency agreement under Part X\nof the Bankruptcy Act 1966—the trustee of the agreement;\n\n(d) in relation to the estate of a deceased person in respect of\nwhich an order has been made under Part XI of the\nBankruptcy Act 1966—the trustee of the estate."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-1-sec-179h-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
