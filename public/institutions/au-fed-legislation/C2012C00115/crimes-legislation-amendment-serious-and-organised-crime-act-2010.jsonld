      "cml:integrityHash": "a82d6684923256d4cda669274c617bf704414774634e35921999c8979865b140",
      "skos:note": "Minister must withdraw nomination if AAT member ceases to hold appointment or Minister withdraws nomination."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15gg-ss-3",
      "@type": "cof:Section",
      "cof:title": "15GG(3) Minister may nominate AAT members",
      "values:kind": "subsection",
      "cof:pageNumber": 70,
      "values:originalText": "(3) A nomination ceases to have effect if:\n\n(a) the nominated Tribunal member ceases to hold an\nappointment described in subsection (1); or\n\n(b) the Minister, by writing, withdraws the nomination."
    },
