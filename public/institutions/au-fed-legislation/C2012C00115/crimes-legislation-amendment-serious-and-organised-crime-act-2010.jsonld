      "cml:integrityHash": "d990a85b1e2a8135f1e0f916ec194c61163bae19813c691706523a6171fce6c3",
      "skos:note": "Court may refuse to make order if not in public interest."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-1-sec-12-2-ss-6",
      "@type": "cof:Section",
      "cof:title": "12(6) Crimes Legislation Amendment (Serious and Organised Crime) Act",
      "values:kind": "subsection",
      "cof:pageNumber": 16,
      "values:originalText": "(6) Despite subsection (1), the court may refuse to make an order\nunder that subsection if the court is satisfied that it is not in the\npublic interest to make the order."
    },
