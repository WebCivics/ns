    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Application of amendments of sections 18 and 19",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.44",
      "values:originalText": "The amendments of sections 18 and 19 of the Proceeds of Crime Act\n2002 made by this Part apply in relation to applications made on or after\nthe commencement of the amendments for a restraining order, whether\nthe conduct constituting the offence concerned occurred or occurs\nbefore, on or after that commencement.",
      "skos:definition": "The amendments of sections 18 and 19 of the Proceeds of Crime Act\n2002 made by this Part apply in relation to applications made on or after\nthe commencement of the amendments for a restraining order, whether\nthe conduct constituting the offence concerned occurred or occurs\nbefore, on or after that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15-norm"
        }
      ],
      "cml:integrityHash": "14a5e11a605f892bdbf4fb45ec99dee66a844ab0aa5928e856b36c9860b84adb",
      "skos:note": "Application of amendments for a restraining order"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Application of amendments of sections 18 and 19",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "The amendments of sections 18 and 19 of the Proceeds of Crime Act\n2002 made by this Part apply in relation to applications made on or after\nthe commencement of the amendments for a restraining order, whether\nthe conduct constituting the offence concerned occurred or occurs\nbefore, on or after that commencement."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-15"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Paragraph 47(1)(c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.44",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) the court is satisfied that a person whose conduct or\nsuspected conduct formed the basis of the restraining order\nengaged in conduct constituting one or more *serious\noffences.\nComLaw Authoritative Act C2012C00115\n\nOther amendments relating to proceeds of crime  Schedule 2\nRemoval of 6-year time limit  Part 2\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(c) the court is satisfied that a person whose conduct or\nsuspected conduct formed the basis of the restraining order\nengaged in conduct constituting one or more *serious\noffences.\nComLaw Authoritative Act C2012C00115\n\nOther amendments relating to proceeds of crime  Schedule 2\nRemoval of 6-year time limit  Part 2\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-16-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-2-sec-16-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0add3d2ab679504f7969bee9e2f0c4728782d6f7132ad6deba16c87d0ae200e3",
      "skos:note": "Court must be satisfied that a person engaged in serious offences."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-2-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Paragraph 47(1)(c)",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) the court is satisfied that a person whose conduct or\nsuspected conduct formed the basis of the restraining order\nengaged in conduct constituting one or more *serious\noffences.\nComLaw Authoritative Act C2012C00115\n\nOther amendments relating to proceeds of crime  Schedule 2\nRemoval of 6-year time limit  Part 2\n\nCrimes Legislation Amendment (Serious and Organised Crime) Act 2010"
    },
