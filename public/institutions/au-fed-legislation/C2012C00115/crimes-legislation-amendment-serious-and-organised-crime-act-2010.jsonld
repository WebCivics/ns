      "cml:premiseText": "No witness identity protection certificate for the operative.",
      "cml:conclusionText": "No adverse inferences."
    },
    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15mo-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MustNot",
      "cml:logicSummary": "Court must not draw adverse inferences against defendant or another party.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
