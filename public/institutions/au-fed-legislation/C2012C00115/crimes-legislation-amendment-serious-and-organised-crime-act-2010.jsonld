      "skos:note": "Ombudsman must give information to authority under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-106-ss-3",
      "@type": "cof:Section",
