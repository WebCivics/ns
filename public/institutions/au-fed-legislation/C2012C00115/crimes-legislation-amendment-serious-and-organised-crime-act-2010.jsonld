    {
      "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hr",
      "@type": "cml:Concept",
      "skos:prefLabel": "15HR Appointment of inspecting officers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-serious-and-organised-crime-act-2010#sch-3-sec-15hr"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf"
      },
      "dc:source": "crimes-legislation-amendment-serious-and-organised-crime-act-2010.pdf, p.105",
      "values:originalText": "(1) The Ombudsman may appoint members of the Ombudsman’s staff\nto be inspecting officers for the purposes of this Part.\n\n(2) An appointment under subsection (1) must be in writing.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "skos:definition": "(1) The Ombudsman may appoint members of the Ombudsman’s staff\nto be inspecting officers for the purposes of this Part.\n\n(2) An appointment under subsection (1) must be in writing.\nComLaw Authoritative Act C2012C00115\n\nSchedule 3  Amendments relating to controlled operations, assumed identities and\nwitness identity protection",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-serious-and-organised-crime-act-2010-sch-3-sec-15hr-ss-1"
        },
        {
