    cml:operator "=" ;
    cml:logicSummary "Definition" ;
    cml:premiseText "freezing order means an order that is made under a State or Territory proceeds of crime law and that is of a kind declared by the regulations to be a freezing order for the purposes of this paragraph." ;
    cml:conclusionText "State or Territory proceeds of crime law is a freezing order if it is of a kind declared by the regulations" ;
    cml:executionSurface "modalities::logic::deontic" ;
