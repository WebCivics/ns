    <https://ns.webcivics.net/cml/premiseText> "freezing order is made under a State or Territory proceeds of crime law";
    <https://ns.webcivics.net/cml/conclusionText> "State or Territory proceeds of crime law includes freezing order";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
