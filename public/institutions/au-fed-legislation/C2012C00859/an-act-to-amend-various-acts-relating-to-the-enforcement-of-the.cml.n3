doc:sch-2-sec-209 a cof:Section ;
    cof:title "209 Application of amendments—the International Criminal" ;
    values:kind "section" ;
    values:originalText "Court Act 2002 (1) The amendments of the International Criminal Court Act 2002 made by items 198 to 208 of this Schedule apply as set out in this item. (2) The amendments apply in relation to requests by the ICC (within the meaning of that Act) to the Attorney-General under that Act made before, at or after the commencement of those items. (3) The amendments apply under subitem (2) of this item regardless of whether the conduct giving rise to those requests occurred, or is suspected to have occurred, before, at or after the commencement of those items. International War Crimes Tribunals Act 1995" ;
    cof:pageNumber "36"^^xsd:integer .

concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-210 a cml:Concept ;
    skos:prefLabel "210 Section 4"@en ;
    cml:realizedBy doc:sch-2-sec-210 ;
    values:originalText "Insert: proceeds of crime authority has the same meaning as in the Proceeds of Crime Act 2002. ComLaw Authoritative Act C2012C00859  Proceeds of crime amendments  Schedule 2 Responsible authorities for proceeds of crime: the DPP and the AFP  Part 1  Crimes Legislation Amendment Act (No. 2) 2011          33 Note: Under that Act, the proceeds of crime authority is either the Commissioner of the Australian Federal Police or the Director of Public Prosecutions (see the definition of proceeds of crime authority in section 338 of that Act)." ;
    skos:definition "Insert: proceeds of crime authority has the same meaning as in the Proceeds of Crime Act 2002. ComLaw Authoritative Act C2012C00859  Proceeds of crime amendments  Schedule 2 Responsible authorities for proceeds of crime: the DPP and the AFP  Part 1  Crimes Legislation Amendment Act (No. 2) 2011          33 Note: Under that Act, the proceeds of crime authority is either the Commissioner of the Australian Federal Police or the Director of Public Prosecutions (see the definition of proceeds of crime authority in section 338 of that Act)."@en ;
    cml:integrityHash "5fae416f5d41cba37728de8a391f5c1d344535fdc835ac9d0118e6306cbf2bd2" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Defines the proceeds of crime authority" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf> ;
    dc:source "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.36" ;
