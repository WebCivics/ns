concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-142 a cml:Concept ;
    skos:prefLabel "142 Subsection 5(1)"@en ;
    cml:realizedBy doc:sch-2-sec-142 ;
    values:originalText "Insert: Commonwealth proceeds of crime authority means a proceeds of crime authority within the meaning of the Proceeds of Crime Act 2002. Note: Under that Act, the proceeds of crime authority is either the Commissioner of the Australian Federal Police or the Director of Public Prosecutions (see the definition of proceeds of crime authority in section 338 of that Act). Responsibility can be transferred between these authorities (see section 315B of that Act)." ;
    skos:definition "Insert: Commonwealth proceeds of crime authority means a proceeds of crime authority within the meaning of the Proceeds of Crime Act 2002. Note: Under that Act, the proceeds of crime authority is either the Commissioner of the Australian Federal Police or the Director of Public Prosecutions (see the definition of proceeds of crime authority in section 338 of that Act). Responsibility can be transferred between these authorities (see section 315B of that Act)."@en ;
    cml:integrityHash "e77dd2a406f36ae17187025201daed7ba66f5987ae1079e75505f2bb5db4c179" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Defines Commonwealth proceeds of crime authority" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
