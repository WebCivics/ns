concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-165 a cml:Concept ;
    skos:prefLabel "165 Subsection 79B(3)"@en ;
    cml:realizedBy doc:sch-2-sec-165 ;
    values:originalText "Omit all the words from and including “the person must”, substitute: the person must:  (c) notify the Registry Manager in writing of the proceeds of crime order or forfeiture application; and  (d) give the Registry Manager:  (i) a copy of the notification referred to in paragraph (b) (if the notification is in writing); and  (ii) a copy of the proceeds of crime order or forfeiture application (if the notification is accompanied by a copy of the order or application)." ;
    skos:definition "Omit all the words from and including “the person must”, substitute: the person must:  (c) notify the Registry Manager in writing of the proceeds of crime order or forfeiture application; and  (d) give the Registry Manager:  (i) a copy of the notification referred to in paragraph (b) (if the notification is in writing); and  (ii) a copy of the proceeds of crime order or forfeiture application (if the notification is accompanied by a copy of the order or application)."@en ;
    cml:integrityHash "e52f6e831d6e20161b906c58cdf1305c3f52d37adb70fe865276f8112135ffea" ;
    cof:pageNumber "31"^^xsd:integer ;
