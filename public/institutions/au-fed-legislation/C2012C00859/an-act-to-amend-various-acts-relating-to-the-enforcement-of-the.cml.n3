concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-147 a cml:Concept ;
    skos:prefLabel "147 After subsection 154(6)"@en ;
    cml:realizedBy doc:sch-2-sec-147 ;
    values:originalText "Insert:  (6A) For the purposes of paragraph (6)(a), the application may be made by:  (a) in the case of pending proceedings in relation to a forfeiture order or a pecuniary penalty order under the Proceeds of Crime Act 2002—the Commonwealth proceeds of crime authority that is, or that is proposed to be, the responsible authority for the application for the order under that Act; or  (b) in the case of pending proceedings under a corresponding law—a person who is entitled to apply for an interstate confiscation order under the corresponding law." ;
    skos:definition "Insert:  (6A) For the purposes of paragraph (6)(a), the application may be made by:  (a) in the case of pending proceedings in relation to a forfeiture order or a pecuniary penalty order under the Proceeds of Crime Act 2002—the Commonwealth proceeds of crime authority that is, or that is proposed to be, the responsible authority for the application for the order under that Act; or  (b) in the case of pending proceedings under a corresponding law—a person who is entitled to apply for an interstate confiscation order under the corresponding law."@en ;
    cml:integrityHash "86bff7bf7a1d793842bbb88cac595fd4d24f8008018bb59d7ff2b0534eb4d247" ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Application may be made by certain parties for a forfeiture order or pecuniary penalty order under the Proceeds of Crime Act 2002." ;
    cml:curationStatus cml:Proposed ;
