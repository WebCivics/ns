concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-152 a cml:Concept ;
    skos:prefLabel "152 At the end of subsection 15YU(4)"@en ;
    cml:realizedBy doc:sch-2-sec-152 ;
    values:originalText "Add: Note: Under that Act, the responsible authority is the Commissioner of the Australian Federal Police or the Director of Public Prosecutions (see the definitions of responsible authority and proceeds of crime authority in section 338 of that Act). Responsibility can be transferred between these authorities (see section 315B of that Act)." ;
    skos:definition "Add: Note: Under that Act, the responsible authority is the Commissioner of the Australian Federal Police or the Director of Public Prosecutions (see the definitions of responsible authority and proceeds of crime authority in section 338 of that Act). Responsibility can be transferred between these authorities (see section 315B of that Act)."@en ;
    cml:integrityHash "ce7a0bc2264402dd946ac7d09d1c00966e1e9b06a3d8863329389512e41d1ba4" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Defines responsible authority and responsibility transfer between authorities." ;
