        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Freezing order under the Proceeds of Crime Act 2002 includes freezing order made under State or Territory proceeds of crime law",
      "cml:conclusionText": "State or Territory proceeds of crime law is included in freezing order under the Proceeds of Crime Act 2002"
    },
    {
