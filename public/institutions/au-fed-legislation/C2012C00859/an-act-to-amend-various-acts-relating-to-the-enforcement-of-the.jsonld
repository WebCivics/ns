      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.21",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) the person has given written notice of the application and the\ngrounds for the application to the *enforcement agency\nmentioned in the paragraph of the definition of authorised\nofficer in section 338 that describes the *authorised officer\nwho applied for the freezing order; and",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) the person has given written notice of the application and the\ngrounds for the application to the *enforcement agency\nmentioned in the paragraph of the definition of authorised\nofficer in section 338 that describes the *authorised officer\nwho applied for the freezing order; and",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-115-norm"
        },
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-115-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "14bb7cb98e8fe6e9ada3e42cb8fbea7b4d71caa3d2c48470cf90d8da50cb8904",
      "skos:note": "Written notice must be given to enforcement agency",
      "dc:description": "Notice of application and grounds"
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-115",
