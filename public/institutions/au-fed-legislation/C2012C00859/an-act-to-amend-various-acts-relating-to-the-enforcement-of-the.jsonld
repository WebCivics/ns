      "skos:prefLabel": "149 After subsection 231A(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-149"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
