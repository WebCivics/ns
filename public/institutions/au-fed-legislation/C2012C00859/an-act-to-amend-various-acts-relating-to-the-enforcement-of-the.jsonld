    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-133",
      "@type": "cof:Section",
      "cof:title": "133 At the end of subsection 170(1)",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Add:\nNote:\nA charge is created under section 169 if both a literary proceeds order\nand a restraining order have been made in relation to an indictable\noffence (or related offence)."
    },
