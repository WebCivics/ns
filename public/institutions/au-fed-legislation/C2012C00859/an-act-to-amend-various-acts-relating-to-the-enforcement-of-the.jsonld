        }
      ],
      "cml:integrityHash": "f6ecb7341352c5714f7dcf15607518863ded30a82b2e7358ba87d5a91e9dc5dc",
      "skos:note": "Substitute authority for application under Proceeds of Crime Act 2002"
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-143",
