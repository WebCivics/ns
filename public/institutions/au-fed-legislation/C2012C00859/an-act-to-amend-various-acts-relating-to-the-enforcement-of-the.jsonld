      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.26",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) an application is made for an order under this subsection by a\nperson mentioned in subsection (6A); and",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) an application is made for an order under this subsection by a\nperson mentioned in subsection (6A); and",
