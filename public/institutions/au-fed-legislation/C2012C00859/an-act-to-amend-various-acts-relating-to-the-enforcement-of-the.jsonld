    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-152",
      "@type": "cml:Concept",
      "skos:prefLabel": "152 At the end of subsection 15YU(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-152"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.27",
      "values:originalText": "Add:\nNote:\nUnder that Act, the responsible authority is the Commissioner of the\nAustralian Federal Police or the Director of Public Prosecutions (see\nthe definitions of responsible authority and proceeds of crime\nauthority in section 338 of that Act). Responsibility can be transferred\nbetween these authorities (see section 315B of that Act).",
      "skos:definition": "Add:\nNote:\nUnder that Act, the responsible authority is the Commissioner of the\nAustralian Federal Police or the Director of Public Prosecutions (see\nthe definitions of responsible authority and proceeds of crime\nauthority in section 338 of that Act). Responsibility can be transferred\nbetween these authorities (see section 315B of that Act).",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-152-norm"
        },
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-152-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ce7a0bc2264402dd946ac7d09d1c00966e1e9b06a3d8863329389512e41d1ba4",
      "skos:note": "Defines responsible authority and responsibility transfer between authorities."
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-152",
      "@type": "cof:Section",
      "cof:title": "152 At the end of subsection 15YU(4)",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "Add:\nNote:\nUnder that Act, the responsible authority is the Commissioner of the\nAustralian Federal Police or the Director of Public Prosecutions (see\nthe definitions of responsible authority and proceeds of crime\nauthority in section 338 of that Act). Responsibility can be transferred\nbetween these authorities (see section 315B of that Act)."
    },
    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-152-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-152"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-152-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Establishes responsibility transfer between authorities",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Responsibility can be transferred between these authorities",
      "cml:conclusionText": "Authority transfer"
    },
    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-153",
      "@type": "cml:Concept",
      "skos:prefLabel": "153 Application of amendments—the Crimes Act 1914",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-153"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
