    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-147",
      "@type": "cml:Concept",
      "skos:prefLabel": "147 After subsection 154(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-147"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.26",
      "values:originalText": "Insert:\n\n(6A) For the purposes of paragraph (6)(a), the application may be made\nby:\n\n(a) in the case of pending proceedings in relation to a forfeiture\norder or a pecuniary penalty order under the Proceeds of\nCrime Act 2002—the Commonwealth proceeds of crime\nauthority that is, or that is proposed to be, the responsible\nauthority for the application for the order under that Act; or\n\n(b) in the case of pending proceedings under a corresponding\nlaw—a person who is entitled to apply for an interstate\nconfiscation order under the corresponding law.",
      "skos:definition": "Insert:\n\n(6A) For the purposes of paragraph (6)(a), the application may be made\nby:\n\n(a) in the case of pending proceedings in relation to a forfeiture\norder or a pecuniary penalty order under the Proceeds of\nCrime Act 2002—the Commonwealth proceeds of crime\nauthority that is, or that is proposed to be, the responsible\nauthority for the application for the order under that Act; or\n\n(b) in the case of pending proceedings under a corresponding\nlaw—a person who is entitled to apply for an interstate\nconfiscation order under the corresponding law.",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-147-norm"
        },
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-147-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "86bff7bf7a1d793842bbb88cac595fd4d24f8008018bb59d7ff2b0534eb4d247",
      "skos:note": "Application may be made by certain parties for a forfeiture order or pecuniary penalty order under the Proceeds of Crime Act 2002."
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-147",
      "@type": "cof:Section",
      "cof:title": "147 After subsection 154(6)",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Insert:\n\n(6A) For the purposes of paragraph (6)(a), the application may be made\nby:\n\n(a) in the case of pending proceedings in relation to a forfeiture\norder or a pecuniary penalty order under the Proceeds of\nCrime Act 2002—the Commonwealth proceeds of crime\nauthority that is, or that is proposed to be, the responsible\nauthority for the application for the order under that Act; or\n\n(b) in the case of pending proceedings under a corresponding\nlaw—a person who is entitled to apply for an interstate\nconfiscation order under the corresponding law."
    },
