    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-198",
      "@type": "cof:Section",
      "cof:title": "198 Section 4",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "Insert:\nproceeds of crime authority has the same meaning as in the\nProceeds of Crime Act.\nNote:\nUnder that Act, the proceeds of crime authority is either the\nCommissioner of the Australian Federal Police or the DPP (see the\ndefinition of proceeds of crime authority in section 338 of that Act)."
    },
