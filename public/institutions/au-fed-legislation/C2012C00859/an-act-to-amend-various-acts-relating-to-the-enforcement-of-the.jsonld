      "cml:integrityHash": "d6d45facbaf5cea5f426db63dd4945fc0609045bd70eca12c4eb14aa2300f96e",
      "skos:note": "Notice of transfer is sufficient compliance with a requirement.",
      "dc:description": "Reasonable steps to give notice to the person."
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-315b-ss-3",
      "@type": "cof:Section",
      "cof:title": "315B(3) Transfer of responsibility for principal orders and",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(3) It is sufficient compliance with a requirement under subsection (2)\nto give a person (other than a court) a notice of transfer if the\ntransferee authority takes reasonable steps to give the notice to the\nperson."
    },
