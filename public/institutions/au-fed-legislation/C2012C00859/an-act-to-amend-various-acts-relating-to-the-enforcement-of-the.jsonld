    },
    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-142",
      "@type": "cml:Concept",
      "skos:prefLabel": "142 Subsection 5(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-142"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.25",
      "values:originalText": "Insert:\nCommonwealth proceeds of crime authority means a proceeds of\ncrime authority within the meaning of the Proceeds of Crime Act\n2002.\nNote:\nUnder that Act, the proceeds of crime authority is either the\nCommissioner of the Australian Federal Police or the Director of\nPublic Prosecutions (see the definition of proceeds of crime authority\nin section 338 of that Act). Responsibility can be transferred between\nthese authorities (see section 315B of that Act).",
      "skos:definition": "Insert:\nCommonwealth proceeds of crime authority means a proceeds of\ncrime authority within the meaning of the Proceeds of Crime Act\n2002.\nNote:\nUnder that Act, the proceeds of crime authority is either the\nCommissioner of the Australian Federal Police or the Director of\nPublic Prosecutions (see the definition of proceeds of crime authority\nin section 338 of that Act). Responsibility can be transferred between\nthese authorities (see section 315B of that Act).",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-142-norm"
        },
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-142-logic-deontic-1"
        },
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-142-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "e77dd2a406f36ae17187025201daed7ba66f5987ae1079e75505f2bb5db4c179",
      "skos:note": "Defines Commonwealth proceeds of crime authority"
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-142",
      "@type": "cof:Section",
      "cof:title": "142 Subsection 5(1)",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Insert:\nCommonwealth proceeds of crime authority means a proceeds of\ncrime authority within the meaning of the Proceeds of Crime Act\n2002.\nNote:\nUnder that Act, the proceeds of crime authority is either the\nCommissioner of the Australian Federal Police or the Director of\nPublic Prosecutions (see the definition of proceeds of crime authority\nin section 338 of that Act). Responsibility can be transferred between\nthese authorities (see section 315B of that Act)."
    },
    {
