      },
      "cml:operator": "is",
      "cml:logicSummary": "DPP has a duty.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The DPP is responsible for the application or order.",
      "cml:conclusionText": "The DPP must provide."
    },
    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-6-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Section 338",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-6-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.14",
      "values:originalText": "Insert:\nresponsible authority, in relation to an application for a *principal\norder, or a principal order, or to an application, proceedings,\nfunction, order, power or duty related to, or arising out of, such an\napplication or order, means:\n\n(a) in the case of an application for a principal order:\n\n(i) the *proceeds of crime authority that made the\napplication; or\n\n(ii) if responsibility for the application has been transferred\nunder section 315B—the proceeds of crime authority to\nwhich responsibility has been transferred (or has been\nlatest transferred) under that section; or\n\n(b) in the case of a principal order:\n\n(i) the proceeds of crime authority that made the\napplication for the order; or\n\n(ii) if responsibility for that application, or the order, has\nbeen transferred under section 315B—the proceeds of\ncrime authority to which responsibility has been\ntransferred (or has been latest transferred) under that\nsection.\nNote 1:\nThe proceeds of crime authority is the Commissioner of the Australian\nFederal Police, or the DPP (see the definition of proceeds of crime\nauthority in this section). Either authority may start and conduct\nproceedings under this Act.\nNote 2:\nSection 315B provides that responsibility for an application for a\nprincipal order, or for a principal order, may be transferred between\nthe 2 proceeds of crime authorities.\nComLaw Authoritative Act C2012C00859\n\nProceeds of crime amendments  Schedule 2\nResponsible authorities for proceeds of crime: the DPP and the AFP  Part 1\n\nCrimes Legislation Amendment Act (No. 2) 2011          11",
      "skos:definition": "Insert:\nresponsible authority, in relation to an application for a *principal\norder, or a principal order, or to an application, proceedings,\nfunction, order, power or duty related to, or arising out of, such an\napplication or order, means:\n\n(a) in the case of an application for a principal order:\n\n(i) the *proceeds of crime authority that made the\napplication; or\n\n(ii) if responsibility for the application has been transferred\nunder section 315B—the proceeds of crime authority to\nwhich responsibility has been transferred (or has been\nlatest transferred) under that section; or\n\n(b) in the case of a principal order:\n\n(i) the proceeds of crime authority that made the\napplication for the order; or\n\n(ii) if responsibility for that application, or the order, has\nbeen transferred under section 315B—the proceeds of\ncrime authority to which responsibility has been\ntransferred (or has been latest transferred) under that\nsection.\nNote 1:\nThe proceeds of crime authority is the Commissioner of the Australian\nFederal Police, or the DPP (see the definition of proceeds of crime\nauthority in this section). Either authority may start and conduct\nproceedings under this Act.\nNote 2:\nSection 315B provides that responsibility for an application for a\nprincipal order, or for a principal order, may be transferred between\nthe 2 proceeds of crime authorities.\nComLaw Authoritative Act C2012C00859\n\nProceeds of crime amendments  Schedule 2\nResponsible authorities for proceeds of crime: the DPP and the AFP  Part 1\n\nCrimes Legislation Amendment Act (No. 2) 2011          11",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-6-5-norm"
        },
