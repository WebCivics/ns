      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-4c",
      "@type": "cml:Concept",
      "skos:prefLabel": "4C Meaning of proceeds of crime authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-4c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
