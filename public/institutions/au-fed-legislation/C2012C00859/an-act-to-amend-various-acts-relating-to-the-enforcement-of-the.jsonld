    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Crimes Legislation Amendment Act (No. 2) 2011",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.14",
      "values:originalText": "(a) the Commissioner of the Australian Federal Police; or\n\n(b) the *DPP.\nNote 1:\nSection 69C of the Australian Federal Police Act 1979 provides for\nthe delegation of the functions, powers and duties of the\nCommissioner of the Australian Federal Police under this Act.\nNote 2:\nSection 31 of the Director of Public Prosecutions Act 1983 provides\nfor the delegation of the functions of the DPP.\nNote 3:\nIf an application for a principal order, or a principal order, has already\nbeen made, the proceeds of crime authority responsible for the\napplication or the order is referred to as the responsible authority (see\nthe definition in this section).",
      "skos:definition": "(a) the Commissioner of the Australian Federal Police; or\n\n(b) the *DPP.\nNote 1:\nSection 69C of the Australian Federal Police Act 1979 provides for\nthe delegation of the functions, powers and duties of the\nCommissioner of the Australian Federal Police under this Act.\nNote 2:\nSection 31 of the Director of Public Prosecutions Act 1983 provides\nfor the delegation of the functions of the DPP.\nNote 3:\nIf an application for a principal order, or a principal order, has already\nbeen made, the proceeds of crime authority responsible for the\napplication or the order is referred to as the responsible authority (see\nthe definition in this section).",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-10-norm"
        },
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "597733142c7146ebca681c7d6307321ac99d09686a49049c99787670757693b8",
      "skos:note": "The DPP is responsible for the application or order."
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Crimes Legislation Amendment Act (No. 2) 2011",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "(a) the Commissioner of the Australian Federal Police; or\n\n(b) the *DPP.\nNote 1:\nSection 69C of the Australian Federal Police Act 1979 provides for\nthe delegation of the functions, powers and duties of the\nCommissioner of the Australian Federal Police under this Act.\nNote 2:\nSection 31 of the Director of Public Prosecutions Act 1983 provides\nfor the delegation of the functions of the DPP.\nNote 3:\nIf an application for a principal order, or a principal order, has already\nbeen made, the proceeds of crime authority responsible for the\napplication or the order is referred to as the responsible authority (see\nthe definition in this section)."
    },
