    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-195",
      "@type": "cof:Section",
      "cof:title": "195 Paragraph 25A(2)(a)",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "Omit “Director of Public Prosecutions”, substitute “responsible\nauthority (under that Act) in relation to the proceeding”."
    },
    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-195-norm",
