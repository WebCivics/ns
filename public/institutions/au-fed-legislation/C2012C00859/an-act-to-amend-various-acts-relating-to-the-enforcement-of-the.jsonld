      "@type": "cml:Concept",
      "skos:prefLabel": "115 Paragraph 15Q(2)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-115"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
