      "values:originalText": "Omit all the words from and including “the person must”, substitute:\nthe person must:\n\n(c) notify the Registry Manager in writing of the proceeds of\ncrime order or forfeiture application; and\n\n(d) give the Registry Manager:\n\n(i) a copy of the notification referred to in paragraph (b) (if\nthe notification is in writing); and\n\n(ii) a copy of the proceeds of crime order or forfeiture\napplication (if the notification is accompanied by a copy\nof the order or application).",
      "skos:definition": "Omit all the words from and including “the person must”, substitute:\nthe person must:\n\n(c) notify the Registry Manager in writing of the proceeds of\ncrime order or forfeiture application; and\n\n(d) give the Registry Manager:\n\n(i) a copy of the notification referred to in paragraph (b) (if\nthe notification is in writing); and\n\n(ii) a copy of the proceeds of crime order or forfeiture\napplication (if the notification is accompanied by a copy\nof the order or application).",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-175-norm"
        },
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-175-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e52f6e831d6e20161b906c58cdf1305c3f52d37adb70fe865276f8112135ffea",
      "skos:note": "Notify Registry Manager of proceeds of crime order or forfeiture application",
      "dc:description": "notification, copy of proceeds of crime order or forfeiture application"
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-175",
      "@type": "cof:Section",
      "cof:title": "175 Subsection 90M(3)",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "Omit all the words from and including “the person must”, substitute:\nthe person must:\n\n(c) notify the Registry Manager in writing of the proceeds of\ncrime order or forfeiture application; and\n\n(d) give the Registry Manager:\n\n(i) a copy of the notification referred to in paragraph (b) (if\nthe notification is in writing); and\n\n(ii) a copy of the proceeds of crime order or forfeiture\napplication (if the notification is accompanied by a copy\nof the order or application)."
    },
