      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012C00859\n\nAustralian Commission for Law Enforcement Integrity amendments  Schedule 1\n\nCrimes Legislation Amendment Act (No. 2) 2011          3",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012C00859\n\nAustralian Commission for Law Enforcement Integrity amendments  Schedule 1\n\nCrimes Legislation Amendment Act (No. 2) 2011          3",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-3-2-norm"
        },
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-3-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "a6eb057e8fe04f8608d89c2211f4b47fe8d8bbf24a022637051864841847aa45",
      "skos:note": "Schedules amendment provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2012C00859\n\nAustralian Commission for Law Enforcement Integrity amendments  Schedule 1\n\nCrimes Legislation Amendment Act (No. 2) 2011          3"
    },
