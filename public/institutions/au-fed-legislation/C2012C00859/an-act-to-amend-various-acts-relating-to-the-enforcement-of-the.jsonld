    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Multiple amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.15",
      "values:originalText": "The specified provisions of the Proceeds of Crime Act 2002 listed in\nitems 8 to 30 of this Division are amended by:\n\n(a) omitting “the *DPP” (wherever occurring) and substituting “a\n*proceeds of crime authority”; and\n\n(b) omitting “The *DPP” (wherever occurring) and substituting\n“A *proceeds of crime authority”; and\n\n(c) omitting “the DPP” (wherever occurring) and substituting “a\nproceeds of crime authority”.",
      "skos:definition": "The specified provisions of the Proceeds of Crime Act 2002 listed in\nitems 8 to 30 of this Division are amended by:\n\n(a) omitting “the *DPP” (wherever occurring) and substituting “a\n*proceeds of crime authority”; and\n\n(b) omitting “The *DPP” (wherever occurring) and substituting\n“A *proceeds of crime authority”; and\n\n(c) omitting “the DPP” (wherever occurring) and substituting “a\nproceeds of crime authority”.",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-7-norm"
        }
      ],
      "cml:integrityHash": "9c9391a3ac731440c161da876f0d638b12bee31ec68aa41fb740f7e3cea5d381",
      "skos:note": "Amendments to specified provisions of the Proceeds of Crime Act 2002"
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Multiple amendments",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "The specified provisions of the Proceeds of Crime Act 2002 listed in\nitems 8 to 30 of this Division are amended by:\n\n(a) omitting “the *DPP” (wherever occurring) and substituting “a\n*proceeds of crime authority”; and\n\n(b) omitting “The *DPP” (wherever occurring) and substituting\n“A *proceeds of crime authority”; and\n\n(c) omitting “the DPP” (wherever occurring) and substituting “a\nproceeds of crime authority”."
    },
