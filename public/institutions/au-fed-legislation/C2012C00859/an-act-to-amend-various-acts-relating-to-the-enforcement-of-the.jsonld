    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Multiple amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.16",
      "values:originalText": "The specified provisions of the Proceeds of Crime Act 2002 listed in\nitems 32 to 114 of this Division are amended by:\nComLaw Authoritative Act C2012C00859\n\nProceeds of crime amendments  Schedule 2\nResponsible authorities for proceeds of crime: the DPP and the AFP  Part 1\n\nCrimes Legislation Amendment Act (No. 2) 2011          13\n\n(a) omitting “*DPP” (wherever occurring) and substituting\n“*responsible authority”; and\n\n(b) omitting “DPP” (wherever occurring) and substituting\n“authority”; and\n\n(c) omitting “*DPP’s” (wherever occurring) and substituting\n“*responsible authority’s”.",
      "skos:definition": "The specified provisions of the Proceeds of Crime Act 2002 listed in\nitems 32 to 114 of this Division are amended by:\nComLaw Authoritative Act C2012C00859\n\nProceeds of crime amendments  Schedule 2\nResponsible authorities for proceeds of crime: the DPP and the AFP  Part 1\n\nCrimes Legislation Amendment Act (No. 2) 2011          13\n\n(a) omitting “*DPP” (wherever occurring) and substituting\n“*responsible authority”; and\n\n(b) omitting “DPP” (wherever occurring) and substituting\n“authority”; and\n\n(c) omitting “*DPP’s” (wherever occurring) and substituting\n“*responsible authority’s”.",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-31-norm"
        }
      ],
      "cml:integrityHash": "e08c41a36f147b15d9e701c6c8c166a9df2a8a106a82705bda3b5bf5b60bdbe4",
      "skos:note": "Amendments to Proceeds of Crime Act 2002"
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Multiple amendments",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "The specified provisions of the Proceeds of Crime Act 2002 listed in\nitems 32 to 114 of this Division are amended by:\nComLaw Authoritative Act C2012C00859\n\nProceeds of crime amendments  Schedule 2\nResponsible authorities for proceeds of crime: the DPP and the AFP  Part 1\n\nCrimes Legislation Amendment Act (No. 2) 2011          13\n\n(a) omitting “*DPP” (wherever occurring) and substituting\n“*responsible authority”; and\n\n(b) omitting “DPP” (wherever occurring) and substituting\n“authority”; and\n\n(c) omitting “*DPP’s” (wherever occurring) and substituting\n“*responsible authority’s”."
    },
    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-31-norm",
