    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-139",
      "@type": "cml:Concept",
      "skos:prefLabel": "139 Application of amendments—Divisions 1 to 4 of this",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-139"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf"
      },
      "dc:source": "an-act-to-amend-various-acts-relating-to-the-enforcement-of-the.pdf, p.24",
      "values:originalText": "Schedule\n(1)\nThe amendments of the Proceeds of Crime Act 2002 made by items 3 to\n138 of this Schedule apply as set out in this item.\n(2)\nThe amendments apply in relation to orders (or applications or\nproceedings for orders) under the Proceeds of Crime Act 2002 made or\n(in the case of proceedings) started before, at or after the\ncommencement of those items.\n(3)\nThe amendments apply under subitem (2) of this item regardless of\nwhether the conduct giving rise to those orders (or applications or\nproceedings for orders) occurred, or is suspected to have occurred,\nbefore, at or after the commencement of those items.",
      "skos:definition": "Schedule\n(1)\nThe amendments of the Proceeds of Crime Act 2002 made by items 3 to\n138 of this Schedule apply as set out in this item.\n(2)\nThe amendments apply in relation to orders (or applications or\nproceedings for orders) under the Proceeds of Crime Act 2002 made or\n(in the case of proceedings) started before, at or after the\ncommencement of those items.\n(3)\nThe amendments apply under subitem (2) of this item regardless of\nwhether the conduct giving rise to those orders (or applications or\nproceedings for orders) occurred, or is suspected to have occurred,\nbefore, at or after the commencement of those items.",
      "cml:asserts": [
        {
          "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-139-norm"
        }
      ],
      "cml:integrityHash": "596286530970162bc075b44b0759b93e08b8a1347a6dc9f13782ca260d7f8dfc",
      "skos:note": "Application of amendments—Divisions 1 to 4 of this Schedule"
    },
    {
      "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-139",
      "@type": "cof:Section",
      "cof:title": "139 Application of amendments—Divisions 1 to 4 of this",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "Schedule\n(1)\nThe amendments of the Proceeds of Crime Act 2002 made by items 3 to\n138 of this Schedule apply as set out in this item.\n(2)\nThe amendments apply in relation to orders (or applications or\nproceedings for orders) under the Proceeds of Crime Act 2002 made or\n(in the case of proceedings) started before, at or after the\ncommencement of those items.\n(3)\nThe amendments apply under subitem (2) of this item regardless of\nwhether the conduct giving rise to those orders (or applications or\nproceedings for orders) occurred, or is suspected to have occurred,\nbefore, at or after the commencement of those items."
    },
    {
