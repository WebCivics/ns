    {
      "@id": "concept:an-act-to-amend-various-acts-relating-to-the-enforcement-of-the-sch-2-sec-249",
      "@type": "cml:Concept",
      "skos:prefLabel": "249 Application of amendments—property-tracking",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/an-act-to-amend-various-acts-relating-to-the-enforcement-of-the#sch-2-sec-249"
      },
      "cml:curationStatus": {
