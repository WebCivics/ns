    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The IC review application is made during the period when the agency or Minister has not made a decision under section 54W (decision not to review) or 55K (decision on review)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "the Information Commissioner must deal with the IC review application for review of the deemed decision as if it were an IC review application for the review of the actual decision"
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68-logic-deontic-1",
