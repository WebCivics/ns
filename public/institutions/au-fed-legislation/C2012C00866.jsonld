        "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-148-ss-8-logic-alleninterval-2",
        "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-148-ss-8-logic-ltl-3",
        "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-148-ss-8-logic-deontic-4"
