    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-89a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) This section applies if:  (a) the Information Commissioner gives an implementation notice to a respondent agency; and  (b) the Information Commissioner is satisfied that:  (i) the agency has not responded to the implementation notice within the time specified in the notice; or  (ii) the agency has not taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must comply with the requirement.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(1) This section applies if:  (a) the Information Commissioner gives an implementation notice to a respondent agency; and  (b) the Information Commissioner is satisfied that:  (i) the agency has not responded to the implementation notice within the time specified in the notice; or  (ii) the agency has not taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation."
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-89a-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(ii) the agency has not taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must comply with the requirement.",
