    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must apply for a review within the time limit.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must apply within time limit",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(a) the latest time for applying for an internal review or an IC review in relation to the decision has ended, if the person has not applied for either review;"
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The internal review and IC review proceedings must be concluded.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must conclude internal review and IC review proceedings",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(b) if the person has applied for an internal review in relation to the decision: (i) the internal review is concluded; and (ii) the time for applying for an IC review of the decision on internal review has ended, if the person has not applied for the IC review;"
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The IC review and Federal Court appeal proceedings must be concluded.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must conclude IC review proceedings and Federal Court appeal proceedings",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(c) if the person has applied for an IC review in relation to the decision: (i) proceedings in relation to the IC review are concluded; and (ii) the time for applying to the Tribunal for a review in relation to the decision has ended, if the person has not applied for such a review; or (iii) the time for instituting an appeal to the Federal Court in relation to the IC review has ended (with no appeal instituted), or, if an appeal has been instituted, all proceedings in relation to the appeal have been concluded;"
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Tribunal review proceedings and Federal Court appeal proceedings must be concluded.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must conclude Tribunal review proceedings and Federal Court appeal proceedings",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(d) if the person has applied to the Tribunal for a review in relation to the decision: (i) proceedings in relation to the review are concluded; and (ii) the time for instituting an appeal to the Federal Court in relation to the review by the Tribunal has ended (with no appeal instituted), or, if an appeal has been instituted, all proceedings in relation to the appeal have been concluded."
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must not apply for an IC review after the internal review is concluded.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must not apply for IC review after internal review is concluded",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST NOT",
      "cml:premiseText": "(b) if the person has applied for an internal review in relation to the decision: (i) the internal review is concluded; and (ii) the time for applying for an IC review of the decision on internal review has ended, if the person has not applied for the IC review;"
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must not institute a Federal Court appeal after the IC review is concluded.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must not institute Federal Court appeal after IC review is concluded",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST NOT",
      "cml:premiseText": "(c) if the person has applied for an IC review in relation to the decision: (i) proceedings in relation to the IC review are concluded; and (ii) the time for applying to the Tribunal for a review in relation to the decision has ended, if the person has not applied for such a review; or (iii) the time for instituting an appeal to the Federal Court in relation to the IC review has ended (with no appeal instituted), or, if an appeal has been instituted, all proceedings in relation to the appeal have been concluded;"
    },
