      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(2) For the purposes of this section, the agency or Minister may treat 2 or more requests as a single request if the agency or Minister is satisfied that:"
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-146-logic-cogai-5",
      "@type": "cml:LogicApplication",
