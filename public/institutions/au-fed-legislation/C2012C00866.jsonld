    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-148-ss-7-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The consultation period is until the end of the processing period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
