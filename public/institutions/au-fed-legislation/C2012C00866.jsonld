      "cml:logicSummary": "Agency or Minister must not consider certain factors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MustNot",
      "cml:premiseText": "(3) In deciding whether a practical refusal reason exists, an agency or Minister must not have regard to:"
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-24aa-ss-3-logic-deontic-2",
