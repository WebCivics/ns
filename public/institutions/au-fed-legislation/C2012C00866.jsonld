      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Disregard period and deadline overlap.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The disregarded period overlaps with the 30-day deadline.",
