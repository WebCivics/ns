        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "Information was communicated in confidence by a foreign government or entity."
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-37-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information is inferred to be confidential.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
