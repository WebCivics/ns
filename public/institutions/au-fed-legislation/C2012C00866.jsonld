        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Paragraph 15(5)(b) requires notification."
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-148-ss-8-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Disregard period is not allowed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The agency cannot disregard the period when calculating the deadline.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "Paragraph 15(5)(b) requires notification."
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-148-ss-8-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Disregard period is recurrent.",
      "cml:confidence": {
        "@type": "xsd:decimal",
