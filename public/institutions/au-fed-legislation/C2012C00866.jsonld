      "@type": "cml:Concept",
      "dc:source": "freedom-of-information-amendment-reform-act-2010.pdf, p.152",
      "skos:note": "Disregard a certain period when calculating the 30-day deadline for an agency's decision on an applicant's request.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "148(8) Freedom of Information Amendment (Reform) Act 2010"
      },
      "wasDerivedFrom": "freedom-of-information-amendment-reform-act-2010.pdf",
