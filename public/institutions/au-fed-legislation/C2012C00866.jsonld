        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Paragraph 15(5)(b) mentions a 30-day deadline."
    },
    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-148-ss-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Disregard period does not apply.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Agency has an obligation to notify the applicant within 30 days.",
