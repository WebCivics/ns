    {
      "@id": "concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-37-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The public access date must overlap with the communication date.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
