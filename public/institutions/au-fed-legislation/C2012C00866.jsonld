      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The withdrawal of the request diffuses to the contact person.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
