    cml:modality cml:Deontic ;
    cml:operator "Cannot" ;
    cml:logicSummary "Prohibition on giving decisions before Federal Court of Australia makes a decision." ;
    cml:premiseText "Information Commissioner must not give a decision to which the question is relevant before the Federal Court of Australia makes a decision in relation to the reference." ;
    cml:conclusionText "The Information Commissioner must not give a decision to which the question is relevant before the Federal Court of Australia makes a decision in relation to the reference." ;
    cml:executionSurface "modalities::logic::deontic" ;
