    cml:modality cml:Deontic ;
    cml:operator "Cannot" ;
    cml:logicSummary "Prohibition on proceeding in a manner inconsistent with Federal Court of Australia's opinion." ;
    cml:premiseText "The Information Commissioner must not proceed in a manner, or make a decision, that is inconsistent with the opinion of the Federal Court of Australia on the question." ;
    cml:conclusionText "The Information Commissioner must not proceed in a manner, or make a decision, that is inconsistent with the opinion of the Federal Court of Australia on the question." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

