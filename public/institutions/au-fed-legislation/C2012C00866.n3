    cml:integrityHash "e928bb36910c5ee6bfd7bc81b755347d5453b5bc83e0cc16973c0c1e06b24040" ;
    skos:note "Time limits for applying for reviews of decisions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.22" ;
    cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-norm .
concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-1 .
concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must apply within time limit" ;
    cml:premiseText "(a) the latest time for applying for an internal review or an IC review in relation to the decision has ended, if the person has not applied for either review;" ;
    cml:conclusionText "The person must apply for a review within the time limit." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-2 .
concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must conclude internal review and IC review proceedings" ;
    cml:premiseText "(b) if the person has applied for an internal review in relation to the decision: (i) the internal review is concluded; and (ii) the time for applying for an IC review of the decision on internal review has ended, if the person has not applied for the IC review;" ;
    cml:conclusionText "The internal review and IC review proceedings must be concluded." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-3 .
concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-3 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must conclude IC review proceedings and Federal Court appeal proceedings" ;
    cml:premiseText "(c) if the person has applied for an IC review in relation to the decision: (i) proceedings in relation to the IC review are concluded; and (ii) the time for applying to the Tribunal for a review in relation to the decision has ended, if the person has not applied for such a review; or (iii) the time for instituting an appeal to the Federal Court in relation to the IC review has ended (with no appeal instituted), or, if an appeal has been instituted, all proceedings in relation to the appeal have been concluded;" ;
    cml:conclusionText "The IC review and Federal Court appeal proceedings must be concluded." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-4 .
concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must conclude Tribunal review proceedings and Federal Court appeal proceedings" ;
    cml:premiseText "(d) if the person has applied to the Tribunal for a review in relation to the decision: (i) proceedings in relation to the review are concluded; and (ii) the time for instituting an appeal to the Federal Court in relation to the review by the Tribunal has ended (with no appeal instituted), or, if an appeal has been instituted, all proceedings in relation to the appeal have been concluded." ;
    cml:conclusionText "The Tribunal review proceedings and Federal Court appeal proceedings must be concluded." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-5 .
concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST NOT" ;
    cml:logicSummary "Must not apply for IC review after internal review is concluded" ;
    cml:premiseText "(b) if the person has applied for an internal review in relation to the decision: (i) the internal review is concluded; and (ii) the time for applying for an IC review of the decision on internal review has ended, if the person has not applied for the IC review;" ;
    cml:conclusionText "The person must not apply for an IC review after the internal review is concluded." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-6 .
concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-18-logic-deontic-6 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST NOT" ;
    cml:logicSummary "Must not institute Federal Court appeal after IC review is concluded" ;
    cml:premiseText "(c) if the person has applied for an IC review in relation to the decision: (i) proceedings in relation to the IC review are concluded; and (ii) the time for applying to the Tribunal for a review in relation to the decision has ended, if the person has not applied for such a review; or (iii) the time for instituting an appeal to the Federal Court in relation to the IC review has ended (with no appeal instituted), or, if an appeal has been instituted, all proceedings in relation to the appeal have been concluded;" ;
    cml:conclusionText "The person must not institute a Federal Court appeal after the IC review is concluded." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


