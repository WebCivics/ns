concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-11c a cml:Concept ;
    skos:prefLabel "11C Publication of information in accessed documents"@en ;
    cml:realizedBy doc:sch-3-sec-11c ;
    values:originalText "Scope  (1) This section applies to information if an agency or Minister gives a person access to a document under section 11A containing the information, except in the case of any of the following:  (a) personal information about any person, if it would be unreasonable to publish the information;  (b) information about the business, commercial, financial or professional affairs of any person, if it would be unreasonable to publish the information; ComLaw Authoritative Act C2012C00866  Schedule 3  Exemptions" ;
    skos:definition "Scope  (1) This section applies to information if an agency or Minister gives a person access to a document under section 11A containing the information, except in the case of any of the following:  (a) personal information about any person, if it would be unreasonable to publish the information;  (b) information about the business, commercial, financial or professional affairs of any person, if it would be unreasonable to publish the information; ComLaw Authoritative Act C2012C00866  Schedule 3  Exemptions"@en ;
    cml:integrityHash "052f68e3128d1f75e30ce189ff6ef06d4d21cb1f4bcaa733262cd8b52d3c621c" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Publication of personal or business information is exempt from access under section 11A." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.25" ;
    cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-11c-norm .
