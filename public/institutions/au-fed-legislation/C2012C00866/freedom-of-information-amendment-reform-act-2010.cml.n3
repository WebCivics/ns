    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.107" .
doc:sch-4-sec-78-2 a cof:Section ;
