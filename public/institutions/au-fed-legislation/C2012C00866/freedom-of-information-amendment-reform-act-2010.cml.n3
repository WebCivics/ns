concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-23 a cml:Concept ;
    skos:prefLabel "23 Records etc. of Office of the Privacy Commissioner"@en ;
    cml:realizedBy doc:sch-7-sec-23 ;
    values:originalText "All records or documents held, immediately before the commencement day, for the purposes of the performance of the functions, or the exercise of the powers, of the Privacy Commissioner, are, on and after the commencement day, taken to be held for the purposes of the performance of the functions, or the exercise of the powers, of the Information Commissioner." ;
    skos:definition "All records or documents held, immediately before the commencement day, for the purposes of the performance of the functions, or the exercise of the powers, of the Privacy Commissioner, are, on and after the commencement day, taken to be held for the purposes of the performance of the functions, or the exercise of the powers, of the Information Commissioner."@en ;
    cml:integrityHash "901c19891e1c3fa6bf661f1f143070709aae75668645d16b630753bce1f8312f" ;
    cof:pageNumber "172"^^xsd:integer ;
    skos:note "Conditional commencement of records for Information Commissioner" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
