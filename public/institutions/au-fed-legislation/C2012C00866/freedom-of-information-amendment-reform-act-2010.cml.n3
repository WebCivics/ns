concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55da a cml:Concept ;
    skos:prefLabel "55DA Decision-maker must assist Information Commissioner"@en ;
    cml:realizedBy doc:sch-4-sec-55da ;
    values:originalText "In an IC review, the agency or Minister who made the IC reviewable decision must use the agency’s or the Minister’s best endeavours to assist the Information Commissioner to make his or her decision in relation to the IC review." ;
    skos:definition "In an IC review, the agency or Minister who made the IC reviewable decision must use the agency’s or the Minister’s best endeavours to assist the Information Commissioner to make his or her decision in relation to the IC review."@en ;
    cml:integrityHash "a449435ed145935b56280d7486ef9275b3697b7baa361b89f42963bda47f2679" ;
    cof:pageNumber "76"^^xsd:integer ;
    skos:note "Agency or Minister must assist Information Commissioner in IC review." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.76" ;
    cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55da-norm .
