concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-22 a cml:Concept ;
    skos:prefLabel "22 Conference held, but determination not made, by Privacy"@en ;
    cml:realizedBy doc:sch-7-sec-22 ;
    values:originalText "Commissioner (1) This item applies if:  (a) the Privacy Commissioner held a conference in accordance with section 76 of the Privacy Act 1988; and  (b) before the commencement day, the Privacy Commissioner did not make a determination in accordance with section 79 of that Act in relation to the matters raised at the conference. (2) The Information Commissioner may make a determination in relation to those matters in accordance with section 79 of the Privacy Act 1988 on or after the commencement day. ComLaw Authoritative Act C2012C00866  Schedule 7  Privacy Commissioner transition" ;
    skos:definition "Commissioner (1) This item applies if:  (a) the Privacy Commissioner held a conference in accordance with section 76 of the Privacy Act 1988; and  (b) before the commencement day, the Privacy Commissioner did not make a determination in accordance with section 79 of that Act in relation to the matters raised at the conference. (2) The Information Commissioner may make a determination in relation to those matters in accordance with section 79 of the Privacy Act 1988 on or after the commencement day. ComLaw Authoritative Act C2012C00866  Schedule 7  Privacy Commissioner transition"@en ;
    cml:integrityHash "bcc069105b47e83d38a900cc7669185de2251c51f2e13e7967fda60454cf6aab" ;
    cof:pageNumber "171"^^xsd:integer ;
    skos:note "Determination must be made by Privacy Commissioner after conference." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
