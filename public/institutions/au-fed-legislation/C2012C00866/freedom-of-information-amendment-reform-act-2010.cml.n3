concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-89k-ss-4 a cml:Concept ;
    skos:prefLabel "89K(4) Vexatious applicants—declaration"@en ;
    cml:realizedBy doc:sch-4-sec-89k-ss-4 ;
