concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-76 a cml:Concept ;
    skos:prefLabel "76 Freedom of Information Amendment (Reform) Act 2010"@en ;
    cml:realizedBy doc:sch-4-sec-76 ;
    values:originalText "Providing copy of decision  (6) The Information Commissioner must give a copy of a decision on an IC review to each review party. Copy of decision prima facie evidence  (7) A document is prima facie evidence of a decision on an IC review if:  (a) the document purports to be a copy of the decision; and  (b) the document purports to be certified by, or on behalf of, the Information Commissioner to be a true copy of the decision. Publication requirement  (8) The Information Commissioner must publish a decision on an IC review to members of the public generally." ;
    skos:definition "Providing copy of decision  (6) The Information Commissioner must give a copy of a decision on an IC review to each review party. Copy of decision prima facie evidence  (7) A document is prima facie evidence of a decision on an IC review if:  (a) the document purports to be a copy of the decision; and  (b) the document purports to be certified by, or on behalf of, the Information Commissioner to be a true copy of the decision. Publication requirement  (8) The Information Commissioner must publish a decision on an IC review to members of the public generally."@en ;
    cml:integrityHash "798936db9b03d0d5a44b3942e1765cdb3e625017df9795f3f0a82cc0be02fe41" ;
    cof:pageNumber "80"^^xsd:integer ;
    cml:hasPart concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-76-ss-6 ;
    cml:hasPart concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-76-ss-7 ;
    cml:hasPart concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-76-ss-8 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.80" .
doc:sch-4-sec-76 a cof:Section ;
    cof:title "76 Freedom of Information Amendment (Reform) Act 2010" ;
    values:kind "section" ;
    values:originalText "Providing copy of decision  (6) The Information Commissioner must give a copy of a decision on an IC review to each review party. Copy of decision prima facie evidence  (7) A document is prima facie evidence of a decision on an IC review if:  (a) the document purports to be a copy of the decision; and  (b) the document purports to be certified by, or on behalf of, the Information Commissioner to be a true copy of the decision. Publication requirement  (8) The Information Commissioner must publish a decision on an IC review to members of the public generally." ;
    cof:pageNumber "80"^^xsd:integer .

