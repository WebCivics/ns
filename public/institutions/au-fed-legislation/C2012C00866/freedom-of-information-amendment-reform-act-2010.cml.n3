concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-85 a cml:Concept ;
    skos:prefLabel "85 Information Commissioner investigations—protection from"@en ;
    cml:realizedBy doc:sch-4-sec-85 ;
    values:originalText "liability  (1) This section applies if a person does any of the following in good faith for the purposes of an investigation:  (a) gives information;  (b) produces a document;  (c) answers a question. ComLaw Authoritative Act C2012C00866  Schedule 4  Information Commissioner amendments" ;
    skos:definition "liability  (1) This section applies if a person does any of the following in good faith for the purposes of an investigation:  (a) gives information;  (b) produces a document;  (c) answers a question. ComLaw Authoritative Act C2012C00866  Schedule 4  Information Commissioner amendments"@en ;
    cml:integrityHash "39bb9ef6fd9886191bd6e150fa2428ef92456362425c3670d23559bfbda211aa" ;
    cof:pageNumber "111"^^xsd:integer ;
    skos:note "Protection from liability for good faith provision of information during investigation" ;
    cml:curationStatus cml:Proposed ;
