concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-18 a cml:Concept ;
    skos:prefLabel "18 Substitution of Information Commissioner as a party to"@en ;
    cml:realizedBy doc:sch-7-sec-18 ;
    values:originalText "pending proceedings If any proceedings to which the Privacy Commissioner was a party were pending in any court or tribunal immediately before the commencement day, the Information Commissioner is substituted for the Privacy Commissioner as a party to the proceedings on and after the commencement day." ;
    skos:definition "pending proceedings If any proceedings to which the Privacy Commissioner was a party were pending in any court or tribunal immediately before the commencement day, the Information Commissioner is substituted for the Privacy Commissioner as a party to the proceedings on and after the commencement day."@en ;
    cml:integrityHash "46a64b4078b4fa5f465185f52c9db3e9ee7166f4b25cf27cd500a5ea2ad96a4e" ;
    cof:pageNumber "170"^^xsd:integer ;
    skos:note "Substitution of Information Commissioner as a party to pending proceedings" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.170" ;
    cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-18-norm .
