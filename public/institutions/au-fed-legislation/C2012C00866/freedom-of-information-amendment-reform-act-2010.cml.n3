concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-30-ss-5 a cml:Concept ;
    skos:prefLabel "30(5) Freedom of Information Amendment (Reform) Act 2010"@en ;
    cml:realizedBy doc:sch-3-sec-30-ss-5 ;
    values:originalText "(5) If the agency or Minister decides to give access to the document, the agency or Minister must give written notice of the decision to both of the following:  (a) the person concerned;  (b) the applicant. Access not to be given until review or appeal opportunities have run out" ;
    skos:definition "(5) If the agency or Minister decides to give access to the document, the agency or Minister must give written notice of the decision to both of the following:  (a) the person concerned;  (b) the applicant. Access not to be given until review or appeal opportunities have run out"@en ;
    cml:integrityHash "18971d655c31d11126074d3e1979abf8f11a7d8be14a07cb442ba9dbd647d111" ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-30 ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "Written notice must be given to the person concerned and the applicant before access is granted." ;
    dc:description "Written notice" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
