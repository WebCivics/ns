doc:sch-7-sec-24 a cof:Section ;
    cof:title "24 Disclosure of private information" ;
    values:kind "section" ;
    values:originalText "Despite the repeal of section 96 of the Privacy Act 1988 by this Act, that section (as in force immediately before the commencement day) continues to apply, in relation to conduct engaged in before the commencement day, as if that section had not been repealed." ;
    cof:pageNumber "172"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-25 a cml:Concept ;
    skos:prefLabel "25 Failure to appear before, or give information to, the"@en ;
    cml:realizedBy doc:sch-7-sec-25 ;
    values:originalText "Privacy Commissioner (1) Subitem (2) applies if:  (a) section 65 or 66 of the Privacy Act 1988 applied to a person before the commencement day in relation to conduct engaged in by the person; and  (b) that provision would not (but for this item) apply to the person on or after the commencement day. (2) That section applies to the person in relation to the conduct on and after the commencement day." ;
    skos:definition "Privacy Commissioner (1) Subitem (2) applies if:  (a) section 65 or 66 of the Privacy Act 1988 applied to a person before the commencement day in relation to conduct engaged in by the person; and  (b) that provision would not (but for this item) apply to the person on or after the commencement day. (2) That section applies to the person in relation to the conduct on and after the commencement day."@en ;
    cml:integrityHash "6eea0f9a854c231729c4ed380b57303842218cba67c56293821027d666e1ab9e" ;
    cof:pageNumber "172"^^xsd:integer ;
    skos:note "Failure to appear before or give information to the Privacy Commissioner is prohibited if a provision of the Privacy Act 1988 applied to the person before the commencement day." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
