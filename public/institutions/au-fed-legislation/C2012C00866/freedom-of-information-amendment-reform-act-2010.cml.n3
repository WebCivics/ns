concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68-logic-alleninterval-2 .
concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Temporal overlap" ;
    cml:premiseText "the Information Commissioner must deal with the IC review application for review of the deemed decision as if it were an IC review application for the review of the actual decision" ;
    cml:conclusionText "The IC review application is made during the period when the agency or Minister has not made a decision under section 54W (decision not to review) or 55K (decision on review)" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68-logic-ltl-3 .
concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "every time" ;
    cml:logicSummary "Recurring action" ;
    cml:premiseText "the Information Commissioner must deal with the IC review application for review of the deemed decision as if it were an IC review application for the review of the actual decision" ;
    cml:conclusionText "The Information Commissioner must deal with every IC review application for review of the actual decision in a similar manner" ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68-logic-deontic-4 .
concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-68-logic-deontic-4 a cml:LogicApplication ;
