doc:sch-4-sec-55h-ss-5 a cof:Section ;
    cof:title "55H(5) Procedure in IC review—reference of questions of law to" ;
    values:kind "subsection" ;
    values:originalText "(5) If a question of law is referred, the Information Commissioner must not, for the purposes of the IC review:  (a) give a decision to which the question is relevant before the Federal Court of Australia makes a decision in relation to the reference; or  (b) proceed in a manner, or make a decision, that is inconsistent with the opinion of the Federal Court of Australia on the question." ;
    cof:pageNumber "78"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55j a cml:Concept ;
    skos:prefLabel "55J Procedure in IC review—sending of documents to, and"@en ;
    cml:realizedBy doc:sch-4-sec-55j ;
    values:originalText "disclosure of documents by, the Federal Court of Australia  If a question of law is referred under section 55H:  (a) the Information Commissioner must cause all documents and information in the possession of the Information ComLaw Authoritative Act C2012C00866  Information Commissioner amendments  Schedule 4 Main amendments  Part 1  Freedom of Information Amendment (Reform) Act 2010          75 Commissioner that relate to the IC review and to the reference to be sent to the Federal Court of Australia; and  (b) at the conclusion of the proceeding before the Federal Court of Australia, the Court must cause the documents to be returned to the Information Commissioner." ;
    skos:definition "disclosure of documents by, the Federal Court of Australia  If a question of law is referred under section 55H:  (a) the Information Commissioner must cause all documents and information in the possession of the Information ComLaw Authoritative Act C2012C00866  Information Commissioner amendments  Schedule 4 Main amendments  Part 1  Freedom of Information Amendment (Reform) Act 2010          75 Commissioner that relate to the IC review and to the reference to be sent to the Federal Court of Australia; and  (b) at the conclusion of the proceeding before the Federal Court of Australia, the Court must cause the documents to be returned to the Information Commissioner."@en ;
    cml:integrityHash "1aba17fcec43b0a7eae19ac229a560b4fe0dd4b958553bb6ce0c8b227545c9e2" ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "Must disclose documents to Federal Court of Australia upon request." ;
    dc:description "Documents and information in possession of the Information Commissioner" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.78" ;
    cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55j-norm .
