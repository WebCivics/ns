concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-15ac-ss-7 a cml:Concept ;
    skos:prefLabel "15AC(7) Decision not made on request within time—deemed refusal"@en ;
    cml:realizedBy doc:sch-6-sec-15ac-ss-7 ;
    values:originalText "(7) Subsection (3) (deemed refusal) does not apply, and is taken never to have applied, if the agency or Minister:  (a) makes a decision on the request within the further time allowed; and  (b) complies with any condition imposed under subsection (6)." ;
    skos:definition "(7) Subsection (3) (deemed refusal) does not apply, and is taken never to have applied, if the agency or Minister:  (a) makes a decision on the request within the further time allowed; and  (b) complies with any condition imposed under subsection (6)."@en ;
    cml:integrityHash "00c53e3ca70bd547d2a9a6c870454bbcbab0e56cba7fda0f91059516f48c8043" ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-15ac ;
    cof:pageNumber "148"^^xsd:integer ;
    skos:note "Agency or Minister may extend time for decision on request." ;
