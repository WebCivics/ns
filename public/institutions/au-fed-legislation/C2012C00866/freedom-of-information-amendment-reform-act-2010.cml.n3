doc:sch-4-sec-55k-ss-3 a cof:Section ;
    cof:title "55K(3) Decision on IC review—decision of Information Commissioner" ;
    values:kind "subsection" ;
    values:originalText "(3) A decision of the Information Commissioner on an IC review has the same effect as a decision of the agency or Minister who made the IC reviewable decision. Content of the decision" ;
    cof:pageNumber "79"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55k-ss-4 a cml:Concept ;
    skos:prefLabel "55K(4) Decision on IC review—decision of Information Commissioner"@en ;
    cml:realizedBy doc:sch-4-sec-55k-ss-4 ;
    values:originalText "(4) A decision on an IC review must include the following:  (a) a statement of reasons for the decision;  (b) a statement of the rights of the review parties to apply to the Tribunal for review of the decision under section 57A." ;
    skos:definition "(4) A decision on an IC review must include the following:  (a) a statement of reasons for the decision;  (b) a statement of the rights of the review parties to apply to the Tribunal for review of the decision under section 57A."@en ;
