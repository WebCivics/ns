concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55y a cml:Concept ;
    skos:prefLabel "55Y Information gathering powers—no loss of legal professional"@en ;
    cml:realizedBy doc:sch-4-sec-55y ;
    values:originalText "privilege  Information or a document does not cease to be the subject of legal professional privilege merely because it is given, provided, produced or referred to for the purposes of this Part." ;
    skos:definition "privilege  Information or a document does not cease to be the subject of legal professional privilege merely because it is given, provided, produced or referred to for the purposes of this Part."@en ;
    cml:integrityHash "cb1cf52984619f9091e5821e953bc7674c7421ed6ed2b0ab467878a5388fe147" ;
    cof:pageNumber "87"^^xsd:integer ;
    skos:note "No loss of legal professional privilege when information is given, produced or referred to for the purposes of this Part." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
