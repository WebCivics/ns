concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-7-2 a cml:Concept ;
    skos:prefLabel "7 Comments sought, but not received, by Privacy"@en ;
    cml:realizedBy doc:sch-7-sec-7-2 ;
    values:originalText "Commissioner (1) This item applies if:  (a) the Privacy Commissioner gave a notice in accordance with a provision of an Act to a person for the purpose of:  (i) seeking the person’s views before making a decision; or  (ii) giving the person an opportunity to be heard before making a decision; and ComLaw Authoritative Act C2012C00866  Schedule 7  Privacy Commissioner transition" ;
    skos:definition "Commissioner (1) This item applies if:  (a) the Privacy Commissioner gave a notice in accordance with a provision of an Act to a person for the purpose of:  (i) seeking the person’s views before making a decision; or  (ii) giving the person an opportunity to be heard before making a decision; and ComLaw Authoritative Act C2012C00866  Schedule 7  Privacy Commissioner transition"@en ;
    cml:integrityHash "8d5f4b7f8f88c6aa58925a115de4ee4b28b62f1a5ebd05b4991040a605f37cc9" ;
    cof:pageNumber "163"^^xsd:integer ;
    skos:note "Commissioner must seek views before making a decision." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
