concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-79-ss-4 a cml:Concept ;
    skos:prefLabel "79(4) Information Commissioner investigations—obliging production"@en ;
    cml:realizedBy doc:sch-4-sec-79-ss-4 ;
    values:originalText "(4) The notice must:  (a) be in writing; and ComLaw Authoritative Act C2012C00866  Information Commissioner amendments  Schedule 4 Main amendments  Part 1  Freedom of Information Amendment (Reform) Act 2010          105  (b) specify the place at which the person must comply with the notice; and  (c) state that the person must comply with the notice:  (i) within a specified period that is not less than 14 days after the day on which the person is given the notice; or  (ii) at a specified time that is not less than 14 days after the time at which the person is given the notice. Offence for failure to comply" ;
    skos:definition "(4) The notice must:  (a) be in writing; and ComLaw Authoritative Act C2012C00866  Information Commissioner amendments  Schedule 4 Main amendments  Part 1  Freedom of Information Amendment (Reform) Act 2010          105  (b) specify the place at which the person must comply with the notice; and  (c) state that the person must comply with the notice:  (i) within a specified period that is not less than 14 days after the day on which the person is given the notice; or  (ii) at a specified time that is not less than 14 days after the time at which the person is given the notice. Offence for failure to comply"@en ;
    cml:integrityHash "059f22c638825c58d7134b0348c42d1947f6cab8a1fd7c34f32a0cfe60d66fae" ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-79 ;
    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Notice must be in writing, specify place and time for compliance." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
