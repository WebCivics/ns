doc:sch-4-sec-54b-ss-2 a cof:Section ;
    cof:title "54B(2) Internal review—application for review" ;
    values:kind "subsection" ;
    values:originalText "(2) A decision by an agency to allow a further period for making an application may be made whether or not the time for making such an application has already expired." ;
    cof:pageNumber "60"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-54b-ss-3 a cml:Concept ;
    skos:prefLabel "54B(3) Internal review—application for review"@en ;
    cml:realizedBy doc:sch-4-sec-54b-ss-3 ;
    values:originalText "(3) The agency’s power to allow a further period for making an application may be exercised by an officer of the agency who is:  (a) acting within the scope of authority exercisable by him or her; and  (b) acting in accordance with arrangements approved by the responsible Minister or principal officer of the agency." ;
    skos:definition "(3) The agency’s power to allow a further period for making an application may be exercised by an officer of the agency who is:  (a) acting within the scope of authority exercisable by him or her; and  (b) acting in accordance with arrangements approved by the responsible Minister or principal officer of the agency."@en ;
