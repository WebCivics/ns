concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-28-2 a cml:Concept ;
    skos:prefLabel "28 Subsection 42(2)"@en ;
    cml:realizedBy doc:sch-3-sec-28-2 ;
    values:originalText "Repeal the subsection, substitute:  (2) A document is not an exempt document because of subsection (1) if the person entitled to claim legal professional privilege in relation to the production of the document in legal proceedings waives that claim.  (3) A document is not an exempt document under subsection (1) by reason only that:  (a) the document contains information that would (apart from this subsection) cause the document to be exempt under subsection (1); and  (b) the information is operational information of an agency. Note: For operational information, see section 8A." ;
    skos:definition "Repeal the subsection, substitute:  (2) A document is not an exempt document because of subsection (1) if the person entitled to claim legal professional privilege in relation to the production of the document in legal proceedings waives that claim.  (3) A document is not an exempt document under subsection (1) by reason only that:  (a) the document contains information that would (apart from this subsection) cause the document to be exempt under subsection (1); and  (b) the information is operational information of an agency. Note: For operational information, see section 8A."@en ;
    cml:integrityHash "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b" ;
    cof:pageNumber "38"^^xsd:integer ;
    cml:hasPart concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-28-2-ss-2 ;
    cml:hasPart concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-28-2-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.38" .
