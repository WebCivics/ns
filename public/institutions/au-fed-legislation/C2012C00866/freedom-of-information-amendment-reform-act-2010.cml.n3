concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-82-2-ss-3-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "right" ;
    cml:logicSummary "Right to comply with requirements." ;
    cml:premiseText "The person is subject to a requirement specified in a notice." ;
    cml:conclusionText "The person commits an offence if they engage in conduct that breaches the requirement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
