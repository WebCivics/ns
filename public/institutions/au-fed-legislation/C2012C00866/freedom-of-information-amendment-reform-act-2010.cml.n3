doc:sch-4-sec-54x-ss-1 a cof:Section ;
    cof:title "54X(1) Decision to review—notice requirement if discretion not to" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if the Information Commissioner decides not to undertake an IC review, or not to continue to undertake an IC review." ;
    cof:pageNumber "71"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-54x-ss-2 a cml:Concept ;
