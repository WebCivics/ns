concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-54y a cml:Concept ;
    skos:prefLabel "54Y Decision to review—actual decisions made after IC review has"@en ;
    cml:realizedBy doc:sch-4-sec-54y ;
    values:originalText "commenced  (1) This section applies if:  (a) an agency or Minister has been taken to have made a decision (the deemed decision) under subsection 15AC(3), 51DA(2) or 54D(2); and ComLaw Authoritative Act C2012C00866  Schedule 4  Information Commissioner amendments" ;
    skos:definition "commenced  (1) This section applies if:  (a) an agency or Minister has been taken to have made a decision (the deemed decision) under subsection 15AC(3), 51DA(2) or 54D(2); and ComLaw Authoritative Act C2012C00866  Schedule 4  Information Commissioner amendments"@en ;
    cml:integrityHash "21b1fc93a2982f374281ab8abce1e2d859ad0a4bd9ac180fcd64cb98b550ac9c" ;
    cof:pageNumber "71"^^xsd:integer ;
    skos:note "Agency or Minister must review actual decisions made after IC review has commenced." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
