concept:freedom-of-information-amendment-reform-act-2010-sch-2-sec-9a a cml:Concept ;
    skos:prefLabel "9A Functions and powers under this Part"@en ;
    cml:realizedBy doc:sch-2-sec-9a ;
    values:originalText "In performing a function, or exercising a power, under this Part, an agency must have regard to:  (a) the objects of this Act (including all the matters set out in sections 3 and 3A); and  (b) guidelines issued by the Information Commissioner for the purposes of this paragraph under section 93A." ;
    skos:definition "In performing a function, or exercising a power, under this Part, an agency must have regard to:  (a) the objects of this Act (including all the matters set out in sections 3 and 3A); and  (b) guidelines issued by the Information Commissioner for the purposes of this paragraph under section 93A."@en ;
    cml:integrityHash "72c6cfbb4f9b8f114891dac87ff7d9538d0ef5fd46d50a9805912864136613c7" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Must have regard to objects of the Act and guidelines issued by the Information Commissioner." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
