concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-56 a cml:Concept ;
    skos:prefLabel "56 Freedom of Information Amendment (Reform) Act 2010"@en ;
    cml:realizedBy doc:sch-4-sec-56 ;
    values:originalText "(2) The affected third party for the document may apply under this Part for the review (the internal review) of the access grant decision. Note: For affected third party, see section 53C." ;
    skos:definition "(2) The affected third party for the document may apply under this Part for the review (the internal review) of the access grant decision. Note: For affected third party, see section 53C."@en ;
    cml:integrityHash "7090c611985c01c349eebe896f0c91160d0bda364f936702bea23411b8a142af" ;
