doc:sch-4-sec-57a-ss-2 a cof:Section ;
    cof:title "57A(2) Tribunal reviewable decisions—which decisions are" ;
    values:kind "subsection" ;
    values:originalText "(2) Despite subsection 29(2) of the Administrative Appeals Tribunal Act 1975, for the purposes of paragraph 29(1)(d) of that Act, the prescribed time for a person to lodge an application for review of an IC reviewable decision mentioned in paragraph (1)(b) of this section is the period: ComLaw Authoritative Act C2012C00866  Schedule 4  Information Commissioner amendments" ;
    cof:pageNumber "93"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-90 a cml:Concept ;
    skos:prefLabel "90 Freedom of Information Amendment (Reform) Act 2010"@en ;
    cml:realizedBy doc:sch-4-sec-90 ;
    values:originalText "(a) starting on the day on which the decision by the Information Commissioner under paragraph 54W(b) of this Act is made; and  (b) ending on the 28th day after the day on which notice of the decision under paragraph 54W(b) was given to the person under section 54X of this Act." ;
    skos:definition "(a) starting on the day on which the decision by the Information Commissioner under paragraph 54W(b) of this Act is made; and  (b) ending on the 28th day after the day on which notice of the decision under paragraph 54W(b) was given to the person under section 54X of this Act."@en ;
