concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-43 a cml:Concept ;
    skos:prefLabel "43 Paragraph 93(3A)(a)"@en ;
    cml:realizedBy doc:sch-6-sec-43 ;
    values:originalText "Repeal the paragraph, substitute:  (a) is:  (i) an exempt document under subparagraph 33(a)(i) of the Freedom of Information Act 1982 (documents affecting national security, defence or international relations); or  (ii) a conditionally exempt document under section 47C of that Act (deliberative processes) to which access would, on balance, be contrary to the public interest for the purposes of subsection 11A(5) of that Act; or" ;
    skos:definition "Repeal the paragraph, substitute:  (a) is:  (i) an exempt document under subparagraph 33(a)(i) of the Freedom of Information Act 1982 (documents affecting national security, defence or international relations); or  (ii) a conditionally exempt document under section 47C of that Act (deliberative processes) to which access would, on balance, be contrary to the public interest for the purposes of subsection 11A(5) of that Act; or"@en ;
    cml:integrityHash "847b39800c55578214f887c574f1dc1c72d1c5d84167a4ef81e37823e354d764" ;
    cof:pageNumber "156"^^xsd:integer ;
    skos:note "Repeal paragraph and substitute with exemptions for national security, defence or international relations documents." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
