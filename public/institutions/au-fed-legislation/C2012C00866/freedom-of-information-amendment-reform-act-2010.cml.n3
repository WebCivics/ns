concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55za a cml:Concept ;
    skos:prefLabel "55ZA Evidence by Inspector-General of Intelligence and Security—"@en ;
    cml:realizedBy doc:sch-4-sec-55za ;
    values:originalText "scope  This Division applies in an IC review of a decision in relation to a document that is claimed to be an exempt document under section 33 (national security documents)." ;
    skos:definition "scope  This Division applies in an IC review of a decision in relation to a document that is claimed to be an exempt document under section 33 (national security documents)."@en ;
    cml:integrityHash "799652fa340f18c8fef6355e51a3802ce9bf3e41f4759a7d483c5ec372202a93" ;
    cof:pageNumber "88"^^xsd:integer ;
    skos:note "Scope of Division" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
