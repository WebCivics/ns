concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-61a-ss-2 a cml:Concept ;
    skos:prefLabel "61A(2) Modification of the Administrative Appeals Tribunal Act 1975"@en ;
    cml:realizedBy doc:sch-4-sec-61a-ss-2 ;
    values:originalText "(2) The agency or Minister who made the IC reviewable decision is taken to have complied with the obligation under paragraph 37(1)(a) of the Administrative Appeals Tribunal Act 1975 if the agency or Minister gives the AAT the number of copies prescribed by the regulations of the decision under section 55K in relation to which an application has been made to the Tribunal." ;
    skos:definition "(2) The agency or Minister who made the IC reviewable decision is taken to have complied with the obligation under paragraph 37(1)(a) of the Administrative Appeals Tribunal Act 1975 if the agency or Minister gives the AAT the number of copies prescribed by the regulations of the decision under section 55K in relation to which an application has been made to the Tribunal."@en ;
    cml:integrityHash "cdd81827c51d7e0ab7128fa7f762704dba0d20dc34161c3523379096bf4e693d" ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-61a ;
    cof:pageNumber "98"^^xsd:integer ;
    skos:note "Agency or Minister must comply with obligation under paragraph 37(1)(a) of the Administrative Appeals Tribunal Act 1975." ;
    cml:curationStatus cml:Proposed ;
