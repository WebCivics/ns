concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-39 a cml:Concept ;
    skos:prefLabel "39 Application—Part 2"@en ;
    cml:realizedBy doc:sch-3-sec-39 ;
    values:originalText "An amendment made by an item in Part 2 applies in relation to requests for access made under section 15 of the Freedom of Information Act 1982 that are received at or after the commencement of that item." ;
