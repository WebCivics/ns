    cml:modality cml:Deontic ;
    cml:operator "CONTINUE" ;
    cml:logicSummary "Continue dealing with complaint" ;
    cml:premiseText "(a) before the commencement of Part 2, a complaint is made to the Ombudsman under the Ombudsman Act 1976; and (b) at the commencement of that Part, the Ombudsman has not informed the complainant of the result of the complaint under section 12 of that Act." ;
    cml:conclusionText "(1)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-4-sec-67 a cof:Section ;
