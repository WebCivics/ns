concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-logic-cogai-4 .
concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-logic-cogai-4 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "if" ;
    cml:logicSummary "Conditional relationship between delegations" ;
    cml:premiseText "Delegation under section 99 continues to have effect on and after the commencement day." ;
    cml:conclusionText "Delegation under section 99 continues to have effect as if it were a delegation under section 25 on and after the commencement day." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-7-sec-26 a cof:Section ;
    cof:title "26 Saving of existing delegations" ;
    values:kind "section" ;
    values:originalText "A delegation in force under section 99 of the Privacy Act 1988 immediately before the commencement day continues to have effect, subject to the new law, as if it were a delegation under section 25 of the new law on and after the commencement day." ;
    cof:pageNumber "172"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-27 a cml:Concept ;
