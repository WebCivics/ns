concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-100 a cml:Concept ;
    skos:prefLabel "100 Freedom of Information Amendment (Reform) Act 2010"@en ;
    cml:realizedBy doc:sch-4-sec-100 ;
    values:originalText "(i) has dealt, or is dealing, adequately with the complaint; or  (ii) has not yet had an adequate opportunity to deal with the complaint;  (e) that the complaint is frivolous, vexatious, misconceived, lacking in substance or not made in good faith;  (f) that the complainant does not have a sufficient interest in the subject matter of the complaint. Note: The Information Commissioner may make a decision under this section to investigate only part of a complaint (see section 71)." ;
    skos:definition "(i) has dealt, or is dealing, adequately with the complaint; or  (ii) has not yet had an adequate opportunity to deal with the complaint;  (e) that the complaint is frivolous, vexatious, misconceived, lacking in substance or not made in good faith;  (f) that the complainant does not have a sufficient interest in the subject matter of the complaint. Note: The Information Commissioner may make a decision under this section to investigate only part of a complaint (see section 71)."@en ;
    cml:integrityHash "0a3954a920d4654ee03d3f9ded78f4b35bc9a29d0cbf9b97d68acabc50718d03" ;
    cof:pageNumber "104"^^xsd:integer ;
    skos:note "Investigation of part of complaint not allowed if complaint is frivolous or vexatious." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.104" ;
