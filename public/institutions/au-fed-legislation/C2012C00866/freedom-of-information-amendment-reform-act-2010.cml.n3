    cof:title "25 Failure to appear before, or give information to, the" ;
    values:kind "section" ;
    values:originalText "Privacy Commissioner (1) Subitem (2) applies if:  (a) section 65 or 66 of the Privacy Act 1988 applied to a person before the commencement day in relation to conduct engaged in by the person; and  (b) that provision would not (but for this item) apply to the person on or after the commencement day. (2) That section applies to the person in relation to the conduct on and after the commencement day." ;
    cof:pageNumber "172"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26 a cml:Concept ;
    skos:prefLabel "26 Saving of existing delegations"@en ;
    cml:realizedBy doc:sch-7-sec-26 ;
    values:originalText "A delegation in force under section 99 of the Privacy Act 1988 immediately before the commencement day continues to have effect, subject to the new law, as if it were a delegation under section 25 of the new law on and after the commencement day." ;
    skos:definition "A delegation in force under section 99 of the Privacy Act 1988 immediately before the commencement day continues to have effect, subject to the new law, as if it were a delegation under section 25 of the new law on and after the commencement day."@en ;
    cml:integrityHash "be1906e93e6df10b0a36cb6935cc272ffd432f929c45ba15476be17d1028ffff" ;
    cof:pageNumber "172"^^xsd:integer ;
    skos:note "Delegations under section 99 of the Privacy Act 1988 continue to have effect under new law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.172" ;
    cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-norm .
