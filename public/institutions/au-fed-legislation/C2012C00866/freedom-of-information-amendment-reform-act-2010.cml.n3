    cml:modality cml:Deontic ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26 ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-logic-alleninterval-1 .
concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-logic-alleninterval-1 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "during" ;
    cml:logicSummary "Temporal relationship between delegations" ;
    cml:premiseText "Delegation under section 99 continues to have effect on and after the commencement day." ;
    cml:conclusionText "Delegation under section 99 continues to have effect as if it were a delegation under section 25 on and after the commencement day." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-logic-ltl-2 .
concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-logic-ltl-2 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "until" ;
    cml:logicSummary "Temporal relationship between delegations" ;
    cml:premiseText "Delegation under section 99 continues to have effect until the commencement day." ;
    cml:conclusionText "Delegation under section 99 does not continue to have effect after the commencement day." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-logic-diffusion-3 .
concept:freedom-of-information-amendment-reform-act-2010-sch-7-sec-26-logic-diffusion-3 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "if" ;
    cml:logicSummary "Conditional relationship between delegations" ;
    cml:premiseText "Delegation under section 99 continues to have effect if it were a delegation under section 25." ;
    cml:conclusionText "Delegation under section 99 continues to have effect as if it were a delegation under section 25." ;
    cml:executionSurface "modalities::diffusion" ;
