concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-79-ss-5 a cml:Concept ;
    skos:prefLabel "79(5) Information Commissioner investigations—obliging production"@en ;
    cml:realizedBy doc:sch-4-sec-79-ss-5 ;
    values:originalText "(5) A person commits an offence if:  (a) the person is subject to a requirement specified in a notice under subsection (3); and  (b) the person engages in conduct; and  (c) the person’s conduct breaches the requirement. Penalty for a contravention of this subsection: Imprisonment for 6 months. Note: Chapter 2 of the Criminal Code sets out the general principles of criminal responsibility." ;
    skos:definition "(5) A person commits an offence if:  (a) the person is subject to a requirement specified in a notice under subsection (3); and  (b) the person engages in conduct; and  (c) the person’s conduct breaches the requirement. Penalty for a contravention of this subsection: Imprisonment for 6 months. Note: Chapter 2 of the Criminal Code sets out the general principles of criminal responsibility."@en ;
    cml:integrityHash "eb1820cc9ba2d084c70161df398e4696e68221b095e59fc98d0214895aa33ec5" ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-79 ;
    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Failure to comply with a notice requirement is an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
