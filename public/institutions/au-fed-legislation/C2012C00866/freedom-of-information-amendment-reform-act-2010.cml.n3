concept:freedom-of-information-amendment-reform-act-2010-sch-2-sec-8e a cml:Concept ;
    skos:prefLabel "8E Information to be published—Information Commissioner to"@en ;
    cml:realizedBy doc:sch-2-sec-8e ;
    values:originalText "assist agencies  The Information Commissioner may provide appropriate assistance to an agency in:  (a) identifying and preparing information which is required or permitted to be published under this Part; and  (b) determining how (and to whom) the information is required or permitted to be published under section 8D." ;
    skos:definition "assist agencies  The Information Commissioner may provide appropriate assistance to an agency in:  (a) identifying and preparing information which is required or permitted to be published under this Part; and  (b) determining how (and to whom) the information is required or permitted to be published under section 8D."@en ;
    cml:integrityHash "31a678164b7626fafb9a3173e8c6d7161d7a0e5f611e7629d92924c779a5a710" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "The Information Commissioner must assist agencies in identifying and preparing required information." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
