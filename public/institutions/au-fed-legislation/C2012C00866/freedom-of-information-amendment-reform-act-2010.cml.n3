doc:sch-4-sec-80-2-ss-2 a cof:Section ;
    cof:title "80(2) Information Commissioner investigations—dealings with" ;
    values:kind "subsection" ;
    values:originalText "(2) During an investigation the Information Commissioner must permit a person to inspect a document that the person would be entitled to inspect if the document were not held by the Information Commissioner. ComLaw Authoritative Act C2012C00866  Schedule 4  Information Commissioner amendments" ;
    cof:pageNumber "109"^^xsd:integer .

