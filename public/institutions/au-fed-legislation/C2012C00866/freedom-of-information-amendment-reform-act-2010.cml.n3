concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-110 a cml:Concept ;
    skos:prefLabel "110 Freedom of Information Amendment (Reform) Act 2010"@en ;
    cml:realizedBy doc:sch-4-sec-110 ;
    values:originalText "Giving implementation notices  (2) The Information Commissioner may, by notice in writing (an implementation notice), require the respondent agency to:  (a) give to the Information Commissioner particulars of any action that the agency proposes to take to implement the investigation recommendations for the investigation; and  (b) give the particulars within the time specified in the notice.  (3) The respondent agency must comply with the implementation notice." ;
    skos:definition "Giving implementation notices  (2) The Information Commissioner may, by notice in writing (an implementation notice), require the respondent agency to:  (a) give to the Information Commissioner particulars of any action that the agency proposes to take to implement the investigation recommendations for the investigation; and  (b) give the particulars within the time specified in the notice.  (3) The respondent agency must comply with the implementation notice."@en ;
    cml:integrityHash "2cdca2c152ebbe5ed3ce86207a8c89a978066c4d7c435ab3eb46a9a9cff18378" ;
    cof:pageNumber "114"^^xsd:integer ;
