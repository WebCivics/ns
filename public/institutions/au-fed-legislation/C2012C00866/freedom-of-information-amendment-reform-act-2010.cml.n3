concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55zb-ss-4 a cml:Concept ;
    skos:prefLabel "55ZB(4) Evidence by Inspector-General of Intelligence and Security—"@en ;
    cml:realizedBy doc:sch-4-sec-55zb-ss-4 ;
    values:originalText "(4) The Information Commissioner is not bound by any opinion of the Inspector-General expressed while giving evidence under this Division." ;
