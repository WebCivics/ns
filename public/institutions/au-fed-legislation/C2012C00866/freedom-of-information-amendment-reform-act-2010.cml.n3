    cml:premiseText "it is possible for the agency or Minister to prepare a copy (an edited copy) of the document, modified by deletions" ;
    cml:conclusionText "access to the edited copy would be required to be given under section 11A" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-22-2 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-22-2-logic-alleninterval-2 .
