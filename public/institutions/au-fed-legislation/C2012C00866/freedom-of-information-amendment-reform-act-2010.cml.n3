    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits making confidential information publicly available." ;
    cml:premiseText "Information was communicated in confidence by a foreign government or entity." ;
    cml:conclusionText "Do not make the information publicly available." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-37 cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-3-sec-37-logic-alleninterval-2 .
