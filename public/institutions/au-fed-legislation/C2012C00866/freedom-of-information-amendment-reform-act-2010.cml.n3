doc:sch-4-sec-89b a cof:Section ;
    cof:title "89B Information Commissioner investigations—requirements for" ;
    values:kind "section" ;
    values:originalText "report  A report under subsection 89A(2) must:  (a) include a copy of the notice given to the respondent agency under subsection 86(2) (notice on completion) and the implementation notice; and  (b) give details of the respondent agency’s response (if any) to the implementation notice; and  (c) state that the Information Commissioner is not satisfied that the agency has taken action that is adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation; and  (d) state the action that the Information Commissioner believes, if taken by the agency, would be adequate and appropriate in the circumstances to implement the investigation recommendations for the investigation." ;
    cof:pageNumber "115"^^xsd:integer .

concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-89c a cml:Concept ;
    skos:prefLabel "89C Information Commissioner investigations—ensuring"@en ;
    cml:realizedBy doc:sch-4-sec-89c ;
    values:originalText "non-disclosure of certain matters  (1) This section applies to the following documents:  (a) a notice to a complainant under section 86 (notice on completion);  (b) a report to the FOI Minister under subsection 89A(3) (failure to take action).  (2) The Information Commissioner must not include in the document:  (a) exempt matter; or  (b) information of the kind referred to in subsection 25(1). ComLaw Authoritative Act C2012C00866  Schedule 4  Information Commissioner amendments" ;
    skos:definition "non-disclosure of certain matters  (1) This section applies to the following documents:  (a) a notice to a complainant under section 86 (notice on completion);  (b) a report to the FOI Minister under subsection 89A(3) (failure to take action).  (2) The Information Commissioner must not include in the document:  (a) exempt matter; or  (b) information of the kind referred to in subsection 25(1). ComLaw Authoritative Act C2012C00866  Schedule 4  Information Commissioner amendments"@en ;
    cml:integrityHash "e2edaeaac723959df7eb3dff6872014f4de4afbb454554cbac29857463e53980" ;
    cof:pageNumber "115"^^xsd:integer ;
    cml:hasPart concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-89c-ss-1 ;
    cml:hasPart concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-89c-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.115" .
