concept:freedom-of-information-amendment-reform-act-2010-sch-5-sec-12-2-ss-4 a cml:Concept ;
    skos:prefLabel "12(4) Guidelines relating to privacy"@en ;
    cml:realizedBy doc:sch-5-sec-12-2-ss-4 ;
    values:originalText "(4) After the end of each financial year, each agency must give the Information Commissioner, and cause to be laid before each House of the Parliament, a report including the matters relating to the data-matching program carried out during the financial year that are specified for the purposes of this subsection in guidelines issued under this section." ;
    skos:definition "(4) After the end of each financial year, each agency must give the Information Commissioner, and cause to be laid before each House of the Parliament, a report including the matters relating to the data-matching program carried out during the financial year that are specified for the purposes of this subsection in guidelines issued under this section."@en ;
    cml:integrityHash "6cf6d0b546256457bc71373b95552798875990592ed848110b3efcd563a92928" ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-5-sec-12-2 ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "Agency must report data-matching program to Information Commissioner and Parliament." ;
    dc:description "Report including specified matters" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
