concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-150 a cml:Concept ;
    skos:prefLabel "150 Freedom of Information Amendment (Reform) Act 2010"@en ;
    cml:realizedBy doc:sch-6-sec-150 ;
    values:originalText "38  Division 1 of Part II of Schedule 2 (after the item relating to the Commonwealth Scientific and Industrial Research Organisation) Insert: Department of Defence, in relation to documents in respect of:  (a) the collection, reporting or analysis of operational intelligence; or  (b) special access programs, under which a foreign government provides restricted access to technologies. 39  Division 1 of Part II of Schedule 2 (the item relating to the Federal Airports Corporation) Repeal the item. ComLaw Authoritative Act C2012C00866  Other amendments  Schedule 6 Application provisions  Part 2  Freedom of Information Amendment (Reform) Act 2010          151" ;
    skos:definition "38  Division 1 of Part II of Schedule 2 (after the item relating to the Commonwealth Scientific and Industrial Research Organisation) Insert: Department of Defence, in relation to documents in respect of:  (a) the collection, reporting or analysis of operational intelligence; or  (b) special access programs, under which a foreign government provides restricted access to technologies. 39  Division 1 of Part II of Schedule 2 (the item relating to the Federal Airports Corporation) Repeal the item. ComLaw Authoritative Act C2012C00866  Other amendments  Schedule 6 Application provisions  Part 2  Freedom of Information Amendment (Reform) Act 2010          151"@en ;
    cml:integrityHash "0c4d6876214992ec6d71b805b1700d8efa21451d66e2daf90ee87cf1460523f8" ;
    cof:pageNumber "154"^^xsd:integer ;
    skos:note "Inserts Department of Defence in relation to documents regarding operational intelligence and special access programs." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <freedom-of-information-amendment-reform-act-2010.pdf> ;
    dc:source "freedom-of-information-amendment-reform-act-2010.pdf, p.154" ;
    cml:asserts concept:freedom-of-information-amendment-reform-act-2010-sch-6-sec-150-norm .
