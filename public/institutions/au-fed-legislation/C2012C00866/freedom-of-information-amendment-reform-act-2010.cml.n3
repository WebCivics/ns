concept:freedom-of-information-amendment-reform-act-2010-sch-5-sec-12-2-ss-6 a cml:Concept ;
    skos:prefLabel "12(6) Guidelines relating to privacy"@en ;
    cml:realizedBy doc:sch-5-sec-12-2-ss-6 ;
    values:originalText "(6) Despite section 12 of the Legislative Instruments Act 2003, guidelines issued under this section take effect from:  (a) the first day on which the guidelines are no longer subject to disallowance; or  (b) if the guidelines make provision for their commencement after that day—in accordance with that provision." ;
    skos:definition "(6) Despite section 12 of the Legislative Instruments Act 2003, guidelines issued under this section take effect from:  (a) the first day on which the guidelines are no longer subject to disallowance; or  (b) if the guidelines make provision for their commencement after that day—in accordance with that provision."@en ;
    cml:integrityHash "da7a82c7a278154aae271ddc8c202e2b615b8c178d3d56e7caedfac5cfbdef8f" ;
    values:partOf concept:freedom-of-information-amendment-reform-act-2010-sch-5-sec-12-2 ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "Guidelines take effect after disallowance ends or in accordance with their commencement provision." ;
    cml:curationStatus cml:Proposed ;
