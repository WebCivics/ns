concept:freedom-of-information-amendment-reform-act-2010-sch-4-sec-55n a cml:Concept ;
    skos:prefLabel "55N Decision on IC review—obligation to comply with decision"@en ;
    cml:realizedBy doc:sch-4-sec-55n ;
    values:originalText "A principal officer of an agency or a Minister must comply with a decision of the Information Commissioner under section 55K on an IC review." ;
    skos:definition "A principal officer of an agency or a Minister must comply with a decision of the Information Commissioner under section 55K on an IC review."@en ;
