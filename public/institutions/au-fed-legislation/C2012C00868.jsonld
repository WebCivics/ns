    {
      "@id": "concept:act-sch-2-sec-36-3-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must not accept payment or other consideration for goods or services with intention to supply different goods or services.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of accepting payment for goods or services with intention to supply different goods or services.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(2) A person must not, in trade or commerce, accept payment or other consideration for goods or services if, at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted."
    },
    {
      "@id": "concept:act-sch-2-sec-36-3-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition on accepting payment for goods or services with intention to supply different goods or services is justified by the requirement that a person must not accept payment or other consideration for goods or services if, at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Justification of the prohibition on accepting payment for goods or services with intention to supply different goods or services.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Justify",
      "cml:premiseText": "(2) A person must not, in trade or commerce, accept payment or other consideration for goods or services if, at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted."
    },
    {
      "@id": "concept:act-sch-2-sec-36-3-ss-2-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If a person accepts payment or other consideration for goods or services with intention to supply different goods or services, then the prohibition on accepting payment for goods or services with intention to supply different goods or services is violated.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Implication of the prohibition on accepting payment for goods or services with intention to supply different goods or services.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Imply",
      "cml:premiseText": "(2) A person must not, in trade or commerce, accept payment or other consideration for goods or services if, at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted."
    },
