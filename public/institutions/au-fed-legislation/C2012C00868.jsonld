    {
      "@id": "concept:act-sch-2-sec-70-2-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "These characteristics overlap with each other.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Characteristics overlap with each other.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlaps",
      "cml:premiseText": "(c) the holding out of the prospect of entitlement to recruitment payments does not give any new participant a legally enforceable right;"
    },
    {
      "@id": "concept:act-sch-2-sec-70-2-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A scheme is a pyramid scheme if it has any or all of these characteristics.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Pyramid scheme characteristics imply obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(a) the participation payments may (or must) be made after the new participants begin to take part in the scheme;"
    },
    {
      "@id": "concept:act-sch-2-sec-70-2-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A scheme is a pyramid scheme if it has any or all of these characteristics.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Characteristics imply obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(d) arrangements for the scheme are not recorded in writing (whether entirely or partly);"
    },
    {
      "@id": "concept:act-sch-2-sec-70-2-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A scheme is a pyramid scheme if it has any or all of these characteristics.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Characteristics imply obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "(e) the scheme involves the marketing of goods or services (or both);"
    },
