    {
      "@id": "concept:act-sch-2-sec-274-2-ss-1",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.257",
      "skos:note": "Manufacturer must indemnify supplier if liable to pay damages under section 259(4) or section 271.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "274(1) Indemnification of suppliers by manufacturers"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
        "concept:act-sch-2-sec-274-2-ss-1-norm",
        "concept:act-sch-2-sec-274-2-ss-1-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "d5819f158723fc7446072b2b30a4ed60fbe89c4f8f8d1dab0cf40ba8d7835cbf",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:act#sch-2-sec-274-2-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:act-sch-2-sec-274-2"
    },
    {
      "@id": "concept:act-sch-2-sec-274-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A manufacturer of goods is liable to indemnify a person (the supplier) who supplies the goods to a consumer if:  (a) the supplier is liable to pay damages under section 259(4) to the consumer for loss or damage suffered by the consumer; and  (b) the manufacturer is or would be liable under section 271 to pay damages to the consumer for the same loss or damage.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Manufacturer has an obligation to indemnify supplier.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) A manufacturer of goods is liable to indemnify a person (the supplier) who supplies the goods to a consumer if:  (a) the supplier is liable to pay damages under section 259(4) to the consumer for loss or damage suffered by the consumer; and  (b) the manufacturer is or would be liable under section 271 to pay damages to the consumer for the same loss or damage."
    },
