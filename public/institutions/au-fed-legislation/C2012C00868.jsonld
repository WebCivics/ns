    {
      "@id": "concept:act-sch-2-sec-45",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.11",
      "skos:note": "Definition of pyramid scheme",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "45 Meaning of pyramid scheme"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": "concept:act-sch-2-sec-45-norm",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:act#sch-2-sec-45",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:act-sch-2-sec-45-2",
      "@type": "cml:Concept",
      "dc:description": "(i) a financial or non-financial benefit to, or for the benefit of, the other participant or participants;",
      "dc:source": "act.pdf, p.75",
      "skos:note": "A pyramid scheme requires new participants to provide a financial or non-financial benefit to other participants.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "45 Meaning of pyramid scheme"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
        "concept:act-sch-2-sec-45-2-norm",
        "concept:act-sch-2-sec-45-2-logic-deontic-1",
        "concept:act-sch-2-sec-45-2-logic-alleninterval-2",
        "concept:act-sch-2-sec-45-2-logic-ltl-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "0f89f50f05f5140abab06b7ac6fdfadc10d43d511a95497508aa83ddf3914165",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:act#sch-2-sec-45-2",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:act-sch-2-sec-45-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(b) the participation payments are entirely or substantially induced by the prospect held out to new participants that they will be entitled, in relation to the introduction to the scheme of further new participants, to be provided with either of the following (a recruitment payment);",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for participation payments.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during"
    },
    {
      "@id": "concept:act-sch-2-sec-45-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(i) a financial or non-financial benefit to, or for the benefit of, the other participant or participants;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requires new participants to provide a financial or non-financial benefit.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires"
    },
    {
      "@id": "concept:act-sch-2-sec-45-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(b) the participation payments are entirely or substantially induced by the prospect held out to new participants that they will be entitled, in relation to the introduction to the scheme of further new participants, to be provided with either of the following (a recruitment payment);",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal interval for participation payments.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "occurs during"
    },
