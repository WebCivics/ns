      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.95",
      "skos:note": "Consumer is not taken to have invited the dealer to come to that place or make a telephone call.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "69(1A) Meaning of unsolicited consumer agreement"
      },
      "wasDerivedFrom": "act.pdf",
