    {
      "@id": "concept:act-sch-2-sec-73-2-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or after 6 pm on any other day (or after 5 pm if the other day is a Saturday).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes the temporal intervals during which a dealer can call on a person for negotiating an unsolicited consumer agreement.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(b) before 9 am on any other day;"
    },
    {
      "@id": "concept:act-sch-2-sec-73-2-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or after 6 pm on any other day (or after 5 pm if the other day is a Saturday).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Recognizes the pattern of hours during which a dealer can call on a person for negotiating an unsolicited consumer agreement.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "(b) before 9 am on any other day;"
    },
    {
      "@id": "concept:act-sch-2-sec-73-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or after 6 pm on any other day (or after 5 pm if the other day is a Saturday).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits calling on a person for negotiating an unsolicited consumer agreement outside certain hours.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) A dealer must not call on a person..."
    },
    {
      "@id": "concept:act-sch-2-sec-73-2-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or after 6 pm on any other day (or after 5 pm if the other day is a Saturday).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Describes the difference between the hours during which a dealer can call on a person for negotiating an unsolicited consumer agreement and the hours during which they cannot.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Differs",
      "cml:premiseText": "(a) at any time on a Sunday or a public holiday;"
    },
    {
      "@id": "concept:act-sch-2-sec-73-2-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...or before 9 am on any other day;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes the recurring pattern of hours during which a dealer can call on a person for negotiating an unsolicited consumer agreement.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "(c) after 6 pm on any other day (or after 5 pm if the other day is a Saturday)."
