    {
      "@id": "concept:act-sch-2-sec-100-2-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The compensation can be recovered within the next year.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for recovery of compensation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(4) The compensation is recoverable in a court of competent jurisdiction."
    },
    {
      "@id": "concept:act-sch-2-sec-100-2-ss-4-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The trade practices amendment implies the recovery of compensation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
