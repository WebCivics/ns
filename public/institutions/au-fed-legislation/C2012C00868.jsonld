        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Failure not within control is excused.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "The person’s failure to supply all the goods or services within the period, or within a reasonable time, was due to the act or omission of another person, or to some other cause beyond the person’s control;"
    },
