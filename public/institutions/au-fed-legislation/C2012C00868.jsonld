      },
      "cml:operator": "Entity Recognition",
      "cml:premiseText": "(1) A person commits an offence if:"
    },
    {
      "@id": "concept:act-sch-2-sec-161-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits sending unsolicited credit or debit cards.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the person sends a credit card or a debit card, or an article that may be used as a credit card and a debit card, to another person;"
    },
    {
      "@id": "concept:act-sch-2-sec-161-2-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person must be sent a card at least once every two years;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Defines the recurring trace for the offence.",
