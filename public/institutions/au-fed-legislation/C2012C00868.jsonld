    {
      "@id": "concept:act-sch-3-sec-12dn-ss-1-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for when the exemption applies",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(1) Sections 12DA, 12DB, 12DC and 12DF do not apply to a publication of matter by an information provider if:"
    },
    {
      "@id": "concept:act-sch-3-sec-12dn-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Type of exemption (Permission)",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(1) Sections 12DA, 12DB, 12DC and 12DF do not apply to a publication of matter by an information provider if:"
    },
    {
      "@id": "concept:act-sch-3-sec-12dn-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Type of exemption (Permission)",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(b) if the information provider is the Australian Broadcasting Corporation, the Special Broadcasting Service Corporation or the holder of a licence granted under the Broadcasting Services Act 1992—the publication was by way of a radio or television broadcast by the information provider."
    },
    {
      "@id": "concept:act-sch-3-sec-12dn-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Type of exemption (Permission)",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(a) in any case—the information provider made the publication in the course of carrying on a business of providing information; or"
    },
    {
      "@id": "concept:act-sch-3-sec-12dn-ss-1-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal interval for when the exemption does not apply",
      "cml:modality": {
        "@id": "cml:LTL"
