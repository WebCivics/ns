      },
      "cml:operator": "includes",
      "cml:premiseText": "(b) a person who holds himself or herself out to the public as the manufacturer of goods;"
    },
    {
      "@id": "concept:act-sch-2-sec-7-2-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The definition includes individuals who cause or permit the application of their name.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Lists the individuals who are considered manufacturers.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "(c) a person who causes or permits the name of the person, a name by which the person carries on business or a brand or mark of the person to be applied to goods supplied by the person;"
    },
    {
      "@id": "concept:act-sch-2-sec-7-2-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The definition includes individuals who cause or permit others to supply goods.",
