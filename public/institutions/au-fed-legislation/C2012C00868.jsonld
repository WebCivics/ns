      },
      "cml:operator": "Entity Recognition",
      "cml:premiseText": "(4) The compensation is recoverable in a court of competent jurisdiction."
    },
    {
      "@id": "concept:act-sch-2-sec-100-2-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The state must provide compensation.",
