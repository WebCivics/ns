      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Manufacturer has an obligation to compensate a person for loss or damage caused by safety defect.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) A manufacturer of goods is liable to compensate a person if..."
    },
    {
      "@id": "concept:act-sch-2-sec-140-3-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the destruction or damage.",
      "cml:confidence": {
