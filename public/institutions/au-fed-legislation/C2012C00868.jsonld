        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Subsection (7) does not apply if the person’s failure to supply all the goods or services within the period, or within a reasonable time, was due to..."
    },
    {
      "@id": "concept:act-sch-2-sec-156-3-ss-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is a duty to take reasonable precautions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
