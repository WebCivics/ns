      "cml:logicSummary": "Prohibits promoting false representations in trade or commerce",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "In connection with the promotion by any means of the supply to another person, or of the use by another person, of goods or services of a kind ordinarily acquired for personal, domestic or household use or consumption;"
    },
    {
      "@id": "concept:act-sch-2-sec-166-2-ss-1-logic-descriptionlogic-2",
