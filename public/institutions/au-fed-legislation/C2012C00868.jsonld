      },
      "realizedBy": "doc:act#sch-2-sec-140f-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:act-sch-2-sec-140f"
    },
    {
      "@id": "concept:act-sch-2-sec-140f-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The duty exceeds the State legislative powers;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between duty and State legislative powers.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlaps",
      "cml:premiseText": "(2) The duty is taken not to be imposed by this Act (or any other law of the Commonwealth)"
    },
    {
      "@id": "concept:act-sch-2-sec-140f-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(a) imposing the duty is within the legislative powers of the State or Territory concerned;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exclusion of duty based on State legislative powers.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "excludes",
      "cml:premiseText": "(2) The duty is taken not to be imposed by this Act (or any other law of the Commonwealth)"
    },
    {
      "@id": "concept:act-sch-2-sec-140f-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(b) imposing the duty by the law of the State or Territory is consistent with the constitutional doctrines restricting the duties that may be imposed on the entity.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exclusion of duty based on State constitutional doctrines.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "excludes",
      "cml:premiseText": "(2) The duty is taken not to be imposed by this Act (or any other law of the Commonwealth)"
    },
    {
      "@id": "concept:act-sch-2-sec-140f-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The duty is within the legislative powers of the State or Territory concerned;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Inclusion of duty within State legislative powers.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "(2) The duty is taken not to be imposed by this Act (or any other law of the Commonwealth)"
    },
    {
      "@id": "concept:act-sch-2-sec-140f-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The duty is consistent with the constitutional doctrines restricting the duties that may be imposed on the entity;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal overlap between duty and State constitutional doctrines.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "overlaps",
      "cml:premiseText": "(2) The duty is taken not to be imposed by this Act (or any other law of the Commonwealth)"
    },
    {
      "@id": "concept:act-sch-2-sec-140f-ss-2-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
