      },
      "realizedBy": "doc:act#sch-3-sec-29-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:act-sch-3-sec-29"
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition applies during the period after which the warning statement must be included.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Describes the timing of the prohibition",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The regulations require a warning statement to be included in documents sent after a certain date."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Sending an invoice or document without a warning statement is prohibited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits the action of sending invoices or documents with false information",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:premiseText": "The regulations require a warning statement to be included in such documents."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Compliance with the regulation requires including a warning statement in such documents.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Describes the requirements for compliance with the regulation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:premiseText": "The regulations require a warning statement to be included in documents sent by a person to another person."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Compliance with the regulation requires authorization from the person placing the advertisement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Describes the authorization required for compliance with the regulation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "authorizes",
      "cml:premiseText": "The regulations require that the person authorizing the placement of an advertisement must also authorize the sending of such documents."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The prohibition applies everywhere, regardless of the context or purpose of the document.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Describes the scope of the prohibition",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:premiseText": "The regulations apply to all documents sent by a person to another person."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-2-norm",
