      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The card is a valid credit or debit card;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
