    {
      "@id": "concept:act-sch-2-sec-140f-ss-2",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.343",
      "skos:note": "Duty is not imposed by this Act to the extent it exceeds State legislative powers.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "140F(2) How duty is imposed"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
