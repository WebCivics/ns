    {
      "@id": "concept:act-sch-2-sec-161-2-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The period begins on the day after the card is sent and ends two years after that day;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal interval for the offence.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(1) A person commits an offence if:"
    },
    {
      "@id": "concept:act-sch-2-sec-161-2-ss-1-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person and the card are the relevant entities;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
