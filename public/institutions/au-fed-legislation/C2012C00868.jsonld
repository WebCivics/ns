        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Consumer has not invited the dealer to come to that place or make a telephone call if the consumer has given their name or contact details for another purpose.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(a) given his or her name or contact details other than for the predominant purpose of entering into negotiations relating to the supply of the goods or services referred to in subsection (1)(c);"
    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1a-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Dealer's attempt to contact the consumer is unsuccessful if the consumer contacts the dealer in connection with an unsuccessful attempt by the dealer to contact the consumer.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Dealer's attempt to contact the consumer is unsuccessful if the consumer contacts the dealer in connection with an unsuccessful attempt by the dealer to contact the consumer.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(b) contacted the dealer in connection with an unsuccessful attempt by the dealer to contact the consumer."
    },
