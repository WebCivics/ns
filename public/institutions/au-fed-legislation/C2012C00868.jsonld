    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1a-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Consumer has not invited the dealer to come to that place or make a telephone call within a certain time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Consumer has not invited the dealer to come to that place or make a telephone call within a certain time frame.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(1A) The consumer is not taken, for the purposes of subsection (1)(c), to have invited the dealer to come to that place, or to make a telephone call."
    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The consumer has not invited the dealer to come to that place or make a telephone call.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Consumer has not invited the dealer to come to that place or make a telephone call.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1A) The consumer is not taken, for the purposes of subsection (1)(c), to have invited the dealer to come to that place, or to make a telephone call."
    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1a-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Consumer has not invited the dealer to come to that place or make a telephone call if the consumer has given their name or contact details for another purpose.",
