      },
      "realizedBy": "doc:act#sch-3-sec-29-ss-5",
      "cml:schemaVersion": "2",
      "partOf": "concept:act-sch-3-sec-29"
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-5-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The time period between the signing of the document and the assertion of payment is relevant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The time period between the signing of the document and the assertion of payment is relevant.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "The right to payment of a charge for the placing of the advertisement is asserted after the person has signed the document."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A document signed by the person or another authorised person is required.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorisation is required.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The person must authorise the placing of the advertisement."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-5-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A copy of the document must be provided before payment is asserted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The person must provide a copy of the document before payment is asserted.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "A copy of the document has not been given to the person."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-5-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A copy of the document must be provided before payment is asserted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "A copy of the document must be provided before payment is asserted.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The person has not signed the document."
    },
    {
      "@id": "concept:act-sch-3-sec-29-ss-5-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The time period between the signing of the document and the assertion of payment is relevant for the person to have authorised it.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The time period between the signing of the document and the assertion of payment is relevant for the person to have authorised it.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "The person has not signed the document before the right to payment of a charge for the placing of the advertisement is asserted."
    },
