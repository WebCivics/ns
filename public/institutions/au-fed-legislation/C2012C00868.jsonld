      },
      "wasDerivedFrom": "act.pdf",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:hasPart": [
        {
          "@id": "concept:act-sch-2-sec-24-3-ss-1"
        },
        {
          "@id": "concept:act-sch-2-sec-24-3-ss-2"
        },
        {
          "@id": "concept:act-sch-2-sec-24-3-ss-3"
        }
      ],
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:act#sch-2-sec-24-3",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:act-sch-2-sec-24-3-ss-1",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.55",
      "skos:note": "A term of a consumer contract is unfair if it causes a significant imbalance in the parties' rights and obligations.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "24(1) Meaning of unfair"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
        "concept:act-sch-2-sec-24-3-ss-1-norm",
        "concept:act-sch-2-sec-24-3-ss-1-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "534c413681b35c79c1f1d76c54424fb48ff46676c9d90e2cc28654b75f0d11fc",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:act#sch-2-sec-24-3-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:act-sch-2-sec-24-3"
    },
    {
      "@id": "concept:act-sch-2-sec-24-3-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The state must ensure fairness in consumer contracts.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a duty on the state to ensure fairness in consumer contracts.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "imposes duty",
      "cml:premiseText": "(1) A term of a consumer contract is unfair if:  (a) it would cause a significant imbalance in the parties’ rights and obligations arising under the contract; and  (b) it is not reasonably necessary in order to protect the legitimate interests of the party who would be advantaged by the term; and  (c) it would cause detriment (whether financial or otherwise) to a party if it were to be applied or relied on."
    },
    {
      "@id": "concept:act-sch-2-sec-24-3-ss-1-norm",
      "@type": "doc:Obligation",
