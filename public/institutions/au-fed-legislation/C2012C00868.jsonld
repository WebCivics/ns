    },
    {
      "@id": "concept:act-sch-2-sec-140g",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.344",
      "skos:note": "Application law imposes a duty on Commonwealth entity if it confers a function or power and gives rise to an obligation.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "140G When an application law imposes a duty"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
        "concept:act-sch-2-sec-140g-norm",
        "concept:act-sch-2-sec-140g-logic-deontic-1",
        "concept:act-sch-2-sec-140g-logic-deontic-2",
        "concept:act-sch-2-sec-140g-logic-deontic-3",
        "concept:act-sch-2-sec-140g-logic-deontic-4",
        "concept:act-sch-2-sec-140g-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "d83b448128b4fe190cf7ca4d4d2bdae50fbcab24806269c1e54b0d670f7ca336",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:act#sch-2-sec-140g",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:act-sch-2-sec-140g-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, it imposes an obligation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the law confers a function or power, then it imposes an obligation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The law confers a function or power."
    },
    {
      "@id": "concept:act-sch-2-sec-140g-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the law imposes a duty.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the circumstances in which the function or power is conferred give rise to an obligation, then the law imposes a duty.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The circumstances give rise to an obligation."
    },
    {
      "@id": "concept:act-sch-2-sec-140g-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, it imposes a duty.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the law confers a function or power and gives rise to an obligation, then it imposes a duty on Commonwealth entity.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The law confers a function or power."
    },
    {
      "@id": "concept:act-sch-2-sec-140g-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, it must perform the function or exercise the power.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the circumstances in which the function or power is conferred give rise to an obligation, then Commonwealth entity must perform the function or exercise the power.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:premiseText": "The circumstances give rise to an obligation."
    },
    {
