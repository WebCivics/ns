    },
    {
      "@id": "concept:act-sch-2-sec-202-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the court must not, in respect of the offences, impose on the person fines that, in the aggregate, exceed the maximum fine that would be applicable in respect of one offence by that person against that provision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
