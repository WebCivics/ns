    {
      "@id": "concept:act-sch-2-sec-112-3-ss-1",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.123",
      "skos:note": "Original ban ceases to be in force immediately before the Commonwealth ban comes into force.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "112(1) Interaction of multiple interim bans"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
