    {
      "@id": "concept:act-sch-3-sec-29-ss-5",
      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.354",
      "skos:note": "A person must authorise the placing of an advertisement with a document signed by them or another authorised person.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "29(5) After section 12DM"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
