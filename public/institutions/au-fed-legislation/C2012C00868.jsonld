    },
    {
      "@id": "concept:act-sch-2-sec-157-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty: $1,100,000 (body corporate), $220,000 (not a body corporate).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits advertising goods or services at a specified price without reasonable grounds.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person, in trade or commerce, advertises goods or services for supply at a specified price; and  (b) there are reasonable grounds for believing that the person will not be able to offer for supply those goods or services at that price for a period that is, and in quantities that are, reasonable, having regard to:  (i) the nature of the market in which the person carries on business; and  (ii) the nature of the advertisement."
    },
    {
      "@id": "concept:act-sch-2-sec-157-2-ss-1-norm",
      "@type": "doc:Prohibition",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:Agent",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:act-sch-2-sec-157-2-ss-1"
    },
