      "cml:logicSummary": "Prohibition of excessive fines",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) a person is convicted of 2 or more offences constituted by, or relating to, contraventions of the same provision..."
    },
