    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Negotiations must occur at a place other than the business premises.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(i) in each other’s presence at a place other than the business or trade premises of the supplier of the goods or services;"
    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Definition of an unsolicited consumer agreement.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(1) An agreement is an unsolicited consumer agreement if..."
    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Total price paid must be more than $100.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(ii) if it is ascertainable at that time—is more than $100 or such other amount prescribed by the regulations."
    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Consumer did not invite dealer to negotiate.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(c) the consumer did not invite the dealer to come to that place, or to make a telephone call, for the purposes of entering into negotiations relating to the supply of those goods or services;"
    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Multiple conditions must be met for an agreement to be unsolicited.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "and",
      "cml:premiseText": "(a) it is for the supply, in trade or commerce, of goods or services to a consumer; and (b) it is made as a result of negotiations..."
    },
    {
      "@id": "concept:act-sch-2-sec-69-2-ss-1-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
