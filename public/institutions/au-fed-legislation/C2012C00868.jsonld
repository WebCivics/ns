      "cml:logicSummary": "Lists the individuals who are considered manufacturers.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "(a) a person who grows, extracts, produces, processes or assembles goods;"
    },
    {
      "@id": "concept:act-sch-2-sec-7-2-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The definition includes individuals who hold themselves out as manufacturers.",
      "cml:confidence": {
        "@type": "xsd:decimal",
