      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.95",
      "skos:note": "Agreement is unsolicited consumer agreement if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "69(1) Meaning of unsolicited consumer agreement"
      },
