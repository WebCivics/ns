        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Subsection (1) applies whether or not consumer goods to which the product related services relate were being used before or at the time the death or serious injury or illness occurred."
    },
    {
