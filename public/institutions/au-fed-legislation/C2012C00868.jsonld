      "@type": "cml:Concept",
      "dc:source": "act.pdf, p.370",
      "skos:note": "Repeal certain provisions and amend others to restrict their operation to specific types of conduct.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "30 Paragraph 6(2)(b)"
      },
      "wasDerivedFrom": "act.pdf",
      "asserts": [
        "concept:act-sch-5-sec-30-norm",
        "concept:act-sch-5-sec-30-logic-deontic-1",
        "concept:act-sch-5-sec-30-logic-alleninterval-2",
        "concept:act-sch-5-sec-30-logic-ltl-3",
        "concept:act-sch-5-sec-30-logic-diffusion-4",
        "concept:act-sch-5-sec-30-logic-argumentation-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "bb2cd63d79e7da18d2b7fb0414c6b8f3699ab5cde3e78e899d4c6211a17d5c54",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:act#sch-5-sec-30",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:act-sch-5-sec-30-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the supply of goods or services to the Commonwealth or an authority or instrumentality of the Commonwealth;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Limits the scope of the provisions to within specific temporal intervals.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "The provisions are to be confined in their operation...within a Territory, between a State and a Territory or between 2 Territories; or..."
    },
    {
      "@id": "concept:act-sch-5-sec-30-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the supply of goods or services to the Commonwealth or an authority or instrumentality of the Commonwealth;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Restricts the operation of the provisions to specific types of conduct through argumentative means.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Restrict",
      "cml:premiseText": "The provisions are to be confined in their operation...to trade or commerce between Australia and places outside Australia; or..."
    },
    {
      "@id": "concept:act-sch-5-sec-30-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...to trade or commerce between Australia and places outside Australia; or...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits the specified provisions from operating beyond their restricted scope.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "The provisions are to be confined in their operation..."
    },
    {
      "@id": "concept:act-sch-5-sec-30-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...trade or commerce within a Territory, between a State and a Territory or between 2 Territories; or...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Spreads the restricted scope of the provisions to specific types of conduct.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:premiseText": "The provisions are to be confined in their operation...to trade or commerce between Australia and places outside Australia; or..."
    },
    {
      "@id": "concept:act-sch-5-sec-30-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...trade or commerce among the States; or...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Limits the scope of the provisions to recurring trade or commerce.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "The provisions are to be confined in their operation...to trade or commerce between Australia and places outside Australia; or..."
    },
