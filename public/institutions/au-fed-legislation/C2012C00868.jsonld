    {
      "@id": "concept:act-sch-2-sec-140-3-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the person suffers loss or damage as a result of the destruction or damage.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The destruction or damage of goods occurs between the time the person uses or consumes, or intends to use or consume, the goods and the time the person suffers loss or damage.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Between",
      "cml:premiseText": "(d) The person used or consumed, or intended to use or consume, the destroyed or damaged goods for personal, domestic or household use or consumption;"
    },
    {
      "@id": "concept:act-sch-2-sec-140-3-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the destroyed or damaged goods have a safety defect.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "If the manufacturer supplies goods in trade or commerce, and the goods have a safety defect, then the manufacturer is liable to compensate a person for loss or damage caused by the safety defect.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(a) The manufacturer supplies the goods in trade or commerce;"
    },
    {
      "@id": "concept:act-sch-2-sec-140-3-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the person suffers loss or damage as a result of the destruction or damage.",
      "cml:confidence": {
