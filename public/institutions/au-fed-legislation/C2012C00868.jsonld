    {
      "@id": "concept:act-sch-2-sec-90-2-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An agreement is an unsolicited consumer agreement if it meets the regulations' criteria during the applicable period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal scope of the regulation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The regulation applies to agreements that meet the criteria during a certain period."
    },
    {
      "@id": "concept:act-sch-2-sec-90-2-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An agreement is classified as an unsolicited consumer agreement if it meets the regulations' criteria.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Classification of agreements in AI systems",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "is-a",
      "cml:premiseText": "The regulation classifies agreements into types that can be used in AI systems."
    },
    {
      "@id": "concept:act-sch-2-sec-90-2-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An agreement meets the criteria if it is of a kind that the regulations provide are unsolicited consumer agreements.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Definition of unsolicited consumer agreement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "The regulations provide criteria for unsolicited consumer agreements."
    },
    {
      "@id": "concept:act-sch-2-sec-90-2-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Meeting the criteria is equivalent to being an unsolicited consumer agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Equivalence between meeting the criteria and being an unsolicited consumer agreement",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if-and-only-if",
      "cml:premiseText": "An agreement is an unsolicited consumer agreement if and only if it meets the regulations' criteria."
    },
    {
      "@id": "concept:act-sch-2-sec-90-2-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "An agreement is an unsolicited consumer agreement if it meets the regulations' criteria everywhere.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Global applicability of the regulation",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "everywhere",
      "cml:premiseText": "The regulation applies to all agreements that meet the criteria."
    },
