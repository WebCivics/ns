    {
      "@id": "concept:act-sch-2-sec-112-3-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the original ban ceases to be in force immediately before the Commonwealth ban comes into force.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The original ban ceases to be in force before the Commonwealth ban comes into force.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(a) an interim ban (the original ban) on consumer goods of a particular kind (the banned goods) is imposed by a responsible Minister other than the Commonwealth Minister;"
    },
    {
      "@id": "concept:act-sch-2-sec-112-3-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the original ban, to the extent that it is a ban on the banned goods, ceases to be in force immediately before the Commonwealth ban comes into force.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Original ban ceases to be in force.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "cease",
      "cml:premiseText": "(a) an interim ban (the original ban) on consumer goods of a particular kind (the banned goods) is imposed by a responsible Minister other than the Commonwealth Minister;"
    },
    {
      "@id": "concept:act-sch-2-sec-112-3-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the Commonwealth ban ceases to be in force if the original ban is lifted.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Commonwealth ban ceases to be in force if the original ban is lifted.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "cease",
      "cml:premiseText": "(b) while the original ban is in force, the Commonwealth Minister imposes an interim ban (the Commonwealth ban): (i) on the banned goods; or (ii) on consumer goods of a kind that includes the banned goods;"
    },
    {
      "@id": "concept:act-sch-2-sec-112-3-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the Commonwealth ban includes the banned goods.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "The Commonwealth ban includes the banned goods.",
