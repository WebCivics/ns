        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "(b) while the original ban is in force, the Commonwealth Minister imposes an interim ban (the Commonwealth ban): (i) on the banned goods; or (ii) on consumer goods of a kind that includes the banned goods;"
    },
    {
      "@id": "concept:act-sch-2-sec-112-3-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the Commonwealth ban comes into force after the original ban ceases to be in force.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The Commonwealth ban comes into force after the original ban ceases to be in force.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:premiseText": "(b) while the original ban is in force, the Commonwealth Minister imposes an interim ban (the Commonwealth ban): (i) on the banned goods; or (ii) on consumer goods of a kind that includes the banned goods;"
