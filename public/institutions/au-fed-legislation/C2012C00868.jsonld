    {
      "@id": "concept:act-sch-2-sec-165-2-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(a) if the person is a body corporate—$5,000; or  (b) if the person is not a body corporate—$1,000.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.8000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Overlaps with supply of goods for more than one price.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person, in trade or commerce, supplies goods; and  (b) the goods have more than one displayed price; and  (c) the supply takes place for a price that is not the lower, or lowest, of the displayed prices."
    },
    {
      "@id": "concept:act-sch-2-sec-165-2-ss-1-logic-deontic-1",
