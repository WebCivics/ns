    },
    {
      "@id": "concept:act-sch-2-sec-118-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth ban starts after the original ban ends.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Overlaps with the original ban in terms of time.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "the original ban, to the extent that it is a ban on the banned services, ceases to be in force immediately before the Commonwealth ban comes into force."
    },
    {
      "@id": "concept:act-sch-2-sec-118-2-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth ban is inferred from the original ban.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Infers the prohibition from the original ban.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "(b) while the original ban is in force, the Commonwealth Minister imposes an interim ban (the Commonwealth ban):"
    },
    {
      "@id": "concept:act-sch-2-sec-118-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth ban comes into force.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes a prohibition.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(b) while the original ban is in force, the Commonwealth Minister imposes an interim ban (the Commonwealth ban):"
    },
    {
      "@id": "concept:act-sch-2-sec-118-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth ban applies to these services.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies the banned services and product-related services as prohibited.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classify",
      "cml:premiseText": "(i) on the banned services; or (ii) on product related services of a kind that includes the banned services;"
    },
    {
      "@id": "concept:act-sch-2-sec-118-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth ban applies to these services as well.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Spreads the prohibition to product-related services.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:premiseText": "(ii) on product related services of a kind that includes the banned services;"
    },
    {
      "@id": "concept:act-sch-2-sec-118-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commonwealth ban repeats every time the original ban ends.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring trace of overlapping bans.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(b) while the original ban is in force, the Commonwealth Minister imposes an interim ban (the Commonwealth ban):"
    },
