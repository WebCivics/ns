    {
      "@id": "concept:act-sch-2-sec-36-2-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Compliance does not preclude the possibility of a safety defect.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Inference of safety defect may occur outside the scope of compliance with mandatory standard.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Safety defect inference is not limited to compliance with standard."
    },
    {
      "@id": "concept:act-sch-2-sec-36-2-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Compliance does not guarantee the absence of AI-inferred safety defects.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Artificial intelligence may be used to infer safety defects beyond compliance with mandatory standard.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "Safety defect inference is not limited to human judgment."
    },
    {
      "@id": "concept:act-sch-2-sec-36-2-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Inference of safety defect requires more than compliance.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to ensure safety standards are met.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Compliance with mandatory standard does not guarantee safety."
    },
    {
      "@id": "concept:act-sch-2-sec-36-2-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Compliance does not preclude the possibility of a safety defect in other contexts.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Inference of safety defect may spread beyond compliance with mandatory standard.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "Safety defect inference is not contained within compliance with standard."
    },
    {
      "@id": "concept:act-sch-2-sec-36-2-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Compliance does not guarantee the absence of future safety defects.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Inference of safety defect may recur over time despite compliance with mandatory standard.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "RecurringTrace",
      "cml:premiseText": "Safety defect inference is not limited to a single instance."
    },
