    <https://ns.webcivics.net/cml/operator> "=";
    <https://ns.webcivics.net/cml/logicSummary> "Definition of supply and acquisition";
    <https://ns.webcivics.net/cml/premiseText> "a reference to the supply or acquisition of goods or services includes a reference to agreeing to supply or acquire goods or services";
    <https://ns.webcivics.net/cml/conclusionText> "The definition is equal to agreement";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
