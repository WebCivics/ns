<https://ns.webcivics.net/concept/act-sch-2-sec-24-3-ss-1> a <https://ns.webcivics.net/cml/Concept>;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "24(1) Meaning of unfair"@en;
    <https://ns.webcivics.net/cml/realizedBy> <https://ns.webcivics.net/values/act#sch-2-sec-24-3-ss-1>;
    <https://ns.webcivics.net/cml/integrityHash> "534c413681b35c79c1f1d76c54424fb48ff46676c9d90e2cc28654b75f0d11fc";
    <https://ns.webcivics.net/values/partOf> <https://ns.webcivics.net/concept/act-sch-2-sec-24-3>;
    <http://www.w3.org/2004/02/skos/core#note> "A term of a consumer contract is unfair if it causes a significant imbalance in the parties' rights and obligations.";
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>;
    <https://ns.webcivics.net/cml/schemaVersion> "2";
    <https://ns.webcivics.net/cml/proposedBy> <https://ns.webcivics.net/tools/legis2cml>;
