<https://ns.webcivics.net/concept/act-sch-2-sec-157-2-ss-1> a <https://ns.webcivics.net/cml/Concept>;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "157(1) Bait advertising"@en;
    <https://ns.webcivics.net/cml/realizedBy> <https://ns.webcivics.net/values/act#sch-2-sec-157-2-ss-1>;
    <https://ns.webcivics.net/cml/integrityHash> "9b84c991f2670276e8a500fb458767d89da2488319c961455d2b92322a3adfb9";
    <https://ns.webcivics.net/values/partOf> <https://ns.webcivics.net/concept/act-sch-2-sec-157-2>;
    <http://www.w3.org/2004/02/skos/core#note> "Advertising goods or services at a specified price without reasonable grounds for believing it can be offered at that price for a period and quantity.";
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>;
    <https://ns.webcivics.net/cml/schemaVersion> "2";
