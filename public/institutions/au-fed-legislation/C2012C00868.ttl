    <https://ns.webcivics.net/cml/logicSummary> "Prohibition on asserting a right to payment without reasonable cause.";
    <https://ns.webcivics.net/cml/premiseText> "A person must not assert a right to payment from another person for unsolicited goods unless the person has reasonable cause to believe that there is a right to the payment.";
    <https://ns.webcivics.net/cml/conclusionText> "There is no right to payment without reasonable cause.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
