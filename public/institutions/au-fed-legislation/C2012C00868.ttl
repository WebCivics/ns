    <http://www.w3.org/2004/02/skos/core#prefLabel> "167(1) Referral selling"@en;
    <https://ns.webcivics.net/cml/realizedBy> <https://ns.webcivics.net/values/act#sch-2-sec-167-2-ss-1>;
    <https://ns.webcivics.net/cml/integrityHash> "d6e42d78d46be60cef8984f444a40ed2b2545275de57b3003307423e8c447d2d";
