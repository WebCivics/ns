doc:sch-2-sec-283-2-ss-1 a cof:Section ;
    cof:title "283(1) Enforcement of judgments etc." ;
    values:kind "subsection" ;
    values:originalText "(1) If, in joint liability proceedings, judgment is given against a supplier and a linked credit provider, the judgment must not be enforced against the credit provider unless a written demand made on the supplier for satisfaction of the judgment has remained unsatisfied for at least 30 days." ;
    cof:pageNumber "265"^^xsd:integer .

concept:act-sch-2-sec-283-2-ss-2 a cml:Concept ;
    skos:prefLabel "283(2) Enforcement of judgments etc."@en ;
    cml:realizedBy doc:sch-2-sec-283-2-ss-2 ;
    values:originalText "(2) If the judgment can be enforced against the linked credit provider, it may only be enforced to the extent of the lesser of the following amounts:  (a) the amount calculated in accordance with section 281;  (b) so much of the judgment debt as has not been satisfied by the supplier." ;
    skos:definition "(2) If the judgment can be enforced against the linked credit provider, it may only be enforced to the extent of the lesser of the following amounts:  (a) the amount calculated in accordance with section 281;  (b) so much of the judgment debt as has not been satisfied by the supplier."@en ;
