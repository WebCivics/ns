concept:act-sch-2-sec-118-3 a cml:Concept ;
    skos:prefLabel "118 Supplying etc. consumer goods covered by a ban"@en ;
    cml:realizedBy doc:sch-2-sec-118-3 ;
    values:originalText "(1) A person must not, in trade or commerce, supply consumer goods of a particular kind if:  (a) an interim ban on consumer goods of that kind is in force in the place where the supply occurs; or  (b) a permanent ban on consumer goods of that kind is in force. Note: A pecuniary penalty may be imposed for a contravention of this subsection. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "(1) A person must not, in trade or commerce, supply consumer goods of a particular kind if:  (a) an interim ban on consumer goods of that kind is in force in the place where the supply occurs; or  (b) a permanent ban on consumer goods of that kind is in force. Note: A pecuniary penalty may be imposed for a contravention of this subsection. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law"@en ;
    cml:integrityHash "95e078445ab6758735b78e7c2930bbcb62ab50200d30f0bf2d17d6c032c0d429" ;
    cof:pageNumber "125"^^xsd:integer ;
    skos:note "Supplying consumer goods of a particular kind is prohibited if an interim or permanent ban is in force." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
