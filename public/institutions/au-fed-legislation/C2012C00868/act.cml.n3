concept:act-sch-2-sec-15-2 a cml:Concept ;
    skos:prefLabel "15 Contraventions of this Schedule"@en ;
    cml:realizedBy doc:sch-2-sec-15-2 ;
    values:originalText "Conduct is not taken, for the purposes of this Schedule, to contravene a provision of this Schedule merely because of the application of:  (a) section 23(1); or  (b) a provision of Division 1 of Part 3-2 (other than section 66(2)); or  (c) a provision of Part 3-5." ;
