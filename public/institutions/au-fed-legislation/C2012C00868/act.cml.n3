    cml:conclusionText "The provision to these persons occurs during the payment for those goods or services" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-22-2 cml:asserts concept:act-sch-2-sec-22-2-logic-ltl-4 .
