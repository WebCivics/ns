concept:act-sch-2-sec-212-3 cml:asserts concept:act-sch-2-sec-212-3-logic-deontic-1 .
concept:act-sch-2-sec-212-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator ">=" ;
    cml:logicSummary "Upper limit for pecuniary penalty" ;
    cml:premiseText "$16,500 or $3,300" ;
    cml:conclusionText "not to exceed" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-2-sec-212-3 a cof:Section ;
