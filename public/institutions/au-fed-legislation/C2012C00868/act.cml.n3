concept:act-sch-2-sec-140-3-ss-1 cml:asserts concept:act-sch-2-sec-140-3-ss-1-logic-argumentation-5 .
concept:act-sch-2-sec-140-3-ss-1-logic-argumentation-5 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "If the manufacturer supplies goods in trade or commerce, and the goods have a safety defect, then the manufacturer is liable to compensate a person for loss or damage caused by the safety defect." ;
    cml:premiseText "(a) The manufacturer supplies the goods in trade or commerce;" ;
    cml:conclusionText "...the destroyed or damaged goods have a safety defect." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-2-sec-140-3-ss-1 a cof:Section ;
    cof:title "140(1) Liability for loss or damage suffered by a person if other goods" ;
    values:kind "subsection" ;
    values:originalText "(1) A manufacturer of goods is liable to compensate a person if:  (a) the manufacturer supplies the goods in trade or commerce; and  (b) the goods have a safety defect; and  (c) other goods of a kind ordinarily acquired for personal, domestic or household use or consumption are destroyed or damaged because of the safety defect; and  (d) the person used or consumed, or intended to use or consume, the destroyed or damaged goods for personal, domestic or household use or consumption; and  (e) the person suffers loss or damage as a result of the destruction or damage." ;
    cof:pageNumber "149"^^xsd:integer .

concept:act-sch-2-sec-140-3-ss-2 a cml:Concept ;
    skos:prefLabel "140(2) Liability for loss or damage suffered by a person if other goods"@en ;
    cml:realizedBy doc:sch-2-sec-140-3-ss-2 ;
    values:originalText "(2) The person may recover, by action against the manufacturer, the amount of the loss or damage suffered by the person." ;
