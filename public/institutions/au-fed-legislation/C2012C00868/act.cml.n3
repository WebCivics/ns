doc:sch-2-sec-194-2-ss-3 a cof:Section ;
    cof:title "194(3) Supplying etc. consumer goods that do not comply with safety" ;
    values:kind "subsection" ;
    values:originalText "(3) A person commits an offence if:  (a) the person, in or for the purposes of trade or commerce, manufactures, possesses or has control of consumer goods of a particular kind; and  (b) a safety standard for consumer goods of that kind is in force; and  (c) those goods do not comply with the standard. ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010 Penalty:  (a) if the person is a body corporate—$1,100,000; or  (b) if the person is not a body corporate—$220,000." ;
    cof:pageNumber "190"^^xsd:integer .

concept:act-sch-2-sec-194-2-ss-4 a cml:Concept ;
    skos:prefLabel "194(4) Supplying etc. consumer goods that do not comply with safety"@en ;
    cml:realizedBy doc:sch-2-sec-194-2-ss-4 ;
    values:originalText "(4) Subsection (3) does not apply if the person does not manufacture, possess or control the goods for the purpose of supplying the goods (other than for export)." ;
    skos:definition "(4) Subsection (3) does not apply if the person does not manufacture, possess or control the goods for the purpose of supplying the goods (other than for export)."@en ;
    cml:integrityHash "5711075f5258db67c1c601f45fc68e129a077603d0ec1bbc73d813d1de283a8b" ;
    values:partOf concept:act-sch-2-sec-194-2 ;
    cof:pageNumber "190"^^xsd:integer ;
    skos:note "Exemption from subsection (3) for non-export purposes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
