doc:sch-2-sec-232-2-ss-2 a cof:Section ;
    cof:title "232(2) Injunctions" ;
    values:kind "subsection" ;
    values:originalText "(2) The court may grant the injunction on application by the regulator or any other person." ;
    cof:pageNumber "222"^^xsd:integer .

concept:act-sch-2-sec-232-2-ss-3 a cml:Concept ;
    skos:prefLabel "232(3) Injunctions"@en ;
    cml:realizedBy doc:sch-2-sec-232-2-ss-3 ;
    values:originalText "(3) Subsection (1) applies in relation to conduct constituted by applying or relying on, or purporting to apply or rely on, a term of a consumer contract that has been declared under section 250 to be an unfair term as if the conduct were a contravention of a provision of Chapter 2." ;
    skos:definition "(3) Subsection (1) applies in relation to conduct constituted by applying or relying on, or purporting to apply or rely on, a term of a consumer contract that has been declared under section 250 to be an unfair term as if the conduct were a contravention of a provision of Chapter 2."@en ;
    cml:integrityHash "7449abe25b21250a6c15614dff2758dba3a6393c4e70f7f1eaae7ec79be6b78f" ;
    values:partOf concept:act-sch-2-sec-232-2 ;
    cof:pageNumber "222"^^xsd:integer ;
    skos:note "Prohibits conduct that relies on or applies an unfair term from a consumer contract." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
