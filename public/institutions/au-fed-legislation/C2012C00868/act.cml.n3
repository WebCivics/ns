concept:act-sch-2-sec-163-2-ss-3 cml:asserts concept:act-sch-2-sec-163-2-ss-3-logic-deontic-2 .
concept:act-sch-2-sec-163-2-ss-3-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposing an obligation on the individual to prove that they knew or had reasonable cause to believe that another person authorized the placement of the entry or advertisement." ;
    cml:premiseText "The person must prove that they knew or had reasonable cause to believe that the other person authorized the placement of the entry or advertisement." ;
    cml:conclusionText "Subsections (1) and (2) do not apply if the person proves this." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
