concept:act-sch-7-sec-2-2 a cml:Concept ;
    skos:prefLabel "2 Schedules 1 to"@en ;
    cml:realizedBy doc:sch-7-sec-2-2 ;
    values:originalText "The later of: (a) the start of 1 January 2011; and (b) immediately after the commencement of Schedule 1 to the Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010. However, the provision(s) do not commence at all if the event mentioned in paragraph (b) does not occur." ;
    skos:definition "The later of: (a) the start of 1 January 2011; and (b) immediately after the commencement of Schedule 1 to the Trade Practices Amendment (Australian Consumer Law) Act (No. 1) 2010. However, the provision(s) do not commence at all if the event mentioned in paragraph (b) does not occur."@en ;
    cml:integrityHash "fae1f14f8092560c5b9fe168b9078e18e95a32f48abc17a2b0322212225e1d18" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Commencement of provision depends on event mentioned in paragraph (b)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
