    cml:operator "Obligation" ;
    cml:logicSummary "State's obligation to ensure parties do not make misleading representations." ;
    cml:premiseText "State allows party or other person to make a representation about a future matter." ;
    cml:conclusionText "State ensures party or other person did not have reasonable grounds for making the representation." ;
    cml:executionSurface "modalities::logic::deontic" ;
