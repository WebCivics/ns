    cof:title "135D(1) Persons assisting inspectors" ;
    values:kind "subsection" ;
    values:originalText "(1) An inspector may, in entering premises under section 135 and in exercising search-related powers in relation to the premises, be assisted by other persons if that assistance is necessary and reasonable." ;
    cof:pageNumber "304"^^xsd:integer .

