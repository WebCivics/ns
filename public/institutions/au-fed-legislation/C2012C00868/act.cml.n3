concept:act-sch-2-sec-12-3 a cml:Concept ;
    skos:prefLabel "12 Application of Schedule in relation to leases and licences of land"@en ;
    cml:realizedBy doc:sch-2-sec-12-3 ;
    values:originalText "and buildings  In this Schedule:  (a) a reference to a contract includes a reference to a lease of, or a licence in respect of, land or a building or part of a building (despite the express references in this Schedule to such leases or licences); and  (b) a reference to making or entering into a contract, in relation to such a lease or licence, is a reference to granting or taking the lease or licence; and  (c) a reference to a party to a contract, in relation to such a lease or licence, includes a reference to any person bound by, or entitled to the benefit of, any provision contained in the lease or licence." ;
    skos:definition "and buildings  In this Schedule:  (a) a reference to a contract includes a reference to a lease of, or a licence in respect of, land or a building or part of a building (despite the express references in this Schedule to such leases or licences); and  (b) a reference to making or entering into a contract, in relation to such a lease or licence, is a reference to granting or taking the lease or licence; and  (c) a reference to a party to a contract, in relation to such a lease or licence, includes a reference to any person bound by, or entitled to the benefit of, any provision contained in the lease or licence."@en ;
    cml:integrityHash "c41dba9ed42823b4e1761aeb3da06790b177e2f22ed8b49701243c3d122e3343" ;
    cof:pageNumber "44"^^xsd:integer ;
    skos:note "Reference to contract includes lease or licence of land or building" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.44" ;
