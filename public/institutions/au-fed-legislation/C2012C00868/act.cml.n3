    cml:hasPart concept:act-sch-2-sec-74-2-ss-5 ;
    cml:hasPart concept:act-sch-2-sec-74-2-ss-6 ;
    cml:hasPart concept:act-sch-2-sec-74-2-ss-7 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
