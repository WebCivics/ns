concept:act-sch-2-sec-135u a cml:Concept ;
    skos:prefLabel "135U Multiple embargo notices for the same consumer goods or"@en ;
    cml:realizedBy doc:sch-2-sec-135u ;
    values:originalText "product related services  An inspector must not give an embargo notice in relation to consumer goods, or product related services, of a particular kind if:  (a) an embargo notice (the earlier embargo notice) has already been given in relation to consumer goods, or product related services, of that kind; and  (b) the embargo period for the earlier embargo notice did not end at least 5 days ago." ;
    skos:definition "product related services  An inspector must not give an embargo notice in relation to consumer goods, or product related services, of a particular kind if:  (a) an embargo notice (the earlier embargo notice) has already been given in relation to consumer goods, or product related services, of that kind; and  (b) the embargo period for the earlier embargo notice did not end at least 5 days ago."@en ;
    cml:integrityHash "6d37ec7981726662d22a441c38310e7bab9bee0eaad14e86a34f5ea5d257f9b7" ;
    cof:pageNumber "313"^^xsd:integer ;
    skos:note "Cannot give embargo notice for same consumer goods or product related services if earlier notice has not ended at least 5 days ago." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
