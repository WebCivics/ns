concept:act-sch-2-sec-86-2 cml:asserts concept:act-sch-2-sec-86-2-logic-deontic-1 .
concept:act-sch-2-sec-86-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Court has an obligation to consider circumstances when determining if reliance on contract term is fair or reasonable." ;
    cml:premiseText "The court must have regard to all the circumstances of the case." ;
    cml:conclusionText "Fairness and reasonableness are determined by considering the circumstances." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-86-2 cml:asserts concept:act-sch-2-sec-86-2-logic-alleninterval-2 .
concept:act-sch-2-sec-86-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The provision overlaps with other provisions in the same section." ;
    cml:premiseText "Subdivision D—Miscellaneous is part of the same section as subsection (3)." ;
    cml:conclusionText "Sch-2-sec-86-2 overlaps with Subdivision D—Miscellaneous." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-86-2 cml:asserts concept:act-sch-2-sec-86-2-logic-argumentation-3 .
concept:act-sch-2-sec-86-2-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "The provision implies that the court must consider certain factors when determining fairness and reasonableness." ;
    cml:premiseText "If the court has regard to all the circumstances of the case, then it is fair or reasonable to rely on a term of a contract." ;
    cml:conclusionText "Fairness and reasonableness are determined by considering the circumstances." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

