concept:act-sch-2-sec-274-2-ss-3 a cml:Concept ;
    skos:prefLabel "274(3) Indemnification of suppliers by manufacturers"@en ;
    cml:realizedBy doc:sch-2-sec-274-2-ss-3 ;
    values:originalText "(3) The supplier may, with respect to the manufacturer’s liability to indemnify the supplier, commence an action against the manufacturer in a court of competent jurisdiction for such legal or equitable relief as the supplier could have obtained if that liability had arisen under a contract of indemnity made between them." ;
    skos:definition "(3) The supplier may, with respect to the manufacturer’s liability to indemnify the supplier, commence an action against the manufacturer in a court of competent jurisdiction for such legal or equitable relief as the supplier could have obtained if that liability had arisen under a contract of indemnity made between them."@en ;
    cml:integrityHash "d13ac696737cb4ce6ea87ebed297be20f4755c5dad0b824f8f1df5b8b21dfef8" ;
    values:partOf concept:act-sch-2-sec-274-2 ;
    cof:pageNumber "257"^^xsd:integer ;
    skos:note "Supplier may bring action against manufacturer for indemnification" ;
