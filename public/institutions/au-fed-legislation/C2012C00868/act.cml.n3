doc:sch-2-sec-132c-ss-2 a cof:Section ;
    cof:title "132C(2) Notification of conference" ;
    values:kind "subsection" ;
    values:originalText "(2) The day appointed must be at least 5 days, but not more than 14 days, after the end of the period:  (a) for a proposed ban notice—specified under paragraph 132(3)(e); or  (b) for a proposed recall notice—specified under paragraph 132A(3)(e). ComLaw Authoritative Act C2012C00868  Schedule 2  Application of the Australian Consumer Law" ;
    cof:pageNumber "279"^^xsd:integer .

