    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-3-sec-12dn-ss-1 cml:asserts concept:act-sch-3-sec-12dn-ss-1-logic-deontic-5 .
