    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "The manufacturer's obligation is to compensate a person for loss or damage caused by safety defect." ;
    cml:premiseText "(1) A manufacturer of goods is liable to compensate a person if..." ;
    cml:conclusionText "...the destruction or damage." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
