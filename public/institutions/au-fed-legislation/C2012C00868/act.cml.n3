doc:sch-2-sec-191-2-ss-1 a cof:Section ;
    cof:title "191(1) Refund of amounts" ;
    values:kind "subsection" ;
    values:originalText "(1) A supplier of consumer goods who is a party to a lay-by agreement commits an offence if:  (a) the agreement is terminated by a party to the agreement; and  (b) the supplier fails to refund to the consumer all the amounts paid by the consumer under the agreement (other than any termination charge that is payable under the agreement). Penalty:  (a) if the person is a body corporate—$30,000; or  (b) if the person is not a body corporate—$6,000." ;
    cof:pageNumber "188"^^xsd:integer .

concept:act-sch-2-sec-191-2-ss-2 a cml:Concept ;
    skos:prefLabel "191(2) Refund of amounts"@en ;
    cml:realizedBy doc:sch-2-sec-191-2-ss-2 ;
    values:originalText "(2) Subsection (1) is an offence of strict liability. ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010" ;
    skos:definition "(2) Subsection (1) is an offence of strict liability. ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010"@en ;
    cml:integrityHash "70a47f0a7c30bcad441292732a6075a5e7731c7e9f261d4eb0f29aaf52283aed" ;
    values:partOf concept:act-sch-2-sec-191-2 ;
