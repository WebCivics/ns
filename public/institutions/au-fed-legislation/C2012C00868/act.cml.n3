concept:act-sch-2-sec-80-2-ss-3 a cml:Concept ;
    skos:prefLabel "80(3) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-80-2-ss-3 ;
    values:originalText "(3) This section does not apply if the circumstances show that the consumer did not rely on, or that it was unreasonable for the consumer to rely on, the skill or judgment of the supplier, the person referred to in subsection (2)(a)(ii) or the manufacturer, as the case may be." ;
    skos:definition "(3) This section does not apply if the circumstances show that the consumer did not rely on, or that it was unreasonable for the consumer to rely on, the skill or judgment of the supplier, the person referred to in subsection (2)(a)(ii) or the manufacturer, as the case may be."@en ;
    cml:integrityHash "5cb97cd089a03291e743a89a6e56f188c6c4ffed1edfd494dd87ab3e64d9bb44" ;
    values:partOf concept:act-sch-2-sec-80-2 ;
    cof:pageNumber "86"^^xsd:integer ;
    skos:note "Consumer reliance on supplier's skill or judgment is not a requirement for this section to apply." ;
    cml:curationStatus cml:Proposed ;
