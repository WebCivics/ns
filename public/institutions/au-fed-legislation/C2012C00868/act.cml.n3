concept:act-sch-2-sec-140h a cml:Concept ;
    skos:prefLabel "140H Application laws may operate concurrently with this Act"@en ;
    cml:realizedBy doc:sch-2-sec-140h ;
    values:originalText "This Act is not intended to exclude the operation of any application law, to the extent that the application law is capable of operating concurrently with this Act. ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010" ;
    skos:definition "This Act is not intended to exclude the operation of any application law, to the extent that the application law is capable of operating concurrently with this Act. ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010"@en ;
    cml:integrityHash "21fd05bd1e79651385e05b7952e68132ad8bc11615a03840b0abc158f6b3205b" ;
    cof:pageNumber "344"^^xsd:integer ;
    skos:note "Application laws may operate concurrently with this Act" ;
