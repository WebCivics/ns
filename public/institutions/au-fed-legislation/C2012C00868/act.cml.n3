    cml:modality cml:AllenInterval ;
    cml:operator "Overlap" ;
    cml:logicSummary "Temporal overlap between promotional and non-promotional donations." ;
    cml:premiseText "(2) For the purposes of Parts 3-3, 3-4, 4-3 and 4-4:" ;
    cml:conclusionText "Donation of goods or services for non-promotional purposes is not treated as a supply." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

