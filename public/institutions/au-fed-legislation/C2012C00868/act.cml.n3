concept:act-sch-2-sec-137g a cml:Concept ;
    skos:prefLabel "137G Compliance with orders made under section 137F"@en ;
    cml:realizedBy doc:sch-2-sec-137g ;
    values:originalText "(1) A person commits an offence if:  (a) an order made under section 137F applies to the person; and  (b) the person contravenes, or refuses or fails to comply with, the order. Penalty:  (a) if the person is a body corporate—900 penalty units; or  (b) if the person is not a body corporate—180 penalty units.  (2) Subsection (1) is an offence of strict liability. Note: For strict liability, see section 6.1 of the Criminal Code." ;
    skos:definition "(1) A person commits an offence if:  (a) an order made under section 137F applies to the person; and  (b) the person contravenes, or refuses or fails to comply with, the order. Penalty:  (a) if the person is a body corporate—900 penalty units; or  (b) if the person is not a body corporate—180 penalty units.  (2) Subsection (1) is an offence of strict liability. Note: For strict liability, see section 6.1 of the Criminal Code."@en ;
    cml:integrityHash "1e079d5b1de93a37b37186acdc168345aa954242f6b5eb76bf6ef802ef98d8bc" ;
    cof:pageNumber "327"^^xsd:integer ;
    cml:hasPart concept:act-sch-2-sec-137g-ss-1 ;
    cml:hasPart concept:act-sch-2-sec-137g-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.327" .
doc:sch-2-sec-137g a cof:Section ;
    cof:title "137G Compliance with orders made under section 137F" ;
    values:kind "section" ;
    values:originalText "(1) A person commits an offence if:  (a) an order made under section 137F applies to the person; and  (b) the person contravenes, or refuses or fails to comply with, the order. Penalty:  (a) if the person is a body corporate—900 penalty units; or  (b) if the person is not a body corporate—180 penalty units.  (2) Subsection (1) is an offence of strict liability. Note: For strict liability, see section 6.1 of the Criminal Code." ;
    cof:pageNumber "327"^^xsd:integer .

