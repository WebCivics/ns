concept:act-sch-2-sec-234-3-ss-6 a cml:Concept ;
    skos:prefLabel "234(6) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-234-3-ss-6 ;
    values:originalText "(6) The regulations made for the purposes of item 3 of the table in subsection (1) may, in relation to a specified logo, prescribe a percentage in the range of 51% to 100% as the percentage applicable to goods for the purposes of paragraph (b) in the second column of that item." ;
    skos:definition "(6) The regulations made for the purposes of item 3 of the table in subsection (1) may, in relation to a specified logo, prescribe a percentage in the range of 51% to 100% as the percentage applicable to goods for the purposes of paragraph (b) in the second column of that item."@en ;
