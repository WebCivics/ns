    cml:modality cml:Deontic ;
    cml:operator "Must" ;
    cml:logicSummary "Court must give leave for defendant to rely on defence provided by subsection (1)." ;
    cml:premiseText "Subsection (2)(a)" ;
    cml:conclusionText "Defendant is entitled to rely on defence provided by subsection (1) if leave is given." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

