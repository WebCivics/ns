concept:act-sch-7-sec-10 a cml:Concept ;
    skos:prefLabel "10 Pecuniary penalties—having regard to previous findings"@en ;
    cml:realizedBy doc:sch-7-sec-10 ;
    values:originalText "The reference in paragraph 224(2)(c) of the Australian Consumer Law to proceedings under Chapter 4 or Part 5-2 of Schedule 2 includes a reference to proceedings, commenced before the commencement of this item, under or in relation to:  (a) Part VC or VI of the Trade Practices Act 1974; or  (b) equivalent provisions of a law of a State or a Territory." ;
    skos:definition "The reference in paragraph 224(2)(c) of the Australian Consumer Law to proceedings under Chapter 4 or Part 5-2 of Schedule 2 includes a reference to proceedings, commenced before the commencement of this item, under or in relation to:  (a) Part VC or VI of the Trade Practices Act 1974; or  (b) equivalent provisions of a law of a State or a Territory."@en ;
    cml:integrityHash "93a8ccbf2cdfae5a7d9f9b964ad9822a60a4886f08ca93ef3a71e235644725ae" ;
    cof:pageNumber "405"^^xsd:integer ;
