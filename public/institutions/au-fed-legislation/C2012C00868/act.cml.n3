doc:sch-2-sec-137g-ss-1 a cof:Section ;
    cof:title "137G(1) Compliance with orders made under section 137F" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if:  (a) an order made under section 137F applies to the person; and  (b) the person contravenes, or refuses or fails to comply with, the order. Penalty:  (a) if the person is a body corporate—900 penalty units; or  (b) if the person is not a body corporate—180 penalty units." ;
    cof:pageNumber "327"^^xsd:integer .

concept:act-sch-2-sec-137g-ss-2 a cml:Concept ;
    skos:prefLabel "137G(2) Compliance with orders made under section 137F"@en ;
    cml:realizedBy doc:sch-2-sec-137g-ss-2 ;
    values:originalText "(2) Subsection (1) is an offence of strict liability. Note: For strict liability, see section 6.1 of the Criminal Code." ;
    skos:definition "(2) Subsection (1) is an offence of strict liability. Note: For strict liability, see section 6.1 of the Criminal Code."@en ;
    cml:integrityHash "693dec5fea6efdf19ebc783373514801287fa9758efbd610a6eb40728042409b" ;
