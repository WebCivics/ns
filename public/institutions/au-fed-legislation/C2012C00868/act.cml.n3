concept:act-sch-2-sec-101-2-ss-3 a cml:Concept ;
    skos:prefLabel "101(3) Consumer may request an itemised bill"@en ;
    cml:realizedBy doc:sch-2-sec-101-2-ss-3 ;
    values:originalText "(3) The supplier must give the consumer the itemised bill within 7 days after the request is made. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
