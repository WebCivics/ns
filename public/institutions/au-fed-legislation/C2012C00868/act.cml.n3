concept:act-sch-2-sec-90-3 a cml:Concept ;
    skos:prefLabel "90 Waiver of rights"@en ;
    cml:realizedBy doc:sch-2-sec-90-3 ;
    values:originalText "(1) The consumer under an unsolicited consumer agreement is not competent to waive any right conferred by this Division.  (2) The supplier under the unsolicited consumer agreement must not induce, or attempt to induce, the consumer to waive any right conferred by this Division. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    skos:definition "(1) The consumer under an unsolicited consumer agreement is not competent to waive any right conferred by this Division.  (2) The supplier under the unsolicited consumer agreement must not induce, or attempt to induce, the consumer to waive any right conferred by this Division. Note: A pecuniary penalty may be imposed for a contravention of this subsection."@en ;
    cml:integrityHash "0a26bb850ff9d8741341f69a5fd6c008f15ba883a8fa8d59752e7d1e0c2f86ab" ;
    cof:pageNumber "109"^^xsd:integer ;
