concept:act-sch-7-sec-6-2 a cml:Concept ;
    skos:prefLabel "6 Acts or omissions that occurred before commencement"@en ;
    cml:realizedBy doc:sch-7-sec-6-2 ;
    values:originalText "(1) The Trade Practices Act 1974 as in force immediately before the commencement of this item continues to apply, after that commencement, in relation to acts or omissions that occurred before that commencement. (2) Without limiting subitem (1), action may be taken, under or in relation to Part VC or VI of that Act as so in force, in relation to those acts or omissions." ;
    skos:definition "(1) The Trade Practices Act 1974 as in force immediately before the commencement of this item continues to apply, after that commencement, in relation to acts or omissions that occurred before that commencement. (2) Without limiting subitem (1), action may be taken, under or in relation to Part VC or VI of that Act as so in force, in relation to those acts or omissions."@en ;
    cml:integrityHash "83e636e4cbcf4193775f059a23386b7f72c6c3b0c928be430d33d5a725cdc92a" ;
    cof:pageNumber "404"^^xsd:integer ;
