concept:act-sch-2-sec-273-2 a cml:Concept ;
    skos:prefLabel "273 Time limit for actions against manufacturers of goods"@en ;
    cml:realizedBy doc:sch-2-sec-273-2 ;
    values:originalText "An affected person may commence an action for damages under this Division at any time within 3 years after the day on which the affected person first became aware, or ought reasonably to have become aware, that the guarantee to which the action relates has not been complied with. ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010" ;
    skos:definition "An affected person may commence an action for damages under this Division at any time within 3 years after the day on which the affected person first became aware, or ought reasonably to have become aware, that the guarantee to which the action relates has not been complied with. ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010"@en ;
    cml:integrityHash "ecff51a7520e8cfc7bad6a744a53b12648cbc584aa3fd1d8bb159c48add5c1a3" ;
    cof:pageNumber "256"^^xsd:integer ;
