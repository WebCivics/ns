concept:act-sch-5-sec-30-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the specified provisions from operating beyond their restricted scope." ;
    cml:premiseText "The provisions are to be confined in their operation..." ;
    cml:conclusionText "...to trade or commerce between Australia and places outside Australia; or..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-30 cml:asserts concept:act-sch-5-sec-30-logic-alleninterval-2 .
concept:act-sch-5-sec-30-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Within" ;
    cml:logicSummary "Limits the scope of the provisions to within specific temporal intervals." ;
    cml:premiseText "The provisions are to be confined in their operation...within a Territory, between a State and a Territory or between 2 Territories; or..." ;
    cml:conclusionText "...the supply of goods or services to the Commonwealth or an authority or instrumentality of the Commonwealth;" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-30 cml:asserts concept:act-sch-5-sec-30-logic-ltl-3 .
concept:act-sch-5-sec-30-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring" ;
    cml:logicSummary "Limits the scope of the provisions to recurring trade or commerce." ;
    cml:premiseText "The provisions are to be confined in their operation...to trade or commerce between Australia and places outside Australia; or..." ;
    cml:conclusionText "...trade or commerce among the States; or..." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-5-sec-30 cml:asserts concept:act-sch-5-sec-30-logic-diffusion-4 .
concept:act-sch-5-sec-30-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Spread" ;
    cml:logicSummary "Spreads the restricted scope of the provisions to specific types of conduct." ;
    cml:premiseText "The provisions are to be confined in their operation...to trade or commerce between Australia and places outside Australia; or..." ;
    cml:conclusionText "...trade or commerce within a Territory, between a State and a Territory or between 2 Territories; or..." ;
    cml:executionSurface "modalities::diffusion" ;
