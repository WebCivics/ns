concept:act-sch-2-sec-115-2 a cml:Concept ;
    skos:prefLabel "115 Places in which permanent bans apply"@en ;
    cml:realizedBy doc:sch-2-sec-115-2 ;
    values:originalText "A permanent ban applies in all States and Territories. 116  When permanent bans come into force  A permanent ban comes into force on the day specified by the Commonwealth Minister in the instrument imposing the ban." ;
    skos:definition "A permanent ban applies in all States and Territories. 116  When permanent bans come into force  A permanent ban comes into force on the day specified by the Commonwealth Minister in the instrument imposing the ban."@en ;
