    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-2-sec-4-2-ss-2 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:act-sch-2-sec-4-2-ss-2 cml:asserts concept:act-sch-2-sec-4-2-ss-2-logic-deontic-1 .
concept:act-sch-2-sec-4-2-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Obligation to not make misleading representations." ;
    cml:premiseText "Party or other person makes a representation about a future matter." ;
    cml:conclusionText "Party or other person did not have reasonable grounds for making the representation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-4-2-ss-2 cml:asserts concept:act-sch-2-sec-4-2-ss-2-logic-deontic-2 .
