doc:sch-2-sec-138b-ss-4 a cof:Section ;
    cof:title "138B(4) Conferring jurisdiction on State and Territory Courts" ;
    values:kind "subsection" ;
    values:originalText "(4) The jurisdiction conferred by subsection (1) on the several courts of the Territories is conferred to the extent that the Constitution permits." ;
    cof:pageNumber "329"^^xsd:integer .

concept:act-sch-2-sec-138b-ss-5 a cml:Concept ;
    skos:prefLabel "138B(5) Conferring jurisdiction on State and Territory Courts"@en ;
    cml:realizedBy doc:sch-2-sec-138b-ss-5 ;
    values:originalText "(5) This section is not to be taken to enable an inferior court of a State or a Territory to grant a remedy other than a remedy of a kind that the court is able to grant under the law of that State or Territory." ;
    skos:definition "(5) This section is not to be taken to enable an inferior court of a State or a Territory to grant a remedy other than a remedy of a kind that the court is able to grant under the law of that State or Territory."@en ;
    cml:integrityHash "e891586db7cc4434d57f83456211316adcd013538e65aa1128fab5b50731e0d6" ;
    values:partOf concept:act-sch-2-sec-138b ;
    cof:pageNumber "329"^^xsd:integer ;
    skos:note "Court cannot grant remedy beyond its jurisdiction" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.329" ;
