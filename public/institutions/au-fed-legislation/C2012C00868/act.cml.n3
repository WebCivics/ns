    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Interval" ;
    cml:logicSummary "Temporal interval for representation" ;
    cml:premiseText "(i) that the person invites (whether by advertisement or otherwise) other persons to engage or participate in, or" ;
    cml:conclusionText "The temporal interval is from the time of invitation." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-158-3 cml:asserts concept:act-sch-2-sec-158-3-logic-ltl-3 .
concept:act-sch-2-sec-158-3-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "Recurring Trace" ;
    cml:logicSummary "Recurring trace for representation" ;
    cml:premiseText "(ii) that requires the performance of work by other persons," ;
    cml:conclusionText "The recurring trace is from the time of requirement." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-158-3 cml:asserts concept:act-sch-2-sec-158-3-logic-deontic-4 .
concept:act-sch-2-sec-158-3-logic-deontic-4 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Strict Liability" ;
    cml:logicSummary "Strict liability for false or misleading representation" ;
    cml:premiseText "(3) Subsections (1) and (2) are offences of strict liability." ;
    cml:conclusionText "The person is strictly liable for the false or misleading representation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-158-3 cml:asserts concept:act-sch-2-sec-158-3-logic-diffusion-5 .
concept:act-sch-2-sec-158-3-logic-diffusion-5 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffuse" ;
    cml:logicSummary "Diffusion of penalty" ;
    cml:premiseText "(a) if the person is a body corporate—$1,100,000;" ;
    cml:conclusionText "The penalty is diffused to all persons who are bodies corporate." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-2-sec-158-3 a cof:Section ;
    cof:title "158 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)" ;
    values:kind "section" ;
    values:originalText "(b) the representation is false or misleading in a material particular; and  (c) the representation concerns the profitability, risk or any other material aspect of any business activity:  (i) that the person invites (whether by advertisement or otherwise) other persons to engage or participate in, or to offer or apply to engage or participate in; and  (ii) that requires the performance of work by other persons, or the investment of money by other persons and the performance by them of work associated with the investment. Penalty:  (a) if the person is a body corporate—$1,100,000; or  (b) if the person is not a body corporate—$220,000.  (3) Subsections (1) and (2) are offences of strict liability." ;
    cof:pageNumber "164"^^xsd:integer .

concept:act-sch-2-sec-160-2 a cml:Concept ;
    skos:prefLabel "160 Application of provisions of this Division to information"@en ;
    cml:realizedBy doc:sch-2-sec-160-2 ;
    values:originalText "providers  (1) Sections 151, 152, 155, 156 and 159 do not apply to a publication of matter by an information provider if:  (a) in any case—the information provider made the publication in the course of carrying on a business of providing information; or  (b) if the information provider is the Australian Broadcasting Corporation, the Special Broadcasting Service Corporation or the holder of a licence granted under the Broadcasting Services Act 1992—the publication was by way of a radio or television broadcast by the information provider.  (2) Subsection (1) does not apply to a publication of an advertisement.  (3) Subsection (1) does not apply to a publication of matter in connection with the supply or possible supply of, or the promotion by any means of the supply or use of, goods or services (the publicised goods or services), if:  (a) the publicised goods or services were goods or services of a kind supplied by the information provider or, if the ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010 information provider is a body corporate, by a body corporate that is related to the information provider; or  (b) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a person who supplies goods or services of the same kind as the publicised goods or services; or  (c) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a body corporate that is related to a body corporate that supplies goods or services of the same kind as the publicised goods or services.  (4) Subsection (1) does not apply to a publication of matter in connection with the sale or grant, or possible sale or grant, of, or the promotion by any means of the sale or grant of, interests in land (the publicised interests in land), if:  (a) the publicised interests in land were interests of a kind sold or granted by the information provider or, if the information provider is a body corporate, by a body corporate that is related to the information provider; or  (b) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a person who sells or grants interests of the same kind as the publicised interests in land; or  (c) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a body corporate that is related to a body corporate that sells or grants interests of the same kind as the publicised interests in land. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "providers  (1) Sections 151, 152, 155, 156 and 159 do not apply to a publication of matter by an information provider if:  (a) in any case—the information provider made the publication in the course of carrying on a business of providing information; or  (b) if the information provider is the Australian Broadcasting Corporation, the Special Broadcasting Service Corporation or the holder of a licence granted under the Broadcasting Services Act 1992—the publication was by way of a radio or television broadcast by the information provider.  (2) Subsection (1) does not apply to a publication of an advertisement.  (3) Subsection (1) does not apply to a publication of matter in connection with the supply or possible supply of, or the promotion by any means of the supply or use of, goods or services (the publicised goods or services), if:  (a) the publicised goods or services were goods or services of a kind supplied by the information provider or, if the ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010 information provider is a body corporate, by a body corporate that is related to the information provider; or  (b) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a person who supplies goods or services of the same kind as the publicised goods or services; or  (c) the publication was made on behalf of, or pursuant to a contract, arrangement or understanding with, a body corporate that is related to a body corporate that supplies goods or services of the same kind as the publicised goods or services.  (4) Subsection (1) does not apply to a publication of matter in connection with the sale or grant, or possible sale or grant, of, or the promotion by any means of the sale or grant of, interests in land (the publicised interests in land), if:  (a) the publicised interests in land were interests of a kind sold or granted by the i"@en ;
    cml:integrityHash "1e19bab29bc6432a45375515ae332f5fc9540db0100ac0b05c3ccb42923c189d" ;
