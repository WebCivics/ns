    cof:title "234(2) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)" ;
    values:kind "subsection" ;
    values:originalText "(2) Despite subsection (1), this section does not apply to a representation of a kind referred to in item 4 or 5 in the first column of the table in that subsection if the representation is made together with another representation of a kind referred to in item 1 or 2 in that first column." ;
    cof:pageNumber "240"^^xsd:integer .

concept:act-sch-2-sec-234-3-ss-3 a cml:Concept ;
    skos:prefLabel "234(3) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-234-3-ss-3 ;
    values:originalText "(3) Goods are substantially transformed in a country if they undergo a fundamental change in that country in form, appearance or nature such that the goods existing after the change are new and different goods from those existing before the change." ;
    skos:definition "(3) Goods are substantially transformed in a country if they undergo a fundamental change in that country in form, appearance or nature such that the goods existing after the change are new and different goods from those existing before the change."@en ;
    cml:integrityHash "2cf28282efa60b9a7b63070f2564ac6d04ac6e7fd2161f2f78ff2ead08773ef1" ;
    values:partOf concept:act-sch-2-sec-234-3 ;
    cof:pageNumber "240"^^xsd:integer ;
    skos:note "Goods must undergo a fundamental change to be considered substantially transformed." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
