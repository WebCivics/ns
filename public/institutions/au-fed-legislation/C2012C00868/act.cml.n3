doc:sch-2-sec-119-2-ss-2 a cof:Section ;
    cof:title "119(2) Supplying etc. product related services covered by a ban" ;
    values:kind "subsection" ;
    values:originalText "(2) A person must not, in trade or commerce, offer for supply product related services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    cof:pageNumber "127"^^xsd:integer .

concept:act-sch-2-sec-119-2-ss-3 a cml:Concept ;
    skos:prefLabel "119(3) Supplying etc. product related services covered by a ban"@en ;
    cml:realizedBy doc:sch-2-sec-119-2-ss-3 ;
    values:originalText "(3) If:  (a) a person supplies product related services in contravention of subsection (1); and  (b) another person suffers loss or damage:  (i) because of a defect in, or a dangerous characteristic of, consumer goods that results from the services being supplied; or  (ii) because of a reasonably foreseeable use (including a misuse) of consumer goods that results from the services being supplied; the other person is taken, for the purposes of this Schedule, to have suffered the loss or damage because of that supply. Subdivision D—Temporary exemption from mutual recognition principles" ;
    skos:definition "(3) If:  (a) a person supplies product related services in contravention of subsection (1); and  (b) another person suffers loss or damage:  (i) because of a defect in, or a dangerous characteristic of, consumer goods that results from the services being supplied; or  (ii) because of a reasonably foreseeable use (including a misuse) of consumer goods that results from the services being supplied; the other person is taken, for the purposes of this Schedule, to have suffered the loss or damage because of that supply. Subdivision D—Temporary exemption from mutual recognition principles"@en ;
    cml:integrityHash "802bd8efefb15d624f1e6447ca4e098f032cbe612e3b95edee64b22bc44b25bb" ;
    values:partOf concept:act-sch-2-sec-119-2 ;
    cof:pageNumber "127"^^xsd:integer ;
    skos:note "If a person supplies product related services in contravention of subsection (1), and another person suffers loss or damage, the other person is taken to have suffered the loss or damage." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
