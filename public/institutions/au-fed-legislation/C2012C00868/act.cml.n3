concept:act-sch-2-sec-281-2 a cml:Concept ;
    skos:prefLabel "281 Amount of liability of linked credit providers"@en ;
    cml:realizedBy doc:sch-2-sec-281-2 ;
    values:originalText "The liability of a linked credit provider to a consumer under section 278(1) in relation to a contract referred to in section 278(1) is limited to an amount that does not exceed the sum of:  (a) the amount financed under the tied loan contract, tied continuing credit contract, lease contract, contract of hire or contract of hire-purchase; and  (b) the amount of interest (if any), or damages in the nature of interest, allowed or awarded against the credit provider by the court in which the action in relation to the liability is taken; and  (c) the amount of costs (if any) awarded by that court against the credit provider or supplier, or both." ;
    skos:definition "The liability of a linked credit provider to a consumer under section 278(1) in relation to a contract referred to in section 278(1) is limited to an amount that does not exceed the sum of:  (a) the amount financed under the tied loan contract, tied continuing credit contract, lease contract, contract of hire or contract of hire-purchase; and  (b) the amount of interest (if any), or damages in the nature of interest, allowed or awarded against the credit provider by the court in which the action in relation to the liability is taken; and  (c) the amount of costs (if any) awarded by that court against the credit provider or supplier, or both."@en ;
    cml:integrityHash "ab045310e99cf07e52d9dd214c6d72f712c2dcc39818bc39600ae55da709b0c2" ;
    cof:pageNumber "264"^^xsd:integer ;
    skos:note "Limits liability of linked credit providers to a consumer." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.264" ;
    cml:asserts concept:act-sch-2-sec-281-2-norm .
