concept:act-sch-2-sec-156-3-ss-9 a cml:Concept ;
    skos:prefLabel "156(9) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-156-3-ss-9 ;
    values:originalText "(9) Subsection (7) does not apply if:  (a) the person offers to supply different goods or services as a replacement to the person (the customer) to whom the original supply was to be made; and  (b) the customer agrees to receive the different goods or services." ;
    skos:definition "(9) Subsection (7) does not apply if:  (a) the person offers to supply different goods or services as a replacement to the person (the customer) to whom the original supply was to be made; and  (b) the customer agrees to receive the different goods or services."@en ;
    cml:integrityHash "3fc91725c8a65a97d8f10a676c782aab6b1bbf02e46e5b392bee8abd78885054" ;
    values:partOf concept:act-sch-2-sec-156-3 ;
    cof:pageNumber "162"^^xsd:integer ;
    skos:note "Exemption from subsection (7) if replacement goods or services are offered and agreed upon." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
