concept:act-sch-2-sec-34-2 cml:asserts concept:act-sch-2-sec-34-2-logic-argumentation-5 .
concept:act-sch-2-sec-34-2-logic-argumentation-5 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "Implication" ;
    cml:logicSummary "Implication of promotional purpose on treatment of donations." ;
    cml:premiseText "(a) any donation of goods or services is treated as a supply of the goods or services;" ;
