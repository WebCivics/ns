doc:sch-2-sec-269-2-ss-2 a cof:Section ;
    cof:title "269(2) Termination of contracts for the supply of services" ;
    values:kind "subsection" ;
    values:originalText "(2) The termination takes effect:  (a) at the time the termination is made known to the supplier of the services (whether by words or by conduct indicating the consumer’s intention to terminate the contract); or  (b) if it is not reasonably practicable to communicate with the supplier of the services—at the time the consumer indicates, by means which are reasonable in the circumstances, his or her intention to terminate the contract." ;
    cof:pageNumber "252"^^xsd:integer .

concept:act-sch-2-sec-269-2-ss-3 a cml:Concept ;
    skos:prefLabel "269(3) Termination of contracts for the supply of services"@en ;
    cml:realizedBy doc:sch-2-sec-269-2-ss-3 ;
    values:originalText "(3) The consumer is entitled to recover, by action against the supplier of the services, a refund of:  (a) any money paid by the consumer for the services; and  (b) an amount that is equal to the value of any other consideration provided by the consumer for the services; to the extent that the consumer has not already consumed the services at the time the termination takes effect." ;
    skos:definition "(3) The consumer is entitled to recover, by action against the supplier of the services, a refund of:  (a) any money paid by the consumer for the services; and  (b) an amount that is equal to the value of any other consideration provided by the consumer for the services; to the extent that the consumer has not already consumed the services at the time the termination takes effect."@en ;
    cml:integrityHash "757ac78effe6b7032e2de43339bca2b29624cc7c5e25d613457bdb22a9c1707f" ;
    values:partOf concept:act-sch-2-sec-269-2 ;
    cof:pageNumber "252"^^xsd:integer ;
    skos:note "Consumer's right to recover refund of money and consideration for services" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.252" ;
    cml:asserts concept:act-sch-2-sec-269-2-ss-3-norm .
