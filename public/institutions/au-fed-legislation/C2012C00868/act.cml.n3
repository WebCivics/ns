concept:act-sch-2-sec-137d a cml:Concept ;
    skos:prefLabel "137D Compensation orders etc. arising out of unfair contract terms"@en ;
    cml:realizedBy doc:sch-2-sec-137d ;
    values:originalText "In determining whether to make an order under subsection 237(1) or 238(1) of the Australian Consumer Law in relation to:  (a) a contravention of a provision of Part 2-2 of the Australian Consumer Law; or ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010  (b) a term of a consumer contract that has been declared under section 250 of the Australian Consumer Law to be an unfair term; the court may have regard to the conduct of the parties to the proceeding referred to in that subsection since the contravention occurred or the declaration was made." ;
    skos:definition "In determining whether to make an order under subsection 237(1) or 238(1) of the Australian Consumer Law in relation to:  (a) a contravention of a provision of Part 2-2 of the Australian Consumer Law; or ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010  (b) a term of a consumer contract that has been declared under section 250 of the Australian Consumer Law to be an unfair term; the court may have regard to the conduct of the parties to the proceeding referred to in that subsection since the contravention occurred or the declaration was made."@en ;
    cml:integrityHash "2e158013c5feacc5825eb018c7f1d6b82e597e3f01063f7f0b307bafbf719c4e" ;
    cof:pageNumber "322"^^xsd:integer ;
    skos:note "Court may have regard to conduct of parties in proceedings since contravention occurred or declaration was made." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
