doc:sch-3-sec-12dn-ss-1 a cof:Section ;
    cof:title "12DN(1) Application of provisions of this Division to information" ;
    values:kind "subsection" ;
    values:originalText "(1) Sections 12DA, 12DB, 12DC and 12DF do not apply to a publication of matter by an information provider if:  (a) in any case—the information provider made the publication in the course of carrying on a business of providing information; or  (b) if the information provider is the Australian Broadcasting Corporation, the Special Broadcasting Service Corporation or the holder of a licence granted under the Broadcasting Services Act 1992—the publication was by way of a radio or television broadcast by the information provider. Exception—advertisements" ;
    cof:pageNumber "356"^^xsd:integer .

concept:act-sch-3-sec-12dn-ss-2 a cml:Concept ;
    skos:prefLabel "12DN(2) Application of provisions of this Division to information"@en ;
    cml:realizedBy doc:sch-3-sec-12dn-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply to a publication of an advertisement. ComLaw Authoritative Act C2012C00868  Amendment of the Corporations legislation  Schedule 3  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010 Exception—information provider connected with supply of financial services" ;
    skos:definition "(2) Subsection (1) does not apply to a publication of an advertisement. ComLaw Authoritative Act C2012C00868  Amendment of the Corporations legislation  Schedule 3  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010 Exception—information provider connected with supply of financial services"@en ;
    cml:integrityHash "2b6c380baa9af21f66e543ec862f606c5e89f6dbf674bf1a6a70a716378ed67b" ;
    values:partOf concept:act-sch-3-sec-12dn ;
    cof:pageNumber "356"^^xsd:integer ;
    skos:note "Exemption from subsection (1) for publications of advertisements" ;
