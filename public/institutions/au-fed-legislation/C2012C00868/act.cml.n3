concept:act-sch-2-sec-114-2 a cml:Concept ;
    skos:prefLabel "114 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-114-2 ;
    values:originalText "(b) the standard specifies, as alternative methods of complying with the standard (or part of the standard), 2 or more sets of requirements relating to goods of that kind; and  (c) the regulator gives to a supplier of goods of that kind a written request that the supplier nominate which of those sets of requirements the supplier intends to comply with as the supplier’s method of complying with the standard; the supplier must, within the period specified in the request, give to the regulator a written notice specifying which of those sets of requirements the supplier intends to comply with as the supplier’s method of complying with the standard. ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010" ;
    skos:definition "(b) the standard specifies, as alternative methods of complying with the standard (or part of the standard), 2 or more sets of requirements relating to goods of that kind; and  (c) the regulator gives to a supplier of goods of that kind a written request that the supplier nominate which of those sets of requirements the supplier intends to comply with as the supplier’s method of complying with the standard; the supplier must, within the period specified in the request, give to the regulator a written notice specifying which of those sets of requirements the supplier intends to comply with as the supplier’s method of complying with the standard. ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010"@en ;
    cml:integrityHash "bd994c70570c2e6ecafd7e795a623b3c32489c1c560adcb82b40e18f54500764" ;
    cof:pageNumber "120"^^xsd:integer ;
    skos:note "Supplier must comply with standard's requirements within specified period." ;
    dc:description "Written notice specifying which sets of requirements to comply with." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.120" ;
    cml:asserts concept:act-sch-2-sec-114-2-norm .
