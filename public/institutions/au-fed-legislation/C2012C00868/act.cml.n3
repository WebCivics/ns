concept:act-sch-2-sec-276a-ss-4 a cml:Concept ;
    skos:prefLabel "276A(4) Limitation in certain circumstances of liability of"@en ;
    cml:realizedBy doc:sch-2-sec-276a-ss-4 ;
    values:originalText "(4) This section is subject to any term of a contract between the manufacturer and the supplier imposing on the manufacturer a greater liability than the liability mentioned in subsection (1)." ;
    skos:definition "(4) This section is subject to any term of a contract between the manufacturer and the supplier imposing on the manufacturer a greater liability than the liability mentioned in subsection (1)."@en ;
