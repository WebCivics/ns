concept:act-sch-2-sec-322 a cml:Concept ;
    skos:prefLabel "322 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-322 ;
    values:originalText "(d) to have induced, or attempted to induce, a person, whether by threats or promises or otherwise, to contravene such a provision; or  (e) to have been in any way, directly or indirectly, knowingly concerned in, or party to, the contravention by a person of such a provision; or  (f) to have conspired with others to contravene such a provision." ;
    skos:definition "(d) to have induced, or attempted to induce, a person, whether by threats or promises or otherwise, to contravene such a provision; or  (e) to have been in any way, directly or indirectly, knowingly concerned in, or party to, the contravention by a person of such a provision; or  (f) to have conspired with others to contravene such a provision."@en ;
    cml:integrityHash "6e59eb1903c75e920405fda3160c27296dd0ac1b536174138c5865479634d1ad" ;
    cof:pageNumber "328"^^xsd:integer ;
    skos:note "Prohibition on inducing or being party to contravention of a provision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
