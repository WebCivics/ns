doc:sch-2-sec-172-3-ss-4 a cof:Section ;
    cof:title "172(4) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)" ;
    values:kind "subsection" ;
    values:originalText "(4) Subsection (2) does not apply to the dealer contacting the prospective consumer if:  (a) the dealer is not, or is not to be, the supplier of the goods or services to which the negotiations relate; and  (b) the contact relates to a supply by another supplier." ;
    cof:pageNumber "178"^^xsd:integer .

