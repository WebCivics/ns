    cml:modality cml:AllenInterval ;
    cml:operator "includes" ;
    cml:logicSummary "Temporal interval" ;
    cml:premiseText "Interest includes a right of occupancy of the land" ;
    cml:conclusionText "The temporal interval for interest includes a right of occupancy of the land" ;
