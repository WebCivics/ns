concept:act-sch-2-sec-132f a cml:Concept ;
    skos:prefLabel "132F Notification of conference"@en ;
    cml:realizedBy doc:sch-2-sec-132f ;
    values:originalText "(1) If one or more persons notify the Commission in accordance with a notice published under subsection 132E(2) that they wish the Commission to hold a conference, the Commission must:  (a) appoint a day, time and place for the holding of the conference; and  (b) give written notice to the Commonwealth Minister, and to each person who so notified the Commission, of that day, time and place. ComLaw Authoritative Act C2012C00868  Schedule 2  Application of the Australian Consumer Law" ;
    skos:definition "(1) If one or more persons notify the Commission in accordance with a notice published under subsection 132E(2) that they wish the Commission to hold a conference, the Commission must:  (a) appoint a day, time and place for the holding of the conference; and  (b) give written notice to the Commonwealth Minister, and to each person who so notified the Commission, of that day, time and place. ComLaw Authoritative Act C2012C00868  Schedule 2  Application of the Australian Consumer Law"@en ;
    cml:integrityHash "f33d93ecd2d496ff422e81b26ab219a0f822e8322ef35c37d32ed26ac7d7cce5" ;
    cof:pageNumber "281"^^xsd:integer ;
    skos:note "Commission must hold conference upon request." ;
    dc:description "written notice to Commonwealth Minister and notifiers" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.281" ;
