doc:sch-2-sec-139d-ss-5 a cof:Section ;
    cof:title "139D(5) Enforcement and recovery of certain fines" ;
    values:kind "subsection" ;
    values:originalText "(5) If the court allows the person to pay the fine by specified instalments:  (a) the enforcement order must not be executed unless the person fails to pay such an instalment at or before the time when it becomes payable; and  (b) if the person pays all those instalments—the enforcement order is taken to have been discharged." ;
    cof:pageNumber "336"^^xsd:integer .

concept:act-sch-2-sec-139d-ss-6 a cml:Concept ;
    skos:prefLabel "139D(6) Enforcement and recovery of certain fines"@en ;
    cml:realizedBy doc:sch-2-sec-139d-ss-6 ;
    values:originalText "(6) The term of a sentence of imprisonment imposed by an order under a law of a State or a Territory applied by section 15A of the Crimes Act 1914 (including an order described in subsection 15A(1AA) of that Act) in respect of a fine is to be calculated at the rate of one day’s imprisonment for each $25 of the amount of the fine that is from time to time unpaid." ;
    skos:definition "(6) The term of a sentence of imprisonment imposed by an order under a law of a State or a Territory applied by section 15A of the Crimes Act 1914 (including an order described in subsection 15A(1AA) of that Act) in respect of a fine is to be calculated at the rate of one day’s imprisonment for each $25 of the amount of the fine that is from time to time unpaid."@en ;
    cml:integrityHash "415a79a1376119154438aafd030d279d8a85a50a0247c2a00b6d8f6e2ce4167b" ;
    values:partOf concept:act-sch-2-sec-139d ;
    cof:pageNumber "336"^^xsd:integer ;
    skos:note "Term of imprisonment for unpaid fine" ;
    cml:curationStatus cml:Proposed ;
