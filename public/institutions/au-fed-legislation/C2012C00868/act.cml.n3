concept:act-sch-2-sec-168-2 a cml:Concept ;
    skos:prefLabel "168 Harassment and coercion"@en ;
    cml:realizedBy doc:sch-2-sec-168-2 ;
    values:originalText "(1) A person commits an offence if:  (a) the person uses physical force, or undue harassment or coercion; and  (b) the physical force, or undue harassment or coercion is used in connection with:  (i) the supply or possible supply of goods or services; or  (ii) the payment for goods or services; or  (iii) the sale or grant, or the possible sale or grant, of an interest in land; or  (iv) the payment for an interest in land. Penalty:  (a) if the person is a body corporate—$1,100,000; or  (b) if the person is not a body corporate—$220,000. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "(1) A person commits an offence if:  (a) the person uses physical force, or undue harassment or coercion; and  (b) the physical force, or undue harassment or coercion is used in connection with:  (i) the supply or possible supply of goods or services; or  (ii) the payment for goods or services; or  (iii) the sale or grant, or the possible sale or grant, of an interest in land; or  (iv) the payment for an interest in land. Penalty:  (a) if the person is a body corporate—$1,100,000; or  (b) if the person is not a body corporate—$220,000. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law"@en ;
    cml:integrityHash "e73d341bebdb974f4278aaaa2cf18c65b5606bb733fae8e431592b9060f9cc62" ;
    cof:pageNumber "173"^^xsd:integer ;
    skos:note "Using physical force, undue harassment, or coercion in specified contexts is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.173" ;
    cml:asserts concept:act-sch-2-sec-168-2-norm .
