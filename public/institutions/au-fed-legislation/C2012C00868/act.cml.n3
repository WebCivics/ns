concept:act-sch-2-sec-101-2-ss-1 a cml:Concept ;
    skos:prefLabel "101(1) Consumer may request an itemised bill"@en ;
    cml:realizedBy doc:sch-2-sec-101-2-ss-1 ;
    values:originalText "(1) If a person (the supplier), in trade or commerce, supplies services to a consumer, the consumer may request that the supplier give the consumer an itemised bill that:  (a) specifies how the price of the services was calculated; and  (b) includes, if applicable, the number of hours of labour that related to the supply of the services and the hourly rate for that labour; and  (c) includes, if applicable, a list of the materials used to supply the services and the amount charged for those materials." ;
    skos:definition "(1) If a person (the supplier), in trade or commerce, supplies services to a consumer, the consumer may request that the supplier give the consumer an itemised bill that:  (a) specifies how the price of the services was calculated; and  (b) includes, if applicable, the number of hours of labour that related to the supply of the services and the hourly rate for that labour; and  (c) includes, if applicable, a list of the materials used to supply the services and the amount charged for those materials."@en ;
    cml:integrityHash "e60658bf9e933589ca753e8fdb5164fbd8411fb2629bc06b5aab11927af617a8" ;
    values:partOf concept:act-sch-2-sec-101-2 ;
    cof:pageNumber "114"^^xsd:integer ;
    skos:note "Supplier must provide itemised bill to consumer upon request." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
