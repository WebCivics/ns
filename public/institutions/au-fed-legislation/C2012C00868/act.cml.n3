concept:act-sch-2-sec-140c a cml:Concept ;
    skos:prefLabel "140C Federal Court may exercise jurisdiction under application"@en ;
    cml:realizedBy doc:sch-2-sec-140c ;
    values:originalText "laws of Territories  The Federal Court may exercise jurisdiction (whether original or appellate) conferred on that Court by an application law of a Territory with respect to matters arising under the applied Australian Consumer Law." ;
