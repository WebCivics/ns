concept:act-sch-2-sec-77-2 a cml:Concept ;
    skos:prefLabel "77 Liability of suppliers for contraventions by dealers"@en ;
    cml:realizedBy doc:sch-2-sec-77-2 ;
    values:originalText "If:  (a) a dealer contravenes a provision of this Subdivision in relation to an unsolicited consumer agreement; and  (b) the dealer is not, or is not to be, the supplier of the goods or services to which the agreement relates; the supplier of the goods or services is also taken to have contravened that provision in relation to the agreement. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "If:  (a) a dealer contravenes a provision of this Subdivision in relation to an unsolicited consumer agreement; and  (b) the dealer is not, or is not to be, the supplier of the goods or services to which the agreement relates; the supplier of the goods or services is also taken to have contravened that provision in relation to the agreement. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law"@en ;
    cml:integrityHash "89c8b70271bdec553e220d5125472ed39f0479e52f6c0b1662dee429e1286e9a" ;
    cof:pageNumber "99"^^xsd:integer ;
    skos:note "Supplier of goods or services also liable for contraventions by dealers" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.99" ;
