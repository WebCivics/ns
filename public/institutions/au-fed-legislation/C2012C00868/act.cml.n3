doc:sch-2-sec-178-2-ss-1 a cof:Section ;
    cof:title "178(1) Obligations of suppliers on termination" ;
    values:kind "subsection" ;
    values:originalText "(1) The supplier under an unsolicited consumer agreement commits an offence if:  (a) the agreement is terminated in accordance with section 82; and  (b) the supplier does not, immediately upon being notified of the termination, return or refund to the consumer under the agreement any consideration (or the value of any consideration) that the consumer gave under the agreement or a related contract or instrument. Penalty:  (a) if the person is a body corporate—$50,000; or  (b) if the person is not a body corporate—$10,000." ;
    cof:pageNumber "182"^^xsd:integer .

concept:act-sch-2-sec-178-2-ss-2 a cml:Concept ;
    skos:prefLabel "178(2) Obligations of suppliers on termination"@en ;
    cml:realizedBy doc:sch-2-sec-178-2-ss-2 ;
    values:originalText "(2) Subsection (1) is an offence of strict liability." ;
    skos:definition "(2) Subsection (1) is an offence of strict liability."@en ;
    cml:integrityHash "c567ddf47efaa5e0ffaa5e6fb964b73c79feb99480fc64b1f194d45392f4ff4e" ;
    values:partOf concept:act-sch-2-sec-178-2 ;
