concept:act-sch-2-sec-88-2 a cml:Concept ;
    skos:prefLabel "88 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-88-2 ;
    values:originalText "(i) the provisions of the law of a country other than Australia;  (ii) the provisions of the law of a State or a Territory; the provisions of this Division apply in relation to the supply under the contract despite that term." ;
    skos:definition "(i) the provisions of the law of a country other than Australia;  (ii) the provisions of the law of a State or a Territory; the provisions of this Division apply in relation to the supply under the contract despite that term."@en ;
