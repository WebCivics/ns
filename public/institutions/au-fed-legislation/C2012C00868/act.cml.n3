concept:act-sch-5-sec-98 a cml:Concept ;
    skos:prefLabel "98 Subsection 87(6)"@en ;
    cml:realizedBy doc:sch-5-sec-98 ;
    values:originalText "Repeal the subsection, substitute:  (6) In subsection (2), interest, in relation to land, means:  (a) a legal or equitable estate or interest in the land; or  (b) a right of occupancy of the land, or of a building or part of a building erected on the land, arising by virtue of the holding of shares, or by virtue of a contract to purchase shares, in an incorporated company that owns the land or building; or  (c) a right, power or privilege over, or in connection with, the land. ComLaw Authoritative Act C2012C00868  Other amendments of the Trade Practices Act 1974  Schedule 5  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010" ;
    skos:definition "Repeal the subsection, substitute:  (6) In subsection (2), interest, in relation to land, means:  (a) a legal or equitable estate or interest in the land; or  (b) a right of occupancy of the land, or of a building or part of a building erected on the land, arising by virtue of the holding of shares, or by virtue of a contract to purchase shares, in an incorporated company that owns the land or building; or  (c) a right, power or privilege over, or in connection with, the land. ComLaw Authoritative Act C2012C00868  Other amendments of the Trade Practices Act 1974  Schedule 5  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010"@en ;
    cml:integrityHash "44f7835bc0b12bdc8c119ef870e74348f1b128f0af0cf6dab8aa308bd1b03d77" ;
    cof:pageNumber "378"^^xsd:integer ;
    skos:note "Defines interest in relation to land" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.378" ;
    cml:asserts concept:act-sch-5-sec-98-norm .
concept:act-sch-5-sec-98-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:act-sch-5-sec-98 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
