concept:act-sch-2-sec-132c a cml:Concept ;
    skos:prefLabel "132C Notification of conference"@en ;
    cml:realizedBy doc:sch-2-sec-132c ;
    values:originalText "(1) If one or more persons notify the Commission in accordance with a proposed ban notice, or a proposed recall notice, that they wish the Commission to hold a conference, the Commission must:  (a) appoint a day, time and place for the holding of the conference; and  (b) give written notice to the Commonwealth Minister, and to each person who so notified the Commission, of that day, time and place.  (2) The day appointed must be at least 5 days, but not more than 14 days, after the end of the period:  (a) for a proposed ban notice—specified under paragraph 132(3)(e); or  (b) for a proposed recall notice—specified under paragraph 132A(3)(e). ComLaw Authoritative Act C2012C00868  Schedule 2  Application of the Australian Consumer Law" ;
    skos:definition "(1) If one or more persons notify the Commission in accordance with a proposed ban notice, or a proposed recall notice, that they wish the Commission to hold a conference, the Commission must:  (a) appoint a day, time and place for the holding of the conference; and  (b) give written notice to the Commonwealth Minister, and to each person who so notified the Commission, of that day, time and place.  (2) The day appointed must be at least 5 days, but not more than 14 days, after the end of the period:  (a) for a proposed ban notice—specified under paragraph 132(3)(e); or  (b) for a proposed recall notice—specified under paragraph 132A(3)(e). ComLaw Authoritative Act C2012C00868  Schedule 2  Application of the Australian Consumer Law"@en ;
    cml:integrityHash "bc0a3c65699f14bf0a5391a5dae460962a276264b61eb326bb16a646943fcbc1" ;
    cof:pageNumber "279"^^xsd:integer ;
    cml:hasPart concept:act-sch-2-sec-132c-ss-1 ;
    cml:hasPart concept:act-sch-2-sec-132c-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.279" .
