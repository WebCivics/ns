concept:act-sch-2-sec-87-2 a cml:Concept ;
    skos:prefLabel "87 Repayment of payments received after termination"@en ;
    cml:realizedBy doc:sch-2-sec-87-2 ;
    values:originalText "If an unsolicited consumer agreement is terminated in accordance with section 82, the supplier under the agreement must immediately refund to the consumer under the agreement any payment:  (a) that the consumer, or a person acting on the consumer’s behalf, makes to the supplier after the termination; and  (b) that purports to be made under the agreement or a related contract or instrument. Note: A pecuniary penalty may be imposed for a contravention of this section." ;
    skos:definition "If an unsolicited consumer agreement is terminated in accordance with section 82, the supplier under the agreement must immediately refund to the consumer under the agreement any payment:  (a) that the consumer, or a person acting on the consumer’s behalf, makes to the supplier after the termination; and  (b) that purports to be made under the agreement or a related contract or instrument. Note: A pecuniary penalty may be imposed for a contravention of this section."@en ;
    cml:integrityHash "f9980a4e33eccbf2452f4693d20ae6cc3d6245de5cde02b2153c52e2e192561d" ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "Supplier must refund payments made after termination." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.107" ;
    cml:asserts concept:act-sch-2-sec-87-2-norm .
