concept:act-sch-2-sec-314-ss-5 a cml:Concept ;
    skos:prefLabel "314(5) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-314-ss-5 ;
    values:originalText "(5) Occupational liability is civil liability arising directly or vicariously from anything done or omitted by a person who:  (a) does or omits to do the thing in the course of his or her profession, trade or occupation; and  (b) is a member of a body:  (i) that represents the interests of persons who have the same profession, trade or occupation; and  (ii) whose membership is limited principally to such persons." ;
    skos:definition "(5) Occupational liability is civil liability arising directly or vicariously from anything done or omitted by a person who:  (a) does or omits to do the thing in the course of his or her profession, trade or occupation; and  (b) is a member of a body:  (i) that represents the interests of persons who have the same profession, trade or occupation; and  (ii) whose membership is limited principally to such persons."@en ;
    cml:integrityHash "90875d27eecee33ad51d86f4468ebde13eb3916eda9acb1b7a8f2484858bf8d8" ;
    values:partOf concept:act-sch-2-sec-314 ;
    cof:pageNumber "320"^^xsd:integer ;
    skos:note "Occupational liability is civil liability arising directly or vicariously from anything done or omitted by a person who meets certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
