concept:act-sch-2-sec-332-ss-5 a cml:Concept ;
    skos:prefLabel "332(5) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-332-ss-5 ;
