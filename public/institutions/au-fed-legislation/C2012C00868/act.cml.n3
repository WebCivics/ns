concept:act-sch-2-sec-42-3 a cml:Concept ;
    skos:prefLabel "42 Liability of recipient for unsolicited services"@en ;
    cml:realizedBy doc:sch-2-sec-42-3 ;
    values:originalText "If a person, in trade or commerce, supplies unsolicited services to another person, the other person:  (a) is not liable to make any payment for the services; and  (b) is not liable for loss or damage as a result of the supply of the services." ;
    skos:definition "If a person, in trade or commerce, supplies unsolicited services to another person, the other person:  (a) is not liable to make any payment for the services; and  (b) is not liable for loss or damage as a result of the supply of the services."@en ;
    cml:integrityHash "e96bd65386a92ca33c6c766af0b4bd8ddfa08f10c1cd4ef53a7b004521e59d61" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "No liability for unsolicited services" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
