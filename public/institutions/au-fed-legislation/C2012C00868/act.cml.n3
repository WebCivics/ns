concept:act-sch-2-sec-230-2 a cml:Concept ;
    skos:prefLabel "230 Certain indemnities not authorised and certain documents void"@en ;
    cml:realizedBy doc:sch-2-sec-230-2 ;
    values:originalText "(1) Section 229 does not authorise anything that would otherwise be unlawful.  (2) Anything that purports to indemnify a person against a liability is void to the extent that it contravenes section 229. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "(1) Section 229 does not authorise anything that would otherwise be unlawful.  (2) Anything that purports to indemnify a person against a liability is void to the extent that it contravenes section 229. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law"@en ;
    cml:integrityHash "46577866b890b8b0be2e3b1dbd901502ff88965e1de12ced2b82dc4ad4911b50" ;
    cof:pageNumber "221"^^xsd:integer ;
