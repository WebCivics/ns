doc:sch-2-sec-119-2-ss-1 a cof:Section ;
    cof:title "119(1) Supplying etc. product related services covered by a ban" ;
    values:kind "subsection" ;
    values:originalText "(1) A person must not, in trade or commerce, supply product related services of a particular kind if:  (a) an interim ban on services of that kind is in force in the place where the supply occurs; or  (b) a permanent ban on services of that kind is in force. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    cof:pageNumber "127"^^xsd:integer .

concept:act-sch-2-sec-119-2-ss-2 a cml:Concept ;
    skos:prefLabel "119(2) Supplying etc. product related services covered by a ban"@en ;
    cml:realizedBy doc:sch-2-sec-119-2-ss-2 ;
    values:originalText "(2) A person must not, in trade or commerce, offer for supply product related services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    skos:definition "(2) A person must not, in trade or commerce, offer for supply product related services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection."@en ;
    cml:integrityHash "eb77028d216fa507cc3135617e00c2b9958c8b9a4f36257e138d80f716a627c6" ;
    values:partOf concept:act-sch-2-sec-119-2 ;
    cof:pageNumber "127"^^xsd:integer ;
    skos:note "Prohibition on offering product-related services covered by a ban" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
