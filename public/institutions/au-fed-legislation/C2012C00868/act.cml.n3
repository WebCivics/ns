doc:sch-2-sec-171-2-ss-1 a cof:Section ;
    cof:title "171(1) Disclosing purpose and identity" ;
    values:kind "subsection" ;
    values:originalText "(1) A dealer commits an offence if the dealer:  (a) calls on a person for the purpose of negotiating an unsolicited consumer agreement, or for an incidental or related purpose; and  (b) does not as soon as practicable and in any event before starting to negotiate:  (i) clearly advise the person that the dealer’s purpose is to seek the person’s agreement to a supply of the goods or services concerned; and ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010  (ii) clearly advise the person that the dealer is obliged to leave the premises immediately on request; and  (iii) provide to the person such information relating to the dealer’s identity as is prescribed by the regulations made for the purposes of section 74(c). Penalty:  (a) if the person is a body corporate—$50,000; or  (b) if the person is not a body corporate—$10,000." ;
    cof:pageNumber "176"^^xsd:integer .

concept:act-sch-2-sec-171-2-ss-2 a cml:Concept ;
    skos:prefLabel "171(2) Disclosing purpose and identity"@en ;
    cml:realizedBy doc:sch-2-sec-171-2-ss-2 ;
    values:originalText "(2) Subsection (1) is an offence of strict liability." ;
    skos:definition "(2) Subsection (1) is an offence of strict liability."@en ;
    cml:integrityHash "c567ddf47efaa5e0ffaa5e6fb964b73c79feb99480fc64b1f194d45392f4ff4e" ;
    values:partOf concept:act-sch-2-sec-171-2 ;
