    cml:conclusionText "...the representation is not misleading." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-2-sec-29-2-ss-3 a cof:Section ;
    cof:title "29(3) False or misleading representations about goods or services" ;
    values:kind "subsection" ;
    values:originalText "(3) To avoid doubt, subsection (2) does not:  (a) have the effect that, merely because such evidence to the contrary is adduced, the representation is not misleading; or  (b) have the effect of placing on any person an onus of proving that the representation is not misleading." ;
    cof:pageNumber "60"^^xsd:integer .

