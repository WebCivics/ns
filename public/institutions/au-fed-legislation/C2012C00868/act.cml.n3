    skos:prefLabel "1 Definitions"@en ;
    cml:realizedBy doc:sch-7-sec-1-9 ;
    values:originalText "In this Schedule: Australian Consumer Law has the same meaning as in Part XI of the Competition and Consumer Act 2010 as substituted by Schedule 2 to this Act. Commonwealth Minister has the same meaning as in the Australian Consumer Law." ;
