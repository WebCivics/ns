doc:sch-2-sec-132a-2-ss-2 a cof:Section ;
    cof:title "132A(2) Commonwealth Minister must issue a proposed recall notice" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not apply in relation to a recall notice if the Commonwealth Minister has issued a notice under section 132J certifying that the recall notice should be issued without delay." ;
    cof:pageNumber "278"^^xsd:integer .

concept:act-sch-2-sec-132a-2-ss-3 a cml:Concept ;
    skos:prefLabel "132A(3) Commonwealth Minister must issue a proposed recall notice"@en ;
    cml:realizedBy doc:sch-2-sec-132a-2-ss-3 ;
    values:originalText "(3) The proposed recall notice must:  (a) be in writing; and  (b) be published on the internet; and  (c) set out a copy of a draft recall notice; and  (d) set out a summary of the reasons for the proposed issue of the recall notice; and ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010  (e) invite any person who supplies, or proposes to supply, consumer goods of that kind to notify the Commission, in writing and within a period specified in the notice, if the person wishes the Commission to hold a conference in relation to the proposed issue of the recall notice." ;
    skos:definition "(3) The proposed recall notice must:  (a) be in writing; and  (b) be published on the internet; and  (c) set out a copy of a draft recall notice; and  (d) set out a summary of the reasons for the proposed issue of the recall notice; and ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010  (e) invite any person who supplies, or proposes to supply, consumer goods of that kind to notify the Commission, in writing and within a period specified in the notice, if the person wishes the Commission to hold a conference in relation to the proposed issue of the recall notice."@en ;
    cml:integrityHash "6062a18908b9a3cef5eb90aa0ddc7809b0caddbbf22a269976057778ba0b77b0" ;
    values:partOf concept:act-sch-2-sec-132a-2 ;
    cof:pageNumber "278"^^xsd:integer ;
    skos:note "Commonwealth Minister must issue a proposed recall notice" ;
    dc:description "proposed recall notice, summary of reasons for proposed recall notice" ;
    cml:curationStatus cml:Proposed ;
