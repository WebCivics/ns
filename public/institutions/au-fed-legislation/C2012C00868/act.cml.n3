doc:sch-2-sec-31-2-ss-3 a cof:Section ;
    cof:title "31(3) Misleading conduct relating to employment" ;
    values:kind "subsection" ;
    values:originalText "(3) Subsection (2) does not apply if:  (a) the person’s failure to provide the rebate, gift, prize or other free item in accordance with the offer was due to the act or omission of another person, or to some other cause beyond the person’s control; and  (b) the person took reasonable precautions and exercised due diligence to avoid the failure." ;
    cof:pageNumber "62"^^xsd:integer .

concept:act-sch-2-sec-31-2-ss-4 a cml:Concept ;
    skos:prefLabel "31(4) Misleading conduct relating to employment"@en ;
    cml:realizedBy doc:sch-2-sec-31-2-ss-4 ;
    values:originalText "(4) Subsection (2) does not apply to an offer that the person makes to another person if:  (a) the person offers to the other person a different rebate, gift, prize or other free item as a replacement; and  (b) the other person agrees to receive the different rebate, gift, prize or other free item. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "(4) Subsection (2) does not apply to an offer that the person makes to another person if:  (a) the person offers to the other person a different rebate, gift, prize or other free item as a replacement; and  (b) the other person agrees to receive the different rebate, gift, prize or other free item. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law"@en ;
    cml:integrityHash "b489d741e5b1206c3b86db1e9179700ffba5aa06be51a44b76b8e1aabf1c7f98" ;
    values:partOf concept:act-sch-2-sec-31-2 ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "Exemption from subsection (2) for offers of different items" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
