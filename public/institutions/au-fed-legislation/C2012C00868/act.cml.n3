concept:act-sch-2-sec-228-3 a cml:Concept ;
    skos:prefLabel "228 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-228-3 ;
    values:originalText "(a) the court is satisfied that the person has contravened, has attempted to contravene or has been involved in a contravention of any of the following provisions:  (i) a provision of Part 2-2 (which is about unconscionable conduct);  (ii) a provision of Part 3-1 (which is about unfair practices);  (iii) a provision (other than section 85) of Division 2 of" ;
    skos:definition "(a) the court is satisfied that the person has contravened, has attempted to contravene or has been involved in a contravention of any of the following provisions:  (i) a provision of Part 2-2 (which is about unconscionable conduct);  (ii) a provision of Part 3-1 (which is about unfair practices);  (iii) a provision (other than section 85) of Division 2 of"@en ;
    cml:integrityHash "70d703dff50f5daf5c78b976a937717e580f046fb6c551d177672c617c01b204" ;
    cof:pageNumber "234"^^xsd:integer ;
