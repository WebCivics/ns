concept:act-sch-2-sec-276 a cml:Concept ;
    skos:prefLabel "276 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-276 ;
    values:originalText "(2) The day appointed must be at least 5 days, but not more than 14 days, after the end of the period specified in the notice under subsection 132E(2).  (3) A notice under paragraph (1)(b) is not a legislative instrument." ;
