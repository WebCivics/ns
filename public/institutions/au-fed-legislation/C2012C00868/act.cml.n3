    skos:prefLabel "135K(3) Occupier etc. entitled to observe execution of search warrant"@en ;
    cml:realizedBy doc:sch-2-sec-135k-ss-3 ;
    values:originalText "(3) This section does not prevent the execution of the search warrant in 2 or more areas of the premises at the same time." ;
