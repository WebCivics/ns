doc:sch-2-sec-156-3-ss-9 a cof:Section ;
    cof:title "156(9) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)" ;
    values:kind "subsection" ;
    values:originalText "(9) Subsection (7) does not apply if:  (a) the person offers to supply different goods or services as a replacement to the person (the customer) to whom the original supply was to be made; and  (b) the customer agrees to receive the different goods or services." ;
    cof:pageNumber "162"^^xsd:integer .

