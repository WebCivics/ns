doc:sch-2-sec-107-2-ss-1 a cof:Section ;
    cof:title "107(1) Supplying etc. product related services that do not comply with" ;
    values:kind "subsection" ;
    values:originalText "(1) A person must not, in trade or commerce, supply product related services of particular kind if:  (a) a safety standard for services of that kind is in force; and  (b) those services do not comply with the standard. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    cof:pageNumber "119"^^xsd:integer .

concept:act-sch-2-sec-107-2-ss-2 a cml:Concept ;
    skos:prefLabel "107(2) Supplying etc. product related services that do not comply with"@en ;
    cml:realizedBy doc:sch-2-sec-107-2-ss-2 ;
    values:originalText "(2) A person must not, in trade or commerce, offer for supply product related services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    skos:definition "(2) A person must not, in trade or commerce, offer for supply product related services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection."@en ;
    cml:integrityHash "eb77028d216fa507cc3135617e00c2b9958c8b9a4f36257e138d80f716a627c6" ;
    values:partOf concept:act-sch-2-sec-107-2 ;
    cof:pageNumber "119"^^xsd:integer ;
    skos:note "Offering product-related services that do not comply with subsection (1) is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.119" ;
    cml:asserts concept:act-sch-2-sec-107-2-ss-2-norm .
