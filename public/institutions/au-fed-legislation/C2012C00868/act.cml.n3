concept:act-sch-2-sec-156-3-ss-11 a cml:Concept ;
    skos:prefLabel "156(11) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-156-3-ss-11 ;
    values:originalText "(11) Subsections (1), (3), (5) and (7) apply whether or not the payment or other consideration that the person accepted represents the whole or a part of the payment or other consideration for the supply of the goods or services." ;
    skos:definition "(11) Subsections (1), (3), (5) and (7) apply whether or not the payment or other consideration that the person accepted represents the whole or a part of the payment or other consideration for the supply of the goods or services."@en ;
    cml:integrityHash "04d15c1b24f7bfa49e4faaca9422052ee6768be04d7592a9397fdd5b1373726f" ;
    values:partOf concept:act-sch-2-sec-156-3 ;
    cof:pageNumber "162"^^xsd:integer ;
    skos:note "Payment or other consideration must be provided regardless of its proportion to the total payment or consideration." ;
    dc:description "True" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
