concept:act-sch-2-sec-234-3-ss-5 a cml:Concept ;
    skos:prefLabel "234(5) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-234-3-ss-5 ;
    values:originalText "(5) Item 2 of the table in subsection (1) applies to a representation that goods are the produce of a particular country whether the representation uses the words “product of”, “produce of” or any other grammatical variation of the word “produce”." ;
    skos:definition "(5) Item 2 of the table in subsection (1) applies to a representation that goods are the produce of a particular country whether the representation uses the words “product of”, “produce of” or any other grammatical variation of the word “produce”."@en ;
