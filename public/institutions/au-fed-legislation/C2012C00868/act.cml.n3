concept:act-sch-2-sec-198-3-ss-2 cml:asserts concept:act-sch-2-sec-198-3-ss-2-logic-deontic-1 .
concept:act-sch-2-sec-198-3-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "exemption" ;
    cml:logicSummary "Exempts certain individuals from liability" ;
    cml:premiseText "Subsection (1) does not apply to employees or agents of the defendant" ;
    cml:conclusionText "The exemption applies" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
