concept:act-sch-2-sec-138-4 a cml:Concept ;
    skos:prefLabel "138 Conferring jurisdiction on the Federal Court"@en ;
    cml:realizedBy doc:sch-2-sec-138-4 ;
    values:originalText "(1) Jurisdiction is conferred on the Federal Court in relation to any matter arising under this Part or the Australian Consumer Law in respect of which a civil proceeding has been instituted under this Part or the Australian Consumer Law.  (2) The jurisdiction conferred by subsection (1) on the Federal Court is exclusive of the jurisdiction of any other court other than:  (a) the jurisdiction of the Federal Magistrates Court under section 138A; and  (b) the jurisdiction of the several courts of the States and Territories under section 138B; and  (c) the jurisdiction of the High Court under section 75 of the Constitution." ;
    skos:definition "(1) Jurisdiction is conferred on the Federal Court in relation to any matter arising under this Part or the Australian Consumer Law in respect of which a civil proceeding has been instituted under this Part or the Australian Consumer Law.  (2) The jurisdiction conferred by subsection (1) on the Federal Court is exclusive of the jurisdiction of any other court other than:  (a) the jurisdiction of the Federal Magistrates Court under section 138A; and  (b) the jurisdiction of the several courts of the States and Territories under section 138B; and  (c) the jurisdiction of the High Court under section 75 of the Constitution."@en ;
    cml:integrityHash "26d1e97ce63ddb04a1824ab1680e16f3f54005f77d1d60d93f60b7afa4b57340" ;
    cof:pageNumber "328"^^xsd:integer ;
    cml:hasPart concept:act-sch-2-sec-138-4-ss-1 ;
    cml:hasPart concept:act-sch-2-sec-138-4-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.328" .
