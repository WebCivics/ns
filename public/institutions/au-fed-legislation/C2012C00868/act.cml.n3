concept:act-sch-2-sec-263-2-ss-5 a cml:Concept ;
    skos:prefLabel "263(5) Consequences of rejecting goods"@en ;
    cml:realizedBy doc:sch-2-sec-263-2-ss-5 ;
    values:originalText "(5) The supplier cannot satisfy subsection (4)(a) by permitting the consumer to acquire goods from the supplier." ;
    skos:definition "(5) The supplier cannot satisfy subsection (4)(a) by permitting the consumer to acquire goods from the supplier."@en ;
