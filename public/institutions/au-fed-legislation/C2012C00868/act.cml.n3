doc:sch-2-sec-71-2 a cof:Section ;
    cof:title "71 Meaning of dealer" ;
    values:kind "section" ;
    values:originalText "A dealer is a person who, in trade or commerce:  (a) enters into negotiations with a consumer with a view to making an agreement for the supply of goods or services to the consumer; or ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010  (b) calls on, or telephones, a consumer for the purpose of entering into such negotiations; whether or not that person is, or is to be, the supplier of the goods or services." ;
    cof:pageNumber "96"^^xsd:integer .

concept:act-sch-2-sec-72-3 a cml:Concept ;
    skos:prefLabel "72 Meaning of negotiation"@en ;
    cml:realizedBy doc:sch-2-sec-72-3 ;
    values:originalText "A negotiation, in relation to an agreement or a proposed agreement, includes any discussion or dealing directed towards the making of the agreement or proposed agreement (whether or not the terms of the agreement or proposed agreement are open to any discussion or dealing). Subdivision B—Negotiating unsolicited consumer agreements" ;
    skos:definition "A negotiation, in relation to an agreement or a proposed agreement, includes any discussion or dealing directed towards the making of the agreement or proposed agreement (whether or not the terms of the agreement or proposed agreement are open to any discussion or dealing). Subdivision B—Negotiating unsolicited consumer agreements"@en ;
    cml:integrityHash "7cd4675b13055ce8c2b109477682ec26c61a5571998196c20a9c67bfcea43d1f" ;
    cof:pageNumber "97"^^xsd:integer ;
    skos:note "Defines a negotiation as any discussion or dealing directed towards making an agreement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
