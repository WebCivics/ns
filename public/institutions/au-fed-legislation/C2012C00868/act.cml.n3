doc:sch-2-sec-7-2-ss-2 a cof:Section ;
    cof:title "7(2) Meaning of manufacturer" ;
    values:kind "subsection" ;
    values:originalText "(2) For the purposes of subsection (1)(c):  (a) a name, brand or mark is taken to be applied to goods if:  (i) it is woven in, impressed on, worked into or annexed or affixed to the goods; or  (ii) it is applied to a covering, label, reel or thing in or with which the goods are supplied; and  (b) if the name of a person, a name by which a person carries on business or a brand or mark of a person is applied to goods, it is presumed, unless the contrary is established, that the person caused or permitted the name, brand or mark to be applied to the goods." ;
    cof:pageNumber "40"^^xsd:integer .

concept:act-sch-2-sec-7-2-ss-3 a cml:Concept ;
    skos:prefLabel "7(3) Meaning of manufacturer"@en ;
    cml:realizedBy doc:sch-2-sec-7-2-ss-3 ;
    values:originalText "(3) If goods are imported into Australia on behalf of a person, the person is taken, for the purposes of paragraph (1)(e), to have imported the goods into Australia." ;
    skos:definition "(3) If goods are imported into Australia on behalf of a person, the person is taken, for the purposes of paragraph (1)(e), to have imported the goods into Australia."@en ;
    cml:integrityHash "2ec17d62e1930713ce42cf9af23359c7e6a1371301fc331c72374b8a6980bc14" ;
    values:partOf concept:act-sch-2-sec-7-2 ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Person is taken to have imported goods into Australia if goods are imported on their behalf." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
