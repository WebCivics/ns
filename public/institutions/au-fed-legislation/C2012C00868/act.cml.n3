concept:act-sch-2-sec-3-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator ">" ;
    cml:logicSummary "Threshold amount for consumer acquisition" ;
    cml:premiseText "$40,000; or" ;
    cml:conclusionText "$40,000" ;
