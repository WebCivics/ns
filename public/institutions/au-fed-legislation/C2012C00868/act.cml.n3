concept:act-sch-2-sec-266-2 a cml:Concept ;
    skos:prefLabel "266 Rights of gift recipients"@en ;
    cml:realizedBy doc:sch-2-sec-266-2 ;
    values:originalText "If a consumer acquires goods from a supplier and gives them to another person as a gift, the other person may, subject to any defence which would be available to the supplier against the consumer:  (a) exercise any rights or remedies under this Subdivision which would be available to the other person if he or she had acquired the goods from the supplier; and  (b) any reference in this Subdivision to a consumer includes a reference to the other person accordingly. Subdivision B—Action against suppliers of services" ;
    skos:definition "If a consumer acquires goods from a supplier and gives them to another person as a gift, the other person may, subject to any defence which would be available to the supplier against the consumer:  (a) exercise any rights or remedies under this Subdivision which would be available to the other person if he or she had acquired the goods from the supplier; and  (b) any reference in this Subdivision to a consumer includes a reference to the other person accordingly. Subdivision B—Action against suppliers of services"@en ;
    cml:integrityHash "8d8c5b15d12598be8e152582fea167b57024712e2afb9ecbe63654c5bf7b074f" ;
    cof:pageNumber "250"^^xsd:integer ;
    skos:note "Consumer's gift recipient has rights under the Subdivision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
