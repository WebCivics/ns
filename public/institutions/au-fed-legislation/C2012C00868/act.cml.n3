doc:sch-2-sec-229-2-ss-1 a cof:Section ;
    cof:title "229(1) Indemnification of officers" ;
    values:kind "subsection" ;
    values:originalText "(1) A body corporate (the first body), or a body corporate related to the first body, commits an offence if it indemnifies a person (whether by agreement or by making a payment and whether directly or through an interposed entity) against either of the following liabilities incurred as an officer (within the meaning of the Corporations Act 2001) of the first body:  (a) a liability to pay a pecuniary penalty under section 224;  (b) legal costs incurred in defending or resisting proceedings in which the person is found to have such a liability. Penalty: $2,750." ;
    cof:pageNumber "221"^^xsd:integer .

concept:act-sch-2-sec-229-2-ss-2 a cml:Concept ;
    skos:prefLabel "229(2) Indemnification of officers"@en ;
    cml:realizedBy doc:sch-2-sec-229-2-ss-2 ;
    values:originalText "(2) For the purposes of subsection (1), the outcome of proceedings is the outcome of the proceedings and any appeal in relation to the proceedings." ;
    skos:definition "(2) For the purposes of subsection (1), the outcome of proceedings is the outcome of the proceedings and any appeal in relation to the proceedings."@en ;
    cml:integrityHash "89c247d250913569a3fcc2293a498f9fba5da31fc37582299fe7126ae5f45522" ;
    values:partOf concept:act-sch-2-sec-229-2 ;
    cof:pageNumber "221"^^xsd:integer ;
    skos:note "Outcome of proceedings is the outcome of proceedings and any appeal in relation to the proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
