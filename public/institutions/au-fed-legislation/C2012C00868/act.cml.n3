doc:sch-2-sec-226-2 a cof:Section ;
    cof:title "226 Defence" ;
    values:kind "section" ;
    values:originalText "If, in proceedings under section 224 against a person other than a body corporate, it appears to a court that the person has, or may have:  (a) engaged in conduct in contravention of a provision referred to in subsection (1)(a) of that section; or  (b) engaged in conduct referred to in subsection (1)(b), (c), (d), (e) or (f) of that section that relates to a contravention of such a provision; but that the person acted honestly and reasonably and, having regard to all the circumstances of the case, ought fairly to be excused, the court may relieve the person either wholly or partly from liability to a pecuniary penalty under that section." ;
    cof:pageNumber "220"^^xsd:integer .

concept:act-sch-2-sec-227-2 a cml:Concept ;
    skos:prefLabel "227 Preference must be given to compensation for victims"@en ;
    cml:realizedBy doc:sch-2-sec-227-2 ;
    values:originalText "If a court considers that:  (a) it is appropriate to order a person (the defendant) to pay a pecuniary penalty under section 224 in relation to:  (i) a contravention of a provision referred to in subsection (1)(a) of that section; or  (ii) conduct referred to in subsection (1)(b), (c), (d), (e) or (f) of that section that relates to a contravention such a provision; and  (b) it is appropriate to order the defendant to pay compensation to a person who has suffered loss or damage as result of that contravention or conduct; and  (c) the defendant does not have sufficient financial resources to pay both the pecuniary penalty and the compensation; the court must give preference to making an order for compensation." ;
    skos:definition "If a court considers that:  (a) it is appropriate to order a person (the defendant) to pay a pecuniary penalty under section 224 in relation to:  (i) a contravention of a provision referred to in subsection (1)(a) of that section; or  (ii) conduct referred to in subsection (1)(b), (c), (d), (e) or (f) of that section that relates to a contravention such a provision; and  (b) it is appropriate to order the defendant to pay compensation to a person who has suffered loss or damage as result of that contravention or conduct; and  (c) the defendant does not have sufficient financial resources to pay both the pecuniary penalty and the compensation; the court must give preference to making an order for compensation."@en ;
    cml:integrityHash "e971d056836a36698c602f24e3247ee229d4e1a7594cdd6d839e232226e174dd" ;
    cof:pageNumber "220"^^xsd:integer ;
    skos:note "Court must give preference to making an order for compensation if defendant cannot pay both penalty and compensation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.220" ;
