concept:act-sch-2-sec-220-2 a cml:Concept ;
    skos:prefLabel "220 Extending periods for complying with substantiation notices"@en ;
    cml:realizedBy doc:sch-2-sec-220-2 ;
    values:originalText "(1) A person who has been given a substantiation notice may, at any time within 21 days after the notice was given to the person by the regulator, apply in writing to the regulator for an extension of the period for complying with the notice.  (2) The regulator may, by written notice given to the person, extend the period within which the person must comply with the notice." ;
    skos:definition "(1) A person who has been given a substantiation notice may, at any time within 21 days after the notice was given to the person by the regulator, apply in writing to the regulator for an extension of the period for complying with the notice.  (2) The regulator may, by written notice given to the person, extend the period within which the person must comply with the notice."@en ;
    cml:integrityHash "85f1483b4b678638eb4a83e2292991a6b43848bc7b736a39e283534115a76d16" ;
    cof:pageNumber "212"^^xsd:integer ;
