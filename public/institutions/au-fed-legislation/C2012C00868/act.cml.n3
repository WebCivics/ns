    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Supplier must avoid conduct causing personal injury." ;
    cml:premiseText "Supplier engages in conduct despite risk and without adequate justification." ;
    cml:conclusionText "Supplier's conduct is reckless if it causes personal injury." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-328-ss-5 cml:asserts concept:act-sch-2-sec-328-ss-5-logic-alleninterval-3 .
concept:act-sch-2-sec-328-ss-5-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "TemporalOverlap" ;
    cml:logicSummary "Conduct causing personal injury must overlap with supplier's awareness or reasonable suspicion of risk." ;
    cml:premiseText "Supplier engages in conduct despite risk and without adequate justification." ;
    cml:conclusionText "Conduct causing personal injury must overlap with supplier's awareness or reasonable suspicion of risk." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-328-ss-5 cml:asserts concept:act-sch-2-sec-328-ss-5-logic-ltl-4 .
concept:act-sch-2-sec-328-ss-5-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "TemporalRecurringTrace" ;
    cml:logicSummary "Conduct causing personal injury must be a recurring trace in supplier's conduct." ;
    cml:premiseText "Supplier engages in conduct despite risk and without adequate justification." ;
    cml:conclusionText "Conduct causing personal injury must be a recurring trace in supplier's conduct." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
