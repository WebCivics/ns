concept:act-sch-2-sec-140d a cml:Concept ;
    skos:prefLabel "140D Exercise of jurisdiction under cross-vesting provisions"@en ;
    cml:realizedBy doc:sch-2-sec-140d ;
    values:originalText "This Part does not affect the operation of any other law of the Commonwealth, or any law of a State or Territory, relating to cross-vesting of jurisdiction. ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010" ;
    skos:definition "This Part does not affect the operation of any other law of the Commonwealth, or any law of a State or Territory, relating to cross-vesting of jurisdiction. ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010"@en ;
    cml:integrityHash "14b05f932779b98793134c1fa7e4844bdab5783a48c8a6afafae1b5e5c87b54b" ;
    cof:pageNumber "342"^^xsd:integer ;
