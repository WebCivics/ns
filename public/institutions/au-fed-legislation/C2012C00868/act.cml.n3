doc:sch-2-sec-135n-ss-4 a cof:Section ;
    cof:title "135N(4) Return of seized consumer goods and equipment" ;
    values:kind "subsection" ;
    values:originalText "(4) Consumer goods that are required to be returned under this section must be returned to the person from whom they were seized (or to the owner if that person is not entitled to possess them)." ;
    cof:pageNumber "308"^^xsd:integer .

