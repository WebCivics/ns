concept:act-sch-2-sec-98-3 a cml:Concept ;
    skos:prefLabel "98 Termination of lay-by agreements by suppliers"@en ;
    cml:realizedBy doc:sch-2-sec-98-3 ;
    values:originalText "A supplier of consumer goods who is a party to a lay-by agreement must not terminate the agreement unless:  (a) the consumer who is a party to the agreement breached a term of the agreement; or  (b) the supplier is no longer engaged in trade or commerce; or  (c) the consumer goods to which the agreement relates are no longer available. Note: A pecuniary penalty may be imposed for a contravention of this section." ;
    skos:definition "A supplier of consumer goods who is a party to a lay-by agreement must not terminate the agreement unless:  (a) the consumer who is a party to the agreement breached a term of the agreement; or  (b) the supplier is no longer engaged in trade or commerce; or  (c) the consumer goods to which the agreement relates are no longer available. Note: A pecuniary penalty may be imposed for a contravention of this section."@en ;
    cml:integrityHash "3451d1f643db6ed4119ef69dd5e2605105af1b951c7f441039d7b562b3e83d27" ;
    cof:pageNumber "112"^^xsd:integer ;
    skos:note "Termination of lay-by agreements by suppliers under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
