concept:act-sch-2-sec-234-2 a cml:Concept ;
    skos:prefLabel "234 Interim injunctions"@en ;
    cml:realizedBy doc:sch-2-sec-234-2 ;
    values:originalText "(1) If an application is made under section 232, the court may, if it considers it is desirable to do so, grant an interim injunction under this subsection pending the determination of the application.  (2) If a responsible Minister or the regulator made the application under section 232, the court must not require the applicant or any ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "(1) If an application is made under section 232, the court may, if it considers it is desirable to do so, grant an interim injunction under this subsection pending the determination of the application.  (2) If a responsible Minister or the regulator made the application under section 232, the court must not require the applicant or any ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law"@en ;
    cml:integrityHash "b41eda7a7d4f8d378d55f63890deb9bf52a051b086d1c6616f84cc63610cbc89" ;
    cof:pageNumber "223"^^xsd:integer ;
