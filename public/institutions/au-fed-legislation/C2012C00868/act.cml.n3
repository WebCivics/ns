concept:act-sch-2-sec-200-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Must" ;
    cml:logicSummary "Defendant must not claim ignorance or reliance on false representation to avoid liability." ;
    cml:premiseText "Section 195 and section 204" ;
    cml:conclusionText "Defendant is liable for contravention of safety standard or information standard." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-200-3 cml:asserts concept:act-sch-2-sec-200-3-logic-deontic-2 .
concept:act-sch-2-sec-200-3-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Must" ;
    cml:logicSummary "Defendant must provide written notice identifying the person from whom services were acquired within 7 days before hearing commences." ;
    cml:premiseText "Subsection (2)" ;
    cml:conclusionText "Defendant is not entitled to rely on defence provided by subsection (1) unless leave is given or notice is served." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-200-3 cml:asserts concept:act-sch-2-sec-200-3-logic-deontic-3 .
