    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-3-sec-29-ss-4 a cof:Section ;
    cof:title "29(4) After section 12DM" ;
    values:kind "subsection" ;
    values:originalText "(4) A person:  (a) is not liable to make any payment to another person; and  (b) is entitled to recover by action in a court of competent jurisdiction against another person any payment made by the person to the other person; in full or part satisfaction of a charge for placing, in a publication, an advertisement for financial services or financial products, unless the person has authorised the publishing of the advertisement." ;
    cof:pageNumber "354"^^xsd:integer .

concept:act-sch-3-sec-29-ss-5 a cml:Concept ;
    skos:prefLabel "29(5) After section 12DM"@en ;
    cml:realizedBy doc:sch-3-sec-29-ss-5 ;
    values:originalText "(5) A person is not taken for the purposes of this section to have authorised the placing, in a publication, of an advertisement, unless:  (a) a document authorising the placing of the advertisement has been signed by the person or by another person authorised by him or her; and  (b) a copy of the document has been given to the person before the right to payment of a charge for the placing of the advertisement is asserted; and ComLaw Authoritative Act C2012C00868  Schedule 3  Amendment of the Corporations legislation" ;
    skos:definition "(5) A person is not taken for the purposes of this section to have authorised the placing, in a publication, of an advertisement, unless:  (a) a document authorising the placing of the advertisement has been signed by the person or by another person authorised by him or her; and  (b) a copy of the document has been given to the person before the right to payment of a charge for the placing of the advertisement is asserted; and ComLaw Authoritative Act C2012C00868  Schedule 3  Amendment of the Corporations legislation"@en ;
    cml:integrityHash "429baabe29f066186603d25472e97458d5afeacb3ae5b9b7c9a83cafda5838bb" ;
    values:partOf concept:act-sch-3-sec-29 ;
    cof:pageNumber "354"^^xsd:integer ;
    skos:note "A person must authorise the placing of an advertisement with a document signed by them or another authorised person." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
