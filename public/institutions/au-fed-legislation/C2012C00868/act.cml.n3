doc:sch-2-sec-133-3-ss-1 a cof:Section ;
    cof:title "133(1) Appointment of inspectors" ;
    values:kind "subsection" ;
    values:originalText "(1) The Chairperson may, in writing, appoint a member of the staff assisting the Commission as an inspector. ComLaw Authoritative Act C2012C00868  Application of the Australian Consumer Law  Schedule 2  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010" ;
    cof:pageNumber "284"^^xsd:integer .

concept:act-sch-2-sec-133-3-ss-2 a cml:Concept ;
    skos:prefLabel "133(2) Appointment of inspectors"@en ;
    cml:realizedBy doc:sch-2-sec-133-3-ss-2 ;
    values:originalText "(2) The Chairperson must not appoint a person as an inspector unless the Chairperson is satisfied that the person has suitable qualifications and experience to exercise properly the powers of an inspector." ;
