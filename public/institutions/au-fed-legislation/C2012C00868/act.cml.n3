doc:sch-2-sec-240-2-ss-1 a cof:Section ;
    cof:title "240(1) Determining whether to make a redress order etc. for non-party" ;
    values:kind "subsection" ;
    values:originalText "(1) A non-party consumer is bound by an order made under section 239(1) against a person if:  (a) the loss or damage suffered, or likely to be suffered, by the non-party consumer in relation to the contravening conduct, or the declared term, to which the order relates has been redressed, prevented or reduced in accordance with the order; and  (b) the non-party consumer has accepted the redress, prevention or reduction." ;
    cof:pageNumber "228"^^xsd:integer .

concept:act-sch-2-sec-240-2-ss-2 a cml:Concept ;
    skos:prefLabel "240(2) Determining whether to make a redress order etc. for non-party"@en ;
    cml:realizedBy doc:sch-2-sec-240-2-ss-2 ;
    values:originalText "(2) Any other order made under section 239(1) that relates to that loss or damage has no effect in relation to the non-party consumer." ;
    skos:definition "(2) Any other order made under section 239(1) that relates to that loss or damage has no effect in relation to the non-party consumer."@en ;
    cml:integrityHash "4ac0c6f2b76bf22bff97fd169d09cf3b0650940eb5990dd1aa4896c87da8f2a0" ;
    values:partOf concept:act-sch-2-sec-240-2 ;
    cof:pageNumber "228"^^xsd:integer ;
    skos:note "No effect on non-party consumer Consider conduct of person and non-party consumers in relation to declared term when determining whether to make an order under section 239(1)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.228" ;
    cml:asserts concept:act-sch-2-sec-240-2-ss-2-norm .
