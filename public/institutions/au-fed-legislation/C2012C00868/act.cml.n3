doc:sch-2-sec-135k-ss-1 a cof:Section ;
    cof:title "135K(1) Occupier etc. entitled to observe execution of search warrant" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a search warrant is being executed in relation to premises; and  (b) the occupier of the premises, or another person who apparently represents the occupier, is present at the premises; the occupier or other person is entitled to observe the execution of the warrant." ;
    cof:pageNumber "307"^^xsd:integer .

concept:act-sch-2-sec-135k-ss-2 a cml:Concept ;
    skos:prefLabel "135K(2) Occupier etc. entitled to observe execution of search warrant"@en ;
    cml:realizedBy doc:sch-2-sec-135k-ss-2 ;
    values:originalText "(2) The right to observe the execution of the search warrant ceases if the occupier or other person impedes that execution." ;
    skos:definition "(2) The right to observe the execution of the search warrant ceases if the occupier or other person impedes that execution."@en ;
    cml:integrityHash "0660fab1c55c0dfa55480c34b949b274199730354f8a324c8b46b2fd7465c81e" ;
    values:partOf concept:act-sch-2-sec-135k ;
