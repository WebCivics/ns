doc:sch-2-sec-203-2-ss-5 a cof:Section ;
    cof:title "203(5) Supplying etc. goods that do not comply with information" ;
    values:kind "subsection" ;
    values:originalText "(5) Subsection (1), (2) or (3) does not apply to goods that are intended to be used outside Australia." ;
    cof:pageNumber "198"^^xsd:integer .

concept:act-sch-2-sec-203-2-ss-6 a cml:Concept ;
    skos:prefLabel "203(6) Supplying etc. goods that do not comply with information"@en ;
    cml:realizedBy doc:sch-2-sec-203-2-ss-6 ;
    values:originalText "(6) Unless the contrary is established, it is presumed, for the purposes of this section, that goods are intended to be used outside Australia if either of the following is applied to the goods:  (a) a statement that the goods are for export only;  (b) a statement indicating, by the use of words authorised by regulations made for the purposes of section 136(6)(b) to be used for the purposes of section 136(6), that the goods are intended to be used outside Australia." ;
    skos:definition "(6) Unless the contrary is established, it is presumed, for the purposes of this section, that goods are intended to be used outside Australia if either of the following is applied to the goods:  (a) a statement that the goods are for export only;  (b) a statement indicating, by the use of words authorised by regulations made for the purposes of section 136(6)(b) to be used for the purposes of section 136(6), that the goods are intended to be used outside Australia."@en ;
    cml:integrityHash "86b0ba9b861d5aa88601b8d3ea9bcee0364b013593d3a701dc89de66445c0067" ;
    values:partOf concept:act-sch-2-sec-203-2 ;
    cof:pageNumber "198"^^xsd:integer ;
    skos:note "Goods intended for export only are presumed to be used outside Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.198" ;
    cml:asserts concept:act-sch-2-sec-203-2-ss-6-norm .
