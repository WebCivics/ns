doc:sch-2-sec-162-3-ss-5 a cof:Section ;
    cof:title "162(5) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)" ;
    values:kind "subsection" ;
    values:originalText "(5) Subsections (1), (2) and (3) are offences of strict liability." ;
