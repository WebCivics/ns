concept:act-sch-2-sec-63-2 a cml:Concept ;
    skos:prefLabel "63 Services to which this Subdivision does not apply"@en ;
    cml:realizedBy doc:sch-2-sec-63-2 ;
    values:originalText "This Subdivision does not apply to services that are, or are to be, supplied under:  (a) a contract for or in relation to the transportation or storage of goods for the purposes of a business, trade, profession or occupation carried on or engaged in by the person for whom the goods are transported or stored; or  (b) a contract of insurance. Subdivision C—Guarantees not to be excluded etc. by contract" ;
    skos:definition "This Subdivision does not apply to services that are, or are to be, supplied under:  (a) a contract for or in relation to the transportation or storage of goods for the purposes of a business, trade, profession or occupation carried on or engaged in by the person for whom the goods are transported or stored; or  (b) a contract of insurance. Subdivision C—Guarantees not to be excluded etc. by contract"@en ;
    cml:integrityHash "a85320f6b1210953a64f3b661ac546959ca2ca9c1cdcb208c4612caaba0d9852" ;
    cof:pageNumber "90"^^xsd:integer ;
    skos:note "Exemptions from application of Subdivision" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.90" ;
