concept:act-sch-2-sec-283-2-ss-3 a cml:Concept ;
    skos:prefLabel "283(3) Enforcement of judgments etc."@en ;
    cml:realizedBy doc:sch-2-sec-283-2-ss-3 ;
    values:originalText "(3) If, in joint liability proceedings, a right conferred by section 282(3) is established by a consumer against a linked credit provider, the consumer must not receive the benefit of the right unless:  (a) judgment has been given against the supplier and credit provider; and ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "(3) If, in joint liability proceedings, a right conferred by section 282(3) is established by a consumer against a linked credit provider, the consumer must not receive the benefit of the right unless:  (a) judgment has been given against the supplier and credit provider; and ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law"@en ;
    cml:integrityHash "1dbbe3c0cf22550ca02cccba2eda2c45950ebe10c933c37b44728b5990fea64f" ;
    values:partOf concept:act-sch-2-sec-283-2 ;
    cof:pageNumber "265"^^xsd:integer ;
    skos:note "Prohibition on consumer receiving benefit of right unless judgment is given against supplier and credit provider" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
