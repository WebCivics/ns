concept:act-sch-2-sec-120-2-ss-5 a cml:Concept ;
    skos:prefLabel "120(5) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-120-2-ss-5 ;
    values:originalText "(5) A person must not, in trade or commerce, export consumer goods the supply of which is prohibited by subsection (1) unless:  (a) the person applies, in writing, to the Commonwealth Minister for an approval to export those goods; and  (b) the Commonwealth Minister gives such an approval by written notice given to the person. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    skos:definition "(5) A person must not, in trade or commerce, export consumer goods the supply of which is prohibited by subsection (1) unless:  (a) the person applies, in writing, to the Commonwealth Minister for an approval to export those goods; and  (b) the Commonwealth Minister gives such an approval by written notice given to the person. Note: A pecuniary penalty may be imposed for a contravention of this subsection."@en ;
    cml:integrityHash "97090cb8bbe815c4df38b95286b8f9600f8736066e5cbfaed0573fb8b82c68ed" ;
    values:partOf concept:act-sch-2-sec-120-2 ;
    cof:pageNumber "126"^^xsd:integer ;
    skos:note "Prohibition on exporting consumer goods without approval" ;
    dc:description "Approval from the Commonwealth Minister" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
