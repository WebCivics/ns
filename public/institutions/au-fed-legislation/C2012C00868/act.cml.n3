    cml:hasPart concept:act-sch-2-sec-194-2-ss-4 ;
    cml:hasPart concept:act-sch-2-sec-194-2-ss-5 ;
    cml:hasPart concept:act-sch-2-sec-194-2-ss-6 ;
    cml:hasPart concept:act-sch-2-sec-194-2-ss-7 ;
