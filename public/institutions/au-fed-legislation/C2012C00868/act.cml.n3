concept:act-sch-2-sec-233-2 a cml:Concept ;
    skos:prefLabel "233 Consent injunctions"@en ;
    cml:realizedBy doc:sch-2-sec-233-2 ;
    values:originalText "If an application is made under section 232, the court may, if it considers that it is appropriate to do so, grant an injunction under this section by consent of all the parties to the proceedings, whether or not the court is satisfied as required by section 232(1)." ;
    skos:definition "If an application is made under section 232, the court may, if it considers that it is appropriate to do so, grant an injunction under this section by consent of all the parties to the proceedings, whether or not the court is satisfied as required by section 232(1)."@en ;
    cml:integrityHash "72203065fc6e268c7df7e682dfa5dce2d94dcd3377c4a9b97bd6c1a44183507d" ;
    cof:pageNumber "223"^^xsd:integer ;
    skos:note "Court may grant injunction by consent of all parties." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.223" ;
