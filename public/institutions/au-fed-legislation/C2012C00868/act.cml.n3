    cml:premiseText "The consumer's undisturbed possession may be lawfully disturbed by a person entitled to the benefit of any security, charge or encumbrance disclosed to the consumer before the consumer agreed to the supply." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-2-sec-52-3-ss-2 a cof:Section ;
    cof:title "52(2) Guarantee as to undisturbed possession" ;
    values:kind "subsection" ;
    values:originalText "(2) Subsection (1) does not apply to the extent that the consumer’s undisturbed possession of the goods may be lawfully disturbed by a person who is entitled to the benefit of any security, charge or encumbrance disclosed to the consumer before the consumer agreed to the supply." ;
    cof:pageNumber "83"^^xsd:integer .

