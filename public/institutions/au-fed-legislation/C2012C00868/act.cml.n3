    cof:pageNumber "403"^^xsd:integer ;
    skos:note "Continuation of notice under subsection 65C(5) of the Trade Practices Act 1974 as if it were an interim ban imposed under section 109 of the Australian Consumer Law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
