doc:sch-2-sec-41-2-ss-1 a cof:Section ;
    cof:title "41(1) Liability etc. of recipient for unsolicited goods" ;
    values:kind "subsection" ;
    values:originalText "(1) If a person, in trade or commerce, supplies unsolicited goods to another person, the other person:  (a) is not liable to make any payment for the goods; and  (b) is not liable for loss of or damage to the goods, other than loss or damage resulting from the other person doing a wilful and unlawful act in relation to the goods during the recovery period." ;
    cof:pageNumber "71"^^xsd:integer .

concept:act-sch-2-sec-41-2-ss-2 a cml:Concept ;
    skos:prefLabel "41(2) Liability etc. of recipient for unsolicited goods"@en ;
    cml:realizedBy doc:sch-2-sec-41-2-ss-2 ;
    values:originalText "(2) If a person sends, in trade or commerce, unsolicited goods to another person:  (a) neither the sender nor any person claiming under the sender is entitled, after the end of the recovery period, to take action for the recovery of the goods from the other person; and  (b) at the end of the recovery period, the goods become, by force of this section, the property of the other person freed and discharged from all liens and charges of any description." ;
    skos:definition "(2) If a person sends, in trade or commerce, unsolicited goods to another person:  (a) neither the sender nor any person claiming under the sender is entitled, after the end of the recovery period, to take action for the recovery of the goods from the other person; and  (b) at the end of the recovery period, the goods become, by force of this section, the property of the other person freed and discharged from all liens and charges of any description."@en ;
    cml:integrityHash "eff793a0b29a860615c97d67f8c87a1e80326da857f36ccf3898882110eaaa69" ;
    values:partOf concept:act-sch-2-sec-41-2 ;
    cof:pageNumber "71"^^xsd:integer ;
    skos:note "Neither sender nor claimant can recover goods after recovery period ends." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
