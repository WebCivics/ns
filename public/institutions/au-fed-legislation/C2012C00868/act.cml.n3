    cml:modality cml:LinearLogic ;
    cml:operator "Implication" ;
    cml:logicSummary "Excessive fine implies previous fines exceed the limit." ;
    cml:premiseText "(c) (i)" ;
    cml:conclusionText "...the contravention mentioned in paragraph (a); and" ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-202-3-ss-1 cml:asserts concept:act-sch-2-sec-202-3-ss-1-logic-alleninterval-4 .
concept:act-sch-2-sec-202-3-ss-1-logic-alleninterval-4 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "Previous fines overlap with current fine." ;
    cml:premiseText "(b)" ;
