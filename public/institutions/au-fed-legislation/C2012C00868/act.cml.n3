concept:act-sch-2-sec-162-3 a cml:Concept ;
    skos:prefLabel "162 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-162-3 ;
    values:originalText "(4) Subsection (1), (2) or (3) does not apply if the person proves that he or she had reasonable cause to believe that there was a right to the payment or charge.  (5) Subsections (1), (2) and (3) are offences of strict liability." ;
    skos:definition "(4) Subsection (1), (2) or (3) does not apply if the person proves that he or she had reasonable cause to believe that there was a right to the payment or charge.  (5) Subsections (1), (2) and (3) are offences of strict liability."@en ;
    cml:integrityHash "65237638584d97c0bbaa7362e5a3f188bda8bd1e2e9f35d92687cfaf4a29742c" ;
