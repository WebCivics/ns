    cml:premiseText "if the other person is a body corporate—the first person is a wholly-owned subsidiary (within the meaning of the Corporations Act 2001) of the other person." ;
    cml:conclusionText "a wholly-owned subsidiary" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

