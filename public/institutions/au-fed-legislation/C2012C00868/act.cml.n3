doc:sch-7-sec-4-3 a cof:Section ;
    cof:title "4 Prescribed consumer product safety standards" ;
    values:kind "section" ;
    values:originalText "A prescribed consumer product safety standard under section 65C of the Trade Practices Act 1974 that was in force immediately before the commencement of this item continues in force after that commencement as if it were a safety standard made under section 104 of the Australian Consumer Law." ;
    cof:pageNumber "403"^^xsd:integer .

