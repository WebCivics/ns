doc:sch-2-sec-44-3-ss-1 a cof:Section ;
    cof:title "44(1) Participation in pyramid schemes" ;
    values:kind "subsection" ;
    values:originalText "(1) A person must not participate in a pyramid scheme. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    cof:pageNumber "75"^^xsd:integer .

