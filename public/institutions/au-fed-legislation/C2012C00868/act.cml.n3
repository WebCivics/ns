concept:act-sch-2-sec-8-3 a cml:Concept ;
    skos:prefLabel "8 Goods affixed to land or premises"@en ;
    cml:realizedBy doc:sch-2-sec-8-3 ;
    values:originalText "For the purposes of this Schedule, goods are taken to be supplied to a consumer even if they are affixed to land or premises at the time of the supply." ;
    skos:definition "For the purposes of this Schedule, goods are taken to be supplied to a consumer even if they are affixed to land or premises at the time of the supply."@en ;
