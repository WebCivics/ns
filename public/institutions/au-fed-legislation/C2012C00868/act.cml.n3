    cml:modality cml:DescriptionLogic ;
    cml:operator "=" ;
    cml:logicSummary "Class hierarchy" ;
    cml:premiseText "Interest is a legal or equitable estate or interest in the land" ;
    cml:conclusionText "Interest is defined as an estate or interest in the land" ;
