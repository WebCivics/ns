doc:sch-2-sec-44-3-ss-2 a cof:Section ;
    cof:title "44(2) Participation in pyramid schemes" ;
    values:kind "subsection" ;
    values:originalText "(2) A person must not induce, or attempt to induce, another person to participate in a pyramid scheme. Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
