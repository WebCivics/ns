concept:act-sch-2-sec-68-3 a cml:Concept ;
    skos:prefLabel "68 Convention on Contracts for the International Sale of Goods"@en ;
    cml:realizedBy doc:sch-2-sec-68-3 ;
    values:originalText "The provisions of the United Nations Convention on Contracts for the International Sale of Goods, done at Vienna on 11 April 1980, as amended and in force for Australia from time to time, prevail over the provisions of this Division to the extent of any inconsistency. Note: The text of the Convention is set out in Australian Treaty Series 1988 No. 32 ([1988] ATS 32). In 2010, the text of a Convention in the Australian Treaty Series was accessible through the Australian Treaties Library on the AustLII website (www.austlii.edu.au). ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010" ;
    skos:definition "The provisions of the United Nations Convention on Contracts for the International Sale of Goods, done at Vienna on 11 April 1980, as amended and in force for Australia from time to time, prevail over the provisions of this Division to the extent of any inconsistency. Note: The text of the Convention is set out in Australian Treaty Series 1988 No. 32 ([1988] ATS 32). In 2010, the text of a Convention in the Australian Treaty Series was accessible through the Australian Treaties Library on the AustLII website (www.austlii.edu.au). ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010"@en ;
    cml:integrityHash "94f4229f7e00895a2f8204b16b135445b6e086e4cfd00a0d10362dbce4ba507d" ;
    cof:pageNumber "94"^^xsd:integer ;
    skos:note "Provisions of the United Nations Convention on Contracts for the International Sale of Goods prevail over this Division." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.94" ;
    cml:asserts concept:act-sch-2-sec-68-3-norm .
