concept:act-sch-2-sec-304 a cml:Concept ;
    skos:prefLabel "304 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-304 ;
    values:originalText "(a) the person from whom the consumer goods were seized, or the equipment was seized; or  (b) if that person is not entitled to possess the consumer goods or equipment—the owner of the consumer goods or equipment; is liable to pay an amount equal to the costs reasonably incurred by the inspector in seizing the consumer goods or equipment.  (2) An amount payable by a person under subsection (1):  (a) is a debt due by the person to the Commonwealth; and  (b) may be recovered by action in a court of competent jurisdiction." ;
    skos:definition "(a) the person from whom the consumer goods were seized, or the equipment was seized; or  (b) if that person is not entitled to possess the consumer goods or equipment—the owner of the consumer goods or equipment; is liable to pay an amount equal to the costs reasonably incurred by the inspector in seizing the consumer goods or equipment.  (2) An amount payable by a person under subsection (1):  (a) is a debt due by the person to the Commonwealth; and  (b) may be recovered by action in a court of competent jurisdiction."@en ;
    cml:integrityHash "340639a17a9d2063b6ee40fb97ee5c2398211183f53c2af49864d343571c8fa6" ;
    cof:pageNumber "310"^^xsd:integer ;
    skos:note "Person liable to pay costs incurred by inspector" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.310" ;
