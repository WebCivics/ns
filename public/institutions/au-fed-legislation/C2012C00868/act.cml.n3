    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits securing consumer goods without reasonable grounds." ;
    cml:premiseText "Inspector believes it is necessary to secure consumer goods." ;
    cml:conclusionText "Inspection may not secure consumer goods." ;
