doc:sch-2-sec-107-2-ss-2 a cof:Section ;
    cof:title "107(2) Supplying etc. product related services that do not comply with" ;
    values:kind "subsection" ;
    values:originalText "(2) A person must not, in trade or commerce, offer for supply product related services the supply of which is prohibited by subsection (1). Note: A pecuniary penalty may be imposed for a contravention of this subsection." ;
    cof:pageNumber "119"^^xsd:integer .

concept:act-sch-2-sec-107-2-ss-3 a cml:Concept ;
    skos:prefLabel "107(3) Supplying etc. product related services that do not comply with"@en ;
    cml:realizedBy doc:sch-2-sec-107-2-ss-3 ;
    values:originalText "(3) If:  (a) a person supplies product related services in contravention of this section; and  (b) another person suffers loss or damage:  (i) because of defect in, or a dangerous characteristic of, consumer goods that results from the services being supplied; or  (ii) because of a reasonably foreseeable use (including a misuse) of consumer goods that results from the services being supplied; or  (iii) because, contrary to the safety standard, he or she was not provided with particular information in relation to the services; and  (c) the other person would not have suffered the loss or damage if the services had complied with the safety standard; the other person is taken, for the purposes of this Schedule, to have suffered the loss or damage because of that supply." ;
    skos:definition "(3) If:  (a) a person supplies product related services in contravention of this section; and  (b) another person suffers loss or damage:  (i) because of defect in, or a dangerous characteristic of, consumer goods that results from the services being supplied; or  (ii) because of a reasonably foreseeable use (including a misuse) of consumer goods that results from the services being supplied; or  (iii) because, contrary to the safety standard, he or she was not provided with particular information in relation to the services; and  (c) the other person would not have suffered the loss or damage if the services had complied with the safety standard; the other person is taken, for the purposes of this Schedule, to have suffered the loss or damage because of that supply."@en ;
    cml:integrityHash "7d02e02122dd4532d0cefb45840804cecd493f1240c665270592b9881bcec947" ;
    values:partOf concept:act-sch-2-sec-107-2 ;
    cof:pageNumber "119"^^xsd:integer ;
    skos:note "Person supplying product-related services that do not comply with safety standard is liable for loss or damage suffered by another person." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.119" ;
