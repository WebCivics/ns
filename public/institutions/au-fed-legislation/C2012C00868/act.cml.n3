concept:act-sch-2-sec-24-2 cml:asserts concept:act-sch-2-sec-24-2-logic-deontic-1 .
concept:act-sch-2-sec-24-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits participating in a pyramid scheme." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:act-sch-2-sec-24-2 cml:asserts concept:act-sch-2-sec-24-2-logic-descriptionlogic-2 .
concept:act-sch-2-sec-24-2-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "Classify" ;
    cml:logicSummary "Classifies premises as related to consumer goods or services." ;
