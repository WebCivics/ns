concept:act-sch-5-sec-59 a cml:Concept ;
    skos:prefLabel "59 Subsection 79A(1)"@en ;
    cml:realizedBy doc:sch-5-sec-59 ;
    values:originalText "Repeal the subsection, substitute:  (1) If:  (a) a fine has been imposed on a person for:  (i) an offence against section 44ZZRF, 44ZZRG, 154Q or 155; or  (ii) an offence against section 149.1 of the Criminal Code that relates to Part XID; and  (b) the person defaults in payment of the fine; a Court may:  (c) exercise any power that the Court has apart from this section with respect to the enforcement and recovery of fines imposed by the Court; or  (d) make an order, on the application of the Minister or the Commission, declaring that the fine is to have effect, and may be enforced, as if it were a judgment debt under a judgment of the Court." ;
    skos:definition "Repeal the subsection, substitute:  (1) If:  (a) a fine has been imposed on a person for:  (i) an offence against section 44ZZRF, 44ZZRG, 154Q or 155; or  (ii) an offence against section 149.1 of the Criminal Code that relates to Part XID; and  (b) the person defaults in payment of the fine; a Court may:  (c) exercise any power that the Court has apart from this section with respect to the enforcement and recovery of fines imposed by the Court; or  (d) make an order, on the application of the Minister or the Commission, declaring that the fine is to have effect, and may be enforced, as if it were a judgment debt under a judgment of the Court."@en ;
    cml:integrityHash "a8896443a0c49e88d1a9dc0d609a7f27155e7ba778ce1a31b83352007be671c0" ;
    cof:pageNumber "374"^^xsd:integer ;
    skos:note "Court may exercise power to enforce and recover fines, or make order declaring fine has effect as judgment debt." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.374" ;
    cml:asserts concept:act-sch-5-sec-59-norm .
