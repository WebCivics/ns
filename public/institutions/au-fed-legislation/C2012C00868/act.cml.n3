concept:act-sch-2-sec-82-2 a cml:Concept ;
    skos:prefLabel "82 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-82-2 ;
    values:originalText "there is a guarantee that:  (c) the goods correspond with the sample or demonstration model in quality, state or condition; and  (d) if the goods are supplied by reference to a sample—the consumer will have a reasonable opportunity to compare the goods with the sample; and  (e) the goods are free from any defect that:  (i) would not be apparent on reasonable examination of the sample or demonstration model; and  (ii) would cause the goods not to be of acceptable quality.  (2) If goods are supplied by reference to a sample or demonstration model as well as by description, the guarantees in section 56 and in this section both apply." ;
    skos:definition "there is a guarantee that:  (c) the goods correspond with the sample or demonstration model in quality, state or condition; and  (d) if the goods are supplied by reference to a sample—the consumer will have a reasonable opportunity to compare the goods with the sample; and  (e) the goods are free from any defect that:  (i) would not be apparent on reasonable examination of the sample or demonstration model; and  (ii) would cause the goods not to be of acceptable quality.  (2) If goods are supplied by reference to a sample or demonstration model as well as by description, the guarantees in section 56 and in this section both apply."@en ;
    cml:integrityHash "7203454a56d53af11f3df72859292c4663385ca97e4d31bf9f3505b736b0b18b" ;
    cof:pageNumber "88"^^xsd:integer ;
    skos:note "Guarantee for goods quality and condition" ;
    dc:description "Goods corresponding with sample or demonstration model" ;
    cml:curationStatus cml:Proposed ;
