    cml:integrityHash "20ad7e79ae43819549be2708acf1ba09c943e33e53c276b0308050e87d9bb371" ;
    values:partOf concept:act-sch-2-sec-272-3 ;
    cof:pageNumber "278"^^xsd:integer ;
