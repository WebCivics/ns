doc:sch-2-sec-135v a cof:Section ;
    cof:title "135V Power of inspectors to secure consumer goods" ;
    values:kind "section" ;
    values:originalText "If:  (a) an embargo notice relates to consumer goods; and  (b) the inspector who gives the notice believes on reasonable grounds that it is necessary to secure the consumer goods in order to ensure that the notice is complied with; the inspector may, during the embargo period for the embargo notice, do anything that the inspector thinks is necessary to secure those consumer goods (whether by locking them up, placing a guard or otherwise)." ;
    cof:pageNumber "313"^^xsd:integer .

concept:act-sch-2-sec-135w a cml:Concept ;
    skos:prefLabel "135W Power of inspectors to secure equipment used to supply"@en ;
    cml:realizedBy doc:sch-2-sec-135w ;
    values:originalText "product related services  If:  (a) an embargo notice relates to product related services; and  (b) the inspector who gives the notice believes on reasonable grounds that it is necessary to secure equipment used to supply the services in order to ensure that the notice is complied with; the inspector may, during the embargo period for the embargo notice, do anything that the inspector thinks is necessary to secure ComLaw Authoritative Act C2012C00868  Schedule 2  Application of the Australian Consumer Law" ;
    skos:definition "product related services  If:  (a) an embargo notice relates to product related services; and  (b) the inspector who gives the notice believes on reasonable grounds that it is necessary to secure equipment used to supply the services in order to ensure that the notice is complied with; the inspector may, during the embargo period for the embargo notice, do anything that the inspector thinks is necessary to secure ComLaw Authoritative Act C2012C00868  Schedule 2  Application of the Australian Consumer Law"@en ;
    cml:integrityHash "ddcbad95d23869402aa1e63ef30cf7f3e158fd02a9f531e09a62c0a213c17024" ;
    cof:pageNumber "313"^^xsd:integer ;
    skos:note "Inspectors may take actions to secure equipment during an embargo period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
