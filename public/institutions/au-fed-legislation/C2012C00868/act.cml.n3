    cof:pageNumber "90"^^xsd:integer .

concept:act-sch-2-sec-64-3 a cml:Concept ;
    skos:prefLabel "64 Guarantees not to be excluded etc. by contract"@en ;
    cml:realizedBy doc:sch-2-sec-64-3 ;
    values:originalText "(1) A term of a contract (including a term that is not set out in the contract but is incorporated in the contract by another term of the ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010 contract) is void to the extent that the term purports to exclude, restrict or modify, or has the effect of excluding, restricting or modifying:  (a) the application of all or any of the provisions of this Division; or  (b) the exercise of a right conferred by such a provision; or  (c) any liability of a person for a failure to comply with a guarantee that applies under this Division to a supply of goods or services.  (2) A term of a contract is not taken, for the purposes of this section, to exclude, restrict or modify the application of a provision of this Division unless the term does so expressly or is inconsistent with the provision." ;
    skos:definition "(1) A term of a contract (including a term that is not set out in the contract but is incorporated in the contract by another term of the ComLaw Authoritative Act C2012C00868  The Australian Consumer Law  Schedule 1  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010 contract) is void to the extent that the term purports to exclude, restrict or modify, or has the effect of excluding, restricting or modifying:  (a) the application of all or any of the provisions of this Division; or  (b) the exercise of a right conferred by such a provision; or  (c) any liability of a person for a failure to comply with a guarantee that applies under this Division to a supply of goods or services.  (2) A term of a contract is not taken, for the purposes of this section, to exclude, restrict or modify the application of a provision of this Division unless the term does so expressly or is inconsistent with the provision."@en ;
    cml:integrityHash "b04282b0abd1c455a86177689335f6294f65252129f805a6178b3edf4e9d6c29" ;
    cof:pageNumber "90"^^xsd:integer ;
    cml:hasPart concept:act-sch-2-sec-64-3-ss-1 ;
    cml:hasPart concept:act-sch-2-sec-64-3-ss-2 ;
