doc:sch-2-sec-51-2-ss-1 a cof:Section ;
    cof:title "51(1) Guarantee as to title" ;
    values:kind "subsection" ;
    values:originalText "(1) If a person (the supplier) supplies goods to a consumer, there is a guarantee that the supplier will have a right to dispose of the property in the goods when that property is to pass to the consumer." ;
    cof:pageNumber "83"^^xsd:integer .

concept:act-sch-2-sec-51-2-ss-2 a cml:Concept ;
    skos:prefLabel "51(2) Guarantee as to title"@en ;
    cml:realizedBy doc:sch-2-sec-51-2-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply to a supply (a supply of limited title) if an intention that the supplier of the goods should transfer only such title as the supplier, or another person, may have:  (a) appears from the contract for the supply; or  (b) is to be inferred from the circumstances of that contract." ;
    skos:definition "(2) Subsection (1) does not apply to a supply (a supply of limited title) if an intention that the supplier of the goods should transfer only such title as the supplier, or another person, may have:  (a) appears from the contract for the supply; or  (b) is to be inferred from the circumstances of that contract."@en ;
    cml:integrityHash "0ab745019173bff6abbb7eff69e5981f58247e4fe8f77ab48942babfb5248abf" ;
    values:partOf concept:act-sch-2-sec-51-2 ;
    cof:pageNumber "83"^^xsd:integer ;
    skos:note "Permits limited title transfer without applying subsection (1)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.83" ;
    cml:asserts concept:act-sch-2-sec-51-2-ss-2-norm .
