doc:sch-2-sec-101-2-ss-1 a cof:Section ;
    cof:title "101(1) Consumer may request an itemised bill" ;
    values:kind "subsection" ;
    values:originalText "(1) If a person (the supplier), in trade or commerce, supplies services to a consumer, the consumer may request that the supplier give the consumer an itemised bill that:  (a) specifies how the price of the services was calculated; and  (b) includes, if applicable, the number of hours of labour that related to the supply of the services and the hourly rate for that labour; and  (c) includes, if applicable, a list of the materials used to supply the services and the amount charged for those materials." ;
    cof:pageNumber "114"^^xsd:integer .

concept:act-sch-2-sec-101-2-ss-2 a cml:Concept ;
    skos:prefLabel "101(2) Consumer may request an itemised bill"@en ;
    cml:realizedBy doc:sch-2-sec-101-2-ss-2 ;
    values:originalText "(2) The request under subsection (1) must be made within 30 days after:  (a) the services are supplied; or  (b) the consumer receives a bill or account from the supplier for the supply of the services; whichever occurs later." ;
    skos:definition "(2) The request under subsection (1) must be made within 30 days after:  (a) the services are supplied; or  (b) the consumer receives a bill or account from the supplier for the supply of the services; whichever occurs later."@en ;
    cml:integrityHash "c9d52405458e00710bdf60650e6de013ba439b6eff84c3526bdaa2a5a8a2027a" ;
    values:partOf concept:act-sch-2-sec-101-2 ;
    cof:pageNumber "114"^^xsd:integer ;
    skos:note "Request for itemised bill must be made within 30 days after services are supplied or consumer receives a bill." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
