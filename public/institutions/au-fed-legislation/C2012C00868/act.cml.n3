concept:act-sch-3-sec-9 a cml:Concept ;
    skos:prefLabel "9 Paragraph 12CC(2)(j)"@en ;
    cml:realizedBy doc:sch-3-sec-9 ;
    values:originalText "Repeal the paragraph, substitute:  (j) if there is a contract between the supplier and the service recipient for the supply of the financial services:  (i) the extent to which the supplier was willing to negotiate the terms and conditions of the contract with the service recipient; and  (ii) the terms and conditions of the contract; and ComLaw Authoritative Act C2012C00868  Amendment of the Corporations legislation  Schedule 3  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010  (iii) the conduct of the supplier and the service recipient in complying with the terms and conditions of the contract; and  (iv) any conduct that the supplier or the service recipient engaged in, in connection with their commercial relationship, after they entered into the contract; and" ;
    skos:definition "Repeal the paragraph, substitute:  (j) if there is a contract between the supplier and the service recipient for the supply of the financial services:  (i) the extent to which the supplier was willing to negotiate the terms and conditions of the contract with the service recipient; and  (ii) the terms and conditions of the contract; and ComLaw Authoritative Act C2012C00868  Amendment of the Corporations legislation  Schedule 3  Trade Practices Amendment (Australian Consumer Law) Act (No. 2) 2010  (iii) the conduct of the supplier and the service recipient in complying with the terms and conditions of the contract; and  (iv) any conduct that the supplier or the service recipient engaged in, in connection with their commercial relationship, after they entered into the contract; and"@en ;
    cml:integrityHash "b77f90506d9118b21b7a32131a93c8d53561feb286e913276de58cd3d34108b1" ;
    cof:pageNumber "348"^^xsd:integer ;
    skos:note "Specify conduct of supplier and service recipient in complying with contract terms" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
