concept:act-sch-4-sec-2 a cml:Concept ;
    skos:prefLabel "2 Subsection 51ACA(1)"@en ;
    cml:realizedBy doc:sch-4-sec-2 ;
    values:originalText "Insert: related contravention: a person engages in conduct that constitutes a related contravention of an applicable industry code, if the person:  (a) aids, abets, counsels or procures a corporation to contravene the applicable industry code; or  (b) induces, whether by threats or promises or otherwise, a corporation to contravene the applicable industry code; or  (c) is in any way, directly or indirectly, knowingly concerned in, or party to, a contravention by a corporation of the applicable industry code; or  (d) conspires with others to effect a contravention by a corporation of the applicable industry code." ;
    skos:definition "Insert: related contravention: a person engages in conduct that constitutes a related contravention of an applicable industry code, if the person:  (a) aids, abets, counsels or procures a corporation to contravene the applicable industry code; or  (b) induces, whether by threats or promises or otherwise, a corporation to contravene the applicable industry code; or  (c) is in any way, directly or indirectly, knowingly concerned in, or party to, a contravention by a corporation of the applicable industry code; or  (d) conspires with others to effect a contravention by a corporation of the applicable industry code."@en ;
    cml:integrityHash "b21cd099925664977fc2019b0a3d03fc0d8903487af7d6e3bb54545635c2d9ec" ;
    cof:pageNumber "360"^^xsd:integer ;
    skos:note "Aiding, abetting, or inducing a corporation to contravene an industry code is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
