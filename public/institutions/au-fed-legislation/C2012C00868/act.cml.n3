concept:act-sch-2-sec-166-3-ss-6 a cml:Concept ;
    skos:prefLabel "166(6) Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-166-3-ss-6 ;
    values:originalText "(6) Subsection (5) does not apply in relation to services to be supplied under a contract if:  (a) the contract provides for the supply of the services for the term of the contract; and  (b) the contract provides for periodic payments for the services to be made during the term of the contract; and  (c) if the contract also provides for the supply of goods—the goods are directly related to the supply of the services." ;
    skos:definition "(6) Subsection (5) does not apply in relation to services to be supplied under a contract if:  (a) the contract provides for the supply of the services for the term of the contract; and  (b) the contract provides for periodic payments for the services to be made during the term of the contract; and  (c) if the contract also provides for the supply of goods—the goods are directly related to the supply of the services."@en ;
    cml:integrityHash "cd2a646a41d31071e2746b50ddff85c11d4f21273d75b679e0eeb13a1a77ca87" ;
    values:partOf concept:act-sch-2-sec-166-3 ;
    cof:pageNumber "172"^^xsd:integer ;
