concept:act-sch-2-sec-280-3 a cml:Concept ;
    skos:prefLabel "280 Trade Practices Amendment (Australian Consumer Law) Act (No. 2)"@en ;
    cml:realizedBy doc:sch-2-sec-280-3 ;
    values:originalText "Inspector must carry card  (6) An inspector issued with an identity card under subsection (1) must carry his or her identity card at all times when exercising powers as an inspector. Subdivision B—Premises to which the public is given access" ;
    skos:definition "Inspector must carry card  (6) An inspector issued with an identity card under subsection (1) must carry his or her identity card at all times when exercising powers as an inspector. Subdivision B—Premises to which the public is given access"@en ;
    cml:integrityHash "e8e7893226c56337211d86683ab9e702e8e67bbf5be6e6bad311ba6f6ed19222" ;
    cof:pageNumber "286"^^xsd:integer ;
    skos:note "Must carry identity card at all times while exercising powers as an inspector." ;
