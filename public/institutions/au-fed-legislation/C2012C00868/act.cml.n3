doc:sch-2-sec-138-3-ss-1 a cof:Section ;
    cof:title "138(1) Liability for loss or damage suffered by an injured individual" ;
    values:kind "subsection" ;
    values:originalText "(1) A manufacturer of goods is liable to compensate an individual if:  (a) the manufacturer supplies the goods in trade or commerce; and  (b) the goods have a safety defect; and  (c) the individual suffers injuries because of the safety defect." ;
    cof:pageNumber "148"^^xsd:integer .

concept:act-sch-2-sec-138-3-ss-2 a cml:Concept ;
    skos:prefLabel "138(2) Liability for loss or damage suffered by an injured individual"@en ;
    cml:realizedBy doc:sch-2-sec-138-3-ss-2 ;
    values:originalText "(2) The individual may recover, by action against the manufacturer, the amount of the loss or damage suffered by the individual." ;
