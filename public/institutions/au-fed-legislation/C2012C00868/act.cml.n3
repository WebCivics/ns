doc:sch-2-sec-240-2-ss-2 a cof:Section ;
    cof:title "240(2) Determining whether to make a redress order etc. for non-party" ;
    values:kind "subsection" ;
    values:originalText "(2) Any other order made under section 239(1) that relates to that loss or damage has no effect in relation to the non-party consumer." ;
    cof:pageNumber "228"^^xsd:integer .

concept:act-sch-2-sec-240-2-ss-3 a cml:Concept ;
    skos:prefLabel "240(3) Determining whether to make a redress order etc. for non-party"@en ;
    cml:realizedBy doc:sch-2-sec-240-2-ss-3 ;
    values:originalText "(3) Despite any other provision of:  (a) this Schedule; or  (b) any other law of the Commonwealth, or a State or a Territory; no claim, action or demand may be made or taken against the person by the non-party consumer in relation to that loss or damage. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law" ;
    skos:definition "(3) Despite any other provision of:  (a) this Schedule; or  (b) any other law of the Commonwealth, or a State or a Territory; no claim, action or demand may be made or taken against the person by the non-party consumer in relation to that loss or damage. ComLaw Authoritative Act C2012C00868  Schedule 1  The Australian Consumer Law"@en ;
    cml:integrityHash "8139b34a0cc5fc714fb450791b8cc1ade830fa0ec6758734174c30b6d1a6dd7e" ;
    values:partOf concept:act-sch-2-sec-240-2 ;
    cof:pageNumber "228"^^xsd:integer ;
    skos:note "No claim, action or demand may be made against the person by the non-party consumer. Court does not need to find non-party consumers or nature of loss/damage in determining whether to make a redress order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <act.pdf> ;
    dc:source "act.pdf, p.228" ;
