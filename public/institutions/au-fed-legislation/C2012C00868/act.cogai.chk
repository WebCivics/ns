act-sch-2-sec-274-2-ss-1-logic-1564 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-2-sec-274-2-ss-1;
  logic: Deontic;
  operator: Obligation;
  summary: Manufacturer has an obligation to indemnify supplier.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (1) A manufacturer of goods is liable to indemnify a person (the supplier) who supplies the goods to a consumer if: (a) the supplier is liable to pay damages under section 259(4) to the consumer for loss or damage suffered by the consumer; and (b) the manufacturer is or would be liable under section 271 to pay damages to the consumer for the same loss or damage.;
  @action: (1) A manufacturer of goods is liable to indemnify a person (the supplier) who supplies the goods to a consumer if: (a) the supplier is liable to pay damages under section 259(4) to the consumer for loss or damage suffered by the consumer; and (b) the manufacturer is or would be liable under section 271 to pay damages to the consumer for the same loss or damage.;
}

