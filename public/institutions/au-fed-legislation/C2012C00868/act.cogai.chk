  type: LogicApplication;
  provision: sch-2-sec-36-3-ss-1;
  logic: Deontic;
  operator: Prohibit;
  summary: Prohibition of accepting payment for goods or services without intention to supply;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
}

act-sch-2-sec-36-3-ss-2-logic-309 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-2-sec-36-3-ss-2;
  logic: Deontic;
  operator: Prohibit;
  summary: Prohibition of accepting payment for goods or services with intention to supply different goods or services.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (2) A person must not, in trade or commerce, accept payment or other consideration for goods or services if, at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted.;
  @action: The person must not accept payment or other consideration for goods or services with intention to supply different goods or services.;
}

act-sch-2-sec-36-3-ss-2-logic-310 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-2-sec-36-3-ss-2;
  logic: Deontic;
  operator: Justify;
  summary: Justification of the prohibition on accepting payment for goods or services with intention to supply different goods or services.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (2) A person must not, in trade or commerce, accept payment or other consideration for goods or services if, at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted.;
  @action: The prohibition on accepting payment for goods or services with intention to supply different goods or services is justified by the requirement that a person must not accept payment or other consideration for goods or services if, at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted.;
}

act-sch-2-sec-36-3-ss-2-logic-311 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-2-sec-36-3-ss-2;
  logic: LinearLogic;
  operator: Imply;
  summary: Implication of the prohibition on accepting payment for goods or services with intention to supply different goods or services.;
  executionSurface: modalities::linear;
  curationStatus: Proposed;
  @condition: (2) A person must not, in trade or commerce, accept payment or other consideration for goods or services if, at the time of the acceptance, the person intends to supply goods or services materially different from the goods or services in respect of which the payment or other consideration is accepted.;
  @action: If a person accepts payment or other consideration for goods or services with intention to supply different goods or services, then the prohibition on accepting payment for goods or services with intention to supply different goods or services is violated.;
}

act-sch-2-sec-36-3-ss-3-logic-312 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-2-sec-36-3-ss-3;
  logic: Deontic;
  operator: Prohibit;
  summary: Prohibition of accepting payment under unreasonable circumstances.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: Reasonable grounds for believing the person cannot supply goods or services within a specified period.;
  @action: The person must not accept payment.;
}

act-sch-2-sec-36-3-ss-3-logic-313 {
  activation: 1.0000;
