act-sch-2-sec-167-2-ss-1-logic-992 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-2-sec-167-2-ss-1;
  logic: Deontic;
  operator: Prohibit;
  summary: Prohibition of inducing a consumer to acquire goods or services by representing a rebate, commission, or other benefit in return for assisting others.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (1) A person commits an offence if: (a) the person, in trade or commerce, induces a consumer to acquire goods or services by representing that the consumer will, after the contract for the acquisition of the goods or services is made, receive a rebate, commission or other benefit in return for: (i) giving the person the names of prospective customers; or (ii) otherwise assisting the person to supply goods or services to other consumers; and;
  @action: Penalty: (a) if the person is a body corporate—$1,100,000; or (b) if the person is not a body corporate—$220,000.;
}

act-sch-2-sec-167-2-ss-1-logic-993 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-2-sec-167-2-ss-1;
  logic: AllenInterval;
  operator: Temporal Containment;
  summary: Temporal containment of induced consumer acquisition.;
  executionSurface: modalities::interval_reasoning;
  curationStatus: Proposed;
  @condition: (1) A person commits an offence if: (a) the person, in trade or commerce, induces a consumer to acquire goods or services by representing that the consumer will, after the contract for the acquisition of the goods or services is made, receive a rebate, commission or other benefit in return for: (i) giving the person the names of prospective customers; or (ii) otherwise assisting the person to supply goods or services to other consumers; and;
  @action: (b) the receipt of the rebate, commission or other benefit is contingent on an event occurring after that contract is made.;
}

act-sch-2-sec-167-2-ss-1-logic-994 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-2-sec-167-2-ss-1;
  logic: LTL;
  operator: Recurring Trace;
  summary: Recurring trace of induced consumer acquisition.;
  executionSurface: modalities::temporal_ltl;
  curationStatus: Proposed;
  @condition: (1) A person commits an offence if: (a) the person, in trade or commerce, induces a consumer to acquire goods or services by representing that the consumer will, after the contract for the acquisition of the goods or services is made, receive a rebate, commission or other benefit in return for: (i) giving the person the names of prospective customers; or (ii) otherwise assisting the person to supply goods or services to other consumers; and;
  @action: (b) the receipt of the rebate, commission or other benefit is contingent on an event occurring after that contract is made.;
}

