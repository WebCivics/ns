  executionSurface: modalities::interval_reasoning;
  curationStatus: Proposed;
  @condition: A reasonable time is defined as the period specified by or on behalf of the person.;
  @action: The payment must be made before the reasonable time expires.;
}

act-sch-2-sec-36-3-ss-3-logic-314 {
