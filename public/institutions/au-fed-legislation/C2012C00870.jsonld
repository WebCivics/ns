    {
      "@id": "concept:c2012c00870-sch-1-sec-38-ss-3b-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commission MUST consider whether to hold a public inquiry under Part 25 of the Telecommunications Act 1997 about a proposal to make a declaration under subsection (8A) in relation to the service AT OR BEFORE the commencement of the inquiry.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Commission must consider another proposal before commencing an inquiry at the same time or later.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The Commission's consideration of another proposal is a prerequisite for holding a public inquiry."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-38-ss-3b-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commission MUST consider whether to hold a public inquiry under Part 25 of the Telecommunications Act 1997 about a proposal to make a declaration under subsection (8A) in relation to the service.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Commission's consideration of another proposal implies an obligation to hold a public inquiry.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "The Commission considers another proposal before commencing an inquiry."
    },
    {
