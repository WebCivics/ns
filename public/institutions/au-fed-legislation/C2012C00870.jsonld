    {
      "@id": "concept:c2012c00870-sch-1-sec-74-2-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The consultation occurs BETWEEN the time of making an instrument under subsection (4) and the previous consultation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for consultation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "The consultation must occur before making an instrument under subsection (4)."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-74-2-ss-6-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The consultation requirement IMPLIES that the Minister must make an instrument under subsection (4).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of consultation requirement",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "If the Minister makes an instrument under subsection (4), then the Minister MUST consult the ACCC and ACMA."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-74-2-ss-6-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The consultation requirement IS A cognitive action towards the ACCC and ACMA.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Definition of consultation requirement",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The consultation requirement is defined as consulting the ACCC and ACMA."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-74-2-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Before making an instrument under subsection (4), the Minister MUST consult the ACCC and ACMA.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to consult",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Minister must consult the ACCC and ACMA."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-74-2-ss-6-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The consultation requirement IS A diffusion of information to the ACCC and ACMA.",
