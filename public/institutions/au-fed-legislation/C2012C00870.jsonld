    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-88-2-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Commission may remove material from statement in Register if conditions are met within the specified interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Commission's satisfaction with conditions must be within a specific temporal interval.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "Commission's decision to remove material must occur within a reasonable time frame after publication."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-88-2-ss-5-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Material is removed from statement in Register if AI analysis indicates potential prejudice.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Commission uses artificial intelligence to analyze statements for potential prejudice.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Artificial Intelligence",
      "cml:premiseText": "Commission employs AI algorithms to assess commercial interests and public interest."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-88-2-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Commission may remove material from statement in Register.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Publication of material could prejudice substantially commercial interests."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-88-2-ss-5-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Material is removed from statement in Register if information spreads through the system.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Commission's decision must be spread through the system for it to take effect.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Information Spread",
      "cml:premiseText": "Commission's removal of material from statement in Register must be communicated to relevant parties."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-88-2-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Commission may remove material from statement in Register if it is part of the recurring review process.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Commission's actions must be part of a recurring pattern.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:premiseText": "Commission regularly reviews statements for potential prejudice to commercial interests."
    },
