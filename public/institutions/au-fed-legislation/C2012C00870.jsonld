      "cml:logicSummary": "Negative obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "not",
      "cml:premiseText": "(a) they do not act together in any relevant dealings relating to the network or company;"
    },
