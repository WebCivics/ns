    {
      "@id": "concept:c2012c00870-sch-1-sec-155-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2012c00870.pdf, p.72",
      "skos:note": "A person is in a position to exercise control of a telecommunications network if they meet certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "155(1) When a person is in a position to exercise control of a network"
      },
      "wasDerivedFrom": "c2012c00870.pdf",
      "asserts": [
        "concept:c2012c00870-sch-1-sec-155-ss-1-norm",
        "concept:c2012c00870-sch-1-sec-155-ss-1-logic-alleninterval-1",
        "concept:c2012c00870-sch-1-sec-155-ss-1-logic-ltl-2",
        "concept:c2012c00870-sch-1-sec-155-ss-1-logic-deontic-3",
        "concept:c2012c00870-sch-1-sec-155-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "99257b827d424080ee26b0e21c4329e07c49336901f01252b17d65260bd6d219",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2012c00870#sch-1-sec-155-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:c2012c00870-sch-1-sec-155"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-155-ss-1-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The controller has control over the network for at least one year.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Identifies the time period during which the controller has control",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "(i) The controller is in a position, either alone or together with an associate of the controller and whether directly or indirectly: to exercise control of the operation of all or part of the network; or"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-155-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The controller has an obligation to exercise control over the company.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Identifies the controller's obligation to exercise control",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(v) The company or more than 50% of its directors, under a contract or an arrangement or understanding (whether formal or informal), are intended or expected to act in accordance with the directions, instructions or wishes of, or in concert with, the controller."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-155-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The controller has the right to exercise control over the network.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Identifies the controller's right to exercise control",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(i) The controller is in a position, either alone or together with an associate of the controller and whether directly or indirectly: to exercise control of the operation of all or part of the network; or"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-155-ss-1-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The controller's control is limited to one year.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Identifies the time period during which the controller's control is limited",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:premiseText": "(ii) The company or more than 50% of its directors act, or are accustomed to act, in accordance with the directions, instructions or wishes of, or in concert with, the controller."
    },
    {
