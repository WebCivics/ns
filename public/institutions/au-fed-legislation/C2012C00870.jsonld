    {
      "@id": "concept:c2012c00870-sch-1-sec-99-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2012c00870.pdf, p.83",
      "skos:note": "Discrimination between access seekers is prohibited for category A standard access obligations.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "99(1) After section 152AR"
      },
      "wasDerivedFrom": "c2012c00870.pdf",
      "asserts": [
        "concept:c2012c00870-sch-1-sec-99-ss-1-norm",
        "concept:c2012c00870-sch-1-sec-99-ss-1-logic-deontic-1",
        "concept:c2012c00870-sch-1-sec-99-ss-1-logic-alleninterval-2",
        "concept:c2012c00870-sch-1-sec-99-ss-1-logic-ltl-3",
        "concept:c2012c00870-sch-1-sec-99-ss-1-logic-deontic-4",
        "concept:c2012c00870-sch-1-sec-99-ss-1-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "17b46fe7a04213045ac4671531dbabc6babab9ea8ca6ea4f9a3f1f1962256a40",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2012c00870#sch-1-sec-99-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:c2012c00870-sch-1-sec-99"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-99-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "must be provided within a specified time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for the provision",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "(1) If a Layer 2 bitstream service is: (a) supplied using a designated superfast telecommunications network; and (b) a declared service;"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-99-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "must not, in complying with any of its category A standard access obligations in relation to the service, discriminate between access seekers.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of discrimination",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) supplied using a designated superfast telecommunications network; and (b) a declared service;"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-99-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "must comply with its category A standard access obligations.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to comply with category A standard access obligations",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) If a Layer 2 bitstream service is: (a) supplied using a designated superfast telecommunications network; and (b) a declared service;"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-99-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "must not discriminate between access seekers.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of discrimination for carriage service providers",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(1) If a Layer 2 bitstream service is: (a) supplied using a designated superfast telecommunications network; and (b) a declared service;"
    },
