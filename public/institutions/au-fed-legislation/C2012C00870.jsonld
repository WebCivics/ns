      "cml:logicSummary": "Negative obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "not",
      "cml:premiseText": "(b) neither of them is in a position to exert influence over the business dealings of the other in relation to the network or company."
    },
