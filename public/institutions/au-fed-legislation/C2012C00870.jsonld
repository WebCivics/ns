      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Commission has an obligation to ensure access seeker complies with terms and conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Subsection (4G) does not prevent discrimination against an access seeker."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commission must consider the cumulative effect of its reasonable grounds when determining whether to discriminate.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Commission's decision may be subject to a diffusive process that considers multiple factors.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffusive Process",
      "cml:premiseText": "Subsection (4G) does not prevent discrimination against an access seeker if the Commission has reasonable grounds to believe..."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commission must consider the pattern of compliance among access seekers when determining whether to discriminate.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Commission's decision may be subject to a recurring trace of access seekers.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:premiseText": "Subsection (4G) does not prevent discrimination against an access seeker if the Commission has reasonable grounds to believe..."
    },
