      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "SUBJECT",
      "cml:logicSummary": "The carrier licence is subject to a condition.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
