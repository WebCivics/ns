      }
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Subsection 577BA(12) (at the end of the definition of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
