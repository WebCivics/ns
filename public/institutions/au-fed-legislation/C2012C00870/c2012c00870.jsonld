    {
      "@id": "concept:c2012c00870-sch-1-sec-141c",
      "@type": "cml:Concept",
      "skos:prefLabel": "141C Certain installations and connections are not taken to be an",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-141c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.61",
      "values:originalText": "extension, alteration or upgrade\n\nFor the purposes of this Part, if:\n\n(a) a line is or was installed for the purposes of connecting\nparticular premises to a telecommunications network; and\n\n(b) the installation of the line enables or enabled the occupier of\nthe premises to become a customer in relation to carriage\nservices supplied using the network; and\n\n(c) the premises are in close proximity to a line that forms part of\nthe infrastructure of the network; and\n\n(d) the network is capable of being used to supply a superfast\ncarriage service; and\n\n(e) the network came into existence before 1 January 2011;\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments",
      "skos:definition": "extension, alteration or upgrade\n\nFor the purposes of this Part, if:\n\n(a) a line is or was installed for the purposes of connecting\nparticular premises to a telecommunications network; and\n\n(b) the installation of the line enables or enabled the occupier of\nthe premises to become a customer in relation to carriage\nservices supplied using the network; and\n\n(c) the premises are in close proximity to a line that forms part of\nthe infrastructure of the network; and\n\n(d) the network is capable of being used to supply a superfast\ncarriage service; and\n\n(e) the network came into existence before 1 January 2011;\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-141c-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-141c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b8c0a081e77ee19f8bbdb0a3e56a77dd82d9eef6888daeb8d6130f976d664024",
      "skos:note": "Installation of lines for superfast carriage services is not an extension, alteration or upgrade."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-141c",
      "@type": "cof:Section",
      "cof:title": "141C Certain installations and connections are not taken to be an",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "extension, alteration or upgrade\n\nFor the purposes of this Part, if:\n\n(a) a line is or was installed for the purposes of connecting\nparticular premises to a telecommunications network; and\n\n(b) the installation of the line enables or enabled the occupier of\nthe premises to become a customer in relation to carriage\nservices supplied using the network; and\n\n(c) the premises are in close proximity to a line that forms part of\nthe infrastructure of the network; and\n\n(d) the network is capable of being used to supply a superfast\ncarriage service; and\n\n(e) the network came into existence before 1 January 2011;\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-141c-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2012c00870-sch-1-sec-141c"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
