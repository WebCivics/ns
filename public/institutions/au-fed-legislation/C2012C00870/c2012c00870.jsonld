      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) under subsection 152AL(8A), (8D) or (8E), a declared service relates to the NBN corporation;",
      "cml:conclusionText": "must not discriminate in favour of itself"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-7-logic-cogai-5",
