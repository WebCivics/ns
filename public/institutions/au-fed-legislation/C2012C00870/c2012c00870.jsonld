      "cml:integrityHash": "a0f8010656d9aaecd093db28ab2018be3aa4280bdde26c4505361606cb6117cf",
      "skos:note": "Grounds for believing access seeker is not creditworthy or has failed to comply with terms and conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-59-ss-4c",
      "@type": "cof:Section",
      "cof:title": "59(4C) After subsection 152BCB(4)",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(4C) Examples of grounds for believing as mentioned in subsection (4B)\ninclude:\n\n(a) evidence that the access seeker is not creditworthy; and\n\n(b) repeated failures by the access seeker to comply with the\nterms and conditions on which the same or similar access has\nbeen provided (whether or not by the NBN corporation)."
    },
