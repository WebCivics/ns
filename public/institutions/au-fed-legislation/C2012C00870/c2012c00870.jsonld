      },
      "cml:premiseText": "(7) If...",
      "cml:conclusionText": "must not discriminate in favour of itself"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-7-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Temporal relation between the NBN corporation and its category B standard access obligation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the NBN corporation is subject to a category B standard access obligation in relation to the service;",
      "cml:conclusionText": "must not discriminate in favour of itself"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-7-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Implication from the NBN corporation's obligations and its discrimination",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an NBN corporation is a carrier or carriage service provider;",
      "cml:conclusionText": "must not discriminate in favour of itself"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-7-logic-diffusion-4",
