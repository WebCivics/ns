    {
      "@id": "concept:c2012c00870-sch-1-sec-1-9-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(7) January 2011; and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-1-9-ss-7"
      },
      "cml:curationStatus": {
