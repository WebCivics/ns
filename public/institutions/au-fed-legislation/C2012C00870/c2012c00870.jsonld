    {
      "@id": "concept:c2012c00870-sch-1-sec-108",
      "@type": "cml:Concept",
      "skos:prefLabel": "108 After subsection 152BE(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-108"
      },
      "cml:curationStatus": {
