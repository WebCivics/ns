        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "NBN corporation has reasonable grounds to believe access seeker would fail to comply with terms and conditions",
      "cml:conclusionText": "Obligation not violated"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Conditional",
      "cml:logicSummary": "Discrimination allowed if NBN corporation believes access seeker will comply",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
