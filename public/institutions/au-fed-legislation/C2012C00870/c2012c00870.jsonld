    {
      "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "28(1) Telecommunications Legislation Amendment (National Broadband",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-28-2-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
