    {
      "@id": "concept:c2012c00870-sch-1-sec-13-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 After paragraph 113(3)(p)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-13-3"
      },
      "cml:curationStatus": {
