    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-10-2",
      "@type": "cof:Section",
      "cof:title": "10 Telecommunications Legislation Amendment (National Broadband",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Network Measures—Access Arrangements) Act 2011\n\n(p) a carrier licence condition covered by section 41 of the\nNational Broadband Network Companies Act 2011."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-10-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
