    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-1-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 January 2011; and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-1-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
