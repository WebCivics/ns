    {
      "@id": "concept:c2012c00870-sch-1-sec-81",
      "@type": "cml:Concept",
      "skos:prefLabel": "81 At the end of section 152CK",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-81"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.53",
      "values:originalText": "Add:\n\n(5) For the purposes of this section, if a special access undertaking\ngiven by an NBN corporation is in operation, assume that\nsubsection 152AL(8E) has effect in relation to the undertaking as if\nparagraph 152AL(8E)(c) had not been enacted.",
      "skos:definition": "Add:\n\n(5) For the purposes of this section, if a special access undertaking\ngiven by an NBN corporation is in operation, assume that\nsubsection 152AL(8E) has effect in relation to the undertaking as if\nparagraph 152AL(8E)(c) had not been enacted.",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-81-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-81-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5c2ca83209c6a8d90a2f983c3d54613c9b3bcda81cae5495781be31dcc6e7711",
      "skos:note": "Assumes effect of subsection 152AL(8E)(c) for special access undertakings"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-81",
      "@type": "cof:Section",
      "cof:title": "81 At the end of section 152CK",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "Add:\n\n(5) For the purposes of this section, if a special access undertaking\ngiven by an NBN corporation is in operation, assume that\nsubsection 152AL(8E) has effect in relation to the undertaking as if\nparagraph 152AL(8E)(c) had not been enacted."
    },
