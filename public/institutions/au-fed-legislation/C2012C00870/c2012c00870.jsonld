    {
      "@id": "concept:c2012c00870-sch-1-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 At the end of section 152BBD",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.35",
      "values:originalText": "Add:\n\n(2) The Commission must, in exercising its powers under\nsections 152BBA and 152BBC in relation to any of the category B\nstandard access obligations, have regard to the desirability of NBN\ncorporations and access seekers agreeing on terms and conditions\nas mentioned in paragraph 152AY(2)(a) in a timely manner.",
      "skos:definition": "Add:\n\n(2) The Commission must, in exercising its powers under\nsections 152BBA and 152BBC in relation to any of the category B\nstandard access obligations, have regard to the desirability of NBN\ncorporations and access seekers agreeing on terms and conditions\nas mentioned in paragraph 152AY(2)(a) in a timely manner.",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-56-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-56-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f617722e97797bd0d1b1bd1d395ce2c975c83b53930551caa7c28a4fca3292f7",
      "skos:note": "Commission must have regard to desirability of NBN corporations and access seekers agreeing on terms and conditions in a timely manner."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-56",
      "@type": "cof:Section",
      "cof:title": "56 At the end of section 152BBD",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "Add:\n\n(2) The Commission must, in exercising its powers under\nsections 152BBA and 152BBC in relation to any of the category B\nstandard access obligations, have regard to the desirability of NBN\ncorporations and access seekers agreeing on terms and conditions\nas mentioned in paragraph 152AY(2)(a) in a timely manner."
    },
