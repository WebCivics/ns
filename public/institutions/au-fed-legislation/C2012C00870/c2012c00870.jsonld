      },
      "dc:source": "c2012c00870.pdf, p.14",
      "values:originalText": "Network Measures—Access Arrangements) Act 2011\n\n(p) a carrier licence condition covered by section 41 of the\nNational Broadband Network Companies Act 2011.",
      "skos:definition": "Network Measures—Access Arrangements) Act 2011\n\n(p) a carrier licence condition covered by section 41 of the\nNational Broadband Network Companies Act 2011.",
      "cml:asserts": [
        {
