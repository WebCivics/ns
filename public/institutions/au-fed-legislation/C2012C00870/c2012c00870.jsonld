    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-84",
      "@type": "cml:Concept",
      "skos:prefLabel": "84 At the end of paragraph 572E(4)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-84"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.55",
      "values:originalText": "Add:\n\nor (xiv) the carrier licence condition set out in section 152CJC\nof the Competition and Consumer Act 2010; or\n\n(xv) the service provider rule set out in subsection\n152CJD(2) of the Competition and Consumer Act 2010;\nor\n\n(xvi) the carrier licence condition set out in section 37 of the\nNational Broadband Network Companies Act 2011; or\n\n(xvii) the service provider rule set out in subsection 38(2) of\nthe National Broadband Network Companies Act 2011;\nor\n\n(xviii) a carrier licence condition covered by section 41 of the\nNational Broadband Network Companies Act 2011;\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments",
      "skos:definition": "Add:\n\nor (xiv) the carrier licence condition set out in section 152CJC\nof the Competition and Consumer Act 2010; or\n\n(xv) the service provider rule set out in subsection\n152CJD(2) of the Competition and Consumer Act 2010;\nor\n\n(xvi) the carrier licence condition set out in section 37 of the\nNational Broadband Network Companies Act 2011; or\n\n(xvii) the service provider rule set out in subsection 38(2) of\nthe National Broadband Network Companies Act 2011;\nor\n\n(xviii) a carrier licence condition covered by section 41 of the\nNational Broadband Network Companies Act 2011;\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-84-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-84-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "391d5e629fc4a761acd12e6adea8abc687aa7f3716a2cedf95805391fd6b3549",
      "skos:note": "Add specific conditions to carrier licence"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-84",
      "@type": "cof:Section",
      "cof:title": "84 At the end of paragraph 572E(4)(b)",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "Add:\n\nor (xiv) the carrier licence condition set out in section 152CJC\nof the Competition and Consumer Act 2010; or\n\n(xv) the service provider rule set out in subsection\n152CJD(2) of the Competition and Consumer Act 2010;\nor\n\n(xvi) the carrier licence condition set out in section 37 of the\nNational Broadband Network Companies Act 2011; or\n\n(xvii) the service provider rule set out in subsection 38(2) of\nthe National Broadband Network Companies Act 2011;\nor\n\n(xviii) a carrier licence condition covered by section 41 of the\nNational Broadband Network Companies Act 2011;\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments"
    },
