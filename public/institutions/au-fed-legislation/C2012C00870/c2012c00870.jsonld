      }
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-24-2-ss-8f",
      "@type": "cml:Concept",
      "skos:prefLabel": "24(8F) Telecommunications Legislation Amendment (National Broadband",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-24-2-ss-8f"
      },
      "cml:curationStatus": {
