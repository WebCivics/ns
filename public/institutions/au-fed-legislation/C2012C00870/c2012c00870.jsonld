      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal intervals for upgrades and alterations",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Upgrades and alterations occur at different times",
      "cml:conclusionText": "Upgrades may occur after alterations"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-141a",
      "@type": "cml:Concept",
      "skos:prefLabel": "141A Exemptions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-141a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.59",
      "values:originalText": "(1) The Minister may, by written instrument, exempt a specified\nnetwork from section 141.\nNote:\nFor specification by class, see the Acts Interpretation Act 1901.\n\n(2) The Minister may, by written instrument, exempt a specified local\naccess line from section 141.\nNote:\nFor specification by class, see the Acts Interpretation Act 1901.\n\n(3) The Minister may, by written instrument, exempt a specified owner\nfrom subsections 141(2) and (3).\nNote:\nFor specification by class, see the Acts Interpretation Act 1901.\n\n(4) An instrument under subsection (1), (2) or (3) may be:\n\n(a) unconditional; or\n\n(b) subject to such conditions (if any) as are specified in the\ninstrument.\n\n(5) Before making an instrument under subsection (1), (2) or (3), the\nMinister must consult:\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments",
      "skos:definition": "(1) The Minister may, by written instrument, exempt a specified\nnetwork from section 141.\nNote:\nFor specification by class, see the Acts Interpretation Act 1901.\n\n(2) The Minister may, by written instrument, exempt a specified local\naccess line from section 141.\nNote:\nFor specification by class, see the Acts Interpretation Act 1901.\n\n(3) The Minister may, by written instrument, exempt a specified owner\nfrom subsections 141(2) and (3).\nNote:\nFor specification by class, see the Acts Interpretation Act 1901.\n\n(4) An instrument under subsection (1), (2) or (3) may be:\n\n(a) unconditional; or\n\n(b) subject to such conditions (if any) as are specified in the\ninstrument.\n\n(5) Before making an instrument under subsection (1), (2) or (3), the\nMinister must consult:\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments",
      "cml:hasPart": [
