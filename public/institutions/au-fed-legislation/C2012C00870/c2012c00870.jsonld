      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Discrimination allowed if NBN corporation believes access seeker will comply with terms and conditions within a certain timeframe",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "NBN corporation has reasonable grounds to believe access seeker would fail to comply with terms and conditions",
      "cml:conclusionText": "Discrimination allowed if NBN corporation believes access seeker will comply with terms and conditions within a certain timeframe"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-2-logic-ltl-4",
