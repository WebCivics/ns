    {
      "@id": "concept:c2012c00870-sch-1-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Paragraph 152AL(7)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.26",
      "values:originalText": "After “person”, insert “(other than an NBN corporation)”.\nNote:\nThe heading to subsection 152AL(7) is altered by adding at the end “—services not\nsupplied by an NBN corporation”.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          23",
      "skos:definition": "After “person”, insert “(other than an NBN corporation)”.\nNote:\nThe heading to subsection 152AL(7) is altered by adding at the end “—services not\nsupplied by an NBN corporation”.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          23",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-40-norm"
        }
      ],
      "cml:integrityHash": "8319a08ccb80b8688d6c4b20270db0c8155a448309db2a3f8d8ff21ab39d707c",
      "skos:note": "Insertion of '(other than an NBN corporation)' after 'person'"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-40",
      "@type": "cof:Section",
      "cof:title": "40 Paragraph 152AL(7)(a)",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "After “person”, insert “(other than an NBN corporation)”.\nNote:\nThe heading to subsection 152AL(7) is altered by adding at the end “—services not\nsupplied by an NBN corporation”.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          23"
    },
    {
