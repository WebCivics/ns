      },
      "cml:premiseText": "alters, fixed-line carriage service, and upgrade have specific meanings",
      "cml:conclusionText": "These terms are related to each other"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-54-2-ss-10-logic-alleninterval-3",
