      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.47",
      "values:originalText": "Insert:\n\n(cb) if subsection 152CBA(3C) applies—the Commission is\nsatisfied that the conduct specified in accordance with that\nsubsection will promote the long-term interests of end-users\nof carriage services or of services supplied by means of\ncarriage services; and",
      "skos:definition": "Insert:\n\n(cb) if subsection 152CBA(3C) applies—the Commission is\nsatisfied that the conduct specified in accordance with that\nsubsection will promote the long-term interests of end-users\nof carriage services or of services supplied by means of\ncarriage services; and",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-76-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-76-logic-deontic-1"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-76-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "cdff3aef5cf1e330224ec76094fae8ae26c1a900c44c2f34c626e3552b3eed99",
      "skos:note": "Commission must be satisfied that conduct promotes long-term interests of end-users."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-76",
      "@type": "cof:Section",
      "cof:title": "76 Before paragraph 152CBD(2)(d)",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "Insert:\n\n(cb) if subsection 152CBA(3C) applies—the Commission is\nsatisfied that the conduct specified in accordance with that\nsubsection will promote the long-term interests of end-users\nof carriage services or of services supplied by means of\ncarriage services; and"
    },
