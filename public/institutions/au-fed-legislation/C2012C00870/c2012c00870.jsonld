      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.22",
      "values:originalText": "(2B) Subsection (2A) ceases to have effect when the Communications\nMinister makes a declaration under section 48 of the National\nBroadband Network Companies Act 2011 that, in the\nCommunications Minister’s opinion, the national broadband\nnetwork should be treated as built and fully operational.",
      "skos:definition": "(2B) Subsection (2A) ceases to have effect when the Communications\nMinister makes a declaration under section 48 of the National\nBroadband Network Companies Act 2011 that, in the\nCommunications Minister’s opinion, the national broadband\nnetwork should be treated as built and fully operational.",
      "values:partOf": {
        "@id": "concept:c2012c00870-sch-1-sec-151db"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-151db-ss-2b-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-151db-ss-2b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a6176e975c86c455ecd12411de25f6fa026a44fd98423ff05b0d454c7229da18",
      "skos:note": "Ceases effect when Communications Minister declares national broadband network built and fully operational."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-151db-ss-2b",
      "@type": "cof:Section",
      "cof:title": "151DB(2B) Listed points of interconnection",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(2B) Subsection (2A) ceases to have effect when the Communications\nMinister makes a declaration under section 48 of the National\nBroadband Network Companies Act 2011 that, in the\nCommunications Minister’s opinion, the national broadband\nnetwork should be treated as built and fully operational."
    },
