        }
      ],
      "cml:integrityHash": "37dbb7b4d2b9a0812f9527b37b3bfab964fcd344d6c2940a6d74ec991215ed62",
      "skos:note": "Exempts certain installations and connections from being considered an extension, alteration or upgrade."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-1-9-ss-7",
      "@type": "cof:Section",
