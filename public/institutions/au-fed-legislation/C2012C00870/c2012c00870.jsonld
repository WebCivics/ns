    {
      "@id": "concept:c2012c00870-sch-1-sec-104-ss-4g-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of discriminatory access determinations",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
