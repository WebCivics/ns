      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Installation enables occupier to become a customer",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-58-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "58 Telecommunications Legislation Amendment (National Broadband",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-58-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.62",
      "values:originalText": "Network Measures—Access Arrangements) Act 2011\nneither the installation of the line mentioned in paragraph (a), nor\nthe connection of the premises, is taken to be an extension,\nalteration or upgrade of the network.",
