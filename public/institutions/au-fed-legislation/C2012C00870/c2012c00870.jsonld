    {
      "@id": "concept:c2012c00870-sch-1-sec-40-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Telecommunications Legislation Amendment (National Broadband",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-40-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.44",
      "values:originalText": "Network Measures—Access Arrangements) Act 2011\n\n(a) section 152BEBA;\n\n(b) section 152BEBB;\n\n(c) section 152BEBC.\n\n(2) The Register is to be maintained by electronic means.\n\n(3) The Register is to be made available for inspection on the\nCommission’s website.\n\n(4) The Register is not a legislative instrument.\n\n(5) If the Commission is satisfied that:\n\n(a) publication of particular material contained in a statement\ncould reasonably be expected to prejudice substantially the\ncommercial interests of a person; and\n\n(b) the prejudice outweighs the public interest in the publication\nof the matter;\nthe Commission may remove the material from the version of the\nstatement that is included in the Register.\n\n(6) If the Commission does so, the Commission must include in the\nRegister an annotation to that effect.",
      "skos:definition": "Network Measures—Access Arrangements) Act 2011\n\n(a) section 152BEBA;\n\n(b) section 152BEBB;\n\n(c) section 152BEBC.\n\n(2) The Register is to be maintained by electronic means.\n\n(3) The Register is to be made available for inspection on the\nCommission’s website.\n\n(4) The Register is not a legislative instrument.\n\n(5) If the Commission is satisfied that:\n\n(a) publication of particular material contained in a statement\ncould reasonably be expected to prejudice substantially the\ncommercial interests of a person; and\n\n(b) the prejudice outweighs the public interest in the publication\nof the matter;\nthe Commission may remove the material from the version of the\nstatement that is included in the Register.\n\n(6) If the Commission does so, the Commission must include in the\nRegister an annotation to that effect.",
      "cml:hasPart": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-40-2-ss-2"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-40-2-ss-3"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-40-2-ss-4"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-40-2-ss-5"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-40-2-ss-6"
        }
      ],
      "cml:integrityHash": "952f9abcb4f4efe2f953a95e84dea245e3f967e5feab4c1edc759fc840173d0c"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-40-2",
      "@type": "cof:Section",
      "cof:title": "40 Telecommunications Legislation Amendment (National Broadband",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "Network Measures—Access Arrangements) Act 2011\n\n(a) section 152BEBA;\n\n(b) section 152BEBB;\n\n(c) section 152BEBC.\n\n(2) The Register is to be maintained by electronic means.\n\n(3) The Register is to be made available for inspection on the\nCommission’s website.\n\n(4) The Register is not a legislative instrument.\n\n(5) If the Commission is satisfied that:\n\n(a) publication of particular material contained in a statement\ncould reasonably be expected to prejudice substantially the\ncommercial interests of a person; and\n\n(b) the prejudice outweighs the public interest in the publication\nof the matter;\nthe Commission may remove the material from the version of the\nstatement that is included in the Register.\n\n(6) If the Commission does so, the Commission must include in the\nRegister an annotation to that effect."
    },
