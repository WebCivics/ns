    {
      "@id": "concept:c2012c00870-sch-1-sec-80-2-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "80(1) Telecommunications Legislation Amendment (National Broadband",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-80-2-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
