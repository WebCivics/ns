        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-1-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "e1a2e642d1926dae871bb2cac287af23bb65f9a19e3ba85f311d30ac1eb9a973",
      "skos:note": "Discrimination between access seekers is prohibited Discrimination between access seekers is prohibited in complying with category B standard access obligations."
    },
    {
