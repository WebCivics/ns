    {
      "@id": "concept:c2012c00870-sch-1-sec-151db-ss-2b",
      "@type": "cml:Concept",
      "skos:prefLabel": "151DB(2B) Listed points of interconnection",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-151db-ss-2b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
