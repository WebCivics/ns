        }
      ],
      "cml:integrityHash": "96851664e0ae43bcc79534676a680107d99840d3e82463380daefc73b032eaa7",
      "skos:note": "Maintains a register of NBN access agreement statements. NBN corporation must provide a statement to the Commission within 7 days of an access agreement being entered into.",
      "dc:description": "yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-38-2-ss-1",
      "@type": "cof:Section",
      "cof:title": "38(1) Telecommunications Legislation Amendment (National Broadband",
      "values:kind": "subsection",
      "cof:pageNumber": 42,
      "values:originalText": "(1) The Commission is to maintain a register, to be known as the\nRegister of NBN Access Agreement Statements, in which the\nCommission includes all statements given to it under the following\nprovisions:\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments"
    },
