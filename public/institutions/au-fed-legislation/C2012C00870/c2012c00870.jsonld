        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-62d-logic-deontic-3"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-62d-logic-deontic-4"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-62d-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "e847310bf2d5812a1ea5145a7eb1290247edead2c03a6e1f1b943de6245966fa",
      "skos:note": "Carrier licence held by NBN corporation is subject to the condition set out in section 152CJC of the Competition and Consumer Act 2010."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-62d",
