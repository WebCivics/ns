      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 At the end of subsection 571(3) (before the notes)",
      "cml:realizedBy": {
