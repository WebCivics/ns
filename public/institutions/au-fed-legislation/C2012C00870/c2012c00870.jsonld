    {
      "@id": "concept:c2012c00870-sch-1-sec-83",
      "@type": "cml:Concept",
      "skos:prefLabel": "83 Transitional—continuity of special access undertakings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-83"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.54",
      "values:originalText": "The amendments of section 152CBA of the Competition and Consumer\nAct 2010 made by this Part do not affect the continuity of a special\naccess undertaking that was in operation immediately before the\ncommencement of this item.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nAmendments relating to infringement notices  Part 2\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          51",
      "skos:definition": "The amendments of section 152CBA of the Competition and Consumer\nAct 2010 made by this Part do not affect the continuity of a special\naccess undertaking that was in operation immediately before the\ncommencement of this item.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nAmendments relating to infringement notices  Part 2\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          51",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-83-norm"
        }
      ],
      "cml:integrityHash": "d253602f773017a96dbc16facd3d89b11085a246d4fb5688e3c2cdf9b73d5edb",
      "skos:note": "Continuity of special access undertakings"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-83",
      "@type": "cof:Section",
      "cof:title": "83 Transitional—continuity of special access undertakings",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "The amendments of section 152CBA of the Competition and Consumer\nAct 2010 made by this Part do not affect the continuity of a special\naccess undertaking that was in operation immediately before the\ncommencement of this item.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nAmendments relating to infringement notices  Part 2\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          51"
    },
