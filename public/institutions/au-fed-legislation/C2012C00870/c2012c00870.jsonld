    {
      "@id": "concept:c2012c00870-sch-1-sec-149",
      "@type": "cml:Concept",
      "skos:prefLabel": "149 Exemption—sewerage services bodies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-149"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
