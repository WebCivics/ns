      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.72",
      "values:originalText": "Network Measures—Access Arrangements) Act 2011",
      "skos:definition": "Network Measures—Access Arrangements) Act 2011",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-68-2-norm"
        }
      ],
      "cml:integrityHash": "bc806b2c26ce22cd25c65c81147bd806a1f45bd04468bfcf1248ff1791822f94",
      "skos:note": "Telecommunications Legislation Amendment (National Broadband, Network Measures—Access Arrangements) Act 2011"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-68-2",
      "@type": "cof:Section",
      "cof:title": "68 Telecommunications Legislation Amendment (National Broadband",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "Network Measures—Access Arrangements) Act 2011"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-68-2-norm",
