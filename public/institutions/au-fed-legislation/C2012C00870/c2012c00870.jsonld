      },
      "dc:source": "c2012c00870.pdf, p.16",
      "values:originalText": "Add:\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          13\n\n(10) Despite anything in this section, a person does not engage in\nanti-competitive conduct if, under section 151DA, the conduct is\nauthorised for the purposes of subsection 51(1).",
      "skos:definition": "Add:\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          13\n\n(10) Despite anything in this section, a person does not engage in\nanti-competitive conduct if, under section 151DA, the conduct is\nauthorised for the purposes of subsection 51(1).",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-25d-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-25d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cb9029ab3b824d95e474e046e114a9a6ef2f2f6c7a47e2dbd676de6f7ffe41ea",
      "skos:note": "No anti-competitive conduct if authorized under section 151DA"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-25d",
      "@type": "cof:Section",
      "cof:title": "25D At the end of section 151AJ",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Add:\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          13\n\n(10) Despite anything in this section, a person does not engage in\nanti-competitive conduct if, under section 151DA, the conduct is\nauthorised for the purposes of subsection 51(1)."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-25d-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
