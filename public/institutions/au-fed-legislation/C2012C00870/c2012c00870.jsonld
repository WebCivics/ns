      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-103",
      "@type": "cml:Concept",
      "skos:prefLabel": "103 After subsection 152BC(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-103"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.86",
      "values:originalText": "Insert:\n\n(4A) Paragraphs (3)(h) and (i) do not apply to an access determination\nthat relates to a declared service that is a Layer 2 bitstream service\nsupplied using a designated superfast telecommunications network.",
      "skos:definition": "Insert:\n\n(4A) Paragraphs (3)(h) and (i) do not apply to an access determination\nthat relates to a declared service that is a Layer 2 bitstream service\nsupplied using a designated superfast telecommunications network.",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-103-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-103-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "ddb91309419168b569404881ed8b362bc89d1380aabd85e41752331b9662740c",
      "skos:note": "Exempts access determinations for declared Layer 2 bitstream services from certain subsections."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-103",
      "@type": "cof:Section",
      "cof:title": "103 After subsection 152BC(4)",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "Insert:\n\n(4A) Paragraphs (3)(h) and (i) do not apply to an access determination\nthat relates to a declared service that is a Layer 2 bitstream service\nsupplied using a designated superfast telecommunications network."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-103-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2012c00870-sch-1-sec-103"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-103-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires a relation between identifiable temporal intervals for this provision to be fully understood.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
