    {
      "@id": "concept:c2012c00870-sch-1-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Subsection 125AA(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.13",
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) The Minister may, in writing, direct the ACMA to:\n\n(a) determine a standard under subsection (1) that:\n\n(i) applies to participants in a specified section of the\ntelecommunications industry; and\n\n(ii) deals with one or more specified matters relating to the\ntelecommunications activities of those participants; and\n\n(b) do so within a specified period.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(4) The Minister may, in writing, direct the ACMA to:\n\n(a) determine a standard under subsection (1) that:\n\n(i) applies to participants in a specified section of the\ntelecommunications industry; and\n\n(ii) deals with one or more specified matters relating to the\ntelecommunications activities of those participants; and\n\n(b) do so within a specified period.",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-16-norm"
        }
      ],
      "cml:integrityHash": "b37f0c165170219d7d77903c05434ddedbe0b81677a582c6da4e6a9d76ef35ae",
      "skos:note": "Directs ACMA to determine a standard within a specified period."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Subsection 125AA(4)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) The Minister may, in writing, direct the ACMA to:\n\n(a) determine a standard under subsection (1) that:\n\n(i) applies to participants in a specified section of the\ntelecommunications industry; and\n\n(ii) deals with one or more specified matters relating to the\ntelecommunications activities of those participants; and\n\n(b) do so within a specified period."
    },
