    {
      "@id": "concept:c2012c00870-sch-1-sec-153",
      "@type": "cml:Concept",
      "skos:prefLabel": "153 Control",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-153"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.71",
      "values:originalText": "In this Part, control includes control as a result of, or by means of,\ntrusts, agreements, arrangements, understandings and practices,\nwhether or not having legal or equitable force and whether or not\nbased on legal or equitable rights.\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments",
      "skos:definition": "In this Part, control includes control as a result of, or by means of,\ntrusts, agreements, arrangements, understandings and practices,\nwhether or not having legal or equitable force and whether or not\nbased on legal or equitable rights.\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-153-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-153-logic-deontic-1"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-153-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "d4ebd249aec3e0c877d8921f01441b4eefaf2614b8e0a49f0cd927e76b83a292",
      "skos:note": "Control includes control as a result of, or by means of, trusts, agreements, arrangements, understandings and practices."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-153",
      "@type": "cof:Section",
      "cof:title": "153 Control",
      "values:kind": "section",
      "cof:pageNumber": 71,
      "values:originalText": "In this Part, control includes control as a result of, or by means of,\ntrusts, agreements, arrangements, understandings and practices,\nwhether or not having legal or equitable force and whether or not\nbased on legal or equitable rights.\nComLaw Authoritative Act C2012C00870\n\nSchedule 1  Amendments"
