    {
      "@id": "concept:c2012c00870-sch-1-sec-141g",
      "@type": "cml:Concept",
      "skos:prefLabel": "141G Small business customer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-141g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.62",
      "values:originalText": "For the purposes of this Part, small business customer means:\n\n(a) a customer who is a small business employer (within the\nmeaning of the Fair Work Act 2009); or\n\n(b) a customer who:\n\n(i) carries on a business; and\n\n(ii) does not have any employees.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nAmendments relating to Layer 2 bitstream services  Part 3\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          59\nFor the purposes of paragraph (a) of this section, it is to be\nassumed that each reference in section 23 of the Fair Work Act\n2009 to a national system employer were a reference to an\nemployer (within the ordinary meaning of that expression).",
      "skos:definition": "For the purposes of this Part, small business customer means:\n\n(a) a customer who is a small business employer (within the\nmeaning of the Fair Work Act 2009); or\n\n(b) a customer who:\n\n(i) carries on a business; and\n\n(ii) does not have any employees.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nAmendments relating to Layer 2 bitstream services  Part 3\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          59\nFor the purposes of paragraph (a) of this section, it is to be\nassumed that each reference in section 23 of the Fair Work Act\n2009 to a national system employer were a reference to an\nemployer (within the ordinary meaning of that expression).",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-141g-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-141g-logic-deontic-1"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-141g-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-141g-logic-descriptionlogic-3"
        }
      ],
      "cml:integrityHash": "50ede4194fb98c3d78ef2f62e449046dab1473301fce3441887efb6016318d59",
      "skos:note": "Defines small business customer for the purposes of this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-141g",
      "@type": "cof:Section",
      "cof:title": "141G Small business customer",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "For the purposes of this Part, small business customer means:\n\n(a) a customer who is a small business employer (within the\nmeaning of the Fair Work Act 2009); or\n\n(b) a customer who:\n\n(i) carries on a business; and\n\n(ii) does not have any employees.\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nAmendments relating to Layer 2 bitstream services  Part 3\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          59\nFor the purposes of paragraph (a) of this section, it is to be\nassumed that each reference in section 23 of the Fair Work Act\n2009 to a national system employer were a reference to an\nemployer (within the ordinary meaning of that expression)."
    },
