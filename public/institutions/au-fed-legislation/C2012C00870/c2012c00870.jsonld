    {
      "@id": "concept:c2012c00870-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 At the end of section 98",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-8"
