      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(6)(a) evidence that the access seeker is not creditworthy; and (6)(b) repeated failures by the access seeker to comply with the terms and conditions on which the same or similar access has been provided",
      "cml:conclusionText": "The access seeker does not have grounds for belief as mentioned in paragraph (6)(a)"
    },
    {
