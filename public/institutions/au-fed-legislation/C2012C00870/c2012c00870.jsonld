    {
      "@id": "concept:c2012c00870-sch-1-sec-143",
      "@type": "cml:Concept",
      "skos:prefLabel": "143 Supply of eligible services to be on wholesale basis",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-143"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.65",
      "values:originalText": "Scope\n\n(1) This section applies to a local access line if:\n\n(a) the local access line is part of the infrastructure of a\ntelecommunications network in Australia; and\n\n(b) the network is used, or proposed to be used, to supply a\nsuperfast carriage service wholly or principally to residential\nor small business customers, or prospective residential or\nsmall business customers, in Australia; and\n\n(c) the network is not the national broadband network; and\n\n(d) either:\n\n(i) the network came into existence on or after 1 January\n2011; or\n\n(ii) the network was altered or upgraded on or after",
      "skos:definition": "Scope\n\n(1) This section applies to a local access line if:\n\n(a) the local access line is part of the infrastructure of a\ntelecommunications network in Australia; and\n\n(b) the network is used, or proposed to be used, to supply a\nsuperfast carriage service wholly or principally to residential\nor small business customers, or prospective residential or\nsmall business customers, in Australia; and\n\n(c) the network is not the national broadband network; and\n\n(d) either:\n\n(i) the network came into existence on or after 1 January\n2011; or\n\n(ii) the network was altered or upgraded on or after",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-143-norm"
        }
      ],
      "cml:integrityHash": "3be9ca96cfb195243cdf1412d026822701d0e273b07179caf0a16f08a9ff7fd0",
      "skos:note": "Scope of section 143"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-143",
      "@type": "cof:Section",
      "cof:title": "143 Supply of eligible services to be on wholesale basis",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "Scope\n\n(1) This section applies to a local access line if:\n\n(a) the local access line is part of the infrastructure of a\ntelecommunications network in Australia; and\n\n(b) the network is used, or proposed to be used, to supply a\nsuperfast carriage service wholly or principally to residential\nor small business customers, or prospective residential or\nsmall business customers, in Australia; and\n\n(c) the network is not the national broadband network; and\n\n(d) either:\n\n(i) the network came into existence on or after 1 January\n2011; or\n\n(ii) the network was altered or upgraded on or after"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-143-norm",
