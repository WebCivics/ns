      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-25d-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "excludes",
      "cml:logicSummary": "Exclusion from anti-competitive conduct",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 151DA authorizes conduct",
      "cml:conclusionText": "No anti-competitive conduct"
    },
