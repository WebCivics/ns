      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(7) Examples of grounds for believing as mentioned in paragraph (6)(a) include: ... repeated failures by the access seeker to comply with the terms and conditions on which the same or similar access has been provided",
      "cml:conclusionText": "The repeated failures by the access seeker to comply with terms and conditions have a temporal relation to the grounds for belief as mentioned in paragraph (6)(a)"
    },
