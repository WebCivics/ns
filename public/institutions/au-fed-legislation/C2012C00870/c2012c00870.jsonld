    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-24-2-ss-8f",
      "@type": "cof:Section",
      "cof:title": "24(8F) Telecommunications Legislation Amendment (National Broadband",
      "values:kind": "subsection",
      "cof:pageNumber": 28,
      "values:originalText": "(8F) The Commission may declare a service under subsection (8A) even\nif the service is, to any extent, covered by subsection (8E)."
