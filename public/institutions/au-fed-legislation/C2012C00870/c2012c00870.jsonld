      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy for telecommunications network terms",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
