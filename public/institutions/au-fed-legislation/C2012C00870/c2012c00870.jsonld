    {
      "@id": "concept:c2012c00870-sch-1-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Paragraphs 152CBD(2)(a) and (b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.46",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) if paragraph 152CBA(1)(a) applies—the Commission is\nsatisfied that:\n\n(i) the terms and conditions referred to in paragraph\n152CBA(3)(b) would be consistent with the obligations\nreferred to in paragraph 152CBA(3)(a); and\n\n(ii) those terms and conditions are reasonable; and\n\n(b) if paragraph 152CBA(1)(b) applies—the Commission is\nsatisfied that:\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          43\n\n(i) the terms and conditions referred to in subsection\n152CBA(3A) would be consistent with the obligations\nreferred to in section 152AXB; and\n\n(ii) those terms and conditions are reasonable; and",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(a) if paragraph 152CBA(1)(a) applies—the Commission is\nsatisfied that:\n\n(i) the terms and conditions referred to in paragraph\n152CBA(3)(b) would be consistent with the obligations\nreferred to in paragraph 152CBA(3)(a); and\n\n(ii) those terms and conditions are reasonable; and\n\n(b) if paragraph 152CBA(1)(b) applies—the Commission is\nsatisfied that:\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          43\n\n(i) the terms and conditions referred to in subsection\n152CBA(3A) would be consistent with the obligations\nreferred to in section 152AXB; and\n\n(ii) those terms and conditions are reasonable; and",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-75-norm"
        }
      ],
      "cml:integrityHash": "cf577b9cbfb460fc177eb55976015ec2434de8d9251a26a590142305b08c3dbe",
      "skos:note": "Repeal and substitute paragraphs with new conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Paragraphs 152CBD(2)(a) and (b)",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) if paragraph 152CBA(1)(a) applies—the Commission is\nsatisfied that:\n\n(i) the terms and conditions referred to in paragraph\n152CBA(3)(b) would be consistent with the obligations\nreferred to in paragraph 152CBA(3)(a); and\n\n(ii) those terms and conditions are reasonable; and\n\n(b) if paragraph 152CBA(1)(b) applies—the Commission is\nsatisfied that:\nComLaw Authoritative Act C2012C00870\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nTelecommunications Legislation Amendment (National Broadband Network\nMeasures—Access Arrangements) Act 2011          43\n\n(i) the terms and conditions referred to in subsection\n152CBA(3A) would be consistent with the obligations\nreferred to in section 152AXB; and\n\n(ii) those terms and conditions are reasonable; and"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-75-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2012c00870-sch-1-sec-75"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-76",
      "@type": "cml:Concept",
      "skos:prefLabel": "76 Before paragraph 152CBD(2)(d)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-76"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
