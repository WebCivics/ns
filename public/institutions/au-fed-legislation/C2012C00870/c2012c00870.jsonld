      "cml:logicSummary": "Exemption from obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No obligation imposed if reasonable grounds exist."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-28-2-ss-6-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
