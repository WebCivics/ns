    {
      "@id": "concept:c2012c00870-sch-1-sec-25d",
      "@type": "cml:Concept",
      "skos:prefLabel": "25D At the end of section 151AJ",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-25d"
      },
      "cml:curationStatus": {
