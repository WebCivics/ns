        }
      ],
      "cml:integrityHash": "6d8a6e99cea1352897d4ad55f5cbd87a5316b66cc3398ef2c8a78cb37820401b",
      "skos:note": "Commission cannot make binding rules of conduct that would have the effect of requiring or preventing NBN corporations from engaging in certain conduct."
    },
    {
