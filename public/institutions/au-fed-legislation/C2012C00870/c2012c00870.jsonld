    {
      "@id": "concept:c2012c00870-sch-1-sec-38-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Telecommunications Legislation Amendment (National Broadband",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-38-2"
      },
