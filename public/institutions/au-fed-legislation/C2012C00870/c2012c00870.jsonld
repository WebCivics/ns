      "cml:integrityHash": "8c63d1bc0fc50d2a942d760d4c41977152d62604e3780f25377e7262c063d72c",
      "skos:note": "Definition of associate for control determination An employee cannot be regarded as exercising control of a network solely because of being an employee."
    },
    {
