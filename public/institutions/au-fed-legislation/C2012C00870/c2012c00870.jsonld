    {
      "@id": "concept:c2012c00870-sch-1-sec-63",
      "@type": "cml:Concept",
      "skos:prefLabel": "63 After subsection 152BD(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-63"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
