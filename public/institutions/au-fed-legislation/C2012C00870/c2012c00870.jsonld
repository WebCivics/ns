      },
      "prov:wasDerivedFrom": {
        "@id": "c2012c00870.pdf"
      },
      "dc:source": "c2012c00870.pdf, p.88",
      "values:originalText": "Insert:\n\n(1B) Subparagraphs (1)(e)(ix) and (x) do not apply to an agreement that\nrelates to a declared service that is a Layer 2 bitstream service\nsupplied using a designated superfast telecommunications network.",
      "skos:definition": "Insert:\n\n(1B) Subparagraphs (1)(e)(ix) and (x) do not apply to an agreement that\nrelates to a declared service that is a Layer 2 bitstream service\nsupplied using a designated superfast telecommunications network.",
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-108-norm"
        }
      ],
      "cml:integrityHash": "ba016fc0461fb6970b61ad0fbd659870fdc786e6db97d7cf086f19506a596c2d",
      "skos:note": "Exempts agreements from Layer 2 bitstream service regulations"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-108",
      "@type": "cof:Section",
      "cof:title": "108 After subsection 152BE(1A)",
      "values:kind": "section",
      "cof:pageNumber": 88,
      "values:originalText": "Insert:\n\n(1B) Subparagraphs (1)(e)(ix) and (x) do not apply to an agreement that\nrelates to a declared service that is a Layer 2 bitstream service\nsupplied using a designated superfast telecommunications network."
    },
