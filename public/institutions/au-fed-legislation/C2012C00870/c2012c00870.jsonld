      "dc:source": "c2012c00870.pdf, p.87",
      "values:originalText": "(4H) Subsection (4G) does not prevent discrimination against an access\nseeker if the Commission has reasonable grounds to believe that\nthe access seeker would fail, to a material extent, to comply with\nthe terms and conditions on which the carrier or carriage service\nprovider complies, or on which the carrier or carriage service\nprovider is reasonably likely to comply, with the relevant\nobligation.",
      "skos:definition": "(4H) Subsection (4G) does not prevent discrimination against an access\nseeker if the Commission has reasonable grounds to believe that\nthe access seeker would fail, to a material extent, to comply with\nthe terms and conditions on which the carrier or carriage service\nprovider complies, or on which the carrier or carriage service\nprovider is reasonably likely to comply, with the relevant\nobligation.",
      "values:partOf": {
        "@id": "concept:c2012c00870-sch-1-sec-106"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-norm"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-deontic-1"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-ltl-3"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-diffusion-4"
        },
        {
          "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "f79dd6898b2600ab6c362df070b64264cded9a994d2f5544a9c54199b095f418",
      "skos:note": "Commission has reasonable grounds to believe access seeker would fail to comply with terms and conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2012c00870#sch-1-sec-106-ss-4h",
      "@type": "cof:Section",
      "cof:title": "106(4H) Before subsection 152BDA(5)",
      "values:kind": "subsection",
      "cof:pageNumber": 87,
      "values:originalText": "(4H) Subsection (4G) does not prevent discrimination against an access\nseeker if the Commission has reasonable grounds to believe that\nthe access seeker would fail, to a material extent, to comply with\nthe terms and conditions on which the carrier or carriage service\nprovider complies, or on which the carrier or carriage service\nprovider is reasonably likely to comply, with the relevant\nobligation."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Commission has an obligation to ensure access seeker complies with terms and conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (4G) does not prevent discrimination against an access seeker.",
      "cml:conclusionText": "The Commission must take reasonable grounds into account when determining whether the access seeker would comply with the terms and conditions."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Commission's reasonable grounds are a temporal interval that must be considered.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (4G) does not prevent discrimination against an access seeker if the Commission has reasonable grounds to believe...",
      "cml:conclusionText": "The Commission's decision is contingent on the duration of its reasonable grounds."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:logicSummary": "Commission's decision may be subject to a recurring trace of access seekers.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (4G) does not prevent discrimination against an access seeker if the Commission has reasonable grounds to believe...",
      "cml:conclusionText": "The Commission must consider the pattern of compliance among access seekers when determining whether to discriminate."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffusive Process",
      "cml:logicSummary": "Commission's decision may be subject to a diffusive process that considers multiple factors.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (4G) does not prevent discrimination against an access seeker if the Commission has reasonable grounds to believe...",
      "cml:conclusionText": "The Commission must consider the cumulative effect of its reasonable grounds when determining whether to discriminate."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4h-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Artificial Intelligence",
      "cml:logicSummary": "Commission's decision may be subject to artificial intelligence processing.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (4G) does not prevent discrimination against an access seeker if the Commission has reasonable grounds to believe...",
      "cml:conclusionText": "The Commission must consider the output of its AI processing when determining whether to discriminate."
    },
    {
      "@id": "concept:c2012c00870-sch-1-sec-106-ss-4j",
