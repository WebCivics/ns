      },
      "cml:operator": "can",
      "cml:premiseText": "Authorized infringement notice officer has reasonable grounds to believe a person has contravened a civil penalty provision."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-572e-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The authorized infringement notice officer must give an infringement notice to the person if he or she has reasonable grounds to believe that a person has contravened a civil penalty provision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
