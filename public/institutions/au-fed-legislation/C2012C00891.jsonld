    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577ab-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The event must occur within the specified period for the undertaking to come into force.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Specifies the temporal relationship between the event and the commencement of the undertaking",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "=",
      "cml:premiseText": "(i) the decision to accept the undertaking is expressed to be subject to the occurrence of a single specified event within a specified period; and (ii) the event occurs within that period;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577ab-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking comes into force when the event occurs.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Describes the conditions under which the undertaking comes into force",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(a) if: (i) the decision to accept the undertaking is expressed to be subject to the occurrence of a single specified event within a specified period; and (ii) the event occurs within that period;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577ab-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking comes into force when all the events occur.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Describes the conditions under which the undertaking comes into force for multiple events",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(c) if: (i) the decision to accept the undertaking is expressed to be subject to the occurrence of 2 or more specified events within a specified period; and (ii) each of those events occur at different times;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577ab-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking comes into force when it is accepted by the ACCC.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Describes the conditions under which the undertaking comes into force for multiple events",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(d) if the decision to accept the undertaking is not expressed to be subject to the occurrence of one or more specified events within a specified period—when the undertaking is accepted by the ACCC."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577ab-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking comes into force when all the events occur simultaneously.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
