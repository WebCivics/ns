    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-15-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking's duration is tied to the access determination.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The undertaking ceases to have effect when the first access determination comes into force.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal interval",
      "cml:premiseText": "There is a temporal relationship between the undertaking and the access determination."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-15-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking continues to apply.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The undertaking persists in spite of changes.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continues",
      "cml:premiseText": "Repeals and amendments do not affect the undertaking."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-15-6-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking's duration is fixed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The undertaking cannot be varied to extend its duration.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "There is a prohibition on modifying the undertaking."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-15-6-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking's effect is sustained by the model terms.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "If the undertaking adopts model terms and conditions, those sections continue to apply despite repeals.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:premiseText": "There is a recurring relationship between the undertaking and the model terms."
    },
