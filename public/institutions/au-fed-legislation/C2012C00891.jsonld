      "cml:logicSummary": "Specifies the temporal relationship between the events and the commencement of the undertaking",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "=",
      "cml:premiseText": "(b) if: (i) the decision to accept the undertaking is expressed to be subject to the occurrence of 2 or more specified events within a specified period; and (ii) each of those events occur at the same time;"
    },
