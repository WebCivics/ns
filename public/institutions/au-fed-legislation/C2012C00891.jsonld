    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-117c-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The benchmark period overlaps with the standard enforcement period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Indicates overlap between two temporal intervals: the benchmark period and the standard enforcement period.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(3) For the purposes of determining whether the first provider has met or exceeded a minimum benchmark set by the instrument..."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-117c-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first provider's act is a contravention if it meets the definition of 'standard'",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Indicates inference from the definition of 'standard' to the meaning of 'contravention'",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "(a) the first provider has contravened a standard in force under section 115;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-117c-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first provider is taken not to have contravened the standard.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exempts first provider from obligation to comply with standard.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Exemption",
      "cml:premiseText": "(3) For the purposes of determining whether the first provider has met or exceeded a minimum benchmark set by the instrument..."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-117c-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The first provider's responsibility is diffused to another provider.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Indicates diffusion of responsibility from one provider to another.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "(b) the contravention is wholly or partly attributable to one or more acts or omissions of another carriage service provider;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-117c-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The contravention and exemption are part of a recurring pattern.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Indicates recurring trace between two events: the contravention and the exemption.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(3) For the purposes of determining whether the first provider has met or exceeded a minimum benchmark set by the instrument..."
    },
