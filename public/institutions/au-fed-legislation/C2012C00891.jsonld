      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy definition",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "fixed-line carriage service means:  (a) a carriage service that is supplied using a line to premises occupied or used by an end-user; or  (b) a service that facilitates the supply of a carriage service covered by paragraph (a)."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-26-2-logic-descriptionlogic-4",
