    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf, p.130",
      "skos:note": "Commission must make interim access determination if certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "126(1) Telecommunications Legislation Amendment (Competition and"
      },
      "wasDerivedFrom": "telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf",
      "asserts": [
        "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1-norm",
        "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1-logic-deontic-1",
        "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1-logic-alleninterval-2",
