    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-117c-ss-3",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf, p.195",
      "skos:note": "Exempts first provider from contravening a standard if another carriage service provider is responsible for the contravention.",
