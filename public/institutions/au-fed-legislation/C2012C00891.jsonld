      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Monitor and report on compliance with final functional separation undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(d) the principle that Telstra should have systems, procedures and practices that relate to:  (ii) monitoring of, and reporting on, compliance with a final functional separation undertaking;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-74-ss-1-logic-deontic-5",
