      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(f) the Minister must ensure that a functional separation requirements determination comes into force within 90 days after the end of the post-acceptance period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
