        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must give an infringement notice if reasonable grounds exist",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "If an authorized infringement notice officer has reasonable grounds to believe a person has contravened a civil penalty provision, the authorized infringement notice officer may give to the person an infringement notice."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-572e-ss-1-logic-deontic-5",
