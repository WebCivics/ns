      },
      "cml:operator": "=",
      "cml:premiseText": "give effect to, in relation to a provision of a contract, arrangement or understanding, has the same meaning as in the Competition and Consumer Act 2010."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-26-2-logic-descriptionlogic-5",
