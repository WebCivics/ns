        "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "7391b2dcc74a642e48c6a97582758796000ee1718c798ac59abfc6de338edd1b",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010#sch-1-sec-126-2-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The public inquiry has started before the declaration was made.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Commission has commenced to hold a public inquiry under Part 25 of the Telecommunications Act 1997 about a proposal to make an access determination in relation to access to the declared service.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The Commission has commenced to hold a public inquiry under Part 25 of the Telecommunications Act 1997 about a proposal to make an access determination in relation to access to the declared service;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Commission must make an interim access determination in relation to access to the service.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to make interim access determination.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Commission makes a declaration under section 152AL after the commencement of this section."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The interim access determination must be made.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Commission considers it is unlikely that a final access determination in relation to access to the service will be made within 6 months after the commencement of the public inquiry.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(d) either: (i) the Commission considers that it is unlikely that a final access determination in relation to access to the service will be made within 6 months after the commencement of the public inquiry; or (ii) the Commission considers that there is an urgent need to make an access determination in relation to access to the service before the completion of the public inquiry;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The public inquiry must end before the interim access determination can be made.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Commission considers there is an urgent need to make an access determination in relation to access to the service before the completion of the public inquiry;",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:premiseText": "(d) either: (i) the Commission considers that it is unlikely that a final access determination in relation to access to the service will be made within 6 months after the commencement of the public inquiry; or (ii) the Commission considers that there is an urgent need to make an access determination in relation to access to the service before the completion of the public inquiry;"
    },
