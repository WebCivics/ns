    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577eb-logic-alleninterval-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The event must occur within that period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "The decision to accept the undertaking is expressed to be subject to the occurrence of a single specified event within a specified period."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577eb-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking comes into force if the event occurs within that period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Conditional obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "The decision to accept the undertaking is expressed to be subject to the occurrence of a single specified event within a specified period."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577eb-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking comes into force if all events occur at the same time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Conditional obligation with multiple events",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "The decision to accept the undertaking is expressed to be subject to the occurrence of 2 or more specified events within a specified period, and each of those events occur at the same time."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577eb-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking comes into force if all events occur at the last time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Conditional obligation with different events",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "The decision to accept the undertaking is expressed to be subject to the occurrence of 2 or more specified events within a specified period, and each of those events occur at different times."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577eb-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The undertaking comes into force when it is accepted by the ACCC.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Default obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if-then",
      "cml:premiseText": "The decision to accept the undertaking is not expressed to be subject to the occurrence of one or more specified events within a specified period."
    },
