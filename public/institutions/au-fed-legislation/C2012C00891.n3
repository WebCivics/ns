    cml:operator "involvement" ;
    cml:logicSummary "Involvement in a contravention is an obligation." ;
    cml:premiseText "A person who has conspired with others to effect the contravention is involved." ;
    cml:conclusionText "The person is obligated to prevent further involvement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


