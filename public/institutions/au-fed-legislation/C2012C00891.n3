    cml:modality cml:Deontic ;
    cml:operator "involvement" ;
    cml:logicSummary "Involvement in a contravention is an obligation." ;
    cml:premiseText "A person who has induced the contravention, whether through threats or promises or otherwise, is involved." ;
    cml:conclusionText "The person is obligated to prevent further involvement." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-134-2-ss-4 cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-134-2-ss-4-logic-deontic-3 .
