    cml:modality cml:Deontic ;
    cml:operator "exemption" ;
    cml:logicSummary "Commission exempt from holding public inquiry under Part 25." ;
    cml:premiseText "(2) The Commission is not required to hold a public inquiry..." ;
    cml:conclusionText "...if the variation is of a minor nature and affected parties consent in writing." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
