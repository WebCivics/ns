doc:sch-1-sec-577ac-ss-2 a cof:Section ;
    cof:title "577AC(2) Publication requirements for undertaking about structural" ;
    values:kind "subsection" ;
    values:originalText "(2) If a decision to accept an undertaking under section 577A is not expressed to be subject to the occurrence of one or more specified events within a specified period, the ACCC must, as soon as practicable after accepting the undertaking, publish the undertaking on its website." ;
    cof:pageNumber "22"^^xsd:integer .

