    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-70-2-ss-8 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-70-2-ss-9 ;
