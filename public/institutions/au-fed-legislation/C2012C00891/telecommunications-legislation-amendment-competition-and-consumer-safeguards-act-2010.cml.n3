doc:sch-1-sec-30-2-ss-2 a cof:Section ;
    cof:title "30(2) Telecommunications Legislation Amendment (Competition and" ;
    values:kind "subsection" ;
    values:originalText "(2) The ACCC must:  (a) if the ACCC is satisfied that the original plan complies with the migration plan principles—approve the original plan; or  (b) otherwise:  (i) refuse to approve the original plan; and  (ii) by written notice given to Telstra, request Telstra to give the ACCC, within 30 days after the notice is given, a replacement draft migration plan that complies with the migration plan principles. Note 1: For migration plan principles, see section 577BB. Note 2: If Telstra gives the ACCC a replacement draft migration plan in response to the request, the ACCC will make a decision about the plan under section 577BDC." ;
    cof:pageNumber "34"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-30-2-ss-3 a cml:Concept ;
    skos:prefLabel "30(3) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-30-2-ss-3 ;
    values:originalText "(3) The ACCC must not make a decision under subsection (2) before it accepts the undertaking." ;
    skos:definition "(3) The ACCC must not make a decision under subsection (2) before it accepts the undertaking."@en ;
    cml:integrityHash "cc6001d246f6ae1d269e60f4ab740f6ad5daaee5990693b7d910f3b0a8271281" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-30-2 ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "The ACCC must accept an undertaking before making a decision under subsection (2) The ACCC must publish a notice and consider submissions before making a decision." ;
    dc:description "Submissions to the ACCC within 28 days" ;
