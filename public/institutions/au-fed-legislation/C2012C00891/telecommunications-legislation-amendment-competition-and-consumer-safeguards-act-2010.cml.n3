concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-147 a cml:Concept ;
    skos:prefLabel "147 After subsection 152ATA(6)"@en ;
    cml:realizedBy doc:sch-1-sec-147 ;
    values:originalText "Insert: Serial applications  (7) If:  (a) a person makes an application (the first application) under subsection (1) for an order in relation to a service or proposed service; and  (b) the Commission refuses the first application; and  (c) the person subsequently makes another application under subsection (1); and  (d)  the Commission is satisfied that:  (i) the first application and the other application have material similarities; or  (ii) the grounds on which the person made the first application are materially similar to the grounds on which the person has made the other application; the Commission may refuse to consider the other application." ;
    skos:definition "Insert: Serial applications  (7) If:  (a) a person makes an application (the first application) under subsection (1) for an order in relation to a service or proposed service; and  (b) the Commission refuses the first application; and  (c) the person subsequently makes another application under subsection (1); and  (d)  the Commission is satisfied that:  (i) the first application and the other application have material similarities; or  (ii) the grounds on which the person made the first application are materially similar to the grounds on which the person has made the other application; the Commission may refuse to consider the other application."@en ;
    cml:integrityHash "af160e09ad119664ca09c25900f4e12d693b355b3eab9355934907a8f706eba2" ;
    cof:pageNumber "117"^^xsd:integer ;
    skos:note "Commission may refuse to consider subsequent application if grounds are materially similar." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf> ;
