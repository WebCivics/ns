concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577cd a cml:Concept ;
    skos:prefLabel "577CD Compliance with undertaking about hybrid fibre-coaxial"@en ;
    cml:realizedBy doc:sch-1-sec-577cd ;
