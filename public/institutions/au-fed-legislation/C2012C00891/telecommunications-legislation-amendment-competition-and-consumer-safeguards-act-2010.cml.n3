doc:sch-1-sec-577m-ss-2 a cof:Section ;
    cof:title "577M(2) Associate" ;
    values:kind "subsection" ;
    values:originalText "(2) However, persons are not associates of each other if the ACCC is satisfied that:  (a) they do not act together in any relevant dealings relating to the network or company; and  (b) neither of them is in a position to exert influence over the business dealings of the other in relation to the network or company." ;
    cof:pageNumber "60"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577n a cml:Concept ;
    skos:prefLabel "577N Control"@en ;
    cml:realizedBy doc:sch-1-sec-577n ;
    values:originalText "In this Part, control includes control as a result of, or by means of, trusts, agreements, arrangements, understandings and practices, whether or not having legal or equitable force and whether or not based on legal or equitable rights." ;
