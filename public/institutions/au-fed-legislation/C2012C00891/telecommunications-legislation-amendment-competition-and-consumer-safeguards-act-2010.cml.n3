concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-217-ss-3 a cml:Concept ;
    skos:prefLabel "217(3) After section 6"@en ;
    cml:realizedBy doc:sch-1-sec-217-ss-3 ;
    values:originalText "(3) For the purposes of this Act, if:  (a) a standard telephone service (the relevant service) is supplied, or proposed to be supplied, to a customer by a primary universal service provider; and  (b) the relevant service is not:  (i) a public mobile telecommunications service; or  (ii) a VOIP service; the relevant service is taken not to be supplied in fulfilment of the universal service obligation if, before the customer entered into an agreement with the primary universal service provider for the supply of the relevant service:  (c) the customer was given the option of being supplied with another standard telephone service by the provider on the ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments" ;
    skos:definition "(3) For the purposes of this Act, if:  (a) a standard telephone service (the relevant service) is supplied, or proposed to be supplied, to a customer by a primary universal service provider; and  (b) the relevant service is not:  (i) a public mobile telecommunications service; or  (ii) a VOIP service; the relevant service is taken not to be supplied in fulfilment of the universal service obligation if, before the customer entered into an agreement with the primary universal service provider for the supply of the relevant service:  (c) the customer was given the option of being supplied with another standard telephone service by the provider on the ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments"@en ;
    cml:integrityHash "62c0579b403958de5e3161c490092f46ca786e261b5fb9ef7c0eed61e8a3cd8e" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-217 ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "Customer must be given option to choose another standard telephone service before entering into agreement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
