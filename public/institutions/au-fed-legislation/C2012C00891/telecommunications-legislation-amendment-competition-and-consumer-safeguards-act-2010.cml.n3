concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-120-2-ss-2 a cml:Concept ;
    skos:prefLabel "120(2) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-120-2-ss-2 ;
    values:originalText "(2) If a fixed principles provision is included in an access determination, the determination must provide that a specified date is the nominal termination date for the fixed principles provision. ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments" ;
    skos:definition "(2) If a fixed principles provision is included in an access determination, the determination must provide that a specified date is the nominal termination date for the fixed principles provision. ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments"@en ;
    cml:integrityHash "c2cd18e316b4a22e9ccdaf9c364b24f7f3c6f37ae25978f00f811973623dc922" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-120-2 ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "Determination must provide a nominal termination date for fixed principles provision. Grounds for believing access seeker is not creditworthy or has repeated failures to comply with terms and conditions." ;
    dc:description "Yes" ;
