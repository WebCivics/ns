concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-32-ss-2 a cml:Concept ;
    skos:prefLabel "32(2) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-32-ss-2 ;
    values:originalText "(2) The ACCC must: ComLaw Authoritative Act C2012C00891  Amendments  Schedule 1 Amendments relating to Telstra  Part 1  Telecommunications Legislation Amendment (Competition and Consumer Safeguards) Act 2010          33  (a) if the ACCC is satisfied that the original plan complies with the migration plan principles—approve the original plan; or  (b) otherwise:  (i) refuse to approve the original plan; and  (ii) by written notice given to Telstra, direct Telstra to give the ACCC, within 30 days after the notice is given, a replacement draft migration plan that complies with the migration plan principles. Note: For migration plan principles, see section 577BB. Consultation" ;
    skos:definition "(2) The ACCC must: ComLaw Authoritative Act C2012C00891  Amendments  Schedule 1 Amendments relating to Telstra  Part 1  Telecommunications Legislation Amendment (Competition and Consumer Safeguards) Act 2010          33  (a) if the ACCC is satisfied that the original plan complies with the migration plan principles—approve the original plan; or  (b) otherwise:  (i) refuse to approve the original plan; and  (ii) by written notice given to Telstra, direct Telstra to give the ACCC, within 30 days after the notice is given, a replacement draft migration plan that complies with the migration plan principles. Note: For migration plan principles, see section 577BB. Consultation"@en ;
    cml:integrityHash "e9187b03764dcfca0925e43198ccccbed4129e44c4c2579fb2e2660030a2c3c2" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-32 ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Direct Telstra to provide a replacement draft migration plan within 30 days." ;
    dc:description "Replacement draft migration plan" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
