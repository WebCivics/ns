concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-148-2-ss-1 a cml:Concept ;
    skos:prefLabel "148(1) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-148-2-ss-1 ;
    values:originalText "(1) If:  (a) an access agreement is covered by subsection 152BE(1); and  (b) the agreement was entered into after the commencement of this section; the carrier or carriage service provider who supplies, or proposes to supply, the service to which the agreement relates must, within 28 days after the day on which the agreement was entered into, give the Commission:  (c) a copy of the agreement; and  (d) a written statement setting out such information (if any) about the agreement as is specified in an instrument in force under subsection (4)." ;
    skos:definition "(1) If:  (a) an access agreement is covered by subsection 152BE(1); and  (b) the agreement was entered into after the commencement of this section; the carrier or carriage service provider who supplies, or proposes to supply, the service to which the agreement relates must, within 28 days after the day on which the agreement was entered into, give the Commission:  (c) a copy of the agreement; and  (d) a written statement setting out such information (if any) about the agreement as is specified in an instrument in force under subsection (4)."@en ;
    cml:integrityHash "38f134abbb2c6762d27763b6199f5178c4a9e3dad6e33353f76770478afffdca" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-148-2 ;
    cof:pageNumber "152"^^xsd:integer ;
    skos:note "Carrier must provide access agreement and written statement to Commission within 28 days." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf> ;
