    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-166-ss-2 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-166-ss-3 ;
