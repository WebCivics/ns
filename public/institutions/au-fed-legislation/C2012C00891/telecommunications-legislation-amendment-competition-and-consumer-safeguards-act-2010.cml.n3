doc:sch-1-sec-127 a cof:Section ;
    cof:title "127 After section 152AH" ;
    values:kind "section" ;
    values:originalText "Insert: 152AI  When public inquiry commences  For the purposes of this Part, a public inquiry held by the Commission under Part 25 of the Telecommunications Act 1997 commences when the Commission publishes the notice under section 498 of that Act about the inquiry." ;
    cof:pageNumber "113"^^xsd:integer .

