concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-12-3-ss-12 a cml:Concept ;
    skos:prefLabel "12(12) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-12-3-ss-12 ;
    values:originalText "(12) If:  (a) the ACCC has accepted an undertaking given by Telstra under subsection (1); and  (b) when the undertaking was accepted, a particular day (the relevant day) was the designated day; ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments" ;
    skos:definition "(12) If:  (a) the ACCC has accepted an undertaking given by Telstra under subsection (1); and  (b) when the undertaking was accepted, a particular day (the relevant day) was the designated day; ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments"@en ;
    cml:integrityHash "68cf95e048f1f3fe3422e55be6a1e45492ee9c03789da840707008674a9bb4fe" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-12-3 ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Condition for ACCC to accept Telstra's undertaking" ;
    cml:curationStatus cml:Proposed ;
