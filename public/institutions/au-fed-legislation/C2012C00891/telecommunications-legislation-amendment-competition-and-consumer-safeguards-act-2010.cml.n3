    cof:pageNumber "113"^^xsd:integer ;
    skos:note "Anything done by a carrier or provider in fulfillment of the requirement is taken to be an aspect of access to a declared service." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
