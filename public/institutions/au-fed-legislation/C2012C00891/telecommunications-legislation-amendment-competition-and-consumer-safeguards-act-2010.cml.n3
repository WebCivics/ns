concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-83-2 a cml:Concept ;
    skos:prefLabel "83 After subsection 103(4)"@en ;
    cml:realizedBy doc:sch-1-sec-83-2 ;
    values:originalText "Insert:  (4A) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BCP(2) of the Competition and Consumer Act 2010.  (4B) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BDG(2) of the Competition and Consumer Act 2010.  (4C) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BED(2) of the Competition and Consumer Act 2010." ;
    skos:definition "Insert:  (4A) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BCP(2) of the Competition and Consumer Act 2010.  (4B) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BDG(2) of the Competition and Consumer Act 2010.  (4C) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BED(2) of the Competition and Consumer Act 2010."@en ;
    cml:integrityHash "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4" ;
    cof:pageNumber "100"^^xsd:integer ;
