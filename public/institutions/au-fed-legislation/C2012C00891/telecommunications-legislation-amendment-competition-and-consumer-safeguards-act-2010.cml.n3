doc:sch-1-sec-146-2-ss-5 a cof:Section ;
    cof:title "146(5) Telecommunications Legislation Amendment (Competition and" ;
    values:kind "subsection" ;
    values:originalText "(5) If the Commission is satisfied that:  (a) publication of a particular provision of binding rules of conduct could reasonably be expected to prejudice substantially the commercial interests of a person; and  (b) the prejudice outweighs the public interest in the publication of the provision; the Commission may remove the provision from the version of the rules that is included in the Register." ;
    cof:pageNumber "150"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-146-2-ss-6 a cml:Concept ;
    skos:prefLabel "146(6) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-146-2-ss-6 ;
    values:originalText "(6) If the Commission does so, the Commission must include in the Register an annotation to that effect." ;
