    cml:modality cml:AllenInterval ;
    cml:operator "between" ;
    cml:logicSummary "Minor variation defined as one that occurs between the time of proposal and the time of consent." ;
    cml:premiseText "(2) The Commission is not required to hold a public inquiry..." ;
    cml:conclusionText "...if the variation is of a minor nature; or (b) each carrier or carriage service provider and access seeker whose interests are likely to be affected by the variation has consented in writing to the variation." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
