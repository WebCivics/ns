concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-64a a cml:Concept ;
    skos:prefLabel "64A Section 104"@en ;
    cml:realizedBy doc:sch-1-sec-64a ;
    values:originalText "After: • The ACMA may be directed by the Minister to monitor, and report on, specified matters relating to the performance of carriers and carriage service providers. insert: • The ACCC is to monitor, and report each financial year to the Minister on, breaches by Telstra of an undertaking about structural separation." ;
    skos:definition "After: • The ACMA may be directed by the Minister to monitor, and report on, specified matters relating to the performance of carriers and carriage service providers. insert: • The ACCC is to monitor, and report each financial year to the Minister on, breaches by Telstra of an undertaking about structural separation."@en ;
    cml:integrityHash "666a0ccb7fe261871a6b45457599157a0ee63217404c0568aefeae0bc4e3c3f8" ;
    cof:pageNumber "92"^^xsd:integer ;
    skos:note "The ACCC must monitor and report on breaches by Telstra of an undertaking about structural separation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf, p.92" ;
    cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-64a-norm .
