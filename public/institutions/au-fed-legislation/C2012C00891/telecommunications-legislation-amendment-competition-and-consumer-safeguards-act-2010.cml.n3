doc:sch-1-sec-86-3 a cof:Section ;
    cof:title "86 At the end of subsection 564(3) (before the notes)" ;
    values:kind "section" ;
    values:originalText "Add:  ; or (f) the carrier licence condition set out in section 152BCO of the Competition and Consumer Act 2010; or  (g) the service provider rule set out in subsection 152BCP(2) of the Competition and Consumer Act 2010; or  (h) the carrier licence condition set out in section 152BDF of the Competition and Consumer Act 2010; or  (i) the service provider rule set out in subsection 152BDG(2) of the Competition and Consumer Act 2010; or  (j) the carrier licence condition set out in section 152BEC of the Competition and Consumer Act 2010; or  (k) the service provider rule set out in subsection 152BED(2) of the Competition and Consumer Act 2010." ;
    cof:pageNumber "102"^^xsd:integer .

