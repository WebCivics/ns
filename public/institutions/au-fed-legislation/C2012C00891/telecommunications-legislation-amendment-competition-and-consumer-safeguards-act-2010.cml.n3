concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-64-ss-5c a cml:Concept ;
    skos:prefLabel "64(5C) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-64-ss-5c ;
    values:originalText "(5C) The Minister must not make an instrument under subclause (5B) unless:  (a) Telstra satisfies the Minister that Telstra is preparing an undertaking under section 577A; or  (b) both:  (i) Telstra has given the ACCC an undertaking under section 577A; and  (ii) the ACCC has not decided whether to accept the undertaking; or  (c) the following conditions are satisfied:  (i) Telstra has given the ACCC an undertaking under section 577A;  (ii) the ACCC has decided to accept the undertaking;  (iii) that decision is expressed to be subject to the occurrence of one or more specified events within a specified period;  (iv) the undertaking is not in force;  (v) that period has not ended; or  (d) the following conditions are satisfied:  (i) an undertaking given by Telstra is in force under section 577A;  (ii) the undertaking requires Telstra to give the ACCC a draft migration plan;  (iii) Telstra satisfies the Minister that Telstra is preparing a draft migration plan to be given to the ACCC in accordance with the undertaking; or ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments" ;
    skos:definition "(5C) The Minister must not make an instrument under subclause (5B) unless:  (a) Telstra satisfies the Minister that Telstra is preparing an undertaking under section 577A; or  (b) both:  (i) Telstra has given the ACCC an undertaking under section 577A; and  (ii) the ACCC has not decided whether to accept the undertaking; or  (c) the following conditions are satisfied:  (i) Telstra has given the ACCC an undertaking under section 577A;  (ii) the ACCC has decided to accept the undertaking;  (iii) that decision is expressed to be subject to the occurrence of one or more specified events within a specified period;  (iv) the undertaking is not in force;  (v) that period has not ended; or  (d) the following conditions are satisfied:  (i) an undertaking given by Telstra is in force under section 577A;  (ii) the undertaking requires Telstra to give the ACCC a draft migration plan;  (iii) Telstra satisfies the Minister that Telstra is preparing a draft migration plan to be given to the ACCC in accordance with the undertaking; or ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments"@en ;
    cml:integrityHash "2a3e9071a24ffe888849f129eadf9e939df90575af420883855d405360f86fe4" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-64 ;
    cof:pageNumber "68"^^xsd:integer ;
    skos:note "Minister must not make an instrument under subclause (5B) without specified conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
