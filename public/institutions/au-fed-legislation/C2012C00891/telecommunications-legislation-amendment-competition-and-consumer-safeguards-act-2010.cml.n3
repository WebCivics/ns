concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-128-2-ss-5 a cml:Concept ;
    skos:prefLabel "128(5) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-128-2-ss-5 ;
    values:originalText "(5) The Commission must not make an interim access determination otherwise than in accordance with this section. 152BCGA  Stay of access determinations" ;
    skos:definition "(5) The Commission must not make an interim access determination otherwise than in accordance with this section. 152BCGA  Stay of access determinations"@en ;
    cml:integrityHash "f71227232467a1112c5233efe9348b8b135aa1db6448e9bf25255bd3d39785a5" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-128-2 ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "If a declaration is in force under section 152AL and an access determination has previously been made, the entity must comply with the access determination. Commission must not make an interim access determination without following this section." ;
