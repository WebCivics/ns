concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-70 a cml:Concept ;
    skos:prefLabel "70 Declared network services"@en ;
    cml:realizedBy doc:sch-1-sec-70 ;
    values:originalText "For the purposes of this Part, a declared network service is a service specified in a legislative instrument made by the Minister for the purposes of this clause. ComLaw Authoritative Act C2012C00891  Amendments  Schedule 1 Amendments relating to Telstra  Part 1  Telecommunications Legislation Amendment (Competition and Consumer Safeguards) Act 2010          61" ;
    skos:definition "For the purposes of this Part, a declared network service is a service specified in a legislative instrument made by the Minister for the purposes of this clause. ComLaw Authoritative Act C2012C00891  Amendments  Schedule 1 Amendments relating to Telstra  Part 1  Telecommunications Legislation Amendment (Competition and Consumer Safeguards) Act 2010          61"@en ;
    cml:integrityHash "af61099330e06be8e0a8a0b474914325b62d21c2e56144c00c5002178e029528" ;
    cof:pageNumber "64"^^xsd:integer ;
    skos:note "Declared network service definition" ;
