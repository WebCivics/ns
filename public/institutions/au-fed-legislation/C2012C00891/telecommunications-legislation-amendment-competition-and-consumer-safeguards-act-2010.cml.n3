concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-126-2-ss-2 a cml:Concept ;
    skos:prefLabel "126(2) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-126-2-ss-2 ;
    values:originalText "(2) If:  (a) a declaration is in force under section 152AL; and  (b) no access determination has previously been made in relation to access to the declared service; the Commission may make an interim access determination in relation to access to the service." ;
    skos:definition "(2) If:  (a) a declaration is in force under section 152AL; and  (b) no access determination has previously been made in relation to access to the declared service; the Commission may make an interim access determination in relation to access to the service."@en ;
