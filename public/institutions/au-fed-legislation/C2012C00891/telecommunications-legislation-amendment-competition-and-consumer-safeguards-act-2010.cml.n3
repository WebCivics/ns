concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-127 a cml:Concept ;
    skos:prefLabel "127 After section 152AH"@en ;
    cml:realizedBy doc:sch-1-sec-127 ;
    values:originalText "Insert: 152AI  When public inquiry commences  For the purposes of this Part, a public inquiry held by the Commission under Part 25 of the Telecommunications Act 1997 commences when the Commission publishes the notice under section 498 of that Act about the inquiry." ;
    skos:definition "Insert: 152AI  When public inquiry commences  For the purposes of this Part, a public inquiry held by the Commission under Part 25 of the Telecommunications Act 1997 commences when the Commission publishes the notice under section 498 of that Act about the inquiry."@en ;
    cml:integrityHash "bc238118764cdf6dd149a9e4aaa473d6bf134c286547b77a4f991b841fce2b56" ;
    cof:pageNumber "113"^^xsd:integer ;
    skos:note "Commences when notice is published under section 498 of the Telecommunications Act 1997." ;
    cml:curationStatus cml:Proposed ;
