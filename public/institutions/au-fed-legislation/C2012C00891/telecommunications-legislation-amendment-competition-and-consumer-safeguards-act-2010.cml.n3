concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-85 a cml:Concept ;
    skos:prefLabel "85 Use by Telstra of certain spectrum licences"@en ;
    cml:realizedBy doc:sch-1-sec-85 ;
    values:originalText "(1) If:  (a) the excluded spectrum regime applies to Telstra; and  (b) a spectrum licence relates to a designated part of the spectrum; Telstra must not supply a carriage service using a radiocommunications device the operation of which is authorised under the licence. Note: For excluded spectrum regime, see section 577GA. ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments" ;
    skos:definition "(1) If:  (a) the excluded spectrum regime applies to Telstra; and  (b) a spectrum licence relates to a designated part of the spectrum; Telstra must not supply a carriage service using a radiocommunications device the operation of which is authorised under the licence. Note: For excluded spectrum regime, see section 577GA. ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments"@en ;
    cml:integrityHash "1a2cd57a02ee04dff20b3f3ca527e893e50b1fb63c994abdcd67ddd04554522b" ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Telstra must not supply a carriage service using a radiocommunications device." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
