doc:sch-1-sec-128-2-ss-1 a cof:Section ;
    cof:title "128(1) Telecommunications Legislation Amendment (Competition and" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commission must not make an access determination unless:  (a) the Commission has held a public inquiry under Part 25 of the Telecommunications Act 1997 about a proposal to make the determination; and  (b) the Commission has prepared a report about the inquiry under section 505 of the Telecommunications Act 1997; and  (c) the report was published during the 180-day period ending when the determination was made." ;
    cof:pageNumber "132"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-128-2-ss-2 a cml:Concept ;
    skos:prefLabel "128(2) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-128-2-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply to an interim access determination." ;
    skos:definition "(2) Subsection (1) does not apply to an interim access determination."@en ;
    cml:integrityHash "82a8c1642d581b05f4be42d6bce08dfbb58a984ba8c0f9dbe6b574dd71ec7e0c" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-128-2 ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "Exempts interim access determination from subsection (1) Commission must hold a public inquiry about access to declared service. Court must not make orders staying or otherwise affecting the operation or implementation of the decision pending finalisation of the application." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
