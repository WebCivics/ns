concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-120-2-ss-5 a cml:Concept ;
    skos:prefLabel "120(5) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-120-2-ss-5 ;
    values:originalText "(5) An access determination is of no effect to the extent to which it contravenes subsection (1), (3) or (3A). ComLaw Authoritative Act C2012C00891  Amendments  Schedule 1 Telecommunications access regime  Part 2  Telecommunications Legislation Amendment (Competition and Consumer Safeguards) Act 2010          121" ;
    skos:definition "(5) An access determination is of no effect to the extent to which it contravenes subsection (1), (3) or (3A). ComLaw Authoritative Act C2012C00891  Amendments  Schedule 1 Telecommunications access regime  Part 2  Telecommunications Legislation Amendment (Competition and Consumer Safeguards) Act 2010          121"@en ;
    cml:integrityHash "9bf165e49215bd3c6c2c4e9a881ae41d8d88bafa61ac994648ccf0f85efb32cc" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-120-2 ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "An access determination is of no effect to the extent it contravenes subsections (1), (3), or (3A)." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
