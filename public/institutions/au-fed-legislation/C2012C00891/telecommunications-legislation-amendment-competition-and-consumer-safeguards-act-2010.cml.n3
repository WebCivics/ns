    skos:prefLabel "128(5) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-128-2-ss-5 ;
    values:originalText "(5) If:  (a) a declaration (the current declaration) is in force under section 152AL; and  (b) an access determination has previously been made in relation to access to the declared service; and ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments" ;
    skos:definition "(5) If:  (a) a declaration (the current declaration) is in force under section 152AL; and  (b) an access determination has previously been made in relation to access to the declared service; and ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments"@en ;
    cml:integrityHash "e914ace8757765de6184ff3ece6bd15f99a0966ff34ac8bc5185421eb746dadb" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-128-2 ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "If a declaration is in force under section 152AL and an access determination has previously been made, the entity must comply with the access determination. Commission must not make an interim access determination without following this section." ;
