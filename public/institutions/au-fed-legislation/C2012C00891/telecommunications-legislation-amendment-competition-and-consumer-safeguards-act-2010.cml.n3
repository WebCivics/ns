    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-22-2-ss-7 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-22-2-ss-8 ;
