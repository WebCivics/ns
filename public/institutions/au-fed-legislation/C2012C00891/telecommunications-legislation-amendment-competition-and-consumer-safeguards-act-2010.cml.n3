concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-110-2 a cml:Concept ;
    skos:prefLabel "110 Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-110-2 ;
    values:originalText "Consumer Safeguards) Act 2010  (a) the principle that the expiry date for a declaration should occur in the period:  (i) beginning 3 years after the declaration was made; and  (ii) ending 5 years after the declaration was made;  unless, in the Commission’s opinion, there are circumstances that warrant the expiry date occurring in a shorter or longer period; and  (b) such other matters (if any) as the Commission considers relevant." ;
    skos:definition "Consumer Safeguards) Act 2010  (a) the principle that the expiry date for a declaration should occur in the period:  (i) beginning 3 years after the declaration was made; and  (ii) ending 5 years after the declaration was made;  unless, in the Commission’s opinion, there are circumstances that warrant the expiry date occurring in a shorter or longer period; and  (b) such other matters (if any) as the Commission considers relevant."@en ;
    cml:integrityHash "9683fe88cedcd107ea55c15c0558adc63d6cdf4612336ff082bd70229571ef38" ;
    cof:pageNumber "114"^^xsd:integer ;
    skos:note "The Commission must consider a relevant matter when determining the expiry date of a declaration." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
