    cml:modality cml:CogAI ;
    cml:operator "Involves" ;
    cml:logicSummary "The concept of 'minor nature' is defined in terms of a temporal interval." ;
    cml:premiseText "Definition of minor nature involves a temporal interval that the variation must involve" ;
    cml:conclusionText "(Minor nature) -> (Variation involves that time)" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
