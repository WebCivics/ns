concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-128-2-ss-1 a cml:Concept ;
    skos:prefLabel "128(1) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-128-2-ss-1 ;
    values:originalText "(1) If: ComLaw Authoritative Act C2012C00891  Amendments  Schedule 1 Telecommunications access regime  Part 2  Telecommunications Legislation Amendment (Competition and Consumer Safeguards) Act 2010          129  (a) the Commission makes a declaration under section 152AL after the commencement of this section; and  (b) no access determination has previously been made in relation to access to the declared service; the Commission must, within 30 days after the declaration is made, commence to hold a public inquiry under Part 25 of the Telecommunications Act 1997 about a proposal to make an access determination relating to access to the declared service." ;
    skos:definition "(1) If: ComLaw Authoritative Act C2012C00891  Amendments  Schedule 1 Telecommunications access regime  Part 2  Telecommunications Legislation Amendment (Competition and Consumer Safeguards) Act 2010          129  (a) the Commission makes a declaration under section 152AL after the commencement of this section; and  (b) no access determination has previously been made in relation to access to the declared service; the Commission must, within 30 days after the declaration is made, commence to hold a public inquiry under Part 25 of the Telecommunications Act 1997 about a proposal to make an access determination relating to access to the declared service."@en ;
    cml:integrityHash "a94d61aa850cde82dc24ce29facdf8673378a210d7827a21c0f372fcdc1b8b43" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-128-2 ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "Commission must not make access determination without public inquiry and report Commission must hold a public inquiry within 30 days after declaration. Exempts Commission decisions from certain judicial review provisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf> ;
