concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-156-2 a cml:Concept ;
    skos:prefLabel "156 Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-156-2 ;
    values:originalText "Consumer Safeguards) Act 2010 152CBCA  Serial undertakings  If:  (a) a person gives a special access undertaking (the first special access undertaking) to the Commission; and  (b) the Commission rejects the first special access undertaking; and  (c) the person subsequently gives another special access undertaking to the Commission; and  (d) the Commission is satisfied that any or all of the provisions of the first special access application are materially similar to any or all of the provisions of the other special access undertaking; the Commission may refuse to consider the other special access undertaking." ;
    skos:definition "Consumer Safeguards) Act 2010 152CBCA  Serial undertakings  If:  (a) a person gives a special access undertaking (the first special access undertaking) to the Commission; and  (b) the Commission rejects the first special access undertaking; and  (c) the person subsequently gives another special access undertaking to the Commission; and  (d) the Commission is satisfied that any or all of the provisions of the first special access application are materially similar to any or all of the provisions of the other special access undertaking; the Commission may refuse to consider the other special access undertaking."@en ;
    cml:integrityHash "9ebfc1552f57e31e7ce2605ff1a13fcb3f043f2cdb9e1d8ae54c483f1f638690" ;
    cof:pageNumber "160"^^xsd:integer ;
    skos:note "Commission may refuse to consider another special access undertaking if it is materially similar to a previous one." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf, p.160" ;
    cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-156-2-norm .
