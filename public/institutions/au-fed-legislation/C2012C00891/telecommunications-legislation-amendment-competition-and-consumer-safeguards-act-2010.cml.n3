concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-136-2-ss-5 a cml:Concept ;
    skos:prefLabel "136(5) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-136-2-ss-5 ;
    values:originalText "(5) If the Commission is satisfied that:  (a) publication of a particular provision of an access determination could reasonably be expected to prejudice substantially the commercial interests of a person; and  (b) the prejudice outweighs the public interest in the publication of the provision; the Commission may remove the provision from the version of the access determination that is included in the Register." ;
    skos:definition "(5) If the Commission is satisfied that:  (a) publication of a particular provision of an access determination could reasonably be expected to prejudice substantially the commercial interests of a person; and  (b) the prejudice outweighs the public interest in the publication of the provision; the Commission may remove the provision from the version of the access determination that is included in the Register."@en ;
    cml:integrityHash "6796c3feff4a374e6ec11a34203b408d08c7a6a58c87f1e5367149023ecb3031" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-136-2 ;
    cof:pageNumber "140"^^xsd:integer ;
    skos:note "Commission may remove a provision from the Register if it prejudices substantially the commercial interests of a person and outweighs the public interest in publication." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
