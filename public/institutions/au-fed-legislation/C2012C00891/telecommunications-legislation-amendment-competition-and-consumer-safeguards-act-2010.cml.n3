concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-64a-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Obligation to report breaches" ;
    cml:premiseText "The ACCC is required to monitor and report on breaches by Telstra of an undertaking about structural separation." ;
    cml:conclusionText "The ACCC MUST report on breaches by Telstra of an undertaking about structural separation." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

