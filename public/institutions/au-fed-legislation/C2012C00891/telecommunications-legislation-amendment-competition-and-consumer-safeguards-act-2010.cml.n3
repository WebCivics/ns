concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-134-2-ss-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "involvement" ;
    cml:logicSummary "Involvement in a contravention is an obligation." ;
    cml:premiseText "A person who has aided, abetted, counselled or procured the contravention is involved." ;
    cml:conclusionText "The person is obligated to prevent further involvement." ;
