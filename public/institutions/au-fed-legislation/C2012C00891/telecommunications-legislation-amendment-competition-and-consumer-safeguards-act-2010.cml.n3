concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-124-2-ss-8 a cml:Concept ;
    skos:prefLabel "124(8) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-124-2-ss-8 ;
    values:originalText "(8) If:  (a) an access determination relating to access to a declared service is in force; and  (b) the declared service is covered by a declaration under section 152AL, and the declaration ceases to be in force; and  (c) the Commission does not make a fresh declaration under section 152AL that replaces the declaration referred to in paragraph (b) of this subsection; the access determination is taken to be revoked at the time of the cessation." ;
    skos:definition "(8) If:  (a) an access determination relating to access to a declared service is in force; and  (b) the declared service is covered by a declaration under section 152AL, and the declaration ceases to be in force; and  (c) the Commission does not make a fresh declaration under section 152AL that replaces the declaration referred to in paragraph (b) of this subsection; the access determination is taken to be revoked at the time of the cessation."@en ;
    cml:integrityHash "05f7e6de2a237ce30b753178044e779c7be1cc0313eb5b5205941e5ec2afb052" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-124-2 ;
    cof:pageNumber "128"^^xsd:integer ;
    skos:note "Access determination revoked upon declaration cessation" ;
    cml:curationStatus cml:Proposed ;
