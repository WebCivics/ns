concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-32-ss-5 a cml:Concept ;
    skos:prefLabel "32(5) Telecommunications Legislation Amendment (Competition and"@en ;
