doc:sch-1-sec-54-ss-3 a cof:Section ;
    cof:title "54(3) Telecommunications Legislation Amendment (Competition and" ;
    values:kind "subsection" ;
    values:originalText "(3) A person must not:  (a) aid, abet, counsel or procure a contravention of subsection (1); or  (b) induce, whether by threats or promises or otherwise, a contravention of subsection (1); or  (c) be in any way, directly or indirectly, knowingly concerned in, or party to, a contravention of subsection (1); or  (d) conspire with others to effect a contravention of subsection (1)." ;
    cof:pageNumber "58"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-54-ss-4 a cml:Concept ;
    skos:prefLabel "54(4) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-54-ss-4 ;
    values:originalText "(4) Subsections (1) and (3) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions." ;
    skos:definition "(4) Subsections (1) and (3) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions."@en ;
