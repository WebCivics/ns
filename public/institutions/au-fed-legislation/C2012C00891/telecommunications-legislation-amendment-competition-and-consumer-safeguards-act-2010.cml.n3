    skos:definition "(5F) The Minister is not required to observe any requirements of procedural fairness in relation to the making of an instrument under subclause (5B)."@en ;
    cml:integrityHash "ed3b8384d703de4802d196983ac914b377d0f3c5742bf6781bff32c825158032" ;
