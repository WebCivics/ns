concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-74-2-ss-5-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Overlaps" ;
    cml:logicSummary "The concept of 'minor nature' is defined in terms of temporal intervals." ;
    cml:premiseText "Definition of minor nature involves temporal intervals" ;
    cml:conclusionText "Temporal intervals involved in definition of minor nature overlap with current variation" ;
