doc:sch-1-sec-83-2 a cof:Section ;
    cof:title "83 After subsection 103(4)" ;
    values:kind "section" ;
    values:originalText "Insert:  (4A) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BCP(2) of the Competition and Consumer Act 2010.  (4B) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BDG(2) of the Competition and Consumer Act 2010.  (4C) The ACCC may issue a formal warning if a person contravenes the service provider rule set out in subsection 152BED(2) of the Competition and Consumer Act 2010." ;
    cof:pageNumber "100"^^xsd:integer .

