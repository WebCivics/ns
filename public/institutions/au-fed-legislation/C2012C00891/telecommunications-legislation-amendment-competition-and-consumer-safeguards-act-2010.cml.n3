concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-17-2 a cml:Concept ;
    skos:prefLabel "17 Priority assistance industry code"@en ;
    cml:realizedBy doc:sch-1-sec-17-2 ;
    values:originalText "For the purposes of this Part, the priority assistance industry code is:  (a) the code that is:  (i) entitled Priority Assistance for Life Threatening Medical Conditions; and  (ii) registered under Part 6; or  (b) if that code is replaced by another code registered under Part 6—the replacement code." ;
    skos:definition "For the purposes of this Part, the priority assistance industry code is:  (a) the code that is:  (i) entitled Priority Assistance for Life Threatening Medical Conditions; and  (ii) registered under Part 6; or  (b) if that code is replaced by another code registered under Part 6—the replacement code."@en ;
    cml:integrityHash "3deaf62abeb338538097e360f1b0ad9c1c3ed8cc3cc9e05bca9160571a6dd94f" ;
    cof:pageNumber "202"^^xsd:integer ;
    skos:note "Defines priority assistance industry code" ;
