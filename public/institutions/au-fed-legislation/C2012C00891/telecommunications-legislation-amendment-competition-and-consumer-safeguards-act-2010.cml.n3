doc:sch-1-sec-76-ss-3 a cof:Section ;
    cof:title "76(3) Draft functional separation undertaking to be given to Minister" ;
    values:kind "subsection" ;
    values:originalText "(3) The Minister may, by writing, specify a period for the purposes of paragraph (1)(b)." ;
    cof:pageNumber "72"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-76-ss-4 a cml:Concept ;
    skos:prefLabel "76(4) Draft functional separation undertaking to be given to Minister"@en ;
    cml:realizedBy doc:sch-1-sec-76-ss-4 ;
    values:originalText "(4) The Minister must not specify a period under subclause (3) unless:  (a) Telstra satisfies the Minister that Telstra is preparing an undertaking under section 577A; or  (b) both:  (i) Telstra has given the ACCC an undertaking under section 577A; and  (ii) the ACCC has not decided whether to accept the undertaking; or  (c) the following conditions are satisfied:  (i) Telstra has given the ACCC an undertaking under section 577A;  (ii) the ACCC has decided to accept the undertaking;  (iii) that decision is expressed to be subject to the occurrence of one or more specified events within a specified period;  (iv) the undertaking is not in force;  (v) that period has not ended; or  (d) the following conditions are satisfied:  (i) an undertaking given by Telstra is in force under section 577A;  (ii) the undertaking requires Telstra to give the ACCC a draft migration plan;  (iii) Telstra satisfies the Minister that Telstra is preparing a draft migration plan to be given to the ACCC in accordance with the undertaking; or ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments" ;
    skos:definition "(4) The Minister must not specify a period under subclause (3) unless:  (a) Telstra satisfies the Minister that Telstra is preparing an undertaking under section 577A; or  (b) both:  (i) Telstra has given the ACCC an undertaking under section 577A; and  (ii) the ACCC has not decided whether to accept the undertaking; or  (c) the following conditions are satisfied:  (i) Telstra has given the ACCC an undertaking under section 577A;  (ii) the ACCC has decided to accept the undertaking;  (iii) that decision is expressed to be subject to the occurrence of one or more specified events within a specified period;  (iv) the undertaking is not in force;  (v) that period has not ended; or  (d) the following conditions are satisfied:  (i) an undertaking given by Telstra is in force under section 577A;  (ii) the undertaking requires Telstra to give the ACCC a draft migration plan;  (iii) Telstra satisfies the Minister that Telstra is preparing a draft migration plan to be given to the ACCC in accordance with the undertaking; or ComLaw Authoritative Act C2012C00891  Schedule 1  Amendments"@en ;
    cml:integrityHash "e6e5f0a452ae8baf649b22fc8712449795644c2fa6df03464fe98967128f50af" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-76 ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Minister must specify period under subclause (3) unless certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
