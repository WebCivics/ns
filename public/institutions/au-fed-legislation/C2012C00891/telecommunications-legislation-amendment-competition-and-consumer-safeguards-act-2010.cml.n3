    skos:prefLabel "206 Transitional—continuity of special access undertakings"@en ;
    cml:realizedBy doc:sch-1-sec-206 ;
    values:originalText "The amendment of subsection 152CBA(1) of the Competition and Consumer Act 2010 made by this Part does not affect the continuity of a special access undertaking that was in operation immediately before the commencement of this item." ;
    skos:definition "The amendment of subsection 152CBA(1) of the Competition and Consumer Act 2010 made by this Part does not affect the continuity of a special access undertaking that was in operation immediately before the commencement of this item."@en ;
    cml:integrityHash "31bdc37b9b00aca3464c5a97f2984f7cf7c4644f4dee46dc081b7cd397c7d9be" ;
