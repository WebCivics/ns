doc:sch-1-sec-46-ss-8 a cof:Section ;
    cof:title "46(8) Telecommunications Legislation Amendment (Competition and" ;
    values:kind "subsection" ;
    values:originalText "(8) If:  (a) a decision to accept an undertaking under section 577E is expressed to be subject to the occurrence of 2 or more specified events within a specified period; and  (b) one or more of those events do not occur within that period; this Act has effect as if the undertaking had never been accepted by the ACCC. Publication requirement" ;
    cof:pageNumber "50"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-46-ss-9 a cml:Concept ;
    skos:prefLabel "46(9) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-46-ss-9 ;
