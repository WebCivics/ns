    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "The concept of 'minor nature' is defined in terms of a temporal interval." ;
    cml:premiseText "Definition of minor nature involves a temporal interval until which the variation must occur" ;
