doc:sch-1-sec-132-2-ss-3 a cof:Section ;
    cof:title "132(3) Telecommunications Legislation Amendment (Competition and" ;
    values:kind "subsection" ;
    values:originalText "(3) The Commission may, by written notice published on its website, extend or further extend the 6-month period referred to in subsection (2), so long as:  (a) the extension or further extension is for a period of not more than 6 months; and  (b) the notice includes a statement explaining why the Commission has been unable to make a final access determination within that 6-month period or that 6-month period as previously extended, as the case may be. Note: The Commission may be required to make an interim access determination—see section 152BCG. Subdivision C—Variation or revocation of access determinations 152BCN  Variation or revocation of access determinations" ;
    cof:pageNumber "136"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-132-2-ss-1 a cml:Concept ;
    skos:prefLabel "132(1) Telecommunications Legislation Amendment (Competition and"@en ;
    cml:realizedBy doc:sch-1-sec-132-2-ss-1 ;
    values:originalText "(1) Subsection 33(3) of the Acts Interpretation Act 1901 applies to a power conferred on the Commission by section 152BC, but it applies with the following changes." ;
    skos:definition "(1) Subsection 33(3) of the Acts Interpretation Act 1901 applies to a power conferred on the Commission by section 152BC, but it applies with the following changes."@en ;
    cml:integrityHash "dccdd1a5b84be7b3addf0a7a4333eb512a8d22bd485c9ae8da10019f63d5bba3" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-132-2 ;
    cof:pageNumber "136"^^xsd:integer ;
    skos:note "Applying a modified version of the Acts Interpretation Act 1901 to a power conferred on the Commission by section 152BC. Commission must hold a public inquiry under Part 25 of the Telecommunications Act 1997 about a proposal to make an access determination." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010.pdf, p.136" ;
    cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-132-2-ss-1-norm .
