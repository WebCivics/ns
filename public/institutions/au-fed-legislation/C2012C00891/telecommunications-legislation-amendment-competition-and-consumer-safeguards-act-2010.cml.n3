    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577bf-ss-5 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577bf-ss-6 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-577bf-ss-7 ;
