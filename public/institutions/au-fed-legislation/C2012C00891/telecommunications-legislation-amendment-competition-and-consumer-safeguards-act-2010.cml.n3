doc:sch-1-sec-156-2 a cof:Section ;
    cof:title "156 Telecommunications Legislation Amendment (Competition and" ;
    values:kind "section" ;
    values:originalText "Consumer Safeguards) Act 2010 152CBCA  Serial undertakings  If:  (a) a person gives a special access undertaking (the first special access undertaking) to the Commission; and  (b) the Commission rejects the first special access undertaking; and  (c) the person subsequently gives another special access undertaking to the Commission; and  (d) the Commission is satisfied that any or all of the provisions of the first special access application are materially similar to any or all of the provisions of the other special access undertaking; the Commission may refuse to consider the other special access undertaking." ;
    cof:pageNumber "160"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-170 a cml:Concept ;
    skos:prefLabel "170 After paragraph 152CBD(2)(c)"@en ;
    cml:realizedBy doc:sch-1-sec-170 ;
    values:originalText "Insert:  (ca) if subsection 152CBA(3B) applies—the Commission is satisfied that:  (i) the conduct referred to in paragraph 152CBA(3B)(a) will promote the long-term interests of end-users of carriage services or of services supplied by means of carriage services; and  (ii) the terms and conditions referred to in paragraph 152CBA(3B)(b) are reasonable; and" ;
    skos:definition "Insert:  (ca) if subsection 152CBA(3B) applies—the Commission is satisfied that:  (i) the conduct referred to in paragraph 152CBA(3B)(a) will promote the long-term interests of end-users of carriage services or of services supplied by means of carriage services; and  (ii) the terms and conditions referred to in paragraph 152CBA(3B)(b) are reasonable; and"@en ;
    cml:integrityHash "7546be39efe12ba4764bcdd78799b5315e6f549ada3a6718c2af12a340d10b19" ;
    cof:pageNumber "160"^^xsd:integer ;
    skos:note "Commission must be satisfied that conduct promotes long-term interests of end-users and terms and conditions are reasonable." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
