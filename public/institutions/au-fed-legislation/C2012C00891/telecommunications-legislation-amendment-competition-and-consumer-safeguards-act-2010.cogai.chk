  type: LogicApplication;
  provision: sch-1-sec-134-2-ss-4;
  logic: Deontic;
  operator: involvement;
  summary: Involvement in a contravention is an obligation.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: A person who has aided, abetted, counselled or procured the contravention is involved.;
  @action: The person is obligated to prevent further involvement.;
}

telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-134-2-ss-4-logic-845 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-1-sec-134-2-ss-4;
  logic: Deontic;
  operator: involvement;
  summary: Involvement in a contravention is an obligation.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: A person who has induced the contravention, whether through threats or promises or otherwise, is involved.;
  @action: The person is obligated to prevent further involvement.;
}

telecommunications-legislation-amendment-competition-and-consumer-safeguards-act-2010-sch-1-sec-134-2-ss-4-logic-846 {
  activation: 1.0000;
