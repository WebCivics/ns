      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Other evidence can be led at any time before or after subsection (1)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
