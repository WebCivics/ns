      "cml:logicSummary": "Defendant bears evidential burden.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Subsection (2) does not apply if the person has a reasonable excuse."
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-2013-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The defendant must provide evidence of a reasonable excuse.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Defendant bears evidential burden in relation to subsection (4).",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "A defendant bears an evidential burden in relation to the matter in subsection (4)."
    },
    {
