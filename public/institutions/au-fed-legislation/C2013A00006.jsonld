      "cml:logicSummary": "Prohibits marriage to a person married to more than one person.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(ii) a party to the marriage is married (within the meaning of this subsection) to more than one person."
