    {
      "@id": "concept:c2013a00006-sch-1-sec-2013-3-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Other cases have different penalties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Overlaps with other provisions regarding employment practices and penalties.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "(b) in any other case—"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-2013-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "No exploitation or confiscation allowed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits exploitation and confiscation of travel or identity documents.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(ii) the extent to which the victim will be free to cease providing the labour or services;"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-2013-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "No unprotected sex required.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits provision of sexual services requiring unprotected sex.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(vi) if the engagement is to involve the provision of sexual services—that fact, or the nature of sexual services to be provided (for example, whether those services will require the victim to have unprotected sex)."
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-2013-3-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty depends on offense severity.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Implies imprisonment for specific terms based on offense severity.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Imply",
      "cml:premiseText": "(a) in the case of an aggravated offence (see section 270.8)—"
    },
