    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-10-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "∃t (t ∈ A ∧ t ∈ B)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "If A overlaps with B, then there is a temporal interval where both A and B occur.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "A ∩ B ≠ ∅"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-10-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A ∃B",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "If A recognizes B, then A is aware of B.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "(A R B)"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-10-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "~A | ~B",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If A implies B, then if not A, then not B.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(A -> B)"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-10-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "∀x (Ax → Bx)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "If A diffuses into B, then all instances of A are also instances of B.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "A ⊆ B"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-10-ss-3-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "C",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "If A and B, then C.",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Conjunction",
      "cml:premiseText": "(A ∧ B)"
    },
