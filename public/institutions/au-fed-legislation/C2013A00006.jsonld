      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information is diffused about forced labour.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
