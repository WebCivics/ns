doc:sch-1-sec-12-2-ss-3 a cof:Section ;
    cof:title "12(3) Crimes Legislation Amendment (Slavery, Slavery-like Conditions and People" ;
    values:kind "subsection" ;
    values:originalText "(3) Subsection (1) does not:  (a) prevent the leading of any other evidence in the relevant proceedings; or  (b) limit the manner in which evidence may be given or the admissibility of evidence. Subdivision D—Offences against Division 270: general" ;
    cof:pageNumber "16"^^xsd:integer .

concept:c2013a00006-sch-1-sec-270-13 a cml:Concept ;
    skos:prefLabel "270 11  Offences against Division 270—no defence of victim consent"@en ;
    cml:realizedBy doc:sch-1-sec-270-13 ;
    values:originalText "or acquiescence  To avoid doubt, it is not a defence in a proceeding for an offence against this Division that a person against whom the offence is alleged to have been committed consented to, or acquiesced in, conduct constituting any element of the offence." ;
    skos:definition "or acquiescence  To avoid doubt, it is not a defence in a proceeding for an offence against this Division that a person against whom the offence is alleged to have been committed consented to, or acquiesced in, conduct constituting any element of the offence."@en ;
