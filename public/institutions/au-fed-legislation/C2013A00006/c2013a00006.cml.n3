concept:c2013a00006-sch-1-sec-2013-10-ss-4 a cml:Concept ;
    skos:prefLabel "2013(4) No. 6, 2013            23"@en ;
    cml:realizedBy doc:sch-1-sec-2013-10-ss-4 ;
    values:originalText "(4) Subsection (1) does not:  (a) prevent the leading of any other evidence in the relevant proceedings; or  (b) limit the manner in which evidence may be given or the admissibility of evidence." ;
    skos:definition "(4) Subsection (1) does not:  (a) prevent the leading of any other evidence in the relevant proceedings; or  (b) limit the manner in which evidence may be given or the admissibility of evidence."@en ;
