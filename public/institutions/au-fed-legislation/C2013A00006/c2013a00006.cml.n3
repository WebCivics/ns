concept:c2013a00006-sch-1-sec-2013-3 cml:asserts concept:c2013a00006-sch-1-sec-2013-3-logic-deontic-1 .
concept:c2013a00006-sch-1-sec-2013-3-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits exploitation and confiscation of travel or identity documents." ;
    cml:premiseText "(ii) the extent to which the victim will be free to cease providing the labour or services;" ;
    cml:conclusionText "No exploitation or confiscation allowed." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2013a00006-sch-1-sec-2013-3 cml:asserts concept:c2013a00006-sch-1-sec-2013-3-logic-deontic-2 .
