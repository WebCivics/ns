concept:c2013a00006-sch-1-sec-2013 a cml:Concept ;
    skos:prefLabel "2013 No. 6, 2013            5"@en ;
    cml:realizedBy doc:sch-1-sec-2013 ;
    values:originalText "(b) a threat to cause a person’s deportation or removal from Australia; or  (c) a threat of any other detrimental action, unless there are reasonable grounds for the threat of that action in connection with the provision of labour or services by a person. Note: Threat includes a threat made by any conduct, whether express or implied and whether conditional or unconditional (see the definition in the Dictionary). Subdivision B—Slavery" ;
    skos:definition "(b) a threat to cause a person’s deportation or removal from Australia; or  (c) a threat of any other detrimental action, unless there are reasonable grounds for the threat of that action in connection with the provision of labour or services by a person. Note: Threat includes a threat made by any conduct, whether express or implied and whether conditional or unconditional (see the definition in the Dictionary). Subdivision B—Slavery"@en ;
    cml:integrityHash "48591a1cc386155a789f06c65fb81e00d0164929bcb2c14e90c342bf4b4324a9" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Threats to cause deportation or removal from Australia are prohibited, unless there are reasonable grounds." ;
    cml:curationStatus cml:Proposed ;
