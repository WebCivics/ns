concept:c2013a00006-sch-1-sec-271-4 a cml:Concept ;
    skos:prefLabel "271 7A  Removal of organs contrary to this Subdivision"@en ;
    cml:realizedBy doc:sch-1-sec-271-4 ;
    values:originalText "The removal of a person’s organ is contrary to this Subdivision if:  (a) the removal, or entering into an agreement for the removal, would be contrary to the law of the State or Territory where it is, or is to be, carried out; or  (b) neither the victim, nor the victim’s guardian, consents to the removal, and it would not meet a medical or therapeutic need of the victim." ;
    skos:definition "The removal of a person’s organ is contrary to this Subdivision if:  (a) the removal, or entering into an agreement for the removal, would be contrary to the law of the State or Territory where it is, or is to be, carried out; or  (b) neither the victim, nor the victim’s guardian, consents to the removal, and it would not meet a medical or therapeutic need of the victim."@en ;
    cml:integrityHash "6b47f66f050f753ab061029d1f12c240996a6c45859568e40ceaf46b8efa76a7" ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "Removal of organs contrary to this Subdivision is prohibited if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2013a00006.pdf> ;
    dc:source "c2013a00006.pdf, p.20" ;
