doc:sch-1-sec-2013-10-ss-2 a cof:Section ;
    cof:title "2013(2) No. 6, 2013            23" ;
    values:kind "subsection" ;
    values:originalText "(2) The following matters are covered by this subsection:  (a) the economic relationship between the alleged victim and the alleged offender;  (b) the terms of any written or oral contract or agreement between the alleged victim and the alleged offender;  (c) the personal circumstances of the alleged victim, including but not limited to:  (i) whether he or she is entitled to be in Australia under the Migration Act 1958; and  (ii) his or her ability to speak, write and understand English or another language; and  (iii) the extent of his or her social and physical dependence on the alleged offender." ;
    cof:pageNumber "27"^^xsd:integer .

concept:c2013a00006-sch-1-sec-2013-10-ss-3 a cml:Concept ;
    skos:prefLabel "2013(3) No. 6, 2013            23"@en ;
    cml:realizedBy doc:sch-1-sec-2013-10-ss-3 ;
    values:originalText "(3) If subsection (1) applies in relation to the consent of an alleged victim’s guardian to the removal of an organ of the alleged victim, a reference in subsection (2) to the alleged victim is taken to include a reference to the alleged victim’s guardian." ;
    skos:definition "(3) If subsection (1) applies in relation to the consent of an alleged victim’s guardian to the removal of an organ of the alleged victim, a reference in subsection (2) to the alleged victim is taken to include a reference to the alleged victim’s guardian."@en ;
    cml:integrityHash "b93132f429cfb10ed77f221c9aa8db6068fab439e40b79f0d7dc7fecb6db4d5a" ;
    values:partOf concept:c2013a00006-sch-1-sec-2013-10 ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Reference to alleged victim includes guardian in organ removal context." ;
