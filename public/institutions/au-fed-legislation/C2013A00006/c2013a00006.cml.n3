concept:c2013a00006-sch-1-sec-29 a cml:Concept ;
    skos:prefLabel "29 At the end of section 271.3 of the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-29 ;
    values:originalText "Add:  (3) Subsection (2) only applies if the defendant has been afforded procedural fairness in relation to the finding of guilt for the offence against section 271.2. Note: Section 271.2 provides for offences of trafficking in persons." ;
