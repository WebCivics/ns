    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-10-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Crimes Legislation Amendment (Slavery, Slavery-like Conditions and People",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-10-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2013a00006.pdf"
      },
      "dc:source": "c2013a00006.pdf, p.14",
      "values:originalText": "(i) a party to the marriage has not freely or fully consented\nto the marriage (for example, because of natural,\ninduced or age-related incapacity);\n\n(ii) a party to the marriage is married (within the meaning\nof this subsection) to more than one person.\nNote:\nSection 2E of the Acts Interpretation Act 1901 covers relationships\nregistered under a law of a State or Territory that are prescribed by\nregulations under that Act.\n\n(3) Subsection (1) applies whether the coercion, threat or deception is\nused against the victim or another person.",
      "skos:definition": "(i) a party to the marriage has not freely or fully consented\nto the marriage (for example, because of natural,\ninduced or age-related incapacity);\n\n(ii) a party to the marriage is married (within the meaning\nof this subsection) to more than one person.\nNote:\nSection 2E of the Acts Interpretation Act 1901 covers relationships\nregistered under a law of a State or Territory that are prescribed by\nregulations under that Act.\n\n(3) Subsection (1) applies whether the coercion, threat or deception is\nused against the victim or another person.",
      "cml:asserts": [
        {
          "@id": "concept:c2013a00006-sch-1-sec-10-2-norm"
        },
