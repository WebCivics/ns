    {
      "@id": "concept:c2013a00006-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Section 270.12 of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
