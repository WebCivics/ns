      "cml:conclusionText": "Obligation to limit"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-51-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "51(3) At the end of section 271.12 of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-51-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2013a00006.pdf"
      },
      "dc:source": "c2013a00006.pdf, p.28",
      "values:originalText": "(3) Subsection (2) applies even if the other law of the Commonwealth,\nor the law of the State or Territory, does any one or more of the\nfollowing:\n\n(a) provides for a penalty for the offence that differs from the\npenalty provided for in this Division;\n\n(b) provides for a fault element in relation to the offence that\ndiffers from the fault elements applicable to the offence\nunder this Division;\n\n(c) provides for a defence in relation to the offence that differs\nfrom the defences applicable to the offence under this\nDivision.",
      "skos:definition": "(3) Subsection (2) applies even if the other law of the Commonwealth,\nor the law of the State or Territory, does any one or more of the\nfollowing:\n\n(a) provides for a penalty for the offence that differs from the\npenalty provided for in this Division;\n\n(b) provides for a fault element in relation to the offence that\ndiffers from the fault elements applicable to the offence\nunder this Division;\n\n(c) provides for a defence in relation to the offence that differs\nfrom the defences applicable to the offence under this\nDivision.",
      "values:partOf": {
        "@id": "concept:c2013a00006-sch-1-sec-51"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2013a00006-sch-1-sec-51-ss-3-norm"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-51-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a1b83237caac97f6e5606dc553afa5eaade5de81898238068bc731b84175a04e",
      "skos:note": "Applicability of subsection (2) despite other laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-51-ss-3",
      "@type": "cof:Section",
      "cof:title": "51(3) At the end of section 271.12 of the Criminal Code",
      "values:kind": "subsection",
      "cof:pageNumber": 28,
      "values:originalText": "(3) Subsection (2) applies even if the other law of the Commonwealth,\nor the law of the State or Territory, does any one or more of the\nfollowing:\n\n(a) provides for a penalty for the offence that differs from the\npenalty provided for in this Division;\n\n(b) provides for a fault element in relation to the offence that\ndiffers from the fault elements applicable to the offence\nunder this Division;\n\n(c) provides for a defence in relation to the offence that differs\nfrom the defences applicable to the offence under this\nDivision."
    },
    {
