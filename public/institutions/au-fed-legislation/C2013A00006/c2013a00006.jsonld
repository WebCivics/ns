        }
      ],
      "cml:integrityHash": "ed4536ba9362a6fcfc8062d52889b1f90799fbc1f89feb4b534b68d963ed0153",
      "skos:note": "Defendant bears evidential burden in relation to reasonable excuse."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-2013-4",
      "@type": "cof:Section",
      "cof:title": "2013 No. 6, 2013            11",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "(4) Subsection (2) does not apply if the person has a reasonable\nexcuse.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (4) (see subsection 13.3(3))."
    },
    {
