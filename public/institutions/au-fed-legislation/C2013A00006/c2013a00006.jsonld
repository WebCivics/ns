    {
      "@id": "concept:c2013a00006-sch-1-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 At the end of section 271.3 of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2013a00006.pdf"
      },
      "dc:source": "c2013a00006.pdf, p.19",
      "values:originalText": "Add:\n\n(3) Subsection (2) only applies if the defendant has been afforded\nprocedural fairness in relation to the finding of guilt for the offence\nagainst section 271.2.\nNote:\nSection 271.2 provides for offences of trafficking in persons.",
      "skos:definition": "Add:\n\n(3) Subsection (2) only applies if the defendant has been afforded\nprocedural fairness in relation to the finding of guilt for the offence\nagainst section 271.2.\nNote:\nSection 271.2 provides for offences of trafficking in persons.",
      "cml:asserts": [
        {
          "@id": "concept:c2013a00006-sch-1-sec-29-norm"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-29-logic-deontic-1"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-29-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-29-logic-ltl-3"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-29-logic-deontic-4"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-29-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "010b1ecc081c2dd288b7e30aa7f7577e34ca8d0b6a317c49eece81511dba2d3b",
      "skos:note": "Procedural fairness is required for the application of subsection (2) of section 271.3."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-29",
      "@type": "cof:Section",
      "cof:title": "29 At the end of section 271.3 of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Add:\n\n(3) Subsection (2) only applies if the defendant has been afforded\nprocedural fairness in relation to the finding of guilt for the offence\nagainst section 271.2.\nNote:\nSection 271.2 provides for offences of trafficking in persons."
    },
