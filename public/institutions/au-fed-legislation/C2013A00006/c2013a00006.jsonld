        }
      ],
      "cml:integrityHash": "7843bc53836fed733150bb2d6b65569ee9fa96c9b21bd221f66b13fe63abf68e",
      "skos:note": "Harbouring a victim is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-271-9",
