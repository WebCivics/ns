      "cml:operator": "applicable",
      "cml:logicSummary": "Applicability of subsection (2)",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
