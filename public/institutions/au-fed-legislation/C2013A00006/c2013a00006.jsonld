    {
      "@id": "concept:c2013a00006-sch-3-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Application of amendments made by this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-3-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2013a00006.pdf"
      },
      "dc:source": "c2013a00006.pdf, p.33",
      "values:originalText": "The amendments made by this Act apply in relation to an offence\nagainst a law of the Commonwealth committed (or alleged to have been\ncommitted) on or after the day this Act commences.\nNote:\nThis Act commences on the day after the Act receives the Royal\nAssent (see section 2).\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2012\nSenate on 27 February 2013]\n\n(110/12)\nComLaw Authoritative Act C2013A00006",
      "skos:definition": "The amendments made by this Act apply in relation to an offence\nagainst a law of the Commonwealth committed (or alleged to have been\ncommitted) on or after the day this Act commences.\nNote:\nThis Act commences on the day after the Act receives the Royal\nAssent (see section 2).\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2012\nSenate on 27 February 2013]\n\n(110/12)\nComLaw Authoritative Act C2013A00006",
      "cml:asserts": [
        {
          "@id": "concept:c2013a00006-sch-3-sec-1-norm"
        },
        {
          "@id": "concept:c2013a00006-sch-3-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "589bc8da7664ffecd6852cb9f70708983c37d763d8d1f8440e393b51b4e9d4c2",
      "skos:note": "Amendments apply to offences committed on or after the Act's commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-3-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Application of amendments made by this Act",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "The amendments made by this Act apply in relation to an offence\nagainst a law of the Commonwealth committed (or alleged to have been\ncommitted) on or after the day this Act commences.\nNote:\nThis Act commences on the day after the Act receives the Royal\nAssent (see section 2).\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2012\nSenate on 27 February 2013]\n\n(110/12)\nComLaw Authoritative Act C2013A00006"
    },
