      "cml:premiseText": "(1) For the purposes of this Division, a marriage is a forced marriage..."
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-8-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "270(2) 7A  Definition of forced marriage",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-270-8-ss-2"
      },
      "cml:curationStatus": {
