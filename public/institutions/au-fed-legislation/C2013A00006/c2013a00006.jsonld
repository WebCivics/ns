    {
      "@id": "concept:c2013a00006-sch-1-sec-271-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "271 7F  Harbouring a victim",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-271-9"
      },
      "cml:curationStatus": {
