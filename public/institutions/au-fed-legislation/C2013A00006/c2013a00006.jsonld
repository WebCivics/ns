      },
      "cml:operator": "Schema validation",
      "cml:logicSummary": "Validates schema of the text",
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
