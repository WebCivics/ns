      }
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-271-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "271 7C  Organ trafficking—aggravated offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-271-6"
      },
