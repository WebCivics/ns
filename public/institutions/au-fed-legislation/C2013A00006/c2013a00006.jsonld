    {
      "@id": "concept:c2013a00006-sch-1-sec-270-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "270 11  Offences against Division 270—no defence of victim consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-270-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2013a00006.pdf"
      },
      "dc:source": "c2013a00006.pdf, p.16",
      "values:originalText": "or acquiescence\n\nTo avoid doubt, it is not a defence in a proceeding for an offence\nagainst this Division that a person against whom the offence is\nalleged to have been committed consented to, or acquiesced in,\nconduct constituting any element of the offence.",
      "skos:definition": "or acquiescence\n\nTo avoid doubt, it is not a defence in a proceeding for an offence\nagainst this Division that a person against whom the offence is\nalleged to have been committed consented to, or acquiesced in,\nconduct constituting any element of the offence.",
      "cml:asserts": [
        {
          "@id": "concept:c2013a00006-sch-1-sec-270-13-norm"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-deontic-1"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-ltl-3"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-cogai-4"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "3942bee589631ea54e29bbb3b62c05fe470cf011469062b7ccc5839cc31cfa30",
      "skos:note": "No defence of victim consent for offences against Division 270"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-270-13",
      "@type": "cof:Section",
      "cof:title": "270 11  Offences against Division 270—no defence of victim consent",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "or acquiescence\n\nTo avoid doubt, it is not a defence in a proceeding for an offence\nagainst this Division that a person against whom the offence is\nalleged to have been committed consented to, or acquiesced in,\nconduct constituting any element of the offence."
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-13-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
