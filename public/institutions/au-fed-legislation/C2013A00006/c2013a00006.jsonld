      }
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-2013",
      "@type": "cml:Concept",
      "skos:prefLabel": "2013 No. 6, 2013            5",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-2013"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2013a00006.pdf"
      },
      "dc:source": "c2013a00006.pdf, p.9",
      "values:originalText": "(b) a threat to cause a person’s deportation or removal from\nAustralia; or\n\n(c) a threat of any other detrimental action, unless there are\nreasonable grounds for the threat of that action in connection\nwith the provision of labour or services by a person.\nNote:\nThreat includes a threat made by any conduct, whether express or\nimplied and whether conditional or unconditional (see the definition in\nthe Dictionary).\nSubdivision B—Slavery",
      "skos:definition": "(b) a threat to cause a person’s deportation or removal from\nAustralia; or\n\n(c) a threat of any other detrimental action, unless there are\nreasonable grounds for the threat of that action in connection\nwith the provision of labour or services by a person.\nNote:\nThreat includes a threat made by any conduct, whether express or\nimplied and whether conditional or unconditional (see the definition in\nthe Dictionary).\nSubdivision B—Slavery",
      "cml:asserts": [
        {
          "@id": "concept:c2013a00006-sch-1-sec-2013-norm"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-2013-logic-deontic-1"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-2013-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-2013-logic-alleninterval-3"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-2013-logic-ltl-4"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-2013-logic-diffusion-5"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-2013-logic-cogai-6"
        }
      ],
      "cml:integrityHash": "48591a1cc386155a789f06c65fb81e00d0164929bcb2c14e90c342bf4b4324a9",
      "skos:note": "Threats to cause deportation or removal from Australia are prohibited, unless there are reasonable grounds."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-2013",
      "@type": "cof:Section",
      "cof:title": "2013 No. 6, 2013            5",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "(b) a threat to cause a person’s deportation or removal from\nAustralia; or\n\n(c) a threat of any other detrimental action, unless there are\nreasonable grounds for the threat of that action in connection\nwith the provision of labour or services by a person.\nNote:\nThreat includes a threat made by any conduct, whether express or\nimplied and whether conditional or unconditional (see the definition in\nthe Dictionary).\nSubdivision B—Slavery"
    },
