    {
      "@id": "concept:c2013a00006-sch-1-sec-20-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Crimes Legislation Amendment (Slavery, Slavery-like Conditions and People",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-20-2"
