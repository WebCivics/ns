    {
      "@id": "concept:c2013a00006-sch-2-sec-245ah",
      "@type": "cml:Concept",
      "skos:prefLabel": "245AH Meaning of exploited",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-2-sec-245ah"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2013a00006.pdf"
      },
      "dc:source": "c2013a00006.pdf, p.31",
      "values:originalText": "For the purposes of this Subdivision, a person is exploited if the\nperson is subjected to exploitation within the meaning of the\nCriminal Code (see section 271.1A of the Criminal Code).\nProceeds of Crime Act 2002",
      "skos:definition": "For the purposes of this Subdivision, a person is exploited if the\nperson is subjected to exploitation within the meaning of the\nCriminal Code (see section 271.1A of the Criminal Code).\nProceeds of Crime Act 2002",
      "cml:asserts": [
        {
          "@id": "concept:c2013a00006-sch-2-sec-245ah-norm"
        }
      ],
      "cml:integrityHash": "0cb89ce72aa10fadc90172c058910db2c2a060633cff13027159223919d076f8",
      "skos:note": "A person is exploited if they are subjected to exploitation within the meaning of the Criminal Code."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-2-sec-245ah",
      "@type": "cof:Section",
      "cof:title": "245AH Meaning of exploited",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "For the purposes of this Subdivision, a person is exploited if the\nperson is subjected to exploitation within the meaning of the\nCriminal Code (see section 271.1A of the Criminal Code).\nProceeds of Crime Act 2002"
    },
