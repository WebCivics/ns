      },
      "cml:premiseText": "(3) Subsection (1) applies whether the coercion, threat or deception is\nused against the victim or another person.",
      "cml:conclusionText": "...the coercion, threat or deception is used against the victim or another person."
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-10-2-logic-alleninterval-4",
