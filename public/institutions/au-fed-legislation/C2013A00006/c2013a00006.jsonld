        "@id": "concept:c2013a00006-sch-1-sec-270-13"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits defence of victim consent",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No defence in a proceeding for an offence against this Division that a person against whom the offence is alleged to have been committed consented to, or acquiesced in...",
      "cml:conclusionText": "No defence of victim consent"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Establishes temporal relation between consent and offence",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "alleged to have been committed at the same time as the consent or acquiescence",
      "cml:conclusionText": "Consent and offence occur at the same time"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Establishes recurring trace of consent and offence",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "consent or acquiescence is a recurring event",
      "cml:conclusionText": "Consent and offence are recurring events"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Entity recognition",
      "cml:logicSummary": "Recognizes entity of consent in the text",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "person against whom the offence is alleged to have been committed",
      "cml:conclusionText": "Person is an entity of consent"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-270-13-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
