    {
      "@id": "concept:c2013a00006-sch-1-sec-271",
      "@type": "cml:Concept",
      "skos:prefLabel": "271 1A  Definition of exploitation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-271"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2013a00006.pdf"
      },
      "dc:source": "c2013a00006.pdf, p.18",
      "values:originalText": "For the purposes of this Division, exploitation, of one person (the\nvictim) by another person, occurs if the other person’s conduct\ncauses the victim to enter into any of the following conditions:\n\n(a) slavery, or a condition similar to slavery;\n\n(b) servitude;\n\n(c) forced labour;\n\n(d) forced marriage;\n\n(e) debt bondage.\nNote:",
      "skos:definition": "For the purposes of this Division, exploitation, of one person (the\nvictim) by another person, occurs if the other person’s conduct\ncauses the victim to enter into any of the following conditions:\n\n(a) slavery, or a condition similar to slavery;\n\n(b) servitude;\n\n(c) forced labour;\n\n(d) forced marriage;\n\n(e) debt bondage.\nNote:",
      "cml:asserts": [
        {
          "@id": "concept:c2013a00006-sch-1-sec-271-norm"
        },
        {
          "@id": "concept:c2013a00006-sch-1-sec-271-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f9de71cc4fa50268630b7017b4a7c74dbfaf99f5fb198ab75599924c992fb8a2",
      "skos:note": "Definition of exploitation"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-271",
      "@type": "cof:Section",
      "cof:title": "271 1A  Definition of exploitation",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "For the purposes of this Division, exploitation, of one person (the\nvictim) by another person, occurs if the other person’s conduct\ncauses the victim to enter into any of the following conditions:\n\n(a) slavery, or a condition similar to slavery;\n\n(b) servitude;\n\n(c) forced labour;\n\n(d) forced marriage;\n\n(e) debt bondage.\nNote:"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-271-norm",
      "@type": "values:Obligation",
      "cml:modality": {
