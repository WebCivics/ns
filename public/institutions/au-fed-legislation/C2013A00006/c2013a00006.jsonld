    {
      "@id": "concept:c2013a00006-sch-1-sec-271-11-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "271(3) 9  Debt bondage—aggravated offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-271-11-ss-3"
