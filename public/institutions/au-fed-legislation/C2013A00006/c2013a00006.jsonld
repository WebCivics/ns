    {
      "@id": "concept:c2013a00006-sch-1-sec-12-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Crimes Legislation Amendment (Slavery, Slavery-like Conditions and People",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2013a00006#sch-1-sec-12-2"
      },
