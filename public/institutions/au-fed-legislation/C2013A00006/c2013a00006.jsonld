          "@id": "concept:c2013a00006-sch-1-sec-14-norm"
        }
      ],
      "cml:integrityHash": "5d7badac56a858100c60b8458cc4dfc2afccfb69ba6e91af98e5ff0f00326681",
      "skos:note": "Insertion of section number in Criminal Code"
