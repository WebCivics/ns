      "cml:operator": "Interval",
      "cml:logicSummary": "Subsection (2) does not apply if the person has an interval of reasonable excuses.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
