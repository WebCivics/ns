      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-271-16-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits defence of victim consent",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No defence in a proceeding for an offence against this Division that a person against whom the offence is alleged to have been committed consented to, or acquiesced in...",
      "cml:conclusionText": "No defence of victim consent"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-271-16-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Establishes temporal relation between consent and offence",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "alleged to have been committed at the same time as the consent or acquiescence",
      "cml:conclusionText": "Consent and offence occur at the same time"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-271-16-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Establishes temporal relation between consent and offence",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "alleged to have been committed after the consent or acquiescence",
      "cml:conclusionText": "Consent precedes the offence"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-271-16-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:logicSummary": "Spreads information about defence of victim consent",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No defence in a proceeding for an offence against this Division that a person against whom the offence is alleged to have been committed consented to, or acquiesced in...",
      "cml:conclusionText": "Defence of victim consent spreads"
    },
    {
      "@id": "concept:c2013a00006-sch-1-sec-271-16-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:logicSummary": "Infers prohibition from Deontic logic",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Prohibit defence of victim consent",
      "cml:conclusionText": "No defence of victim consent"
    },
