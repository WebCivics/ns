concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-106-2 a cml:Concept ;
    skos:prefLabel "106 4  Saving—Federal Magistrates"@en ;
    cml:realizedBy doc:sch-1-sec-106-2 ;
    values:originalText "(1) An appointment that is in force immediately before the commencement of this section under subsection 105.2(1) in respect of a Federal Magistrate continues in force, after that commencement, as an appointment in respect of a Judge of the Federal Circuit Court of Australia under that subsection.  Schedule 1  Main amendments  (2) A consent that is in force immediately before the commencement of this section under subsection 105.2(2) in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia.  (3) A thing done by, or in relation to, a Federal Magistrate, as an issuing authority for continued preventative detention orders, under Division 105 before the commencement of this section has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing authority for continued preventative detention orders, under that Division." ;
    skos:definition "(1) An appointment that is in force immediately before the commencement of this section under subsection 105.2(1) in respect of a Federal Magistrate continues in force, after that commencement, as an appointment in respect of a Judge of the Federal Circuit Court of Australia under that subsection.  Schedule 1  Main amendments  (2) A consent that is in force immediately before the commencement of this section under subsection 105.2(2) in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia.  (3) A thing done by, or in relation to, a Federal Magistrate, as an issuing authority for continued preventative detention orders, under Division 105 before the commencement of this section has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing authority for continued preventative detention orders, under that Division."@en ;
    cml:integrityHash "73ed31f1bcbf1b8c3bbc6ad3b60a5cdf1f7cf5a31491464b3ddf30473598720c" ;
    cof:pageNumber "33"^^xsd:integer ;
    cml:hasPart concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-106-2-ss-1 ;
    cml:hasPart concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-106-2-ss-2 ;
    cml:hasPart concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-106-2-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf> ;
    dc:source "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.33" .
