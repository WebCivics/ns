concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-495 a cml:Concept ;
    skos:prefLabel "495 Saving provisions"@en ;
    cml:realizedBy doc:sch-1-sec-495 ;
    values:originalText "(1) A consent that is in force immediately before the commencement of this item under subsection 87(1) of the Product Stewardship Act 2011 in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia. (2) A nomination that is in force immediately before the commencement of this item under subsection 87(2) of the Product Stewardship Act 2011 in respect of a Federal Magistrate continues in force, after that commencement, as a nomination in respect of a Judge of the Federal Circuit Court of Australia. (3) A thing done by, or in relation to, a magistrate under Division 2 of Part 6 of the Product Stewardship Act 2011 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, an issuing officer under that Division.  Schedule 1  Main amendments  Renewable Energy (Electricity) Act 2000" ;
    skos:definition "(1) A consent that is in force immediately before the commencement of this item under subsection 87(1) of the Product Stewardship Act 2011 in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia. (2) A nomination that is in force immediately before the commencement of this item under subsection 87(2) of the Product Stewardship Act 2011 in respect of a Federal Magistrate continues in force, after that commencement, as a nomination in respect of a Judge of the Federal Circuit Court of Australia. (3) A thing done by, or in relation to, a magistrate under Division 2 of Part 6 of the Product Stewardship Act 2011 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, an issuing officer under that Division.  Schedule 1  Main amendments  Renewable Energy (Electricity) Act 2000"@en ;
    cml:integrityHash "55830a68bc2226bba8649ed65a6c3457ad88836755f7833c7a2d069b6a02cb95" ;
    cof:pageNumber "77"^^xsd:integer ;
    skos:note "Consent and nomination continuity" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf> ;
    dc:source "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.77" ;
