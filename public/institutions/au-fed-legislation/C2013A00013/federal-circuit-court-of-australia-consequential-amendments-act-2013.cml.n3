concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-233 a cml:Concept ;
    skos:prefLabel "233 Saving provisions"@en ;
    cml:realizedBy doc:sch-1-sec-233 ;
    values:originalText "(1) A consent that is in force immediately before the commencement of this item under subsection 45A(1) of the Extradition Act 1988 in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia. (2) A nomination that is in force immediately before the commencement of this item under subsection 45A(2) of the Extradition Act 1988 in respect of a Federal Magistrate continues in force, after that commencement, as a nomination in respect of a Judge of the Federal Circuit Court of Australia. (3) A thing done by, or in relation to, a Federal Magistrate under the Extradition Act 1988 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, an eligible Federal Circuit Court Judge under that Act. Fair Work Act 2009" ;
    skos:definition "(1) A consent that is in force immediately before the commencement of this item under subsection 45A(1) of the Extradition Act 1988 in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia. (2) A nomination that is in force immediately before the commencement of this item under subsection 45A(2) of the Extradition Act 1988 in respect of a Federal Magistrate continues in force, after that commencement, as a nomination in respect of a Judge of the Federal Circuit Court of Australia. (3) A thing done by, or in relation to, a Federal Magistrate under the Extradition Act 1988 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, an eligible Federal Circuit Court Judge under that Act. Fair Work Act 2009"@en ;
    cml:integrityHash "e713840515c61b61caea37c9f81eb8a2566f9967e67330028f9e0da144b7041d" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Consent and nomination continuity after commencement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf> ;
    dc:source "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.45" ;
    cml:asserts concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-233-norm .
