doc:sch-1-sec-106-2-ss-2 a cof:Section ;
    cof:title "106(2) 4  Saving—Federal Magistrates" ;
    values:kind "subsection" ;
    values:originalText "(2) A consent that is in force immediately before the commencement of this section under subsection 105.2(2) in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia." ;
    cof:pageNumber "33"^^xsd:integer .

concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-106-2-ss-3 a cml:Concept ;
    skos:prefLabel "106(3) 4  Saving—Federal Magistrates"@en ;
    cml:realizedBy doc:sch-1-sec-106-2-ss-3 ;
    values:originalText "(3) A thing done by, or in relation to, a Federal Magistrate, as an issuing authority for continued preventative detention orders, under Division 105 before the commencement of this section has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing authority for continued preventative detention orders, under that Division." ;
    skos:definition "(3) A thing done by, or in relation to, a Federal Magistrate, as an issuing authority for continued preventative detention orders, under Division 105 before the commencement of this section has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing authority for continued preventative detention orders, under that Division."@en ;
