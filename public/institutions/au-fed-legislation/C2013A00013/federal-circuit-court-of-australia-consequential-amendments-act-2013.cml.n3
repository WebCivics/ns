concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-45 a cml:Concept ;
    skos:prefLabel "45 Saving provision"@en ;
    cml:realizedBy doc:sch-1-sec-45 ;
    values:originalText "A thing done by, or in relation to, a Federal Magistrate, as an issuing officer, under Division 1A of Part II of the Australian Crime Commission Act 2002 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing officer, under that Division. Australian Energy Market Act 2004" ;
    skos:definition "A thing done by, or in relation to, a Federal Magistrate, as an issuing officer, under Division 1A of Part II of the Australian Crime Commission Act 2002 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing officer, under that Division. Australian Energy Market Act 2004"@en ;
    cml:integrityHash "5a50a95e53354bdeb1362b8788b39acf11375959d02572dda394000d287f3e0f" ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "Saving provision for actions taken by Federal Magistrate before commencement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
