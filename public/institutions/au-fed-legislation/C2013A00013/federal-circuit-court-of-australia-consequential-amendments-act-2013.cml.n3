concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-53 a cml:Concept ;
    skos:prefLabel "53 Saving provisions"@en ;
    cml:realizedBy doc:sch-1-sec-53 ;
    values:originalText "(1) An appointment that is in force immediately before the commencement of this item under section 34AB of the Australian Security Intelligence Organisation Act 1979 continues in force, after that commencement, as:  (a) an appointment under section 34AB of that Act (as amended by this Act); and  (b) if the appointment is in respect of a Federal Magistrate—an appointment in respect of a Judge of the Federal Circuit Court of Australia. (2) A consent that is in force immediately before the commencement of this item under subsection 34AB(2) of the Australian Security Intelligence Organisation Act 1979 in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia. (3) A thing done by, or in relation to, a Federal Magistrate, as an issuing authority, under Division 3 of Part III of the Australian Security Intelligence Organisation Act 1979 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing authority, under that Division. Bankruptcy Act 1966" ;
    skos:definition "(1) An appointment that is in force immediately before the commencement of this item under section 34AB of the Australian Security Intelligence Organisation Act 1979 continues in force, after that commencement, as:  (a) an appointment under section 34AB of that Act (as amended by this Act); and  (b) if the appointment is in respect of a Federal Magistrate—an appointment in respect of a Judge of the Federal Circuit Court of Australia. (2) A consent that is in force immediately before the commencement of this item under subsection 34AB(2) of the Australian Security Intelligence Organisation Act 1979 in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia. (3) A thing done by, or in relation to, a Federal Magistrate, as an issuing authority, under Division 3 of Part III of the Australian Security Intelligence Organisation Act 1979 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing authority, under that Division. Bankruptcy Act 1966"@en ;
    cml:integrityHash "275b59c18833b5d61ae2212131914cc3a8519d82a460db174e51fe28e71c2082" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Appointment and consent continuity after commencement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf> ;
    dc:source "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.24" ;
    cml:asserts concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-53-norm .
