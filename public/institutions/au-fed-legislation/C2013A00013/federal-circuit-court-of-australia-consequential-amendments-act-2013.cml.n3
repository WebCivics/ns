concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-555 a cml:Concept ;
    skos:prefLabel "555 Saving provisions"@en ;
    cml:realizedBy doc:sch-1-sec-555 ;
    values:originalText "(1) A consent that is in force immediately before the commencement of this item under subsection 79(1) of the Tobacco Plain Packaging Act 2011 in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia. (2) A nomination that is in force immediately before the commencement of this item under subsection 79(2) of the Tobacco Plain Packaging Act 2011 in respect of a Federal Magistrate continues in force, after that commencement, as a nomination in respect of a Judge of the Federal Circuit Court of Australia. (3) A thing done by, or in relation to, a Federal Magistrate, as an issuing officer, under Part 2 of Chapter 4 of the Tobacco Plain Packaging Act 2011 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing officer, under that Part. Trans-Tasman Proceedings Act 2010" ;
    skos:definition "(1) A consent that is in force immediately before the commencement of this item under subsection 79(1) of the Tobacco Plain Packaging Act 2011 in respect of a Federal Magistrate continues in force, after that commencement, as a consent in respect of a Judge of the Federal Circuit Court of Australia. (2) A nomination that is in force immediately before the commencement of this item under subsection 79(2) of the Tobacco Plain Packaging Act 2011 in respect of a Federal Magistrate continues in force, after that commencement, as a nomination in respect of a Judge of the Federal Circuit Court of Australia. (3) A thing done by, or in relation to, a Federal Magistrate, as an issuing officer, under Part 2 of Chapter 4 of the Tobacco Plain Packaging Act 2011 before the commencement of this item has effect, after that commencement, as if it had been done by, or in relation to, a Judge of the Federal Circuit Court of Australia, as an issuing officer, under that Part. Trans-Tasman Proceedings Act 2010"@en ;
    cml:integrityHash "c2d847d4779af8df54bcd382c09fd4f75928daed79ba9594ef1f039f5c09138d" ;
    cof:pageNumber "85"^^xsd:integer ;
    skos:note "Consent and nomination continuity" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf> ;
    dc:source "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.85" ;
    cml:asserts concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-555-norm .
concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-555-norm a values:Undertaking ;
