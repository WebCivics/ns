concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-4-sec-1 a cml:Concept ;
    skos:prefLabel "1 Transfer of appropriated money"@en ;
    cml:realizedBy doc:sch-4-sec-1 ;
    values:originalText "(1) For the purposes of the operation of an Appropriation Act after this Schedule commences, references to the Federal Magistrates Court of Australia are to be read as references to the Federal Circuit Court of Australia. (2) In this item: Appropriation Act means an Act appropriating money for expenditure out of the Consolidated Revenue Fund." ;
    skos:definition "(1) For the purposes of the operation of an Appropriation Act after this Schedule commences, references to the Federal Magistrates Court of Australia are to be read as references to the Federal Circuit Court of Australia. (2) In this item: Appropriation Act means an Act appropriating money for expenditure out of the Consolidated Revenue Fund."@en ;
    cml:integrityHash "2da1d92d910f6ea0738d1ddd2b091de5436d39ebf5d1b6d6083ea2c588181468" ;
    cof:pageNumber "109"^^xsd:integer ;
    skos:note "References to Federal Magistrates Court of Australia should be read as references to Federal Circuit Court of Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
