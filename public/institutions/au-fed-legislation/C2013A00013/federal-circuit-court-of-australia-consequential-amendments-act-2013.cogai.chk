federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-4-sec-1-logic-432 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-4-sec-1;
  logic: Deontic;
  operator: Obligation;
  summary: Imposes a duty on the State to refer to the Federal Circuit Court of Australia.;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (1) For the purposes of the operation of an Appropriation Act after this Schedule commences, references to the Federal Magistrates Court of Australia are to be read as references to the Federal Circuit Court of Australia.;
}

