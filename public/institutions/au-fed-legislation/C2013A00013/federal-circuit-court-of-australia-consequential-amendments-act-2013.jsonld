      "skos:note": "Appoint Judge as issuing authority"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-52",
      "@type": "cof:Section",
      "cof:title": "52 Subsection 34AB(1)",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) The Minister may, by writing, appoint as an issuing authority a\nperson who is a Judge."
    },
    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-52-norm",
