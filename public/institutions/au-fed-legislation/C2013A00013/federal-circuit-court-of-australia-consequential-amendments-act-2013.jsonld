      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.107",
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 3 of Part 8E of the Migration Act 1958 before\nthe commencement of this item has effect, after that commencement, as\nif it had been done by, or in relation to, a Judge of the Federal Circuit\nCourt of Australia, as an issuing officer, under that Division.\n\n\nSchedule 3  Contingent amendments",
      "skos:definition": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 3 of Part 8E of the Migration Act 1958 before\nthe commencement of this item has effect, after that commencement, as\nif it had been done by, or in relation to, a Judge of the Federal Circuit\nCourt of Australia, as an issuing officer, under that Division.\n\n\nSchedule 3  Contingent amendments",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-3-sec-98-norm"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-3-sec-98-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c11e2b56e42fd7864abf44a8e321a3c9fafb5d362e9591a8f95a8373be9e038a",
      "skos:note": "Saving provision for actions taken before commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-3-sec-98",
      "@type": "cof:Section",
      "cof:title": "98 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 107,
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 3 of Part 8E of the Migration Act 1958 before\nthe commencement of this item has effect, after that commencement, as\nif it had been done by, or in relation to, a Judge of the Federal Circuit\nCourt of Australia, as an issuing officer, under that Division.\n\n\nSchedule 3  Contingent amendments"
    },
