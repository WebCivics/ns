        }
      ],
      "cml:integrityHash": "ab8790497cd22c00dc3b6b7f3726bd2232e7d8bedf84c927c1e7a185997a171b",
      "skos:note": "No limit on operation of section 7 or subsection 25B(1) of the Acts Interpretation Act 1901"
    },
