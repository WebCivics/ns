      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "continues",
      "cml:logicSummary": "Consent and nomination continue in force.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
