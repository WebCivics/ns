    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-3-sec-101",
      "@type": "cml:Concept",
      "skos:prefLabel": "101 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-3-sec-101"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
