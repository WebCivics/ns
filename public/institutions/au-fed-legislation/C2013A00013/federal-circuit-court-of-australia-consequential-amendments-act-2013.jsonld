    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-11-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Effect of change of name of Federal Magistrates Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-11-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf"
      },
      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.55",
      "values:originalText": "Schedule 1  Main amendments\n\nTo the extent that this Schedule applies after the commencement of\nSchedule 2 to the Federal Circuit Court of Australia Legislation\nAmendment Act 2012:\n\n(a) a reference in this Schedule to the Federal Magistrates Act\n1999 is taken to include a reference to the Federal Circuit\nCourt of Australia Act 1999; and\n\n(b) a reference in this Schedule to a Federal Magistrate is taken\nto include a reference to a Judge of the Federal Circuit Court\nof Australia; and\n\n(c) a reference in this Schedule to the Federal Magistrates Court\nis taken to include a reference to the Federal Circuit Court of\nAustralia.\nFederal Court of Australia Act 1976",
      "skos:definition": "Schedule 1  Main amendments\n\nTo the extent that this Schedule applies after the commencement of\nSchedule 2 to the Federal Circuit Court of Australia Legislation\nAmendment Act 2012:\n\n(a) a reference in this Schedule to the Federal Magistrates Act\n1999 is taken to include a reference to the Federal Circuit\nCourt of Australia Act 1999; and\n\n(b) a reference in this Schedule to a Federal Magistrate is taken\nto include a reference to a Judge of the Federal Circuit Court\nof Australia; and\n\n(c) a reference in this Schedule to the Federal Magistrates Court\nis taken to include a reference to the Federal Circuit Court of\nAustralia.\nFederal Court of Australia Act 1976",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-11-2-norm"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-11-2-logic-alleninterval-1"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-11-2-logic-ltl-2"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-11-2-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "45ca9281b5b6cbf1ee16ba7b3b54446e00c2700e276d76e7894b838e85c4b92a",
      "skos:note": "Effect of change of name of Federal Magistrates Court"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-11-2",
      "@type": "cof:Section",
      "cof:title": "11 Effect of change of name of Federal Magistrates Court",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "Schedule 1  Main amendments\n\nTo the extent that this Schedule applies after the commencement of\nSchedule 2 to the Federal Circuit Court of Australia Legislation\nAmendment Act 2012:\n\n(a) a reference in this Schedule to the Federal Magistrates Act\n1999 is taken to include a reference to the Federal Circuit\nCourt of Australia Act 1999; and\n\n(b) a reference in this Schedule to a Federal Magistrate is taken\nto include a reference to a Judge of the Federal Circuit Court\nof Australia; and\n\n(c) a reference in this Schedule to the Federal Magistrates Court\nis taken to include a reference to the Federal Circuit Court of\nAustralia.\nFederal Court of Australia Act 1976"
    },
