    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf"
      },
      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.21",
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 75 of the Australian Charities and\nNot-for-profits Commission Act 2012 before the commencement of this\nitem has effect, after that commencement, as if it had been done by, or\nin relation to, a Judge of the Federal Circuit Court of Australia, as an\nissuing officer, under that Division.\nAustralian Crime Commission Act 2002",
      "skos:definition": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 75 of the Australian Charities and\nNot-for-profits Commission Act 2012 before the commencement of this\nitem has effect, after that commencement, as if it had been done by, or\nin relation to, a Judge of the Federal Circuit Court of Australia, as an\nissuing officer, under that Division.\nAustralian Crime Commission Act 2002",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-30-norm"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-30-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c9ffa71f55f239aba168051bba39291dcfb12c3dba75a29a7f9e2c9057dd19bc",
      "skos:note": "Saving provision for issuing officers"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 75 of the Australian Charities and\nNot-for-profits Commission Act 2012 before the commencement of this\nitem has effect, after that commencement, as if it had been done by, or\nin relation to, a Judge of the Federal Circuit Court of Australia, as an\nissuing officer, under that Division.\nAustralian Crime Commission Act 2002"
    },
