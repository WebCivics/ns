    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-108",
      "@type": "cml:Concept",
      "skos:prefLabel": "108 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-108"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf"
      },
      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.32",
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate under\nsection 3ZQO of the Crimes Act 1914 before the commencement of this\nitem has effect, after that commencement, as if it had been done by, or\nin relation to, a Judge of the Federal Circuit Court of Australia under\nthat section.\nCrimes (Superannuation Benefits) Act 1989",
      "skos:definition": "A thing done by, or in relation to, a Federal Magistrate under\nsection 3ZQO of the Crimes Act 1914 before the commencement of this\nitem has effect, after that commencement, as if it had been done by, or\nin relation to, a Judge of the Federal Circuit Court of Australia under\nthat section.\nCrimes (Superannuation Benefits) Act 1989",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-108-norm"
        }
      ],
      "cml:integrityHash": "1d32a74cdd30bb735f1c537ddb45cdd195bc2135d911bc8eafe8deed7c256c1e",
      "skos:note": "Saving provision for actions taken before commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-108",
      "@type": "cof:Section",
      "cof:title": "108 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate under\nsection 3ZQO of the Crimes Act 1914 before the commencement of this\nitem has effect, after that commencement, as if it had been done by, or\nin relation to, a Judge of the Federal Circuit Court of Australia under\nthat section.\nCrimes (Superannuation Benefits) Act 1989"
    },
