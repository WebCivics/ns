      "skos:prefLabel": "6A Effect of change of name of Federal Magistrates Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-6a"
