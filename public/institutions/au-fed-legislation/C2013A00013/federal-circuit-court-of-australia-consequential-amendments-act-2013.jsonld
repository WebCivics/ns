      "@type": "cml:Concept",
      "skos:prefLabel": "3 No limit on operation of section 7 or subsection 25B(1) of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-4-sec-3"
