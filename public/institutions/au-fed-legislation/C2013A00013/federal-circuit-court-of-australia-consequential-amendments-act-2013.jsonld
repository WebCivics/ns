    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf"
      },
      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.23",
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 1A of Part II of the Australian Crime\nCommission Act 2002 before the commencement of this item has effect,\nafter that commencement, as if it had been done by, or in relation to, a\nJudge of the Federal Circuit Court of Australia, as an issuing officer,\nunder that Division.\nAustralian Energy Market Act 2004",
      "skos:definition": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 1A of Part II of the Australian Crime\nCommission Act 2002 before the commencement of this item has effect,\nafter that commencement, as if it had been done by, or in relation to, a\nJudge of the Federal Circuit Court of Australia, as an issuing officer,\nunder that Division.\nAustralian Energy Market Act 2004",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-45-norm"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-45-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "5a50a95e53354bdeb1362b8788b39acf11375959d02572dda394000d287f3e0f",
      "skos:note": "Saving provision for actions taken by Federal Magistrate before commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Division 1A of Part II of the Australian Crime\nCommission Act 2002 before the commencement of this item has effect,\nafter that commencement, as if it had been done by, or in relation to, a\nJudge of the Federal Circuit Court of Australia, as an issuing officer,\nunder that Division.\nAustralian Energy Market Act 2004"
    },
