    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-3-sec-98",
      "@type": "cml:Concept",
      "skos:prefLabel": "98 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-3-sec-98"
      },
