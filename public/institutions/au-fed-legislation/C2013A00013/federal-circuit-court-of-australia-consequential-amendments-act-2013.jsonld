      },
      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.108",
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Part 5, 6 or 7 of the National Gambling Reform Act 2012\nbefore the commencement of this item has effect, after that\ncommencement, as if it had been done by, or in relation to, a Judge of\nthe Federal Circuit Court of Australia, as an issuing officer, under that\nPart.\n\n\nGeneral transitional provisions  Schedule 4",
      "skos:definition": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under Part 5, 6 or 7 of the National Gambling Reform Act 2012\nbefore the commencement of this item has effect, after that\ncommencement, as if it had been done by, or in relation to, a Judge of\nthe Federal Circuit Court of Australia, as an issuing officer, under that\nPart.\n\n\nGeneral transitional provisions  Schedule 4",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-3-sec-101-norm"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-3-sec-101-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "677a0f9ebdcbc28d0ff2434987bc9b8ddd05d7e60da3d8e0eca1d9afd3ec692a",
      "skos:note": "Saving provision for transitional period"
    },
    {
