      },
      "prov:wasDerivedFrom": {
        "@id": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf"
      },
      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.109",
      "values:originalText": "The Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to the amendments and repeals made by\nSchedules 1, 2 and 3.",
      "skos:definition": "The Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to the amendments and repeals made by\nSchedules 1, 2 and 3.",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-4-sec-2-norm"
        }
      ],
      "cml:integrityHash": "96056f356da804e131c0fe2a37e39eab3a8708b06b11dc6d48a85988ca64ef27",
      "skos:note": "Governor-General may make regulations for transitional matters."
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-4-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Transitional regulations",
      "values:kind": "section",
      "cof:pageNumber": 109,
      "values:originalText": "The Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to the amendments and repeals made by\nSchedules 1, 2 and 3."
    },
