      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.10",
      "values:originalText": "item 43\nImmediately after the commencement of\nitem 9 of Schedule 2 to the Access to Justice\n(Federal Jurisdiction) Amendment Act 2012.\nHowever, the provision(s) do not commence\nat all if item 9 of Schedule 2 to the Access to\nJustice (Federal Jurisdiction) Amendment\nAct 2012 commences at or before the time\nSchedule 1 to this Act commences.\nDoes not\ncommence\n\n\n\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvision(s)\nCommencement\nDate/Details",
      "skos:definition": "item 43\nImmediately after the commencement of\nitem 9 of Schedule 2 to the Access to Justice\n(Federal Jurisdiction) Amendment Act 2012.\nHowever, the provision(s) do not commence\nat all if item 9 of Schedule 2 to the Access to\nJustice (Federal Jurisdiction) Amendment\nAct 2012 commences at or before the time\nSchedule 1 to this Act commences.\nDoes not\ncommence\n\n\n\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvision(s)\nCommencement\nDate/Details",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sec-5-norm"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sec-5-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "f3a412f54e1132dbef1a1c9797cb3b2c30dfd052ffdcda3242fb9113bf79ac99",
      "skos:note": "Conditional commencement of provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Schedule 3,",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "item 43\nImmediately after the commencement of\nitem 9 of Schedule 2 to the Access to Justice\n(Federal Jurisdiction) Amendment Act 2012.\nHowever, the provision(s) do not commence\nat all if item 9 of Schedule 2 to the Access to\nJustice (Federal Jurisdiction) Amendment\nAct 2012 commences at or before the time\nSchedule 1 to this Act commences.\nDoes not\ncommence\n\n\n\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvision(s)\nCommencement\nDate/Details"
    },
    {
