    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf"
      },
      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.15",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\n\nMain amendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\n\nMain amendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "8b23f464c3a5b776d7078f4d72c0c003ff0248c1aedf9ae128a28f84c32a0096",
      "skos:note": "Amendments and repeals of Acts specified in Schedules"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\n\nMain amendments  Schedule 1"
    },
