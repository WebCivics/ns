    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-327",
      "@type": "cml:Concept",
      "skos:prefLabel": "327 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-327"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf"
      },
      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.59",
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under the Law Enforcement Integrity Commissioner Act 2006\nbefore the commencement of this item has effect, after that\ncommencement, as if it had been done by, or in relation to, a Judge of\nthe Federal Circuit Court of Australia, as an issuing officer, under that\nAct.\nMarriage Act 1961",
      "skos:definition": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under the Law Enforcement Integrity Commissioner Act 2006\nbefore the commencement of this item has effect, after that\ncommencement, as if it had been done by, or in relation to, a Judge of\nthe Federal Circuit Court of Australia, as an issuing officer, under that\nAct.\nMarriage Act 1961",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-327-norm"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-327-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ac54b5fd5f1d21e566a2320ed8b654471ca1f0ba7cab49a5cf7f5dc509cbd8b9",
      "skos:note": "Saving provision for issuing officers under Law Enforcement Integrity Commissioner Act 2006"
    },
    {
      "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-1-sec-327",
      "@type": "cof:Section",
      "cof:title": "327 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "A thing done by, or in relation to, a Federal Magistrate, as an issuing\nofficer, under the Law Enforcement Integrity Commissioner Act 2006\nbefore the commencement of this item has effect, after that\ncommencement, as if it had been done by, or in relation to, a Judge of\nthe Federal Circuit Court of Australia, as an issuing officer, under that\nAct.\nMarriage Act 1961"
    },
