      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.61",
      "values:originalText": "Schedule 1  Main amendments\n\nOmit “Federal Magistrates Court under this section are to be exercised\nby a single Federal Magistrate”, substitute “Federal Circuit Court under\nthis section are to be exercised by a single Judge of that Court”.\nMutual Assistance in Criminal Matters Act 1987",
      "skos:definition": "Schedule 1  Main amendments\n\nOmit “Federal Magistrates Court under this section are to be exercised\nby a single Federal Magistrate”, substitute “Federal Circuit Court under\nthis section are to be exercised by a single Judge of that Court”.\nMutual Assistance in Criminal Matters Act 1987",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-350-norm"
        },
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-1-sec-350-logic-deontic-1"
        }
      ],
