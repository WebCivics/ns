    {
      "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-4-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Transitional regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/federal-circuit-court-of-australia-consequential-amendments-act-2013#sch-4-sec-2"
