      "dc:source": "federal-circuit-court-of-australia-consequential-amendments-act-2013.pdf, p.99",
      "values:originalText": "items 1 to 186\nA single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period.",
      "skos:definition": "items 1 to 186\nA single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period.",
      "cml:asserts": [
        {
          "@id": "concept:federal-circuit-court-of-australia-consequential-amendments-act-2013-sch-3-sec-2-2-norm"
        }
      ],
