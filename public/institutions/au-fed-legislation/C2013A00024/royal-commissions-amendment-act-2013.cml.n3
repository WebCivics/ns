    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Defendant bears evidential burden in relation to disclosure of information at a private session." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
