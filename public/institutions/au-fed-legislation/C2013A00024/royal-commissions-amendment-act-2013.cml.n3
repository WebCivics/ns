doc:sch-1-sec-6of-ss-2 a cof:Section ;
    cof:title "6OF(2) Protection of those who appear, or are authorised to be" ;
    values:kind "subsection" ;
    values:originalText "(2) A legal practitioner who appears on behalf of a person at a private session has the same protection and immunity as a barrister has in appearing for a party in proceedings in the High Court. ComLaw Authoritative Act C2013A00024  Amendments  Schedule 1" ;
    cof:pageNumber "14"^^xsd:integer .

concept:royal-commissions-amendment-act-2013-sch-1-sec-6og a cml:Concept ;
    skos:prefLabel "6OG Privacy of private sessions"@en ;
    cml:realizedBy doc:sch-1-sec-6og ;
    values:originalText "A private session must be held in private, and only persons who are authorised by a member of the Child Sexual Abuse Royal Commission holding the private session may be present during the private session." ;
    skos:definition "A private session must be held in private, and only persons who are authorised by a member of the Child Sexual Abuse Royal Commission holding the private session may be present during the private session."@en ;
    cml:integrityHash "7a01d284ca9c1ac2b008ff8d4d71288da306867ac43f62ec248ba5a7c801263b" ;
    cof:pageNumber "15"^^xsd:integer ;
