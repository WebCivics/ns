doc:sch-1-sec-6 a cof:Section ;
    cof:title "6 At the end of section 1B" ;
    values:kind "section" ;
    values:originalText "Add:  (3) A reference in any other Act to a Royal Commission (being a Royal Commission established by the Governor-General by Letters Patent under this Act or any other power) includes a reference to one or more members of a Commission holding an authorised member hearing." ;
    cof:pageNumber "8"^^xsd:integer .

