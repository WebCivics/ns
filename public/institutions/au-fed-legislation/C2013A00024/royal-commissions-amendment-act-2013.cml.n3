concept:royal-commissions-amendment-act-2013-sch-1-sec-37 a cml:Concept ;
    skos:prefLabel "37 Application"@en ;
    cml:realizedBy doc:sch-1-sec-37 ;
    values:originalText "ComLaw Authoritative Act C2013A00024  Schedule 1  Amendments  The amendments made by this Schedule (other than the amendments made by items 10, 30, 33 and 34 of this Schedule) apply in relation to any Royal Commission that conducts an inquiry after this Schedule commences, whether the Royal Commission is established before or after this Schedule commences. Note: The amendments made by items 10, 30, 33 and 34 of this Schedule apply only in relation to the Child Sexual Abuse Royal Commission.  [Minister’s second reading speech made in— House of Representatives on 13 February 2013 Senate on 13 March 2013]  (25/13) ComLaw Authoritative Act C2013A00024" ;
    skos:definition "ComLaw Authoritative Act C2013A00024  Schedule 1  Amendments  The amendments made by this Schedule (other than the amendments made by items 10, 30, 33 and 34 of this Schedule) apply in relation to any Royal Commission that conducts an inquiry after this Schedule commences, whether the Royal Commission is established before or after this Schedule commences. Note: The amendments made by items 10, 30, 33 and 34 of this Schedule apply only in relation to the Child Sexual Abuse Royal Commission.  [Minister’s second reading speech made in— House of Representatives on 13 February 2013 Senate on 13 March 2013]  (25/13) ComLaw Authoritative Act C2013A00024"@en ;
    cml:integrityHash "2f933c23818f6e729993b86dfedd38758dd1268e19cc3dc117504b2d7cb89580" ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Amendments apply to Royal Commissions after Schedule commences" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <royal-commissions-amendment-act-2013.pdf> ;
    dc:source "royal-commissions-amendment-act-2013.pdf, p.17" ;
    cml:asserts concept:royal-commissions-amendment-act-2013-sch-1-sec-37-norm .
