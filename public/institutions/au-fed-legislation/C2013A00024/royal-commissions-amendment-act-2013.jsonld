          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oc-ss-4-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oc-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a051597902df11d5ec449d199c5b76e2ba0095146df9d67924694689e60af6e7",
      "skos:note": "Section 9 applies to records of Royal Commission"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6oc-ss-4",
      "@type": "cof:Section",
      "cof:title": "6OC(4) Status of private session",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(4) Section 9 (custody and use of records of Royal Commission) also\napplies as if a record produced by one or 2 members of the Child\nSexual Abuse Royal Commission at a private session were\nproduced by the Commission.\nApplication of Part 4 (offences)"
    },
    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oc-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oc-ss-4"
      },
