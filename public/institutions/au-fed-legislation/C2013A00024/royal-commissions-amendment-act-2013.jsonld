      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.17",
      "values:originalText": "Insert:\n\n(2C) A person who obtains information, evidence, a document or a thing\nin accordance with this section may (subject to sections 6DD and\n6OE) make a record of, use or disclose the information, evidence,\ndocument or thing for the purposes of performing his or her\nfunctions or exercising his or her powers.",
      "skos:definition": "Insert:\n\n(2C) A person who obtains information, evidence, a document or a thing\nin accordance with this section may (subject to sections 6DD and\n6OE) make a record of, use or disclose the information, evidence,\ndocument or thing for the purposes of performing his or her\nfunctions or exercising his or her powers.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-31a-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-31a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bf67eb9e3cdf70f814799a12501d51606e085f125d4758c099af3dd5db598b7a",
      "skos:note": "A person may make a record of, use or disclose information for the purposes of performing their functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-31a",
      "@type": "cof:Section",
      "cof:title": "31A After subsection 6P(2B)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Insert:\n\n(2C) A person who obtains information, evidence, a document or a thing\nin accordance with this section may (subject to sections 6DD and\n6OE) make a record of, use or disclose the information, evidence,\ndocument or thing for the purposes of performing his or her\nfunctions or exercising his or her powers."
    },
