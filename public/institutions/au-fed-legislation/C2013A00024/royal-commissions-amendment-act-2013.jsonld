    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 At the end of section 6H",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.11",
      "values:originalText": "ComLaw Authoritative Act C2013A00024\n\nSchedule 1  Amendments\n\nAdd:\n\n(5) The reference in subsection (1) to the inquiry being made by the\nCommission is, for a Commission that holds an authorised member\nhearing, a reference to the inquiry being made by the Commission\nas a whole.\nNote:\nHowever, the reference in subsection (1) to a hearing before a\nCommission may be an authorised member hearing.",
      "skos:definition": "ComLaw Authoritative Act C2013A00024\n\nSchedule 1  Amendments\n\nAdd:\n\n(5) The reference in subsection (1) to the inquiry being made by the\nCommission is, for a Commission that holds an authorised member\nhearing, a reference to the inquiry being made by the Commission\nas a whole.\nNote:\nHowever, the reference in subsection (1) to a hearing before a\nCommission may be an authorised member hearing.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-29-norm"
        }
      ],
      "cml:integrityHash": "a158d8c93a4179cb7a95431de3ac9aab5eb3502d41d85e6dd9d02578532b3936",
      "skos:note": "Amends reference to inquiry made by Commission for authorized member hearing"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-29",
      "@type": "cof:Section",
      "cof:title": "29 At the end of section 6H",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "ComLaw Authoritative Act C2013A00024\n\nSchedule 1  Amendments\n\nAdd:\n\n(5) The reference in subsection (1) to the inquiry being made by the\nCommission is, for a Commission that holds an authorised member\nhearing, a reference to the inquiry being made by the Commission\nas a whole.\nNote:\nHowever, the reference in subsection (1) to a hearing before a\nCommission may be an authorised member hearing."
    },
