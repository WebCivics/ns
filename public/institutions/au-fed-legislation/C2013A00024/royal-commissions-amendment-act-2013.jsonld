    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "1A After subsection 7(2D)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-1a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.7",
      "values:originalText": "Insert:\n\n(2E) A Minister and an agency are exempt from the operation of this\nAct in relation to the following documents:\n\n(a) a document that has originated with, or has been received\nfrom, the Child Sexual Abuse Royal Commission (within the\nmeaning of Part 4 of the Royal Commissions Act 1902) and:\n\n(i) that contains information obtained at a private session\n(within the meaning of that Part); or\n\n(ii) that relates to a private session and identifies a natural\nperson who appeared at a private session;\n\n(b) a document that contains a summary of, or an extract or\ninformation from, a private session.\nRoyal Commissions Act 1902",
      "skos:definition": "Insert:\n\n(2E) A Minister and an agency are exempt from the operation of this\nAct in relation to the following documents:\n\n(a) a document that has originated with, or has been received\nfrom, the Child Sexual Abuse Royal Commission (within the\nmeaning of Part 4 of the Royal Commissions Act 1902) and:\n\n(i) that contains information obtained at a private session\n(within the meaning of that Part); or\n\n(ii) that relates to a private session and identifies a natural\nperson who appeared at a private session;\n\n(b) a document that contains a summary of, or an extract or\ninformation from, a private session.\nRoyal Commissions Act 1902",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-1a-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-1a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bd3a66251c2a5736feeb4cfad39a18ca27e9b306ff62802deb9ec2629438a25d",
      "skos:note": "Exempts certain documents from the operation of this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-1a",
      "@type": "cof:Section",
      "cof:title": "1A After subsection 7(2D)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n\n(2E) A Minister and an agency are exempt from the operation of this\nAct in relation to the following documents:\n\n(a) a document that has originated with, or has been received\nfrom, the Child Sexual Abuse Royal Commission (within the\nmeaning of Part 4 of the Royal Commissions Act 1902) and:\n\n(i) that contains information obtained at a private session\n(within the meaning of that Part); or\n\n(ii) that relates to a private session and identifies a natural\nperson who appeared at a private session;\n\n(b) a document that contains a summary of, or an extract or\ninformation from, a private session.\nRoyal Commissions Act 1902"
    },
