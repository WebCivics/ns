    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oe",
      "@type": "cml:Concept",
      "skos:prefLabel": "6OE Statements made and documents produced etc. at a private",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6oe"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
