    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 At the end of section 3 (after the note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-12"
      },
      "cml:curationStatus": {
