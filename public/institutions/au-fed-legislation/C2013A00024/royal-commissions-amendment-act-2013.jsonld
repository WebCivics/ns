    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Subsection 6F(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.11",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) In subsection (1), a reference to a person who is an authorised\nperson in relation to a Commission is a reference to a person\nauthorised in writing, or a person included in a class of persons\nauthorised in writing, for the purposes of that subsection by:\n\n(a) in relation to an authorised member hearing—the member of\nthe Commission presiding at the hearing; and\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the President or\nChair of the Commission; and\n\n(c) in relation to a sole Commissioner—the Commissioner.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) In subsection (1), a reference to a person who is an authorised\nperson in relation to a Commission is a reference to a person\nauthorised in writing, or a person included in a class of persons\nauthorised in writing, for the purposes of that subsection by:\n\n(a) in relation to an authorised member hearing—the member of\nthe Commission presiding at the hearing; and\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the President or\nChair of the Commission; and\n\n(c) in relation to a sole Commissioner—the Commissioner.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-25-norm"
        }
      ],
      "cml:integrityHash": "7e8b63fd308bf3a8215a3781f84b01e11266df57547b95ec7dd9b4685d03e0da",
      "skos:note": "Specify written authorization for authorized persons"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Subsection 6F(3)",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) In subsection (1), a reference to a person who is an authorised\nperson in relation to a Commission is a reference to a person\nauthorised in writing, or a person included in a class of persons\nauthorised in writing, for the purposes of that subsection by:\n\n(a) in relation to an authorised member hearing—the member of\nthe Commission presiding at the hearing; and\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the President or\nChair of the Commission; and\n\n(c) in relation to a sole Commissioner—the Commissioner."
    },
    {
