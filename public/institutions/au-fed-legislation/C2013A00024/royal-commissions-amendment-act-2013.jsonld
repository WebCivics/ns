      },
      "cml:premiseText": "Sections 6H-6N apply as if a person appeared at a private session before the Child Sexual Abuse Royal Commission."
    },
    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oc-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6OC(6) Status of private session",
      "cml:realizedBy": {
