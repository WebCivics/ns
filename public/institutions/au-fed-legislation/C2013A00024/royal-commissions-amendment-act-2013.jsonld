      }
    },
    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oj",
      "@type": "cml:Concept",
      "skos:prefLabel": "6OJ Inclusion of information in reports and recommendations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6oj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.16",
      "values:originalText": "Information that relates to a natural person that has been obtained\nat a private session may be included in a report or recommendation\nof the Child Sexual Abuse Royal Commission only if:\n\n(a) the information is also given as evidence to the Commission\nor under a summons, requirement or notice under section 2;\nor\n\n(b) the information is de-identified.",
      "skos:definition": "Information that relates to a natural person that has been obtained\nat a private session may be included in a report or recommendation\nof the Child Sexual Abuse Royal Commission only if:\n\n(a) the information is also given as evidence to the Commission\nor under a summons, requirement or notice under section 2;\nor\n\n(b) the information is de-identified.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oj-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oj-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "46a0816e773db2ebd024a3b6391234492440f003090067785a87d204cb299ba0",
      "skos:note": "Include private session information in reports if evidence or de-identified."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6oj",
      "@type": "cof:Section",
      "cof:title": "6OJ Inclusion of information in reports and recommendations",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Information that relates to a natural person that has been obtained\nat a private session may be included in a report or recommendation\nof the Child Sexual Abuse Royal Commission only if:\n\n(a) the information is also given as evidence to the Commission\nor under a summons, requirement or notice under section 2;\nor\n\n(b) the information is de-identified."
    },
    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oj-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oj"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oj-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "include",
      "cml:logicSummary": "Mandatory inclusion of private session information.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6ok",
      "@type": "cml:Concept",
      "skos:prefLabel": "6OK Defence for disclosure to person who provided the information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6ok"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.16",
      "values:originalText": "Section 6OH does not apply to a disclosure of information to the\nperson who gave the information at a private session.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection (see subsection 13.3(3) of the Criminal Code).",
      "skos:definition": "Section 6OH does not apply to a disclosure of information to the\nperson who gave the information at a private session.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection (see subsection 13.3(3) of the Criminal Code).",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6ok-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6ok-logic-deontic-1"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6ok-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "c4e5154c26a73c529acc9fa48eb2a31fde1b30ee521ac5cd187233a5b3d0ec89",
      "skos:note": "Defendant bears evidential burden in relation to disclosure of information at a private session."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6ok",
      "@type": "cof:Section",
      "cof:title": "6OK Defence for disclosure to person who provided the information",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Section 6OH does not apply to a disclosure of information to the\nperson who gave the information at a private session.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsection (see subsection 13.3(3) of the Criminal Code)."
    },
    {
