    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oa",
      "@type": "cml:Concept",
      "skos:prefLabel": "6OA Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6oa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.12",
      "values:originalText": "In this Part:\nChild Sexual Abuse Royal Commission means the Royal\nCommission into Institutional Responses to Child Sexual Abuse\nissued by the Governor-General by Letters Patent on 11 January\n2013 (and including any later variations of those Letters Patent).\nprivate session means a private session held under section 6OB.",
      "skos:definition": "In this Part:\nChild Sexual Abuse Royal Commission means the Royal\nCommission into Institutional Responses to Child Sexual Abuse\nissued by the Governor-General by Letters Patent on 11 January\n2013 (and including any later variations of those Letters Patent).\nprivate session means a private session held under section 6OB.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oa-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oa-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oa-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "adc99b7f15b46f3aebd6a3388135d84172b1370c05c4706e9dde5122f98756ee",
      "skos:note": "Definition of Child Sexual Abuse Royal Commission and private session."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6oa",
      "@type": "cof:Section",
      "cof:title": "6OA Definitions",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "In this Part:\nChild Sexual Abuse Royal Commission means the Royal\nCommission into Institutional Responses to Child Sexual Abuse\nissued by the Governor-General by Letters Patent on 11 January\n2013 (and including any later variations of those Letters Patent).\nprivate session means a private session held under section 6OB."
    },
    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oa-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oa"
