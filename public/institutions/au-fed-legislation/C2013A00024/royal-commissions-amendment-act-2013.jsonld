    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Subsection 2(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.9",
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) In this section, a reference to a person who is an authorised person\nin relation to a Commission is a reference to a person authorised in\nwriting, or a person included in a class of persons authorised in\nwriting, for the purposes of this section by:\n\n(a) in relation to an authorised member hearing—the member of\nthe Commission presiding at the hearing; and\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the President or\nChair of the Commission; and\n\n(c) in relation to a sole Commissioner—the Commissioner.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(4) In this section, a reference to a person who is an authorised person\nin relation to a Commission is a reference to a person authorised in\nwriting, or a person included in a class of persons authorised in\nwriting, for the purposes of this section by:\n\n(a) in relation to an authorised member hearing—the member of\nthe Commission presiding at the hearing; and\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the President or\nChair of the Commission; and\n\n(c) in relation to a sole Commissioner—the Commissioner.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-11-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-11-logic-deontic-1"
        },
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-11-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "e7e5f8dc2cf124235287aa8b5af7742b271a06876f0096550778ab9b5aaf635a",
      "skos:note": "Repeal subsection, substitute definition of authorised person"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Subsection 2(4)",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Repeal the subsection, substitute:\n\n(4) In this section, a reference to a person who is an authorised person\nin relation to a Commission is a reference to a person authorised in\nwriting, or a person included in a class of persons authorised in\nwriting, for the purposes of this section by:\n\n(a) in relation to an authorised member hearing—the member of\nthe Commission presiding at the hearing; and\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the President or\nChair of the Commission; and\n\n(c) in relation to a sole Commissioner—the Commissioner."
    },
    {
