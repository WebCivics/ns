    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oc-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "6OC(4) Status of private session",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6oc-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.13",
      "values:originalText": "(4) Section 9 (custody and use of records of Royal Commission) also\napplies as if a record produced by one or 2 members of the Child\nSexual Abuse Royal Commission at a private session were\nproduced by the Commission.\nApplication of Part 4 (offences)",
      "skos:definition": "(4) Section 9 (custody and use of records of Royal Commission) also\napplies as if a record produced by one or 2 members of the Child\nSexual Abuse Royal Commission at a private session were\nproduced by the Commission.\nApplication of Part 4 (offences)",
      "values:partOf": {
        "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-6oc"
      },
      "cml:asserts": [
