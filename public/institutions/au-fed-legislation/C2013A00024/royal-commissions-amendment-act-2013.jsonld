        }
      ],
      "cml:integrityHash": "ff283ee238bfe9862582017d0205737232eaafb34471852b12a0037ef81498df",
      "skos:note": "Section 6O applies in relation to a private session as if the member or members of the Child Sexual Abuse Royal Commission were the Commission."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-6oc-ss-6",
      "@type": "cof:Section",
      "cof:title": "6OC(6) Status of private session",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(6) Section 6O (contempt of Royal Commission) applies in relation to\na private session as if:\n\n(a) the member or members of the Child Sexual Abuse Royal\nCommission holding the private session were the\nCommission; and\n\n(b) the private session were proceedings of the Commission."
    },
