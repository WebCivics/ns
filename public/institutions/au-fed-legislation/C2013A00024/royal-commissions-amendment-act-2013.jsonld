    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Subsection 1B(1) (definition of Commission and Royal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.8",
      "values:originalText": "Commission)\nRepeal the definition, substitute:\nCommission and Royal Commission means any Commission of\ninquiry issued by the Governor-General by Letters Patent under\nthis Act or any other power, and includes the following persons\nsitting for the purposes of the inquiry:\n\n(a) in relation to an authorised member hearing—the member or\nmembers of the Commission holding the hearing;\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the members of\nthe Commission, or a quorum of those members;\n\n(c) in relation to a sole Commissioner—the Commissioner.",
      "skos:definition": "Commission)\nRepeal the definition, substitute:\nCommission and Royal Commission means any Commission of\ninquiry issued by the Governor-General by Letters Patent under\nthis Act or any other power, and includes the following persons\nsitting for the purposes of the inquiry:\n\n(a) in relation to an authorised member hearing—the member or\nmembers of the Commission holding the hearing;\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the members of\nthe Commission, or a quorum of those members;\n\n(c) in relation to a sole Commissioner—the Commissioner.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-5-norm"
        }
      ],
      "cml:integrityHash": "15476296f4ab1f6b1bcf513e04405a72b00448d0bdb06f21c745aff01ef01ab4",
      "skos:note": "Definition of Commission and Royal Commission"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Subsection 1B(1) (definition of Commission and Royal",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Commission)\nRepeal the definition, substitute:\nCommission and Royal Commission means any Commission of\ninquiry issued by the Governor-General by Letters Patent under\nthis Act or any other power, and includes the following persons\nsitting for the purposes of the inquiry:\n\n(a) in relation to an authorised member hearing—the member or\nmembers of the Commission holding the hearing;\n\n(b) in relation to a Commission that is constituted by 2 or more\nmembers (except if paragraph (a) applies)—the members of\nthe Commission, or a quorum of those members;\n\n(c) in relation to a sole Commissioner—the Commissioner."
    },
