      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-act-2013.pdf"
      },
      "dc:source": "royal-commissions-amendment-act-2013.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00024\n\nAmendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00024\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-act-2013-sec-3-norm"
        }
      ],
      "cml:integrityHash": "4c8232f5acfc880e6cb8b56f51b707b40928d1dbb4ca5505570593f344f59a6a",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00024\n\nAmendments  Schedule 1"
    },
