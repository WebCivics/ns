    {
      "@id": "concept:royal-commissions-amendment-act-2013-sch-1-sec-31a",
      "@type": "cml:Concept",
      "skos:prefLabel": "31A After subsection 6P(2B)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-act-2013#sch-1-sec-31a"
      },
