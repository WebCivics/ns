      "dc:source": "australian-capital-territory-self-government-amendment-act-2013.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00028\n\nAmendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00028\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-amendment-act-2013-sec-3-norm"
        }
      ],
      "cml:integrityHash": "fe7328c614c09e6c7efc0e6f7df54605717031b7a872ff0a5629f973e451fea8",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-amendment-act-2013#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00028\n\nAmendments  Schedule 1"
    },
