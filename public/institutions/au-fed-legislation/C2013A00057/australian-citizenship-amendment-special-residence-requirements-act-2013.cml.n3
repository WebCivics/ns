concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-19 a cml:Concept ;
    skos:prefLabel "19 Application provision"@en ;
    cml:realizedBy doc:sch-1-sec-19 ;
    values:originalText "The amendments made by items 1 to 10 apply in relation to:  (a) applications made under section 21 of the Australian Citizenship Act 2007 on or after the commencement of those items; and  (b) applications made under that section before that commencement and not decided by the Minister before that commencement. ComLaw Authoritative Act C2013A00057    10            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No. 57, 2013 [Minister’s second reading speech made in— House of Representatives on 30 May 2013 Senate on 17 June 2013]  (131/13) ComLaw Authoritative Act C2013A00057" ;
    skos:definition "The amendments made by items 1 to 10 apply in relation to:  (a) applications made under section 21 of the Australian Citizenship Act 2007 on or after the commencement of those items; and  (b) applications made under that section before that commencement and not decided by the Minister before that commencement. ComLaw Authoritative Act C2013A00057    10            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No. 57, 2013 [Minister’s second reading speech made in— House of Representatives on 30 May 2013 Senate on 17 June 2013]  (131/13) ComLaw Authoritative Act C2013A00057"@en ;
    cml:integrityHash "8000515e72843bc12f4cf76b8c0a07fd9f190663b9ac1e05268d4b77b37926d3" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Application provision for amendments made by items 1 to 10" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-special-residence-requirements-act-2013.pdf> ;
