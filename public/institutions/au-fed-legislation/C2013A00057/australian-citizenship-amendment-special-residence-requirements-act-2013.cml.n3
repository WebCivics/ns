concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-18 a cml:Concept ;
    skos:prefLabel "18 At the end of section 52"@en ;
    cml:realizedBy doc:sch-1-sec-18 ;
    values:originalText "Add:  (3) For the purposes of the Administrative Appeals Tribunal reviewing a decision of a kind referred to in paragraph (1)(b):  (a) the Tribunal must not exercise the power under subsection 22A(1A) or 22B(1A); and  (b) the Tribunal must not review any exercise of the power or any failure to exercise the power." ;
    skos:definition "Add:  (3) For the purposes of the Administrative Appeals Tribunal reviewing a decision of a kind referred to in paragraph (1)(b):  (a) the Tribunal must not exercise the power under subsection 22A(1A) or 22B(1A); and  (b) the Tribunal must not review any exercise of the power or any failure to exercise the power."@en ;
    cml:integrityHash "6f0c15cb6fd58a09b81b6baab405d9ac77d3aee535bec3d07161cfc3001d2016" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Tribunal cannot exercise certain powers when reviewing decisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-special-residence-requirements-act-2013.pdf> ;
    dc:source "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf, p.13" ;
