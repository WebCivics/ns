concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-13 a cml:Concept ;
    skos:prefLabel "13 Section 32A"@en ;
    cml:realizedBy doc:sch-1-sec-13 ;
    values:originalText "Omit: • if you did not automatically become an Australian citizen, the Minister can revoke your citizenship: see section 34; or substitute: ComLaw Authoritative Act C2013A00057  Schedule 1  Amendments  8            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No. 57, 2013 • if you did not automatically become an Australian citizen, the Minister can revoke your citizenship in circumstances involving offences or fraud: see section 34; or • if you did not automatically become an Australian citizen and the Minister exercised the power under subsection 22A(1A) or 22B(1A), the Minister can revoke your citizenship in circumstances involving a failure to comply with special residence requirements: see section 34A; or" ;
    skos:definition "Omit: • if you did not automatically become an Australian citizen, the Minister can revoke your citizenship: see section 34; or substitute: ComLaw Authoritative Act C2013A00057  Schedule 1  Amendments  8            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No. 57, 2013 • if you did not automatically become an Australian citizen, the Minister can revoke your citizenship in circumstances involving offences or fraud: see section 34; or • if you did not automatically become an Australian citizen and the Minister exercised the power under subsection 22A(1A) or 22B(1A), the Minister can revoke your citizenship in circumstances involving a failure to comply with special residence requirements: see section 34A; or"@en ;
    cml:integrityHash "304e4e2d56b777b0a5c7cea2b1169dd84ec25c7e12471beea0e0c70225d3a51c" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Revocation of citizenship in certain circumstances" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-special-residence-requirements-act-2013.pdf> ;
    dc:source "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf, p.11" ;
    cml:asserts concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-13-norm .
