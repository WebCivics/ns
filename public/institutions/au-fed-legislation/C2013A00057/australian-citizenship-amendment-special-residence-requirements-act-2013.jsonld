    {
      "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 At the end of section 52",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-special-residence-requirements-act-2013#sch-1-sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf"
      },
      "dc:source": "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf, p.13",
      "values:originalText": "Add:\n\n(3) For the purposes of the Administrative Appeals Tribunal reviewing\na decision of a kind referred to in paragraph (1)(b):\n\n(a) the Tribunal must not exercise the power under\nsubsection 22A(1A) or 22B(1A); and\n\n(b) the Tribunal must not review any exercise of the power or\nany failure to exercise the power.",
      "skos:definition": "Add:\n\n(3) For the purposes of the Administrative Appeals Tribunal reviewing\na decision of a kind referred to in paragraph (1)(b):\n\n(a) the Tribunal must not exercise the power under\nsubsection 22A(1A) or 22B(1A); and\n\n(b) the Tribunal must not review any exercise of the power or\nany failure to exercise the power.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-18-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6f0c15cb6fd58a09b81b6baab405d9ac77d3aee535bec3d07161cfc3001d2016",
      "skos:note": "Tribunal cannot exercise certain powers when reviewing decisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-special-residence-requirements-act-2013#sch-1-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 At the end of section 52",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Add:\n\n(3) For the purposes of the Administrative Appeals Tribunal reviewing\na decision of a kind referred to in paragraph (1)(b):\n\n(a) the Tribunal must not exercise the power under\nsubsection 22A(1A) or 22B(1A); and\n\n(b) the Tribunal must not review any exercise of the power or\nany failure to exercise the power."
    },
    {
