    {
      "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Section 32A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-special-residence-requirements-act-2013#sch-1-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf"
      },
      "dc:source": "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf, p.11",
      "values:originalText": "Omit:\n•\nif you did not automatically become an Australian citizen, the\nMinister can revoke your citizenship: see section 34; or\nsubstitute:\nComLaw Authoritative Act C2013A00057\n\nSchedule 1  Amendments\n\n8            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No.\n57, 2013\n•\nif you did not automatically become an Australian citizen, the\nMinister can revoke your citizenship in circumstances\ninvolving offences or fraud: see section 34; or\n•\nif you did not automatically become an Australian citizen and\nthe Minister exercised the power under subsection 22A(1A) or\n22B(1A), the Minister can revoke your citizenship in\ncircumstances involving a failure to comply with special\nresidence requirements: see section 34A; or",
      "skos:definition": "Omit:\n•\nif you did not automatically become an Australian citizen, the\nMinister can revoke your citizenship: see section 34; or\nsubstitute:\nComLaw Authoritative Act C2013A00057\n\nSchedule 1  Amendments\n\n8            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No.\n57, 2013\n•\nif you did not automatically become an Australian citizen, the\nMinister can revoke your citizenship in circumstances\ninvolving offences or fraud: see section 34; or\n•\nif you did not automatically become an Australian citizen and\nthe Minister exercised the power under subsection 22A(1A) or\n22B(1A), the Minister can revoke your citizenship in\ncircumstances involving a failure to comply with special\nresidence requirements: see section 34A; or",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-13-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "304e4e2d56b777b0a5c7cea2b1169dd84ec25c7e12471beea0e0c70225d3a51c",
      "skos:note": "Revocation of citizenship in certain circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-special-residence-requirements-act-2013#sch-1-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Section 32A",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Omit:\n•\nif you did not automatically become an Australian citizen, the\nMinister can revoke your citizenship: see section 34; or\nsubstitute:\nComLaw Authoritative Act C2013A00057\n\nSchedule 1  Amendments\n\n8            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No.\n57, 2013\n•\nif you did not automatically become an Australian citizen, the\nMinister can revoke your citizenship in circumstances\ninvolving offences or fraud: see section 34; or\n•\nif you did not automatically become an Australian citizen and\nthe Minister exercised the power under subsection 22A(1A) or\n22B(1A), the Minister can revoke your citizenship in\ncircumstances involving a failure to comply with special\nresidence requirements: see section 34A; or"
    },
