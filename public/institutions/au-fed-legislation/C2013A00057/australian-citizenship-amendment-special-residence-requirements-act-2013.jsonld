      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-special-residence-requirements-act-2013#sch-1-sec-4-ss-7",
      "@type": "cof:Section",
      "cof:title": "4(7) At the end of section 22A",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(7) The Minister does not have a duty to consider whether to exercise\nthe power under subsection (1A), whether he or she is requested to\ndo so by the applicant or by any other person, or in any other\ncircumstances."
    },
