    {
      "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-special-residence-requirements-act-2013#sch-1-sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf"
      },
      "dc:source": "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf, p.13",
      "values:originalText": "The amendments made by items 1 to 10 apply in relation to:\n\n(a) applications made under section 21 of the Australian\nCitizenship Act 2007 on or after the commencement of those\nitems; and\n\n(b) applications made under that section before that\ncommencement and not decided by the Minister before that\ncommencement.\nComLaw Authoritative Act C2013A00057\n\n\n\n10            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No.\n57, 2013\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2013\nSenate on 17 June 2013]\n\n(131/13)\nComLaw Authoritative Act C2013A00057",
      "skos:definition": "The amendments made by items 1 to 10 apply in relation to:\n\n(a) applications made under section 21 of the Australian\nCitizenship Act 2007 on or after the commencement of those\nitems; and\n\n(b) applications made under that section before that\ncommencement and not decided by the Minister before that\ncommencement.\nComLaw Authoritative Act C2013A00057\n\n\n\n10            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No.\n57, 2013\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2013\nSenate on 17 June 2013]\n\n(131/13)\nComLaw Authoritative Act C2013A00057",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sch-1-sec-19-norm"
        }
      ],
      "cml:integrityHash": "8000515e72843bc12f4cf76b8c0a07fd9f190663b9ac1e05268d4b77b37926d3",
      "skos:note": "Application provision for amendments made by items 1 to 10"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-special-residence-requirements-act-2013#sch-1-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "The amendments made by items 1 to 10 apply in relation to:\n\n(a) applications made under section 21 of the Australian\nCitizenship Act 2007 on or after the commencement of those\nitems; and\n\n(b) applications made under that section before that\ncommencement and not decided by the Minister before that\ncommencement.\nComLaw Authoritative Act C2013A00057\n\n\n\n10            Australian Citizenship Amendment (Special Residence Requirements) Act 2013       No.\n57, 2013\n[Minister’s second reading speech made in—\nHouse of Representatives on 30 May 2013\nSenate on 17 June 2013]\n\n(131/13)\nComLaw Authoritative Act C2013A00057"
    },
