      "dc:source": "australian-citizenship-amendment-special-residence-requirements-act-2013.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00057\n\nAmendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00057\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-special-residence-requirements-act-2013-sec-3-norm"
        }
      ],
      "cml:integrityHash": "ed09c23119681a98f3b00adc65c2207cd84ff3cfa714c8e9b8efa5235080db0d",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-special-residence-requirements-act-2013#sec-3",
