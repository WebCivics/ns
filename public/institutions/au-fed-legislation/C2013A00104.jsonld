        "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "792dbb3df6fbb2e4d24219097bee277722ce16ebcde7565fd31f9c935105d4b1",
      "cml:proposedBy": {
