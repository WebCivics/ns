      },
      "realizedBy": "doc:competition-and-consumer-amendment-act-2013#sch-1-sec-1",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Exemptions are conditional on compliance with regulations",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for exemptions",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "Subsection (1) does not apply if the representation is in a class prescribed by the regulations"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Exemptions are prescribed by the regulations",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Regulations prescribe exemptions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "allows",
      "cml:premiseText": "The regulations prescribe a class of representations for which subsection (1) does not apply"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Exemptions are conditional on compliance with regulations",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Compliance with regulations is necessary for exemptions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:premiseText": "The conditions prescribed by the regulations in relation to representations in that class have been complied with"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Exemptions override condition requirements",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "No need to comply with conditions if exemptions apply",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "allows",
      "cml:premiseText": "If the representation is in a class prescribed for paragraph (a) of this subsection and subsection (1) is complied with in relation to the representation, there is no need to also comply with any conditions prescribed for paragraph (b) of this subsection"
    },
