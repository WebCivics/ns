      "skos:note": "Exemptions from subsection (1) based on regulations",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "1 After subsection 48(4) of Schedule 2"
      },
      "wasDerivedFrom": "competition-and-consumer-amendment-act-2013.pdf",
      "asserts": [
        "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-norm",
        "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-descriptionlogic-1",
