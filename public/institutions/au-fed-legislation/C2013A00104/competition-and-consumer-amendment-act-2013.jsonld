    {
      "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After subsection 48(4) of Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act-2013#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-act-2013.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-act-2013.pdf, p.7",
      "values:originalText": "Insert:\n\n(4A) Subsection (1) does not apply if:\n\n(a) the representation is in a class of representations prescribed\nby the regulations; and\n\n(b) the conditions (if any) prescribed by the regulations in\nrelation to representations in that class have been complied\nwith.\nNote:\nIf the representation is in a class prescribed for paragraph (a) of this\nsubsection and subsection (1) is complied with in relation to the\nrepresentation, there is no need to also comply with any conditions\nprescribed for paragraph (b) of this subsection.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 May 2013\nSenate on 17 June 2013]\n\n(141/13)\nComLaw Authoritative Act C2013A00104",
      "skos:definition": "Insert:\n\n(4A) Subsection (1) does not apply if:\n\n(a) the representation is in a class of representations prescribed\nby the regulations; and\n\n(b) the conditions (if any) prescribed by the regulations in\nrelation to representations in that class have been complied\nwith.\nNote:\nIf the representation is in a class prescribed for paragraph (a) of this\nsubsection and subsection (1) is complied with in relation to the\nrepresentation, there is no need to also comply with any conditions\nprescribed for paragraph (b) of this subsection.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 May 2013\nSenate on 17 June 2013]\n\n(141/13)\nComLaw Authoritative Act C2013A00104",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-alleninterval-2"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-3"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-ltl-4"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-5"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-6"
        }
      ],
      "cml:integrityHash": "792dbb3df6fbb2e4d24219097bee277722ce16ebcde7565fd31f9c935105d4b1",
      "skos:note": "Exemptions from subsection (1) based on regulations"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act-2013#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 After subsection 48(4) of Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n\n(4A) Subsection (1) does not apply if:\n\n(a) the representation is in a class of representations prescribed\nby the regulations; and\n\n(b) the conditions (if any) prescribed by the regulations in\nrelation to representations in that class have been complied\nwith.\nNote:\nIf the representation is in a class prescribed for paragraph (a) of this\nsubsection and subsection (1) is complied with in relation to the\nrepresentation, there is no need to also comply with any conditions\nprescribed for paragraph (b) of this subsection.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 May 2013\nSenate on 17 June 2013]\n\n(141/13)\nComLaw Authoritative Act C2013A00104"
    },
