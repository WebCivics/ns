        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The conditions prescribed by the regulations in relation to representations in that class have been complied with",
      "cml:conclusionText": "Exemptions are conditional on compliance with regulations"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "allows",
      "cml:logicSummary": "No need to comply with conditions if exemptions apply",
      "cml:executionSurface": "modalities::logic::deontic",
