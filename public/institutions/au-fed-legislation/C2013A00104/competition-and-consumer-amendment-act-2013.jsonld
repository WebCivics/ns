      "cml:premiseText": "Subsection (1) does not apply if the representation is in a class prescribed by the regulations",
      "cml:conclusionText": "Exemptions are conditional on compliance with regulations"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-act-2013-sch-1-sec-1-logic-deontic-5",
