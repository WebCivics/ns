      },
      "cml:operator": "hasClass",
      "cml:logicSummary": "Exemptions based on class of representations",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
