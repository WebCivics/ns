      "dc:source": "competition-and-consumer-amendment-act-2013.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00104\n\nAmendments  Schedule 1",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00104\n\nAmendments  Schedule 1",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-act-2013-sec-3-norm"
        }
      ],
      "cml:integrityHash": "4e105b31e17ff49acc7c388badb2289cabc62ff405379139fc045040166313af",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-act-2013#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2013A00104\n\nAmendments  Schedule 1"
    },
