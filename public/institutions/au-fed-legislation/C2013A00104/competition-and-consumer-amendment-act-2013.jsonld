      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The regulations prescribe a class of representations for which subsection (1) does not apply",
      "cml:conclusionText": "Exemptions are prescribed by the regulations"
    },
    {
