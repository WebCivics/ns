      },
      "cml:premiseText": "oldAct means the Australian Civilian Corps Act 2011 as in force immediately before the commencement of this Part.",
      "cml:conclusionText": "AusAID etc. refers to oldAct."
    },
    {
      "@id": "concept:australian-civilian-corps-amendment-act-2013-sch-1-sec-123-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
