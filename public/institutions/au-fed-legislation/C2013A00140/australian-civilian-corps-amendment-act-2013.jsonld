    {
      "@id": "concept:australian-civilian-corps-amendment-act-2013-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-amendment-act-2013#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-amendment-act-2013.pdf"
      },
      "dc:source": "australian-civilian-corps-amendment-act-2013.pdf, p.6",
      "values:originalText": "(1) Each Act, and each set of regulations or directions, that is specified\nin a Schedule to this Act is amended or repealed as set out in the\napplicable items in the Schedule concerned, and any other item in a\nSchedule to this Act has effect according to its terms.\n\n(2) The amendment of any regulation under subsection (1) does not\nprevent the regulation, as so amended, from being amended or\nrepealed by the Governor-General.\n\n(3) The amendment of any direction under subsection (1) does not\nprevent the direction, as so amended, from being amended or\nrepealed by the Prime Minister or the Secretary of the Department\n(as the case requires).\nComLaw Authoritative Act C2013A00140\n\nAmendments  Schedule 1\nAmendment of the Australian Civilian Corps Act 2011  Part 1\n\nNo. 140, 2013\nAustralian Civilian Corps Amendment Act 2013",
      "skos:definition": "(1) Each Act, and each set of regulations or directions, that is specified\nin a Schedule to this Act is amended or repealed as set out in the\napplicable items in the Schedule concerned, and any other item in a\nSchedule to this Act has effect according to its terms.\n\n(2) The amendment of any regulation under subsection (1) does not\nprevent the regulation, as so amended, from being amended or\nrepealed by the Governor-General.\n\n(3) The amendment of any direction under subsection (1) does not\nprevent the direction, as so amended, from being amended or\nrepealed by the Prime Minister or the Secretary of the Department\n(as the case requires).\nComLaw Authoritative Act C2013A00140\n\nAmendments  Schedule 1\nAmendment of the Australian Civilian Corps Act 2011  Part 1\n\nNo. 140, 2013\nAustralian Civilian Corps Amendment Act 2013",
      "cml:hasPart": [
        {
          "@id": "concept:australian-civilian-corps-amendment-act-2013-sec-3-ss-1"
        },
        {
          "@id": "concept:australian-civilian-corps-amendment-act-2013-sec-3-ss-2"
        },
        {
          "@id": "concept:australian-civilian-corps-amendment-act-2013-sec-3-ss-3"
        }
      ],
      "cml:integrityHash": "a9e175300db737ee9dc5359689ec08180ba2e16b693b1080435c9e979eb890ab"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-amendment-act-2013#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "(1) Each Act, and each set of regulations or directions, that is specified\nin a Schedule to this Act is amended or repealed as set out in the\napplicable items in the Schedule concerned, and any other item in a\nSchedule to this Act has effect according to its terms.\n\n(2) The amendment of any regulation under subsection (1) does not\nprevent the regulation, as so amended, from being amended or\nrepealed by the Governor-General.\n\n(3) The amendment of any direction under subsection (1) does not\nprevent the direction, as so amended, from being amended or\nrepealed by the Prime Minister or the Secretary of the Department\n(as the case requires).\nComLaw Authoritative Act C2013A00140\n\nAmendments  Schedule 1\nAmendment of the Australian Civilian Corps Act 2011  Part 1\n\nNo. 140, 2013\nAustralian Civilian Corps Amendment Act 2013"
    },
