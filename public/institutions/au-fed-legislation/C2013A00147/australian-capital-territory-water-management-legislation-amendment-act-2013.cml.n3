    skos:prefLabel "2 Schedule 1"@en ;
    cml:realizedBy doc:sec-2-2 ;
    values:originalText "A single day to be fixed by Proclamation. However, if the provision(s) do not commence within the period of 12 months beginning on the day this Act receives the Royal Assent, they commence on the day after the end of that period." ;
