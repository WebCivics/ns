      "@type": "cml:Concept",
      "skos:prefLabel": "8 Paragraph 30(2)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-water-management-legislation-amendment-act-2013#sch-1-sec-8"
      },
