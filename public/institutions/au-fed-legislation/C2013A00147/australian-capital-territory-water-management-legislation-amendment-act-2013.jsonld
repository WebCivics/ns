      "@id": "concept:australian-capital-territory-water-management-legislation-amendment-act-2013-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 At the end of section 6",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-water-management-legislation-amendment-act-2013#sch-1-sec-4"
      },
      "cml:curationStatus": {
