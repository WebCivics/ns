    {
      "@id": "concept:australian-capital-territory-water-management-legislation-amendment-act-2013-sec-17-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 December",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-water-management-legislation-amendment-act-2013#sec-17-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-water-management-legislation-amendment-act-2013.pdf"
      },
      "dc:source": "australian-capital-territory-water-management-legislation-amendment-act-2013.pdf, p.6",
      "values:originalText": "ComLaw Authoritative Act C2013A00147\n\n\n\nNo. 147, 2013\nAustralian Capital Territory Water Management Legislation\nAmendment Act 2013\n\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvision(s)\nCommencement\nDate/Details\nRoyal Assent, they commence on the day\nafter the end of that period.\nNote 1:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\nNote 2:\nItems 1 and 3 of Schedule 2 to this Act amend provisions of the Water\nAct 2007 that concern the Basin Plan under that Act (see items 3 and 5\nof the table). The Basin Plan was adopted on 22 November 2012.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "skos:definition": "ComLaw Authoritative Act C2013A00147\n\n\n\nNo. 147, 2013\nAustralian Capital Territory Water Management Legislation\nAmendment Act 2013\n\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvision(s)\nCommencement\nDate/Details\nRoyal Assent, they commence on the day\nafter the end of that period.\nNote 1:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\nNote 2:\nItems 1 and 3 of Schedule 2 to this Act amend provisions of the Water\nAct 2007 that concern the Basin Plan under that Act (see items 3 and 5\nof the table). The Basin Plan was adopted on 22 November 2012.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-water-management-legislation-amendment-act-2013-sec-17-3-norm"
        }
      ],
      "cml:integrityHash": "9d1203cd12d8f963b24ae8a49a0686989d07eafd9fa5c0f6e4025bb249f7317d",
      "skos:note": "Commencement information for the Australian Capital Territory Water Management Legislation Amendment Act 2013."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-water-management-legislation-amendment-act-2013#sec-17-3",
      "@type": "cof:Section",
      "cof:title": "17 December",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "ComLaw Authoritative Act C2013A00147\n\n\n\nNo. 147, 2013\nAustralian Capital Territory Water Management Legislation\nAmendment Act 2013\n\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvision(s)\nCommencement\nDate/Details\nRoyal Assent, they commence on the day\nafter the end of that period.\nNote 1:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\nNote 2:\nItems 1 and 3 of Schedule 2 to this Act amend provisions of the Water\nAct 2007 that concern the Basin Plan under that Act (see items 3 and 5\nof the table). The Basin Plan was adopted on 22 November 2012.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act."
    },
    {
