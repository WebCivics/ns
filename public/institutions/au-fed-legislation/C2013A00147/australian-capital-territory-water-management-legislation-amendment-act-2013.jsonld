      "skos:note": "Treat surface water of Googong Dam Area as if located in Australian Capital Territory"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-water-management-legislation-amendment-act-2013#sch-2-sec-63a",
      "@type": "cof:Section",
      "cof:title": "63A Googong Dam Area to be treated as if located in the Australian",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Capital Territory\n\nFor the purposes of this Act, the surface water of the Googong\nDam Area (within the meaning of the Canberra Water Supply\n(Googong Dam) Act 1974) is to be treated as if it were located in\nthe Australian Capital Territory (and not in New South Wales)."
    },
