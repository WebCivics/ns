      },
      "dc:source": "australian-capital-territory-water-management-legislation-amendment-act-2013.pdf, p.6",
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 12 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period.",
      "skos:definition": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 12 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-water-management-legislation-amendment-act-2013-sec-2-2-norm"
        },
        {
          "@id": "concept:australian-capital-territory-water-management-legislation-amendment-act-2013-sec-2-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "d5bce3174cac78d11c991c393225c7d9a1fd2f8c80efb8a8fd2793f3392514c9",
      "skos:note": "Conditional commencement of provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-water-management-legislation-amendment-act-2013#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 12 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period."
    },
