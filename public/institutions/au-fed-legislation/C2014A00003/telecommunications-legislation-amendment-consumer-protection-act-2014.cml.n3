concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-1 a cml:Concept ;
    skos:prefLabel "1 Section 4"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Insert: give effect to, in relation to a contract, arrangement or understanding, includes do an act or thing:  (a) in pursuance of; or  (b) in accordance with; the contract, arrangement or understanding." ;
