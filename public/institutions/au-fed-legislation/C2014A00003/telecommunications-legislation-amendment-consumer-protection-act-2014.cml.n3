    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-119b-ss-4 a cof:Section ;
    cof:title "119B(4) Publication requirements for submissions" ;
    values:kind "subsection" ;
    values:originalText "(4) If:  (a) a submission made by a person consists wholly or partly of material that is claimed by the person to be confidential or commercially sensitive; and  (b) the person has requested the body or association not to publish the material; and  (c) the body or association is satisfied that the material is confidential or commercially sensitive; then:  (d) if the submission consists wholly of the material—the body or association is not required to publish the submission on its website; or  (e) if:  (i) the submission consists partly of the material; and  (ii) it is practicable for the body or association to remove the material from the submission;  the body or association may remove the material from the submission before publishing the submission on its website; or  (f) if:  (i) the submission consists partly of the material; and  (ii) it is not practicable for the body or association to remove the material from the submission;  the body or association is not required to publish the submission on its website." ;
    cof:pageNumber "12"^^xsd:integer .

concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-119b-ss-5 a cml:Concept ;
    skos:prefLabel "119B(5) Publication requirements for submissions"@en ;
    cml:realizedBy doc:sch-1-sec-119b-ss-5 ;
    values:originalText "(5) If, under subsection (4), the body or association removes material from a submission before publishing the submission on its website, the body or association must publish on its website a statement to the effect that confidential or commercially sensitive material in the submission has not been published. ComLaw Authoritative Act C2014A00003  Schedule 1  Amendments" ;
    skos:definition "(5) If, under subsection (4), the body or association removes material from a submission before publishing the submission on its website, the body or association must publish on its website a statement to the effect that confidential or commercially sensitive material in the submission has not been published. ComLaw Authoritative Act C2014A00003  Schedule 1  Amendments"@en ;
    cml:integrityHash "1caf38814d81ec77495d042dfe818878ddc00af78c85ac5b9c73180cffca7ff7" ;
    values:partOf concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-119b ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Publish statement if material is removed from submission before publishing" ;
    dc:description "statement to the effect that confidential or commercially sensitive material has not been published" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-consumer-protection-act-2014.pdf> ;
