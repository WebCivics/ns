      "skos:note": "Public consultation and consultation with the Telecommunications Industry Ombudsman and ACMA are required for a review."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-consumer-protection-act-2014#sch-1-sec-133a-ss-5",
      "@type": "cof:Section",
      "cof:title": "133A(5) Reviews of the Telecommunications Industry Ombudsman",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(5) A review must make provision for:\n\n(a) public consultation; and\n\n(b) consultation with:\n\n(i) the Telecommunications Industry Ombudsman; and\n\n(ii) the ACMA.\nReport of review"
    },
