    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-consumer-protection-act-2014#sch-1-sec-119b-ss-3",
      "@type": "cof:Section",
      "cof:title": "119B(3) Publication requirements for submissions",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(3) Subsection (2) has effect subject to subsections (4) and (6).\nConfidential or commercially sensitive material"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-119b-ss-3-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-119b-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-119b-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "119B(4) Publication requirements for submissions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-consumer-protection-act-2014#sch-1-sec-119b-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-consumer-protection-act-2014.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-consumer-protection-act-2014.pdf, p.12",
      "values:originalText": "(4) If:\n\n(a) a submission made by a person consists wholly or partly of\nmaterial that is claimed by the person to be confidential or\ncommercially sensitive; and\n\n(b) the person has requested the body or association not to\npublish the material; and\n\n(c) the body or association is satisfied that the material is\nconfidential or commercially sensitive;\nthen:\n\n(d) if the submission consists wholly of the material—the body\nor association is not required to publish the submission on its\nwebsite; or\n\n(e) if:\n\n(i) the submission consists partly of the material; and\n\n(ii) it is practicable for the body or association to remove\nthe material from the submission;\n\nthe body or association may remove the material from the\nsubmission before publishing the submission on its website;\nor\n\n(f) if:\n\n(i) the submission consists partly of the material; and\n\n(ii) it is not practicable for the body or association to\nremove the material from the submission;\n\nthe body or association is not required to publish the\nsubmission on its website.",
      "skos:definition": "(4) If:\n\n(a) a submission made by a person consists wholly or partly of\nmaterial that is claimed by the person to be confidential or\ncommercially sensitive; and\n\n(b) the person has requested the body or association not to\npublish the material; and\n\n(c) the body or association is satisfied that the material is\nconfidential or commercially sensitive;\nthen:\n\n(d) if the submission consists wholly of the material—the body\nor association is not required to publish the submission on its\nwebsite; or\n\n(e) if:\n\n(i) the submission consists partly of the material; and\n\n(ii) it is practicable for the body or association to remove\nthe material from the submission;\n\nthe body or association may remove the material from the\nsubmission before publishing the submission on its website;\nor\n\n(f) if:\n\n(i) the submission consists partly of the material; and\n\n(ii) it is not practicable for the body or association to\nremove the material from the submission;\n\nthe body or association is not required to publish the\nsubmission on its website.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-119b"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-119b-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-119b-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f78f713e5876790aa855094b2bf5c070581a4cf0def31084d2632e6ae9d06a78",
      "skos:note": "Exemptions from publication requirements for submissions with confidential or commercially sensitive material"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-consumer-protection-act-2014#sch-1-sec-119b-ss-4",
      "@type": "cof:Section",
      "cof:title": "119B(4) Publication requirements for submissions",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(4) If:\n\n(a) a submission made by a person consists wholly or partly of\nmaterial that is claimed by the person to be confidential or\ncommercially sensitive; and\n\n(b) the person has requested the body or association not to\npublish the material; and\n\n(c) the body or association is satisfied that the material is\nconfidential or commercially sensitive;\nthen:\n\n(d) if the submission consists wholly of the material—the body\nor association is not required to publish the submission on its\nwebsite; or\n\n(e) if:\n\n(i) the submission consists partly of the material; and\n\n(ii) it is practicable for the body or association to remove\nthe material from the submission;\n\nthe body or association may remove the material from the\nsubmission before publishing the submission on its website;\nor\n\n(f) if:\n\n(i) the submission consists partly of the material; and\n\n(ii) it is not practicable for the body or association to\nremove the material from the submission;\n\nthe body or association is not required to publish the\nsubmission on its website."
    },
