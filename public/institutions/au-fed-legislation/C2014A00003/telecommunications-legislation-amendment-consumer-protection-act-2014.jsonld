        },
        {
          "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c76ffca61461dac2542a7135c98ff624172d70470562a2fc0b5d264e9fd5edde",
      "skos:note": "Prohibit telemarketing calls without effect from the other party."
    },
