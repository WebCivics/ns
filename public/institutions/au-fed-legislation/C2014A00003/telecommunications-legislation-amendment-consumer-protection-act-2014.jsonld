    {
      "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Subparagraph 119A(1)(k)(i)",
      "cml:realizedBy": {
