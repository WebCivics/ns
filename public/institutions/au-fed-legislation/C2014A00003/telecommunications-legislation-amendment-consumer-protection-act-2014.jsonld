      },
      "dc:source": "telecommunications-legislation-amendment-consumer-protection-act-2014.pdf, p.22",
      "values:originalText": "Omit “National Privacy Principles (as defined in the Privacy Act\n1988)”, substitute “Australian Privacy Principles”.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 14 November 2013\nSenate on 11 February 2014]\n\n(196/13)\nComLaw Authoritative Act C2014A00003",
      "skos:definition": "Omit “National Privacy Principles (as defined in the Privacy Act\n1988)”, substitute “Australian Privacy Principles”.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 14 November 2013\nSenate on 11 February 2014]\n\n(196/13)\nComLaw Authoritative Act C2014A00003",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-33-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2e951ff2d129603f8ab48d9ea8cc0c4bd78e6c0ef9a388c4de5444423973c910",
      "skos:note": "Substitute Australian Privacy Principles for National Privacy Principles."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-consumer-protection-act-2014#sch-1-sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Subparagraph 119A(1)(k)(i)",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "Omit “National Privacy Principles (as defined in the Privacy Act\n1988)”, substitute “Australian Privacy Principles”.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 14 November 2013\nSenate on 11 February 2014]\n\n(196/13)\nComLaw Authoritative Act C2014A00003"
