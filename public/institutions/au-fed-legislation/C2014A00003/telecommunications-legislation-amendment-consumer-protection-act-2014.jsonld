      "dc:source": "telecommunications-legislation-amendment-consumer-protection-act-2014.pdf, p.7",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2014A00003\n\nSchedule 1  Amendments",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2014A00003\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "8bd6b86fe9457e6714cf6a191bcc5da47956c72759e05b5c16524b1c0680c319",
      "skos:note": "Amendments and repeals of Acts specified in a Schedule."
    },
    {
