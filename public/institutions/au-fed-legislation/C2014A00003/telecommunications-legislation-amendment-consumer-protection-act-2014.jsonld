      "dc:source": "telecommunications-legislation-amendment-consumer-protection-act-2014.pdf, p.8",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) there is a reasonable likelihood that the other person will give\neffect to the contract, arrangement or understanding by:\n\n(i) sending marketing faxes; or\nComLaw Authoritative Act C2014A00003\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 3, 2014\nTelecommunications Legislation Amendment (Consumer Protection)\nAct 2014\n\n(ii) causing any or all of the employees or agents of the\nother person to send marketing faxes; and",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) there is a reasonable likelihood that the other person will give\neffect to the contract, arrangement or understanding by:\n\n(i) sending marketing faxes; or\nComLaw Authoritative Act C2014A00003\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 3, 2014\nTelecommunications Legislation Amendment (Consumer Protection)\nAct 2014\n\n(ii) causing any or all of the employees or agents of the\nother person to send marketing faxes; and",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-6-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-consumer-protection-act-2014-sch-1-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e4c8dc043ce535630b505ee10ad278433a4e90958a5c0fc42d40117b4c21b29c",
      "skos:note": "Prohibit sending marketing faxes without consent."
    },
