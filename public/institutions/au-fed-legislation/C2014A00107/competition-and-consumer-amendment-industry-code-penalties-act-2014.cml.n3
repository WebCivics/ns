doc:sch-1-sec-8 a cof:Section ;
    cof:title "8 After paragraph 76(1B)(a)" ;
    values:kind "section" ;
    values:originalText "Insert:  (aaa) for each act or omission to which this section applies that relates to a civil penalty provision of an industry code—the ComLaw Authoritative Act C2014A00107  Amendments  Schedule 1  No. 107, 2014 Competition and Consumer Amendment (Industry Code Penalties) Act  amount set out in the civil penalty provision of the industry code; and  [Minister’s second reading speech made in— House of Representatives on 17 July 2014 Senate on 1 September 2014]  (163/14) ComLaw Authoritative Act C2014A00107" ;
    cof:pageNumber "12"^^xsd:integer .