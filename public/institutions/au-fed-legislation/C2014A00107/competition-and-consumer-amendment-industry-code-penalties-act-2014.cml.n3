concept:competition-and-consumer-amendment-industry-code-penalties-act-2014-sch-1-sec-5 a cml:Concept ;
    skos:prefLabel "5 At the end of section 51AE"@en ;
    cml:realizedBy doc:sch-1-sec-5 ;
    values:originalText "Add:  (2) If regulations prescribe an industry code, the industry code may prescribe pecuniary penalties not exceeding 300 penalty units for civil penalty provisions of the industry code." ;
