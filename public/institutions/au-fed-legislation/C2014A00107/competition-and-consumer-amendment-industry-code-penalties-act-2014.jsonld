      "dc:source": "competition-and-consumer-amendment-industry-code-penalties-act-2014.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2014A00107\n\nAmendments  Schedule 1\n\nNo. 107, 2014\nCompetition and Consumer Amendment (Industry Code Penalties) Act",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2014A00107\n\nAmendments  Schedule 1\n\nNo. 107, 2014\nCompetition and Consumer Amendment (Industry Code Penalties) Act",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-industry-code-penalties-act-2014-sec-3-norm"
        }
      ],
      "cml:integrityHash": "c64218eada70af4d41ae941c0e5becc1a70acdaf840efa6d1815c58868fe351b",
      "skos:note": "Schedules for amendment or repeal of Acts"
    },
