concept:australian-civilian-corps-act-2011-sec-25 a cml:Concept ;
    skos:prefLabel "25 Limitation on Ministerial directions to Secretary"@en ;
    cml:realizedBy doc:sec-25 ;
    values:originalText "The Secretary is not subject to direction by any Minister in relation to the exercise of powers by the Secretary under this Part in relation to particular individuals. ComLaw Authoritative Act C2014C00531   Leave for the purposes of service in the Australian Civilian Corps  Part 4  Section 26  Australian Civilian Corps Act 2011" ;
    skos:definition "The Secretary is not subject to direction by any Minister in relation to the exercise of powers by the Secretary under this Part in relation to particular individuals. ComLaw Authoritative Act C2014C00531   Leave for the purposes of service in the Australian Civilian Corps  Part 4  Section 26  Australian Civilian Corps Act 2011"@en ;
    cml:integrityHash "4e47d2770047f753019630e8b473c827446e9eaec7dd7b35c6af1754371f53f9" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "The Secretary is not subject to direction by any Minister." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
