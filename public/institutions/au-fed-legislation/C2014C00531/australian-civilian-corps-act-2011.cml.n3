concept:australian-civilian-corps-act-2011-sec-29a a cml:Concept ;
    skos:prefLabel "29A Prohibition of patronage and favouritism"@en ;
    cml:realizedBy doc:sec-29a ;
    values:originalText "A person exercising powers under this Act or the regulations:  (a) in relation to the engagement of Australian Civilian Corps employees; or  (b) otherwise in relation to Australian Civilian Corps employees; must do so without patronage or favouritism." ;
    skos:definition "A person exercising powers under this Act or the regulations:  (a) in relation to the engagement of Australian Civilian Corps employees; or  (b) otherwise in relation to Australian Civilian Corps employees; must do so without patronage or favouritism."@en ;
    cml:integrityHash "3cdc0b4ac331458dfceaa07197522df574d0f77f4da32a6ae74e810edb49433b" ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "No patronage or favouritism allowed when hiring Australian Civilian Corps employees." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-civilian-corps-act-2011.pdf> ;
    dc:source "australian-civilian-corps-act-2011.pdf, p.20" ;
    cml:asserts concept:australian-civilian-corps-act-2011-sec-29a-norm .
