    skos:prefLabel "28(3) Payments in special circumstances"@en ;
    cml:realizedBy doc:sec-28-ss-3 ;
    values:originalText "(3) Payments may be authorised under this section even though the payments would not otherwise be authorised by law or required to meet a legal liability." ;
