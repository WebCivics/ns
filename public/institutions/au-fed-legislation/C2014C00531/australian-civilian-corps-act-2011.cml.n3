concept:australian-civilian-corps-act-2011-sec-28-ss-5 a cml:Concept ;
    skos:prefLabel "28(5) Payments in special circumstances"@en ;
    cml:realizedBy doc:sec-28-ss-5 ;
    values:originalText "(5) Conditions may be attached to payments under this section. If a condition is breached, the payment may be recovered by the Commonwealth as a debt in a court of competent jurisdiction." ;
    skos:definition "(5) Conditions may be attached to payments under this section. If a condition is breached, the payment may be recovered by the Commonwealth as a debt in a court of competent jurisdiction."@en ;
