    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-1-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 July 2014. It includes any commenced amendment affecting the legislation to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-1-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.2",
      "values:originalText": "that date.\nThis compilation was prepared on 29 July 2014.\nThe notes at the end of this compilation (the endnotes) include information\nabout amending laws and the amendment history of each amended provision.\nUncommenced amendments\nThe effect of uncommenced amendments is not reflected in the text of the\ncompiled law but the text of the amendments is included in the endnotes.\nApplication, saving and transitional provisions for provisions and\namendments\nIf the operation of a provision or amendment is affected by an application,\nsaving or transitional provision that is not included in this compilation, details\nare included in the endnotes.\nModifications\nIf a provision of the compiled law is affected by a modification that is in force,\ndetails are included in the endnotes.\nProvisions ceasing to have effect\nIf a provision of the compiled law has expired or otherwise ceased to have\neffect in accordance with a provision of the law, details are included in the\nendnotes.\n\nComLaw Authoritative Act C2014C00531\n\n\n\nAustralian Civilian Corps Act 2011\ni\n\nContents",
      "skos:definition": "that date.\nThis compilation was prepared on 29 July 2014.\nThe notes at the end of this compilation (the endnotes) include information\nabout amending laws and the amendment history of each amended provision.\nUncommenced amendments\nThe effect of uncommenced amendments is not reflected in the text of the\ncompiled law but the text of the amendments is included in the endnotes.\nApplication, saving and transitional provisions for provisions and\namendments\nIf the operation of a provision or amendment is affected by an application,\nsaving or transitional provision that is not included in this compilation, details\nare included in the endnotes.\nModifications\nIf a provision of the compiled law is affected by a modification that is in force,\ndetails are included in the endnotes.\nProvisions ceasing to have effect\nIf a provision of the compiled law has expired or otherwise ceased to have\neffect in accordance with a provision of the law, details are included in the\nendnotes.\n\nComLaw Authoritative Act C2014C00531\n\n\n\nAustralian Civilian Corps Act 2011\ni\n\nContents",
      "cml:asserts": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-1-2-norm"
        }
      ],
      "cml:integrityHash": "8236c2f71c6fdac5f2b6f641a333c1e547edddabcade445fcd6417a7c492a4b3",
      "skos:note": "Compilation notes and application, saving, and transitional provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-1-2",
      "@type": "cof:Section",
      "cof:title": "1 July 2014. It includes any commenced amendment affecting the legislation to",
      "values:kind": "section",
      "cof:pageNumber": 2,
      "values:originalText": "that date.\nThis compilation was prepared on 29 July 2014.\nThe notes at the end of this compilation (the endnotes) include information\nabout amending laws and the amendment history of each amended provision.\nUncommenced amendments\nThe effect of uncommenced amendments is not reflected in the text of the\ncompiled law but the text of the amendments is included in the endnotes.\nApplication, saving and transitional provisions for provisions and\namendments\nIf the operation of a provision or amendment is affected by an application,\nsaving or transitional provision that is not included in this compilation, details\nare included in the endnotes.\nModifications\nIf a provision of the compiled law is affected by a modification that is in force,\ndetails are included in the endnotes.\nProvisions ceasing to have effect\nIf a provision of the compiled law has expired or otherwise ceased to have\neffect in accordance with a provision of the law, details are included in the\nendnotes.\n\nComLaw Authoritative Act C2014C00531\n\n\n\nAustralian Civilian Corps Act 2011\ni\n\nContents"
    },
