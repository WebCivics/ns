    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Secretary’s directions about the Australian Civilian Corps Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.9",
      "values:originalText": "of Conduct\n\n(1) The Secretary may, by legislative instrument, issue directions in\nrelation to the Australian Civilian Corps Code of Conduct for the\npurposes of determining, where necessary, the scope or application\nof the Australian Civilian Corps Code of Conduct.\n\n(2) For the purposes of this Act other than this section, the Australian\nCivilian Corps Code of Conduct has effect subject to the\nrestrictions (if any) in directions made under subsection (1).",
      "skos:definition": "of Conduct\n\n(1) The Secretary may, by legislative instrument, issue directions in\nrelation to the Australian Civilian Corps Code of Conduct for the\npurposes of determining, where necessary, the scope or application\nof the Australian Civilian Corps Code of Conduct.\n\n(2) For the purposes of this Act other than this section, the Australian\nCivilian Corps Code of Conduct has effect subject to the\nrestrictions (if any) in directions made under subsection (1).",
      "cml:hasPart": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-16-ss-1"
        },
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-16-ss-2"
        }
      ],
      "cml:integrityHash": "fd5e36a4da737198b75e435162318aa17a58cb9d2c8d7ee2f21b3335b0b8d07e"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Secretary’s directions about the Australian Civilian Corps Code",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "of Conduct\n\n(1) The Secretary may, by legislative instrument, issue directions in\nrelation to the Australian Civilian Corps Code of Conduct for the\npurposes of determining, where necessary, the scope or application\nof the Australian Civilian Corps Code of Conduct.\n\n(2) For the purposes of this Act other than this section, the Australian\nCivilian Corps Code of Conduct has effect subject to the\nrestrictions (if any) in directions made under subsection (1)."
    },
