    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Secretary’s directions about the Australian Civilian Corps Values",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.8",
      "values:originalText": "(1) The Secretary may, by legislative instrument, issue directions in\nrelation to each of the Australian Civilian Corps Values for the\npurposes of determining, where necessary, the scope or application\nof the Australian Civilian Corps Values.\n\n(2) For the purposes of this Act other than this section, the Australian\nCivilian Corps Values have effect subject to the restrictions (if any)\nin directions made under subsection (1).",
      "skos:definition": "(1) The Secretary may, by legislative instrument, issue directions in\nrelation to each of the Australian Civilian Corps Values for the\npurposes of determining, where necessary, the scope or application\nof the Australian Civilian Corps Values.\n\n(2) For the purposes of this Act other than this section, the Australian\nCivilian Corps Values have effect subject to the restrictions (if any)\nin directions made under subsection (1).",
      "cml:hasPart": [
