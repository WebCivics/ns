    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Limitation on Ministerial directions to Secretary",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.16",
      "values:originalText": "The Secretary is not subject to direction by any Minister in relation\nto the exercise of powers by the Secretary under this Part in\nrelation to particular individuals.\nComLaw Authoritative Act C2014C00531\n\n\nLeave for the purposes of service in the Australian Civilian Corps  Part 4\n\nSection 26\n\nAustralian Civilian Corps Act 2011",
      "skos:definition": "The Secretary is not subject to direction by any Minister in relation\nto the exercise of powers by the Secretary under this Part in\nrelation to particular individuals.\nComLaw Authoritative Act C2014C00531\n\n\nLeave for the purposes of service in the Australian Civilian Corps  Part 4\n\nSection 26\n\nAustralian Civilian Corps Act 2011",
      "cml:asserts": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-25-norm"
        },
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-25-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4e47d2770047f753019630e8b473c827446e9eaec7dd7b35c6af1754371f53f9",
      "skos:note": "The Secretary is not subject to direction by any Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Limitation on Ministerial directions to Secretary",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "The Secretary is not subject to direction by any Minister in relation\nto the exercise of powers by the Secretary under this Part in\nrelation to particular individuals.\nComLaw Authoritative Act C2014C00531\n\n\nLeave for the purposes of service in the Australian Civilian Corps  Part 4\n\nSection 26\n\nAustralian Civilian Corps Act 2011"
    },
