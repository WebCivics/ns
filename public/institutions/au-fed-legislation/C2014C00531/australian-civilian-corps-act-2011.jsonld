    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Power to grant leave for the purposes of service in the Australian",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.17",
      "values:originalText": "Civilian Corps\n\n(1) An employer in Australia may, at the request of an employee of the\nemployer, grant unpaid leave to the employee for the purposes of\nservice in the Australian Civilian Corps.\n\n(2) Subsection (1) is in addition to, and not instead of, any other power\nof an employer to grant unpaid leave.",
      "skos:definition": "Civilian Corps\n\n(1) An employer in Australia may, at the request of an employee of the\nemployer, grant unpaid leave to the employee for the purposes of\nservice in the Australian Civilian Corps.\n\n(2) Subsection (1) is in addition to, and not instead of, any other power\nof an employer to grant unpaid leave.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-26-ss-1"
        },
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-26-ss-2"
        }
      ],
      "cml:integrityHash": "f01b95e790b40dea5ede30d5c0b0f0cf14378ad9d65530d22a7c62d4a3324ab1"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Power to grant leave for the purposes of service in the Australian",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Civilian Corps\n\n(1) An employer in Australia may, at the request of an employee of the\nemployer, grant unpaid leave to the employee for the purposes of\nservice in the Australian Civilian Corps.\n\n(2) Subsection (1) is in addition to, and not instead of, any other power\nof an employer to grant unpaid leave."
    },
