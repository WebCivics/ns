    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Objects",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.6",
      "values:originalText": "The objects of this Act are:\n\n(a) to establish the Australian Civilian Corps; and\n\n(b) to provide a legal framework for the effective and fair\nemployment and management of Australian Civilian Corps\nemployees.",
      "skos:definition": "The objects of this Act are:\n\n(a) to establish the Australian Civilian Corps; and\n\n(b) to provide a legal framework for the effective and fair\nemployment and management of Australian Civilian Corps\nemployees.",
      "cml:asserts": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-3-norm"
        },
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8860b292bd8cc90b4e320f126250bde16b91115572c574952534a657cc0d68ae",
      "skos:note": "Establishing the Australian Civilian Corps and providing a legal framework for its employees."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Objects",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "The objects of this Act are:\n\n(a) to establish the Australian Civilian Corps; and\n\n(b) to provide a legal framework for the effective and fair\nemployment and management of Australian Civilian Corps\nemployees."
    },
