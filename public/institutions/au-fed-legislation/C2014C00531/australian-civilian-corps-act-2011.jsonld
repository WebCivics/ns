    },
    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Crown to be bound",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.7",
      "values:originalText": "(1) This Act binds the Crown in each of its capacities.\n\n(2) However, this Act does not make the Crown liable to a pecuniary\npenalty or to be prosecuted for an offence.",
      "skos:definition": "(1) This Act binds the Crown in each of its capacities.\n\n(2) However, this Act does not make the Crown liable to a pecuniary\npenalty or to be prosecuted for an offence.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-6-ss-1"
        },
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-6-ss-2"
        }
      ],
      "cml:integrityHash": "dfc4587b23a129211ea72a198303e2a59d4f92f7f7cd2801254a4964b19c6b88"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Crown to be bound",
      "values:kind": "section",
