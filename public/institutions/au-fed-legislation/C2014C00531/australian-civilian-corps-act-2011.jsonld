    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Secondment of Australian Civilian Corps employees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.15",
      "values:originalText": "Secondment\n\n(1) The Secretary may arrange for an Australian Civilian Corps\nemployee to be seconded for a specified period to any body or\norganisation (including an international body or organisation).\n\n(2) The Secretary may enter into an agreement with a body or\norganisation in relation to the secondment of one or more\nAustralian Civilian Corps employees to the body or organisation\nunder subsection (1).\n\n(3) The Secretary may enter into an agreement with an Australian\nCivilian Corps employee in relation to the secondment of the\nemployee to a body or organisation under subsection (1).\nComLaw Authoritative Act C2014C00531",
      "skos:definition": "Secondment\n\n(1) The Secretary may arrange for an Australian Civilian Corps\nemployee to be seconded for a specified period to any body or\norganisation (including an international body or organisation).\n\n(2) The Secretary may enter into an agreement with a body or\norganisation in relation to the secondment of one or more\nAustralian Civilian Corps employees to the body or organisation\nunder subsection (1).\n\n(3) The Secretary may enter into an agreement with an Australian\nCivilian Corps employee in relation to the secondment of the\nemployee to a body or organisation under subsection (1).\nComLaw Authoritative Act C2014C00531",
      "cml:hasPart": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-24-ss-1"
        },
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-24-ss-2"
        },
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-24-ss-3"
        }
      ],
      "cml:integrityHash": "fc2723b0e10a5f7e43cabed219173ab5d5bdcde6fa925dc41d4852623faf09ec"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-24",
      "@type": "cof:Section",
      "cof:title": "24 Secondment of Australian Civilian Corps employees",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Secondment\n\n(1) The Secretary may arrange for an Australian Civilian Corps\nemployee to be seconded for a specified period to any body or\norganisation (including an international body or organisation).\n\n(2) The Secretary may enter into an agreement with a body or\norganisation in relation to the secondment of one or more\nAustralian Civilian Corps employees to the body or organisation\nunder subsection (1).\n\n(3) The Secretary may enter into an agreement with an Australian\nCivilian Corps employee in relation to the secondment of the\nemployee to a body or organisation under subsection (1).\nComLaw Authoritative Act C2014C00531"
    },
