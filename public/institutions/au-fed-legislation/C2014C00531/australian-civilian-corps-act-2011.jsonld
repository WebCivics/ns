    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.6",
      "values:originalText": "The following is a simplified outline of this Act:\n•\nThis Act establishes the Australian Civilian Corps.\n•\nThe Australian Civilian Corps consists of persons engaged\nunder this Act as Australian Civilian Corps employees.\n•\nThe Secretary of the Department is to manage the Australian\nCivilian Corps.\n•\nAustralian Civilian Corps employees will perform duties\noverseas.",
      "skos:definition": "The following is a simplified outline of this Act:\n•\nThis Act establishes the Australian Civilian Corps.\n•\nThe Australian Civilian Corps consists of persons engaged\nunder this Act as Australian Civilian Corps employees.\n•\nThe Secretary of the Department is to manage the Australian\nCivilian Corps.\n•\nAustralian Civilian Corps employees will perform duties\noverseas.",
      "cml:asserts": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-4-norm"
        }
      ],
      "cml:integrityHash": "8c2d698915fa3cbe98b29c303e3d6ccd2e8ca2cbd553b6cc273bb5b969664460",
      "skos:note": "Establishes the Australian Civilian Corps and outlines its structure."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "The following is a simplified outline of this Act:\n•\nThis Act establishes the Australian Civilian Corps.\n•\nThe Australian Civilian Corps consists of persons engaged\nunder this Act as Australian Civilian Corps employees.\n•\nThe Secretary of the Department is to manage the Australian\nCivilian Corps.\n•\nAustralian Civilian Corps employees will perform duties\noverseas."
    },
    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-4-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
