    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-29a",
      "@type": "cml:Concept",
      "skos:prefLabel": "29A Prohibition of patronage and favouritism",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-29a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-civilian-corps-act-2011.pdf"
      },
      "dc:source": "australian-civilian-corps-act-2011.pdf, p.20",
      "values:originalText": "A person exercising powers under this Act or the regulations:\n\n(a) in relation to the engagement of Australian Civilian Corps\nemployees; or\n\n(b) otherwise in relation to Australian Civilian Corps employees;\nmust do so without patronage or favouritism.",
      "skos:definition": "A person exercising powers under this Act or the regulations:\n\n(a) in relation to the engagement of Australian Civilian Corps\nemployees; or\n\n(b) otherwise in relation to Australian Civilian Corps employees;\nmust do so without patronage or favouritism.",
      "cml:asserts": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-29a-norm"
        },
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-29a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3cdc0b4ac331458dfceaa07197522df574d0f77f4da32a6ae74e810edb49433b",
      "skos:note": "No patronage or favouritism allowed when hiring Australian Civilian Corps employees."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-29a",
      "@type": "cof:Section",
      "cof:title": "29A Prohibition of patronage and favouritism",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "A person exercising powers under this Act or the regulations:\n\n(a) in relation to the engagement of Australian Civilian Corps\nemployees; or\n\n(b) otherwise in relation to Australian Civilian Corps employees;\nmust do so without patronage or favouritism."
    },
    {
      "@id": "concept:australian-civilian-corps-act-2011-sec-29a-norm",
      "@type": "values:Prohibition",
