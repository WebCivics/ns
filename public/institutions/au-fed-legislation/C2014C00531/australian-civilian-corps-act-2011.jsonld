      "dc:source": "australian-civilian-corps-act-2011.pdf, p.1",
      "values:originalText": "Includes amendments up to:\nAct No. 62, 2014\n\nComLaw Authoritative Act C2014C00531\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Civilian Corps Act 2011 as in force on",
      "skos:definition": "Includes amendments up to:\nAct No. 62, 2014\n\nComLaw Authoritative Act C2014C00531\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Civilian Corps Act 2011 as in force on",
      "cml:asserts": [
        {
          "@id": "concept:australian-civilian-corps-act-2011-sec-1-norm"
        }
      ],
      "cml:integrityHash": "3df38dd4a096f9e3c95f2c29c6efd5e9d885adebf29b964cf0dc6ff5c4766b4d",
      "skos:note": "Compilation of Australian Civilian Corps Act 2011"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-civilian-corps-act-2011#sec-1",
      "@type": "cof:Section",
      "cof:title": "1 July 2014",
      "values:kind": "section",
      "cof:pageNumber": 1,
      "values:originalText": "Includes amendments up to:\nAct No. 62, 2014\n\nComLaw Authoritative Act C2014C00531\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Civilian Corps Act 2011 as in force on"
    },
