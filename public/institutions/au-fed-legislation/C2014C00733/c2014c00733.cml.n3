doc:sch-4-sec-3-ss-2 a cof:Section ;
    cof:title "3(2) Schedule(s)" ;
    values:kind "subsection" ;
    values:originalText "(2) The amendment of any regulation under subsection (1) does not prevent the regulation, as so amended, from being amended or repealed by the Governor-General." ;
    cof:pageNumber "6"^^xsd:integer .

