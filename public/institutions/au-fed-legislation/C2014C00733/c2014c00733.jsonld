      },
      "dc:source": "c2014c00733.pdf, p.1",
      "values:originalText": "Includes amendments up to:\nAct No. 109, 2014\n\nComLaw Authoritative Act C2014C00733\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Communications and Media Authority\n(Consequential and Transitional Provisions) Act 2005 as in force on 17 October",
      "skos:definition": "Includes amendments up to:\nAct No. 109, 2014\n\nComLaw Authoritative Act C2014C00733\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Communications and Media Authority\n(Consequential and Transitional Provisions) Act 2005 as in force on 17 October",
      "cml:asserts": [
        {
          "@id": "concept:c2014c00733-sec-17-norm"
        }
      ],
      "cml:integrityHash": "3a03688ae6229e85d88318aa1f43ceb7ed258061e015377defc69fdde8ec73f9",
      "skos:note": "Compilation of Australian Communications and Media Authority (Consequential and Transitional Provisions) Act 2005"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2014c00733#sec-17",
      "@type": "cof:Section",
      "cof:title": "17 October 2014",
      "values:kind": "section",
      "cof:pageNumber": 1,
      "values:originalText": "Includes amendments up to:\nAct No. 109, 2014\n\nComLaw Authoritative Act C2014C00733\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Communications and Media Authority\n(Consequential and Transitional Provisions) Act 2005 as in force on 17 October"
    },
