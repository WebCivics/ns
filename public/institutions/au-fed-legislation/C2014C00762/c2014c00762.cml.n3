concept:c2014c00762-sec-10 a cml:Concept ;
    skos:prefLabel "10 Judicial notice"@en ;
    cml:realizedBy doc:sec-10 ;
    values:originalText "All courts, judges and persons acting judicially shall take judicial notice of the imprint of the seal of the Australian Broadcasting Commission appearing on a document that was executed before the commencing day and shall presume that the document was duly sealed." ;
    skos:definition "All courts, judges and persons acting judicially shall take judicial notice of the imprint of the seal of the Australian Broadcasting Commission appearing on a document that was executed before the commencing day and shall presume that the document was duly sealed."@en ;
