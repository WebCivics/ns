      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "preservation",
      "cml:logicSummary": "Preservation of corporate identity",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "subsection 5(1) of the Australian Broadcasting Corporation Act 1983",
      "cml:conclusionText": "The corporate identity of the body corporate is preserved"
    },
