          "@id": "concept:c2014c00762-sec-1-norm"
        }
      ],
      "cml:integrityHash": "9ee13da22e762db3deea0f4f08592a529ebc15cb9593c0f2b211836db3b2d9f5",
      "skos:note": "Citation of the Act"
    },
