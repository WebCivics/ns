    {
      "@id": "concept:c2014c00762-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Judicial notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2014c00762#sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2014c00762.pdf"
      },
      "dc:source": "c2014c00762.pdf, p.7",
      "values:originalText": "All courts, judges and persons acting judicially shall take judicial\nnotice of the imprint of the seal of the Australian Broadcasting\nCommission appearing on a document that was executed before the\ncommencing day and shall presume that the document was duly\nsealed.",
      "skos:definition": "All courts, judges and persons acting judicially shall take judicial\nnotice of the imprint of the seal of the Australian Broadcasting\nCommission appearing on a document that was executed before the\ncommencing day and shall presume that the document was duly\nsealed.",
      "cml:asserts": [
        {
          "@id": "concept:c2014c00762-sec-10-norm"
        },
        {
          "@id": "concept:c2014c00762-sec-10-logic-deontic-1"
        },
        {
          "@id": "concept:c2014c00762-sec-10-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2014c00762-sec-10-logic-deontic-3"
        },
        {
          "@id": "concept:c2014c00762-sec-10-logic-deontic-4"
        },
        {
          "@id": "concept:c2014c00762-sec-10-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "d39a0b1a890cdecde23ea70b8124be033d67d05592c5a8b35518ec3e63602862",
      "skos:note": "All courts, judges and persons acting judicially must take notice of the seal of the Australian Broadcasting Commission."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2014c00762#sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Judicial notice",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "All courts, judges and persons acting judicially shall take judicial\nnotice of the imprint of the seal of the Australian Broadcasting\nCommission appearing on a document that was executed before the\ncommencing day and shall presume that the document was duly\nsealed."
    },
    {
      "@id": "concept:c2014c00762-sec-10-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2014c00762-sec-10"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2014c00762-sec-10-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to take notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The document was executed before the commencing day.",
      "cml:conclusionText": "All courts, judges and persons acting judicially must take notice of the seal."
    },
    {
      "@id": "concept:c2014c00762-sec-10-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Seal appears on documents executed before the commencing day.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The document has the imprint of the Australian Broadcasting Commission's seal.",
      "cml:conclusionText": "The document was executed before the commencing day."
    },
    {
      "@id": "concept:c2014c00762-sec-10-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to presume the document was sealed.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The document has the imprint of the Australian Broadcasting Commission's seal.",
      "cml:conclusionText": "All courts, judges and persons acting judicially must presume that the document was sealed."
    },
    {
