        },
        {
          "@id": "concept:c2014c00762-sec-8-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "cb9a6bd3424ce4917e2e93e979450cfc320c6d4cf814fe4accb3f658753f1448",
      "skos:note": "Continuation of property, powers, rights, liabilities, and obligations despite name change."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2014c00762#sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Property, powers, liabilities, &c.",
