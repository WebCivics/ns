    {
      "@id": "concept:c2014c00762-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 October 2014",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2014c00762#sec-17"
      },
      "cml:curationStatus": {
