    {
      "@id": "concept:c2014c00762-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Officers and employees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2014c00762#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2014c00762.pdf"
      },
      "dc:source": "c2014c00762.pdf, p.7",
      "values:originalText": "Any person who was an officer (including an officer on probation)\nor a temporary employee of the Australian Broadcasting\nCommission immediately before the commencing day by virtue of\nhis having been appointed or engaged under subsection 43(2) of\nthe Broadcasting and Television Act 1942 continues, subject to the\nAustralian Broadcasting Corporation Act 1983, as an officer or\ntemporary employee, as the case may be, of the Corporation as if\nhe had been appointed or engaged under section 33 of that\nlast-mentioned Act.",
      "skos:definition": "Any person who was an officer (including an officer on probation)\nor a temporary employee of the Australian Broadcasting\nCommission immediately before the commencing day by virtue of\nhis having been appointed or engaged under subsection 43(2) of\nthe Broadcasting and Television Act 1942 continues, subject to the\nAustralian Broadcasting Corporation Act 1983, as an officer or\ntemporary employee, as the case may be, of the Corporation as if\nhe had been appointed or engaged under section 33 of that\nlast-mentioned Act.",
      "cml:asserts": [
        {
          "@id": "concept:c2014c00762-sec-11-norm"
        },
        {
          "@id": "concept:c2014c00762-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ecb271a898730ec82c16c81039827f59e74acd32dc40a41a5af0581a1638cdda",
      "skos:note": "Continuation of employment for certain individuals"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2014c00762#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Officers and employees",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Any person who was an officer (including an officer on probation)\nor a temporary employee of the Australian Broadcasting\nCommission immediately before the commencing day by virtue of\nhis having been appointed or engaged under subsection 43(2) of\nthe Broadcasting and Television Act 1942 continues, subject to the\nAustralian Broadcasting Corporation Act 1983, as an officer or\ntemporary employee, as the case may be, of the Corporation as if\nhe had been appointed or engaged under section 33 of that\nlast-mentioned Act."
    },
    {
      "@id": "concept:c2014c00762-sec-11-norm",
      "@type": "values:Obligation",
      "cml:modality": {
