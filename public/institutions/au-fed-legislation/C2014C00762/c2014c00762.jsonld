    {
      "@id": "concept:c2014c00762-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Extension to external Territories",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2014c00762#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2014c00762.pdf"
      },
      "dc:source": "c2014c00762.pdf, p.6",
      "values:originalText": "This Part extends to all the external Territories.",
      "skos:definition": "This Part extends to all the external Territories.",
