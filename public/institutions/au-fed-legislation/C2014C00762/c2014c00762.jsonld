    {
      "@id": "concept:c2014c00762-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2014c00762#sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
