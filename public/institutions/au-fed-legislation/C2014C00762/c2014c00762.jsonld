      },
      "dc:source": "c2014c00762.pdf, p.5",
      "values:originalText": "(1) Sections 1 and 2 and subsection 15(1) shall come into operation on\nthe day on which this Act receives the Royal Assent.\n\n(2) The remaining provisions of this Act shall come into operation on\nthe day fixed under subsection 2(2) of the Australian Broadcasting\nCorporation Act 1983.",
      "skos:definition": "(1) Sections 1 and 2 and subsection 15(1) shall come into operation on\nthe day on which this Act receives the Royal Assent.\n\n(2) The remaining provisions of this Act shall come into operation on\nthe day fixed under subsection 2(2) of the Australian Broadcasting\nCorporation Act 1983.",
      "cml:hasPart": [
        {
          "@id": "concept:c2014c00762-sec-2-ss-1"
        },
        {
          "@id": "concept:c2014c00762-sec-2-ss-2"
        }
      ],
      "cml:integrityHash": "bbd31cd2f832af24ba4abd6a9be793f73b1e0b3d6d8a804e6ea404b3c9b86756"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2014c00762#sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Commencement",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "(1) Sections 1 and 2 and subsection 15(1) shall come into operation on\nthe day on which this Act receives the Royal Assent.\n\n(2) The remaining provisions of this Act shall come into operation on\nthe day fixed under subsection 2(2) of the Australian Broadcasting\nCorporation Act 1983."
    },
