      },
      "dc:source": "c2014c00762.pdf, p.1",
      "values:originalText": "Includes amendments up to:\nAct No. 109, 2014\n\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Broadcasting Corporation (Transitional\nProvisions and Consequential Amendments) Act 1983 as in force on 17 october",
      "skos:definition": "Includes amendments up to:\nAct No. 109, 2014\n\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Broadcasting Corporation (Transitional\nProvisions and Consequential Amendments) Act 1983 as in force on 17 october",
      "cml:asserts": [
        {
          "@id": "concept:c2014c00762-sec-17-norm"
        }
      ],
      "cml:integrityHash": "8733b6cfeb26a8b6c7d684b7fadb09db657a1a162c8d31cf32d6fcccbe9d03f0",
      "skos:note": "Compilation of amendments up to Act No. 109, 2014"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2014c00762#sec-17",
      "@type": "cof:Section",
      "cof:title": "17 October 2014",
      "values:kind": "section",
      "cof:pageNumber": 1,
      "values:originalText": "Includes amendments up to:\nAct No. 109, 2014\n\n\n\n\nAbout this compilation\nThis compilation\nThis is a compilation of the Australian Broadcasting Corporation (Transitional\nProvisions and Consequential Amendments) Act 1983 as in force on 17 october"
    },
    {
