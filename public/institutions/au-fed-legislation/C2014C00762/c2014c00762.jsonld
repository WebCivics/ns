      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "On the commencing day",
      "cml:conclusionText": "Members of Commission cease to hold office"
    },
    {
      "@id": "concept:c2014c00762-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Property, powers, liabilities, &c.",
      "cml:realizedBy": {
