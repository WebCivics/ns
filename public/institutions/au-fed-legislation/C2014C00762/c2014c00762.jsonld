    },
    {
      "@id": "concept:c2014c00762-sec-2014",
      "@type": "cml:Concept",
      "skos:prefLabel": "2014 It includes any commenced amendment affecting the legislation to that",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2014c00762#sec-2014"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2014c00762.pdf"
      },
      "dc:source": "c2014c00762.pdf, p.2",
      "values:originalText": "date.\nThis compilation was prepared on 3 November 2014.\nThe notes at the end of this compilation (the endnotes) include information\nabout amending laws and the amendment history of each amended provision.\nUncommenced amendments\nThe effect of uncommenced amendments is not reflected in the text of the\ncompiled law but the text of the amendments is included in the endnotes.\nApplication, saving and transitional provisions for provisions and\namendments\nIf the operation of a provision or amendment is affected by an application,\nsaving or transitional provision that is not included in this compilation, details\nare included in the endnotes.\nModifications\nIf a provision of the compiled law is affected by a modification that is in force,\ndetails are included in the endnotes.\nProvisions ceasing to have effect\nIf a provision of the compiled law has expired or otherwise ceased to have\neffect in accordance with a provision of the law, details are included in the\nendnotes.\n\n\n\n\nAustralian Broadcasting Corporation (Transitional Provisions and\nConsequential Amendments) Act 1983\ni\n\nContents",
      "skos:definition": "date.\nThis compilation was prepared on 3 November 2014.\nThe notes at the end of this compilation (the endnotes) include information\nabout amending laws and the amendment history of each amended provision.\nUncommenced amendments\nThe effect of uncommenced amendments is not reflected in the text of the\ncompiled law but the text of the amendments is included in the endnotes.\nApplication, saving and transitional provisions for provisions and\namendments\nIf the operation of a provision or amendment is affected by an application,\nsaving or transitional provision that is not included in this compilation, details\nare included in the endnotes.\nModifications\nIf a provision of the compiled law is affected by a modification that is in force,\ndetails are included in the endnotes.\nProvisions ceasing to have effect\nIf a provision of the compiled law has expired or otherwise ceased to have\neffect in accordance with a provision of the law, details are included in the\nendnotes.\n\n\n\n\nAustralian Broadcasting Corporation (Transitional Provisions and\nConsequential Amendments) Act 1983\ni\n\nContents",
      "cml:asserts": [
        {
          "@id": "concept:c2014c00762-sec-2014-norm"
        }
      ],
      "cml:integrityHash": "a1bc5186f5cfced8ad83ebdc14e6642cfb9a2d482197ae82ba84622cac6fadde",
      "skos:note": "Compilation notes and application, saving, and transitional provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2014c00762#sec-2014",
      "@type": "cof:Section",
      "cof:title": "2014 It includes any commenced amendment affecting the legislation to that",
      "values:kind": "section",
      "cof:pageNumber": 2,
      "values:originalText": "date.\nThis compilation was prepared on 3 November 2014.\nThe notes at the end of this compilation (the endnotes) include information\nabout amending laws and the amendment history of each amended provision.\nUncommenced amendments\nThe effect of uncommenced amendments is not reflected in the text of the\ncompiled law but the text of the amendments is included in the endnotes.\nApplication, saving and transitional provisions for provisions and\namendments\nIf the operation of a provision or amendment is affected by an application,\nsaving or transitional provision that is not included in this compilation, details\nare included in the endnotes.\nModifications\nIf a provision of the compiled law is affected by a modification that is in force,\ndetails are included in the endnotes.\nProvisions ceasing to have effect\nIf a provision of the compiled law has expired or otherwise ceased to have\neffect in accordance with a provision of the law, details are included in the\nendnotes.\n\n\n\n\nAustralian Broadcasting Corporation (Transitional Provisions and\nConsequential Amendments) Act 1983\ni\n\nContents"
    },
