      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Appeals have expired or lapsed",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "APPEALS",
      "cml:premiseText": "one of the following applies: the time for an appeal against the refusal has expired without an appeal being lodged; an appeal against the refusal has lapsed; an appeal against the refusal has been dismissed and finally disposed of."
    },
