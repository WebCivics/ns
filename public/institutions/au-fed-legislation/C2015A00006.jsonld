      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Ceases to be in force",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "CEASES",
      "cml:premiseText": "the restraining order was made at the same time as or after an application for an unexplained wealth order is made in relation to the suspect to whom the restraining order relates;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-10-ss-3a-logic-deontic-2",
