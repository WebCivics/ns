      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Appeals have expired or lapsed after a certain time",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "the time for an appeal against the refusal has expired without an appeal being lodged; an appeal against the refusal has lapsed; an appeal against the refusal has been dismissed and finally disposed of."
    },
    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-10-ss-3a-logic-deontic-1",
