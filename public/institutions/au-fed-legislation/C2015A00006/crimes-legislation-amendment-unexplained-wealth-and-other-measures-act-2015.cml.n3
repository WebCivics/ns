    cml:hasPart concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-15-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
