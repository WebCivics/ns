concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-27 a cml:Concept ;
    skos:prefLabel "27 After paragraph 227(1)(h)"@en ;
    cml:realizedBy doc:sch-1-sec-27 ;
    values:originalText "Insert:  (ha) that the warrant authorises the seizure of other things found at the premises in the course of the search that the executing officer or a person assisting believes on reasonable grounds to be *things relevant to unexplained wealth proceedings; and" ;
