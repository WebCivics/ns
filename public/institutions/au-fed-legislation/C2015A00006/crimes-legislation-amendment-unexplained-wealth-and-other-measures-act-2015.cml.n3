concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-17 a cml:Concept ;
    skos:prefLabel "17 At the end of section 179B"@en ;
    cml:realizedBy doc:sch-1-sec-17 ;
    values:originalText "Add: Refusal to make preliminary unexplained wealth order  (4) Despite subsection (1), the court may refuse to make the *preliminary unexplained wealth order if the court is satisfied that there are not reasonable grounds to suspect that the person’s *total wealth exceeds by $100,000 or more the value of the person’s *wealth that was *lawfully acquired." ;
    skos:definition "Add: Refusal to make preliminary unexplained wealth order  (4) Despite subsection (1), the court may refuse to make the *preliminary unexplained wealth order if the court is satisfied that there are not reasonable grounds to suspect that the person’s *total wealth exceeds by $100,000 or more the value of the person’s *wealth that was *lawfully acquired."@en ;
    cml:integrityHash "7f03391800651db26054e51e80ae622e66e2d662146e2d99961d2d15957f7c69" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Court may refuse to make preliminary unexplained wealth order if no reasonable grounds exist." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
