        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-15-ss-2"
        }
      ],
      "cml:integrityHash": "d5e34df635bb3374c90869a66f954799abd68a1a41d07f02014dc7bff6e292d7"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-15",
