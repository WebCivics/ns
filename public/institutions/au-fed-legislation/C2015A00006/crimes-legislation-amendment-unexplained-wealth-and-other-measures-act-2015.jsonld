    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Subsection 179E(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf, p.12",
      "values:originalText": "Omit all the words after “may refuse to make an order under that\nsubsection”, substitute:\n\nif the court is satisfied that:\n\n(a) the person’s *unexplained wealth amount is less than\n$100,000; or\n\n(b) it is not in the public interest to make the order.",
      "skos:definition": "Omit all the words after “may refuse to make an order under that\nsubsection”, substitute:\n\nif the court is satisfied that:\n\n(a) the person’s *unexplained wealth amount is less than\n$100,000; or\n\n(b) it is not in the public interest to make the order.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-20-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2267d91bcef8cb081e93124980d54904651a00f73d4adcb4a929b1ee34fbc73c",
      "skos:note": "Court may refuse to make an order under subsection 179E(6) if person's unexplained wealth amount is less than $100,000 or not in public interest."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Subsection 179E(6)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Omit all the words after “may refuse to make an order under that\nsubsection”, substitute:\n\nif the court is satisfied that:\n\n(a) the person’s *unexplained wealth amount is less than\n$100,000; or\n\n(b) it is not in the public interest to make the order."
    },
