    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Paragraph 45A(2)(c)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) the court refuses to make either:\n\n(i) a *preliminary unexplained wealth order in connection\nwith the application for the unexplained wealth order; or\n\n(ii) the unexplained wealth order itself; and"
    },
