    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 After subsection 179N(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf, p.12",
      "values:originalText": "Insert:\n\n(2A) The court may make an order extending the period during which\nthe things referred to in subsection (2) must be done, by a period\nnot exceeding 28 days, if:\n\n(a) the *responsible authority applies for the order before the end\nof the period (including that period as previously extended);\nand\n\n(b) the court is satisfied that it is appropriate to do so.\n\n(2B) The period referred to in subsection (2) may be extended more than\nonce.",
      "skos:definition": "Insert:\n\n(2A) The court may make an order extending the period during which\nthe things referred to in subsection (2) must be done, by a period\nnot exceeding 28 days, if:\n\n(a) the *responsible authority applies for the order before the end\nof the period (including that period as previously extended);\nand\n\n(b) the court is satisfied that it is appropriate to do so.\n\n(2B) The period referred to in subsection (2) may be extended more than\nonce.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-22-ss-2a"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-22-ss-2b"
        }
      ],
      "cml:integrityHash": "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-22",
      "@type": "cof:Section",
      "cof:title": "22 After subsection 179N(2)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Insert:\n\n(2A) The court may make an order extending the period during which\nthe things referred to in subsection (2) must be done, by a period\nnot exceeding 28 days, if:\n\n(a) the *responsible authority applies for the order before the end\nof the period (including that period as previously extended);\nand\n\n(b) the court is satisfied that it is appropriate to do so.\n\n(2B) The period referred to in subsection (2) may be extended more than\nonce."
    },
    {
