    },
    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Subsection 45A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf, p.8",
      "values:originalText": "Repeal the subsection, substitute:\nRestraining orders made before application for unexplained wealth\norder\n\n(1) A *restraining order made under section 20A ceases to be in force\nif:\n\n(a) no application for an *unexplained wealth order had been\nmade in relation to the *suspect to whom the restraining order\nrelates before the restraining order was made; and\n\n(b) no such application has been made in relation to the suspect\nwithin 28 days after the restraining order was made.",
      "skos:definition": "Repeal the subsection, substitute:\nRestraining orders made before application for unexplained wealth\norder\n\n(1) A *restraining order made under section 20A ceases to be in force\nif:\n\n(a) no application for an *unexplained wealth order had been\nmade in relation to the *suspect to whom the restraining order\nrelates before the restraining order was made; and\n\n(b) no such application has been made in relation to the suspect\nwithin 28 days after the restraining order was made.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-8-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d27ee7e476dc8604ba99005f03f2f6f6295a1e96b31046ec770c73fdc23645a8",
      "skos:note": "Ceases restraining order if no application for unexplained wealth order is made within 28 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Subsection 45A(1)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the subsection, substitute:\nRestraining orders made before application for unexplained wealth\norder\n\n(1) A *restraining order made under section 20A ceases to be in force\nif:\n\n(a) no application for an *unexplained wealth order had been\nmade in relation to the *suspect to whom the restraining order\nrelates before the restraining order was made; and\n\n(b) no such application has been made in relation to the suspect\nwithin 28 days after the restraining order was made."
    },
    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-8-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-8"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Cease",
      "cml:logicSummary": "Restraining order ceases to be in force.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No application for unexplained wealth order is made within 28 days."
    },
    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Paragraph 45A(2)(c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf, p.8",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) the court refuses to make either:\n\n(i) a *preliminary unexplained wealth order in connection\nwith the application for the unexplained wealth order; or\n\n(ii) the unexplained wealth order itself; and",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(c) the court refuses to make either:\n\n(i) a *preliminary unexplained wealth order in connection\nwith the application for the unexplained wealth order; or\n\n(ii) the unexplained wealth order itself; and",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-9-norm"
        },
        {
