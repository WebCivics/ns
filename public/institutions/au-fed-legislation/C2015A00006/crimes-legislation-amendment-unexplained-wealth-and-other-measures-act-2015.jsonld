    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Subsection 266A(2) (after table item 2A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf, p.16",
      "values:originalText": "Insert:\n2B\nAuthority of a State, or a\n*self-governing Territory, that has a\nfunction under a *corresponding law\nof the State or Territory\nAny one or more of the following\npurposes:\n(a) engaging in proceedings under\nthat *corresponding law;\n(b) engaging in proceedings for the\nforfeiture of things under a law\nof that State or Territory;\n(c) deciding whether to institute\nComLaw Authoritative Act C2015A00006\n\nUnexplained wealth  Schedule 1\n\nNo. 6, 2015\nCrimes Legislation Amendment (Unexplained Wealth and Other\nMeasures) Act 2015\n\nproceedings of a kind referred to\nin paragraph (a) or (b)\n2C\nAuthority of a foreign country that\nhas one or more of the following\nfunctions:\n(a) investigating or prosecuting\noffences against a law of the\ncountry;\n(b) identifying, locating, tracing,\ninvestigating or confiscating\n*proceeds or *instruments of\ncrime under a law of the country\nAssisting in identification, location,\ntracing, investigation or confiscation\nof *proceeds or *instruments of\ncrime, if the identification, location,\ntracing, investigation or confiscation\ncould take place under this Act, or\nunder a *corresponding law of a\nState or a *self-governing Territory,\nif the proceeds or instruments\nrelated to an offence against a law of\nthe Commonwealth, State or\nTerritory",
      "skos:definition": "Insert:\n2B\nAuthority of a State, or a\n*self-governing Territory, that has a\nfunction under a *corresponding law\nof the State or Territory\nAny one or more of the following\npurposes:\n(a) engaging in proceedings under\nthat *corresponding law;\n(b) engaging in proceedings for the\nforfeiture of things under a law\nof that State or Territory;\n(c) deciding whether to institute\nComLaw Authoritative Act C2015A00006\n\nUnexplained wealth  Schedule 1\n\nNo. 6, 2015\nCrimes Legislation Amendment (Unexplained Wealth and Other\nMeasures) Act 2015\n\nproceedings of a kind referred to\nin paragraph (a) or (b)\n2C\nAuthority of a foreign country that\nhas one or more of the following\nfunctions:\n(a) investigating or prosecuting\noffences against a law of the\ncountry;\n(b) identifying, locating, tracing,\ninvestigating or confiscating\n*proceeds or *instruments of\ncrime under a law of the country\nAssisting in identification, location,\ntracing, investigation or confiscation\nof *proceeds or *instruments of\ncrime, if the identification, location,\ntracing, investigation or confiscation\ncould take place under this Act, or\nunder a *corresponding law of a\nState or a *self-governing Territory,\nif the proceeds or instruments\nrelated to an offence against a law of\nthe Commonwealth, State or\nTerritory",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-31-norm"
        },
