    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Paragraph 179N(2)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf, p.12",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) provide to the person a copy of the application for the\nunexplained wealth order, and a copy of:\n\n(i) the affidavit referred to in subsection 179B(2); or\n\n(ii) if, because of subsection 179B(1A), there is no such\naffidavit—the affidavit referred to in\nparagraph 179B(1B)(a).",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) provide to the person a copy of the application for the\nunexplained wealth order, and a copy of:\n\n(i) the affidavit referred to in subsection 179B(2); or\n\n(ii) if, because of subsection 179B(1A), there is no such\naffidavit—the affidavit referred to in\nparagraph 179B(1B)(a).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-21-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-21-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a158b32ed1a489e6682fea74f5315c85a1c23c9dfe6ad521d3762ee2d85433d8",
      "skos:note": "Provide copies of application and affidavit to person",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Paragraph 179N(2)(b)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) provide to the person a copy of the application for the\nunexplained wealth order, and a copy of:\n\n(i) the affidavit referred to in subsection 179B(2); or\n\n(ii) if, because of subsection 179B(1A), there is no such\naffidavit—the affidavit referred to in\nparagraph 179B(1B)(a)."
    },
    {
