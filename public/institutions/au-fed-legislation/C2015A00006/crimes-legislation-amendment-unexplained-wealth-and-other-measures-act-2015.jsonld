      "skos:prefLabel": "179SA(3) Charge on property subject to restraining order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-179sa-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
