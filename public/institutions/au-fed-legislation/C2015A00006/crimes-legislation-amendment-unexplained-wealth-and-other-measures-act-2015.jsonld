    },
    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "179SA(4) Charge on property subject to restraining order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-179sa-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf, p.13",
      "values:originalText": "(4) Subsection 73(2) of the Personal Property Securities Act 2009\napplies to the charge (to the extent, if any, to which that Act\napplies in relation to the property charged).\nNote:\nThe effect of this subsection is that the priority between the charge\nand a security interest in the property to which the Personal Property\nSecurities Act 2009 applies is to be determined in accordance with this\nAct rather than the Personal Property Securities Act 2009.",
      "skos:definition": "(4) Subsection 73(2) of the Personal Property Securities Act 2009\napplies to the charge (to the extent, if any, to which that Act\napplies in relation to the property charged).\nNote:\nThe effect of this subsection is that the priority between the charge\nand a security interest in the property to which the Personal Property\nSecurities Act 2009 applies is to be determined in accordance with this\nAct rather than the Personal Property Securities Act 2009.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa-ss-4-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa-ss-4-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa-ss-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa-ss-4-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa-ss-4-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "abef81c3efd582d7f37312f0b9918672e16f8db5d55e86c4a97be2bd3155b195",
      "skos:note": "Priority between charge and security interest determined by this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-179sa-ss-4",
      "@type": "cof:Section",
      "cof:title": "179SA(4) Charge on property subject to restraining order",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(4) Subsection 73(2) of the Personal Property Securities Act 2009\napplies to the charge (to the extent, if any, to which that Act\napplies in relation to the property charged).\nNote:\nThe effect of this subsection is that the priority between the charge\nand a security interest in the property to which the Personal Property\nSecurities Act 2009 applies is to be determined in accordance with this\nAct rather than the Personal Property Securities Act 2009."
    },
    {
