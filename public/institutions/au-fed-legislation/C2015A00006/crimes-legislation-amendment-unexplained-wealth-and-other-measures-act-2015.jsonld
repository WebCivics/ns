    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Subsection 179S(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015.pdf, p.12",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The court may, on application by the *responsible authority, make\na *restraining order under section 20A in respect of the property as\nif:\n\n(a) the property were the *person’s property; and\nComLaw Authoritative Act C2015A00006\n\nUnexplained wealth  Schedule 1\n\nNo. 6, 2015\nCrimes Legislation Amendment (Unexplained Wealth and Other\nMeasures) Act 2015\n\n(b) the requirements in paragraphs 20A(1)(c) to (g) were\nsatisfied.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) The court may, on application by the *responsible authority, make\na *restraining order under section 20A in respect of the property as\nif:\n\n(a) the property were the *person’s property; and\nComLaw Authoritative Act C2015A00006\n\nUnexplained wealth  Schedule 1\n\nNo. 6, 2015\nCrimes Legislation Amendment (Unexplained Wealth and Other\nMeasures) Act 2015\n\n(b) the requirements in paragraphs 20A(1)(c) to (g) were\nsatisfied.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-23-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "54cb39d968a77c3ea3c7ca5351e4e50a9553457c6cb023fb4dc5ebbb54d1fcf9",
      "skos:note": "The court may make a restraining order under section 20A in respect of the property if certain requirements are satisfied."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015#sch-1-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Subsection 179S(3)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The court may, on application by the *responsible authority, make\na *restraining order under section 20A in respect of the property as\nif:\n\n(a) the property were the *person’s property; and\nComLaw Authoritative Act C2015A00006\n\nUnexplained wealth  Schedule 1\n\nNo. 6, 2015\nCrimes Legislation Amendment (Unexplained Wealth and Other\nMeasures) Act 2015\n\n(b) the requirements in paragraphs 20A(1)(c) to (g) were\nsatisfied."
    },
