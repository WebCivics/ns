      },
      "cml:operator": "priority",
      "cml:logicSummary": "Determines priority between charge and security interest.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) Subsection 73(2) of the Personal Property Securities Act 2009 applies to the charge (to the extent, if any, to which that Act applies in relation to the property charged).",
      "cml:conclusionText": "Priority is determined by this Act."
    },
    {
      "@id": "concept:crimes-legislation-amendment-unexplained-wealth-and-other-measures-act-2015-sch-1-sec-179sa-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
