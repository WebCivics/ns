    skos:prefLabel "1 Section 2A"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Omit: The second is citizenship for persons adopted in accordance with the Hague Convention on Intercountry Adoption: see Subdivision AA. substitute: The second is citizenship for persons adopted in accordance with the Hague Convention on Intercountry Adoption or a bilateral arrangement: see Subdivision AA." ;
