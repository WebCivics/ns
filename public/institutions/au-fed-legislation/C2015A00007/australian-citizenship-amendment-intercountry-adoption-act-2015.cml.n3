concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-3 a cml:Concept ;
    skos:prefLabel "3 Section 19B"@en ;
    cml:realizedBy doc:sch-1-sec-3 ;
    values:originalText "Omit: You may be eligible to become an Australian citizen under this Subdivision if you are adopted outside Australia in accordance with the Hague Convention on Intercountry Adoption by at least 1 Australian citizen. substitute: You may be eligible to become an Australian citizen under this Subdivision if you are adopted outside Australia by at least one Australian citizen in accordance with: ComLaw Authoritative Act C2015A00007  Schedule 1  Amendments  Australian Citizenship Amendment (Intercountry Adoption) Act 2015 No. 7, 2015  (a) the Hague Convention on Intercountry Adoption; or  (b) a bilateral arrangement." ;
    skos:definition "Omit: You may be eligible to become an Australian citizen under this Subdivision if you are adopted outside Australia in accordance with the Hague Convention on Intercountry Adoption by at least 1 Australian citizen. substitute: You may be eligible to become an Australian citizen under this Subdivision if you are adopted outside Australia by at least one Australian citizen in accordance with: ComLaw Authoritative Act C2015A00007  Schedule 1  Amendments  Australian Citizenship Amendment (Intercountry Adoption) Act 2015 No. 7, 2015  (a) the Hague Convention on Intercountry Adoption; or  (b) a bilateral arrangement."@en ;
    cml:integrityHash "780640100856c63217f48cf41c0559004028e6487f797d7a7bbec785b637da3d" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Eligibility for Australian citizenship under Subdivision if adopted outside Australia by at least one Australian citizen in accordance with the Hague Convention on Intercountry Adoption or a bilateral arrangement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
