    {
      "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 2A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf, p.7",
      "values:originalText": "Omit:\nThe second is citizenship for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption: see Subdivision\nAA.\nsubstitute:\nThe second is citizenship for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption or a bilateral\narrangement: see Subdivision AA.",
      "skos:definition": "Omit:\nThe second is citizenship for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption: see Subdivision\nAA.\nsubstitute:\nThe second is citizenship for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption or a bilateral\narrangement: see Subdivision AA.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d4c46537cfb299d3b7805990ae654ce34d7a983699f7b21c15913cdf114b28ad",
      "skos:note": "Citizenship for persons adopted in accordance with the Hague Convention on Intercountry Adoption is omitted."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Section 2A",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit:\nThe second is citizenship for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption: see Subdivision\nAA.\nsubstitute:\nThe second is citizenship for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption or a bilateral\narrangement: see Subdivision AA."
    },
