      "dc:source": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf, p.8",
      "values:originalText": "After “Convention country”, insert “or a prescribed overseas\njurisdiction”.",
      "skos:definition": "After “Convention country”, insert “or a prescribed overseas\njurisdiction”.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-4-norm"
