    {
      "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf, p.9",
      "values:originalText": "The amendments made by this Schedule apply in relation to an\napplication made under section 19C of the Australian Citizenship Act\n2007 on or after the day this item commences by a person adopted\noutside Australia by an Australian citizen in accordance with a bilateral\narrangement, even if the adoption occurred before that day.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 May 2014\nSenate on 25 September 2014]\n\n(108/14)\nComLaw Authoritative Act C2015A00007",
      "skos:definition": "The amendments made by this Schedule apply in relation to an\napplication made under section 19C of the Australian Citizenship Act\n2007 on or after the day this item commences by a person adopted\noutside Australia by an Australian citizen in accordance with a bilateral\narrangement, even if the adoption occurred before that day.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 May 2014\nSenate on 25 September 2014]\n\n(108/14)\nComLaw Authoritative Act C2015A00007",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-9-norm"
        }
      ],
      "cml:integrityHash": "5718b925e6514e3e362d76641e57cfe534d9ea13088cd6fe86ca5dbf0573aab6",
      "skos:note": "Application of amendments made by this Schedule"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Application",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "The amendments made by this Schedule apply in relation to an\napplication made under section 19C of the Australian Citizenship Act\n2007 on or after the day this item commences by a person adopted\noutside Australia by an Australian citizen in accordance with a bilateral\narrangement, even if the adoption occurred before that day.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 May 2014\nSenate on 25 September 2014]\n\n(108/14)\nComLaw Authoritative Act C2015A00007"
    },
