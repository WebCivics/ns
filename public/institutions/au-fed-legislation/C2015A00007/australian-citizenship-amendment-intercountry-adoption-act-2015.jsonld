    {
      "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subdivision AA of Division 2 of Part 2 (heading)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf, p.7",
      "values:originalText": "Repeal the heading, substitute:\nSubdivision AA—Citizenship for persons adopted in\naccordance with the Hague Convention on\nIntercountry Adoption or a bilateral arrangement",
      "skos:definition": "Repeal the heading, substitute:\nSubdivision AA—Citizenship for persons adopted in\naccordance with the Hague Convention on\nIntercountry Adoption or a bilateral arrangement",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-2-norm"
        }
      ],
      "cml:integrityHash": "12f3b8d834f57843173d5b10f3db37ae478dd77daa15edcdcc7b20a7b78f32dd",
      "skos:note": "Repeal and substitute a heading."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subdivision AA of Division 2 of Part 2 (heading)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the heading, substitute:\nSubdivision AA—Citizenship for persons adopted in\naccordance with the Hague Convention on\nIntercountry Adoption or a bilateral arrangement"
    },
    {
      "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-2-norm",
      "@type": "values:Obligation",
