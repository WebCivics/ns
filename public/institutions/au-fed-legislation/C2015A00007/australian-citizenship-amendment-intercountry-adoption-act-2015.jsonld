      "dc:source": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf, p.8",
      "values:originalText": "Repeal the heading, substitute:\nComLaw Authoritative Act C2015A00007\n\nAmendments  Schedule 1\n\nNo. 7, 2015\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015\n\nCitizenship by descent or for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption or a bilateral\narrangement",
      "skos:definition": "Repeal the heading, substitute:\nComLaw Authoritative Act C2015A00007\n\nAmendments  Schedule 1\n\nNo. 7, 2015\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015\n\nCitizenship by descent or for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption or a bilateral\narrangement",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-8-norm"
        }
      ],
      "cml:integrityHash": "e2638349633d6cfcc753ddea3cd9ede046bbc787e116695759a88599124735be",
      "skos:note": "Repeal heading and substitute with new title."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Subsection 34(1) (heading)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the heading, substitute:\nComLaw Authoritative Act C2015A00007\n\nAmendments  Schedule 1\n\nNo. 7, 2015\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015\n\nCitizenship by descent or for persons adopted in accordance with\nthe Hague Convention on Intercountry Adoption or a bilateral\narrangement"
    },
