      "dc:source": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2015A00007\n\nAmendments  Schedule 1\n\nNo. 7, 2015\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2015A00007\n\nAmendments  Schedule 1\n\nNo. 7, 2015\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sec-3-norm"
        }
      ],
      "cml:integrityHash": "babc6ac2f6dffe554f5fc2cf66cee486415100033a9e8e7f9ac2cceda80bc1cf",
      "skos:note": "Schedules amendment and repeal provisions for Acts specified in them."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2015A00007\n\nAmendments  Schedule 1\n\nNo. 7, 2015\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015"
    },
