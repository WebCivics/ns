    },
    {
      "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Section 19B",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-intercountry-adoption-act-2015.pdf, p.7",
      "values:originalText": "Omit:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia in accordance\nwith the Hague Convention on Intercountry Adoption by at least 1\nAustralian citizen.\nsubstitute:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia by at least one\nAustralian citizen in accordance with:\nComLaw Authoritative Act C2015A00007\n\nSchedule 1  Amendments\n\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015\nNo. 7, 2015\n\n(a)\nthe Hague Convention on Intercountry Adoption; or\n\n(b)\na bilateral arrangement.",
      "skos:definition": "Omit:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia in accordance\nwith the Hague Convention on Intercountry Adoption by at least 1\nAustralian citizen.\nsubstitute:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia by at least one\nAustralian citizen in accordance with:\nComLaw Authoritative Act C2015A00007\n\nSchedule 1  Amendments\n\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015\nNo. 7, 2015\n\n(a)\nthe Hague Convention on Intercountry Adoption; or\n\n(b)\na bilateral arrangement.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-3-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-intercountry-adoption-act-2015-sch-1-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "780640100856c63217f48cf41c0559004028e6487f797d7a7bbec785b637da3d",
      "skos:note": "Eligibility for Australian citizenship under Subdivision if adopted outside Australia by at least one Australian citizen in accordance with the Hague Convention on Intercountry Adoption or a bilateral arrangement."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-intercountry-adoption-act-2015#sch-1-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Section 19B",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia in accordance\nwith the Hague Convention on Intercountry Adoption by at least 1\nAustralian citizen.\nsubstitute:\nYou may be eligible to become an Australian citizen under this\nSubdivision if you are adopted outside Australia by at least one\nAustralian citizen in accordance with:\nComLaw Authoritative Act C2015A00007\n\nSchedule 1  Amendments\n\nAustralian Citizenship Amendment (Intercountry Adoption) Act 2015\nNo. 7, 2015\n\n(a)\nthe Hague Convention on Intercountry Adoption; or\n\n(b)\na bilateral arrangement."
    },
