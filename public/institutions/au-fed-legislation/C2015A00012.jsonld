        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes an obligation on individuals to not import a substance with an express or implied representation.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person imports a substance; and  (b) at the time of the importation, the presentation of the substance includes an express or implied representation that the substance is a serious drug alternative."
    },
