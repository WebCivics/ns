      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The application of section 5 is spread to all goods seized on suspicion of being a prohibited psychoactive substance.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
