    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(a) the person exports a thing, or enters a thing for export from Australia;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The prohibition applies during the act of exporting.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person exports a thing, or enters a thing for export from Australia; and  (b) the thing is a firearm or firearm part; and  (c) the person exports, or enters for export, the firearm or part with the intention of trafficking in the firearm or part; and  (d) exporting the firearm or part was prohibited under the Customs Act 1901 absolutely."
    },
    {
