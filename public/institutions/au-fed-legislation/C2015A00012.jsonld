    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The application of section 5 is restricted to goods seized before a certain point in time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal interval during which section 5 does not apply to goods seized on suspicion of being a prohibited psychoactive substance.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "Section 5 does not apply to goods seized on suspicion of being a prohibited psychoactive substance after a certain point in time."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-5-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The application of section 5 is represented as exempt in relation to such goods.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Represents the knowledge that section 5 does not apply to goods seized on suspicion of being a prohibited psychoactive substance.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge Representation",
      "cml:premiseText": "The knowledge is represented that section 5 does not apply to goods seized on suspicion of being a prohibited psychoactive substance."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The application of section 5 is prohibited in relation to such goods.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes prohibition on the application of section 5 to goods suspected of being prohibited psychoactive substances.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "Section 5 does not apply to goods seized on suspicion of being a prohibited psychoactive substance."
    },
