      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(d) importing the firearm or part was prohibited under the Customs Act 1901 absolutely.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
