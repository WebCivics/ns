      "skos:note": "Exporting a firearm or part with the intention of trafficking is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "361(1) Section 361"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf",
