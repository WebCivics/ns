      "realizedBy": "doc:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-361-3-ss-4",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3"
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Penalty: Imprisonment for 10 years or a fine of 2,500 penalty units, or both.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits entering a firearm or part for export with the intention of trafficking.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(4) A person commits an offence if:  (a) the person enters a thing for export from Australia; and  (b) the thing is a firearm or firearm part; and  (c) the person enters the firearm or part for export with the intention of trafficking in the firearm or part; and  (d) entering the firearm or part for export was prohibited under the Customs Act 1901 unless certain requirements were met; and  (e) the person fails to meet any of those requirements."
    },
