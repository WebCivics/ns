      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.11",
      "skos:note": "Importation of a substance with an express or implied representation that it is a serious drug alternative is prohibited.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "320(1) Section 320"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf",
      "asserts": [
