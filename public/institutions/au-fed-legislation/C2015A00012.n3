    cml:modality cml:Deontic ;
    cml:operator "Obligation" ;
    cml:logicSummary "Imposes a duty on the prosecution to prove recklessness in certain circumstances." ;
    cml:premiseText "(4) In a prosecution for an offence under subsection (1), it is not necessary to prove that the defendant was reckless as to..." ;
    cml:conclusionText "...the particular identity of the substance; or ... whether the substance had a particular psychoactive effect." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
