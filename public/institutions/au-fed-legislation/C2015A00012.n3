concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits exporting a firearm or part with the intention of trafficking." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person exports a thing, or enters a thing for export from Australia; and  (b) the thing is a firearm or firearm part; and  (c) the person exports, or enters for export, the firearm or part with the intention of trafficking in the firearm or part; and  (d) exporting the firearm or part was prohibited under the Customs Act 1901 absolutely." ;
    cml:conclusionText "Exporting a firearm or part with the intention of trafficking is prohibited." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

