    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits importing a psychoactive substance." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person imports a substance; and  (b) the substance is a psychoactive substance." ;
    cml:conclusionText "Imprisonment for 5 years, or 300 penalty units, or both." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

