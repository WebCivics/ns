    cml:asserts concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-4-norm .
concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-4-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-4 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-4 cml:asserts concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-4-logic-deontic-1 .
concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3-ss-4-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits entering a firearm or part for export with the intention of trafficking." ;
    cml:premiseText "(4) A person commits an offence if:  (a) the person enters a thing for export from Australia; and  (b) the thing is a firearm or firearm part; and  (c) the person enters the firearm or part for export with the intention of trafficking in the firearm or part; and  (d) entering the firearm or part for export was prohibited under the Customs Act 1901 unless certain requirements were met; and  (e) the person fails to meet any of those requirements." ;
    cml:conclusionText "Penalty: Imprisonment for 10 years or a fine of 2,500 penalty units, or both." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


