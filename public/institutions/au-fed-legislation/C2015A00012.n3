    values:partOf concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3 ;
    skos:note "Importation of a substance with an express or implied representation that it is a serious drug alternative is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
