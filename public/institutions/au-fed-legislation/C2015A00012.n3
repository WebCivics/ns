concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3-ss-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
