    cml:integrityHash "03b5870a2baf32e45b5ca63dd3a98291edde5726b22b6c0437881e47996e0981" ;
    values:partOf concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-3 ;
    skos:note "Entering a firearm or part for export with the intention of trafficking is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf> ;
