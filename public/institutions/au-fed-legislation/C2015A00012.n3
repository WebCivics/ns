concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-2-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits importing a firearm or part with intent to traffic." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person imports a thing; and  (b) the thing is a firearm or firearm part; and  (c) the person imports the firearm or part with the intention of trafficking in the firearm or part; and  (d) importing the firearm or part was prohibited under the Customs Act 1901 absolutely." ;
    cml:conclusionText "(d) importing the firearm or part was prohibited under the Customs Act 1901 absolutely." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

