concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3-ss-1 cml:asserts concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3-ss-1-logic-deontic-1 .
concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibition" ;
    cml:logicSummary "Prohibits importation of a substance with an express or implied representation." ;
    cml:premiseText "(1) A person commits an offence if:  (a) the person imports a substance; and  (b) at the time of the importation, the presentation of the substance includes an express or implied representation that the substance is a serious drug alternative." ;
    cml:conclusionText "Penalty: Imprisonment for 2 years, or 120 penalty units, or both." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3-ss-1 cml:asserts concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3-ss-1-logic-descriptionlogic-2 .
