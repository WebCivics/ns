<https://ns.webcivics.net/concept/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-2-ss-1-logic-deontic-1> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits importing a firearm or part with intent to traffic.";
    <https://ns.webcivics.net/cml/premiseText> "(1) A person commits an offence if:  (a) the person imports a thing; and  (b) the thing is a firearm or firearm part; and  (c) the person imports the firearm or part with the intention of trafficking in the firearm or part; and  (d) importing the firearm or part was prohibited under the Customs Act 1901 absolutely.";
    <https://ns.webcivics.net/cml/conclusionText> "(d) importing the firearm or part was prohibited under the Customs Act 1901 absolutely.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
