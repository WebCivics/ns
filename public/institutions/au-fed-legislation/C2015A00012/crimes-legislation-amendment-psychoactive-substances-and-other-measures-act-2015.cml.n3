concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-4 a cml:Concept ;
    skos:prefLabel "205EA(4) Treatment of goods seized if a claim for return is made—"@en ;
    cml:realizedBy doc:sch-1-sec-205ea-ss-4 ;
    values:originalText "(4) The goods are condemned as forfeited to the Crown if:  (a) the claimant does not institute proceedings of a kind referred to in paragraph (2)(b) within the period of 30 days after receiving the notice under that paragraph (or within that period as extended, or further extended, under section 205EB); or  (b) the claimant institutes such proceedings within that period (or within that period as extended or further extended), and at the end of the proceedings there is not: ComLaw Authoritative Act C2015A00012  Schedule 1  Psychoactive substances  Crimes Legislation Amendment (Psychoactive Substances and Other Measures) Act 2015 No. 12, 2015  (i) an order for the claimant to recover the goods; or  (ii) an order for the Commonwealth to pay the claimant the market value of the goods at the time they were disposed of or destroyed, if they have been disposed of or destroyed before the end of the proceedings; or  (iii) a declaration that the goods are not forfeited." ;
    skos:definition "(4) The goods are condemned as forfeited to the Crown if:  (a) the claimant does not institute proceedings of a kind referred to in paragraph (2)(b) within the period of 30 days after receiving the notice under that paragraph (or within that period as extended, or further extended, under section 205EB); or  (b) the claimant institutes such proceedings within that period (or within that period as extended or further extended), and at the end of the proceedings there is not: ComLaw Authoritative Act C2015A00012  Schedule 1  Psychoactive substances  Crimes Legislation Amendment (Psychoactive Substances and Other Measures) Act 2015 No. 12, 2015  (i) an order for the claimant to recover the goods; or  (ii) an order for the Commonwealth to pay the claimant the market value of the goods at the time they were disposed of or destroyed, if they have been disposed of or destroyed before the end of the proceedings; or  (iii) a declaration that the goods are not forfeited."@en ;
    cml:integrityHash "5caf1fe60622163aeee095be7028d6bf52fd65c9c4afd9cc5e2e72abdc328d90" ;
    values:partOf concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Goods are condemned as forfeited to the Crown if certain conditions are not met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
