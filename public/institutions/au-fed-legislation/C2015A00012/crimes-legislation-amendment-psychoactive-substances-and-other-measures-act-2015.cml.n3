doc:sch-1-sec-205ea-ss-2 a cof:Section ;
    cof:title "205EA(2) Treatment of goods seized if a claim for return is made—" ;
    values:kind "subsection" ;
    values:originalText "(2) The authorised person who seized the goods must, subject to any law of the Commonwealth, a State or a Territory permitting their retention, destruction or disposal, return the goods unless:  (a) the goods have been dealt with under section 206; or  (b) not later than 30 days after the day the claim is made, the CEO gives the claimant a written notice stating that the goods will be condemned as forfeited if the claimant does not, within 30 days after receiving the notice, institute proceedings against the Commonwealth:  (i) to recover the goods; or  (ii) for a declaration that the goods are not forfeited." ;
    cof:pageNumber "15"^^xsd:integer .

concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-3 a cml:Concept ;
    skos:prefLabel "205EA(3) Treatment of goods seized if a claim for return is made—"@en ;
    cml:realizedBy doc:sch-1-sec-205ea-ss-3 ;
    values:originalText "(3) A notice under paragraph (2)(b):  (a) must be served personally or by post; and  (b) may be served on a person who is outside Australia." ;
    skos:definition "(3) A notice under paragraph (2)(b):  (a) must be served personally or by post; and  (b) may be served on a person who is outside Australia."@en ;
    cml:integrityHash "53717940b4fa8bf60e7e77d42c038843d64000cf9f18b08d5f00eac74621f307" ;
    values:partOf concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Notice may be served on a person outside Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf> ;
