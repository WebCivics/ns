concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-6 a cml:Concept ;
    skos:prefLabel "205EA(6) Treatment of goods seized if a claim for return is made—"@en ;
    cml:realizedBy doc:sch-1-sec-205ea-ss-6 ;
    values:originalText "(6) For the purposes of this section, the return of goods requires their return to the person reasonably believed to be the owner of the goods in a condition as near as practicable to the condition in which they were seized." ;
    skos:definition "(6) For the purposes of this section, the return of goods requires their return to the person reasonably believed to be the owner of the goods in a condition as near as practicable to the condition in which they were seized."@en ;
    cml:integrityHash "4e9a95abaabb62110bbae4cf4c4ea3c9f3d51aafb458764a73b798ecd0f1a1b5" ;
    values:partOf concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Goods must be returned to the person reasonably believed to be their owner in a condition as near as practicable to when they were seized." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
