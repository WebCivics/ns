concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-2 a cml:Concept ;
    skos:prefLabel "2 Subsection 4(1) (definition of sentence of imprisonment)"@en ;
    cml:realizedBy doc:sch-3-sec-2 ;
    values:originalText "Repeal the definition, substitute: sentence of imprisonment means any punishment or measure involving:  (a) deprivation of liberty; or  (b) potential deprivation of liberty, if the punishment or measure relates to a conviction for a non-Tribunal offence; ordered by a court or tribunal for a determinate or indeterminate period in the exercise of its criminal jurisdiction, and includes any direction or order given or made by the court or tribunal with respect to the commencement of the punishment or measure. Note: Paragraph (b) covers suspended sentences." ;
    skos:definition "Repeal the definition, substitute: sentence of imprisonment means any punishment or measure involving:  (a) deprivation of liberty; or  (b) potential deprivation of liberty, if the punishment or measure relates to a conviction for a non-Tribunal offence; ordered by a court or tribunal for a determinate or indeterminate period in the exercise of its criminal jurisdiction, and includes any direction or order given or made by the court or tribunal with respect to the commencement of the punishment or measure. Note: Paragraph (b) covers suspended sentences."@en ;
    cml:integrityHash "627e12d7cab17714cb709798a1bdec84935db7b7ce517f6d0e0547969ff8cefb" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Defines sentence of imprisonment" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf> ;
