    cml:hasPart concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-2-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
