concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-5-sec-1 a cml:Concept ;
    skos:prefLabel "1 Definitions"@en ;
    cml:realizedBy doc:sch-5-sec-1 ;
    values:originalText "In this Schedule: Commonwealth place has the same meaning as in the Commonwealth Places (Application of Laws) Act 1970. designated State airport has the same meaning as in the Commonwealth Places (Application of Laws) Act 1970. member of the Australian Federal Police has the same meaning as in the Australian Federal Police Act 1979. relevant Crimes Act provision has the same meaning as in the Commonwealth Places (Application of Laws) Act 1970. relevant period means the period:  (a) starting on 19 March 2014; and  (b) ending on 16 May 2014. special member has the same meaning as in the Australian Federal Police Act 1979." ;
    skos:definition "In this Schedule: Commonwealth place has the same meaning as in the Commonwealth Places (Application of Laws) Act 1970. designated State airport has the same meaning as in the Commonwealth Places (Application of Laws) Act 1970. member of the Australian Federal Police has the same meaning as in the Australian Federal Police Act 1979. relevant Crimes Act provision has the same meaning as in the Commonwealth Places (Application of Laws) Act 1970. relevant period means the period:  (a) starting on 19 March 2014; and  (b) ending on 16 May 2014. special member has the same meaning as in the Australian Federal Police Act 1979."@en ;
    cml:integrityHash "2fb8fcb7854291e7555ff5e2aded2c69c20df505d09a5e2be0eed32af95de263" ;
    cof:pageNumber "41"^^xsd:integer ;
    skos:note "Defines terms used in the Schedule." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
