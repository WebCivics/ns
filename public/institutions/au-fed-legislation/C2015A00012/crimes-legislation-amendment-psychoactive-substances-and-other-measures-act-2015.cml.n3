    cml:conclusionText "the court decides that, apart from the disposal or destruction, it would have ordered that the goods be returned to a person." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ec-ss-3 cml:asserts concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ec-ss-3-logic-diffusion-4 .
