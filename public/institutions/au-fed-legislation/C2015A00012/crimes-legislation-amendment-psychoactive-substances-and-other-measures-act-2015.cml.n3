concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-5 a cml:Concept ;
    skos:prefLabel "205EA(5) Treatment of goods seized if a claim for return is made—"@en ;
    cml:realizedBy doc:sch-1-sec-205ea-ss-5 ;
    values:originalText "(5) For the purposes of subsection (4), if the proceedings go to judgment, they end:  (a) at the end of the period for lodging an appeal against the judgment, if no appeal is lodged within that period; or  (b) when the appeal lapses or is finally determined, if an appeal is lodged against the judgment within that period." ;
    skos:definition "(5) For the purposes of subsection (4), if the proceedings go to judgment, they end:  (a) at the end of the period for lodging an appeal against the judgment, if no appeal is lodged within that period; or  (b) when the appeal lapses or is finally determined, if an appeal is lodged against the judgment within that period."@en ;
    cml:integrityHash "39ba0fd1b2cb91700d1696cfdf10586f9f37bcb8db0c6314c0a422ee29aad977" ;
    values:partOf concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "End of proceedings if appeal is lodged within the period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
