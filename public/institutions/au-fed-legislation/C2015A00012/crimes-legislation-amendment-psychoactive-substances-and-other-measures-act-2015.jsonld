    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361",
      "@type": "cml:Concept",
      "skos:prefLabel": "361 1  Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-361"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.21",
      "values:originalText": "In this Division:\nexport a thing, means export the thing from Australia.\nfirearm has the same meaning as in the Customs (Prohibited\nImports) Regulations 1956.\nfirearm part has the same meaning as in the Customs (Prohibited\nImports) Regulations 1956.\nimport a thing, means import the thing into Australia, and includes\ndeal with the thing in connection with its importation.\ntraffic in a thing that is a firearm or a firearm part means:\nComLaw Authoritative Act C2015A00012\n\nSchedule 2  Firearms trafficking offences\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\n(a) transfer the thing; or\n\n(b) offer the thing for sale; or\n\n(c) invite the making of offers to buy the thing; or\n\n(d) prepare the thing for transfer with the intention of\ntransferring any of it or believing that another person intends\nto transfer any of it; or\n\n(e) transport or deliver the thing with the intention of transferring\nany of it or believing that another person intends to transfer\nany of it; or\n\n(f) guard or conceal the thing with the intention of transferring\nany of it or the intention of assisting another person to\ntransfer any of it; or\n\n(g) possess the thing with the intention of transferring any of it.\nFor the purposes of paragraph (d), preparing a thing for transfer\nincludes packaging the thing or separating the thing into discrete\nunits.",
      "skos:definition": "In this Division:\nexport a thing, means export the thing from Australia.\nfirearm has the same meaning as in the Customs (Prohibited\nImports) Regulations 1956.\nfirearm part has the same meaning as in the Customs (Prohibited\nImports) Regulations 1956.\nimport a thing, means import the thing into Australia, and includes\ndeal with the thing in connection with its importation.\ntraffic in a thing that is a firearm or a firearm part means:\nComLaw Authoritative Act C2015A00012\n\nSchedule 2  Firearms trafficking offences\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\n(a) transfer the thing; or\n\n(b) offer the thing for sale; or\n\n(c) invite the making of offers to buy the thing; or\n\n(d) prepare the thing for transfer with the intention of\ntransferring any of it or believing that another person intends\nto transfer any of it; or\n\n(e) transport or deliver the thing with the intention of transferring\nany of it or believing that another person intends to transfer\nany of it; or\n\n(f) guard or conceal the thing with the intention of transferring\nany of it or the intention of assisting another person to\ntransfer any of it; or\n\n(g) possess the thing with the intention of transferring any of it.\nFor the purposes of paragraph (d), preparing a thing for transfer\nincludes packaging the thing or separating the thing into discrete\nunits.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-logic-deontic-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-logic-alleninterval-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-logic-deontic-5"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-logic-descriptionlogic-6"
        }
      ],
      "cml:integrityHash": "ad04791be270b6cbdf6263131876cc95438af5e10a6e7086f6209d6a156e4dd5",
      "skos:note": "Definitions for firearms trafficking offences"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-361",
      "@type": "cof:Section",
      "cof:title": "361 1  Definitions",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "In this Division:\nexport a thing, means export the thing from Australia.\nfirearm has the same meaning as in the Customs (Prohibited\nImports) Regulations 1956.\nfirearm part has the same meaning as in the Customs (Prohibited\nImports) Regulations 1956.\nimport a thing, means import the thing into Australia, and includes\ndeal with the thing in connection with its importation.\ntraffic in a thing that is a firearm or a firearm part means:\nComLaw Authoritative Act C2015A00012\n\nSchedule 2  Firearms trafficking offences\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\n(a) transfer the thing; or\n\n(b) offer the thing for sale; or\n\n(c) invite the making of offers to buy the thing; or\n\n(d) prepare the thing for transfer with the intention of\ntransferring any of it or believing that another person intends\nto transfer any of it; or\n\n(e) transport or deliver the thing with the intention of transferring\nany of it or believing that another person intends to transfer\nany of it; or\n\n(f) guard or conceal the thing with the intention of transferring\nany of it or the intention of assisting another person to\ntransfer any of it; or\n\n(g) possess the thing with the intention of transferring any of it.\nFor the purposes of paragraph (d), preparing a thing for transfer\nincludes packaging the thing or separating the thing into discrete\nunits."
    },
