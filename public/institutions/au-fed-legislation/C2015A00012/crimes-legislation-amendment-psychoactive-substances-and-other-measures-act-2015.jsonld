    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-17-2-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "17(2) Copies of applications to be given to State and Territory",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-17-2-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
