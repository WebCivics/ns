      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-34-ss-5",
      "@type": "cof:Section",
      "cof:title": "34(5) Subsection 20(3)",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(5) If the Attorney-General decides not to consent to the transfer on\nthose terms, the Attorney-General may state in the notice that\nconsent may be given if the transfer country agrees to a specified\nvariation of those terms."
    },
