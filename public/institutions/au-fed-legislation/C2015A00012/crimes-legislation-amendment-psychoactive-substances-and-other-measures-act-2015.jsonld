      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Imposes a prohibition on dealing with goods in a certain manner.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO or Regional Director may cause the goods to be dealt with in such manner as he or she considers appropriate.",
      "cml:conclusionText": "Goods must not be dealt with in any other manner."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
