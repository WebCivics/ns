    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Subsection 4(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.31",
      "values:originalText": "Insert:\nchild: without limiting who is a child of a person for the purposes\nof this Act, someone is the child of a person if he or she is a child\nof the person within the meaning of the Family Law Act 1975.\nclose family member: see section 4AA.\nde facto partner has the meaning given by the Acts Interpretation\nAct 1901.\nparent: without limiting who is a parent of a person for the\npurposes of this Act, someone is the parent of a person if the\nperson is his or her child because of the definition of child in this\nsubsection.",
      "skos:definition": "Insert:\nchild: without limiting who is a child of a person for the purposes\nof this Act, someone is the child of a person if he or she is a child\nof the person within the meaning of the Family Law Act 1975.\nclose family member: see section 4AA.\nde facto partner has the meaning given by the Acts Interpretation\nAct 1901.\nparent: without limiting who is a parent of a person for the\npurposes of this Act, someone is the parent of a person if the\nperson is his or her child because of the definition of child in this\nsubsection.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-15-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-15-logic-alleninterval-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-15-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "b45a3d32157b4a28c0cd765cff8ae28c003da33f8fe7f030ca62a9b02528e130",
      "skos:note": "Defines child, parent, and close family member for the purposes of this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Subsection 4(1)",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Insert:\nchild: without limiting who is a child of a person for the purposes\nof this Act, someone is the child of a person if he or she is a child\nof the person within the meaning of the Family Law Act 1975.\nclose family member: see section 4AA.\nde facto partner has the meaning given by the Acts Interpretation\nAct 1901.\nparent: without limiting who is a parent of a person for the\npurposes of this Act, someone is the parent of a person if the\nperson is his or her child because of the definition of child in this\nsubsection."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-15-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-15"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-15-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "within",
      "cml:logicSummary": "Temporal interval relation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The definition of child includes the meaning from the Family Law Act 1975",
      "cml:conclusionText": "This definition creates a temporal interval relation between the two acts"
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-15-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "prohibition",
      "cml:logicSummary": "Prohibits ambiguous definitions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The definition of child is clear and specific",
      "cml:conclusionText": "This definition prevents ambiguity in the application of this Act"
    },
