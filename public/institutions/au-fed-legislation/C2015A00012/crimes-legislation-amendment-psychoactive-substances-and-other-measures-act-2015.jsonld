      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.19",
      "values:originalText": "Insert:\nfirearm part means either of the following within the meaning of\nthe firearm law concerned:\n\n(a) a firearm part;\nComLaw Authoritative Act C2015A00012\n\nSchedule 2  Firearms trafficking offences\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\n(b) a part of, or for, a firearm or weapon.",
      "skos:definition": "Insert:\nfirearm part means either of the following within the meaning of\nthe firearm law concerned:\n\n(a) a firearm part;\nComLaw Authoritative Act C2015A00012\n\nSchedule 2  Firearms trafficking offences\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\n(b) a part of, or for, a firearm or weapon.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-8-norm"
        },
