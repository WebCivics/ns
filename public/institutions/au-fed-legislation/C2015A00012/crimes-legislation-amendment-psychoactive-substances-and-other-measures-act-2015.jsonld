    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Subsection 20(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.36",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The Attorney-General must decide whether to consent to the\ntransfer of the prisoner on the terms proposed by the transfer\ncountry.\n\n(4) The Attorney-General must notify the transfer country of his or her\ndecision under subsection (3).\n\n(5) If the Attorney-General decides not to consent to the transfer on\nthose terms, the Attorney-General may state in the notice that\nconsent may be given if the transfer country agrees to a specified\nvariation of those terms.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) The Attorney-General must decide whether to consent to the\ntransfer of the prisoner on the terms proposed by the transfer\ncountry.\n\n(4) The Attorney-General must notify the transfer country of his or her\ndecision under subsection (3).\n\n(5) If the Attorney-General decides not to consent to the transfer on\nthose terms, the Attorney-General may state in the notice that\nconsent may be given if the transfer country agrees to a specified\nvariation of those terms.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-34-ss-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-34-ss-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-34-ss-5"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Subsection 20(3)",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The Attorney-General must decide whether to consent to the\ntransfer of the prisoner on the terms proposed by the transfer\ncountry.\n\n(4) The Attorney-General must notify the transfer country of his or her\ndecision under subsection (3).\n\n(5) If the Attorney-General decides not to consent to the transfer on\nthose terms, the Attorney-General may state in the notice that\nconsent may be given if the transfer country agrees to a specified\nvariation of those terms."
    },
