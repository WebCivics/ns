      },
      "cml:premiseText": "A person was under a mistaken but reasonable belief"
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Interval",
      "cml:logicSummary": "Temporal interval of defence",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The conduct would not have constituted the offence if justified or excused"
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "361 6  Double jeopardy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-361-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.25",
      "values:originalText": "A person punished for an offence against this Division in respect of\nparticular conduct cannot be punished for an offence against\nsection 233BAB of the Customs Act 1901 in respect of that\nconduct.\nNote:\nA similar provision for the opposite case is set out in\nsubsection 233BAB(7) of the Customs Act 1901.\nCustoms Act 1901",
      "skos:definition": "A person punished for an offence against this Division in respect of\nparticular conduct cannot be punished for an offence against\nsection 233BAB of the Customs Act 1901 in respect of that\nconduct.\nNote:\nA similar provision for the opposite case is set out in\nsubsection 233BAB(7) of the Customs Act 1901.\nCustoms Act 1901",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-5-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f3688a9f4e204377dfe427dbafc3381718aae3b9a5d1bad3fdc5fa7c4c287d10",
      "skos:note": "Prohibition on double jeopardy for similar conduct"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-361-5",
      "@type": "cof:Section",
      "cof:title": "361 6  Double jeopardy",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "A person punished for an offence against this Division in respect of\nparticular conduct cannot be punished for an offence against\nsection 233BAB of the Customs Act 1901 in respect of that\nconduct.\nNote:\nA similar provision for the opposite case is set out in\nsubsection 233BAB(7) of the Customs Act 1901.\nCustoms Act 1901"
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-361-5-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
