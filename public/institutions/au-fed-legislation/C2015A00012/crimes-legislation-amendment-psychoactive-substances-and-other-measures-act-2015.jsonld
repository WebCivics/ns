      "skos:note": "Disclosure of information relating to a communication under section 43 or 45 for the purposes of, or in connection with, the performance of the entrusted investigating official’s duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-6-sec-1c",
      "@type": "cof:Section",
      "cof:title": "1C After paragraph 122(3)(g)",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "Insert:\n\n(ga) if the entrusted investigating official is the Commissioner of\nTaxation or a taxation officer—the disclosure is:\n\n(i) of information relating to a communication under\nsection 43 or 45; and\n\n(ii) for the purposes of, or in connection with, the\nperformance of the entrusted investigating official’s\nduties;"
    },
