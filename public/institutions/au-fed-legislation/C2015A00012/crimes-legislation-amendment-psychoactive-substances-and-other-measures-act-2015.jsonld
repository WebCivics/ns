      "skos:note": "Conditional commencement of provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Schedule 3",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provision(s) do not\ncommence within the period of 6 months\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period."
