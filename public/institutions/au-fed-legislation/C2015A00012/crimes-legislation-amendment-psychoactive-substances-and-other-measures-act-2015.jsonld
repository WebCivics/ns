    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-320-3-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "320(4) 3  Importing substances represented to be serious drug",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-1-sec-320-3-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
