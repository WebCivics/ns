      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.28",
      "values:originalText": "Omit “is a prisoner other than a prisoner who has been released on\nparole”, substitute “has not been released on parole and is not serving\nthe suspended part of the sentence of imprisonment”.",
      "skos:definition": "Omit “is a prisoner other than a prisoner who has been released on\nparole”, substitute “has not been released on parole and is not serving\nthe suspended part of the sentence of imprisonment”.",
      "cml:asserts": [
