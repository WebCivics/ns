    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 After subsection 206(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-1-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.17",
      "values:originalText": "Insert:\nProhibited psychoactive substances and prohibited serious drug\nalternatives\n\n(2A) If:\n\n(a) goods are seized under a seizure warrant or under\nsubsection 203B(2) or (2A), 203CA(3) or 203CB(2); and\nComLaw Authoritative Act C2015A00012\n\nSchedule 1  Psychoactive substances\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\n(b) the CEO or a Regional Director for a State or Territory is\nsatisfied that the goods are a prohibited psychoactive\nsubstance or a prohibited serious drug alternative;\nthe CEO or Regional Director concerned may cause the goods to\nbe dealt with in such manner as he or she considers appropriate\n(including the destruction of the goods).",
      "skos:definition": "Insert:\nProhibited psychoactive substances and prohibited serious drug\nalternatives\n\n(2A) If:\n\n(a) goods are seized under a seizure warrant or under\nsubsection 203B(2) or (2A), 203CA(3) or 203CB(2); and\nComLaw Authoritative Act C2015A00012\n\nSchedule 1  Psychoactive substances\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\n(b) the CEO or a Regional Director for a State or Territory is\nsatisfied that the goods are a prohibited psychoactive\nsubstance or a prohibited serious drug alternative;\nthe CEO or Regional Director concerned may cause the goods to\nbe dealt with in such manner as he or she considers appropriate\n(including the destruction of the goods).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-diffusion-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-argumentation-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "77bcb2c81a7366b15026b8bd08ffc2101c3d2138f48e9bf49fb56f0e9bc57e5a",
      "skos:note": "Goods must be dealt with in a manner considered appropriate by the CEO or Regional Director."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-1-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 After subsection 206(2)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Insert:\nProhibited psychoactive substances and prohibited serious drug\nalternatives\n\n(2A) If:\n\n(a) goods are seized under a seizure warrant or under\nsubsection 203B(2) or (2A), 203CA(3) or 203CB(2); and\nComLaw Authoritative Act C2015A00012\n\nSchedule 1  Psychoactive substances\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\n(b) the CEO or a Regional Director for a State or Territory is\nsatisfied that the goods are a prohibited psychoactive\nsubstance or a prohibited serious drug alternative;\nthe CEO or Regional Director concerned may cause the goods to\nbe dealt with in such manner as he or she considers appropriate\n(including the destruction of the goods)."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-norm",
      "@type": "values:Prohibition",
