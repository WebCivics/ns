    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Subsection 233BAB(7)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.25",
      "values:originalText": "Repeal the subsection, substitute:\n\n(7) A person punished for an offence against subsection (5) or (6) in\nrespect of particular conduct cannot be punished, in respect of that\nconduct, for an offence against:\n\n(a) section 233; or\n\n(b) Division 361 of the Criminal Code (about international\nfirearms trafficking).\nComLaw Authoritative Act C2015A00012\n\nSchedule 2  Firearms trafficking offences\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\nNote:\nA similar provision for the opposite case to paragraph (b) is set out in\nsection 361.6 of the Criminal Code.\nComLaw Authoritative Act C2015A00012\n\nInternational transfer of prisoners  Schedule 3\nSuspended sentences  Part 1\n\nNo. 12, 2015\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015",
      "skos:definition": "Repeal the subsection, substitute:\n\n(7) A person punished for an offence against subsection (5) or (6) in\nrespect of particular conduct cannot be punished, in respect of that\nconduct, for an offence against:\n\n(a) section 233; or\n\n(b) Division 361 of the Criminal Code (about international\nfirearms trafficking).\nComLaw Authoritative Act C2015A00012\n\nSchedule 2  Firearms trafficking offences\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\nNote:\nA similar provision for the opposite case to paragraph (b) is set out in\nsection 361.6 of the Criminal Code.\nComLaw Authoritative Act C2015A00012\n\nInternational transfer of prisoners  Schedule 3\nSuspended sentences  Part 1\n\nNo. 12, 2015\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-23-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "831bbf8307a2916bbbbaea6c728bac00dc300f34c50eb238d95db64a38ee010f",
      "skos:note": "Exempts punishment for certain conduct from other offences."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Subsection 233BAB(7)",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Repeal the subsection, substitute:\n\n(7) A person punished for an offence against subsection (5) or (6) in\nrespect of particular conduct cannot be punished, in respect of that\nconduct, for an offence against:\n\n(a) section 233; or\n\n(b) Division 361 of the Criminal Code (about international\nfirearms trafficking).\nComLaw Authoritative Act C2015A00012\n\nSchedule 2  Firearms trafficking offences\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015\n\nNote:\nA similar provision for the opposite case to paragraph (b) is set out in\nsection 361.6 of the Criminal Code.\nComLaw Authoritative Act C2015A00012\n\nInternational transfer of prisoners  Schedule 3\nSuspended sentences  Part 1\n\nNo. 12, 2015\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015"
    },
    {
