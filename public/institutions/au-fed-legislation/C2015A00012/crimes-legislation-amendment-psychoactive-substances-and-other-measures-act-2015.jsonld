      "cml:operator": "if-then",
      "cml:logicSummary": "If goods are disposed of or destroyed before proceedings end and would have been returned, then Commonwealth must pay person.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) If:...",
      "cml:conclusionText": "the court must order the Commonwealth to pay the person an amount equal to the market value of the goods at the time they were disposed of or destroyed."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ec-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "classify",
      "cml:logicSummary": "Classifies goods as subject to return if disposed of or destroyed before proceedings end and would have been returned.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) If:...",
      "cml:conclusionText": "the court decides that, apart from the disposal or destruction, it would have ordered that the goods be returned to a person."
    },
