    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "205EA(3) Treatment of goods seized if a claim for return is made—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-1-sec-205ea-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.15",
      "values:originalText": "(3) A notice under paragraph (2)(b):\n\n(a) must be served personally or by post; and\n\n(b) may be served on a person who is outside Australia.",
      "skos:definition": "(3) A notice under paragraph (2)(b):\n\n(a) must be served personally or by post; and\n\n(b) may be served on a person who is outside Australia.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-3-norm"
        }
      ],
      "cml:integrityHash": "53717940b4fa8bf60e7e77d42c038843d64000cf9f18b08d5f00eac74621f307",
      "skos:note": "Notice may be served on a person outside Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-1-sec-205ea-ss-3",
      "@type": "cof:Section",
      "cof:title": "205EA(3) Treatment of goods seized if a claim for return is made—",
      "values:kind": "subsection",
      "cof:pageNumber": 15,
      "values:originalText": "(3) A notice under paragraph (2)(b):\n\n(a) must be served personally or by post; and\n\n(b) may be served on a person who is outside Australia."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-3-norm",
