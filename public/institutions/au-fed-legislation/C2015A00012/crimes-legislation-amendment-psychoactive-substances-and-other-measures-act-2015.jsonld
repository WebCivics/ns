        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-16-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f34078e1cbf14cebfe0ffcc8c7c8359ebea0ed6af980c84f527139eb72fef0ac",
      "skos:note": "No law of a State or Territory can exclude or limit the concurrent operation of this Division."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-16-ss-2",
