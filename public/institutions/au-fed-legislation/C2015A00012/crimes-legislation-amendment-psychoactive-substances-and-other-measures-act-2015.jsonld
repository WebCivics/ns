    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-17-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Copies of applications to be given to State and Territory",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-17-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.35",
      "values:originalText": "Ministers\n\n(1) The Attorney-General must give:\n\n(a) a copy of an application given under section 16; and\n\n(b) any other information the Attorney-General considers\nrelevant;\nto any State Ministers and Territory Ministers whose consent is\nrequired for the transfer to have appropriate Ministerial consent.\n\n(2) Any of those State Ministers or Territory Ministers may:\n\n(a) advise the Attorney-General of any matters that Minister\nconsiders relevant to the processing of the application; and\n\n(b) request the Attorney-General to obtain information from the\ntransfer country that is relevant to that Minister’s assessment\nof the application.",
      "skos:definition": "Ministers\n\n(1) The Attorney-General must give:\n\n(a) a copy of an application given under section 16; and\n\n(b) any other information the Attorney-General considers\nrelevant;\nto any State Ministers and Territory Ministers whose consent is\nrequired for the transfer to have appropriate Ministerial consent.\n\n(2) Any of those State Ministers or Territory Ministers may:\n\n(a) advise the Attorney-General of any matters that Minister\nconsiders relevant to the processing of the application; and\n\n(b) request the Attorney-General to obtain information from the\ntransfer country that is relevant to that Minister’s assessment\nof the application.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-17-2-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-17-2-ss-2"
        }
      ],
      "cml:integrityHash": "eeb46d3dcaa189ca892f73ee371e79da1135c7767e724aa1b4228fd8013524a5"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-17-2",
      "@type": "cof:Section",
      "cof:title": "17 Copies of applications to be given to State and Territory",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "Ministers\n\n(1) The Attorney-General must give:\n\n(a) a copy of an application given under section 16; and\n\n(b) any other information the Attorney-General considers\nrelevant;\nto any State Ministers and Territory Ministers whose consent is\nrequired for the transfer to have appropriate Ministerial consent.\n\n(2) Any of those State Ministers or Territory Ministers may:\n\n(a) advise the Attorney-General of any matters that Minister\nconsiders relevant to the processing of the application; and\n\n(b) request the Attorney-General to obtain information from the\ntransfer country that is relevant to that Minister’s assessment\nof the application."
    },
