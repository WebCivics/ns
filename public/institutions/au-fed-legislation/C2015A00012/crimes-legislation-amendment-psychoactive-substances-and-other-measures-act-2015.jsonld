          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-6-sec-1e-norm"
        }
      ],
      "cml:integrityHash": "fd66507d252a3de0c603e2617a68707c70c11c98bd146a2bccb6019d950eab96",
      "skos:note": "Amendments apply to disclosures of information on or after commencement."
    },
