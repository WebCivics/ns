      "cml:integrityHash": "4e9a95abaabb62110bbae4cf4c4ea3c9f3d51aafb458764a73b798ecd0f1a1b5",
      "skos:note": "Goods must be returned to the person reasonably believed to be their owner in a condition as near as practicable to when they were seized."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-1-sec-205ea-ss-6",
      "@type": "cof:Section",
      "cof:title": "205EA(6) Treatment of goods seized if a claim for return is made—",
      "values:kind": "subsection",
      "cof:pageNumber": 15,
      "values:originalText": "(6) For the purposes of this section, the return of goods requires their\nreturn to the person reasonably believed to be the owner of the\ngoods in a condition as near as practicable to the condition in\nwhich they were seized."
    },
