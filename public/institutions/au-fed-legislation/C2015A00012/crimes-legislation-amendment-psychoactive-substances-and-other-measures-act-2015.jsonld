    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 4(1) (definition of sentence of imprisonment)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.27",
      "values:originalText": "Repeal the definition, substitute:\nsentence of imprisonment means any punishment or measure\ninvolving:\n\n(a) deprivation of liberty; or\n\n(b) potential deprivation of liberty, if the punishment or measure\nrelates to a conviction for a non-Tribunal offence;\nordered by a court or tribunal for a determinate or indeterminate\nperiod in the exercise of its criminal jurisdiction, and includes any\ndirection or order given or made by the court or tribunal with\nrespect to the commencement of the punishment or measure.\nNote:\nParagraph (b) covers suspended sentences.",
      "skos:definition": "Repeal the definition, substitute:\nsentence of imprisonment means any punishment or measure\ninvolving:\n\n(a) deprivation of liberty; or\n\n(b) potential deprivation of liberty, if the punishment or measure\nrelates to a conviction for a non-Tribunal offence;\nordered by a court or tribunal for a determinate or indeterminate\nperiod in the exercise of its criminal jurisdiction, and includes any\ndirection or order given or made by the court or tribunal with\nrespect to the commencement of the punishment or measure.\nNote:\nParagraph (b) covers suspended sentences.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "627e12d7cab17714cb709798a1bdec84935db7b7ce517f6d0e0547969ff8cefb",
      "skos:note": "Defines sentence of imprisonment"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsection 4(1) (definition of sentence of imprisonment)",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "Repeal the definition, substitute:\nsentence of imprisonment means any punishment or measure\ninvolving:\n\n(a) deprivation of liberty; or\n\n(b) potential deprivation of liberty, if the punishment or measure\nrelates to a conviction for a non-Tribunal offence;\nordered by a court or tribunal for a determinate or indeterminate\nperiod in the exercise of its criminal jurisdiction, and includes any\ndirection or order given or made by the court or tribunal with\nrespect to the commencement of the punishment or measure.\nNote:\nParagraph (b) covers suspended sentences."
    },
