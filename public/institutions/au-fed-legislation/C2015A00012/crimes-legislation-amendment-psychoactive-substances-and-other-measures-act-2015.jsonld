    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-2-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Subsection 360.2(3) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-2-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
