      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO or Regional Director concerned may cause the goods to be dealt with in such manner as he or she considers appropriate (including the destruction of the goods).",
      "cml:conclusionText": "The action must occur within a certain temporal interval."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-diffusion-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spread",
      "cml:logicSummary": "Spreads the prohibition to all relevant parties.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO or Regional Director may cause the goods to be dealt with in such manner as he or she considers appropriate.",
      "cml:conclusionText": "The prohibition must spread to all relevant parties."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Imply",
      "cml:logicSummary": "Implies a certain course of action for the CEO or Regional Director.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CEO or Regional Director concerned may cause the goods to be dealt with in such manner as he or she considers appropriate (including the destruction of the goods).",
      "cml:conclusionText": "A certain course of action must be implied."
    },
    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-9-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognize",
      "cml:logicSummary": "Recognizes the need for a certain course of action by the CEO or Regional Director.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
