    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 At the end of section 24",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.37",
      "values:originalText": "Add:\nNote:\nThe Attorney-General need not take any steps to decide the request if\ncertain requirements are not met, or if it is less than 12 months since\nan earlier request for the prisoner was not proceeded with (see\nsection 10A).\n\n(2) The request may be made by the transfer country, the prisoner or\nthe prisoner’s representative.",
      "skos:definition": "Add:\nNote:\nThe Attorney-General need not take any steps to decide the request if\ncertain requirements are not met, or if it is less than 12 months since\nan earlier request for the prisoner was not proceeded with (see\nsection 10A).\n\n(2) The request may be made by the transfer country, the prisoner or\nthe prisoner’s representative.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-38-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-38-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-38-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-38-logic-alleninterval-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-38-logic-ltl-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-38-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "31313395760de8f99af9cd1d9fba4418e599c567b7e9564c4026a645a407b926",
      "skos:note": "The Attorney-General need not take steps to decide a request if certain requirements are not met or it is less than 12 months since an earlier request was not proceeded with."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-38",
      "@type": "cof:Section",
      "cof:title": "38 At the end of section 24",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "Add:\nNote:\nThe Attorney-General need not take any steps to decide the request if\ncertain requirements are not met, or if it is less than 12 months since\nan earlier request for the prisoner was not proceeded with (see\nsection 10A).\n\n(2) The request may be made by the transfer country, the prisoner or\nthe prisoner’s representative."
    },
