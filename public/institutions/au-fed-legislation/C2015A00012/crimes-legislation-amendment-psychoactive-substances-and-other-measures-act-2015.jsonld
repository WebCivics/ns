    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Prisoner and prisoner’s representative to be kept informed",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-52"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.37",
      "values:originalText": "The Attorney-General must arrange for a prisoner or prisoner’s\nrepresentative to be kept informed of the progress of:\n\n(a) any application made under section 16; or\n\n(b) any request made under section 24 or 33;\nfor the transfer of the prisoner.\nComLaw Authoritative Act C2015A00012\n\nSchedule 3  International transfer of prisoners",
      "skos:definition": "The Attorney-General must arrange for a prisoner or prisoner’s\nrepresentative to be kept informed of the progress of:\n\n(a) any application made under section 16; or\n\n(b) any request made under section 24 or 33;\nfor the transfer of the prisoner.\nComLaw Authoritative Act C2015A00012\n\nSchedule 3  International transfer of prisoners",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-52-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-52-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "062389857862d645fec53a4e1bfa688bbe8f4e4d5a030cac44b57ffdf394a7a7",
      "skos:note": "The Attorney-General must inform a prisoner or their representative of certain requests.",
      "dc:description": "Information about the progress of applications and requests"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-52",
      "@type": "cof:Section",
      "cof:title": "52 Prisoner and prisoner’s representative to be kept informed",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "The Attorney-General must arrange for a prisoner or prisoner’s\nrepresentative to be kept informed of the progress of:\n\n(a) any application made under section 16; or\n\n(b) any request made under section 24 or 33;\nfor the transfer of the prisoner.\nComLaw Authoritative Act C2015A00012\n\nSchedule 3  International transfer of prisoners"
    },
    {
