    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "205EA(6) Treatment of goods seized if a claim for return is made—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-1-sec-205ea-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.15",
      "values:originalText": "(6) For the purposes of this section, the return of goods requires their\nreturn to the person reasonably believed to be the owner of the\ngoods in a condition as near as practicable to the condition in\nwhich they were seized.",
      "skos:definition": "(6) For the purposes of this section, the return of goods requires their\nreturn to the person reasonably believed to be the owner of the\ngoods in a condition as near as practicable to the condition in\nwhich they were seized.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea"
