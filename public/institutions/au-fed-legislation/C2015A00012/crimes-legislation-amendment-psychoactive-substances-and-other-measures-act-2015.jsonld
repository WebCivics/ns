      "cml:integrityHash": "276b7c618a5ab4f71cb8da87a49bfe5ffffaa6eed6b152af6bff00a08eafc5d5",
      "skos:note": "No proceedings for an offence against section 270.3 can take place outside Australia without consent from the Attorney-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-4-sec-270-2-ss-1",
      "@type": "cof:Section",
      "cof:title": "270(1) 3B  Prosecutions",
      "values:kind": "subsection",
      "cof:pageNumber": 40,
      "values:originalText": "(1) Proceedings for an offence against section 270.3, where the\nconduct constituting the alleged offence occurs wholly outside\nAustralia, must not take place except with the consent in writing of\nthe Attorney-General."
    },
