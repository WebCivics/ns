    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 After subsection 22(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.28",
      "values:originalText": "Insert:\n\n(4A) If the prisoner is serving the suspended part of the sentence of\nimprisonment, the warrant is:\n\n(a) to specify any conditions relating to that part of the sentence\nthat have been imposed under an Australian law; and\n\n(b) to specify any procedures for the transfer of the prisoner to\nthe transfer country that have been agreed upon with the\ntransfer country, and to give any necessary authorisations and\ndirections.\nComLaw Authoritative Act C2015A00012\n\nInternational transfer of prisoners  Schedule 3\nSuspended sentences  Part 1\n\nNo. 12, 2015\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015",
      "skos:definition": "Insert:\n\n(4A) If the prisoner is serving the suspended part of the sentence of\nimprisonment, the warrant is:\n\n(a) to specify any conditions relating to that part of the sentence\nthat have been imposed under an Australian law; and\n\n(b) to specify any procedures for the transfer of the prisoner to\nthe transfer country that have been agreed upon with the\ntransfer country, and to give any necessary authorisations and\ndirections.\nComLaw Authoritative Act C2015A00012\n\nInternational transfer of prisoners  Schedule 3\nSuspended sentences  Part 1\n\nNo. 12, 2015\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-9-norm"
        }
      ],
      "cml:integrityHash": "a73cfde0a0e1e330e16293c804e9dc5b2ca31dfcceba6cdb8330b241a503b1fb",
      "skos:note": "Specifies conditions and procedures for prisoner transfer"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 After subsection 22(4)",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Insert:\n\n(4A) If the prisoner is serving the suspended part of the sentence of\nimprisonment, the warrant is:\n\n(a) to specify any conditions relating to that part of the sentence\nthat have been imposed under an Australian law; and\n\n(b) to specify any procedures for the transfer of the prisoner to\nthe transfer country that have been agreed upon with the\ntransfer country, and to give any necessary authorisations and\ndirections.\nComLaw Authoritative Act C2015A00012\n\nInternational transfer of prisoners  Schedule 3\nSuspended sentences  Part 1\n\nNo. 12, 2015\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015"
    },
