      "@type": "cml:Concept",
      "skos:prefLabel": "1 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-5-sec-1"
