    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "205EA(5) Treatment of goods seized if a claim for return is made—",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-1-sec-205ea-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.15",
      "values:originalText": "(5) For the purposes of subsection (4), if the proceedings go to\njudgment, they end:\n\n(a) at the end of the period for lodging an appeal against the\njudgment, if no appeal is lodged within that period; or\n\n(b) when the appeal lapses or is finally determined, if an appeal\nis lodged against the judgment within that period.",
      "skos:definition": "(5) For the purposes of subsection (4), if the proceedings go to\njudgment, they end:\n\n(a) at the end of the period for lodging an appeal against the\njudgment, if no appeal is lodged within that period; or\n\n(b) when the appeal lapses or is finally determined, if an appeal\nis lodged against the judgment within that period.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-5-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-1-sec-205ea-ss-5-logic-deontic-1"
