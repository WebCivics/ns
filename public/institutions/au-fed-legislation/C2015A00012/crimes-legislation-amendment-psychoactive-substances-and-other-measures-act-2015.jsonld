      "cml:integrityHash": "455973d325ac7cb23a13793bc8c399e19427761baa2c325e6c7b9773620cb61c",
      "skos:note": "Omit specific phrase from definition of prisoner"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Subsection 22(3)",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Omit “is a prisoner other than a prisoner who has been released on\nparole”, substitute “has not been released on parole and is not serving\nthe suspended part of the sentence of imprisonment”."
    },
