    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 At the end of section 16",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.35",
      "values:originalText": "Add:\nNote:\nThe Attorney-General need not take any steps to decide the\napplication if certain requirements are not met, or if it is less than 12\nmonths since an earlier application for the prisoner was not proceeded\nwith (see section 10A).",
      "skos:definition": "Add:\nNote:\nThe Attorney-General need not take any steps to decide the\napplication if certain requirements are not met, or if it is less than 12\nmonths since an earlier application for the prisoner was not proceeded\nwith (see section 10A).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-32-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8327dd8c2695479205d6c90f0e74554120bea4140cc6220ef78005d8df5c1f9c",
      "skos:note": "No action required if certain requirements are not met or it's less than 12 months since an earlier application."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 At the end of section 16",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "Add:\nNote:\nThe Attorney-General need not take any steps to decide the\napplication if certain requirements are not met, or if it is less than 12\nmonths since an earlier application for the prisoner was not proceeded\nwith (see section 10A)."
    },
