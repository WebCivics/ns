    {
      "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-43",
      "@type": "cml:Concept",
      "skos:prefLabel": "43 Transitional—saving current prescribed forms",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-43"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015.pdf, p.39",
      "values:originalText": "(1)\nThis item applies to a form prescribed by regulations:\n\n(a) made for the purposes of section 16 of the International\nTransfer of Prisoners Act 1997; and\n\n(b) in force immediately before the commencement of this\nSchedule.\n(2)\nOn and after that commencement, treat the form as if it were the form\napproved in writing by the Attorney-General for the purposes of\nsection 16 of the International Transfer of Prisoners Act 1997.\n(3)\nSubitem (2) does not prevent the Attorney-General from approving a\nnew form for the purposes of that section.\nComLaw Authoritative Act C2015A00012\n\nSchedule 4  Slavery offences: jurisdiction\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015",
      "skos:definition": "(1)\nThis item applies to a form prescribed by regulations:\n\n(a) made for the purposes of section 16 of the International\nTransfer of Prisoners Act 1997; and\n\n(b) in force immediately before the commencement of this\nSchedule.\n(2)\nOn and after that commencement, treat the form as if it were the form\napproved in writing by the Attorney-General for the purposes of\nsection 16 of the International Transfer of Prisoners Act 1997.\n(3)\nSubitem (2) does not prevent the Attorney-General from approving a\nnew form for the purposes of that section.\nComLaw Authoritative Act C2015A00012\n\nSchedule 4  Slavery offences: jurisdiction\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015-sch-3-sec-43-norm"
        }
      ],
      "cml:integrityHash": "9ae242ffec5a16fb834b1fc17ea3886c97d25ff979d4fef9da2dfeba5eb84114",
      "skos:note": "Transitional provision for saving current prescribed forms"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-43",
      "@type": "cof:Section",
      "cof:title": "43 Transitional—saving current prescribed forms",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "(1)\nThis item applies to a form prescribed by regulations:\n\n(a) made for the purposes of section 16 of the International\nTransfer of Prisoners Act 1997; and\n\n(b) in force immediately before the commencement of this\nSchedule.\n(2)\nOn and after that commencement, treat the form as if it were the form\napproved in writing by the Attorney-General for the purposes of\nsection 16 of the International Transfer of Prisoners Act 1997.\n(3)\nSubitem (2) does not prevent the Attorney-General from approving a\nnew form for the purposes of that section.\nComLaw Authoritative Act C2015A00012\n\nSchedule 4  Slavery offences: jurisdiction\n\nCrimes Legislation Amendment (Psychoactive Substances and Other\nMeasures) Act 2015\nNo. 12, 2015"
    },
