      ],
      "cml:integrityHash": "26a282a40892ec8b3975fde4eb2401e1ea4c2870dbf9a28e453bc54001d268b5",
      "skos:note": "Must provide copies of applications to State and Territory Ministers"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-psychoactive-substances-and-other-measures-act-2015#sch-3-sec-17-2-ss-1",
      "@type": "cof:Section",
      "cof:title": "17(1) Copies of applications to be given to State and Territory",
      "values:kind": "subsection",
      "cof:pageNumber": 35,
      "values:originalText": "(1) The Attorney-General must give:\n\n(a) a copy of an application given under section 16; and\n\n(b) any other information the Attorney-General considers\nrelevant;\nto any State Ministers and Territory Ministers whose consent is\nrequired for the transfer to have appropriate Ministerial consent."
    },
