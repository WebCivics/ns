    cof:title "186J(1) Reports" ;
    values:kind "subsection" ;
    values:originalText "(1) The Ombudsman must report to the Minister, in writing, about the results of inspections under section 186B of the records of agencies during a financial year." ;
    cof:pageNumber "87"^^xsd:integer .

