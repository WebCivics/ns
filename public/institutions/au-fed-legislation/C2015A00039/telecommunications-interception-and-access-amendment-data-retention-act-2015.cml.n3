concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-3-sec-186d-ss-4 a cml:Concept ;
    skos:prefLabel "186D(4) Ombudsman to be given information and access despite other"@en ;
    cml:realizedBy doc:sch-3-sec-186d-ss-4 ;
    values:originalText "(4) Nothing in section 133, 181A, 181B or 182, or in any other law, prevents an officer of an enforcement agency from making a record of information, or causing a record of information to be made, for the purposes of giving the information to a person as permitted by subsection (3)." ;
    skos:definition "(4) Nothing in section 133, 181A, 181B or 182, or in any other law, prevents an officer of an enforcement agency from making a record of information, or causing a record of information to be made, for the purposes of giving the information to a person as permitted by subsection (3)."@en ;
    cml:integrityHash "43dc319e0b4016a5f25ff8aa3cdfa79c9541ac30c52c3f945101103d4402bcd4" ;
    values:partOf concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-3-sec-186d ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Enforcement agency must provide information to a person." ;
    cml:curationStatus cml:Proposed ;
