concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6j a cml:Concept ;
    skos:prefLabel "6J Section 180F"@en ;
    cml:realizedBy doc:sch-1-sec-6j ;
    values:originalText "Omit “have regard to whether any interference with the privacy of any person or persons that may result from the disclosure or use is justifiable”, substitute “be satisfied on reasonable grounds that any interference with the privacy of any person or persons that may result from the disclosure or use is justifiable and proportionate”." ;
    skos:definition "Omit “have regard to whether any interference with the privacy of any person or persons that may result from the disclosure or use is justifiable”, substitute “be satisfied on reasonable grounds that any interference with the privacy of any person or persons that may result from the disclosure or use is justifiable and proportionate”."@en ;
    cml:integrityHash "777b3d2f3d87a40384eac979b91625c3ae340d453f289497f138a4323cef3862" ;
    cof:pageNumber "38"^^xsd:integer ;
    skos:note "Interference with privacy must be proportionate and justifiable." ;
    cml:curationStatus cml:Proposed ;
