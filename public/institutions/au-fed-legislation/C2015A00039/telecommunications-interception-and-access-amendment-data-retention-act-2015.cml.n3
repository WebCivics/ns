concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187ba a cml:Concept ;
    skos:prefLabel "187BA Ensuring the confidentiality of information"@en ;
    cml:realizedBy doc:sch-1-sec-187ba ;
    values:originalText "A service provider must protect the confidentiality of information that, or information in a document that, the service provider must keep, or cause to be kept, under section 187A by:  (a) encrypting the information; and  (b) protecting the information from unauthorised interference or unauthorised access." ;
    skos:definition "A service provider must protect the confidentiality of information that, or information in a document that, the service provider must keep, or cause to be kept, under section 187A by:  (a) encrypting the information; and  (b) protecting the information from unauthorised interference or unauthorised access."@en ;
    cml:integrityHash "a0945ba12cfb1eeffc6efd5b5bc3b53b689b1d81cac9150a06b2e1d5bab79eb0" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Must protect confidentiality of information" ;
    dc:description "Protection measures (encryption, protection from unauthorized access)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
