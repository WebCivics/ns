concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-48 a cml:Concept ;
    skos:prefLabel "48 Existing domestic preservation notices"@en ;
    cml:realizedBy doc:sch-2-sec-48 ;
    values:originalText "If:  (a) a domestic preservation notice was given to a carrier before the commencement of this Schedule; and  (b) the notice was in force immediately before that commencement; and  (c) the authority or body that gave the notice was not the Organisation; and  (d) on that commencement, the authority or body is not a criminal law-enforcement agency (whether or not it is an enforcement agency); after that commencement, the notice continues in force, and Chapter 3 of the Telecommunications (Interception and Access) Act 1979 as amended by this Act continues to apply in relation to the notice, as if the authority or body were a criminal law-enforcement agency." ;
    skos:definition "If:  (a) a domestic preservation notice was given to a carrier before the commencement of this Schedule; and  (b) the notice was in force immediately before that commencement; and  (c) the authority or body that gave the notice was not the Organisation; and  (d) on that commencement, the authority or body is not a criminal law-enforcement agency (whether or not it is an enforcement agency); after that commencement, the notice continues in force, and Chapter 3 of the Telecommunications (Interception and Access) Act 1979 as amended by this Act continues to apply in relation to the notice, as if the authority or body were a criminal law-enforcement agency."@en ;
    cml:integrityHash "ca895ec19f496f645361a339767a2050393c9fdeb685bdb32684cfb6d0a2749a" ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "Continuation of existing domestic preservation notices after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
