concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-3-sec-2 a cml:Concept ;
    skos:prefLabel "2 At the end of section 87"@en ;
    cml:realizedBy doc:sch-3-sec-2 ;
    values:originalText "Add:  (6) A person must not refuse:  (a) to attend before a person; or  (b) to give information; or  (c) to answer questions; when required to do so under this section. Penalty for an offence against this subsection: Imprisonment for 6 months." ;
