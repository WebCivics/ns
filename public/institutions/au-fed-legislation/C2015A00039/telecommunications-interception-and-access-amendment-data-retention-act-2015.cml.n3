concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187n-ss-5 a cml:Concept ;
    skos:prefLabel "187N(5) Review of operation of Part"@en ;
    cml:realizedBy doc:sch-1-sec-187n-ss-5 ;
    values:originalText "(5) Subsections (3) and (4) do not limit any other obligation to keep information under this Act or another law. ComLaw Authoritative Act C2015A00039  Data retention  Schedule 1 Main amendments  Part 1  No. 39, 2015 Telecommunications (Interception and Access) Amendment (Data Retention) Act 2015" ;
    skos:definition "(5) Subsections (3) and (4) do not limit any other obligation to keep information under this Act or another law. ComLaw Authoritative Act C2015A00039  Data retention  Schedule 1 Main amendments  Part 1  No. 39, 2015 Telecommunications (Interception and Access) Amendment (Data Retention) Act 2015"@en ;
    cml:integrityHash "694a2d87bda19392aafdec95689187393e2680755fa7ca8fed225542f44bfc06" ;
    values:partOf concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187n ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "No obligation to keep information under this Act or another law is limited by subsections (3) and (4)." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
