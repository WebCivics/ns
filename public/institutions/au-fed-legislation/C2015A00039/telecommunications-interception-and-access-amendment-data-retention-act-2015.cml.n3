    cml:hasPart concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187n-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
