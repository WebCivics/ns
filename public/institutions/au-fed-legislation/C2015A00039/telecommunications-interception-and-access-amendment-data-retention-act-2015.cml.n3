concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180n a cml:Concept ;
    skos:prefLabel "180N Duration of a journalist information warrant"@en ;
    cml:realizedBy doc:sch-1-sec-180n ;
    values:originalText "A journalist information warrant issued under section 180L must specify the period (not exceeding 6 months) for which it is to remain in force. The Minister may revoke the warrant at any time before the end of the specified period." ;
    skos:definition "A journalist information warrant issued under section 180L must specify the period (not exceeding 6 months) for which it is to remain in force. The Minister may revoke the warrant at any time before the end of the specified period."@en ;
    cml:integrityHash "e4f9c4ceff1b5dc25db89a1ebfb983d6ed178d99a4d284552c36eaadc91187da" ;
    cof:pageNumber "44"^^xsd:integer ;
    skos:note "The Minister must revoke a journalist information warrant before its specified period ends." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf> ;
    dc:source "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.44" ;
