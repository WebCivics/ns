concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-49 a cml:Concept ;
    skos:prefLabel "49 Existing stored communications warrants"@en ;
    cml:realizedBy doc:sch-2-sec-49 ;
    values:originalText "If:  (a) a stored communications warrant was issued to an authority or body before the commencement of this Schedule; and  (b) the warrant was in force immediately before that commencement; and  (c) on that commencement, the authority or body is not a criminal law-enforcement agency (whether or not it is an enforcement agency); after that commencement, the warrant continues in force, and Chapter 3 of the Telecommunications (Interception and Access) Act 1979 as amended by this Act continues to apply in relation to the warrant, as if the authority or body were a criminal law-enforcement agency." ;
    skos:definition "If:  (a) a stored communications warrant was issued to an authority or body before the commencement of this Schedule; and  (b) the warrant was in force immediately before that commencement; and  (c) on that commencement, the authority or body is not a criminal law-enforcement agency (whether or not it is an enforcement agency); after that commencement, the warrant continues in force, and Chapter 3 of the Telecommunications (Interception and Access) Act 1979 as amended by this Act continues to apply in relation to the warrant, as if the authority or body were a criminal law-enforcement agency."@en ;
    cml:integrityHash "d4097cbc90a532af1bec022c0071c7eb12ef2af1ca560820b7cc88ade6a63c51" ;
    cof:pageNumber "74"^^xsd:integer ;
    skos:note "Existing stored communications warrants continue in force after commencement." ;
