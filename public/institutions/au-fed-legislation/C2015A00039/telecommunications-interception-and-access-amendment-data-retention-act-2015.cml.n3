doc:sch-1-sec-180x-ss-1 a cof:Section ;
    cof:title "180X(1) Public Interest Advocates" ;
    values:kind "subsection" ;
    values:originalText "(1) The Prime Minister shall declare, in writing, one or more persons to be Public Interest Advocates." ;
    cof:pageNumber "48"^^xsd:integer .

concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180x-ss-2 a cml:Concept ;
    skos:prefLabel "180X(2) Public Interest Advocates"@en ;
    cml:realizedBy doc:sch-1-sec-180x-ss-2 ;
    values:originalText "(2) A Public Interest Advocate may make submissions:  (a) to the Minister about matters relevant to:  (i) a decision to issue, or refuse to issue, a journalist information warrant under section 180L; or  (ii) a decision about the conditions or restrictions (if any) that are to be specified in such a warrant; or  (b) to a Part 4-1 issuing authority about matters relevant to:  (i) a decision to issue, or refuse to issue, the warrant under section 180T; or  (ii) a decision about the conditions or restrictions (if any) that are to be specified in such a warrant." ;
    skos:definition "(2) A Public Interest Advocate may make submissions:  (a) to the Minister about matters relevant to:  (i) a decision to issue, or refuse to issue, a journalist information warrant under section 180L; or  (ii) a decision about the conditions or restrictions (if any) that are to be specified in such a warrant; or  (b) to a Part 4-1 issuing authority about matters relevant to:  (i) a decision to issue, or refuse to issue, the warrant under section 180T; or  (ii) a decision about the conditions or restrictions (if any) that are to be specified in such a warrant."@en ;
    cml:integrityHash "46d08e35a5fc08a7cca64191ca4e9e166b4129f064cad794f4172ff5758ec815" ;
    values:partOf concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180x ;
    cof:pageNumber "48"^^xsd:integer ;
    skos:note "Submit to Minister or issuing authority about specific matters." ;
