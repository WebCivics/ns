concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187m a cml:Concept ;
    skos:prefLabel "187M Pecuniary penalties and infringement notices"@en ;
    cml:realizedBy doc:sch-1-sec-187m ;
    values:originalText "Subsection 187A(1) and paragraph 187D(a) are civil penalty provisions for the purposes of the Telecommunications Act 1997. Note: Parts 31 and 31B of the Telecommunications Act 1997 provide for pecuniary penalties and infringement notices for contraventions of civil penalty provisions. ComLaw Authoritative Act C2015A00039  Schedule 1  Data retention" ;
    skos:definition "Subsection 187A(1) and paragraph 187D(a) are civil penalty provisions for the purposes of the Telecommunications Act 1997. Note: Parts 31 and 31B of the Telecommunications Act 1997 provide for pecuniary penalties and infringement notices for contraventions of civil penalty provisions. ComLaw Authoritative Act C2015A00039  Schedule 1  Data retention"@en ;
    cml:integrityHash "5d324d337bc576885c51679486223e6fd95b5b3f0c7623ea18cce7749134ed06" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Pecuniary penalties and infringement notices for contraventions of civil penalty provisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf> ;
