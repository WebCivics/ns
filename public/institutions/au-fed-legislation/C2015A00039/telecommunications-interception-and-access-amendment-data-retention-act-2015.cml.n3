doc:sch-1-sec-180r-ss-1 a cof:Section ;
    cof:title "180R(1) Further information" ;
    values:kind "subsection" ;
    values:originalText "(1) The Part 4-1 issuing authority may require:  (a) in any case—the chief officer of the agency; or  (b) if the application is made, on the agency’s behalf, by a person other than the chief officer—that other person; to give to the Part 4-1 issuing authority, within the period and in the form specified in the requirement, further information in connection with the application." ;
    cof:pageNumber "45"^^xsd:integer .

