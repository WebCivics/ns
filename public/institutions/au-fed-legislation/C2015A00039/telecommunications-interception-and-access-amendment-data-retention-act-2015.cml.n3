    values:partOf concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180u ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Allows for multiple warrants to be issued under the same Act." ;
