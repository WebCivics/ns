    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180u-ss-4",
      "@type": "cof:Section",
      "cof:title": "180U(4) Form and content of a journalist information warrant",
      "values:kind": "subsection",
      "cof:pageNumber": 47,
      "values:originalText": "(4) A Part 4-1 issuing authority must not vary a journalist information\nwarrant issued under this Subdivision by extending the period for\nwhich it is to be in force."
    },
