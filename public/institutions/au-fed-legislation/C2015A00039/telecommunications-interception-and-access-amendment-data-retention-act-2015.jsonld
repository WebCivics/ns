    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187n-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "187N(5) Review of operation of Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-187n-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.26",
      "values:originalText": "(5) Subsections (3) and (4) do not limit any other obligation to keep\ninformation under this Act or another law.\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nMain amendments  Part 1\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015",
      "skos:definition": "(5) Subsections (3) and (4) do not limit any other obligation to keep\ninformation under this Act or another law.\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nMain amendments  Part 1\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187n"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187n-ss-5-norm"
        }
      ],
      "cml:integrityHash": "694a2d87bda19392aafdec95689187393e2680755fa7ca8fed225542f44bfc06",
      "skos:note": "No obligation to keep information under this Act or another law is limited by subsections (3) and (4)."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-187n-ss-5",
      "@type": "cof:Section",
      "cof:title": "187N(5) Review of operation of Part",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(5) Subsections (3) and (4) do not limit any other obligation to keep\ninformation under this Act or another law.\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nMain amendments  Part 1\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187n-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187n-ss-5"
