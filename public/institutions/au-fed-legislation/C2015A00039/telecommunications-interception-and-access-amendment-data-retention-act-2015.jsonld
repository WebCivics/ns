        }
      ],
      "cml:integrityHash": "1f7f7f43fcf70081c059d450cdbf6e1300eb01df850990b90d73a2115bc73b84",
      "skos:note": "Service providers must keep certain information for a specified period.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-187a-ss-3b",
      "@type": "cof:Section",
      "cof:title": "187A(3B) Service providers must keep certain information and",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(3B) A declaration under subsection (3A):\n\n(a) comes into force when it is made, or on such later day as is\nspecified in the declaration; and\n\n(b) ceases to be in force at the end of the period of 40 sitting\ndays of a House of the Parliament after the declaration comes\ninto force."
    },
    {
