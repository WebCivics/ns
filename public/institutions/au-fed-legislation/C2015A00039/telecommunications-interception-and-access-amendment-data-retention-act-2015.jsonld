      "@type": "cml:Concept",
      "skos:prefLabel": "5 Subsection 5(1) (definition of Crime and Misconduct",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-2-sec-5"
      },
