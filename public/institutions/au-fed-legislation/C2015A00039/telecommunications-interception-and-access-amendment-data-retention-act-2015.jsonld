        }
      ],
      "cml:integrityHash": "62d242e4b56017755f8eb9d1f5da4f41c3586b9cfecf20029a902f9e84c97f25",
      "skos:note": "Ombudsman may obtain relevant information from an officer of a particular enforcement agency."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-3-sec-186c",
