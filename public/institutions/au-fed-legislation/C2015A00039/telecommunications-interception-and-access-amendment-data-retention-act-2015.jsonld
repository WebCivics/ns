    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6k",
      "@type": "cml:Concept",
      "skos:prefLabel": "6K Before paragraph 180F(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.38",
      "values:originalText": "Insert:\n\n(aa) the gravity of any conduct in relation to which the\nauthorisation is sought, including:\n\n(i) the seriousness of any offence in relation to which the\nauthorisation is sought; and\n\n(ii) the seriousness of any pecuniary penalty in relation to\nwhich the authorisation is sought; and\n\n(iii) the seriousness of any protection of the public revenue\nin relation to which the authorisation is sought; and\n\n(iv) whether the authorisation is sought for the purposes of\nfinding a missing person;",
      "skos:definition": "Insert:\n\n(aa) the gravity of any conduct in relation to which the\nauthorisation is sought, including:\n\n(i) the seriousness of any offence in relation to which the\nauthorisation is sought; and\n\n(ii) the seriousness of any pecuniary penalty in relation to\nwhich the authorisation is sought; and\n\n(iii) the seriousness of any protection of the public revenue\nin relation to which the authorisation is sought; and\n\n(iv) whether the authorisation is sought for the purposes of\nfinding a missing person;",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6k-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6k-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c86dcd71c7f52ff69ee07b95af11c98bd8d5485eb350b0c812052978b033ba5",
      "skos:note": "Requires consideration of conduct gravity, including seriousness of offence and pecuniary penalty."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6k",
      "@type": "cof:Section",
      "cof:title": "6K Before paragraph 180F(a)",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Insert:\n\n(aa) the gravity of any conduct in relation to which the\nauthorisation is sought, including:\n\n(i) the seriousness of any offence in relation to which the\nauthorisation is sought; and\n\n(ii) the seriousness of any pecuniary penalty in relation to\nwhich the authorisation is sought; and\n\n(iii) the seriousness of any protection of the public revenue\nin relation to which the authorisation is sought; and\n\n(iv) whether the authorisation is sought for the purposes of\nfinding a missing person;"
    },
