      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-3-sec-186h",
      "@type": "cml:Concept",
      "skos:prefLabel": "186H Ombudsman not to be sued",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-3-sec-186h"
