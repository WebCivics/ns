        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187g-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "187G(4) Consultation with agencies and the ACMA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-187g-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.18",
      "values:originalText": "(4) If the service provider indicates that it does not accept a request for\nan amendment of the original plan, the Communications Access\nCo-ordinator must:\n\n(a) refer the request and the service provider’s response to the\nACMA; and\n\n(b) request the ACMA to determine whether any amendment of\nthe original plan is required.",
      "skos:definition": "(4) If the service provider indicates that it does not accept a request for\nan amendment of the original plan, the Communications Access\nCo-ordinator must:\n\n(a) refer the request and the service provider’s response to the\nACMA; and\n\n(b) request the ACMA to determine whether any amendment of\nthe original plan is required.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187g"
      },
