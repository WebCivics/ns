      },
      "cml:premiseText": "Disclosure is no longer required",
      "cml:conclusionText": "Revocation must be cancelled"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6j",
      "@type": "cml:Concept",
      "skos:prefLabel": "6J Section 180F",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.38",
      "values:originalText": "Omit “have regard to whether any interference with the privacy of any\nperson or persons that may result from the disclosure or use is\njustifiable”, substitute “be satisfied on reasonable grounds that any\ninterference with the privacy of any person or persons that may result\nfrom the disclosure or use is justifiable and proportionate”.",
      "skos:definition": "Omit “have regard to whether any interference with the privacy of any\nperson or persons that may result from the disclosure or use is\njustifiable”, substitute “be satisfied on reasonable grounds that any\ninterference with the privacy of any person or persons that may result\nfrom the disclosure or use is justifiable and proportionate”.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6j-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6j-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "777b3d2f3d87a40384eac979b91625c3ae340d453f289497f138a4323cef3862",
      "skos:note": "Interference with privacy must be proportionate and justifiable."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6j",
      "@type": "cof:Section",
      "cof:title": "6J Section 180F",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Omit “have regard to whether any interference with the privacy of any\nperson or persons that may result from the disclosure or use is\njustifiable”, substitute “be satisfied on reasonable grounds that any\ninterference with the privacy of any person or persons that may result\nfrom the disclosure or use is justifiable and proportionate”."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6j-norm",
      "@type": "values:Obligation",
