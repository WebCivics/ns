    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187ba",
      "@type": "cml:Concept",
      "skos:prefLabel": "187BA Ensuring the confidentiality of information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-187ba"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.15",
      "values:originalText": "A service provider must protect the confidentiality of information\nthat, or information in a document that, the service provider must\nkeep, or cause to be kept, under section 187A by:\n\n(a) encrypting the information; and\n\n(b) protecting the information from unauthorised interference or\nunauthorised access.",
      "skos:definition": "A service provider must protect the confidentiality of information\nthat, or information in a document that, the service provider must\nkeep, or cause to be kept, under section 187A by:\n\n(a) encrypting the information; and\n\n(b) protecting the information from unauthorised interference or\nunauthorised access.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187ba-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187ba-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a0945ba12cfb1eeffc6efd5b5bc3b53b689b1d81cac9150a06b2e1d5bab79eb0",
      "skos:note": "Must protect confidentiality of information",
      "dc:description": "Protection measures (encryption, protection from unauthorized access)"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-187ba",
      "@type": "cof:Section",
      "cof:title": "187BA Ensuring the confidentiality of information",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "A service provider must protect the confidentiality of information\nthat, or information in a document that, the service provider must\nkeep, or cause to be kept, under section 187A by:\n\n(a) encrypting the information; and\n\n(b) protecting the information from unauthorised interference or\nunauthorised access."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187ba-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
