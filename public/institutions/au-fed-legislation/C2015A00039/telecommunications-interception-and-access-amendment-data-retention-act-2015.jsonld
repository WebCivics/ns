      "cml:integrityHash": "feb7f2fe6e5808239a2549bb420a081df257976cff809410bf18391d2f3a6fb7",
      "skos:note": "Report must be laid before each House of Parliament within 15 sitting days."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-3-sec-186j-ss-3",
      "@type": "cof:Section",
      "cof:title": "186J(3) Reports",
      "values:kind": "subsection",
      "cof:pageNumber": 87,
      "values:originalText": "(3) The Minister must cause a copy of the report to be laid before each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives it."
    },
