    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-1j",
      "@type": "cml:Concept",
      "skos:prefLabel": "1J Subsection 6C(1) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-1j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.30",
      "values:originalText": "Repeal the note, substitute:\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nOther amendments  Part 2\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015\n\nNote 1:\nUnder section 187LA of the Telecommunications (Interception and\nAccess) Act 1979, service providers are, in relation to their activities\nrelating to retained data, treated as organisations for the purposes of\nthis Act.\nNote: 2:\nRegulations may prescribe an instrumentality by reference to one or\nmore classes of instrumentality. See subsection 13(3) of the\nLegislative Instruments Act 2003.\nTelecommunications Act 1997",
      "skos:definition": "Repeal the note, substitute:\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nOther amendments  Part 2\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015\n\nNote 1:\nUnder section 187LA of the Telecommunications (Interception and\nAccess) Act 1979, service providers are, in relation to their activities\nrelating to retained data, treated as organisations for the purposes of\nthis Act.\nNote: 2:\nRegulations may prescribe an instrumentality by reference to one or\nmore classes of instrumentality. See subsection 13(3) of the\nLegislative Instruments Act 2003.\nTelecommunications Act 1997",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-1j-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-1j-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-1j-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-1j-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "162ae7a58e97f8ddb2ae834f8c30f537e86ef2ed7e9e3485c9adbcdbcdfe031c",
      "skos:note": "Service providers are treated as organisations for the purposes of this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-1j",
      "@type": "cof:Section",
      "cof:title": "1J Subsection 6C(1) (note)",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "Repeal the note, substitute:\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nOther amendments  Part 2\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015\n\nNote 1:\nUnder section 187LA of the Telecommunications (Interception and\nAccess) Act 1979, service providers are, in relation to their activities\nrelating to retained data, treated as organisations for the purposes of\nthis Act.\nNote: 2:\nRegulations may prescribe an instrumentality by reference to one or\nmore classes of instrumentality. See subsection 13(3) of the\nLegislative Instruments Act 2003.\nTelecommunications Act 1997"
    },
