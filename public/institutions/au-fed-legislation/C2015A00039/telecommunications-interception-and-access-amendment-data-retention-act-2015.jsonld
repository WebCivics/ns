      ],
      "cml:integrityHash": "45939248616ce2eeaec65aeb485c9762e6f301d49cd908ccb84d804543bcb1c1",
      "skos:note": "Delegation of power to a certifying officer"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180w-ss-2",
      "@type": "cof:Section",
      "cof:title": "180W(2) Revocation of a journalist information warrant by chief",
      "values:kind": "subsection",
      "cof:pageNumber": 48,
      "values:originalText": "(2) The chief officer of an enforcement agency may delegate his or her\npower under paragraph (1)(a) to a certifying officer of the agency.\nSubdivision D—Miscellaneous"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180w-ss-2-norm",
