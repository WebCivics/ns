      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.47",
      "values:originalText": "A journalist information warrant issued under this Subdivision\ncomes into force when it is issued.\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention",
      "skos:definition": "A journalist information warrant issued under this Subdivision\ncomes into force when it is issued.\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention",
