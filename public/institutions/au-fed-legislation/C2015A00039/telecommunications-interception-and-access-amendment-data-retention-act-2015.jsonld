    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6e",
      "@type": "cml:Concept",
      "skos:prefLabel": "6E Paragraph 176(5)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.36",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) unless it is revoked earlier, ends at the time specified in the\nauthorisation, which must be a time that:\n\n(i) is no later than the end of the period of 90 days\nbeginning on the day the authorisation is made; and\n\n(ii) if the authorisation is made under a journalist\ninformation warrant—is no later than the end of the\nperiod specified under section 180N as the period for\nwhich the warrant is to remain in force.\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nOther amendments  Part 2\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) unless it is revoked earlier, ends at the time specified in the\nauthorisation, which must be a time that:\n\n(i) is no later than the end of the period of 90 days\nbeginning on the day the authorisation is made; and\n\n(ii) if the authorisation is made under a journalist\ninformation warrant—is no later than the end of the\nperiod specified under section 180N as the period for\nwhich the warrant is to remain in force.\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nOther amendments  Part 2\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6e-norm"
        }
      ],
      "cml:integrityHash": "c4f160fe4d41081ac5637986dfe8114bbe9c082009b08de648dd14d2e2f4b246",
      "skos:note": "Conditional commencement of authorization period"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6e",
      "@type": "cof:Section",
      "cof:title": "6E Paragraph 176(5)(b)",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) unless it is revoked earlier, ends at the time specified in the\nauthorisation, which must be a time that:\n\n(i) is no later than the end of the period of 90 days\nbeginning on the day the authorisation is made; and\n\n(ii) if the authorisation is made under a journalist\ninformation warrant—is no later than the end of the\nperiod specified under section 180N as the period for\nwhich the warrant is to remain in force.\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nOther amendments  Part 2\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6e-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6e"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6f",
      "@type": "cml:Concept",
      "skos:prefLabel": "6F Subsection 176(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.37",
      "values:originalText": "Repeal the subsection, substitute:\nRevoking the authorisation\n\n(6) An eligible person must revoke the authorisation if:\n\n(a) he or she is satisfied that the disclosure is no longer required;\nor\n\n(b) in a case where the authorisation is made under a journalist\ninformation warrant:\n\n(i) the warrant is revoked under subsection 180N(1); or\n\n(ii) the Director-General of Security has informed the\nMinister under section 180P that the Director-General is\nsatisfied that the grounds on which the warrant was\nissued have ceased to exist.\nNote:\nSection 184 deals with notification of authorisations.",
      "skos:definition": "Repeal the subsection, substitute:\nRevoking the authorisation\n\n(6) An eligible person must revoke the authorisation if:\n\n(a) he or she is satisfied that the disclosure is no longer required;\nor\n\n(b) in a case where the authorisation is made under a journalist\ninformation warrant:\n\n(i) the warrant is revoked under subsection 180N(1); or\n\n(ii) the Director-General of Security has informed the\nMinister under section 180P that the Director-General is\nsatisfied that the grounds on which the warrant was\nissued have ceased to exist.\nNote:\nSection 184 deals with notification of authorisations.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6f-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6f-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "511618a3fde04be6ff2f92ad1f000a747162a03920c616fcc7d8bf77116f21dc",
      "skos:note": "Must revoke authorisation under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6f",
      "@type": "cof:Section",
      "cof:title": "6F Subsection 176(6)",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "Repeal the subsection, substitute:\nRevoking the authorisation\n\n(6) An eligible person must revoke the authorisation if:\n\n(a) he or she is satisfied that the disclosure is no longer required;\nor\n\n(b) in a case where the authorisation is made under a journalist\ninformation warrant:\n\n(i) the warrant is revoked under subsection 180N(1); or\n\n(ii) the Director-General of Security has informed the\nMinister under section 180P that the Director-General is\nsatisfied that the grounds on which the warrant was\nissued have ceased to exist.\nNote:\nSection 184 deals with notification of authorisations."
    },
    {
