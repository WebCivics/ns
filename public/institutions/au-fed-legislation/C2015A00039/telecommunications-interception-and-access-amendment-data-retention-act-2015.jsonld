      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.40",
      "values:originalText": "(1) The Director-General of Security may request the Minister to issue\na journalist information warrant in relation to a particular person.\n\n(2) The request must specify the facts and other grounds on which the\nDirector-General considers it necessary that the warrant be issued.",
      "skos:definition": "(1) The Director-General of Security may request the Minister to issue\na journalist information warrant in relation to a particular person.\n\n(2) The request must specify the facts and other grounds on which the\nDirector-General considers it necessary that the warrant be issued.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180j-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180j-ss-2"
        }
      ],
      "cml:integrityHash": "431d1d5261b5c1af250272514483df0775f634e2565d885204fd2fa8f26688cc"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180j",
      "@type": "cof:Section",
      "cof:title": "180J Requesting a journalist information warrant",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "(1) The Director-General of Security may request the Minister to issue\na journalist information warrant in relation to a particular person.\n\n(2) The request must specify the facts and other grounds on which the\nDirector-General considers it necessary that the warrant be issued."
    },
