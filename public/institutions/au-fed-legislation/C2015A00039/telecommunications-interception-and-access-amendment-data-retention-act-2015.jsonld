    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180w",
      "@type": "cml:Concept",
      "skos:prefLabel": "180W Revocation of a journalist information warrant by chief",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.48",
      "values:originalText": "officer\n\n(1) The chief officer of an enforcement agency:\n\n(a) may, at any time, by signed writing, revoke a journalist\ninformation warrant issued under this Subdivision to the\nagency; and\n\n(b) must do so, if he or she is satisfied that the grounds on which\nthe warrant was issued to the agency have ceased to exist.\n\n(2) The chief officer of an enforcement agency may delegate his or her\npower under paragraph (1)(a) to a certifying officer of the agency.\nSubdivision D—Miscellaneous",
      "skos:definition": "officer\n\n(1) The chief officer of an enforcement agency:\n\n(a) may, at any time, by signed writing, revoke a journalist\ninformation warrant issued under this Subdivision to the\nagency; and\n\n(b) must do so, if he or she is satisfied that the grounds on which\nthe warrant was issued to the agency have ceased to exist.\n\n(2) The chief officer of an enforcement agency may delegate his or her\npower under paragraph (1)(a) to a certifying officer of the agency.\nSubdivision D—Miscellaneous",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180w-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180w-ss-2"
        }
      ],
      "cml:integrityHash": "d71f0bd623e5e0b40eb4b4355091d057d5e40644e1e6cda16b33213f8ae7541f"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180w",
      "@type": "cof:Section",
      "cof:title": "180W Revocation of a journalist information warrant by chief",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "officer\n\n(1) The chief officer of an enforcement agency:\n\n(a) may, at any time, by signed writing, revoke a journalist\ninformation warrant issued under this Subdivision to the\nagency; and\n\n(b) must do so, if he or she is satisfied that the grounds on which\nthe warrant was issued to the agency have ceased to exist.\n\n(2) The chief officer of an enforcement agency may delegate his or her\npower under paragraph (1)(a) to a certifying officer of the agency.\nSubdivision D—Miscellaneous"
    },
