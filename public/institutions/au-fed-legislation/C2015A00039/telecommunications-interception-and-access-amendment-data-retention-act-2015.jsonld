    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Subsection 5(1) (at the end of the definition of officer)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-2-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.68",
      "values:originalText": "Add:\n\n; or (n) in the case of a criminal law-enforcement agency for which a\ndeclaration under subsection 110A(3) is in force—a person\nspecified, or of a kind specified, in the declaration to be an\nofficer of the criminal law-enforcement agency for the\npurposes of this Act; or\n\n(o) in the case of an enforcement agency for which a declaration\nunder subsection 176A(3) is in force—a person specified, or\nof a kind specified, in the declaration to be an officer of the\nenforcement agency for the purposes of this Act.",
      "skos:definition": "Add:\n\n; or (n) in the case of a criminal law-enforcement agency for which a\ndeclaration under subsection 110A(3) is in force—a person\nspecified, or of a kind specified, in the declaration to be an\nofficer of the criminal law-enforcement agency for the\npurposes of this Act; or\n\n(o) in the case of an enforcement agency for which a declaration\nunder subsection 176A(3) is in force—a person specified, or\nof a kind specified, in the declaration to be an officer of the\nenforcement agency for the purposes of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-8-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b7438c7a57456ab083a70d7cee7d55dff543576c6eee490e6f47cf64a7f78234",
      "skos:note": "Specify persons as officers for criminal law-enforcement agencies or enforcement agencies."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-2-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Subsection 5(1) (at the end of the definition of officer)",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "Add:\n\n; or (n) in the case of a criminal law-enforcement agency for which a\ndeclaration under subsection 110A(3) is in force—a person\nspecified, or of a kind specified, in the declaration to be an\nofficer of the criminal law-enforcement agency for the\npurposes of this Act; or\n\n(o) in the case of an enforcement agency for which a declaration\nunder subsection 176A(3) is in force—a person specified, or\nof a kind specified, in the declaration to be an officer of the\nenforcement agency for the purposes of this Act."
    },
