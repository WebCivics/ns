    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6d",
      "@type": "cml:Concept",
      "skos:prefLabel": "6D Subsection 64(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.36",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) A person, being the Director-General of Security or an ASIO\nemployee, ASIO affiliate or IGIS official, may:\n\n(a) in connection with the performance by the Organisation of its\nfunctions; or\n\n(b) in connection with the performance by the Inspector-General\nof Intelligence and Security of his or her functions;\ncommunicate to another such person, make use of, or make a\nrecord of, foreign intelligence information.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) A person, being the Director-General of Security or an ASIO\nemployee, ASIO affiliate or IGIS official, may:\n\n(a) in connection with the performance by the Organisation of its\nfunctions; or\n\n(b) in connection with the performance by the Inspector-General\nof Intelligence and Security of his or her functions;\ncommunicate to another such person, make use of, or make a\nrecord of, foreign intelligence information.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6d-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "77654dfddc91dc9b5c04993033e1e4a1dbd417f451ec2d9f9a15f8bff2485a6d",
      "skos:note": "Allow communication with foreign intelligence information"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6d",
      "@type": "cof:Section",
      "cof:title": "6D Subsection 64(2)",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) A person, being the Director-General of Security or an ASIO\nemployee, ASIO affiliate or IGIS official, may:\n\n(a) in connection with the performance by the Organisation of its\nfunctions; or\n\n(b) in connection with the performance by the Inspector-General\nof Intelligence and Security of his or her functions;\ncommunicate to another such person, make use of, or make a\nrecord of, foreign intelligence information."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6d-norm",
      "@type": "values:Permission",
