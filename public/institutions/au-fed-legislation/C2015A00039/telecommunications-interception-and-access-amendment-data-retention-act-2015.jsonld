    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-3-sec-186j",
      "@type": "cml:Concept",
      "skos:prefLabel": "186J Reports",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-3-sec-186j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.87",
      "values:originalText": "(1) The Ombudsman must report to the Minister, in writing, about the\nresults of inspections under section 186B of the records of agencies\nduring a financial year.\n\n(2) The report under subsection (1) must be given to the Minister as\nsoon as practicable after the end of the financial year.\n\n(3) The Minister must cause a copy of the report to be laid before each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives it.\n\n(4) The Ombudsman may report to the Minister in writing at any time\nabout the results of an inspection under this Chapter and must do\nso if so requested by the Minister.\n\n(5) If, as a result of an inspection under this Chapter of the records of\nan enforcement agency, the Ombudsman is of the opinion that an\nofficer of the agency has contravened a provision of this Act, the\nOmbudsman may include in his or her report on the inspection a\nreport on the contravention.\nComLaw Authoritative Act C2015A00039\n\nSchedule 3  Oversight by the Commonwealth Ombudsman",
      "skos:definition": "(1) The Ombudsman must report to the Minister, in writing, about the\nresults of inspections under section 186B of the records of agencies\nduring a financial year.\n\n(2) The report under subsection (1) must be given to the Minister as\nsoon as practicable after the end of the financial year.\n\n(3) The Minister must cause a copy of the report to be laid before each\nHouse of the Parliament within 15 sitting days of that House after\nthe Minister receives it.\n\n(4) The Ombudsman may report to the Minister in writing at any time\nabout the results of an inspection under this Chapter and must do\nso if so requested by the Minister.\n\n(5) If, as a result of an inspection under this Chapter of the records of\nan enforcement agency, the Ombudsman is of the opinion that an\nofficer of the agency has contravened a provision of this Act, the\nOmbudsman may include in his or her report on the inspection a\nreport on the contravention.\nComLaw Authoritative Act C2015A00039\n\nSchedule 3  Oversight by the Commonwealth Ombudsman",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-3-sec-186j-ss-1"
        },
        {
