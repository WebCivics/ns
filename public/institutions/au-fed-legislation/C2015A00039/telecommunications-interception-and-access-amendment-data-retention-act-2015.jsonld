    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180k",
      "@type": "cml:Concept",
      "skos:prefLabel": "180K Further information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.40",
      "values:originalText": "(1) The Minister may require the Director-General of Security to give\nto the Minister, within the period specified in the requirement,\nfurther information in connection with a request under this\nSubdivision.\n\n(2) If the Director-General breaches the requirement, the Minister\nmay:\n\n(a) refuse to consider the request; or\n\n(b) refuse to take any action, or any further action, in relation to\nthe request.",
      "skos:definition": "(1) The Minister may require the Director-General of Security to give\nto the Minister, within the period specified in the requirement,\nfurther information in connection with a request under this\nSubdivision.\n\n(2) If the Director-General breaches the requirement, the Minister\nmay:\n\n(a) refuse to consider the request; or\n\n(b) refuse to take any action, or any further action, in relation to\nthe request.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180k-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180k-ss-2"
        }
      ],
      "cml:integrityHash": "317649265cc33b433438792194ad8b3e5b42f79c0c923e6dc73e81c3a88da877"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180k",
      "@type": "cof:Section",
      "cof:title": "180K Further information",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "(1) The Minister may require the Director-General of Security to give\nto the Minister, within the period specified in the requirement,\nfurther information in connection with a request under this\nSubdivision.\n\n(2) If the Director-General breaches the requirement, the Minister\nmay:\n\n(a) refuse to consider the request; or\n\n(b) refuse to take any action, or any further action, in relation to\nthe request."
    },
