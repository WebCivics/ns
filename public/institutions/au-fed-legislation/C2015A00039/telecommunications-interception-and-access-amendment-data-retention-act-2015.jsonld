      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-1f",
      "@type": "cml:Concept",
      "skos:prefLabel": "1F After paragraph 29(1)(bb)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-1f"
      },
      "cml:curationStatus": {
