    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Existing stored communications warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-2-sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.74",
      "values:originalText": "If:\n\n(a) a stored communications warrant was issued to an authority\nor body before the commencement of this Schedule; and\n\n(b) the warrant was in force immediately before that\ncommencement; and\n\n(c) on that commencement, the authority or body is not a\ncriminal law-enforcement agency (whether or not it is an\nenforcement agency);\nafter that commencement, the warrant continues in force, and Chapter 3\nof the Telecommunications (Interception and Access) Act 1979 as\namended by this Act continues to apply in relation to the warrant, as if\nthe authority or body were a criminal law-enforcement agency.",
      "skos:definition": "If:\n\n(a) a stored communications warrant was issued to an authority\nor body before the commencement of this Schedule; and\n\n(b) the warrant was in force immediately before that\ncommencement; and\n\n(c) on that commencement, the authority or body is not a\ncriminal law-enforcement agency (whether or not it is an\nenforcement agency);\nafter that commencement, the warrant continues in force, and Chapter 3\nof the Telecommunications (Interception and Access) Act 1979 as\namended by this Act continues to apply in relation to the warrant, as if\nthe authority or body were a criminal law-enforcement agency.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-49-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-49-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d4097cbc90a532af1bec022c0071c7eb12ef2af1ca560820b7cc88ade6a63c51",
      "skos:note": "Existing stored communications warrants continue in force after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-2-sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Existing stored communications warrants",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "If:\n\n(a) a stored communications warrant was issued to an authority\nor body before the commencement of this Schedule; and\n\n(b) the warrant was in force immediately before that\ncommencement; and\n\n(c) on that commencement, the authority or body is not a\ncriminal law-enforcement agency (whether or not it is an\nenforcement agency);\nafter that commencement, the warrant continues in force, and Chapter 3\nof the Telecommunications (Interception and Access) Act 1979 as\namended by this Act continues to apply in relation to the warrant, as if\nthe authority or body were a criminal law-enforcement agency."
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-2-sec-49-norm",
