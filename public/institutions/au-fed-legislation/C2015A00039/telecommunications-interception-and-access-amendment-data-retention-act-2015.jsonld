    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Subsection 105(5A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.31",
      "values:originalText": "Repeal the subsection, substitute:\n\n(5A) The ACMA must monitor, and report each financial year to the\nMinister on:\n\n(a) the operation of Part 14 and on the costs of compliance with\nthe requirements of that Part; and\n\n(b) without limiting paragraph (a), the costs of compliance with\nthe requirements of Part 5-1A of the Telecommunications\n(Interception and Access) Act 1979 (about data retention).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(5A) The ACMA must monitor, and report each financial year to the\nMinister on:\n\n(a) the operation of Part 14 and on the costs of compliance with\nthe requirements of that Part; and\n\n(b) without limiting paragraph (a), the costs of compliance with\nthe requirements of Part 5-1A of the Telecommunications\n(Interception and Access) Act 1979 (about data retention).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-3-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c9e7391f4f88680f64e5e890b2926ab5af6f0ceb2a1b010a78b9fb83426dc5e",
      "skos:note": "Monitor and report on compliance costs"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Subsection 105(5A)",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Repeal the subsection, substitute:\n\n(5A) The ACMA must monitor, and report each financial year to the\nMinister on:\n\n(a) the operation of Part 14 and on the costs of compliance with\nthe requirements of that Part; and\n\n(b) without limiting paragraph (a), the costs of compliance with\nthe requirements of Part 5-1A of the Telecommunications\n(Interception and Access) Act 1979 (about data retention)."
    },
    {
