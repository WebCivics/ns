    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6m",
      "@type": "cml:Concept",
      "skos:prefLabel": "6M After subparagraph 181A(3)(b)(i)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.48",
      "values:originalText": "Insert:\nComLaw Authoritative Act C2015A00039\n\nData retention  Schedule 1\nOther amendments  Part 2\n\nNo. 39, 2015\nTelecommunications (Interception and Access) Amendment (Data\nRetention) Act 2015\n\n(ia) to enable a person to comply with his or her obligations\nunder section 185D or 185E; or",
