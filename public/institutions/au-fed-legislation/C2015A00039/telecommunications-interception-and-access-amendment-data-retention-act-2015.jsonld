    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "3A After subsection 280(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.31",
      "values:originalText": "Insert:\n\n(1B) Subject to subsection (1C), paragraph (1)(b) does not apply to a\ndisclosure of information or a document if:\n\n(a) the disclosure is required or authorised because of:\n\n(i) a subpoena; or\n\n(ii) a notice of disclosure; or\n\n(iii) an order of a court;\n\nin connection with a civil proceeding; and\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention",
      "skos:definition": "Insert:\n\n(1B) Subject to subsection (1C), paragraph (1)(b) does not apply to a\ndisclosure of information or a document if:\n\n(a) the disclosure is required or authorised because of:\n\n(i) a subpoena; or\n\n(ii) a notice of disclosure; or\n\n(iii) an order of a court;\n\nin connection with a civil proceeding; and\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-3a-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-3a-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-3a-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "fa7fa7dbf9f5275881cbfe830ddcbfdaa43258507f3aaf7a7ab8a16c6045b3cc",
      "skos:note": "Disclosure of information or document not prohibited in certain circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-3a",
      "@type": "cof:Section",
      "cof:title": "3A After subsection 280(1A)",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Insert:\n\n(1B) Subject to subsection (1C), paragraph (1)(b) does not apply to a\ndisclosure of information or a document if:\n\n(a) the disclosure is required or authorised because of:\n\n(i) a subpoena; or\n\n(ii) a notice of disclosure; or\n\n(iii) an order of a court;\n\nin connection with a civil proceeding; and\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention"
    },
