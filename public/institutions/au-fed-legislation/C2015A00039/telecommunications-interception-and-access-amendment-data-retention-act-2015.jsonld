    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180u-ss-5",
      "@type": "cof:Section",
      "cof:title": "180U(5) Form and content of a journalist information warrant",
      "values:kind": "subsection",
