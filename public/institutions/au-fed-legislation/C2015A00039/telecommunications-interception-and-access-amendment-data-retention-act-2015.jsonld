    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Subsection 5(1)",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "Insert:\nDefence Minister has the same meaning as in the Intelligence\nServices Act 2001.\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention"
