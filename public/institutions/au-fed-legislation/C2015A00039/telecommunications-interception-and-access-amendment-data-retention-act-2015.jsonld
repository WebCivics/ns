      "cml:integrityHash": "24cefa7a50b051ab917424b4ef49345404428de243276c47e29011e3c36e508c",
      "skos:note": "Appointment ceases if the person ceases to be appointable or is revoked by writing."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6dc-ss-3",
      "@type": "cof:Section",
      "cof:title": "6DC(3) Part 4-1 issuing authorities",
      "values:kind": "subsection",
      "cof:pageNumber": 35,
      "values:originalText": "(3) A person’s appointment ceases to have effect if:\n\n(a) the person ceases to be a person whom the Minister could\nappoint under this section; or\n\n(b) the Minister, by writing, revokes the appointment."
    },
