    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-6g",
      "@type": "cml:Concept",
      "skos:prefLabel": "6G Paragraph 180(6)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
