    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-3-sec-186c",
      "@type": "cml:Concept",
      "skos:prefLabel": "186C Power to obtain relevant information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-3-sec-186c"
      },
      "cml:curationStatus": {
