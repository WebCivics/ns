      "cml:integrityHash": "ea2267ffc5dc9d35b9f9e330a8e6dbcfdcc15ce4c22c95b8b21063744cb1a05d",
      "skos:note": "Ombudsman must provide information to State if necessary for inspecting authority's functions."
    },
    {
