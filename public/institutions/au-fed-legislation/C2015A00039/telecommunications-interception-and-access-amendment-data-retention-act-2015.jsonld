        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.44",
      "values:originalText": "A journalist information warrant issued under section 180L must\nspecify the period (not exceeding 6 months) for which it is to\nremain in force. The Minister may revoke the warrant at any time\nbefore the end of the specified period.",
      "skos:definition": "A journalist information warrant issued under section 180L must\nspecify the period (not exceeding 6 months) for which it is to\nremain in force. The Minister may revoke the warrant at any time\nbefore the end of the specified period.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180n-norm"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180n-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e4f9c4ceff1b5dc25db89a1ebfb983d6ed178d99a4d284552c36eaadc91187da",
      "skos:note": "The Minister must revoke a journalist information warrant before its specified period ends."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180n",
      "@type": "cof:Section",
      "cof:title": "180N Duration of a journalist information warrant",
      "values:kind": "section",
