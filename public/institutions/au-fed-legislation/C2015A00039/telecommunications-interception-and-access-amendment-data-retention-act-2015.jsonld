      ],
      "cml:integrityHash": "5e23670618734f3b7fe4b027e43834567991b80bbde33483c763d15cc5572755",
      "skos:note": "Entry into force of a journalist information warrant"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180v",
      "@type": "cof:Section",
      "cof:title": "180V Entry into force of a journalist information warrant",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "A journalist information warrant issued under this Subdivision\ncomes into force when it is issued.\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention"
    },
    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180v-norm",
