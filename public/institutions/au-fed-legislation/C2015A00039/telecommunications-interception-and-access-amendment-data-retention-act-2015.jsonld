    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-3-sec-186f-ss-3",
      "@type": "cof:Section",
      "cof:title": "186F(3) Exchange of information between Ombudsman and State",
      "values:kind": "subsection",
      "cof:pageNumber": 86,
      "values:originalText": "(3) The Ombudsman may receive, from an inspecting authority,\ninformation relevant to the performance of the Ombudsman’s\nfunctions under this Act."
    },
