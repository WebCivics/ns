    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180s",
      "@type": "cml:Concept",
      "skos:prefLabel": "180S Oaths and affirmations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180s"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.45",
      "values:originalText": "(1) Information given to the Part 4-1 issuing authority in connection\nwith the application must be verified on oath or affirmation.\n\n(2) For the purposes of this section, the Part 4-1 issuing authority may:\n\n(a) administer an oath or affirmation; or\n\n(b) authorise another person to administer an oath or affirmation.\nThe oath or affirmation may be administered in person, or by\ntelephone, video call, video link or audio link.\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention",
      "skos:definition": "(1) Information given to the Part 4-1 issuing authority in connection\nwith the application must be verified on oath or affirmation.\n\n(2) For the purposes of this section, the Part 4-1 issuing authority may:\n\n(a) administer an oath or affirmation; or\n\n(b) authorise another person to administer an oath or affirmation.\nThe oath or affirmation may be administered in person, or by\ntelephone, video call, video link or audio link.\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180s-ss-1"
        },
        {
          "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-180s-ss-2"
        }
      ],
      "cml:integrityHash": "d8467f7f3c8494f4a1b3cbbb6158fad6d973a624300e4e2042a2b8b798c55db2"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-180s",
      "@type": "cof:Section",
      "cof:title": "180S Oaths and affirmations",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "(1) Information given to the Part 4-1 issuing authority in connection\nwith the application must be verified on oath or affirmation.\n\n(2) For the purposes of this section, the Part 4-1 issuing authority may:\n\n(a) administer an oath or affirmation; or\n\n(b) authorise another person to administer an oath or affirmation.\nThe oath or affirmation may be administered in person, or by\ntelephone, video call, video link or audio link.\nComLaw Authoritative Act C2015A00039\n\nSchedule 1  Data retention"
    },
