    {
      "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187b-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "187B(7) Certain service providers not covered by this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-187b-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf"
      },
      "dc:source": "telecommunications-interception-and-access-amendment-data-retention-act-2015.pdf, p.14",
      "values:originalText": "(7) As soon as practicable after receiving the notice under\nsubsection (6), the Minister must give written notice of the\ndeclaration to the Parliamentary Joint Committee on Intelligence\nand Security.",
      "skos:definition": "(7) As soon as practicable after receiving the notice under\nsubsection (6), the Minister must give written notice of the\ndeclaration to the Parliamentary Joint Committee on Intelligence\nand Security.",
      "values:partOf": {
        "@id": "concept:telecommunications-interception-and-access-amendment-data-retention-act-2015-sch-1-sec-187b"
      },
      "cml:asserts": [
