      "skos:note": "Must revoke authorisation if disclosure is no longer required"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-interception-and-access-amendment-data-retention-act-2015#sch-1-sec-6h",
      "@type": "cof:Section",
