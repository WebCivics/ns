concept:crimes-legislation-amendment-penalty-unit-act-2015-sch-1-sec-3 a cml:Concept ;
    skos:prefLabel "3 Subsection 4AA(1A)"@en ;
    cml:realizedBy doc:sch-1-sec-3 ;
    values:originalText "Repeal the subsection, substitute:  (1A) If the amount of a penalty unit is indexed under subsection (3), the Minister must, by notifiable instrument, publish the amount of a penalty unit. However, a failure by the Minister to do so does not invalidate the indexation." ;
    skos:definition "Repeal the subsection, substitute:  (1A) If the amount of a penalty unit is indexed under subsection (3), the Minister must, by notifiable instrument, publish the amount of a penalty unit. However, a failure by the Minister to do so does not invalidate the indexation."@en ;
    cml:integrityHash "d0428f2151c58f5886bf8769d8b23aeb85429b4544d6c6e4bd17dd56c872762a" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Publish penalty unit amount by notifiable instrument." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
