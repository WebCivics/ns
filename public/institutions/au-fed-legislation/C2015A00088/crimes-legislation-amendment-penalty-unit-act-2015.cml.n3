doc:sch-1-sec-4-ss-6 a cof:Section ;
    cof:title "4(6) At the end of section 4AA" ;
    values:kind "subsection" ;
    values:originalText "(6) Amounts worked out under subsection (3) are to be rounded to the nearest whole dollar (rounding 50 cents upwards)." ;
    cof:pageNumber "7"^^xsd:integer .

concept:crimes-legislation-amendment-penalty-unit-act-2015-sch-1-sec-4-ss-7 a cml:Concept ;
    skos:prefLabel "4(7) At the end of section 4AA"@en ;
    cml:realizedBy doc:sch-1-sec-4-ss-7 ;
    values:originalText "(7) Calculations under subsection (4):  (a) are to be made using only the index numbers published in terms of the most recently published index reference period; and  (b) are to be made disregarding index numbers that are published in substitution for previously published index numbers (except where the substituted numbers are published to take account of changes in the index reference period). Application of indexed penalty unit" ;
    skos:definition "(7) Calculations under subsection (4):  (a) are to be made using only the index numbers published in terms of the most recently published index reference period; and  (b) are to be made disregarding index numbers that are published in substitution for previously published index numbers (except where the substituted numbers are published to take account of changes in the index reference period). Application of indexed penalty unit"@en ;
