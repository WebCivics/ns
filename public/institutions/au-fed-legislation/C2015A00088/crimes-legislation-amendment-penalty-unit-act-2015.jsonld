      },
      "dc:source": "crimes-legislation-amendment-penalty-unit-act-2015.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2015A00088\n\nAmendments  Schedule 1\n\nNo. 88, 2015\nCrimes Legislation Amendment (Penalty Unit) Act 2015",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2015A00088\n\nAmendments  Schedule 1\n\nNo. 88, 2015\nCrimes Legislation Amendment (Penalty Unit) Act 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-penalty-unit-act-2015-sec-3-norm"
        }
      ],
      "cml:integrityHash": "813ef7108a5d5c3f28e03e5556576954b9ca766d69077d409cf68183498f9ee7",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
