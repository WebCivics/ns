      },
      "cml:operator": "=",
      "cml:premiseText": "(d) that a substance is a border controlled drug or border controlled plant (a physical element of an offence against Subdivision A, B or C of Division 307 or section 309.12 or"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-309-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A plant is a controlled plant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
