concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-9-sec-20bz-ss-4 a cml:Concept ;
    skos:prefLabel "20BZ(4) Definitions"@en ;
    cml:realizedBy doc:sch-9-sec-20bz-ss-4 ;
    values:originalText "(4) A person given a notice under subsection (3) must, as soon as practicable after the notice is given, comply with it to the extent that he or she has, or can reasonably acquire, the information." ;
    skos:definition "(4) A person given a notice under subsection (3) must, as soon as practicable after the notice is given, comply with it to the extent that he or she has, or can reasonably acquire, the information."@en ;
