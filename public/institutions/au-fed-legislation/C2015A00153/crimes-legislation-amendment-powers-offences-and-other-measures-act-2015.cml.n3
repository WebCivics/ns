concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-12 a cml:Concept ;
    skos:prefLabel "12 Transitional provision for approved examiners"@en ;
    cml:realizedBy doc:sch-14-sec-12 ;
    values:originalText "A person who was an approved examiner for the purposes of the Proceeds of Crime Act 2002 immediately before the commencement of this Part is taken to have been appointed under subsection 183(5) of that Act on the commencement of this Part. This does not prevent later resignation or revocation of the appointment. ComLaw Authoritative Act C2015A00153  Schedule 14  Proceeds of crime—other matters" ;
    skos:definition "A person who was an approved examiner for the purposes of the Proceeds of Crime Act 2002 immediately before the commencement of this Part is taken to have been appointed under subsection 183(5) of that Act on the commencement of this Part. This does not prevent later resignation or revocation of the appointment. ComLaw Authoritative Act C2015A00153  Schedule 14  Proceeds of crime—other matters"@en ;
    cml:integrityHash "ca17694fa0c64d195416ebaae6726bbf9d82feaa49cfc6b77b4e52909981f115" ;
    cof:pageNumber "61"^^xsd:integer ;
    skos:note "Transitional provision for approved examiners" ;
