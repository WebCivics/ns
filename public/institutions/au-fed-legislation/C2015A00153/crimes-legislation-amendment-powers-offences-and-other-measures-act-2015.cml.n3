concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-34 a cml:Concept ;
    skos:prefLabel "34 Person who refers corruption issue"@en ;
    cml:realizedBy doc:sch-11-sec-34 ;
    values:originalText "The Integrity Commissioner may advise a person (or a representative nominated by the person) of:  (a) the Integrity Commissioner’s decision under section 31 in relation to a corruption issue raised by the person in a referral under section 23; and  (b) any decision the Integrity Commissioner makes under section 42 on a reconsideration of how the corruption issue should be dealt with." ;
    skos:definition "The Integrity Commissioner may advise a person (or a representative nominated by the person) of:  (a) the Integrity Commissioner’s decision under section 31 in relation to a corruption issue raised by the person in a referral under section 23; and  (b) any decision the Integrity Commissioner makes under section 42 on a reconsideration of how the corruption issue should be dealt with."@en ;
    cml:integrityHash "416a3e7c5149a3f29b2f7a17ed915256acb80e07707eac7d4089901d544d5729" ;
    cof:pageNumber "48"^^xsd:integer ;
    skos:note "The Integrity Commissioner must advise a person or their representative on certain decisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
