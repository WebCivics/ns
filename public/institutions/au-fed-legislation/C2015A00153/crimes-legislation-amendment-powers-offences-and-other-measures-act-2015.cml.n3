doc:sch-7-sec-17-ss-5 a cof:Section ;
    cof:title "17(5) After section 19AH" ;
    values:kind "subsection" ;
    values:originalText "(5) The court may amend the sentencing order whether or not the court is constituted in the way in which it was constituted when the person was sentenced." ;
    cof:pageNumber "24"^^xsd:integer .

