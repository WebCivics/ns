concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-21 a cml:Concept ;
    skos:prefLabel "21 Before section 19AQ"@en ;
    cml:realizedBy doc:sch-7-sec-21 ;
    values:originalText "Insert: 19APB  Effect of parole order and licence on sentence  (1) If a parole order is made, or a licence is granted, in relation to a person:  (a) the person is taken to be still under sentence and not to have served the part of any sentence that remained to be served at the beginning of the parole period or licence period, until:  (i) the parole period or licence period ends without the parole order or licence being revoked; or  (ii) the person is otherwise discharged from imprisonment; and  (b) the person is taken:  (i) to have served the part of any sentence that remained to be served at the beginning of the parole period or licence period; and  (ii) to have been discharged from imprisonment;  if the parole period or licence period ends without the parole order or licence being revoked. ComLaw Authoritative Act C2015A00153  Schedule 7  Sentencing and parole" ;
    skos:definition "Insert: 19APB  Effect of parole order and licence on sentence  (1) If a parole order is made, or a licence is granted, in relation to a person:  (a) the person is taken to be still under sentence and not to have served the part of any sentence that remained to be served at the beginning of the parole period or licence period, until:  (i) the parole period or licence period ends without the parole order or licence being revoked; or  (ii) the person is otherwise discharged from imprisonment; and  (b) the person is taken:  (i) to have served the part of any sentence that remained to be served at the beginning of the parole period or licence period; and  (ii) to have been discharged from imprisonment;  if the parole period or licence period ends without the parole order or licence being revoked. ComLaw Authoritative Act C2015A00153  Schedule 7  Sentencing and parole"@en ;
    cml:integrityHash "4fb339fd827b7f202e79dabcb51e95b69142a51f12bbefb4e6ed6c1bf5864aa6" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Parole order and licence affect sentence duration" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf> ;
