concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-49 a cml:Concept ;
    skos:prefLabel "49 Savings provision—regulation"@en ;
    cml:realizedBy doc:sch-7-sec-49 ;
    values:originalText "A regulation:  (a) made for the purposes of section 20AB of the Crimes Act 1914; and  (b) in force just before the commencement of this item; has effect, from that commencement, as if it had been made for the purposes of subsection 20AB(1AA) of that Act, as amended by this Part. ComLaw Authoritative Act C2015A00153  Transfer of prisoners  Schedule 8  No. 153, 2015 Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015" ;
    skos:definition "A regulation:  (a) made for the purposes of section 20AB of the Crimes Act 1914; and  (b) in force just before the commencement of this item; has effect, from that commencement, as if it had been made for the purposes of subsection 20AB(1AA) of that Act, as amended by this Part. ComLaw Authoritative Act C2015A00153  Transfer of prisoners  Schedule 8  No. 153, 2015 Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015"@en ;
    cml:integrityHash "9a8335f53742a99680258164d0f5537ec41c80d6f89f454097dabc0cd337fbdb" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Regulation made for specific purposes has effect from commencement as if amended" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf> ;
    dc:source "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.36" ;
    cml:asserts concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-49-norm .
