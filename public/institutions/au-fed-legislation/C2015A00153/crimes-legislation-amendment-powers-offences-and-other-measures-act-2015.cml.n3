doc:sch-7-sec-28 a cof:Section ;
    cof:title "28 At the end of subsection 19AL(3)" ;
    values:kind "section" ;
    values:originalText "Add: Note 1: For when a person is released on parole in accordance with a parole order, see section 19AM. Note 2: A person released on parole must comply with any conditions of the parole order during the parole period (see sections 19AMA, 19AN and 19AU)." ;
    cof:pageNumber "29"^^xsd:integer .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-29 a cml:Concept ;
    skos:prefLabel "29 Subsection 19AL(4)"@en ;
    cml:realizedBy doc:sch-7-sec-29 ;
    values:originalText "Repeal the subsection, substitute: Person subject to State or Territory sentence  (4) Subsections (5) and (6) apply if the person is subject to a State or Territory sentence.  (5) The Attorney-General is not required to make, or to refuse to make, a parole order under subsection (1) or paragraph (2)(b) if:  (a) the State or Territory sentence is a life sentence for which a non-parole period has not been fixed; or  (b) the State or Territory sentence ends after the end of the last of the federal sentences to end; or ComLaw Authoritative Act C2015A00153  Schedule 7  Sentencing and parole" ;
    skos:definition "Repeal the subsection, substitute: Person subject to State or Territory sentence  (4) Subsections (5) and (6) apply if the person is subject to a State or Territory sentence.  (5) The Attorney-General is not required to make, or to refuse to make, a parole order under subsection (1) or paragraph (2)(b) if:  (a) the State or Territory sentence is a life sentence for which a non-parole period has not been fixed; or  (b) the State or Territory sentence ends after the end of the last of the federal sentences to end; or ComLaw Authoritative Act C2015A00153  Schedule 7  Sentencing and parole"@en ;
    cml:integrityHash "86559b18d65d7eb0758f625cfde88add80d3bffb20fe7280c5598f4d014e9963" ;
    cof:pageNumber "29"^^xsd:integer ;
