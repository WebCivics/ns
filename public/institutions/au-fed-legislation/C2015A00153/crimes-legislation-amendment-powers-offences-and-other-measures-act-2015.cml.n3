concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-3 a cml:Concept ;
    skos:prefLabel "3 Section 338 (definition of related offence)"@en ;
    cml:realizedBy doc:sch-14-sec-3 ;
    values:originalText "Repeal the definition, substitute: related offence: an offence is a related offence in relation to another offence if the physical elements of the 2 offences are:  (a) substantially the same acts or omissions; or  (b) acts or omissions in a single series." ;
    skos:definition "Repeal the definition, substitute: related offence: an offence is a related offence in relation to another offence if the physical elements of the 2 offences are:  (a) substantially the same acts or omissions; or  (b) acts or omissions in a single series."@en ;
    cml:integrityHash "9de5d08640543ae7ab7a45942836b9e1f36f84efd107ad9bf9715955dc1af241" ;
    cof:pageNumber "58"^^xsd:integer ;
    skos:note "Defines related offence in relation to another offence." ;
    cml:curationStatus cml:Proposed ;
