concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-8 a cml:Concept ;
    skos:prefLabel "8 Subsection 19AA(1)"@en ;
    cml:realizedBy doc:sch-7-sec-8 ;
    values:originalText "Repeal the subsection, substitute:  (1) A law of a State or Territory that provides for the remission or reduction of State or Territory sentences applies in the same way to the remission or reduction of a federal sentence in a prison of that State or Territory.  (1A) However, the law does not remit or reduce the non-parole period or pre-release period in respect of the federal sentence (except as provided for by subsection (4))." ;
    skos:definition "Repeal the subsection, substitute:  (1) A law of a State or Territory that provides for the remission or reduction of State or Territory sentences applies in the same way to the remission or reduction of a federal sentence in a prison of that State or Territory.  (1A) However, the law does not remit or reduce the non-parole period or pre-release period in respect of the federal sentence (except as provided for by subsection (4))."@en ;
    cml:integrityHash "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b" ;
    cof:pageNumber "20"^^xsd:integer ;
