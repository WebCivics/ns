concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-4 a cml:Concept ;
    skos:prefLabel "4 Application of new definition of related offence"@en ;
    cml:realizedBy doc:sch-14-sec-4 ;
    values:originalText "The definition of related offence in section 338 of the Proceeds of Crime Act 2002, as amended by this Division, applies in relation to:  (a) restraining orders applied for on or after the commencement of this Division; and  (b) interstate pecuniary penalty orders made on or after that commencement; whether the physical elements of either or both of the offences concerned occurred before, on or after that commencement." ;
    skos:definition "The definition of related offence in section 338 of the Proceeds of Crime Act 2002, as amended by this Division, applies in relation to:  (a) restraining orders applied for on or after the commencement of this Division; and  (b) interstate pecuniary penalty orders made on or after that commencement; whether the physical elements of either or both of the offences concerned occurred before, on or after that commencement."@en ;
    cml:integrityHash "7f71c187afba2066ce33d911550e31a50da4fdc510cb8ae4caa13396be34b371" ;
    cof:pageNumber "58"^^xsd:integer ;
    skos:note "Definition of related offence applies to certain orders and penalties" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf> ;
