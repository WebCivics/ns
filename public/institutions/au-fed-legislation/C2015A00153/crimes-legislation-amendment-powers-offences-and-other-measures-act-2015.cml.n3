concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-6 a cml:Concept ;
    skos:prefLabel "6 Subsections 17(2) and (3)"@en ;
    cml:realizedBy doc:sch-11-sec-6 ;
    values:originalText "Repeal the subsections, substitute:  (2) The Integrity Commissioner may revoke the agreement by written notice given to the head of the agency. The revocation takes effect on a day specified in the notice, which must be at least 14 days after the day it is given.  (3) Without limiting subsection (1), the agreement may set out how it may be varied and other ways how it may be revoked." ;
    skos:definition "Repeal the subsections, substitute:  (2) The Integrity Commissioner may revoke the agreement by written notice given to the head of the agency. The revocation takes effect on a day specified in the notice, which must be at least 14 days after the day it is given.  (3) Without limiting subsection (1), the agreement may set out how it may be varied and other ways how it may be revoked."@en ;
    cml:integrityHash "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d" ;
    cof:pageNumber "46"^^xsd:integer ;
