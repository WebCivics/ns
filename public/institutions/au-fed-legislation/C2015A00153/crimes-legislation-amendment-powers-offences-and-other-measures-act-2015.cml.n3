doc:sch-14-sec-11-ss-6 a cof:Section ;
    cof:title "11(6) Subsection 183(4)" ;
    values:kind "subsection" ;
    values:originalText "(6) An *approved examiner may resign his or her appointment by giving the Minister a written resignation. The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day." ;
    cof:pageNumber "61"^^xsd:integer .

