concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-28 a cml:Concept ;
    skos:prefLabel "28 At the end of subsection 19AL(3)"@en ;
    cml:realizedBy doc:sch-7-sec-28 ;
    values:originalText "Add: Note 1: For when a person is released on parole in accordance with a parole order, see section 19AM. Note 2: A person released on parole must comply with any conditions of the parole order during the parole period (see sections 19AMA, 19AN and 19AU)." ;
    skos:definition "Add: Note 1: For when a person is released on parole in accordance with a parole order, see section 19AM. Note 2: A person released on parole must comply with any conditions of the parole order during the parole period (see sections 19AMA, 19AN and 19AU)."@en ;
    cml:integrityHash "d157cf26fdc1f9186489fec614eb43d7043af5be10c59c1c89e69e66406fd374" ;
    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Compliance with parole conditions is mandatory." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
