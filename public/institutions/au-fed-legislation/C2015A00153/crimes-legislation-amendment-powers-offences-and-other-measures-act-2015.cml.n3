concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sec-5 a cml:Concept ;
    skos:prefLabel "5 Schedule 15,"@en ;
    cml:realizedBy doc:sec-5 ;
    values:originalText "item 53 The later of: (a) the start of the day after this Act receives the Royal Assent; and (b) immediately after the commencement of item 3 of Schedule 2 to the Telecommunications (Interception and Access) Amendment (Data Retention) Act 2015. However, the provision does not commence at all if the event mentioned in paragraph (b) does not occur." ;
    skos:definition "item 53 The later of: (a) the start of the day after this Act receives the Royal Assent; and (b) immediately after the commencement of item 3 of Schedule 2 to the Telecommunications (Interception and Access) Amendment (Data Retention) Act 2015. However, the provision does not commence at all if the event mentioned in paragraph (b) does not occur."@en ;
    cml:integrityHash "7cd366ab59023733a43e7015f26830f33a3b3f0e78b7e5c19051695d804b6a28" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Conditional commencement of Schedule 15 item 53" ;
