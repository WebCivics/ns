concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-31 a cml:Concept ;
    skos:prefLabel "31 Savings provision"@en ;
    cml:realizedBy doc:sch-7-sec-31 ;
    values:originalText "(1) A parole order:  (a) made under section 19AL of the Crimes Act 1914; and  (b) in force just before the commencement of this item; has effect, from that commencement, as if it had been made under that section as amended by this Part. (2) A decision:  (a) made by the Attorney-General under section 19AL of the Crimes Act 1914 before the commencement of this item; and  (b)  not revoked before that commencement; has effect, from that commencement, as if it had been made under that section as amended by this Part. ComLaw Authoritative Act C2015A00153  Sentencing and parole  Schedule 7 Early release on parole  Part 8  No. 153, 2015 Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015" ;
    skos:definition "(1) A parole order:  (a) made under section 19AL of the Crimes Act 1914; and  (b) in force just before the commencement of this item; has effect, from that commencement, as if it had been made under that section as amended by this Part. (2) A decision:  (a) made by the Attorney-General under section 19AL of the Crimes Act 1914 before the commencement of this item; and  (b)  not revoked before that commencement; has effect, from that commencement, as if it had been made under that section as amended by this Part. ComLaw Authoritative Act C2015A00153  Sentencing and parole  Schedule 7 Early release on parole  Part 8  No. 153, 2015 Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015"@en ;
    cml:integrityHash "01719b1eb4b78317e28830baba519a58c0ffb28752349f4e39562a769ed59309" ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Savings provision for parole orders and decisions made under section 19AL of the Crimes Act 1914." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf> ;
