concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-8-sec-3 a cml:Concept ;
    skos:prefLabel "3 After subsection 17(3)"@en ;
    cml:realizedBy doc:sch-8-sec-3 ;
    values:originalText "Insert:  (3A) Without limiting subsection (1) or (3), it is sufficient compliance with a transfer order if the prisoner or remand prisoner:  (a) is delivered into the custody of an escort of the State or Territory to which the prisoner is being transferred, being an escort who is authorised by the local prisons authority for that State or Territory to receive custody of the prisoner; and  (b) is so delivered into custody at a place at which the escort mentioned in paragraph (a) is authorised by the local prisons authority for that State or Territory to receive custody of the prisoner." ;
    skos:definition "Insert:  (3A) Without limiting subsection (1) or (3), it is sufficient compliance with a transfer order if the prisoner or remand prisoner:  (a) is delivered into the custody of an escort of the State or Territory to which the prisoner is being transferred, being an escort who is authorised by the local prisons authority for that State or Territory to receive custody of the prisoner; and  (b) is so delivered into custody at a place at which the escort mentioned in paragraph (a) is authorised by the local prisons authority for that State or Territory to receive custody of the prisoner."@en ;
    cml:integrityHash "d43420048c3de066c981ac23d53e7bfe9815b707d1139ccc5bfc503c1797cdde" ;
    cof:pageNumber "37"^^xsd:integer ;
    skos:note "Compliance with transfer order sufficient if delivered into custody of authorized escort." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
