doc:sch-14-sec-3-2 a cof:Section ;
    cof:title "3 Related offences" ;
    values:kind "section" ;
    values:originalText "For the purposes of this Act, 2 offences are related to each other if the physical elements of the 2 offences are:  (a) substantially the same acts or omissions; or  (b) acts or omissions in a single series." ;
    cof:pageNumber "59"^^xsd:integer .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-8 a cml:Concept ;
    skos:prefLabel "8 Application of new section 3"@en ;
    cml:realizedBy doc:sch-14-sec-8 ;
    values:originalText "Section 3 of the Crimes (Superannuation Benefits) Act 1989, as amended by this Division, applies in relation to a restraining order applied for on or after the commencement of this Division, whether the physical elements of either or both of the offences concerned occurred before, on or after that commencement. Mutual Assistance in Criminal Matters Act 1987" ;
    skos:definition "Section 3 of the Crimes (Superannuation Benefits) Act 1989, as amended by this Division, applies in relation to a restraining order applied for on or after the commencement of this Division, whether the physical elements of either or both of the offences concerned occurred before, on or after that commencement. Mutual Assistance in Criminal Matters Act 1987"@en ;
    cml:integrityHash "d0593b6febb089196ebd0d43588d813e216eeb9b30c5cb2d911de7d54bd9680b" ;
    cof:pageNumber "59"^^xsd:integer ;
    skos:note "Section applies in relation to restraining order applied for on or after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
