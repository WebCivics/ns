concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 270.7A(1) of the Criminal Code"@en ;
    cml:realizedBy doc:sch-4-sec-1 ;
    values:originalText "Repeal the subsection, substitute:  (1) A marriage is a forced marriage if one party to the marriage (the victim) entered into the marriage without freely and fully consenting:  (a) because of the use of coercion, threat or deception; or  (b) because the party was incapable of understanding the nature and effect of the marriage ceremony." ;
    skos:definition "Repeal the subsection, substitute:  (1) A marriage is a forced marriage if one party to the marriage (the victim) entered into the marriage without freely and fully consenting:  (a) because of the use of coercion, threat or deception; or  (b) because the party was incapable of understanding the nature and effect of the marriage ceremony."@en ;
    cml:integrityHash "4b15719d4023c13473990a063fe9e00a3882597014604f1a740cae168c4ced40" ;
    cof:pageNumber "14"^^xsd:integer ;
    skos:note "Forced marriage defined as a marriage where one party did not freely and fully consent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf> ;
