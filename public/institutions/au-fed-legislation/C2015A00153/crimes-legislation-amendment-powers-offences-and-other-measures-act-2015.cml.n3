doc:sch-7-sec-31 a cof:Section ;
    cof:title "31 Savings provision" ;
    values:kind "section" ;
    values:originalText "(1) A parole order:  (a) made under section 19AL of the Crimes Act 1914; and  (b) in force just before the commencement of this item; has effect, from that commencement, as if it had been made under that section as amended by this Part. (2) A decision:  (a) made by the Attorney-General under section 19AL of the Crimes Act 1914 before the commencement of this item; and  (b)  not revoked before that commencement; has effect, from that commencement, as if it had been made under that section as amended by this Part. ComLaw Authoritative Act C2015A00153  Sentencing and parole  Schedule 7 Early release on parole  Part 8  No. 153, 2015 Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015" ;
    cof:pageNumber "30"^^xsd:integer .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-32 a cml:Concept ;
    skos:prefLabel "32 After subsection 19AL(3)"@en ;
    cml:realizedBy doc:sch-7-sec-32 ;
    values:originalText "Insert:  (3A) If the Attorney-General considers that in all the circumstances it is appropriate to do so, the Attorney-General may specify in a parole order that a person is to be released from prison on a day that is before the end of the non-parole period, but is not earlier than 30 days before the end of the non-parole period." ;
    skos:definition "Insert:  (3A) If the Attorney-General considers that in all the circumstances it is appropriate to do so, the Attorney-General may specify in a parole order that a person is to be released from prison on a day that is before the end of the non-parole period, but is not earlier than 30 days before the end of the non-parole period."@en ;
    cml:integrityHash "3aedf6efdf8877ccbc9d270d78c444c232d616719859dd6d66948e9dfd6a9f5b" ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Specify release date for parole order" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
