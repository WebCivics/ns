concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-16-sec-6 a cml:Concept ;
    skos:prefLabel "6 Application"@en ;
    cml:realizedBy doc:sch-16-sec-6 ;
    values:originalText "The amendments made by this Schedule apply, in relation to an authority, to a variation that is granted on or after the day this item commences:  (a) whether the authority was granted before that day; and  (b) if the variation is the result of an application, whether the application was made before that day." ;
    skos:definition "The amendments made by this Schedule apply, in relation to an authority, to a variation that is granted on or after the day this item commences:  (a) whether the authority was granted before that day; and  (b) if the variation is the result of an application, whether the application was made before that day."@en ;
    cml:integrityHash "50e4664ec81cb6aa2be695a4c9cfdadd47f2cd7258a5bcd2542572ee0efa1ed3" ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Amendments apply to variations granted on or after the commencement day." ;
