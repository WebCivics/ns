concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-10-sec-2 a cml:Concept ;
    skos:prefLabel "2 Paragraphs 75B(6)(a) and (b)"@en ;
    cml:realizedBy doc:sch-10-sec-2 ;
    values:originalText "Repeal the paragraphs, substitute:  (a) the day the application is made;  (b) if the AUSTRAC CEO requests information under subsection 75N(1) in relation to the application—the last day such information is provided;  (c) if the person makes a submission under section 75Q in relation to the application—the day the person makes the submission." ;
    skos:definition "Repeal the paragraphs, substitute:  (a) the day the application is made;  (b) if the AUSTRAC CEO requests information under subsection 75N(1) in relation to the application—the last day such information is provided;  (c) if the person makes a submission under section 75Q in relation to the application—the day the person makes the submission."@en ;
    cml:integrityHash "2d527da7aa4f2a1f2d12a2d353965855bf7707eb86cb74cbb5670d2be43079f0" ;
