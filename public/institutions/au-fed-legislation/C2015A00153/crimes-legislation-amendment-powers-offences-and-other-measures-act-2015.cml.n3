    cof:pageNumber "38"^^xsd:integer ;
    skos:note "Request for information from a relevant person or prescribed person Authorized officer may disclose federal offender information under certain circumstances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
