concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sec-3-2 a cml:Concept ;
    skos:prefLabel "3 Schedules"@en ;
    cml:realizedBy doc:sec-3-2 ;
    values:originalText "Legislation that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule concerned, and any other item in a Schedule to this Act has effect according to its terms. ComLaw Authoritative Act C2015A00153  Schedule 1  Serious drug offences  Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015 No. 153, 2015" ;
    skos:definition "Legislation that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule concerned, and any other item in a Schedule to this Act has effect according to its terms. ComLaw Authoritative Act C2015A00153  Schedule 1  Serious drug offences  Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015 No. 153, 2015"@en ;
    cml:integrityHash "bbf4e07d9180ed67432983337b9255dfd60302ba579f458e5e036809b4faa46d" ;
    cof:pageNumber "9"^^xsd:integer ;
