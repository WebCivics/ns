concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-16-sec-7 a cml:Concept ;
    skos:prefLabel "7 Savings provision"@en ;
    cml:realizedBy doc:sch-16-sec-7 ;
    values:originalText "To avoid doubt, the amendments made by this Schedule do not affect:  (a) a controlled operation varied before the day this item commences; or  (b) any conduct engaged in in the course of, and for the purposes of, such a controlled operation. ComLaw Authoritative Act C2015A00153  Schedule 17  Technical corrections  Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015 No. 153, 2015" ;
    skos:definition "To avoid doubt, the amendments made by this Schedule do not affect:  (a) a controlled operation varied before the day this item commences; or  (b) any conduct engaged in in the course of, and for the purposes of, such a controlled operation. ComLaw Authoritative Act C2015A00153  Schedule 17  Technical corrections  Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2015 No. 153, 2015"@en ;
    cml:integrityHash "769dfab20c6afba0f0ad522bda2d8d1a78dd510eca0fca0304344022af4d3e1e" ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Exempts controlled operations from amendments." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
