concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-6 a cml:Concept ;
    skos:prefLabel "6 After subsection 19AP(4)"@en ;
    cml:realizedBy doc:sch-7-sec-6 ;
    values:originalText "Insert:  (4A) Without limiting the matters to which the Attorney-General may have regard for the purposes of subsection (4), the Attorney-General may have regard to:  (a) any extensive cooperation by the person with law enforcement agencies before sentencing that the sentencing court did not take into account; or  (b) any extensive cooperation by the person with law enforcement agencies after sentencing; or  (c) any serious medical condition the person has that cannot adequately be treated or managed within the prison system." ;
    skos:definition "Insert:  (4A) Without limiting the matters to which the Attorney-General may have regard for the purposes of subsection (4), the Attorney-General may have regard to:  (a) any extensive cooperation by the person with law enforcement agencies before sentencing that the sentencing court did not take into account; or  (b) any extensive cooperation by the person with law enforcement agencies after sentencing; or  (c) any serious medical condition the person has that cannot adequately be treated or managed within the prison system."@en ;
    cml:integrityHash "d647581b31152b6ed03fda22cf3c2150edca24ce43212bf904d3bfa0eeed8ae4" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Attorney-General may have regard to cooperation with law enforcement agencies and serious medical conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
