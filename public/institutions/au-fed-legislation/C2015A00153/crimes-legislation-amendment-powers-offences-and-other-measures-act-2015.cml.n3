concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-19 a cml:Concept ;
    skos:prefLabel "19 Before section 19AL"@en ;
    cml:realizedBy doc:sch-7-sec-19 ;
    values:originalText "Insert: Subdivision A—Release on parole or licence 19AKA  Purposes of parole  The purposes of parole are the following:  (a) the protection of the community;  (b) the rehabilitation of the offender;  (c) the reintegration of the offender into the community." ;
    skos:definition "Insert: Subdivision A—Release on parole or licence 19AKA  Purposes of parole  The purposes of parole are the following:  (a) the protection of the community;  (b) the rehabilitation of the offender;  (c) the reintegration of the offender into the community."@en ;
