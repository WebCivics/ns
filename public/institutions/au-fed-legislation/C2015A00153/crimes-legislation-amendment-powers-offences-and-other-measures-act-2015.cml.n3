    cof:title "20BZ(4) Definitions" ;
    values:kind "subsection" ;
    values:originalText "(4) A person given a notice under subsection (3) must, as soon as practicable after the notice is given, comply with it to the extent that he or she has, or can reasonably acquire, the information." ;
    cof:pageNumber "38"^^xsd:integer .

