doc:sch-11-sec-6-ss-2 a cof:Section ;
    cof:title "6(2) Subsections 17(2) and (3)" ;
    values:kind "subsection" ;
    values:originalText "(2) The Integrity Commissioner may revoke the agreement by written notice given to the head of the agency. The revocation takes effect on a day specified in the notice, which must be at least 14 days after the day it is given." ;
    cof:pageNumber "46"^^xsd:integer .

