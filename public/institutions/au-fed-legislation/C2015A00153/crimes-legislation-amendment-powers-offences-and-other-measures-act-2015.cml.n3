doc:sch-10-sec-2 a cof:Section ;
    cof:title "2 Paragraphs 75B(6)(a) and (b)" ;
    values:kind "section" ;
    values:originalText "Repeal the paragraphs, substitute:  (a) the day the application is made;  (b) if the AUSTRAC CEO requests information under subsection 75N(1) in relation to the application—the last day such information is provided;  (c) if the person makes a submission under section 75Q in relation to the application—the day the person makes the submission." ;
    cof:pageNumber "43"^^xsd:integer .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-10-sec-3 a cml:Concept ;
    skos:prefLabel "3 Paragraphs 169(2)(c) and (d)"@en ;
    cml:realizedBy doc:sch-10-sec-3 ;
    values:originalText "Repeal the paragraphs, substitute:  (c) in civil proceedings other than:  (i) proceedings under this Act; or  (ii) proceedings under the Proceeds of Crime Act 2002 that relate to this Act; or  (d) in criminal proceedings other than:  (i) proceedings for an offence against this Act; or  (ii) proceedings for an offence against the Criminal Code that relates to this Act." ;
    skos:definition "Repeal the paragraphs, substitute:  (c) in civil proceedings other than:  (i) proceedings under this Act; or  (ii) proceedings under the Proceeds of Crime Act 2002 that relate to this Act; or  (d) in criminal proceedings other than:  (i) proceedings for an offence against this Act; or  (ii) proceedings for an offence against the Criminal Code that relates to this Act."@en ;
    cml:integrityHash "fbc1342b84ab334d020e2e2456293ce41466870b1a3a0c3f8ae6240a8fbbc257" ;
    cof:pageNumber "43"^^xsd:integer ;
    skos:note "Repeal certain paragraphs and substitute with new provisions." ;
