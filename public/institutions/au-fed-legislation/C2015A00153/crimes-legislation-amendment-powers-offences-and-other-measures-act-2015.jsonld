    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Application of new definition of related foreign serious",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-10"
