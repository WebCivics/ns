    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 At the end of section 300.5 of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.10",
      "values:originalText": "Add:\nNote:\nThis section applies to a prosecution of an ancillary offence relating to\nthis Part as well as to prosecution of a primary offence against this\nPart. This is because of:\n(a) sections 11.2, 11.2A and 11.3 (which treat certain combinations\nof physical and fault elements relating to this Part as being\noffences against this Part); and\n(b) section 11.6 (which has the effect that a reference to an offence\nagainst this Part includes a reference to an offence against\nsection 11.1 (attempt), 11.4 (incitement) or 11.5 (conspiracy) that\nrelates to this Part).",
      "skos:definition": "Add:\nNote:\nThis section applies to a prosecution of an ancillary offence relating to\nthis Part as well as to prosecution of a primary offence against this\nPart. This is because of:\n(a) sections 11.2, 11.2A and 11.3 (which treat certain combinations\nof physical and fault elements relating to this Part as being\noffences against this Part); and\n(b) section 11.6 (which has the effect that a reference to an offence\nagainst this Part includes a reference to an offence against\nsection 11.1 (attempt), 11.4 (incitement) or 11.5 (conspiracy) that\nrelates to this Part).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-1-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "a834cb3226f27814694e4fc6c2b7908492070f367e588d5a83b3279c37e096ce",
      "skos:note": "This section applies to a prosecution of an ancillary offence relating to this Part as well as to prosecution of a primary offence against this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 At the end of section 300.5 of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Add:\nNote:\nThis section applies to a prosecution of an ancillary offence relating to\nthis Part as well as to prosecution of a primary offence against this\nPart. This is because of:\n(a) sections 11.2, 11.2A and 11.3 (which treat certain combinations\nof physical and fault elements relating to this Part as being\noffences against this Part); and\n(b) section 11.6 (which has the effect that a reference to an offence\nagainst this Part includes a reference to an offence against\nsection 11.1 (attempt), 11.4 (incitement) or 11.5 (conspiracy) that\nrelates to this Part)."
    },
    {
