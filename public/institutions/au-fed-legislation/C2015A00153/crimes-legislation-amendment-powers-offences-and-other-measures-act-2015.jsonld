      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.50",
      "values:originalText": "Repeal the subsection, substitute:\nPerson who referred issue under section 23\n\n(2) The head of a law enforcement agency may keep a person (or a\nrepresentative nominated by the person) informed of the progress\nof the agency’s investigation of a corruption issue:\n\n(a) referred to the agency under paragraph 26(1)(b) or (c); and\n\n(b) raised by the person in a referral under section 23.",
      "skos:definition": "Repeal the subsection, substitute:\nPerson who referred issue under section 23\n\n(2) The head of a law enforcement agency may keep a person (or a\nrepresentative nominated by the person) informed of the progress\nof the agency’s investigation of a corruption issue:\n\n(a) referred to the agency under paragraph 26(1)(b) or (c); and\n\n(b) raised by the person in a referral under section 23.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-20-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-20-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-20-logic-linearlogic-2"
        }
      ],
      "cml:integrityHash": "560db84c99dacab4b4232af36633a14e664354ddd7538997fb30feb6cd30c429",
      "skos:note": "The head of a law enforcement agency must inform a person or their representative about the progress of an investigation."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Subsection 65(2)",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Repeal the subsection, substitute:\nPerson who referred issue under section 23\n\n(2) The head of a law enforcement agency may keep a person (or a\nrepresentative nominated by the person) informed of the progress\nof the agency’s investigation of a corruption issue:\n\n(a) referred to the agency under paragraph 26(1)(b) or (c); and\n\n(b) raised by the person in a referral under section 23."
    },
