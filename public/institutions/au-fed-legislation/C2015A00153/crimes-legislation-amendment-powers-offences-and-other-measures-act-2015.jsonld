      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.34",
      "values:originalText": "Add:\nExample: A condition under subparagraph (iv) could be that the person will\nundertake a specified counselling, education or treatment\nprogram during a specified part of, or throughout, the specified\nperiod.",
