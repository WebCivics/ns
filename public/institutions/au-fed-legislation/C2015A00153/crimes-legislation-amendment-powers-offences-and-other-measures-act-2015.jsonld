    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-15-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Paragraphs 27(1)(ba) to (bd)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-15-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
