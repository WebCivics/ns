    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.30",
      "values:originalText": "The amendments made by this Part apply in relation to a federal\nsentence if the non-parole period for the sentence ends on or after the\ncommencement of this item, whether the sentence was passed before,\non or after that commencement.",
      "skos:definition": "The amendments made by this Part apply in relation to a federal\nsentence if the non-parole period for the sentence ends on or after the\ncommencement of this item, whether the sentence was passed before,\non or after that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-30-norm"
        }
      ],
      "cml:integrityHash": "6a49cdecc9f1ea97da995c8f417f3b750fadde3235b38328d358f6be4253629e",
      "skos:note": "Amendments apply to federal sentences under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "The amendments made by this Part apply in relation to a federal\nsentence if the non-parole period for the sentence ends on or after the\ncommencement of this item, whether the sentence was passed before,\non or after that commencement."
    },
