    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Section 338 (definition of related offence)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.58",
      "values:originalText": "Repeal the definition, substitute:\nrelated offence: an offence is a related offence in relation to\nanother offence if the physical elements of the 2 offences are:\n\n(a) substantially the same acts or omissions; or\n\n(b) acts or omissions in a single series.",
      "skos:definition": "Repeal the definition, substitute:\nrelated offence: an offence is a related offence in relation to\nanother offence if the physical elements of the 2 offences are:\n\n(a) substantially the same acts or omissions; or\n\n(b) acts or omissions in a single series.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-3-norm"
        }
      ],
      "cml:integrityHash": "9de5d08640543ae7ab7a45942836b9e1f36f84efd107ad9bf9715955dc1af241",
      "skos:note": "Defines related offence in relation to another offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Section 338 (definition of related offence)",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "Repeal the definition, substitute:\nrelated offence: an offence is a related offence in relation to\nanother offence if the physical elements of the 2 offences are:\n\n(a) substantially the same acts or omissions; or\n\n(b) acts or omissions in a single series."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-3-norm",
      "@type": "values:Obligation",
