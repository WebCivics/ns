      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.79",
      "values:originalText": "The amendments made by this Schedule apply, in relation to an\nauthority, to a variation that is granted on or after the day this item\ncommences:\n\n(a) whether the authority was granted before that day; and\n\n(b) if the variation is the result of an application, whether the\napplication was made before that day.",
      "skos:definition": "The amendments made by this Schedule apply, in relation to an\nauthority, to a variation that is granted on or after the day this item\ncommences:\n\n(a) whether the authority was granted before that day; and\n\n(b) if the variation is the result of an application, whether the\napplication was made before that day.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-16-sec-6-norm"
        }
      ],
      "cml:integrityHash": "50e4664ec81cb6aa2be695a4c9cfdadd47f2cd7258a5bcd2542572ee0efa1ed3",
      "skos:note": "Amendments apply to variations granted on or after the commencement day."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-16-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Application",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "The amendments made by this Schedule apply, in relation to an\nauthority, to a variation that is granted on or after the day this item\ncommences:\n\n(a) whether the authority was granted before that day; and\n\n(b) if the variation is the result of an application, whether the\napplication was made before that day."
    },
