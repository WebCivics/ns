    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 After subsection 19AP(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.19",
      "values:originalText": "Insert:\n\n(4A) Without limiting the matters to which the Attorney-General may\nhave regard for the purposes of subsection (4), the\nAttorney-General may have regard to:\n\n(a) any extensive cooperation by the person with law\nenforcement agencies before sentencing that the sentencing\ncourt did not take into account; or\n\n(b) any extensive cooperation by the person with law\nenforcement agencies after sentencing; or\n\n(c) any serious medical condition the person has that cannot\nadequately be treated or managed within the prison system.",
      "skos:definition": "Insert:\n\n(4A) Without limiting the matters to which the Attorney-General may\nhave regard for the purposes of subsection (4), the\nAttorney-General may have regard to:\n\n(a) any extensive cooperation by the person with law\nenforcement agencies before sentencing that the sentencing\ncourt did not take into account; or\n\n(b) any extensive cooperation by the person with law\nenforcement agencies after sentencing; or\n\n(c) any serious medical condition the person has that cannot\nadequately be treated or managed within the prison system.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-6-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d647581b31152b6ed03fda22cf3c2150edca24ce43212bf904d3bfa0eeed8ae4",
      "skos:note": "Attorney-General may have regard to cooperation with law enforcement agencies and serious medical conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 After subsection 19AP(4)",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Insert:\n\n(4A) Without limiting the matters to which the Attorney-General may\nhave regard for the purposes of subsection (4), the\nAttorney-General may have regard to:\n\n(a) any extensive cooperation by the person with law\nenforcement agencies before sentencing that the sentencing\ncourt did not take into account; or\n\n(b) any extensive cooperation by the person with law\nenforcement agencies after sentencing; or\n\n(c) any serious medical condition the person has that cannot\nadequately be treated or managed within the prison system."
    },
