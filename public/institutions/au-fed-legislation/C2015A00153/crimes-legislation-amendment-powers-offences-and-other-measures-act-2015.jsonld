      },
      "cml:premiseText": "The chief officer authorises the personnel.",
      "cml:conclusionText": "An obligation to authorise is created."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-15-sec-6a-ss-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "before",
      "cml:logicSummary": "Temporal relationship between authorisation and chief officer's power",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The chief officer authorises the personnel before the end of subsection (5).",
      "cml:conclusionText": "A temporal relationship is created."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-15-sec-6a-ss-6-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implication between authorisation and chief officer's power",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the chief officer authorises the personnel, then they have the necessary authority.",
      "cml:conclusionText": "An implication is created."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-15-sec-6a-ss-6-logic-diffusion-4",
