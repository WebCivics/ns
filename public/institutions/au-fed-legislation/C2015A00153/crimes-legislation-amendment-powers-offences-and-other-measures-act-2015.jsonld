    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-3-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsections 268.74(2) and (3) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-3-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.13",
      "values:originalText": "Repeal the subsections, substitute:\n\n(2) To avoid doubt, a reference in subsection (1) to a person or persons\nwho are not taking an active part in the hostilities includes a\nreference to a person or persons who:\n\n(a) are hors de combat; or\n\n(b) are civilians, medical personnel or religious personnel who\nare not taking an active part in the hostilities; or\n\n(c) are dead.\nComLaw Authoritative Act C2015A00153\n\nSchedule 4  Forced marriage\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015",
      "skos:definition": "Repeal the subsections, substitute:\n\n(2) To avoid doubt, a reference in subsection (1) to a person or persons\nwho are not taking an active part in the hostilities includes a\nreference to a person or persons who:\n\n(a) are hors de combat; or\n\n(b) are civilians, medical personnel or religious personnel who\nare not taking an active part in the hostilities; or\n\n(c) are dead.\nComLaw Authoritative Act C2015A00153\n\nSchedule 4  Forced marriage\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-3-sec-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-3-sec-2-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-3-sec-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-3-sec-2-logic-deontic-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-3-sec-2-logic-ltl-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-3-sec-2-logic-paraconsistent-5"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-3-sec-2-logic-diffusion-6"
        }
      ],
      "cml:integrityHash": "a6e2c5f69686a23817471ea00fbd882320055e950ab5fe4fd3ebf342333ccfed",
      "skos:note": "Specify who is not taking an active part in hostilities for the purpose of subsection (1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-3-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsections 268.74(2) and (3) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the subsections, substitute:\n\n(2) To avoid doubt, a reference in subsection (1) to a person or persons\nwho are not taking an active part in the hostilities includes a\nreference to a person or persons who:\n\n(a) are hors de combat; or\n\n(b) are civilians, medical personnel or religious personnel who\nare not taking an active part in the hostilities; or\n\n(c) are dead.\nComLaw Authoritative Act C2015A00153\n\nSchedule 4  Forced marriage\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015"
    },
