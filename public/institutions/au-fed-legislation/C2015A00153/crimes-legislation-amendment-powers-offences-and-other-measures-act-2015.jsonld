    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Subsection 19AA(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.20",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A law of a State or Territory that provides for the remission or\nreduction of State or Territory sentences applies in the same way to\nthe remission or reduction of a federal sentence in a prison of that\nState or Territory.\n\n(1A) However, the law does not remit or reduce the non-parole period or\npre-release period in respect of the federal sentence (except as\nprovided for by subsection (4)).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) A law of a State or Territory that provides for the remission or\nreduction of State or Territory sentences applies in the same way to\nthe remission or reduction of a federal sentence in a prison of that\nState or Territory.\n\n(1A) However, the law does not remit or reduce the non-parole period or\npre-release period in respect of the federal sentence (except as\nprovided for by subsection (4)).",
      "cml:hasPart": [
        {
