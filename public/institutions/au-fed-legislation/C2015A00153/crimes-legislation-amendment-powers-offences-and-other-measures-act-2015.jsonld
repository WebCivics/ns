      "skos:note": "Defines 'State transfer law' for a State."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-8-sec-1",
      "@type": "cof:Section",
