        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The sentence or order under consideration may have an effect on other persons at some point",
      "cml:conclusionText": "There is an overlap between the two intervals"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-1-logic-argumentation-3",
