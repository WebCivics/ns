    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.57",
      "values:originalText": "Paragraph 330(4)(e) of the Proceeds of Crime Act 2002, as amended by\nthis Part, applies whether the forfeiture, confiscation or other disposal\noccurred before, on or after the commencement of this Part.\nComLaw Authoritative Act C2015A00153\n\nSchedule 14  Proceeds of crime—other matters",
      "skos:definition": "Paragraph 330(4)(e) of the Proceeds of Crime Act 2002, as amended by\nthis Part, applies whether the forfeiture, confiscation or other disposal\noccurred before, on or after the commencement of this Part.\nComLaw Authoritative Act C2015A00153\n\nSchedule 14  Proceeds of crime—other matters",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1b0696b9219539e7984015c53b69474a55c30addc0b1a9b7c37d7bab801a5741",
      "skos:note": "Paragraph 330(4)(e) applies regardless of when the forfeiture/disposal occurred."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Application",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "Paragraph 330(4)(e) of the Proceeds of Crime Act 2002, as amended by\nthis Part, applies whether the forfeiture, confiscation or other disposal\noccurred before, on or after the commencement of this Part.\nComLaw Authoritative Act C2015A00153\n\nSchedule 14  Proceeds of crime—other matters"
    },
    {
