    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-10-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Court obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Court must fix a single non-parole period.",
      "cml:conclusionText": "Court has an obligation to do so."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-10-ss-1-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "AND",
      "cml:logicSummary": "Combining conditions for court obligation",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Conditions (a), (b), and (c) must be met.",
      "cml:conclusionText": "The conditions are combined using the 'AND' operator."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-10-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Temporal interval for court obligation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The non-parole period is a temporal interval.",
      "cml:conclusionText": "The interval is between the start of the sentence and its completion."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-10-ss-1-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Implication of court obligation on sentencing",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the court does not fix a single non-parole period, then it is not fulfilling its obligation.",
      "cml:conclusionText": "The implication shows that the court's action is necessary to fulfill its obligation."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-10-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Implication of non-parole period on sentencing",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If a single non-parole period is not fixed, then the sentence may be longer than intended.",
      "cml:conclusionText": "The implication shows that fixing a single non-parole period is necessary to prevent this outcome."
    },
