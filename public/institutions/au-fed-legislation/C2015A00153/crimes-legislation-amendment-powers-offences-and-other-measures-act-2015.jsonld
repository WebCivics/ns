      },
      "cml:premiseText": "the corrupt conduct to which the corruption issue relates has been, is or will be, the subject of proceedings before a court",
      "cml:conclusionText": "the Integrity Commissioner may decide not to take further action"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-12-ss-8-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The Integrity Commissioner may decide not to take further action if certain conditions are met.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
