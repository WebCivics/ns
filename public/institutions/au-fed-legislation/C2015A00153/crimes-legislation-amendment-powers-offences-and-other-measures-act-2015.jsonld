    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Paragraphs 10(5)(a) and (aa)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.45",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) a person is a secondee to the AFP if the person is referred to\nin paragraph (g) of the definition of AFP appointee in\nsection 4 of the Australian Federal Police Act 1979; and\n\n(aa) a person is a secondee to the AFP if the person:\nComLaw Authoritative Act C2015A00153\n\nSchedule 11  Australian Commission for Law Enforcement Integrity\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015\n\n(i) is referred to in paragraph (c) or (d) of the definition of\nAFP appointee in section 4 of the Australian Federal\nPolice Act 1979; and\n\n(ii) is also an employee of another government agency; and",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(a) a person is a secondee to the AFP if the person is referred to\nin paragraph (g) of the definition of AFP appointee in\nsection 4 of the Australian Federal Police Act 1979; and\n\n(aa) a person is a secondee to the AFP if the person:\nComLaw Authoritative Act C2015A00153\n\nSchedule 11  Australian Commission for Law Enforcement Integrity\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015\n\n(i) is referred to in paragraph (c) or (d) of the definition of\nAFP appointee in section 4 of the Australian Federal\nPolice Act 1979; and\n\n(ii) is also an employee of another government agency; and",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-4-norm"
        }
      ],
      "cml:integrityHash": "b97ff26eebb66a665ff07873296a0c433e4657c2dab941bf638eff249a6c2f63",
      "skos:note": "Repeal and substitute paragraphs regarding AFP appointees."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Paragraphs 10(5)(a) and (aa)",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) a person is a secondee to the AFP if the person is referred to\nin paragraph (g) of the definition of AFP appointee in\nsection 4 of the Australian Federal Police Act 1979; and\n\n(aa) a person is a secondee to the AFP if the person:\nComLaw Authoritative Act C2015A00153\n\nSchedule 11  Australian Commission for Law Enforcement Integrity\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015\n\n(i) is referred to in paragraph (c) or (d) of the definition of\nAFP appointee in section 4 of the Australian Federal\nPolice Act 1979; and\n\n(ii) is also an employee of another government agency; and"
    },
