      "cml:integrityHash": "05843a04a41d96f39c7d9f37f9cf971f038f2906c2d7f94538d952dcac16e4c9",
      "skos:note": "Request for information from a relevant person or prescribed person Authorized officer may disclose federal offender information under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-9-sec-20bz-ss-1",
      "@type": "cof:Section",
      "cof:title": "20BZ(1) Definitions",
      "values:kind": "subsection",
      "cof:pageNumber": 38,
      "values:originalText": "(1) An authorised officer may disclose federal offender information to\na relevant person if the officer reasonably believes that the\ndisclosure is necessary to enable the relevant person to exercise the\nperson’s powers, or to perform the person’s functions or duties."
    },
