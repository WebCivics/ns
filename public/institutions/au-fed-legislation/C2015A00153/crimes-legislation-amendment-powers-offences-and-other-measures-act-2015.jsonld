    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.11",
      "values:originalText": "The amendments made by items 2 to 7 apply in relation to offences\nconstituted by conduct engaged in on or after the commencement of this\nSchedule.\nComLaw Authoritative Act C2015A00153\n\nSchedule 2  Bribing foreign public officials\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015",
      "skos:definition": "The amendments made by items 2 to 7 apply in relation to offences\nconstituted by conduct engaged in on or after the commencement of this\nSchedule.\nComLaw Authoritative Act C2015A00153\n\nSchedule 2  Bribing foreign public officials\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-8-norm"
        }
      ],
      "cml:integrityHash": "2693975be25dfbaaca2d08bfe77cd61a863e96d866578a20d5afbce1f3686540",
      "skos:note": "Application of amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "The amendments made by items 2 to 7 apply in relation to offences\nconstituted by conduct engaged in on or after the commencement of this\nSchedule.\nComLaw Authoritative Act C2015A00153\n\nSchedule 2  Bribing foreign public officials\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-8-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
