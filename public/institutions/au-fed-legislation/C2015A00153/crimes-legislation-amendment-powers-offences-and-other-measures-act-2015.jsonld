    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Related offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.58",
      "values:originalText": "For the purposes of this Act, 2 offences are related to each other if\nthe physical elements of the 2 offences are:\n\n(a) substantially the same acts or omissions; or\nComLaw Authoritative Act C2015A00153\n\nProceeds of crime—other matters  Schedule 14\nRelated offences  Part 2\n\nNo. 153, 2015\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\n\n(b) acts or omissions in a single series.",
      "skos:definition": "For the purposes of this Act, 2 offences are related to each other if\nthe physical elements of the 2 offences are:\n\n(a) substantially the same acts or omissions; or\nComLaw Authoritative Act C2015A00153\n\nProceeds of crime—other matters  Schedule 14\nRelated offences  Part 2\n\nNo. 153, 2015\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\n\n(b) acts or omissions in a single series.",
