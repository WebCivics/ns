      },
      "cml:premiseText": "Consider the deterrent effect on other persons",
      "cml:conclusionText": "There is an obligation to consider"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
