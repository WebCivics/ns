      "@type": "cml:Concept",
      "skos:prefLabel": "9 After subsection 31(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-9"
