      "@type": "cml:Concept",
      "skos:prefLabel": "68 Advising person who referred corruption issue of outcome of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-68"
