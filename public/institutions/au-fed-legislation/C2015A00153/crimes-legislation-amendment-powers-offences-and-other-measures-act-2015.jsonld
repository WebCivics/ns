    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-16-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Savings provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-16-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.79",
      "values:originalText": "To avoid doubt, the amendments made by this Schedule do not affect:\n\n(a) a controlled operation varied before the day this item\ncommences; or\n\n(b) any conduct engaged in in the course of, and for the purposes\nof, such a controlled operation.\nComLaw Authoritative Act C2015A00153\n\nSchedule 17  Technical corrections\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015",
      "skos:definition": "To avoid doubt, the amendments made by this Schedule do not affect:\n\n(a) a controlled operation varied before the day this item\ncommences; or\n\n(b) any conduct engaged in in the course of, and for the purposes\nof, such a controlled operation.\nComLaw Authoritative Act C2015A00153\n\nSchedule 17  Technical corrections\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-16-sec-7-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-16-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "769dfab20c6afba0f0ad522bda2d8d1a78dd510eca0fca0304344022af4d3e1e",
      "skos:note": "Exempts controlled operations from amendments."
    },
    {
