    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Transitional provision for approved examiners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.61",
      "values:originalText": "A person who was an approved examiner for the purposes of the\nProceeds of Crime Act 2002 immediately before the commencement of\nthis Part is taken to have been appointed under subsection 183(5) of that\nAct on the commencement of this Part. This does not prevent later\nresignation or revocation of the appointment.\nComLaw Authoritative Act C2015A00153\n\nSchedule 14  Proceeds of crime—other matters",
      "skos:definition": "A person who was an approved examiner for the purposes of the\nProceeds of Crime Act 2002 immediately before the commencement of\nthis Part is taken to have been appointed under subsection 183(5) of that\nAct on the commencement of this Part. This does not prevent later\nresignation or revocation of the appointment.\nComLaw Authoritative Act C2015A00153\n\nSchedule 14  Proceeds of crime—other matters",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-12-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ca17694fa0c64d195416ebaae6726bbf9d82feaa49cfc6b77b4e52909981f115",
      "skos:note": "Transitional provision for approved examiners"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Transitional provision for approved examiners",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "A person who was an approved examiner for the purposes of the\nProceeds of Crime Act 2002 immediately before the commencement of\nthis Part is taken to have been appointed under subsection 183(5) of that\nAct on the commencement of this Part. This does not prevent later\nresignation or revocation of the appointment.\nComLaw Authoritative Act C2015A00153\n\nSchedule 14  Proceeds of crime—other matters"
    },
