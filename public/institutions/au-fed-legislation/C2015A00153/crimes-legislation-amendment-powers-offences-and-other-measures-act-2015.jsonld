      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The Integrity Commissioner has an obligation to decide not to take further action if certain conditions are met.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the corruption issue is already being, or will be, investigated by a law enforcement agency; or a government agency; or an integrity agency for a State or Territory",
      "cml:conclusionText": "the Integrity Commissioner may decide not to take further action"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-12-ss-8-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The corrupt conduct to which the corruption issue relates has been, is or will be, the subject of proceedings before a court",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the corrupt conduct to which the corruption issue relates has been, is or will be, the subject of proceedings before a court"
    },
