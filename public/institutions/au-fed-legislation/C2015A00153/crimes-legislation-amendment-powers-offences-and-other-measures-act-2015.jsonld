    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 After subsection 19AL(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.31",
      "values:originalText": "Insert:\n\n(3A) If the Attorney-General considers that in all the circumstances it is\nappropriate to do so, the Attorney-General may specify in a parole\norder that a person is to be released from prison on a day that is\nbefore the end of the non-parole period, but is not earlier than 30\ndays before the end of the non-parole period.",
      "skos:definition": "Insert:\n\n(3A) If the Attorney-General considers that in all the circumstances it is\nappropriate to do so, the Attorney-General may specify in a parole\norder that a person is to be released from prison on a day that is\nbefore the end of the non-parole period, but is not earlier than 30\ndays before the end of the non-parole period.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-32-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3aedf6efdf8877ccbc9d270d78c444c232d616719859dd6d66948e9dfd6a9f5b",
      "skos:note": "Specify release date for parole order"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 After subsection 19AL(3)",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Insert:\n\n(3A) If the Attorney-General considers that in all the circumstances it is\nappropriate to do so, the Attorney-General may specify in a parole\norder that a person is to be released from prison on a day that is\nbefore the end of the non-parole period, but is not earlier than 30\ndays before the end of the non-parole period."
    },
