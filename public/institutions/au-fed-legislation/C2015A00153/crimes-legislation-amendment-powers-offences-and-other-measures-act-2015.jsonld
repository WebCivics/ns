        }
      ],
      "cml:integrityHash": "4ab6bed088294891013289a76d1f61a34bfda505a53a6d2cafc643ee8aa24e3d",
      "skos:note": "Amendment applies to sentencing orders made before, on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "The amendment made by this Part applies to a sentencing order made\nbefore, on or after the commencement of this item.\nComLaw Authoritative Act C2015A00153\n\nSchedule 7  Sentencing and parole"
    },
    {
