        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The chief officer's power diffuses to the personnel.",
      "cml:conclusionText": "Authority is diffused."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-15-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Savings provision—authorisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-15-sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.73",
      "values:originalText": "An authorisation:\n\n(a) made under section 6A of the Surveillance Devices Act 2004;\nand\n\n(b) in force just before the commencement of this item;\nis taken, from that commencement, to have been made under\nsubsection 6A(5) of that Act, as amended by this Part.",
      "skos:definition": "An authorisation:\n\n(a) made under section 6A of the Surveillance Devices Act 2004;\nand\n\n(b) in force just before the commencement of this item;\nis taken, from that commencement, to have been made under\nsubsection 6A(5) of that Act, as amended by this Part.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-15-sec-30-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-15-sec-30-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-15-sec-30-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "65483fb43ad6e3432e1918032eaba4f6dc722136dc7caea9358d7bf8af65b9b0",
      "skos:note": "Authorisation taken into force upon commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-15-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Savings provision—authorisations",
      "values:kind": "section",
      "cof:pageNumber": 73,
      "values:originalText": "An authorisation:\n\n(a) made under section 6A of the Surveillance Devices Act 2004;\nand\n\n(b) in force just before the commencement of this item;\nis taken, from that commencement, to have been made under\nsubsection 6A(5) of that Act, as amended by this Part."
    },
