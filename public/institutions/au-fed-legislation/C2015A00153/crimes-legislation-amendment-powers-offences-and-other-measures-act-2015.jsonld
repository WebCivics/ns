    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 270.7A(1) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-4-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.14",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A marriage is a forced marriage if one party to the marriage (the\nvictim) entered into the marriage without freely and fully\nconsenting:\n\n(a) because of the use of coercion, threat or deception; or\n\n(b) because the party was incapable of understanding the nature\nand effect of the marriage ceremony.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) A marriage is a forced marriage if one party to the marriage (the\nvictim) entered into the marriage without freely and fully\nconsenting:\n\n(a) because of the use of coercion, threat or deception; or\n\n(b) because the party was incapable of understanding the nature\nand effect of the marriage ceremony.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "4b15719d4023c13473990a063fe9e00a3882597014604f1a740cae168c4ced40",
      "skos:note": "Forced marriage defined as a marriage where one party did not freely and fully consent."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-4-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 270.7A(1) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A marriage is a forced marriage if one party to the marriage (the\nvictim) entered into the marriage without freely and fully\nconsenting:\n\n(a) because of the use of coercion, threat or deception; or\n\n(b) because the party was incapable of understanding the nature\nand effect of the marriage ceremony."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits forced marriages.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Marriage without free and full consent is a crime.",
      "cml:conclusionText": "No forced marriage allowed."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits marriage where one party did not freely and fully consent.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Marriage without free and full consent is a crime.",
      "cml:conclusionText": "No such marriage allowed."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-4-sec-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits marriage where one party was coerced, threatened or deceived into it.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Coercion, threat or deception in marriage is a crime.",
      "cml:conclusionText": "No such marriage allowed."
    },
