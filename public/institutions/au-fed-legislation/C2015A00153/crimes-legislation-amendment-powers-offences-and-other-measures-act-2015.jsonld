    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-8-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 3(1)",
      "cml:realizedBy": {
