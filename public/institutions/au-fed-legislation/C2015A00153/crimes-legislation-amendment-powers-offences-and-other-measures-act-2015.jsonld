    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Subsections 17(2) and (3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.46",
      "values:originalText": "Repeal the subsections, substitute:\n\n(2) The Integrity Commissioner may revoke the agreement by written\nnotice given to the head of the agency. The revocation takes effect\non a day specified in the notice, which must be at least 14 days\nafter the day it is given.\n\n(3) Without limiting subsection (1), the agreement may set out how it\nmay be varied and other ways how it may be revoked.",
      "skos:definition": "Repeal the subsections, substitute:\n\n(2) The Integrity Commissioner may revoke the agreement by written\nnotice given to the head of the agency. The revocation takes effect\non a day specified in the notice, which must be at least 14 days\nafter the day it is given.\n\n(3) Without limiting subsection (1), the agreement may set out how it\nmay be varied and other ways how it may be revoked.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-6-ss-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-6-ss-3"
        }
      ],
      "cml:integrityHash": "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Subsections 17(2) and (3)",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "Repeal the subsections, substitute:\n\n(2) The Integrity Commissioner may revoke the agreement by written\nnotice given to the head of the agency. The revocation takes effect\non a day specified in the notice, which must be at least 14 days\nafter the day it is given.\n\n(3) Without limiting subsection (1), the agreement may set out how it\nmay be varied and other ways how it may be revoked."
    },
