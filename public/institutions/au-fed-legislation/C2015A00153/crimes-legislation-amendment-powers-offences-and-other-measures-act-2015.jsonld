    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Person who refers corruption issue",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.48",
      "values:originalText": "The Integrity Commissioner may advise a person (or a\nrepresentative nominated by the person) of:\n\n(a) the Integrity Commissioner’s decision under section 31 in\nrelation to a corruption issue raised by the person in a referral\nunder section 23; and\n\n(b) any decision the Integrity Commissioner makes under\nsection 42 on a reconsideration of how the corruption issue\nshould be dealt with.",
      "skos:definition": "The Integrity Commissioner may advise a person (or a\nrepresentative nominated by the person) of:\n\n(a) the Integrity Commissioner’s decision under section 31 in\nrelation to a corruption issue raised by the person in a referral\nunder section 23; and\n\n(b) any decision the Integrity Commissioner makes under\nsection 42 on a reconsideration of how the corruption issue\nshould be dealt with.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-34-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-34-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "416a3e7c5149a3f29b2f7a17ed915256acb80e07707eac7d4089901d544d5729",
      "skos:note": "The Integrity Commissioner must advise a person or their representative on certain decisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-11-sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Person who refers corruption issue",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "The Integrity Commissioner may advise a person (or a\nrepresentative nominated by the person) of:\n\n(a) the Integrity Commissioner’s decision under section 31 in\nrelation to a corruption issue raised by the person in a referral\nunder section 23; and\n\n(b) any decision the Integrity Commissioner makes under\nsection 42 on a reconsideration of how the corruption issue\nshould be dealt with."
    },
