      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.9",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2015A00153\n\nSchedule 1  Serious drug offences\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2015A00153\n\nSchedule 1  Serious drug offences\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "bbf4e07d9180ed67432983337b9255dfd60302ba579f458e5e036809b4faa46d",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2015A00153\n\nSchedule 1  Serious drug offences\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015\nNo. 153, 2015"
    },
