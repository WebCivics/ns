        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Considering the deterrent effect may lead to other consequences",
      "cml:conclusionText": "If considering the deterrent effect, then there are other consequences"
