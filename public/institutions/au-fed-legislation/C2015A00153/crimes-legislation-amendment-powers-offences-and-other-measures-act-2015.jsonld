      "cml:logicSummary": "The Integrity Commissioner may decide not to take further action if certain conditions are met.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
