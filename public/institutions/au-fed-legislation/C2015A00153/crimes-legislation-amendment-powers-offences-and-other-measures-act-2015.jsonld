      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-2-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 70.2(1A) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-2-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.12",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1A) For the purposes of paragraph (1)(c):\n\n(a) the first-mentioned person does not need to intend to\ninfluence a particular foreign public official; and\n\n(b) business, or a business advantage, does not need to be\nactually obtained or retained.\nComLaw Authoritative Act C2015A00153\n\nOutrages upon personal dignity  Schedule 3\n\nNo. 153, 2015\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1A) For the purposes of paragraph (1)(c):\n\n(a) the first-mentioned person does not need to intend to\ninfluence a particular foreign public official; and\n\n(b) business, or a business advantage, does not need to be\nactually obtained or retained.\nComLaw Authoritative Act C2015A00153\n\nOutrages upon personal dignity  Schedule 3\n\nNo. 153, 2015\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-2-sec-1-norm"
        }
      ],
      "cml:integrityHash": "7b3da98d45d2333e7bdd191f0ae0c9eb2c51a0966367cf4cc43f6ce277758c26",
      "skos:note": "Repeal subsection 70.2(1A) of the Criminal Code and substitute with new provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 70.2(1A) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1A) For the purposes of paragraph (1)(c):\n\n(a) the first-mentioned person does not need to intend to\ninfluence a particular foreign public official; and\n\n(b) business, or a business advantage, does not need to be\nactually obtained or retained.\nComLaw Authoritative Act C2015A00153\n\nOutrages upon personal dignity  Schedule 3\n\nNo. 153, 2015\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015"
    },
