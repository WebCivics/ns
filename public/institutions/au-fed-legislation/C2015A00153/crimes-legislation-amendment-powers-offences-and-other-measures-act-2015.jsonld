      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Application of new definition of related offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.58",
      "values:originalText": "The definition of related offence in section 338 of the Proceeds of\nCrime Act 2002, as amended by this Division, applies in relation to:\n\n(a) restraining orders applied for on or after the commencement\nof this Division; and\n\n(b) interstate pecuniary penalty orders made on or after that\ncommencement;\nwhether the physical elements of either or both of the offences\nconcerned occurred before, on or after that commencement.",
      "skos:definition": "The definition of related offence in section 338 of the Proceeds of\nCrime Act 2002, as amended by this Division, applies in relation to:\n\n(a) restraining orders applied for on or after the commencement\nof this Division; and\n\n(b) interstate pecuniary penalty orders made on or after that\ncommencement;\nwhether the physical elements of either or both of the offences\nconcerned occurred before, on or after that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-4-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-14-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7f71c187afba2066ce33d911550e31a50da4fdc510cb8ae4caa13396be34b371",
      "skos:note": "Definition of related offence applies to certain orders and penalties"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-14-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Application of new definition of related offence",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "The definition of related offence in section 338 of the Proceeds of\nCrime Act 2002, as amended by this Division, applies in relation to:\n\n(a) restraining orders applied for on or after the commencement\nof this Division; and\n\n(b) interstate pecuniary penalty orders made on or after that\ncommencement;\nwhether the physical elements of either or both of the offences\nconcerned occurred before, on or after that commencement."
    },
