      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "an investigation of the corruption issue is not warranted having regard to all the circumstances",
      "cml:conclusionText": "the Integrity Commissioner may decide not to take further action"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-11-sec-12-ss-9",
      "@type": "cml:Concept",
