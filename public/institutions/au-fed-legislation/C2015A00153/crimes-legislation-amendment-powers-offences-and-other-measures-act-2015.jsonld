    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-1-sec-300",
      "@type": "cml:Concept",
      "skos:prefLabel": "300 6  Recklessness as to nature of substance or plant sufficient for",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-1-sec-300"
      },
      "cml:curationStatus": {
