    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Savings provision—regulation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2015.pdf, p.36",
      "values:originalText": "A regulation:\n\n(a) made for the purposes of section 20AB of the Crimes Act\n1914; and\n\n(b) in force just before the commencement of this item;\nhas effect, from that commencement, as if it had been made for the\npurposes of subsection 20AB(1AA) of that Act, as amended by this\nPart.\nComLaw Authoritative Act C2015A00153\n\nTransfer of prisoners  Schedule 8\n\nNo. 153, 2015\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015",
      "skos:definition": "A regulation:\n\n(a) made for the purposes of section 20AB of the Crimes Act\n1914; and\n\n(b) in force just before the commencement of this item;\nhas effect, from that commencement, as if it had been made for the\npurposes of subsection 20AB(1AA) of that Act, as amended by this\nPart.\nComLaw Authoritative Act C2015A00153\n\nTransfer of prisoners  Schedule 8\n\nNo. 153, 2015\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2015-sch-7-sec-49-norm"
        }
      ],
      "cml:integrityHash": "9a8335f53742a99680258164d0f5537ec41c80d6f89f454097dabc0cd337fbdb",
      "skos:note": "Regulation made for specific purposes has effect from commencement as if amended"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2015#sch-7-sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Savings provision—regulation",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "A regulation:\n\n(a) made for the purposes of section 20AB of the Crimes Act\n1914; and\n\n(b) in force just before the commencement of this item;\nhas effect, from that commencement, as if it had been made for the\npurposes of subsection 20AB(1AA) of that Act, as amended by this\nPart.\nComLaw Authoritative Act C2015A00153\n\nTransfer of prisoners  Schedule 8\n\nNo. 153, 2015\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2015"
    },
