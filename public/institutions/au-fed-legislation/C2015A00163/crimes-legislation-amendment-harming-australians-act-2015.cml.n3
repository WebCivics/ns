concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14 a cml:Concept ;
    skos:prefLabel "14 At the end of section 115.2 of the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-14 ;
    values:originalText "Add:  (3) If:  (a) a person has been convicted or acquitted of an offence in respect of conduct under a law of a foreign country or a part of a foreign country; and  (b) the person engaged in the conduct before 1 October 2002; the person cannot be convicted of an offence against this section in respect of that conduct.  [Minister’s second reading speech made in— Senate on 15 October 2015 House of Representatives on 23 November 2015]  (185/15) ComLaw Authoritative Act C2015A00163" ;
    skos:definition "Add:  (3) If:  (a) a person has been convicted or acquitted of an offence in respect of conduct under a law of a foreign country or a part of a foreign country; and  (b) the person engaged in the conduct before 1 October 2002; the person cannot be convicted of an offence against this section in respect of that conduct.  [Minister’s second reading speech made in— Senate on 15 October 2015 House of Representatives on 23 November 2015]  (185/15) ComLaw Authoritative Act C2015A00163"@en ;
    cml:integrityHash "027e9bdda9ba6fcf4f5cea6fda884ec7c0a6d50414b8764c1da7e24e5e42d8bb" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Exempts conduct under foreign law from prosecution if engaged before 1 October 2002." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-harming-australians-act-2015.pdf> ;
    dc:source "crimes-legislation-amendment-harming-australians-act-2015.pdf, p.9" ;
    cml:asserts concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14-norm .
