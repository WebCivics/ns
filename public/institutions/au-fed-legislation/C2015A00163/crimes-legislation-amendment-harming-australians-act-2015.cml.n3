concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-7 a cml:Concept ;
    skos:prefLabel "7 At the end of section 115.1 of the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-7 ;
    values:originalText "Add:  (3) If:  (a) a person has been convicted or acquitted of an offence in respect of conduct under a law of a foreign country or a part of a foreign country; and  (b) the person engaged in the conduct before 1 October 2002; the person cannot be convicted of an offence against this section in respect of that conduct." ;
    skos:definition "Add:  (3) If:  (a) a person has been convicted or acquitted of an offence in respect of conduct under a law of a foreign country or a part of a foreign country; and  (b) the person engaged in the conduct before 1 October 2002; the person cannot be convicted of an offence against this section in respect of that conduct."@en ;
    cml:integrityHash "b4685c8e1fd8cc3c3f94cf70ca5b4bf4b5b7f38350ff69cf17c05c8b95b1b683" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Exemption from prosecution for conduct under foreign law before October 2002" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-harming-australians-act-2015.pdf> ;
