    {
      "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 At the end of section 115.2 of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-harming-australians-act-2015#sch-1-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-harming-australians-act-2015.pdf"
      },
      "dc:source": "crimes-legislation-amendment-harming-australians-act-2015.pdf, p.9",
      "values:originalText": "Add:\n\n(3) If:\n\n(a) a person has been convicted or acquitted of an offence in\nrespect of conduct under a law of a foreign country or a part\nof a foreign country; and\n\n(b) the person engaged in the conduct before 1 October 2002;\nthe person cannot be convicted of an offence against this section in\nrespect of that conduct.\n\n[Minister’s second reading speech made in—\nSenate on 15 October 2015\nHouse of Representatives on 23 November 2015]\n\n(185/15)\nComLaw Authoritative Act C2015A00163",
      "skos:definition": "Add:\n\n(3) If:\n\n(a) a person has been convicted or acquitted of an offence in\nrespect of conduct under a law of a foreign country or a part\nof a foreign country; and\n\n(b) the person engaged in the conduct before 1 October 2002;\nthe person cannot be convicted of an offence against this section in\nrespect of that conduct.\n\n[Minister’s second reading speech made in—\nSenate on 15 October 2015\nHouse of Representatives on 23 November 2015]\n\n(185/15)\nComLaw Authoritative Act C2015A00163",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-14-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "027e9bdda9ba6fcf4f5cea6fda884ec7c0a6d50414b8764c1da7e24e5e42d8bb",
      "skos:note": "Exempts conduct under foreign law from prosecution if engaged before 1 October 2002."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-harming-australians-act-2015#sch-1-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 At the end of section 115.2 of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Add:\n\n(3) If:\n\n(a) a person has been convicted or acquitted of an offence in\nrespect of conduct under a law of a foreign country or a part\nof a foreign country; and\n\n(b) the person engaged in the conduct before 1 October 2002;\nthe person cannot be convicted of an offence against this section in\nrespect of that conduct.\n\n[Minister’s second reading speech made in—\nSenate on 15 October 2015\nHouse of Representatives on 23 November 2015]\n\n(185/15)\nComLaw Authoritative Act C2015A00163"
