    {
      "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 At the end of section 115.1 of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-harming-australians-act-2015#sch-1-sec-7"
      },
