      "dc:source": "crimes-legislation-amendment-harming-australians-act-2015.pdf, p.8",
      "values:originalText": "Add:\n\n(3) If:\n\n(a) a person has been convicted or acquitted of an offence in\nrespect of conduct under a law of a foreign country or a part\nof a foreign country; and\n\n(b) the person engaged in the conduct before 1 October 2002;\nthe person cannot be convicted of an offence against this section in\nrespect of that conduct.",
      "skos:definition": "Add:\n\n(3) If:\n\n(a) a person has been convicted or acquitted of an offence in\nrespect of conduct under a law of a foreign country or a part\nof a foreign country; and\n\n(b) the person engaged in the conduct before 1 October 2002;\nthe person cannot be convicted of an offence against this section in\nrespect of that conduct.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-7-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b4685c8e1fd8cc3c3f94cf70ca5b4bf4b5b7f38350ff69cf17c05c8b95b1b683",
      "skos:note": "Exemption from prosecution for conduct under foreign law before October 2002"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-harming-australians-act-2015#sch-1-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 At the end of section 115.1 of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Add:\n\n(3) If:\n\n(a) a person has been convicted or acquitted of an offence in\nrespect of conduct under a law of a foreign country or a part\nof a foreign country; and\n\n(b) the person engaged in the conduct before 1 October 2002;\nthe person cannot be convicted of an offence against this section in\nrespect of that conduct."
    },
