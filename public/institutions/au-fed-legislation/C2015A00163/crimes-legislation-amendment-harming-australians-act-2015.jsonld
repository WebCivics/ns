    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-harming-australians-act-2015#sch-1-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Subsection 115.2(2) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Omit “paragraphs (1)(b) and (c)”, substitute “paragraphs (1)(b), (c) and\n(e)”."
    },
    {
      "@id": "concept:crimes-legislation-amendment-harming-australians-act-2015-sch-1-sec-13-norm",
