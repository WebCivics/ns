        "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-10-logic-ltl-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "0ae106b0ee9fe414aec6e0de266a47cb2b21fc18261cbcb9a1c5287f2768df0c",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-35a-ss-10",
      "cml:schemaVersion": "2",
      "partOf": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-10-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval is between the exercise of powers and the personal exercise.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval between exercise of powers and personal exercise.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Between",
      "cml:premiseText": "(10) The powers of the Minister under this section may only be exercised by the Minister personally."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-10-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister must exercise powers personally.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Minister's obligation to exercise powers personally.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:premiseText": "(10) The powers of the Minister under this section may only be exercised by the Minister personally."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-10-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal limit is until the personal exercise.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal limit on exercise of powers.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "(10) The powers of the Minister under this section may only be exercised by the Minister personally."
    },
