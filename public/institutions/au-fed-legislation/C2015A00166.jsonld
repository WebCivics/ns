    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.18",
      "skos:note": "Loss of Australian citizenship due to conviction for terrorism offences and certain other offences.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "35A(1) Conviction for terrorism offences and certain other offences"
      },
      "wasDerivedFrom": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf",
      "asserts": [
        "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-norm",
        "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-deontic-1",
        "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-alleninterval-2",
        "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-ltl-3",
        "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-diffusion-4",
        "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-argumentation-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "8cad95ac59fa750b5d551595b15663662c37cddc062c35035411927638e35bf6",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-35a-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person's conviction overlaps with their loss of citizenship.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between conviction and loss of citizenship.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The person has, in respect of the conviction or convictions, been sentenced to a period of imprisonment of at least 6 years..."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conviction implies a loss of right to remain an Australian citizen.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of conviction on Australian citizenship.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implicates",
      "cml:premiseText": "Having regard to the following factors, the Minister is satisfied that it is not in the public interest for the person to remain an Australian citizen:"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "No longer an Australian citizen.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Loss of citizenship due to conviction.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "Conviction for terrorism offences and certain other offences."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information about the loss of citizenship diffuses through the legal system.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion of information about loss of citizenship.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:premiseText": "A person may seek review of a determination made under this subsection in the High Court of Australia under section 75 of the Constitution, or in the Federal Court of Australia under section 39B of the Judiciary Act 1903."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person's conviction reaches the point where they no longer have a right to remain an Australian citizen.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal reach between conviction and loss of citizenship.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Reaches",
      "cml:premiseText": "The Minister is satisfied that it is not in the public interest for the person to remain an Australian citizen:"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-norm",
      "@type": "doc:Prohibition",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:State",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-10",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.18",
      "skos:note": "Minister must exercise powers personally.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "35A(10) Conviction for terrorism offences and certain other offences"
      },
      "wasDerivedFrom": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf",
      "asserts": [
