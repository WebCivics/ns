    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.12",
      "skos:note": "Ceases to be an Australian citizen if serves in armed forces of enemy country or fights for declared terrorist organisation.",
