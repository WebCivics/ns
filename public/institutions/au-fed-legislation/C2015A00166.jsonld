    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "ceases to be an Australian citizen if serves in armed forces of enemy country or fights for declared terrorist organisation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The conditions under which a person ceases to be an Australian citizen overlap with the definition of serving in armed forces of an enemy country or fighting for a declared terrorist organisation.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(i) serves in the armed forces of a country at war with Australia; or (ii) fights for, or is in the service of, a declared terrorist organisation (see section 35AA); and"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35-ss-1-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "ceases to be an Australian citizen if serves in armed forces of enemy country or fights for declared terrorist organisation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "The conditions under which a person ceases to be an Australian citizen imply that serving in armed forces of an enemy country or fighting for a declared terrorist organisation is a sufficient condition.",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implicates",
      "cml:premiseText": "(i) serves in the armed forces of a country at war with Australia; or (ii) fights for, or is in the service of, a declared terrorist organisation (see section 35AA); and"
    },
