concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101-ss-14 a cml:Concept ;
    skos:prefLabel "101(14) 2, 102.2, 102.4, 103.1 and 103.2 and Division 119 of the"@en ;
    cml:realizedBy doc:sch-1-sec-101-ss-14 ;
    values:originalText "(14) At any time after a person has renounced his or her citizenship under this section, the Minister may make a determination to:  (a) rescind any notice given under subsection (10) in respect of the person; and  (b) exempt the person from the effect of this section in relation to the matters that were the basis for the notice, or in relation to matters that would have been the basis for giving a notice in respect of the person under paragraph (10)(a), but for the operation of subsection (12)." ;
    skos:definition "(14) At any time after a person has renounced his or her citizenship under this section, the Minister may make a determination to:  (a) rescind any notice given under subsection (10) in respect of the person; and  (b) exempt the person from the effect of this section in relation to the matters that were the basis for the notice, or in relation to matters that would have been the basis for giving a notice in respect of the person under paragraph (10)(a), but for the operation of subsection (12)."@en ;
    cml:integrityHash "04c8df83da38e9e4824b8e66986eafad38505768c1fca3502e15caea70907e17" ;
    values:partOf concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101 ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Minister may make a determination to rescind notice or exempt person from section's effect." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf> ;
