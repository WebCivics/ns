concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-4 a cml:Concept ;
    skos:prefLabel "4 Purpose of this Act"@en ;
    cml:realizedBy doc:sec-4 ;
    values:originalText "This Act is enacted because the Parliament recognises that Australian citizenship is a common bond, involving reciprocal rights and obligations, and that citizens may, through certain conduct incompatible with the shared values of the Australian community, demonstrate that they have severed that bond and repudiated their allegiance to Australia.  ComLaw Authoritative Act C2015A00166  Main amendments  Schedule 1  No. 166, 2015 Australian Citizenship Amendment (Allegiance to Australia) Act 2015" ;
    skos:definition "This Act is enacted because the Parliament recognises that Australian citizenship is a common bond, involving reciprocal rights and obligations, and that citizens may, through certain conduct incompatible with the shared values of the Australian community, demonstrate that they have severed that bond and repudiated their allegiance to Australia.  ComLaw Authoritative Act C2015A00166  Main amendments  Schedule 1  No. 166, 2015 Australian Citizenship Amendment (Allegiance to Australia) Act 2015"@en ;
    cml:integrityHash "996f504865c4ffc5aa31866b8f919804e549a9b5d5bf8cad010aa174b590b1ae" ;
    cof:pageNumber "6"^^xsd:integer ;
    skos:note "Recognizes Australian citizenship as a common bond with reciprocal rights and obligations." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf> ;
    dc:source "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.6" ;
    cml:asserts concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-4-norm .
