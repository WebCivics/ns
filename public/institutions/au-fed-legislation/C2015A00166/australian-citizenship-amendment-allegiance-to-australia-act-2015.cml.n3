doc:sch-1-sec-35-ss-8 a cof:Section ;
    cof:title "35(8) Service outside Australia in armed forces of an enemy country or" ;
    values:kind "subsection" ;
    values:originalText "(8) Subsections (9) to (14) apply only if a person has ceased to be a citizen under this section." ;
