    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Notice must state reasons for decision to revoke citizenship. Ceases to be an Australian citizen at the time of determination." ;
    dc:description "Reasons for decision" ;
    cml:curationStatus cml:Proposed ;
