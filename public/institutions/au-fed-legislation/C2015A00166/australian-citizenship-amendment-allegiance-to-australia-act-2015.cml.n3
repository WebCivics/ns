doc:sch-1-sec-101-ss-15 a cof:Section ;
    cof:title "101(15) 2, 102.2, 102.4, 103.1 and 103.2 and Division 119 of the" ;
    values:kind "subsection" ;
    values:originalText "(15) The Minister does not have a duty to consider whether to exercise the power under subsection (14) in respect of any person, whether the Minister is requested to do so by the person who has renounced his or her citizenship under this section, or by any other person, or in any other circumstances." ;
    cof:pageNumber "8"^^xsd:integer .

concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101-ss-16 a cml:Concept ;
    skos:prefLabel "101(16) 2, 102.2, 102.4, 103.1 and 103.2 and Division 119 of the"@en ;
    cml:realizedBy doc:sch-1-sec-101-ss-16 ;
    values:originalText "(16) To avoid doubt, in deciding whether to consider exercising the power in subsection (14), the Minister is not required to have regard to any of the matters referred to in subsection (17)." ;
    skos:definition "(16) To avoid doubt, in deciding whether to consider exercising the power in subsection (14), the Minister is not required to have regard to any of the matters referred to in subsection (17)."@en ;
    cml:integrityHash "f81c53b0df50e0bb5d426f32be23e5d037fdbc8f3bc88947b6245ae36380107b" ;
    values:partOf concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101 ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Minister is not required to consider matters when exercising power." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
