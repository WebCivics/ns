concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-1 a cml:Concept ;
    skos:prefLabel "1 Section 32A"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Omit: • you serve in the armed forces of a country at war with Australia: see section 35; or substitute: • you engage in various kinds of conduct inconsistent with allegiance to Australia: see sections 33AA, 35 and 35A; or" ;
    skos:definition "Omit: • you serve in the armed forces of a country at war with Australia: see section 35; or substitute: • you engage in various kinds of conduct inconsistent with allegiance to Australia: see sections 33AA, 35 and 35A; or"@en ;
