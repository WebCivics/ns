concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-9 a cml:Concept ;
    skos:prefLabel "35A(9) Conviction for terrorism offences and certain other offences"@en ;
    cml:realizedBy doc:sch-1-sec-35a-ss-9 ;
