      "cml:integrityHash": "19bf90f3e1a89cdb47cdcb4dd08c18ecd01b65b55da0930a439abf6f2f9c075a",
      "skos:note": "Exemption from prosecution for conduct outside Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-101-ss-7",
      "@type": "cof:Section",
      "cof:title": "101(7) 2, 102.2, 102.4, 103.1 and 103.2 and Division 119 of the",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(7) This section does not apply in relation to conduct by a person\nunless:\n\n(a) the person was not in Australia when the person engaged in\nthe conduct; or\n\n(b) the person left Australia after engaging in the conduct and, at\nthe time that the person left Australia, the person had not\nbeen tried for any offence related to the conduct."
    },
