    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-33aa-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "33AA(4) Renunciation by conduct",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-33aa-ss-4"
