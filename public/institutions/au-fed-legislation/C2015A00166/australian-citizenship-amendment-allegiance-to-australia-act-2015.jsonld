    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-3-norm"
        }
      ],
      "cml:integrityHash": "451ffd68058b1e0feb697eca15b67f99f88953e3d620122de73723d8ad8ce2fa",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms."
    },
