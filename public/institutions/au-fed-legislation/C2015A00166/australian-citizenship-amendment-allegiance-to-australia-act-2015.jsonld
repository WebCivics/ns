    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101-ss-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "101(14) 2, 102.2, 102.4, 103.1 and 103.2 and Division 119 of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-101-ss-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.8",
      "values:originalText": "(14) At any time after a person has renounced his or her citizenship\nunder this section, the Minister may make a determination to:\n\n(a) rescind any notice given under subsection (10) in respect of\nthe person; and\n\n(b) exempt the person from the effect of this section in relation to\nthe matters that were the basis for the notice, or in relation to\nmatters that would have been the basis for giving a notice in\nrespect of the person under paragraph (10)(a), but for the\noperation of subsection (12).",
      "skos:definition": "(14) At any time after a person has renounced his or her citizenship\nunder this section, the Minister may make a determination to:\n\n(a) rescind any notice given under subsection (10) in respect of\nthe person; and\n\n(b) exempt the person from the effect of this section in relation to\nthe matters that were the basis for the notice, or in relation to\nmatters that would have been the basis for giving a notice in\nrespect of the person under paragraph (10)(a), but for the\noperation of subsection (12).",
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101"
      },
      "cml:asserts": [
