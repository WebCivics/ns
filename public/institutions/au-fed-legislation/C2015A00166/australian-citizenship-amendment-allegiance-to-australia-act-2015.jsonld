      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to not cease citizenship",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person's citizenship is taken never to have ceased under this section.",
      "cml:conclusionText": "If certain conditions are met, the person's citizenship is not taken to have ceased."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101-ss-24-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between conduct and declaration",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A declaration under section 35AA is disallowed by either House of Parliament if the person's citizenship would not have ceased under this section.",
      "cml:conclusionText": "The temporal overlap between the conduct and the declaration is significant."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101-ss-24-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Temporal until condition",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A court finds that the person was not a national or citizen of a country other than Australia at the time of the conduct.",
      "cml:conclusionText": "The temporal condition is met if the person was not a national or citizen of a country other than Australia at the time of the conduct."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101-ss-24-logic-diffusion-4",
