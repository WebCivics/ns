        }
      ],
      "cml:integrityHash": "b7f55361512b6e1f94ab4eaaac18a610496aaef79a8e85595e12265e95c7b5b3",
      "skos:note": "Minister does not have a duty to consider exercising power under subsection (9)"
    },
    {
