      "cml:operator": "implies",
      "cml:logicSummary": "If it is not clear that only a particular part of the total period relates to the offence, then the person is taken to have been sentenced for the whole of the total period.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) if subparagraph (i) does not apply...",
      "cml:conclusionText": "...the person is taken to have been sentenced..."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-4-logic-deontic-4",
