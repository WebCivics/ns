        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-2-sec-51c-ss-3"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-2-sec-51c-ss-4"
        },
