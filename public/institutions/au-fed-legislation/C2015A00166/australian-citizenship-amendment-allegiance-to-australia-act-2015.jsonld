        }
      ],
      "cml:integrityHash": "ffe979ba1b1c62aba7a33960c408b72106e38b7c572f7ef951f5de520e4e11aa",
      "skos:note": "Minister must provide statement to Parliament within 15 days of determination.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-35-ss-13",
      "@type": "cof:Section",
      "cof:title": "35(13) Service outside Australia in armed forces of an enemy country or",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(13) If the Minister makes a determination under subsection (9), the\nMinister must cause to be laid before each House of the\nParliament, within 15 sitting days of that House after the Minister\nmakes the determination, a statement that:\n\n(a) sets out the determination; and\n\n(b) sets out the reasons for the determination, referring in\nparticular to the Minister’s reasons in relation to the matters\nset out in subsection (12)."
    },
