    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-101-ss-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "101(18) 2, 102.2, 102.4, 103.1 and 103.2 and Division 119 of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-101-ss-18"
      },
      "cml:curationStatus": {
