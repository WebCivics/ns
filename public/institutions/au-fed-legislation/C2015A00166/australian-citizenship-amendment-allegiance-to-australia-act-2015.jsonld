    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Purpose of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.6",
      "values:originalText": "This Act is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia.\n\nComLaw Authoritative Act C2015A00166\n\nMain amendments  Schedule 1\n\nNo. 166, 2015\nAustralian Citizenship Amendment (Allegiance to Australia) Act 2015",
      "skos:definition": "This Act is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia.\n\nComLaw Authoritative Act C2015A00166\n\nMain amendments  Schedule 1\n\nNo. 166, 2015\nAustralian Citizenship Amendment (Allegiance to Australia) Act 2015",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-4-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "996f504865c4ffc5aa31866b8f919804e549a9b5d5bf8cad010aa174b590b1ae",
      "skos:note": "Recognizes Australian citizenship as a common bond with reciprocal rights and obligations."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Purpose of this Act",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "This Act is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia.\n\nComLaw Authoritative Act C2015A00166\n\nMain amendments  Schedule 1\n\nNo. 166, 2015\nAustralian Citizenship Amendment (Allegiance to Australia) Act 2015"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sec-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes a duty on citizens to uphold the shared values of the Australian community.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Parliament recognises that Australian citizenship is a common bond...",
      "cml:conclusionText": "Citizens may demonstrate that they have severed that bond and repudiated their allegiance to Australia."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 32A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.7",
      "values:originalText": "Omit:\n•\nyou serve in the armed forces of a country at war with\nAustralia: see section 35; or\nsubstitute:\n•\nyou engage in various kinds of conduct inconsistent with\nallegiance to Australia: see sections 33AA, 35 and 35A; or",
      "skos:definition": "Omit:\n•\nyou serve in the armed forces of a country at war with\nAustralia: see section 35; or\nsubstitute:\n•\nyou engage in various kinds of conduct inconsistent with\nallegiance to Australia: see sections 33AA, 35 and 35A; or",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e55906bc386198bdc3cfeba3b0663fae1c4b614c3e3c1a94b2cfd7745b051a55",
      "skos:note": "Omit serving in armed forces of a country at war with Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Section 32A",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit:\n•\nyou serve in the armed forces of a country at war with\nAustralia: see section 35; or\nsubstitute:\n•\nyou engage in various kinds of conduct inconsistent with\nallegiance to Australia: see sections 33AA, 35 and 35A; or"
