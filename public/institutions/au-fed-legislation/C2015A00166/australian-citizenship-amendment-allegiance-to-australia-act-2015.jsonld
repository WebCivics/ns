      "cml:premiseText": "(4) For the purpose of paragraph (1)(b):",
      "cml:conclusionText": "the person is taken to have been sentenced..."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "The total period of imprisonment includes a part that relates to the offence.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) if it is clear that only a particular part of the total period...",
      "cml:conclusionText": "...the person is taken to have been sentenced..."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
