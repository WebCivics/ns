      },
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.12",
      "values:originalText": "Repeal the section, substitute:",
      "skos:definition": "Repeal the section, substitute:",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-4-norm"
        }
      ],
      "cml:integrityHash": "e760fc8d63da5406b762d346b67c33f828593d7f3e1e89f1a1e04f768edbdfa9",
      "skos:note": "Repeal section and substitute with new content."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Section 35",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Repeal the section, substitute:"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-4-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
