    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35-ss-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "35(9) Service outside Australia in armed forces of an enemy country or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-35-ss-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.12",
      "values:originalText": "(9) At any time after a person has ceased to be a citizen under this\nsection, the Minister may make a determination to:\n\n(a) rescind any notice given under subsection (5) in respect of\nthe person; and\n\n(b) exempt the person from the effect of this section in relation to\nthe matters that were the basis for the notice, or in relation to\nmatters that would have been the basis for giving a notice in\nrespect of the person under paragraph (5)(a), but for the\noperation of subsection (7).",
      "skos:definition": "(9) At any time after a person has ceased to be a citizen under this\nsection, the Minister may make a determination to:\n\n(a) rescind any notice given under subsection (5) in respect of\nthe person; and\n\n(b) exempt the person from the effect of this section in relation to\nthe matters that were the basis for the notice, or in relation to\nmatters that would have been the basis for giving a notice in\nrespect of the person under paragraph (5)(a), but for the\noperation of subsection (7).",
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35-ss-9-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35-ss-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ee5b7778e9d5f41cdc1488a6d2d73841f5286b42be7519174958737ae2ce052c",
      "skos:note": "The Minister may exempt a person from the effect of section 35 in relation to matters that were the basis for a notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-35-ss-9",
      "@type": "cof:Section",
      "cof:title": "35(9) Service outside Australia in armed forces of an enemy country or",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(9) At any time after a person has ceased to be a citizen under this\nsection, the Minister may make a determination to:\n\n(a) rescind any notice given under subsection (5) in respect of\nthe person; and\n\n(b) exempt the person from the effect of this section in relation to\nthe matters that were the basis for the notice, or in relation to\nmatters that would have been the basis for giving a notice in\nrespect of the person under paragraph (5)(a), but for the\noperation of subsection (7)."
    },
