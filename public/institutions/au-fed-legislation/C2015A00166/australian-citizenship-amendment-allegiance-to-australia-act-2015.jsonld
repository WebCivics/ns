    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35-ss-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "35(10) Service outside Australia in armed forces of an enemy country or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-35-ss-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
