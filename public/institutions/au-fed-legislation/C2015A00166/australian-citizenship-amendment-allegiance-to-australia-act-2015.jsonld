    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "35A(1) Conviction for terrorism offences and certain other offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-35a-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf"
      },
      "dc:source": "australian-citizenship-amendment-allegiance-to-australia-act-2015.pdf, p.18",
      "values:originalText": "(1) A notice that is given to a person under paragraph 33AA(10)(a) or\n35(5)(a) must:\n\n(a) state that the Minister has become aware of conduct because\nof which the person has, under section 33AA or 35, ceased to\nbe an Australian citizen; and\n\n(b) contain a basic description of that conduct.",
      "skos:definition": "(1) A notice that is given to a person under paragraph 33AA(10)(a) or\n35(5)(a) must:\n\n(a) state that the Minister has become aware of conduct because\nof which the person has, under section 33AA or 35, ceased to\nbe an Australian citizen; and\n\n(b) contain a basic description of that conduct.",
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-deontic-2"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-alleninterval-3"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-ltl-4"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-diffusion-5"
        },
        {
          "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-argumentation-6"
        }
      ],
      "cml:integrityHash": "325e3e4246bad8cdd50894ee606dacd4998beb17534dfc690a391446ffbadd7e",
      "skos:note": "Notice must state that Minister is aware of conduct and contain a basic description. Loss of Australian citizenship due to conviction for terrorism offences and certain other offences.",
      "dc:description": "basic description of conduct"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-35a-ss-1",
      "@type": "cof:Section",
      "cof:title": "35A(1) Conviction for terrorism offences and certain other offences",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(1) A notice that is given to a person under paragraph 33AA(10)(a) or\n35(5)(a) must:\n\n(a) state that the Minister has become aware of conduct because\nof which the person has, under section 33AA or 35, ceased to\nbe an Australian citizen; and\n\n(b) contain a basic description of that conduct."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to provide notice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Loss of citizenship due to conviction.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Conviction for terrorism offences and certain other offences.",
      "cml:conclusionText": "No longer an Australian citizen."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between conviction and loss of citizenship.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person has, in respect of the conviction or convictions, been sentenced to a period of imprisonment of at least 6 years...",
      "cml:conclusionText": "The person's conviction overlaps with their loss of citizenship."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Reaches",
      "cml:logicSummary": "Temporal reach between conviction and loss of citizenship.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister is satisfied that it is not in the public interest for the person to remain an Australian citizen:",
      "cml:conclusionText": "The person's conviction reaches the point where they no longer have a right to remain an Australian citizen."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffusion of information about loss of citizenship.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person may seek review of a determination made under this subsection in the High Court of Australia under section 75 of the Constitution, or in the Federal Court of Australia under section 39B of the Judiciary Act 1903.",
      "cml:conclusionText": "The information about the loss of citizenship diffuses through the legal system."
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-35a-ss-1-logic-argumentation-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implicates",
      "cml:logicSummary": "Implication of conviction on Australian citizenship.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Having regard to the following factors, the Minister is satisfied that it is not in the public interest for the person to remain an Australian citizen:",
      "cml:conclusionText": "The conviction implies a loss of right to remain an Australian citizen."
    },
    {
