      "cml:integrityHash": "34bd14252e5782eb323e4e76e537c5ec4ce553df2986a81133565c5452170084",
      "skos:note": "Definition of terms used in paragraphs (2)(a) to (h)"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-allegiance-to-australia-act-2015#sch-1-sec-33aa-ss-6",
      "@type": "cof:Section",
      "cof:title": "33AA(6) Renunciation by conduct",
      "values:kind": "subsection",
      "cof:pageNumber": 7,
      "values:originalText": "(6) Words and expressions used in paragraphs (2)(a) to (h) have the\nsame meanings as in Subdivision A of Division 72, sections 101.1,"
    },
    {
      "@id": "concept:australian-citizenship-amendment-allegiance-to-australia-act-2015-sch-1-sec-33aa-ss-6-norm",
      "@type": "values:Obligation",
