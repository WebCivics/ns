      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Defines a duty for the Commissioner to vary the determination after commencement time.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "(3) The Commissioner may, by legislative instrument, vary the determination after the commencement time to take account of the amendments of the Privacy Act made by this Act."
    },
