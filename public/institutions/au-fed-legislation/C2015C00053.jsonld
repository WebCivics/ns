    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-25a-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) This section applies if:  (a) either:  (i) a civil penalty order has been made against an entity for a contravention of a civil penalty provision (other than section 13G); or  (ii) an entity is found guilty of an offence against this Part; and  (b) a person has suffered, or is likely to suffer, loss or damage (including injury to the person’s feelings or humiliation) as a result of the contravention or commission of the offence.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "This section applies during the time period when an entity has suffered loss or damage.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(1) This section applies if:  (a) either:  (i) a civil penalty order has been made against an entity for a contravention of a civil penalty provision (other than section 13G); or  (ii) an entity is found guilty of an offence against this Part; and  (b) a person has suffered, or is likely to suffer, loss or damage (including injury to the person’s feelings or humiliation) as a result of the contravention or commission of the offence."
    },
