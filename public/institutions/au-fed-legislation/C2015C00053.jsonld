    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-5-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Direct marketing is permitted within this temporal interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval within which direct marketing is permitted.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:premiseText": "either:  (i) the individual has consented to the use or disclosure of the information for that purpose; or  (ii) it is impracticable to obtain that consent"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Use of personal information for direct marketing is permitted under these conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permission granted under certain conditions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:premiseText": "the organisation collected the information from:  (i) the individual and the individual would not reasonably expect the organisation to use or disclose the information for that purpose; or  (ii) someone other than the individual"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-5-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Consent is required from the individual before using their personal information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requirements for obtaining consent before using personal information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Requires",
      "cml:premiseText": "the individual has not made such a request to the organisation"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-5-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The individual is classified as non-sensitive if they did not provide consent.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classification of individuals into sensitive and non-sensitive categories.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:premiseText": "the organisation collected the information from:  (i) the individual and the individual would not reasonably expect the organisation to use or disclose the information for that purpose; or  (ii) someone other than the individual"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-5-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Direct marketing communications must include a prominent statement about requesting opt-out.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Characterization of direct marketing communications.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Characterizes",
      "cml:premiseText": "in each direct marketing communication with the individual:  (i) the organisation includes a prominent statement that the individual may make such a request; or  (ii) the organisation otherwise draws the individual’s attention to the fact that the individual may make such a request"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-5-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Direct marketing is not permitted after this temporal interval.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal interval until which direct marketing is not permitted.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:premiseText": "the organisation provides a simple means by which the individual may easily request not to receive direct marketing communications from the organisation"
    },
