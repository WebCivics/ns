        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines a temporal interval for the determination's effect after commencement time.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "(2) The determination has effect, after the commencement time, as if it had been made under that section, as amended by Schedule 4 to this Act."
    },
