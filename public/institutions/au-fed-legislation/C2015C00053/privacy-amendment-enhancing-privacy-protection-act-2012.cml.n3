doc:sch-4-sec-17-2 a cof:Section ;
    cof:title "17 Rules relating to tax file number information" ;
    values:kind "section" ;
    values:originalText "The Commissioner must, by legislative instrument, issue rules concerning the collection, storage, use and security of tax file number information." ;
    cof:pageNumber "178"^^xsd:integer .

