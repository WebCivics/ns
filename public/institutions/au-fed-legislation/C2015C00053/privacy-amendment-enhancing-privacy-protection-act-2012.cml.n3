concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-4 a cml:Concept ;
    skos:prefLabel "13 2 If:"@en ;
    cml:realizedBy doc:sch-1-sec-13-4 ;
    values:originalText "(a) the APP entity corrects personal information about an individual that the entity previously disclosed to another APP entity; and  (b) the individual requests the entity to notify the other APP entity of the correction; the entity must take such steps (if any) as are reasonable in the circumstances to give that notification unless it is impracticable or unlawful to do so. Refusal to correct information" ;
    skos:definition "(a) the APP entity corrects personal information about an individual that the entity previously disclosed to another APP entity; and  (b) the individual requests the entity to notify the other APP entity of the correction; the entity must take such steps (if any) as are reasonable in the circumstances to give that notification unless it is impracticable or unlawful to do so. Refusal to correct information"@en ;
    cml:integrityHash "209e3d5862ca02cf53191a8600be832ee37e2d66316db4aff0b1c908d44e4096" ;
    cof:pageNumber "51"^^xsd:integer ;
    skos:note "Entity must notify other APP entity of correction upon request." ;
    dc:description "notification" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-enhancing-privacy-protection-act-2012.pdf> ;
    dc:source "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.51" ;
