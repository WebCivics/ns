doc:sch-2-sec-20v-ss-1 a cof:Section ;
    cof:title "20V(1) Destruction etc. of credit reporting information after the" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if:  (a) a credit reporting body holds credit information about an individual; and  (b) the retention period for the information ends. Note: There is no retention period for identification information or credit information of a kind referred to in paragraph 6N(k). Destruction etc. of credit information" ;
    cof:pageNumber "99"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20v-ss-2 a cml:Concept ;
    skos:prefLabel "20V(2) Destruction etc. of credit reporting information after the"@en ;
    cml:realizedBy doc:sch-2-sec-20v-ss-2 ;
    values:originalText "(2) The credit reporting body must destroy the credit information, or ensure that the information is de-identified, within 1 month after the retention period for the information ends. Civil penalty: 1,000 penalty units." ;
    skos:definition "(2) The credit reporting body must destroy the credit information, or ensure that the information is de-identified, within 1 month after the retention period for the information ends. Civil penalty: 1,000 penalty units."@en ;
    cml:integrityHash "a94cd77fa5669caa048bb04dbb83735f0c7b19835a441e60266a5a157ff31f27" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20v ;
    cof:pageNumber "99"^^xsd:integer ;
    skos:note "Destroy credit information within 1 month after retention period ends." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
