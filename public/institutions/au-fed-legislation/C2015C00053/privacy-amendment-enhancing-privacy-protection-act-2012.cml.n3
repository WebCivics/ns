concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-5 a cml:Concept ;
    skos:prefLabel "20R(5) Access to credit reporting information"@en ;
    cml:realizedBy doc:sch-2-sec-20r-ss-5 ;
    values:originalText "(5) If a request under subsection (1) in relation to the individual has not been made to the credit reporting body in the previous 12 months, the body must not charge the access seeker for the making of the request or for giving access to the information." ;
