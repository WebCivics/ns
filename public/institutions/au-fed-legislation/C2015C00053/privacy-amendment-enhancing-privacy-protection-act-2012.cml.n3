concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40a-ss-5 a cml:Concept ;
    skos:prefLabel "40A(5) Conciliation of complaints"@en ;
    cml:realizedBy doc:sch-4-sec-40a-ss-5 ;
    values:originalText "(5) Evidence of anything said or done in the course of the conciliation is not admissible in any hearing before the Commissioner, or in any legal proceedings, relating to complaint or the act or practice unless:  (a) the complainant and respondent otherwise agree; or  (b) the thing was said or done in furtherance of the commission of a fraud or an offence, or the commission of an act that renders a person liable to a civil penalty." ;
    skos:definition "(5) Evidence of anything said or done in the course of the conciliation is not admissible in any hearing before the Commissioner, or in any legal proceedings, relating to complaint or the act or practice unless:  (a) the complainant and respondent otherwise agree; or  (b) the thing was said or done in furtherance of the commission of a fraud or an offence, or the commission of an act that renders a person liable to a civil penalty."@en ;
    cml:integrityHash "4880f4f122e7091d8a47d8bcb27f03f907a3aed82539c3953872a6e5cadbde83" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40a ;
    cof:pageNumber "190"^^xsd:integer ;
    skos:note "Complainant and respondent must agree for evidence to be admissible." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-enhancing-privacy-protection-act-2012.pdf> ;
    dc:source "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.190" ;
