concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26l a cml:Concept ;
    skos:prefLabel "26L Entities to comply with the registered CR code if bound by the"@en ;
    cml:realizedBy doc:sch-3-sec-26l ;
    values:originalText "code  If an entity is bound by the registered CR code, the entity must not do an act, or engage in a practice, that breaches the code. Note: There must always be one, and only one, registered CR code at all times after this Part commences: see subsection 26S(4)." ;
    skos:definition "code  If an entity is bound by the registered CR code, the entity must not do an act, or engage in a practice, that breaches the code. Note: There must always be one, and only one, registered CR code at all times after this Part commences: see subsection 26S(4)."@en ;
    cml:integrityHash "d587dd1bfb3d2aa585c84f3c889f0a9fd0f82bc5cec9b317c417e32742e70152" ;
    cof:pageNumber "160"^^xsd:integer ;
    skos:note "Entity must not breach the CR code" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
