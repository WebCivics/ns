doc:sch-3-sec-26e-ss-2 a cof:Section ;
    cof:title "26E(2) Development of APP codes by APP code developers" ;
    values:kind "subsection" ;
    values:originalText "(2) The Commissioner may, in writing, request an APP code developer to develop an APP code, and apply to the Commissioner for the code to be registered, if the Commissioner is satisfied it is in the public interest for the code to be developed." ;
    cof:pageNumber "155"^^xsd:integer .

