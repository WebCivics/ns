doc:sch-2-sec-6g-ss-5 a cof:Section ;
    cof:title "6G(5) Meaning of credit provider" ;
    values:kind "subsection" ;
    values:originalText "(5) Despite subsections (1) to (4) of this section, an organisation or small business operator acting in the capacity of:  (a) a real estate agent; or  (b) a general insurer (within the meaning of the Insurance Act 1973); or  (c) an employer of an individual; is not a credit provider while acting in that capacity." ;
    cof:pageNumber "66"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6g-ss-6 a cml:Concept ;
    skos:prefLabel "6G(6) Meaning of credit provider"@en ;
    cml:realizedBy doc:sch-2-sec-6g-ss-6 ;
    values:originalText "(6) Despite subsections (1) to (4) of this section, an organisation or small business operator is not a credit provider if it is included in a class of organisations or operators prescribed by the regulations." ;
    skos:definition "(6) Despite subsections (1) to (4) of this section, an organisation or small business operator is not a credit provider if it is included in a class of organisations or operators prescribed by the regulations."@en ;
    cml:integrityHash "8c41d4a9956122f0abba052b0fc6498d0da42637051bd3878fea11bdb172f00d" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6g ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "An organisation or small business operator is not a credit provider if it is included in a class of organisations or operators prescribed by the regulations." ;
