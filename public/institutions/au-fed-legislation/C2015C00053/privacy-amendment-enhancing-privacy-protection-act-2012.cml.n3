concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1 cml:asserts concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-alleninterval-2 .
concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "Temporal Interval" ;
    cml:logicSummary "Temporal interval for prohibition." ;
    cml:premiseText "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;" ;
    cml:conclusionText "the prohibition applies until the information is deleted or updated." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1 cml:asserts concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-ltl-3 .
