concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-48 a cml:Concept ;
    skos:prefLabel "48 Subsection 6(1)"@en ;
    cml:realizedBy doc:sch-2-sec-48 ;
    values:originalText "Insert: pending dispute in relation to credit information or CRB derived information means:  (a) a complaint made under section 23A that relates to the information if a decision about the complaint has not been made under subsection 23B(4); or  (b) a matter that relates to the information and that is still being dealt with by a recognised external dispute resolution scheme; or  (c) a complaint made to the Commissioner under Part V that relates to the information and that is still being dealt with." ;
    skos:definition "Insert: pending dispute in relation to credit information or CRB derived information means:  (a) a complaint made under section 23A that relates to the information if a decision about the complaint has not been made under subsection 23B(4); or  (b) a matter that relates to the information and that is still being dealt with by a recognised external dispute resolution scheme; or  (c) a complaint made to the Commissioner under Part V that relates to the information and that is still being dealt with."@en ;
    cml:integrityHash "934d88fe21ad1045c4eb72bced3e63bdff6b118767657610748a380841f229d1" ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "Definition of 'pending dispute in relation to credit information or CRB derived information'" ;
