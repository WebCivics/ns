concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26e-ss-5 a cml:Concept ;
    skos:prefLabel "26E(5) Development of APP codes by APP code developers"@en ;
    cml:realizedBy doc:sch-3-sec-26e-ss-5 ;
    values:originalText "(5) The request may:  (a) specify one or more matters that the APP code must deal with; and  (b) specify the APP entities, or a class of APP entities, that should be bound by the code." ;
    skos:definition "(5) The request may:  (a) specify one or more matters that the APP code must deal with; and  (b) specify the APP entities, or a class of APP entities, that should be bound by the code."@en ;
    cml:integrityHash "58b4e634960eaeffc230da848705173faaf83fdec76b7a3b52273c8465d2da90" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26e ;
