    cml:operator "must" ;
    cml:logicSummary "The credit provider must provide repayment history information." ;
    cml:premiseText "(1) If a credit provider provides consumer credit to an individual, the following information about the consumer credit is repayment history information about the individual:" ;
    cml:conclusionText "the credit provider must provide repayment history information" ;
    cml:executionSurface "modalities::logic::deontic" ;
