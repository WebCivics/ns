concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-5 a cml:Concept ;
    skos:prefLabel "23C(5) Notification requirements relating to correction complaints"@en ;
    cml:realizedBy doc:sch-2-sec-23c-ss-5 ;
    values:originalText "(5) If:  (a) a credit provider discloses personal information to which the complaint relates under Division 3 of this Part or under the Australian Privacy Principles; and  (b) at the time of the disclosure, a decision about the complaint under subsection 23B(4) has not been made; the provider must, at that time, notify in writing the recipient of the information of the complaint. Exceptions" ;
    skos:definition "(5) If:  (a) a credit provider discloses personal information to which the complaint relates under Division 3 of this Part or under the Australian Privacy Principles; and  (b) at the time of the disclosure, a decision about the complaint under subsection 23B(4) has not been made; the provider must, at that time, notify in writing the recipient of the information of the complaint. Exceptions"@en ;
    cml:integrityHash "35e60cf0de259f92a454264e45c3a05a7315575733b1919650e062330c76ab66" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c ;
    cof:pageNumber "143"^^xsd:integer ;
    skos:note "Credit provider must notify recipient of complaint if personal information is disclosed under Division 3 or Australian Privacy Principles." ;
    dc:description "Notification in writing" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
