concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21a-ss-3 a cml:Concept ;
    skos:prefLabel "21A(3) Application of this Division to credit providers"@en ;
    cml:realizedBy doc:sch-2-sec-21a-ss-3 ;
    values:originalText "(3) A credit provider must have a clearly expressed and up-to-date policy about the management of credit information and credit eligibility information by the provider." ;
    skos:definition "(3) A credit provider must have a clearly expressed and up-to-date policy about the management of credit information and credit eligibility information by the provider."@en ;
    cml:integrityHash "c0d330507dc065396dd91c99bcfbbd20ecfb7cd5757f234da4a95ee602ea6910" ;
