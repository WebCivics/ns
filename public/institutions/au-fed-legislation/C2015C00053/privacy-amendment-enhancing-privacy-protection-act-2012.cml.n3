doc:sch-2-sec-20h-ss-4 a cof:Section ;
    cof:title "20H(4) Use or disclosure of pre-screening assessments" ;
    values:kind "subsection" ;
    values:originalText "(4) If the credit reporting body discloses the pre-screening assessment under subsection (2), the recipient must not use or disclose the assessment. Civil penalty: 1,000 penalty units." ;
    cof:pageNumber "88"^^xsd:integer .

