    cof:title "14(2) Australian Privacy Principles" ;
    values:kind "subsection" ;
    values:originalText "(2) A reference in any Act to an Australian Privacy Principle by a number is a reference to the Australian Privacy Principle with that number." ;
    cof:pageNumber "21"^^xsd:integer .

