doc:sch-2-sec-21g-ss-4 a cof:Section ;
    cof:title "21G(4) Use or disclosure of credit eligibility information" ;
    values:kind "subsection" ;
    values:originalText "(4) However, if the credit eligibility information about the individual is, or was derived from, repayment history information about the individual, the credit provider must not disclose the information under subsection (3). Civil penalty: 2,000 penalty units." ;
    cof:pageNumber "114"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21g-ss-5 a cml:Concept ;
    skos:prefLabel "21G(5) Use or disclosure of credit eligibility information"@en ;
    cml:realizedBy doc:sch-2-sec-21g-ss-5 ;
    values:originalText "(5) Subsection (4) does not apply if:  (a) the recipient of the credit eligibility information is another credit provider who is a licensee; or  (b) the disclosure is a permitted CP disclosure within the meaning of section 21L; or  (c) the credit provider discloses the credit eligibility information under paragraph (3)(b), (c), (e) or (f); or ComLaw Authoritative Act C2015C00053  Schedule 2  Credit reporting  Privacy Amendment (Enhancing Privacy Protection) Act 2012  Compilation date: 12/3/14 Registered: 6/3/15  (d) the credit provider discloses the credit eligibility information under paragraph (3)(d) to an enforcement body. Written note of use or disclosure" ;
    skos:definition "(5) Subsection (4) does not apply if:  (a) the recipient of the credit eligibility information is another credit provider who is a licensee; or  (b) the disclosure is a permitted CP disclosure within the meaning of section 21L; or  (c) the credit provider discloses the credit eligibility information under paragraph (3)(b), (c), (e) or (f); or ComLaw Authoritative Act C2015C00053  Schedule 2  Credit reporting  Privacy Amendment (Enhancing Privacy Protection) Act 2012  Compilation date: 12/3/14 Registered: 6/3/15  (d) the credit provider discloses the credit eligibility information under paragraph (3)(d) to an enforcement body. Written note of use or disclosure"@en ;
    cml:integrityHash "8b41065e62a81a7f3ffe48b401b778cf7c9ce75f6bca78b1dc1b0071de24d61c" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21g ;
