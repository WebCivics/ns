doc:sch-2-sec-20n-ss-1 a cof:Section ;
    cof:title "20N(1) Quality of credit reporting information" ;
    values:kind "subsection" ;
    values:originalText "(1) A credit reporting body must take such steps as are reasonable in the circumstances to ensure that the credit information the body collects is accurate, up-to-date and complete." ;
    cof:pageNumber "93"^^xsd:integer .

