doc:sch-2-sec-20d-ss-4 a cof:Section ;
    cof:title "20D(4) Dealing with unsolicited credit information" ;
    values:kind "subsection" ;
    values:originalText "(4) If the credit reporting body determines that it could not have collected the credit information, the body must, as soon as practicable, destroy the information. ComLaw Authoritative Act C2015C00053  Schedule 2  Credit reporting  Privacy Amendment (Enhancing Privacy Protection) Act 2012  Compilation date: 12/3/14 Registered: 6/3/15  Civil penalty: 1,000 penalty units." ;
    cof:pageNumber "83"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20d-ss-5 a cml:Concept ;
    skos:prefLabel "20D(5) Dealing with unsolicited credit information"@en ;
    cml:realizedBy doc:sch-2-sec-20d-ss-5 ;
    values:originalText "(5) Subsection (4) does not apply if the credit reporting body is required by or under an Australian law, or a court/tribunal order, to retain the credit information. Subdivision D—Dealing with credit reporting information etc." ;
    skos:definition "(5) Subsection (4) does not apply if the credit reporting body is required by or under an Australian law, or a court/tribunal order, to retain the credit information. Subdivision D—Dealing with credit reporting information etc."@en ;
