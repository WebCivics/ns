concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-9 a cml:Concept ;
    skos:prefLabel "9 Subsection 6(1)"@en ;
    cml:realizedBy doc:sch-2-sec-9 ;
    values:originalText "Insert: consumer credit means credit:  (a) for which an application has been made by an individual to a credit provider, or that has been provided to an individual by a credit provider, in the course of the provider carrying on a business or undertaking as a credit provider; and  (b) that is intended to be used wholly or primarily:  (i) for personal, family or household purposes; or  (ii) to acquire, maintain, renovate or improve residential property for investment purposes; or  (iii) to refinance consumer credit that has been provided wholly or primarily to acquire, maintain, renovate or improve residential property for investment purposes." ;
    skos:definition "Insert: consumer credit means credit:  (a) for which an application has been made by an individual to a credit provider, or that has been provided to an individual by a credit provider, in the course of the provider carrying on a business or undertaking as a credit provider; and  (b) that is intended to be used wholly or primarily:  (i) for personal, family or household purposes; or  (ii) to acquire, maintain, renovate or improve residential property for investment purposes; or  (iii) to refinance consumer credit that has been provided wholly or primarily to acquire, maintain, renovate or improve residential property for investment purposes."@en ;
    cml:integrityHash "5fa85d571449aba7231e40a647f86d9691231fb4c73cbbab7bd1a17037d1fbf6" ;
    cof:pageNumber "54"^^xsd:integer ;
    skos:note "Defines consumer credit" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
