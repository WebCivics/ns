doc:sch-2-sec-20c-ss-7 a cof:Section ;
    cof:title "20C(7) Collection of solicited credit information" ;
    values:kind "subsection" ;
    values:originalText "(7) A credit reporting body must collect credit information only by lawful and fair means. Solicited credit information" ;
    cof:pageNumber "81"^^xsd:integer .

