concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-58-2 a cml:Concept ;
    skos:prefLabel "58 Obligations of agencies"@en ;
    cml:realizedBy doc:sch-4-sec-58-2 ;
    values:originalText "If this Division applies to a determination and the determination applies in relation to an agency, the agency:  (a) must not repeat or continue conduct that is covered by a declaration included in the determination under subparagraph 52(1)(b)(i) or paragraph 52(1A)(a); and  (b) must take the steps that are specified in a declaration included in the determination under subparagraph 52(1)(b)(ia) or paragraph 52(1A)(b) within the specified period; and  (c) must perform the act or course of conduct that is covered by a declaration included in the determination under subparagraph 52(1)(b)(ii) or paragraph 52(1A)(c)." ;
    skos:definition "If this Division applies to a determination and the determination applies in relation to an agency, the agency:  (a) must not repeat or continue conduct that is covered by a declaration included in the determination under subparagraph 52(1)(b)(i) or paragraph 52(1A)(a); and  (b) must take the steps that are specified in a declaration included in the determination under subparagraph 52(1)(b)(ia) or paragraph 52(1A)(b) within the specified period; and  (c) must perform the act or course of conduct that is covered by a declaration included in the determination under subparagraph 52(1)(b)(ii) or paragraph 52(1A)(c)."@en ;
    cml:integrityHash "b5fedcf61a9d807023e3dbeb84f5ae3b070b28966e444b58e57806f3f46d4bd9" ;
    cof:pageNumber "200"^^xsd:integer ;
    skos:note "Agency must not repeat or continue conduct covered by a declaration included in the determination." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
