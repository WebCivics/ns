concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zf a cml:Concept ;
    skos:prefLabel "80ZF Criminal proceedings after civil proceedings"@en ;
    cml:realizedBy doc:sch-4-sec-80zf ;
    values:originalText "Criminal proceedings may be commenced against an entity for conduct that is the same, or substantially the same, as conduct that would constitute a contravention of a civil penalty provision regardless of whether a civil penalty order has been made against the entity in relation to the contravention. ComLaw Authoritative Act C2015C00053  Other amendments of the Privacy Act 1988  Schedule 4  Privacy Amendment (Enhancing Privacy Protection) Act 2012 Compilation date: 12/3/14 Registered: 6/3/15" ;
    skos:definition "Criminal proceedings may be commenced against an entity for conduct that is the same, or substantially the same, as conduct that would constitute a contravention of a civil penalty provision regardless of whether a civil penalty order has been made against the entity in relation to the contravention. ComLaw Authoritative Act C2015C00053  Other amendments of the Privacy Act 1988  Schedule 4  Privacy Amendment (Enhancing Privacy Protection) Act 2012 Compilation date: 12/3/14 Registered: 6/3/15"@en ;
    cml:integrityHash "6bb292cd46cd63d8352dabb6a6f4b1180b862c379de0ff7b9bfc09f5c9112c3d" ;
    cof:pageNumber "210"^^xsd:integer ;
    skos:note "Criminal proceedings may be commenced against an entity for conduct that is the same, or substantially the same, as conduct that would constitute a contravention of a civil penalty provision." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-enhancing-privacy-protection-act-2012.pdf> ;
    dc:source "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.210" ;
    cml:asserts concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zf-norm .
