concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-3 a cml:Concept ;
    skos:prefLabel "20B(3) Open and transparent management of credit reporting"@en ;
    cml:realizedBy doc:sch-2-sec-20b-ss-3 ;
