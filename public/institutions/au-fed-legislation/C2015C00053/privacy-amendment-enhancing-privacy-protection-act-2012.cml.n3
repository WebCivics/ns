doc:sch-2-sec-22a-ss-6 a cof:Section ;
    cof:title "22A(6) Open and transparent management of regulated information" ;
    values:kind "subsection" ;
    values:originalText "(6) If a person or body requests a copy, in a particular form, of the policy of an affected information recipient, the recipient must take such steps as are reasonable in the circumstances to give the person or body a copy in that form. Interaction with the Australian Privacy Principles" ;
    cof:pageNumber "133"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a-ss-7 a cml:Concept ;
    skos:prefLabel "22A(7) Open and transparent management of regulated information"@en ;
    cml:realizedBy doc:sch-2-sec-22a-ss-7 ;
    values:originalText "(7) If an affected information recipient is an APP entity, Australian Privacy Principles 1.3 and 1.4 do not apply to the recipient in relation to the regulated information of the recipient. Subdivision B—Dealing with regulated information" ;
    skos:definition "(7) If an affected information recipient is an APP entity, Australian Privacy Principles 1.3 and 1.4 do not apply to the recipient in relation to the regulated information of the recipient. Subdivision B—Dealing with regulated information"@en ;
    cml:integrityHash "7eb5eed273be73160ae0369f3f2d0eb390bb1bdbbaa30cd1cf8aa59bb107fb70" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a ;
    cof:pageNumber "133"^^xsd:integer ;
    skos:note "Exemption from Australian Privacy Principles for APP entities" ;
    cml:curationStatus cml:Proposed ;
