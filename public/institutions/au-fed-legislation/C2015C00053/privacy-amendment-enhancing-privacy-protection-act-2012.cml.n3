    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-25a ;
    cof:pageNumber "147"^^xsd:integer ;
    skos:note "Court may make order to compensate loss or damage within 6 years of the cause of action." ;
