concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-5-3 a cml:Concept ;
    skos:prefLabel "5 Section 5"@en ;
    cml:realizedBy doc:sch-1-sec-5-3 ;
    values:originalText "1 At or before the time or, if that is not practicable, as soon as practicable after, an APP entity collects personal information about an individual, the entity must take such steps (if any) as are reasonable in the circumstances:  (a) to notify the individual of such matters referred to in subclause 5.2 as are reasonable in the circumstances; or  (b) to otherwise ensure that the individual is aware of any such matters." ;
    skos:definition "1 At or before the time or, if that is not practicable, as soon as practicable after, an APP entity collects personal information about an individual, the entity must take such steps (if any) as are reasonable in the circumstances:  (a) to notify the individual of such matters referred to in subclause 5.2 as are reasonable in the circumstances; or  (b) to otherwise ensure that the individual is aware of any such matters."@en ;
    cml:integrityHash "4f7ae7febafff0cc11bbd6083611cd2b179a7becad1336e891001bd328838249" ;
    cof:pageNumber "37"^^xsd:integer ;
    skos:note "Notify individual of personal information collected" ;
    dc:description "Notification or awareness" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
