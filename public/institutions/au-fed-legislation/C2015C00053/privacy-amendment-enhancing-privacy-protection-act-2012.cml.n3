doc:sch-2-sec-20k-ss-4 a cof:Section ;
    cof:title "20K(4) No use or disclosure of credit reporting information during a" ;
    values:kind "subsection" ;
    values:originalText "(4) If:  (a) there is a ban period for credit reporting information about an individual that is held by a credit reporting body; and  (b) before the ban period ends, the individual requests the body to extend that period; and  (c) the body believes on reasonable grounds that the individual has been, or is likely to be, a victim of fraud (including identity fraud); the body must:  (d) extend the ban period by such period as the body considers is reasonable in the circumstances; and  (e) give the individual written notification of the extension. Civil penalty: 1,000 penalty units." ;
    cof:pageNumber "90"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20k-ss-5 a cml:Concept ;
    skos:prefLabel "20K(5) No use or disclosure of credit reporting information during a"@en ;
    cml:realizedBy doc:sch-2-sec-20k-ss-5 ;
    values:originalText "(5) A ban period for credit reporting information may be extended more than once under subsection (4). No charge for request etc." ;
