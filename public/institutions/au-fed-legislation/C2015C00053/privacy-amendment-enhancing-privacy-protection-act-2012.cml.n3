concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d-ss-1 a cml:Concept ;
    skos:prefLabel "22D(1) Use or disclosure of information by a related body corporate"@en ;
    cml:realizedBy doc:sch-2-sec-22d-ss-1 ;
    values:originalText "(1) If:  (a) a person holds or held credit eligibility information about an individual; and  (b) the information was disclosed to the person by a credit provider under paragraph 21G(3)(c); the person must not use or disclose the information, or any personal information about the individual derived from that information. Civil penalty: 1,000 penalty units. Permitted uses" ;
    skos:definition "(1) If:  (a) a person holds or held credit eligibility information about an individual; and  (b) the information was disclosed to the person by a credit provider under paragraph 21G(3)(c); the person must not use or disclose the information, or any personal information about the individual derived from that information. Civil penalty: 1,000 penalty units. Permitted uses"@en ;
    cml:integrityHash "222ee5be3b01cdcbb04881c3a0c89f3c3b118c050dfa6ecd01c90c33229ee97d" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d ;
    cof:pageNumber "137"^^xsd:integer ;
    skos:note "Prohibition on using or disclosing credit information without consent. Recipient must not use or disclose credit eligibility information. Body corporate must not use or disclose credit eligibility information about an individual." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-enhancing-privacy-protection-act-2012.pdf> ;
    dc:source "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.137" ;
    cml:asserts concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d-ss-1-norm .
