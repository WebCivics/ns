    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21u ;
    cof:pageNumber "129"^^xsd:integer ;
    skos:note "Use or disclosure of personal information for consultation purposes is authorized. Credit provider must comply with Australian Privacy Principle 13 when handling identification information." ;
