concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40 a cml:Concept ;
    skos:prefLabel "40 After subsection 12B(5)"@en ;
    cml:realizedBy doc:sch-4-sec-40 ;
    values:originalText "Insert:  (5A) This Act also has the effect it would have if its operation in relation to regulated entities were expressly confined to acts or practices engaged in by regulated entities in the course of:  (a) banking (other than State banking not extending beyond the limits of the State concerned); or  (b) insurance (other than State insurance not extending beyond the limits of the State concerned)." ;
    skos:definition "Insert:  (5A) This Act also has the effect it would have if its operation in relation to regulated entities were expressly confined to acts or practices engaged in by regulated entities in the course of:  (a) banking (other than State banking not extending beyond the limits of the State concerned); or  (b) insurance (other than State insurance not extending beyond the limits of the State concerned)."@en ;
    cml:integrityHash "e4d746cfd32a1ffacaefb0ba683f0a266428b94ab4001e3afb077aead3882526" ;
    cof:pageNumber "174"^^xsd:integer ;
