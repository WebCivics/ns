concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13e a cml:Concept ;
    skos:prefLabel "13E Effect of sections 13B, 13C and 13D"@en ;
    cml:realizedBy doc:sch-4-sec-13e ;
    values:originalText "Sections 13B, 13C and 13D do not prevent an act or practice of an organisation from being an interference with the privacy of an individual under subsection 13(2), (4) or (5)." ;
    skos:definition "Sections 13B, 13C and 13D do not prevent an act or practice of an organisation from being an interference with the privacy of an individual under subsection 13(2), (4) or (5)."@en ;
    cml:integrityHash "96f431d2eddfbedd9fef36b69a626368463e6a7f39bc9407928f335d20923c89" ;
    cof:pageNumber "177"^^xsd:integer ;
    skos:note "Organisations may still interfere with individual privacy despite sections 13B, 13C and 13D." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-enhancing-privacy-protection-act-2012.pdf> ;
    dc:source "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.177" ;
    cml:asserts concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13e-norm .
