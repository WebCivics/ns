doc:sch-1-sec-4-3 a cof:Section ;
    cof:title "4 1 If:" ;
    values:kind "section" ;
    values:originalText "(a) an APP entity receives personal information; and  (b) the entity did not solicit the information; the entity must, within a reasonable period after receiving the information, determine whether or not the entity could have collected the information under Australian Privacy Principle 3 if the entity had solicited the information." ;
    cof:pageNumber "36"^^xsd:integer .

