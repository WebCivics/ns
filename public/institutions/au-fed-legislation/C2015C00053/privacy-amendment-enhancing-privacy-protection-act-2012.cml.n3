concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-6 a cml:Concept ;
    skos:prefLabel "23C(6) Notification requirements relating to correction complaints"@en ;
    cml:realizedBy doc:sch-2-sec-23c-ss-6 ;
    values:originalText "(6) Subsection (2), (3), (4) or (5) does not apply if:  (a) it is impracticable for the credit reporting body or credit provider to give the notification under that subsection; or  (b) the credit reporting body or credit provider is required by or under an Australian law, or a court/tribunal order, not to give the notification under that subsection." ;
    skos:definition "(6) Subsection (2), (3), (4) or (5) does not apply if:  (a) it is impracticable for the credit reporting body or credit provider to give the notification under that subsection; or  (b) the credit reporting body or credit provider is required by or under an Australian law, or a court/tribunal order, not to give the notification under that subsection."@en ;
    cml:integrityHash "e834bf99d960e1aba25471061d6c9e0b56e8ce0fdd5f778fbf77fe4785478f0f" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c ;
    cof:pageNumber "143"^^xsd:integer ;
    skos:note "Exemption from notification requirements under certain circumstances" ;
