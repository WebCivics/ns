    cml:operator "Recurring Trace" ;
    cml:logicSummary "Recurring trace for prohibition." ;
    cml:premiseText "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;" ;
    cml:conclusionText "the prohibition is recurring and applies until the information is deleted or updated." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1 cml:asserts concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-diffusion-4 .
concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "Diffusion" ;
    cml:logicSummary "Diffusion of prohibition." ;
    cml:premiseText "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;" ;
    cml:conclusionText "the diffusion of the prohibition applies to all parties with access to the information." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1 cml:asserts concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-cogai-5 .
concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-cogai-5 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "Knowledge Representation" ;
    cml:logicSummary "Knowledge representation for prohibition." ;
    cml:premiseText "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;" ;
    cml:conclusionText "the knowledge representation includes the prohibition on use or disclosure." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-2-sec-22c-ss-1 a cof:Section ;
    cof:title "22C(1) Use or disclosure of information by mortgage insurers or trade" ;
    values:kind "subsection" ;
    values:originalText "(1) If: ComLaw Authoritative Act C2015C00053  Schedule 2  Credit reporting  Privacy Amendment (Enhancing Privacy Protection) Act 2012  Compilation date: 12/3/14 Registered: 6/3/15  (a) a mortgage insurer or trade insurer holds or held personal information about an individual; and  (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part; the insurer must not use or disclose the information, or any personal information about the individual derived from that information. Civil penalty: 2,000 penalty units. Permitted uses" ;
    cof:pageNumber "135"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-2 a cml:Concept ;
    skos:prefLabel "22C(2) Use or disclosure of information by mortgage insurers or trade"@en ;
    cml:realizedBy doc:sch-2-sec-22c-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply to the use of the information if:  (a) for a mortgage insurer—the use is for:  (i) a mortgage insurance purpose of the insurer in relation to the individual; or  (ii) any purpose arising under a contract for mortgage insurance that has been entered into between the credit provider and the insurer; or  (b) for a trade insurer—the use is for a trade insurance purpose of the insurer in relation to the individual; or  (c) the use is required or authorised by or under an Australian law or a court/tribunal order. Permitted disclosure" ;
    skos:definition "(2) Subsection (1) does not apply to the use of the information if:  (a) for a mortgage insurer—the use is for:  (i) a mortgage insurance purpose of the insurer in relation to the individual; or  (ii) any purpose arising under a contract for mortgage insurance that has been entered into between the credit provider and the insurer; or  (b) for a trade insurer—the use is for a trade insurance purpose of the insurer in relation to the individual; or  (c) the use is required or authorised by or under an Australian law or a court/tribunal order. Permitted disclosure"@en ;
    cml:integrityHash "90362826ba5160a930736acccddf75582d25c78c0ffd53fb5bf6549207c25d5d" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c ;
    cof:pageNumber "135"^^xsd:integer ;
    skos:note "Permitted disclosure of information under certain conditions." ;
