    cml:hasPart concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21w-ss-2 ;
    cml:hasPart concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21w-ss-3 ;
    cml:hasPart concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21w-ss-4 ;
    cml:hasPart concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21w-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-enhancing-privacy-protection-act-2012.pdf> ;
