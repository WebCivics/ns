doc:sch-2-sec-23b-ss-1 a cof:Section ;
    cof:title "23B(1) Dealing with complaints" ;
    values:kind "subsection" ;
    values:originalText "(1) If an individual makes a complaint under section 23A, the respondent for the complaint:  (a) must, within 7 days after the complaint is made, give the individual a written notice that:  (i) acknowledges the making of the complaint; and  (ii) sets out how the respondent will deal with the complaint; and  (b) must investigate the complaint. Consultation about the complaint" ;
    cof:pageNumber "142"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23b-ss-2 a cml:Concept ;
    skos:prefLabel "23B(2) Dealing with complaints"@en ;
    cml:realizedBy doc:sch-2-sec-23b-ss-2 ;
    values:originalText "(2) If the respondent for the complaint considers that it is necessary to consult a credit reporting body or credit provider about the complaint, the respondent must consult the body or provider." ;
    skos:definition "(2) If the respondent for the complaint considers that it is necessary to consult a credit reporting body or credit provider about the complaint, the respondent must consult the body or provider."@en ;
    cml:integrityHash "45b161707e39965321e829a49b290fac728cf367abbcb0799bcaebf44ecf6a98" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23b ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "Respondent must consult credit reporting body or provider about complaint." ;
