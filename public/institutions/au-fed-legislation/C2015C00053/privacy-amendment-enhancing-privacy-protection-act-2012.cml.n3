    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6k ;
    cof:pageNumber "70"^^xsd:integer ;
    skos:note "Application to original credit provider is taken as made to acquirer." ;
    cml:curationStatus cml:Proposed ;
