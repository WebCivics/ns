concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-5 a cml:Concept ;
    skos:prefLabel "20B(5) Open and transparent management of credit reporting"@en ;
    cml:realizedBy doc:sch-2-sec-20b-ss-5 ;
    values:originalText "(5) A credit reporting body must take such steps as are reasonable in the circumstances to make the policy available:  (a) free of charge; and  (b) in such form as is appropriate. Note: A credit reporting body will usually make the policy available on the body’s website." ;
    skos:definition "(5) A credit reporting body must take such steps as are reasonable in the circumstances to make the policy available:  (a) free of charge; and  (b) in such form as is appropriate. Note: A credit reporting body will usually make the policy available on the body’s website."@en ;
    cml:integrityHash "83e2d4299dc814b0e082e16376330eeb32d29244dfd0ee957641c04d010ff9d5" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b ;
    cof:pageNumber "80"^^xsd:integer ;
    skos:note "Credit reporting bodies must make the policy available free of charge and in an appropriate form." ;
