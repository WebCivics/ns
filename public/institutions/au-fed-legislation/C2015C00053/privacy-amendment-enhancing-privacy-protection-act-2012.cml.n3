concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d-ss-3 a cml:Concept ;
    skos:prefLabel "22D(3) Use or disclosure of information by a related body corporate"@en ;
    cml:realizedBy doc:sch-2-sec-22d-ss-3 ;
    values:originalText "(3) Subsection (1) does not apply to the disclosure of the information if the disclosure is required or authorised by or under an Australian law or a court/tribunal order. Interaction with the Australian Privacy Principles" ;
    skos:definition "(3) Subsection (1) does not apply to the disclosure of the information if the disclosure is required or authorised by or under an Australian law or a court/tribunal order. Interaction with the Australian Privacy Principles"@en ;
    cml:integrityHash "bb13d13a7cc28840d3ce4db1db8080ecc8737c50b5cc9bd20b4d9e251c506afa" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d ;
    cof:pageNumber "137"^^xsd:integer ;
    skos:note "Disclosure of information to credit provider or under Australian law is permitted. Permits use or disclosure of information by a related body corporate Disclosure of information is permitted if required or authorised by an Australian law or court/tribunal order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
