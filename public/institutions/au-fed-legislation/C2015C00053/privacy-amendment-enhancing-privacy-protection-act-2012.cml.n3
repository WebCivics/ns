doc:sch-2-sec-20s-ss-1 a cof:Section ;
    cof:title "20S(1) Correction of credit reporting information" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a credit reporting body holds credit reporting information about an individual; and  (b) the body is satisfied that, having regard to a purpose for which the information is held by the body, the information is inaccurate, out-of-date, incomplete, irrelevant or misleading; the body must take such steps (if any) as are reasonable in the circumstances to correct the information to ensure that, having regard to the purpose for which it is held, the information is accurate, up-to-date, complete, relevant and not misleading." ;
    cof:pageNumber "96"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20s-ss-2 a cml:Concept ;
    skos:prefLabel "20S(2) Correction of credit reporting information"@en ;
    cml:realizedBy doc:sch-2-sec-20s-ss-2 ;
    values:originalText "(2) If:  (a) the credit reporting body corrects credit reporting information under subsection (1); and  (b) the body has previously disclosed the information under this Division (other than subsections 20D(2) and 20T(4)); the body must, within a reasonable period, give each recipient of the information written notice of the correction." ;
    skos:definition "(2) If:  (a) the credit reporting body corrects credit reporting information under subsection (1); and  (b) the body has previously disclosed the information under this Division (other than subsections 20D(2) and 20T(4)); the body must, within a reasonable period, give each recipient of the information written notice of the correction."@en ;
    cml:integrityHash "6557a3ed42f702a9087bc72b3e2e3212238fead70c5e04978d9613dda4fef9a1" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20s ;
    cof:pageNumber "96"^^xsd:integer ;
    skos:note "Credit reporting body must correct inaccurate information within a specified period. Body must provide written notice of correction within a reasonable period." ;
    dc:description "written notice" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
