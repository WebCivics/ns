doc:sch-3-sec-26f-ss-2 a cof:Section ;
    cof:title "26F(2) Application for registration of APP codes" ;
    values:kind "subsection" ;
    values:originalText "(2) Before making the application, the APP code developer must:  (a) make a draft of the APP code publicly available; and  (b) invite the public to make submissions to the developer about the draft within a specified period (which must run for at least 28 days); and  (c) give consideration to any submissions made within the specified period." ;
    cof:pageNumber "156"^^xsd:integer .

