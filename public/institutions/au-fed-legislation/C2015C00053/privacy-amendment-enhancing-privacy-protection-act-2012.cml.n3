    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-28b ;
    cof:pageNumber "181"^^xsd:integer ;
    skos:note "Instrument is not a legislative instrument if Minister is informed in writing or report is provided in writing." ;
