doc:sch-2-sec-22d-ss-1 a cof:Section ;
    cof:title "22D(1) Use or disclosure of information by a related body corporate" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a person holds or held credit eligibility information about an individual; and  (b) the information was disclosed to the person by a credit provider under paragraph 21G(3)(c); the person must not use or disclose the information, or any personal information about the individual derived from that information. Civil penalty: 1,000 penalty units. Permitted uses" ;
    cof:pageNumber "137"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d-ss-2 a cml:Concept ;
    skos:prefLabel "22D(2) Use or disclosure of information by a related body corporate"@en ;
    cml:realizedBy doc:sch-2-sec-22d-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply to the use of the information if:  (a) the person uses the information for the purpose for which it was disclosed to the person under paragraph 21G(3)(c); or  (b) the use is required or authorised by or under an Australian law or a court/tribunal order. Permitted disclosure" ;
    skos:definition "(2) Subsection (1) does not apply to the use of the information if:  (a) the person uses the information for the purpose for which it was disclosed to the person under paragraph 21G(3)(c); or  (b) the use is required or authorised by or under an Australian law or a court/tribunal order. Permitted disclosure"@en ;
    cml:integrityHash "3f5950bd60970fc1cbd2e7c3fba25900de49a35ae452ee8d0bc6657ab13aac64" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d ;
    cof:pageNumber "137"^^xsd:integer ;
    skos:note "Permits use or disclosure of information by a related body corporate under certain conditions. Permitted disclosure of information Permitted disclosure of information under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
