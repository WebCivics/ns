doc:sch-2-sec-25-2-ss-2 a cof:Section ;
    cof:title "25(2) Compensation orders" ;
    values:kind "subsection" ;
    values:originalText "(2) The court may make the order only if: ComLaw Authoritative Act C2015C00053  Credit reporting  Schedule 2  Privacy Amendment (Enhancing Privacy Protection) Act 2012 Compilation date: 12/3/14 Registered: 6/3/15  (a) the person applies for an order under this section; and  (b) the application is made within 6 years of the day the cause of action that relates to the contravention or commission of the offence accrued." ;
    cof:pageNumber "146"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-25-2-ss-3 a cml:Concept ;
    skos:prefLabel "25(3) Compensation orders"@en ;
    cml:realizedBy doc:sch-2-sec-25-2-ss-3 ;
    values:originalText "(3) If the court makes the order, the amount of compensation specified in the order that is to be paid to the person may be recovered as a debt due to the person." ;
    skos:definition "(3) If the court makes the order, the amount of compensation specified in the order that is to be paid to the person may be recovered as a debt due to the person."@en ;
    cml:integrityHash "fa3bcc1d2e6f4d71469f38c52b19a600e64c1b4e40ce4ed3dcfa9549823799d3" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-25-2 ;
    cof:pageNumber "146"^^xsd:integer ;
    skos:note "Debt recovery for compensation order" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
