concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-7 a cml:Concept ;
    skos:prefLabel "13 Section 13"@en ;
    cml:realizedBy doc:sch-1-sec-13-7 ;
    values:originalText "5 If a request is made under subclause 13.1 or 13.4, the APP entity: ComLaw Authoritative Act C2015C00053  Schedule 1  Australian Privacy Principles  Privacy Amendment (Enhancing Privacy Protection) Act 2012  Compilation date: 12/3/14 Registered: 6/3/15  (a) must respond to the request:  (i) if the entity is an agency—within 30 days after the request is made; or  (ii) if the entity is an organisation—within a reasonable period after the request is made; and  (b) must not charge the individual for the making of the request, for correcting the personal information or for associating the statement with the personal information (as the case may be). ComLaw Authoritative Act C2015C00053  Credit reporting  Schedule 2  Privacy Amendment (Enhancing Privacy Protection) Act 2012 Compilation date: 12/3/14 Registered: 6/3/15" ;
    skos:definition "5 If a request is made under subclause 13.1 or 13.4, the APP entity: ComLaw Authoritative Act C2015C00053  Schedule 1  Australian Privacy Principles  Privacy Amendment (Enhancing Privacy Protection) Act 2012  Compilation date: 12/3/14 Registered: 6/3/15  (a) must respond to the request:  (i) if the entity is an agency—within 30 days after the request is made; or  (ii) if the entity is an organisation—within a reasonable period after the request is made; and  (b) must not charge the individual for the making of the request, for correcting the personal information or for associating the statement with the personal information (as the case may be). ComLaw Authoritative Act C2015C00053  Credit reporting  Schedule 2  Privacy Amendment (Enhancing Privacy Protection) Act 2012 Compilation date: 12/3/14 Registered: 6/3/15"@en ;
    cml:integrityHash "e354bd6802b2f95d17cb5524cce578074283e03ae36e9e7ca7b412750fe2704e" ;
    cof:pageNumber "51"^^xsd:integer ;
    skos:note "Must respond to request within specified timeframe and not charge individual for making the request." ;
    dc:description "Response to request" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
