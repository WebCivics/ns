concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-4 a cml:Concept ;
    skos:prefLabel "1 Section 1"@en ;
    cml:realizedBy doc:sch-1-sec-1-4 ;
    values:originalText "2 An APP entity must take such steps as are reasonable in the circumstances to implement practices, procedures and systems relating to the entity’s functions or activities that:  (a) will ensure that the entity complies with the Australian Privacy Principles and a registered APP code (if any) that binds the entity; and  (b) will enable the entity to deal with inquiries or complaints from individuals about the entity’s compliance with the Australian Privacy Principles or such a code. APP Privacy policy" ;
    skos:definition "2 An APP entity must take such steps as are reasonable in the circumstances to implement practices, procedures and systems relating to the entity’s functions or activities that:  (a) will ensure that the entity complies with the Australian Privacy Principles and a registered APP code (if any) that binds the entity; and  (b) will enable the entity to deal with inquiries or complaints from individuals about the entity’s compliance with the Australian Privacy Principles or such a code. APP Privacy policy"@en ;
    cml:integrityHash "adf277fafdae532c7dbee93a21c0bd28bb3873b6a6426f7005e1e3a036e662e2" ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "Must implement practices, procedures and systems to comply with Australian Privacy Principles." ;
    cml:curationStatus cml:Proposed ;
