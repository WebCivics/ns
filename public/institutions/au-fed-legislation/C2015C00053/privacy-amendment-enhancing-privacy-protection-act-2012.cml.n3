doc:sch-2-sec-6k-ss-1 a cof:Section ;
    cof:title "6K(1) Acquisition of the rights of a credit provider" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) an organisation or small business operator (the acquirer) acquires, whether by assignment, subrogation or any other means, the rights of a credit provider (the original credit provider) in relation to the repayment of an amount of credit; and  (b) the acquirer is not a credit provider under subsection 6G(1); then the acquirer is a credit provider but only in relation to the credit." ;
    cof:pageNumber "70"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6k-ss-2 a cml:Concept ;
    skos:prefLabel "6K(2) Acquisition of the rights of a credit provider"@en ;
    cml:realizedBy doc:sch-2-sec-6k-ss-2 ;
    values:originalText "(2) If subsection (1) of this section applies in relation to credit that has been provided by the original credit provider, the credit is taken, for the purposes of this Act, to have been provided by the acquirer." ;
    skos:definition "(2) If subsection (1) of this section applies in relation to credit that has been provided by the original credit provider, the credit is taken, for the purposes of this Act, to have been provided by the acquirer."@en ;
    cml:integrityHash "bdab3e557e4ae53710b29ae4c8a4c1121655690922ea09f7d43a2ff4f1b67853" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6k ;
    cof:pageNumber "70"^^xsd:integer ;
    skos:note "Credit is taken to have been provided by the acquirer for the purposes of this Act." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-enhancing-privacy-protection-act-2012.pdf> ;
