    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21a ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "Division may apply to credit provider in relation to information referred to in subsection (1) Credit provider must implement practices, procedures and systems to comply with Division and registered CR code." ;
