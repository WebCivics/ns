doc:sch-2-sec-22d-ss-5 a cof:Section ;
    cof:title "22D(5) Use or disclosure of information by a related body corporate" ;
    values:kind "subsection" ;
    values:originalText "(5) If:  (a) the person is an APP entity; and  (b) the information is a government related identifier of the individual; Australian Privacy Principle 9.2 does not apply to the person in relation to the information. 22F  Use or disclosure of information by advisers etc. Prohibition on use or disclosure" ;
    cof:pageNumber "137"^^xsd:integer .

concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d-ss-1 a cml:Concept ;
    skos:prefLabel "22D(1) Use or disclosure of information by a related body corporate"@en ;
    cml:realizedBy doc:sch-2-sec-22d-ss-1 ;
    values:originalText "(1) If:  (a) any of the following (the recipient) holds or held credit eligibility information about an individual:  (i) an entity;  (ii) a professional legal adviser of the entity;  (iii) a professional financial adviser of the entity; and  (b) the information was disclosed to the recipient by a credit provider under subsection 21N(2); the recipient must not use or disclose the information, or any personal information about the individual derived from that information. Civil penalty: 1,000 penalty units. Permitted uses" ;
    skos:definition "(1) If:  (a) any of the following (the recipient) holds or held credit eligibility information about an individual:  (i) an entity;  (ii) a professional legal adviser of the entity;  (iii) a professional financial adviser of the entity; and  (b) the information was disclosed to the recipient by a credit provider under subsection 21N(2); the recipient must not use or disclose the information, or any personal information about the individual derived from that information. Civil penalty: 1,000 penalty units. Permitted uses"@en ;
    cml:integrityHash "8aa0d975bccdccce529daf15a7486ab82e40b414e745dc2e6000797dd35676c1" ;
    values:partOf concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d ;
    cof:pageNumber "137"^^xsd:integer ;
    skos:note "Prohibition on using or disclosing credit information without consent. Recipient must not use or disclose credit eligibility information. Body corporate must not use or disclose credit eligibility information about an individual." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-enhancing-privacy-protection-act-2012.pdf> ;
    dc:source "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.137" ;
    cml:asserts concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d-ss-1-norm .
