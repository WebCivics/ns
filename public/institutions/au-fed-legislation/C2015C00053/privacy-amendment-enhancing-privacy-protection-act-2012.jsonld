      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26e-ss-7",
      "@type": "cof:Section",
      "cof:title": "26E(7) Development of APP codes by APP code developers",
      "values:kind": "subsection",
      "cof:pageNumber": 155,
      "values:originalText": "(7) The Commissioner must make a copy of the request publicly\navailable as soon as practicable after the request is made."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26e-ss-7-norm",
