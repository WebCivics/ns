    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Subsection 6(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.54",
      "values:originalText": "Insert:\nconsumer credit liability information: if a credit provider provides\nconsumer credit to an individual, the following information about\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nthe consumer credit is consumer credit liability information about\nthe individual:\n\n(a) the name of the provider;\n\n(b) whether the provider is a licensee;\n\n(c) the type of consumer credit;\n\n(d) the day on which the consumer credit is entered into;\n\n(e) the terms or conditions of the consumer credit:\n\n(i) that relate to the repayment of the amount of credit; and\n\n(ii) that are prescribed by the regulations;\n\n(f) the maximum amount of credit available under the consumer\ncredit;\n\n(g) the day on which the consumer credit is terminated or\notherwise ceases to be in force.",
      "skos:definition": "Insert:\nconsumer credit liability information: if a credit provider provides\nconsumer credit to an individual, the following information about\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nthe consumer credit is consumer credit liability information about\nthe individual:\n\n(a) the name of the provider;\n\n(b) whether the provider is a licensee;\n\n(c) the type of consumer credit;\n\n(d) the day on which the consumer credit is entered into;\n\n(e) the terms or conditions of the consumer credit:\n\n(i) that relate to the repayment of the amount of credit; and\n\n(ii) that are prescribed by the regulations;\n\n(f) the maximum amount of credit available under the consumer\ncredit;\n\n(g) the day on which the consumer credit is terminated or\notherwise ceases to be in force.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-10-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-10-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-10-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "526b530e27a8564f99365395e493fa26ab7518efa83cb3c8678c54974151944f",
      "skos:note": "Consumer credit liability information must be provided by a credit provider.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "Insert:\nconsumer credit liability information: if a credit provider provides\nconsumer credit to an individual, the following information about\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nthe consumer credit is consumer credit liability information about\nthe individual:\n\n(a) the name of the provider;\n\n(b) whether the provider is a licensee;\n\n(c) the type of consumer credit;\n\n(d) the day on which the consumer credit is entered into;\n\n(e) the terms or conditions of the consumer credit:\n\n(i) that relate to the repayment of the amount of credit; and\n\n(ii) that are prescribed by the regulations;\n\n(f) the maximum amount of credit available under the consumer\ncredit;\n\n(g) the day on which the consumer credit is terminated or\notherwise ceases to be in force."
    },
