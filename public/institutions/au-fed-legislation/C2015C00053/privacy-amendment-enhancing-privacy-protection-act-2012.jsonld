      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-33e",
      "@type": "cml:Concept",
      "skos:prefLabel": "33E Commissioner may accept undertakings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-33e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.185",
      "values:originalText": "(1) The Commissioner may accept any of the following undertakings:\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) a written undertaking given by an entity that the entity will,\nin order to comply with this Act, take specified action;\n\n(b) a written undertaking given by an entity that the entity will,\nin order to comply with this Act, refrain from taking\nspecified action;\n\n(c) a written undertaking given by an entity that the entity will\ntake specified action directed towards ensuring that the entity\ndoes not do an act, or engage in a practice, in the future that\ninterferes with the privacy of an individual.\n\n(2) The undertaking must be expressed to be an undertaking under this\nsection.\n\n(3) The entity may withdraw or vary the undertaking at any time, but\nonly with the consent of the Commissioner.\n\n(4) The Commissioner may, by written notice given to the entity,\ncancel the undertaking.\n\n(5) The Commissioner may publish the undertaking on the\nCommissioner’s website.",
      "skos:definition": "(1) The Commissioner may accept any of the following undertakings:\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) a written undertaking given by an entity that the entity will,\nin order to comply with this Act, take specified action;\n\n(b) a written undertaking given by an entity that the entity will,\nin order to comply with this Act, refrain from taking\nspecified action;\n\n(c) a written undertaking given by an entity that the entity will\ntake specified action directed towards ensuring that the entity\ndoes not do an act, or engage in a practice, in the future that\ninterferes with the privacy of an individual.\n\n(2) The undertaking must be expressed to be an undertaking under this\nsection.\n\n(3) The entity may withdraw or vary the undertaking at any time, but\nonly with the consent of the Commissioner.\n\n(4) The Commissioner may, by written notice given to the entity,\ncancel the undertaking.\n\n(5) The Commissioner may publish the undertaking on the\nCommissioner’s website.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-33e-ss-1"
        },
