      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.50",
      "values:originalText": "10 If the APP entity refuses to give access to the personal information\nbecause of paragraph 12.3(j), the reasons for the refusal may\ninclude an explanation for the commercially sensitive decision.",
      "skos:definition": "10 If the APP entity refuses to give access to the personal information\nbecause of paragraph 12.3(j), the reasons for the refusal may\ninclude an explanation for the commercially sensitive decision.",
      "cml:asserts": [
