    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "23C(3) Notification requirements relating to correction complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23c-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.143",
      "values:originalText": "(3) If:\n\n(a) the respondent for the complaint is a credit provider; and\n\n(b) the complaint relates to:\n\n(i) credit reporting information that a credit reporting body\nholds; or\n\n(ii) credit information or credit eligibility information that\nanother credit provider holds;\nthe respondent must, in writing:\n\n(c) notify the body or other provider (as the case may be) of the\nmaking of the complaint as soon as practicable after it is\nmade; and\n\n(d) notify the body or other provider (as the case may be) of the\nmaking of a decision about the complaint under subsection\n23B(4) as soon as practicable after it is made.\nNotification of recipients of disclosed information",
      "skos:definition": "(3) If:\n\n(a) the respondent for the complaint is a credit provider; and\n\n(b) the complaint relates to:\n\n(i) credit reporting information that a credit reporting body\nholds; or\n\n(ii) credit information or credit eligibility information that\nanother credit provider holds;\nthe respondent must, in writing:\n\n(c) notify the body or other provider (as the case may be) of the\nmaking of the complaint as soon as practicable after it is\nmade; and\n\n(d) notify the body or other provider (as the case may be) of the\nmaking of a decision about the complaint under subsection\n23B(4) as soon as practicable after it is made.\nNotification of recipients of disclosed information",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6dcb2c1bb47bd7c947c2252dc28fabd967e063158f1e86ab6717f13e7b52ce0b",
      "skos:note": "Respondent must notify body or provider of complaint making and decision making.",
      "dc:description": "Notification"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23c-ss-3",
      "@type": "cof:Section",
      "cof:title": "23C(3) Notification requirements relating to correction complaints",
      "values:kind": "subsection",
      "cof:pageNumber": 143,
      "values:originalText": "(3) If:\n\n(a) the respondent for the complaint is a credit provider; and\n\n(b) the complaint relates to:\n\n(i) credit reporting information that a credit reporting body\nholds; or\n\n(ii) credit information or credit eligibility information that\nanother credit provider holds;\nthe respondent must, in writing:\n\n(c) notify the body or other provider (as the case may be) of the\nmaking of the complaint as soon as practicable after it is\nmade; and\n\n(d) notify the body or other provider (as the case may be) of the\nmaking of a decision about the complaint under subsection\n23B(4) as soon as practicable after it is made.\nNotification of recipients of disclosed information"
    },
