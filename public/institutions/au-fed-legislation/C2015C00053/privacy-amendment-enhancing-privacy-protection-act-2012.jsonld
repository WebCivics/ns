      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.110",
      "values:originalText": "3 and 1.4 do not apply to the provider in relation to credit\ninformation or credit eligibility information.\nSubdivision C—Dealing with credit information",
      "skos:definition": "3 and 1.4 do not apply to the provider in relation to credit\ninformation or credit eligibility information.\nSubdivision C—Dealing with credit information",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-1-2-norm"
        },
        {
