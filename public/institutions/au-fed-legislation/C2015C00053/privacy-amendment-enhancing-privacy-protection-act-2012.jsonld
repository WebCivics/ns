          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-4"
        },
