    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Subsection 6(1) (definition of mortgage insurer)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.60",
      "values:originalText": "Repeal the definition, substitute:\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nmortgage insurer means an organisation, or small business\noperator, that carries on a business or undertaking that involves\nproviding insurance to credit providers in relation to mortgage\ncredit provided by providers to other persons.",
      "skos:definition": "Repeal the definition, substitute:\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nmortgage insurer means an organisation, or small business\noperator, that carries on a business or undertaking that involves\nproviding insurance to credit providers in relation to mortgage\ncredit provided by providers to other persons.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-42-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-42-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-42-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "6d3f61c707c87e4009bfd432676d21584988230916cca8a249764396c09b8a63",
      "skos:note": "Definition of mortgage insurer"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-42",
      "@type": "cof:Section",
      "cof:title": "42 Subsection 6(1) (definition of mortgage insurer)",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "Repeal the definition, substitute:\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nmortgage insurer means an organisation, or small business\noperator, that carries on a business or undertaking that involves\nproviding insurance to credit providers in relation to mortgage\ncredit provided by providers to other persons."
    },
