    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "23C(4) Notification requirements relating to correction complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23c-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.143",
      "values:originalText": "(4) If:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) a credit reporting body discloses credit reporting information\nto which the complaint relates under Division 2 of this Part;\nand\n\n(b) at the time of the disclosure, a decision about the complaint\nunder subsection 23B(4) has not been made;\nthe body must, at that time, notify in writing the recipient of the\ninformation of the complaint.",
      "skos:definition": "(4) If:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) a credit reporting body discloses credit reporting information\nto which the complaint relates under Division 2 of this Part;\nand\n\n(b) at the time of the disclosure, a decision about the complaint\nunder subsection 23B(4) has not been made;\nthe body must, at that time, notify in writing the recipient of the\ninformation of the complaint.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f48d6ad4860a5853e7a20d3fac8dbaf8de184e78234f01ca1c4e557250f81992",
      "skos:note": "Credit reporting body must notify recipient of complaint upon disclosure.",
      "dc:description": "Notification in writing"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23c-ss-4",
      "@type": "cof:Section",
      "cof:title": "23C(4) Notification requirements relating to correction complaints",
      "values:kind": "subsection",
      "cof:pageNumber": 143,
      "values:originalText": "(4) If:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) a credit reporting body discloses credit reporting information\nto which the complaint relates under Division 2 of this Part;\nand\n\n(b) at the time of the disclosure, a decision about the complaint\nunder subsection 23B(4) has not been made;\nthe body must, at that time, notify in writing the recipient of the\ninformation of the complaint."
    },
