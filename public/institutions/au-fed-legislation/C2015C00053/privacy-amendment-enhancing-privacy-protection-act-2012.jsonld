    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Section 12",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.50",
      "values:originalText": "9 If the APP entity refuses to give access to the personal information\nbecause of subclause 12.2 or 12.3, or to give access in the manner\nrequested by the individual, the entity must give the individual a\nwritten notice that sets out:\n\n(a) the reasons for the refusal except to the extent that, having\nregard to the grounds for the refusal, it would be\nunreasonable to do so; and\n\n(b) the mechanisms available to complain about the refusal; and\n\n(c) any other matter prescribed by the regulations.",
      "skos:definition": "9 If the APP entity refuses to give access to the personal information\nbecause of subclause 12.2 or 12.3, or to give access in the manner\nrequested by the individual, the entity must give the individual a\nwritten notice that sets out:\n\n(a) the reasons for the refusal except to the extent that, having\nregard to the grounds for the refusal, it would be\nunreasonable to do so; and\n\n(b) the mechanisms available to complain about the refusal; and\n\n(c) any other matter prescribed by the regulations.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-11-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "69e56e6de1fb1cda06bd2fe142bce71f5f5e2f593310033b7764b0b7e8af370c",
      "skos:note": "Entity must provide written notice to individual if access to personal information is refused",
      "dc:description": "written notice with reasons for refusal, mechanisms for complaint, and other prescribed matters"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-11",
      "@type": "cof:Section",
      "cof:title": "12 Section 12",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "9 If the APP entity refuses to give access to the personal information\nbecause of subclause 12.2 or 12.3, or to give access in the manner\nrequested by the individual, the entity must give the individual a\nwritten notice that sets out:\n\n(a) the reasons for the refusal except to the extent that, having\nregard to the grounds for the refusal, it would be\nunreasonable to do so; and\n\n(b) the mechanisms available to complain about the refusal; and\n\n(c) any other matter prescribed by the regulations."
    },
