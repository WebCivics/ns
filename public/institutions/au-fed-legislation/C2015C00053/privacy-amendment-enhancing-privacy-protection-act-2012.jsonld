      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.158",
      "values:originalText": "(8) An approval is not a legislative instrument.\nNote:\nThe APP code, as varied, is a legislative instrument once it is included\non the Codes Register: see section 26B.",
      "skos:definition": "(8) An approval is not a legislative instrument.\nNote:\nThe APP code, as varied, is a legislative instrument once it is included\non the Codes Register: see section 26B.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26j"
      },
