      "cml:integrityHash": "c107c893ddf92f31c73b1cec6da93428ceb6e128bd1d356ef8535759e2fc2ea9",
      "skos:note": "Repayment history information must include whether the individual has met an obligation to make a monthly payment.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6v-ss-1",
      "@type": "cof:Section",
