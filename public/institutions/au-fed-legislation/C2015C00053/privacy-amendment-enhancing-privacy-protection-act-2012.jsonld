    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20z-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "20Z(4) Dealing with information if there is a pending correction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20z-ss-4"
