        }
      ],
      "cml:integrityHash": "5da15387a7d413f65b935e065a76908887c641ba0bed478052efa404cfac0d9f",
      "skos:note": "Credit provider must ensure disclosure does not breach Australian Privacy Principles."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21na-ss-3",
      "@type": "cof:Section",
      "cof:title": "21NA(3) Disclosures to certain persons and bodies that do not have an",
      "values:kind": "subsection",
      "cof:pageNumber": 123,
      "values:originalText": "(3) Before a credit provider discloses credit eligibility information\nunder subsection 21M(1) to a person or body that does not have an\nAustralian link, the provider must take such steps as are reasonable\nin the circumstances to ensure that the person or body does not\nbreach the Australian Privacy Principles (other than Australian\nPrivacy Principle 1) in relation to the information."
    },
