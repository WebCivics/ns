      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Code is registered.",
      "cml:conclusionText": "Breach of CR code occurs during the act or practice's execution."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-6ba-logic-argumentation-3",
