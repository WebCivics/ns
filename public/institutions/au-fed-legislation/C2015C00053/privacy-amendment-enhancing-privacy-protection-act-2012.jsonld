    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "22A(7) Open and transparent management of regulated information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-22a-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.133",
      "values:originalText": "(7) If an affected information recipient is an APP entity, Australian\nPrivacy Principles 1.3 and 1.4 do not apply to the recipient in\nrelation to the regulated information of the recipient.\nSubdivision B—Dealing with regulated information",
      "skos:definition": "(7) If an affected information recipient is an APP entity, Australian\nPrivacy Principles 1.3 and 1.4 do not apply to the recipient in\nrelation to the regulated information of the recipient.\nSubdivision B—Dealing with regulated information",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a-ss-7-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7eb5eed273be73160ae0369f3f2d0eb390bb1bdbbaa30cd1cf8aa59bb107fb70",
      "skos:note": "Exemption from Australian Privacy Principles for APP entities"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-22a-ss-7",
      "@type": "cof:Section",
      "cof:title": "22A(7) Open and transparent management of regulated information",
      "values:kind": "subsection",
      "cof:pageNumber": 133,
      "values:originalText": "(7) If an affected information recipient is an APP entity, Australian\nPrivacy Principles 1.3 and 1.4 do not apply to the recipient in\nrelation to the regulated information of the recipient.\nSubdivision B—Dealing with regulated information"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a-ss-7-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a-ss-7"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22a-ss-7-logic-deontic-1",
