      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.84",
      "values:originalText": "(6) This section does not apply to the use or disclosure of credit\nreporting information for the purposes of direct marketing.\nNote:\nSection 20G deals with the use or disclosure of credit reporting\ninformation for the purposes of direct marketing.",
      "skos:definition": "(6) This section does not apply to the use or disclosure of credit\nreporting information for the purposes of direct marketing.\nNote:\nSection 20G deals with the use or disclosure of credit reporting\ninformation for the purposes of direct marketing.",
      "values:partOf": {
