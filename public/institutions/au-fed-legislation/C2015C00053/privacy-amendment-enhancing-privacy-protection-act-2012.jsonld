      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.10",
      "values:originalText": "Insert:\ncourt/tribunal order means an order, direction or other instrument\nmade by:\n\n(a) a court; or\n\n(b) a tribunal; or\n\n(c) a judge (including a judge acting in a personal capacity) or a\nperson acting as a judge; or\n\n(d) a magistrate (including a magistrate acting in a personal\ncapacity) or a person acting as a magistrate; or\n\n(e) a member or an officer of a tribunal;\nand includes an order, direction or other instrument that is of an\ninterim or interlocutory nature.\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "Insert:\ncourt/tribunal order means an order, direction or other instrument\nmade by:\n\n(a) a court; or\n\n(b) a tribunal; or\n\n(c) a judge (including a judge acting in a personal capacity) or a\nperson acting as a judge; or\n\n(d) a magistrate (including a magistrate acting in a personal\ncapacity) or a person acting as a magistrate; or\n\n(e) a member or an officer of a tribunal;\nand includes an order, direction or other instrument that is of an\ninterim or interlocutory nature.\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "3297ffbee01ee2935058869370b0e9772826f1deea86b75e05bf819072aa664c",
      "skos:note": "Definition of court/tribunal order"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Insert:\ncourt/tribunal order means an order, direction or other instrument\nmade by:\n\n(a) a court; or\n\n(b) a tribunal; or\n\n(c) a judge (including a judge acting in a personal capacity) or a\nperson acting as a judge; or\n\n(d) a magistrate (including a magistrate acting in a personal\ncapacity) or a person acting as a magistrate; or\n\n(e) a member or an officer of a tribunal;\nand includes an order, direction or other instrument that is of an\ninterim or interlocutory nature.\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15"
    },
