        }
      ],
      "cml:integrityHash": "e6b8adaa44fbea6e2eb2617f9189c006579b9a7804ea5f46d4175990d396cd0d",
      "skos:note": "Exempts provider from credit information obligations."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-1-2",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
