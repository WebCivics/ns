      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.216",
      "values:originalText": "Repeal the definition, substitute:\npersonal information has the same meaning as in the Privacy Act\n1988.\nComLaw Authoritative Act C2015C00053\n\nAmendment of other Acts  Schedule 5\nAmendments relating to the Australian Privacy Principles  Part 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nA New Tax System (Family Assistance) (Administration) Act",
      "skos:definition": "Repeal the definition, substitute:\npersonal information has the same meaning as in the Privacy Act\n1988.\nComLaw Authoritative Act C2015C00053\n\nAmendment of other Acts  Schedule 5\nAmendments relating to the Australian Privacy Principles  Part 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nA New Tax System (Family Assistance) (Administration) Act",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dce8857c97f663ae3a3ad5d98cbfb4bd3c754dfec5388042d9cc8472277f096a",
      "skos:note": "Repeal and substitute definition of personal information with the Privacy Act 1988."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Clause 1 of Schedule 1 (definition of personal information)",
      "values:kind": "section",
      "cof:pageNumber": 216,
      "values:originalText": "Repeal the definition, substitute:\npersonal information has the same meaning as in the Privacy Act\n1988.\nComLaw Authoritative Act C2015C00053\n\nAmendment of other Acts  Schedule 5\nAmendments relating to the Australian Privacy Principles  Part 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nA New Tax System (Family Assistance) (Administration) Act"
    },
