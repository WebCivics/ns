        }
      ],
      "cml:integrityHash": "3df8503e6a3a78a638cf6271bbd5c6dda2d20df2170a2d61685f1a3a1f209725",
      "skos:note": "No notice must be given if required by law or court order."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20u-ss-5",
      "@type": "cof:Section",
      "cof:title": "20U(5) Notice of correction etc. must be given",
      "values:kind": "subsection",
