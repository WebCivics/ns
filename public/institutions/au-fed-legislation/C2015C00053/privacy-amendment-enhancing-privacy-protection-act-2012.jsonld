    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zb",
      "@type": "cml:Concept",
      "skos:prefLabel": "80ZB Civil evidence and procedure rules for civil penalty orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80zb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.209",
      "values:originalText": "The Federal Court or Federal Magistrates Court must apply the\nrules of evidence and procedure for civil matters when hearing\nproceedings for a civil penalty order.\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "The Federal Court or Federal Magistrates Court must apply the\nrules of evidence and procedure for civil matters when hearing\nproceedings for a civil penalty order.\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zb-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "93e9b9a41b43efa116557e6eeda29bdc5d93357228c60fe7cdcc99c463b25232",
      "skos:note": "Federal Court or Federal Magistrates Court must apply rules of evidence and procedure for civil matters when hearing proceedings for a civil penalty order."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80zb",
      "@type": "cof:Section",
      "cof:title": "80ZB Civil evidence and procedure rules for civil penalty orders",
      "values:kind": "section",
      "cof:pageNumber": 209,
      "values:originalText": "The Federal Court or Federal Magistrates Court must apply the\nrules of evidence and procedure for civil matters when hearing\nproceedings for a civil penalty order.\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15"
    },
