    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "20R(5) Access to credit reporting information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20r-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.94",
      "values:originalText": "(5) If a request under subsection (1) in relation to the individual has\nnot been made to the credit reporting body in the previous 12\nmonths, the body must not charge the access seeker for the making\nof the request or for giving access to the information.",
      "skos:definition": "(5) If a request under subsection (1) in relation to the individual has\nnot been made to the credit reporting body in the previous 12\nmonths, the body must not charge the access seeker for the making\nof the request or for giving access to the information.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5691b3689577bb631fa2fc3822e32f5745333d80a450a287db92e5432bf2fb2a",
      "skos:note": "No charge for making request or giving access to information if not made in previous 12 months."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20r-ss-5",
      "@type": "cof:Section",
      "cof:title": "20R(5) Access to credit reporting information",
      "values:kind": "subsection",
      "cof:pageNumber": 94,
      "values:originalText": "(5) If a request under subsection (1) in relation to the individual has\nnot been made to the credit reporting body in the previous 12\nmonths, the body must not charge the access seeker for the making\nof the request or for giving access to the information."
    },
    {
