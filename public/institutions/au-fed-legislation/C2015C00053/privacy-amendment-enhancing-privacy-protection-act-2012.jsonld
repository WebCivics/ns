      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.32",
      "values:originalText": "(the APP privacy policy) about the management of personal\ninformation by the entity.\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "(the APP privacy policy) about the management of personal\ninformation by the entity.\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "cml:asserts": [
