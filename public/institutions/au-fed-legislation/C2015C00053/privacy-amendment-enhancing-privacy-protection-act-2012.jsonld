    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-24a-ss-3",
      "@type": "cof:Section",
      "cof:title": "24A(3) Obtaining credit eligibility information from a credit provider",
      "values:kind": "subsection",
      "cof:pageNumber": 145,
      "values:originalText": "(3) An entity must not obtain credit eligibility information from a\ncredit provider if the entity is not:\n\n(a) an entity to which the provider is permitted to disclose the\ninformation under Division 3 of this Part; or\n\n(b) an access seeker for the information.\nCivil penalty:\n2,000 penalty units."
    },
