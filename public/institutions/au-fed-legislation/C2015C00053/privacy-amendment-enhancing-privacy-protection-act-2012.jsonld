      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to remove original code and register varied APP code",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26j-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "26J(7) Variation of registered APP codes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26j-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.158",
      "values:originalText": "(7) If the Commissioner approves a variation, the variation comes into\neffect on the day specified in the approval, which must not be\nbefore the day on which the APP code, as varied, is included on the\nCodes Register.",
      "skos:definition": "(7) If the Commissioner approves a variation, the variation comes into\neffect on the day specified in the approval, which must not be\nbefore the day on which the APP code, as varied, is included on the\nCodes Register.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26j"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26j-ss-7-norm"
        }
      ],
      "cml:integrityHash": "512a30f1d6ff9e4c07da649c1f4c25d47cd45e7831c18a8831be0662cc01efcb",
      "skos:note": "Variation of registered APP codes comes into effect on a specified day after approval."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26j-ss-7",
      "@type": "cof:Section",
      "cof:title": "26J(7) Variation of registered APP codes",
      "values:kind": "subsection",
      "cof:pageNumber": 158,
      "values:originalText": "(7) If the Commissioner approves a variation, the variation comes into\neffect on the day specified in the approval, which must not be\nbefore the day on which the APP code, as varied, is included on the\nCodes Register."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26j-ss-7-norm",
