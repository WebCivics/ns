      ],
      "cml:integrityHash": "bf686a686b08e3ff392f97b7f63d780a52398849b5028af806303cb8a2078f18",
      "skos:note": "Credit reporting body must provide written notice of correction to individual and recipient.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20u-ss-2",
      "@type": "cof:Section",
      "cof:title": "20U(2) Notice of correction etc. must be given",
      "values:kind": "subsection",
      "cof:pageNumber": 98,
      "values:originalText": "(2) If the credit reporting body corrects the personal information under\nsubsection 20T(2), the body must, within a reasonable period:\n\n(a) give the individual written notice of the correction; and\n\n(b) if the body consulted an interested party under subsection\n20T(3) about the individual’s request—give the party written\nnotice of the correction; and\n\n(c) if the correction relates to information that the body has\npreviously disclosed under this Division (other than\nsubsections 20D(2) and 20T(4))—give each recipient of the\ninformation written notice of the correction."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20u-ss-2-norm",
      "@type": "values:Obligation",
