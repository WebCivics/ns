    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20e-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "20E(5) Use or disclosure of credit reporting information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20e-ss-5"
      },
