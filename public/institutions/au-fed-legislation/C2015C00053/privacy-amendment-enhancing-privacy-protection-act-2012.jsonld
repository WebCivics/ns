      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The Commissioner has power...",
      "cml:conclusionText": "The Commissioner's power to perform functions implies that it is able to perform its duties."
    },
    {
