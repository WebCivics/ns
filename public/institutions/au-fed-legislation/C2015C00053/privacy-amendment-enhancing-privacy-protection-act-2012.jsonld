    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23b-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "23B(5) Dealing with complaints",
      "cml:realizedBy": {
