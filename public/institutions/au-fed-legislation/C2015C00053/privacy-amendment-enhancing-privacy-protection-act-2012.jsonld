      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21g-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "21G(4) Use or disclosure of credit eligibility information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21g-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.114",
      "values:originalText": "(4) However, if the credit eligibility information about the individual\nis, or was derived from, repayment history information about the\nindividual, the credit provider must not disclose the information\nunder subsection (3).\nCivil penalty:\n2,000 penalty units.",
      "skos:definition": "(4) However, if the credit eligibility information about the individual\nis, or was derived from, repayment history information about the\nindividual, the credit provider must not disclose the information\nunder subsection (3).\nCivil penalty:\n2,000 penalty units.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21g"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21g-ss-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21g-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "984e1e059230796ff26533f85dc09182112060f2582da7500926290f9c734e54",
      "skos:note": "Credit provider must not disclose repayment history information under subsection (3)."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21g-ss-4",
      "@type": "cof:Section",
      "cof:title": "21G(4) Use or disclosure of credit eligibility information",
      "values:kind": "subsection",
      "cof:pageNumber": 114,
      "values:originalText": "(4) However, if the credit eligibility information about the individual\nis, or was derived from, repayment history information about the\nindividual, the credit provider must not disclose the information\nunder subsection (3).\nCivil penalty:\n2,000 penalty units."
    },
