    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Subparagraph 30(1)(b)(ii)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-55"
      },
      "cml:curationStatus": {
