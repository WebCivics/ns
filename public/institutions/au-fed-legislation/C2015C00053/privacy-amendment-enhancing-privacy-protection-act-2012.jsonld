        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6j-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c1a29217b0158c264c63c7b67e33c26be1ff7372d4304b6efddb16f4e2dcfab",
      "skos:note": "Application to credit provider is taken as application to securitisation entity."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6j-ss-4",
      "@type": "cof:Section",
      "cof:title": "6J(4) Securitisation arrangements etc.",
      "values:kind": "subsection",
      "cof:pageNumber": 69,
      "values:originalText": "(4) If subsection (1) applies in relation to credit for which an\napplication has been made to the original credit provider, the\napplication is taken, for the purposes of this Act, to have been\nmade to both the original credit provider and the securitisation\nentity.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6j-ss-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
