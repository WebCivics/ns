      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.128",
      "values:originalText": "(8) If a credit provider is an APP entity, Australian Privacy Principle\n12 does not apply to the provider in relation to credit eligibility\ninformation.",
      "skos:definition": "(8) If a credit provider is an APP entity, Australian Privacy Principle\n12 does not apply to the provider in relation to credit eligibility\ninformation.",
