    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80u",
      "@type": "cml:Concept",
      "skos:prefLabel": "80U Civil penalty provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80u"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.207",
      "values:originalText": "A subsection of this Act (or a section of this Act that is not divided\ninto subsections) is a civil penalty provision if the words “civil\npenalty” and one or more amounts in penalty units are set out at the\nfoot of the subsection (or section).",
      "skos:definition": "A subsection of this Act (or a section of this Act that is not divided\ninto subsections) is a civil penalty provision if the words “civil\npenalty” and one or more amounts in penalty units are set out at the\nfoot of the subsection (or section).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80u-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80u-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "440b0c533d29838f277721fc589819d7169a2f642ccccb75fd7e30736bb8e941",
      "skos:note": "Defines civil penalty provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80u",
      "@type": "cof:Section",
      "cof:title": "80U Civil penalty provisions",
      "values:kind": "section",
      "cof:pageNumber": 207,
      "values:originalText": "A subsection of this Act (or a section of this Act that is not divided\ninto subsections) is a civil penalty provision if the words “civil\npenalty” and one or more amounts in penalty units are set out at the\nfoot of the subsection (or section)."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80u-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80u"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80u-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Identifies obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "civil penalty provision"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80v",
      "@type": "cml:Concept",
      "skos:prefLabel": "80V Ancillary contravention of civil penalty provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80v"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.207",
      "values:originalText": "(1) An entity must not:\n\n(a) attempt to contravene a civil penalty provision; or\n\n(b) aid, abet, counsel or procure a contravention of a civil\npenalty provision; or\n\n(c) induce (by threats, promises or otherwise) a contravention of\na civil penalty provision; or\n\n(d) be in any way, directly or indirectly, knowingly concerned in,\nor party to, a contravention of a civil penalty provision; or\n\n(e) conspire with others to effect a contravention of a civil\npenalty provision.\n\n(2) An entity that contravenes subsection (1) in relation to a civil\npenalty provision is taken to have contravened the provision.",
      "skos:definition": "(1) An entity must not:\n\n(a) attempt to contravene a civil penalty provision; or\n\n(b) aid, abet, counsel or procure a contravention of a civil\npenalty provision; or\n\n(c) induce (by threats, promises or otherwise) a contravention of\na civil penalty provision; or\n\n(d) be in any way, directly or indirectly, knowingly concerned in,\nor party to, a contravention of a civil penalty provision; or\n\n(e) conspire with others to effect a contravention of a civil\npenalty provision.\n\n(2) An entity that contravenes subsection (1) in relation to a civil\npenalty provision is taken to have contravened the provision.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80v-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80v-ss-2"
        }
      ],
      "cml:integrityHash": "a33976899515218a646f94f2c4347f37386e3a953b4381094ba255b1964c1b06"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80v",
      "@type": "cof:Section",
      "cof:title": "80V Ancillary contravention of civil penalty provisions",
      "values:kind": "section",
      "cof:pageNumber": 207,
      "values:originalText": "(1) An entity must not:\n\n(a) attempt to contravene a civil penalty provision; or\n\n(b) aid, abet, counsel or procure a contravention of a civil\npenalty provision; or\n\n(c) induce (by threats, promises or otherwise) a contravention of\na civil penalty provision; or\n\n(d) be in any way, directly or indirectly, knowingly concerned in,\nor party to, a contravention of a civil penalty provision; or\n\n(e) conspire with others to effect a contravention of a civil\npenalty provision.\n\n(2) An entity that contravenes subsection (1) in relation to a civil\npenalty provision is taken to have contravened the provision."
    },
    {
