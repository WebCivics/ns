    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 8 If:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.49",
      "values:originalText": "(a) the APP entity is an organisation; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 1  Australian Privacy Principles\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the entity charges the individual for giving access to the\npersonal information;\nthe charge must not be excessive and must not apply to the making\nof the request.\nRefusal to give access",
      "skos:definition": "(a) the APP entity is an organisation; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 1  Australian Privacy Principles\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the entity charges the individual for giving access to the\npersonal information;\nthe charge must not be excessive and must not apply to the making\nof the request.\nRefusal to give access",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-10-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1fab1934f32788dadc22896b6f02d1de2ae0691a587aae03884c733bae0de7ff",
      "skos:note": "Entity must not charge excessive fee for access to personal information."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-10",
      "@type": "cof:Section",
      "cof:title": "12 8 If:",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "(a) the APP entity is an organisation; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 1  Australian Privacy Principles\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the entity charges the individual for giving access to the\npersonal information;\nthe charge must not be excessive and must not apply to the making\nof the request.\nRefusal to give access"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-10-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-10"
