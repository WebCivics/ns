      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.195",
      "values:originalText": "Repeal the note, substitute:\nNote 2:\nThe Commissioner may determine under section 53B that the\ndetermination applies in relation to an agency if the organisation has\nnot complied with the determination.",
      "skos:definition": "Repeal the note, substitute:\nNote 2:\nThe Commissioner may determine under section 53B that the\ndetermination applies in relation to an agency if the organisation has\nnot complied with the determination.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-105-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-105-logic-deontic-1"
