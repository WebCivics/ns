    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21g-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "21G(5) Use or disclosure of credit eligibility information",
      "cml:realizedBy": {
