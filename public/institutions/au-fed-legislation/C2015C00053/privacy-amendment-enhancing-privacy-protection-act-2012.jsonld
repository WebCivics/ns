    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-179",
      "@type": "cml:Concept",
      "skos:prefLabel": "179 Subsections 80B(1) and (2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-179"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.205",
      "values:originalText": "Repeal the subsections, substitute:\nAPP entity covered by a determination\n\n(1) If an act or practice of an APP entity is the subject of a temporary\npublic interest determination, the entity is taken not to breach\nsection 15 or 26A if the entity does the act, or engages in the\npractice, while the determination is in force.",
      "skos:definition": "Repeal the subsections, substitute:\nAPP entity covered by a determination\n\n(1) If an act or practice of an APP entity is the subject of a temporary\npublic interest determination, the entity is taken not to breach\nsection 15 or 26A if the entity does the act, or engages in the\npractice, while the determination is in force.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-179-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-179-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e7e6f07a57bfeb8fccdc2c3de8c0270bac09a8d53cbce89a57f288bae9a79351",
      "skos:note": "Entity not breaching section 15 or 26A if act/practice subject to temporary public interest determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-179",
      "@type": "cof:Section",
      "cof:title": "179 Subsections 80B(1) and (2)",
      "values:kind": "section",
      "cof:pageNumber": 205,
      "values:originalText": "Repeal the subsections, substitute:\nAPP entity covered by a determination\n\n(1) If an act or practice of an APP entity is the subject of a temporary\npublic interest determination, the entity is taken not to breach\nsection 15 or 26A if the entity does the act, or engages in the\npractice, while the determination is in force."
    },
