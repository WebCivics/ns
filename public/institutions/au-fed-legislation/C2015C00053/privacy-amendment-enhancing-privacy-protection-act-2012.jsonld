    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-94",
      "@type": "cml:Concept",
      "skos:prefLabel": "94 Subsections 43(4), (5) and (6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-94"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.193",
      "values:originalText": "Repeal the subsections, substitute:\n\n(4) The Commissioner may make a determination under section 52 in\nrelation to an investigation under this Division without holding a\nhearing, if:\n\n(a) it appears to the Commissioner that the matter to which the\ninvestigation relates can be adequately determined in the\nabsence of:\n\n(i) in the case of an investigation under subsection 40(1)—\nthe complainant and respondent; or\n\n(ii) otherwise—the person or entity that engaged in the act\nor practice that is being investigated; and\n\n(b) the Commissioner is satisfied that there are no unusual\ncircumstances that would warrant the Commissioner holding\na hearing; and\n\n(c) an application for a hearing has not been made under\nsection 43A.",
      "skos:definition": "Repeal the subsections, substitute:\n\n(4) The Commissioner may make a determination under section 52 in\nrelation to an investigation under this Division without holding a\nhearing, if:\n\n(a) it appears to the Commissioner that the matter to which the\ninvestigation relates can be adequately determined in the\nabsence of:\n\n(i) in the case of an investigation under subsection 40(1)—\nthe complainant and respondent; or\n\n(ii) otherwise—the person or entity that engaged in the act\nor practice that is being investigated; and\n\n(b) the Commissioner is satisfied that there are no unusual\ncircumstances that would warrant the Commissioner holding\na hearing; and\n\n(c) an application for a hearing has not been made under\nsection 43A.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-94-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-94-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4fc28cadce747a655ee427d837bdfc66dbd0c639b9758e7de6f0df8d769ed0d7",
      "skos:note": "Commissioner may make a determination without holding a hearing under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-94",
      "@type": "cof:Section",
      "cof:title": "94 Subsections 43(4), (5) and (6)",
      "values:kind": "section",
      "cof:pageNumber": 193,
      "values:originalText": "Repeal the subsections, substitute:\n\n(4) The Commissioner may make a determination under section 52 in\nrelation to an investigation under this Division without holding a\nhearing, if:\n\n(a) it appears to the Commissioner that the matter to which the\ninvestigation relates can be adequately determined in the\nabsence of:\n\n(i) in the case of an investigation under subsection 40(1)—\nthe complainant and respondent; or\n\n(ii) otherwise—the person or entity that engaged in the act\nor practice that is being investigated; and\n\n(b) the Commissioner is satisfied that there are no unusual\ncircumstances that would warrant the Commissioner holding\na hearing; and\n\n(c) an application for a hearing has not been made under\nsection 43A."
    },
