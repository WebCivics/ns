      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.33",
      "values:originalText": "5 An APP entity must take such steps as are reasonable in the\ncircumstances to make its APP privacy policy available:\n\n(a) free of charge; and\n\n(b) in such form as is appropriate.\nNote:\nAn APP entity will usually make its APP privacy policy available on\nthe entity’s website.",
      "skos:definition": "5 An APP entity must take such steps as are reasonable in the\ncircumstances to make its APP privacy policy available:\n\n(a) free of charge; and\n\n(b) in such form as is appropriate.\nNote:\nAn APP entity will usually make its APP privacy policy available on\nthe entity’s website.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-7-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "77fcf352f416e4f5d3418b6e764fc9ac141a45223707152dfef3cb0b872a2657",
      "skos:note": "An APP entity must make its APP privacy policy available.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-1-7",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "5 An APP entity must take such steps as are reasonable in the\ncircumstances to make its APP privacy policy available:\n\n(a) free of charge; and\n\n(b) in such form as is appropriate.\nNote:\nAn APP entity will usually make its APP privacy policy available on\nthe entity’s website."
    },
