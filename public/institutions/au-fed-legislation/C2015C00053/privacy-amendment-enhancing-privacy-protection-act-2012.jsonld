    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-173",
      "@type": "cml:Concept",
      "skos:prefLabel": "173 Subparagraphs 80A(1)(a)(i) and (ii)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-173"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.204",
      "values:originalText": "Repeal the subparagraphs, substitute:\n\n(i) an Australian Privacy Principle; or\n\n(ii) a registered APP code that binds the entity; and\nComLaw Authoritative Act C2015C00053\n\nOther amendments of the Privacy Act 1988  Schedule 4\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "Repeal the subparagraphs, substitute:\n\n(i) an Australian Privacy Principle; or\n\n(ii) a registered APP code that binds the entity; and\nComLaw Authoritative Act C2015C00053\n\nOther amendments of the Privacy Act 1988  Schedule 4\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-173-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-173-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6362041ceac0b064eae0ab1959299d8acd0d9c62f9a561476ce632869e58fa9c",
      "skos:note": "Repeal subparagraphs and substitute with an Australian Privacy Principle or a registered APP code."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-173",
      "@type": "cof:Section",
      "cof:title": "173 Subparagraphs 80A(1)(a)(i) and (ii)",
      "values:kind": "section",
      "cof:pageNumber": 204,
      "values:originalText": "Repeal the subparagraphs, substitute:\n\n(i) an Australian Privacy Principle; or\n\n(ii) a registered APP code that binds the entity; and\nComLaw Authoritative Act C2015C00053\n\nOther amendments of the Privacy Act 1988  Schedule 4\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15"
    },
