      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.182",
      "values:originalText": "Repeal the subparagraph, substitute:\n\n(ii) does not consider that it is reasonably possible that the\nmatter that gave rise to the investigation can be\nconciliated successfully or has attempted to conciliate\nthe matter without success.",
      "skos:definition": "Repeal the subparagraph, substitute:\n\n(ii) does not consider that it is reasonably possible that the\nmatter that gave rise to the investigation can be\nconciliated successfully or has attempted to conciliate\nthe matter without success.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-55-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-55-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2b235505d6e7e0dcb71511164c820edb9e07166329214d824a9c6aa61af2a0e4",
      "skos:note": "Repeal and substitute a provision regarding conciliation."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-55",
      "@type": "cof:Section",
      "cof:title": "55 Subparagraph 30(1)(b)(ii)",
      "values:kind": "section",
      "cof:pageNumber": 182,
      "values:originalText": "Repeal the subparagraph, substitute:\n\n(ii) does not consider that it is reasonably possible that the\nmatter that gave rise to the investigation can be\nconciliated successfully or has attempted to conciliate\nthe matter without success."
    },
