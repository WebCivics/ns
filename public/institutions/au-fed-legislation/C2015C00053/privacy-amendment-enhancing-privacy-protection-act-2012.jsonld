      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.184",
      "values:originalText": "(7) Before the fifth anniversary of the commencement of this section,\nthe Minister must cause a review to be undertaken of whether this\nsection should apply in relation to organisations.",
      "skos:definition": "(7) Before the fifth anniversary of the commencement of this section,\nthe Minister must cause a review to be undertaken of whether this\nsection should apply in relation to organisations.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-33d"
      },
