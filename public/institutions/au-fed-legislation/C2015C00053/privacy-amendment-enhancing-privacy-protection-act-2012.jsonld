    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "80W(5) Civil penalty orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80w-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.207",
      "values:originalText": "(5) The pecuniary penalty must not be more than:\n\n(a) if the entity is a body corporate—5 times the amount of the\npecuniary penalty specified for the civil penalty provision; or\n\n(b) otherwise—the amount of the pecuniary penalty specified for\nthe civil penalty provision.",
      "skos:definition": "(5) The pecuniary penalty must not be more than:\n\n(a) if the entity is a body corporate—5 times the amount of the\npecuniary penalty specified for the civil penalty provision; or\n\n(b) otherwise—the amount of the pecuniary penalty specified for\nthe civil penalty provision.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c2034b1fea90cb17b96661fac62a6e87597720833069b8c437faa2530c74f1ac",
      "skos:note": "Maximum pecuniary penalty amount"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80w-ss-5",
      "@type": "cof:Section",
      "cof:title": "80W(5) Civil penalty orders",
      "values:kind": "subsection",
      "cof:pageNumber": 207,
      "values:originalText": "(5) The pecuniary penalty must not be more than:\n\n(a) if the entity is a body corporate—5 times the amount of the\npecuniary penalty specified for the civil penalty provision; or\n\n(b) otherwise—the amount of the pecuniary penalty specified for\nthe civil penalty provision."
    },
