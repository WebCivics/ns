      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-10-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
