    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zd",
      "@type": "cml:Concept",
      "skos:prefLabel": "80ZD Civil proceedings after criminal proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80zd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.210",
      "values:originalText": "The Federal Court or Federal Magistrates Court must not make a\ncivil penalty order against an entity for a contravention of a civil\npenalty provision if the entity has been convicted of an offence\nconstituted by conduct that is the same, or substantially the same,\nas the conduct constituting the contravention.",
      "skos:definition": "The Federal Court or Federal Magistrates Court must not make a\ncivil penalty order against an entity for a contravention of a civil\npenalty provision if the entity has been convicted of an offence\nconstituted by conduct that is the same, or substantially the same,\nas the conduct constituting the contravention.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zd-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zd-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ec86f772ccd048136f99a4bab9da43090688e2b16734f368bb1e226fd83c1f49",
      "skos:note": "Federal Court cannot make a civil penalty order against an entity convicted of the same or substantially similar conduct."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80zd",
      "@type": "cof:Section",
      "cof:title": "80ZD Civil proceedings after criminal proceedings",
      "values:kind": "section",
      "cof:pageNumber": 210,
      "values:originalText": "The Federal Court or Federal Magistrates Court must not make a\ncivil penalty order against an entity for a contravention of a civil\npenalty provision if the entity has been convicted of an offence\nconstituted by conduct that is the same, or substantially the same,\nas the conduct constituting the contravention."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zd-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
