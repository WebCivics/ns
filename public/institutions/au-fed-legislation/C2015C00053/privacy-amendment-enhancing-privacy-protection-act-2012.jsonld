    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21u-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "21U(5) Correction of credit information or credit eligibility",
