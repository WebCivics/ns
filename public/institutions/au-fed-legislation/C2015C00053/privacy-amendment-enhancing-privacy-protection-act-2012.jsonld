    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13f",
      "@type": "cml:Concept",
      "skos:prefLabel": "13F Act or practice not covered by section 13 is not an interference",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-13f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.177",
      "values:originalText": "with privacy\n\nAn act or practice that is not covered by section 13 is not an\ninterference with the privacy of an individual.",
      "skos:definition": "with privacy\n\nAn act or practice that is not covered by section 13 is not an\ninterference with the privacy of an individual.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13f-norm"
        }
      ],
      "cml:integrityHash": "bb3e079f0b5b44d9aeb17a68938df2c1f3f585a528015eee6ac3d17b313ecd26",
      "skos:note": "An act or practice not covered by section 13 is not an interference with the privacy of an individual."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-13f",
      "@type": "cof:Section",
      "cof:title": "13F Act or practice not covered by section 13 is not an interference",
      "values:kind": "section",
      "cof:pageNumber": 177,
      "values:originalText": "with privacy\n\nAn act or practice that is not covered by section 13 is not an\ninterference with the privacy of an individual."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13f-norm",
