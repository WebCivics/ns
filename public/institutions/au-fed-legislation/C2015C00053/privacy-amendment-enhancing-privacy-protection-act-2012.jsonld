          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40a-ss-5"
        }
      ],
      "cml:integrityHash": "09a2d9c20c677d77d4785d22a473ce288d8174cab93697343948591843b75384"
