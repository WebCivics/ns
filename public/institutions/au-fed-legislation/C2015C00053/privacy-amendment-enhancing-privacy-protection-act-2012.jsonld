    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-133",
      "@type": "cml:Concept",
      "skos:prefLabel": "133 Paragraphs 55B(1)(a) and (b) and (3)(a) and (b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-133"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.199",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) a specified APP entity had breached an Australian Privacy\nPrinciple; or\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) a specified APP entity had breached a registered APP code\nthat binds the entity.",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(a) a specified APP entity had breached an Australian Privacy\nPrinciple; or\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) a specified APP entity had breached a registered APP code\nthat binds the entity.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-133-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-133-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dbe4e86870ee3931c927328d888026e7507f34fb6b1e74c1567902b425e66abd",
      "skos:note": "Repeal paragraphs and substitute with conditions for breach of Australian Privacy Principle or APP code"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-133",
      "@type": "cof:Section",
      "cof:title": "133 Paragraphs 55B(1)(a) and (b) and (3)(a) and (b)",
      "values:kind": "section",
      "cof:pageNumber": 199,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) a specified APP entity had breached an Australian Privacy\nPrinciple; or\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) a specified APP entity had breached a registered APP code\nthat binds the entity."
    },
