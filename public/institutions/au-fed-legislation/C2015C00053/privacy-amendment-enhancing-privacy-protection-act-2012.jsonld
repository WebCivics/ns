    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Subsection 6(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.65",
      "values:originalText": "Insert:\ntrade insurance purpose of a trade insurer in relation to an\nindividual is the purpose of assessing:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) whether to provide insurance to, or the risk of providing\ninsurance to, a credit provider in relation to commercial\ncredit provided by the provider to the individual or another\nperson; or\n\n(b) the risk of a person defaulting on commercial credit in\nrelation to which the insurer has provided insurance to a\ncredit provider.",
      "skos:definition": "Insert:\ntrade insurance purpose of a trade insurer in relation to an\nindividual is the purpose of assessing:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) whether to provide insurance to, or the risk of providing\ninsurance to, a credit provider in relation to commercial\ncredit provided by the provider to the individual or another\nperson; or\n\n(b) the risk of a person defaulting on commercial credit in\nrelation to which the insurer has provided insurance to a\ncredit provider.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-64-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-64-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7f2b840584b093b104dd4e4956ef26f6dad4dd8d2138360883a4fd5fa5d4fadb",
      "skos:note": "Duty to assess risk of default on commercial credit",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-64",
      "@type": "cof:Section",
      "cof:title": "64 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "Insert:\ntrade insurance purpose of a trade insurer in relation to an\nindividual is the purpose of assessing:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) whether to provide insurance to, or the risk of providing\ninsurance to, a credit provider in relation to commercial\ncredit provided by the provider to the individual or another\nperson; or\n\n(b) the risk of a person defaulting on commercial credit in\nrelation to which the insurer has provided insurance to a\ncredit provider."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-64-norm",
