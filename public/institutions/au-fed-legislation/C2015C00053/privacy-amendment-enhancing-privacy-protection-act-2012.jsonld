      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Disclosure of credit information to a credit reporting body is permitted under certain conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "21D(3) Disclosure of credit information to a credit reporting body",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21d-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.111",
      "values:originalText": "(3) Credit information about an individual meets the requirements of\nthis subsection if:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) the information does not relate to an act, omission, matter or\nthing that occurred or existed before the individual turned 18;\nand\n\n(b) if the information relates to consumer credit or commercial\ncredit—the credit is or has been provided, or applied for, in\nAustralia; and\n\n(c) if the information is repayment history information about the\nindividual:\n\n(i) the credit provider is a licensee or is prescribed by the\nregulations; and\n\n(ii) the consumer credit to which the information relates is\nconsumer credit in relation to which the provider also\ndiscloses, or a credit provider has previously disclosed,\nconsumer credit liability information about the\nindividual to the credit reporting body; and\n\n(iii) the provider complies with any requirements relating to\nthe disclosure of the information that are prescribed by\nthe regulations; and\n\n(d) if the information is default information about the individual:\n\n(i) the credit provider has given the individual a notice in\nwriting stating that the provider intends to disclose the\ninformation to the credit reporting body; and\n\n(ii) at least 14 days have passed since the giving of the\nnotice.",
      "skos:definition": "(3) Credit information about an individual meets the requirements of\nthis subsection if:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) the information does not relate to an act, omission, matter or\nthing that occurred or existed before the individual turned 18;\nand\n\n(b) if the information relates to consumer credit or commercial\ncredit—the credit is or has been provided, or applied for, in\nAustralia; and\n\n(c) if the information is repayment history information about the\nindividual:\n\n(i) the credit provider is a licensee or is prescribed by the\nregulations; and\n\n(ii) the consumer credit to which the information relates is\nconsumer credit in relation to which the provider also\ndiscloses, or a credit provider has previously disclosed,\nconsumer credit liability information about the\nindividual to the credit reporting body; and\n\n(iii) the provider complies with any requirements relating to\nthe disclosure of the information that are prescribed by\nthe regulations; and\n\n(d) if the information is default information about the individual:\n\n(i) the credit provider has given the individual a notice in\nwriting stating that the provider intends to disclose the\ninformation to the credit reporting body; and\n\n(ii) at least 14 days have passed since the giving of the\nnotice.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "af1ea7b684205b857a4c8a9f431936d90b02ddd5f7a782d53d6bd60a20059ed4",
      "skos:note": "Credit information must be disclosed to a credit reporting body under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21d-ss-3",
      "@type": "cof:Section",
      "cof:title": "21D(3) Disclosure of credit information to a credit reporting body",
      "values:kind": "subsection",
      "cof:pageNumber": 111,
      "values:originalText": "(3) Credit information about an individual meets the requirements of\nthis subsection if:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) the information does not relate to an act, omission, matter or\nthing that occurred or existed before the individual turned 18;\nand\n\n(b) if the information relates to consumer credit or commercial\ncredit—the credit is or has been provided, or applied for, in\nAustralia; and\n\n(c) if the information is repayment history information about the\nindividual:\n\n(i) the credit provider is a licensee or is prescribed by the\nregulations; and\n\n(ii) the consumer credit to which the information relates is\nconsumer credit in relation to which the provider also\ndiscloses, or a credit provider has previously disclosed,\nconsumer credit liability information about the\nindividual to the credit reporting body; and\n\n(iii) the provider complies with any requirements relating to\nthe disclosure of the information that are prescribed by\nthe regulations; and\n\n(d) if the information is default information about the individual:\n\n(i) the credit provider has given the individual a notice in\nwriting stating that the provider intends to disclose the\ninformation to the credit reporting body; and\n\n(ii) at least 14 days have passed since the giving of the\nnotice."
    },
    {
