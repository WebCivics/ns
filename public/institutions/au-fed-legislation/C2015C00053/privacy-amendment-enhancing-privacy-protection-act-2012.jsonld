      "skos:note": "No notice required under subsections (2) or (3) if mandated by law or court order."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21w-ss-5",
      "@type": "cof:Section",
      "cof:title": "21W(5) Notice of correction etc. must be given",
