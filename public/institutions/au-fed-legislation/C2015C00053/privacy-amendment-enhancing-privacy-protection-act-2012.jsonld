      ],
      "cml:integrityHash": "5858e6ca38a9205952356b14e9432afa3a3336833ed1f65b6df79dab0f5555bf",
      "skos:note": "Disclose false or misleading credit information under section 21D."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21r-ss-3",
      "@type": "cof:Section",
      "cof:title": "21R(3) False or misleading credit information or credit eligibility",
      "values:kind": "subsection",
      "cof:pageNumber": 126,
      "values:originalText": "(3) A credit provider must not disclose credit information under\nsection 21D if the information is false or misleading in a material\nparticular.\nCivil penalty:\n2,000 penalty units."
    },
