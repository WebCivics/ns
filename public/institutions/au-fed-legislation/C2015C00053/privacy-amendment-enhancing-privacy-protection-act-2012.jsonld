        }
      ],
      "cml:integrityHash": "827bf2a9b596f744c7278560b36279761abd6422585aab2cf2701cebb01c5a0d",
      "skos:note": "Use or disclosure of personal information for consultation purposes is authorized. Credit provider must comply with Australian Privacy Principle 13 when handling identification information."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21u-ss-4",
      "@type": "cof:Section",
      "cof:title": "21U(4) Correction of credit information or credit eligibility",
      "values:kind": "subsection",
      "cof:pageNumber": 129,
      "values:originalText": "(4) The use or disclosure of personal information about the individual\nfor the purposes of the consultation is taken, for the purposes of\nthis Act, to be a use or disclosure that is authorised by this\nsubsection.\nNo charge"
    },
