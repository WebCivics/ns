      "@type": "cml:Concept",
      "skos:prefLabel": "9 3 This subclause applies in relation to the adoption, use or disclosure",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-9-5"
