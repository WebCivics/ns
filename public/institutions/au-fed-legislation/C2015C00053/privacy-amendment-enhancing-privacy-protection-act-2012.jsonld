      "cml:integrityHash": "34d7b3b11cba19e3f31650468c5117061ca01f28e5646e32426fc6994f1f879d",
      "skos:note": "Australian Privacy Principle 10 does not apply to APP entities in relation to credit eligibility information."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21q-ss-3",
      "@type": "cof:Section",
      "cof:title": "21Q(3) Quality of credit eligibility information",
      "values:kind": "subsection",
      "cof:pageNumber": 126,
      "values:originalText": "(3) If a credit provider is an APP entity, Australian Privacy Principle\n10 does not apply to the provider in relation to credit eligibility\ninformation."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21q-ss-3-norm",
