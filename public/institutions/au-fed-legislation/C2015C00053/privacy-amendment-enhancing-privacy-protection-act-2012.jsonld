      "cml:integrityHash": "9ce954456d8335001e58e6667132abc627a7474554658841fc4e568421f86b16",
      "skos:note": "Entity must provide access in a way that meets the needs of both the entity and the individual.",
      "dc:description": "yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-7",
      "@type": "cof:Section",
