          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-5-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "40098219ebb65b5cb6b3f6e78ee0b286972638f98bcb742b6a265fa81342f16a",
