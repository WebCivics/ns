      "values:kind": "subsection",
      "cof:pageNumber": 81,
      "values:originalText": "(4) Subsection (1) does not apply if:\n\n(a) the credit reporting body:\n\n(i) collects the credit information about the individual from\nan entity (other than a credit provider) in the course of\ncarrying on a credit reporting business; and\n\n(ii) knows, or believes on reasonable grounds, that the\nindividual is at least 18 years old; and\n\n(b) the information does not relate to an act, omission, matter or\nthing that occurred or existed before the individual turned 18;\nand\n\n(c) if the information relates to consumer credit or commercial\ncredit—the credit is or has been provided, or applied for, in\nAustralia; and\n\n(d) if the information is identification information about the\nindividual—the body also collects from the entity, or already\nholds, credit information of another kind about the\nindividual; and\n\n(e) if the information is repayment history information about the\nindividual—the body collects the information from another\ncredit reporting body that has an Australian link."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20c-ss-4-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20c-ss-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20c-ss-4-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Temporal relationship between credit reporting and consumer credit",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "if the information relates to consumer credit or commercial credit—the credit is or has been provided, or applied for, in Australia;",
      "cml:conclusionText": "The credit reporting must occur after the individual's 18th birthday"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20c-ss-4-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Recurring trace of credit reporting",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "if the information is repayment history information about the individual—the body collects the information from another credit reporting body that has an Australian link;",
      "cml:conclusionText": "The credit reporting must occur regularly"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20c-ss-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Duty to collect credit information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the credit reporting body collects the credit information about the individual from an entity (other than a credit provider)",
      "cml:conclusionText": "The credit reporting body has a duty to collect the credit information"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20c-ss-4-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Permission to collect credit information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the individual is at least 18 years old",
      "cml:conclusionText": "The credit reporting body is permitted to collect the credit information from an entity (other than a credit provider) if the individual has reached the age of majority"
    },
