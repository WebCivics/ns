    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 1 If:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-13-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.50",
      "values:originalText": "(a) an APP entity holds personal information about an\nindividual; and\n\n(b) either:\n\n(i) the entity is satisfied that, having regard to a purpose for\nwhich the information is held, the information is\ninaccurate, out-of-date, incomplete, irrelevant or\nmisleading; or\n\n(ii) the individual requests the entity to correct the\ninformation;\nthe entity must take such steps (if any) as are reasonable in the\ncircumstances to correct that information to ensure that, having\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nregard to the purpose for which it is held, the information is\naccurate, up-to-date, complete, relevant and not misleading.\nNotification of correction to third parties",
      "skos:definition": "(a) an APP entity holds personal information about an\nindividual; and\n\n(b) either:\n\n(i) the entity is satisfied that, having regard to a purpose for\nwhich the information is held, the information is\ninaccurate, out-of-date, incomplete, irrelevant or\nmisleading; or\n\n(ii) the individual requests the entity to correct the\ninformation;\nthe entity must take such steps (if any) as are reasonable in the\ncircumstances to correct that information to ensure that, having\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nregard to the purpose for which it is held, the information is\naccurate, up-to-date, complete, relevant and not misleading.\nNotification of correction to third parties",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-3-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-3-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-3-logic-argumentation-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-3-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-3-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "43c40c7bcba762b0fbb96e85a3ad2cf891f9f3abd99213cd6830af15724e7cde",
      "skos:note": "Correct inaccurate or incomplete personal information upon request.",
      "dc:description": "Steps to correct information"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-13-3",
      "@type": "cof:Section",
      "cof:title": "13 1 If:",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "(a) an APP entity holds personal information about an\nindividual; and\n\n(b) either:\n\n(i) the entity is satisfied that, having regard to a purpose for\nwhich the information is held, the information is\ninaccurate, out-of-date, incomplete, irrelevant or\nmisleading; or\n\n(ii) the individual requests the entity to correct the\ninformation;\nthe entity must take such steps (if any) as are reasonable in the\ncircumstances to correct that information to ensure that, having\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nregard to the purpose for which it is held, the information is\naccurate, up-to-date, complete, relevant and not misleading.\nNotification of correction to third parties"
    },
