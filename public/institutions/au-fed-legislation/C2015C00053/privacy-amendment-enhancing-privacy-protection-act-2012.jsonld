      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.248",
      "values:originalText": "Section 13G of the Privacy Act, as inserted by Schedule 4 to this Act,\napplies in relation to an act done, or a practice engaged in, after the\ncommencement time.",
      "skos:definition": "Section 13G of the Privacy Act, as inserted by Schedule 4 to this Act,\napplies in relation to an act done, or a practice engaged in, after the\ncommencement time.",
      "cml:asserts": [
        {
