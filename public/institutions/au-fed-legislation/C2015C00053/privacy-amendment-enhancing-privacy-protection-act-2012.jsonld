    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-29-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Commissioner must have due regard to the objects of the Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-29-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.182",
      "values:originalText": "The Commissioner must have due regard to the objects of this Act\nin performing the Commissioner’s functions, and exercising the\nCommissioner’s powers, conferred by this Act.\nNote:\nThe objects of this Act are set out in section 2A.",
      "skos:definition": "The Commissioner must have due regard to the objects of this Act\nin performing the Commissioner’s functions, and exercising the\nCommissioner’s powers, conferred by this Act.\nNote:\nThe objects of this Act are set out in section 2A.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-29-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-29-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "192883fcbfe9ed1d68a6a0080de7e9fd9000eaa8abf428e31f539c14f9c2f4f3",
      "skos:note": "Commissioner must have due regard to the objects of the Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-29-2",
      "@type": "cof:Section",
      "cof:title": "29 Commissioner must have due regard to the objects of the Act",
      "values:kind": "section",
      "cof:pageNumber": 182,
      "values:originalText": "The Commissioner must have due regard to the objects of this Act\nin performing the Commissioner’s functions, and exercising the\nCommissioner’s powers, conferred by this Act.\nNote:\nThe objects of this Act are set out in section 2A."
    },
