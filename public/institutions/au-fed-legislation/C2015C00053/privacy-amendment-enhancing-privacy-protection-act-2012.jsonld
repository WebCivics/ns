    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Saving—guidelines issued under other Acts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.251",
      "values:originalText": "(1)\nThis item applies to guidelines if:\n\n(a) the guidelines were issued under section 135AA of the\nNational Health Act 1953 or section 12 of the Data-matching\nProgram (Assistance and Tax) Act 1990; and\n\n(b) the guidelines were in force immediately before the\ncommencement time.\n(2)\nThe guidelines have effect, after that time, as if they had been rules\nissued under that section, as amended by Schedule 5 to this Act.\nComLaw Authoritative Act C2015C00053\n\nSchedule 6  Application, transitional and savings provisions",
      "skos:definition": "(1)\nThis item applies to guidelines if:\n\n(a) the guidelines were issued under section 135AA of the\nNational Health Act 1953 or section 12 of the Data-matching\nProgram (Assistance and Tax) Act 1990; and\n\n(b) the guidelines were in force immediately before the\ncommencement time.\n(2)\nThe guidelines have effect, after that time, as if they had been rules\nissued under that section, as amended by Schedule 5 to this Act.\nComLaw Authoritative Act C2015C00053\n\nSchedule 6  Application, transitional and savings provisions",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-15-norm"
        }
      ],
      "cml:integrityHash": "6b372ab5176b2cc0fac1003b6a9361fd3b2c36698402f9c5ee89f50e71ecec7c",
      "skos:note": "Saving—guidelines issued under other Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Saving—guidelines issued under other Acts",
      "values:kind": "section",
      "cof:pageNumber": 251,
      "values:originalText": "(1)\nThis item applies to guidelines if:\n\n(a) the guidelines were issued under section 135AA of the\nNational Health Act 1953 or section 12 of the Data-matching\nProgram (Assistance and Tax) Act 1990; and\n\n(b) the guidelines were in force immediately before the\ncommencement time.\n(2)\nThe guidelines have effect, after that time, as if they had been rules\nissued under that section, as amended by Schedule 5 to this Act.\nComLaw Authoritative Act C2015C00053\n\nSchedule 6  Application, transitional and savings provisions"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-15-norm",
