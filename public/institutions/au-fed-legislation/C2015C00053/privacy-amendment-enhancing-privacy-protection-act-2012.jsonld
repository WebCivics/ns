      ],
      "cml:integrityHash": "990d29cafbe7119f177f09777b13f8eb14ddfe0296d1b4b5ad24279f00b62d49",
      "skos:note": "Commissioner may decide not to investigate or further investigate a complaint."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-40a-ss-4",
      "@type": "cof:Section",
