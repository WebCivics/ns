      ],
      "cml:integrityHash": "7cdfbd5d634cf18076c6cb6564f607c3a8d52537fea8d180d717f39efffc18d1",
      "skos:note": "Compilation and registration of amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-189",
      "@type": "cof:Section",
      "cof:title": "189 After Part VIA",
      "values:kind": "section",
