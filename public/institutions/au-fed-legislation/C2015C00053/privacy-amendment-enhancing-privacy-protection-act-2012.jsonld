    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Guide to this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-22-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.133",
      "values:originalText": "This Division sets out rules that apply to affected information\nrecipients in relation to their handling of their regulated\ninformation.\nIf an affected information recipient is an APP entity, the rules\napply in relation to the regulated information of the recipient in\naddition to, or instead of, any relevant Australian Privacy\nPrinciples.\nSubdivision A—Consideration of information privacy",
      "skos:definition": "This Division sets out rules that apply to affected information\nrecipients in relation to their handling of their regulated\ninformation.\nIf an affected information recipient is an APP entity, the rules\napply in relation to the regulated information of the recipient in\naddition to, or instead of, any relevant Australian Privacy\nPrinciples.\nSubdivision A—Consideration of information privacy",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c730138c22859228c56b0f25af482d4f6a990480719c38bcfefbe8f41474f767",
      "skos:note": "Rules for handling regulated information apply to affected recipients."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-22-2",
      "@type": "cof:Section",
      "cof:title": "22 Guide to this Division",
      "values:kind": "section",
      "cof:pageNumber": 133,
      "values:originalText": "This Division sets out rules that apply to affected information\nrecipients in relation to their handling of their regulated\ninformation.\nIf an affected information recipient is an APP entity, the rules\napply in relation to the regulated information of the recipient in\naddition to, or instead of, any relevant Australian Privacy\nPrinciples.\nSubdivision A—Consideration of information privacy"
    },
