    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26j-ss-8",
      "@type": "cof:Section",
      "cof:title": "26J(8) Variation of registered APP codes",
      "values:kind": "subsection",
      "cof:pageNumber": 158,
      "values:originalText": "(8) An approval is not a legislative instrument.\nNote:\nThe APP code, as varied, is a legislative instrument once it is included\non the Codes Register: see section 26B."
    },
