      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The policy is available",
      "cml:conclusionText": "It must be made available"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "20B(6) Open and transparent management of credit reporting",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20b-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.80",
      "values:originalText": "(6) If a person or body requests a copy, in a particular form, of the\npolicy of a credit reporting body, the credit reporting body must\ntake such steps as are reasonable in the circumstances to give the\nperson or body a copy in that form.\nSubdivision C—Collection of credit information",
      "skos:definition": "(6) If a person or body requests a copy, in a particular form, of the\npolicy of a credit reporting body, the credit reporting body must\ntake such steps as are reasonable in the circumstances to give the\nperson or body a copy in that form.\nSubdivision C—Collection of credit information",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-6-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ddac24c392f15df918643b2a7e7c35db761836c7ae19b8c90dcddf3343029288",
      "skos:note": "Credit reporting body must provide a copy of its policy in a requested form.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20b-ss-6",
      "@type": "cof:Section",
      "cof:title": "20B(6) Open and transparent management of credit reporting",
      "values:kind": "subsection",
      "cof:pageNumber": 80,
      "values:originalText": "(6) If a person or body requests a copy, in a particular form, of the\npolicy of a credit reporting body, the credit reporting body must\ntake such steps as are reasonable in the circumstances to give the\nperson or body a copy in that form.\nSubdivision C—Collection of credit information"
    },
