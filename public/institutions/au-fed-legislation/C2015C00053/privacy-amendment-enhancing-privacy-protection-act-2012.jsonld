    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80y",
      "@type": "cml:Concept",
      "skos:prefLabel": "80Y Conduct contravening more than one civil penalty provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80y"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.209",
      "values:originalText": "(1) If conduct constitutes a contravention of 2 or more civil penalty\nprovisions, proceedings may be instituted under this Division\nagainst an entity in relation to the contravention of any one or more\nof those provisions.\n\n(2) However, the entity is not liable to more than one pecuniary\npenalty under this Division in relation to the same conduct.",
      "skos:definition": "(1) If conduct constitutes a contravention of 2 or more civil penalty\nprovisions, proceedings may be instituted under this Division\nagainst an entity in relation to the contravention of any one or more\nof those provisions.\n\n(2) However, the entity is not liable to more than one pecuniary\npenalty under this Division in relation to the same conduct.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80y-ss-1"
        },
        {
