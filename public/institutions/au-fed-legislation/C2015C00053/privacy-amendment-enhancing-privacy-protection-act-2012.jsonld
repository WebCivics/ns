          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-6ba-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-6ba-logic-argumentation-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-6ba-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-6ba-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "f6ed454c19e866e4742a34c959cd5ff62cfa87b384abff34ed5c542798c53e1b",
      "skos:note": "Act or practice breaches CR code if it is contrary to the code."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-6ba",
      "@type": "cof:Section",
      "cof:title": "6BA Breach of the registered CR code",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "For the purposes of this Act, an act or practice breaches the\nregistered CR code if, and only if, it is contrary to, or inconsistent\nwith, the code."
    },
