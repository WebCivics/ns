      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.41",
      "values:originalText": "the organisation must not use or disclose the information for the\npurpose of direct marketing.\nNote:\nAn act or practice of an agency may be treated as an act or practice of\nan organisation, see section 7A.\nExceptions—personal information other than sensitive information",
      "skos:definition": "the organisation must not use or disclose the information for the\npurpose of direct marketing.\nNote:\nAn act or practice of an agency may be treated as an act or practice of\nan organisation, see section 7A.\nExceptions—personal information other than sensitive information",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-3-logic-deontic-1"
        },
        {
