        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The organisation has a rational basis to prohibit using personal information for direct marketing.",
      "cml:conclusionText": "Must not use or disclose the information for the purpose of direct marketing."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-3-logic-diffusion-4",
