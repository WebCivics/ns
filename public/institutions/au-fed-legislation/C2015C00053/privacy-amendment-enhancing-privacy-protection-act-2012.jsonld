    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Subsection 6(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.60",
      "values:originalText": "Insert:\nmortgage insurance purpose of a mortgage insurer in relation to\nan individual is the purpose of assessing:\n\n(a) whether to provide insurance to, or the risk of providing\ninsurance to, a credit provider in relation to mortgage credit:\n\n(i) provided by the provider to the individual; or\n\n(ii) for which an application to the provider has been made\nby the individual; or\n\n(b) the risk of the individual defaulting on mortgage credit in\nrelation to which the insurer has provided insurance to a\ncredit provider; or\n\n(c) the risk of the individual being unable to meet a liability that\nmight arise under a guarantee provided, or proposed to be\nprovided, in relation to mortgage credit provided by a credit\nprovider to another person.",
      "skos:definition": "Insert:\nmortgage insurance purpose of a mortgage insurer in relation to\nan individual is the purpose of assessing:\n\n(a) whether to provide insurance to, or the risk of providing\ninsurance to, a credit provider in relation to mortgage credit:\n\n(i) provided by the provider to the individual; or\n\n(ii) for which an application to the provider has been made\nby the individual; or\n\n(b) the risk of the individual defaulting on mortgage credit in\nrelation to which the insurer has provided insurance to a\ncredit provider; or\n\n(c) the risk of the individual being unable to meet a liability that\nmight arise under a guarantee provided, or proposed to be\nprovided, in relation to mortgage credit provided by a credit\nprovider to another person.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-41-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-41-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "349a2930ba3859bc00aa2cbc369fddf105f453549c2dbf3a7630503552740015",
      "skos:note": "Assess risk of providing insurance to credit provider or individual"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "Insert:\nmortgage insurance purpose of a mortgage insurer in relation to\nan individual is the purpose of assessing:\n\n(a) whether to provide insurance to, or the risk of providing\ninsurance to, a credit provider in relation to mortgage credit:\n\n(i) provided by the provider to the individual; or\n\n(ii) for which an application to the provider has been made\nby the individual; or\n\n(b) the risk of the individual defaulting on mortgage credit in\nrelation to which the insurer has provided insurance to a\ncredit provider; or\n\n(c) the risk of the individual being unable to meet a liability that\nmight arise under a guarantee provided, or proposed to be\nprovided, in relation to mortgage credit provided by a credit\nprovider to another person."
    },
