    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22d-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "22D(2) Use or disclosure of information by a related body corporate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-22d-ss-2"
      },
