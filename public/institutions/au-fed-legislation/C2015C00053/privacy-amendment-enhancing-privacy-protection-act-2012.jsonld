      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.141",
      "values:originalText": "(5) The credit reporting body or credit provider must not charge the\nindividual for the making of the complaint or for dealing with the\ncomplaint.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "(5) The credit reporting body or credit provider must not charge the\nindividual for the making of the complaint or for dealing with the\ncomplaint.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23a"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23a-ss-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23a-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4f59bf93f1f31475d2e7924bc8cfe17554285b0d6da01448b85b2366bda1a292",
      "skos:note": "Credit provider cannot charge individual for complaint or dealing with complaint."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23a-ss-5",
      "@type": "cof:Section",
      "cof:title": "23A(5) Individual may complain about a breach of a provision of this",
      "values:kind": "subsection",
      "cof:pageNumber": 141,
      "values:originalText": "(5) The credit reporting body or credit provider must not charge the\nindividual for the making of the complaint or for dealing with the\ncomplaint.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23a-ss-5-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23a-ss-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23a-ss-5-logic-deontic-1",
