    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 4 If:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-6-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.40",
      "values:originalText": "(a) the APP entity is an organisation; and\n\n(b) subsection 16B(2) applied in relation to the collection of the\npersonal information by the entity;\nthe entity must take such steps as are reasonable in the\ncircumstances to ensure that the information is de-identified before\nthe entity discloses it in accordance with subclause 6.1 or 6.2.\nWritten note of use or disclosure",
      "skos:definition": "(a) the APP entity is an organisation; and\n\n(b) subsection 16B(2) applied in relation to the collection of the\npersonal information by the entity;\nthe entity must take such steps as are reasonable in the\ncircumstances to ensure that the information is de-identified before\nthe entity discloses it in accordance with subclause 6.1 or 6.2.\nWritten note of use or disclosure",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-6-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d2a2fda6e81bfe96edd83767dbf9cc32e93dba220bbfd1158993880c71d3ed8d",
      "skos:note": "Ensure de-identification of personal information before disclosure"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-6-6",
      "@type": "cof:Section",
      "cof:title": "6 4 If:",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "(a) the APP entity is an organisation; and\n\n(b) subsection 16B(2) applied in relation to the collection of the\npersonal information by the entity;\nthe entity must take such steps as are reasonable in the\ncircumstances to ensure that the information is de-identified before\nthe entity discloses it in accordance with subclause 6.1 or 6.2.\nWritten note of use or disclosure"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-6-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-6"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must ensure de-identification",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the APP entity is an organisation; and (b) subsection 16B(2) applied in relation to the collection of the personal information by the entity;",
      "cml:conclusionText": "the entity must take such steps as are reasonable in the circumstances to ensure that the information is de-identified before the entity discloses it in accordance with subclause 6.1 or 6.2."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-7",
