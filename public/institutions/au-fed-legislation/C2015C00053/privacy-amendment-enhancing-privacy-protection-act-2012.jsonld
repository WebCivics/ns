        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-23-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "63f9330f786edd4c0b25def2bb53206017c91e3fba8940aa47d8f5c0f3144564",
      "skos:note": "Defines government-related identifier of an individual"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Insert:\ngovernment related identifier of an individual means an identifier\nof the individual that has been assigned by:\n\n(a) an agency; or\n\n(b) a State or Territory authority; or\n\n(c) an agent of an agency, or a State or Territory authority, acting\nin its capacity as agent; or\n\n(d) a contracted service provider for a Commonwealth contract,\nor a State contract, acting in its capacity as contracted service\nprovider for that contract."
    },
