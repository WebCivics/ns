        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "51fe211747820533f1fc09e383190adb71db01b6b47146326ed033a02d22fd84",
      "skos:note": "No excessive charge for access to credit reporting information"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20r-ss-6",
      "@type": "cof:Section",
      "cof:title": "20R(6) Access to credit reporting information",
      "values:kind": "subsection",
      "cof:pageNumber": 94,
      "values:originalText": "(6) If subsection (5) does not apply, any charge by the credit reporting\nbody for giving access to the information must not be excessive\nand must not apply to the making of the request.\nRefusal to give access"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-6-norm",
