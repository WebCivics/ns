      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26w",
      "@type": "cml:Concept",
      "skos:prefLabel": "26W Review of operation of registered codes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
