      },
      "cml:premiseText": "The organisation or small business operator is a credit provider.",
      "cml:conclusionText": "It is not a credit provider."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6g-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6G(6) Meaning of credit provider",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6g-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.66",
      "values:originalText": "(6) Despite subsections (1) to (4) of this section, an organisation or\nsmall business operator is not a credit provider if it is included in a\nclass of organisations or operators prescribed by the regulations.",
      "skos:definition": "(6) Despite subsections (1) to (4) of this section, an organisation or\nsmall business operator is not a credit provider if it is included in a\nclass of organisations or operators prescribed by the regulations.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6g"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6g-ss-6-norm"
        }
      ],
      "cml:integrityHash": "8c41d4a9956122f0abba052b0fc6498d0da42637051bd3878fea11bdb172f00d",
      "skos:note": "An organisation or small business operator is not a credit provider if it is included in a class of organisations or operators prescribed by the regulations."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6g-ss-6",
      "@type": "cof:Section",
      "cof:title": "6G(6) Meaning of credit provider",
      "values:kind": "subsection",
      "cof:pageNumber": 66,
      "values:originalText": "(6) Despite subsections (1) to (4) of this section, an organisation or\nsmall business operator is not a credit provider if it is included in a\nclass of organisations or operators prescribed by the regulations."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6g-ss-6-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6g-ss-6"
      },
      "values:deonticStatus": {
