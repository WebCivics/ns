      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.51",
      "values:originalText": "(a) the APP entity corrects personal information about an\nindividual that the entity previously disclosed to another APP\nentity; and\n\n(b) the individual requests the entity to notify the other APP\nentity of the correction;\nthe entity must take such steps (if any) as are reasonable in the\ncircumstances to give that notification unless it is impracticable or\nunlawful to do so.\nRefusal to correct information",
      "skos:definition": "(a) the APP entity corrects personal information about an\nindividual that the entity previously disclosed to another APP\nentity; and\n\n(b) the individual requests the entity to notify the other APP\nentity of the correction;\nthe entity must take such steps (if any) as are reasonable in the\ncircumstances to give that notification unless it is impracticable or\nunlawful to do so.\nRefusal to correct information",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-13-4-norm"
        },
        {
