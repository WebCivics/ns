    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-1-3",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
