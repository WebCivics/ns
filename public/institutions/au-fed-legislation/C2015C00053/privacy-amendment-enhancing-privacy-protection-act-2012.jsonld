      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.60",
      "values:originalText": "Repeal the definition, substitute:\nmortgage credit means consumer credit:\n\n(a) that is provided in connection with the acquisition,\nmaintenance, renovation or improvement of real property;\nand\n\n(b) in relation to which the real property is security.",
      "skos:definition": "Repeal the definition, substitute:\nmortgage credit means consumer credit:\n\n(a) that is provided in connection with the acquisition,\nmaintenance, renovation or improvement of real property;\nand\n\n(b) in relation to which the real property is security.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-40-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-40-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-40-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "ef2a4bdcc2d9bc8061b01b1715c02e2d3a7f503c10fa0ed0c7bee619cfff1747",
      "skos:note": "Defines mortgage credit as consumer credit related to real property acquisition, maintenance, renovation or improvement."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-40",
      "@type": "cof:Section",
