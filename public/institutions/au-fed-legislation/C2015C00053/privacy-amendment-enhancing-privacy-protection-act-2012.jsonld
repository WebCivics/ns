      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-18-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Pre-commencement acts and practices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-18-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.252",
      "values:originalText": "(1)\nThis item applies if:\n\n(a) before the commencement time, an act was done, or a\npractice was engaged in, by an agency or organisation; and\nComLaw Authoritative Act C2015C00053\n\nApplication, transitional and savings provisions  Schedule 6\nProvisions relating to other matters  Part 7\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the act or practice may be an interference with the privacy of\nan individual under section 13 or 13A of the Privacy Act (as\nin force immediately before that time); and\n\n(c) immediately before that time:\n\n(i) the individual has not made a complaint about the act or\npractice to the Commissioner under section 36 of that\nAct; and\n\n(ii) the Commissioner has not decided to investigate the act\nor practice under subsection 40(2) of that Act.\n(2)\nDespite the amendments of the Privacy Act made by this Act, the\nindividual may, after the commencement time, complain to the\nCommissioner about the act or practice, and the complaint may be dealt\nwith, under the Privacy Act as if those amendments had not been made.\n(3)\nDespite the amendments of the Privacy Act made by this Act, the\nCommissioner may, after the commencement time, investigate the act\nor practice under subsection 40(2) of the Privacy Act as if those\namendments had not been made.",
      "skos:definition": "(1)\nThis item applies if:\n\n(a) before the commencement time, an act was done, or a\npractice was engaged in, by an agency or organisation; and\nComLaw Authoritative Act C2015C00053\n\nApplication, transitional and savings provisions  Schedule 6\nProvisions relating to other matters  Part 7\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the act or practice may be an interference with the privacy of\nan individual under section 13 or 13A of the Privacy Act (as\nin force immediately before that time); and\n\n(c) immediately before that time:\n\n(i) the individual has not made a complaint about the act or\npractice to the Commissioner under section 36 of that\nAct; and\n\n(ii) the Commissioner has not decided to investigate the act\nor practice under subsection 40(2) of that Act.\n(2)\nDespite the amendments of the Privacy Act made by this Act, the\nindividual may, after the commencement time, complain to the\nCommissioner about the act or practice, and the complaint may be dealt\nwith, under the Privacy Act as if those amendments had not been made.\n(3)\nDespite the amendments of the Privacy Act made by this Act, the\nCommissioner may, after the commencement time, investigate the act\nor practice under subsection 40(2) of the Privacy Act as if those\namendments had not been made.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-18-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-18-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "303d7c52620e9eb09d0ec8b6f100b15472f98ce292d0e4b4817c4c4748f2075c",
      "skos:note": "An act or practice done before commencement time may be an interference with individual privacy."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-18-2",
      "@type": "cof:Section",
      "cof:title": "18 Pre-commencement acts and practices",
      "values:kind": "section",
      "cof:pageNumber": 252,
      "values:originalText": "(1)\nThis item applies if:\n\n(a) before the commencement time, an act was done, or a\npractice was engaged in, by an agency or organisation; and\nComLaw Authoritative Act C2015C00053\n\nApplication, transitional and savings provisions  Schedule 6\nProvisions relating to other matters  Part 7\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the act or practice may be an interference with the privacy of\nan individual under section 13 or 13A of the Privacy Act (as\nin force immediately before that time); and\n\n(c) immediately before that time:\n\n(i) the individual has not made a complaint about the act or\npractice to the Commissioner under section 36 of that\nAct; and\n\n(ii) the Commissioner has not decided to investigate the act\nor practice under subsection 40(2) of that Act.\n(2)\nDespite the amendments of the Privacy Act made by this Act, the\nindividual may, after the commencement time, complain to the\nCommissioner about the act or practice, and the complaint may be dealt\nwith, under the Privacy Act as if those amendments had not been made.\n(3)\nDespite the amendments of the Privacy Act made by this Act, the\nCommissioner may, after the commencement time, investigate the act\nor practice under subsection 40(2) of the Privacy Act as if those\namendments had not been made."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-18-2-norm",
      "@type": "values:Obligation",
