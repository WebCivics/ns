      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-24",
      "@type": "cof:Section",
      "cof:title": "24 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Insert:\nholds: an entity holds personal information if the entity has\npossession or control of a record that contains the personal\ninformation.\nNote:\nSee section 10 for when an agency is taken to hold a record."
    },
