          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21s-ss-3"
        }
      ],
      "cml:integrityHash": "a5f9eee72a2b73507fd62026dbf4b12c3febedf25ee8d21101d4c9d34a9a2afb"
    },
