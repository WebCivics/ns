    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 2 If:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.47",
      "values:originalText": "(a) the APP entity is an agency; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 1  Australian Privacy Principles\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the entity is required or authorised to refuse to give the\nindividual access to the personal information by or under:\n\n(i) the Freedom of Information Act; or\n\n(ii) any other Act of the Commonwealth, or a Norfolk\nIsland enactment, that provides for access by persons to\ndocuments;\nthen, despite subclause 12.1, the entity is not required to give\naccess to the extent that the entity is required or authorised to\nrefuse to give access.\nException to access—organisation",
      "skos:definition": "(a) the APP entity is an agency; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 1  Australian Privacy Principles\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the entity is required or authorised to refuse to give the\nindividual access to the personal information by or under:\n\n(i) the Freedom of Information Act; or\n\n(ii) any other Act of the Commonwealth, or a Norfolk\nIsland enactment, that provides for access by persons to\ndocuments;\nthen, despite subclause 12.1, the entity is not required to give\naccess to the extent that the entity is required or authorised to\nrefuse to give access.\nException to access—organisation",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-4-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-4-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-4-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "4aae10bc6be359448a6dda67f5f49f92ea6e3bac59df01a3816957e258c7764c",
      "skos:note": "Entity may refuse access to personal information under certain conditions."
