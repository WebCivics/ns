    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-1-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.32",
      "values:originalText": "2 An APP entity must take such steps as are reasonable in the\ncircumstances to implement practices, procedures and systems\nrelating to the entity’s functions or activities that:\n\n(a) will ensure that the entity complies with the Australian\nPrivacy Principles and a registered APP code (if any) that\nbinds the entity; and\n\n(b) will enable the entity to deal with inquiries or complaints\nfrom individuals about the entity’s compliance with the\nAustralian Privacy Principles or such a code.\nAPP Privacy policy",
      "skos:definition": "2 An APP entity must take such steps as are reasonable in the\ncircumstances to implement practices, procedures and systems\nrelating to the entity’s functions or activities that:\n\n(a) will ensure that the entity complies with the Australian\nPrivacy Principles and a registered APP code (if any) that\nbinds the entity; and\n\n(b) will enable the entity to deal with inquiries or complaints\nfrom individuals about the entity’s compliance with the\nAustralian Privacy Principles or such a code.\nAPP Privacy policy",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "adf277fafdae532c7dbee93a21c0bd28bb3873b6a6426f7005e1e3a036e662e2",
      "skos:note": "Must implement practices, procedures and systems to comply with Australian Privacy Principles."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-1-4",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "2 An APP entity must take such steps as are reasonable in the\ncircumstances to implement practices, procedures and systems\nrelating to the entity’s functions or activities that:\n\n(a) will ensure that the entity complies with the Australian\nPrivacy Principles and a registered APP code (if any) that\nbinds the entity; and\n\n(b) will enable the entity to deal with inquiries or complaints\nfrom individuals about the entity’s compliance with the\nAustralian Privacy Principles or such a code.\nAPP Privacy policy"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-4-norm",
