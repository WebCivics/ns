      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.235",
      "values:originalText": "Omit “agency (within the meaning of section 11A of the Privacy Act\n1988) would be required, under subsection 18K(5)”, substitute “body\n(within the meaning of the Privacy Act 1988) would be required, under\nsubsection 20E(5)”.\nLaw Enforcement Integrity Commissioner Act 2006",
      "skos:definition": "Omit “agency (within the meaning of section 11A of the Privacy Act\n1988) would be required, under subsection 18K(5)”, substitute “body\n(within the meaning of the Privacy Act 1988) would be required, under\nsubsection 20E(5)”.\nLaw Enforcement Integrity Commissioner Act 2006",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-128-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-128-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "336004368dbef9b4d12e3a0b413890975e9e6c49923626da8dde5e81373e00c8",
      "skos:note": "Omit specific term from definition"
    },
