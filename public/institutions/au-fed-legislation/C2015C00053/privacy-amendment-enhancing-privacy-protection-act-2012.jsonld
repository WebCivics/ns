    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l",
      "@type": "cml:Concept",
      "skos:prefLabel": "35L Breach of requirement is an interference with privacy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-35l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.235",
      "values:originalText": "A breach of a requirement of this Division in relation to an\nindividual constitutes an act or practice involving an interference\nwith the privacy of the individual for the purposes of section 13 of\nthe Privacy Act 1988.\nNote:\nThe act or practice may be the subject of a complaint under section 36\nof that Act.\nAustralian Crime Commission Act 2002",
      "skos:definition": "A breach of a requirement of this Division in relation to an\nindividual constitutes an act or practice involving an interference\nwith the privacy of the individual for the purposes of section 13 of\nthe Privacy Act 1988.\nNote:\nThe act or practice may be the subject of a complaint under section 36\nof that Act.\nAustralian Crime Commission Act 2002",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "17bbedd6f2139cd28b29c333fde8a1349e8657a2b382f4e42bffcbbe4d3e266f",
      "skos:note": "Interference with privacy constitutes a breach of requirement."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-35l",
      "@type": "cof:Section",
      "cof:title": "35L Breach of requirement is an interference with privacy",
      "values:kind": "section",
      "cof:pageNumber": 235,
      "values:originalText": "A breach of a requirement of this Division in relation to an\nindividual constitutes an act or practice involving an interference\nwith the privacy of the individual for the purposes of section 13 of\nthe Privacy Act 1988.\nNote:\nThe act or practice may be the subject of a complaint under section 36\nof that Act.\nAustralian Crime Commission Act 2002"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to protect privacy",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 13 of the Privacy Act 1988",
      "cml:conclusionText": "Breach of requirement constitutes an act or practice involving an interference with the privacy of the individual."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap between breach and requirement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Breach of a requirement in relation to an individual",
      "cml:conclusionText": "The breach overlaps with the requirement in relation to the individual."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrent",
      "cml:logicSummary": "Recurring interference with privacy",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 13 of the Privacy Act 1988",
      "cml:conclusionText": "The interference is recurring and involves an act or practice."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffusion of breach to requirement",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Breach of a requirement in relation to an individual",
      "cml:conclusionText": "The breach diffuses to the requirement in relation to the individual."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35l-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "Recognition of breach as interference with privacy",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 13 of the Privacy Act 1988",
      "cml:conclusionText": "The breach is recognized as an act or practice involving an interference with the privacy of the individual."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-128",
      "@type": "cml:Concept",
      "skos:prefLabel": "128 Paragraph 29A(7)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-128"
      },
