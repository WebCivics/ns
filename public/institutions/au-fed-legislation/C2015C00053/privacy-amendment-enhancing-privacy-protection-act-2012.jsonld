    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Subsection 409(4)",
      "values:kind": "section",
      "cof:pageNumber": 224,
      "values:originalText": "Omit “Information Privacy Principles set out in section 14 of the\nPrivacy Act 1988, to be authorised by law”, substitute “Australian\nPrivacy Principles, to be authorised by this Act”.\nComLaw Authoritative Act C2015C00053\n\nAmendment of other Acts  Schedule 5\nAmendments relating to the Australian Privacy Principles  Part 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nMutual Assistance in Criminal Matters Act 1987"
    },
