    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "21D(6) Disclosure of credit information to a credit reporting body",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21d-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.111",
      "values:originalText": "(6) If a credit provider discloses credit information under this section,\nthe provider must make a written note of that disclosure.\nCivil penalty:\n500 penalty units.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nInteraction with the Australian Privacy Principles",
      "skos:definition": "(6) If a credit provider discloses credit information under this section,\nthe provider must make a written note of that disclosure.\nCivil penalty:\n500 penalty units.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nInteraction with the Australian Privacy Principles",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-6-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ebabde7b9dc45546992df53f6982eec2496c1b07eb3d5f71ba79b6f82fc17297",
      "skos:note": "Credit provider must make a written note of disclosure.",
      "dc:description": "written note of disclosure"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21d-ss-6",
      "@type": "cof:Section",
      "cof:title": "21D(6) Disclosure of credit information to a credit reporting body",
      "values:kind": "subsection",
      "cof:pageNumber": 111,
      "values:originalText": "(6) If a credit provider discloses credit information under this section,\nthe provider must make a written note of that disclosure.\nCivil penalty:\n500 penalty units.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nInteraction with the Australian Privacy Principles"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-6-norm",
      "@type": "values:Obligation",
