      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zd"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80zd-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Cannot",
      "cml:logicSummary": "Prohibition on making a civil penalty order",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80ze",
      "@type": "cml:Concept",
      "skos:prefLabel": "80ZE Criminal proceedings during civil proceedings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80ze"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.210",
      "values:originalText": "(1) Proceedings for a civil penalty order against an entity for a\ncontravention of a civil penalty provision are stayed if:\n\n(a) criminal proceedings are commenced or have already been\ncommenced against the entity for an offence; and\n\n(b) the offence is constituted by conduct that is the same, or\nsubstantially the same, as the conduct alleged to constitute\nthe contravention.\n\n(2) The proceedings for the civil penalty order may be resumed if the\nentity is not convicted of the offence. Otherwise:\n\n(a) the proceedings are dismissed; and\n\n(b) costs must not be awarded in relation to the proceedings.",
      "skos:definition": "(1) Proceedings for a civil penalty order against an entity for a\ncontravention of a civil penalty provision are stayed if:\n\n(a) criminal proceedings are commenced or have already been\ncommenced against the entity for an offence; and\n\n(b) the offence is constituted by conduct that is the same, or\nsubstantially the same, as the conduct alleged to constitute\nthe contravention.\n\n(2) The proceedings for the civil penalty order may be resumed if the\nentity is not convicted of the offence. Otherwise:\n\n(a) the proceedings are dismissed; and\n\n(b) costs must not be awarded in relation to the proceedings.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80ze-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80ze-ss-2"
        }
      ],
      "cml:integrityHash": "26ec4eff0f5e4ac078fdcbd5344662e3488bb19a604fde590e93e3b677f835d2"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80ze",
      "@type": "cof:Section",
      "cof:title": "80ZE Criminal proceedings during civil proceedings",
      "values:kind": "section",
      "cof:pageNumber": 210,
      "values:originalText": "(1) Proceedings for a civil penalty order against an entity for a\ncontravention of a civil penalty provision are stayed if:\n\n(a) criminal proceedings are commenced or have already been\ncommenced against the entity for an offence; and\n\n(b) the offence is constituted by conduct that is the same, or\nsubstantially the same, as the conduct alleged to constitute\nthe contravention.\n\n(2) The proceedings for the civil penalty order may be resumed if the\nentity is not convicted of the offence. Otherwise:\n\n(a) the proceedings are dismissed; and\n\n(b) costs must not be awarded in relation to the proceedings."
    },
