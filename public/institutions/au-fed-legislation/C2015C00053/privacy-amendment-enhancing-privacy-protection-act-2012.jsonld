          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20s-ss-1-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "344f07a73def634c907b15b35fb066db2e8fa13b8bf232db3c75e6c48e77c435",
      "skos:note": "Request to correct personal information about an individual Correct inaccurate credit reporting information",
      "dc:description": "Reasonable steps to correct information"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20s-ss-1",
