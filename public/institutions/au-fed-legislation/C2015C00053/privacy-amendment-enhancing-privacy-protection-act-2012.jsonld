    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-27-2-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "27(4) Functions of the Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-27-2-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.178",
      "values:originalText": "(4) Section 38 of the Healthcare Identifiers Act 2010, rather than\nsection 12B of this Act, applies in relation to an investigation of an\nact or practice referred to in subsection 29(1) of that Act in the\nsame way as it applies to Parts 3 and 4 of that Act.\nNote:\nSection 38 of the Healthcare Identifiers Act 2010 deals with the\nadditional effect of Parts 3 and 4 of that Act.",
      "skos:definition": "(4) Section 38 of the Healthcare Identifiers Act 2010, rather than\nsection 12B of this Act, applies in relation to an investigation of an\nact or practice referred to in subsection 29(1) of that Act in the\nsame way as it applies to Parts 3 and 4 of that Act.\nNote:\nSection 38 of the Healthcare Identifiers Act 2010 deals with the\nadditional effect of Parts 3 and 4 of that Act.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-27-2"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-27-2-ss-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-27-2-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "92cbce97d13be363c4e9c39d217a19c1471fc69b2b728e5e64f978d64bf9e030",
      "skos:note": "Section 38 of the Healthcare Identifiers Act 2010 applies in relation to an investigation."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-27-2-ss-4",
      "@type": "cof:Section",
      "cof:title": "27(4) Functions of the Commissioner",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(4) Section 38 of the Healthcare Identifiers Act 2010, rather than\nsection 12B of this Act, applies in relation to an investigation of an\nact or practice referred to in subsection 29(1) of that Act in the\nsame way as it applies to Parts 3 and 4 of that Act.\nNote:\nSection 38 of the Healthcare Identifiers Act 2010 deals with the\nadditional effect of Parts 3 and 4 of that Act."
    },
