      },
      "cml:premiseText": "APP entity must take such steps as are reasonable in the circumstances.",
      "cml:conclusionText": "to comply with Australian Privacy Principles."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 3 An APP entity must have a clearly expressed and up-to-date policy",
      "cml:realizedBy": {
