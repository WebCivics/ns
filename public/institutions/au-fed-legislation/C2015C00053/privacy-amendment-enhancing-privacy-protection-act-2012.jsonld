      "skos:note": "Application to original credit provider is taken as made to acquirer."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6k-ss-3",
      "@type": "cof:Section",
