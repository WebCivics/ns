    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "21D(7) Disclosure of credit information to a credit reporting body",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21d-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.111",
      "values:originalText": "(7) If a credit provider is an APP entity, Australian Privacy Principles\n6 and 8 do not apply to the disclosure by the provider of credit\ninformation to a credit reporting body.",
      "skos:definition": "(7) If a credit provider is an APP entity, Australian Privacy Principles\n6 and 8 do not apply to the disclosure by the provider of credit\ninformation to a credit reporting body.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-7-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6315a612e462a131368046883d0869da9ea6ff18de2f33bbfc1bfcc07956d105",
      "skos:note": "Exemption from Australian Privacy Principles for APP entities"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21d-ss-7",
      "@type": "cof:Section",
      "cof:title": "21D(7) Disclosure of credit information to a credit reporting body",
      "values:kind": "subsection",
      "cof:pageNumber": 111,
      "values:originalText": "(7) If a credit provider is an APP entity, Australian Privacy Principles\n6 and 8 do not apply to the disclosure by the provider of credit\ninformation to a credit reporting body."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21d-ss-7-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
