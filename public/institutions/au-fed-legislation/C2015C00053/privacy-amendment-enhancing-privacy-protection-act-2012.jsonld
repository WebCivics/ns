    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 3 An APP entity must not collect sensitive information about an",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-3-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.34",
      "values:originalText": "individual unless:\n\n(a) the individual consents to the collection of the information\nand:\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(i) if the entity is an agency—the information is reasonably\nnecessary for, or directly related to, one or more of the\nentity’s functions or activities; or\n\n(ii) if the entity is an organisation—the information is\nreasonably necessary for one or more of the entity’s\nfunctions or activities; or\n\n(b) subclause 3.4 applies in relation to the information.",
      "skos:definition": "individual unless:\n\n(a) the individual consents to the collection of the information\nand:\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(i) if the entity is an agency—the information is reasonably\nnecessary for, or directly related to, one or more of the\nentity’s functions or activities; or\n\n(ii) if the entity is an organisation—the information is\nreasonably necessary for one or more of the entity’s\nfunctions or activities; or\n\n(b) subclause 3.4 applies in relation to the information.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-logic-cogai-4"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "c790ba545f5aaced487c3ece183676a6b910dd8a830c193fcf902469b4fb6ede",
      "skos:note": "An APP entity must not collect sensitive information about an individual unless certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-3-5",
      "@type": "cof:Section",
      "cof:title": "3 3 An APP entity must not collect sensitive information about an",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "individual unless:\n\n(a) the individual consents to the collection of the information\nand:\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(i) if the entity is an agency—the information is reasonably\nnecessary for, or directly related to, one or more of the\nentity’s functions or activities; or\n\n(ii) if the entity is an organisation—the information is\nreasonably necessary for one or more of the entity’s\nfunctions or activities; or\n\n(b) subclause 3.4 applies in relation to the information."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-norm",
