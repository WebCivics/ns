        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-17-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "40e681ec66738c292e37dd60aad3249b9d6718cdf60d64463c75b73f9ab78c10",
      "skos:note": "The Commissioner must issue rules concerning tax file number information."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-17-2",
      "@type": "cof:Section",
      "cof:title": "17 Rules relating to tax file number information",
      "values:kind": "section",
      "cof:pageNumber": 178,
      "values:originalText": "The Commissioner must, by legislative instrument, issue rules\nconcerning the collection, storage, use and security of tax file\nnumber information."
