      "@type": "cml:Concept",
      "skos:prefLabel": "26Q(2) Application for registration of CR code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26q-ss-2"
