      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The entity's functions or activities are related to the collection of sensitive information.",
      "cml:conclusionText": "There is a recurring trace between the entity's functions and the collection of sensitive information."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge representation",
      "cml:logicSummary": "Knowledge representation of APP entities",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
