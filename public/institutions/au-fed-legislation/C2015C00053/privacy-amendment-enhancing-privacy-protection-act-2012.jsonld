    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-54",
      "@type": "cml:Concept",
      "skos:prefLabel": "54 Subsection 336FD(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-54"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.224",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) For the purposes of paragraph 6.2(b) of Australian Privacy\nPrinciple 6, the disclosure by a person of personal information\nabout another person (the subject) is taken to be a disclosure that is\nauthorised by this Act if:\n\n(a) the person is disclosing a personal identifier of the subject\nand the disclosure is authorised by section 336FC; and\n\n(b) the personal information is disclosed together with the\npersonal identifier; and\n\n(c) the disclosure of the personal information is for the purpose\nmentioned in paragraph 336FC(1)(b).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) For the purposes of paragraph 6.2(b) of Australian Privacy\nPrinciple 6, the disclosure by a person of personal information\nabout another person (the subject) is taken to be a disclosure that is\nauthorised by this Act if:\n\n(a) the person is disclosing a personal identifier of the subject\nand the disclosure is authorised by section 336FC; and\n\n(b) the personal information is disclosed together with the\npersonal identifier; and\n\n(c) the disclosure of the personal information is for the purpose\nmentioned in paragraph 336FC(1)(b).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-54-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-54-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "53864ec0ae89e6bb90e025078b826c84c339489d24b5fc6c246941baf67d7eec",
      "skos:note": "Disclosure of personal information is authorized if certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-54",
      "@type": "cof:Section",
      "cof:title": "54 Subsection 336FD(1)",
      "values:kind": "section",
      "cof:pageNumber": 224,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) For the purposes of paragraph 6.2(b) of Australian Privacy\nPrinciple 6, the disclosure by a person of personal information\nabout another person (the subject) is taken to be a disclosure that is\nauthorised by this Act if:\n\n(a) the person is disclosing a personal identifier of the subject\nand the disclosure is authorised by section 336FC; and\n\n(b) the personal information is disclosed together with the\npersonal identifier; and\n\n(c) the disclosure of the personal information is for the purpose\nmentioned in paragraph 336FC(1)(b)."
    },
