    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-22c-ss-1",
      "@type": "cof:Section",
      "cof:title": "22C(1) Use or disclosure of information by mortgage insurers or trade",
      "values:kind": "subsection",
      "cof:pageNumber": 135,
      "values:originalText": "(1) If:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(a) a mortgage insurer or trade insurer holds or held personal\ninformation about an individual; and\n\n(b) the information was disclosed to the insurer by a credit\nreporting body or credit provider under Division 2 or 3 of this\nPart;\nthe insurer must not use or disclose the information, or any\npersonal information about the individual derived from that\ninformation.\nCivil penalty:\n2,000 penalty units.\nPermitted uses"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of use or disclosure.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;",
      "cml:conclusionText": "the insurer must not use or disclose the information, or any personal information about the individual derived from that information."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Temporal interval for prohibition.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;",
      "cml:conclusionText": "the prohibition applies until the information is deleted or updated."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:logicSummary": "Recurring trace for prohibition.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;",
      "cml:conclusionText": "the prohibition is recurring and applies until the information is deleted or updated."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffusion",
      "cml:logicSummary": "Diffusion of prohibition.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;",
      "cml:conclusionText": "the diffusion of the prohibition applies to all parties with access to the information."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-22c-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge Representation",
      "cml:logicSummary": "Knowledge representation for prohibition.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a mortgage insurer or trade insurer holds or held personal information about an individual; and (b) the information was disclosed to the insurer by a credit reporting body or credit provider under Division 2 or 3 of this Part;",
      "cml:conclusionText": "the knowledge representation includes the prohibition on use or disclosure."
    },
