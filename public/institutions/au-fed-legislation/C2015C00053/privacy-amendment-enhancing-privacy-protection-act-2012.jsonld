    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-5-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Section 5",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-5-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.37",
      "values:originalText": "1 At or before the time or, if that is not practicable, as soon as\npracticable after, an APP entity collects personal information about\nan individual, the entity must take such steps (if any) as are\nreasonable in the circumstances:\n\n(a) to notify the individual of such matters referred to in\nsubclause 5.2 as are reasonable in the circumstances; or\n\n(b) to otherwise ensure that the individual is aware of any such\nmatters.",
      "skos:definition": "1 At or before the time or, if that is not practicable, as soon as\npracticable after, an APP entity collects personal information about\nan individual, the entity must take such steps (if any) as are\nreasonable in the circumstances:\n\n(a) to notify the individual of such matters referred to in\nsubclause 5.2 as are reasonable in the circumstances; or\n\n(b) to otherwise ensure that the individual is aware of any such\nmatters.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-5-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-5-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4f7ae7febafff0cc11bbd6083611cd2b179a7becad1336e891001bd328838249",
      "skos:note": "Notify individual of personal information collected",
      "dc:description": "Notification or awareness"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-5-3",
      "@type": "cof:Section",
      "cof:title": "5 Section 5",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "1 At or before the time or, if that is not practicable, as soon as\npracticable after, an APP entity collects personal information about\nan individual, the entity must take such steps (if any) as are\nreasonable in the circumstances:\n\n(a) to notify the individual of such matters referred to in\nsubclause 5.2 as are reasonable in the circumstances; or\n\n(b) to otherwise ensure that the individual is aware of any such\nmatters."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-5-3-norm",
      "@type": "values:Obligation",
