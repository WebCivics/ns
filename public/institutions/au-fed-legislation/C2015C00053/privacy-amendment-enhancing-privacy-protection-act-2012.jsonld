      "@type": "cml:Concept",
      "skos:prefLabel": "7 1 If an organisation holds personal information about an individual,",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-7-3"
