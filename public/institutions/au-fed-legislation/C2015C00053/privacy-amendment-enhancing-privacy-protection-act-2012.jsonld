        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Code is a subclass of CR code.",
      "cml:conclusionText": "Breach of CR code implies act or practice."
    },
