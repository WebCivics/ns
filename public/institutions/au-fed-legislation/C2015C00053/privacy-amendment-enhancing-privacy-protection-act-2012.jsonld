      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.57",
      "values:originalText": "Insert:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\ncredit reporting body means:\n\n(a) an organisation; or\n\n(b) an agency prescribed by the regulations;\nthat carries on a credit reporting business.",
      "skos:definition": "Insert:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\ncredit reporting body means:\n\n(a) an organisation; or\n\n(b) an agency prescribed by the regulations;\nthat carries on a credit reporting business.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-26-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-26-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-26-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-26-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "d822e747b9846dc469a6d63f3fdc02ad9f4984307fbec97b292ddd753df272e9",
      "skos:note": "Definition of credit reporting body"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "Insert:\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\ncredit reporting body means:\n\n(a) an organisation; or\n\n(b) an agency prescribed by the regulations;\nthat carries on a credit reporting business."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-26-norm",
