    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20a",
      "@type": "cml:Concept",
      "skos:prefLabel": "20A Application of this Division and the Australian Privacy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20a"
      },
      "cml:curationStatus": {
