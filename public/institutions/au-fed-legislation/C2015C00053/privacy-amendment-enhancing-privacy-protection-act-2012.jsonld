        }
      ],
      "cml:integrityHash": "ce1143144281a87846a60b640f0e91d73681983926260604deee2e40cbd9c6f7",
      "skos:note": "Credit provider cannot charge for making request or correcting information."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21u-ss-5",
      "@type": "cof:Section",
      "cof:title": "21U(5) Correction of credit information or credit eligibility",
      "values:kind": "subsection",
      "cof:pageNumber": 129,
      "values:originalText": "(5) The credit provider must not charge the individual for the making\nof the request or for correcting the information.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nInteraction with the Australian Privacy Principles"
    },
    {
