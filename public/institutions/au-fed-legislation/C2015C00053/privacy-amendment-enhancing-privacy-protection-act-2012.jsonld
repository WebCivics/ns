        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.157",
      "values:originalText": "(3) If the Commissioner decides not to register an APP code developed\nby an APP code developer, the Commissioner must give written\nnotice of the decision to the developer, including reasons for the\ndecision.\nSubdivision C—Variation and removal of registered APP codes",
      "skos:definition": "(3) If the Commissioner decides not to register an APP code developed\nby an APP code developer, the Commissioner must give written\nnotice of the decision to the developer, including reasons for the\ndecision.\nSubdivision C—Variation and removal of registered APP codes",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26h"
      },
      "cml:asserts": [
