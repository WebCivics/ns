      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-63",
      "@type": "cml:Concept",
      "skos:prefLabel": "63 Subsection 6(1) (definition of serious credit infringement)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-63"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.65",
      "values:originalText": "Repeal the definition, substitute:\nserious credit infringement means:\n\n(a) an act done by an individual that involves fraudulently\nobtaining consumer credit, or attempting fraudulently to\nobtain consumer credit; or\n\n(b) an act done by an individual that involves fraudulently\nevading the individual’s obligations in relation to consumer\ncredit, or attempting fraudulently to evade those obligations;\nor\n\n(c) an act done by an individual if:\n\n(i) a reasonable person would consider that the act\nindicates an intention, on the part of the individual, to\nno longer comply with the individual’s obligations in\nrelation to consumer credit provided by a credit\nprovider; and\n\n(ii) the provider has, after taking such steps as are\nreasonable in the circumstances, been unable to contact\nthe individual about the act; and\n\n(iii) at least 6 months have passed since the provider last had\ncontact with the individual.",
      "skos:definition": "Repeal the definition, substitute:\nserious credit infringement means:\n\n(a) an act done by an individual that involves fraudulently\nobtaining consumer credit, or attempting fraudulently to\nobtain consumer credit; or\n\n(b) an act done by an individual that involves fraudulently\nevading the individual’s obligations in relation to consumer\ncredit, or attempting fraudulently to evade those obligations;\nor\n\n(c) an act done by an individual if:\n\n(i) a reasonable person would consider that the act\nindicates an intention, on the part of the individual, to\nno longer comply with the individual’s obligations in\nrelation to consumer credit provided by a credit\nprovider; and\n\n(ii) the provider has, after taking such steps as are\nreasonable in the circumstances, been unable to contact\nthe individual about the act; and\n\n(iii) at least 6 months have passed since the provider last had\ncontact with the individual.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-63-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-63-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-63-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "d58323c5e68401e9426ef3816c77f98c96a523da2a02438fe0b2288f83bb0005",
      "skos:note": "Definition of serious credit infringement"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-63",
      "@type": "cof:Section",
      "cof:title": "63 Subsection 6(1) (definition of serious credit infringement)",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "Repeal the definition, substitute:\nserious credit infringement means:\n\n(a) an act done by an individual that involves fraudulently\nobtaining consumer credit, or attempting fraudulently to\nobtain consumer credit; or\n\n(b) an act done by an individual that involves fraudulently\nevading the individual’s obligations in relation to consumer\ncredit, or attempting fraudulently to evade those obligations;\nor\n\n(c) an act done by an individual if:\n\n(i) a reasonable person would consider that the act\nindicates an intention, on the part of the individual, to\nno longer comply with the individual’s obligations in\nrelation to consumer credit provided by a credit\nprovider; and\n\n(ii) the provider has, after taking such steps as are\nreasonable in the circumstances, been unable to contact\nthe individual about the act; and\n\n(iii) at least 6 months have passed since the provider last had\ncontact with the individual."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-63-norm",
