    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-25a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "25A(3) Other orders to compensate loss or damage",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-25a-ss-3"
      },
