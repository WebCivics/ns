      },
      "cml:premiseText": "The substitution occurs at the specified time",
      "cml:conclusionText": "The new phrase applies from the start of the agency's operation to its closure"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-134-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
