      "@type": "cml:Concept",
      "skos:prefLabel": "22 Subsection 6(1) (definition of generally available",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-22"
      },
      "cml:curationStatus": {
