    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Saving—guidelines relating to tax file number information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.248",
      "values:originalText": "(1)\nThis item applies to guidelines if:\n\n(a) the guidelines were issued under subsection 17(1) of the\nPrivacy Act; and\n\n(b) the guidelines were in force immediately before the\ncommencement time.\n(2)\nThe guidelines have effect, after that time, as if they had been rules\nissued under section 17 of that Act, as inserted by Schedule 4 to this\nAct.",
      "skos:definition": "(1)\nThis item applies to guidelines if:\n\n(a) the guidelines were issued under subsection 17(1) of the\nPrivacy Act; and\n\n(b) the guidelines were in force immediately before the\ncommencement time.\n(2)\nThe guidelines have effect, after that time, as if they had been rules\nissued under section 17 of that Act, as inserted by Schedule 4 to this\nAct.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-7-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-7-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-7-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "8ce9413be2aa35c007c736c9db0c8633f9c742df1001285be6ca5e9fe50cbcd8",
      "skos:note": "Guidelines have effect after commencement time as if they had been rules issued under section 17 of the Privacy Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Saving—guidelines relating to tax file number information",
      "values:kind": "section",
      "cof:pageNumber": 248,
      "values:originalText": "(1)\nThis item applies to guidelines if:\n\n(a) the guidelines were issued under subsection 17(1) of the\nPrivacy Act; and\n\n(b) the guidelines were in force immediately before the\ncommencement time.\n(2)\nThe guidelines have effect, after that time, as if they had been rules\nissued under section 17 of that Act, as inserted by Schedule 4 to this\nAct."
    },
