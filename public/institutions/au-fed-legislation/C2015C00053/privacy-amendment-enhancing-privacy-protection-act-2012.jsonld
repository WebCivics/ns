    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "23C(5) Notification requirements relating to correction complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23c-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.143",
      "values:originalText": "(5) If:\n\n(a) a credit provider discloses personal information to which the\ncomplaint relates under Division 3 of this Part or under the\nAustralian Privacy Principles; and\n\n(b) at the time of the disclosure, a decision about the complaint\nunder subsection 23B(4) has not been made;\nthe provider must, at that time, notify in writing the recipient of the\ninformation of the complaint.\nExceptions",
      "skos:definition": "(5) If:\n\n(a) a credit provider discloses personal information to which the\ncomplaint relates under Division 3 of this Part or under the\nAustralian Privacy Principles; and\n\n(b) at the time of the disclosure, a decision about the complaint\nunder subsection 23B(4) has not been made;\nthe provider must, at that time, notify in writing the recipient of the\ninformation of the complaint.\nExceptions",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c"
      },
      "cml:asserts": [
        {
