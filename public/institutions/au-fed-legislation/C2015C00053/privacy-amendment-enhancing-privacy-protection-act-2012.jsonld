    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 4 The APP entity must:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-6"
      },
      "cml:curationStatus": {
