    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21w-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "21W(5) Notice of correction etc. must be given",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21w-ss-5"
      },
