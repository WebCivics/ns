        }
      ],
      "cml:integrityHash": "f695603cc97e9a143bc609b6e2587fd22a99e8c471c8d0394fd26302cf6f6f87",
      "skos:note": "Permitted CP disclosures between credit providers Consent must be given in writing unless application was not made in writing.",
      "dc:description": "writing"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21j-ss-4",
