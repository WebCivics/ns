    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21j-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "21J(5) Permitted CP disclosures between credit providers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21j-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.118",
      "values:originalText": "(5) A disclosure by a credit provider of credit eligibility information\nabout an individual is a permitted CP disclosure in relation to the\nindividual if:\n\n(a) the disclosure is to another credit provider that has an\nAustralian link; and\n\n(b) both credit providers have provided mortgage credit to the\nindividual in relation to which the same real property forms\nall or part of the security; and\n\n(c) the individual is at least 60 days overdue in making a\npayment in relation to the mortgage credit provided by either\nprovider; and\n\n(d) the information is disclosed for the purpose of either provider\ndeciding what action to take in relation to the overdue\npayment.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n21K  Permitted CP disclosures relating to guarantees etc.\nOffer to act as a guarantor etc.",
      "skos:definition": "(5) A disclosure by a credit provider of credit eligibility information\nabout an individual is a permitted CP disclosure in relation to the\nindividual if:\n\n(a) the disclosure is to another credit provider that has an\nAustralian link; and\n\n(b) both credit providers have provided mortgage credit to the\nindividual in relation to which the same real property forms\nall or part of the security; and\n\n(c) the individual is at least 60 days overdue in making a\npayment in relation to the mortgage credit provided by either\nprovider; and\n\n(d) the information is disclosed for the purpose of either provider\ndeciding what action to take in relation to the overdue\npayment.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n21K  Permitted CP disclosures relating to guarantees etc.\nOffer to act as a guarantor etc.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21j"
      },
      "cml:asserts": [
