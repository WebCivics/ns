      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The individual must consent to the collection of the information before it can be collected.",
      "cml:conclusionText": "There is a temporal relation between the collection of the information and the individual's consent."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-logic-ltl-3",
