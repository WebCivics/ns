      },
      "cml:premiseText": "The credit reporting body must not use or disclose the information under Subdivision D of this Division.",
      "cml:conclusionText": "The prohibition is diffused to other entities that are related to the credit reporting body."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20z-ss-3-logic-cogai-4",
