    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21g-ss-6",
      "@type": "cof:Section",
      "cof:title": "21G(6) Use or disclosure of credit eligibility information",
      "values:kind": "subsection",
      "cof:pageNumber": 114,
      "values:originalText": "(6) If a credit provider uses or discloses credit eligibility information\nunder this section, the provider must make a written note of that\nuse or disclosure.\nCivil penalty:\n500 penalty units.\nInteraction with the Australian Privacy Principles"
    },
