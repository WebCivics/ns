      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.62",
      "values:originalText": "Insert:\npending dispute in relation to credit information or CRB derived\ninformation means:\n\n(a) a complaint made under section 23A that relates to the\ninformation if a decision about the complaint has not been\nmade under subsection 23B(4); or\n\n(b) a matter that relates to the information and that is still being\ndealt with by a recognised external dispute resolution\nscheme; or\n\n(c) a complaint made to the Commissioner under Part V that\nrelates to the information and that is still being dealt with.",
      "skos:definition": "Insert:\npending dispute in relation to credit information or CRB derived\ninformation means:\n\n(a) a complaint made under section 23A that relates to the\ninformation if a decision about the complaint has not been\nmade under subsection 23B(4); or\n\n(b) a matter that relates to the information and that is still being\ndealt with by a recognised external dispute resolution\nscheme; or\n\n(c) a complaint made to the Commissioner under Part V that\nrelates to the information and that is still being dealt with.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-48-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-48-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-48-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-48-logic-alleninterval-3"
        }
      ],
      "cml:integrityHash": "934d88fe21ad1045c4eb72bced3e63bdff6b118767657610748a380841f229d1",
      "skos:note": "Definition of 'pending dispute in relation to credit information or CRB derived information'"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-48",
      "@type": "cof:Section",
      "cof:title": "48 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "Insert:\npending dispute in relation to credit information or CRB derived\ninformation means:\n\n(a) a complaint made under section 23A that relates to the\ninformation if a decision about the complaint has not been\nmade under subsection 23B(4); or\n\n(b) a matter that relates to the information and that is still being\ndealt with by a recognised external dispute resolution\nscheme; or\n\n(c) a complaint made to the Commissioner under Part V that\nrelates to the information and that is still being dealt with."
    },
