        }
      ],
      "cml:integrityHash": "93a10dde99304109aeb3474f508e546672268978264bada569a93180ec8b29e8",
      "skos:note": "Must provide a copy of the APP privacy policy in a particular form upon request.",
      "dc:description": "true"
    },
