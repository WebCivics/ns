      "skos:prefLabel": "80X Civil enforcement of penalty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.208",
      "values:originalText": "(1) A pecuniary penalty is a debt payable to the Commonwealth.\n\n(2) The Commonwealth may enforce a civil penalty order as if it were\nan order made in civil proceedings against the entity to recover a\ndebt due by the entity. The debt arising from the order is taken to\nbe a judgement debt.\nComLaw Authoritative Act C2015C00053\n\nOther amendments of the Privacy Act 1988  Schedule 4\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "(1) A pecuniary penalty is a debt payable to the Commonwealth.\n\n(2) The Commonwealth may enforce a civil penalty order as if it were\nan order made in civil proceedings against the entity to recover a\ndebt due by the entity. The debt arising from the order is taken to\nbe a judgement debt.\nComLaw Authoritative Act C2015C00053\n\nOther amendments of the Privacy Act 1988  Schedule 4\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
