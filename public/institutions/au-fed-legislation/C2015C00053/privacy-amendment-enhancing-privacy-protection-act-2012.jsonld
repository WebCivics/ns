      "skos:note": "Exemption from subsection (4) for certain recipients and disclosures"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21g-ss-5",
