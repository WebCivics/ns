    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "20Y(4) Destruction of credit reporting information in cases of fraud",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20y-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.103",
      "values:originalText": "(4) If:\n\n(a) a credit reporting body destroys credit reporting information\nabout an individual under subsection (2); and\n\n(b) the body has previously disclosed the information to one or\nmore recipients under Subdivision D of this Division;\nthe body must, within a reasonable period after the destruction,\nnotify those recipients of the destruction and the matters referred to\nin paragraph (1)(c).\nCivil penalty:\n500 penalty units.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "(4) If:\n\n(a) a credit reporting body destroys credit reporting information\nabout an individual under subsection (2); and\n\n(b) the body has previously disclosed the information to one or\nmore recipients under Subdivision D of this Division;\nthe body must, within a reasonable period after the destruction,\nnotify those recipients of the destruction and the matters referred to\nin paragraph (1)(c).\nCivil penalty:\n500 penalty units.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y-ss-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3faf9f8d12f048b3f7169b19bad29aea524e702107fd4f75bf43c55643ca9fc4",
      "skos:note": "Notify recipients of destruction of credit reporting information",
      "dc:description": "Notification to recipients"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20y-ss-4",
      "@type": "cof:Section",
      "cof:title": "20Y(4) Destruction of credit reporting information in cases of fraud",
      "values:kind": "subsection",
      "cof:pageNumber": 103,
      "values:originalText": "(4) If:\n\n(a) a credit reporting body destroys credit reporting information\nabout an individual under subsection (2); and\n\n(b) the body has previously disclosed the information to one or\nmore recipients under Subdivision D of this Division;\nthe body must, within a reasonable period after the destruction,\nnotify those recipients of the destruction and the matters referred to\nin paragraph (1)(c).\nCivil penalty:\n500 penalty units.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15"
    },
    {
