    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 5 Despite subclause 7.1, an organisation may use or disclose",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-7-7"
