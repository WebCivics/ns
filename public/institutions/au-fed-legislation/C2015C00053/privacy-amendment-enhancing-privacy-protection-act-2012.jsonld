    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-11-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 2 If:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-11-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.47",
      "values:originalText": "(a) an APP entity holds personal information about an\nindividual; and\n\n(b) the entity no longer needs the information for any purpose for\nwhich the information may be used or disclosed by the entity\nunder this Schedule; and\n\n(c) the information is not contained in a Commonwealth record;\nand\n\n(d) the entity is not required by or under an Australian law, or a\ncourt/tribunal order, to retain the information;\nthe entity must take such steps as are reasonable in the\ncircumstances to destroy the information or to ensure that the\ninformation is de-identified.",
      "skos:definition": "(a) an APP entity holds personal information about an\nindividual; and\n\n(b) the entity no longer needs the information for any purpose for\nwhich the information may be used or disclosed by the entity\nunder this Schedule; and\n\n(c) the information is not contained in a Commonwealth record;\nand\n\n(d) the entity is not required by or under an Australian law, or a\ncourt/tribunal order, to retain the information;\nthe entity must take such steps as are reasonable in the\ncircumstances to destroy the information or to ensure that the\ninformation is de-identified.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-11-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-11-4-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-11-4-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-11-4-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "9ed9306c5b8e45f18916650a3344413b3faed2947e714a3771ae2147b36e1164",
      "skos:note": "Destroy personal information when no longer needed"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-11-4",
      "@type": "cof:Section",
      "cof:title": "11 2 If:",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "(a) an APP entity holds personal information about an\nindividual; and\n\n(b) the entity no longer needs the information for any purpose for\nwhich the information may be used or disclosed by the entity\nunder this Schedule; and\n\n(c) the information is not contained in a Commonwealth record;\nand\n\n(d) the entity is not required by or under an Australian law, or a\ncourt/tribunal order, to retain the information;\nthe entity must take such steps as are reasonable in the\ncircumstances to destroy the information or to ensure that the\ninformation is de-identified."
    },
