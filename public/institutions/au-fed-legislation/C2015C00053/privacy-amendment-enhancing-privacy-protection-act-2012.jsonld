        }
      ],
      "cml:integrityHash": "a597a60b13543b7cd37f9ecb5603c374a0cfc31766a24020fb12f386ce46da72",
      "skos:note": "Commissioner may direct an agency to give a privacy impact review after five years."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-33d-ss-7",
      "@type": "cof:Section",
      "cof:title": "33D(7) Commissioner may direct an agency to give a privacy impact",
      "values:kind": "subsection",
      "cof:pageNumber": 184,
      "values:originalText": "(7) Before the fifth anniversary of the commencement of this section,\nthe Minister must cause a review to be undertaken of whether this\nsection should apply in relation to organisations."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-33d-ss-7-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
