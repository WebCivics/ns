      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.55",
      "values:originalText": "Insert:\nconsumer credit related purpose of a credit provider in relation to\nan individual means the purpose of:\n\n(a) assessing an application for consumer credit made by the\nindividual to the provider; or\n\n(b) collecting payments that are overdue in relation to consumer\ncredit provided by the provider to the individual.",
      "skos:definition": "Insert:\nconsumer credit related purpose of a credit provider in relation to\nan individual means the purpose of:\n\n(a) assessing an application for consumer credit made by the\nindividual to the provider; or\n\n(b) collecting payments that are overdue in relation to consumer\ncredit provided by the provider to the individual.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-11-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-11-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-11-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "e0e435970688be5b1edd375206de149ced10158b68f24666ade6d82cbcb23c6e",
      "skos:note": "Assessing an application for consumer credit and collecting overdue payments are obligations of a credit provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "Insert:\nconsumer credit related purpose of a credit provider in relation to\nan individual means the purpose of:\n\n(a) assessing an application for consumer credit made by the\nindividual to the provider; or\n\n(b) collecting payments that are overdue in relation to consumer\ncredit provided by the provider to the individual."
    },
