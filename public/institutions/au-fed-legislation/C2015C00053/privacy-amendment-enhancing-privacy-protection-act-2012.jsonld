          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-8-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "0108a711ce5bbf18d49adc3fa01483c633b46ea6e3130d56d0221b25163a8399",
      "skos:note": "Definition of Australian law"
    },
