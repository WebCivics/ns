    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-55-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Obligations of organisations and small business operators",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-55-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.198",
      "values:originalText": "If the determination applies in relation to an organisation or small\nbusiness operator, the organisation or operator:\n\n(a) must not repeat or continue conduct that is covered by a\ndeclaration included in the determination under\nsub-subparagraph 52(1)(b)(i)(B) or paragraph 52(1A)(a); and\n\n(b) must take the steps that are specified in a declaration\nincluded in the determination under subparagraph\n52(1)(b)(ia) or paragraph 52(1A)(b) within the specified\nperiod; and\n\n(c) must perform the act or course of conduct that is covered by\na declaration included in the determination under\nsubparagraph 52(1)(b)(ii) or paragraph 52(1A)(c).\nComLaw Authoritative Act C2015C00053\n\nOther amendments of the Privacy Act 1988  Schedule 4\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "If the determination applies in relation to an organisation or small\nbusiness operator, the organisation or operator:\n\n(a) must not repeat or continue conduct that is covered by a\ndeclaration included in the determination under\nsub-subparagraph 52(1)(b)(i)(B) or paragraph 52(1A)(a); and\n\n(b) must take the steps that are specified in a declaration\nincluded in the determination under subparagraph\n52(1)(b)(ia) or paragraph 52(1A)(b) within the specified\nperiod; and\n\n(c) must perform the act or course of conduct that is covered by\na declaration included in the determination under\nsubparagraph 52(1)(b)(ii) or paragraph 52(1A)(c).\nComLaw Authoritative Act C2015C00053\n\nOther amendments of the Privacy Act 1988  Schedule 4\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-55-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-55-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e167802089d0c2cba53774f844304315624cfca2abefbe033e0265a45047b55d",
      "skos:note": "Must not repeat or continue conduct covered by a declaration included in the determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-55-2",
      "@type": "cof:Section",
      "cof:title": "55 Obligations of organisations and small business operators",
      "values:kind": "section",
      "cof:pageNumber": 198,
      "values:originalText": "If the determination applies in relation to an organisation or small\nbusiness operator, the organisation or operator:\n\n(a) must not repeat or continue conduct that is covered by a\ndeclaration included in the determination under\nsub-subparagraph 52(1)(b)(i)(B) or paragraph 52(1A)(a); and\n\n(b) must take the steps that are specified in a declaration\nincluded in the determination under subparagraph\n52(1)(b)(ia) or paragraph 52(1A)(b) within the specified\nperiod; and\n\n(c) must perform the act or course of conduct that is covered by\na declaration included in the determination under\nsubparagraph 52(1)(b)(ii) or paragraph 52(1A)(c).\nComLaw Authoritative Act C2015C00053\n\nOther amendments of the Privacy Act 1988  Schedule 4\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15"
    },
    {
