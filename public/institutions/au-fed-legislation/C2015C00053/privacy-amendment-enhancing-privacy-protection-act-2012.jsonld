      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Member takes all reasonable steps to correct contravention",
      "cml:conclusionText": "No offence against Act"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98b-ss-4-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "ignorance",
      "cml:logicSummary": "Ignorance is not a defence",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Member does not know of circumstances",
      "cml:conclusionText": "No excuse for contravention"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98b-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
