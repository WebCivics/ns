    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6j-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "6J(4) Securitisation arrangements etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6j-ss-4"
      },
