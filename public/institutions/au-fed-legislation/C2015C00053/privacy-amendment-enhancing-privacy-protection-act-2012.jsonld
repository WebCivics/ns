      "cml:integrityHash": "3b82a72fb8ce1a135a1fdaff9948971254481d818a5b1629aaaff1f332212dfe",
      "skos:note": "Proceedings dismissed if entity is not convicted of the offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80ze-ss-2",
      "@type": "cof:Section",
      "cof:title": "80ZE(2) Criminal proceedings during civil proceedings",
      "values:kind": "subsection",
      "cof:pageNumber": 210,
      "values:originalText": "(2) The proceedings for the civil penalty order may be resumed if the\nentity is not convicted of the offence. Otherwise:\n\n(a) the proceedings are dismissed; and\n\n(b) costs must not be awarded in relation to the proceedings."
    },
