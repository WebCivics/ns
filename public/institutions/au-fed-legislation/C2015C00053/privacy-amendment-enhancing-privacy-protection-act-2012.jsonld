        }
      ],
      "cml:integrityHash": "0398f40a6ae26a9da61820822b47eedb312376d212a0cc97f858d3197a407212",
      "skos:note": "Section applies after commencement time"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Application—section 13G of the Privacy Act",
      "values:kind": "section",
      "cof:pageNumber": 248,
      "values:originalText": "Section 13G of the Privacy Act, as inserted by Schedule 4 to this Act,\napplies in relation to an act done, or a practice engaged in, after the\ncommencement time."
    },
