      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21j-ss-3-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21j-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21j-ss-3-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "b149a4545c42c57f595a96e4e328b86e2f40335a0a6c0028754cfda6832df652",
      "skos:note": "Disclosure of credit eligibility information is permitted to certain individuals under specific conditions. Permitted CP disclosures between credit providers"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21j-ss-3",
      "@type": "cof:Section",
      "cof:title": "21J(3) Permitted CP disclosures between credit providers",
      "values:kind": "subsection",
      "cof:pageNumber": 118,
      "values:originalText": "(3) A disclosure by a credit provider of credit eligibility information\nabout an individual is a permitted CP disclosure in relation to the\nindividual if:\n\n(a) the provider is acting as an agent of another credit provider\nthat has an Australian link; and\n\n(b) while the provider is so acting, the provider is a credit\nprovider under subsection 6H(1); and\n\n(c) the provider discloses the information to the other credit\nprovider in the provider’s capacity as such an agent.\nSecuritisation arrangements etc."
    },
