      "@type": "cml:Concept",
      "skos:prefLabel": "12 5 If the APP entity refuses:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-7"
