    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-3-2"
      },
