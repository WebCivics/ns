    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 4 Without limiting subclause 1.3, the APP privacy policy of the APP",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-1-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.33",
      "values:originalText": "entity must contain the following information:\n\n(a) the kinds of personal information that the entity collects and\nholds;\n\n(b) how the entity collects and holds personal information;\n\n(c) the purposes for which the entity collects, holds, uses and\ndiscloses personal information;\n\n(d) how an individual may access personal information about the\nindividual that is held by the entity and seek the correction of\nsuch information;\n\n(e) how an individual may complain about a breach of the\nAustralian Privacy Principles, or a registered APP code (if\nany) that binds the entity, and how the entity will deal with\nsuch a complaint;\n\n(f) whether the entity is likely to disclose personal information\nto overseas recipients;\n\n(g) if the entity is likely to disclose personal information to\noverseas recipients—the countries in which such recipients\nare likely to be located if it is practicable to specify those\ncountries in the policy.\nAvailability of APP privacy policy etc.",
      "skos:definition": "entity must contain the following information:\n\n(a) the kinds of personal information that the entity collects and\nholds;\n\n(b) how the entity collects and holds personal information;\n\n(c) the purposes for which the entity collects, holds, uses and\ndiscloses personal information;\n\n(d) how an individual may access personal information about the\nindividual that is held by the entity and seek the correction of\nsuch information;\n\n(e) how an individual may complain about a breach of the\nAustralian Privacy Principles, or a registered APP code (if\nany) that binds the entity, and how the entity will deal with\nsuch a complaint;\n\n(f) whether the entity is likely to disclose personal information\nto overseas recipients;\n\n(g) if the entity is likely to disclose personal information to\noverseas recipients—the countries in which such recipients\nare likely to be located if it is practicable to specify those\ncountries in the policy.\nAvailability of APP privacy policy etc.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-6-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-1-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d260da7aea77762519797a460cc4c1a7fc2cbe95867043733bd2845f7d187dce",
      "skos:note": "Entity must provide certain information about personal data collection and use.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-1-6",
      "@type": "cof:Section",
      "cof:title": "1 4 Without limiting subclause 1.3, the APP privacy policy of the APP",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "entity must contain the following information:\n\n(a) the kinds of personal information that the entity collects and\nholds;\n\n(b) how the entity collects and holds personal information;\n\n(c) the purposes for which the entity collects, holds, uses and\ndiscloses personal information;\n\n(d) how an individual may access personal information about the\nindividual that is held by the entity and seek the correction of\nsuch information;\n\n(e) how an individual may complain about a breach of the\nAustralian Privacy Principles, or a registered APP code (if\nany) that binds the entity, and how the entity will deal with\nsuch a complaint;\n\n(f) whether the entity is likely to disclose personal information\nto overseas recipients;\n\n(g) if the entity is likely to disclose personal information to\noverseas recipients—the countries in which such recipients\nare likely to be located if it is practicable to specify those\ncountries in the policy.\nAvailability of APP privacy policy etc."
    },
