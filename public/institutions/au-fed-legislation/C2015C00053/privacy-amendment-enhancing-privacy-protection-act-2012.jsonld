        }
      ],
      "cml:integrityHash": "1ca046e43006c6ca3543dbd5fc2229f052c57f77c5f1de23d534388ced817a97",
      "skos:note": "Consent for credit applications must be given in writing under certain conditions. Consent must be given in writing for certain disclosures.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21j-ss-2",
      "@type": "cof:Section",
      "cof:title": "21J(2) Permitted CP disclosures between credit providers",
      "values:kind": "subsection",
      "cof:pageNumber": 118,
      "values:originalText": "(2) The consent of the individual under paragraph (1)(d) must be given\nin writing unless:\n\n(a) if subparagraph (1)(a)(i) applies—the application for the\ncredit was not made in writing; or\n\n(b) if subparagraph (1)(a)(ii) applies—the application for the\ncredit has not been made in writing.\nGuarantors etc."
    },
