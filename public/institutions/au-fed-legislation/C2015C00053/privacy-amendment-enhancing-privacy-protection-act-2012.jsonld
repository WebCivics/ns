    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-58-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "58 Obligations of agencies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-58-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.200",
      "values:originalText": "If this Division applies to a determination and the determination\napplies in relation to an agency, the agency:\n\n(a) must not repeat or continue conduct that is covered by a\ndeclaration included in the determination under subparagraph\n52(1)(b)(i) or paragraph 52(1A)(a); and\n\n(b) must take the steps that are specified in a declaration\nincluded in the determination under subparagraph\n52(1)(b)(ia) or paragraph 52(1A)(b) within the specified\nperiod; and\n\n(c) must perform the act or course of conduct that is covered by\na declaration included in the determination under\nsubparagraph 52(1)(b)(ii) or paragraph 52(1A)(c).",
      "skos:definition": "If this Division applies to a determination and the determination\napplies in relation to an agency, the agency:\n\n(a) must not repeat or continue conduct that is covered by a\ndeclaration included in the determination under subparagraph\n52(1)(b)(i) or paragraph 52(1A)(a); and\n\n(b) must take the steps that are specified in a declaration\nincluded in the determination under subparagraph\n52(1)(b)(ia) or paragraph 52(1A)(b) within the specified\nperiod; and\n\n(c) must perform the act or course of conduct that is covered by\na declaration included in the determination under\nsubparagraph 52(1)(b)(ii) or paragraph 52(1A)(c).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-58-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-58-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b5fedcf61a9d807023e3dbeb84f5ae3b070b28966e444b58e57806f3f46d4bd9",
      "skos:note": "Agency must not repeat or continue conduct covered by a declaration included in the determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-58-2",
      "@type": "cof:Section",
      "cof:title": "58 Obligations of agencies",
      "values:kind": "section",
      "cof:pageNumber": 200,
      "values:originalText": "If this Division applies to a determination and the determination\napplies in relation to an agency, the agency:\n\n(a) must not repeat or continue conduct that is covered by a\ndeclaration included in the determination under subparagraph\n52(1)(b)(i) or paragraph 52(1A)(a); and\n\n(b) must take the steps that are specified in a declaration\nincluded in the determination under subparagraph\n52(1)(b)(ia) or paragraph 52(1A)(b) within the specified\nperiod; and\n\n(c) must perform the act or course of conduct that is covered by\na declaration included in the determination under\nsubparagraph 52(1)(b)(ii) or paragraph 52(1A)(c)."
    },
