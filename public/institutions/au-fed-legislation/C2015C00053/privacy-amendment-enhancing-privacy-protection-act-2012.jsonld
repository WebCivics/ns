    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-76",
      "@type": "cml:Concept",
      "skos:prefLabel": "76 Add at the end of subsection 38B(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-76"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.190",
      "values:originalText": "Add:\nNote:\nIf a class member withdraws from a representative complaint that\nrelates to a matter, the former member may make a complaint under\nsection 36 that relates to the matter.",
      "skos:definition": "Add:\nNote:\nIf a class member withdraws from a representative complaint that\nrelates to a matter, the former member may make a complaint under\nsection 36 that relates to the matter.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-76-norm"
        }
      ],
      "cml:integrityHash": "6ef6777b9eafd6483335a7667145ece8eeff181227208165b2b5f3b146a8c0a0",
      "skos:note": "Member may make complaint under section 36 if withdrawn from representative complaint."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-76",
      "@type": "cof:Section",
      "cof:title": "76 Add at the end of subsection 38B(2)",
      "values:kind": "section",
      "cof:pageNumber": 190,
      "values:originalText": "Add:\nNote:\nIf a class member withdraws from a representative complaint that\nrelates to a matter, the former member may make a complaint under\nsection 36 that relates to the matter."
    },
