    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "20R(6) Access to credit reporting information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20r-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.94",
      "values:originalText": "(6) If subsection (5) does not apply, any charge by the credit reporting\nbody for giving access to the information must not be excessive\nand must not apply to the making of the request.\nRefusal to give access",
      "skos:definition": "(6) If subsection (5) does not apply, any charge by the credit reporting\nbody for giving access to the information must not be excessive\nand must not apply to the making of the request.\nRefusal to give access",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20r"
      },
      "cml:asserts": [
