    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20s-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "20S(1) Correction of credit reporting information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20s-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.96",
      "values:originalText": "(1) An individual may request a credit reporting body to correct\npersonal information about the individual if:\n\n(a) the personal information is:\n\n(i) credit information about the individual; or\n\n(ii) CRB derived information about the individual; or\n\n(iii) CP derived information about the individual; and\n\n(b) the body holds at least one kind of the personal information\nreferred to in paragraph (a).\nCorrection",
      "skos:definition": "(1) An individual may request a credit reporting body to correct\npersonal information about the individual if:\n\n(a) the personal information is:\n\n(i) credit information about the individual; or\n\n(ii) CRB derived information about the individual; or\n\n(iii) CP derived information about the individual; and\n\n(b) the body holds at least one kind of the personal information\nreferred to in paragraph (a).\nCorrection",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20s"
      },
      "cml:asserts": [
        {
