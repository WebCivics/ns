    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Guide to this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.140",
      "values:originalText": "This Division deals with complaints about credit reporting bodies\nor credit providers.\nIndividuals may complain to credit reporting bodies or credit\nproviders about acts or practices that may be a breach of certain\nprovisions of this Part or the registered CR code.\nIf a complaint is made, the respondent for the complaint must\ninvestigate the complaint and make a decision about the complaint.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "This Division deals with complaints about credit reporting bodies\nor credit providers.\nIndividuals may complain to credit reporting bodies or credit\nproviders about acts or practices that may be a breach of certain\nprovisions of this Part or the registered CR code.\nIf a complaint is made, the respondent for the complaint must\ninvestigate the complaint and make a decision about the complaint.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c8859e1894df7885ec9e0b97a9123f202a4b03cb3124cee4f96d474950de12b5",
      "skos:note": "Individuals may complain to credit reporting bodies or credit providers about acts or practices that may be a breach of certain provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23-2",
      "@type": "cof:Section",
      "cof:title": "23 Guide to this Division",
      "values:kind": "section",
      "cof:pageNumber": 140,
      "values:originalText": "This Division deals with complaints about credit reporting bodies\nor credit providers.\nIndividuals may complain to credit reporting bodies or credit\nproviders about acts or practices that may be a breach of certain\nprovisions of this Part or the registered CR code.\nIf a complaint is made, the respondent for the complaint must\ninvestigate the complaint and make a decision about the complaint.\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15"
    },
