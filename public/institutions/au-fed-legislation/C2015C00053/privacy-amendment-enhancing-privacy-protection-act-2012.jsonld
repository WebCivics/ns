      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.40",
      "values:originalText": "7 This principle does not apply to the use or disclosure by an\norganisation of:\n\n(a) personal information for the purpose of direct marketing; or\n\n(b) government related identifiers.\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "skos:definition": "7 This principle does not apply to the use or disclosure by an\norganisation of:\n\n(a) personal information for the purpose of direct marketing; or\n\n(b) government related identifiers.\nComLaw Authoritative Act C2015C00053\n\nAustralian Privacy Principles  Schedule 1\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-9-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8f360b43b909f9aa603f0ba1953bd372cb2722c4298710900bf8c513bcbad024",
      "skos:note": "Exemptions from data protection for direct marketing and government-related identifiers."
    },
    {
