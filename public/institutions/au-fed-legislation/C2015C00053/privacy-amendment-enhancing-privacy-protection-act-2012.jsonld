          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-22-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-22-logic-descriptionlogic-2"
        }
