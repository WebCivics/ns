      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-6ba",
      "@type": "cml:Concept",
      "skos:prefLabel": "6BA Breach of the registered CR code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-6ba"
      },
      "cml:curationStatus": {
