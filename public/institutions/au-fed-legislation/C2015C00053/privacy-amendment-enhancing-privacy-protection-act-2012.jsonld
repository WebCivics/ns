    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6t",
      "@type": "cml:Concept",
      "skos:prefLabel": "6T Meaning of payment information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6t"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.76",
      "values:originalText": "If:\n\n(a) a credit provider has disclosed default information about an\nindividual to a credit reporting body; and\n\n(b) on a day after the default information was disclosed, the\namount of the overdue payment to which the information\nrelates is paid;\nthen payment information about the individual is a statement that\nthe amount of the overdue payment has been paid on that day.",
      "skos:definition": "If:\n\n(a) a credit provider has disclosed default information about an\nindividual to a credit reporting body; and\n\n(b) on a day after the default information was disclosed, the\namount of the overdue payment to which the information\nrelates is paid;\nthen payment information about the individual is a statement that\nthe amount of the overdue payment has been paid on that day.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6t-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6t-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6t-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "743361bd1d93d3c2afcf510bcf008469d798faf489d8350b415d14e327a857f6",
      "skos:note": "Payment information is a statement that the amount of overdue payment has been paid."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6t",
      "@type": "cof:Section",
      "cof:title": "6T Meaning of payment information",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "If:\n\n(a) a credit provider has disclosed default information about an\nindividual to a credit reporting body; and\n\n(b) on a day after the default information was disclosed, the\namount of the overdue payment to which the information\nrelates is paid;\nthen payment information about the individual is a statement that\nthe amount of the overdue payment has been paid on that day."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6t-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6t"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6t-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Conditional obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a credit provider has disclosed default information about an individual to a credit reporting body; and (b) on a day after the default information was disclosed, the amount of the overdue payment to which the information relates is paid;",
      "cml:conclusionText": "payment information about the individual is a statement that the amount of the overdue payment has been paid on that day."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6t-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal relation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6u",
      "@type": "cml:Concept",
      "skos:prefLabel": "6U Meaning of personal insolvency information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6u"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.76",
      "values:originalText": "(1) Personal insolvency information about an individual is\ninformation:\n\n(a) that is entered or recorded in the National Personal\nInsolvency Index; and\n\n(b) that relates to:\n\n(i) a bankruptcy of the individual; or\n\n(ii) a debt agreement proposal given by the individual; or\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(iii) a debt agreement made by the individual; or\n\n(iv) a personal insolvency agreement executed by the\nindividual; or\n\n(v) a direction given, or an order made, under section 50 of\nthe Bankruptcy Act that relates to the property of the\nindividual; or\n\n(vi) an authority signed under section 188 of that Act that\nrelates to the property of the individual.\n\n(2) Despite subparagraph (1)(b)(i), personal insolvency information\nabout an individual must not relate to:\n\n(a) the presentation of a creditor’s petition against the individual;\nor\n\n(b) an administration under Part XI of the Bankruptcy Act of the\nindividual’s estate.\n\n(3) An expression used in paragraph (1)(b) or (2)(a) that is also used in\nthe Bankruptcy Act has the same meaning in that paragraph as it\nhas in that Act.",
      "skos:definition": "(1) Personal insolvency information about an individual is\ninformation:\n\n(a) that is entered or recorded in the National Personal\nInsolvency Index; and\n\n(b) that relates to:\n\n(i) a bankruptcy of the individual; or\n\n(ii) a debt agreement proposal given by the individual; or\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(iii) a debt agreement made by the individual; or\n\n(iv) a personal insolvency agreement executed by the\nindividual; or\n\n(v) a direction given, or an order made, under section 50 of\nthe Bankruptcy Act that relates to the property of the\nindividual; or\n\n(vi) an authority signed under section 188 of that Act that\nrelates to the property of the individual.\n\n(2) Despite subparagraph (1)(b)(i), personal insolvency information\nabout an individual must not relate to:\n\n(a) the presentation of a creditor’s petition against the individual;\nor\n\n(b) an administration under Part XI of the Bankruptcy Act of the\nindividual’s estate.\n\n(3) An expression used in paragraph (1)(b) or (2)(a) that is also used in\nthe Bankruptcy Act has the same meaning in that paragraph as it\nhas in that Act.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6u-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6u-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6u-ss-3"
        }
      ],
      "cml:integrityHash": "03ffb5c8cca0ca37999468cae8f937c00dddfc1905f3b34f9b627bafe8beede3"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6u",
      "@type": "cof:Section",
      "cof:title": "6U Meaning of personal insolvency information",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "(1) Personal insolvency information about an individual is\ninformation:\n\n(a) that is entered or recorded in the National Personal\nInsolvency Index; and\n\n(b) that relates to:\n\n(i) a bankruptcy of the individual; or\n\n(ii) a debt agreement proposal given by the individual; or\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(iii) a debt agreement made by the individual; or\n\n(iv) a personal insolvency agreement executed by the\nindividual; or\n\n(v) a direction given, or an order made, under section 50 of\nthe Bankruptcy Act that relates to the property of the\nindividual; or\n\n(vi) an authority signed under section 188 of that Act that\nrelates to the property of the individual.\n\n(2) Despite subparagraph (1)(b)(i), personal insolvency information\nabout an individual must not relate to:\n\n(a) the presentation of a creditor’s petition against the individual;\nor\n\n(b) an administration under Part XI of the Bankruptcy Act of the\nindividual’s estate.\n\n(3) An expression used in paragraph (1)(b) or (2)(a) that is also used in\nthe Bankruptcy Act has the same meaning in that paragraph as it\nhas in that Act."
    },
