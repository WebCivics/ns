    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 3 This subclause applies in relation to the disclosure of personal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-6-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.39",
      "values:originalText": "information about an individual by an APP entity that is an agency\nif:\n\n(a) the agency is not an enforcement body; and\n\n(b) the information is biometric information or biometric\ntemplates; and\n\n(c) the recipient of the information is an enforcement body; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 1  Australian Privacy Principles\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(d) the disclosure is conducted in accordance with the guidelines\nmade by the Commissioner for the purposes of this\nparagraph.",
      "skos:definition": "information about an individual by an APP entity that is an agency\nif:\n\n(a) the agency is not an enforcement body; and\n\n(b) the information is biometric information or biometric\ntemplates; and\n\n(c) the recipient of the information is an enforcement body; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 1  Australian Privacy Principles\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(d) the disclosure is conducted in accordance with the guidelines\nmade by the Commissioner for the purposes of this\nparagraph.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "378b336b2e29ee0598e58b74518037a4d5ec3514457f2504020cf0d05cc1d21e",
      "skos:note": "Disclosure of personal information by an APP entity is subject to certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-6-5",
      "@type": "cof:Section",
      "cof:title": "6 3 This subclause applies in relation to the disclosure of personal",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "information about an individual by an APP entity that is an agency\nif:\n\n(a) the agency is not an enforcement body; and\n\n(b) the information is biometric information or biometric\ntemplates; and\n\n(c) the recipient of the information is an enforcement body; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 1  Australian Privacy Principles\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(d) the disclosure is conducted in accordance with the guidelines\nmade by the Commissioner for the purposes of this\nparagraph."
    },
