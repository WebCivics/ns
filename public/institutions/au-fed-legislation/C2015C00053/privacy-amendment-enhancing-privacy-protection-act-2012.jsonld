      "cml:integrityHash": "fa3bcc1d2e6f4d71469f38c52b19a600e64c1b4e40ce4ed3dcfa9549823799d3",
      "skos:note": "Debt recovery for compensation order"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-25-2-ss-3",
      "@type": "cof:Section",
      "cof:title": "25(3) Compensation orders",
      "values:kind": "subsection",
      "cof:pageNumber": 146,
      "values:originalText": "(3) If the court makes the order, the amount of compensation specified\nin the order that is to be paid to the person may be recovered as a\ndebt due to the person."
    },
