      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-17-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Rules relating to tax file number information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-17-2"
      },
      "cml:curationStatus": {
