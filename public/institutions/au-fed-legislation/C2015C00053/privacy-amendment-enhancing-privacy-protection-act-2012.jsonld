    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-16-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Personal, family or household affairs",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-16-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.21",
      "values:originalText": "Nothing in the Australian Privacy Principles applies to:\n\n(a) the collection, holding, use or disclosure of personal\ninformation by an individual; or\n\n(b) personal information held by an individual;\nonly for the purposes of, or in connection with, his or her personal,\nfamily or household affairs.",
      "skos:definition": "Nothing in the Australian Privacy Principles applies to:\n\n(a) the collection, holding, use or disclosure of personal\ninformation by an individual; or\n\n(b) personal information held by an individual;\nonly for the purposes of, or in connection with, his or her personal,\nfamily or household affairs.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-16-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-16-2-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-16-2-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "66ce7b1e9103bd80f36565a7d2fd314c7583582fb7f9a3cf8abc163ef72556fb",
      "skos:note": "Exemptions from Australian Privacy Principles for personal, family or household affairs"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-16-2",
      "@type": "cof:Section",
      "cof:title": "16 Personal, family or household affairs",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "Nothing in the Australian Privacy Principles applies to:\n\n(a) the collection, holding, use or disclosure of personal\ninformation by an individual; or\n\n(b) personal information held by an individual;\nonly for the purposes of, or in connection with, his or her personal,\nfamily or household affairs."
    },
