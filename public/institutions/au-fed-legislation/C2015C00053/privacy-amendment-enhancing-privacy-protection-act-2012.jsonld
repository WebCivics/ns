    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 March 2015",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sec-6"
      },
      "cml:curationStatus": {
