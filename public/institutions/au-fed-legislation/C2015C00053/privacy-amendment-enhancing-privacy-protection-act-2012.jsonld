    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsection 6(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.55",
      "values:originalText": "Insert:\ncourt proceedings information about an individual means\ninformation about a judgement of an Australian court:\n\n(a) that is made, or given, against the individual in proceedings\n(other than criminal proceedings); and\n\n(b) that relates to any credit that has been provided to, or applied\nfor by, the individual.",
      "skos:definition": "Insert:\ncourt proceedings information about an individual means\ninformation about a judgement of an Australian court:\n\n(a) that is made, or given, against the individual in proceedings\n(other than criminal proceedings); and\n\n(b) that relates to any credit that has been provided to, or applied\nfor by, the individual.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-12-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-12-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-12-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "bd877fccebbc4de17c2f4f4ae0fbec6b6524a56e432b4475b5bb4681803e098f",
      "skos:note": "Must provide court proceedings information about an individual's judgement in Australian courts.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 55,
      "values:originalText": "Insert:\ncourt proceedings information about an individual means\ninformation about a judgement of an Australian court:\n\n(a) that is made, or given, against the individual in proceedings\n(other than criminal proceedings); and\n\n(b) that relates to any credit that has been provided to, or applied\nfor by, the individual."
    },
