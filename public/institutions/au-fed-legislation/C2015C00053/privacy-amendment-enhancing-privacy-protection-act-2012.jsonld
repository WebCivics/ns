      "@type": "cml:Concept",
      "skos:prefLabel": "36 Subsection 6(1) (definition of personal information)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-36"
      },
      "cml:curationStatus": {
