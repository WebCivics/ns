        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20u-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "20U(3) Notice of correction etc. must be given",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20u-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.98",
      "values:originalText": "(3) If the credit reporting body does not correct the personal\ninformation under subsection 20T(2), the body must, within a\nreasonable period, give the individual written notice that:\n\n(a) states that the correction has not been made; and\n\n(b) sets out the body’s reasons for not correcting the information\n(including evidence substantiating the correctness of the\ninformation); and\n\n(c) states that, if the individual is not satisfied with the response\nto the request, the individual may:\n\n(i) access a recognised external dispute resolution scheme\nof which the body is a member; or\n\n(ii) make a complaint to the Commissioner under Part V.\nExceptions",
      "skos:definition": "(3) If the credit reporting body does not correct the personal\ninformation under subsection 20T(2), the body must, within a\nreasonable period, give the individual written notice that:\n\n(a) states that the correction has not been made; and\n\n(b) sets out the body’s reasons for not correcting the information\n(including evidence substantiating the correctness of the\ninformation); and\n\n(c) states that, if the individual is not satisfied with the response\nto the request, the individual may:\n\n(i) access a recognised external dispute resolution scheme\nof which the body is a member; or\n\n(ii) make a complaint to the Commissioner under Part V.\nExceptions",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20u"
      },
      "cml:asserts": [
