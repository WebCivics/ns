      "cml:logicSummary": "Spread of prohibition.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The organisation must ensure that all employees are aware of the prohibition.",
      "cml:conclusionText": "Must not use or disclose the information for the purpose of direct marketing."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Artificial intelligence application.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The organisation must implement artificial intelligence to ensure compliance with the prohibition.",
      "cml:conclusionText": "Must not use or disclose the information for the purpose of direct marketing."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-7-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 2 Despite subclause 7.1, an organisation may use or disclose",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-7-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.41",
      "values:originalText": "personal information (other than sensitive information) about an\nindividual for the purpose of direct marketing if:\n\n(a) the organisation collected the information from the\nindividual; and\n\n(b) the individual would reasonably expect the organisation to\nuse or disclose the information for that purpose; and\n\n(c) the organisation provides a simple means by which the\nindividual may easily request not to receive direct marketing\ncommunications from the organisation; and\n\n(d) the individual has not made such a request to the\norganisation.",
      "skos:definition": "personal information (other than sensitive information) about an\nindividual for the purpose of direct marketing if:\n\n(a) the organisation collected the information from the\nindividual; and\n\n(b) the individual would reasonably expect the organisation to\nuse or disclose the information for that purpose; and\n\n(c) the organisation provides a simple means by which the\nindividual may easily request not to receive direct marketing\ncommunications from the organisation; and\n\n(d) the individual has not made such a request to the\norganisation.",
      "cml:asserts": [
        {
