      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35d",
      "@type": "cml:Concept",
      "skos:prefLabel": "35D Verification information not to be collected or held by a credit",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-35d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.234",
      "values:originalText": "reporting body\n\nSubject to section 35E, a credit reporting body must not collect or\nhold personal information about an individual that relates to a\nverification request or an assessment in relation to the individual.",
      "skos:definition": "reporting body\n\nSubject to section 35E, a credit reporting body must not collect or\nhold personal information about an individual that relates to a\nverification request or an assessment in relation to the individual.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35d-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-35d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0c32ddc033d269847deb81c0d29f451f37d4c56f6fb086b866d3fb11a7e37ae5",
      "skos:note": "Credit reporting bodies must not collect or hold personal information about an individual related to a verification request."
    },
