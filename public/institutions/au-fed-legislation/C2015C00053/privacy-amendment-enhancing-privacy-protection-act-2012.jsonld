      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.54",
      "values:originalText": "Insert:\nconsumer credit means credit:\n\n(a) for which an application has been made by an individual to a\ncredit provider, or that has been provided to an individual by\na credit provider, in the course of the provider carrying on a\nbusiness or undertaking as a credit provider; and\n\n(b) that is intended to be used wholly or primarily:\n\n(i) for personal, family or household purposes; or\n\n(ii) to acquire, maintain, renovate or improve residential\nproperty for investment purposes; or\n\n(iii) to refinance consumer credit that has been provided\nwholly or primarily to acquire, maintain, renovate or\nimprove residential property for investment purposes.",
      "skos:definition": "Insert:\nconsumer credit means credit:\n\n(a) for which an application has been made by an individual to a\ncredit provider, or that has been provided to an individual by\na credit provider, in the course of the provider carrying on a\nbusiness or undertaking as a credit provider; and\n\n(b) that is intended to be used wholly or primarily:\n\n(i) for personal, family or household purposes; or\n\n(ii) to acquire, maintain, renovate or improve residential\nproperty for investment purposes; or\n\n(iii) to refinance consumer credit that has been provided\nwholly or primarily to acquire, maintain, renovate or\nimprove residential property for investment purposes.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-9-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-9-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-9-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "5fa85d571449aba7231e40a647f86d9691231fb4c73cbbab7bd1a17037d1fbf6",
      "skos:note": "Defines consumer credit"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "Insert:\nconsumer credit means credit:\n\n(a) for which an application has been made by an individual to a\ncredit provider, or that has been provided to an individual by\na credit provider, in the course of the provider carrying on a\nbusiness or undertaking as a credit provider; and\n\n(b) that is intended to be used wholly or primarily:\n\n(i) for personal, family or household purposes; or\n\n(ii) to acquire, maintain, renovate or improve residential\nproperty for investment purposes; or\n\n(iii) to refinance consumer credit that has been provided\nwholly or primarily to acquire, maintain, renovate or\nimprove residential property for investment purposes."
    },
