      "cml:integrityHash": "9bdea0197292a460cc3ef48cb0ebd67b45dd04b826939dcc78d5871a7e24fe4b",
      "skos:note": "Use or disclosure of credit reporting information for direct marketing is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20g-ss-1",
      "@type": "cof:Section",
      "cof:title": "20G(1) Use or disclosure of credit reporting information for the",
      "values:kind": "subsection",
      "cof:pageNumber": 87,
      "values:originalText": "(1) If a credit reporting body holds credit reporting information about\nan individual, the body must not use or disclose the information for\nthe purposes of direct marketing.\nCivil penalty:\n2,000 penalty units.\nPermitted use for pre-screening"
    },
    {
