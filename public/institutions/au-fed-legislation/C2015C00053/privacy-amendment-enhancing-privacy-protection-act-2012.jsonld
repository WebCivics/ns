      "skos:note": "Exemption from section 20E for direct marketing purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20e-ss-6",
      "@type": "cof:Section",
      "cof:title": "20E(6) Use or disclosure of credit reporting information",
      "values:kind": "subsection",
      "cof:pageNumber": 84,
      "values:originalText": "(6) This section does not apply to the use or disclosure of credit\nreporting information for the purposes of direct marketing.\nNote:\nSection 20G deals with the use or disclosure of credit reporting\ninformation for the purposes of direct marketing."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20e-ss-6-norm",
