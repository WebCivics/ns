    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80v-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If entity contravenes subsection (1), then it contravenes civil penalty provision.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Entity A contravenes subsection (1).",
      "cml:conclusionText": "Entity A contravenes civil penalty provision."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80v-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal interval during which entity contravenes subsection (1) overlaps with temporal interval during which it contravenes civil penalty provision.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Entity A starts contravening subsection (1) at time T1 and ends at time T2.",
      "cml:conclusionText": "T1 overlaps with T2 where T2 is the temporal interval during which Entity A contravenes civil penalty provision."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80v-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Entity that contravenes subsection (1) until it stops contravening civil penalty provision.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Entity A starts contravening subsection (1).",
      "cml:conclusionText": "Entity A stops contravening civil penalty provision until Entity B stops contravening subsection (1)."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80v-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Entity that contravenes subsection (1) diffuses to entity that contravenes civil penalty provision.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Entity A starts contravening subsection (1).",
      "cml:conclusionText": "Entity A diffuses to Entity B where Entity B contravenes civil penalty provision."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80v-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "CogAI recognizes entity that contravenes subsection (1) as entity that contravenes civil penalty provision.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Entity A starts contravening subsection (1).",
      "cml:conclusionText": "CogAI recognizes Entity A as Entity B where Entity B contravenes civil penalty provision."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w",
      "@type": "cml:Concept",
      "skos:prefLabel": "80W Civil penalty orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.207",
      "values:originalText": "Application for order\n\n(1) The Commissioner may apply to the Federal Court or Federal\nMagistrates Court for an order that an entity, that is alleged to have\ncontravened a civil penalty provision, pay the Commonwealth a\npecuniary penalty.\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(2) The Commissioner must make the application within 6 years of the\nalleged contravention.\nCourt may order entity to pay pecuniary penalty\n\n(3) If the court is satisfied that the entity has contravened the civil\npenalty provision, the court may order the entity to pay to the\nCommonwealth such pecuniary penalty for the contravention as the\ncourt determines to be appropriate.\nNote:\nSubsection (5) sets out the maximum penalty that the court may order\nthe entity to pay.\n\n(4) An order under subsection (3) is a civil penalty order.\nDetermining pecuniary penalty\n\n(5) The pecuniary penalty must not be more than:\n\n(a) if the entity is a body corporate—5 times the amount of the\npecuniary penalty specified for the civil penalty provision; or\n\n(b) otherwise—the amount of the pecuniary penalty specified for\nthe civil penalty provision.\n\n(6) In determining the pecuniary penalty, the court must take into\naccount all relevant matters, including:\n\n(a) the nature and extent of the contravention; and\n\n(b) the nature and extent of any loss or damage suffered because\nof the contravention; and\n\n(c) the circumstances in which the contravention took place; and\n\n(d) whether the entity has previously been found by a court in\nproceedings under this Act to have engaged in any similar\nconduct.",
      "skos:definition": "Application for order\n\n(1) The Commissioner may apply to the Federal Court or Federal\nMagistrates Court for an order that an entity, that is alleged to have\ncontravened a civil penalty provision, pay the Commonwealth a\npecuniary penalty.\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(2) The Commissioner must make the application within 6 years of the\nalleged contravention.\nCourt may order entity to pay pecuniary penalty\n\n(3) If the court is satisfied that the entity has contravened the civil\npenalty provision, the court may order the entity to pay to the\nCommonwealth such pecuniary penalty for the contravention as the\ncourt determines to be appropriate.\nNote:\nSubsection (5) sets out the maximum penalty that the court may order\nthe entity to pay.\n\n(4) An order under subsection (3) is a civil penalty order.\nDetermining pecuniary penalty\n\n(5) The pecuniary penalty must not be more than:\n\n(a) if the entity is a body corporate—5 times the amount of the\npecuniary penalty specified for the civil penalty provision; or\n\n(b) otherwise—the amount of the pecuniary penalty specified for\nthe civil penalty provision.\n\n(6) In determining the pecuniary penalty, the court must take into\naccount all relevant matters, including:\n\n(a) the nature and extent of the contravention; and\n\n(b) the nature and extent of any loss or damage suffered because\nof the contravention; and\n\n(c) the circumstances in which the contravention took place; and\n\n(d) whether the entity has previously been found by a court in\nproceedings under this Act to have engaged in any similar\nconduct.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-4"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-5"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-80w-ss-6"
        }
      ],
      "cml:integrityHash": "7a6f7d2c3ace1ebcb524e927eedc5746e1b8465cb56139706b215b07638f08e9"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-80w",
      "@type": "cof:Section",
      "cof:title": "80W Civil penalty orders",
      "values:kind": "section",
      "cof:pageNumber": 207,
      "values:originalText": "Application for order\n\n(1) The Commissioner may apply to the Federal Court or Federal\nMagistrates Court for an order that an entity, that is alleged to have\ncontravened a civil penalty provision, pay the Commonwealth a\npecuniary penalty.\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(2) The Commissioner must make the application within 6 years of the\nalleged contravention.\nCourt may order entity to pay pecuniary penalty\n\n(3) If the court is satisfied that the entity has contravened the civil\npenalty provision, the court may order the entity to pay to the\nCommonwealth such pecuniary penalty for the contravention as the\ncourt determines to be appropriate.\nNote:\nSubsection (5) sets out the maximum penalty that the court may order\nthe entity to pay.\n\n(4) An order under subsection (3) is a civil penalty order.\nDetermining pecuniary penalty\n\n(5) The pecuniary penalty must not be more than:\n\n(a) if the entity is a body corporate—5 times the amount of the\npecuniary penalty specified for the civil penalty provision; or\n\n(b) otherwise—the amount of the pecuniary penalty specified for\nthe civil penalty provision.\n\n(6) In determining the pecuniary penalty, the court must take into\naccount all relevant matters, including:\n\n(a) the nature and extent of the contravention; and\n\n(b) the nature and extent of any loss or damage suffered because\nof the contravention; and\n\n(c) the circumstances in which the contravention took place; and\n\n(d) whether the entity has previously been found by a court in\nproceedings under this Act to have engaged in any similar\nconduct."
    },
