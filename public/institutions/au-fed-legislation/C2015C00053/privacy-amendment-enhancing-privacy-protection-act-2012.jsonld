        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The entity must not collect sensitive information unless it meets certain conditions.",
      "cml:conclusionText": "The knowledge representation of the entity is that it must not collect sensitive information unless it meets certain conditions."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-3-5-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "Validation",
      "cml:logicSummary": "Validation of APP entity classification",
