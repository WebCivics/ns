    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 2 This subclause applies in relation to the use or disclosure of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-6-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.39",
      "values:originalText": "personal information about an individual if:\n\n(a) the individual would reasonably expect the APP entity to use\nor disclose the information for the secondary purpose and the\nsecondary purpose is:\n\n(i) if the information is sensitive information—directly\nrelated to the primary purpose; or\n\n(ii) if the information is not sensitive information—related\nto the primary purpose; or\n\n(b) the use or disclosure of the information is required or\nauthorised by or under an Australian law or a court/tribunal\norder; or\n\n(c) a permitted general situation exists in relation to the use or\ndisclosure of the information by the APP entity; or\n\n(d) the APP entity is an organisation and a permitted health\nsituation exists in relation to the use or disclosure of the\ninformation by the entity; or\n\n(e) the APP entity reasonably believes that the use or disclosure\nof the information is reasonably necessary for one or more\nenforcement related activities conducted by, or on behalf of,\nan enforcement body.\nNote:\nFor permitted general situation, see section 16A. For permitted\nhealth situation, see section 16B.",
      "skos:definition": "personal information about an individual if:\n\n(a) the individual would reasonably expect the APP entity to use\nor disclose the information for the secondary purpose and the\nsecondary purpose is:\n\n(i) if the information is sensitive information—directly\nrelated to the primary purpose; or\n\n(ii) if the information is not sensitive information—related\nto the primary purpose; or\n\n(b) the use or disclosure of the information is required or\nauthorised by or under an Australian law or a court/tribunal\norder; or\n\n(c) a permitted general situation exists in relation to the use or\ndisclosure of the information by the APP entity; or\n\n(d) the APP entity is an organisation and a permitted health\nsituation exists in relation to the use or disclosure of the\ninformation by the entity; or\n\n(e) the APP entity reasonably believes that the use or disclosure\nof the information is reasonably necessary for one or more\nenforcement related activities conducted by, or on behalf of,\nan enforcement body.\nNote:\nFor permitted general situation, see section 16A. For permitted\nhealth situation, see section 16B.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-4-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-4-logic-deontic-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-4-logic-deontic-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-4-logic-deontic-4"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-6-4-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "f157a837c7aa992cb65644327b410ab02681f38ef83752b77718e55aa941560a",
      "skos:note": "Use or disclose personal information for secondary purpose if individual expects it, or required by law or court order."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-6-4",
      "@type": "cof:Section",
      "cof:title": "6 2 This subclause applies in relation to the use or disclosure of",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "personal information about an individual if:\n\n(a) the individual would reasonably expect the APP entity to use\nor disclose the information for the secondary purpose and the\nsecondary purpose is:\n\n(i) if the information is sensitive information—directly\nrelated to the primary purpose; or\n\n(ii) if the information is not sensitive information—related\nto the primary purpose; or\n\n(b) the use or disclosure of the information is required or\nauthorised by or under an Australian law or a court/tribunal\norder; or\n\n(c) a permitted general situation exists in relation to the use or\ndisclosure of the information by the APP entity; or\n\n(d) the APP entity is an organisation and a permitted health\nsituation exists in relation to the use or disclosure of the\ninformation by the entity; or\n\n(e) the APP entity reasonably believes that the use or disclosure\nof the information is reasonably necessary for one or more\nenforcement related activities conducted by, or on behalf of,\nan enforcement body.\nNote:\nFor permitted general situation, see section 16A. For permitted\nhealth situation, see section 16B."
    },
