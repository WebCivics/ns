      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.103",
      "values:originalText": "(5) Subsection (4) does not apply if the credit reporting body is\nrequired by or under an Australian law, or a court/tribunal order,\nnot to give the notification.",
      "skos:definition": "(5) Subsection (4) does not apply if the credit reporting body is\nrequired by or under an Australian law, or a court/tribunal order,\nnot to give the notification.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y-ss-5-norm"
        }
      ],
      "cml:integrityHash": "ad10d75edbd95daa4cbe4095b113b949fda1f66c265a2b4a81223fb034ad51fa",
      "skos:note": "Notification is not required if mandated by law or court order."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20y-ss-5",
      "@type": "cof:Section",
      "cof:title": "20Y(5) Destruction of credit reporting information in cases of fraud",
      "values:kind": "subsection",
      "cof:pageNumber": 103,
      "values:originalText": "(5) Subsection (4) does not apply if the credit reporting body is\nrequired by or under an Australian law, or a court/tribunal order,\nnot to give the notification."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y-ss-5"
      },
      "values:deonticStatus": {
