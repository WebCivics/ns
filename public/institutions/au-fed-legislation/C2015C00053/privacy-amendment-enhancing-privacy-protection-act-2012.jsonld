    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-187",
      "@type": "cml:Concept",
      "skos:prefLabel": "187 Subsections 80P(4) and (5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-187"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.206",
      "values:originalText": "Repeal the subsections, substitute:\n\n(4) An entity does not breach an Australian Privacy Principle, or a\nregistered APP code that binds the entity, in respect of a collection,\nuse or disclosure of personal information authorised by\nsubsection (1).",
      "skos:definition": "Repeal the subsections, substitute:\n\n(4) An entity does not breach an Australian Privacy Principle, or a\nregistered APP code that binds the entity, in respect of a collection,\nuse or disclosure of personal information authorised by\nsubsection (1).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-187-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-187-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "541a4f1cff32b500e0bbc0af3a7e46e6d3f250ee18ebb31a621f1a32eca4c656",
      "skos:note": "No breach of Australian Privacy Principle or APP code for authorized collection, use, or disclosure of personal information."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-187",
      "@type": "cof:Section",
      "cof:title": "187 Subsections 80P(4) and (5)",
      "values:kind": "section",
      "cof:pageNumber": 206,
      "values:originalText": "Repeal the subsections, substitute:\n\n(4) An entity does not breach an Australian Privacy Principle, or a\nregistered APP code that binds the entity, in respect of a collection,\nuse or disclosure of personal information authorised by\nsubsection (1)."
    },
