    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-62",
      "@type": "cml:Concept",
      "skos:prefLabel": "62 Subsection 6(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-62"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.64",
      "values:originalText": "Insert:\nsecuritisation related purpose of a credit provider in relation to an\nindividual is the purpose of:\n\n(a) assessing the risk in purchasing, by means of a securitisation\narrangement, credit that has been provided to, or applied for\nby:\n\n(i) the individual; or\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(ii) a person for whom the individual is, or is proposing to\nbe, a guarantor; or\n\n(b) assessing the risk in undertaking credit enhancement in\nrelation to credit:\n\n(i) that is, or is proposed to be, purchased or funded by\nmeans of a securitisation arrangement; and\n\n(ii) that has been provided to, or applied for by, the\nindividual or a person for whom the individual is, or is\nproposing to be, a guarantor.",
      "skos:definition": "Insert:\nsecuritisation related purpose of a credit provider in relation to an\nindividual is the purpose of:\n\n(a) assessing the risk in purchasing, by means of a securitisation\narrangement, credit that has been provided to, or applied for\nby:\n\n(i) the individual; or\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(ii) a person for whom the individual is, or is proposing to\nbe, a guarantor; or\n\n(b) assessing the risk in undertaking credit enhancement in\nrelation to credit:\n\n(i) that is, or is proposed to be, purchased or funded by\nmeans of a securitisation arrangement; and\n\n(ii) that has been provided to, or applied for by, the\nindividual or a person for whom the individual is, or is\nproposing to be, a guarantor.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-62-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-62-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-62-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "7c461913de7c54c39837ca51e2b6bd4db20ade49745a303dff7c1ec4b3985c6b",
      "skos:note": "Assessing risk in purchasing credit or undertaking credit enhancement"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-62",
      "@type": "cof:Section",
      "cof:title": "62 Subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 64,
      "values:originalText": "Insert:\nsecuritisation related purpose of a credit provider in relation to an\nindividual is the purpose of:\n\n(a) assessing the risk in purchasing, by means of a securitisation\narrangement, credit that has been provided to, or applied for\nby:\n\n(i) the individual; or\nComLaw Authoritative Act C2015C00053\n\nCredit reporting  Schedule 2\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(ii) a person for whom the individual is, or is proposing to\nbe, a guarantor; or\n\n(b) assessing the risk in undertaking credit enhancement in\nrelation to credit:\n\n(i) that is, or is proposed to be, purchased or funded by\nmeans of a securitisation arrangement; and\n\n(ii) that has been provided to, or applied for by, the\nindividual or a person for whom the individual is, or is\nproposing to be, a guarantor."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-62-norm",
