        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20x-ss-3-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "43ce83d2b5fb694c93c8744e988771b17d298ce6e848f18a63ec79696cc22590",
      "skos:note": "Retention period for credit information—personal insolvency"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20x-ss-3",
      "@type": "cof:Section",
      "cof:title": "20X(3) Retention period for credit information—personal insolvency",
      "values:kind": "subsection",
      "cof:pageNumber": 102,
      "values:originalText": "(3) If personal insolvency information relates to a direction given, or\nan order made, under section 50 of the Bankruptcy Act, the\nretention period for the information is the period that ends on the\nday on which the control of the property to which the direction or\norder relates ends.\nNote:\nSee subsection 50(1B) of the Bankruptcy Act for when the control of\nthe property ends."
    },
