      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.15",
      "values:originalText": "Repeal the definition, substitute:\npersonal information means information or an opinion about an\nidentified individual, or an individual who is reasonably\nidentifiable:\n\n(a) whether the information or opinion is true or not; and\n\n(b) whether the information or opinion is recorded in a material\nform or not.",
      "skos:definition": "Repeal the definition, substitute:\npersonal information means information or an opinion about an\nidentified individual, or an individual who is reasonably\nidentifiable:\n\n(a) whether the information or opinion is true or not; and\n\n(b) whether the information or opinion is recorded in a material\nform or not.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-36-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-36-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-36-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "1c6894ba2f7625ce9bbf583a96e9596669e859fb9761be945917e813c86aa8d7",
      "skos:note": "Definition of personal information"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Subsection 6(1) (definition of personal information)",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Repeal the definition, substitute:\npersonal information means information or an opinion about an\nidentified individual, or an individual who is reasonably\nidentifiable:\n\n(a) whether the information or opinion is true or not; and\n\n(b) whether the information or opinion is recorded in a material\nform or not."
    },
