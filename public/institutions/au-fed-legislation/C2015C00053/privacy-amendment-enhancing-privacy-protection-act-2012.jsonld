        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Entity must not breach the CR code"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26m",
      "@type": "cml:Concept",
      "skos:prefLabel": "26M What is the registered CR code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.160",
      "values:originalText": "(1) The registered CR code is the CR code that is included on the\nCodes Register.\n\n(2) The registered CR code is a legislative instrument.\n\n(3) Despite subsection 12(2) of the Legislative Instruments Act 2003,\nthe registered CR code may be expressed to take effect before the\ndate it is registered under that Act.",
      "skos:definition": "(1) The registered CR code is the CR code that is included on the\nCodes Register.\n\n(2) The registered CR code is a legislative instrument.\n\n(3) Despite subsection 12(2) of the Legislative Instruments Act 2003,\nthe registered CR code may be expressed to take effect before the\ndate it is registered under that Act.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26m-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26m-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26m-ss-3"
        }
      ],
      "cml:integrityHash": "c58fe767bee637ed3c5515c9ed578a5dcc49afc3fb9bf65df67e90d6607f53ca"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26m",
      "@type": "cof:Section",
      "cof:title": "26M What is the registered CR code",
      "values:kind": "section",
      "cof:pageNumber": 160,
      "values:originalText": "(1) The registered CR code is the CR code that is included on the\nCodes Register.\n\n(2) The registered CR code is a legislative instrument.\n\n(3) Despite subsection 12(2) of the Legislative Instruments Act 2003,\nthe registered CR code may be expressed to take effect before the\ndate it is registered under that Act."
    },
