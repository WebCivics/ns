    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-2a",
      "@type": "cml:Concept",
      "skos:prefLabel": "2A Objects of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-2a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.168",
      "values:originalText": "The objects of this Act are:\n\n(a) to promote the protection of the privacy of individuals; and\n\n(b) to recognise that the protection of the privacy of individuals\nis balanced with the interests of entities in carrying out their\nfunctions or activities; and\n\n(c) to provide the basis for nationally consistent regulation of\nprivacy and the handling of personal information; and\n\n(d) to promote responsible and transparent handling of personal\ninformation by entities; and\n\n(e) to facilitate an efficient credit reporting system while\nensuring that the privacy of individuals is respected; and\n\n(f) to facilitate the free flow of information across national\nborders while ensuring that the privacy of individuals is\nrespected; and\n\n(g) to provide a means for individuals to complain about an\nalleged interference with their privacy; and\n\n(h) to implement Australia’s international obligation in relation\nto privacy.",
      "skos:definition": "The objects of this Act are:\n\n(a) to promote the protection of the privacy of individuals; and\n\n(b) to recognise that the protection of the privacy of individuals\nis balanced with the interests of entities in carrying out their\nfunctions or activities; and\n\n(c) to provide the basis for nationally consistent regulation of\nprivacy and the handling of personal information; and\n\n(d) to promote responsible and transparent handling of personal\ninformation by entities; and\n\n(e) to facilitate an efficient credit reporting system while\nensuring that the privacy of individuals is respected; and\n\n(f) to facilitate the free flow of information across national\nborders while ensuring that the privacy of individuals is\nrespected; and\n\n(g) to provide a means for individuals to complain about an\nalleged interference with their privacy; and\n\n(h) to implement Australia’s international obligation in relation\nto privacy.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-2a-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-2a-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-2a-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "6ae8b997853c802df47561d654fb80ca6092b051b009cff47caffde3514cccbd",
      "skos:note": "Promote protection of individual privacy and balance with entity interests."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-2a",
      "@type": "cof:Section",
      "cof:title": "2A Objects of this Act",
      "values:kind": "section",
      "cof:pageNumber": 168,
      "values:originalText": "The objects of this Act are:\n\n(a) to promote the protection of the privacy of individuals; and\n\n(b) to recognise that the protection of the privacy of individuals\nis balanced with the interests of entities in carrying out their\nfunctions or activities; and\n\n(c) to provide the basis for nationally consistent regulation of\nprivacy and the handling of personal information; and\n\n(d) to promote responsible and transparent handling of personal\ninformation by entities; and\n\n(e) to facilitate an efficient credit reporting system while\nensuring that the privacy of individuals is respected; and\n\n(f) to facilitate the free flow of information across national\nborders while ensuring that the privacy of individuals is\nrespected; and\n\n(g) to provide a means for individuals to complain about an\nalleged interference with their privacy; and\n\n(h) to implement Australia’s international obligation in relation\nto privacy."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-2a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-2a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
