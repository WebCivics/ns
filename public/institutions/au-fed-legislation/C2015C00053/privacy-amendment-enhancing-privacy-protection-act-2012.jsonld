    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21a-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "21A(6) Application of this Division to credit providers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21a-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.107",
      "values:originalText": "(6) If a person or body requests a copy, in a particular form, of the\npolicy of a credit provider, the provider must take such steps as are\nreasonable in the circumstances to give the person or body a copy\nin that form.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nInteraction with the Australian Privacy Principles",
      "skos:definition": "(6) If a person or body requests a copy, in a particular form, of the\npolicy of a credit provider, the provider must take such steps as are\nreasonable in the circumstances to give the person or body a copy\nin that form.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nInteraction with the Australian Privacy Principles",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21a"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21a-ss-6-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21a-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6fb7bae1072dae00d9c1cc5d24213709f315d2c9c7bc93347096ec1e109e9f90",
      "skos:note": "Credit provider must provide a copy of policy in a particular form upon request.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21a-ss-6",
      "@type": "cof:Section",
      "cof:title": "21A(6) Application of this Division to credit providers",
      "values:kind": "subsection",
      "cof:pageNumber": 107,
      "values:originalText": "(6) If a person or body requests a copy, in a particular form, of the\npolicy of a credit provider, the provider must take such steps as are\nreasonable in the circumstances to give the person or body a copy\nin that form.\nComLaw Authoritative Act C2015C00053\n\nSchedule 2  Credit reporting\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\nInteraction with the Australian Privacy Principles"
    },
