      "cml:integrityHash": "1e69df1dadcdc6a65d488a8caad3d37a15a8cc2bd1cecb22c8cb83aefd96219e",
      "skos:note": "An individual must not authorise a person under subsection (1)(b)(ii) if the person is a credit provider, mortgage insurer, trade insurer, or prevented from being a credit provider by subsection 6G(5) or (6)."
    },
    {
