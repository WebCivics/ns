      "@type": "cml:Concept",
      "skos:prefLabel": "13 4 If:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-13-6"
