      "cml:integrityHash": "98ea3bda7c97d3dc0ff970116d5cdd4d0d1eab194bc7c5c008a9a2a948934d91",
      "skos:note": "Prohibition on using or disclosing credit information without consent. Recipient must not use or disclose credit eligibility information. Body corporate must not use or disclose credit eligibility information about an individual."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-22d-ss-1",
      "@type": "cof:Section",
      "cof:title": "22D(1) Use or disclosure of information by a related body corporate",
      "values:kind": "subsection",
      "cof:pageNumber": 137,
      "values:originalText": "(1) If:\n\n(a) a body corporate holds or held credit eligibility information\nabout an individual; and\n\n(b) the information was disclosed to the body by a credit\nprovider under paragraph 21G(3)(b);\nthe body must not use or disclose the information, or any personal\ninformation about the individual derived from that information.\nCivil penalty:\n1,000 penalty units.\nPermitted use or disclosure"
    },
