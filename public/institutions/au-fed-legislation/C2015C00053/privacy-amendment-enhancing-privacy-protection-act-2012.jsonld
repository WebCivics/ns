    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21t-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "21T(8) Access to credit eligibility information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21t-ss-8"
      },
