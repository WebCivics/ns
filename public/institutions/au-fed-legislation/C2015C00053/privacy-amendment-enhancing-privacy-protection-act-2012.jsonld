    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21t-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "21T(6) Access to credit eligibility information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21t-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.128",
      "values:originalText": "(6) If a credit provider is an organisation or small business operator,\nany charge by the provider for giving access to the information\nmust not be excessive and must not apply to the making of the\nrequest.\nRefusal to give access",
      "skos:definition": "(6) If a credit provider is an organisation or small business operator,\nany charge by the provider for giving access to the information\nmust not be excessive and must not apply to the making of the\nrequest.\nRefusal to give access",
      "values:partOf": {
