    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98a-ss-4-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Ignorance",
      "cml:logicSummary": "Ignorance is not an excuse",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The partner does not know of the circumstances",
      "cml:conclusionText": "The partner is excused"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98a-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Recurring trace of reasonable steps",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The partner takes all reasonable steps",
      "cml:conclusionText": "The partner's actions are justified"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98b",
      "@type": "cml:Concept",
      "skos:prefLabel": "98B Treatment of unincorporated associations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-98b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.214",
      "values:originalText": "(1) If, apart from this subsection, this Act would impose an obligation\non an unincorporated association, the obligation is imposed instead\non each member of the association’s committee of management but\nmay be discharged by any of the members.\n\n(2) If, apart from this subsection, an offence against this Act would be\ncommitted by an unincorporated association, the offence is taken to\nhave been committed by each member of the association’s\ncommittee of management.\n\n(3) If, apart from this subsection, an unincorporated association would\ncontravene a civil penalty provision, the contravention is taken to\nhave been committed by each member of the association’s\ncommittee of management.\n\n(4) A member of an unincorporated association’s committee of\nmanagement does not commit an offence against this Act because\nof subsection (2), or contravene a civil penalty provision because\nof subsection (3), if the member:\n\n(a) does not know of the circumstances that constitute the\ncontravention of the provision concerned; or\n\n(b) knows of those circumstances but takes all reasonable steps\nto correct the contravention as soon as possible after the\nmember becomes aware of those circumstances.\nNote:\nIn criminal proceedings, a defendant bears an evidential burden in\nrelation to the matters in subsection (4) (see subsection 13.3(3) of the\nCriminal Code).",
      "skos:definition": "(1) If, apart from this subsection, this Act would impose an obligation\non an unincorporated association, the obligation is imposed instead\non each member of the association’s committee of management but\nmay be discharged by any of the members.\n\n(2) If, apart from this subsection, an offence against this Act would be\ncommitted by an unincorporated association, the offence is taken to\nhave been committed by each member of the association’s\ncommittee of management.\n\n(3) If, apart from this subsection, an unincorporated association would\ncontravene a civil penalty provision, the contravention is taken to\nhave been committed by each member of the association’s\ncommittee of management.\n\n(4) A member of an unincorporated association’s committee of\nmanagement does not commit an offence against this Act because\nof subsection (2), or contravene a civil penalty provision because\nof subsection (3), if the member:\n\n(a) does not know of the circumstances that constitute the\ncontravention of the provision concerned; or\n\n(b) knows of those circumstances but takes all reasonable steps\nto correct the contravention as soon as possible after the\nmember becomes aware of those circumstances.\nNote:\nIn criminal proceedings, a defendant bears an evidential burden in\nrelation to the matters in subsection (4) (see subsection 13.3(3) of the\nCriminal Code).",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98b-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98b-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98b-ss-3"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-98b-ss-4"
        }
      ],
      "cml:integrityHash": "a2ff677530643cabd6ca06e13f13ec0f118623b93dfa1f90965fbd232a9d834b"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-98b",
      "@type": "cof:Section",
      "cof:title": "98B Treatment of unincorporated associations",
      "values:kind": "section",
      "cof:pageNumber": 214,
      "values:originalText": "(1) If, apart from this subsection, this Act would impose an obligation\non an unincorporated association, the obligation is imposed instead\non each member of the association’s committee of management but\nmay be discharged by any of the members.\n\n(2) If, apart from this subsection, an offence against this Act would be\ncommitted by an unincorporated association, the offence is taken to\nhave been committed by each member of the association’s\ncommittee of management.\n\n(3) If, apart from this subsection, an unincorporated association would\ncontravene a civil penalty provision, the contravention is taken to\nhave been committed by each member of the association’s\ncommittee of management.\n\n(4) A member of an unincorporated association’s committee of\nmanagement does not commit an offence against this Act because\nof subsection (2), or contravene a civil penalty provision because\nof subsection (3), if the member:\n\n(a) does not know of the circumstances that constitute the\ncontravention of the provision concerned; or\n\n(b) knows of those circumstances but takes all reasonable steps\nto correct the contravention as soon as possible after the\nmember becomes aware of those circumstances.\nNote:\nIn criminal proceedings, a defendant bears an evidential burden in\nrelation to the matters in subsection (4) (see subsection 13.3(3) of the\nCriminal Code)."
    },
