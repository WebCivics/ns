    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26a",
      "@type": "cml:Concept",
      "skos:prefLabel": "26A APP entities to comply with binding registered APP codes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.153",
      "values:originalText": "An APP entity must not do an act, or engage in a practice, that\nbreaches a registered APP code that binds the entity.",
      "skos:definition": "An APP entity must not do an act, or engage in a practice, that\nbreaches a registered APP code that binds the entity.",
