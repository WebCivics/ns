        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The substitution applies to all agencies and principal executives",
      "cml:conclusionText": "All related agencies and principal executives must use the alternative text"
    },
