    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40a-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "40A(5) Conciliation of complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-40a-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.190",
      "values:originalText": "(5) Evidence of anything said or done in the course of the conciliation\nis not admissible in any hearing before the Commissioner, or in\nany legal proceedings, relating to complaint or the act or practice\nunless:\n\n(a) the complainant and respondent otherwise agree; or\n\n(b) the thing was said or done in furtherance of the commission\nof a fraud or an offence, or the commission of an act that\nrenders a person liable to a civil penalty.",
      "skos:definition": "(5) Evidence of anything said or done in the course of the conciliation\nis not admissible in any hearing before the Commissioner, or in\nany legal proceedings, relating to complaint or the act or practice\nunless:\n\n(a) the complainant and respondent otherwise agree; or\n\n(b) the thing was said or done in furtherance of the commission\nof a fraud or an offence, or the commission of an act that\nrenders a person liable to a civil penalty.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40a"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40a-ss-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40a-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4880f4f122e7091d8a47d8bcb27f03f907a3aed82539c3953872a6e5cadbde83",
      "skos:note": "Complainant and respondent must agree for evidence to be admissible."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-40a-ss-5",
      "@type": "cof:Section",
      "cof:title": "40A(5) Conciliation of complaints",
      "values:kind": "subsection",
      "cof:pageNumber": 190,
      "values:originalText": "(5) Evidence of anything said or done in the course of the conciliation\nis not admissible in any hearing before the Commissioner, or in\nany legal proceedings, relating to complaint or the act or practice\nunless:\n\n(a) the complainant and respondent otherwise agree; or\n\n(b) the thing was said or done in furtherance of the commission\nof a fraud or an offence, or the commission of an act that\nrenders a person liable to a civil penalty."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-40a-ss-5-norm",
