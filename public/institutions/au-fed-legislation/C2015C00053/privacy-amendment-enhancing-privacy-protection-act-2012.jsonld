      }
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6k",
      "@type": "cml:Concept",
      "skos:prefLabel": "6K Acquisition of the rights of a credit provider",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.70",
      "values:originalText": "(1) If:\n\n(a) an organisation or small business operator (the acquirer)\nacquires, whether by assignment, subrogation or any other\nmeans, the rights of a credit provider (the original credit\nprovider) in relation to the repayment of an amount of credit;\nand\n\n(b) the acquirer is not a credit provider under subsection 6G(1);\nthen the acquirer is a credit provider but only in relation to the\ncredit.\n\n(2) If subsection (1) of this section applies in relation to credit that has\nbeen provided by the original credit provider, the credit is taken,\nfor the purposes of this Act, to have been provided by the acquirer.\n\n(3) If subsection (1) of this section applies in relation to credit for\nwhich an application has been made to the original credit provider,\nthe application is taken, for the purposes of this Act, to have been\nmade to the acquirer.\nSubdivision B—Other definitions",
      "skos:definition": "(1) If:\n\n(a) an organisation or small business operator (the acquirer)\nacquires, whether by assignment, subrogation or any other\nmeans, the rights of a credit provider (the original credit\nprovider) in relation to the repayment of an amount of credit;\nand\n\n(b) the acquirer is not a credit provider under subsection 6G(1);\nthen the acquirer is a credit provider but only in relation to the\ncredit.\n\n(2) If subsection (1) of this section applies in relation to credit that has\nbeen provided by the original credit provider, the credit is taken,\nfor the purposes of this Act, to have been provided by the acquirer.\n\n(3) If subsection (1) of this section applies in relation to credit for\nwhich an application has been made to the original credit provider,\nthe application is taken, for the purposes of this Act, to have been\nmade to the acquirer.\nSubdivision B—Other definitions",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6k-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6k-ss-2"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-6k-ss-3"
        }
      ],
      "cml:integrityHash": "0226906a221bd56b43d4ea28ea48a45aced616d0b306b9727da9c1fd5d4c355f"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-6k",
      "@type": "cof:Section",
      "cof:title": "6K Acquisition of the rights of a credit provider",
      "values:kind": "section",
      "cof:pageNumber": 70,
      "values:originalText": "(1) If:\n\n(a) an organisation or small business operator (the acquirer)\nacquires, whether by assignment, subrogation or any other\nmeans, the rights of a credit provider (the original credit\nprovider) in relation to the repayment of an amount of credit;\nand\n\n(b) the acquirer is not a credit provider under subsection 6G(1);\nthen the acquirer is a credit provider but only in relation to the\ncredit.\n\n(2) If subsection (1) of this section applies in relation to credit that has\nbeen provided by the original credit provider, the credit is taken,\nfor the purposes of this Act, to have been provided by the acquirer.\n\n(3) If subsection (1) of this section applies in relation to credit for\nwhich an application has been made to the original credit provider,\nthe application is taken, for the purposes of this Act, to have been\nmade to the acquirer.\nSubdivision B—Other definitions"
    },
