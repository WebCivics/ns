    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-193",
      "@type": "cml:Concept",
      "skos:prefLabel": "193 Paragraph 82(7)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-193"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.211",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) at least one must be a person who has had at least 5 years’\nexperience at a high level in industry or commerce; and\n\n(aa) at least one must be a person who has had at least 5 years’\nexperience at a high level in public administration, or the\nservice of a government or an authority of a government; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(ab) at least one must be a person who has had extensive\nexperience in health privacy; and",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) at least one must be a person who has had at least 5 years’\nexperience at a high level in industry or commerce; and\n\n(aa) at least one must be a person who has had at least 5 years’\nexperience at a high level in public administration, or the\nservice of a government or an authority of a government; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(ab) at least one must be a person who has had extensive\nexperience in health privacy; and",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-193-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-193-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f890ac7345bd4a007d66e9ac9e9e0554234c215f3fddfed6692273e250ddf23a",
      "skos:note": "At least one person must have specific experience in industry, public administration, or health privacy."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-193",
      "@type": "cof:Section",
      "cof:title": "193 Paragraph 82(7)(a)",
      "values:kind": "section",
      "cof:pageNumber": 211,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) at least one must be a person who has had at least 5 years’\nexperience at a high level in industry or commerce; and\n\n(aa) at least one must be a person who has had at least 5 years’\nexperience at a high level in public administration, or the\nservice of a government or an authority of a government; and\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(ab) at least one must be a person who has had extensive\nexperience in health privacy; and"
    },
