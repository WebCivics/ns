        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Omitting the phrase implies the use of an alternative text",
      "cml:conclusionText": "The alternative text is used when the specified phrase is omitted"
    },
    {
