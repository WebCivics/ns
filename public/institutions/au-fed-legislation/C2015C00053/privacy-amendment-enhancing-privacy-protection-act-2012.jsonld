    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26a",
      "@type": "cof:Section",
      "cof:title": "26A APP entities to comply with binding registered APP codes",
      "values:kind": "section",
      "cof:pageNumber": 153,
      "values:originalText": "An APP entity must not do an act, or engage in a practice, that\nbreaches a registered APP code that binds the entity."
