    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "20B(5) Open and transparent management of credit reporting",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20b-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.80",
      "values:originalText": "(5) A credit reporting body must take such steps as are reasonable in\nthe circumstances to make the policy available:\n\n(a) free of charge; and\n\n(b) in such form as is appropriate.\nNote:\nA credit reporting body will usually make the policy available on the\nbody’s website.",
      "skos:definition": "(5) A credit reporting body must take such steps as are reasonable in\nthe circumstances to make the policy available:\n\n(a) free of charge; and\n\n(b) in such form as is appropriate.\nNote:\nA credit reporting body will usually make the policy available on the\nbody’s website.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-5-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "83e2d4299dc814b0e082e16376330eeb32d29244dfd0ee957641c04d010ff9d5",
      "skos:note": "Credit reporting bodies must make the policy available free of charge and in an appropriate form."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20b-ss-5",
      "@type": "cof:Section",
      "cof:title": "20B(5) Open and transparent management of credit reporting",
      "values:kind": "subsection",
      "cof:pageNumber": 80,
      "values:originalText": "(5) A credit reporting body must take such steps as are reasonable in\nthe circumstances to make the policy available:\n\n(a) free of charge; and\n\n(b) in such form as is appropriate.\nNote:\nA credit reporting body will usually make the policy available on the\nbody’s website."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20b-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
