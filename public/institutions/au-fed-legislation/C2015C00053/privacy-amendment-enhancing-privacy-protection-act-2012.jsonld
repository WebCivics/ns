    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21l",
      "@type": "cml:Concept",
      "skos:prefLabel": "21L Permitted CP disclosures to mortgage insurers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.121",
      "values:originalText": "A disclosure by a credit provider of credit eligibility information\nabout an individual is a permitted CP disclosure in relation to the\nindividual if the disclosure is to a mortgage insurer that has an\nAustralian link for:\n\n(a) a mortgage insurance purpose of the insurer in relation to the\nindividual; or\n\n(b) any purpose arising under a contract for mortgage insurance\nthat has been entered into between the provider and the\ninsurer.",
      "skos:definition": "A disclosure by a credit provider of credit eligibility information\nabout an individual is a permitted CP disclosure in relation to the\nindividual if the disclosure is to a mortgage insurer that has an\nAustralian link for:\n\n(a) a mortgage insurance purpose of the insurer in relation to the\nindividual; or\n\n(b) any purpose arising under a contract for mortgage insurance\nthat has been entered into between the provider and the\ninsurer.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21l-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8e91a863710831179d864eb23fd3cceb039b809cb63f1d815e6b955c31951096",
      "skos:note": "Permitted CP disclosures to mortgage insurers"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21l",
      "@type": "cof:Section",
      "cof:title": "21L Permitted CP disclosures to mortgage insurers",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "A disclosure by a credit provider of credit eligibility information\nabout an individual is a permitted CP disclosure in relation to the\nindividual if the disclosure is to a mortgage insurer that has an\nAustralian link for:\n\n(a) a mortgage insurance purpose of the insurer in relation to the\nindividual; or\n\n(b) any purpose arising under a contract for mortgage insurance\nthat has been entered into between the provider and the\ninsurer."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21l-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21l"
      },
