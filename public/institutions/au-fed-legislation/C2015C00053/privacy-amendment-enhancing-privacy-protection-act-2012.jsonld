      },
      "cml:premiseText": "Act or practice done before commencement time.",
      "cml:conclusionText": "Interference with individual privacy."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-19-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Regulations may deal with transitional etc. matters",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-19-2"
      },
      "cml:curationStatus": {
