      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.49",
      "values:originalText": "(a) respond to the request for access to the personal information:\n\n(i) if the entity is an agency—within 30 days after the\nrequest is made; or\n\n(ii) if the entity is an organisation—within a reasonable\nperiod after the request is made; and\n\n(b) give access to the information in the manner requested by the\nindividual, if it is reasonable and practicable to do so.\nOther means of access",
      "skos:definition": "(a) respond to the request for access to the personal information:\n\n(i) if the entity is an agency—within 30 days after the\nrequest is made; or\n\n(ii) if the entity is an organisation—within a reasonable\nperiod after the request is made; and\n\n(b) give access to the information in the manner requested by the\nindividual, if it is reasonable and practicable to do so.\nOther means of access",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-6-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-6-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-6-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "00f03c0d89e8fddf58e79a73b8ce443b9c9493e47033733a3ef736755ebc2d8c",
      "skos:note": "Entity must respond to request for access to personal information within a specified timeframe.",
      "dc:description": "true"
    },
