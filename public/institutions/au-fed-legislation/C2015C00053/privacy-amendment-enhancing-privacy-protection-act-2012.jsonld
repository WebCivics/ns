      "skos:note": "Substitute 'a registered APP code' for 'an approved privacy code'"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-38",
      "@type": "cof:Section",
