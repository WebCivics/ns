          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-12-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-12-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b1576251bc2a660d5f74ad424ec6267dbbdfdaf063a969fcb0898f2360f9983c",
      "skos:note": "Must provide explanation for refusal of access to personal information",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-12-12",
      "@type": "cof:Section",
      "cof:title": "12 Section 12",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "10 If the APP entity refuses to give access to the personal information\nbecause of paragraph 12.3(j), the reasons for the refusal may\ninclude an explanation for the commercially sensitive decision."
    },
