    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Guide to this Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.79",
      "values:originalText": "This Division sets out rules that apply to credit reporting bodies in\nrelation to their handling of the following:\n\n(a)\ncredit reporting information;\n\n(b)\nCP derived information;\n\n(c)\ncredit reporting information that is de-identified;\n\n(d)\na pre-screening assessment.\nThe rules apply in relation to that kind of information or\nassessment instead of the Australian Privacy Principles.",
      "skos:definition": "This Division sets out rules that apply to credit reporting bodies in\nrelation to their handling of the following:\n\n(a)\ncredit reporting information;\n\n(b)\nCP derived information;\n\n(c)\ncredit reporting information that is de-identified;\n\n(d)\na pre-screening assessment.\nThe rules apply in relation to that kind of information or\nassessment instead of the Australian Privacy Principles.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20-2-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20-2-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "6c8e042b3ee0eebc279625b43e8cde50e4251c79844ac7dbff77f670a1dc8b26",
      "skos:note": "Rules for credit reporting bodies regarding handling of specific information and assessments."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-20-2",
      "@type": "cof:Section",
      "cof:title": "20 Guide to this Division",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "This Division sets out rules that apply to credit reporting bodies in\nrelation to their handling of the following:\n\n(a)\ncredit reporting information;\n\n(b)\nCP derived information;\n\n(c)\ncredit reporting information that is de-identified;\n\n(d)\na pre-screening assessment.\nThe rules apply in relation to that kind of information or\nassessment instead of the Australian Privacy Principles."
    },
    {
