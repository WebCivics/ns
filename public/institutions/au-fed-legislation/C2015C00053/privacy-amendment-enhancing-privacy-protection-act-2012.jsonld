    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-5-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Clause 1 of Schedule 1 (definition of personal information)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-5-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
