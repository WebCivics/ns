    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-36a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Individuals have a duty to complain about privacy interference.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An individual may complain to the Commissioner...",
      "cml:conclusionText": "The Commissioner must investigate."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-36a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Entities must comply with determination declarations.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An entity to which a determination relates must comply with certain declarations...",
      "cml:conclusionText": "Entities have a duty to comply with determination declarations."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-36a-logic-linearlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "⇒",
      "cml:logicSummary": "Court proceedings can be commenced to enforce a determination.",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "After an investigation, the Commissioner may make a determination...",
      "cml:conclusionText": "Determination is a basis for court proceedings."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-36a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Commissioner must investigate complaints.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If a complaint is made, the Commissioner is required to investigate...",
      "cml:conclusionText": "The Commissioner has a duty to investigate complaints."
    },
