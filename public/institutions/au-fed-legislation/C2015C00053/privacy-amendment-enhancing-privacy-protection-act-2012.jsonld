    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13e",
      "@type": "cml:Concept",
      "skos:prefLabel": "13E Effect of sections 13B, 13C and 13D",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-13e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.177",
      "values:originalText": "Sections 13B, 13C and 13D do not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under subsection 13(2), (4) or (5).",
      "skos:definition": "Sections 13B, 13C and 13D do not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under subsection 13(2), (4) or (5).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13e-norm"
        }
      ],
      "cml:integrityHash": "96f431d2eddfbedd9fef36b69a626368463e6a7f39bc9407928f335d20923c89",
      "skos:note": "Organisations may still interfere with individual privacy despite sections 13B, 13C and 13D."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-13e",
      "@type": "cof:Section",
      "cof:title": "13E Effect of sections 13B, 13C and 13D",
      "values:kind": "section",
      "cof:pageNumber": 177,
      "values:originalText": "Sections 13B, 13C and 13D do not prevent an act or practice of an\norganisation from being an interference with the privacy of an\nindividual under subsection 13(2), (4) or (5)."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13e-norm",
