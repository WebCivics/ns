          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26h-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aa0e7fc7787efe9f05438ad17c1981c2a06b89ce9172f0b9a9c2f77084a1b49e",
      "skos:note": "Commissioner must give written notice of decision to developer."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26h-ss-3",
      "@type": "cof:Section",
      "cof:title": "26H(3) Commissioner may register APP codes",
      "values:kind": "subsection",
      "cof:pageNumber": 157,
      "values:originalText": "(3) If the Commissioner decides not to register an APP code developed\nby an APP code developer, the Commissioner must give written\nnotice of the decision to the developer, including reasons for the\ndecision.\nSubdivision C—Variation and removal of registered APP codes"
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26h-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26h-ss-3"
