    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-1-sec-4-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 3 If:",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-1-sec-4-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
