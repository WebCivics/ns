    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-21a-ss-3",
      "@type": "cof:Section",
      "cof:title": "21A(3) Application of this Division to credit providers",
      "values:kind": "subsection",
      "cof:pageNumber": 107,
      "values:originalText": "(3) A credit provider must have a clearly expressed and up-to-date\npolicy about the management of credit information and credit\neligibility information by the provider."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-21a-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
