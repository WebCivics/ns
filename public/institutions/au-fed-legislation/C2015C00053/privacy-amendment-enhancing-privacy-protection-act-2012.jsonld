    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-77",
      "@type": "cml:Concept",
      "skos:prefLabel": "77 Subsections 40(1B) and (1C)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-77"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.190",
      "values:originalText": "Repeal the subsections, substitute:\n\n(1B) Subsection (1A) does not apply if the complaint is about an act or\npractice that may breach:\n\n(a) section 20R, 20T, 21T or 21V (which are about access to,\nand correction of, credit reporting information etc.); or\n\n(b) a provision of the registered CR code that relates to that\nsection.",
      "skos:definition": "Repeal the subsections, substitute:\n\n(1B) Subsection (1A) does not apply if the complaint is about an act or\npractice that may breach:\n\n(a) section 20R, 20T, 21T or 21V (which are about access to,\nand correction of, credit reporting information etc.); or\n\n(b) a provision of the registered CR code that relates to that\nsection.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-77-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-77-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c692b960b7724ec8cd2d4f50e2852ed529ca0c73f05d94d7f04d473fc5bf19e2",
      "skos:note": "Repeal subsections and substitute with new provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-77",
      "@type": "cof:Section",
      "cof:title": "77 Subsections 40(1B) and (1C)",
      "values:kind": "section",
      "cof:pageNumber": 190,
      "values:originalText": "Repeal the subsections, substitute:\n\n(1B) Subsection (1A) does not apply if the complaint is about an act or\npractice that may breach:\n\n(a) section 20R, 20T, 21T or 21V (which are about access to,\nand correction of, credit reporting information etc.); or\n\n(b) a provision of the registered CR code that relates to that\nsection."
    },
