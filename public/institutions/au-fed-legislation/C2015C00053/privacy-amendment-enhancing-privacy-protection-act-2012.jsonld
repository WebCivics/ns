    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13g",
      "@type": "cml:Concept",
      "skos:prefLabel": "13G Serious and repeated interferences with privacy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-13g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.177",
      "values:originalText": "An entity contravenes this subsection if:\n\n(a) the entity does an act, or engages in a practice, that is a\nserious interference with the privacy of an individual; or\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the entity repeatedly does an act, or engages in a practice,\nthat is an interference with the privacy of one or more\nindividuals.\nCivil penalty:\n2,000 penalty units.",
      "skos:definition": "An entity contravenes this subsection if:\n\n(a) the entity does an act, or engages in a practice, that is a\nserious interference with the privacy of an individual; or\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the entity repeatedly does an act, or engages in a practice,\nthat is an interference with the privacy of one or more\nindividuals.\nCivil penalty:\n2,000 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13g-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "afad3f05e1ec4a5bb3b7637af28abc5cfe8694f90d5a0435ba00f3655fb4e8ac",
      "skos:note": "Serious and repeated interferences with privacy are prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-4-sec-13g",
      "@type": "cof:Section",
      "cof:title": "13G Serious and repeated interferences with privacy",
      "values:kind": "section",
      "cof:pageNumber": 177,
      "values:originalText": "An entity contravenes this subsection if:\n\n(a) the entity does an act, or engages in a practice, that is a\nserious interference with the privacy of an individual; or\nComLaw Authoritative Act C2015C00053\n\nSchedule 4  Other amendments of the Privacy Act 1988\n\nPrivacy Amendment (Enhancing Privacy Protection) Act 2012\n\nCompilation date: 12/3/14\nRegistered: 6/3/15\n\n(b) the entity repeatedly does an act, or engages in a practice,\nthat is an interference with the privacy of one or more\nindividuals.\nCivil penalty:\n2,000 penalty units."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-4-sec-13g-norm",
