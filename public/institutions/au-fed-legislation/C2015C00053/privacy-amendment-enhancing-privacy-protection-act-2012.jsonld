        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26j-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "40ae4da0ebc510a4e0a7497c61f6180aeaef1d7b3614d0beb02117ba563833fb",
      "skos:note": "Variation of registered APP codes must not deal with exempt acts or practices."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26j-ss-3",
      "@type": "cof:Section",
      "cof:title": "26J(3) Variation of registered APP codes",
      "values:kind": "subsection",
      "cof:pageNumber": 158,
      "values:originalText": "(3) If the Commissioner varies a registered APP code on his or her\nown initiative, then, despite subsection 26C(3)(b), the variation\nmust not deal with an act or practice that is exempt within the\nmeaning of subsection 7B(1), (2) or (3)."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26j-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
