    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-20y-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "20Y(3) Destruction of credit reporting information in cases of fraud",
      "cml:realizedBy": {
