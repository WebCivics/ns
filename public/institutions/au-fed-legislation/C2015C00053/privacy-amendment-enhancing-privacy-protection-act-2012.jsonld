    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-26t-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "26T(6) Variation of the registered CR code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-3-sec-26t-ss-6"
      },
