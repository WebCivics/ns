    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "23C(6) Notification requirements relating to correction complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23c-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.143",
      "values:originalText": "(6) Subsection (2), (3), (4) or (5) does not apply if:\n\n(a) it is impracticable for the credit reporting body or credit\nprovider to give the notification under that subsection; or\n\n(b) the credit reporting body or credit provider is required by or\nunder an Australian law, or a court/tribunal order, not to give\nthe notification under that subsection.",
      "skos:definition": "(6) Subsection (2), (3), (4) or (5) does not apply if:\n\n(a) it is impracticable for the credit reporting body or credit\nprovider to give the notification under that subsection; or\n\n(b) the credit reporting body or credit provider is required by or\nunder an Australian law, or a court/tribunal order, not to give\nthe notification under that subsection.",
      "values:partOf": {
        "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c"
      },
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-6-norm"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-6-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-2-sec-23c-ss-6-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "e834bf99d960e1aba25471061d6c9e0b56e8ce0fdd5f778fbf77fe4785478f0f",
      "skos:note": "Exemption from notification requirements under certain circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-2-sec-23c-ss-6",
      "@type": "cof:Section",
      "cof:title": "23C(6) Notification requirements relating to correction complaints",
      "values:kind": "subsection",
      "cof:pageNumber": 143,
      "values:originalText": "(6) Subsection (2), (3), (4) or (5) does not apply if:\n\n(a) it is impracticable for the credit reporting body or credit\nprovider to give the notification under that subsection; or\n\n(b) the credit reporting body or credit provider is required by or\nunder an Australian law, or a court/tribunal order, not to give\nthe notification under that subsection."
    },
    {
