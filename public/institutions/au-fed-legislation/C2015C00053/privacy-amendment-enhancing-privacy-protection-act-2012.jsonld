      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.151",
      "values:originalText": "For the purposes of this Act, an act or practice breaches the\nregistered CR code if, and only if, it is contrary to, or inconsistent\nwith, the code.",
      "skos:definition": "For the purposes of this Act, an act or practice breaches the\nregistered CR code if, and only if, it is contrary to, or inconsistent\nwith, the code.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-3-sec-6ba-norm"
        },
