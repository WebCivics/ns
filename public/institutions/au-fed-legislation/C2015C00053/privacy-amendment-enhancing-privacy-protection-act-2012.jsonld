    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-17-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Pre-commencement own initiative investigations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-17-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf"
      },
      "dc:source": "privacy-amendment-enhancing-privacy-protection-act-2012.pdf, p.252",
      "values:originalText": "(1)\nThis item applies if:\n\n(a) before the commencement time, the Commissioner\ncommenced an investigation under subsection 40(2) of the\nPrivacy Act; and\n\n(b) immediately before that time, the Commissioner has not\nfinished conducting the investigation.\n(2)\nDespite the amendments of the Privacy Act made by this Act, the\nCommissioner may continue to conduct the investigation under the\nPrivacy Act after the commencement time as if those amendments had\nnot been made.",
      "skos:definition": "(1)\nThis item applies if:\n\n(a) before the commencement time, the Commissioner\ncommenced an investigation under subsection 40(2) of the\nPrivacy Act; and\n\n(b) immediately before that time, the Commissioner has not\nfinished conducting the investigation.\n(2)\nDespite the amendments of the Privacy Act made by this Act, the\nCommissioner may continue to conduct the investigation under the\nPrivacy Act after the commencement time as if those amendments had\nnot been made.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-17-2-norm"
        }
      ],
      "cml:integrityHash": "7e559ef580aedf65d11b571a541a1befd8c156446cfefd3ee4e6db71679cacdd",
      "skos:note": "Commissioner may continue investigation under Privacy Act after commencement time."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-enhancing-privacy-protection-act-2012#sch-6-sec-17-2",
      "@type": "cof:Section",
      "cof:title": "17 Pre-commencement own initiative investigations",
      "values:kind": "section",
      "cof:pageNumber": 252,
      "values:originalText": "(1)\nThis item applies if:\n\n(a) before the commencement time, the Commissioner\ncommenced an investigation under subsection 40(2) of the\nPrivacy Act; and\n\n(b) immediately before that time, the Commissioner has not\nfinished conducting the investigation.\n(2)\nDespite the amendments of the Privacy Act made by this Act, the\nCommissioner may continue to conduct the investigation under the\nPrivacy Act after the commencement time as if those amendments had\nnot been made."
    },
    {
      "@id": "concept:privacy-amendment-enhancing-privacy-protection-act-2012-sch-6-sec-17-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
