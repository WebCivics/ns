    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.19",
      "skos:note": "Citizenship by birth under the new Act applies to persons born on or after the commencement day.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "4 Citizenship by birth under the new Act"
      },
      "wasDerivedFrom": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf",
      "asserts": [
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4-norm",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4-logic-deontic-1",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4-logic-alleninterval-2",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4-logic-ltl-3",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4-logic-diffusion-4",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "1ddd2202c2370b3ce01e06224acb200acdc9a80dd0751b9375ff564187b4065e",
      "cml:proposedBy": {
