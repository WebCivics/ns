      },
      "realizedBy": "doc:australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-4",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The period for which a person has been ordinarily resident in Australia before the commencement day is counted under the new Act during the 10-year period beginning on the day the person was born.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(2) Paragraph 12(1)(b) of the new Act applies to: ... (b) a person born before the commencement day who, immediately before that day, has not been ordinarily resident in Australia throughout the period of 10 years beginning on the day the person was born."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
