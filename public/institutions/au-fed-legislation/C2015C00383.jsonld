    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2",
      "@type": "cml:Concept",
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.18",
      "skos:note": "A person is taken to have been an unlawful non-citizen if they meet certain conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "3 Expanded meaning of some expressions in the new Act"
      },
      "wasDerivedFrom": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf",
      "asserts": [
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-norm",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-deontic-1",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-descriptionlogic-2",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-alleninterval-3",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-ltl-4",
        "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "0b214616c8c494a26cc5613aeb299d33322b3efd1f04ba9c19a70b9b729c76cc",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-3-2",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the periods overlap.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The periods for being an illegal entrant and a prohibited non-citizen overlap with the period before 2 April 1984.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlaps",
      "cml:premiseText": "The person was an illegal entrant at that time within the meaning of the Migration Act 1958 as in force at that time."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the state has an obligation to define these conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The state has an obligation to define the conditions for being an unlawful non-citizen.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "The new Act defines the conditions for being an unlawful non-citizen."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the state has an obligation to define these conditions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The state has an obligation to define the conditions for being a prohibited immigrant.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "The new Act defines the conditions for being a prohibited non-citizen."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the definition of permanent visa is defined by section 3 of the new Act.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "The definition of permanent visa includes a valid permanent entry permit within the meaning of the Migration Act 1958.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "isDefinedBy",
      "cml:premiseText": "Section 3 of the new Act defines permanent visa."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Therefore, the person repeats this behavior.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The person was a prohibited immigrant at that time within the meaning of that Act as in force at that time.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "repeats",
      "cml:premiseText": "The person was a prohibited non-citizen at that time within the meaning of that Act as in force at that time."
    },
