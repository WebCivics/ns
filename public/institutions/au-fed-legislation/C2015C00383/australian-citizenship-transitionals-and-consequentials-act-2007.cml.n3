concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-2-sec-1 a cml:Concept ;
    skos:prefLabel "1 Paragraphs 4D(1)(c) and (d)"@en ;
    cml:realizedBy doc:sch-2-sec-1 ;
