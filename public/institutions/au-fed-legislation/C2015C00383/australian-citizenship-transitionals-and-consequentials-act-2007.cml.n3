concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2 cml:asserts concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-deontic-1 .
concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "hasObligation" ;
    cml:logicSummary "The state has an obligation to define the conditions for being an unlawful non-citizen." ;
    cml:premiseText "The new Act defines the conditions for being an unlawful non-citizen." ;
    cml:conclusionText "Therefore, the state has an obligation to define these conditions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2 cml:asserts concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-descriptionlogic-2 .
concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "isDefinedBy" ;
    cml:logicSummary "The definition of permanent visa includes a valid permanent entry permit within the meaning of the Migration Act 1958." ;
    cml:premiseText "Section 3 of the new Act defines permanent visa." ;
    cml:conclusionText "Therefore, the definition of permanent visa is defined by section 3 of the new Act." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2 cml:asserts concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-alleninterval-3 .
concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "overlaps" ;
    cml:logicSummary "The periods for being an illegal entrant and a prohibited non-citizen overlap with the period before 2 April 1984." ;
    cml:premiseText "The person was an illegal entrant at that time within the meaning of the Migration Act 1958 as in force at that time." ;
    cml:conclusionText "Therefore, the periods overlap." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2 cml:asserts concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-ltl-4 .
concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "repeats" ;
    cml:logicSummary "The person was a prohibited immigrant at that time within the meaning of that Act as in force at that time." ;
    cml:premiseText "The person was a prohibited non-citizen at that time within the meaning of that Act as in force at that time." ;
    cml:conclusionText "Therefore, the person repeats this behavior." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2 cml:asserts concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-deontic-5 .
concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-3-2-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "hasObligation" ;
    cml:logicSummary "The state has an obligation to define the conditions for being a prohibited immigrant." ;
    cml:premiseText "The new Act defines the conditions for being a prohibited non-citizen." ;
    cml:conclusionText "Therefore, the state has an obligation to define these conditions." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-3-sec-3-2 a cof:Section ;
    cof:title "3 Expanded meaning of some expressions in the new Act" ;
    values:kind "section" ;
    values:originalText "Unlawful non-citizen (1) For the purposes of subparagraph 16(2)(b)(i), subsection 19C(3) and paragraphs 22(1)(b) and (6)(a) of the new Act, a person is taken to also have been present in Australia as an unlawful non-citizen at a particular time if the person:  (a) in relation to the period beginning on 19 December 1989 and ending on 31 August 1994—was an illegal entrant at that time within the meaning of the Migration Act 1958 as in force at that time; and  (b) in relation to the period beginning on 2 April 1984 and ending on 18 December 1989—was a prohibited non-citizen at that time within the meaning of that Act as in force at that time; and  (c) in relation to the period before 2 April 1984—was a prohibited immigrant at that time within the meaning of that Act as in force at that time; and  (d) for any time—was in Australia at that time in contravention of a law of Norfolk Island or the Territory of Cocos (Keeling) Islands. Permanent visa (2) For the purposes of the new Act, the definition of permanent visa in section 3 of the new Act includes a valid permanent entry permit within the meaning of the Migration Act 1958 as in force immediately before" ;
    cof:pageNumber "18"^^xsd:integer .

concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-1-5 a cml:Concept ;
    skos:prefLabel "1 September 1994."@en ;
    cml:realizedBy doc:sch-3-sec-1-5 ;
    values:originalText "Visa (3) For the purposes of the new Act, the definition of visa in section 3 of the new Act includes: ComLaw Authoritative Act C2015C00383  Application and transitional provisions  Schedule 3 Provisions relating to the enactment of the Australian Citizenship Act 2007  Part 1  Australian Citizenship (Transitionals and Consequentials) Act 2007 Compilation date: 1/7/15 Registered: 10/8/15  (a) a valid entry permit within the meaning of the Migration Act 1958 as in force immediately before 1 September 1994; and  (b) a valid visa within the meaning of that Act as in force immediately before 1 September 1994. Defence service (4) For the purposes of section 23 of the new Act:  (a) service in the permanent forces of the Commonwealth includes service because of a notice under section 26 of the National Service Act 1951 as in force at any time before" ;
    skos:definition "Visa (3) For the purposes of the new Act, the definition of visa in section 3 of the new Act includes: ComLaw Authoritative Act C2015C00383  Application and transitional provisions  Schedule 3 Provisions relating to the enactment of the Australian Citizenship Act 2007  Part 1  Australian Citizenship (Transitionals and Consequentials) Act 2007 Compilation date: 1/7/15 Registered: 10/8/15  (a) a valid entry permit within the meaning of the Migration Act 1958 as in force immediately before 1 September 1994; and  (b) a valid visa within the meaning of that Act as in force immediately before 1 September 1994. Defence service (4) For the purposes of section 23 of the new Act:  (a) service in the permanent forces of the Commonwealth includes service because of a notice under section 26 of the National Service Act 1951 as in force at any time before"@en ;
    cml:integrityHash "913059c8a6f817c1cb42f7cb0dae563d501d0994cba4a309bba1b91a983fb218" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Definition of visa includes valid entry permit and valid visa as in force before September 1994." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-transitionals-and-consequentials-act-2007.pdf> ;
    dc:source "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.18" ;
