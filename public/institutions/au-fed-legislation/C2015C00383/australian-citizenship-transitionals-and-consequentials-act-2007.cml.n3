concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-1-4 a cml:Concept ;
    skos:prefLabel "1 Definitions"@en ;
    cml:realizedBy doc:sch-3-sec-1-4 ;
    values:originalText "In this Part: commencement day means the day on which sections 2A to 54 of the Australian Citizenship Act 2007 commence. new Act means the Australian Citizenship Act 2007. old Act means the Australian Citizenship Act 1948 as in force at any time before the commencement day." ;
    skos:definition "In this Part: commencement day means the day on which sections 2A to 54 of the Australian Citizenship Act 2007 commence. new Act means the Australian Citizenship Act 2007. old Act means the Australian Citizenship Act 1948 as in force at any time before the commencement day."@en ;
    cml:integrityHash "0a8cbacd275340da3b5390ed9241e591bf305e8e01b24205d3fd531f021a5727" ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Defines terms for the Act" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
