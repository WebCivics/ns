    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-5a",
      "@type": "cml:Concept",
      "skos:prefLabel": "5A Citizenship for persons adopted in accordance with the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-5a"
      },
