      "skos:note": "Definition of visa includes valid entry permit and valid visa as in force before September 1994."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-1-5",
      "@type": "cof:Section",
