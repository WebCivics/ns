        }
      ],
      "cml:integrityHash": "69967d8be2cdb922ee6d87b00cc9457098aa85804a556128274c703edcf44ce5",
      "skos:note": "General residence requirement for permanent residents"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-5b-ss-1",
      "@type": "cof:Section",
      "cof:title": "5B(1) Citizenship by conferral—persons who are permanent",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(1) For the purposes of section 21, a person satisfies the general\nresidence requirement if the person has been present in Australia\nas a permanent resident for:\n\n(a) a total period of at least 1 year in the period of 2 years before\nthe day the person made the application; and\n\n(b) a total period of at least 2 years in the period of 5 years\nbefore that day."
    },
