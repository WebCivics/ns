    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Citizenship by descent and conferral under the new Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.19",
      "values:originalText": "Subsections 17(5) and 24(7) of the new Act apply as if a reference to a\nperson ceasing to be an Australian citizen included a reference to a\nperson ceasing to be an Australian citizen under the old Act.\nNote:\nThe effect of this item is that if a person ceases to be an Australian citizen under the old\nAct, the person cannot become an Australian citizen under Subdivision A or B of\nDivision 2 of Part 2 of the new Act for at least 12 months.\nComLaw Authoritative Act C2015C00383\n\nSchedule 3  Application and transitional provisions",
      "skos:definition": "Subsections 17(5) and 24(7) of the new Act apply as if a reference to a\nperson ceasing to be an Australian citizen included a reference to a\nperson ceasing to be an Australian citizen under the old Act.\nNote:\nThe effect of this item is that if a person ceases to be an Australian citizen under the old\nAct, the person cannot become an Australian citizen under Subdivision A or B of\nDivision 2 of Part 2 of the new Act for at least 12 months.\nComLaw Authoritative Act C2015C00383\n\nSchedule 3  Application and transitional provisions",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-5-norm"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-5-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-5-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-5-logic-ltl-3"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-5-logic-deontic-4"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-5-logic-argumentation-5"
        }
      ],
      "cml:integrityHash": "b9f0fa8fe9e9125ebffaf9e3fa01483d0b3b2a0b329f15e16e76b91e45c9f4d0",
      "skos:note": "Cannot become an Australian citizen under Subdivision A or B of Division 2 of Part 2 of the new Act for at least 12 months if ceasing to be an Australian citizen under the old Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Citizenship by descent and conferral under the new Act",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Subsections 17(5) and 24(7) of the new Act apply as if a reference to a\nperson ceasing to be an Australian citizen included a reference to a\nperson ceasing to be an Australian citizen under the old Act.\nNote:\nThe effect of this item is that if a person ceases to be an Australian citizen under the old\nAct, the person cannot become an Australian citizen under Subdivision A or B of\nDivision 2 of Part 2 of the new Act for at least 12 months.\nComLaw Authoritative Act C2015C00383\n\nSchedule 3  Application and transitional provisions"
    },
    {
