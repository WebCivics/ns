      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.13",
      "values:originalText": "Repeal the definition, substitute:\nAustralian citizen has the same meaning as in the Australian\nCitizenship Act 2007.\nComLaw Authoritative Act C2015C00383\n\nSchedule 1  Consequential amendments",
      "skos:definition": "Repeal the definition, substitute:\nAustralian citizen has the same meaning as in the Australian\nCitizenship Act 2007.\nComLaw Authoritative Act C2015C00383\n\nSchedule 1  Consequential amendments",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-1-sec-40-norm"
        }
      ],
      "cml:integrityHash": "8fd7f0f8699250215027fb8576fea66bd3d9a0be0a63fc43a1edac4742e60b2d",
      "skos:note": "Repeal and substitute definition of Australian citizen with reference to the Australian Citizenship Act 2007."
    },
