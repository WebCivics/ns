    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Application—Age Discrimination Act 2004",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-16"
      },
      "cml:curationStatus": {
