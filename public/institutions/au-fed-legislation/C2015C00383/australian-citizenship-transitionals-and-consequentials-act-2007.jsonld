    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Transitional regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.26",
      "values:originalText": "The Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to:\n\n(a) the amendments or repeals made by this Act; or\n\n(b) the enactment of this Act or the new Act.\nComLaw Authoritative Act C2015C00383\n\nApplication and transitional provisions  Schedule 3\nProvisions relating to the amendments made by Schedules 1 and 2 to this Act  Part 2\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15",
      "skos:definition": "The Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to:\n\n(a) the amendments or repeals made by this Act; or\n\n(b) the enactment of this Act or the new Act.\nComLaw Authoritative Act C2015C00383\n\nApplication and transitional provisions  Schedule 3\nProvisions relating to the amendments made by Schedules 1 and 2 to this Act  Part 2\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-13-norm"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ac2bfea7de8d18d43354fa12d7fb6c2c9e4d4c3dcd94b329afb14652fca2ae8a",
      "skos:note": "Governor-General may make regulations for transitional matters"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Transitional regulations",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "The Governor-General may make regulations prescribing matters of a\ntransitional nature (including prescribing any saving or application\nprovisions) relating to:\n\n(a) the amendments or repeals made by this Act; or\n\n(b) the enactment of this Act or the new Act.\nComLaw Authoritative Act C2015C00383\n\nApplication and transitional provisions  Schedule 3\nProvisions relating to the amendments made by Schedules 1 and 2 to this Act  Part 2\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15"
    },
    {
