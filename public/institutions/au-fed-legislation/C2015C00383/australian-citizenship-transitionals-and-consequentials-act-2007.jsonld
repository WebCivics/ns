      },
      "cml:operator": "=",
      "cml:logicSummary": "Definition of military service",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) service in the Naval Reserve, the Army Reserve or Air Force Reserve includes service in any reserve force that is a predecessor (whether immediate or otherwise) of the Naval Reserve, the Army Reserve or Air Force Reserve.",
      "cml:conclusionText": "Service in reserve forces is included in military service."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-26-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Definition of military service",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) service in the Naval Reserve, the Army Reserve or Air Force Reserve includes service in any reserve force that is a predecessor (whether immediate or otherwise) of the Naval Reserve, the Army Reserve or Air Force Reserve.",
      "cml:conclusionText": "Service in reserve forces is included in military service."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-26-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Temporal inclusion",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) service in the Naval Reserve, the Army Reserve or Air Force Reserve includes service in any reserve force that is a predecessor (whether immediate or otherwise) of the Naval Reserve, the Army Reserve or Air Force Reserve.",
      "cml:conclusionText": "Service in reserve forces is included in military service during the same period as the preceding reserve force."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-26-logic-ltl-4",
      "@type": "cml:LogicApplication",
