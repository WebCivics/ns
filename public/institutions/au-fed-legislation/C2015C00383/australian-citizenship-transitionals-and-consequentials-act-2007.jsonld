    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-1-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-1-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.17",
      "values:originalText": "In this Part:\ncommencement day means the day on which sections 2A to 54 of the\nAustralian Citizenship Act 2007 commence.\nnew Act means the Australian Citizenship Act 2007.\nold Act means the Australian Citizenship Act 1948 as in force at any\ntime before the commencement day.",
      "skos:definition": "In this Part:\ncommencement day means the day on which sections 2A to 54 of the\nAustralian Citizenship Act 2007 commence.\nnew Act means the Australian Citizenship Act 2007.\nold Act means the Australian Citizenship Act 1948 as in force at any\ntime before the commencement day.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-1-4-norm"
        }
      ],
      "cml:integrityHash": "0a8cbacd275340da3b5390ed9241e591bf305e8e01b24205d3fd531f021a5727",
      "skos:note": "Defines terms for the Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-1-4",
      "@type": "cof:Section",
      "cof:title": "1 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "In this Part:\ncommencement day means the day on which sections 2A to 54 of the\nAustralian Citizenship Act 2007 commence.\nnew Act means the Australian Citizenship Act 2007.\nold Act means the Australian Citizenship Act 1948 as in force at any\ntime before the commencement day."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-1-4-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
