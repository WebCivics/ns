      },
      "cml:operator": "=",
      "cml:logicSummary": "Temporal inclusion",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) service in the Naval Reserve, the Army Reserve or Air Force Reserve includes service in any reserve force that is a predecessor (whether immediate or otherwise) of the Naval Reserve, the Army Reserve or Air Force Reserve.",
      "cml:conclusionText": "Service in reserve forces is included in military service during the preceding period as well."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-26-logic-diffusion-5",
