    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Continuation of criminal proceedings under the old Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.26",
      "values:originalText": "Despite the repeal of the old Act made by item 42 of Schedule 1, the old\nAct continues to apply on and after the commencement day, in relation\nto criminal proceedings that began before that day under the old Act, as\nif that repeal had not been made.",
      "skos:definition": "Despite the repeal of the old Act made by item 42 of Schedule 1, the old\nAct continues to apply on and after the commencement day, in relation\nto criminal proceedings that began before that day under the old Act, as\nif that repeal had not been made.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-11-norm"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9850bc2e70901a0f1e77be96853dd578fbbd15410032aadfa4d17527217f9be1",
      "skos:note": "Continues application of old Act to criminal proceedings before commencement day"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Continuation of criminal proceedings under the old Act",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Despite the repeal of the old Act made by item 42 of Schedule 1, the old\nAct continues to apply on and after the commencement day, in relation\nto criminal proceedings that began before that day under the old Act, as\nif that repeal had not been made."
    },
