      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.27",
      "values:originalText": "In this Part:\ncommencement day means the day on which sections 2A to 54 of the\nAustralian Citizenship Act 2007 commence.",
      "skos:definition": "In this Part:\ncommencement day means the day on which sections 2A to 54 of the\nAustralian Citizenship Act 2007 commence.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-14-norm"
        }
      ],
      "cml:integrityHash": "1515c879025a36f786b9ecd5aa363fff884d90bd462955d745e5ad22b6d55f4f",
      "skos:note": "Defines commencement day as the day sections 2A to 54 of the Australian Citizenship Act 2007 commence."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Definition",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "In this Part:\ncommencement day means the day on which sections 2A to 54 of the\nAustralian Citizenship Act 2007 commence."
    },
