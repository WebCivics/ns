    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-1-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Subsection 41(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-1-sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.12",
      "values:originalText": "Omit “a certificate of Australian citizenship under section 13 of the\nAustralian Citizenship Act 1948 and who has yet to make the pledge\nreferred to in section 15”, substitute “an approval to become an\nAustralian citizen under section 24 of the Australian Citizenship Act\n2007 and who has yet to make the pledge referred to in section 26”.\nComLaw Authoritative Act C2015C00383\n\nConsequential amendments  Schedule 1\nAmendments  Part 1\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15",
      "skos:definition": "Omit “a certificate of Australian citizenship under section 13 of the\nAustralian Citizenship Act 1948 and who has yet to make the pledge\nreferred to in section 15”, substitute “an approval to become an\nAustralian citizen under section 24 of the Australian Citizenship Act\n2007 and who has yet to make the pledge referred to in section 26”.\nComLaw Authoritative Act C2015C00383\n\nConsequential amendments  Schedule 1\nAmendments  Part 1\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-1-sec-34-norm"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-1-sec-34-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "95d4b8e021399203ef60f0d8d781d1d6c0a3cdb04a133244fdd4de4a37dc5a9f",
      "skos:note": "Substitute an approval to become an Australian citizen under section 24 of the Australian Citizenship Act 2007"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-1-sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Subsection 41(3)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Omit “a certificate of Australian citizenship under section 13 of the\nAustralian Citizenship Act 1948 and who has yet to make the pledge\nreferred to in section 15”, substitute “an approval to become an\nAustralian citizen under section 24 of the Australian Citizenship Act\n2007 and who has yet to make the pledge referred to in section 26”.\nComLaw Authoritative Act C2015C00383\n\nConsequential amendments  Schedule 1\nAmendments  Part 1\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15"
    },
