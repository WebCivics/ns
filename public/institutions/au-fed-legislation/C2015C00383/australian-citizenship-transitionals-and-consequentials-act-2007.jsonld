    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-21-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "applies to",
      "cml:logicSummary": "The amendment applies in relation to a person.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 4C of the Immigration (Education) Act 1971",
      "cml:conclusionText": "An obligation under section 4C begins on or after the commencement day."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-21-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "applies to",
      "cml:logicSummary": "The amendment applies in relation to a person in respect of which an obligation under section 4C begins on or after the commencement day.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 4C of the Immigration (Education) Act 1971",
      "cml:conclusionText": "An obligation under section 4C has not ceased before the commencement day."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-21-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "applies to",
      "cml:logicSummary": "The amendment applies in relation to a person in respect of which an obligation under section 4C began before the commencement day but only if that obligation has not ceased before the commencement day.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 4C of the Immigration (Education) Act 1971",
      "cml:conclusionText": "An obligation under section 4C has not ceased before the commencement day."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-21-logic-linearlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "applies to",
      "cml:logicSummary": "The amendment applies in relation to a person in respect of which an obligation under section 4C begins on or after the commencement day.",
