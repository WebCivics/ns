      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.27",
      "values:originalText": "The amendment made by item 2 of Schedule 1 applies in relation to\nthings done by a person on or after the commencement day.",
      "skos:definition": "The amendment made by item 2 of Schedule 1 applies in relation to\nthings done by a person on or after the commencement day.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-16-norm"
        }
      ],
      "cml:integrityHash": "6e8dfab7c67f4e33b67e5fd881a9510e21283cba6844d0d7dcc562d193dee801",
      "skos:note": "Amendment applies in relation to things done on or after commencement day."
