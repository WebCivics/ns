    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Review of decisions made under the old Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.26",
      "values:originalText": "Despite the repeal of the old Act made by item 42 of Schedule 1,\nsection 52A of the old Act continues to apply in relation to a decision\nmade under that Act, as if that repeal had not been made.",
      "skos:definition": "Despite the repeal of the old Act made by item 42 of Schedule 1,\nsection 52A of the old Act continues to apply in relation to a decision\nmade under that Act, as if that repeal had not been made.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-10-norm"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1444ed11b46dd240524159b6ef0a16821c64556d9b87229bfb3587d7c2015995",
      "skos:note": "Continuation of old Act's section 52A despite repeal"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Review of decisions made under the old Act",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Despite the repeal of the old Act made by item 42 of Schedule 1,\nsection 52A of the old Act continues to apply in relation to a decision\nmade under that Act, as if that repeal had not been made."
    },
