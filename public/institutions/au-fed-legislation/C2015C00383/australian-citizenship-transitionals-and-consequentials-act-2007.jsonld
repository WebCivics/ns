      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continuation",
      "cml:logicSummary": "Certificate validity continues from old Act to new Act.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Children of persons who lost or were deprived of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.26",
      "values:originalText": "citizenship under the old Act\n(1)\nIf, immediately before the commencement day, paragraph 23(3)(c) of\nthe old Act has prevented the application of subsection 23(1) or (2) of\nthe old Act in relation to a child, then, on and from the commencement\nday, section 36 of the new Act is taken to apply in relation to the child.\n(2)\nFor this purpose, the reference to the cessation time in subsection 36(2)\nof the new Act is taken to be a reference to the commencement day and\nthere is taken to be a responsible parent of the child who is an\nAustralian citizen on that day.",
      "skos:definition": "citizenship under the old Act\n(1)\nIf, immediately before the commencement day, paragraph 23(3)(c) of\nthe old Act has prevented the application of subsection 23(1) or (2) of\nthe old Act in relation to a child, then, on and from the commencement\nday, section 36 of the new Act is taken to apply in relation to the child.\n(2)\nFor this purpose, the reference to the cessation time in subsection 36(2)\nof the new Act is taken to be a reference to the commencement day and\nthere is taken to be a responsible parent of the child who is an\nAustralian citizen on that day.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-9-norm"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-9-logic-deontic-1"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-9-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-9-logic-ltl-3"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-9-logic-deontic-4"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-9-logic-argumentation-5"
        }
      ],
      "cml:integrityHash": "fd434fd169e1d7c0d92bcf5cac93e16644bb528eec3007852feed3e29b5b4d08",
      "skos:note": "If paragraph 23(3)(c) of the old Act prevents application of subsection 23(1) or (2), section 36 of the new Act applies."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Children of persons who lost or were deprived of",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "citizenship under the old Act\n(1)\nIf, immediately before the commencement day, paragraph 23(3)(c) of\nthe old Act has prevented the application of subsection 23(1) or (2) of\nthe old Act in relation to a child, then, on and from the commencement\nday, section 36 of the new Act is taken to apply in relation to the child.\n(2)\nFor this purpose, the reference to the cessation time in subsection 36(2)\nof the new Act is taken to be a reference to the commencement day and\nthere is taken to be a responsible parent of the child who is an\nAustralian citizen on that day."
    },
    {
