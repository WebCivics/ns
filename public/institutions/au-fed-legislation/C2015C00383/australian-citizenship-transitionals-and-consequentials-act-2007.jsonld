      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.16",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(c) if the person fails to commence an approved English course\nwithin the period of 12 months starting on the visa\ncommencement date.\nComLaw Authoritative Act C2015C00383\n\nApplication and transitional provisions  Schedule 3\nProvisions relating to the enactment of the Australian Citizenship Act 2007  Part 1\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(c) if the person fails to commence an approved English course\nwithin the period of 12 months starting on the visa\ncommencement date.\nComLaw Authoritative Act C2015C00383\n\nApplication and transitional provisions  Schedule 3\nProvisions relating to the enactment of the Australian Citizenship Act 2007  Part 1\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-2-sec-1-norm"
        },
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-2-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2fe48c3eec5dbf891e8ac3cc61e446609a025058fc08471d395191fc1a64aa3a",
      "skos:note": "Fail to commence an approved English course within 12 months of visa commencement date."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Paragraphs 4D(1)(c) and (d)",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(c) if the person fails to commence an approved English course\nwithin the period of 12 months starting on the visa\ncommencement date.\nComLaw Authoritative Act C2015C00383\n\nApplication and transitional provisions  Schedule 3\nProvisions relating to the enactment of the Australian Citizenship Act 2007  Part 1\n\nAustralian Citizenship (Transitionals and Consequentials) Act 2007\nCompilation date: 1/7/15\nRegistered: 10/8/15"
    },
