      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Application—Electronic Transactions Act 1999",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.27",
      "values:originalText": "The amendment made by item 27 of Schedule 1 applies in relation to\ndocuments required or permitted to be produced on or after the\ncommencement day.\nComLaw Authoritative Act C2015C00383\n\nSchedule 3  Application and transitional provisions",
      "skos:definition": "The amendment made by item 27 of Schedule 1 applies in relation to\ndocuments required or permitted to be produced on or after the\ncommencement day.\nComLaw Authoritative Act C2015C00383\n\nSchedule 3  Application and transitional provisions",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-20-norm"
        }
      ],
      "cml:integrityHash": "7fa38f344f8a01327c2d631c6299a4b9a7a4fd705c351ac1896ba1bb96202231",
      "skos:note": "Application of amendment made by item 27 of Schedule 1"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Application—Electronic Transactions Act 1999",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "The amendment made by item 27 of Schedule 1 applies in relation to\ndocuments required or permitted to be produced on or after the\ncommencement day.\nComLaw Authoritative Act C2015C00383\n\nSchedule 3  Application and transitional provisions"
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-20-norm",
