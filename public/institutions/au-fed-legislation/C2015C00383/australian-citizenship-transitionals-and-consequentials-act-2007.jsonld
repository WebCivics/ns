    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Transitional—Criminal Code Act 1995",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.27",
      "values:originalText": "(1)\nA certificate in force under subsection 72.8(2) of the Criminal Code\nimmediately before the commencement day has effect on and after that\nday as if it were a certificate issued under that subsection on that day.\n(2)\nA certificate in force under subsection 115.7(1) of the Criminal Code\n(in relation to paragraph 115.7(1)(a) of the Criminal Code) immediately\nbefore the commencement day has effect on and after that day as if it\nwere a certificate issued under that subsection on that day.",
      "skos:definition": "(1)\nA certificate in force under subsection 72.8(2) of the Criminal Code\nimmediately before the commencement day has effect on and after that\nday as if it were a certificate issued under that subsection on that day.\n(2)\nA certificate in force under subsection 115.7(1) of the Criminal Code\n(in relation to paragraph 115.7(1)(a) of the Criminal Code) immediately\nbefore the commencement day has effect on and after that day as if it\nwere a certificate issued under that subsection on that day.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-19-norm"
        }
      ],
      "cml:integrityHash": "46a734e1b19831dc29c0b0be256d4756113b37834e5d536e528c3791068ef6f4",
      "skos:note": "Transitional provision for certificates under Criminal Code Act 1995"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Transitional—Criminal Code Act 1995",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "(1)\nA certificate in force under subsection 72.8(2) of the Criminal Code\nimmediately before the commencement day has effect on and after that\nday as if it were a certificate issued under that subsection on that day.\n(2)\nA certificate in force under subsection 115.7(1) of the Criminal Code\n(in relation to paragraph 115.7(1)(a) of the Criminal Code) immediately\nbefore the commencement day has effect on and after that day as if it\nwere a certificate issued under that subsection on that day."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-19-norm",
      "@type": "values:Undertaking",
