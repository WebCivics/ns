    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Section 8 of the Acts Interpretation Act 1901",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf"
      },
      "dc:source": "australian-citizenship-transitionals-and-consequentials-act-2007.pdf, p.26",
      "values:originalText": "This Part does not limit the operation of section 8 of the Acts\nInterpretation Act 1901 in relation to the repeal of the old Act.",
      "skos:definition": "This Part does not limit the operation of section 8 of the Acts\nInterpretation Act 1901 in relation to the repeal of the old Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-12-norm"
        }
      ],
      "cml:integrityHash": "1a236b720dedcf3394debd89c0915ff2757acbd70442e51bcc21f9deb3ab9b26",
      "skos:note": "Does not limit operation of section 8 in relation to repeal"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-transitionals-and-consequentials-act-2007#sch-3-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Section 8 of the Acts Interpretation Act 1901",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "This Part does not limit the operation of section 8 of the Acts\nInterpretation Act 1901 in relation to the repeal of the old Act."
    },
    {
      "@id": "concept:australian-citizenship-transitionals-and-consequentials-act-2007-sch-3-sec-12-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
