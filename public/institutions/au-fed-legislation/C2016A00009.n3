    cml:modality cml:Deontic ;
    cml:operator "obligation" ;
    cml:logicSummary "Obligation to comply with infringement notice." ;
    cml:premiseText "(1) This section applies if:  (a) an infringement notice for an alleged contravention of section 55B is issued to a person; and  (b) the person pays the penalty specified in the infringement notice within the infringement notice compliance period and in accordance with the notice; and  (c) the infringement notice is not withdrawn under section 55N." ;
    cml:conclusionText "(1) This section applies if:  (a) an infringement notice for an alleged contravention of section 55B is issued to a person; and  (b) the person pays the penalty specified in the infringement notice within the infringement notice compliance period and in accordance with the notice; and  (c) the infringement notice is not withdrawn under section 55N." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


