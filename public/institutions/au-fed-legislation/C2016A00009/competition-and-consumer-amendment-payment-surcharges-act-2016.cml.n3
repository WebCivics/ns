doc:sch-1-sec-55n-ss-4 a cof:Section ;
    cof:title "55N(4) Withdrawal of an infringement notice" ;
    values:kind "subsection" ;
    values:originalText "(4) Subsection (3) applies whether or not the person has made representations seeking the withdrawal. Content of withdrawal notices" ;
    cof:pageNumber "13"^^xsd:integer .

concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55n-ss-5 a cml:Concept ;
    skos:prefLabel "55N(5) Withdrawal of an infringement notice"@en ;
    cml:realizedBy doc:sch-1-sec-55n-ss-5 ;
    values:originalText "(5) The withdrawal notice must state:  (a) the name and address of the person; and  (b) the day on which the infringement notice was issued to the person; and  (c) that the infringement notice is withdrawn; and  (d) that proceedings under section 76 may be started or continued against the person in relation to the alleged contravention of section 55B. Time limit for giving withdrawal notices" ;
    skos:definition "(5) The withdrawal notice must state:  (a) the name and address of the person; and  (b) the day on which the infringement notice was issued to the person; and  (c) that the infringement notice is withdrawn; and  (d) that proceedings under section 76 may be started or continued against the person in relation to the alleged contravention of section 55B. Time limit for giving withdrawal notices"@en ;
    cml:integrityHash "e2db0e235366c3ef9e14c0d10c08d2225baf8fccc6c3492d8f39e3d6c633b51e" ;
    values:partOf concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55n ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Withdrawal notice must state certain information." ;
    dc:description "Time limit for giving withdrawal notices" ;
