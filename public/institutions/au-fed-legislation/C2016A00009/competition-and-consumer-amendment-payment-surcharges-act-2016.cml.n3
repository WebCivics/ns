doc:sch-1-sec-55k-ss-2 a cof:Section ;
    cof:title "55K(2) Effect of compliance with an infringement notice" ;
    values:kind "subsection" ;
    values:originalText "(2) The person is not, merely because of the payment, regarded as having contravened section 55B." ;
    cof:pageNumber "12"^^xsd:integer .

concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55k-ss-3 a cml:Concept ;
    skos:prefLabel "55K(3) Effect of compliance with an infringement notice"@en ;
    cml:realizedBy doc:sch-1-sec-55k-ss-3 ;
    values:originalText "(3) No proceedings (whether criminal or civil) may be started or continued against the person, by or on behalf of the Commonwealth, in relation to the alleged contravention of section 55B." ;
    skos:definition "(3) No proceedings (whether criminal or civil) may be started or continued against the person, by or on behalf of the Commonwealth, in relation to the alleged contravention of section 55B."@en ;
