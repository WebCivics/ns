concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55n-ss-7 a cml:Concept ;
    skos:prefLabel "55N(7) Withdrawal of an infringement notice"@en ;
    cml:realizedBy doc:sch-1-sec-55n-ss-7 ;
    values:originalText "(7) If the infringement notice is withdrawn after the person has paid the penalty specified in the infringement notice, the Commission must refund to the person an amount equal to the amount paid. ComLaw Authoritative Act C2016A00009  Amendments  Schedule 1  No. 9, 2016 Competition and Consumer Amendment (Payment Surcharges) Act" ;
    skos:definition "(7) If the infringement notice is withdrawn after the person has paid the penalty specified in the infringement notice, the Commission must refund to the person an amount equal to the amount paid. ComLaw Authoritative Act C2016A00009  Amendments  Schedule 1  No. 9, 2016 Competition and Consumer Amendment (Payment Surcharges) Act"@en ;
    cml:integrityHash "cb2cf60f87ff5d2ce72755c2e9a74f10c1bf678c1a25c42c9f0c007c52f08b32" ;
    values:partOf concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55n ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Commission must refund amount paid if infringement notice is withdrawn after payment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-payment-surcharges-act-2016.pdf> ;
