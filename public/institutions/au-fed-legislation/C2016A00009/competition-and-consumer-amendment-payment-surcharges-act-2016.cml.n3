doc:sch-1-sec-55e-ss-1 a cof:Section ;
    cof:title "55E(1) Participant must comply with notice" ;
    values:kind "subsection" ;
    values:originalText "(1) A surcharge participant commits an offence if:  (a) the surcharge participant is given a surcharge information notice; and  (b) the surcharge participant fails to comply with the notice within the period for so complying. Penalty: 30 penalty units." ;
    cof:pageNumber "10"^^xsd:integer .

concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55e-ss-2 a cml:Concept ;
    skos:prefLabel "55E(2) Participant must comply with notice"@en ;
    cml:realizedBy doc:sch-1-sec-55e-ss-2 ;
    values:originalText "(2) Subsection (1) is an offence of strict liability. Note: Sections 137.1 and 137.2 of the Criminal Code create offences for providing false or misleading information or documents." ;
    skos:definition "(2) Subsection (1) is an offence of strict liability. Note: Sections 137.1 and 137.2 of the Criminal Code create offences for providing false or misleading information or documents."@en ;
