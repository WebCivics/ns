concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55 a cml:Concept ;
    skos:prefLabel "55 Object of this Part"@en ;
    cml:realizedBy doc:sch-1-sec-55 ;
    values:originalText "The object of this Part is to ensure that payment surcharges:  (a) are not excessive; and  (b) reflect the cost of using the payment methods for which they are charged." ;
    skos:definition "The object of this Part is to ensure that payment surcharges:  (a) are not excessive; and  (b) reflect the cost of using the payment methods for which they are charged."@en ;
    cml:integrityHash "0581bd7573e1816ded315a4edcc231114b31ee0bd658dea2fff934ade073bfb9" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Payment surcharges should not be excessive and reflect the cost of using payment methods." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-payment-surcharges-act-2016.pdf> ;
