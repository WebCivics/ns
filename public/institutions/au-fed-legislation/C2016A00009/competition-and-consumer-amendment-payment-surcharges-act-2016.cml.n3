concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55d a cml:Concept ;
    skos:prefLabel "55D Extending periods for complying with notices"@en ;
    cml:realizedBy doc:sch-1-sec-55d ;
    values:originalText "(1) A surcharge participant that has been given a notice under section 55C may, at any time within 21 days after the notice was given to the participant, apply in writing to the Commission for an extension of the period for complying with the notice.  (2) The Commission may, by written notice given to the surcharge participant, extend the period within which the participant must comply with the notice." ;
    skos:definition "(1) A surcharge participant that has been given a notice under section 55C may, at any time within 21 days after the notice was given to the participant, apply in writing to the Commission for an extension of the period for complying with the notice.  (2) The Commission may, by written notice given to the surcharge participant, extend the period within which the participant must comply with the notice."@en ;
    cml:integrityHash "6cbce72e268e224e2d0948d027b737a6f517aa8e346cf3413c6023c681fe90f3" ;
    cof:pageNumber "10"^^xsd:integer ;
