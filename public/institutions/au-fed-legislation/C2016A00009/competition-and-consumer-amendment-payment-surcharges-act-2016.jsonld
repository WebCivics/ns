    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.8",
      "values:originalText": "The object of this Part is to ensure that payment surcharges:\n\n(a) are not excessive; and\n\n(b) reflect the cost of using the payment methods for which they\nare charged.",
      "skos:definition": "The object of this Part is to ensure that payment surcharges:\n\n(a) are not excessive; and\n\n(b) reflect the cost of using the payment methods for which they\nare charged.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0581bd7573e1816ded315a4edcc231114b31ee0bd658dea2fff934ade073bfb9",
      "skos:note": "Payment surcharges should not be excessive and reflect the cost of using payment methods."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55",
      "@type": "cof:Section",
      "cof:title": "55 Object of this Part",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "The object of this Part is to ensure that payment surcharges:\n\n(a) are not excessive; and\n\n(b) reflect the cost of using the payment methods for which they\nare charged."
    },
    {
