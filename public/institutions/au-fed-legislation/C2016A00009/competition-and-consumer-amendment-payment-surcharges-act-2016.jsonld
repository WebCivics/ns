      "cml:premiseText": "(2) A payment surcharge is excessive if...",
      "cml:conclusionText": "...the amount of the surcharge exceeds the permitted surcharge"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55b-ss-2-logic-descriptionlogic-2",
