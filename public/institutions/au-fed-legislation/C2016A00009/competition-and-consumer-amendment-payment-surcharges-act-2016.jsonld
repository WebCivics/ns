    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55e-ss-2",
      "@type": "cof:Section",
      "cof:title": "55E(2) Participant must comply with notice",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(2) Subsection (1) is an offence of strict liability.\nNote:\nSections 137.1 and 137.2 of the Criminal Code create offences for\nproviding false or misleading information or documents."
    },
