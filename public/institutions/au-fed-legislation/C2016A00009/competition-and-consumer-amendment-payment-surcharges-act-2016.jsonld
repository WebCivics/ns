      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sec-3-norm"
        }
      ],
      "cml:integrityHash": "af76c3f3994155ccb7738c88f2130d40c192a3ae36c27d5137e458f601abed56",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sec-3",
      "@type": "cof:Section",
