    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55l",
      "@type": "cml:Concept",
      "skos:prefLabel": "55L Effect of failure to comply with an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.12",
      "values:originalText": "If:\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act\n\n(a) an infringement notice for an alleged contravention of\nsection 55B is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 55N;\nthe person is liable to proceedings under section 76 in relation to\nthe alleged contravention of section 55B.",
      "skos:definition": "If:\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act\n\n(a) an infringement notice for an alleged contravention of\nsection 55B is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 55N;\nthe person is liable to proceedings under section 76 in relation to\nthe alleged contravention of section 55B.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55l-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55l-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5e003d82f826b6c87e5f79af0e70f64bf94f76df58d5cb4ee5ac1ec44b017c34",
      "skos:note": "Failure to pay penalty specified in infringement notice within compliance period results in liability for proceedings under section 76."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55l",
      "@type": "cof:Section",
      "cof:title": "55L Effect of failure to comply with an infringement notice",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "If:\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act\n\n(a) an infringement notice for an alleged contravention of\nsection 55B is issued to a person; and\n\n(b) the person fails to pay the penalty specified in the\ninfringement notice within the infringement notice\ncompliance period and in accordance with the notice; and\n\n(c) the infringement notice is not withdrawn under section 55N;\nthe person is liable to proceedings under section 76 in relation to\nthe alleged contravention of section 55B."
    },
