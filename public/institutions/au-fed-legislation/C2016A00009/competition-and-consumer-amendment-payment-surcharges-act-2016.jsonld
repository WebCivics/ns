    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55n-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "55N(7) Withdrawal of an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55n-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.13",
      "values:originalText": "(7) If the infringement notice is withdrawn after the person has paid\nthe penalty specified in the infringement notice, the Commission\nmust refund to the person an amount equal to the amount paid.\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act",
      "skos:definition": "(7) If the infringement notice is withdrawn after the person has paid\nthe penalty specified in the infringement notice, the Commission\nmust refund to the person an amount equal to the amount paid.\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55n"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55n-ss-7-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55n-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cb2cf60f87ff5d2ce72755c2e9a74f10c1bf678c1a25c42c9f0c007c52f08b32",
      "skos:note": "Commission must refund amount paid if infringement notice is withdrawn after payment."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55n-ss-7",
      "@type": "cof:Section",
      "cof:title": "55N(7) Withdrawal of an infringement notice",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(7) If the infringement notice is withdrawn after the person has paid\nthe penalty specified in the infringement notice, the Commission\nmust refund to the person an amount equal to the amount paid.\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act"
    },
