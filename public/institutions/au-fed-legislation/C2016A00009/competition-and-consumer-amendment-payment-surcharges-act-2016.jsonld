    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55d",
      "@type": "cml:Concept",
      "skos:prefLabel": "55D Extending periods for complying with notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.10",
      "values:originalText": "(1) A surcharge participant that has been given a notice under\nsection 55C may, at any time within 21 days after the notice was\ngiven to the participant, apply in writing to the Commission for an\nextension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the surcharge\nparticipant, extend the period within which the participant must\ncomply with the notice.",
      "skos:definition": "(1) A surcharge participant that has been given a notice under\nsection 55C may, at any time within 21 days after the notice was\ngiven to the participant, apply in writing to the Commission for an\nextension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the surcharge\nparticipant, extend the period within which the participant must\ncomply with the notice.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55d-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55d-ss-2"
        }
      ],
      "cml:integrityHash": "6cbce72e268e224e2d0948d027b737a6f517aa8e346cf3413c6023c681fe90f3"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55d",
      "@type": "cof:Section",
      "cof:title": "55D Extending periods for complying with notices",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) A surcharge participant that has been given a notice under\nsection 55C may, at any time within 21 days after the notice was\ngiven to the participant, apply in writing to the Commission for an\nextension of the period for complying with the notice.\n\n(2) The Commission may, by written notice given to the surcharge\nparticipant, extend the period within which the participant must\ncomply with the notice."
    },
