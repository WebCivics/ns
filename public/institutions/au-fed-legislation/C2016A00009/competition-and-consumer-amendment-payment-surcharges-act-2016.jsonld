    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55a",
      "@type": "cml:Concept",
      "skos:prefLabel": "55A Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.8",
      "values:originalText": "In this Part:\nexcessive, in relation to a payment surcharge, has the meaning\ngiven by subsection 55B(2).\ninfringement notice compliance period has the meaning given by\nsubsection 55M(1).\nlisted corporation has the meaning given by section 9 of the\nCorporations Act 2001.\npayment surcharge means:\n\n(a) an amount charged, in addition to the price of goods or\nservices, for processing payment for the goods or services; or\n\n(b) an amount (however described) charged for using one\npayment method rather than another.\nReserve Bank standard means a standard determined under\nsection 18 of the Payment Systems (Regulation) Act 1998 after the\ncommencement of this definition.\nsurcharge information notice has the meaning given by\nsubsection 55C(3).\nsurcharge participant has the meaning given by\nsubsection 55C(2).\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act",
      "skos:definition": "In this Part:\nexcessive, in relation to a payment surcharge, has the meaning\ngiven by subsection 55B(2).\ninfringement notice compliance period has the meaning given by\nsubsection 55M(1).\nlisted corporation has the meaning given by section 9 of the\nCorporations Act 2001.\npayment surcharge means:\n\n(a) an amount charged, in addition to the price of goods or\nservices, for processing payment for the goods or services; or\n\n(b) an amount (however described) charged for using one\npayment method rather than another.\nReserve Bank standard means a standard determined under\nsection 18 of the Payment Systems (Regulation) Act 1998 after the\ncommencement of this definition.\nsurcharge information notice has the meaning given by\nsubsection 55C(3).\nsurcharge participant has the meaning given by\nsubsection 55C(2).\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55a-norm"
        }
      ],
      "cml:integrityHash": "cfaf4f374b83ccd9d46ac14a5983ed28609970225672936584a31a0391f82b4a",
      "skos:note": "Defines payment surcharge and related terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55a",
      "@type": "cof:Section",
      "cof:title": "55A Definitions",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "In this Part:\nexcessive, in relation to a payment surcharge, has the meaning\ngiven by subsection 55B(2).\ninfringement notice compliance period has the meaning given by\nsubsection 55M(1).\nlisted corporation has the meaning given by section 9 of the\nCorporations Act 2001.\npayment surcharge means:\n\n(a) an amount charged, in addition to the price of goods or\nservices, for processing payment for the goods or services; or\n\n(b) an amount (however described) charged for using one\npayment method rather than another.\nReserve Bank standard means a standard determined under\nsection 18 of the Payment Systems (Regulation) Act 1998 after the\ncommencement of this definition.\nsurcharge information notice has the meaning given by\nsubsection 55C(3).\nsurcharge participant has the meaning given by\nsubsection 55C(2).\nComLaw Authoritative Act C2016A00009\n\nAmendments  Schedule 1\n\nNo. 9, 2016\nCompetition and Consumer Amendment (Payment Surcharges) Act"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
