      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55b",
      "@type": "cml:Concept",
      "skos:prefLabel": "55B Payment surcharges must not be excessive",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.9",
      "values:originalText": "(1) A corporation must not, in trade or commerce, charge a payment\nsurcharge that is excessive.\n\n(2) A payment surcharge is excessive if:\n\n(a) the surcharge is for a kind of payment covered by:\n\n(i) a Reserve Bank standard; or\n\n(ii) regulations made for the purposes of this subparagraph;\nand\n\n(b) the amount of the surcharge exceeds the permitted surcharge\nreferred to in the Reserve Bank standard or the regulations.\n\n(3) Subsection (1) does not apply to a corporation who is exempted\nfrom its operation by the regulations.",
      "skos:definition": "(1) A corporation must not, in trade or commerce, charge a payment\nsurcharge that is excessive.\n\n(2) A payment surcharge is excessive if:\n\n(a) the surcharge is for a kind of payment covered by:\n\n(i) a Reserve Bank standard; or\n\n(ii) regulations made for the purposes of this subparagraph;\nand\n\n(b) the amount of the surcharge exceeds the permitted surcharge\nreferred to in the Reserve Bank standard or the regulations.\n\n(3) Subsection (1) does not apply to a corporation who is exempted\nfrom its operation by the regulations.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55b-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55b-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55b-ss-3"
        }
      ],
      "cml:integrityHash": "b276123e5e2fb0b8eb542e5b5b2c5a30e5f90ce4e272bd81c821bae3b23639b0"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55b",
      "@type": "cof:Section",
      "cof:title": "55B Payment surcharges must not be excessive",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "(1) A corporation must not, in trade or commerce, charge a payment\nsurcharge that is excessive.\n\n(2) A payment surcharge is excessive if:\n\n(a) the surcharge is for a kind of payment covered by:\n\n(i) a Reserve Bank standard; or\n\n(ii) regulations made for the purposes of this subparagraph;\nand\n\n(b) the amount of the surcharge exceeds the permitted surcharge\nreferred to in the Reserve Bank standard or the regulations.\n\n(3) Subsection (1) does not apply to a corporation who is exempted\nfrom its operation by the regulations."
    },
