    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55g-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "55G(3) Issuing an infringement notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55g-ss-3"
      },
