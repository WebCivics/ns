    },
    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 After subsection 6(2E)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.7",
      "values:originalText": "Insert:\n\n(2F) In addition to the effect that this Act (other than Parts IIIA, VIIA\nand X) has as provided by another subsection of this section, this\nAct (other than Parts IIIA, VIIA and X) has, by force of this\nsubsection, the effect it would have if:\n\n(a) each reference in Part IVC to a payment surcharge were a\nreference to a payment surcharge charged for processing a\npayment made by means of a postal, telegraphic, telephonic,\nor other like service (including electronic communication);\nand\n\n(b) each reference to a corporation included a reference to a\nperson not being a corporation.",
      "skos:definition": "Insert:\n\n(2F) In addition to the effect that this Act (other than Parts IIIA, VIIA\nand X) has as provided by another subsection of this section, this\nAct (other than Parts IIIA, VIIA and X) has, by force of this\nsubsection, the effect it would have if:\n\n(a) each reference in Part IVC to a payment surcharge were a\nreference to a payment surcharge charged for processing a\npayment made by means of a postal, telegraphic, telephonic,\nor other like service (including electronic communication);\nand\n\n(b) each reference to a corporation included a reference to a\nperson not being a corporation.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-2-norm"
        }
      ],
      "cml:integrityHash": "b74f20b6e1145b2c7bfb4ff20ab8bc907bebd476cd012717281f32196acef345",
      "skos:note": "Inserts new subsection 2F with specific effects on the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 After subsection 6(2E)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n\n(2F) In addition to the effect that this Act (other than Parts IIIA, VIIA\nand X) has as provided by another subsection of this section, this\nAct (other than Parts IIIA, VIIA and X) has, by force of this\nsubsection, the effect it would have if:\n\n(a) each reference in Part IVC to a payment surcharge were a\nreference to a payment surcharge charged for processing a\npayment made by means of a postal, telegraphic, telephonic,\nor other like service (including electronic communication);\nand\n\n(b) each reference to a corporation included a reference to a\nperson not being a corporation."
    },
    {
