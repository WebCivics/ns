      "skos:prefLabel": "55J Amount of penalty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.12",
      "values:originalText": "The penalty to be specified in an infringement notice that is to be\nissued to a person in relation to an alleged contravention of\nsection 55B must be:\n\n(a) if the person is a listed corporation—600 penalty units; or\n\n(b) if the person is a body corporate other than a listed\ncorporation—60 penalty units; or\n\n(c) if the person is not a body corporate—12 penalty units.",
      "skos:definition": "The penalty to be specified in an infringement notice that is to be\nissued to a person in relation to an alleged contravention of\nsection 55B must be:\n\n(a) if the person is a listed corporation—600 penalty units; or\n\n(b) if the person is a body corporate other than a listed\ncorporation—60 penalty units; or\n\n(c) if the person is not a body corporate—12 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55j-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55j-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "599b1d4868477da047ff36c3314b53b09561600f714f109461bfc6cf30e93f54",
      "skos:note": "Penalty amount for infringement notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55j",
      "@type": "cof:Section",
      "cof:title": "55J Amount of penalty",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "The penalty to be specified in an infringement notice that is to be\nissued to a person in relation to an alleged contravention of\nsection 55B must be:\n\n(a) if the person is a listed corporation—600 penalty units; or\n\n(b) if the person is a body corporate other than a listed\ncorporation—60 penalty units; or\n\n(c) if the person is not a body corporate—12 penalty units."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55j-norm",
