      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A payment surcharge is excessive if:\n\n(a) the surcharge is for a kind of payment covered by:\n\n(i) a Reserve Bank standard; or\n\n(ii) regulations made for the purposes of this subparagraph;",
      "cml:conclusionText": "...the amount of the surcharge exceeds the permitted surcharge"
