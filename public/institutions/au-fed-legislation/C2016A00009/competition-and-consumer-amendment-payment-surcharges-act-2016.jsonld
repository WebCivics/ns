      "cml:integrityHash": "e1b8450e0e4ca52ffc82020969f9bb72ca23c70ace45b361d23aeb2607227a4e",
      "skos:note": "Reference to extended infringement notice compliance period"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55m-ss-6",
      "@type": "cof:Section",
      "cof:title": "55M(6) Infringement notice compliance period for infringement notice",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(6) If the Commission extends the infringement notice compliance\nperiod for an infringement notice, a reference in this Division to\nthe infringement notice compliance period for an infringement\nnotice is taken to be a reference to the infringement notice\ncompliance period as so extended."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-55m-ss-6-norm",
      "@type": "values:Obligation",
