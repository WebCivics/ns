        }
      ],
      "cml:integrityHash": "d6ea0bb3694921983c60e4dbf5adff5e6577c0a42e4056c094d15680c8c84172",
      "skos:note": "Commission may make an application on behalf of a class of persons who have suffered loss or damage by conduct in contravention of section 55B."
    },
