      "cml:integrityHash": "d75b6b5882d8a0f1fca8d34779d84d9a094ff34e9050afde15a6acad5e94fea6",
      "skos:note": "Commission may withdraw infringement notice upon request."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-55n-ss-3",
      "@type": "cof:Section",
      "cof:title": "55N(3) Withdrawal of an infringement notice",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(3) The Commission may, by written notice (the withdrawal notice)\ngiven to the person to whom an infringement notice was issued,\nwithdraw the infringement notice if the Commission is satisfied\nthat it is appropriate to do so."
    },
