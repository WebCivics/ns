    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 4(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-payment-surcharges-act-2016.pdf, p.7",
      "values:originalText": "Insert:\nelectronic communication means a communication of information\nby means of guided and/or unguided electromagnetic energy:\n\n(a) whether in the form of text; or\n\n(b) whether in the form of data; or\n\n(c) whether in the form of speech, music or other sounds; or\n\n(d) whether in the form of visual images (animated or\notherwise); or\n\n(e) whether in any other form; or\n\n(f) whether in any combination of forms.",
      "skos:definition": "Insert:\nelectronic communication means a communication of information\nby means of guided and/or unguided electromagnetic energy:\n\n(a) whether in the form of text; or\n\n(b) whether in the form of data; or\n\n(c) whether in the form of speech, music or other sounds; or\n\n(d) whether in the form of visual images (animated or\notherwise); or\n\n(e) whether in any other form; or\n\n(f) whether in any combination of forms.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-1-norm"
        }
      ],
      "cml:integrityHash": "25e7e56fac204f29f9efcffdc91724d10d304ac52d84351f9ab9dbef34c30336",
      "skos:note": "Definition of electronic communication"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-payment-surcharges-act-2016#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 4(1)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\nelectronic communication means a communication of information\nby means of guided and/or unguided electromagnetic energy:\n\n(a) whether in the form of text; or\n\n(b) whether in the form of data; or\n\n(c) whether in the form of speech, music or other sounds; or\n\n(d) whether in the form of visual images (animated or\notherwise); or\n\n(e) whether in any other form; or\n\n(f) whether in any combination of forms."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-payment-surcharges-act-2016-sch-1-sec-1-norm",
