    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of making, altering, destroying or concealing an accounting document.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(1) A person commits an offence if:  (a) the person:  (i) makes, alters, destroys or conceals an accounting document;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-2-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Reckless failure to make or alter an accounting document is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(b) the person is reckless as to whether the making, alteration, destruction or concealment of the document (or the failure to make or alter the document) facilitates, conceals or disguises..."
    },
    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-2-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Reckless facilitation of illegitimate benefits is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(ii) the person receiving a benefit that is not legitimately due to the person;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-2-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Reckless concealment of illegitimate benefits is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(iv) another person giving a benefit that is not legitimately due to the recipient, or intended recipient, of the benefit (who may be the first-mentioned person);"
    },
    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-2-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Reckless loss to another person is prohibited.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(v) loss to another person that is not legitimately incurred by the other person;"
    },
