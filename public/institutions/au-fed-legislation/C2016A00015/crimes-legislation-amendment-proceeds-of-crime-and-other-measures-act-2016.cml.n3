    skos:prefLabel "490 4  Related bodies corporate"@en ;
    cml:realizedBy doc:sch-2-sec-490-4 ;
    values:originalText "The question whether 2 bodies corporate are related to each other is to be determined for the purposes of this Division in the same way as for the purposes of the Corporations Act 2001." ;
