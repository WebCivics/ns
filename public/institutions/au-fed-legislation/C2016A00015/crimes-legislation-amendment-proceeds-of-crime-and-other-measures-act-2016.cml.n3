    skos:prefLabel "3 Schedule 5"@en ;
    cml:realizedBy doc:sec-3 ;
    values:originalText "A single day to be fixed by Proclamation. However, if the provisions do not commence within the period of 6 months beginning on the day this Act receives the Royal Assent, they commence on the day after the end of that period." ;
