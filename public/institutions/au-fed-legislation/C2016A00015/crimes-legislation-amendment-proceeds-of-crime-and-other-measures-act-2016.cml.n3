concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-5 a cml:Concept ;
    skos:prefLabel "490 5  Proof of certain matters unnecessary"@en ;
    cml:realizedBy doc:sch-2-sec-490-5 ;
    values:originalText "In a prosecution for an offence against this Division, it is not necessary to prove:  (a) the occurrence of any of the following:  (i) the defendant receiving or giving a benefit;  (ii) another person receiving or giving a benefit;  (iii) loss to another person; or  (b) that the defendant intended that a particular person receive or give a benefit, or incur a loss." ;
    skos:definition "In a prosecution for an offence against this Division, it is not necessary to prove:  (a) the occurrence of any of the following:  (i) the defendant receiving or giving a benefit;  (ii) another person receiving or giving a benefit;  (iii) loss to another person; or  (b) that the defendant intended that a particular person receive or give a benefit, or incur a loss."@en ;
    cml:integrityHash "bea19e1b950e7c2c53d75079752d76989ff3a2a773bef2987af17e123bf42a4a" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "No need to prove certain matters in a prosecution for an offence against this Division." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
