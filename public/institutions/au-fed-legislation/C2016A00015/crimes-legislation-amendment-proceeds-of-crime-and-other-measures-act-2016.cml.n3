concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-5-sec-5 a cml:Concept ;
    skos:prefLabel "5 Application provision"@en ;
    cml:realizedBy doc:sch-5-sec-5 ;
    values:originalText "The amendments of the AusCheck Act 2007 made by this Schedule apply in relation to the use or disclosure of information after the commencement of this item, whether the information was collected before or after that commencement.    No. 15, 2016 Crimes Legislation Amendment (Proceeds of Crime and Other Measures) Act 2016  [Minister’s second reading speech made in— House of Representatives on 26 November 2015 Senate on 2 February 2016]  (201/15)" ;
    skos:definition "The amendments of the AusCheck Act 2007 made by this Schedule apply in relation to the use or disclosure of information after the commencement of this item, whether the information was collected before or after that commencement.    No. 15, 2016 Crimes Legislation Amendment (Proceeds of Crime and Other Measures) Act 2016  [Minister’s second reading speech made in— House of Representatives on 26 November 2015 Senate on 2 February 2016]  (201/15)"@en ;
    cml:integrityHash "a7a8ebd80bc42a81a64c79d512f0d6f1862b25f68d46e2a5d18b0f1e9b322856" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Amendments apply in relation to use or disclosure of information after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
