doc:sch-2-sec-490-7 a cof:Section ;
    cof:title "490 7  Saving of other laws" ;
    values:kind "section" ;
    values:originalText "This Division is not intended to exclude or limit the operation of any other law of the Commonwealth or any law of a State or Territory." ;
    cof:pageNumber "17"^^xsd:integer .

concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-2 a cml:Concept ;
    skos:prefLabel "2 Dictionary of the Criminal Code"@en ;
