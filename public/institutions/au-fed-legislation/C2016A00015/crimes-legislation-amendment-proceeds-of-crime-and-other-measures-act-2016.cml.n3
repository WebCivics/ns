doc:sch-5-sec-1 a cof:Section ;
    cof:title "1 Subsection 4(1) (definition of Commonwealth authority)" ;
    values:kind "section" ;
    values:originalText "Repeal the definition, substitute: Commonwealth authority means a body (whether incorporated or not) established for a public purpose by or under a law of the Commonwealth." ;
    cof:pageNumber "22"^^xsd:integer .

