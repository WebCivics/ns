concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-ss-5 a cml:Concept ;
    skos:prefLabel "490(5) 1  Intentional false dealing with accounting documents"@en ;
    cml:realizedBy doc:sch-2-sec-490-ss-5 ;
    values:originalText "(5) An offence against this section committed by a body corporate is punishable on conviction by a fine not more than the greatest of the following:  (a) 100,000 penalty units;  (b) if the court can determine the value of the benefit that the body corporate, and any body corporate related to the body corporate, have obtained directly or indirectly and that is reasonably attributable to the conduct constituting the offence—3 times the value of that benefit;  (c) if the court cannot determine the value of that benefit—10% of the annual turnover of the body corporate during the period (the turnover period) of 12 months ending at the end of the month in which the conduct constituting the offence occurred." ;
    skos:definition "(5) An offence against this section committed by a body corporate is punishable on conviction by a fine not more than the greatest of the following:  (a) 100,000 penalty units;  (b) if the court can determine the value of the benefit that the body corporate, and any body corporate related to the body corporate, have obtained directly or indirectly and that is reasonably attributable to the conduct constituting the offence—3 times the value of that benefit;  (c) if the court cannot determine the value of that benefit—10% of the annual turnover of the body corporate during the period (the turnover period) of 12 months ending at the end of the month in which the conduct constituting the offence occurred."@en ;
    cml:integrityHash "731882c1c6e81fb62b532dcf5b997ab256479c226624a37062410e81804b2880" ;
    values:partOf concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490 ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Offence against section 490(5) committed by a body corporate is punishable." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
