      },
      "dc:source": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf, p.18",
      "values:originalText": "Repeal the subparagraph, substitute:\n\n(iii) by the replacement of one or more of the groups or\natoms specified in subsection (2) with one or more of\nthe other groups or atoms specified in that subsection;",
      "skos:definition": "Repeal the subparagraph, substitute:\n\n(iii) by the replacement of one or more of the groups or\natoms specified in subsection (2) with one or more of\nthe other groups or atoms specified in that subsection;",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-3-sec-2-norm"
        }
      ],
      "cml:integrityHash": "e010d2d8f021c83d65c013bbc952659e15f5ec07f82a263a58f9c393ce7ade73",
      "skos:note": "Replace groups or atoms with other specified groups or atoms."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-3-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subparagraph 301.9(1)(c)(iii) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Repeal the subparagraph, substitute:\n\n(iii) by the replacement of one or more of the groups or\natoms specified in subsection (2) with one or more of\nthe other groups or atoms specified in that subsection;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-3-sec-2-norm",
      "@type": "values:Undertaking",
