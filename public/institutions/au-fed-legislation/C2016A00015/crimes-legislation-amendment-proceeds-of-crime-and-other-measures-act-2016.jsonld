      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf"
      },
      "dc:source": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf, p.17",
      "values:originalText": "This Division is not intended to exclude or limit the operation of\nany other law of the Commonwealth or any law of a State or\nTerritory.",
      "skos:definition": "This Division is not intended to exclude or limit the operation of\nany other law of the Commonwealth or any law of a State or\nTerritory.",
      "cml:asserts": [
