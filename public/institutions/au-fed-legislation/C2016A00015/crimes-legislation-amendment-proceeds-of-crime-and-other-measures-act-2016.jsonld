        },
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-1-sec-1-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "27d2545722a259622314097c8c841a72c29dbb18b072624f80b71ba7846868b8",
      "skos:note": "Permits disclosure of information under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 266A(2)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Omit all the words after “in that item”, substitute:\n\nif:\n\n(a) the person believes on reasonable grounds that the disclosure\nwill serve that purpose; and\n\n(b) a court has not made an order prohibiting the disclosure of\nthe information to the authority for that purpose."
    },
