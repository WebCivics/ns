    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "490(4) 1  Intentional false dealing with accounting documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-2-sec-490-ss-4"
      },
