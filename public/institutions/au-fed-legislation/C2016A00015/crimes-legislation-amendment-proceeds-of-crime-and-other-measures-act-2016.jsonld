      "dc:source": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nNo. 15, 2016\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Proceeds of crime\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nNo. 15, 2016\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Proceeds of crime\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "dc16f8ef1b1b2664002831f0970e8b31eedba37ab5e43a67edc34dd82a18fced",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nNo. 15, 2016\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Proceeds of crime\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016"
    },
