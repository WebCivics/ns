    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-3-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Subsection 305.1(1) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-3-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf"
      },
      "dc:source": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf, p.19",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) For the purposes of this Part, manufacture means:\n\n(a) any process by which a substance is produced (other than the\ncultivation of a plant), and includes the following:\n\n(i) the process of extracting or refining a substance;\n\n(ii) the process of transforming a substance into a different\nsubstance; or\n\n(b) any process by which a substance is converted from one form\nto another, including the process of extracting or refining a\nsubstance.\n\nSchedule 4  Secrecy and access of AUSTRAC information\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) For the purposes of this Part, manufacture means:\n\n(a) any process by which a substance is produced (other than the\ncultivation of a plant), and includes the following:\n\n(i) the process of extracting or refining a substance;\n\n(ii) the process of transforming a substance into a different\nsubstance; or\n\n(b) any process by which a substance is converted from one form\nto another, including the process of extracting or refining a\nsubstance.\n\nSchedule 4  Secrecy and access of AUSTRAC information\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-3-sec-4-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-3-sec-4-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-3-sec-4-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "e024e7368c724230bfcda4227f5063e43451900d1a453053f13a42122226a3e4",
      "skos:note": "Defines manufacture for the purposes of this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-3-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsection 305.1(1) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) For the purposes of this Part, manufacture means:\n\n(a) any process by which a substance is produced (other than the\ncultivation of a plant), and includes the following:\n\n(i) the process of extracting or refining a substance;\n\n(ii) the process of transforming a substance into a different\nsubstance; or\n\n(b) any process by which a substance is converted from one form\nto another, including the process of extracting or refining a\nsubstance.\n\nSchedule 4  Secrecy and access of AUSTRAC information\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016"
    },
