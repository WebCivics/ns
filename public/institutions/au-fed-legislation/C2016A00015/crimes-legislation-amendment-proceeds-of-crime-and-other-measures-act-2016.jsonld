    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "490 5  Proof of certain matters unnecessary",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-2-sec-490-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf"
      },
      "dc:source": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf, p.16",
      "values:originalText": "In a prosecution for an offence against this Division, it is not\nnecessary to prove:\n\n(a) the occurrence of any of the following:\n\n(i) the defendant receiving or giving a benefit;\n\n(ii) another person receiving or giving a benefit;\n\n(iii) loss to another person; or\n\n(b) that the defendant intended that a particular person receive or\ngive a benefit, or incur a loss.",
      "skos:definition": "In a prosecution for an offence against this Division, it is not\nnecessary to prove:\n\n(a) the occurrence of any of the following:\n\n(i) the defendant receiving or giving a benefit;\n\n(ii) another person receiving or giving a benefit;\n\n(iii) loss to another person; or\n\n(b) that the defendant intended that a particular person receive or\ngive a benefit, or incur a loss.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-5-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-2-sec-490-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bea19e1b950e7c2c53d75079752d76989ff3a2a773bef2987af17e123bf42a4a",
      "skos:note": "No need to prove certain matters in a prosecution for an offence against this Division."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-2-sec-490-5",
      "@type": "cof:Section",
      "cof:title": "490 5  Proof of certain matters unnecessary",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "In a prosecution for an offence against this Division, it is not\nnecessary to prove:\n\n(a) the occurrence of any of the following:\n\n(i) the defendant receiving or giving a benefit;\n\n(ii) another person receiving or giving a benefit;\n\n(iii) loss to another person; or\n\n(b) that the defendant intended that a particular person receive or\ngive a benefit, or incur a loss."
    },
