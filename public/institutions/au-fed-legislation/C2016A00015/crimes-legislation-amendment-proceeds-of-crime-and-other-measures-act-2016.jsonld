    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-3-sec-3-ss-3",
      "@type": "cof:Section",
      "cof:title": "3(3) Subsection 301.9(2) of the Criminal Code",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(3) However:\n\n(a) a drug analogue of a listed controlled drug does not include a\nsubstance that is itself a listed controlled drug; and\n\n(b) a drug analogue of a listed border controlled drug does not\ninclude a substance that is itself a listed border controlled\ndrug."
    },
