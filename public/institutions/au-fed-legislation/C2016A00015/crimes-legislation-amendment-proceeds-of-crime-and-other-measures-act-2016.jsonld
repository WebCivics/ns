          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-1-sec-319-ss-5"
        },
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-1-sec-319-ss-6"
        }
      ],
      "cml:integrityHash": "1d51229c15afb4c7174516d1a83fc40661555c919776704720eccbf5f78436dc"
