    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-2-sec-490-7",
      "@type": "cof:Section",
      "cof:title": "490 7  Saving of other laws",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "This Division is not intended to exclude or limit the operation of\nany other law of the Commonwealth or any law of a State or\nTerritory."
    },
