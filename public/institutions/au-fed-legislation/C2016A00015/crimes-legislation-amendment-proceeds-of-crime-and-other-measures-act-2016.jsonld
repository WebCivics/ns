    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-4-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-4-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf"
      },
      "dc:source": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf, p.21",
      "values:originalText": "Paragraph 122(3)(c) of the Anti-Money Laundering and\nCounter-Terrorism Financing Act 2006, as inserted by this Schedule,\napplies in relation to the disclosure of information after the\ncommencement of this item, whether the information was obtained\nbefore or after that commencement.\n\nSchedule 5  Disclosure etc. of AusCheck scheme personal information\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016",
      "skos:definition": "Paragraph 122(3)(c) of the Anti-Money Laundering and\nCounter-Terrorism Financing Act 2006, as inserted by this Schedule,\napplies in relation to the disclosure of information after the\ncommencement of this item, whether the information was obtained\nbefore or after that commencement.\n\nSchedule 5  Disclosure etc. of AusCheck scheme personal information\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-4-sec-5-norm"
        }
      ],
      "cml:integrityHash": "e87761a373f76fe9cfd0ab6cb1b2263b6dcc37c79a7a39b7b65837685e23b587",
      "skos:note": "Application provision for disclosure of information after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-4-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "Paragraph 122(3)(c) of the Anti-Money Laundering and\nCounter-Terrorism Financing Act 2006, as inserted by this Schedule,\napplies in relation to the disclosure of information after the\ncommencement of this item, whether the information was obtained\nbefore or after that commencement.\n\nSchedule 5  Disclosure etc. of AusCheck scheme personal information\n\nCrimes Legislation Amendment (Proceeds of Crime and Other\nMeasures) Act 2016\nNo. 15, 2016"
    },
