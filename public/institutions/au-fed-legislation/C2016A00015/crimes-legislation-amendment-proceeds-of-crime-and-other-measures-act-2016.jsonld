    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-1-sec-319a",
      "@type": "cml:Concept",
      "skos:prefLabel": "319A Closed court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-1-sec-319a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf"
      },
      "dc:source": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf, p.10",
      "values:originalText": "A court may order that proceedings under this Act (other than\ncriminal proceedings) be heard, in whole or in part, in closed court\nif the court considers that the order is necessary to prevent\ninterference with the administration of criminal justice.",
      "skos:definition": "A court may order that proceedings under this Act (other than\ncriminal proceedings) be heard, in whole or in part, in closed court\nif the court considers that the order is necessary to prevent\ninterference with the administration of criminal justice.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-1-sec-319a-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-1-sec-319a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9f8183f62185c667862416bfbeba478d6821b51434f33b2853b3c67cf4dd9acb",
      "skos:note": "Court may order closed proceedings for administration of criminal justice."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-1-sec-319a",
      "@type": "cof:Section",
      "cof:title": "319A Closed court",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "A court may order that proceedings under this Act (other than\ncriminal proceedings) be heard, in whole or in part, in closed court\nif the court considers that the order is necessary to prevent\ninterference with the administration of criminal justice."
    },
