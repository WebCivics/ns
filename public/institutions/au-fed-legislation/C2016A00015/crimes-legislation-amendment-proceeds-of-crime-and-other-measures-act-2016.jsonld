    {
      "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-4-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Section 5 (definition of foreign law enforcement agency)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-4-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf"
      },
      "dc:source": "crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016.pdf, p.20",
      "values:originalText": "Repeal the definition, substitute:\nforeign law enforcement agency means:\n\n(a) a government body that has responsibility for law\nenforcement in a foreign country or a part of a foreign\ncountry; or\n\n(b) the European Police Office (Europol); or\n\n(c) the International Criminal Police Organization (Interpol); or\n\n(d) an international body prescribed by the regulations for the\npurposes of this paragraph.",
      "skos:definition": "Repeal the definition, substitute:\nforeign law enforcement agency means:\n\n(a) a government body that has responsibility for law\nenforcement in a foreign country or a part of a foreign\ncountry; or\n\n(b) the European Police Office (Europol); or\n\n(c) the International Criminal Police Organization (Interpol); or\n\n(d) an international body prescribed by the regulations for the\npurposes of this paragraph.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-4-sec-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-4-sec-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016-sch-4-sec-2-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "4f8e7da4e00aff4aa76b45d86ed0e899b8af0636c2ff1dc2ff556197b2cc36aa",
      "skos:note": "Definition of foreign law enforcement agency"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-proceeds-of-crime-and-other-measures-act-2016#sch-4-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Section 5 (definition of foreign law enforcement agency)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Repeal the definition, substitute:\nforeign law enforcement agency means:\n\n(a) a government body that has responsibility for law\nenforcement in a foreign country or a part of a foreign\ncountry; or\n\n(b) the European Police Office (Europol); or\n\n(c) the International Criminal Police Organization (Interpol); or\n\n(d) an international body prescribed by the regulations for the\npurposes of this paragraph."
    },
