    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-47-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The day on which the approved provider provides the care recipient with such home care (if any) as is required under the home care agreement overlaps with the day on which the care recipient is a prioritised home care recipient.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The day on which the approved provider provides the care recipient with such home care (if any) as is required under the home care agreement must overlap with the day on which the care recipient is a prioritised home care recipient.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "On that day, the approved provider provides the care recipient with such home care (if any) as is required under the home care agreement."
    },
    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-47-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The approved provider provides the care recipient with such home care (if any) as is required under the home care agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The approved provider must provide the care recipient with such home care (if any) as is required under the home care agreement.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Necessity",
      "cml:premiseText": "There is in force a home care agreement under which a care recipient approved under Part 2.3 is to be provided with home care by the approved provider through a home care service."
    },
    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-47-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The approved provider agrees in the claim relating to the day to deal with the care recipient’s unspent home care amount in accordance with the User Rights Principles.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The approved provider must agree in the claim relating to the day to deal with the care recipient’s unspent home care amount in accordance with the User Rights Principles.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The approved provider has agreed in the claim relating to the day to deal with the care recipient’s unspent home care amount in accordance with the User Rights Principles."
    },
    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-47-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The approved provider provides the care recipient with such home care (if any) as is required under the home care agreement on each day that the care recipient is a prioritised home care recipient.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The approved provider must provide the care recipient with such home care (if any) as is required under the home care agreement on each day that the care recipient is a prioritised home care recipient.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:premiseText": "On that day, the approved provider provides the care recipient with such home care (if any) as is required under the home care agreement."
    },
