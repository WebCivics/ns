concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-82 a cml:Concept ;
    skos:prefLabel "82 Delegation"@en ;
    cml:realizedBy doc:sch-1-sec-82 ;
    values:originalText "The amendments of subsection 96-2(1) of the Aged Care Act 1997 and the Aged Care (Transitional Provisions) Act 1997 made by this Schedule do not affect the continuity of any delegation that is in force under those subsections immediately before the commencement time." ;
    skos:definition "The amendments of subsection 96-2(1) of the Aged Care Act 1997 and the Aged Care (Transitional Provisions) Act 1997 made by this Schedule do not affect the continuity of any delegation that is in force under those subsections immediately before the commencement time."@en ;
    cml:integrityHash "fafa34dee306b4af7fa0bee90d7200b80b4403b24160d201947f070a48abe0e1" ;
    cof:pageNumber "29"^^xsd:integer ;
