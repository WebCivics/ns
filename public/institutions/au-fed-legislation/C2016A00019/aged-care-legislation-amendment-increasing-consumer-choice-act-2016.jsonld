          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-61-norm"
        },
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-61-logic-deontic-1"
        },
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-61-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "8a85ee7de59dd3adb14a83f3dda5e3b4314586df2cba85ec26e7a54a1e303ce8",
      "skos:note": "Certain responsibilities arise from receipt of payments under this Chapter."
    },
