    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Before section 9-1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf"
      },
      "dc:source": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf, p.11",
      "values:originalText": "Insert:\n9-1A  Obligation to notify Secretary about home care services\n\n(1) An approved provider must notify the Secretary of the following\ninformation in relation to each home care service through which\nthe approved provider proposes to provide home care:\n\n(a) the name and address of the service;\n\n(b) any other information of a kind specified in the Approved\nProvider Principles for the purposes of this section.\nNote:\nApproved providers have a responsibility under Part 4.3 to comply\nwith this obligation. Failure to comply with a responsibility can result\nin a sanction being imposed under Part 4.4.\n\nSchedule 1  Amendments",
      "skos:definition": "Insert:\n9-1A  Obligation to notify Secretary about home care services\n\n(1) An approved provider must notify the Secretary of the following\ninformation in relation to each home care service through which\nthe approved provider proposes to provide home care:\n\n(a) the name and address of the service;\n\n(b) any other information of a kind specified in the Approved\nProvider Principles for the purposes of this section.\nNote:\nApproved providers have a responsibility under Part 4.3 to comply\nwith this obligation. Failure to comply with a responsibility can result\nin a sanction being imposed under Part 4.4.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-20-norm"
        },
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f3baa536cf9f0ddd77275a824095f83a7d8f801349dbb0430a6d4212002b0f31",
      "skos:note": "Notify Secretary about home care services",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Before section 9-1",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Insert:\n9-1A  Obligation to notify Secretary about home care services\n\n(1) An approved provider must notify the Secretary of the following\ninformation in relation to each home care service through which\nthe approved provider proposes to provide home care:\n\n(a) the name and address of the service;\n\n(b) any other information of a kind specified in the Approved\nProvider Principles for the purposes of this section.\nNote:\nApproved providers have a responsibility under Part 4.3 to comply\nwith this obligation. Failure to comply with a responsibility can result\nin a sanction being imposed under Part 4.4.\n\nSchedule 1  Amendments"
    },
