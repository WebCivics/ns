    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Subsection 96-2(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf"
      },
      "dc:source": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf, p.20",
      "values:originalText": "Repeal the subsection, substitute:\nEmployees etc. of Agencies and Commonwealth authorities\n\n(1) The Secretary may, in writing, delegate all or any of the powers\nand functions of the Secretary under this Act, the regulations or\nany Principles made under section 96-1 to a person engaged\n(whether as an employee or otherwise) by:\n\n(a) an Agency (within the meaning of the Public Service Act\n1999); or\n\n(b) an authority of the Commonwealth.\n\nAmendments  Schedule 1\nMain amendments  Part 1\n\nNo. 19, 2016\nAged Care Legislation Amendment (Increasing Consumer Choice) Act",
      "skos:definition": "Repeal the subsection, substitute:\nEmployees etc. of Agencies and Commonwealth authorities\n\n(1) The Secretary may, in writing, delegate all or any of the powers\nand functions of the Secretary under this Act, the regulations or\nany Principles made under section 96-1 to a person engaged\n(whether as an employee or otherwise) by:\n\n(a) an Agency (within the meaning of the Public Service Act\n1999); or\n\n(b) an authority of the Commonwealth.\n\nAmendments  Schedule 1\nMain amendments  Part 1\n\nNo. 19, 2016\nAged Care Legislation Amendment (Increasing Consumer Choice) Act",
      "cml:asserts": [
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-56-norm"
        }
      ],
      "cml:integrityHash": "fbcd3ff8e78a73407374dcd8d978d72951abee0d7c9cc4dcddea36159b1b41c2",
      "skos:note": "Delegation of powers and functions"
    },
    {
      "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Subsection 96-2(1)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Repeal the subsection, substitute:\nEmployees etc. of Agencies and Commonwealth authorities\n\n(1) The Secretary may, in writing, delegate all or any of the powers\nand functions of the Secretary under this Act, the regulations or\nany Principles made under section 96-1 to a person engaged\n(whether as an employee or otherwise) by:\n\n(a) an Agency (within the meaning of the Public Service Act\n1999); or\n\n(b) an authority of the Commonwealth.\n\nAmendments  Schedule 1\nMain amendments  Part 1\n\nNo. 19, 2016\nAged Care Legislation Amendment (Increasing Consumer Choice) Act"
    },
