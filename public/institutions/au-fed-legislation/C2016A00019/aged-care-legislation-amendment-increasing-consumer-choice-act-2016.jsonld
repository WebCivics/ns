      },
      "dc:source": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf, p.29",
      "values:originalText": "care services before commencement\nThe Secretary may, at any time after the commencement time, make\npublicly available the number of places included in a home care service\nimmediately before the commencement time.",
      "skos:definition": "care services before commencement\nThe Secretary may, at any time after the commencement time, make\npublicly available the number of places included in a home care service\nimmediately before the commencement time.",
      "cml:asserts": [
