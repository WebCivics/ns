        },
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-46-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d80195a7c09ef2733f864e547539bd1a3146324241c03a5eaca44174d3c6eb2b",
      "skos:note": "Approved providers must deal with unspent home care amounts according to User Rights Principles."
    },
    {
      "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-46",
      "@type": "cof:Section",
