      "@type": "cml:Concept",
      "skos:prefLabel": "81 Information about number of places included in home",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-81"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
