        }
      ],
      "cml:integrityHash": "b33cb5dfd4a15f56b0ba6a96d133a923152b3672e54dc1e28889bc273e950ac4",
      "skos:note": "Repeal of section 10-2 Aged Care Act 1997 approval"
    },
    {
      "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-73",
      "@type": "cof:Section",
      "cof:title": "73 Approvals to no longer lapse",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "The repeal of section 10-2 of the Aged Care Act 1997 by this Schedule\napplies in relation to any approval of an aged care provider that is in\nforce at or after the commencement time."
    },
    {
