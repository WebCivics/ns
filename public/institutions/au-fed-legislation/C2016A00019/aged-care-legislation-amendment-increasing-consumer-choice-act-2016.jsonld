    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-82",
      "@type": "cml:Concept",
      "skos:prefLabel": "82 Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-82"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf"
      },
      "dc:source": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf, p.29",
      "values:originalText": "The amendments of subsection 96-2(1) of the Aged Care Act 1997 and\nthe Aged Care (Transitional Provisions) Act 1997 made by this\nSchedule do not affect the continuity of any delegation that is in force\nunder those subsections immediately before the commencement time.",
      "skos:definition": "The amendments of subsection 96-2(1) of the Aged Care Act 1997 and\nthe Aged Care (Transitional Provisions) Act 1997 made by this\nSchedule do not affect the continuity of any delegation that is in force\nunder those subsections immediately before the commencement time.",
      "cml:asserts": [
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-82-norm"
        }
      ],
      "cml:integrityHash": "fafa34dee306b4af7fa0bee90d7200b80b4403b24160d201947f070a48abe0e1",
      "skos:note": "Delegation continuity unaffected by amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-82",
      "@type": "cof:Section",
      "cof:title": "82 Delegation",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "The amendments of subsection 96-2(1) of the Aged Care Act 1997 and\nthe Aged Care (Transitional Provisions) Act 1997 made by this\nSchedule do not affect the continuity of any delegation that is in force\nunder those subsections immediately before the commencement time."
    },
    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-82-norm",
