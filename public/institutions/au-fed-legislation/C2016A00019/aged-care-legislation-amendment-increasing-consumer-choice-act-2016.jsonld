      "dc:source": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf, p.7",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "136708eab1a37a19d8b769ed2abfd0753e56e4f44a67f01e39d93acd0558db7f",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
