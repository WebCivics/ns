        }
      ],
      "cml:integrityHash": "e71559e7b728823b6ad1526b59ae85990e8d8731968b4eca582d4fcf10219c79",
      "skos:note": "Approved provider must hold allocation of place for home care subsidy in force under Part 2.2 of the Aged Care Act 1997."
    },
    {
