    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-65",
      "@type": "cml:Concept",
      "skos:prefLabel": "65 Subsection 96-2(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-65"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf"
      },
      "dc:source": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf, p.23",
      "values:originalText": "Repeal the subsection, substitute:\nEmployees etc. of Agencies and Commonwealth authorities\n\n(1) The Secretary may, in writing, delegate all or any of the powers\nand functions of the Secretary under this Act, the regulations or\nany Principles made under section 96-1 to a person engaged\n(whether as an employee or otherwise) by:\n\n(a) an Agency (within the meaning of the Public Service Act\n1999); or\n\n(b) an authority of the Commonwealth.",
      "skos:definition": "Repeal the subsection, substitute:\nEmployees etc. of Agencies and Commonwealth authorities\n\n(1) The Secretary may, in writing, delegate all or any of the powers\nand functions of the Secretary under this Act, the regulations or\nany Principles made under section 96-1 to a person engaged\n(whether as an employee or otherwise) by:\n\n(a) an Agency (within the meaning of the Public Service Act\n1999); or\n\n(b) an authority of the Commonwealth.",
      "cml:asserts": [
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-65-norm"
        }
      ],
      "cml:integrityHash": "2507f97bdd885a17dc325a7a4c44ecb6edc1608fca118e0dd2cb8fcc61bd0d62",
      "skos:note": "Delegate powers and functions to a person engaged by an Agency or authority."
    },
    {
      "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-65",
      "@type": "cof:Section",
      "cof:title": "65 Subsection 96-2(1)",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Repeal the subsection, substitute:\nEmployees etc. of Agencies and Commonwealth authorities\n\n(1) The Secretary may, in writing, delegate all or any of the powers\nand functions of the Secretary under this Act, the regulations or\nany Principles made under section 96-1 to a person engaged\n(whether as an employee or otherwise) by:\n\n(a) an Agency (within the meaning of the Public Service Act\n1999); or\n\n(b) an authority of the Commonwealth."
    },
