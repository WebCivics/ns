    {
      "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-54",
      "@type": "cml:Concept",
      "skos:prefLabel": "54 At the end of section 95-1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-54"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf"
      },
      "dc:source": "aged-care-legislation-amendment-increasing-consumer-choice-act-2016.pdf, p.20",
      "values:originalText": "Add:\n\n(3) The *Commonwealth portion of a care recipient’s *unspent home\ncare amount is a recoverable amount if:\n\n(a) the unspent home care amount relates to *home care subsidy,\nor home care fees, paid to an approved provider; and\n\n(b) after this subsection commenced, the approved provider was\npaid an amount of home care subsidy in respect of the care\nrecipient (whether or not the unspent home care amount\nrelates to that payment of subsidy); and\n\n(c) the Commonwealth portion is not payable under the User\nRights Principles to any other approved provider of home\ncare.",
      "skos:definition": "Add:\n\n(3) The *Commonwealth portion of a care recipient’s *unspent home\ncare amount is a recoverable amount if:\n\n(a) the unspent home care amount relates to *home care subsidy,\nor home care fees, paid to an approved provider; and\n\n(b) after this subsection commenced, the approved provider was\npaid an amount of home care subsidy in respect of the care\nrecipient (whether or not the unspent home care amount\nrelates to that payment of subsidy); and\n\n(c) the Commonwealth portion is not payable under the User\nRights Principles to any other approved provider of home\ncare.",
      "cml:asserts": [
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-54-norm"
        },
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-54-logic-deontic-1"
        },
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-54-logic-alleninterval-2"
        },
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-54-logic-deontic-3"
        },
        {
          "@id": "concept:aged-care-legislation-amendment-increasing-consumer-choice-act-2016-sch-1-sec-54-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "c71b1ca5922f08891134d7aa840bc000856f79d3ce291b80ef144496f81f2c74",
      "skos:note": "The Commonwealth portion of a care recipient's unspent home care amount is recoverable if certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/aged-care-legislation-amendment-increasing-consumer-choice-act-2016#sch-1-sec-54",
      "@type": "cof:Section",
      "cof:title": "54 At the end of section 95-1",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Add:\n\n(3) The *Commonwealth portion of a care recipient’s *unspent home\ncare amount is a recoverable amount if:\n\n(a) the unspent home care amount relates to *home care subsidy,\nor home care fees, paid to an approved provider; and\n\n(b) after this subsection commenced, the approved provider was\npaid an amount of home care subsidy in respect of the care\nrecipient (whether or not the unspent home care amount\nrelates to that payment of subsidy); and\n\n(c) the Commonwealth portion is not payable under the User\nRights Principles to any other approved provider of home\ncare."
    },
