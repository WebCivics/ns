    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11",
      "@type": "cml:Concept",
      "dc:source": "criminal-code-amendment-war-crimes-act-2016.pdf, p.10",
      "skos:note": "Exemption from liability for incidental death or injury to civilians during military operations.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "11 After subsection 268.72(1) of the Criminal Code"
      },
      "wasDerivedFrom": "criminal-code-amendment-war-crimes-act-2016.pdf",
      "asserts": [
        "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-norm",
        "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-deontic-1",
        "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-alleninterval-2",
        "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-ltl-3",
        "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-deontic-4",
        "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-deontic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "3c30b665835f7b0c356ad081dd5454119ca228334f52ff4011759bc97bc5afe2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:criminal-code-amendment-war-crimes-act-2016#sch-1-sec-11",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is a temporal overlap between the attack and civilian casualties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between attack and civilian casualties",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The perpetrator did not expect that the attack would result in the incidental death of, or injury to, civilians."
    },
    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to ensure that attacks do not result in excessive civilian casualties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Legal obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The perpetrator did not expect that the attack would result in the incidental death of, or injury to, civilians."
    },
    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "It is permitted for the perpetrator to launch an attack without expecting excessive civilian casualties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Permitted action",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:premiseText": "The perpetrator did not expect that the attack would result in the incidental death of, or injury to, civilians."
    },
    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is a legal obligation for the perpetrator to ensure that attacks do not result in excessive civilian casualties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Legal obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The perpetrator did not expect that the attack would result in the incidental death of, or injury to, civilians."
    },
    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is a recurring pattern of military operations that do not result in excessive civilian casualties.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring pattern of military operations",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrent",
      "cml:premiseText": "The perpetrator did not expect that the attack would result in the incidental death of, or injury to, civilians."
    },
