concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-268 a cml:Concept ;
    skos:prefLabel "268 125  Meaning of civilian"@en ;
    cml:realizedBy doc:sch-1-sec-268 ;
    values:originalText "In this Division, the expression civilian does not include a person who is a member of an organised armed group.  Amendments relating to war crimes  Schedule 1 Proportionality in non-international armed conflict  Part 2  No. 97, 2016 Criminal Code Amendment (War Crimes) Act 2016" ;
    skos:definition "In this Division, the expression civilian does not include a person who is a member of an organised armed group.  Amendments relating to war crimes  Schedule 1 Proportionality in non-international armed conflict  Part 2  No. 97, 2016 Criminal Code Amendment (War Crimes) Act 2016"@en ;
    cml:integrityHash "0e6c732ca0ff3387ce319e5e1a27e43c2529c1785b068b7056b87d8a8bfc9314" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Definition of civilian excludes members of an organised armed group." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
