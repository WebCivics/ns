concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-5 a cml:Concept ;
    skos:prefLabel "5 Paragraphs 268.72(1)(b) and (c) of the Criminal Code"@en ;
    cml:realizedBy doc:sch-1-sec-5 ;
    values:originalText "Repeal the paragraphs, substitute:  (b) the person or persons are neither taking an active part in the hostilities nor are members of an organised armed group; and  (c) the perpetrator knows of, or is reckless as to, the factual circumstances establishing that the person or persons are neither taking an active part in the hostilities nor are members of an organised armed group; and" ;
    skos:definition "Repeal the paragraphs, substitute:  (b) the person or persons are neither taking an active part in the hostilities nor are members of an organised armed group; and  (c) the perpetrator knows of, or is reckless as to, the factual circumstances establishing that the person or persons are neither taking an active part in the hostilities nor are members of an organised armed group; and"@en ;
    cml:integrityHash "7017acc2ba98bbda9d40a54a24153804daab151bec570faa862ee102e15538e6" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Repeal paragraphs and substitute conditions for active participation in hostilities or membership in an armed group." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
