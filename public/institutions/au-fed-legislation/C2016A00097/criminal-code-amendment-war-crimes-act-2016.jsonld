    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 After subsection 268.71(2) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sch-1-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "criminal-code-amendment-war-crimes-act-2016.pdf"
      },
      "dc:source": "criminal-code-amendment-war-crimes-act-2016.pdf, p.10",
      "values:originalText": "Insert:\n\n(2A) Subsection (2) does not apply if:\n\n(a) the serious endangerment of the physical or mental health, or\nintegrity, of the person or persons occurs in the course of, or\nas a result of, an attack on a military objective; and\n\n(b) at the time the attack was launched:\n\n(i) the perpetrator did not expect that the attack would\nresult in the incidental death of, or injury to, civilians\nthat would have been excessive in relation to the\nconcrete and direct military advantage anticipated; and\n\n(ii) it was reasonable in all the circumstances that the\nperpetrator did not have such an expectation.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2A). See subsection 13.3(3).",
      "skos:definition": "Insert:\n\n(2A) Subsection (2) does not apply if:\n\n(a) the serious endangerment of the physical or mental health, or\nintegrity, of the person or persons occurs in the course of, or\nas a result of, an attack on a military objective; and\n\n(b) at the time the attack was launched:\n\n(i) the perpetrator did not expect that the attack would\nresult in the incidental death of, or injury to, civilians\nthat would have been excessive in relation to the\nconcrete and direct military advantage anticipated; and\n\n(ii) it was reasonable in all the circumstances that the\nperpetrator did not have such an expectation.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2A). See subsection 13.3(3).",
      "cml:asserts": [
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-10-norm"
        },
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d4c194540f3326f98caf3b2c2932d3a6bbf3ac62cefdc1c0bdb5afe583a12097",
      "skos:note": "Defendant bears evidential burden in relation to the matter in subsection (2A)"
    },
    {
      "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sch-1-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 After subsection 268.71(2) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Insert:\n\n(2A) Subsection (2) does not apply if:\n\n(a) the serious endangerment of the physical or mental health, or\nintegrity, of the person or persons occurs in the course of, or\nas a result of, an attack on a military objective; and\n\n(b) at the time the attack was launched:\n\n(i) the perpetrator did not expect that the attack would\nresult in the incidental death of, or injury to, civilians\nthat would have been excessive in relation to the\nconcrete and direct military advantage anticipated; and\n\n(ii) it was reasonable in all the circumstances that the\nperpetrator did not have such an expectation.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (2A). See subsection 13.3(3)."
    },
