    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "criminal-code-amendment-war-crimes-act-2016.pdf"
      },
      "dc:source": "criminal-code-amendment-war-crimes-act-2016.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments relating to war crimes  Schedule 1\nMembers of organised armed groups  Part 1\n\nNo. 97, 2016\nCriminal Code Amendment (War Crimes) Act 2016",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments relating to war crimes  Schedule 1\nMembers of organised armed groups  Part 1\n\nNo. 97, 2016\nCriminal Code Amendment (War Crimes) Act 2016",
      "cml:asserts": [
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sec-3-norm"
        }
      ],
      "cml:integrityHash": "08f6c66daac63c3a7586c13ccc3b210be93f6c835eb551e74b40e73f0e2ab483",
      "skos:note": "Schedules have effect according to their terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments relating to war crimes  Schedule 1\nMembers of organised armed groups  Part 1\n\nNo. 97, 2016\nCriminal Code Amendment (War Crimes) Act 2016"
    },
