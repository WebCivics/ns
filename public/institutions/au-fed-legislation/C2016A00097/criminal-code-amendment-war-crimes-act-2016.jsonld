      }
    },
    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Paragraphs 268.70(1)(b) and (c) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "criminal-code-amendment-war-crimes-act-2016.pdf"
      },
      "dc:source": "criminal-code-amendment-war-crimes-act-2016.pdf, p.7",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(b) the person or persons are neither taking an active part in the\nhostilities nor are members of an organised armed group; and\n\n(c) the perpetrator knows of, or is reckless as to, the factual\ncircumstances establishing that the person or persons are\nneither taking an active part in the hostilities nor are\nmembers of an organised armed group; and",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(b) the person or persons are neither taking an active part in the\nhostilities nor are members of an organised armed group; and\n\n(c) the perpetrator knows of, or is reckless as to, the factual\ncircumstances establishing that the person or persons are\nneither taking an active part in the hostilities nor are\nmembers of an organised armed group; and",
      "cml:asserts": [
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7017acc2ba98bbda9d40a54a24153804daab151bec570faa862ee102e15538e6",
      "skos:note": "Prohibit taking an active part in hostilities or being a member of an organized armed group."
    },
    {
      "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Paragraphs 268.70(1)(b) and (c) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(b) the person or persons are neither taking an active part in the\nhostilities nor are members of an organised armed group; and\n\n(c) the perpetrator knows of, or is reckless as to, the factual\ncircumstances establishing that the person or persons are\nneither taking an active part in the hostilities nor are\nmembers of an organised armed group; and"
    },
