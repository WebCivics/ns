    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 After subsection 268.72(1) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sch-1-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "criminal-code-amendment-war-crimes-act-2016.pdf"
      },
      "dc:source": "criminal-code-amendment-war-crimes-act-2016.pdf, p.10",
      "values:originalText": "Insert:\n\n(1A) Subsection (1) does not apply if:\n\n(a) the infliction of the severe physical or mental pain or\nsuffering on the person or persons occurs in the course of, or\nas a result of, an attack on a military objective; and\n\n(b) at the time the attack was launched:\n\n(i) the perpetrator did not expect that the attack would\nresult in the incidental death of, or injury to, civilians\nthat would have been excessive in relation to the\nconcrete and direct military advantage anticipated; and\n\n(ii) it was reasonable in all the circumstances that the\nperpetrator did not have such an expectation.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (1A). See subsection 13.3(3).\n\nAmendments relating to war crimes  Schedule 1\nMinor technical amendment  Part 3\n\nNo. 97, 2016\nCriminal Code Amendment (War Crimes) Act 2016",
      "skos:definition": "Insert:\n\n(1A) Subsection (1) does not apply if:\n\n(a) the infliction of the severe physical or mental pain or\nsuffering on the person or persons occurs in the course of, or\nas a result of, an attack on a military objective; and\n\n(b) at the time the attack was launched:\n\n(i) the perpetrator did not expect that the attack would\nresult in the incidental death of, or injury to, civilians\nthat would have been excessive in relation to the\nconcrete and direct military advantage anticipated; and\n\n(ii) it was reasonable in all the circumstances that the\nperpetrator did not have such an expectation.\nNote:\nA defendant bears an evidential burden in relation to the matter in\nsubsection (1A). See subsection 13.3(3).\n\nAmendments relating to war crimes  Schedule 1\nMinor technical amendment  Part 3\n\nNo. 97, 2016\nCriminal Code Amendment (War Crimes) Act 2016",
      "cml:asserts": [
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-norm"
        },
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-deontic-1"
        },
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-alleninterval-2"
        },
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-ltl-3"
        },
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-11-logic-deontic-4"
        },
