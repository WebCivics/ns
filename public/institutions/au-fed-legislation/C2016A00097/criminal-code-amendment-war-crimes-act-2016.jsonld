    {
      "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-268",
      "@type": "cml:Concept",
      "skos:prefLabel": "268 125  Meaning of civilian",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sch-1-sec-268"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "criminal-code-amendment-war-crimes-act-2016.pdf"
      },
      "dc:source": "criminal-code-amendment-war-crimes-act-2016.pdf, p.8",
      "values:originalText": "In this Division, the expression civilian does not include a person\nwho is a member of an organised armed group.\n\nAmendments relating to war crimes  Schedule 1\nProportionality in non-international armed conflict  Part 2\n\nNo. 97, 2016\nCriminal Code Amendment (War Crimes) Act 2016",
      "skos:definition": "In this Division, the expression civilian does not include a person\nwho is a member of an organised armed group.\n\nAmendments relating to war crimes  Schedule 1\nProportionality in non-international armed conflict  Part 2\n\nNo. 97, 2016\nCriminal Code Amendment (War Crimes) Act 2016",
      "cml:asserts": [
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-268-norm"
        },
        {
          "@id": "concept:criminal-code-amendment-war-crimes-act-2016-sch-1-sec-268-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0e6c732ca0ff3387ce319e5e1a27e43c2529c1785b068b7056b87d8a8bfc9314",
      "skos:note": "Definition of civilian excludes members of an organised armed group."
    },
    {
      "@id": "https://ns.webcivics.net/values/criminal-code-amendment-war-crimes-act-2016#sch-1-sec-268",
      "@type": "cof:Section",
      "cof:title": "268 125  Meaning of civilian",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "In this Division, the expression civilian does not include a person\nwho is a member of an organised armed group.\n\nAmendments relating to war crimes  Schedule 1\nProportionality in non-international armed conflict  Part 2\n\nNo. 97, 2016\nCriminal Code Amendment (War Crimes) Act 2016"
    },
