    {
      "@id": "concept:crimes-hostages-act-1989-sec-3-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(Australian coastal sea) = (the territorial sea of Australia) and (the sea on the landward side of the territorial sea of Australia)",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
