    {
      "@id": "concept:crimes-hostages-act-1989-sec-15",
      "@type": "cml:Concept",
      "dc:source": "crimes-hostages-act-1989.pdf, p.12",
      "skos:note": "States shall report findings and intentions regarding jurisdiction. A person in custody is entitled to assistance under article 6 of the Convention. Any State Party may withdraw its reservation by notification to the Secretary-General of the United Nations.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15 Assistance under article 6 of Convention"
      },
