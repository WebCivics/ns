    {
      "@id": "concept:crimes-hostages-act-1989-sec-12-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the Attorney-General or the Director of Public Prosecutions notifies that court that he or she does not intend to file an indictment against the defendant in a court of another part of Australia,",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Notification period during which the defendant's obligation to appear is discharged.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(3) If, before the time at which the defendant is to appear before a court..."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-12-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...he or she be released; or...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Release from custody or discharge of recognizances.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "release",
      "cml:premiseText": "(3) If, before the time at which the defendant is to appear before a court..."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-12-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the defendant from the obligation to appear before that court at that time;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Discharge of obligation to appear.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "discharge",
      "cml:premiseText": "(3) If, before the time at which the defendant is to appear before a court..."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-12-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...he or she be released;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Release from custody.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "release",
      "cml:premiseText": "(3) If, before the time at which the defendant is to appear before a court..."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-12-ss-3-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the first-mentioned court shall, as soon as practicable after being so notified, make an order:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Notification period until which the defendant's obligation to appear is discharged.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:premiseText": "(3) If, before the time at which the defendant is to appear before a court..."
    },
