    {
      "@id": "concept:crimes-hostages-act-1989-sec-12-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-hostages-act-1989.pdf, p.10",
      "skos:note": "Proceedings on indictment must be discontinued if offence committed in another part of Australia.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "12(1) Change of venue"
      },
