    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-hostages-act-1989.pdf, p.8",
      "skos:note": "A person who commits an act of hostage-taking after the Convention enters into force for Australia commits an offence against this subsection.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "8(1) When hostage-taking an offence"
      },
      "wasDerivedFrom": "crimes-hostages-act-1989.pdf",
