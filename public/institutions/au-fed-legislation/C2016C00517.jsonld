    {
      "@id": "concept:crimes-hostages-act-1989-sec-15-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "State shall report its findings to the States or organization referred to in paragraph 2 of this article and indicate whether it intends to exercise jurisdiction.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "States are obligated to report findings and intentions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "shall",
      "cml:premiseText": "Article 6(2)"
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-15-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Assistance is owed.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The person has a right to assistance.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "Article 6 of the Convention"
    },
    {
