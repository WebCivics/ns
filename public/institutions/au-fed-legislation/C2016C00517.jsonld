    {
      "@id": "concept:crimes-hostages-act-1989-sec-9-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-hostages-act-1989.pdf, p.8",
      "skos:note": "No charge for acts not covered by the Convention.",
