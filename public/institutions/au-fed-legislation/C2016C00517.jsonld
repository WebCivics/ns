    {
      "@id": "concept:crimes-hostages-act-1989-sec-12-ss-3",
      "@type": "cml:Concept",
      "dc:source": "crimes-hostages-act-1989.pdf, p.10",
      "skos:note": "Defendant's obligation to appear before court discharged if indictment not filed.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "12(3) Change of venue"
      },
      "wasDerivedFrom": "crimes-hostages-act-1989.pdf",
