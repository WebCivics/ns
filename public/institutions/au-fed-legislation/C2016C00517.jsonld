        "concept:crimes-hostages-act-1989-sec-15-logic-deontic-3",
        "concept:crimes-hostages-act-1989-sec-15-logic-descriptionlogic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
