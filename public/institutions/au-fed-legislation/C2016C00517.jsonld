    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "A person who commits an act of hostage-taking after the Convention enters into force for Australia commits an offence against this subsection.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
