    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-hostages-act-1989.pdf, p.8",
      "skos:note": "Hostage-taking is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "8(2) When hostage-taking an offence"
      },
      "wasDerivedFrom": "crimes-hostages-act-1989.pdf",
      "asserts": [
        "concept:crimes-hostages-act-1989-sec-8-ss-2-norm",
        "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-deontic-1",
        "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-linearlogic-2",
        "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-alleninterval-3",
        "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-cogai-4",
        "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-n3logic-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "d99d02085e18eea8ee6b3d748977287afe5fc602170139284abe5cb786ed8a88",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-hostages-act-1989#sec-8-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-hostages-act-1989-sec-8"
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal interval of hostage-taking overlaps with the temporal intervals of offences punishable by imprisonment for life or for any lesser term",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Hostage-taking overlaps with offences punishable by imprisonment for life or for any lesser term",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(2) The punishment for an offence against subsection (1) is imprisonment for life or for any lesser term."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Hostage-taking is classified as an offence based on its punishment",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Classifies hostage-taking as an offence based on its punishment",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Classification",
      "cml:premiseText": "(2) The punishment for an offence against subsection (1) is imprisonment for life or for any lesser term."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Hostage-taking is prohibited",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits hostage-taking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(2) The punishment for an offence against subsection (1) is imprisonment for life or for any lesser term."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "If the punishment for an offence against subsection (1) includes imprisonment for life or for any lesser term, then hostage-taking is an offence",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::linear",
      "cml:logicSummary": "Implies that hostage-taking is an offence if it is punishable by imprisonment for life or for any lesser term",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "(2) The punishment for an offence against subsection (1) is imprisonment for life or for any lesser term."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-2-logic-n3logic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Hostage-taking is a subclass of offences",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::n3_compiler",
      "cml:logicSummary": "Represents hostage-taking as a subclass of offences",
      "cml:modality": {
        "@id": "cml:N3Logic"
      },
      "cml:operator": "RDF",
      "cml:premiseText": "(2) The punishment for an offence against subsection (1) is imprisonment for life or for any lesser term."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-2-norm",
      "@type": "doc:Prohibition",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "borneBy": "doc:Agent",
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:crimes-hostages-act-1989-sec-8-ss-2"
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-3",
      "@type": "cml:Concept",
      "dc:source": "crimes-hostages-act-1989.pdf, p.8",
      "skos:note": "Subject to section 9, a person shall not be charged with an offence against this Act unless certain conditions are met.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "8(3) When hostage-taking an offence"
      },
      "wasDerivedFrom": "crimes-hostages-act-1989.pdf",
      "asserts": [
        "concept:crimes-hostages-act-1989-sec-8-ss-3-norm",
        "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-1",
        "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-2",
        "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-3",
        "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-alleninterval-4",
        "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-ltl-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "40ab16c6fa38d990406a000ce05403eabf2fac2d2bec290ee10c6a8078bf5d7c",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:crimes-hostages-act-1989#sec-8-ss-3",
      "cml:schemaVersion": "2",
      "partOf": "concept:crimes-hostages-act-1989-sec-8"
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(ii) The person is present in Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The conditions overlap with each other.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(i) The person is an Australian citizen."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(i) The person is an Australian citizen.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the act was committed outside Australia, then the person must be an Australian citizen.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(ii) The person is not an Australian citizen."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(i) The person is present in Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the act was committed outside Australia, then the person must be present in Australia.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(ii) The person is not present in Australia."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(i) The act is committed to compel an institution.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the act was committed outside Australia, then the act must be committed to compel a legislative, executive or judicial institution in Australia.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(iii) The person is not committing the act to compel an institution."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-3-logic-ltl-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The conditions repeat over time.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The conditions repeat over time.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats"
    },
    {
      "@id": "concept:crimes-hostages-act-1989-sec-8-ss-3-norm",
      "@type": "doc:Obligation",
      "skos:scopeNote": "borne by: State",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
