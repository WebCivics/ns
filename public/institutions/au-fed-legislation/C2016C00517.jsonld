      "cml:logicSummary": "Class hierarchy for Australian aircraft and coastal sea",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "(Australian aircraft) = (an aircraft registered under regulations made under the Civil Aviation Act 1988) or (an aircraft that is owned by, or is in the possession or control of, the Commonwealth or an authority of the Commonwealth) or (an aircraft of any part of the Defence Force)"
    },
