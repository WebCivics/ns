concept:crimes-hostages-act-1989-article-17 a cml:Concept ;
    skos:prefLabel "17 1."@en ;
    cml:realizedBy doc:article-17 ;
    values:originalText "This Convention is open for signature by all States until 31 December 1980 at United Nations Headquarters in New York. 2. This Convention is subject to ratification. The instruments of ratification shall be deposited with the Secretary-General of the United Nations. 3. This Convention is open for accession by any State. The instruments of accession shall be deposited with the Secretary-General of the United Nations." ;
    skos:definition "This Convention is open for signature by all States until 31 December 1980 at United Nations Headquarters in New York. 2. This Convention is subject to ratification. The instruments of ratification shall be deposited with the Secretary-General of the United Nations. 3. This Convention is open for accession by any State. The instruments of accession shall be deposited with the Secretary-General of the United Nations."@en ;
    cml:integrityHash "c080c6c4c75fd61f9b996974e5d8a10b08e580a9117dd87a5ff7232992841c2e" ;
    cof:pageNumber "19"^^xsd:integer ;
