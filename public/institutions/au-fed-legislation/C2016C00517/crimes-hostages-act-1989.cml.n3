concept:crimes-hostages-act-1989-article-12 a cml:Concept ;
    skos:prefLabel "12 In so far as the Geneva Conventions of 1949 for the protection of war victims or"@en ;
    cml:realizedBy doc:article-12 ;
    values:originalText "the Protocols Additional to those Conventions are applicable to a particular act of hostage-taking, and in so far as States Parties to this Convention are bound under those conventions to prosecute or hand over the hostage-taker, the present Convention shall not apply to an act of hostage-taking committed in the course of armed conflicts as defined in the Geneva Conventions of 1949 and the Protocols thereto, including armed conflicts mentioned in article 1, paragraph 4, of Additional Protocol I of 1977, in which peoples are fighting against colonial domination and alien occupation and against racist regimes in the exercise of their right of self-determination, as enshrined in the Charter of the United Nations and the Declaration on Principles of International Law concerning Friendly Relations and Co-operation among States in accordance with the Charter of the United Nations." ;
    skos:definition "the Protocols Additional to those Conventions are applicable to a particular act of hostage-taking, and in so far as States Parties to this Convention are bound under those conventions to prosecute or hand over the hostage-taker, the present Convention shall not apply to an act of hostage-taking committed in the course of armed conflicts as defined in the Geneva Conventions of 1949 and the Protocols thereto, including armed conflicts mentioned in article 1, paragraph 4, of Additional Protocol I of 1977, in which peoples are fighting against colonial domination and alien occupation and against racist regimes in the exercise of their right of self-determination, as enshrined in the Charter of the United Nations and the Declaration on Principles of International Law concerning Friendly Relations and Co-operation among States in accordance with the Charter of the United Nations."@en ;
    cml:integrityHash "75e7748633a35508dc92fd5b664e5951a766899d5576e619f75775a5afafccc3" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Exempts hostage-taking committed in armed conflicts from application of the Convention." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-hostages-act-1989.pdf> ;
    dc:source "crimes-hostages-act-1989.pdf, p.18" ;
