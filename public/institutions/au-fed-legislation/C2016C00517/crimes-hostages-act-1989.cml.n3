concept:crimes-hostages-act-1989-article-7 a cml:Concept ;
    skos:prefLabel "7 The State Party where the alleged offender is prosecuted shall in accordance"@en ;
    cml:realizedBy doc:article-7 ;
    values:originalText "with its laws communicate the final outcome of the proceedings to the Secretary-General of the United Nations, who shall transmit the information to the other States concerned and the international intergovernmental organizations concerned." ;
    skos:definition "with its laws communicate the final outcome of the proceedings to the Secretary-General of the United Nations, who shall transmit the information to the other States concerned and the international intergovernmental organizations concerned."@en ;
    cml:integrityHash "93a6fdebd9322d64a1a8488617c1389f07a4968e9b9f82f3b63b8c4bfe88a69a" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Communicate final outcome of proceedings to other States and international organizations." ;
