concept:crimes-hostages-act-1989-article-19 a cml:Concept ;
    skos:prefLabel "19 1."@en ;
    cml:realizedBy doc:article-19 ;
    values:originalText "Any State Party may denounce this Convention by written notification to the Secretary-General of the United Nations. 2. Denunciation shall take effect one year following the date on which notification is received by the Secretary-General of the United Nations." ;
