concept:crimes-hostages-act-1989-article-11 a cml:Concept ;
    skos:prefLabel "11 1."@en ;
    cml:realizedBy doc:article-11 ;
    values:originalText "States Parties shall afford one another the greatest measure of assistance in connexion with criminal proceedings brought in respect of the offences set forth in article 1, including the supply of all evidence at their disposal necessary for the proceedings. 2. The provisions of paragraph 1 of this article shall not affect obligations concerning mutual judicial assistance embodied in any other treaty." ;
    skos:definition "States Parties shall afford one another the greatest measure of assistance in connexion with criminal proceedings brought in respect of the offences set forth in article 1, including the supply of all evidence at their disposal necessary for the proceedings. 2. The provisions of paragraph 1 of this article shall not affect obligations concerning mutual judicial assistance embodied in any other treaty."@en ;
    cml:integrityHash "e6485f12c4b8c9ee63b7a47ed30c827c9846a6646dc427d8140a8e4f962d8c0d" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "States must provide assistance in criminal proceedings." ;
    dc:description "Evidence and other necessary materials" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
