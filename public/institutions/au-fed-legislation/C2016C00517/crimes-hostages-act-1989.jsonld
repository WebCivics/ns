      }
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.19",
      "values:originalText": "This Convention is open for signature by all States until 31 December\n1980 at United Nations Headquarters in New York.\n2.\nThis Convention is subject to ratification. The instruments of ratification\nshall be deposited with the Secretary-General of the United Nations.\n3.\nThis Convention is open for accession by any State. The instruments of\naccession shall be deposited with the Secretary-General of the United Nations.",
      "skos:definition": "This Convention is open for signature by all States until 31 December\n1980 at United Nations Headquarters in New York.\n2.\nThis Convention is subject to ratification. The instruments of ratification\nshall be deposited with the Secretary-General of the United Nations.\n3.\nThis Convention is open for accession by any State. The instruments of\naccession shall be deposited with the Secretary-General of the United Nations.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-17-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-17-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c080c6c4c75fd61f9b996974e5d8a10b08e580a9117dd87a5ff7232992841c2e",
      "skos:note": "States must ratify or accede to the Convention."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-17",
      "@type": "cof:Section",
      "cof:title": "17 1.",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "This Convention is open for signature by all States until 31 December\n1980 at United Nations Headquarters in New York.\n2.\nThis Convention is subject to ratification. The instruments of ratification\nshall be deposited with the Secretary-General of the United Nations.\n3.\nThis Convention is open for accession by any State. The instruments of\naccession shall be deposited with the Secretary-General of the United Nations."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-17-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
