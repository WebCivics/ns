      },
      "cml:premiseText": "Commencement requires temporal intervals",
      "cml:conclusionText": "Temporal intervals are required for commencement"
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.20",
      "values:originalText": "Any State Party may denounce this Convention by written notification to\nthe Secretary-General of the United Nations.\n2.\nDenunciation shall take effect one year following the date on which\nnotification is received by the Secretary-General of the United Nations.",
      "skos:definition": "Any State Party may denounce this Convention by written notification to\nthe Secretary-General of the United Nations.\n2.\nDenunciation shall take effect one year following the date on which\nnotification is received by the Secretary-General of the United Nations.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-19-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f1883a7e35572b2938a1a54ab439e89c3763b0a6b467d9e601d904e0f0a483ed",
      "skos:note": "Denunciation of the Convention"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-19",
      "@type": "cof:Section",
      "cof:title": "19 1.",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Any State Party may denounce this Convention by written notification to\nthe Secretary-General of the United Nations.\n2.\nDenunciation shall take effect one year following the date on which\nnotification is received by the Secretary-General of the United Nations."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-19-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
