  "@graph": [
    {
      "@id": "https://ns.webcivics.net/values/au/c2016c00517",
      "@type": "cof:Document",
      "dc:title": "Crimes (Hostages) Act 1989",
      "values:category": "AU",
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "dc:identifier": "No. 26 of 1989",
      "dc:date": "10 March 2016",
      "dc:description": "An Act to give effect to the International Convention Against the Taking of Hostages, and for related purposes"
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.13",
      "values:originalText": "Any person who seizes or detains and threatens to kill, to injure or to\ncontinue to detain another person (hereinafter referred to as the “hostage”) in\norder to compel a third party, namely, a State, an international\nintergovernmental organization, a natural or juridical person, or a group of\npersons, to do or abstain from doing any act as an explicit or implicit condition\nfor the release of the hostage commits the offence of taking of hostages\n(“hostage-taking”) within the meaning of this Convention.\n\nSchedule  International Convention Against The Taking Of Hostages\n\nCrimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n2.\nAny person who:\n(a)\nattempts to commit an act of hostage-taking, or\n(b)\nparticipates as an accomplice of anyone who commits or attempts\nto commit an act of hostage-taking,\nlikewise commits an offence for the purposes of this Convention.",
      "skos:definition": "Any person who seizes or detains and threatens to kill, to injure or to\ncontinue to detain another person (hereinafter referred to as the “hostage”) in\norder to compel a third party, namely, a State, an international\nintergovernmental organization, a natural or juridical person, or a group of\npersons, to do or abstain from doing any act as an explicit or implicit condition\nfor the release of the hostage commits the offence of taking of hostages\n(“hostage-taking”) within the meaning of this Convention.\n\nSchedule  International Convention Against The Taking Of Hostages\n\nCrimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n2.\nAny person who:\n(a)\nattempts to commit an act of hostage-taking, or\n(b)\nparticipates as an accomplice of anyone who commits or attempts\nto commit an act of hostage-taking,\nlikewise commits an offence for the purposes of this Convention.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-1-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "02799da7aeeb9fd033badb76ed345450ca3155c39dcac46cf924f29a0fe002b9",
      "skos:note": "Taking hostages is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-1",
      "@type": "cof:Section",
      "cof:title": "1 1.",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Any person who seizes or detains and threatens to kill, to injure or to\ncontinue to detain another person (hereinafter referred to as the “hostage”) in\norder to compel a third party, namely, a State, an international\nintergovernmental organization, a natural or juridical person, or a group of\npersons, to do or abstain from doing any act as an explicit or implicit condition\nfor the release of the hostage commits the offence of taking of hostages\n(“hostage-taking”) within the meaning of this Convention.\n\nSchedule  International Convention Against The Taking Of Hostages\n\nCrimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n2.\nAny person who:\n(a)\nattempts to commit an act of hostage-taking, or\n(b)\nparticipates as an accomplice of anyone who commits or attempts\nto commit an act of hostage-taking,\nlikewise commits an offence for the purposes of this Convention."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-1-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-hostages-act-1989-article-1"
      },
