        }
      ],
      "cml:integrityHash": "93a6fdebd9322d64a1a8488617c1389f07a4968e9b9f82f3b63b8c4bfe88a69a",
      "skos:note": "Communicate final outcome of proceedings to other States and international organizations."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-7",
      "@type": "cof:Section",
      "cof:title": "7 The State Party where the alleged offender is prosecuted shall in accordance",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "with its laws communicate the final outcome of the proceedings to the\nSecretary-General of the United Nations, who shall transmit the information to\nthe other States concerned and the international intergovernmental organizations\nconcerned."
    },
