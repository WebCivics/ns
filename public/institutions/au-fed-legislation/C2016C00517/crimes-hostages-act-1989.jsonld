    {
      "@id": "concept:crimes-hostages-act-1989-article-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.19",
      "values:originalText": "Any dispute between two or more States Parties concerning the\ninterpretation or application of this Convention which is not settled by\nnegotiation shall, at the request of one of them, be submitted to arbitration. If\nwithin six months from the date of the request for arbitration the parties are\nunable to agree on the organization of the arbitration, any one of those parties\nmay refer the dispute to the International Court of Justice by request in\nconformity with the Statute of the Court.\n2.\nEach State may at the time of signature or ratification of this Convention\nor accession thereto declare that it does not consider itself bound by paragraph 1\nof this article. The other States Parties shall not be bound by paragraph 1 of this\narticle with respect to any State Party which has made such a reservation.\n3.\nAny State Party which has made a reservation in accordance with\nparagraph 2 of this article may at any time withdraw that reservation by\nnotification to the Secretary-General of the United Nations.",
      "skos:definition": "Any dispute between two or more States Parties concerning the\ninterpretation or application of this Convention which is not settled by\nnegotiation shall, at the request of one of them, be submitted to arbitration. If\nwithin six months from the date of the request for arbitration the parties are\nunable to agree on the organization of the arbitration, any one of those parties\nmay refer the dispute to the International Court of Justice by request in\nconformity with the Statute of the Court.\n2.\nEach State may at the time of signature or ratification of this Convention\nor accession thereto declare that it does not consider itself bound by paragraph 1\nof this article. The other States Parties shall not be bound by paragraph 1 of this\narticle with respect to any State Party which has made such a reservation.\n3.\nAny State Party which has made a reservation in accordance with\nparagraph 2 of this article may at any time withdraw that reservation by\nnotification to the Secretary-General of the United Nations.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-16-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-16-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a62072e77fa7cc032c914f15f77651fca37f79c7bb16a501bc3b74169807b9ad",
      "skos:note": "States Parties must submit disputes to arbitration or the International Court of Justice."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-16",
      "@type": "cof:Section",
      "cof:title": "16 1.",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Any dispute between two or more States Parties concerning the\ninterpretation or application of this Convention which is not settled by\nnegotiation shall, at the request of one of them, be submitted to arbitration. If\nwithin six months from the date of the request for arbitration the parties are\nunable to agree on the organization of the arbitration, any one of those parties\nmay refer the dispute to the International Court of Justice by request in\nconformity with the Statute of the Court.\n2.\nEach State may at the time of signature or ratification of this Convention\nor accession thereto declare that it does not consider itself bound by paragraph 1\nof this article. The other States Parties shall not be bound by paragraph 1 of this\narticle with respect to any State Party which has made such a reservation.\n3.\nAny State Party which has made a reservation in accordance with\nparagraph 2 of this article may at any time withdraw that reservation by\nnotification to the Secretary-General of the United Nations."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-16-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
