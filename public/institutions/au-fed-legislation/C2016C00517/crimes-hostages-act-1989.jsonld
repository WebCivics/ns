      }
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 In so far as the Geneva Conventions of 1949 for the protection of war victims or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.18",
      "values:originalText": "the Protocols Additional to those Conventions are applicable to a particular act\nof hostage-taking, and in so far as States Parties to this Convention are bound\nunder those conventions to prosecute or hand over the hostage-taker, the present\nConvention shall not apply to an act of hostage-taking committed in the course\nof armed conflicts as defined in the Geneva Conventions of 1949 and the\nProtocols thereto, including armed conflicts mentioned in article 1, paragraph 4,\nof Additional Protocol I of 1977, in which peoples are fighting against colonial\ndomination and alien occupation and against racist regimes in the exercise of\ntheir right of self-determination, as enshrined in the Charter of the United\nNations and the Declaration on Principles of International Law concerning\nFriendly Relations and Co-operation among States in accordance with the\nCharter of the United Nations.",
      "skos:definition": "the Protocols Additional to those Conventions are applicable to a particular act\nof hostage-taking, and in so far as States Parties to this Convention are bound\nunder those conventions to prosecute or hand over the hostage-taker, the present\nConvention shall not apply to an act of hostage-taking committed in the course\nof armed conflicts as defined in the Geneva Conventions of 1949 and the\nProtocols thereto, including armed conflicts mentioned in article 1, paragraph 4,\nof Additional Protocol I of 1977, in which peoples are fighting against colonial\ndomination and alien occupation and against racist regimes in the exercise of\ntheir right of self-determination, as enshrined in the Charter of the United\nNations and the Declaration on Principles of International Law concerning\nFriendly Relations and Co-operation among States in accordance with the\nCharter of the United Nations.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-12-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "75e7748633a35508dc92fd5b664e5951a766899d5576e619f75775a5afafccc3",
      "skos:note": "Exempts hostage-taking committed in armed conflicts from application of the Convention."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-12",
      "@type": "cof:Section",
      "cof:title": "12 In so far as the Geneva Conventions of 1949 for the protection of war victims or",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "the Protocols Additional to those Conventions are applicable to a particular act\nof hostage-taking, and in so far as States Parties to this Convention are bound\nunder those conventions to prosecute or hand over the hostage-taker, the present\nConvention shall not apply to an act of hostage-taking committed in the course\nof armed conflicts as defined in the Geneva Conventions of 1949 and the\nProtocols thereto, including armed conflicts mentioned in article 1, paragraph 4,\nof Additional Protocol I of 1977, in which peoples are fighting against colonial\ndomination and alien occupation and against racist regimes in the exercise of\ntheir right of self-determination, as enshrined in the Charter of the United\nNations and the Declaration on Principles of International Law concerning\nFriendly Relations and Co-operation among States in accordance with the\nCharter of the United Nations."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-12-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-hostages-act-1989-article-12"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-12-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits hostage-taking in armed conflicts.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 This Convention shall not apply where the offence is committed within a single",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.18",
      "values:originalText": "State, the hostage and the alleged offender are nationals of that State and the\nalleged offender is found in the territory of that State.",
      "skos:definition": "State, the hostage and the alleged offender are nationals of that State and the\nalleged offender is found in the territory of that State.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-13-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ba9663ec5866a45667b73dd369233948743e087b7733fb281bc1d4733e34aece",
      "skos:note": "Convention does not apply in certain circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-13",
      "@type": "cof:Section",
      "cof:title": "13 This Convention shall not apply where the offence is committed within a single",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "State, the hostage and the alleged offender are nationals of that State and the\nalleged offender is found in the territory of that State."
    },
    {
