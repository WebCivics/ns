    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Schedule  International Convention Against The Taking Of Hostages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.19",
      "values:originalText": "Crimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n1.\nThis Convention shall enter into force on the thirtieth day following the\ndate of deposit of the twenty-second instrument of ratification or accession with\nthe Secretary-General of the United Nations.\n2.\nFor each State ratifying or acceding to the Convention after the deposit of\nthe twenty-second instrument of ratification or accession, the Convention shall\nenter into force on the thirtieth day after deposit by such State of its instrument\nof ratification or accession.",
      "skos:definition": "Crimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n1.\nThis Convention shall enter into force on the thirtieth day following the\ndate of deposit of the twenty-second instrument of ratification or accession with\nthe Secretary-General of the United Nations.\n2.\nFor each State ratifying or acceding to the Convention after the deposit of\nthe twenty-second instrument of ratification or accession, the Convention shall\nenter into force on the thirtieth day after deposit by such State of its instrument\nof ratification or accession.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-18-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-18-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "6df8c285cfdd1729407fb082ae62f1b1a86d242c5d263188098793d8af91a89e",
      "skos:note": "Schedule for International Convention Against The Taking Of Hostages"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-18",
      "@type": "cof:Section",
      "cof:title": "18 Schedule  International Convention Against The Taking Of Hostages",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Crimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n1.\nThis Convention shall enter into force on the thirtieth day following the\ndate of deposit of the twenty-second instrument of ratification or accession with\nthe Secretary-General of the United Nations.\n2.\nFor each State ratifying or acceding to the Convention after the deposit of\nthe twenty-second instrument of ratification or accession, the Convention shall\nenter into force on the thirtieth day after deposit by such State of its instrument\nof ratification or accession."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-18-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
