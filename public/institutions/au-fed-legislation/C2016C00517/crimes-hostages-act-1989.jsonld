    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.14",
      "values:originalText": "The State Party in the territory of which the hostage is held by the\noffender shall take all measures it considers appropriate to ease the situation of\nthe hostage, in particular, to secure his release and, after his release, to facilitate,\nwhen relevant, his departure.\n2.\nIf any object which the offender has obtained as a result of the taking of\nhostages comes into the custody of a State Party, that State Party shall return it\nas soon as possible to the hostage or the third party referred to in article 1, as the\ncase may be, or to the appropriate authorities thereof.",
      "skos:definition": "The State Party in the territory of which the hostage is held by the\noffender shall take all measures it considers appropriate to ease the situation of\nthe hostage, in particular, to secure his release and, after his release, to facilitate,\nwhen relevant, his departure.\n2.\nIf any object which the offender has obtained as a result of the taking of\nhostages comes into the custody of a State Party, that State Party shall return it\nas soon as possible to the hostage or the third party referred to in article 1, as the\ncase may be, or to the appropriate authorities thereof.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-3-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c5e64ba5ade2514c505b52a234a557aa4ec4d63921cbedd7f03eec3cb3e975a2",
      "skos:note": "State Party must take measures to ease hostage situation and secure release."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-3",
      "@type": "cof:Section",
      "cof:title": "3 1.",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The State Party in the territory of which the hostage is held by the\noffender shall take all measures it considers appropriate to ease the situation of\nthe hostage, in particular, to secure his release and, after his release, to facilitate,\nwhen relevant, his departure.\n2.\nIf any object which the offender has obtained as a result of the taking of\nhostages comes into the custody of a State Party, that State Party shall return it\nas soon as possible to the hostage or the third party referred to in article 1, as the\ncase may be, or to the appropriate authorities thereof."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-hostages-act-1989-article-3"
