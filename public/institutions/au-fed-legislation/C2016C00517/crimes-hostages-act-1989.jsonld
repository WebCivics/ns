      },
      "cml:operator": "MUST",
      "cml:logicSummary": "States Parties must submit disputes to arbitration or the International Court of Justice.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
