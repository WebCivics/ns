      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "State Party has an obligation to take measures.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
