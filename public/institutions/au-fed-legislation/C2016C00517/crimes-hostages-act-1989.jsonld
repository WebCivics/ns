        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Each State Party shall make the offences set forth in article 1 punishable by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.14",
      "values:originalText": "appropriate penalties which take into account the grave nature of those offences.",
      "skos:definition": "appropriate penalties which take into account the grave nature of those offences.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-2-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b68dc82e285689696f8c1775a415b784261b0fe1786ab3b9f3c2309d031e88bc",
      "skos:note": "States must impose penalties for offences listed in article 1."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-2",
      "@type": "cof:Section",
      "cof:title": "2 Each State Party shall make the offences set forth in article 1 punishable by",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "appropriate penalties which take into account the grave nature of those offences."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
