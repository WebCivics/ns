    {
      "@id": "concept:crimes-hostages-act-1989-article-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 International Convention Against The Taking Of Hostages  Schedule",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.18",
      "values:originalText": "Crimes (Hostages) Act 1989\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\nNothing in this Convention shall be construed as justifying the violation of the\nterritorial integrity or political independence of a State in contravention of the\nCharter of the United Nations.",
      "skos:definition": "Crimes (Hostages) Act 1989\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\nNothing in this Convention shall be construed as justifying the violation of the\nterritorial integrity or political independence of a State in contravention of the\nCharter of the United Nations.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-14-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0346aca469199db9b317cae42b4cab39e9f94e642035c16f161b5f4250481354",
      "skos:note": "No violation of territorial integrity or political independence is justified."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-14",
      "@type": "cof:Section",
      "cof:title": "14 International Convention Against The Taking Of Hostages  Schedule",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Crimes (Hostages) Act 1989\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\nNothing in this Convention shall be construed as justifying the violation of the\nterritorial integrity or political independence of a State in contravention of the\nCharter of the United Nations."
    },
