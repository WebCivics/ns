      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.16",
      "values:originalText": "with its laws communicate the final outcome of the proceedings to the\nSecretary-General of the United Nations, who shall transmit the information to\nthe other States concerned and the international intergovernmental organizations\nconcerned.",
      "skos:definition": "with its laws communicate the final outcome of the proceedings to the\nSecretary-General of the United Nations, who shall transmit the information to\nthe other States concerned and the international intergovernmental organizations\nconcerned.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-7-norm"
