    {
      "@id": "concept:crimes-hostages-act-1989-article-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 The provisions of this Convention shall not affect the application of the Treaties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.19",
      "values:originalText": "on Asylum, in force at the date of the adoption of this Convention, as between\nthe States which are parties to those Treaties; but a State Party to this\nConvention may not invoke those Treaties with respect to another State Party to\nthis Convention which is not a party to those treaties.",
      "skos:definition": "on Asylum, in force at the date of the adoption of this Convention, as between\nthe States which are parties to those Treaties; but a State Party to this\nConvention may not invoke those Treaties with respect to another State Party to\nthis Convention which is not a party to those treaties.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-15-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-15-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-15-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-15-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-15-logic-deontic-4"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-15-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "f272307fd0ffaec37a992736d18bac45d35ec378ef444f22bf6f1c1fcd777b07",
      "skos:note": "A State Party may not invoke other treaties with respect to another State Party that is also a party to this Convention."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-15",
      "@type": "cof:Section",
      "cof:title": "15 The provisions of this Convention shall not affect the application of the Treaties",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "on Asylum, in force at the date of the adoption of this Convention, as between\nthe States which are parties to those Treaties; but a State Party to this\nConvention may not invoke those Treaties with respect to another State Party to\nthis Convention which is not a party to those treaties."
    },
