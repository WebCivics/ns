    {
      "@id": "concept:crimes-hostages-act-1989-article-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 The State Party where the alleged offender is prosecuted shall in accordance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-7"
      },
      "cml:curationStatus": {
