        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "...the person’s position may be prejudiced: (i) for any of the reasons mentioned in subparagraph...",
      "cml:conclusionText": "...if the requested State Party has substantial grounds for believing..."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-9-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
