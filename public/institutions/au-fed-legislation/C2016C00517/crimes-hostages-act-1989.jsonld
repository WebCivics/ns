      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "State Party has an obligation to submit the case.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The State Party is required to do so.",
      "cml:conclusionText": "Submission of the case is mandatory."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-8-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The obligation applies to all stages of the proceedings.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The obligation is not limited to specific stages.",
      "cml:conclusionText": "The obligation overlaps with all stages of the proceedings."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-8-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Submission of the case implies prosecution.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Submission of the case is required.",
      "cml:conclusionText": "Prosecution follows from submission of the case."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.17",
      "values:originalText": "A request for the extradition of an alleged offender, pursuant to this\nConvention, shall not be granted if the requested State Party has substantial\ngrounds for believing:\n(a)\nthat the request for extradition for an offence set forth in article 1\nhas been made for the purpose of prosecuting or punishing a person\non account of his race, religion, nationality, ethnic origin or\npolitical opinion; or\n(b)\nthat the person’s position may be prejudiced:\n(i) for any of the reasons mentioned in subparagraph (a) of this\nparagraph, or\n(ii) for the reason that communication with him by the\nappropriate authorities of the State entitled to exercise rights\nof protection cannot be effected.\n2.\nWith respect to the offences as defined in this Convention, the provisions\nof all extradition treaties and arrangements applicable between States Parties are\nmodified as between States Parties to the extent that they are incompatible with\nthis Convention.",
      "skos:definition": "A request for the extradition of an alleged offender, pursuant to this\nConvention, shall not be granted if the requested State Party has substantial\ngrounds for believing:\n(a)\nthat the request for extradition for an offence set forth in article 1\nhas been made for the purpose of prosecuting or punishing a person\non account of his race, religion, nationality, ethnic origin or\npolitical opinion; or\n(b)\nthat the person’s position may be prejudiced:\n(i) for any of the reasons mentioned in subparagraph (a) of this\nparagraph, or\n(ii) for the reason that communication with him by the\nappropriate authorities of the State entitled to exercise rights\nof protection cannot be effected.\n2.\nWith respect to the offences as defined in this Convention, the provisions\nof all extradition treaties and arrangements applicable between States Parties are\nmodified as between States Parties to the extent that they are incompatible with\nthis Convention.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-9-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-9-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-9-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-9-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-9-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-9-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "e72f7a1b0b8e21eb124d6fec3591c5ca2f5619b2247f42131369f0858f55b851",
      "skos:note": "Extradition request denied if requested State has substantial grounds for believing the request is made for discriminatory purposes or communication with the person cannot be effected."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-9",
      "@type": "cof:Section",
      "cof:title": "9 1.",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "A request for the extradition of an alleged offender, pursuant to this\nConvention, shall not be granted if the requested State Party has substantial\ngrounds for believing:\n(a)\nthat the request for extradition for an offence set forth in article 1\nhas been made for the purpose of prosecuting or punishing a person\non account of his race, religion, nationality, ethnic origin or\npolitical opinion; or\n(b)\nthat the person’s position may be prejudiced:\n(i) for any of the reasons mentioned in subparagraph (a) of this\nparagraph, or\n(ii) for the reason that communication with him by the\nappropriate authorities of the State entitled to exercise rights\nof protection cannot be effected.\n2.\nWith respect to the offences as defined in this Convention, the provisions\nof all extradition treaties and arrangements applicable between States Parties are\nmodified as between States Parties to the extent that they are incompatible with\nthis Convention."
    },
