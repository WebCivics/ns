    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.17",
      "values:originalText": "The offences set forth in article 1 shall be deemed to be included as\nextraditable offences in any extradition treaty existing between States Parties.\nStates Parties undertake to include such offences as extraditable offences in\nevery extradition treaty to be concluded between them.\n2.\nIf a State Party which makes extradition conditional on the existence of a\ntreaty receives a request for extradition from another State Party with which it\nhas no extradition treaty, the requested State may at its option consider this\nConvention as the legal basis for extradition in respect of the offences set forth\nin article 1. Extradition shall be subject to the other conditions provided by the\nlaw of the requested State.\n\nSchedule  International Convention Against The Taking Of Hostages\n\nCrimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n3.\nStates Parties which do not make extradition conditional on the existence\nof a treaty shall recognize the offences set forth in article 1 as extraditable\noffences between themselves subject to the conditions provided by the law of\nthe requested State.\n4.\nThe offences set forth in article 1 shall be treated, for the purpose of\nextradition between States Parties, as if they had been committed not only in the\nplace in which they occurred but also in the territories of the States required to\nestablish their jurisdiction in accordance with paragraph 1 of article 5.",
      "skos:definition": "The offences set forth in article 1 shall be deemed to be included as\nextraditable offences in any extradition treaty existing between States Parties.\nStates Parties undertake to include such offences as extraditable offences in\nevery extradition treaty to be concluded between them.\n2.\nIf a State Party which makes extradition conditional on the existence of a\ntreaty receives a request for extradition from another State Party with which it\nhas no extradition treaty, the requested State may at its option consider this\nConvention as the legal basis for extradition in respect of the offences set forth\nin article 1. Extradition shall be subject to the other conditions provided by the\nlaw of the requested State.\n\nSchedule  International Convention Against The Taking Of Hostages\n\nCrimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n3.\nStates Parties which do not make extradition conditional on the existence\nof a treaty shall recognize the offences set forth in article 1 as extraditable\noffences between themselves subject to the conditions provided by the law of\nthe requested State.\n4.\nThe offences set forth in article 1 shall be treated, for the purpose of\nextradition between States Parties, as if they had been committed not only in the\nplace in which they occurred but also in the territories of the States required to\nestablish their jurisdiction in accordance with paragraph 1 of article 5.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-10-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "18b539bf64fba15e17eed04e9fe88035771e19a0fb52c33430ff8dafbc286f37",
      "skos:note": "States Parties undertake to include such offences as extraditable offences in every extradition treaty to be concluded between them."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-10",
      "@type": "cof:Section",
      "cof:title": "10 1.",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "The offences set forth in article 1 shall be deemed to be included as\nextraditable offences in any extradition treaty existing between States Parties.\nStates Parties undertake to include such offences as extraditable offences in\nevery extradition treaty to be concluded between them.\n2.\nIf a State Party which makes extradition conditional on the existence of a\ntreaty receives a request for extradition from another State Party with which it\nhas no extradition treaty, the requested State may at its option consider this\nConvention as the legal basis for extradition in respect of the offences set forth\nin article 1. Extradition shall be subject to the other conditions provided by the\nlaw of the requested State.\n\nSchedule  International Convention Against The Taking Of Hostages\n\nCrimes (Hostages) Act 1989\n\nCompilation date: 10/3/16\nRegistered: 25/5/16\n\n3.\nStates Parties which do not make extradition conditional on the existence\nof a treaty shall recognize the offences set forth in article 1 as extraditable\noffences between themselves subject to the conditions provided by the law of\nthe requested State.\n4.\nThe offences set forth in article 1 shall be treated, for the purpose of\nextradition between States Parties, as if they had been committed not only in the\nplace in which they occurred but also in the territories of the States required to\nestablish their jurisdiction in accordance with paragraph 1 of article 5."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-10-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
