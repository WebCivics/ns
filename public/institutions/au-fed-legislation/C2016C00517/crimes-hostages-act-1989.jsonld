    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 States Parties shall co-operate in the prevention of the offences set forth in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.14",
      "values:originalText": "article 1, particularly by:\n(a)\ntaking all practicable measures to prevent preparations in their\nrespective territories for the commission of those offences within or\noutside their territories, including measures to prohibit in their\nterritories illegal activities of persons, groups and organizations that\nencourage, instigate, organize or engage in the perpetration of acts\nof taking of hostages;\n(b)\nexchanging information and co-ordinating the taking of\nadministrative and other measures as appropriate to prevent the\ncommission of those offences.",
      "skos:definition": "article 1, particularly by:\n(a)\ntaking all practicable measures to prevent preparations in their\nrespective territories for the commission of those offences within or\noutside their territories, including measures to prohibit in their\nterritories illegal activities of persons, groups and organizations that\nencourage, instigate, organize or engage in the perpetration of acts\nof taking of hostages;\n(b)\nexchanging information and co-ordinating the taking of\nadministrative and other measures as appropriate to prevent the\ncommission of those offences.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-4-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "300be10f6bd13e3b26ad0df6fb4fef1653f3fa22d9c88e21b66b0e10f4a124e7",
      "skos:note": "Cooperation in preventing offenses"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-4",
      "@type": "cof:Section",
      "cof:title": "4 States Parties shall co-operate in the prevention of the offences set forth in",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "article 1, particularly by:\n(a)\ntaking all practicable measures to prevent preparations in their\nrespective territories for the commission of those offences within or\noutside their territories, including measures to prohibit in their\nterritories illegal activities of persons, groups and organizations that\nencourage, instigate, organize or engage in the perpetration of acts\nof taking of hostages;\n(b)\nexchanging information and co-ordinating the taking of\nadministrative and other measures as appropriate to prevent the\ncommission of those offences."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-hostages-act-1989-article-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "shall",
      "cml:logicSummary": "Imperative mood",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
