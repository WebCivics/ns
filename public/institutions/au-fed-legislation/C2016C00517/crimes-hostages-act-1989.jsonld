        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "...the appropriate authorities of the State entitled to exercise rights of protection cannot be effected.",
      "cml:conclusionText": "...if the requested State Party has substantial grounds for believing..."
    },
