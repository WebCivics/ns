      }
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 1.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-hostages-act-1989.pdf"
      },
      "dc:source": "crimes-hostages-act-1989.pdf, p.18",
      "values:originalText": "States Parties shall afford one another the greatest measure of assistance\nin connexion with criminal proceedings brought in respect of the offences set\nforth in article 1, including the supply of all evidence at their disposal necessary\nfor the proceedings.\n2.\nThe provisions of paragraph 1 of this article shall not affect obligations\nconcerning mutual judicial assistance embodied in any other treaty.",
      "skos:definition": "States Parties shall afford one another the greatest measure of assistance\nin connexion with criminal proceedings brought in respect of the offences set\nforth in article 1, including the supply of all evidence at their disposal necessary\nfor the proceedings.\n2.\nThe provisions of paragraph 1 of this article shall not affect obligations\nconcerning mutual judicial assistance embodied in any other treaty.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-hostages-act-1989-article-11-norm"
        },
        {
          "@id": "concept:crimes-hostages-act-1989-article-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e6485f12c4b8c9ee63b7a47ed30c827c9846a6646dc427d8140a8e4f962d8c0d",
      "skos:note": "States must provide assistance in criminal proceedings.",
      "dc:description": "Evidence and other necessary materials"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-hostages-act-1989#article-11",
      "@type": "cof:Section",
      "cof:title": "11 1.",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "States Parties shall afford one another the greatest measure of assistance\nin connexion with criminal proceedings brought in respect of the offences set\nforth in article 1, including the supply of all evidence at their disposal necessary\nfor the proceedings.\n2.\nThe provisions of paragraph 1 of this article shall not affect obligations\nconcerning mutual judicial assistance embodied in any other treaty."
    },
    {
      "@id": "concept:crimes-hostages-act-1989-article-11-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
