      "cml:logicSummary": "Information diffusion",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:premiseText": "(3) The trial of an offence against this Act not committed within a State may be held by a court of competent jurisdiction at any place where the court may sit."
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-sec-15-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The trial holds for all times when the court is competent and can sit there.",
      "cml:confidence": {
