    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-sec-15-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The trial can occur at any time when the court is competent and can sit there.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlaps",
      "cml:premiseText": "(3) The trial of an offence against this Act not committed within a State may be held by a court of competent jurisdiction at any place where the court may sit."
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-sec-15-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The artificial intelligence recognizes that the court has jurisdiction over trials outside the state.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Artificial intelligence recognition",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:premiseText": "(3) The trial of an offence against this Act not committed within a State may be held by a court of competent jurisdiction at any place where the court may sit."
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-sec-15-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The court has jurisdiction over trials outside the state.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Court jurisdiction",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:premiseText": "(3) The trial of an offence against this Act not committed within a State may be held by a court of competent jurisdiction at any place where the court may sit."
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-sec-15-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information about the trial diffuses to all places where the court can sit.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
