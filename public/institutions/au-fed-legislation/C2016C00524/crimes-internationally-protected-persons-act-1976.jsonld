    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 1. States Parties shall afford one another the greatest measure of assistance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-10"
      },
      "cml:curationStatus": {
