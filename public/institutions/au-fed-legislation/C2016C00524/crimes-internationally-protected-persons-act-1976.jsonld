    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 1. The State Party in which any of the crimes set forth in article 2 has been",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-internationally-protected-persons-act-1976.pdf"
      },
      "dc:source": "crimes-internationally-protected-persons-act-1976.pdf, p.19",
      "values:originalText": "committed shall, if it has reason to believe that an alleged offender has fled\nfrom its territory, communicate to all other States concerned, directly or through\nthe Secretary-General of the United Nations, all the pertinent facts regarding the\ncrime committed and all available information regarding the identity of the\nalleged offender.\n2. Whenever any of the crimes set forth in article 2 has been committed\nagainst an internationally protected person, any State Party which has\ninformation concerning the victim and the circumstances of the crime shall\nendeavour to transmit it, under the conditions provided for in its internal law,\nfully and promptly to the State Party on whose behalf he was exercising his\nfunctions.\n\nSchedule  Convention on the prevention and punishment of crimes against\ninternationally protected persons, including diplomatic agents\n\nCrimes (Internationally Protected Persons) Act 1976\n\nCompilation date: 10/3/16\nRegistered: 26/5/16",
      "skos:definition": "committed shall, if it has reason to believe that an alleged offender has fled\nfrom its territory, communicate to all other States concerned, directly or through\nthe Secretary-General of the United Nations, all the pertinent facts regarding the\ncrime committed and all available information regarding the identity of the\nalleged offender.\n2. Whenever any of the crimes set forth in article 2 has been committed\nagainst an internationally protected person, any State Party which has\ninformation concerning the victim and the circumstances of the crime shall\nendeavour to transmit it, under the conditions provided for in its internal law,\nfully and promptly to the State Party on whose behalf he was exercising his\nfunctions.\n\nSchedule  Convention on the prevention and punishment of crimes against\ninternationally protected persons, including diplomatic agents\n\nCrimes (Internationally Protected Persons) Act 1976\n\nCompilation date: 10/3/16\nRegistered: 26/5/16",
      "cml:asserts": [
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-5-norm"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c5e049cf5d4a40fdddb32f63f9773f90993ecb0d0cf1c9198598d8378a2d452d",
      "skos:note": "Communicate pertinent facts and available information regarding an alleged offender to other States concerned."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-5",
      "@type": "cof:Section",
      "cof:title": "5 1. The State Party in which any of the crimes set forth in article 2 has been",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "committed shall, if it has reason to believe that an alleged offender has fled\nfrom its territory, communicate to all other States concerned, directly or through\nthe Secretary-General of the United Nations, all the pertinent facts regarding the\ncrime committed and all available information regarding the identity of the\nalleged offender.\n2. Whenever any of the crimes set forth in article 2 has been committed\nagainst an internationally protected person, any State Party which has\ninformation concerning the victim and the circumstances of the crime shall\nendeavour to transmit it, under the conditions provided for in its internal law,\nfully and promptly to the State Party on whose behalf he was exercising his\nfunctions.\n\nSchedule  Convention on the prevention and punishment of crimes against\ninternationally protected persons, including diplomatic agents\n\nCrimes (Internationally Protected Persons) Act 1976\n\nCompilation date: 10/3/16\nRegistered: 26/5/16"
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-internationally-protected-persons-act-1976-article-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "State Party has an obligation to communicate pertinent facts and available information.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 1. Upon being satisfied that the circumstances so warrant, the State Party in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-internationally-protected-persons-act-1976.pdf"
      },
      "dc:source": "crimes-internationally-protected-persons-act-1976.pdf, p.20",
      "values:originalText": "whose territory the alleged offender is present shall take the appropriate\nmeasures under its internal law so as to ensure his presence for the purpose of\nprosecution or extradition. Such measures shall be notified without delay\ndirectly or through the Secretary-General of the United Nations to:\n\n(a) the State where the crime was committed;\n\n(b) the State or States of which the alleged offender is a national or, if he is\na stateless person, in whose territory he permanently resides;\n\n(c) the State or States of which the internationally protected person\nconcerned is a national or on whose behalf he was exercising his\nfunctions;\n\n(d) all other States concerned; and\n\n(e) the international organization of which the internationally protected\nperson concerned is an official or an agent.\n2. Any person regarding whom the measures referred to in paragraph 1 of\nthis article are being taken shall be entitled:\n\n(a) to communicate without delay with the nearest appropriate\nrepresentative of the State of which he is a national or which is\notherwise entitled to protect his rights or, if he is a stateless person,\nwhich he requests and which is willing to protect his rights; and\n\n(b) to be visited by a representative of that State.",
      "skos:definition": "whose territory the alleged offender is present shall take the appropriate\nmeasures under its internal law so as to ensure his presence for the purpose of\nprosecution or extradition. Such measures shall be notified without delay\ndirectly or through the Secretary-General of the United Nations to:\n\n(a) the State where the crime was committed;\n\n(b) the State or States of which the alleged offender is a national or, if he is\na stateless person, in whose territory he permanently resides;\n\n(c) the State or States of which the internationally protected person\nconcerned is a national or on whose behalf he was exercising his\nfunctions;\n\n(d) all other States concerned; and\n\n(e) the international organization of which the internationally protected\nperson concerned is an official or an agent.\n2. Any person regarding whom the measures referred to in paragraph 1 of\nthis article are being taken shall be entitled:\n\n(a) to communicate without delay with the nearest appropriate\nrepresentative of the State of which he is a national or which is\notherwise entitled to protect his rights or, if he is a stateless person,\nwhich he requests and which is willing to protect his rights; and\n\n(b) to be visited by a representative of that State.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-6-norm"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2ce39ae43ec2a90b17d27633487d3e96fe30baa75562a825bb6a95f2abaa6060",
      "skos:note": "State must notify other States and international organizations about measures taken to ensure presence for prosecution or extradition."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-6",
      "@type": "cof:Section",
      "cof:title": "6 1. Upon being satisfied that the circumstances so warrant, the State Party in",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "whose territory the alleged offender is present shall take the appropriate\nmeasures under its internal law so as to ensure his presence for the purpose of\nprosecution or extradition. Such measures shall be notified without delay\ndirectly or through the Secretary-General of the United Nations to:\n\n(a) the State where the crime was committed;\n\n(b) the State or States of which the alleged offender is a national or, if he is\na stateless person, in whose territory he permanently resides;\n\n(c) the State or States of which the internationally protected person\nconcerned is a national or on whose behalf he was exercising his\nfunctions;\n\n(d) all other States concerned; and\n\n(e) the international organization of which the internationally protected\nperson concerned is an official or an agent.\n2. Any person regarding whom the measures referred to in paragraph 1 of\nthis article are being taken shall be entitled:\n\n(a) to communicate without delay with the nearest appropriate\nrepresentative of the State of which he is a national or which is\notherwise entitled to protect his rights or, if he is a stateless person,\nwhich he requests and which is willing to protect his rights; and\n\n(b) to be visited by a representative of that State."
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-6-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-internationally-protected-persons-act-1976-article-6"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "State must take measures",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 The State Party in whose territory the alleged offender is present shall, if it",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-internationally-protected-persons-act-1976.pdf"
      },
      "dc:source": "crimes-internationally-protected-persons-act-1976.pdf, p.20",
      "values:originalText": "does not extradite him, submit, without exception whatsoever and without\nundue delay, the case to its competent authorities for the purpose of\nprosecution, through proceedings in accordance with the laws of that State.",
      "skos:definition": "does not extradite him, submit, without exception whatsoever and without\nundue delay, the case to its competent authorities for the purpose of\nprosecution, through proceedings in accordance with the laws of that State.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-7-norm"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bcc94d8cdf9da482c904e1ac0fae56943ec27c8f17b3cc62a40b5b08f731fac5",
      "skos:note": "State must submit case to competent authorities for prosecution without exception."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-7",
      "@type": "cof:Section",
      "cof:title": "7 The State Party in whose territory the alleged offender is present shall, if it",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "does not extradite him, submit, without exception whatsoever and without\nundue delay, the case to its competent authorities for the purpose of\nprosecution, through proceedings in accordance with the laws of that State."
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-7-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
