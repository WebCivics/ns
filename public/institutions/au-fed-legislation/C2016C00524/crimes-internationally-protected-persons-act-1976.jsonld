    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 This Convention shall be open for signature by all States, until 31 December",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-14"
      },
      "cml:curationStatus": {
