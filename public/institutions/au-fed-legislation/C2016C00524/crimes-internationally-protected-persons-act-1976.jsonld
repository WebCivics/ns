        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State Party to this Convention may not invoke those Treaties with respect to another State Party to this Convention which is not a party to those Treaties.",
      "cml:conclusionText": "Treaties on Asylum, in force at the date of the adoption of this Convention, as between the States which are parties to those Treaties"
    },
    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-12-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Overlaps with treaties on asylum in party states.",
