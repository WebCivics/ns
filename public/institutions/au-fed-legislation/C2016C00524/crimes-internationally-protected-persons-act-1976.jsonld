    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 The provisions of this Convention shall not affect the application of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-internationally-protected-persons-act-1976.pdf"
      },
      "dc:source": "crimes-internationally-protected-persons-act-1976.pdf, p.22",
      "values:originalText": "Treaties on Asylum, in force at the date of the adoption of this Convention, as\nbetween the States which are parties to those Treaties; but a State Party to this\nConvention may not invoke those Treaties with respect to another State Party to\nthis Convention which is not a party to those Treaties.",
      "skos:definition": "Treaties on Asylum, in force at the date of the adoption of this Convention, as\nbetween the States which are parties to those Treaties; but a State Party to this\nConvention may not invoke those Treaties with respect to another State Party to\nthis Convention which is not a party to those Treaties.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-12-norm"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-12-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-12-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-12-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-12-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-12-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "d747ab38fa61ba00f32eba6543e79af4fd543099a30956f7f66c2499984a32fc",
      "skos:note": "Prevents invoking treaties on asylum between non-party states."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-12",
      "@type": "cof:Section",
      "cof:title": "12 The provisions of this Convention shall not affect the application of the",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "Treaties on Asylum, in force at the date of the adoption of this Convention, as\nbetween the States which are parties to those Treaties; but a State Party to this\nConvention may not invoke those Treaties with respect to another State Party to\nthis Convention which is not a party to those Treaties."
    },
    {
