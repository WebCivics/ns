    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Feb",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-internationally-protected-persons-act-1976.pdf"
