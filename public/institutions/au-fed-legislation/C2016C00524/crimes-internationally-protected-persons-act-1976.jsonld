    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 States Parties shall co-operate in the prevention of the crimes set forth in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-internationally-protected-persons-act-1976.pdf"
      },
      "dc:source": "crimes-internationally-protected-persons-act-1976.pdf, p.19",
      "values:originalText": "article 2, particularly by:\n\n(a) taking all practicable measures to prevent preparations in their\nrespective territories for the commission of those crimes within or\noutside their territories;\n\n(b) exchanging information and co-ordinating the taking of administrative\nand other measures as appropriate to prevent the commission of those\ncrimes.",
      "skos:definition": "article 2, particularly by:\n\n(a) taking all practicable measures to prevent preparations in their\nrespective territories for the commission of those crimes within or\noutside their territories;\n\n(b) exchanging information and co-ordinating the taking of administrative\nand other measures as appropriate to prevent the commission of those\ncrimes.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-4-norm"
        },
        {
          "@id": "concept:crimes-internationally-protected-persons-act-1976-article-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c81e082cafc813971502935c88722351b0759d615a9974dd8efb5ca33ceec18e",
      "skos:note": "States Parties shall co-operate in the prevention of crimes."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-4",
      "@type": "cof:Section",
      "cof:title": "4 States Parties shall co-operate in the prevention of the crimes set forth in",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "article 2, particularly by:\n\n(a) taking all practicable measures to prevent preparations in their\nrespective territories for the commission of those crimes within or\noutside their territories;\n\n(b) exchanging information and co-ordinating the taking of administrative\nand other measures as appropriate to prevent the commission of those\ncrimes."
    },
