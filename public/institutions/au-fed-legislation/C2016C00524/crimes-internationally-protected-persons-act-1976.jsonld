    {
      "@id": "concept:crimes-internationally-protected-persons-act-1976-article-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 The Secretary-General of the United Nations shall inform all States, inter",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-internationally-protected-persons-act-1976#article-19"
      },
      "cml:curationStatus": {
