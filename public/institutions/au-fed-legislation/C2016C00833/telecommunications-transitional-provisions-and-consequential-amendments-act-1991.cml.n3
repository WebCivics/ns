concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-8 a cml:Concept ;
    skos:prefLabel "8 Disclosure of pre-existing communications"@en ;
    cml:realizedBy doc:sch-2-sec-8 ;
    values:originalText "Section 88 of the Telecommunications Act 1991 applies to any disclosure or use by a person of a fact or document that takes place after the commencement of that section even though:  (a) it relates to a communication that was carried, or a telecommunications service that was supplied, before that commencement; or  (b) the fact or document came to the knowledge, or into the possession, of the person before that commencement." ;
    skos:definition "Section 88 of the Telecommunications Act 1991 applies to any disclosure or use by a person of a fact or document that takes place after the commencement of that section even though:  (a) it relates to a communication that was carried, or a telecommunications service that was supplied, before that commencement; or  (b) the fact or document came to the knowledge, or into the possession, of the person before that commencement."@en ;
    cml:integrityHash "51766ccb3f675c40aee34f0b833090a00b1126419eb033e275bfe54eb1a73b36" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Disclosure of pre-existing communications after commencement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
