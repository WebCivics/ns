concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7 a cml:Concept ;
    skos:prefLabel "7 Existing carriers may continue to operate pending grant of"@en ;
    cml:realizedBy doc:sch-2-sec-7 ;
    values:originalText "licences  (1) In this section: corporation to which this section applies means AUSSAT, OTC or Telecom.  (2) A corporation to which this section applies may, after the commencement of this section, continue to perform the functions and exercise the powers that it was entitled to perform and exercise immediately before that commencement until:  (a) a decision is made by the Minister whether to grant to the corporation a licence under section 57 of the Telecommunications Act 1991; or  (b) the Minister, by notice published in the Gazette, determines that this section is to cease to apply to the corporation; whichever first occurs.  (3) A corporation to which this section applies is taken to have been a general carrier within the meaning of the Telecommunications Act 1991, otherwise than for the purposes of Divisions 2 and 3 of" ;
    skos:definition "licences  (1) In this section: corporation to which this section applies means AUSSAT, OTC or Telecom.  (2) A corporation to which this section applies may, after the commencement of this section, continue to perform the functions and exercise the powers that it was entitled to perform and exercise immediately before that commencement until:  (a) a decision is made by the Minister whether to grant to the corporation a licence under section 57 of the Telecommunications Act 1991; or  (b) the Minister, by notice published in the Gazette, determines that this section is to cease to apply to the corporation; whichever first occurs.  (3) A corporation to which this section applies is taken to have been a general carrier within the meaning of the Telecommunications Act 1991, otherwise than for the purposes of Divisions 2 and 3 of"@en ;
    cml:integrityHash "7466684625aa64c2bc4f957a9968830843f8b1482e171b9f0771e101e7dfa072" ;
    cof:pageNumber "7"^^xsd:integer ;
    cml:hasPart concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7-ss-1 ;
    cml:hasPart concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7-ss-2 ;
    cml:hasPart concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
