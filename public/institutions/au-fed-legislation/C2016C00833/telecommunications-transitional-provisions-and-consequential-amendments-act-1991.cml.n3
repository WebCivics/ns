concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-9 a cml:Concept ;
    skos:prefLabel "9 Relief in respect of past infringing conduct"@en ;
    cml:realizedBy doc:sch-2-sec-9 ;
    values:originalText "Despite the repeal of section 69 of the Telecommunications Act 1989, that section continues in force in respect of conduct that was engaged in before that section was repealed." ;
    skos:definition "Despite the repeal of section 69 of the Telecommunications Act 1989, that section continues in force in respect of conduct that was engaged in before that section was repealed."@en ;
