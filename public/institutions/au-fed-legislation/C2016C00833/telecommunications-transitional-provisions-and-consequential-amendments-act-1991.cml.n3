doc:sch-2-sec-21-ss-1 a cof:Section ;
    cof:title "21(1) Existing regulations under Telecommunications (Application" ;
    values:kind "subsection" ;
    values:originalText "(1) Subject to subsection (3), any regulations made under the Telecommunications (Application Fees) Act 1989 and in force immediately before the repeal of that Act continue in force as if made under the Telecommunications (Application Fees) Act 1991." ;
    cof:pageNumber "13"^^xsd:integer .

concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-21-ss-2 a cml:Concept ;
    skos:prefLabel "21(2) Existing regulations under Telecommunications (Application"@en ;
    cml:realizedBy doc:sch-2-sec-21-ss-2 ;
    values:originalText "(2) A reference in a regulation so continued in force to a provision of the Telecommunications Act 1989 is taken to be a reference to the corresponding provision of the Telecommunications Act 1991." ;
    skos:definition "(2) A reference in a regulation so continued in force to a provision of the Telecommunications Act 1989 is taken to be a reference to the corresponding provision of the Telecommunications Act 1991."@en ;
