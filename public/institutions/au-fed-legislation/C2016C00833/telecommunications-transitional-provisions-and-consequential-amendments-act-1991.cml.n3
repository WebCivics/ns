concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "takes-over" ;
    cml:logicSummary "Obligation to take over existing licences." ;
    cml:premiseText "Previous cabling licence is taken to be a new cabling licence." ;
    cml:conclusionText "New cabling licence includes the conditions of the previous licence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16 cml:asserts concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-descriptionlogic-2 .
concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "includes" ;
    cml:logicSummary "Description logic for including conditions in new licences." ;
    cml:premiseText "The new cabling licence includes the conditions to which the previous cabling licence was subject." ;
    cml:conclusionText "New cabling licence has the same conditions as the previous licence." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16 cml:asserts concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-alleninterval-3 .
concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "on" ;
    cml:logicSummary "Temporal relation for taking over licences." ;
    cml:premiseText "The new cabling licence is taken on the commencement of Part 12." ;
    cml:conclusionText "The new cabling licence takes effect at the same time as the previous licence." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16 cml:asserts concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-argumentation-4 .
concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-argumentation-4 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "implies" ;
    cml:logicSummary "Implication for holder of licences." ;
    cml:premiseText "If a person held the previous cabling licence, they are taken to be the holder of the new licence." ;
    cml:conclusionText "The holder of the new licence is implied to be the same as the holder of the previous licence." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16 cml:asserts concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-diffusion-5 .
concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-diffusion-5 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "diffuses" ;
    cml:logicSummary "Diffusion logic for taking over licences." ;
    cml:premiseText "The new cabling licence diffuses the conditions of the previous licence." ;
    cml:conclusionText "The new cabling licence has the same conditions as the previous licence." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16 cml:asserts concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-cogai-6 .
concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-cogai-6 a cml:LogicApplication ;
    cml:modality cml:CogAI ;
    cml:operator "recognises" ;
    cml:logicSummary "CogAI logic for recognising existing licences." ;
    cml:premiseText "The CogAI system recognises the existence of the previous cabling licence." ;
    cml:conclusionText "The CogAI system takes over the existing licence." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
