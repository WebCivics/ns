    cml:conclusionText "(Ceases to apply)" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-2-sec-12-ss-2 a cof:Section ;
    cof:title "12(2) Pre-existing eligible services" ;
    values:kind "subsection" ;
    values:originalText "(2) However, if at any time after that repeal the person supplies the service in a way that is not in accordance with that approval, subsection (1) ceases to apply in relation to the supply of the service by the person." ;
    cof:pageNumber "9"^^xsd:integer .

concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-13 a cml:Concept ;
    skos:prefLabel "13 Pre-existing numbers"@en ;
    cml:realizedBy doc:sch-2-sec-13 ;
    values:originalText "Section 241 of the Telecommunications Act 1991 does not prohibit the provision of a telecommunications service by the use of numbers allocated before the national numbering plan referred to in that section is prepared.    Telecommunications (Transitional Provisions and Consequential Amendments) Act 1991  Compilation date: 1/7/16 Registered: 18/7/16" ;
    skos:definition "Section 241 of the Telecommunications Act 1991 does not prohibit the provision of a telecommunications service by the use of numbers allocated before the national numbering plan referred to in that section is prepared.    Telecommunications (Transitional Provisions and Consequential Amendments) Act 1991  Compilation date: 1/7/16 Registered: 18/7/16"@en ;
    cml:integrityHash "c40e3d2b600539b84d0157408ece9614e4ac456e93ac1386a75587c5e075a74f" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Permits provision of telecommunications service using pre-existing numbers." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
