concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-17 a cml:Concept ;
    skos:prefLabel "17 Pre-existing delegations by AUSTEL"@en ;
    cml:realizedBy doc:sch-2-sec-17 ;
    values:originalText "Any delegation of a function or power of AUSTEL under the Telecommunications Act 1989 that was made under section 140 of that Act and was in force immediately before the repeal of that section continues in force after the commencement of section 279 of the Telecommunications Act 1991 as a delegation made under that section of the corresponding function or power of AUSTEL under that Act, being a function or power that AUSTEL is authorised by that section to delegate." ;
    skos:definition "Any delegation of a function or power of AUSTEL under the Telecommunications Act 1989 that was made under section 140 of that Act and was in force immediately before the repeal of that section continues in force after the commencement of section 279 of the Telecommunications Act 1991 as a delegation made under that section of the corresponding function or power of AUSTEL under that Act, being a function or power that AUSTEL is authorised by that section to delegate."@en ;
    cml:integrityHash "98f64fd53e76531a1e0618238a66d3ad63eab8e3f4bf43941d704f1182c592d7" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Continuation of pre-existing delegations after repeal and commencement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
