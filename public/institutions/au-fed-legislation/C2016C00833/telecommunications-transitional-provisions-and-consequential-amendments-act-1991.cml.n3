doc:sch-2-sec-7-ss-1 a cof:Section ;
    cof:title "7(1) Existing carriers may continue to operate pending grant of" ;
    values:kind "subsection" ;
    values:originalText "(1) In this section: corporation to which this section applies means AUSSAT, OTC or Telecom." ;
    cof:pageNumber "7"^^xsd:integer .

concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7-ss-2 a cml:Concept ;
    skos:prefLabel "7(2) Existing carriers may continue to operate pending grant of"@en ;
    cml:realizedBy doc:sch-2-sec-7-ss-2 ;
    values:originalText "(2) A corporation to which this section applies may, after the commencement of this section, continue to perform the functions and exercise the powers that it was entitled to perform and exercise immediately before that commencement until:  (a) a decision is made by the Minister whether to grant to the corporation a licence under section 57 of the Telecommunications Act 1991; or  (b) the Minister, by notice published in the Gazette, determines that this section is to cease to apply to the corporation; whichever first occurs." ;
    skos:definition "(2) A corporation to which this section applies may, after the commencement of this section, continue to perform the functions and exercise the powers that it was entitled to perform and exercise immediately before that commencement until:  (a) a decision is made by the Minister whether to grant to the corporation a licence under section 57 of the Telecommunications Act 1991; or  (b) the Minister, by notice published in the Gazette, determines that this section is to cease to apply to the corporation; whichever first occurs."@en ;
    cml:integrityHash "dbc074d94bfe4ed799b2b8b5d012d4a04c0a8df07306634767319ac4b5cee48c" ;
    values:partOf concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7 ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Existing carriers may continue to operate pending grant of licence." ;
