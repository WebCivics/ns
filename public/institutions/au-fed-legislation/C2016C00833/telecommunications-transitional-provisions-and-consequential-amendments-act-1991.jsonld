      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Payment of amount is a term and condition for the right to interconnect facilities",
      "cml:conclusionText": "Payment of amount is an obligation"
    },
    {
