    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Pre-existing interconnection rights",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.8",
      "values:originalText": "If, immediately before the commencement of section 137 of the\nTelecommunications Act 1991, a carrier within the meaning of the\nTelecommunications Act 1989 had, under section 49 of the\nTelecommunications Act 1989 or section 10A of the AUSSAT Act\n1984, a right to interconnect its facilities to another carrier’s\nnetwork on payment of an amount agreed between them or\ndetermined by AUSTEL, the payment of that amount is a term and\ncondition for the purposes of the right of the first-mentioned carrier\nto interconnect its facilities to that other carrier’s network under\nsection 137 of the Telecommunications Act 1991 and is taken to\nhave been agreed or determined as mentioned in\nparagraph 137(2)(b) of that Act.",
      "skos:definition": "If, immediately before the commencement of section 137 of the\nTelecommunications Act 1991, a carrier within the meaning of the\nTelecommunications Act 1989 had, under section 49 of the\nTelecommunications Act 1989 or section 10A of the AUSSAT Act\n1984, a right to interconnect its facilities to another carrier’s\nnetwork on payment of an amount agreed between them or\ndetermined by AUSTEL, the payment of that amount is a term and\ncondition for the purposes of the right of the first-mentioned carrier\nto interconnect its facilities to that other carrier’s network under\nsection 137 of the Telecommunications Act 1991 and is taken to\nhave been agreed or determined as mentioned in\nparagraph 137(2)(b) of that Act.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-10-norm"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-10-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-10-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-10-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-10-logic-deontic-4"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-10-logic-argumentation-5"
        }
      ],
      "cml:integrityHash": "a2b6ccc06a5fa13c1789bda80810ee78a74126ee149245b75ce9b4cab7f4afd0",
      "skos:note": "Payment of amount is a term and condition for interconnection right"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Pre-existing interconnection rights",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "If, immediately before the commencement of section 137 of the\nTelecommunications Act 1991, a carrier within the meaning of the\nTelecommunications Act 1989 had, under section 49 of the\nTelecommunications Act 1989 or section 10A of the AUSSAT Act\n1984, a right to interconnect its facilities to another carrier’s\nnetwork on payment of an amount agreed between them or\ndetermined by AUSTEL, the payment of that amount is a term and\ncondition for the purposes of the right of the first-mentioned carrier\nto interconnect its facilities to that other carrier’s network under\nsection 137 of the Telecommunications Act 1991 and is taken to\nhave been agreed or determined as mentioned in\nparagraph 137(2)(b) of that Act."
    },
    {
