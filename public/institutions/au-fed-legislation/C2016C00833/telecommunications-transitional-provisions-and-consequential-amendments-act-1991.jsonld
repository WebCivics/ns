    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.6",
      "values:originalText": "(1) In this Part:\nAUSSAT means AUSSAT Pty Ltd.\nOTC means OTC Limited.\n\n(2) In this Part, unless the contrary intention appears, expressions have\nthe same meanings as in the Telecommunications Act 1991.\n\n(3) The operation of this Part in relation to Norfolk Island is not\naffected by the amendments made by Division 1 of Part 1 of\nSchedule 5 to the Territories Legislation Amendment Act 2016.",
      "skos:definition": "(1) In this Part:\nAUSSAT means AUSSAT Pty Ltd.\nOTC means OTC Limited.\n\n(2) In this Part, unless the contrary intention appears, expressions have\nthe same meanings as in the Telecommunications Act 1991.\n\n(3) The operation of this Part in relation to Norfolk Island is not\naffected by the amendments made by Division 1 of Part 1 of\nSchedule 5 to the Territories Legislation Amendment Act 2016.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-3-ss-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-3-ss-2"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-3-ss-3"
        }
      ],
      "cml:integrityHash": "4ed91ecbc8783a4248dfca2418d270b417254d13c14583f417c69f661adce51d"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Interpretation",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "(1) In this Part:\nAUSSAT means AUSSAT Pty Ltd.\nOTC means OTC Limited.\n\n(2) In this Part, unless the contrary intention appears, expressions have\nthe same meanings as in the Telecommunications Act 1991.\n\n(3) The operation of this Part in relation to Norfolk Island is not\naffected by the amendments made by Division 1 of Part 1 of\nSchedule 5 to the Territories Legislation Amendment Act 2016."
    },
