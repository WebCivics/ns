        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-14-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has effect",
      "cml:logicSummary": "Imposes an obligation on the standard to have effect after repeal.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Pre-existing authorities for connection of customer equipment",
      "cml:realizedBy": {
