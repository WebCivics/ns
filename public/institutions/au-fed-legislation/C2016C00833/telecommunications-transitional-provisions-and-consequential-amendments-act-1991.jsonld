    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Pre-existing numbers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.9",
      "values:originalText": "Section 241 of the Telecommunications Act 1991 does not prohibit\nthe provision of a telecommunications service by the use of\nnumbers allocated before the national numbering plan referred to\nin that section is prepared.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16",
      "skos:definition": "Section 241 of the Telecommunications Act 1991 does not prohibit\nthe provision of a telecommunications service by the use of\nnumbers allocated before the national numbering plan referred to\nin that section is prepared.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-13-norm"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c40e3d2b600539b84d0157408ece9614e4ac456e93ac1386a75587c5e075a74f",
      "skos:note": "Permits provision of telecommunications service using pre-existing numbers."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Pre-existing numbers",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Section 241 of the Telecommunications Act 1991 does not prohibit\nthe provision of a telecommunications service by the use of\nnumbers allocated before the national numbering plan referred to\nin that section is prepared.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16"
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-13-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-13"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "PERMITS",
      "cml:logicSummary": "Permits action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Effect of standards determined under section 106 of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.10",
      "values:originalText": "Telecommunications Act 1989\n\nA technical standard that, immediately before the repeal of\nsection 106 of the Telecommunications Act 1989, was in force\nunder that section has effect after that repeal (including for the\npurposes of section 46A of the Acts Interpretation Act 1901) as if:\n\n(a) section 246 of the Telecommunications Act 1991 had\ncommenced on the day when the standard was determined;\nand\n\n(b) the standard had been determined under section 246 of the\nTelecommunications Act 1991.",
      "skos:definition": "Telecommunications Act 1989\n\nA technical standard that, immediately before the repeal of\nsection 106 of the Telecommunications Act 1989, was in force\nunder that section has effect after that repeal (including for the\npurposes of section 46A of the Acts Interpretation Act 1901) as if:\n\n(a) section 246 of the Telecommunications Act 1991 had\ncommenced on the day when the standard was determined;\nand\n\n(b) the standard had been determined under section 246 of the\nTelecommunications Act 1991.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-14-norm"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4b45627c8d0cf5d402d0dd9412c57158fc20cb9a4567cdc1d4b244174c4ddc42",
      "skos:note": "A technical standard has effect after repeal as if section 246 of the Telecommunications Act 1991 had commenced."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Effect of standards determined under section 106 of the",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Telecommunications Act 1989\n\nA technical standard that, immediately before the repeal of\nsection 106 of the Telecommunications Act 1989, was in force\nunder that section has effect after that repeal (including for the\npurposes of section 46A of the Acts Interpretation Act 1901) as if:\n\n(a) section 246 of the Telecommunications Act 1991 had\ncommenced on the day when the standard was determined;\nand\n\n(b) the standard had been determined under section 246 of the\nTelecommunications Act 1991."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-14-norm",
      "@type": "values:Obligation",
