    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 July 2016",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sec-18"
      },
      "cml:curationStatus": {
