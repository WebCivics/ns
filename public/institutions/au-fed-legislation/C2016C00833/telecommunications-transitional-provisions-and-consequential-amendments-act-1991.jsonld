        }
      ],
      "cml:integrityHash": "ca6e9dc613395f17d0e571f27a0ecde5acbdccd9cde445edcefa91bb60f381f9",
      "skos:note": "Continuation of section 69 despite repeal"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Relief in respect of past infringing conduct",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Despite the repeal of section 69 of the Telecommunications Act\n1989, that section continues in force in respect of conduct that was\nengaged in before that section was repealed."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-9-norm",
