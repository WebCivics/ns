      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.8",
      "values:originalText": "(2) This section has effect subject to section 12 of this Act.",
      "skos:definition": "(2) This section has effect subject to section 12 of this Act.",
      "values:partOf": {
        "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-11"
      },
