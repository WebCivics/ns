      }
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Pre-existing licences for performing cabling work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.10",
      "values:originalText": "Where, immediately before the commencement of Part 12 of the\nTelecommunications Act 1991 there was in force a cabling licence\n(in this section called the previous cabling licence) issued under\nsection 131 of the Telecommunications Act 1989 or a cabling\nlicence (in this section also called the previous cabling licence)\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\nCompilation date: 1/7/16\nRegistered: 18/7/16\n\ntaken by section 139 of that Act to be issued under Division 5 of\nPart 5 of that Act:\n\n(a) the previous cabling licence is taken, on that commencement,\nto be a cabling licence (in this section called the new cabling\nlicence) issued under Division 7 of Part 12 of the\nTelecommunications Act 1991, being a cabling licence that\nincludes the conditions (if any) to which the previous cabling\nlicence was subject immediately before that commencement;\nand\n\n(b) the person who was, or was taken to be, the holder of the\nprevious cabling licence is taken, on that commencement, to\nbe the holder of the new cabling licence.",
      "skos:definition": "Where, immediately before the commencement of Part 12 of the\nTelecommunications Act 1991 there was in force a cabling licence\n(in this section called the previous cabling licence) issued under\nsection 131 of the Telecommunications Act 1989 or a cabling\nlicence (in this section also called the previous cabling licence)\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\nCompilation date: 1/7/16\nRegistered: 18/7/16\n\ntaken by section 139 of that Act to be issued under Division 5 of\nPart 5 of that Act:\n\n(a) the previous cabling licence is taken, on that commencement,\nto be a cabling licence (in this section called the new cabling\nlicence) issued under Division 7 of Part 12 of the\nTelecommunications Act 1991, being a cabling licence that\nincludes the conditions (if any) to which the previous cabling\nlicence was subject immediately before that commencement;\nand\n\n(b) the person who was, or was taken to be, the holder of the\nprevious cabling licence is taken, on that commencement, to\nbe the holder of the new cabling licence.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-norm"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-alleninterval-3"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-argumentation-4"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-diffusion-5"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-cogai-6"
        }
      ],
      "cml:integrityHash": "415f231683c36cc38987a906264dca2b223d2bceeb1e17bf1bcd21813bf6eef0",
      "skos:note": "Existing cabling licences are taken over by new licences with the same conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Pre-existing licences for performing cabling work",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Where, immediately before the commencement of Part 12 of the\nTelecommunications Act 1991 there was in force a cabling licence\n(in this section called the previous cabling licence) issued under\nsection 131 of the Telecommunications Act 1989 or a cabling\nlicence (in this section also called the previous cabling licence)\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\nCompilation date: 1/7/16\nRegistered: 18/7/16\n\ntaken by section 139 of that Act to be issued under Division 5 of\nPart 5 of that Act:\n\n(a) the previous cabling licence is taken, on that commencement,\nto be a cabling licence (in this section called the new cabling\nlicence) issued under Division 7 of Part 12 of the\nTelecommunications Act 1991, being a cabling licence that\nincludes the conditions (if any) to which the previous cabling\nlicence was subject immediately before that commencement;\nand\n\n(b) the person who was, or was taken to be, the holder of the\nprevious cabling licence is taken, on that commencement, to\nbe the holder of the new cabling licence."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "takes-over",
      "cml:logicSummary": "Obligation to take over existing licences.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Previous cabling licence is taken to be a new cabling licence.",
      "cml:conclusionText": "New cabling licence includes the conditions of the previous licence."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Description logic for including conditions in new licences.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The new cabling licence includes the conditions to which the previous cabling licence was subject.",
      "cml:conclusionText": "New cabling licence has the same conditions as the previous licence."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "on",
      "cml:logicSummary": "Temporal relation for taking over licences.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The new cabling licence is taken on the commencement of Part 12.",
      "cml:conclusionText": "The new cabling licence takes effect at the same time as the previous licence."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implication for holder of licences.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If a person held the previous cabling licence, they are taken to be the holder of the new licence.",
      "cml:conclusionText": "The holder of the new licence is implied to be the same as the holder of the previous licence."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:logicSummary": "Diffusion logic for taking over licences.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The new cabling licence diffuses the conditions of the previous licence.",
      "cml:conclusionText": "The new cabling licence has the same conditions as the previous licence."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-16-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognises",
      "cml:logicSummary": "CogAI logic for recognising existing licences.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The CogAI system recognises the existence of the previous cabling licence.",
      "cml:conclusionText": "The CogAI system takes over the existing licence."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Pre-existing delegations by AUSTEL",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.11",
      "values:originalText": "Any delegation of a function or power of AUSTEL under the\nTelecommunications Act 1989 that was made under section 140 of\nthat Act and was in force immediately before the repeal of that\nsection continues in force after the commencement of section 279\nof the Telecommunications Act 1991 as a delegation made under\nthat section of the corresponding function or power of AUSTEL\nunder that Act, being a function or power that AUSTEL is\nauthorised by that section to delegate.",
      "skos:definition": "Any delegation of a function or power of AUSTEL under the\nTelecommunications Act 1989 that was made under section 140 of\nthat Act and was in force immediately before the repeal of that\nsection continues in force after the commencement of section 279\nof the Telecommunications Act 1991 as a delegation made under\nthat section of the corresponding function or power of AUSTEL\nunder that Act, being a function or power that AUSTEL is\nauthorised by that section to delegate.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-17-norm"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-17-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "98f64fd53e76531a1e0618238a66d3ad63eab8e3f4bf43941d704f1182c592d7",
      "skos:note": "Continuation of pre-existing delegations after repeal and commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Pre-existing delegations by AUSTEL",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Any delegation of a function or power of AUSTEL under the\nTelecommunications Act 1989 that was made under section 140 of\nthat Act and was in force immediately before the repeal of that\nsection continues in force after the commencement of section 279\nof the Telecommunications Act 1991 as a delegation made under\nthat section of the corresponding function or power of AUSTEL\nunder that Act, being a function or power that AUSTEL is\nauthorised by that section to delegate."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-17-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-17"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-17-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires temporal relation between delegations",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Delegation made under section 140 of the Telecommunications Act 1989",
      "cml:conclusionText": "Temporal relation required"
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Continuation of investigations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.11",
      "values:originalText": "(1) Where before the repeal of Part 6 of the Telecommunications Act",
      "skos:definition": "(1) Where before the repeal of Part 6 of the Telecommunications Act",
      "cml:asserts": [
        {
