      },
      "cml:premiseText": "The payment of that amount is taken to have been agreed or determined as mentioned in paragraph 137(2)(b) of the Telecommunications Act 1991",
      "cml:conclusionText": "Payment of amount is a term and condition for interconnection right"
    },
