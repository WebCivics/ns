      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-18-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Continuation obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
