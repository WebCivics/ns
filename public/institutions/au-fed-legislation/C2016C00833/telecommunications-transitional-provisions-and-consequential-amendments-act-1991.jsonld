    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Disclosure of pre-existing communications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.8",
      "values:originalText": "Section 88 of the Telecommunications Act 1991 applies to any\ndisclosure or use by a person of a fact or document that takes place\nafter the commencement of that section even though:\n\n(a) it relates to a communication that was carried, or a\ntelecommunications service that was supplied, before that\ncommencement; or\n\n(b) the fact or document came to the knowledge, or into the\npossession, of the person before that commencement.",
      "skos:definition": "Section 88 of the Telecommunications Act 1991 applies to any\ndisclosure or use by a person of a fact or document that takes place\nafter the commencement of that section even though:\n\n(a) it relates to a communication that was carried, or a\ntelecommunications service that was supplied, before that\ncommencement; or\n\n(b) the fact or document came to the knowledge, or into the\npossession, of the person before that commencement.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-8-norm"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "51766ccb3f675c40aee34f0b833090a00b1126419eb033e275bfe54eb1a73b36",
      "skos:note": "Disclosure of pre-existing communications after commencement"
    },
