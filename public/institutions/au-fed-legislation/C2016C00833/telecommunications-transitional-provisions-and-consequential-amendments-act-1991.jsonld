    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Existing members and associate members of AUSTEL",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.12",
      "values:originalText": "(1) A person who held office as a member of AUSTEL immediately\nbefore the repeal of Part 7 of the Telecommunications Act 1989\ncontinues in office for the unexpired portion of the period of his or\nher appointment as if:\n\n(a) section 368 of the Telecommunications Act 1991 had been in\nforce when the appointment was made; and\n\n(b) the person had been appointed under that section.\n\n(2) A person who held office as an associate member of AUSTEL\nimmediately before the repeal of Part 7 of the Telecommunications\nAct 1989 continues in office for the unexpired portion of the period\nof his or her appointment as if:\n\n(a) section 369 of the Telecommunications Act 1991 had been in\nforce when the appointment was made; and\n\n(b) the person had been appointed under that section.\n\n(3) Any directions given under subsection 160(5) of the\nTelecommunications Act 1989 to a person referred to in\nsubsection (2) that were in force immediately before the repeal of\nthat Act continue in force as if:\n\n(a) subsection 369(2) of the Telecommunications Act 1991 had\nbeen in force when the direction was given; and\n\n(b) the directions had been given under that subsection.",
      "skos:definition": "(1) A person who held office as a member of AUSTEL immediately\nbefore the repeal of Part 7 of the Telecommunications Act 1989\ncontinues in office for the unexpired portion of the period of his or\nher appointment as if:\n\n(a) section 368 of the Telecommunications Act 1991 had been in\nforce when the appointment was made; and\n\n(b) the person had been appointed under that section.\n\n(2) A person who held office as an associate member of AUSTEL\nimmediately before the repeal of Part 7 of the Telecommunications\nAct 1989 continues in office for the unexpired portion of the period\nof his or her appointment as if:\n\n(a) section 369 of the Telecommunications Act 1991 had been in\nforce when the appointment was made; and\n\n(b) the person had been appointed under that section.\n\n(3) Any directions given under subsection 160(5) of the\nTelecommunications Act 1989 to a person referred to in\nsubsection (2) that were in force immediately before the repeal of\nthat Act continue in force as if:\n\n(a) subsection 369(2) of the Telecommunications Act 1991 had\nbeen in force when the direction was given; and\n\n(b) the directions had been given under that subsection.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-19-ss-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-19-ss-2"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-19-ss-3"
        }
      ],
      "cml:integrityHash": "5c93cb53d474f6e43dcee976167f893fd9470dbfd16d46ead730658c51f0b113"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Existing members and associate members of AUSTEL",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "(1) A person who held office as a member of AUSTEL immediately\nbefore the repeal of Part 7 of the Telecommunications Act 1989\ncontinues in office for the unexpired portion of the period of his or\nher appointment as if:\n\n(a) section 368 of the Telecommunications Act 1991 had been in\nforce when the appointment was made; and\n\n(b) the person had been appointed under that section.\n\n(2) A person who held office as an associate member of AUSTEL\nimmediately before the repeal of Part 7 of the Telecommunications\nAct 1989 continues in office for the unexpired portion of the period\nof his or her appointment as if:\n\n(a) section 369 of the Telecommunications Act 1991 had been in\nforce when the appointment was made; and\n\n(b) the person had been appointed under that section.\n\n(3) Any directions given under subsection 160(5) of the\nTelecommunications Act 1989 to a person referred to in\nsubsection (2) that were in force immediately before the repeal of\nthat Act continue in force as if:\n\n(a) subsection 369(2) of the Telecommunications Act 1991 had\nbeen in force when the direction was given; and\n\n(b) the directions had been given under that subsection."
    },
