    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Existing regulations under Telecommunications (Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.13",
      "values:originalText": "Fees) Act 1989\n\n(1) Subject to subsection (3), any regulations made under the\nTelecommunications (Application Fees) Act 1989 and in force\nimmediately before the repeal of that Act continue in force as if\nmade under the Telecommunications (Application Fees) Act 1991.\n\n(2) A reference in a regulation so continued in force to a provision of\nthe Telecommunications Act 1989 is taken to be a reference to the\ncorresponding provision of the Telecommunications Act 1991.\n\n(3) This section does not apply to a regulation the making of which\nwould not be authorised by the Telecommunications (Application\nFees) Act 1991.",
      "skos:definition": "Fees) Act 1989\n\n(1) Subject to subsection (3), any regulations made under the\nTelecommunications (Application Fees) Act 1989 and in force\nimmediately before the repeal of that Act continue in force as if\nmade under the Telecommunications (Application Fees) Act 1991.\n\n(2) A reference in a regulation so continued in force to a provision of\nthe Telecommunications Act 1989 is taken to be a reference to the\ncorresponding provision of the Telecommunications Act 1991.\n\n(3) This section does not apply to a regulation the making of which\nwould not be authorised by the Telecommunications (Application\nFees) Act 1991.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-21-ss-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-21-ss-2"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-21-ss-3"
        }
      ],
      "cml:integrityHash": "3abc3e3332679a45092b1355ebbe2322675d0d89a4634f0bee814ce0cc2109e4"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Existing regulations under Telecommunications (Application",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Fees) Act 1989\n\n(1) Subject to subsection (3), any regulations made under the\nTelecommunications (Application Fees) Act 1989 and in force\nimmediately before the repeal of that Act continue in force as if\nmade under the Telecommunications (Application Fees) Act 1991.\n\n(2) A reference in a regulation so continued in force to a provision of\nthe Telecommunications Act 1989 is taken to be a reference to the\ncorresponding provision of the Telecommunications Act 1991.\n\n(3) This section does not apply to a regulation the making of which\nwould not be authorised by the Telecommunications (Application\nFees) Act 1991."
    },
