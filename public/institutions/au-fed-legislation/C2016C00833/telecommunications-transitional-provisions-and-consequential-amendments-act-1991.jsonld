    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Application of State and Territory laws to Telecom",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.13",
      "values:originalText": "(1) Subject to section 59 of the Australian Telecommunications\nCorporation Act 1989 and subsection (2) of this section, Telecom\nis not subject to any requirement, obligation, liability, penalty or\ndisability under a law of a State or Territory to which the\nCommonwealth is not subject.\n\n(2) Subsection (1) applies only in relation to the period beginning at\nthe commencement of this section and ending immediately before\nthe commencement of section 116 of the Telecommunications Act\n1991.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16",
      "skos:definition": "(1) Subject to section 59 of the Australian Telecommunications\nCorporation Act 1989 and subsection (2) of this section, Telecom\nis not subject to any requirement, obligation, liability, penalty or\ndisability under a law of a State or Territory to which the\nCommonwealth is not subject.\n\n(2) Subsection (1) applies only in relation to the period beginning at\nthe commencement of this section and ending immediately before\nthe commencement of section 116 of the Telecommunications Act\n1991.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-22-ss-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-22-ss-2"
        }
      ],
      "cml:integrityHash": "bb4acac751341ac7b8cb0353499309b9cb10f31e6906fc0332f08e8d5282b393"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Application of State and Territory laws to Telecom",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) Subject to section 59 of the Australian Telecommunications\nCorporation Act 1989 and subsection (2) of this section, Telecom\nis not subject to any requirement, obligation, liability, penalty or\ndisability under a law of a State or Territory to which the\nCommonwealth is not subject.\n\n(2) Subsection (1) applies only in relation to the period beginning at\nthe commencement of this section and ending immediately before\nthe commencement of section 116 of the Telecommunications Act\n1991.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16"
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-22-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "22(1) Application of State and Territory laws to Telecom",
      "cml:realizedBy": {
