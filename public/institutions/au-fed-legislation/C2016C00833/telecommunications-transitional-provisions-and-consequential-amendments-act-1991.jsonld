    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Pre-existing notifications and directions to AUSTEL",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.6",
      "values:originalText": "(1) Any notification or direction given to AUSTEL under section 28 or\n29 of the Telecommunications Act 1989 and in force immediately\nbefore the repeal of that section is taken to have been given to\nAUSTEL under section 49 or 50, as the case may be, of the\nTelecommunications Act 1991 on the commencement of that\nlast-mentioned section.\n\n(2) A reference in a notification or direction referred to in\nsubsection (1) to a provision of the Telecommunications Act 1989\nis a reference to the provision of the Telecommunications Act 1991\nthat corresponds, or most closely corresponds, to the\nfirst-mentioned provision.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\nCompilation date: 1/7/16\nRegistered: 18/7/16",
      "skos:definition": "(1) Any notification or direction given to AUSTEL under section 28 or\n29 of the Telecommunications Act 1989 and in force immediately\nbefore the repeal of that section is taken to have been given to\nAUSTEL under section 49 or 50, as the case may be, of the\nTelecommunications Act 1991 on the commencement of that\nlast-mentioned section.\n\n(2) A reference in a notification or direction referred to in\nsubsection (1) to a provision of the Telecommunications Act 1989\nis a reference to the provision of the Telecommunications Act 1991\nthat corresponds, or most closely corresponds, to the\nfirst-mentioned provision.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\nCompilation date: 1/7/16\nRegistered: 18/7/16",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-5-ss-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-5-ss-2"
        }
      ],
      "cml:integrityHash": "11d3cf84be80daf14bfe4907664f0b84fe8135bdf2958c763254a917ac2808c1"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Pre-existing notifications and directions to AUSTEL",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "(1) Any notification or direction given to AUSTEL under section 28 or\n29 of the Telecommunications Act 1989 and in force immediately\nbefore the repeal of that section is taken to have been given to\nAUSTEL under section 49 or 50, as the case may be, of the\nTelecommunications Act 1991 on the commencement of that\nlast-mentioned section.\n\n(2) A reference in a notification or direction referred to in\nsubsection (1) to a provision of the Telecommunications Act 1989\nis a reference to the provision of the Telecommunications Act 1991\nthat corresponds, or most closely corresponds, to the\nfirst-mentioned provision.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\nCompilation date: 1/7/16\nRegistered: 18/7/16"
    },
