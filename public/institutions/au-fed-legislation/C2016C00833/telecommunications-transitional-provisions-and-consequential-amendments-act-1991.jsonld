    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Existing carriers may continue to operate pending grant of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.7",
      "values:originalText": "licences\n\n(1) In this section:\ncorporation to which this section applies means AUSSAT, OTC\nor Telecom.\n\n(2) A corporation to which this section applies may, after the\ncommencement of this section, continue to perform the functions\nand exercise the powers that it was entitled to perform and exercise\nimmediately before that commencement until:\n\n(a) a decision is made by the Minister whether to grant to the\ncorporation a licence under section 57 of the\nTelecommunications Act 1991; or\n\n(b) the Minister, by notice published in the Gazette, determines\nthat this section is to cease to apply to the corporation;\nwhichever first occurs.\n\n(3) A corporation to which this section applies is taken to have been a\ngeneral carrier within the meaning of the Telecommunications Act\n1991, otherwise than for the purposes of Divisions 2 and 3 of",
      "skos:definition": "licences\n\n(1) In this section:\ncorporation to which this section applies means AUSSAT, OTC\nor Telecom.\n\n(2) A corporation to which this section applies may, after the\ncommencement of this section, continue to perform the functions\nand exercise the powers that it was entitled to perform and exercise\nimmediately before that commencement until:\n\n(a) a decision is made by the Minister whether to grant to the\ncorporation a licence under section 57 of the\nTelecommunications Act 1991; or\n\n(b) the Minister, by notice published in the Gazette, determines\nthat this section is to cease to apply to the corporation;\nwhichever first occurs.\n\n(3) A corporation to which this section applies is taken to have been a\ngeneral carrier within the meaning of the Telecommunications Act\n1991, otherwise than for the purposes of Divisions 2 and 3 of",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7-ss-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7-ss-2"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-7-ss-3"
        }
      ],
      "cml:integrityHash": "7466684625aa64c2bc4f957a9968830843f8b1482e171b9f0771e101e7dfa072"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Existing carriers may continue to operate pending grant of",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "licences\n\n(1) In this section:\ncorporation to which this section applies means AUSSAT, OTC\nor Telecom.\n\n(2) A corporation to which this section applies may, after the\ncommencement of this section, continue to perform the functions\nand exercise the powers that it was entitled to perform and exercise\nimmediately before that commencement until:\n\n(a) a decision is made by the Minister whether to grant to the\ncorporation a licence under section 57 of the\nTelecommunications Act 1991; or\n\n(b) the Minister, by notice published in the Gazette, determines\nthat this section is to cease to apply to the corporation;\nwhichever first occurs.\n\n(3) A corporation to which this section applies is taken to have been a\ngeneral carrier within the meaning of the Telecommunications Act\n1991, otherwise than for the purposes of Divisions 2 and 3 of"
    },
