    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.5",
      "values:originalText": "(1) Part 1 commences on the day on which this Act receives the Royal\nAssent.\n\n(2) Part 2, Part 3 (except section 24) and Part 4 commence on 1 July\n1991.\n\n(3) Section 24 and Part 5 commence on the day fixed under\nsubsection 2(1) of the Australian and Overseas\nTelecommunications Corporation Act 1991.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16",
      "skos:definition": "(1) Part 1 commences on the day on which this Act receives the Royal\nAssent.\n\n(2) Part 2, Part 3 (except section 24) and Part 4 commence on 1 July\n1991.\n\n(3) Section 24 and Part 5 commence on the day fixed under\nsubsection 2(1) of the Australian and Overseas\nTelecommunications Corporation Act 1991.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-2-ss-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-2-ss-2"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-2-ss-3"
        }
      ],
      "cml:integrityHash": "d460715a52f2ffad95fdc1ccf38e39b5500892d18b7a2902a1b521f95b0d3485"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Commencement",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "(1) Part 1 commences on the day on which this Act receives the Royal\nAssent.\n\n(2) Part 2, Part 3 (except section 24) and Part 4 commence on 1 July\n1991.\n\n(3) Section 24 and Part 5 commence on the day fixed under\nsubsection 2(1) of the Australian and Overseas\nTelecommunications Corporation Act 1991.\n\n\n\nTelecommunications (Transitional Provisions and Consequential Amendments)\nAct 1991\n\nCompilation date: 1/7/16\nRegistered: 18/7/16"
    },
