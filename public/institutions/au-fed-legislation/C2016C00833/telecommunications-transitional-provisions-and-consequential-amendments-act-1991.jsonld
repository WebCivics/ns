    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Pre-existing advisory committees established by AUSTEL",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf"
      },
      "dc:source": "telecommunications-transitional-provisions-and-consequential-amendments-act-1991.pdf, p.7",
      "values:originalText": "(1) Any advisory committee that was established by AUSTEL under\nsection 32 of the Telecommunications Act 1989 and was in\nexistence immediately before the repeal of that section is taken to\nhave been established under section 53 of the Telecommunications\nAct 1991 on the commencement of that last-mentioned section.\n\n(2) Any direction that was given by AUSTEL under subsection 32(3)\nof the Telecommunications Act 1989 to a committee referred to in\nsubsection (1) of this section and was in force immediately before\nthe repeal of that subsection is taken to have been given to\nAUSTEL under subsection 53(3) of the Telecommunications Act\n1991 on the commencement of that last-mentioned subsection.",
      "skos:definition": "(1) Any advisory committee that was established by AUSTEL under\nsection 32 of the Telecommunications Act 1989 and was in\nexistence immediately before the repeal of that section is taken to\nhave been established under section 53 of the Telecommunications\nAct 1991 on the commencement of that last-mentioned section.\n\n(2) Any direction that was given by AUSTEL under subsection 32(3)\nof the Telecommunications Act 1989 to a committee referred to in\nsubsection (1) of this section and was in force immediately before\nthe repeal of that subsection is taken to have been given to\nAUSTEL under subsection 53(3) of the Telecommunications Act\n1991 on the commencement of that last-mentioned subsection.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-6-ss-1"
        },
        {
          "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-6-ss-2"
        }
      ],
      "cml:integrityHash": "4495d17cd79fcd067010aeaeebc4ae93d16f4b3ecea0dc9e7132b2bec2c7b2a3"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Pre-existing advisory committees established by AUSTEL",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "(1) Any advisory committee that was established by AUSTEL under\nsection 32 of the Telecommunications Act 1989 and was in\nexistence immediately before the repeal of that section is taken to\nhave been established under section 53 of the Telecommunications\nAct 1991 on the commencement of that last-mentioned section.\n\n(2) Any direction that was given by AUSTEL under subsection 32(3)\nof the Telecommunications Act 1989 to a committee referred to in\nsubsection (1) of this section and was in force immediately before\nthe repeal of that subsection is taken to have been given to\nAUSTEL under subsection 53(3) of the Telecommunications Act\n1991 on the commencement of that last-mentioned subsection."
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-6-ss-1",
