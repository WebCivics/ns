        }
      ],
      "cml:integrityHash": "c0dbeeb0a074eee89ec8692dcc499d0a4a98fce8e9b2fc48226d55b369d6a08e",
      "skos:note": "Continuation of investigations after repeal of Part 6 of the Telecommunications Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-transitional-provisions-and-consequential-amendments-act-1991#sch-2-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Continuation of investigations",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "(1) Where before the repeal of Part 6 of the Telecommunications Act"
    },
    {
      "@id": "concept:telecommunications-transitional-provisions-and-consequential-amendments-act-1991-sch-2-sec-18-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
