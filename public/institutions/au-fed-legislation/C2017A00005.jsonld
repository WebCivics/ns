    {
      "@id": "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-2-ss-2",
      "@type": "cml:Concept",
      "dc:source": "competition-and-consumer-amendment-country-of-origin-act-2017.pdf, p.7",
      "skos:note": "Goods must meet specific requirements to be considered substantially transformed in a country.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "2(2) Subsections 255(1) to (4) of Schedule 2"
      },
      "wasDerivedFrom": "competition-and-consumer-amendment-country-of-origin-act-2017.pdf",
      "asserts": [
        "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-2-ss-2-norm",
        "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-2-ss-2-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "9d2fb6c304808dc6531bd2081f70c07d0371438543c90e93bb521e8ee943cdba",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-amendment-country-of-origin-act-2017#sch-1-sec-2-ss-2",
      "cml:schemaVersion": "2",
      "partOf": "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-2"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-2-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(2) Goods were substantially transformed in a country if:  (a) the goods met, in relation to that country, the requirements of item 1 or 2 in the second column of the table in subsection (1); or  (b) as a result of one or more processes undertaken in that country, the goods are fundamentally different in identity, nature or essential character from all of their ingredients or components that were imported into that country.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Goods must meet specific requirements.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:premiseText": "(2) Goods were substantially transformed in a country if:  (a) the goods met, in relation to that country, the requirements of item 1 or 2 in the second column of the table in subsection (1); or  (b) as a result of one or more processes undertaken in that country, the goods are fundamentally different in identity, nature or essential character from all of their ingredients or components that were imported into that country."
    },
