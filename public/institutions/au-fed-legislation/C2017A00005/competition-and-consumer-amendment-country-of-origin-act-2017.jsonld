    {
      "@id": "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Subsections 255(8) and (9) of Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-country-of-origin-act-2017#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-country-of-origin-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-country-of-origin-act-2017.pdf, p.8",
      "values:originalText": "Repeal the subsections, substitute:\n\n(8) For the purposes of item 1 of the table in subsection (1) in relation\nto particular goods, packaging materials are not treated as\ningredients or components of the goods.\n\n(9) For the purposes of item 1 of the table in subsection (1) in relation\nto an ingredient or component, water added to the ingredient or\ncomponent is treated as having the same origin as the ingredient or\ncomponent, regardless of its actual origin, if:\n\n(a) the ingredient or component has been dried or concentrated\nby the evaporation of water; and\n\n(b) the added water returns the water content of the ingredient or\ncomponent to no more than its natural level.",
      "skos:definition": "Repeal the subsections, substitute:\n\n(8) For the purposes of item 1 of the table in subsection (1) in relation\nto particular goods, packaging materials are not treated as\ningredients or components of the goods.\n\n(9) For the purposes of item 1 of the table in subsection (1) in relation\nto an ingredient or component, water added to the ingredient or\ncomponent is treated as having the same origin as the ingredient or\ncomponent, regardless of its actual origin, if:\n\n(a) the ingredient or component has been dried or concentrated\nby the evaporation of water; and\n\n(b) the added water returns the water content of the ingredient or\ncomponent to no more than its natural level.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-4-ss-8"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sch-1-sec-4-ss-9"
        }
      ],
      "cml:integrityHash": "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-country-of-origin-act-2017#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsections 255(8) and (9) of Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the subsections, substitute:\n\n(8) For the purposes of item 1 of the table in subsection (1) in relation\nto particular goods, packaging materials are not treated as\ningredients or components of the goods.\n\n(9) For the purposes of item 1 of the table in subsection (1) in relation\nto an ingredient or component, water added to the ingredient or\ncomponent is treated as having the same origin as the ingredient or\ncomponent, regardless of its actual origin, if:\n\n(a) the ingredient or component has been dried or concentrated\nby the evaporation of water; and\n\n(b) the added water returns the water content of the ingredient or\ncomponent to no more than its natural level."
    },
