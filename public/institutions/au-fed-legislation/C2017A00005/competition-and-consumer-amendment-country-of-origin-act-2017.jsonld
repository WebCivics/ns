      "dc:source": "competition-and-consumer-amendment-country-of-origin-act-2017.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 5, 2017\nCompetition and Consumer Amendment (Country of Origin) Act 2017",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 5, 2017\nCompetition and Consumer Amendment (Country of Origin) Act 2017",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-country-of-origin-act-2017-sec-3-norm"
        }
      ],
      "cml:integrityHash": "642e4a9d04a80b4ad997c7f4fc788dd14ca36d1edb9b65fe83ec9fdfa0b9fd85",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
