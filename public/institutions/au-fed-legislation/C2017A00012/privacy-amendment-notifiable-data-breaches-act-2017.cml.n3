concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26ws a cml:Concept ;
    skos:prefLabel "26WS Exception—enforcement related activities"@en ;
    cml:realizedBy doc:sch-1-sec-26ws ;
    values:originalText "An entity is not required to comply with a direction under subsection 26WR(1) if:  (a) the entity is an enforcement body; and  (b) the chief executive officer of the enforcement body believes on reasonable grounds that compliance with the direction would be likely to prejudice one or more enforcement related activities conducted by, or on behalf of, the enforcement body." ;
    skos:definition "An entity is not required to comply with a direction under subsection 26WR(1) if:  (a) the entity is an enforcement body; and  (b) the chief executive officer of the enforcement body believes on reasonable grounds that compliance with the direction would be likely to prejudice one or more enforcement related activities conducted by, or on behalf of, the enforcement body."@en ;
    cml:integrityHash "45d9d85fdbf8339d9dbf55f68b17fdb6298c67610c36e1be811598310c5fccb0" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Entity exempt from direction under subsection 26WR(1) if chief executive officer believes compliance would prejudice enforcement activities." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-notifiable-data-breaches-act-2017.pdf> ;
