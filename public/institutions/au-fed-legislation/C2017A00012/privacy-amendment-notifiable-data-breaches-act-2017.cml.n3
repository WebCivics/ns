doc:sch-1-sec-26wl-ss-4 a cof:Section ;
    cof:title "26WL(4) Entity must notify eligible data breach" ;
    values:kind "subsection" ;
    values:originalText "(4) If the entity normally communicates with a particular individual using a particular method, the notification to the individual under paragraph (2)(a) or (b) may use that method. This subsection does not limit paragraph (2)(a) or (b).  Schedule 1  Amendments  Privacy Amendment (Notifiable Data Breaches) Act 2017 No. 12, 2017" ;
    cof:pageNumber "16"^^xsd:integer .

concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wm a cml:Concept ;
    skos:prefLabel "26WM Exception—eligible data breaches of other entities"@en ;
    cml:realizedBy doc:sch-1-sec-26wm ;
    values:originalText "If:  (a) an entity complies with sections 26WK and 26WL in relation to an eligible data breach of the entity; and  (b) the access, disclosure or loss that constituted the eligible data breach of the entity is an eligible data breach of one or more other entities; those sections do not apply in relation to those eligible data breaches of those other entities." ;
    skos:definition "If:  (a) an entity complies with sections 26WK and 26WL in relation to an eligible data breach of the entity; and  (b) the access, disclosure or loss that constituted the eligible data breach of the entity is an eligible data breach of one or more other entities; those sections do not apply in relation to those eligible data breaches of those other entities."@en ;
    cml:integrityHash "1b33f05df0a80a033655ff684b3cbd62dfa1daa215e6cd7c90af9bfc2592d281" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Exemption for eligible data breaches of other entities" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
