doc:sch-1-sec-26wq-ss-6 a cof:Section ;
    cof:title "26WQ(6) Exception—declaration by Commissioner" ;
    values:kind "subsection" ;
    values:originalText "(6) An application by an entity under paragraph (5)(b) may be expressed to be:  (a) an application for a paragraph (1)(c) declaration; or  (b) an application for a paragraph (1)(d) declaration; or  (c) an application for:  (i) a paragraph (1)(c) declaration; or  (ii) in the event that the Commissioner is not disposed to make such a declaration—a paragraph (1)(d) declaration." ;
    cof:pageNumber "19"^^xsd:integer .

concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wq-ss-7 a cml:Concept ;
    skos:prefLabel "26WQ(7) Exception—declaration by Commissioner"@en ;
    cml:realizedBy doc:sch-1-sec-26wq-ss-7 ;
    values:originalText "(7) If an entity applies to the Commissioner under paragraph (5)(b):  (a) the Commissioner may refuse the application; and  (b) if the Commissioner does so—the Commissioner must give written notice of the refusal to the entity." ;
    skos:definition "(7) If an entity applies to the Commissioner under paragraph (5)(b):  (a) the Commissioner may refuse the application; and  (b) if the Commissioner does so—the Commissioner must give written notice of the refusal to the entity."@en ;
