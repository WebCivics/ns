concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wt-ss-4 a cml:Concept ;
    skos:prefLabel "26WT(4) Exception—inconsistency with secrecy provisions"@en ;
    cml:realizedBy doc:sch-1-sec-26wt-ss-4 ;
    values:originalText "(4) For the purposes of a prescribed secrecy provision:  (a) paragraph 26WR(1)(b); and  (b) subsection 26WR(2); are taken not to be provisions that require or authorise the use or disclosure of information." ;
    skos:definition "(4) For the purposes of a prescribed secrecy provision:  (a) paragraph 26WR(1)(b); and  (b) subsection 26WR(2); are taken not to be provisions that require or authorise the use or disclosure of information."@en ;
