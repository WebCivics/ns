concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wq-ss-8 a cml:Concept ;
    skos:prefLabel "26WQ(8) Exception—declaration by Commissioner"@en ;
    cml:realizedBy doc:sch-1-sec-26wq-ss-8 ;
    values:originalText "(8) If:  (a) an application for a paragraph (1)(d) declaration nominates a period to be specified in the declaration; and  (b) the Commissioner makes the declaration, but specifies a different period in the declaration; the Commissioner is taken not to have refused the application." ;
    skos:definition "(8) If:  (a) an application for a paragraph (1)(d) declaration nominates a period to be specified in the declaration; and  (b) the Commissioner makes the declaration, but specifies a different period in the declaration; the Commissioner is taken not to have refused the application."@en ;
    cml:integrityHash "b737115452147c8c9484eec2944497c1e67c03cb1c7e39c575bef8e7a4caebd3" ;
    values:partOf concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wq ;
