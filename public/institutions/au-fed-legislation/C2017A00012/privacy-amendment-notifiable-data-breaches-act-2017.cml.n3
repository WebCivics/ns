concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wd a cml:Concept ;
    skos:prefLabel "26WD Exception—notification under the My Health Records Act"@en ;
    cml:realizedBy doc:sch-1-sec-26wd ;
    values:originalText "If:  (a) an unauthorised access to information; or  (b) an unauthorised disclosure of information; or  (c) a loss of information; has been, or is required to be, notified under section 75 of the My Health Records Act 2012, this Part does not apply in relation to the access, disclosure or loss." ;
    skos:definition "If:  (a) an unauthorised access to information; or  (b) an unauthorised disclosure of information; or  (c) a loss of information; has been, or is required to be, notified under section 75 of the My Health Records Act 2012, this Part does not apply in relation to the access, disclosure or loss."@en ;
    cml:integrityHash "4d64de7c223944d139334c0bb0c0f0e1303cfa54d2055179ab0b9381b87e07b4" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Notification under My Health Records Act exempts from this Part" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-notifiable-data-breaches-act-2017.pdf> ;
    dc:source "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.9" ;
    cml:asserts concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wd-norm .
