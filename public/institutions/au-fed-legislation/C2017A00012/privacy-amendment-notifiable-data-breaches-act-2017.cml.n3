doc:sch-1-sec-26wt-ss-1 a cof:Section ;
    cof:title "26WT(1) Exception—inconsistency with secrecy provisions" ;
    values:kind "subsection" ;
    values:originalText "(1) For the purposes of this section, secrecy provision means a provision that:  (a) is a provision of a law of the Commonwealth (other than this Act); and  (b) prohibits or regulates the use or disclosure of information." ;
    cof:pageNumber "24"^^xsd:integer .

concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wt-ss-2 a cml:Concept ;
    skos:prefLabel "26WT(2) Exception—inconsistency with secrecy provisions"@en ;
    cml:realizedBy doc:sch-1-sec-26wt-ss-2 ;
    values:originalText "(2) If compliance by an entity with paragraph 26WR(1)(b) or subsection 26WR(2) in relation to a statement would, to any extent, be inconsistent with a secrecy provision (other than a prescribed secrecy provision), paragraph 26WR(1)(b) or subsection 26WR(2),  Amendments  Schedule 1  No. 12, 2017 Privacy Amendment (Notifiable Data Breaches) Act 2017  as the case may be, does not apply to the entity, in relation to the statement, to the extent of the inconsistency. Prescribed secrecy provisions" ;
    skos:definition "(2) If compliance by an entity with paragraph 26WR(1)(b) or subsection 26WR(2) in relation to a statement would, to any extent, be inconsistent with a secrecy provision (other than a prescribed secrecy provision), paragraph 26WR(1)(b) or subsection 26WR(2),  Amendments  Schedule 1  No. 12, 2017 Privacy Amendment (Notifiable Data Breaches) Act 2017  as the case may be, does not apply to the entity, in relation to the statement, to the extent of the inconsistency. Prescribed secrecy provisions"@en ;
    cml:integrityHash "8b4891db1706add8c34da5bb6f115eaf5a32a1e50a5d3bf994202ed5eac4a6d9" ;
    values:partOf concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wt ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Entity exempt from secrecy provisions if compliance with other provisions would be inconsistent." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
