    },
    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26we-ss-3-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26we-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
