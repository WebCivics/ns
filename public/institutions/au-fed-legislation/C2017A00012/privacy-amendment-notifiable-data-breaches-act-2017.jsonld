    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wq-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "26WQ(5) Exception—declaration by Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wq-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-notifiable-data-breaches-act-2017.pdf"
      },
      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.19",
      "values:originalText": "(5) The Commissioner may give a notice of a declaration to an entity\nunder subsection (1):\n\n(a) on the Commissioner’s own initiative; or\n\n(b) on application made to the Commissioner by the entity.\n\nAmendments  Schedule 1\n\nNo. 12, 2017\nPrivacy Amendment (Notifiable Data Breaches) Act 2017\n\nApplications",
      "skos:definition": "(5) The Commissioner may give a notice of a declaration to an entity\nunder subsection (1):\n\n(a) on the Commissioner’s own initiative; or\n\n(b) on application made to the Commissioner by the entity.\n\nAmendments  Schedule 1\n\nNo. 12, 2017\nPrivacy Amendment (Notifiable Data Breaches) Act 2017\n\nApplications",
      "values:partOf": {
        "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wq"
      },
      "cml:asserts": [
        {
