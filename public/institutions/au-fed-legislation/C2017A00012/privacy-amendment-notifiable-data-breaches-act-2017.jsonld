      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.9",
      "values:originalText": "(3) Subsection (2) has effect subject to section 26WF.",
      "skos:definition": "(3) Subsection (2) has effect subject to section 26WF.",
