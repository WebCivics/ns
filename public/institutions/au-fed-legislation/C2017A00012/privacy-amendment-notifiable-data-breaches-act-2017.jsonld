    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 After paragraph 96(1)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-notifiable-data-breaches-act-2017.pdf"
      },
      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.25",
      "values:originalText": "Insert:\n\n(ba) a decision under subsection 26WQ(7) to refuse an application\nfor a declaration;\n\n(bb) a decision to make a declaration under\nparagraph 26WQ(1)(d);\n\n(bc) a decision under subsection 26WR(1) to give a direction;",
      "skos:definition": "Insert:\n\n(ba) a decision under subsection 26WQ(7) to refuse an application\nfor a declaration;\n\n(bb) a decision to make a declaration under\nparagraph 26WQ(1)(d);\n\n(bc) a decision under subsection 26WR(1) to give a direction;",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d0794147b2cd5869696e5b96440157887df4a6da7724d18c40ed2ced6bb513cc",
      "skos:note": "Decisions under certain subsections to refuse or make declarations."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 After paragraph 96(1)(b)",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Insert:\n\n(ba) a decision under subsection 26WQ(7) to refuse an application\nfor a declaration;\n\n(bb) a decision to make a declaration under\nparagraph 26WQ(1)(d);\n\n(bc) a decision under subsection 26WR(1) to give a direction;"
    },
    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-4-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-4"
      },
      "values:deonticStatus": {
