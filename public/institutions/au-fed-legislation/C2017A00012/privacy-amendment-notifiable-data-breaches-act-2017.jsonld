      "@type": "cml:Concept",
      "skos:prefLabel": "2 Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sec-2-2"
