      ],
      "cml:integrityHash": "ccde4b6a55288bd6506d82ae70a32a2899e435a28541862255690d5fa4a2b2d7",
      "skos:note": "Entity exempted from subsection 26WK(2) if compliance with secrecy provision is inconsistent."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wp-ss-2",
      "@type": "cof:Section",
      "cof:title": "26WP(2) Exception—inconsistency with secrecy provisions",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(2) If compliance by an entity with subparagraph 26WK(2)(a)(ii) in\nrelation to a statement would, to any extent, be inconsistent with a\nsecrecy provision (other than a prescribed secrecy provision),\nsubsection 26WK(2) does not apply to the entity, in relation to the\nstatement, to the extent of the inconsistency."
    },
