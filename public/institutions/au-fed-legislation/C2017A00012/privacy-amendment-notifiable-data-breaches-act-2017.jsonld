    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wr-ss-5",
      "@type": "cof:Section",
      "cof:title": "26WR(5) Commissioner may direct entity to notify eligible data breach",
      "values:kind": "subsection",
