    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wd",
      "@type": "cml:Concept",
      "skos:prefLabel": "26WD Exception—notification under the My Health Records Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-notifiable-data-breaches-act-2017.pdf"
      },
      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.9",
      "values:originalText": "If:\n\n(a) an unauthorised access to information; or\n\n(b) an unauthorised disclosure of information; or\n\n(c) a loss of information;\nhas been, or is required to be, notified under section 75 of the My\nHealth Records Act 2012, this Part does not apply in relation to the\naccess, disclosure or loss.",
      "skos:definition": "If:\n\n(a) an unauthorised access to information; or\n\n(b) an unauthorised disclosure of information; or\n\n(c) a loss of information;\nhas been, or is required to be, notified under section 75 of the My\nHealth Records Act 2012, this Part does not apply in relation to the\naccess, disclosure or loss.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wd-norm"
        },
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wd-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4d64de7c223944d139334c0bb0c0f0e1303cfa54d2055179ab0b9381b87e07b4",
      "skos:note": "Notification under My Health Records Act exempts from this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wd",
      "@type": "cof:Section",
      "cof:title": "26WD Exception—notification under the My Health Records Act",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "If:\n\n(a) an unauthorised access to information; or\n\n(b) an unauthorised disclosure of information; or\n\n(c) a loss of information;\nhas been, or is required to be, notified under section 75 of the My\nHealth Records Act 2012, this Part does not apply in relation to the\naccess, disclosure or loss."
    },
    {
