    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26ws",
      "@type": "cml:Concept",
      "skos:prefLabel": "26WS Exception—enforcement related activities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26ws"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-notifiable-data-breaches-act-2017.pdf"
      },
      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.24",
      "values:originalText": "An entity is not required to comply with a direction under\nsubsection 26WR(1) if:\n\n(a) the entity is an enforcement body; and\n\n(b) the chief executive officer of the enforcement body believes\non reasonable grounds that compliance with the direction\nwould be likely to prejudice one or more enforcement related\nactivities conducted by, or on behalf of, the enforcement\nbody.",
      "skos:definition": "An entity is not required to comply with a direction under\nsubsection 26WR(1) if:\n\n(a) the entity is an enforcement body; and\n\n(b) the chief executive officer of the enforcement body believes\non reasonable grounds that compliance with the direction\nwould be likely to prejudice one or more enforcement related\nactivities conducted by, or on behalf of, the enforcement\nbody.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26ws-norm"
        },
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26ws-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "45d9d85fdbf8339d9dbf55f68b17fdb6298c67610c36e1be811598310c5fccb0",
      "skos:note": "Entity exempt from direction under subsection 26WR(1) if chief executive officer believes compliance would prejudice enforcement activities."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26ws",
      "@type": "cof:Section",
      "cof:title": "26WS Exception—enforcement related activities",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "An entity is not required to comply with a direction under\nsubsection 26WR(1) if:\n\n(a) the entity is an enforcement body; and\n\n(b) the chief executive officer of the enforcement body believes\non reasonable grounds that compliance with the direction\nwould be likely to prejudice one or more enforcement related\nactivities conducted by, or on behalf of, the enforcement\nbody."
    },
    {
