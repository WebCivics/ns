    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wm",
      "@type": "cml:Concept",
      "skos:prefLabel": "26WM Exception—eligible data breaches of other entities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wm"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-notifiable-data-breaches-act-2017.pdf"
      },
      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.18",
      "values:originalText": "If:\n\n(a) an entity complies with sections 26WK and 26WL in relation\nto an eligible data breach of the entity; and\n\n(b) the access, disclosure or loss that constituted the eligible data\nbreach of the entity is an eligible data breach of one or more\nother entities;\nthose sections do not apply in relation to those eligible data\nbreaches of those other entities.",
      "skos:definition": "If:\n\n(a) an entity complies with sections 26WK and 26WL in relation\nto an eligible data breach of the entity; and\n\n(b) the access, disclosure or loss that constituted the eligible data\nbreach of the entity is an eligible data breach of one or more\nother entities;\nthose sections do not apply in relation to those eligible data\nbreaches of those other entities.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wm-norm"
        },
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wm-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1b33f05df0a80a033655ff684b3cbd62dfa1daa215e6cd7c90af9bfc2592d281",
      "skos:note": "Exemption for eligible data breaches of other entities"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wm",
      "@type": "cof:Section",
      "cof:title": "26WM Exception—eligible data breaches of other entities",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "If:\n\n(a) an entity complies with sections 26WK and 26WL in relation\nto an eligible data breach of the entity; and\n\n(b) the access, disclosure or loss that constituted the eligible data\nbreach of the entity is an eligible data breach of one or more\nother entities;\nthose sections do not apply in relation to those eligible data\nbreaches of those other entities."
    },
    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wm-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wm"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wm-logic-deontic-1",
