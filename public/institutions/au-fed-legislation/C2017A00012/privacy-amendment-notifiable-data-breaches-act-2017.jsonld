        },
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wq-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c90e7c8b917472afa423a568862959dcebd45261ffea5f4ab0631d548d98daf",
      "skos:note": "Commissioner may give notice of declaration to entity on own initiative or application."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wq-ss-5",
      "@type": "cof:Section",
      "cof:title": "26WQ(5) Exception—declaration by Commissioner",
      "values:kind": "subsection",
      "cof:pageNumber": 19,
      "values:originalText": "(5) The Commissioner may give a notice of a declaration to an entity\nunder subsection (1):\n\n(a) on the Commissioner’s own initiative; or\n\n(b) on application made to the Commissioner by the entity.\n\nAmendments  Schedule 1\n\nNo. 12, 2017\nPrivacy Amendment (Notifiable Data Breaches) Act 2017\n\nApplications"
    },
    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wq-ss-5-norm",
