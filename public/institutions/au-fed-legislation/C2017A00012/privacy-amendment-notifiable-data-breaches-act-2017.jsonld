        },
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wq-ss-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "145e816a682f7a20efbf044cca0f8683b2aeac33082a44b86b9ee23f4a1ca8c5",
      "skos:note": "Commissioner may extend period specified in declaration"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wq-ss-11",
      "@type": "cof:Section",
      "cof:title": "26WQ(11) Exception—declaration by Commissioner",
      "values:kind": "subsection",
      "cof:pageNumber": 19,
      "values:originalText": "(11) If notice of a paragraph (1)(d) declaration has been given to an\nentity, the Commissioner may, by written notice given to the\nentity, extend the period specified in the declaration.\nSubdivision C—Commissioner may direct entity to notify\neligible data breach"
    },
