      "cml:premiseText": "Reasonable grounds to believe data breach has happened",
      "cml:conclusionText": "Notification given"
    },
    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wa-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
