      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-notifiable-data-breaches-act-2017.pdf"
      },
      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.8",
      "values:originalText": "For the purposes of this Part, entity includes a person who is a file\nnumber recipient.",
      "skos:definition": "For the purposes of this Part, entity includes a person who is a file\nnumber recipient.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wb-norm"
        }
      ],
      "cml:integrityHash": "b1500522c8092d4b381b829238f9ed838f142b1578b24384a094d792360dc3c2",
      "skos:note": "Defines entity for purposes of this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wb",
      "@type": "cof:Section",
      "cof:title": "26WB Entity",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "For the purposes of this Part, entity includes a person who is a file\nnumber recipient."
    },
    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wb-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
