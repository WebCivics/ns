    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wf-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "26WF(5) Exception—remedial action",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wf-ss-5"
      },
