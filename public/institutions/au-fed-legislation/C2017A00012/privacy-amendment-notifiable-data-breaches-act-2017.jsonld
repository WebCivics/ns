    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wr-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "26WR(4) Commissioner may direct entity to notify eligible data breach",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wr-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
