    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wj",
      "@type": "cml:Concept",
      "skos:prefLabel": "26WJ Exception—eligible data breaches of other entities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wj"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-notifiable-data-breaches-act-2017.pdf"
      },
      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.15",
      "values:originalText": "If:\n\n(a) an entity complies with section 26WH in relation to an\neligible data breach of the entity; and\n\n(b) the access, disclosure or loss that constituted the eligible data\nbreach of the entity is an eligible data breach of one or more\nother entities;\nthat section does not apply in relation to those eligible data\nbreaches of those other entities.\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Notifiable Data Breaches) Act 2017\nNo. 12, 2017\n\nSubdivision B—General notification obligations",
      "skos:definition": "If:\n\n(a) an entity complies with section 26WH in relation to an\neligible data breach of the entity; and\n\n(b) the access, disclosure or loss that constituted the eligible data\nbreach of the entity is an eligible data breach of one or more\nother entities;\nthat section does not apply in relation to those eligible data\nbreaches of those other entities.\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Notifiable Data Breaches) Act 2017\nNo. 12, 2017\n\nSubdivision B—General notification obligations",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wj-norm"
        },
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wj-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4b3111aa14abc9398811329c5e96b708ac28b2f028048325abc0ddf469c896c9",
      "skos:note": "Compliance with section 26WH exempts eligible data breaches of other entities from this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wj",
      "@type": "cof:Section",
      "cof:title": "26WJ Exception—eligible data breaches of other entities",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "If:\n\n(a) an entity complies with section 26WH in relation to an\neligible data breach of the entity; and\n\n(b) the access, disclosure or loss that constituted the eligible data\nbreach of the entity is an eligible data breach of one or more\nother entities;\nthat section does not apply in relation to those eligible data\nbreaches of those other entities.\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Notifiable Data Breaches) Act 2017\nNo. 12, 2017\n\nSubdivision B—General notification obligations"
    },
