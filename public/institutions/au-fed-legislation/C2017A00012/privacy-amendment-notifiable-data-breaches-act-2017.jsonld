      "cml:integrityHash": "adcaa4386da53650e7cd6dd30869f2120e135decf96c673c91d95b0e1ad74737",
      "skos:note": "Entity exemption from section 26WL if secrecy provision is inconsistent."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wp-ss-7",
      "@type": "cof:Section",
      "cof:title": "26WP(7) Exception—inconsistency with secrecy provisions",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(7) If compliance by an entity with section 26WL in relation to a\nstatement would, to any extent, be inconsistent with a prescribed\nsecrecy provision, section 26WL does not apply to the entity in\nrelation to the statement."
    },
