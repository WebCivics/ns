      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
