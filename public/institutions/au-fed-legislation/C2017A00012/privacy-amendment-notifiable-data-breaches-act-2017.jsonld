    {
      "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sch-1-sec-26wb",
      "@type": "cml:Concept",
      "skos:prefLabel": "26WB Entity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sch-1-sec-26wb"
      },
      "cml:curationStatus": {
