      "dc:source": "privacy-amendment-notifiable-data-breaches-act-2017.pdf, p.6",
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provisions do not commence\nwithin the period of 12 months beginning on\nthe day this Act receives the Royal Assent,\nthey commence on the day after the end of\nthat period.",
      "skos:definition": "A single day to be fixed by Proclamation.\nHowever, if the provisions do not commence\nwithin the period of 12 months beginning on\nthe day this Act receives the Royal Assent,\nthey commence on the day after the end of\nthat period.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-notifiable-data-breaches-act-2017-sec-2-2-norm"
        }
      ],
      "cml:integrityHash": "d87f30c07b72f811197dc2934fb8e3b27412751081448e8cf42859be5d121677",
      "skos:note": "Commencement provision for Schedule 1"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-notifiable-data-breaches-act-2017#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provisions do not commence\nwithin the period of 12 months beginning on\nthe day this Act receives the Royal Assent,\nthey commence on the day after the end of\nthat period."
    },
