      "dc:source": "crimes-amendment-penalty-unit-act-2017.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 35, 2017\nCrimes Amendment (Penalty Unit) Act 2017",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 35, 2017\nCrimes Amendment (Penalty Unit) Act 2017",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-penalty-unit-act-2017-sec-3-norm"
        }
      ],
      "cml:integrityHash": "e4f4726003dbe750833ec4dbc39073c2fb9579d47ba33be2f3f2217d81df3f78",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
