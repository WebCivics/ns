doc:sch-1-sec-46-ss-5 a cof:Section ;
    cof:title "46(5) Misuse of market power" ;
    values:kind "subsection" ;
    values:originalText "(5) For the purposes of this section, a body corporate may have a substantial degree of power in a market even though:  (a) the body corporate does not substantially control that market; or  (b) the body corporate does not have absolute freedom from constraint by the conduct of:  (i) competitors, or potential competitors, of the body corporate in that market; or  (ii) persons to whom or from whom the body corporate supplies or acquires goods or services in that market." ;
    cof:pageNumber "7"^^xsd:integer .

concept:competition-and-consumer-amendment-misuse-of-market-power-act-2017-sch-1-sec-46-ss-6 a cml:Concept ;
    skos:prefLabel "46(6) Misuse of market power"@en ;
    cml:realizedBy doc:sch-1-sec-46-ss-6 ;
    values:originalText "(6) Subsections (4) and (5) do not limit the matters to which regard may be had in determining, for the purposes of this section, the degree of power that a body corporate or bodies corporate has or have in a market." ;
    skos:definition "(6) Subsections (4) and (5) do not limit the matters to which regard may be had in determining, for the purposes of this section, the degree of power that a body corporate or bodies corporate has or have in a market."@en ;
    cml:integrityHash "d0d20d4209fc6b66934ac176dc7cf9b8ba6e484708802b3168475e458dd1cb44" ;
    values:partOf concept:competition-and-consumer-amendment-misuse-of-market-power-act-2017-sch-1-sec-46 ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Regard may be had in determining the degree of power that a body corporate or bodies corporate has or have in a market." ;
