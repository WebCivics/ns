      "dc:source": "competition-and-consumer-amendment-misuse-of-market-power-act-2017.pdf, p.6",
      "values:originalText": "The whole of\nthis Act\nAt the same time as Schedule 1 to the\nCompetition and Consumer Amendment\n(Competition Policy Review) Act 2017\ncommences.\nHowever, the provisions do not commence\nat all if that Schedule does not commence.",
      "skos:definition": "The whole of\nthis Act\nAt the same time as Schedule 1 to the\nCompetition and Consumer Amendment\n(Competition Policy Review) Act 2017\ncommences.\nHowever, the provisions do not commence\nat all if that Schedule does not commence.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-misuse-of-market-power-act-2017-sec-1-2-norm"
        }
      ],
      "cml:integrityHash": "653c09489ae24247a5b8678310f76eec882d205ed7ce57ce57e7f72241aa3081",
      "skos:note": "Commences at the same time as Schedule 1 to the Competition and Consumer Amendment (Competition Policy Review) Act 2017."
    },
