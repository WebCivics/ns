      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-93ag-ss-1",
      "cml:schemaVersion": "2",
