concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-95ab-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits conduct that would have a detrimental effect on competition." ;
    cml:premiseText "(a) a determination in force under section 95AA specifies a kind of conduct; and (b) the Commission is satisfied that particular conduct of that kind engaged in by the person: (i) would have the effect, or would be likely to have the effect, of substantially lessening competition; and (ii) would not result or be likely to result in a benefit to the public that would outweigh the detriment to the public that would result, or would be likely to result from the conduct." ;
    cml:conclusionText "The Commission may give a person a written notice if the conduct is prohibited." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
