concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-5 a cml:Concept ;
    skos:prefLabel "5 Subsection 93(1)"@en ;
    cml:realizedBy doc:sch-8-sec-5 ;
    values:originalText "Repeal the subsection, substitute:  (1) Subject to subsection (2):  (a) a corporation that engages, or proposes to engage, in conduct of a kind referred to in subsection 47(2), (3), (4), (5), (6), (7), (8) or (9); or  (b) a corporation or other person who engages, or proposes to engage, in conduct of a kind referred to in section 48;  Resale price maintenance  Schedule 8  No. 114, 2017 Competition and Consumer Amendment (Competition Policy Review) Act 2017  may give to the Commission a notice setting out particulars of the conduct or proposed conduct." ;
    skos:definition "Repeal the subsection, substitute:  (1) Subject to subsection (2):  (a) a corporation that engages, or proposes to engage, in conduct of a kind referred to in subsection 47(2), (3), (4), (5), (6), (7), (8) or (9); or  (b) a corporation or other person who engages, or proposes to engage, in conduct of a kind referred to in section 48;  Resale price maintenance  Schedule 8  No. 114, 2017 Competition and Consumer Amendment (Competition Policy Review) Act 2017  may give to the Commission a notice setting out particulars of the conduct or proposed conduct."@en ;
    cml:integrityHash "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b" ;
    cof:pageNumber "38"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-5-ss-1 ;
    cml:hasPart concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-5-ss-8 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-competition-policy-review-act-2017.pdf> ;
    dc:source "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.38" .
