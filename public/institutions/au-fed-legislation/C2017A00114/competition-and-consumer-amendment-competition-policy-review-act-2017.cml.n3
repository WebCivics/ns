doc:sch-3-sec-5 a cof:Section ;
    cof:title "5 Subsections 45(7) and (8)" ;
    values:kind "section" ;
    values:originalText "Repeal the subsections, substitute:  (7) This section does not apply to or in relation to:  (a) a contract, arrangement or understanding to the extent that the contract, arrangement or understanding directly or indirectly provides for; or  (b) a proposed contract, arrangement or understanding to the extent that the proposed contract, arrangement or understanding would directly or indirectly provide for; or  Schedule 3  Price signalling and concerted practices" ;
    cof:pageNumber "23"^^xsd:integer .

