concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-92-ss-5 a cml:Concept ;
    skos:prefLabel "92(5) Subsections 91A(3) to (5)"@en ;
    cml:realizedBy doc:sch-9-sec-92-ss-5 ;
    values:originalText "(5) Subsections 90(10B), (12) and (13) apply in relation to an application for a minor variation of a merger authorisation that is not an overseas merger authorisation in a corresponding way to the way those subsections apply in relation to an application for a merger authorisation that is not an overseas merger authorisation. Note: Those subsections deem the Commissioner to have refused to grant the application if the Commission does not determine the application within 90 days (or an extended period in some cases)." ;
    skos:definition "(5) Subsections 90(10B), (12) and (13) apply in relation to an application for a minor variation of a merger authorisation that is not an overseas merger authorisation in a corresponding way to the way those subsections apply in relation to an application for a merger authorisation that is not an overseas merger authorisation. Note: Those subsections deem the Commissioner to have refused to grant the application if the Commission does not determine the application within 90 days (or an extended period in some cases)."@en ;
    cml:integrityHash "ddf208a4766595cab0298823536caf779abcf0a43c3f1bc62268839df172de15" ;
    values:partOf concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-92 ;
    cof:pageNumber "64"^^xsd:integer ;
    skos:note "Subsections 90(10B), (12) and (13) apply in relation to an application for a minor variation of a merger authorisation that is not an overseas merger authorisation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
