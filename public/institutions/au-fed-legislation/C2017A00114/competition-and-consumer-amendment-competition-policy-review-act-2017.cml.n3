    cml:hasPart concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-88-ss-5 ;
    cml:hasPart concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-88-ss-6 ;
