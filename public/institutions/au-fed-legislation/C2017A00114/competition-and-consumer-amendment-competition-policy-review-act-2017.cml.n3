doc:sch-9-sec-93ag-ss-5 a cof:Section ;
    cof:title "93AG(5) Stop notice for collective boycott conduct" ;
    values:kind "subsection" ;
    values:originalText "(5) The stop notice ceases to be in force at the earliest of the following times:  (a) at the end of the period provided under subsection (6);  (b) if, before the end of that period, the Commission gives the corporation an objection notice under subsection 93AC(1) or" ;
    cof:pageNumber "50"^^xsd:integer .

concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93ag-ss-2 a cml:Concept ;
    skos:prefLabel "93AG(2) Stop notice for collective boycott conduct"@en ;
    cml:realizedBy doc:sch-9-sec-93ag-ss-2 ;
    values:originalText "(2) that relates to the collective bargaining notice—when that objection notice is given;  (c) if, before the end of that period, the Commission gives the corporation a notice under subsection 93ACA(1) imposing conditions relating to conduct or proposed conduct that relates to the collective bargaining notice—when that notice under subsection 93ACA(1) is given;  (d) if the Commission withdraws the stop notice—when it is withdrawn." ;
    skos:definition "(2) that relates to the collective bargaining notice—when that objection notice is given;  (c) if, before the end of that period, the Commission gives the corporation a notice under subsection 93ACA(1) imposing conditions relating to conduct or proposed conduct that relates to the collective bargaining notice—when that notice under subsection 93ACA(1) is given;  (d) if the Commission withdraws the stop notice—when it is withdrawn."@en ;
    cml:integrityHash "3435cd50e2489778cc09feb510f24993e148c324c7c610b00d49cbe6f0ed37dd" ;
    values:partOf concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93ag ;
    cof:pageNumber "50"^^xsd:integer ;
    skos:note "Commission must provide written statement of reasons for stop notice. Stop notice for collective boycott conduct" ;
    dc:description "yes" ;
