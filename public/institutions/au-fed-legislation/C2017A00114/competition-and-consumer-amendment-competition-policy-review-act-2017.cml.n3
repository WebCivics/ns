concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-2 a cml:Concept ;
    skos:prefLabel "2 Application of amendments"@en ;
    cml:realizedBy doc:sch-14-sec-2 ;
    values:originalText "(1) The repeal of subsection 5(3) of the Competition and Consumer Act 2010 made by this Part applies in relation to hearings commencing on or after the commencement of this item. (2) The repeal of subsection 5(4) of the Competition and Consumer Act 2010 made by this Part applies in relation to applications made on or after the commencement of this item.  Other amendments  Schedule 14 Jurisdiction of State and Territory Courts  Part 2  No. 114, 2017 Competition and Consumer Amendment (Competition Policy Review) Act 2017" ;
    skos:definition "(1) The repeal of subsection 5(3) of the Competition and Consumer Act 2010 made by this Part applies in relation to hearings commencing on or after the commencement of this item. (2) The repeal of subsection 5(4) of the Competition and Consumer Act 2010 made by this Part applies in relation to applications made on or after the commencement of this item.  Other amendments  Schedule 14 Jurisdiction of State and Territory Courts  Part 2  No. 114, 2017 Competition and Consumer Amendment (Competition Policy Review) Act 2017"@en ;
    cml:integrityHash "9c3957084f8c3001864c16d5ce6c0bc497601800d23c8acd4dcb2a00525b6615" ;
    cof:pageNumber "104"^^xsd:integer ;
    skos:note "Repeal of subsections applies to hearings and applications commencing after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
