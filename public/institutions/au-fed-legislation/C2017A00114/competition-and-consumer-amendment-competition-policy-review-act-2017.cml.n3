doc:sch-9-sec-16-ss-1 a cof:Section ;
    cof:title "16(1) After section 93AC" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a corporation gives the Commission a collective bargaining notice that relates (wholly or partly) to collective boycott conduct or proposed collective boycott conduct; and  (b) the Commission reasonably believes that:  (i) apart from this section, the Commission would have grounds to give the corporation an objection notice relating to the collective bargaining notice; and  (ii) those grounds would not exist if particular conditions relating to the conduct or proposed conduct were complied with; the Commission may give the corporation a written notice imposing those conditions." ;
    cof:pageNumber "48"^^xsd:integer .

concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-16-ss-2 a cml:Concept ;
    skos:prefLabel "16(2) After section 93AC"@en ;
    cml:realizedBy doc:sch-9-sec-16-ss-2 ;
    values:originalText "(2) The Commission must, in or with the notice under subsection (1), give the corporation a written statement of its reasons for giving the notice." ;
    skos:definition "(2) The Commission must, in or with the notice under subsection (1), give the corporation a written statement of its reasons for giving the notice."@en ;
