concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-13 a cml:Concept ;
    skos:prefLabel "13 Subsection 93(7A)"@en ;
    cml:realizedBy doc:sch-8-sec-13 ;
    values:originalText "Repeal the subsection, substitute:  (7A) A notice under subsection (1) describing conduct or proposed conduct referred to in section 48 comes into force:  (a) at the end of the period of 60 days, or such other period as is prescribed by the regulations, starting on the day when the corporation or other person gave the Commission the notice; or  (b) if the Commission gives notice to the corporation or other person under subsection 93A(2) during that period—when  Schedule 8  Resale price maintenance  Competition and Consumer Amendment (Competition Policy Review) Act 2017 No. 114, 2017  the Commission decides not to give the corporation or other person a notice under subsection (3A) of this section." ;
    skos:definition "Repeal the subsection, substitute:  (7A) A notice under subsection (1) describing conduct or proposed conduct referred to in section 48 comes into force:  (a) at the end of the period of 60 days, or such other period as is prescribed by the regulations, starting on the day when the corporation or other person gave the Commission the notice; or  (b) if the Commission gives notice to the corporation or other person under subsection 93A(2) during that period—when  Schedule 8  Resale price maintenance  Competition and Consumer Amendment (Competition Policy Review) Act 2017 No. 114, 2017  the Commission decides not to give the corporation or other person a notice under subsection (3A) of this section."@en ;
    cml:integrityHash "e4ae233549eb611e29b3ebb20144190ff1b53568599e0e6f166cbfbf5dccf6b3" ;
    cof:pageNumber "39"^^xsd:integer ;
    skos:note "Conditional commencement of notice under subsection (1)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-competition-policy-review-act-2017.pdf> ;
