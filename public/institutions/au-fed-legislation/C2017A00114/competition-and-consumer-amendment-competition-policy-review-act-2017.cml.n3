concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-5 a cml:Concept ;
    skos:prefLabel "5 Subsections 45(7) and (8)"@en ;
    cml:realizedBy doc:sch-3-sec-5 ;
    values:originalText "Repeal the subsections, substitute:  (7) This section does not apply to or in relation to:  (a) a contract, arrangement or understanding to the extent that the contract, arrangement or understanding directly or indirectly provides for; or  (b) a proposed contract, arrangement or understanding to the extent that the proposed contract, arrangement or understanding would directly or indirectly provide for; or  Schedule 3  Price signalling and concerted practices" ;
    skos:definition "Repeal the subsections, substitute:  (7) This section does not apply to or in relation to:  (a) a contract, arrangement or understanding to the extent that the contract, arrangement or understanding directly or indirectly provides for; or  (b) a proposed contract, arrangement or understanding to the extent that the proposed contract, arrangement or understanding would directly or indirectly provide for; or  Schedule 3  Price signalling and concerted practices"@en ;
    cml:integrityHash "16456d68fc6fb7ba2b350b6a50fed07b70cbaa0baba2ed4a139fda57b1141729" ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "Exempts contracts, arrangements, and understandings from the application of section 7." ;
    cml:curationStatus cml:Proposed ;
