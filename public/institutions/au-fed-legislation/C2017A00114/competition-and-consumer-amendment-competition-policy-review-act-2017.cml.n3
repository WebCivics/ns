concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-44ca-ss-3 a cml:Concept ;
    skos:prefLabel "44CA(3) Meaning of declaration criteria"@en ;
    cml:realizedBy doc:sch-12-sec-44ca-ss-3 ;
    values:originalText "(3) Without limiting the matters to which the Council may have regard for the purposes of section 44G, or the designated Minister may have regard for the purposes of section 44H, in considering whether paragraph (1)(d) of this section applies the Council or designated Minister must have regard to:  (a) the effect that declaring the service would have on investment in:  (i) infrastructure services; and  (ii) markets that depend on access to the service; and  (b) the administrative and compliance costs that would be incurred by the provider of the service if the service is declared." ;
    skos:definition "(3) Without limiting the matters to which the Council may have regard for the purposes of section 44G, or the designated Minister may have regard for the purposes of section 44H, in considering whether paragraph (1)(d) of this section applies the Council or designated Minister must have regard to:  (a) the effect that declaring the service would have on investment in:  (i) infrastructure services; and  (ii) markets that depend on access to the service; and  (b) the administrative and compliance costs that would be incurred by the provider of the service if the service is declared."@en ;
    cml:integrityHash "688cc72cca4815cbc8c3d7cb0df814fec8b25a66dc57e8a5d8b94fd093dcc4f6" ;
    values:partOf concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-44ca ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Council must have regard to the effect of declaring the service on investment and administrative costs." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
