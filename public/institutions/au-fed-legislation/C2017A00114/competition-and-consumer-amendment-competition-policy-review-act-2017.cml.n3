doc:sch-9-sec-93ag-ss-6 a cof:Section ;
    cof:title "93AG(6) Stop notice for collective boycott conduct" ;
    values:kind "subsection" ;
    values:originalText "(6) For the purposes of paragraph (5)(a), the period is:  (a) the period of 90 days beginning on the day the Commission gives the corporation the stop notice; or  (b) if the Commission extends it under subsection (7)—that period as so extended." ;
    cof:pageNumber "50"^^xsd:integer .

concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93ag-ss-7 a cml:Concept ;
    skos:prefLabel "93AG(7) Stop notice for collective boycott conduct"@en ;
    cml:realizedBy doc:sch-9-sec-93ag-ss-7 ;
    values:originalText "(7) Before the end of the period referred to in paragraph (6)(a), the Commission may extend the period by up to a further 90 days:  (a) if satisfied that in all the circumstances it is reasonable to do so; and  (b) by giving written notice of the extended period to the corporation." ;
    skos:definition "(7) Before the end of the period referred to in paragraph (6)(a), the Commission may extend the period by up to a further 90 days:  (a) if satisfied that in all the circumstances it is reasonable to do so; and  (b) by giving written notice of the extended period to the corporation."@en ;
    cml:integrityHash "dda79bba5aa4688d05d22e9ae7de11a75e09ac3da8652707be854fd83a747851" ;
    values:partOf concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93ag ;
    cof:pageNumber "50"^^xsd:integer ;
    skos:note "Commission may extend period of collective boycott conduct by up to 90 days with written notice." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
