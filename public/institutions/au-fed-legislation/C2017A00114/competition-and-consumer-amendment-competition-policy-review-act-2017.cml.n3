concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-4-sec-3 a cml:Concept ;
    skos:prefLabel "3 Subsection 93AC(1)"@en ;
    cml:realizedBy doc:sch-4-sec-3 ;
    values:originalText "Repeal the subsection, substitute: Commission’s objection notice—cartel provisions  (1) If:  (a) a corporation gives the Commission a collective bargaining notice under subsection 93AB(1A) in relation to a contract, or proposed contract, containing a cartel provision of the kind referred to in that subsection; and  (b) the Commission is satisfied that any benefit to the public that has resulted or is likely to result or would result or be likely to result from the provision does not or would not outweigh the detriment to the public that has resulted or is likely to result or would result or be likely to result from the provision; the Commission may give the corporation a written notice (the objection notice) stating that it is so satisfied." ;
    skos:definition "Repeal the subsection, substitute: Commission’s objection notice—cartel provisions  (1) If:  (a) a corporation gives the Commission a collective bargaining notice under subsection 93AB(1A) in relation to a contract, or proposed contract, containing a cartel provision of the kind referred to in that subsection; and  (b) the Commission is satisfied that any benefit to the public that has resulted or is likely to result or would result or be likely to result from the provision does not or would not outweigh the detriment to the public that has resulted or is likely to result or would result or be likely to result from the provision; the Commission may give the corporation a written notice (the objection notice) stating that it is so satisfied."@en ;
    cml:integrityHash "e98874f2828b98979fbb56b4ba81893948ba9bf5381e82b601bdec91be52b800" ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Commission may give corporation an objection notice if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
