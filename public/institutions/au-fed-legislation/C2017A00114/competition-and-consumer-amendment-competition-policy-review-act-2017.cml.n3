doc:sch-3-sec-34 a cof:Section ;
    cof:title "34 Paragraphs 51(2)(c) and (d) of Schedule 1" ;
    values:kind "section" ;
    values:originalText "Repeal the paragraphs, substitute:  (c) to:  (i) any provision of a contract, arrangement or understanding; or  (ii) any concerted practice;  to the extent that the provision or concerted practice obliges a person to comply with or apply standards of dimension, design, quality or performance prepared or approved by Standards Australia or a prescribed association or body; or  (d) to:  (i) any provision of a contract, arrangement or understanding; or  (ii) any concerted practice;  between partners none of whom is a body corporate, to the extent that the provision or concerted practice relates to:  (iii) the terms of the partnership; or  (iv) the conduct of the partnership business; or  (v) competition between the partnership and a party to the contract, arrangement, understanding or concerted practice, while the party is, or after the party ceases to be, a partner; or" ;
    cof:pageNumber "31"^^xsd:integer .

concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-35 a cml:Concept ;
    skos:prefLabel "35 Paragraph 51(2)(g) of Schedule 1"@en ;
    cml:realizedBy doc:sch-3-sec-35 ;
    values:originalText "Repeal the paragraph, substitute:  (g) to:  (i) any provision of a contract, arrangement or understanding; or  (ii) any concerted practice;  to the extent that the provision or concerted practice relates exclusively to:  (iii) the export of goods from Australia; or  (iv) the supply of services outside Australia;  if full and accurate particulars of the provision or concerted practice were given to the Commission no more than 14 days after the day the contract or arrangement was made or the  Schedule 3  Price signalling and concerted practices" ;
    skos:definition "Repeal the paragraph, substitute:  (g) to:  (i) any provision of a contract, arrangement or understanding; or  (ii) any concerted practice;  to the extent that the provision or concerted practice relates exclusively to:  (iii) the export of goods from Australia; or  (iv) the supply of services outside Australia;  if full and accurate particulars of the provision or concerted practice were given to the Commission no more than 14 days after the day the contract or arrangement was made or the  Schedule 3  Price signalling and concerted practices"@en ;
    cml:integrityHash "a22dbdbf6b4f47c06ad201d7c7d51b1bc3214c7094894f04e1860f0888f9bbb0" ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Repeal paragraph and substitute with new provision related to export of goods from Australia or supply of services outside Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
