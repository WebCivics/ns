concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-2 a cml:Concept ;
    skos:prefLabel "2 At the end of section 48"@en ;
    cml:realizedBy doc:sch-8-sec-2 ;
    values:originalText "Add:  (2) Subsection (1) does not apply to a corporation or other person engaging in conduct that constitutes the practice of resale price maintenance if:  (a) the corporation or other person has given the Commission a notice under subsection 93(1) describing the conduct; and  (b) the notice is in force under section 93." ;
    skos:definition "Add:  (2) Subsection (1) does not apply to a corporation or other person engaging in conduct that constitutes the practice of resale price maintenance if:  (a) the corporation or other person has given the Commission a notice under subsection 93(1) describing the conduct; and  (b) the notice is in force under section 93."@en ;
    cml:integrityHash "bfa3c12f304d743a95b567586fad78b8ce285ac3192fd350c3f8c741148012b3" ;
    cof:pageNumber "38"^^xsd:integer ;
    skos:note "Exempts corporations from resale price maintenance if notice is given to Commission." ;
