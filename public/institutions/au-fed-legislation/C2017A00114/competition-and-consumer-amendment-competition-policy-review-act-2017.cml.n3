concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-9 a cml:Concept ;
    skos:prefLabel "9 At the end of section 44FA"@en ;
    cml:realizedBy doc:sch-12-sec-9 ;
    values:originalText "Add:  (4) Subsections 44GB(4) to (6) apply to information given in response to a notice under this section (whether given in compliance with the notice or not) in a corresponding way to the way those subsections apply to a submission made in response to a notice under subsection 44GB(1). Note: This allows the Council to make the information publicly available, subject to any confidentiality concerns." ;
    skos:definition "Add:  (4) Subsections 44GB(4) to (6) apply to information given in response to a notice under this section (whether given in compliance with the notice or not) in a corresponding way to the way those subsections apply to a submission made in response to a notice under subsection 44GB(1). Note: This allows the Council to make the information publicly available, subject to any confidentiality concerns."@en ;
    cml:integrityHash "cb506a2f4cfe0b6f8c7bb70b6b80c7c2ae0b2b7bbc743e92d157f290a4d12fcb" ;
    cof:pageNumber "87"^^xsd:integer ;
    skos:note "Information given in response to a notice under this section must be made publicly available, subject to any confidentiality concerns." ;
