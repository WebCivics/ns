concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-88-ss-5 a cml:Concept ;
    skos:prefLabel "88(5) Commission may grant authorisations"@en ;
    cml:realizedBy doc:sch-9-sec-88-ss-5 ;
    values:originalText "(5) The Commission may grant a single authorisation for all the conduct specified in an application for authorisation, or may grant separate authorisations for any of the conduct. Past conduct" ;
    skos:definition "(5) The Commission may grant a single authorisation for all the conduct specified in an application for authorisation, or may grant separate authorisations for any of the conduct. Past conduct"@en ;
