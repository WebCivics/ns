concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-8 a cml:Concept ;
    skos:prefLabel "8 After subsection 45(5) of Schedule 1"@en ;
    cml:realizedBy doc:sch-3-sec-8 ;
    values:originalText "Insert:  (5A) The making of a contract, arrangement or understanding does not constitute a contravention of this section because the contract, arrangement or understanding contains a provision the giving effect to which would, or would apart from subsection 47(10) or section 88 or 93, constitute a contravention of section 47." ;
    skos:definition "Insert:  (5A) The making of a contract, arrangement or understanding does not constitute a contravention of this section because the contract, arrangement or understanding contains a provision the giving effect to which would, or would apart from subsection 47(10) or section 88 or 93, constitute a contravention of section 47."@en ;
    cml:integrityHash "c0096386c4f442c45190b1049e0dc798de6ad990ac2d7d5649f01df8183ed5f0" ;
    cof:pageNumber "25"^^xsd:integer ;
    skos:note "Making a contract does not constitute a contravention if it contains a provision that would otherwise be a contravention." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
