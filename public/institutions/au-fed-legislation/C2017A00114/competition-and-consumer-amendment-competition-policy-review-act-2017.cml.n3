concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sec-2-2 a cml:Concept ;
    skos:prefLabel "2 Schedule 1"@en ;
    cml:realizedBy doc:sec-2-2 ;
    values:originalText "The provisions do not commence at all unless the Competition and Consumer Amendment (Misuse of Market Power) Act 2017 receives the Royal Assent. If that Act receives the Royal Assent, the provisions commence on: (a) a single day to be fixed by Proclamation; or (b) if no earlier day is fixed under paragraph (a), the day after the end of the period of 6 months beginning on the later of: (i) the day this Act receives the Royal Assent; and (ii) the day the Competition and Consumer Amendment (Misuse of Market Power) Act 2017 receives the Royal Assent." ;
    skos:definition "The provisions do not commence at all unless the Competition and Consumer Amendment (Misuse of Market Power) Act 2017 receives the Royal Assent. If that Act receives the Royal Assent, the provisions commence on: (a) a single day to be fixed by Proclamation; or (b) if no earlier day is fixed under paragraph (a), the day after the end of the period of 6 months beginning on the later of: (i) the day this Act receives the Royal Assent; and (ii) the day the Competition and Consumer Amendment (Misuse of Market Power) Act 2017 receives the Royal Assent."@en ;
    cml:integrityHash "d046630e44af0950c1c9deb26339182fa031b9638301a049430d1dba94a096a0" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Commencement of provisions depends on Royal Assent and Proclamation" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-competition-policy-review-act-2017.pdf> ;
    dc:source "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.8" ;
