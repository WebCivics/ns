concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93ag-ss-6 a cml:Concept ;
    skos:prefLabel "93AG(6) Stop notice for collective boycott conduct"@en ;
    cml:realizedBy doc:sch-9-sec-93ag-ss-6 ;
    values:originalText "(6) For the purposes of paragraph (5)(a), the period is:  (a) the period of 90 days beginning on the day the Commission gives the corporation the stop notice; or  (b) if the Commission extends it under subsection (7)—that period as so extended." ;
    skos:definition "(6) For the purposes of paragraph (5)(a), the period is:  (a) the period of 90 days beginning on the day the Commission gives the corporation the stop notice; or  (b) if the Commission extends it under subsection (7)—that period as so extended."@en ;
    cml:integrityHash "a2d73e5326981b7737180e0f790bcc176efe0b93f21a0a745f894c2c6884e641" ;
    values:partOf concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93ag ;
