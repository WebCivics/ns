    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Subsection 4(1) (definition of authorisation)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-27"
      },
