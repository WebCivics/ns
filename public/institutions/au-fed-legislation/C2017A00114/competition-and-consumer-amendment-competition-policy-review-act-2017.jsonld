    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-117",
      "@type": "cml:Concept",
      "skos:prefLabel": "117 After subsection 101(1B)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-117"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.71",
      "values:originalText": "Insert:\n\n(1C) The regulations may make it a requirement that a person applying\nunder subsection (1) for review of a determination relating to a\nmerger authorisation give an undertaking under section 87B that\nthe person will not make the acquisition to which the authorisation\nrelates while the Tribunal is considering the application.",
      "skos:definition": "Insert:\n\n(1C) The regulations may make it a requirement that a person applying\nunder subsection (1) for review of a determination relating to a\nmerger authorisation give an undertaking under section 87B that\nthe person will not make the acquisition to which the authorisation\nrelates while the Tribunal is considering the application.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-117-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-117-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "78214d818fb719a177cb56cb01d1072a9ca0122de4ae2912d19733604aca8d09",
      "skos:note": "Give an undertaking under section 87B not to make the acquisition while the Tribunal is considering the application."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-117",
      "@type": "cof:Section",
      "cof:title": "117 After subsection 101(1B)",
      "values:kind": "section",
      "cof:pageNumber": 71,
      "values:originalText": "Insert:\n\n(1C) The regulations may make it a requirement that a person applying\nunder subsection (1) for review of a determination relating to a\nmerger authorisation give an undertaking under section 87B that\nthe person will not make the acquisition to which the authorisation\nrelates while the Tribunal is considering the application."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-117-norm",
