    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Paragraph 51(2)(a) of Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.30",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) to any act done, or concerted practice, to the extent that it\nrelates to the remuneration, conditions of employment, hours\nof work or working conditions of employees; or\n\n(aa) to:\n\n(i) the making of a contract or arrangement, or the entering\ninto of an understanding; or\n\n(ii) any provision of a contract, arrangement or\nunderstanding;\n\nto the extent that the contract, arrangement, understanding or\nprovision relates to the remuneration, conditions of\nemployment, hours of work or working conditions of\nemployees; or",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) to any act done, or concerted practice, to the extent that it\nrelates to the remuneration, conditions of employment, hours\nof work or working conditions of employees; or\n\n(aa) to:\n\n(i) the making of a contract or arrangement, or the entering\ninto of an understanding; or\n\n(ii) any provision of a contract, arrangement or\nunderstanding;\n\nto the extent that the contract, arrangement, understanding or\nprovision relates to the remuneration, conditions of\nemployment, hours of work or working conditions of\nemployees; or",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-32-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-32-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4017eb59cb73652d86de7d0960ba0c10d1fad3406f48733929a714f3acfce977",
      "skos:note": "Repeal certain acts and practices related to employee remuneration, conditions of employment, hours of work, or working conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Paragraph 51(2)(a) of Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) to any act done, or concerted practice, to the extent that it\nrelates to the remuneration, conditions of employment, hours\nof work or working conditions of employees; or\n\n(aa) to:\n\n(i) the making of a contract or arrangement, or the entering\ninto of an understanding; or\n\n(ii) any provision of a contract, arrangement or\nunderstanding;\n\nto the extent that the contract, arrangement, understanding or\nprovision relates to the remuneration, conditions of\nemployment, hours of work or working conditions of\nemployees; or"
    },
    {
