    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.10",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nDefinition of “competition”  Schedule 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nDefinition of “competition”  Schedule 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "60fc169c15e2f983d53a7ebd1323f57502fec6cf14aa7d33f6e99fe771efe466",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nDefinition of “competition”  Schedule 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sec-3-2-norm",
