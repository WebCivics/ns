    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Paragraph 44W(1)(e)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.96",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(e) requiring the provider to bear some or all of the costs of\nextending the facility (including expanding the capacity of\nthe facility and expanding the geographical reach of the\nfacility);\n\n(ea) requiring the provider to bear some or all of the costs of\nmaintaining extensions of the facility (including expansions\nof the capacity of the facility and expansions of the\ngeographical reach of the facility);",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(e) requiring the provider to bear some or all of the costs of\nextending the facility (including expanding the capacity of\nthe facility and expanding the geographical reach of the\nfacility);\n\n(ea) requiring the provider to bear some or all of the costs of\nmaintaining extensions of the facility (including expansions\nof the capacity of the facility and expansions of the\ngeographical reach of the facility);",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-40-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-40-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "27e7dd9bb9d12120c27f34358120d8d08cc09bc484dbb1f7a1d228e7a131a65e",
      "skos:note": "Provider must bear costs of extending facility",
      "dc:description": "costs of extending facility"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-40",
      "@type": "cof:Section",
      "cof:title": "40 Paragraph 44W(1)(e)",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(e) requiring the provider to bear some or all of the costs of\nextending the facility (including expanding the capacity of\nthe facility and expanding the geographical reach of the\nfacility);\n\n(ea) requiring the provider to bear some or all of the costs of\nmaintaining extensions of the facility (including expansions\nof the capacity of the facility and expansions of the\ngeographical reach of the facility);"
    },
