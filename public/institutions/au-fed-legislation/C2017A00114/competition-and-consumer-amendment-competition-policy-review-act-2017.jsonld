    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Paragraph 51(2)(g)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.28",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(g) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice relates\nexclusively to:\n\n(iii) the export of goods from Australia; or\n\n(iv) the supply of services outside Australia;\n\nPrice signalling and concerted practices  Schedule 3\nOther amendments  Part 2\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nif full and accurate particulars of the provision or concerted\npractice were given to the Commission no more than 14 days\nafter the day the contract or arrangement was made or the\nunderstanding or concerted practice was entered into, or\nbefore 8 September 1976, whichever was the later.",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(g) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice relates\nexclusively to:\n\n(iii) the export of goods from Australia; or\n\n(iv) the supply of services outside Australia;\n\nPrice signalling and concerted practices  Schedule 3\nOther amendments  Part 2\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nif full and accurate particulars of the provision or concerted\npractice were given to the Commission no more than 14 days\nafter the day the contract or arrangement was made or the\nunderstanding or concerted practice was entered into, or\nbefore 8 September 1976, whichever was the later.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-19-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-19-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-19-logic-epistemic-2"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-19-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "91897b3a2575270b3b8d2c6616108495c3a540fdd0deb6910f972a9223584ed5",
      "skos:note": "Provide full and accurate particulars of provision or concerted practice within 14 days after contract or arrangement is made, or before 8 September 1976."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Paragraph 51(2)(g)",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(g) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice relates\nexclusively to:\n\n(iii) the export of goods from Australia; or\n\n(iv) the supply of services outside Australia;\n\nPrice signalling and concerted practices  Schedule 3\nOther amendments  Part 2\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nif full and accurate particulars of the provision or concerted\npractice were given to the Commission no more than 14 days\nafter the day the contract or arrangement was made or the\nunderstanding or concerted practice was entered into, or\nbefore 8 September 1976, whichever was the later."
    },
