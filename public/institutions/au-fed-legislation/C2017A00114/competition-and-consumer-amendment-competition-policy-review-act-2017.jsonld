    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-20-ss-1",
      "@type": "cof:Section",
      "cof:title": "20(1) After Subdivision C of Division 2A of Part IIIA",
      "values:kind": "subsection",
      "cof:pageNumber": 90,
      "values:originalText": "(1) The Council may give a person a written notice requesting the\nperson give to the Council, within a specified period, information\nof the kind specified in the notice that the Council considers may\nbe relevant to deciding what recommendation to make under\nsection 44NBA."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-20-ss-1-norm",
