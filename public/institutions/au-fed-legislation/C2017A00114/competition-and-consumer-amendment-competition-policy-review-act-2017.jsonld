    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-99",
      "@type": "cml:Concept",
      "skos:prefLabel": "99 After subsection 91C(7)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-99"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.68",
      "values:originalText": "Insert:\n\n(7A) Subsections 90(10B), (12) and (13) apply in relation to an\napplication for a revocation and substitution of a merger\nauthorisation that is not an overseas merger authorisation in a\ncorresponding way to the way those subsections apply in relation\nto an application for a merger authorisation that is not an overseas\nmerger authorisation.\nNote:\nThose subsections deem the Commissioner to have refused to grant\nthe application if the Commission does not determine the application\nwithin 90 days (or an extended period in some cases).",
      "skos:definition": "Insert:\n\n(7A) Subsections 90(10B), (12) and (13) apply in relation to an\napplication for a revocation and substitution of a merger\nauthorisation that is not an overseas merger authorisation in a\ncorresponding way to the way those subsections apply in relation\nto an application for a merger authorisation that is not an overseas\nmerger authorisation.\nNote:\nThose subsections deem the Commissioner to have refused to grant\nthe application if the Commission does not determine the application\nwithin 90 days (or an extended period in some cases).",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-99-norm"
        }
      ],
      "cml:integrityHash": "2b142bd011f0652b2b9ae545cc6649b694ba03f73301be8864518eca57c826c4",
      "skos:note": "Application for revocation and substitution of merger authorization"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-99",
      "@type": "cof:Section",
      "cof:title": "99 After subsection 91C(7)",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "Insert:\n\n(7A) Subsections 90(10B), (12) and (13) apply in relation to an\napplication for a revocation and substitution of a merger\nauthorisation that is not an overseas merger authorisation in a\ncorresponding way to the way those subsections apply in relation\nto an application for a merger authorisation that is not an overseas\nmerger authorisation.\nNote:\nThose subsections deem the Commissioner to have refused to grant\nthe application if the Commission does not determine the application\nwithin 90 days (or an extended period in some cases)."
    },
