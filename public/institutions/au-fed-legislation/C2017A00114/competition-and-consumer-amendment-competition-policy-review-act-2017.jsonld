      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.9",
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n\n\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\nNo. 114, 2017\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "skos:definition": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n\n\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\nNo. 114, 2017\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sec-28-norm"
        }
      ],
      "cml:integrityHash": "97f66a36ba9bb8798925feced9fcda85fd65f2855723e7f81239532c2a4019ac",
      "skos:note": "Note on table limitations"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sec-28",
      "@type": "cof:Section",
      "cof:title": "28 October 2017",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n\n\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\nNo. 114, 2017\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act."
    },
