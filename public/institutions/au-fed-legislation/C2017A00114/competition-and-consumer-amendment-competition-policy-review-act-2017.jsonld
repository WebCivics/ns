      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.76",
      "values:originalText": "Add:\n\n(2) A reference in this Division to subsection 88(1A) or\nparagraph 88(1A)(b) is a reference to that subsection or paragraph\nas in force before the commencement of Schedule 9 to the\nCompetition and Consumer Amendment (Competition Policy\nReview) Act 2017.",
      "skos:definition": "Add:\n\n(2) A reference in this Division to subsection 88(1A) or\nparagraph 88(1A)(b) is a reference to that subsection or paragraph\nas in force before the commencement of Schedule 9 to the\nCompetition and Consumer Amendment (Competition Policy\nReview) Act 2017.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-145-norm"
        }
      ],
      "cml:integrityHash": "6201a9a187c5ca7f30c874756bdce54277670e9a4ec986e0e82c6fbba0b29555",
      "skos:note": "Reference to subsection or paragraph as in force before commencement of Schedule 9"
    },
    {
