      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-15-logic-deontic-1",
      "@type": "cml:LogicApplication",
