      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.62",
      "values:originalText": "Add:\n\n(7) The Commission may disclose information excluded under this\nsection from the register kept under subsection (3) to such persons\nand on such terms as it considers reasonable and appropriate for\nthe purposes of making its determination on the application\nconcerned.",
      "skos:definition": "Add:\n\n(7) The Commission may disclose information excluded under this\nsection from the register kept under subsection (3) to such persons\nand on such terms as it considers reasonable and appropriate for\nthe purposes of making its determination on the application\nconcerned.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-79-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-79-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "516e21ab0ee8e3f1c2dec5c38f76d9ae817d89f8740cae40c567087437854d14",
      "skos:note": "Disclosure of information under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-79",
      "@type": "cof:Section",
      "cof:title": "79 At the end of section 89",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "Add:\n\n(7) The Commission may disclose information excluded under this\nsection from the register kept under subsection (3) to such persons\nand on such terms as it considers reasonable and appropriate for\nthe purposes of making its determination on the application\nconcerned."
    },
