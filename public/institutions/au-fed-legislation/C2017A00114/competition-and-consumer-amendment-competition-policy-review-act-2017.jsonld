    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 At the end of section 48 of Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-8-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.41",
      "values:originalText": "Add:\n\n(2) Subsection (1) does not apply to a person engaging in conduct that\nconstitutes the practice of resale price maintenance if:\n\n(a) the person has given the Commission a notice under\nsubsection 93(1) describing the conduct; and\n\n(b) the notice is in force under section 93.\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "skos:definition": "Add:\n\n(2) Subsection (1) does not apply to a person engaging in conduct that\nconstitutes the practice of resale price maintenance if:\n\n(a) the person has given the Commission a notice under\nsubsection 93(1) describing the conduct; and\n\n(b) the notice is in force under section 93.\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-23-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8cdc8b6a980d634214c9016df879f2a51d6867a097794d6d7fae079f358e1afb",
      "skos:note": "Exemption from resale price maintenance regulation under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-8-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 At the end of section 48 of Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "Add:\n\n(2) Subsection (1) does not apply to a person engaging in conduct that\nconstitutes the practice of resale price maintenance if:\n\n(a) the person has given the Commission a notice under\nsubsection 93(1) describing the conduct; and\n\n(b) the notice is in force under section 93.\n\nSchedule 9  Authorisations, notifications and class exemptions"
    },
