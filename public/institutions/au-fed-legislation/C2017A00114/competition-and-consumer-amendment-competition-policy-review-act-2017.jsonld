        }
      ],
      "cml:integrityHash": "25affa23029aa120daab7bcfa0849abb092518bcf084bb315e3fa8d33d06487e",
      "skos:note": "The Council must, in writing, recommend to the Commonwealth Minister that he or she not revoke the decision."
    },
    {
