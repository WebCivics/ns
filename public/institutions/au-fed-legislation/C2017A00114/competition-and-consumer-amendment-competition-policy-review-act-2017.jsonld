        }
      ],
      "cml:integrityHash": "29340ebcb90807d594a00846e9c9c557327d5fe792c5c6aeeb93c7d1ff478f67",
      "skos:note": "Clearance granted before commencement time is taken to be an authorisation after clearance comes into force."
    },
    {
