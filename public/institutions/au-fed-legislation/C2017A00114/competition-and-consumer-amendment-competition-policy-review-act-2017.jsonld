    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Subsection 4(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.57",
      "values:originalText": "Insert:\ncollective boycott conduct means conduct that has a purpose\nreferred to in subsection 44ZZRD(3) in relation to a contract,\narrangement or understanding.\nmerger authorisation means an authorisation that:\n\n(a) is an authorisation for a person to engage in conduct to which\nsection 50 or 50A would or might apply; but\n\n(b) is not an authorisation for a person to engage in conduct to\nwhich any provision of Part IV other than section 50 or 50A\nwould or might apply.\noverseas merger authorisation means a merger authorisation that\nis not an authorisation for a person to engage in conduct to which\nsection 50 would or might apply.",
      "skos:definition": "Insert:\ncollective boycott conduct means conduct that has a purpose\nreferred to in subsection 44ZZRD(3) in relation to a contract,\narrangement or understanding.\nmerger authorisation means an authorisation that:\n\n(a) is an authorisation for a person to engage in conduct to which\nsection 50 or 50A would or might apply; but\n\n(b) is not an authorisation for a person to engage in conduct to\nwhich any provision of Part IV other than section 50 or 50A\nwould or might apply.\noverseas merger authorisation means a merger authorisation that\nis not an authorisation for a person to engage in conduct to which\nsection 50 would or might apply.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-29-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-29-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-29-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "ddcfba1f85ec8d0fff745e4d3381a4da85b6fd5740473319b3bc5a32bb8962f7",
      "skos:note": "Defines collective boycott conduct and merger authorisation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Subsection 4(1)",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "Insert:\ncollective boycott conduct means conduct that has a purpose\nreferred to in subsection 44ZZRD(3) in relation to a contract,\narrangement or understanding.\nmerger authorisation means an authorisation that:\n\n(a) is an authorisation for a person to engage in conduct to which\nsection 50 or 50A would or might apply; but\n\n(b) is not an authorisation for a person to engage in conduct to\nwhich any provision of Part IV other than section 50 or 50A\nwould or might apply.\noverseas merger authorisation means a merger authorisation that\nis not an authorisation for a person to engage in conduct to which\nsection 50 would or might apply."
    },
