    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-4-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Subsection 93AC(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-4-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.33",
      "values:originalText": "Repeal the subsection, substitute:\nCommission’s objection notice—cartel provisions\n\n(1) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice under subsection 93AB(1A) in relation to a contract,\nor proposed contract, containing a cartel provision of the kind\nreferred to in that subsection; and\n\n(b) the Commission is satisfied that any benefit to the public that\nhas resulted or is likely to result or would result or be likely\nto result from the provision does not or would not outweigh\nthe detriment to the public that has resulted or is likely to\nresult or would result or be likely to result from the\nprovision;\nthe Commission may give the corporation a written notice (the\nobjection notice) stating that it is so satisfied.",
      "skos:definition": "Repeal the subsection, substitute:\nCommission’s objection notice—cartel provisions\n\n(1) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice under subsection 93AB(1A) in relation to a contract,\nor proposed contract, containing a cartel provision of the kind\nreferred to in that subsection; and\n\n(b) the Commission is satisfied that any benefit to the public that\nhas resulted or is likely to result or would result or be likely\nto result from the provision does not or would not outweigh\nthe detriment to the public that has resulted or is likely to\nresult or would result or be likely to result from the\nprovision;\nthe Commission may give the corporation a written notice (the\nobjection notice) stating that it is so satisfied.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-4-sec-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-4-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e98874f2828b98979fbb56b4ba81893948ba9bf5381e82b601bdec91be52b800",
      "skos:note": "Commission may give corporation an objection notice if certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-4-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Subsection 93AC(1)",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "Repeal the subsection, substitute:\nCommission’s objection notice—cartel provisions\n\n(1) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice under subsection 93AB(1A) in relation to a contract,\nor proposed contract, containing a cartel provision of the kind\nreferred to in that subsection; and\n\n(b) the Commission is satisfied that any benefit to the public that\nhas resulted or is likely to result or would result or be likely\nto result from the provision does not or would not outweigh\nthe detriment to the public that has resulted or is likely to\nresult or would result or be likely to result from the\nprovision;\nthe Commission may give the corporation a written notice (the\nobjection notice) stating that it is so satisfied."
    },
