    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Paragraphs 44ZZRO(1)(a) and (b) of Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-2-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.16",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) the cartel provision is:\n\n(i) for the purposes of a joint venture; and\n\n(ii) reasonably necessary for undertaking the joint venture;\nand\n\n(b) the joint venture is for any one or more of the following:\n\n(i) production of goods;\n\n(ii) supply of goods or services;\n\n(iii) acquisition of goods or services; and\n\n(ba) the joint venture is not carried on for the purpose of\nsubstantially lessening competition; and",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(a) the cartel provision is:\n\n(i) for the purposes of a joint venture; and\n\n(ii) reasonably necessary for undertaking the joint venture;\nand\n\n(b) the joint venture is for any one or more of the following:\n\n(i) production of goods;\n\n(ii) supply of goods or services;\n\n(iii) acquisition of goods or services; and\n\n(ba) the joint venture is not carried on for the purpose of\nsubstantially lessening competition; and",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-31-norm"
        }
      ],
      "cml:integrityHash": "a026ddcab829079e46b1970db16c7aab552fe35c98ccb4e0250fe73c0e08a691",
      "skos:note": "Repeal and substitute certain provisions related to joint ventures."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-2-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Paragraphs 44ZZRO(1)(a) and (b) of Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) the cartel provision is:\n\n(i) for the purposes of a joint venture; and\n\n(ii) reasonably necessary for undertaking the joint venture;\nand\n\n(b) the joint venture is for any one or more of the following:\n\n(i) production of goods;\n\n(ii) supply of goods or services;\n\n(iii) acquisition of goods or services; and\n\n(ba) the joint venture is not carried on for the purpose of\nsubstantially lessening competition; and"
    },
