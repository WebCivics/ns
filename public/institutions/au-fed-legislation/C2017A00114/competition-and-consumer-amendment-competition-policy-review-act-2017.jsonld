    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Subsections 90(5A) to (9)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.43",
      "values:originalText": "Repeal the subsections, substitute:\n\n(6) Before making a determination in respect of an application for an\nauthorisation, the Commission may do any one or more of the\nfollowing:\n\n(a) give any persons who appear to the Commission to be\ninterested a written notice inviting submissions in respect of\nthe application within a specified period;\n\n(b) give the applicant a written notice requesting the applicant to\ngive the Commission, within a specified period, additional\ninformation relevant to making its determination in respect of\nthe application;\n\n(c) give a person a written notice requesting the person to give\nthe Commission, within a specified period, particular\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "skos:definition": "Repeal the subsections, substitute:\n\n(6) Before making a determination in respect of an application for an\nauthorisation, the Commission may do any one or more of the\nfollowing:\n\n(a) give any persons who appear to the Commission to be\ninterested a written notice inviting submissions in respect of\nthe application within a specified period;\n\n(b) give the applicant a written notice requesting the applicant to\ngive the Commission, within a specified period, additional\ninformation relevant to making its determination in respect of\nthe application;\n\n(c) give a person a written notice requesting the person to give\nthe Commission, within a specified period, particular\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-3-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "994fc64e4cfa552d0522ecc1ee264d8a698a8268a7e684e32d169854264a2bbc",
      "skos:note": "Commission may give written notices to persons interested or applicants with specified information."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Subsections 90(5A) to (9)",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "Repeal the subsections, substitute:\n\n(6) Before making a determination in respect of an application for an\nauthorisation, the Commission may do any one or more of the\nfollowing:\n\n(a) give any persons who appear to the Commission to be\ninterested a written notice inviting submissions in respect of\nthe application within a specified period;\n\n(b) give the applicant a written notice requesting the applicant to\ngive the Commission, within a specified period, additional\ninformation relevant to making its determination in respect of\nthe application;\n\n(c) give a person a written notice requesting the person to give\nthe Commission, within a specified period, particular\n\nSchedule 9  Authorisations, notifications and class exemptions"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-3-logic-deontic-1",
