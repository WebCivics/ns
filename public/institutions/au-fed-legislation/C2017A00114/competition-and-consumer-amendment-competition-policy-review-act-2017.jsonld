    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Paragraphs 51(2)(c) and (d) of Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.31",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(c) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice obliges a\nperson to comply with or apply standards of dimension,\ndesign, quality or performance prepared or approved by\nStandards Australia or a prescribed association or body; or\n\n(d) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nbetween partners none of whom is a body corporate, to the\nextent that the provision or concerted practice relates to:\n\n(iii) the terms of the partnership; or\n\n(iv) the conduct of the partnership business; or\n\n(v) competition between the partnership and a party to the\ncontract, arrangement, understanding or concerted\npractice, while the party is, or after the party ceases to\nbe, a partner; or",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(c) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice obliges a\nperson to comply with or apply standards of dimension,\ndesign, quality or performance prepared or approved by\nStandards Australia or a prescribed association or body; or\n\n(d) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nbetween partners none of whom is a body corporate, to the\nextent that the provision or concerted practice relates to:\n\n(iii) the terms of the partnership; or\n\n(iv) the conduct of the partnership business; or\n\n(v) competition between the partnership and a party to the\ncontract, arrangement, understanding or concerted\npractice, while the party is, or after the party ceases to\nbe, a partner; or",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-34-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-34-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-34-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "371d3323fc5a7863b1fd970f5fc763832c7595393ffd3b77e5538fa9a833724c",
      "skos:note": "Repeal paragraphs and substitute with new provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Paragraphs 51(2)(c) and (d) of Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(c) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice obliges a\nperson to comply with or apply standards of dimension,\ndesign, quality or performance prepared or approved by\nStandards Australia or a prescribed association or body; or\n\n(d) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nbetween partners none of whom is a body corporate, to the\nextent that the provision or concerted practice relates to:\n\n(iii) the terms of the partnership; or\n\n(iv) the conduct of the partnership business; or\n\n(v) competition between the partnership and a party to the\ncontract, arrangement, understanding or concerted\npractice, while the party is, or after the party ceases to\nbe, a partner; or"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-34-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-34"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-34-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the provision or concerted practice.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "any provision of a contract, arrangement or understanding; or any concerted practice;"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-34-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits competition between the partnership and a party.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "competition between the partnership and a party to the contract, arrangement, understanding or concerted practice, while the party is, or after the party ceases to be, a partner;"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-35",
      "@type": "cml:Concept",
      "skos:prefLabel": "35 Paragraph 51(2)(g) of Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-35"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.31",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(g) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice relates\nexclusively to:\n\n(iii) the export of goods from Australia; or\n\n(iv) the supply of services outside Australia;\n\nif full and accurate particulars of the provision or concerted\npractice were given to the Commission no more than 14 days\nafter the day the contract or arrangement was made or the\n\nSchedule 3  Price signalling and concerted practices",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(g) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice relates\nexclusively to:\n\n(iii) the export of goods from Australia; or\n\n(iv) the supply of services outside Australia;\n\nif full and accurate particulars of the provision or concerted\npractice were given to the Commission no more than 14 days\nafter the day the contract or arrangement was made or the\n\nSchedule 3  Price signalling and concerted practices",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-35-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-35-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a22dbdbf6b4f47c06ad201d7c7d51b1bc3214c7094894f04e1860f0888f9bbb0",
      "skos:note": "Repeal paragraph and substitute with new provision related to export of goods from Australia or supply of services outside Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-35",
      "@type": "cof:Section",
      "cof:title": "35 Paragraph 51(2)(g) of Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(g) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice relates\nexclusively to:\n\n(iii) the export of goods from Australia; or\n\n(iv) the supply of services outside Australia;\n\nif full and accurate particulars of the provision or concerted\npractice were given to the Commission no more than 14 days\nafter the day the contract or arrangement was made or the\n\nSchedule 3  Price signalling and concerted practices"
    },
