    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-82",
      "@type": "cml:Concept",
      "skos:prefLabel": "82 After subsection 90(10A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-82"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.63",
      "values:originalText": "Insert:\n\n(10B) Subject to subsections (12) and (13), if:\n\n(a) the Commission does not determine an application for a\nmerger authorisation within the 90-day period beginning on\nthe day the Commission received the application; and\n\n(b) the application is not an application for an overseas merger\nauthorisation;\nthe Commission is taken to have refused, at the end of that period,\nto grant the authorisation applied for.",
      "skos:definition": "Insert:\n\n(10B) Subject to subsections (12) and (13), if:\n\n(a) the Commission does not determine an application for a\nmerger authorisation within the 90-day period beginning on\nthe day the Commission received the application; and\n\n(b) the application is not an application for an overseas merger\nauthorisation;\nthe Commission is taken to have refused, at the end of that period,\nto grant the authorisation applied for.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-82-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-82-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4a10073bb8a198e1cf9e8022606ff0102f3f353741eb183fc97075e481b40649",
      "skos:note": "Commission's failure to determine an application for a merger authorisation within the specified period is taken as refusal to grant the authorisation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-82",
      "@type": "cof:Section",
      "cof:title": "82 After subsection 90(10A)",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "Insert:\n\n(10B) Subject to subsections (12) and (13), if:\n\n(a) the Commission does not determine an application for a\nmerger authorisation within the 90-day period beginning on\nthe day the Commission received the application; and\n\n(b) the application is not an application for an overseas merger\nauthorisation;\nthe Commission is taken to have refused, at the end of that period,\nto grant the authorisation applied for."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-82-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
