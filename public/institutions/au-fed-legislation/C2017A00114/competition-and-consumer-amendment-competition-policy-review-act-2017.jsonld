    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 At the end of section 48",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-8-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.38",
      "values:originalText": "Add:\n\n(2) Subsection (1) does not apply to a corporation or other person\nengaging in conduct that constitutes the practice of resale price\nmaintenance if:\n\n(a) the corporation or other person has given the Commission a\nnotice under subsection 93(1) describing the conduct; and\n\n(b) the notice is in force under section 93.",
      "skos:definition": "Add:\n\n(2) Subsection (1) does not apply to a corporation or other person\nengaging in conduct that constitutes the practice of resale price\nmaintenance if:\n\n(a) the corporation or other person has given the Commission a\nnotice under subsection 93(1) describing the conduct; and\n\n(b) the notice is in force under section 93.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bfa3c12f304d743a95b567586fad78b8ce285ac3192fd350c3f8c741148012b3",
      "skos:note": "Exempts corporations from resale price maintenance if notice is given to Commission."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-8-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 At the end of section 48",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Add:\n\n(2) Subsection (1) does not apply to a corporation or other person\nengaging in conduct that constitutes the practice of resale price\nmaintenance if:\n\n(a) the corporation or other person has given the Commission a\nnotice under subsection 93(1) describing the conduct; and\n\n(b) the notice is in force under section 93."
    },
