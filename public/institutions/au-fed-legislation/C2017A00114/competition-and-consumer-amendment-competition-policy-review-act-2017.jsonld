      "cof:title": "100 At the end of Division 1 of Part VII",
      "values:kind": "section",
      "cof:pageNumber": 68,
      "values:originalText": "Add:"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-100-norm",
      "@type": "values:Undertaking",
