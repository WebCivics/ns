      "@type": "cml:Concept",
      "skos:prefLabel": "5 Subsections 45(7) and (8)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-5"
