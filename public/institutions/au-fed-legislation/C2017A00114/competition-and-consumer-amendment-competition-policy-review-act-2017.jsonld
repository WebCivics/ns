    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 After subsection 51(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
