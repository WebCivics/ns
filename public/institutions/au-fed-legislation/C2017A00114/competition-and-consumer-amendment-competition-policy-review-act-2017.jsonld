    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 After subsection 51(2) of Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-36"
