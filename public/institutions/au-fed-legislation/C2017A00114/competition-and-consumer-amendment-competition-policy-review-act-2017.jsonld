      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.49",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) at the end of:\n\n(i) if subparagraph (ii) does not apply—the period of 3\nyears beginning on the day the corporation gave the\ncollective bargaining notice; or\n\n(ii) the period determined under subsection (5).",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(c) at the end of:\n\n(i) if subparagraph (ii) does not apply—the period of 3\nyears beginning on the day the corporation gave the\ncollective bargaining notice; or\n\n(ii) the period determined under subsection (5).",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-18-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fc78439cf9bf4b6dc318373588ebdc0df5300fbcd4aaa6cb7f6a98c6813e221e",
      "skos:note": "Repeal paragraph and substitute with new provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Paragraph 93AD(3)(c)",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) at the end of:\n\n(i) if subparagraph (ii) does not apply—the period of 3\nyears beginning on the day the corporation gave the\ncollective bargaining notice; or\n\n(ii) the period determined under subsection (5)."
    },
