    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-13-sec-180",
      "@type": "cml:Concept",
      "skos:prefLabel": "180 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-13-sec-180"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.98",
      "values:originalText": "In this Division:\namended Act means this Act as amended by the amending Act.\namending Act means the Competition and Consumer Amendment\n(Competition Policy Review) Act 2017.\ncommencement time means the commencement of Schedule 1 to\nthe amending Act.",
      "skos:definition": "In this Division:\namended Act means this Act as amended by the amending Act.\namending Act means the Competition and Consumer Amendment\n(Competition Policy Review) Act 2017.\ncommencement time means the commencement of Schedule 1 to\nthe amending Act.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-13-sec-180-norm"
        }
      ],
      "cml:integrityHash": "8609312a9b38db9acec2a449a0666046339e631e7de99676d44b56479e7bdf8d",
      "skos:note": "Definitions for amended Act and amending Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-13-sec-180",
      "@type": "cof:Section",
      "cof:title": "180 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "In this Division:\namended Act means this Act as amended by the amending Act.\namending Act means the Competition and Consumer Amendment\n(Competition Policy Review) Act 2017.\ncommencement time means the commencement of Schedule 1 to\nthe amending Act."
    },
