    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Paragraphs 51(2)(c) and (d)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.28",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(c) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice obliges a\nperson to comply with or apply standards of dimension,\ndesign, quality or performance prepared or approved by\nStandards Australia or a prescribed association or body; or\n\n(d) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nbetween partners none of whom is a body corporate, to the\nextent that the provision or concerted practice relates to:\n\n(iii) the terms of the partnership; or\n\n(iv) the conduct of the partnership business; or\n\n(v) competition between the partnership and a party to the\ncontract, arrangement, understanding or concerted\npractice, while the party is, or after the party ceases to\nbe, a partner; or",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(c) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice obliges a\nperson to comply with or apply standards of dimension,\ndesign, quality or performance prepared or approved by\nStandards Australia or a prescribed association or body; or\n\n(d) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nbetween partners none of whom is a body corporate, to the\nextent that the provision or concerted practice relates to:\n\n(iii) the terms of the partnership; or\n\n(iv) the conduct of the partnership business; or\n\n(v) competition between the partnership and a party to the\ncontract, arrangement, understanding or concerted\npractice, while the party is, or after the party ceases to\nbe, a partner; or",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-18-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "371d3323fc5a7863b1fd970f5fc763832c7595393ffd3b77e5538fa9a833724c",
      "skos:note": "Repeal certain provisions of contracts and concerted practices."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Paragraphs 51(2)(c) and (d)",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(c) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nto the extent that the provision or concerted practice obliges a\nperson to comply with or apply standards of dimension,\ndesign, quality or performance prepared or approved by\nStandards Australia or a prescribed association or body; or\n\n(d) to:\n\n(i) any provision of a contract, arrangement or\nunderstanding; or\n\n(ii) any concerted practice;\n\nbetween partners none of whom is a body corporate, to the\nextent that the provision or concerted practice relates to:\n\n(iii) the terms of the partnership; or\n\n(iv) the conduct of the partnership business; or\n\n(v) competition between the partnership and a party to the\ncontract, arrangement, understanding or concerted\npractice, while the party is, or after the party ceases to\nbe, a partner; or"
    },
