    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Subsection 44ZZRD(4) of Schedule 1 (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-2-sec-27"
      },
      "cml:curationStatus": {
