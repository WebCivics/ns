    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Subsection 93AD(3) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.49",
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nA collective bargaining notice is not in force, to the extent that it\nrelates to collective boycott conduct, while a stop notice is in force in\nrelation to the collective bargaining notice: see section 93AG.\nNote 2:\nSection 93AE deals with the withdrawal of a collective bargaining\nnotice.",
      "skos:definition": "Repeal the note, substitute:\nNote 1:\nA collective bargaining notice is not in force, to the extent that it\nrelates to collective boycott conduct, while a stop notice is in force in\nrelation to the collective bargaining notice: see section 93AG.\nNote 2:\nSection 93AE deals with the withdrawal of a collective bargaining\nnotice.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-19-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "44aacd51fedf16354c7cd1f80124c88ab95ae3c77575ae3e01d681cfac474be2",
      "skos:note": "Prohibits collective boycott conduct while a stop notice is in force."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Subsection 93AD(3) (note)",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nA collective bargaining notice is not in force, to the extent that it\nrelates to collective boycott conduct, while a stop notice is in force in\nrelation to the collective bargaining notice: see section 93AG.\nNote 2:\nSection 93AE deals with the withdrawal of a collective bargaining\nnotice."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-19-norm",
      "@type": "values:Prohibition",
