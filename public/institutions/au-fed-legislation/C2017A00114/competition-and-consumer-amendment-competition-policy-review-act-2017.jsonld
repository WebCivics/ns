    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-92-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "92(5) Subsections 91A(3) to (5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-92-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.64",
      "values:originalText": "(5) Subsections 90(10B), (12) and (13) apply in relation to an\napplication for a minor variation of a merger authorisation that is\nnot an overseas merger authorisation in a corresponding way to the\nway those subsections apply in relation to an application for a\nmerger authorisation that is not an overseas merger authorisation.\nNote:\nThose subsections deem the Commissioner to have refused to grant\nthe application if the Commission does not determine the application\nwithin 90 days (or an extended period in some cases).",
      "skos:definition": "(5) Subsections 90(10B), (12) and (13) apply in relation to an\napplication for a minor variation of a merger authorisation that is\nnot an overseas merger authorisation in a corresponding way to the\nway those subsections apply in relation to an application for a\nmerger authorisation that is not an overseas merger authorisation.\nNote:\nThose subsections deem the Commissioner to have refused to grant\nthe application if the Commission does not determine the application\nwithin 90 days (or an extended period in some cases).",
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-92"
      },
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-92-ss-5-norm"
        }
      ],
      "cml:integrityHash": "ddf208a4766595cab0298823536caf779abcf0a43c3f1bc62268839df172de15",
      "skos:note": "Subsections 90(10B), (12) and (13) apply in relation to an application for a minor variation of a merger authorisation that is not an overseas merger authorisation."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-92-ss-5",
      "@type": "cof:Section",
      "cof:title": "92(5) Subsections 91A(3) to (5)",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(5) Subsections 90(10B), (12) and (13) apply in relation to an\napplication for a minor variation of a merger authorisation that is\nnot an overseas merger authorisation in a corresponding way to the\nway those subsections apply in relation to an application for a\nmerger authorisation that is not an overseas merger authorisation.\nNote:\nThose subsections deem the Commissioner to have refused to grant\nthe application if the Commission does not determine the application\nwithin 90 days (or an extended period in some cases)."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-92-ss-5-norm",
      "@type": "values:Obligation",
