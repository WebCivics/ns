      "cml:premiseText": "(e) there is a decision of the designated Minister in force under section 44LG that the service is ineligible to be a declared service",
      "cml:conclusionText": "the service is not eligible for declaration"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-5-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(1A) Subsection 44F(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-5-ss-1a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
