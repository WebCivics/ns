      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.13",
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nParty has an extended meaning—see section 44ZZRC.\nNote 2:\nTrade or commerce is defined in section 4 to mean trade or commerce\nwithin Australia or between Australia and places outside Australia.",
      "skos:definition": "Repeal the note, substitute:\nNote 1:\nParty has an extended meaning—see section 44ZZRC.\nNote 2:\nTrade or commerce is defined in section 4 to mean trade or commerce\nwithin Australia or between Australia and places outside Australia.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-8-norm"
        }
      ],
      "cml:integrityHash": "11ebb0833d8d61d715613caa7fb605e09eaef818c6c86dd93399c2a7b3af245f",
      "skos:note": "Repeal a note and substitute with new definitions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-2-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Subsection 44ZZRD(4) (note)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nParty has an extended meaning—see section 44ZZRC.\nNote 2:\nTrade or commerce is defined in section 4 to mean trade or commerce\nwithin Australia or between Australia and places outside Australia."
    },
