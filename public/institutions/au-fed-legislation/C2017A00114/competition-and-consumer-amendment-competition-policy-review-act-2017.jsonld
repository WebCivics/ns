    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Subsection 93(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-8-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.38",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) Subject to subsection (2):\n\n(a) a corporation that engages, or proposes to engage, in conduct\nof a kind referred to in subsection 47(2), (3), (4), (5), (6), (7),\n(8) or (9); or\n\n(b) a corporation or other person who engages, or proposes to\nengage, in conduct of a kind referred to in section 48;\n\nResale price maintenance  Schedule 8\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nmay give to the Commission a notice setting out particulars of the\nconduct or proposed conduct.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) Subject to subsection (2):\n\n(a) a corporation that engages, or proposes to engage, in conduct\nof a kind referred to in subsection 47(2), (3), (4), (5), (6), (7),\n(8) or (9); or\n\n(b) a corporation or other person who engages, or proposes to\nengage, in conduct of a kind referred to in section 48;\n\nResale price maintenance  Schedule 8\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nmay give to the Commission a notice setting out particulars of the\nconduct or proposed conduct.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-5-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-5-ss-8"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-8-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Subsection 93(1)",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) Subject to subsection (2):\n\n(a) a corporation that engages, or proposes to engage, in conduct\nof a kind referred to in subsection 47(2), (3), (4), (5), (6), (7),\n(8) or (9); or\n\n(b) a corporation or other person who engages, or proposes to\nengage, in conduct of a kind referred to in section 48;\n\nResale price maintenance  Schedule 8\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nmay give to the Commission a notice setting out particulars of the\nconduct or proposed conduct."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-5-ss-1",
