      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.35",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) a provision of a contract made, whether before or after the\ncommencement of the Trade Practices Amendment Act 1977,\nis unenforceable because of section 45 in so far as it confers\nrights or benefits or imposes duties or obligations on a\ncorporation; or",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) a provision of a contract made, whether before or after the\ncommencement of the Trade Practices Amendment Act 1977,\nis unenforceable because of section 45 in so far as it confers\nrights or benefits or imposes duties or obligations on a\ncorporation; or",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-5-sec-12-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-5-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e216be3e96ca7e82a85fdea14d649b00376d5c66ce2a6ade317f7491684a0272",
      "skos:note": "Repeal paragraph and substitute with a provision that does not confer rights or impose duties on corporations."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-5-sec-12",
      "@type": "cof:Section",
