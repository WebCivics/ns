    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 After subsection 93AC(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-15"
      },
