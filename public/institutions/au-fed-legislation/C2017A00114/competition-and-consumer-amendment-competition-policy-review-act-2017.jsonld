    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 At the end of section 44FA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.87",
      "values:originalText": "Add:\n\n(4) Subsections 44GB(4) to (6) apply to information given in response\nto a notice under this section (whether given in compliance with\nthe notice or not) in a corresponding way to the way those\nsubsections apply to a submission made in response to a notice\nunder subsection 44GB(1).\nNote:\nThis allows the Council to make the information publicly available,\nsubject to any confidentiality concerns.",
      "skos:definition": "Add:\n\n(4) Subsections 44GB(4) to (6) apply to information given in response\nto a notice under this section (whether given in compliance with\nthe notice or not) in a corresponding way to the way those\nsubsections apply to a submission made in response to a notice\nunder subsection 44GB(1).\nNote:\nThis allows the Council to make the information publicly available,\nsubject to any confidentiality concerns.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-9-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cb506a2f4cfe0b6f8c7bb70b6b80c7c2ae0b2b7bbc743e92d157f290a4d12fcb",
      "skos:note": "Information given in response to a notice under this section must be made publicly available, subject to any confidentiality concerns."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 At the end of section 44FA",
      "values:kind": "section",
      "cof:pageNumber": 87,
      "values:originalText": "Add:\n\n(4) Subsections 44GB(4) to (6) apply to information given in response\nto a notice under this section (whether given in compliance with\nthe notice or not) in a corresponding way to the way those\nsubsections apply to a submission made in response to a notice\nunder subsection 44GB(1).\nNote:\nThis allows the Council to make the information publicly available,\nsubject to any confidentiality concerns."
    },
