      "skos:prefLabel": "185(7) Merger clearances and authorisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-13-sec-185-ss-7"
      },
