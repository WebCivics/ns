    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-13-sec-185-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "185(6) Merger clearances and authorisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-13-sec-185-ss-6"
      },
