        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-118-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9990237ca65ee0f7e9819887ea56956e6ccc6772822eb0eb378e879f1c204dc0",
      "skos:note": "Review by Tribunal is a re-hearing unless specific conditions apply."
    },
    {
