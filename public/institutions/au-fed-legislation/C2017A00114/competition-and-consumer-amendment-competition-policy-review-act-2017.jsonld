    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sec-2-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sec-2-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.8",
      "values:originalText": "The provisions do not commence at all\nunless the Competition and Consumer\nAmendment (Misuse of Market Power) Act\n2017 receives the Royal Assent.\nIf that Act receives the Royal Assent, the\nprovisions commence on:\n(a) a single day to be fixed by Proclamation;\nor\n(b) if no earlier day is fixed under\nparagraph (a), the day after the end of the\nperiod of 6 months beginning on the later\nof:\n(i) the day this Act receives the Royal\nAssent; and\n(ii) the day the Competition and\nConsumer Amendment (Misuse of\nMarket Power) Act 2017 receives\nthe Royal Assent.",
      "skos:definition": "The provisions do not commence at all\nunless the Competition and Consumer\nAmendment (Misuse of Market Power) Act\n2017 receives the Royal Assent.\nIf that Act receives the Royal Assent, the\nprovisions commence on:\n(a) a single day to be fixed by Proclamation;\nor\n(b) if no earlier day is fixed under\nparagraph (a), the day after the end of the\nperiod of 6 months beginning on the later\nof:\n(i) the day this Act receives the Royal\nAssent; and\n(ii) the day the Competition and\nConsumer Amendment (Misuse of\nMarket Power) Act 2017 receives\nthe Royal Assent.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sec-2-2-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sec-2-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "d046630e44af0950c1c9deb26339182fa031b9638301a049430d1dba94a096a0",
      "skos:note": "Commencement of provisions depends on Royal Assent and Proclamation"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "The provisions do not commence at all\nunless the Competition and Consumer\nAmendment (Misuse of Market Power) Act\n2017 receives the Royal Assent.\nIf that Act receives the Royal Assent, the\nprovisions commence on:\n(a) a single day to be fixed by Proclamation;\nor\n(b) if no earlier day is fixed under\nparagraph (a), the day after the end of the\nperiod of 6 months beginning on the later\nof:\n(i) the day this Act receives the Royal\nAssent; and\n(ii) the day the Competition and\nConsumer Amendment (Misuse of\nMarket Power) Act 2017 receives\nthe Royal Assent."
    },
