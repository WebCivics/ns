    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Subsection 93(7A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-8-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.39",
      "values:originalText": "Repeal the subsection, substitute:\n\n(7A) A notice under subsection (1) describing conduct or proposed\nconduct referred to in section 48 comes into force:\n\n(a) at the end of the period of 60 days, or such other period as is\nprescribed by the regulations, starting on the day when the\ncorporation or other person gave the Commission the notice;\nor\n\n(b) if the Commission gives notice to the corporation or other\nperson under subsection 93A(2) during that period—when\n\nSchedule 8  Resale price maintenance\n\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\nNo. 114, 2017\n\nthe Commission decides not to give the corporation or other\nperson a notice under subsection (3A) of this section.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(7A) A notice under subsection (1) describing conduct or proposed\nconduct referred to in section 48 comes into force:\n\n(a) at the end of the period of 60 days, or such other period as is\nprescribed by the regulations, starting on the day when the\ncorporation or other person gave the Commission the notice;\nor\n\n(b) if the Commission gives notice to the corporation or other\nperson under subsection 93A(2) during that period—when\n\nSchedule 8  Resale price maintenance\n\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\nNo. 114, 2017\n\nthe Commission decides not to give the corporation or other\nperson a notice under subsection (3A) of this section.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-8-sec-13-norm"
        }
      ],
      "cml:integrityHash": "e4ae233549eb611e29b3ebb20144190ff1b53568599e0e6f166cbfbf5dccf6b3",
      "skos:note": "Conditional commencement of notice under subsection (1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-8-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Subsection 93(7A)",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "Repeal the subsection, substitute:\n\n(7A) A notice under subsection (1) describing conduct or proposed\nconduct referred to in section 48 comes into force:\n\n(a) at the end of the period of 60 days, or such other period as is\nprescribed by the regulations, starting on the day when the\ncorporation or other person gave the Commission the notice;\nor\n\n(b) if the Commission gives notice to the corporation or other\nperson under subsection 93A(2) during that period—when\n\nSchedule 8  Resale price maintenance\n\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\nNo. 114, 2017\n\nthe Commission decides not to give the corporation or other\nperson a notice under subsection (3A) of this section."
    },
