    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Paragraph 51(2)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.27",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) to any act done, or concerted practice, to the extent that it\nrelates to the remuneration, conditions of employment, hours\nof work or working conditions of employees; or\n\n(aa) to:\n\n(i) the making of a contract or arrangement, or the entering\ninto of an understanding; or\n\n(ii) any provision of a contract, arrangement or\nunderstanding;\n\nto the extent that the contract, arrangement, understanding or\nprovision relates to the remuneration, conditions of\nemployment, hours of work or working conditions of\nemployees; or\n\nSchedule 3  Price signalling and concerted practices",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) to any act done, or concerted practice, to the extent that it\nrelates to the remuneration, conditions of employment, hours\nof work or working conditions of employees; or\n\n(aa) to:\n\n(i) the making of a contract or arrangement, or the entering\ninto of an understanding; or\n\n(ii) any provision of a contract, arrangement or\nunderstanding;\n\nto the extent that the contract, arrangement, understanding or\nprovision relates to the remuneration, conditions of\nemployment, hours of work or working conditions of\nemployees; or\n\nSchedule 3  Price signalling and concerted practices",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-16-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-3-sec-16-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f662e228c15d8b0ef8590974d55a61f57fc8f95d4c46dff6b7e895eb133507d8",
      "skos:note": "Repeal certain acts and practices related to employee remuneration and working conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-3-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Paragraph 51(2)(a)",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) to any act done, or concerted practice, to the extent that it\nrelates to the remuneration, conditions of employment, hours\nof work or working conditions of employees; or\n\n(aa) to:\n\n(i) the making of a contract or arrangement, or the entering\ninto of an understanding; or\n\n(ii) any provision of a contract, arrangement or\nunderstanding;\n\nto the extent that the contract, arrangement, understanding or\nprovision relates to the remuneration, conditions of\nemployment, hours of work or working conditions of\nemployees; or\n\nSchedule 3  Price signalling and concerted practices"
    },
