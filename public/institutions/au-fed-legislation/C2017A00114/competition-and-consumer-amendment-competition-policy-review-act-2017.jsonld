    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Subparagraphs 179(1)(b)(i) and (ii) of Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-14-sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.111",
      "values:originalText": "Repeal the subparagraphs, substitute:\n\n(i) if the agreement was not negotiated by telephone—the\nperiod starting on the day on which the agreement was\nmade and ending at the end of the tenth business day\nafter the day on which the agreement was made; or\n\n(ii) if the agreement was negotiated by telephone—the\nperiod starting on the day on which the agreement was\nmade and ending at the end of the tenth business day\n\nSchedule 14  Other amendments",
      "skos:definition": "Repeal the subparagraphs, substitute:\n\n(i) if the agreement was not negotiated by telephone—the\nperiod starting on the day on which the agreement was\nmade and ending at the end of the tenth business day\nafter the day on which the agreement was made; or\n\n(ii) if the agreement was negotiated by telephone—the\nperiod starting on the day on which the agreement was\nmade and ending at the end of the tenth business day\n\nSchedule 14  Other amendments",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-22-norm"
        }
      ],
      "cml:integrityHash": "ce3c97b440e43dc8cf219862ecd986b60c025f84d46d6eafd46d4cb90e29d3b0",
      "skos:note": "Substitute time period for agreement made"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-14-sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Subparagraphs 179(1)(b)(i) and (ii) of Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 111,
      "values:originalText": "Repeal the subparagraphs, substitute:\n\n(i) if the agreement was not negotiated by telephone—the\nperiod starting on the day on which the agreement was\nmade and ending at the end of the tenth business day\nafter the day on which the agreement was made; or\n\n(ii) if the agreement was negotiated by telephone—the\nperiod starting on the day on which the agreement was\nmade and ending at the end of the tenth business day\n\nSchedule 14  Other amendments"
    },
