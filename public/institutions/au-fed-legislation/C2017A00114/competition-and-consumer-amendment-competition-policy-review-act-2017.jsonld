      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.14",
      "values:originalText": "Add:\n\nCartels  Schedule 2\nAmendments  Part 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(iv) the acquisition, or likely acquisition, of goods or\nservices from persons or classes of persons by any or all\nof the parties to the contract, arrangement or\nunderstanding; or",
      "skos:definition": "Add:\n\nCartels  Schedule 2\nAmendments  Part 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(iv) the acquisition, or likely acquisition, of goods or\nservices from persons or classes of persons by any or all\nof the parties to the contract, arrangement or\nunderstanding; or",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-21-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-21-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e362c0b98b6681b82aecb60b852864efddd83f271980b3ca0d4b870967bb7585",
      "skos:note": "Prohibition on acquiring goods or services from certain persons"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-2-sec-21",
      "@type": "cof:Section",
      "cof:title": "21 At the end of paragraph 44ZZRD(3)(a) of Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Add:\n\nCartels  Schedule 2\nAmendments  Part 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(iv) the acquisition, or likely acquisition, of goods or\nservices from persons or classes of persons by any or all\nof the parties to the contract, arrangement or\nunderstanding; or"
    },
