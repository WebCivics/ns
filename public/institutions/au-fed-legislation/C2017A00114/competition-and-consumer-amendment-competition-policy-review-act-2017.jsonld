        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of application after decision made",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Decision under section 44NBC has been made",
      "cml:conclusionText": "No one may apply for a recommendation under section 44NBA(3)"
    },
    {
