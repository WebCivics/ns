    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 After subsection 93AB(7)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.47",
      "values:originalText": "Insert:\n\n(7A) A collective bargaining notice for a group of contracting parties\nmay be expressed to be given on behalf of persons who become\nmembers of the group after the notice is given, but only if those\npersons could have given the notice on their own behalf at the time\nthey became members of the group. If the notice is so expressed,\nthen it is also taken to have been given by those persons.",
      "skos:definition": "Insert:\n\n(7A) A collective bargaining notice for a group of contracting parties\nmay be expressed to be given on behalf of persons who become\nmembers of the group after the notice is given, but only if those\npersons could have given the notice on their own behalf at the time\nthey became members of the group. If the notice is so expressed,\nthen it is also taken to have been given by those persons.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-14-norm"
        }
      ],
      "cml:integrityHash": "1bc7076c93b01921992b062f111311b2185aefda2a62ae14e66551a8b76cf111",
      "skos:note": "A collective bargaining notice may be expressed to be given on behalf of persons who become members of the group after the notice is given."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 After subsection 93AB(7)",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "Insert:\n\n(7A) A collective bargaining notice for a group of contracting parties\nmay be expressed to be given on behalf of persons who become\nmembers of the group after the notice is given, but only if those\npersons could have given the notice on their own behalf at the time\nthey became members of the group. If the notice is so expressed,\nthen it is also taken to have been given by those persons."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-14-norm",
