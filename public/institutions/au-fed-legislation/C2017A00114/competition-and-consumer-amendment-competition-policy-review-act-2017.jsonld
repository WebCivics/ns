    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 At the end of section 132A of Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-14-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.107",
      "values:originalText": "Add:\n\n(3) This section also does not apply if the disclosure is made by a\nmember of the staff of the regulator, or an associate regulator, in\nthe performance of his or her duties as such a member of staff, and\nis made because it is reasonably necessary to protect public safety,\nto:\n\n(a) any other agency within the meaning of the Freedom of\nInformation Act 1982; or\n\n(b) the Director of Public Prosecutions; or\n\n(c) a State/Territory government body (within the meaning of\nsection 155AAA of the Competition and Consumer Act); or\n\n(d) a foreign government body (within the meaning of the\nCompetition and Consumer Act).\n\nSchedule 14  Other amendments",
      "skos:definition": "Add:\n\n(3) This section also does not apply if the disclosure is made by a\nmember of the staff of the regulator, or an associate regulator, in\nthe performance of his or her duties as such a member of staff, and\nis made because it is reasonably necessary to protect public safety,\nto:\n\n(a) any other agency within the meaning of the Freedom of\nInformation Act 1982; or\n\n(b) the Director of Public Prosecutions; or\n\n(c) a State/Territory government body (within the meaning of\nsection 155AAA of the Competition and Consumer Act); or\n\n(d) a foreign government body (within the meaning of the\nCompetition and Consumer Act).\n\nSchedule 14  Other amendments",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-11-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6fa82d1e476ced93ba0b04293e335e80724726433f0f91c4979da86126cb4ba6",
      "skos:note": "Disclosure is not required for certain agencies or bodies."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-14-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 At the end of section 132A of Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 107,
      "values:originalText": "Add:\n\n(3) This section also does not apply if the disclosure is made by a\nmember of the staff of the regulator, or an associate regulator, in\nthe performance of his or her duties as such a member of staff, and\nis made because it is reasonably necessary to protect public safety,\nto:\n\n(a) any other agency within the meaning of the Freedom of\nInformation Act 1982; or\n\n(b) the Director of Public Prosecutions; or\n\n(c) a State/Territory government body (within the meaning of\nsection 155AAA of the Competition and Consumer Act); or\n\n(d) a foreign government body (within the meaning of the\nCompetition and Consumer Act).\n\nSchedule 14  Other amendments"
    },
