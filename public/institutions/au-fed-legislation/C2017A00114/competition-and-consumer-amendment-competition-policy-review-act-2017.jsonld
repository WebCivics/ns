    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93ag-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "93AG(6) Stop notice for collective boycott conduct",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-93ag-ss-6"
