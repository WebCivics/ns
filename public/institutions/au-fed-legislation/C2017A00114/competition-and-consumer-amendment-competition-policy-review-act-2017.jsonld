    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-71a",
      "@type": "cml:Concept",
      "skos:prefLabel": "71A Issue of spectrum licence taken to be an acquisition of an asset",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-71a"
      },
      "cml:curationStatus": {
