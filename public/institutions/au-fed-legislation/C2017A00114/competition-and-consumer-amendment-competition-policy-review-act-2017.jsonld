    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 After subsection 44V(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-38"
      },
