    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-20-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "20(2) After Subdivision C of Division 2A of Part IIIA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-20-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
