      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 4(1) (definition of competition)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.11",
      "values:originalText": "Repeal the definition, substitute:\ncompetition includes:\n\n(a) competition from goods that are, or are capable of being,\nimported into Australia; and\n\n(b) competition from services that are rendered, or are capable of\nbeing rendered, in Australia by persons not resident or not\ncarrying on business in Australia.\n\nSchedule 2  Cartels",
      "skos:definition": "Repeal the definition, substitute:\ncompetition includes:\n\n(a) competition from goods that are, or are capable of being,\nimported into Australia; and\n\n(b) competition from services that are rendered, or are capable of\nbeing rendered, in Australia by persons not resident or not\ncarrying on business in Australia.\n\nSchedule 2  Cartels",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-1-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-1-sec-1-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "d51db3efcfcb1962e1621dfe06dd7b27d63028888a6e6868b5c0872cc1b9c53d",
      "skos:note": "Definition of competition includes goods and services from non-resident persons."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 4(1) (definition of competition)",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Repeal the definition, substitute:\ncompetition includes:\n\n(a) competition from goods that are, or are capable of being,\nimported into Australia; and\n\n(b) competition from services that are rendered, or are capable of\nbeing rendered, in Australia by persons not resident or not\ncarrying on business in Australia.\n\nSchedule 2  Cartels"
    },
