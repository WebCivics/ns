      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.47",
      "values:originalText": "Insert:\nCommission’s objection notice—non-compliance with conditions\n\n(2A) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice that relates (wholly or partly) to collective boycott\nconduct or proposed collective boycott conduct; and\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "skos:definition": "Insert:\nCommission’s objection notice—non-compliance with conditions\n\n(2A) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice that relates (wholly or partly) to collective boycott\nconduct or proposed collective boycott conduct; and\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-15-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8291cfc8e853be7c68a34ae281ea4852c84cc77bfad81920e91009d068984970",
      "skos:note": "Corporation must provide notice if giving collective bargaining notice related to collective boycott conduct.",
      "dc:description": "Notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 After subsection 93AC(2)",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "Insert:\nCommission’s objection notice—non-compliance with conditions\n\n(2A) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice that relates (wholly or partly) to collective boycott\nconduct or proposed collective boycott conduct; and\n\nSchedule 9  Authorisations, notifications and class exemptions"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-15-norm",
      "@type": "values:Obligation",
