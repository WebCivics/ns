      "@type": "cml:Concept",
      "skos:prefLabel": "68A Authorisation under spectrum licence taken to be an",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-68a"
      },
      "cml:curationStatus": {
