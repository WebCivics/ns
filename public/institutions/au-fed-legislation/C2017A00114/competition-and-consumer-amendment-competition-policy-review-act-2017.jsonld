    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 References in other Acts, instruments or documents to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-2-sec-40"
      },
