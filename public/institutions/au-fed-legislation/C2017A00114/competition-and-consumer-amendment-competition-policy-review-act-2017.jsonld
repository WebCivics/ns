    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-14-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.108",
      "values:originalText": "The amendment made by this Part applies in relation to contraventions\nthat occur on or after the commencement of this item.\n\nOther amendments  Schedule 14\nUnsolicited consumer agreements  Part 6\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017",
      "skos:definition": "The amendment made by this Part applies in relation to contraventions\nthat occur on or after the commencement of this item.\n\nOther amendments  Schedule 14\nUnsolicited consumer agreements  Part 6\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-13-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-14-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ae2eb7899be490afd4f0a1ae4b8cf2827c9c3b3744051ab01aed3ab44932cd0c",
      "skos:note": "Amendment applies to contraventions occurring on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-14-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "The amendment made by this Part applies in relation to contraventions\nthat occur on or after the commencement of this item.\n\nOther amendments  Schedule 14\nUnsolicited consumer agreements  Part 6\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017"
    },
    {
