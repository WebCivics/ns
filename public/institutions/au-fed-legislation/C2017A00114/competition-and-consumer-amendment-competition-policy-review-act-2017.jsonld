      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Subsection 90(9A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.45",
      "values:originalText": "Omit “In determining what amounts to a benefit to the public for the\npurposes of subsections (8A), (8B) and (9)”, substitute “In relation to\nthe Commission’s consideration of an application for an authorisation to\nengage in conduct to which section 49 would or might apply or for a\nmerger authorisation, in determining what amounts to a benefit to the\npublic for the purposes of paragraph (7)(b)”.",
      "skos:definition": "Omit “In determining what amounts to a benefit to the public for the\npurposes of subsections (8A), (8B) and (9)”, substitute “In relation to\nthe Commission’s consideration of an application for an authorisation to\nengage in conduct to which section 49 would or might apply or for a\nmerger authorisation, in determining what amounts to a benefit to the\npublic for the purposes of paragraph (7)(b)”.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-4-norm"
        }
      ],
      "cml:integrityHash": "65a4024300b170cf95139d5b1181b51bb5e8c3399f5a41a6a98d2c4d1792395c",
      "skos:note": "Substitute clause in subsections (8A), (8B) and (9)"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsection 90(9A)",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "Omit “In determining what amounts to a benefit to the public for the\npurposes of subsections (8A), (8B) and (9)”, substitute “In relation to\nthe Commission’s consideration of an application for an authorisation to\nengage in conduct to which section 49 would or might apply or for a\nmerger authorisation, in determining what amounts to a benefit to the\npublic for the purposes of paragraph (7)(b)”."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Subsection 93(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.45",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) If the Commission is satisfied that the engaging by a corporation in\nconduct or proposed conduct of a kind described in\nsubsection 47(2), (3), (4), (5), (6), (7), (8) or (9) and referred to in a\nnotice given by the corporation under subsection (1):\n\n(a) has or would have the purpose or has or is likely to have, or\nwould have or be likely to have, the effect of substantially\nlessening competition within the meaning of section 47; and\n\n(b) in all the circumstances:\n\n(i) has not resulted or is not likely to result, or would not\nresult or be likely to result, in a benefit to the public; or\n\n(ii) has resulted or is likely to result, or would result or be\nlikely to result, in a benefit to the public that has not or\nwould not outweigh the detriment to the public that has\nresulted or is likely to result from the conduct or would\nresult or be likely to result from the proposed conduct;\nthe Commission may at any time give notice in writing to the\ncorporation stating that the Commission is so satisfied and\naccompanied by a statement setting out its reasons for being so\nsatisfied.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) If the Commission is satisfied that the engaging by a corporation in\nconduct or proposed conduct of a kind described in\nsubsection 47(2), (3), (4), (5), (6), (7), (8) or (9) and referred to in a\nnotice given by the corporation under subsection (1):\n\n(a) has or would have the purpose or has or is likely to have, or\nwould have or be likely to have, the effect of substantially\nlessening competition within the meaning of section 47; and\n\n(b) in all the circumstances:\n\n(i) has not resulted or is not likely to result, or would not\nresult or be likely to result, in a benefit to the public; or\n\n(ii) has resulted or is likely to result, or would result or be\nlikely to result, in a benefit to the public that has not or\nwould not outweigh the detriment to the public that has\nresulted or is likely to result from the conduct or would\nresult or be likely to result from the proposed conduct;\nthe Commission may at any time give notice in writing to the\ncorporation stating that the Commission is so satisfied and\naccompanied by a statement setting out its reasons for being so\nsatisfied.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-5-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0ccd5257d8d845574949983e1296ceefceda56645ed6b0f44bec4ed397b83982",
      "skos:note": "Commission may give notice if conduct would substantially lessen competition without a benefit to the public."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Subsection 93(3)",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) If the Commission is satisfied that the engaging by a corporation in\nconduct or proposed conduct of a kind described in\nsubsection 47(2), (3), (4), (5), (6), (7), (8) or (9) and referred to in a\nnotice given by the corporation under subsection (1):\n\n(a) has or would have the purpose or has or is likely to have, or\nwould have or be likely to have, the effect of substantially\nlessening competition within the meaning of section 47; and\n\n(b) in all the circumstances:\n\n(i) has not resulted or is not likely to result, or would not\nresult or be likely to result, in a benefit to the public; or\n\n(ii) has resulted or is likely to result, or would result or be\nlikely to result, in a benefit to the public that has not or\nwould not outweigh the detriment to the public that has\nresulted or is likely to result from the conduct or would\nresult or be likely to result from the proposed conduct;\nthe Commission may at any time give notice in writing to the\ncorporation stating that the Commission is so satisfied and\naccompanied by a statement setting out its reasons for being so\nsatisfied."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-5-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of conduct that would substantially lessen competition without a benefit to the public.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Subsection 93(3B)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.45",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3B) If:\n\n(a) a corporation or other person has notified the Commission\nunder subsection (1) of conduct or proposed conduct; and\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3B) If:\n\n(a) a corporation or other person has notified the Commission\nunder subsection (1) of conduct or proposed conduct; and\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "cml:asserts": [
        {
