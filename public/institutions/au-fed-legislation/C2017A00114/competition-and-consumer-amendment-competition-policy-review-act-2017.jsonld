      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.81",
      "values:originalText": "The amendment made by this Schedule applies in relation to findings of\nfact, and admissions of fact, made on or after the commencement of this\nitem.\n\nSchedule 11  Power to obtain information, documents and evidence\n\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\nNo. 114, 2017",
      "skos:definition": "The amendment made by this Schedule applies in relation to findings of\nfact, and admissions of fact, made on or after the commencement of this\nitem.\n\nSchedule 11  Power to obtain information, documents and evidence\n\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\nNo. 114, 2017",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-10-sec-2-norm"
        }
      ],
      "cml:integrityHash": "ce39281d41b334cf35788b8c7eacf8a1a92dbe61d744126ebc6feadf797bc436",
      "skos:note": "Applicable to findings of fact and admissions made after commencement."
    },
    {
