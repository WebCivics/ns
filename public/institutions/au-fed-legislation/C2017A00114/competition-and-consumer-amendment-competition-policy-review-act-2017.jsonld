    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-5-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Subsection 45(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-5-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.34",
      "values:originalText": "Repeal the subsection, substitute:\n\nCovenants affecting competition  Schedule 5\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(5) This section does not apply to or in relation to a provision of a\ncontract, arrangement or understanding or of a proposed contract,\narrangement or understanding, or to or in relation to a concerted\npractice, in so far as the provision or practice relates to:\n\n(a) conduct that contravenes section 48; or\n\n(b) conduct that would contravene section 48 if subsection 48(2)\ndid not apply; or\n\n(c) conduct that would contravene section 48 if it were not\nauthorised under section 88; or\n\n(d) conduct that would contravene section 48 if this Act defined\nthe acts constituting the practice of resale price maintenance\nby reference to the maximum price at which goods or\nservices are to be sold or supplied or are to be advertised,\ndisplayed or offered for sale or supply.",
      "skos:definition": "Repeal the subsection, substitute:\n\nCovenants affecting competition  Schedule 5\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(5) This section does not apply to or in relation to a provision of a\ncontract, arrangement or understanding or of a proposed contract,\narrangement or understanding, or to or in relation to a concerted\npractice, in so far as the provision or practice relates to:\n\n(a) conduct that contravenes section 48; or\n\n(b) conduct that would contravene section 48 if subsection 48(2)\ndid not apply; or\n\n(c) conduct that would contravene section 48 if it were not\nauthorised under section 88; or\n\n(d) conduct that would contravene section 48 if this Act defined\nthe acts constituting the practice of resale price maintenance\nby reference to the maximum price at which goods or\nservices are to be sold or supplied or are to be advertised,\ndisplayed or offered for sale or supply.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-5-sec-9-norm"
        }
      ],
      "cml:integrityHash": "34552de475a1021771135e28bf13bdadf3061a75c933438555bf46efef7bb390",
      "skos:note": "Exempts conduct from section 48 if it is authorized under section 88 or would not contravene section 48 due to subsection 48(2)."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-5-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Subsection 45(5)",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "Repeal the subsection, substitute:\n\nCovenants affecting competition  Schedule 5\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(5) This section does not apply to or in relation to a provision of a\ncontract, arrangement or understanding or of a proposed contract,\narrangement or understanding, or to or in relation to a concerted\npractice, in so far as the provision or practice relates to:\n\n(a) conduct that contravenes section 48; or\n\n(b) conduct that would contravene section 48 if subsection 48(2)\ndid not apply; or\n\n(c) conduct that would contravene section 48 if it were not\nauthorised under section 88; or\n\n(d) conduct that would contravene section 48 if this Act defined\nthe acts constituting the practice of resale price maintenance\nby reference to the maximum price at which goods or\nservices are to be sold or supplied or are to be advertised,\ndisplayed or offered for sale or supply."
    },
