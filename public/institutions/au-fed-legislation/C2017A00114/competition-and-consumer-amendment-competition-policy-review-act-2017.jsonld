      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93",
      "@type": "cml:Concept",
      "skos:prefLabel": "93 Subsections 91B(4) and (5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-93"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.65",
      "values:originalText": "Repeal the subsections, substitute:\n\n(3A) Subsection 90(6) (other than paragraph 90(6)(a)) applies in relation\nto an application for a revocation of an authorisation in a\ncorresponding way to the way in which it applies in relation to an\napplication for an authorisation.\n\n(3B) Subsection 90(6) (other than paragraphs 90(6)(a) and (b)) applies\nin relation to a proposal for a revocation of an authorisation in a\ncorresponding way to the way in which it applies in relation to an\napplication for an authorisation.\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "skos:definition": "Repeal the subsections, substitute:\n\n(3A) Subsection 90(6) (other than paragraph 90(6)(a)) applies in relation\nto an application for a revocation of an authorisation in a\ncorresponding way to the way in which it applies in relation to an\napplication for an authorisation.\n\n(3B) Subsection 90(6) (other than paragraphs 90(6)(a) and (b)) applies\nin relation to a proposal for a revocation of an authorisation in a\ncorresponding way to the way in which it applies in relation to an\napplication for an authorisation.\n\nSchedule 9  Authorisations, notifications and class exemptions",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93-ss-3a"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93-ss-3b"
        }
      ],
      "cml:integrityHash": "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-93",
      "@type": "cof:Section",
      "cof:title": "93 Subsections 91B(4) and (5)",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "Repeal the subsections, substitute:\n\n(3A) Subsection 90(6) (other than paragraph 90(6)(a)) applies in relation\nto an application for a revocation of an authorisation in a\ncorresponding way to the way in which it applies in relation to an\napplication for an authorisation.\n\n(3B) Subsection 90(6) (other than paragraphs 90(6)(a) and (b)) applies\nin relation to a proposal for a revocation of an authorisation in a\ncorresponding way to the way in which it applies in relation to an\napplication for an authorisation.\n\nSchedule 9  Authorisations, notifications and class exemptions"
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-93-ss-3a",
