    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-11-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Existing section 155 notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-11-sec-5"
      },
