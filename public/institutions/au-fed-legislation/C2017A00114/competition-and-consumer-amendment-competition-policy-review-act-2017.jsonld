    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Subsection 44ZZRD(4) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-2-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
