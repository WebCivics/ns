        }
      ],
      "cml:integrityHash": "16456d68fc6fb7ba2b350b6a50fed07b70cbaa0baba2ed4a139fda57b1141729",
      "skos:note": "Exempts contracts, arrangements, and understandings from the application of section 7."
    },
