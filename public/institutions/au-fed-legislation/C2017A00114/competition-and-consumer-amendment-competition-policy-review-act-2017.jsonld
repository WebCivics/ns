    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-5-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Paragraph 87(3)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-5-sec-12"
      },
      "cml:curationStatus": {
