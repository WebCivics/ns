    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Paragraph 93AD(1)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.48",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) at the end of the period which is:\n\n(i) if the notice relates (wholly or partly) to collective\nboycott conduct or proposed collective boycott\nconduct—60 days or such other period as is prescribed\nby the regulations; or\n\nAuthorisations, notifications and class exemptions  Schedule 9\nMain amendments  Part 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(ii) otherwise—14 days or such other period as is prescribed\nby the regulations;\n\nstarting on the day the corporation gave the Commission the\nnotice; or",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) at the end of the period which is:\n\n(i) if the notice relates (wholly or partly) to collective\nboycott conduct or proposed collective boycott\nconduct—60 days or such other period as is prescribed\nby the regulations; or\n\nAuthorisations, notifications and class exemptions  Schedule 9\nMain amendments  Part 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(ii) otherwise—14 days or such other period as is prescribed\nby the regulations;\n\nstarting on the day the corporation gave the Commission the\nnotice; or",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-17-norm"
        }
      ],
      "cml:integrityHash": "6ca0c5985f6282b471e9112b40a0b7167a72794e1825bd487d58dd90b367b353",
      "skos:note": "Repeal paragraph, substitute with new provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Paragraph 93AD(1)(a)",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) at the end of the period which is:\n\n(i) if the notice relates (wholly or partly) to collective\nboycott conduct or proposed collective boycott\nconduct—60 days or such other period as is prescribed\nby the regulations; or\n\nAuthorisations, notifications and class exemptions  Schedule 9\nMain amendments  Part 1\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\n(ii) otherwise—14 days or such other period as is prescribed\nby the regulations;\n\nstarting on the day the corporation gave the Commission the\nnotice; or"
    },
