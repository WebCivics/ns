    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-2-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 At the end of paragraph 44ZZRD(3)(a) of Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-2-sec-21"
      },
