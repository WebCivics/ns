    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-118",
      "@type": "cml:Concept",
      "skos:prefLabel": "118 Subsection 101(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-118"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.71",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) A review by the Tribunal is a re-hearing of the matter, unless it is a\nreview of a determination by the Commission:\n\n(a) in relation to an application for a merger authorisation or a\nminor variation of a merger authorisation; or\n\n(b) in relation to the revocation of a merger authorisation, or the\nrevocation of a merger authorisation and the substitution of\nanother merger authorisation.\n\n(3) Subsections 90(7), 91A(4) and (4A), 91B(5) and 91C(7) apply in\nrelation to the Tribunal in like manner as they apply in relation to\nthe Commission.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) A review by the Tribunal is a re-hearing of the matter, unless it is a\nreview of a determination by the Commission:\n\n(a) in relation to an application for a merger authorisation or a\nminor variation of a merger authorisation; or\n\n(b) in relation to the revocation of a merger authorisation, or the\nrevocation of a merger authorisation and the substitution of\nanother merger authorisation.\n\n(3) Subsections 90(7), 91A(4) and (4A), 91B(5) and 91C(7) apply in\nrelation to the Tribunal in like manner as they apply in relation to\nthe Commission.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-118-ss-2"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-118-ss-3"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-118",
      "@type": "cof:Section",
      "cof:title": "118 Subsection 101(2)",
      "values:kind": "section",
      "cof:pageNumber": 71,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) A review by the Tribunal is a re-hearing of the matter, unless it is a\nreview of a determination by the Commission:\n\n(a) in relation to an application for a merger authorisation or a\nminor variation of a merger authorisation; or\n\n(b) in relation to the revocation of a merger authorisation, or the\nrevocation of a merger authorisation and the substitution of\nanother merger authorisation.\n\n(3) Subsections 90(7), 91A(4) and (4A), 91B(5) and 91C(7) apply in\nrelation to the Tribunal in like manner as they apply in relation to\nthe Commission."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-118-ss-2",
