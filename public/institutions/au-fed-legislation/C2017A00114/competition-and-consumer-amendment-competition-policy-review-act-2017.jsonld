      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.87",
      "values:originalText": "Repeal the subsections, substitute:\n\n(4) The designated Minister cannot declare a service unless he or she\nis satisfied of all of the declaration criteria for the service.",
      "skos:definition": "Repeal the subsections, substitute:\n\n(4) The designated Minister cannot declare a service unless he or she\nis satisfied of all of the declaration criteria for the service.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-11-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-12-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b48fc2ec1068f8bfcb0d1a9bced8b238c90ec61ba8aec9ccb893259eb233a47b",
      "skos:note": "The designated Minister must be satisfied of all declaration criteria before declaring a service."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-12-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Subsections 44H(2) to (6C)",
      "values:kind": "section",
      "cof:pageNumber": 87,
      "values:originalText": "Repeal the subsections, substitute:\n\n(4) The designated Minister cannot declare a service unless he or she\nis satisfied of all of the declaration criteria for the service."
    },
