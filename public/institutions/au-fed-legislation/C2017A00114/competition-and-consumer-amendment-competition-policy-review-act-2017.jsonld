    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-13-sec-182",
      "@type": "cml:Concept",
      "skos:prefLabel": "182 Orders under section 87",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-13-sec-182"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.98",
      "values:originalText": "If:\n\n(a) before the commencement time, an order was made under\nsection 87 relating to a contravention of section 45B; and\n\n(b) the order was still in force immediately before the\ncommencement time;\n\nApplication and transitional provisions  Schedule 13\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nthe amendments made to section 87 by Schedule 5 to the amending\nAct do not apply in relation to, and do not affect the validity of, the\norder.",
      "skos:definition": "If:\n\n(a) before the commencement time, an order was made under\nsection 87 relating to a contravention of section 45B; and\n\n(b) the order was still in force immediately before the\ncommencement time;\n\nApplication and transitional provisions  Schedule 13\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nthe amendments made to section 87 by Schedule 5 to the amending\nAct do not apply in relation to, and do not affect the validity of, the\norder.",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-13-sec-182-norm"
        }
      ],
      "cml:integrityHash": "f3a29b0374cd825737f00695700a75b41a744f05d032b4ce9cd02633ee0ecba6",
      "skos:note": "No amendments apply to an existing order under section 87."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-13-sec-182",
      "@type": "cof:Section",
      "cof:title": "182 Orders under section 87",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "If:\n\n(a) before the commencement time, an order was made under\nsection 87 relating to a contravention of section 45B; and\n\n(b) the order was still in force immediately before the\ncommencement time;\n\nApplication and transitional provisions  Schedule 13\n\nNo. 114, 2017\nCompetition and Consumer Amendment (Competition Policy Review)\nAct 2017\n\nthe amendments made to section 87 by Schedule 5 to the amending\nAct do not apply in relation to, and do not affect the validity of, the\norder."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-13-sec-182-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
