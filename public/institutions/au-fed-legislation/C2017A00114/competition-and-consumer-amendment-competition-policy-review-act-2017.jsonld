      "@type": "cml:Concept",
      "skos:prefLabel": "78 After subsection 89(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-78"
      },
