    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 After section 93AC",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-competition-policy-review-act-2017.pdf, p.48",
      "values:originalText": "Insert:\n93ACA  Imposing conditions relating to collective boycott conduct\n\n(1) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice that relates (wholly or partly) to collective boycott\nconduct or proposed collective boycott conduct; and\n\n(b) the Commission reasonably believes that:\n\n(i) apart from this section, the Commission would have\ngrounds to give the corporation an objection notice\nrelating to the collective bargaining notice; and\n\n(ii) those grounds would not exist if particular conditions\nrelating to the conduct or proposed conduct were\ncomplied with;\nthe Commission may give the corporation a written notice\nimposing those conditions.\n\n(2) The Commission must, in or with the notice under subsection (1),\ngive the corporation a written statement of its reasons for giving\nthe notice.",
      "skos:definition": "Insert:\n93ACA  Imposing conditions relating to collective boycott conduct\n\n(1) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice that relates (wholly or partly) to collective boycott\nconduct or proposed collective boycott conduct; and\n\n(b) the Commission reasonably believes that:\n\n(i) apart from this section, the Commission would have\ngrounds to give the corporation an objection notice\nrelating to the collective bargaining notice; and\n\n(ii) those grounds would not exist if particular conditions\nrelating to the conduct or proposed conduct were\ncomplied with;\nthe Commission may give the corporation a written notice\nimposing those conditions.\n\n(2) The Commission must, in or with the notice under subsection (1),\ngive the corporation a written statement of its reasons for giving\nthe notice.",
      "cml:hasPart": [
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-16-ss-1"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-16-ss-2"
        }
      ],
      "cml:integrityHash": "6834d4e76c9fe7ecf645d8f30334cba3fe7e2f016803b7354ed181fc9940fbf8"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-competition-policy-review-act-2017#sch-9-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 After section 93AC",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "Insert:\n93ACA  Imposing conditions relating to collective boycott conduct\n\n(1) If:\n\n(a) a corporation gives the Commission a collective bargaining\nnotice that relates (wholly or partly) to collective boycott\nconduct or proposed collective boycott conduct; and\n\n(b) the Commission reasonably believes that:\n\n(i) apart from this section, the Commission would have\ngrounds to give the corporation an objection notice\nrelating to the collective bargaining notice; and\n\n(ii) those grounds would not exist if particular conditions\nrelating to the conduct or proposed conduct were\ncomplied with;\nthe Commission may give the corporation a written notice\nimposing those conditions.\n\n(2) The Commission must, in or with the notice under subsection (1),\ngive the corporation a written statement of its reasons for giving\nthe notice."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-competition-policy-review-act-2017-sch-9-sec-16-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(1) After section 93AC",
      "cml:realizedBy": {
