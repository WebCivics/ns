        }
      ],
      "cml:integrityHash": "596b83741edb8bfafeee54cfac0234a8090fa560f7cf115bb95d05e2554cfdd8",
      "skos:note": "Commission may withdraw the benefit of class exemption if conduct substantially lessens competition."
    },
