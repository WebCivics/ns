    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "The provision diffuses liability to certain acts or omissions." ;
    cml:premiseText "(a) before the day this Act receives the Royal Assent a person did an act, or omitted to do an act;" ;
    cml:conclusionText "then, despite the amendments of that Act made by this Schedule, the person is not liable to a penalty for the act or omission." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

