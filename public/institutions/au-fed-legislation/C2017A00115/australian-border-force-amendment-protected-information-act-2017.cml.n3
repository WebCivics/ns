doc:sch-1-sec-57a-ss-1 a cof:Section ;
    cof:title "57A(1) Act not to apply so as to exceed Commonwealth power" ;
    values:kind "subsection" ;
    values:originalText "(1) If a provision of this Act, or of an instrument made under this Act:  (a) would, apart from this section, have an application (an invalid application) in relation to:  Amendments  Schedule 1 Amendments commencing on 1 July 2015  Part 1  No. 115, 2017 Australian Border Force Amendment (Protected Information) Act 2017  (i) one or more particular persons, things, matters, places, circumstances or cases; or  (ii) one or more classes (however defined or determined) of persons, things, matters, places, circumstances or cases;  because of which the provision exceeds the Commonwealth’s legislative power; but  (b) also has at least one application (a valid application) in relation to:  (i) one or more particular persons, things, matters, places, circumstances or cases; or  (ii) one or more classes (however defined or determined) of persons, things, matters, places, circumstances or cases;  that, if it were the provision’s only application, would be within the Commonwealth’s legislative power; it is the Parliament’s intention that the provision is not to have the invalid application, but is to have every valid application." ;
    cof:pageNumber "12"^^xsd:integer .

concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-57a-ss-2 a cml:Concept ;
    skos:prefLabel "57A(2) Act not to apply so as to exceed Commonwealth power"@en ;
    cml:realizedBy doc:sch-1-sec-57a-ss-2 ;
    values:originalText "(2) This section applies to a provision of this Act, or of an instrument made under this Act, whether the provision is enacted or made before, on or after the commencement of this section." ;
    skos:definition "(2) This section applies to a provision of this Act, or of an instrument made under this Act, whether the provision is enacted or made before, on or after the commencement of this section."@en ;
    cml:integrityHash "db0030f9f17e0eb271deb383826dac1aa68b2b1f184850fb306c9fd994a7edd2" ;
    values:partOf concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-57a ;
