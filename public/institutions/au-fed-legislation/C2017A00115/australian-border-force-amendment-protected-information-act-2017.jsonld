    {
      "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Application—Immigration and Border Protection",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-amendment-protected-information-act-2017#sch-1-sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-amendment-protected-information-act-2017.pdf"
      },
      "dc:source": "australian-border-force-amendment-protected-information-act-2017.pdf, p.13",
      "values:originalText": "information\nTo avoid doubt, if:\n\n(a) before the day this Act receives the Royal Assent a person\ndid an act, or omitted to do an act; and\n\n(b) at the time of the act or omission, the act or omission did not\nmake the person liable to a penalty under Part 6 of the\nAustralian Border Force Act 2015;\nthen, despite the amendments of that Act made by this Schedule, the\nperson is not liable to a penalty for the act or omission.",
      "skos:definition": "information\nTo avoid doubt, if:\n\n(a) before the day this Act receives the Royal Assent a person\ndid an act, or omitted to do an act; and\n\n(b) at the time of the act or omission, the act or omission did not\nmake the person liable to a penalty under Part 6 of the\nAustralian Border Force Act 2015;\nthen, despite the amendments of that Act made by this Schedule, the\nperson is not liable to a penalty for the act or omission.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24-norm"
        },
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24-logic-deontic-1"
        },
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24-logic-ltl-3"
        },
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24-logic-diffusion-4"
        },
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "169344813317edc7f98748b93d7b9c4b03e8b5259a451a75a28ae32e76bc3a89",
      "skos:note": "Immunity from penalty for certain acts or omissions before the Act receives Royal Assent."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-amendment-protected-information-act-2017#sch-1-sec-24",
      "@type": "cof:Section",
      "cof:title": "24 Application—Immigration and Border Protection",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "information\nTo avoid doubt, if:\n\n(a) before the day this Act receives the Royal Assent a person\ndid an act, or omitted to do an act; and\n\n(b) at the time of the act or omission, the act or omission did not\nmake the person liable to a penalty under Part 6 of the\nAustralian Border Force Act 2015;\nthen, despite the amendments of that Act made by this Schedule, the\nperson is not liable to a penalty for the act or omission."
    },
    {
      "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-24-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If an act or omission did not make the person liable to a penalty, then they are not liable.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "a) before the day this Act receives the Royal Assent a person did an act, or omitted to do an act;",
      "cml:conclusionText": "then, despite the amendments of that Act made by this Schedule, the person is not liable to a penalty for the act or omission."
    },
