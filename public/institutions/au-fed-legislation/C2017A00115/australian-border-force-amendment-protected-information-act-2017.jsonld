      "dc:source": "australian-border-force-amendment-protected-information-act-2017.pdf, p.6",
      "values:originalText": "(paragraph (a)\napplies)\n\nNote:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "skos:definition": "(paragraph (a)\napplies)\n\nNote:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sec-31-2-norm"
        }
      ],
      "cml:integrityHash": "fe71c9739c9634fd0dcf0b8428f9189c777ff77fe2ab74db678644201bfba21d",
      "skos:note": "Note on table limitations and amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-amendment-protected-information-act-2017#sec-31-2",
      "@type": "cof:Section",
      "cof:title": "31 October 2017",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "(paragraph (a)\napplies)\n\nNote:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act."
    },
