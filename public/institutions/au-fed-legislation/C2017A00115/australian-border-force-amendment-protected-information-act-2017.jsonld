      "dc:source": "australian-border-force-amendment-protected-information-act-2017.pdf, p.15",
      "values:originalText": "Insert:\n\n(na) a purpose relating to the inter-country adoption of a child;\n\n(nb) a purpose relating to the protection of national security or the\ndefence of Australia;\n\n(nc) a purpose relating to locating a missing person;\n\nSchedule 1  Amendments",
      "skos:definition": "Insert:\n\n(na) a purpose relating to the inter-country adoption of a child;\n\n(nb) a purpose relating to the protection of national security or the\ndefence of Australia;\n\n(nc) a purpose relating to locating a missing person;\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-31-norm"
        }
      ],
      "cml:integrityHash": "16110b10df0c68070badfc4aa4f5632b26851dd1f88d887ebc3e26603c7ffc22",
      "skos:note": "Inserts purposes for inter-country adoption, national security, and locating missing persons."
    },
