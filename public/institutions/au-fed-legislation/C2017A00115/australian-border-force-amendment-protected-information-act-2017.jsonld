    },
    {
      "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-amendment-protected-information-act-2017#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-amendment-protected-information-act-2017.pdf"
      },
      "dc:source": "australian-border-force-amendment-protected-information-act-2017.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nNo. 115, 2017\nAustralian Border Force Amendment (Protected Information) Act 2017\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nNo. 115, 2017\nAustralian Border Force Amendment (Protected Information) Act 2017\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "1eea1196b2aaa58cfd903fa8e92b3df33d928cc1c6c53ac06038e1d751fc2f1a",
      "skos:note": "Legislation in Schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-amendment-protected-information-act-2017#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\n\n\n\nNo. 115, 2017\nAustralian Border Force Amendment (Protected Information) Act 2017\n\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sec-3-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sec-3-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 4(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-border-force-amendment-protected-information-act-2017#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-border-force-amendment-protected-information-act-2017.pdf"
      },
      "dc:source": "australian-border-force-amendment-protected-information-act-2017.pdf, p.8",
      "values:originalText": "Insert:\nduty of confidence means any duty or obligation arising under the\ncommon law or at equity pursuant to which a person is obliged not\nto disclose information.\nImmigration and Border Protection information means\ninformation of any of the following kinds that was obtained by a\nperson in the person’s capacity as an entrusted person:\n\n(a) information the disclosure of which would or could\nreasonably be expected to prejudice the security, defence or\ninternational relations of Australia;\n\n(b) information the disclosure of which would or could\nreasonably be expected to prejudice the prevention, detection\nor investigation of, or the conduct of proceedings relating to,\nan offence or a contravention of a civil penalty provision;\n\n(c) information the disclosure of which would or could\nreasonably be expected to prejudice the protection of public\nhealth, or endanger the life or safety of an individual or group\nof individuals;\n\n(d) information the disclosure of which would or could\nreasonably be expected to found an action by a person (other\nthan the Commonwealth) for breach of a duty of confidence;\n\n(e) information the disclosure of which would or could\nreasonably be expected to cause competitive detriment to a\nperson;\n\n(f) information of a kind prescribed in an instrument under\nsubsection (7).\nNote:\nSee also subsections (4) to (7).\nintelligence agency means:\n\n(a) the Australian Geospatial-Intelligence Organisation; or\n\nAmendments  Schedule 1\nAmendments commencing on 1 July 2015  Part 1\n\nNo. 115, 2017\nAustralian Border Force Amendment (Protected Information) Act 2017\n\n(b) the Australian Secret Intelligence Service; or\n\n(c) the Australian Security Intelligence Organisation; or\n\n(d) the Australian Signals Directorate; or\n\n(e) the Defence Intelligence Organisation; or\n\n(f) the Office of National Assessments; or\n\n(g) a government body or authority responsible for intelligence\ngathering for, or the security of, a foreign country.",
      "skos:definition": "Insert:\nduty of confidence means any duty or obligation arising under the\ncommon law or at equity pursuant to which a person is obliged not\nto disclose information.\nImmigration and Border Protection information means\ninformation of any of the following kinds that was obtained by a\nperson in the person’s capacity as an entrusted person:\n\n(a) information the disclosure of which would or could\nreasonably be expected to prejudice the security, defence or\ninternational relations of Australia;\n\n(b) information the disclosure of which would or could\nreasonably be expected to prejudice the prevention, detection\nor investigation of, or the conduct of proceedings relating to,\nan offence or a contravention of a civil penalty provision;\n\n(c) information the disclosure of which would or could\nreasonably be expected to prejudice the protection of public\nhealth, or endanger the life or safety of an individual or group\nof individuals;\n\n(d) information the disclosure of which would or could\nreasonably be expected to found an action by a person (other\nthan the Commonwealth) for breach of a duty of confidence;\n\n(e) information the disclosure of which would or could\nreasonably be expected to cause competitive detriment to a\nperson;\n\n(f) information of a kind prescribed in an instrument under\nsubsection (7).\nNote:\nSee also subsections (4) to (7).\nintelligence agency means:\n\n(a) the Australian Geospatial-Intelligence Organisation; or\n\nAmendments  Schedule 1\nAmendments commencing on 1 July 2015  Part 1\n\nNo. 115, 2017\nAustralian Border Force Amendment (Protected Information) Act 2017\n\n(b) the Australian Secret Intelligence Service; or\n\n(c) the Australian Security Intelligence Organisation; or\n\n(d) the Australian Signals Directorate; or\n\n(e) the Defence Intelligence Organisation; or\n\n(f) the Office of National Assessments; or\n\n(g) a government body or authority responsible for intelligence\ngathering for, or the security of, a foreign country.",
      "cml:asserts": [
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:australian-border-force-amendment-protected-information-act-2017-sch-1-sec-1-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "9b316bc70876d4cd75b243605d4339957ad85dc2c08996e1f1b47ef982fdb2ae",
      "skos:note": "Definition of Immigration and Border Protection information"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-border-force-amendment-protected-information-act-2017#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 4(1)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Insert:\nduty of confidence means any duty or obligation arising under the\ncommon law or at equity pursuant to which a person is obliged not\nto disclose information.\nImmigration and Border Protection information means\ninformation of any of the following kinds that was obtained by a\nperson in the person’s capacity as an entrusted person:\n\n(a) information the disclosure of which would or could\nreasonably be expected to prejudice the security, defence or\ninternational relations of Australia;\n\n(b) information the disclosure of which would or could\nreasonably be expected to prejudice the prevention, detection\nor investigation of, or the conduct of proceedings relating to,\nan offence or a contravention of a civil penalty provision;\n\n(c) information the disclosure of which would or could\nreasonably be expected to prejudice the protection of public\nhealth, or endanger the life or safety of an individual or group\nof individuals;\n\n(d) information the disclosure of which would or could\nreasonably be expected to found an action by a person (other\nthan the Commonwealth) for breach of a duty of confidence;\n\n(e) information the disclosure of which would or could\nreasonably be expected to cause competitive detriment to a\nperson;\n\n(f) information of a kind prescribed in an instrument under\nsubsection (7).\nNote:\nSee also subsections (4) to (7).\nintelligence agency means:\n\n(a) the Australian Geospatial-Intelligence Organisation; or\n\nAmendments  Schedule 1\nAmendments commencing on 1 July 2015  Part 1\n\nNo. 115, 2017\nAustralian Border Force Amendment (Protected Information) Act 2017\n\n(b) the Australian Secret Intelligence Service; or\n\n(c) the Australian Security Intelligence Organisation; or\n\n(d) the Australian Signals Directorate; or\n\n(e) the Defence Intelligence Organisation; or\n\n(f) the Office of National Assessments; or\n\n(g) a government body or authority responsible for intelligence\ngathering for, or the security of, a foreign country."
    },
