        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines a temporal interval for the application of merits review.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "A matter may be remitted by the Tribunal following merits review by the Tribunal of such a decision if an application for merits review was made before 21 June 2017."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017-sch-1-sec-21-logic-cogai-5",
