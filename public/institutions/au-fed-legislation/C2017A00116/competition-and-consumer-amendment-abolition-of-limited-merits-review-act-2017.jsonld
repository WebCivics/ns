      "cml:integrityHash": "099c4f3abd0f4345ac64e90a95b251f3d67d52a10035805b27d8e4ca2da2ac73",
      "skos:note": "Amendment applies in relation to decisions made before, on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017#sch-1-sec-5",
      "@type": "cof:Section",
