      "dc:source": "competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAbolition of limited merits review  Schedule 1\nAmendments  Part 1\n\nNo. 116, 2017\nCompetition and Consumer Amendment (Abolition of Limited Merits\nReview) Act 2017",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAbolition of limited merits review  Schedule 1\nAmendments  Part 1\n\nNo. 116, 2017\nCompetition and Consumer Amendment (Abolition of Limited Merits\nReview) Act 2017",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017-sec-3-norm"
        }
      ],
      "cml:integrityHash": "67401d8b66a322b4389d31633f4241e726e1a3536943facef54d489c7f66f5ce",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
