    {
      "@id": "concept:competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 After section 44ZZM",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017.pdf"
      },
      "dc:source": "competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017.pdf, p.7",
      "values:originalText": "Insert:\n44ZZMAA  No merits review by Tribunal of decisions under energy\nlaws\n\n(1) This section applies if a State/Territory energy law or the\nAustralian Energy Market Act 2004 purports to confer a function\nor power, or to impose a duty, in relation to a decision made under:\n\n(a) a State/Territory energy law; or\n\n(b) a uniform energy law applied as a law of the Commonwealth\nunder the Australian Energy Market Act 2004.\n\nSchedule 1  Abolition of limited merits review",
      "skos:definition": "Insert:\n44ZZMAA  No merits review by Tribunal of decisions under energy\nlaws\n\n(1) This section applies if a State/Territory energy law or the\nAustralian Energy Market Act 2004 purports to confer a function\nor power, or to impose a duty, in relation to a decision made under:\n\n(a) a State/Territory energy law; or\n\n(b) a uniform energy law applied as a law of the Commonwealth\nunder the Australian Energy Market Act 2004.\n\nSchedule 1  Abolition of limited merits review",
      "cml:asserts": [
        {
          "@id": "concept:competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017-sch-1-sec-4-norm"
        },
        {
          "@id": "concept:competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017-sch-1-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a905a7746684156e896d4fe00ccca0d06d51324363f8561233dc97ddf3cae18c",
      "skos:note": "No merits review by Tribunal of decisions under energy laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 After section 44ZZM",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n44ZZMAA  No merits review by Tribunal of decisions under energy\nlaws\n\n(1) This section applies if a State/Territory energy law or the\nAustralian Energy Market Act 2004 purports to confer a function\nor power, or to impose a duty, in relation to a decision made under:\n\n(a) a State/Territory energy law; or\n\n(b) a uniform energy law applied as a law of the Commonwealth\nunder the Australian Energy Market Act 2004.\n\nSchedule 1  Abolition of limited merits review"
    },
