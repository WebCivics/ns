      },
      "cml:premiseText": "Subitem (3) prevents an application for merits review by the Tribunal of the decision on the remitted matter."
    },
    {
      "@id": "concept:competition-and-consumer-amendment-abolition-of-limited-merits-review-act-2017-sch-1-sec-21-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Defines a temporal interval for the application of merits review.",
