    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Defines accountable authority for reporting purposes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf> ;
