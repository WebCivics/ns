concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-5 a cml:Concept ;
    skos:prefLabel "5 Saving of directions"@en ;
    cml:realizedBy doc:sch-1-sec-5 ;
    values:originalText "Directions under section 46 of the Australian Capital Territory (Planning and Land Management) Act 1988 that were in force immediately before the day this item commences have effect on or after that day as if they had been made by the Authority under subsection 46(2) of that Act, as amended by Part 1 of this Schedule." ;
    skos:definition "Directions under section 46 of the Australian Capital Territory (Planning and Land Management) Act 1988 that were in force immediately before the day this item commences have effect on or after that day as if they had been made by the Authority under subsection 46(2) of that Act, as amended by Part 1 of this Schedule."@en ;
    cml:integrityHash "c71a82a8bf3474c0d95a720286f0493467677cae7a95f55fa0cae3955e4f9f39" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Directions under section 46 of the Australian Capital Territory (Planning and Land Management) Act 1988 have effect on or after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf> ;
