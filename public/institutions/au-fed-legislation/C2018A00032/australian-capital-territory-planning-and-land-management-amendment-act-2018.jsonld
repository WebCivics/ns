        }
      ],
      "cml:integrityHash": "9ab6070c6c851cda6bfdc56a77f4e1b691746accfc983ae6849be5a3a7bd326c"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-planning-and-land-management-amendment-act-2018#sch-1-sec-7",
