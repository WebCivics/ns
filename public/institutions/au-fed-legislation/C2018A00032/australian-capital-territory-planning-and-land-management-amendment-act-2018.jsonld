      "dc:source": "australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nGovernance arrangements  Schedule 1\nAmendments  Part 1\n\nNo. 32, 2018\nAustralian Capital Territory (Planning and Land Management)\nAmendment Act 2018",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nGovernance arrangements  Schedule 1\nAmendments  Part 1\n\nNo. 32, 2018\nAustralian Capital Territory (Planning and Land Management)\nAmendment Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sec-3-norm"
        }
      ],
      "cml:integrityHash": "6ea513c26abd86b0d854937189495a0b608dadc2301a851bd39f7ea2da9fa7d6",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-planning-and-land-management-amendment-act-2018#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nGovernance arrangements  Schedule 1\nAmendments  Part 1\n\nNo. 32, 2018\nAustralian Capital Territory (Planning and Land Management)\nAmendment Act 2018"
    },
