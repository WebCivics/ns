    {
      "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Saving of directions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-planning-and-land-management-amendment-act-2018#sch-1-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf"
      },
      "dc:source": "australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf, p.9",
      "values:originalText": "Directions under section 46 of the Australian Capital Territory\n(Planning and Land Management) Act 1988 that were in force\nimmediately before the day this item commences have effect on or after\nthat day as if they had been made by the Authority under\nsubsection 46(2) of that Act, as amended by Part 1 of this Schedule.",
      "skos:definition": "Directions under section 46 of the Australian Capital Territory\n(Planning and Land Management) Act 1988 that were in force\nimmediately before the day this item commences have effect on or after\nthat day as if they had been made by the Authority under\nsubsection 46(2) of that Act, as amended by Part 1 of this Schedule.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-5-norm"
        },
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-5-logic-deontic-1"
        },
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-5-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-5-logic-ltl-3"
        },
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-5-logic-diffusion-4"
        },
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-5-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "c71a82a8bf3474c0d95a720286f0493467677cae7a95f55fa0cae3955e4f9f39",
      "skos:note": "Directions under section 46 of the Australian Capital Territory (Planning and Land Management) Act 1988 have effect on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-planning-and-land-management-amendment-act-2018#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Saving of directions",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Directions under section 46 of the Australian Capital Territory\n(Planning and Land Management) Act 1988 that were in force\nimmediately before the day this item commences have effect on or after\nthat day as if they had been made by the Authority under\nsubsection 46(2) of that Act, as amended by Part 1 of this Schedule."
    },
    {
