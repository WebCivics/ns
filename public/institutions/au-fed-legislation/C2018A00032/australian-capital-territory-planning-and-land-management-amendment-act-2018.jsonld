    {
      "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Transitional—duties of accountable authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-planning-and-land-management-amendment-act-2018#sch-1-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf"
      },
      "dc:source": "australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf, p.9",
      "values:originalText": "For the purposes of sections 39, 42 and 46 of the Public Governance,\nPerformance and Accountability Act 2013, the Authority is the\naccountable authority in relation to the reporting period (within the\nmeaning of that Act) for the Authority that ends immediately before this\nitem commences.",
      "skos:definition": "For the purposes of sections 39, 42 and 46 of the Public Governance,\nPerformance and Accountability Act 2013, the Authority is the\naccountable authority in relation to the reporting period (within the\nmeaning of that Act) for the Authority that ends immediately before this\nitem commences.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-6-norm"
        },
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-6-logic-deontic-1"
        },
        {
          "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-6-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "eaa5f3e6f4b1e65d8a7a011958a6ca63b2d10c1bc53037157f18e7b5367d361a",
      "skos:note": "Defines accountable authority for reporting purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-planning-and-land-management-amendment-act-2018#sch-1-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Transitional—duties of accountable authority",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "For the purposes of sections 39, 42 and 46 of the Public Governance,\nPerformance and Accountability Act 2013, the Authority is the\naccountable authority in relation to the reporting period (within the\nmeaning of that Act) for the Authority that ends immediately before this\nitem commences."
    },
    {
      "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-6-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-6"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Characterizes Authority as accountable authority",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "For the purposes of sections 39, 42 and 46 of the Public Governance, Performance and Accountability Act 2013",
      "cml:conclusionText": "Authority is the accountable authority for the reporting period"
    },
    {
      "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-6-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "within",
      "cml:logicSummary": "Defines temporal interval for Authority's accountability",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "the Authority that ends immediately before this item commences",
      "cml:conclusionText": "Authority's accountability is within the reporting period"
    },
    {
      "@id": "concept:australian-capital-territory-planning-and-land-management-amendment-act-2018-sch-1-sec-7-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Transitional—things done by, or in relation to, the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-planning-and-land-management-amendment-act-2018#sch-1-sec-7-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf"
      },
      "dc:source": "australian-capital-territory-planning-and-land-management-amendment-act-2018.pdf, p.9",
      "values:originalText": "accountable authority\nAnything done by, or in relation to, the Chief Executive as the\naccountable authority for the purposes of the finance law (within the\nmeaning of the Public Governance, Performance and Accountability\nAct 2013) before the commencement of this item has effect after that\ncommencement as if the thing had been done by, or in relation to, the\nAuthority as the accountable authority.\nNote:\nFor example, an instruction given by the Chief Executive under subsection 20A(1) of\nthe Public Governance, Performance and Accountability Act 2013 before\ncommencement will be treated after commencement as if it had been given by the\nAuthority.\n\n[Minister’s second reading speech made in—\nSenate on 6 December 2017\nHouse of Representatives on 9 May 2018]\n\n(262/17)",
      "skos:definition": "accountable authority\nAnything done by, or in relation to, the Chief Executive as the\naccountable authority for the purposes of the finance law (within the\nmeaning of the Public Governance, Performance and Accountability\nAct 2013) before the commencement of this item has effect after that\ncommencement as if the thing had been done by, or in relation to, the\nAuthority as the accountable authority.\nNote:\nFor example, an instruction given by the Chief Executive under subsection 20A(1) of\nthe Public Governance, Performance and Accountability Act 2013 before\ncommencement will be treated after commencement as if it had been given by the\nAuthority.\n\n[Minister’s second reading speech made in—\nSenate on 6 December 2017\nHouse of Representatives on 9 May 2018]\n\n(262/17)",
