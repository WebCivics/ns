      "@id": "concept:crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subdivision A of Division 6 of Part VIIC (heading)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018#sch-1-sec-1"
      },
      "cml:curationStatus": {
