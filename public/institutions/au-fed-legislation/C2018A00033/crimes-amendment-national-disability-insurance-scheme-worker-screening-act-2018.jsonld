      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the heading, substitute:\nSubdivision A—Exclusions relating to work with children\n(Divisions 2 and 3)"
    },
    {
      "@id": "concept:crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018-sch-1-sec-1-norm",
