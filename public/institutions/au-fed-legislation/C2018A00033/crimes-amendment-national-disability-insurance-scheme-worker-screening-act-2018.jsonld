      "cml:integrityHash": "35f08535f2945aeac95911e04b5d453d4ca0f890b0b5d65f9c0328ab762d09dd",
      "skos:note": "Repeal a heading and substitute it with a new one."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018#sch-1-sec-1",
      "@type": "cof:Section",
