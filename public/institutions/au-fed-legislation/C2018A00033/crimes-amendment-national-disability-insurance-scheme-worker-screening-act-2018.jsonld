      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018.pdf"
      },
      "dc:source": "crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018.pdf, p.7",
      "values:originalText": "Repeal the heading, substitute:\nSubdivision A—Exclusions relating to work with children\n(Divisions 2 and 3)",
      "skos:definition": "Repeal the heading, substitute:\nSubdivision A—Exclusions relating to work with children\n(Divisions 2 and 3)",
      "cml:asserts": [
        {
