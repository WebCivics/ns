      "dc:source": "crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018.pdf, p.6",
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provisions do not commence\nwithin the period of 6 months beginning on\nthe day this Act receives the Royal Assent,\nthey commence on the day after the end of\nthat period.",
      "skos:definition": "A single day to be fixed by Proclamation.\nHowever, if the provisions do not commence\nwithin the period of 6 months beginning on\nthe day this Act receives the Royal Assent,\nthey commence on the day after the end of\nthat period.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018-sec-2-2-norm"
        }
      ],
      "cml:integrityHash": "3da1f419c50f363574136ef5b33e60c6d4aa84b705072605d623341525811dd3",
      "skos:note": "Commencement provision for Schedule 1"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-national-disability-insurance-scheme-worker-screening-act-2018#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "A single day to be fixed by Proclamation.\nHowever, if the provisions do not commence\nwithin the period of 6 months beginning on\nthe day this Act receives the Royal Assent,\nthey commence on the day after the end of\nthat period."
    },
