concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-134 a cml:Concept ;
    skos:prefLabel "134 Subsection 23YUB(1A)"@en ;
    cml:realizedBy doc:sch-1-sec-134 ;
    values:originalText "Repeal the subsection, substitute:  (1A) The orders mentioned in subsection (1) do not include an order made in response to a request by a foreign country or international tribunal.  Assistance to international courts and tribunals  Schedule 1 Forensic procedures  Part 7  No. 34, 2018 Crimes Legislation Amendment (International Crime Cooperation and Other Measures) Act 2018  International Criminal Court Act 2002" ;
    skos:definition "Repeal the subsection, substitute:  (1A) The orders mentioned in subsection (1) do not include an order made in response to a request by a foreign country or international tribunal.  Assistance to international courts and tribunals  Schedule 1 Forensic procedures  Part 7  No. 34, 2018 Crimes Legislation Amendment (International Crime Cooperation and Other Measures) Act 2018  International Criminal Court Act 2002"@en ;
    cml:integrityHash "42ae90222679afc5c9efc9453459061e4b5827822ffc584e26b3017708ede53b" ;
    cof:pageNumber "52"^^xsd:integer ;
    skos:note "Prevents orders made in response to foreign country or international tribunal requests from being included." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
