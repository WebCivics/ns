    cof:pageNumber "67"^^xsd:integer ;
    skos:note "Court may order responsible agency head to retain property for as long as required." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
