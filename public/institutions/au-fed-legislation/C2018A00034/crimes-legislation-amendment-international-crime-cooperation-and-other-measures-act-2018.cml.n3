concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ai a cml:Concept ;
    skos:prefLabel "40AI Contents of notices to financial institutions"@en ;
    cml:realizedBy doc:sch-1-sec-40ai ;
    values:originalText "The notice must:  (a) state that the officer giving the notice believes that the notice is required:  Schedule 1  Assistance to international courts and tribunals" ;
    skos:definition "The notice must:  (a) state that the officer giving the notice believes that the notice is required:  Schedule 1  Assistance to international courts and tribunals"@en ;
