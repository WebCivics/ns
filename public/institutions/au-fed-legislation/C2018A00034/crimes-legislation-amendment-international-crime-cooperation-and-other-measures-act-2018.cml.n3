concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aa a cml:Concept ;
    skos:prefLabel "40AA Application of Division"@en ;
    cml:realizedBy doc:sch-1-sec-40aa ;
    values:originalText "This Division applies if:  (a) a Tribunal makes a request (a proceeds request) to the Attorney-General for the identification, tracing, and freezing or seizure, of the proceeds of a Tribunal offence; and  (b) the Attorney-General is satisfied that a person (the defendant):  (i) has been, or is about to be, charged with the Tribunal offence before the Tribunal; or  (ii) has been convicted by the Tribunal of the Tribunal offence." ;
    skos:definition "This Division applies if:  (a) a Tribunal makes a request (a proceeds request) to the Attorney-General for the identification, tracing, and freezing or seizure, of the proceeds of a Tribunal offence; and  (b) the Attorney-General is satisfied that a person (the defendant):  (i) has been, or is about to be, charged with the Tribunal offence before the Tribunal; or  (ii) has been convicted by the Tribunal of the Tribunal offence."@en ;
    cml:integrityHash "eb4be67265f5fb30dd7059cac19a74da1acbb36552ac4efc44bdea93da52b56d" ;
    cof:pageNumber "73"^^xsd:integer ;
    skos:note "Request for Attorney-General to identify and freeze proceeds of Tribunal offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
