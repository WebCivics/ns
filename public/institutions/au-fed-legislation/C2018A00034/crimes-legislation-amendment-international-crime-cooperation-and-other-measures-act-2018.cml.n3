concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-32b a cml:Concept ;
    skos:prefLabel "32B Authorising application for carrying out of forensic procedures"@en ;
    cml:realizedBy doc:sch-1-sec-32b ;
    values:originalText "(1) The Attorney-General may authorise, in writing, a constable to apply under Part ID of the Crimes Act 1914 for an order for the carrying out of a forensic procedure on a person if:  (a) a Tribunal has requested the procedure to be carried out on the person; and  (b) the Attorney-General is satisfied:  (i) that the request relates to a proceeding before, or an investigation conducted by, the Tribunal; and  (ii) that the person is, or is believed to be, in Australia; and  Schedule 1  Assistance to international courts and tribunals" ;
    skos:definition "(1) The Attorney-General may authorise, in writing, a constable to apply under Part ID of the Crimes Act 1914 for an order for the carrying out of a forensic procedure on a person if:  (a) a Tribunal has requested the procedure to be carried out on the person; and  (b) the Attorney-General is satisfied:  (i) that the request relates to a proceeding before, or an investigation conducted by, the Tribunal; and  (ii) that the person is, or is believed to be, in Australia; and  Schedule 1  Assistance to international courts and tribunals"@en ;
    cml:integrityHash "38e57e6d3cffe4fbe9ed694e1ea5c95634ec34064058fc9ea3566952bb2bd26b" ;
    cof:pageNumber "55"^^xsd:integer ;
    skos:note "Authorisation to apply for carrying out of forensic procedures" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
