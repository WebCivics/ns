concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-198-ss-6 a cml:Concept ;
    skos:prefLabel "198(6) Subsections 156(5) and (6)"@en ;
    cml:realizedBy doc:sch-1-sec-198-ss-6 ;
    values:originalText "(6) However, a registration effected by a court registering a copy of an authenticated copy ceases to have effect after 45 days unless the authenticated copy has been filed by then in that court." ;
    skos:definition "(6) However, a registration effected by a court registering a copy of an authenticated copy ceases to have effect after 45 days unless the authenticated copy has been filed by then in that court."@en ;
