concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-23 a cml:Concept ;
    skos:prefLabel "23 Subsection 270.10(1) of the Criminal Code"@en ;
    cml:realizedBy doc:sch-6-sec-23 ;
    values:originalText "Omit all the words after “determining”, substitute:  whether, in relation to a person (the alleged victim) against whom the offence is alleged to have been committed:  (a) in the case of an offence against this Subdivision—the alleged victim has been coerced, threatened or deceived; or  (b) in the case of an offence against section 270.5—the alleged victim was significantly deprived of personal freedom; or  (c) in the case of an offence against section 270.7B—the alleged victim was incapable of understanding the nature and effect of a marriage ceremony; or  (d) in the case of an offence against section 270.7C—another person has caused the alleged victim to enter into debt bondage." ;
    skos:definition "Omit all the words after “determining”, substitute:  whether, in relation to a person (the alleged victim) against whom the offence is alleged to have been committed:  (a) in the case of an offence against this Subdivision—the alleged victim has been coerced, threatened or deceived; or  (b) in the case of an offence against section 270.5—the alleged victim was significantly deprived of personal freedom; or  (c) in the case of an offence against section 270.7B—the alleged victim was incapable of understanding the nature and effect of a marriage ceremony; or  (d) in the case of an offence against section 270.7C—another person has caused the alleged victim to enter into debt bondage."@en ;
    cml:integrityHash "09c413313509234d59e4d8413bcc7180fca43a102f1f2aba4fed23291c2af52c" ;
    cof:pageNumber "110"^^xsd:integer ;
    skos:note "The alleged victim must have been coerced, threatened or deceived in relation to an offence against this Subdivision." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf> ;
