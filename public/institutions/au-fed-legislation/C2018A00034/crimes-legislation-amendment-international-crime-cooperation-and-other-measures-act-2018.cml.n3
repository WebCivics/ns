concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-98 a cml:Concept ;
    skos:prefLabel "98 Paragraph 50(1)(ia)"@en ;
    cml:realizedBy doc:sch-1-sec-98 ;
    values:originalText "Repeal the paragraph, substitute:  (ia) for each of the following offences:  (i) an offence against a law of a foreign country;  (ii) a crime within the jurisdiction of the ICC (within the meaning of the International Criminal Court Act 2002);  (iii) a Tribunal offence (within the meaning of the International War Crimes Tribunals Act 1995);  in respect of which a warrant was issued as a result of an international assistance application made by or on behalf of law enforcement officers of the agency during the year—the offence (if any), under a law of the Commonwealth, a State or a Territory, that is of the same, or a substantially similar, nature; and" ;
    skos:definition "Repeal the paragraph, substitute:  (ia) for each of the following offences:  (i) an offence against a law of a foreign country;  (ii) a crime within the jurisdiction of the ICC (within the meaning of the International Criminal Court Act 2002);  (iii) a Tribunal offence (within the meaning of the International War Crimes Tribunals Act 1995);  in respect of which a warrant was issued as a result of an international assistance application made by or on behalf of law enforcement officers of the agency during the year—the offence (if any), under a law of the Commonwealth, a State or a Territory, that is of the same, or a substantially similar, nature; and"@en ;
    cml:integrityHash "513ad967a1c38b3d9bcca0a60da4f830c50574cc115067bc831c7b96c1ac6ae9" ;
    cof:pageNumber "42"^^xsd:integer ;
    skos:note "Repeal certain offences and substitute with new definitions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf> ;
