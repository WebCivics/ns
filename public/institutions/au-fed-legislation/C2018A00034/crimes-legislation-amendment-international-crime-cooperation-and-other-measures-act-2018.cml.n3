concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-163a a cml:Concept ;
    skos:prefLabel "163A Report regarding international requests"@en ;
    cml:realizedBy doc:sch-1-sec-163a ;
    values:originalText "The report must set out the number of occasions on which lawfully accessed information or stored communications warrant information was communicated under subsection 139(1) or section 142 to any of the following:  (a) a foreign country;  (b) the International Criminal Court;  (c) a War Crimes Tribunal; for a purpose connected with an authorisation referred to in paragraph 139(2)(e)." ;
    skos:definition "The report must set out the number of occasions on which lawfully accessed information or stored communications warrant information was communicated under subsection 139(1) or section 142 to any of the following:  (a) a foreign country;  (b) the International Criminal Court;  (c) a War Crimes Tribunal; for a purpose connected with an authorisation referred to in paragraph 139(2)(e)."@en ;
    cml:integrityHash "c17c42c88264384d1fe4c1088c3a5ece58f692f82eaa834498b8a4e8dfe0bcd4" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Report must provide information on communications with foreign countries, International Criminal Court, and War Crimes Tribunal." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf> ;
