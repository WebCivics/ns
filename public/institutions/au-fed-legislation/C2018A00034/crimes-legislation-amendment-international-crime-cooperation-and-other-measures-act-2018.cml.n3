doc:sch-1-sec-40ac-ss-2 a cof:Section ;
    cof:title "40AC(2) Applying for and making restraining orders" ;
    values:kind "subsection" ;
    values:originalText "(2) If so authorised, a proceeds of crime authority may apply for such a restraining order against that property in respect of the Tribunal offence." ;
    cof:pageNumber "74"^^xsd:integer .

