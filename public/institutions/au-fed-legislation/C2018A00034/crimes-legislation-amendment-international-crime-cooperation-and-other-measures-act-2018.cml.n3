concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-181 a cml:Concept ;
    skos:prefLabel "181 Subsection 101(1)"@en ;
    cml:realizedBy doc:sch-1-sec-181 ;
    values:originalText "Repeal the subsection, substitute:  (1) Property must be dealt with in accordance with this section if:  (a) it has been seized under a POCA search warrant in relation to a crime within the jurisdiction of the ICC; and  (b) it is not:  (i) evidential material; or  (ii) property of a kind referred to in subparagraph 99A(a)(iv) or (v)." ;
    skos:definition "Repeal the subsection, substitute:  (1) Property must be dealt with in accordance with this section if:  (a) it has been seized under a POCA search warrant in relation to a crime within the jurisdiction of the ICC; and  (b) it is not:  (i) evidential material; or  (ii) property of a kind referred to in subparagraph 99A(a)(iv) or (v)."@en ;
    cml:integrityHash "652831b47819a9b4ebd4c28c7a7e3c1b4658c56cddaf8980254f09b0575fc142" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Property must be dealt with in accordance with this section if seized under a POCA search warrant." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
