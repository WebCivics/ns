concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-3-sec-2 a cml:Concept ;
    skos:prefLabel "2 At the end of section 35"@en ;
    cml:realizedBy doc:sch-3-sec-2 ;
    values:originalText "Add:  (7) If:  (a) the Federal Court makes an order under subsection (2) that the person be surrendered to New Zealand or confirming an order under paragraph 34(1)(c); or  (b) on appeal, the Full Court or the High Court makes an order that the person be surrendered to New Zealand or confirming such an order; the Federal Court, the Full Court or the High Court (as the case may be) must order that the person be committed to prison pending the execution of the surrender warrant." ;
    skos:definition "Add:  (7) If:  (a) the Federal Court makes an order under subsection (2) that the person be surrendered to New Zealand or confirming an order under paragraph 34(1)(c); or  (b) on appeal, the Full Court or the High Court makes an order that the person be surrendered to New Zealand or confirming such an order; the Federal Court, the Full Court or the High Court (as the case may be) must order that the person be committed to prison pending the execution of the surrender warrant."@en ;
    cml:integrityHash "3ff1bc9ca5fc27b677128f929055eb3eb4a62192c08c8f44f108e22956c43f08" ;
    cof:pageNumber "100"^^xsd:integer ;
    skos:note "Order person to be committed to prison pending execution of surrender warrant if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
