concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-11-sec-5 a cml:Concept ;
    skos:prefLabel "5 At the end of section 8"@en ;
    cml:realizedBy doc:sch-11-sec-5 ;
    values:originalText "Add: Definitions  (5) A term used in subsection (2A) and the Constitution has the same meaning in that subsection as it has in the Constitution." ;
