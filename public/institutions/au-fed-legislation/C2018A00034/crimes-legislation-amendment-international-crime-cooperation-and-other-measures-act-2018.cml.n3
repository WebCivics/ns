concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-14 a cml:Concept ;
    skos:prefLabel "14 Subsection 34ZD(5)"@en ;
    cml:realizedBy doc:sch-2-sec-14 ;
    values:originalText "Repeal the subsection, substitute:  (5) This section does not apply to property that has been seized under a POCA search warrant because:  (a) it is evidential material; or  (b) it is property of a kind referred to in subparagraph 34ZCA(a)(iv) or (v)." ;
    skos:definition "Repeal the subsection, substitute:  (5) This section does not apply to property that has been seized under a POCA search warrant because:  (a) it is evidential material; or  (b) it is property of a kind referred to in subparagraph 34ZCA(a)(iv) or (v)."@en ;
    cml:integrityHash "08dda1f52140f70e419ae9f59a41d736d1506bade983eddd995ec6615b15fc80" ;
    cof:pageNumber "93"^^xsd:integer ;
