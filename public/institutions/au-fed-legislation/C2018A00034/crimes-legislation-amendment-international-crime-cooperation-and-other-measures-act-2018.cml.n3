concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-50 a cml:Concept ;
    skos:prefLabel "50 Paragraph 139(2)(e)"@en ;
    cml:realizedBy doc:sch-1-sec-50 ;
    values:originalText "Repeal the paragraph, substitute:  Assistance to international courts and tribunals  Schedule 1 Covert access to stored communications  Part 3  No. 34, 2018 Crimes Legislation Amendment (International Crime Cooperation and Other Measures) Act 2018  (e) an authorisation under any of the following provisions in respect of the information:  (i) subsection 13A(1) of the Mutual Assistance in Criminal Matters Act 1987;  (ii) section 69A of the International Criminal Court Act 2002;  (iii) section 25A of the International War Crimes Tribunals Act 1995." ;
    skos:definition "Repeal the paragraph, substitute:  Assistance to international courts and tribunals  Schedule 1 Covert access to stored communications  Part 3  No. 34, 2018 Crimes Legislation Amendment (International Crime Cooperation and Other Measures) Act 2018  (e) an authorisation under any of the following provisions in respect of the information:  (i) subsection 13A(1) of the Mutual Assistance in Criminal Matters Act 1987;  (ii) section 69A of the International Criminal Court Act 2002;  (iii) section 25A of the International War Crimes Tribunals Act 1995."@en ;
    cml:integrityHash "92129b708c966d48445338e8a254ecbbb4d65a884a0960506fa244da4297c498" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Repeal paragraph 139(2)(e) and substitute with new provisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf> ;
