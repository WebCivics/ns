doc:sch-1-sec-40aa a cof:Section ;
    cof:title "40AA Application of Division" ;
    values:kind "section" ;
    values:originalText "This Division applies if:  (a) a Tribunal makes a request (a proceeds request) to the Attorney-General for the identification, tracing, and freezing or seizure, of the proceeds of a Tribunal offence; and  (b) the Attorney-General is satisfied that a person (the defendant):  (i) has been, or is about to be, charged with the Tribunal offence before the Tribunal; or  (ii) has been convicted by the Tribunal of the Tribunal offence." ;
    cof:pageNumber "73"^^xsd:integer .

concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ab a cml:Concept ;
    skos:prefLabel "40AB Authorising applications under the Proceeds of Crime Act"@en ;
    cml:realizedBy doc:sch-1-sec-40ab ;
    values:originalText "The Attorney-General may authorise, in writing, an authorised officer of an enforcement agency to make such applications under the Proceeds of Crime Act 2002 as are necessary to respond to the proceeds request if the Attorney-General is satisfied that the proceeds request:  (a) relates to a proceeding before, or an investigation conducted by, the Tribunal; and  Schedule 1  Assistance to international courts and tribunals" ;
    skos:definition "The Attorney-General may authorise, in writing, an authorised officer of an enforcement agency to make such applications under the Proceeds of Crime Act 2002 as are necessary to respond to the proceeds request if the Attorney-General is satisfied that the proceeds request:  (a) relates to a proceeding before, or an investigation conducted by, the Tribunal; and  Schedule 1  Assistance to international courts and tribunals"@en ;
    cml:integrityHash "9f2f7dbb1b76d6b3b35a61d8eb4721e32c425b3e6c60b1dc52e3c418078fd898" ;
    cof:pageNumber "73"^^xsd:integer ;
    skos:note "Attorney-General authorises officer to make applications under Proceeds of Crime Act" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf> ;
    dc:source "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.73" ;
    cml:asserts concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ab-norm .
