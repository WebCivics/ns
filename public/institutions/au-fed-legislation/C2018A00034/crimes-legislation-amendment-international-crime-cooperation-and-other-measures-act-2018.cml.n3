concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-107 a cml:Concept ;
    skos:prefLabel "107 Subsection 23WA(1)"@en ;
    cml:realizedBy doc:sch-1-sec-107 ;
    values:originalText "Insert: request, by a foreign country, international tribunal or foreign law enforcement agency, means:  (a) in the case of a foreign country—a request, referred to in section 28B of the Mutual Assistance in Criminal Matters Act 1987, by the country; or  (b) in the case of an international tribunal:  (i) a request referred to in section 76A of the International Criminal Court Act 2002, if the tribunal is the ICC; or  (ii) a request referred to in section 32B of the International War Crimes Tribunals Act 1995, if the tribunal is a War Crimes Tribunal; or  (c) in the case of a foreign law enforcement agency—a request, to which Subdivision B of Division 9A applies, by the agency.  Schedule 1  Assistance to international courts and tribunals" ;
    skos:definition "Insert: request, by a foreign country, international tribunal or foreign law enforcement agency, means:  (a) in the case of a foreign country—a request, referred to in section 28B of the Mutual Assistance in Criminal Matters Act 1987, by the country; or  (b) in the case of an international tribunal:  (i) a request referred to in section 76A of the International Criminal Court Act 2002, if the tribunal is the ICC; or  (ii) a request referred to in section 32B of the International War Crimes Tribunals Act 1995, if the tribunal is a War Crimes Tribunal; or  (c) in the case of a foreign law enforcement agency—a request, to which Subdivision B of Division 9A applies, by the agency.  Schedule 1  Assistance to international courts and tribunals"@en ;
    cml:integrityHash "a4888c1ac670238a3d61e05738ea3f0ece668e07210dad87d53f1c91708dabc5" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Request for assistance from foreign country, international tribunal or foreign law enforcement agency" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
