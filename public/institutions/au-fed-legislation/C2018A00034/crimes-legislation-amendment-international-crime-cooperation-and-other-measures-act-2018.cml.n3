    cof:pageNumber "83"^^xsd:integer ;
    skos:note "Property must be dealt with in accordance with this section if seized under a POCA search warrant." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
