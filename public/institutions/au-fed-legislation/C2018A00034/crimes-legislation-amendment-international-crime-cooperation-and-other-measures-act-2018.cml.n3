concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-100 a cml:Concept ;
    skos:prefLabel "100 Application of amendments"@en ;
    cml:realizedBy doc:sch-1-sec-100 ;
    values:originalText "The amendments made by this Part apply in relation to a request made to the Attorney-General by the ICC, a Tribunal or a foreign country:  (a) on or after the commencement of this item; or  Assistance to international courts and tribunals  Schedule 1 Use of surveillance devices  Part 6  No. 34, 2018 Crimes Legislation Amendment (International Crime Cooperation and Other Measures) Act 2018  (b) before the commencement of this item, if, immediately before that commencement, the Attorney-General had yet to make a decision on the request; whether conduct, a crime or an offence to which the request relates occurred before, on or after that commencement.  Schedule 1  Assistance to international courts and tribunals" ;
    skos:definition "The amendments made by this Part apply in relation to a request made to the Attorney-General by the ICC, a Tribunal or a foreign country:  (a) on or after the commencement of this item; or  Assistance to international courts and tribunals  Schedule 1 Use of surveillance devices  Part 6  No. 34, 2018 Crimes Legislation Amendment (International Crime Cooperation and Other Measures) Act 2018  (b) before the commencement of this item, if, immediately before that commencement, the Attorney-General had yet to make a decision on the request; whether conduct, a crime or an offence to which the request relates occurred before, on or after that commencement.  Schedule 1  Assistance to international courts and tribunals"@en ;
    cml:integrityHash "bd508b93060bbb39b7367503760da70e4d55ccfdf15298a277ec6db69a89d334" ;
    cof:pageNumber "42"^^xsd:integer ;
    skos:note "Amendments apply in relation to a request made by the ICC, Tribunal or foreign country." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf> ;
