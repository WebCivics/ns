concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al a cml:Concept ;
    skos:prefLabel "40AL Disclosing existence or nature of notice"@en ;
    cml:realizedBy doc:sch-1-sec-40al ;
    values:originalText "A person commits an offence if:  (a) the person is given a notice under section 40AH; and  (b) the notice states that information about the notice must not be disclosed; and  (c) the person discloses the existence or nature of the notice. Penalty: Imprisonment for 2 years or 120 penalty units, or both." ;
    skos:definition "A person commits an offence if:  (a) the person is given a notice under section 40AH; and  (b) the notice states that information about the notice must not be disclosed; and  (c) the person discloses the existence or nature of the notice. Penalty: Imprisonment for 2 years or 120 penalty units, or both."@en ;
    cml:integrityHash "219c36407e587108b6c3bdceedae60eeaf5d66e6d775d5bf4582e5f7702dbe7f" ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Disclosing existence or nature of notice is prohibited after receiving a notice under section 40AH." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
