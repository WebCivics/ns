doc:sch-1-sec-40am-ss-1 a cof:Section ;
    cof:title "40AM(1) Failing to comply with a notice" ;
    values:kind "subsection" ;
    values:originalText "(1) A person commits an offence if:  (a) the person is given a notice under section 40AH; and  (b) the person fails to comply with the notice. Penalty: Imprisonment for 2 years or 100 penalty units, or both." ;
    cof:pageNumber "79"^^xsd:integer .

concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40am-ss-2 a cml:Concept ;
    skos:prefLabel "40AM(2) Failing to comply with a notice"@en ;
    cml:realizedBy doc:sch-1-sec-40am-ss-2 ;
    values:originalText "(2) Subsection (1) does not apply if:  (a) the person fails to comply with the notice only because the person does not provide information or a document within the period specified in the notice; and  (b) the person took all reasonable steps to provide the information or document within that period; and  (c) the person provides the information or document as soon as practicable after the end of that period. Note 1: A defendant bears an evidential burden in relation to the matters in subsection (2) (see subsection 13.3(3) of the Criminal Code).  Schedule 1  Assistance to international courts and tribunals" ;
    skos:definition "(2) Subsection (1) does not apply if:  (a) the person fails to comply with the notice only because the person does not provide information or a document within the period specified in the notice; and  (b) the person took all reasonable steps to provide the information or document within that period; and  (c) the person provides the information or document as soon as practicable after the end of that period. Note 1: A defendant bears an evidential burden in relation to the matters in subsection (2) (see subsection 13.3(3) of the Criminal Code).  Schedule 1  Assistance to international courts and tribunals"@en ;
    cml:integrityHash "d1e2b98bd2883255b50700b1cc70665863e93b1cdd07c7c14d1cd0899c5019c5" ;
    values:partOf concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40am ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Exemption from liability for failing to provide information within a specified period" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf> ;
    dc:source "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.79" ;
    cml:asserts concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40am-ss-2-norm .
