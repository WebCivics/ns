concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-141 a cml:Concept ;
    skos:prefLabel "141 Section 4 (definition of evidential material)"@en ;
    cml:realizedBy doc:sch-1-sec-141 ;
    values:originalText "Repeal the definition, substitute: evidential material means:  (a) in Subdivision F of Division 14 of Part 4—evidence relating to:  (i) property in relation to which a forfeiture order has been or could be made; or  (ii) property in relation to which a restraining order has been or could be made for the purposes of section 82; or  (iii) property of a person in relation to whom a pecuniary penalty order may be enforced as described in section 159; or  (iv) proceeds of a crime within the jurisdiction of the ICC; or  (v) benefits derived from the commission of a crime within the jurisdiction of the ICC; or  (b) otherwise—a thing relevant to a crime within the jurisdiction of the ICC, including such a thing in electronic form." ;
    skos:definition "Repeal the definition, substitute: evidential material means:  (a) in Subdivision F of Division 14 of Part 4—evidence relating to:  (i) property in relation to which a forfeiture order has been or could be made; or  (ii) property in relation to which a restraining order has been or could be made for the purposes of section 82; or  (iii) property of a person in relation to whom a pecuniary penalty order may be enforced as described in section 159; or  (iv) proceeds of a crime within the jurisdiction of the ICC; or  (v) benefits derived from the commission of a crime within the jurisdiction of the ICC; or  (b) otherwise—a thing relevant to a crime within the jurisdiction of the ICC, including such a thing in electronic form."@en ;
    cml:integrityHash "72c038d1f53d471bee6149ffeac22277071d56853bf5f683fec2b31eca3edeb8" ;
    cof:pageNumber "58"^^xsd:integer ;
    skos:note "Definition of evidential material" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
