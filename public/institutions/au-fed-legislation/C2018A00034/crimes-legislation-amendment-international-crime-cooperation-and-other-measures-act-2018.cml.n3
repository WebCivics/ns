concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40au a cml:Concept ;
    skos:prefLabel "40AU Dealing with evidential material and certain property or"@en ;
    cml:realizedBy doc:sch-1-sec-40au ;
    values:originalText "things seized under POCA search warrants  (1) This section applies if:  (a) property or a thing (the seized item) is seized under a POCA search warrant in relation to a Tribunal offence; and  (b) the seized item is:  (i) evidential material; or  (ii) property or a thing of a kind referred to in subparagraph 40AR(a)(iv); and  (c) the seized item is seized by a person (the seizing officer) who is:  (i) an authorised officer; or  Schedule 1  Assistance to international courts and tribunals" ;
    skos:definition "things seized under POCA search warrants  (1) This section applies if:  (a) property or a thing (the seized item) is seized under a POCA search warrant in relation to a Tribunal offence; and  (b) the seized item is:  (i) evidential material; or  (ii) property or a thing of a kind referred to in subparagraph 40AR(a)(iv); and  (c) the seized item is seized by a person (the seizing officer) who is:  (i) an authorised officer; or  Schedule 1  Assistance to international courts and tribunals"@en ;
    cml:integrityHash "63a34b39e2e3e9f321e292c4415b4d0320ee242c6fe8236cc54f72a4bbb68e1f" ;
    cof:pageNumber "85"^^xsd:integer ;
    skos:note "Seizure of evidential material and certain property under POCA search warrants" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf> ;
