concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-270 a cml:Concept ;
    skos:prefLabel "270 7C  Offence of debt bondage"@en ;
    cml:realizedBy doc:sch-6-sec-270 ;
    values:originalText "A person commits an offence of debt bondage if:  (a) the person engages in conduct that causes another person to enter into debt bondage; and  (b) the person intends to cause the other person to enter into debt bondage. Penalty:  Schedule 6  Slavery-like offences and relevant evidence" ;
    skos:definition "A person commits an offence of debt bondage if:  (a) the person engages in conduct that causes another person to enter into debt bondage; and  (b) the person intends to cause the other person to enter into debt bondage. Penalty:  Schedule 6  Slavery-like offences and relevant evidence"@en ;
    cml:integrityHash "554805dea5c9445e0acbf775fa0feb0094330f8e63b02c247d740a120a2ade0a" ;
    cof:pageNumber "107"^^xsd:integer ;
    skos:note "Debt bondage offence" ;
