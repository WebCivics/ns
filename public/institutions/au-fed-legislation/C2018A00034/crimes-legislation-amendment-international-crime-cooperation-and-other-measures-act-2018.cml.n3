concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-16 a cml:Concept ;
    skos:prefLabel "16 Subsection 34ZE(1)"@en ;
    cml:realizedBy doc:sch-2-sec-16 ;
    values:originalText "Repeal the subsection, substitute:  (1) Property must be dealt with in accordance with this section if:  (a) it has been seized under a POCA search warrant in relation to a foreign serious offence; and  (b) it is not:  (i) evidential material; or  (ii) property of a kind referred to in subparagraph 34ZCA(a)(iv) or (v)." ;
