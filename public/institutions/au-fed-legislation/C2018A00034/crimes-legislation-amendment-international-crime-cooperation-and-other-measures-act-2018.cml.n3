concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-79 a cml:Concept ;
    skos:prefLabel "79 Application of amendments"@en ;
    cml:realizedBy doc:sch-1-sec-79 ;
    values:originalText "The amendments made by this Part apply in relation to a request made to the Attorney-General by the ICC, a Tribunal or a foreign country:  (a) on or after the commencement of this item; or  (b) before the commencement of this item, if, immediately before that commencement, the Attorney-General had yet to make a decision on the request;  Schedule 1  Assistance to international courts and tribunals" ;
    skos:definition "The amendments made by this Part apply in relation to a request made to the Attorney-General by the ICC, a Tribunal or a foreign country:  (a) on or after the commencement of this item; or  (b) before the commencement of this item, if, immediately before that commencement, the Attorney-General had yet to make a decision on the request;  Schedule 1  Assistance to international courts and tribunals"@en ;
    cml:integrityHash "4608c4a1d10e119bb5e128bba6d488a9e9b82a85329c46cd4a90ac06e8f1e44c" ;
    cof:pageNumber "35"^^xsd:integer ;
