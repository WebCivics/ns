    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ad-ss-1",
      "@type": "cof:Section",
      "cof:title": "40AD(1) Excluding property from restraining orders",
      "values:kind": "subsection",
      "cof:pageNumber": 74,
      "values:originalText": "(1) If, at the end of the period of 1 month after the making of a\nrestraining order in reliance on the proposed charging of a person\nwith a Tribunal offence, the person has not been charged with the\nTribunal offence or a related Tribunal offence, the order ceases to\nbe in force at the end of that period."
    },
