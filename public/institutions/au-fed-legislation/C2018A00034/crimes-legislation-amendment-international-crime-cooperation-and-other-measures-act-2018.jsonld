    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-4-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Evidentiary certificates relating to requests made to foreign",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-4-sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.102",
      "values:originalText": "countries\n\n(1) The Attorney-General may issue a written certificate signed by the\nAttorney-General certifying that specified documents or things\nwere obtained as a result of a request made to a foreign country by\nor on behalf of the Attorney-General.\n\n(2) In any proceeding to which this Part applies, a certificate under\nsubsection (1) is prima facie evidence of the matters stated in the\ncertificate.",
      "skos:definition": "countries\n\n(1) The Attorney-General may issue a written certificate signed by the\nAttorney-General certifying that specified documents or things\nwere obtained as a result of a request made to a foreign country by\nor on behalf of the Attorney-General.\n\n(2) In any proceeding to which this Part applies, a certificate under\nsubsection (1) is prima facie evidence of the matters stated in the\ncertificate.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-4-sec-26-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-4-sec-26-ss-2"
        }
      ],
      "cml:integrityHash": "e45d4cbade71ec65c6bf518246dc9bd75c5bf785b19a5fc727c2c3614dced1c0"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-4-sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Evidentiary certificates relating to requests made to foreign",
      "values:kind": "section",
      "cof:pageNumber": 102,
      "values:originalText": "countries\n\n(1) The Attorney-General may issue a written certificate signed by the\nAttorney-General certifying that specified documents or things\nwere obtained as a result of a request made to a foreign country by\nor on behalf of the Attorney-General.\n\n(2) In any proceeding to which this Part applies, a certificate under\nsubsection (1) is prima facie evidence of the matters stated in the\ncertificate."
    },
