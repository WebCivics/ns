      "cml:integrityHash": "b0186feb24b1c0fc3d72441e91a7ec216057b7326d2f50d69ef0efc18cbeb2c9",
      "skos:note": "Notice of resignation must be given to AFP employee before specified day."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-8-sec-20-ss-8",
      "@type": "cof:Section",
      "cof:title": "20(8) Subsections 30A(6) and (7)",
      "values:kind": "subsection",
      "cof:pageNumber": 119,
      "values:originalText": "(8) To be effective, the first notice given under subsection (6) in\nrelation to the notice of resignation must:\n\n(a) specify a day no later than 30 days after the day specified in\nthe most recent notice given under subsection (2) in relation\nto the notice of resignation; and\n\n(b) be given to the AFP employee before the day specified in the\nmost recent notice given under subsection (2) in relation to\nthe notice of resignation."
    },
