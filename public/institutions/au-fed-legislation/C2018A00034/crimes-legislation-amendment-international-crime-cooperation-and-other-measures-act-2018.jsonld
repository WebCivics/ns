    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-107",
      "@type": "cml:Concept",
      "skos:prefLabel": "107 Subsection 23WA(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-107"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
