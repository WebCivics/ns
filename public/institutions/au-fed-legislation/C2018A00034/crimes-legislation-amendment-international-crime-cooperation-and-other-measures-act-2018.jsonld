    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-51",
      "@type": "cml:Concept",
      "skos:prefLabel": "51 Subsection 139(4A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-51"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.25",
      "values:originalText": "Repeal the subsection, substitute:\n\n(4A) In the case of information obtained by the agency through the\nexecution of a warrant issued as a result of an international\nassistance application, the purposes are purposes connected with:\n\n(a) providing the information to the entity to which the\napplication relates, or to an appropriate authority of that\nentity; or\n\n(b) the keeping of records by the agency under Part 3-5.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(4A) In the case of information obtained by the agency through the\nexecution of a warrant issued as a result of an international\nassistance application, the purposes are purposes connected with:\n\n(a) providing the information to the entity to which the\napplication relates, or to an appropriate authority of that\nentity; or\n\n(b) the keeping of records by the agency under Part 3-5.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-51-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-51-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "73d69839e2135d0a076d9e618b319b086927cce8c74a418e538746a7a0c8fb0c",
      "skos:note": "Provide information to entity or appropriate authority"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-51",
      "@type": "cof:Section",
      "cof:title": "51 Subsection 139(4A)",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Repeal the subsection, substitute:\n\n(4A) In the case of information obtained by the agency through the\nexecution of a warrant issued as a result of an international\nassistance application, the purposes are purposes connected with:\n\n(a) providing the information to the entity to which the\napplication relates, or to an appropriate authority of that\nentity; or\n\n(b) the keeping of records by the agency under Part 3-5."
    },
