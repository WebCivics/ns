    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.113",
      "values:originalText": "(1)\nThe amendments made by Part 1 of this Schedule apply in relation to\nconduct engaged in on or after the commencement of this item.\n(2)\nThe amendments made by Part 2 of this Schedule apply in relation to\nproceedings for offences instituted after the commencement of this item\n(whether the proceedings are for offences committed, or alleged to have\nbeen committed, before or after the commencement of this item).",
      "skos:definition": "(1)\nThe amendments made by Part 1 of this Schedule apply in relation to\nconduct engaged in on or after the commencement of this item.\n(2)\nThe amendments made by Part 2 of this Schedule apply in relation to\nproceedings for offences instituted after the commencement of this item\n(whether the proceedings are for offences committed, or alleged to have\nbeen committed, before or after the commencement of this item).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-31-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-31-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "ae1329361eefaf18fcc3471db149de2fd0e11fbbdd522d865f7eb1ece8481eb1",
      "skos:note": "Conditional commencement of amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 113,
      "values:originalText": "(1)\nThe amendments made by Part 1 of this Schedule apply in relation to\nconduct engaged in on or after the commencement of this item.\n(2)\nThe amendments made by Part 2 of this Schedule apply in relation to\nproceedings for offences instituted after the commencement of this item\n(whether the proceedings are for offences committed, or alleged to have\nbeen committed, before or after the commencement of this item)."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-31-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-31"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-31-logic-alleninterval-1",
