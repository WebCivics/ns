    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-201",
      "@type": "cml:Concept",
      "skos:prefLabel": "201 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-201"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
