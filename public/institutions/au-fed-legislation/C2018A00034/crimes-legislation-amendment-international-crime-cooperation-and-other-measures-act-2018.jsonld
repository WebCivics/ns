      "skos:note": "Repeal section and substitute with amendments relating to mutual assistance in criminal matters"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Section 34ZC",
      "values:kind": "section",
      "cof:pageNumber": 90,
      "values:originalText": "Repeal the section, substitute:\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nSearch warrants  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018"
    },
