        }
      ],
      "cml:integrityHash": "46da14fe4420f3aff35aee96bf477f22e87bfdc1e438f86f55f3d63409085139"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-3-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 100,
      "values:originalText": "(1) The amendment of section 26 of the Extradition Act 1988 made by\nthis Schedule applies in relation to surrender warrants issued after\nthe commencement of this item.\n\n(2) The amendment of section 35 of the Extradition Act 1988 made by\nthis Schedule applies in relation to an order referred to in\n\nAmendment of the Extradition Act 1988  Schedule 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nparagraph 35(7)(a) or (b) made after the commencement of this\nitem.\n\nSchedule 4  Amendments relating to foreign evidence\n\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\nNo. 34, 2018"
    },
