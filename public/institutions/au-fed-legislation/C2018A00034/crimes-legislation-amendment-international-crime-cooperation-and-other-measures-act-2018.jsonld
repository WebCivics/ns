      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.45",
      "values:originalText": "Insert:\nrequest, by a foreign country, international tribunal or foreign law\nenforcement agency, means:\n\n(a) in the case of a foreign country—a request, referred to in\nsection 28B of the Mutual Assistance in Criminal Matters Act\n1987, by the country; or\n\n(b) in the case of an international tribunal:\n\n(i) a request referred to in section 76A of the International\nCriminal Court Act 2002, if the tribunal is the ICC; or\n\n(ii) a request referred to in section 32B of the International\nWar Crimes Tribunals Act 1995, if the tribunal is a War\nCrimes Tribunal; or\n\n(c) in the case of a foreign law enforcement agency—a request,\nto which Subdivision B of Division 9A applies, by the\nagency.\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "Insert:\nrequest, by a foreign country, international tribunal or foreign law\nenforcement agency, means:\n\n(a) in the case of a foreign country—a request, referred to in\nsection 28B of the Mutual Assistance in Criminal Matters Act\n1987, by the country; or\n\n(b) in the case of an international tribunal:\n\n(i) a request referred to in section 76A of the International\nCriminal Court Act 2002, if the tribunal is the ICC; or\n\n(ii) a request referred to in section 32B of the International\nWar Crimes Tribunals Act 1995, if the tribunal is a War\nCrimes Tribunal; or\n\n(c) in the case of a foreign law enforcement agency—a request,\nto which Subdivision B of Division 9A applies, by the\nagency.\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-107-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-107-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-107-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "a4888c1ac670238a3d61e05738ea3f0ece668e07210dad87d53f1c91708dabc5",
      "skos:note": "Request for assistance from foreign country, international tribunal or foreign law enforcement agency"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-107",
      "@type": "cof:Section",
      "cof:title": "107 Subsection 23WA(1)",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "Insert:\nrequest, by a foreign country, international tribunal or foreign law\nenforcement agency, means:\n\n(a) in the case of a foreign country—a request, referred to in\nsection 28B of the Mutual Assistance in Criminal Matters Act\n1987, by the country; or\n\n(b) in the case of an international tribunal:\n\n(i) a request referred to in section 76A of the International\nCriminal Court Act 2002, if the tribunal is the ICC; or\n\n(ii) a request referred to in section 32B of the International\nWar Crimes Tribunals Act 1995, if the tribunal is a War\nCrimes Tribunal; or\n\n(c) in the case of a foreign law enforcement agency—a request,\nto which Subdivision B of Division 9A applies, by the\nagency.\n\nSchedule 1  Assistance to international courts and tribunals"
    },
