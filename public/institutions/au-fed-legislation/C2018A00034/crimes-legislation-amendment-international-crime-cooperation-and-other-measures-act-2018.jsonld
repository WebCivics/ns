    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-78a",
      "@type": "cml:Concept",
      "skos:prefLabel": "78A Authorising application for a stored communications warrant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-78a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.18",
      "values:originalText": "The Attorney-General may authorise, in writing, the Australian\nFederal Police, or the police force or police service of a State, to\napply for a stored communications warrant under section 110 of\nthe Telecommunications (Interception and Access) Act 1979 if:\n\n(a) the Attorney-General is satisfied that:\n\n(i) an investigation is being conducted by the Prosecutor or\na proceeding is before the ICC; and\n\n(ii) there are reasonable grounds to believe that stored\ncommunications relevant to the investigation or\nproceeding are held by a carrier; and\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(b) the ICC has requested the Attorney-General to arrange for\naccess to the stored communications.\nNote:\nInformation obtained under the warrant may only be communicated to\nthe ICC on certain conditions: see subsection 142A(1) of the\nTelecommunications (Interception and Access) Act 1979.\nInternational War Crimes Tribunals Act 1995",
      "skos:definition": "The Attorney-General may authorise, in writing, the Australian\nFederal Police, or the police force or police service of a State, to\napply for a stored communications warrant under section 110 of\nthe Telecommunications (Interception and Access) Act 1979 if:\n\n(a) the Attorney-General is satisfied that:\n\n(i) an investigation is being conducted by the Prosecutor or\na proceeding is before the ICC; and\n\n(ii) there are reasonable grounds to believe that stored\ncommunications relevant to the investigation or\nproceeding are held by a carrier; and\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(b) the ICC has requested the Attorney-General to arrange for\naccess to the stored communications.\nNote:\nInformation obtained under the warrant may only be communicated to\nthe ICC on certain conditions: see subsection 142A(1) of the\nTelecommunications (Interception and Access) Act 1979.\nInternational War Crimes Tribunals Act 1995",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-78a-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-78a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0b9a9b1fc77a5f82c1c498891f59a4b9e1f4cb7869ea99866bd4794563c7aee3",
      "skos:note": "The Attorney-General may authorise the police to apply for a stored communications warrant."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-78a",
      "@type": "cof:Section",
      "cof:title": "78A Authorising application for a stored communications warrant",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "The Attorney-General may authorise, in writing, the Australian\nFederal Police, or the police force or police service of a State, to\napply for a stored communications warrant under section 110 of\nthe Telecommunications (Interception and Access) Act 1979 if:\n\n(a) the Attorney-General is satisfied that:\n\n(i) an investigation is being conducted by the Prosecutor or\na proceeding is before the ICC; and\n\n(ii) there are reasonable grounds to believe that stored\ncommunications relevant to the investigation or\nproceeding are held by a carrier; and\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(b) the ICC has requested the Attorney-General to arrange for\naccess to the stored communications.\nNote:\nInformation obtained under the warrant may only be communicated to\nthe ICC on certain conditions: see subsection 142A(1) of the\nTelecommunications (Interception and Access) Act 1979.\nInternational War Crimes Tribunals Act 1995"
    },
