    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-28"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.96",
      "values:originalText": "The amendments of the Mutual Assistance in Criminal Matters Act\n1987 made by this Part apply in relation to the following:\n\n(a) a requirement to produce documents or other articles that is\nmade on or after the commencement of this item;\n\n(b) a requirement to produce documents or other articles that is\nmade before the commencement of this item if:\n\n(i) the documents or other articles had not been produced\nimmediately before the commencement of this item; or\n\n(ii) the documents or other articles were produced before\nthe commencement of this item but, immediately before\nthat commencement, the documents (or copies of the\ndocuments) or other articles had not been sent to the\nAttorney-General as required by paragraph 13(2)(b) or\nsubsection 13(2D) of that Act.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nOther amendments  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "skos:definition": "The amendments of the Mutual Assistance in Criminal Matters Act\n1987 made by this Part apply in relation to the following:\n\n(a) a requirement to produce documents or other articles that is\nmade on or after the commencement of this item;\n\n(b) a requirement to produce documents or other articles that is\nmade before the commencement of this item if:\n\n(i) the documents or other articles had not been produced\nimmediately before the commencement of this item; or\n\n(ii) the documents or other articles were produced before\nthe commencement of this item but, immediately before\nthat commencement, the documents (or copies of the\ndocuments) or other articles had not been sent to the\nAttorney-General as required by paragraph 13(2)(b) or\nsubsection 13(2D) of that Act.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nOther amendments  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-28-norm"
        }
      ],
      "cml:integrityHash": "ea0a12315824342ed7390ef977a58b4c9e8792aaf24556fbc00fd30f4efab8e1",
      "skos:note": "Application provision for amendments made by this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-28",
      "@type": "cof:Section",
      "cof:title": "28 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "The amendments of the Mutual Assistance in Criminal Matters Act\n1987 made by this Part apply in relation to the following:\n\n(a) a requirement to produce documents or other articles that is\nmade on or after the commencement of this item;\n\n(b) a requirement to produce documents or other articles that is\nmade before the commencement of this item if:\n\n(i) the documents or other articles had not been produced\nimmediately before the commencement of this item; or\n\n(ii) the documents or other articles were produced before\nthe commencement of this item but, immediately before\nthat commencement, the documents (or copies of the\ndocuments) or other articles had not been sent to the\nAttorney-General as required by paragraph 13(2)(b) or\nsubsection 13(2D) of that Act.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nOther amendments  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018"
    },
