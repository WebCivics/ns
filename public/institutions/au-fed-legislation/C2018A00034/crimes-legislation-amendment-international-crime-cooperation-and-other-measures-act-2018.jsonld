    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-270",
      "@type": "cml:Concept",
      "skos:prefLabel": "270 7C  Offence of debt bondage",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-270"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.107",
      "values:originalText": "A person commits an offence of debt bondage if:\n\n(a) the person engages in conduct that causes another person to\nenter into debt bondage; and\n\n(b) the person intends to cause the other person to enter into debt\nbondage.\nPenalty:\n\nSchedule 6  Slavery-like offences and relevant evidence",
      "skos:definition": "A person commits an offence of debt bondage if:\n\n(a) the person engages in conduct that causes another person to\nenter into debt bondage; and\n\n(b) the person intends to cause the other person to enter into debt\nbondage.\nPenalty:\n\nSchedule 6  Slavery-like offences and relevant evidence",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-270-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-270-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-270-logic-ltl-2"
        }
      ],
      "cml:integrityHash": "554805dea5c9445e0acbf775fa0feb0094330f8e63b02c247d740a120a2ade0a",
      "skos:note": "Debt bondage offence"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-270",
      "@type": "cof:Section",
      "cof:title": "270 7C  Offence of debt bondage",
      "values:kind": "section",
      "cof:pageNumber": 107,
      "values:originalText": "A person commits an offence of debt bondage if:\n\n(a) the person engages in conduct that causes another person to\nenter into debt bondage; and\n\n(b) the person intends to cause the other person to enter into debt\nbondage.\nPenalty:\n\nSchedule 6  Slavery-like offences and relevant evidence"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-270-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-270"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
