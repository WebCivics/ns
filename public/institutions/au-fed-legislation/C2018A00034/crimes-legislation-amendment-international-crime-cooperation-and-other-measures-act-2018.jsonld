      "@type": "cml:Concept",
      "skos:prefLabel": "69A(3) Authorising provision of material obtained by law enforcement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-69a-ss-3"
