    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-126",
      "@type": "cml:Concept",
      "skos:prefLabel": "126 Subsection 23YF(1) (note 1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-126"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.50",
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nIf a forensic procedure is carried out as a result of a request by a\nforeign country or an international tribunal, a copy of anything made\nmay also be provided to that country or tribunal: see section 23YQB.",
      "skos:definition": "Repeal the note, substitute:\nNote 1:\nIf a forensic procedure is carried out as a result of a request by a\nforeign country or an international tribunal, a copy of anything made\nmay also be provided to that country or tribunal: see section 23YQB.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-126-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-126-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bb1a9e0e055e0073cf41263098173c05d886c38d2c2472a87dd8fc340ae2d841",
      "skos:note": "Provide a copy of anything made to a foreign country or tribunal if a forensic procedure is carried out as a result of a request."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-126",
      "@type": "cof:Section",
      "cof:title": "126 Subsection 23YF(1) (note 1)",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nIf a forensic procedure is carried out as a result of a request by a\nforeign country or an international tribunal, a copy of anything made\nmay also be provided to that country or tribunal: see section 23YQB."
    },
