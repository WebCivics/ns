    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 Paragraph 16(2)(ea)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-90"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.40",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(ea) in the case of a warrant sought in relation to an international\nassistance authorisation—the likely evidentiary or\nintelligence value of any evidence or information sought to\nbe obtained, to the extent that this is possible to determine\nfrom information obtained from the international entity to\nwhich the authorisation relates; and\n\nAssistance to international courts and tribunals  Schedule 1\nUse of surveillance devices  Part 6\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(ea) in the case of a warrant sought in relation to an international\nassistance authorisation—the likely evidentiary or\nintelligence value of any evidence or information sought to\nbe obtained, to the extent that this is possible to determine\nfrom information obtained from the international entity to\nwhich the authorisation relates; and\n\nAssistance to international courts and tribunals  Schedule 1\nUse of surveillance devices  Part 6\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-90-norm"
        }
      ],
      "cml:integrityHash": "6cdbaa9aeaa9b8f3cb5fe61031ca76cc804de2a7aac5b18066cf5f1eced6e371",
      "skos:note": "Determine the likely evidentiary or intelligence value of evidence sought to be obtained from an international entity."
    },
