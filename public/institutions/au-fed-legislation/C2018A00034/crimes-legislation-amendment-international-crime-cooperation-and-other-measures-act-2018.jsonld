        }
      ],
      "cml:integrityHash": "b8ea3f1724f06bc21a18c0c1bdef1e2da75816534d99601cae11906531479dc8",
      "skos:note": "List of authorities responsible for investigating or prosecuting crimes within the jurisdiction of the ICC or War Crimes Tribunal."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-61",
