      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.66",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) Property must be dealt with in accordance with this section if:\n\n(a) it has been seized under a POCA search warrant in relation to\na crime within the jurisdiction of the ICC; and\n\n(b) it is not:\n\n(i) evidential material; or\n\n(ii) property of a kind referred to in\nsubparagraph 99A(a)(iv) or (v).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) Property must be dealt with in accordance with this section if:\n\n(a) it has been seized under a POCA search warrant in relation to\na crime within the jurisdiction of the ICC; and\n\n(b) it is not:\n\n(i) evidential material; or\n\n(ii) property of a kind referred to in\nsubparagraph 99A(a)(iv) or (v).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-181-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-181-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "652831b47819a9b4ebd4c28c7a7e3c1b4658c56cddaf8980254f09b0575fc142",
      "skos:note": "Property must be dealt with in accordance with this section if seized under a POCA search warrant."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-181",
      "@type": "cof:Section",
      "cof:title": "181 Subsection 101(1)",
      "values:kind": "section",
      "cof:pageNumber": 66,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) Property must be dealt with in accordance with this section if:\n\n(a) it has been seized under a POCA search warrant in relation to\na crime within the jurisdiction of the ICC; and\n\n(b) it is not:\n\n(i) evidential material; or\n\n(ii) property of a kind referred to in\nsubparagraph 99A(a)(iv) or (v)."
    },
