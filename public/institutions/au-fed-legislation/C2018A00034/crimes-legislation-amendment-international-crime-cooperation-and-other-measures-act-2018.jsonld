      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.48",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) if the forensic procedure has been requested by a foreign\ncountry or an international tribunal—balance the public\ninterest in Australia providing and receiving international\nassistance in criminal matters against the public interest in\nupholding the physical integrity of the suspect; and",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) if the forensic procedure has been requested by a foreign\ncountry or an international tribunal—balance the public\ninterest in Australia providing and receiving international\nassistance in criminal matters against the public interest in\nupholding the physical integrity of the suspect; and",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-117-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-117-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "13d12f8bb5f618a14c30c436ee987b1274f46a4615571b7b8d59eeb65d6a32b0",
      "skos:note": "Balance public interest in Australia providing and receiving international assistance in criminal matters against the public interest in upholding the physical integrity of the suspect."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-117",
      "@type": "cof:Section",
      "cof:title": "117 Paragraph 23WT(2)(a)",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) if the forensic procedure has been requested by a foreign\ncountry or an international tribunal—balance the public\ninterest in Australia providing and receiving international\nassistance in criminal matters against the public interest in\nupholding the physical integrity of the suspect; and"
    },
