      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.103",
      "values:originalText": "The amendments of the Foreign Evidence Act 1994 made by items 1\nand 2 of this Schedule apply in relation to a proceeding that commences\nbefore, on or after the commencement of this item.\n\nSchedule 5  Protecting vulnerable persons\n\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\nNo. 34, 2018",
      "skos:definition": "The amendments of the Foreign Evidence Act 1994 made by items 1\nand 2 of this Schedule apply in relation to a proceeding that commences\nbefore, on or after the commencement of this item.\n\nSchedule 5  Protecting vulnerable persons\n\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\nNo. 34, 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-4-sec-6-norm"
        }
      ],
      "cml:integrityHash": "6bc493f79e589cc80024e1daffb8f50a6cb78c5a233133a25d545c8f0147c17a",
      "skos:note": "Amendments apply to proceedings commencing before, on or after commencement."
    },
    {
