      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "After “Mutual Assistance in Criminal Matters Act 1987”, insert “, the\nInternational Criminal Court Act 2002, the International War Crimes\nTribunals Act 1995”."
    },
