    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Subsection 270.10(1) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.110",
      "values:originalText": "Omit all the words after “determining”, substitute:\n\nwhether, in relation to a person (the alleged victim) against whom\nthe offence is alleged to have been committed:\n\n(a) in the case of an offence against this Subdivision—the\nalleged victim has been coerced, threatened or deceived; or\n\n(b) in the case of an offence against section 270.5—the alleged\nvictim was significantly deprived of personal freedom; or\n\n(c) in the case of an offence against section 270.7B—the alleged\nvictim was incapable of understanding the nature and effect\nof a marriage ceremony; or\n\n(d) in the case of an offence against section 270.7C—another\nperson has caused the alleged victim to enter into debt\nbondage.",
      "skos:definition": "Omit all the words after “determining”, substitute:\n\nwhether, in relation to a person (the alleged victim) against whom\nthe offence is alleged to have been committed:\n\n(a) in the case of an offence against this Subdivision—the\nalleged victim has been coerced, threatened or deceived; or\n\n(b) in the case of an offence against section 270.5—the alleged\nvictim was significantly deprived of personal freedom; or\n\n(c) in the case of an offence against section 270.7B—the alleged\nvictim was incapable of understanding the nature and effect\nof a marriage ceremony; or\n\n(d) in the case of an offence against section 270.7C—another\nperson has caused the alleged victim to enter into debt\nbondage.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-23-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-23-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-23-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-23-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "09c413313509234d59e4d8413bcc7180fca43a102f1f2aba4fed23291c2af52c",
      "skos:note": "The alleged victim must have been coerced, threatened or deceived in relation to an offence against this Subdivision."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Subsection 270.10(1) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 110,
      "values:originalText": "Omit all the words after “determining”, substitute:\n\nwhether, in relation to a person (the alleged victim) against whom\nthe offence is alleged to have been committed:\n\n(a) in the case of an offence against this Subdivision—the\nalleged victim has been coerced, threatened or deceived; or\n\n(b) in the case of an offence against section 270.5—the alleged\nvictim was significantly deprived of personal freedom; or\n\n(c) in the case of an offence against section 270.7B—the alleged\nvictim was incapable of understanding the nature and effect\nof a marriage ceremony; or\n\n(d) in the case of an offence against section 270.7C—another\nperson has caused the alleged victim to enter into debt\nbondage."
    },
