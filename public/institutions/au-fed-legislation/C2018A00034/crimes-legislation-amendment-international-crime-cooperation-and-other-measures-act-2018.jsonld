      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-119",
      "@type": "cml:Concept",
      "skos:prefLabel": "119 After paragraph 23XWR(2)(da)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-119"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.48",
      "values:originalText": "Insert:\n\n(db) if the volunteer undergoes a forensic procedure because of a\nrequest by a foreign law enforcement agency responsible to\nan international tribunal—the following:\n\n(i) the name of the international tribunal for which the\nrequest was made;\n\n(ii) that forensic evidence resulting from the forensic\nprocedure will be provided to the agency;\n\n(iii) that the forensic evidence may be used in proceedings in\nthe international tribunal;\n\n(iv) that the retention of the forensic evidence will be\ngoverned by the rules of the international tribunal;\n\n(v) that the retention of the forensic evidence will be subject\nto undertakings given by the agency;\n\nAssistance to international courts and tribunals  Schedule 1\nForensic procedures  Part 7\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(vi) the content of those undertakings;",
      "skos:definition": "Insert:\n\n(db) if the volunteer undergoes a forensic procedure because of a\nrequest by a foreign law enforcement agency responsible to\nan international tribunal—the following:\n\n(i) the name of the international tribunal for which the\nrequest was made;\n\n(ii) that forensic evidence resulting from the forensic\nprocedure will be provided to the agency;\n\n(iii) that the forensic evidence may be used in proceedings in\nthe international tribunal;\n\n(iv) that the retention of the forensic evidence will be\ngoverned by the rules of the international tribunal;\n\n(v) that the retention of the forensic evidence will be subject\nto undertakings given by the agency;\n\nAssistance to international courts and tribunals  Schedule 1\nForensic procedures  Part 7\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(vi) the content of those undertakings;",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-119-norm"
        }
      ],
      "cml:integrityHash": "170651ec4a4592deedf77bbd0b3a5e9e216cb96da289da56786550cee51cfe18",
      "skos:note": "International tribunal undertakings for forensic evidence"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-119",
      "@type": "cof:Section",
      "cof:title": "119 After paragraph 23XWR(2)(da)",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "Insert:\n\n(db) if the volunteer undergoes a forensic procedure because of a\nrequest by a foreign law enforcement agency responsible to\nan international tribunal—the following:\n\n(i) the name of the international tribunal for which the\nrequest was made;\n\n(ii) that forensic evidence resulting from the forensic\nprocedure will be provided to the agency;\n\n(iii) that the forensic evidence may be used in proceedings in\nthe international tribunal;\n\n(iv) that the retention of the forensic evidence will be\ngoverned by the rules of the international tribunal;\n\n(v) that the retention of the forensic evidence will be subject\nto undertakings given by the agency;\n\nAssistance to international courts and tribunals  Schedule 1\nForensic procedures  Part 7\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(vi) the content of those undertakings;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-119-norm",
