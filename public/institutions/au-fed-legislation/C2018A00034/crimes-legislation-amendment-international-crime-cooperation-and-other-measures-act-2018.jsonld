    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102b",
      "@type": "cml:Concept",
      "skos:prefLabel": "102B Report regarding international requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-102b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.14",
      "values:originalText": "The report must set out the number of occasions on which lawfully\nintercepted information or interception warrant information was\ncommunicated to any of the following:\n\n(a) a foreign country under paragraph 68(l) or section 68A;\n\n(b) the International Criminal Court under paragraph 68(la) or\nsection 68A;\n\nAssistance to international courts and tribunals  Schedule 1\nLawfully obtained material  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(c) a War Crimes Tribunal under paragraph 68(lb) or\nsection 68A.",
      "skos:definition": "The report must set out the number of occasions on which lawfully\nintercepted information or interception warrant information was\ncommunicated to any of the following:\n\n(a) a foreign country under paragraph 68(l) or section 68A;\n\n(b) the International Criminal Court under paragraph 68(la) or\nsection 68A;\n\nAssistance to international courts and tribunals  Schedule 1\nLawfully obtained material  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(c) a War Crimes Tribunal under paragraph 68(lb) or\nsection 68A.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102b-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b60bbff5501b6d7d96cd252f6f4d088f8683f370ced06c8304c11c27b9a80a4c",
      "skos:note": "Report must set out communication of intercepted information to certain entities.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-102b",
      "@type": "cof:Section",
      "cof:title": "102B Report regarding international requests",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The report must set out the number of occasions on which lawfully\nintercepted information or interception warrant information was\ncommunicated to any of the following:\n\n(a) a foreign country under paragraph 68(l) or section 68A;\n\n(b) the International Criminal Court under paragraph 68(la) or\nsection 68A;\n\nAssistance to international courts and tribunals  Schedule 1\nLawfully obtained material  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(c) a War Crimes Tribunal under paragraph 68(lb) or\nsection 68A."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102b"
      },
      "values:deonticStatus": {
