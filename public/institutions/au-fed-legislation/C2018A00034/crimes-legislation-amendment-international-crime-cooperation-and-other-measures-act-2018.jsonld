      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.86",
      "values:originalText": "Repeal the subsection, substitute:\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(2) A registration effected by a court registering a copy of a sealed\ncopy ceases to have effect after 45 days unless the sealed copy has\nbeen filed by then in that court.",
      "skos:definition": "Repeal the subsection, substitute:\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(2) A registration effected by a court registering a copy of a sealed\ncopy ceases to have effect after 45 days unless the sealed copy has\nbeen filed by then in that court.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-210-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-210-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bc4f5d80d5be6fa97749ebf89771a48e3871588981a2b9506e941245bd1c66c3",
      "skos:note": "Ceases effect after 45 days unless sealed copy is filed"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-210",
      "@type": "cof:Section",
      "cof:title": "210 Subsection 46(2)",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "Repeal the subsection, substitute:\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(2) A registration effected by a court registering a copy of a sealed\ncopy ceases to have effect after 45 days unless the sealed copy has\nbeen filed by then in that court."
    },
