    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AA Application of Division",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.73",
      "values:originalText": "This Division applies if:\n\n(a) a Tribunal makes a request (a proceeds request) to the\nAttorney-General for the identification, tracing, and freezing\nor seizure, of the proceeds of a Tribunal offence; and\n\n(b) the Attorney-General is satisfied that a person (the\ndefendant):\n\n(i) has been, or is about to be, charged with the Tribunal\noffence before the Tribunal; or\n\n(ii) has been convicted by the Tribunal of the Tribunal\noffence.",
      "skos:definition": "This Division applies if:\n\n(a) a Tribunal makes a request (a proceeds request) to the\nAttorney-General for the identification, tracing, and freezing\nor seizure, of the proceeds of a Tribunal offence; and\n\n(b) the Attorney-General is satisfied that a person (the\ndefendant):\n\n(i) has been, or is about to be, charged with the Tribunal\noffence before the Tribunal; or\n\n(ii) has been convicted by the Tribunal of the Tribunal\noffence.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aa-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aa-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aa-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aa-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aa-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aa-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "eb4be67265f5fb30dd7059cac19a74da1acbb36552ac4efc44bdea93da52b56d",
      "skos:note": "Request for Attorney-General to identify and freeze proceeds of Tribunal offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40aa",
      "@type": "cof:Section",
      "cof:title": "40AA Application of Division",
      "values:kind": "section",
      "cof:pageNumber": 73,
      "values:originalText": "This Division applies if:\n\n(a) a Tribunal makes a request (a proceeds request) to the\nAttorney-General for the identification, tracing, and freezing\nor seizure, of the proceeds of a Tribunal offence; and\n\n(b) the Attorney-General is satisfied that a person (the\ndefendant):\n\n(i) has been, or is about to be, charged with the Tribunal\noffence before the Tribunal; or\n\n(ii) has been convicted by the Tribunal of the Tribunal\noffence."
    },
    {
