    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-68a",
      "@type": "cml:Concept",
      "skos:prefLabel": "68A Communicating information obtained by the Secretary",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-68a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.14",
      "values:originalText": "(1) This section applies to information communicated to the Secretary\nof the Department as described in an item of the following table:\n\nInformation to which this section applies\nItem\nInformation communicated\nunder this provision:\nFor the purpose of providing it to\nthis entity:\nparagraph 68(l)\nthe foreign country concerned\nparagraph 68(la)\nthe International Criminal Court\nparagraph 68(lb)\nthe War Crimes Tribunal concerned\n\n(2) Each of the following:\n\n(a) the Secretary of the Department;\n\n(b) a person authorised by the Secretary;\n\n(c) a person or other entity to whom the information has been\ncommunicated under this subsection;\nmay communicate the information to another person or entity for\npurposes connected with providing the information to the entity\nmentioned in that table item.",
      "skos:definition": "(1) This section applies to information communicated to the Secretary\nof the Department as described in an item of the following table:\n\nInformation to which this section applies\nItem\nInformation communicated\nunder this provision:\nFor the purpose of providing it to\nthis entity:\nparagraph 68(l)\nthe foreign country concerned\nparagraph 68(la)\nthe International Criminal Court\nparagraph 68(lb)\nthe War Crimes Tribunal concerned\n\n(2) Each of the following:\n\n(a) the Secretary of the Department;\n\n(b) a person authorised by the Secretary;\n\n(c) a person or other entity to whom the information has been\ncommunicated under this subsection;\nmay communicate the information to another person or entity for\npurposes connected with providing the information to the entity\nmentioned in that table item.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-68a-ss-1"
        },
