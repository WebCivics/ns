    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aq",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AQ Contents of POCA search warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40aq"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.81",
      "values:originalText": "A POCA search warrant in relation to a Tribunal offence must state\nthat the warrant authorises the seizure of property or a thing found\nby an authorised officer, or a person assisting in relation to the\nwarrant, in the course of the search if the authorised officer or\nperson assisting believes on reasonable grounds that:\n\n(a) the property or thing:\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "A POCA search warrant in relation to a Tribunal offence must state\nthat the warrant authorises the seizure of property or a thing found\nby an authorised officer, or a person assisting in relation to the\nwarrant, in the course of the search if the authorised officer or\nperson assisting believes on reasonable grounds that:\n\n(a) the property or thing:\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aq-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aq-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "936618ac51cece92c290450e298313f6230d1b36d818c76b83c651175a9c6f82",
      "skos:note": "POCA search warrant must state authorisation for seizure of property or thing found during search."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40aq",
      "@type": "cof:Section",
      "cof:title": "40AQ Contents of POCA search warrants",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "A POCA search warrant in relation to a Tribunal offence must state\nthat the warrant authorises the seizure of property or a thing found\nby an authorised officer, or a person assisting in relation to the\nwarrant, in the course of the search if the authorised officer or\nperson assisting believes on reasonable grounds that:\n\n(a) the property or thing:\n\nSchedule 1  Assistance to international courts and tribunals"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40aq-norm",
