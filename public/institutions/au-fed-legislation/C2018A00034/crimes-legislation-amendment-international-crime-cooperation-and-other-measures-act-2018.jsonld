    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-127",
      "@type": "cml:Concept",
      "skos:prefLabel": "127 Section 23YKA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-127"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.50",
      "values:originalText": "Repeal the section, substitute:\n23YKA  Application of sections 23YI to 23YK\n\nTo avoid doubt, sections 23YI to 23YK do not apply in relation to\na proceeding in a foreign country or international tribunal in which\nforensic evidence is provided in response to a request by:\n\n(a) a foreign country; or\n\n(b) an international tribunal; or\n\n(c) a foreign law enforcement agency.",
      "skos:definition": "Repeal the section, substitute:\n23YKA  Application of sections 23YI to 23YK\n\nTo avoid doubt, sections 23YI to 23YK do not apply in relation to\na proceeding in a foreign country or international tribunal in which\nforensic evidence is provided in response to a request by:\n\n(a) a foreign country; or\n\n(b) an international tribunal; or\n\n(c) a foreign law enforcement agency.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-127-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-127-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "842ba04c078843d6096844f379b4f5e37a391e59a1d0556c9e6b2b626ed0a25e",
      "skos:note": "Sections 23YI to 23YK do not apply in certain foreign proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-127",
      "@type": "cof:Section",
      "cof:title": "127 Section 23YKA",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Repeal the section, substitute:\n23YKA  Application of sections 23YI to 23YK\n\nTo avoid doubt, sections 23YI to 23YK do not apply in relation to\na proceeding in a foreign country or international tribunal in which\nforensic evidence is provided in response to a request by:\n\n(a) a foreign country; or\n\n(b) an international tribunal; or\n\n(c) a foreign law enforcement agency."
    },
