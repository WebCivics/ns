    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-50",
      "@type": "cml:Concept",
      "skos:prefLabel": "50 Paragraph 139(2)(e)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-50"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.24",
      "values:originalText": "Repeal the paragraph, substitute:\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(e) an authorisation under any of the following provisions in\nrespect of the information:\n\n(i) subsection 13A(1) of the Mutual Assistance in Criminal\nMatters Act 1987;\n\n(ii) section 69A of the International Criminal Court Act\n2002;\n\n(iii) section 25A of the International War Crimes Tribunals\nAct 1995.",
      "skos:definition": "Repeal the paragraph, substitute:\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(e) an authorisation under any of the following provisions in\nrespect of the information:\n\n(i) subsection 13A(1) of the Mutual Assistance in Criminal\nMatters Act 1987;\n\n(ii) section 69A of the International Criminal Court Act\n2002;\n\n(iii) section 25A of the International War Crimes Tribunals\nAct 1995.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-50-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-50-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "92129b708c966d48445338e8a254ecbbb4d65a884a0960506fa244da4297c498",
      "skos:note": "Repeal paragraph 139(2)(e) and substitute with new provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-50",
      "@type": "cof:Section",
      "cof:title": "50 Paragraph 139(2)(e)",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "Repeal the paragraph, substitute:\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(e) an authorisation under any of the following provisions in\nrespect of the information:\n\n(i) subsection 13A(1) of the Mutual Assistance in Criminal\nMatters Act 1987;\n\n(ii) section 69A of the International Criminal Court Act\n2002;\n\n(iii) section 25A of the International War Crimes Tribunals\nAct 1995."
    },
