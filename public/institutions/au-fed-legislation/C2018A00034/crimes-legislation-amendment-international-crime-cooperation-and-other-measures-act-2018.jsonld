      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.62",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) An authorised officer may apply for a monitoring order under the\nProceeds of Crime Act in respect of the crime that is the subject of\nthe proceeds request, if authorised to do so by the\nAttorney-General under section 81A.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) An authorised officer may apply for a monitoring order under the\nProceeds of Crime Act in respect of the crime that is the subject of\nthe proceeds request, if authorised to do so by the\nAttorney-General under section 81A.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-168-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-168-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2328e3619fa00b82e480cccc56e2c8eb48733becee11226956db3158d2b71ae2",
      "skos:note": "Authorized officer may apply for monitoring order under Proceeds of Crime Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-168",
      "@type": "cof:Section",
      "cof:title": "168 Subsection 95(1)",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) An authorised officer may apply for a monitoring order under the\nProceeds of Crime Act in respect of the crime that is the subject of\nthe proceeds request, if authorised to do so by the\nAttorney-General under section 81A."
    },
