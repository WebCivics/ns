    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-118",
      "@type": "cof:Section",
      "cof:title": "118 Paragraph 23XWR(2)(da)",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "After “a foreign law enforcement agency”, insert “(other than an agency\nresponsible to an international tribunal)”."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-118-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
