    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-139",
      "@type": "cml:Concept",
      "skos:prefLabel": "139 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-139"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.57",
      "values:originalText": "The amendments made by this Part apply in relation to a request made\nto the Attorney-General by the ICC, a Tribunal, a foreign country or a\nforeign law enforcement agency:\n\n(a) on or after the commencement of this item; or\n\n(b) before the commencement of this item, if, immediately\nbefore that commencement, the Attorney-General had yet to\nmake a decision on the request;\nwhether conduct, a crime or an offence to which the request relates\noccurred before, on or after that commencement.\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "The amendments made by this Part apply in relation to a request made\nto the Attorney-General by the ICC, a Tribunal, a foreign country or a\nforeign law enforcement agency:\n\n(a) on or after the commencement of this item; or\n\n(b) before the commencement of this item, if, immediately\nbefore that commencement, the Attorney-General had yet to\nmake a decision on the request;\nwhether conduct, a crime or an offence to which the request relates\noccurred before, on or after that commencement.\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-139-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-139-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c87fbc13afe22e8a3d9d062f2be4efb4fbda3c828ca529087f8b609b1167918f",
      "skos:note": "Amendments apply to requests made by ICC, Tribunal, foreign country or law enforcement agency."
    },
    {
