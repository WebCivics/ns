    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-94",
      "@type": "cml:Concept",
      "skos:prefLabel": "94 Paragraph 21(5)(c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-94"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.41",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) if the warrant was issued in relation to an international\nassistance authorisation—of enabling evidence to be obtained\nof:\n\n(i) the commission of any offence to which the\nauthorisation relates; or\n\n(ii) the identity or location of the persons suspected of\ncommitting the offence;",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(c) if the warrant was issued in relation to an international\nassistance authorisation—of enabling evidence to be obtained\nof:\n\n(i) the commission of any offence to which the\nauthorisation relates; or\n\n(ii) the identity or location of the persons suspected of\ncommitting the offence;",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-94-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-94-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ba97ec39c2465a298a61a41197a327d8db1fd5e869ff09848be727fe0fb46155",
      "skos:note": "Repeal paragraph and substitute with new provision"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-94",
      "@type": "cof:Section",
      "cof:title": "94 Paragraph 21(5)(c)",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) if the warrant was issued in relation to an international\nassistance authorisation—of enabling evidence to be obtained\nof:\n\n(i) the commission of any offence to which the\nauthorisation relates; or\n\n(ii) the identity or location of the persons suspected of\ncommitting the offence;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-94-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
