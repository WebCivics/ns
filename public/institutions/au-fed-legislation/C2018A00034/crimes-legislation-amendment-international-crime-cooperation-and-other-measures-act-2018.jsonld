    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-99-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "99 Contents of POCA search warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-99-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.64",
      "values:originalText": "A POCA search warrant in relation to a crime within the\njurisdiction of the ICC must state that the warrant authorises the\nseizure of property or a thing found by an authorised officer, or a\nperson assisting in relation to the warrant, in the course of the\nsearch if the authorised officer or person assisting believes on\nreasonable grounds that:\n\n(a) the property or thing:\n\n(i) is proceeds of the crime that are not of a kind specified\nin the warrant; or\n\n(ii) is evidential material relating to the crime that is not of\na kind specified in the warrant; or\n\n(iii) is proceeds of, or evidential material relating to, another\ncrime within the jurisdiction of the ICC in relation to\nwhich a POCA search warrant is in force; or\n\n(iv) is relevant to a proceeding in the ICC in respect of the\ncrime within the jurisdiction of the ICC; or\n\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 98(3)(d), the POCA search warrant must also\nstate the matters set out in section 227 of the Proceeds of Crime Act.",
      "skos:definition": "A POCA search warrant in relation to a crime within the\njurisdiction of the ICC must state that the warrant authorises the\nseizure of property or a thing found by an authorised officer, or a\nperson assisting in relation to the warrant, in the course of the\nsearch if the authorised officer or person assisting believes on\nreasonable grounds that:\n\n(a) the property or thing:\n\n(i) is proceeds of the crime that are not of a kind specified\nin the warrant; or\n\n(ii) is evidential material relating to the crime that is not of\na kind specified in the warrant; or\n\n(iii) is proceeds of, or evidential material relating to, another\ncrime within the jurisdiction of the ICC in relation to\nwhich a POCA search warrant is in force; or\n\n(iv) is relevant to a proceeding in the ICC in respect of the\ncrime within the jurisdiction of the ICC; or\n\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 98(3)(d), the POCA search warrant must also\nstate the matters set out in section 227 of the Proceeds of Crime Act.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-99-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-99-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-99-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-99-2-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-99-2-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "ecc33a672d2259072387e310bdbaa9cdbd088b034bfb637973417bfd037f8b86",
      "skos:note": "POCA search warrant must state that the warrant authorises the seizure of property or a thing found by an authorised officer, or a person assisting in relation to the warrant.",
      "dc:description": "The matters set out in section 227 of the Proceeds of Crime Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-99-2",
      "@type": "cof:Section",
      "cof:title": "99 Contents of POCA search warrants",
      "values:kind": "section",
      "cof:pageNumber": 64,
      "values:originalText": "A POCA search warrant in relation to a crime within the\njurisdiction of the ICC must state that the warrant authorises the\nseizure of property or a thing found by an authorised officer, or a\nperson assisting in relation to the warrant, in the course of the\nsearch if the authorised officer or person assisting believes on\nreasonable grounds that:\n\n(a) the property or thing:\n\n(i) is proceeds of the crime that are not of a kind specified\nin the warrant; or\n\n(ii) is evidential material relating to the crime that is not of\na kind specified in the warrant; or\n\n(iii) is proceeds of, or evidential material relating to, another\ncrime within the jurisdiction of the ICC in relation to\nwhich a POCA search warrant is in force; or\n\n(iv) is relevant to a proceeding in the ICC in respect of the\ncrime within the jurisdiction of the ICC; or\n\n(v) will afford evidence as to the commission of an offence\nagainst an Australian law; and\n\n(b) the seizure of the property or thing is necessary to prevent its\nconcealment, loss or destruction or its use in committing an\noffence.\nNote:\nSubject to paragraph 98(3)(d), the POCA search warrant must also\nstate the matters set out in section 227 of the Proceeds of Crime Act."
    },
