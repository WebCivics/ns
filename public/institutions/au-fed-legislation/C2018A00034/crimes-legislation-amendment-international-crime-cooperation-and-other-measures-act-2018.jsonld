      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.88",
      "values:originalText": "The amendments made by this Part apply in relation to giving help on\nor after the commencement of this item, whether conduct, a crime or an\noffence to which the help relates occurred before, on or after that\ncommencement.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nSearch warrants  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "skos:definition": "The amendments made by this Part apply in relation to giving help on\nor after the commencement of this item, whether conduct, a crime or an\noffence to which the help relates occurred before, on or after that\ncommencement.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nSearch warrants  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-215-norm"
        }
      ],
      "cml:integrityHash": "5d70deb8f30a41ffbf6483d6d67df2634b31c945754e1cb251d8dab454348c2a",
      "skos:note": "Amendments apply in relation to giving help on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-215",
      "@type": "cof:Section",
      "cof:title": "215 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 88,
      "values:originalText": "The amendments made by this Part apply in relation to giving help on\nor after the commencement of this item, whether conduct, a crime or an\noffence to which the help relates occurred before, on or after that\ncommencement.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nSearch warrants  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018"
    },
