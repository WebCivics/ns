    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-58",
      "@type": "cml:Concept",
      "skos:prefLabel": "58 At the end of section 162",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-58"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.26",
      "values:originalText": "Add:\n\n(3) An international offence, for an enforcement agency, is:\n\n(a) an offence against a law of a foreign country; or\n\n(b) a crime within the jurisdiction of the ICC; or\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(c) a War Crimes Tribunal offence;\nin respect of which a stored communications warrant was issued as\na result of an international assistance application made by the\nagency during the year.",
      "skos:definition": "Add:\n\n(3) An international offence, for an enforcement agency, is:\n\n(a) an offence against a law of a foreign country; or\n\n(b) a crime within the jurisdiction of the ICC; or\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(c) a War Crimes Tribunal offence;\nin respect of which a stored communications warrant was issued as\na result of an international assistance application made by the\nagency during the year.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-58-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-58-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-58-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-58-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-58-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-58-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "c3df93d4d9befdc4377884adeede37698b9a7f2e4c99191cc423847887e01281",
      "skos:note": "An international offence for an enforcement agency is defined as an offence against a law of a foreign country, a crime within the jurisdiction of the ICC, or a War Crimes Tribunal offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-58",
      "@type": "cof:Section",
      "cof:title": "58 At the end of section 162",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Add:\n\n(3) An international offence, for an enforcement agency, is:\n\n(a) an offence against a law of a foreign country; or\n\n(b) a crime within the jurisdiction of the ICC; or\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(c) a War Crimes Tribunal offence;\nin respect of which a stored communications warrant was issued as\na result of an international assistance application made by the\nagency during the year."
    },
