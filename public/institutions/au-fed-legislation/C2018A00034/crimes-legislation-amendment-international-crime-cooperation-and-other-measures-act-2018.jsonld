    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Subsection 34ZD(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.92",
      "values:originalText": "Omit “head of the authorised officer’s enforcement agency”, substitute\n“responsible enforcement agency head”.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nSearch warrants  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "skos:definition": "Omit “head of the authorised officer’s enforcement agency”, substitute\n“responsible enforcement agency head”.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nSearch warrants  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-13-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "118748af2b3149cfccad87d4657678e869a57c23d3dcff1d2c6dd25d5f725a98",
      "skos:note": "Replace 'head of the authorised officer’s enforcement agency' with 'responsible enforcement agency head'."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Subsection 34ZD(4)",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "Omit “head of the authorised officer’s enforcement agency”, substitute\n“responsible enforcement agency head”.\n\nAmendments relating to mutual assistance in criminal matters  Schedule 2\nSearch warrants  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-13-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-13"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Replace",
      "cml:logicSummary": "Replace the term",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The term needs to be replaced.",
      "cml:conclusionText": "The new term is 'responsible enforcement agency head'."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Subsection 34ZD(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.93",
      "values:originalText": "Repeal the subsection, substitute:\n\n(5) This section does not apply to property that has been seized under a\nPOCA search warrant because:\n\n(a) it is evidential material; or\n\n(b) it is property of a kind referred to in\nsubparagraph 34ZCA(a)(iv) or (v).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(5) This section does not apply to property that has been seized under a\nPOCA search warrant because:\n\n(a) it is evidential material; or\n\n(b) it is property of a kind referred to in\nsubparagraph 34ZCA(a)(iv) or (v).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-14-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-14-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "08dda1f52140f70e419ae9f59a41d736d1506bade983eddd995ec6615b15fc80",
      "skos:note": "Property seized under POCA search warrant is exempt from this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Subsection 34ZD(5)",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "Repeal the subsection, substitute:\n\n(5) This section does not apply to property that has been seized under a\nPOCA search warrant because:\n\n(a) it is evidential material; or\n\n(b) it is property of a kind referred to in\nsubparagraph 34ZCA(a)(iv) or (v)."
    },
