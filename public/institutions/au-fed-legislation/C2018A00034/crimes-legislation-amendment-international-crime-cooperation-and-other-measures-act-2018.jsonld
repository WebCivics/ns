      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ak",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AK Making false statements in applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ak"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.78",
      "values:originalText": "A person commits an offence if:\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n\n(b) the statement:\n\n(i) is false or misleading; or\n\n(ii) omits any matter or thing without which the statement is\nmisleading; and\n\n(c) the statement is made in, or in connection with, a notice\nunder section 40AH.\nPenalty: Imprisonment for 12 months or 60 penalty units, or both.",
      "skos:definition": "A person commits an offence if:\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n\n(b) the statement:\n\n(i) is false or misleading; or\n\n(ii) omits any matter or thing without which the statement is\nmisleading; and\n\n(c) the statement is made in, or in connection with, a notice\nunder section 40AH.\nPenalty: Imprisonment for 12 months or 60 penalty units, or both.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ak-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ak-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bebfc6e15ccccfcd5330d1aced68b64ac95d1a7cc96fb1c2d769b0e9b2d5e5e2",
      "skos:note": "Making false statements in applications is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ak",
      "@type": "cof:Section",
      "cof:title": "40AK Making false statements in applications",
      "values:kind": "section",
      "cof:pageNumber": 78,
      "values:originalText": "A person commits an offence if:\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(a) the person makes a statement (whether orally, in a document\nor in any other way); and\n\n(b) the statement:\n\n(i) is false or misleading; or\n\n(ii) omits any matter or thing without which the statement is\nmisleading; and\n\n(c) the statement is made in, or in connection with, a notice\nunder section 40AH.\nPenalty: Imprisonment for 12 months or 60 penalty units, or both."
    },
    {
