      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.26",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(e) for each international offence for each enforcement agency—\nthe offence (if any), under a law of the Commonwealth, a\nState or a Territory, that is of the same, or a substantially\nsimilar, nature to the international offence.",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(e) for each international offence for each enforcement agency—\nthe offence (if any), under a law of the Commonwealth, a\nState or a Territory, that is of the same, or a substantially\nsimilar, nature to the international offence.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-57-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-57-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e64222112717e6a3731fd6b9f89b5c14e92adde111c0f5eaa2f3c42b99465a3e",
      "skos:note": "Substitute international offence with a similar or substantially similar law of the Commonwealth, State or Territory."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-57",
      "@type": "cof:Section",
      "cof:title": "57 Paragraph 162(2)(e)",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(e) for each international offence for each enforcement agency—\nthe offence (if any), under a law of the Commonwealth, a\nState or a Territory, that is of the same, or a substantially\nsimilar, nature to the international offence."
    },
