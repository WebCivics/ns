    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "102 Dealing with evidential material and certain property or things",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-102-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.67",
      "values:originalText": "seized under POCA search warrants\n\n(1) This section applies if:\n\n(a) property or a thing (the seized item) is seized under a POCA\nsearch warrant in relation to a crime within the jurisdiction of\nthe ICC; and\n\n(b) the seized item is:\n\n(i) evidential material; or\n\n(ii) property or a thing of a kind referred to in\nsubparagraph 99A(a)(iv); and\n\n(c) the seized item is seized by a person (the seizing officer) who\nis:\n\n(i) an authorised officer; or\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "seized under POCA search warrants\n\n(1) This section applies if:\n\n(a) property or a thing (the seized item) is seized under a POCA\nsearch warrant in relation to a crime within the jurisdiction of\nthe ICC; and\n\n(b) the seized item is:\n\n(i) evidential material; or\n\n(ii) property or a thing of a kind referred to in\nsubparagraph 99A(a)(iv); and\n\n(c) the seized item is seized by a person (the seizing officer) who\nis:\n\n(i) an authorised officer; or\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-2-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-2-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-2-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-2-logic-alleninterval-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-2-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "896d762c5e22201cb32245d4697035f1f4c062727cc946db0dc3e7c5066da980",
      "skos:note": "Seized item must be evidential material or property of a kind referred to in subsection 99A(a)(iv)"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-102-2",
