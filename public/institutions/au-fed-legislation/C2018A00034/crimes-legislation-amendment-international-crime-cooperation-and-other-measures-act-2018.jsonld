    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Subsection 5(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.20",
      "values:originalText": "Insert:\nserious foreign contravention means:\n\n(a) a contravention of a law of a foreign country that is\npunishable by a maximum penalty of:\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(i) imprisonment for 3 years or more, imprisonment for life\nor the death penalty; or\n\n(ii) a fine of an amount that is at least equivalent to 900\npenalty units; or\n\n(b) a crime within the jurisdiction of the ICC; or\n\n(c) a War Crimes Tribunal offence.\nWar Crimes Tribunal offence has the same meaning as Tribunal\noffence in the International War Crimes Tribunals Act 1995.",
      "skos:definition": "Insert:\nserious foreign contravention means:\n\n(a) a contravention of a law of a foreign country that is\npunishable by a maximum penalty of:\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(i) imprisonment for 3 years or more, imprisonment for life\nor the death penalty; or\n\n(ii) a fine of an amount that is at least equivalent to 900\npenalty units; or\n\n(b) a crime within the jurisdiction of the ICC; or\n\n(c) a War Crimes Tribunal offence.\nWar Crimes Tribunal offence has the same meaning as Tribunal\noffence in the International War Crimes Tribunals Act 1995.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-32-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-32-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-32-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "c0720125db82847d2fcd417b9c3c68c4b9d0fb9584a689e1b713542f0616756a",
      "skos:note": "Definition of serious foreign contravention"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Subsection 5(1)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Insert:\nserious foreign contravention means:\n\n(a) a contravention of a law of a foreign country that is\npunishable by a maximum penalty of:\n\nAssistance to international courts and tribunals  Schedule 1\nCovert access to stored communications  Part 3\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(i) imprisonment for 3 years or more, imprisonment for life\nor the death penalty; or\n\n(ii) a fine of an amount that is at least equivalent to 900\npenalty units; or\n\n(b) a crime within the jurisdiction of the ICC; or\n\n(c) a War Crimes Tribunal offence.\nWar Crimes Tribunal offence has the same meaning as Tribunal\noffence in the International War Crimes Tribunals Act 1995."
    },
