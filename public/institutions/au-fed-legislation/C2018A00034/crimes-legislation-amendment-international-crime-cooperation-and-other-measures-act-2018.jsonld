    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 After paragraph 68(l)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.13",
      "values:originalText": "Insert:\n\n(la) if the Attorney-General has authorised the provision of the\ninformation to the International Criminal Court under\nsection 69A of the International Criminal Court Act 2002—\nto:\n\n(i) that Court; or\n\n(ii) the Secretary of the Department for the purpose of\nproviding the information to that Court; and\n\n(lb) if the Attorney-General has authorised the provision of the\ninformation to a War Crimes Tribunal under section 25A of\nthe International War Crimes Tribunals Act 1995—to:\n\n(i) that Tribunal; or\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "Insert:\n\n(la) if the Attorney-General has authorised the provision of the\ninformation to the International Criminal Court under\nsection 69A of the International Criminal Court Act 2002—\nto:\n\n(i) that Court; or\n\n(ii) the Secretary of the Department for the purpose of\nproviding the information to that Court; and\n\n(lb) if the Attorney-General has authorised the provision of the\ninformation to a War Crimes Tribunal under section 25A of\nthe International War Crimes Tribunals Act 1995—to:\n\n(i) that Tribunal; or\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-8-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-8-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-8-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a31b2da8b1122dff884a9c6470321139a7ee397ca70d1bbdef730cef7850b0a8",
      "skos:note": "Authorisation for provision of information to international courts and tribunals"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 After paragraph 68(l)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Insert:\n\n(la) if the Attorney-General has authorised the provision of the\ninformation to the International Criminal Court under\nsection 69A of the International Criminal Court Act 2002—\nto:\n\n(i) that Court; or\n\n(ii) the Secretary of the Department for the purpose of\nproviding the information to that Court; and\n\n(lb) if the Attorney-General has authorised the provision of the\ninformation to a War Crimes Tribunal under section 25A of\nthe International War Crimes Tribunals Act 1995—to:\n\n(i) that Tribunal; or\n\nSchedule 1  Assistance to international courts and tribunals"
    },
