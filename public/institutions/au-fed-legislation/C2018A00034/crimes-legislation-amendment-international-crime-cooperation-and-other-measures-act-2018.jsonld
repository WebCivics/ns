    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 At the end of section 271.11A of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.111",
      "values:originalText": "Add:\n\n(5) In this section:\nfamily member of a person means:\n\n(a) the person’s spouse or de facto partner; or\n\n(b) a parent, step-parent or grandparent of the person; or\n\n(c) a child, step-child or grandchild of the person; or\n\n(d) a brother, sister, step-brother or step-sister of the person; or\n\n(e) a guardian or carer of the person.\n\nSchedule 6  Slavery-like offences and relevant evidence",
      "skos:definition": "Add:\n\n(5) In this section:\nfamily member of a person means:\n\n(a) the person’s spouse or de facto partner; or\n\n(b) a parent, step-parent or grandparent of the person; or\n\n(c) a child, step-child or grandchild of the person; or\n\n(d) a brother, sister, step-brother or step-sister of the person; or\n\n(e) a guardian or carer of the person.\n\nSchedule 6  Slavery-like offences and relevant evidence",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-30-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-30-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-30-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "7b80a758b2703af13dfaf1703d8b8e7c15812dc6cb82347df363454163d5c6de",
      "skos:note": "Defines family member for section 271.11A of the Criminal Code"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-30",
      "@type": "cof:Section",
      "cof:title": "30 At the end of section 271.11A of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 111,
      "values:originalText": "Add:\n\n(5) In this section:\nfamily member of a person means:\n\n(a) the person’s spouse or de facto partner; or\n\n(b) a parent, step-parent or grandparent of the person; or\n\n(c) a child, step-child or grandchild of the person; or\n\n(d) a brother, sister, step-brother or step-sister of the person; or\n\n(e) a guardian or carer of the person.\n\nSchedule 6  Slavery-like offences and relevant evidence"
    },
