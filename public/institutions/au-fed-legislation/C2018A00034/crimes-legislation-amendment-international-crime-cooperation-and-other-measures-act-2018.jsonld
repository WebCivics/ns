    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-156",
      "@type": "cml:Concept",
      "skos:prefLabel": "156 Subsection 86(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-156"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.60",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) An authorised officer may apply for a production order under the\nProceeds of Crime Act in respect of the crime that is the subject of\nthe proceeds request, if authorised to do so by the\nAttorney-General under section 81A.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) An authorised officer may apply for a production order under the\nProceeds of Crime Act in respect of the crime that is the subject of\nthe proceeds request, if authorised to do so by the\nAttorney-General under section 81A.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-156-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-156-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3b7084cb5273f104c0714ad8ad597971144cce87e240c1fb9db7e426790a5982",
      "skos:note": "Authorized officer may apply for production order under the Proceeds of Crime Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-156",
      "@type": "cof:Section",
      "cof:title": "156 Subsection 86(1)",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) An authorised officer may apply for a production order under the\nProceeds of Crime Act in respect of the crime that is the subject of\nthe proceeds request, if authorised to do so by the\nAttorney-General under section 81A.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018"
    },
