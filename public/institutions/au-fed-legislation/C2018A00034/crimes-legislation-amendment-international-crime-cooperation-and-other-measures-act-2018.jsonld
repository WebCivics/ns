    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-88",
      "@type": "cml:Concept",
      "skos:prefLabel": "88 Subsection 14(3A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-88"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.40",
      "values:originalText": "Repeal the subsection, substitute:\nWarrants sought for international assistance investigations\n\n(3A) A law enforcement officer (or a person on his or her behalf) may\napply for the issue of a surveillance device warrant if he or she:\n\n(a) is authorised to do so under an international assistance\nauthorisation; and\n\n(b) suspects on reasonable grounds that the use of a surveillance\ndevice is necessary, in the course of the investigation,\nproceeding or investigative proceeding to which the\nauthorisation relates, for the purpose of enabling evidence to\nbe obtained of:\n\n(i) the commission of an offence to which the authorisation\nrelates; or\n\n(ii) the identity or location of the persons suspected of\ncommitting the offence.",
      "skos:definition": "Repeal the subsection, substitute:\nWarrants sought for international assistance investigations\n\n(3A) A law enforcement officer (or a person on his or her behalf) may\napply for the issue of a surveillance device warrant if he or she:\n\n(a) is authorised to do so under an international assistance\nauthorisation; and\n\n(b) suspects on reasonable grounds that the use of a surveillance\ndevice is necessary, in the course of the investigation,\nproceeding or investigative proceeding to which the\nauthorisation relates, for the purpose of enabling evidence to\nbe obtained of:\n\n(i) the commission of an offence to which the authorisation\nrelates; or\n\n(ii) the identity or location of the persons suspected of\ncommitting the offence.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-88-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-88-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "223bf30df868fcb225bb7768d5020103b6f6cc4e6291c447b0b045ef58d4b02f",
      "skos:note": "Law enforcement officer may apply for surveillance device warrant under international assistance authorization."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-88",
      "@type": "cof:Section",
      "cof:title": "88 Subsection 14(3A)",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "Repeal the subsection, substitute:\nWarrants sought for international assistance investigations\n\n(3A) A law enforcement officer (or a person on his or her behalf) may\napply for the issue of a surveillance device warrant if he or she:\n\n(a) is authorised to do so under an international assistance\nauthorisation; and\n\n(b) suspects on reasonable grounds that the use of a surveillance\ndevice is necessary, in the course of the investigation,\nproceeding or investigative proceeding to which the\nauthorisation relates, for the purpose of enabling evidence to\nbe obtained of:\n\n(i) the commission of an offence to which the authorisation\nrelates; or\n\n(ii) the identity or location of the persons suspected of\ncommitting the offence."
    },
