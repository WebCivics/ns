    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AL Disclosing existence or nature of notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40al"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.79",
      "values:originalText": "A person commits an offence if:\n\n(a) the person is given a notice under section 40AH; and\n\n(b) the notice states that information about the notice must not be\ndisclosed; and\n\n(c) the person discloses the existence or nature of the notice.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both.",
      "skos:definition": "A person commits an offence if:\n\n(a) the person is given a notice under section 40AH; and\n\n(b) the notice states that information about the notice must not be\ndisclosed; and\n\n(c) the person discloses the existence or nature of the notice.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "219c36407e587108b6c3bdceedae60eeaf5d66e6d775d5bf4582e5f7702dbe7f",
      "skos:note": "Disclosing existence or nature of notice is prohibited after receiving a notice under section 40AH."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40al",
      "@type": "cof:Section",
      "cof:title": "40AL Disclosing existence or nature of notice",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "A person commits an offence if:\n\n(a) the person is given a notice under section 40AH; and\n\n(b) the notice states that information about the notice must not be\ndisclosed; and\n\n(c) the person discloses the existence or nature of the notice.\nPenalty: Imprisonment for 2 years or 120 penalty units, or both."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of disclosing existence or nature of notice.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Given a notice under section 40AH, the person must not disclose its existence or nature.",
      "cml:conclusionText": "Disclosing existence or nature of notice is prohibited."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of disclosing existence or nature of notice.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person commits an offence if they disclose the existence or nature of the notice.",
      "cml:conclusionText": "Disclosing existence or nature of notice is prohibited."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40al-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of disclosing existence or nature of notice in a linear temporal context.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person must not disclose the existence or nature of the notice at any point in time.",
      "cml:conclusionText": "Disclosing existence or nature of notice is prohibited in a linear temporal context."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40am",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AM Failing to comply with a notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40am"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.79",
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person is given a notice under section 40AH; and\n\n(b) the person fails to comply with the notice.\nPenalty: Imprisonment for 2 years or 100 penalty units, or both.\n\n(2) Subsection (1) does not apply if:\n\n(a) the person fails to comply with the notice only because the\nperson does not provide information or a document within\nthe period specified in the notice; and\n\n(b) the person took all reasonable steps to provide the\ninformation or document within that period; and\n\n(c) the person provides the information or document as soon as\npracticable after the end of that period.\nNote 1:\nA defendant bears an evidential burden in relation to the matters in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "(1) A person commits an offence if:\n\n(a) the person is given a notice under section 40AH; and\n\n(b) the person fails to comply with the notice.\nPenalty: Imprisonment for 2 years or 100 penalty units, or both.\n\n(2) Subsection (1) does not apply if:\n\n(a) the person fails to comply with the notice only because the\nperson does not provide information or a document within\nthe period specified in the notice; and\n\n(b) the person took all reasonable steps to provide the\ninformation or document within that period; and\n\n(c) the person provides the information or document as soon as\npracticable after the end of that period.\nNote 1:\nA defendant bears an evidential burden in relation to the matters in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40am-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40am-ss-2"
        }
      ],
      "cml:integrityHash": "6b96a4676a1bc1394d78ea2d16a2a57530c01ff1d759c8383e4274a4b896d9fc"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40am",
      "@type": "cof:Section",
      "cof:title": "40AM Failing to comply with a notice",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "(1) A person commits an offence if:\n\n(a) the person is given a notice under section 40AH; and\n\n(b) the person fails to comply with the notice.\nPenalty: Imprisonment for 2 years or 100 penalty units, or both.\n\n(2) Subsection (1) does not apply if:\n\n(a) the person fails to comply with the notice only because the\nperson does not provide information or a document within\nthe period specified in the notice; and\n\n(b) the person took all reasonable steps to provide the\ninformation or document within that period; and\n\n(c) the person provides the information or document as soon as\npracticable after the end of that period.\nNote 1:\nA defendant bears an evidential burden in relation to the matters in\nsubsection (2) (see subsection 13.3(3) of the Criminal Code).\n\nSchedule 1  Assistance to international courts and tribunals"
    },
