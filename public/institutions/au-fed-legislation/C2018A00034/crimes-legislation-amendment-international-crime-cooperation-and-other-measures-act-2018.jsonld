      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-5-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 At the end of item 93 of Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-5-sec-6"
      },
      "cml:curationStatus": {
