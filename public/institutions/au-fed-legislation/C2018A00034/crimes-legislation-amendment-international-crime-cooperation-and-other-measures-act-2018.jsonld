    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-188",
      "@type": "cml:Concept",
      "skos:prefLabel": "188 Subsection 101(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-188"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.67",
      "values:originalText": "Repeal the subsection, substitute:\n\n(6) If the court is satisfied that the responsible enforcement agency\nhead requires the property to be retained to give effect to the\nproceeds request, the court may make an order that the responsible\nenforcement agency head may retain the property for so long as the\nproperty is so required.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(6) If the court is satisfied that the responsible enforcement agency\nhead requires the property to be retained to give effect to the\nproceeds request, the court may make an order that the responsible\nenforcement agency head may retain the property for so long as the\nproperty is so required.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-188-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-188-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9f5b79a451e58005488ba08c4acbf6453d2149bfff59f0a279ef1d660ae11a5b",
      "skos:note": "Court may order responsible agency head to retain property for as long as required."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-188",
      "@type": "cof:Section",
      "cof:title": "188 Subsection 101(6)",
      "values:kind": "section",
      "cof:pageNumber": 67,
      "values:originalText": "Repeal the subsection, substitute:\n\n(6) If the court is satisfied that the responsible enforcement agency\nhead requires the property to be retained to give effect to the\nproceeds request, the court may make an order that the responsible\nenforcement agency head may retain the property for so long as the\nproperty is so required."
    },
