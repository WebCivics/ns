      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.50",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(da) the purposes of assisting a foreign country or international\ntribunal to decide whether to make a request;\n\nAssistance to international courts and tribunals  Schedule 1\nForensic procedures  Part 7\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(da) the purposes of assisting a foreign country or international\ntribunal to decide whether to make a request;\n\nAssistance to international courts and tribunals  Schedule 1\nForensic procedures  Part 7\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-128-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-128-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "382667e7fe91ee17af885a99eb819415667dad6e7c59e6f4666c2af52a388710",
      "skos:note": "Repeal paragraph, substitute with new assistance to international courts and tribunals provision."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-128",
      "@type": "cof:Section",
      "cof:title": "128 Paragraph 23YO(2)(da)",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(da) the purposes of assisting a foreign country or international\ntribunal to decide whether to make a request;\n\nAssistance to international courts and tribunals  Schedule 1\nForensic procedures  Part 7\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018"
    },
