      },
      "cml:premiseText": "Paragraph 21(5)(c)",
      "cml:conclusionText": "No warrant can be issued for such purposes"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-95",
      "@type": "cml:Concept",
      "skos:prefLabel": "95 Paragraph 45(4)(f)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-95"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.41",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(f) the communication of information for the purpose of\nproviding it to one of the following entities (or to an\nappropriate authority of that entity):\n\n(i) a foreign country;\n\n(ii) the International Criminal Court;\n\n(iii) a War Crimes Tribunal;\n\nif the information was obtained under, or relates to, a\nsurveillance device warrant issued in relation to an\ninternational assistance authorisation requested by that entity;\nor\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(f) the communication of information for the purpose of\nproviding it to one of the following entities (or to an\nappropriate authority of that entity):\n\n(i) a foreign country;\n\n(ii) the International Criminal Court;\n\n(iii) a War Crimes Tribunal;\n\nif the information was obtained under, or relates to, a\nsurveillance device warrant issued in relation to an\ninternational assistance authorisation requested by that entity;\nor\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-95-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-95-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1c0a6d68c5a074ac0637da640849d72cd6ec280d119afaa4292003c82dc2a8a8",
      "skos:note": "Prohibit communication of information to certain entities without proper authorization."
    },
    {
