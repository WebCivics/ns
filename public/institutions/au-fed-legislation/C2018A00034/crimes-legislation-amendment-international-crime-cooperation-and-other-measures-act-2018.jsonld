    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40as-ss-1",
      "@type": "cof:Section",
      "cof:title": "40AS(1) Return of seized property to third parties",
      "values:kind": "subsection",
      "cof:pageNumber": 83,
      "values:originalText": "(1) A person who claims an interest in property that has been seized\nunder a POCA search warrant in relation to a Tribunal offence may\napply to a court for an order that the property be returned to the\nperson."
    },
