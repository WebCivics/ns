      "@type": "cml:Concept",
      "skos:prefLabel": "120 Paragraph 23XWU(1)(d)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-120"
