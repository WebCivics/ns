    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-70",
      "@type": "cml:Concept",
      "skos:prefLabel": "70 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-70"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.31",
      "values:originalText": "The amendments made by this Part apply in relation to a disclosure of\ninformation or documents on or after the commencement of this item:\n\n(a) whether the information or documents were acquired before,\non or after that commencement; and\n\n(b) whether conduct, a crime or an offence to which the\ndisclosure relates occurred before, on or after that\ncommencement.\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "The amendments made by this Part apply in relation to a disclosure of\ninformation or documents on or after the commencement of this item:\n\n(a) whether the information or documents were acquired before,\non or after that commencement; and\n\n(b) whether conduct, a crime or an offence to which the\ndisclosure relates occurred before, on or after that\ncommencement.\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-70-norm"
        }
      ],
      "cml:integrityHash": "088bca30fe3dd240c65f4ea54ce0212f151c77b84e602671f6c869cb79805b79",
      "skos:note": "Amendments apply in relation to disclosures on or after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-70",
      "@type": "cof:Section",
      "cof:title": "70 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "The amendments made by this Part apply in relation to a disclosure of\ninformation or documents on or after the commencement of this item:\n\n(a) whether the information or documents were acquired before,\non or after that commencement; and\n\n(b) whether conduct, a crime or an offence to which the\ndisclosure relates occurred before, on or after that\ncommencement.\n\nSchedule 1  Assistance to international courts and tribunals"
    },
