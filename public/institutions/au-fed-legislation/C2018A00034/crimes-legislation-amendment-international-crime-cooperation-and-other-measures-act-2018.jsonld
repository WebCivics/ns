    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-163a",
      "@type": "cml:Concept",
      "skos:prefLabel": "163A Report regarding international requests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-163a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.27",
      "values:originalText": "The report must set out the number of occasions on which lawfully\naccessed information or stored communications warrant\ninformation was communicated under subsection 139(1) or\nsection 142 to any of the following:\n\n(a) a foreign country;\n\n(b) the International Criminal Court;\n\n(c) a War Crimes Tribunal;\nfor a purpose connected with an authorisation referred to in\nparagraph 139(2)(e).",
      "skos:definition": "The report must set out the number of occasions on which lawfully\naccessed information or stored communications warrant\ninformation was communicated under subsection 139(1) or\nsection 142 to any of the following:\n\n(a) a foreign country;\n\n(b) the International Criminal Court;\n\n(c) a War Crimes Tribunal;\nfor a purpose connected with an authorisation referred to in\nparagraph 139(2)(e).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-163a-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-163a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c17c42c88264384d1fe4c1088c3a5ece58f692f82eaa834498b8a4e8dfe0bcd4",
      "skos:note": "Report must provide information on communications with foreign countries, International Criminal Court, and War Crimes Tribunal.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-163a",
      "@type": "cof:Section",
      "cof:title": "163A Report regarding international requests",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "The report must set out the number of occasions on which lawfully\naccessed information or stored communications warrant\ninformation was communicated under subsection 139(1) or\nsection 142 to any of the following:\n\n(a) a foreign country;\n\n(b) the International Criminal Court;\n\n(c) a War Crimes Tribunal;\nfor a purpose connected with an authorisation referred to in\nparagraph 139(2)(e)."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-163a-norm",
