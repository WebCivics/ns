      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.10",
      "values:originalText": "Insert:\ninterception warrant information has the same meaning as in the\nTelecommunications (Interception and Access) Act 1979.\nlaw enforcement agency has the same meaning as in the\nSurveillance Devices Act 2004.\nlaw enforcement officer has the same meaning as in the\nSurveillance Devices Act 2004.\nlawfully intercepted information has the same meaning as in the\nTelecommunications (Interception and Access) Act 1979.\nlawfully obtained in Australia has a meaning affected by\nsubsection 69A(3).",
      "skos:definition": "Insert:\ninterception warrant information has the same meaning as in the\nTelecommunications (Interception and Access) Act 1979.\nlaw enforcement agency has the same meaning as in the\nSurveillance Devices Act 2004.\nlaw enforcement officer has the same meaning as in the\nSurveillance Devices Act 2004.\nlawfully intercepted information has the same meaning as in the\nTelecommunications (Interception and Access) Act 1979.\nlawfully obtained in Australia has a meaning affected by\nsubsection 69A(3).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6aaa9a4cdcc93d1dbd446652064f22a5f9e0707310dd99fdee79954d2f077cf5",
      "skos:note": "Defines terms for interception warrant information and law enforcement agency."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Section 4",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Insert:\ninterception warrant information has the same meaning as in the\nTelecommunications (Interception and Access) Act 1979.\nlaw enforcement agency has the same meaning as in the\nSurveillance Devices Act 2004.\nlaw enforcement officer has the same meaning as in the\nSurveillance Devices Act 2004.\nlawfully intercepted information has the same meaning as in the\nTelecommunications (Interception and Access) Act 1979.\nlawfully obtained in Australia has a meaning affected by\nsubsection 69A(3)."
    },
