      },
      "cml:premiseText": "(1) An entity...",
      "cml:conclusionText": "...arrange for the preservation of stored communications."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 Subparagraph 107Q(b)(ii)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.22",
      "values:originalText": "Repeal the subparagraph, substitute:\n\n(ii) if a stored communications warrant authorising access\nto the stored communications covered by the notice is\nissued as a result of the access request—when the\nwarrant ceases to be in force.",
      "skos:definition": "Repeal the subparagraph, substitute:\n\n(ii) if a stored communications warrant authorising access\nto the stored communications covered by the notice is\nissued as a result of the access request—when the\nwarrant ceases to be in force.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-37-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-37-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "02c72b86eb1ea22e772782ea3e421a2a22ca709511614056cca48e452a001027",
      "skos:note": "Repeal a subparagraph and substitute it with an obligation to cease access when the warrant ceases to be in force."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-37",
      "@type": "cof:Section",
      "cof:title": "37 Subparagraph 107Q(b)(ii)",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "Repeal the subparagraph, substitute:\n\n(ii) if a stored communications warrant authorising access\nto the stored communications covered by the notice is\nissued as a result of the access request—when the\nwarrant ceases to be in force."
    },
