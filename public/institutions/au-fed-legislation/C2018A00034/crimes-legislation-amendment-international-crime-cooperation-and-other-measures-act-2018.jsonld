    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Section 270.1A of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.106",
      "values:originalText": "Insert:\ndebt bondage is the condition of a person (the first person) if:\n\n(a) the condition arises from a pledge:\n\n(i) by the first person of the personal services of the first\nperson; or\n\n(ii) by another person of the personal services of the first\nperson, and the first person is under the other person’s\ncontrol; or\n\nSlavery-like offences and relevant evidence  Schedule 6\nSlavery-like offences  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(iii) by the first person of the personal services of another\nperson who is under the first person’s control; and\n\n(b) the pledge is made as security for a debt owed, or claimed to\nbe owed, (including any debt incurred, or claimed to be\nincurred, after the pledge is given) by the person making the\npledge; and\n\n(c) any of the following apply:\n\n(i) the debt owed or claimed to be owed is manifestly\nexcessive;\n\n(ii) the reasonable value of those services is not applied\ntoward the liquidation of the debt or purported debt;\n\n(iii) the length and nature of those services are not\nrespectively limited and defined.",
      "skos:definition": "Insert:\ndebt bondage is the condition of a person (the first person) if:\n\n(a) the condition arises from a pledge:\n\n(i) by the first person of the personal services of the first\nperson; or\n\n(ii) by another person of the personal services of the first\nperson, and the first person is under the other person’s\ncontrol; or\n\nSlavery-like offences and relevant evidence  Schedule 6\nSlavery-like offences  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(iii) by the first person of the personal services of another\nperson who is under the first person’s control; and\n\n(b) the pledge is made as security for a debt owed, or claimed to\nbe owed, (including any debt incurred, or claimed to be\nincurred, after the pledge is given) by the person making the\npledge; and\n\n(c) any of the following apply:\n\n(i) the debt owed or claimed to be owed is manifestly\nexcessive;\n\n(ii) the reasonable value of those services is not applied\ntoward the liquidation of the debt or purported debt;\n\n(iii) the length and nature of those services are not\nrespectively limited and defined.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-6-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-6-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-6-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a4e1e619550f8e7cec8b3b8d0d50faa69a38a6bb14c778f444b4d5adeadb9156",
      "skos:note": "Debt bondage is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Section 270.1A of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "Insert:\ndebt bondage is the condition of a person (the first person) if:\n\n(a) the condition arises from a pledge:\n\n(i) by the first person of the personal services of the first\nperson; or\n\n(ii) by another person of the personal services of the first\nperson, and the first person is under the other person’s\ncontrol; or\n\nSlavery-like offences and relevant evidence  Schedule 6\nSlavery-like offences  Part 1\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(iii) by the first person of the personal services of another\nperson who is under the first person’s control; and\n\n(b) the pledge is made as security for a debt owed, or claimed to\nbe owed, (including any debt incurred, or claimed to be\nincurred, after the pledge is given) by the person making the\npledge; and\n\n(c) any of the following apply:\n\n(i) the debt owed or claimed to be owed is manifestly\nexcessive;\n\n(ii) the reasonable value of those services is not applied\ntoward the liquidation of the debt or purported debt;\n\n(iii) the length and nature of those services are not\nrespectively limited and defined."
    },
