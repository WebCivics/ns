    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-76",
      "@type": "cml:Concept",
      "skos:prefLabel": "76 Subsection 180B(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-76"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.34",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The authorised officer must not make the authorisation unless:\n\n(a) the Attorney-General has authorised the making of the\nauthorisation under a provision mentioned in an item of the\nfollowing table; and\n\n(b) the authorised officer is satisfied that:\n\n(i) the disclosure is reasonably necessary for an\ninvestigation or proceeding referred to in that table item;\nand\n\n(ii) the disclosure is appropriate in all the circumstances.\n\nAuthorising access to prospective information or documents\nItem\nFor Attorney-General\nauthorisations under:\nthe investigation or proceeding is:\nsection 15D of the Mutual\nan investigation or proceeding relating\n\nAssistance to international courts and tribunals  Schedule 1\nProspective telecommunications data  Part 5\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nAuthorising access to prospective information or documents\nItem\nFor Attorney-General\nauthorisations under:\nthe investigation or proceeding is:\nAssistance in Criminal Matters\nAct 1987\nto an offence against the law of a\nforeign country that:\n(a) is punishable by imprisonment for 3\nyears or more, imprisonment for\nlife or the death penalty; or\n(b) involves an act or omission that, if\nit had occurred in Australia, would\nbe a serious offence\nsection 78B of the International\nCriminal Court Act 2002\nan investigation or proceeding relating\nto a crime within the jurisdiction of the\nICC\nsection 34B of the International\nWar Crimes Tribunals Act 1995\nan investigation or proceeding relating\nto a War Crimes Tribunal offence",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) The authorised officer must not make the authorisation unless:\n\n(a) the Attorney-General has authorised the making of the\nauthorisation under a provision mentioned in an item of the\nfollowing table; and\n\n(b) the authorised officer is satisfied that:\n\n(i) the disclosure is reasonably necessary for an\ninvestigation or proceeding referred to in that table item;\nand\n\n(ii) the disclosure is appropriate in all the circumstances.\n\nAuthorising access to prospective information or documents\nItem\nFor Attorney-General\nauthorisations under:\nthe investigation or proceeding is:\nsection 15D of the Mutual\nan investigation or proceeding relating\n\nAssistance to international courts and tribunals  Schedule 1\nProspective telecommunications data  Part 5\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nAuthorising access to prospective information or documents\nItem\nFor Attorney-General\nauthorisations under:\nthe investigation or proceeding is:\nAssistance in Criminal Matters\nAct 1987\nto an offence against the law of a\nforeign country that:\n(a) is punishable by imprisonment for 3\nyears or more, imprisonment for\nlife or the death penalty; or\n(b) involves an act or omission that, if\nit had occurred in Australia, would\nbe a serious offence\nsection 78B of the International\nCriminal Court Act 2002\nan investigation or proceeding relating\nto a crime within the jurisdiction of the\nICC\nsection 34B of the International\nWar Crimes Tribunals Act 1995\nan investigation or proceeding relating\nto a War Crimes Tribunal offence",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-76-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-76-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-76-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-76-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-76-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-76-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "9d704bceeaabb42633f0f921f704c0ce4cd95b28f5aa09e798628d1fe9f394cd",
      "skos:note": "Authorisation must be made under specific conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-76",
      "@type": "cof:Section",
      "cof:title": "76 Subsection 180B(3)",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The authorised officer must not make the authorisation unless:\n\n(a) the Attorney-General has authorised the making of the\nauthorisation under a provision mentioned in an item of the\nfollowing table; and\n\n(b) the authorised officer is satisfied that:\n\n(i) the disclosure is reasonably necessary for an\ninvestigation or proceeding referred to in that table item;\nand\n\n(ii) the disclosure is appropriate in all the circumstances.\n\nAuthorising access to prospective information or documents\nItem\nFor Attorney-General\nauthorisations under:\nthe investigation or proceeding is:\nsection 15D of the Mutual\nan investigation or proceeding relating\n\nAssistance to international courts and tribunals  Schedule 1\nProspective telecommunications data  Part 5\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nAuthorising access to prospective information or documents\nItem\nFor Attorney-General\nauthorisations under:\nthe investigation or proceeding is:\nAssistance in Criminal Matters\nAct 1987\nto an offence against the law of a\nforeign country that:\n(a) is punishable by imprisonment for 3\nyears or more, imprisonment for\nlife or the death penalty; or\n(b) involves an act or omission that, if\nit had occurred in Australia, would\nbe a serious offence\nsection 78B of the International\nCriminal Court Act 2002\nan investigation or proceeding relating\nto a crime within the jurisdiction of the\nICC\nsection 34B of the International\nWar Crimes Tribunals Act 1995\nan investigation or proceeding relating\nto a War Crimes Tribunal offence"
    },
