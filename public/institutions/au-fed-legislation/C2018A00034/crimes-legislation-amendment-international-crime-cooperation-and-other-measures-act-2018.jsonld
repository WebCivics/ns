      "cml:logicSummary": "Material lawfully obtained in Australia includes material obtained from individuals or entities by consent and material obtained by warrant within a specific time frame",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) Material lawfully obtained in Australia includes:\n\n(a) material obtained from individuals or entities by consent; and\n\n(b) material obtained by warrant, or the exercise of a coercive power by a court, in Australia for the purposes of a domestic investigation or prosecution."
    },
