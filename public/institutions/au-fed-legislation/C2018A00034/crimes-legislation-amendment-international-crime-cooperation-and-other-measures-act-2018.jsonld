    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-63",
      "@type": "cml:Concept",
      "skos:prefLabel": "63 Subsection 180A(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-63"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
