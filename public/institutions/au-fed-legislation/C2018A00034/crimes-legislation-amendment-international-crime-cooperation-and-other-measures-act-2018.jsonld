    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-3-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After subsection 26(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-3-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.100",
      "values:originalText": "Insert:\n\n(2A) If a person is brought before a magistrate, eligible Federal Circuit\nCourt Judge or court as referred to in paragraph (1)(ca), the\nmagistrate, Judge or court must order:\n\n(a) the discharge of the recognisances on which bail was granted;\nand\n\n(b) that the person be committed to prison to await surrender\nunder the warrant.",
      "skos:definition": "Insert:\n\n(2A) If a person is brought before a magistrate, eligible Federal Circuit\nCourt Judge or court as referred to in paragraph (1)(ca), the\nmagistrate, Judge or court must order:\n\n(a) the discharge of the recognisances on which bail was granted;\nand\n\n(b) that the person be committed to prison to await surrender\nunder the warrant.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-3-sec-1-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-3-sec-1-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-3-sec-1-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "5e5f741ed104fe050f89f762478433fed0146842e45cc6df3a64dd1b04b2b519",
      "skos:note": "Magistrate must order discharge of recognisances and commitment to prison."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-3-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 After subsection 26(2)",
      "values:kind": "section",
      "cof:pageNumber": 100,
      "values:originalText": "Insert:\n\n(2A) If a person is brought before a magistrate, eligible Federal Circuit\nCourt Judge or court as referred to in paragraph (1)(ca), the\nmagistrate, Judge or court must order:\n\n(a) the discharge of the recognisances on which bail was granted;\nand\n\n(b) that the person be committed to prison to await surrender\nunder the warrant."
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-3-sec-1-norm",
