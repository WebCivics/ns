      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Transitional—serious offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.113",
      "values:originalText": "Paragraph 5D(3A)(a) of the Telecommunications (Interception and\nAccess) Act 1979 has effect after the commencement of this item (in\naddition to its effect as amended by this Act) as if it also contained a\nreference to the following provisions of the Criminal Code, as in force\nimmediately before the commencement of this item:\n\n(a) section 271.8;\n\n(b) section 271.9.\n\nSchedule 7  Amendment of the War Crimes Act 1945\n\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\nNo. 34, 2018",
      "skos:definition": "Paragraph 5D(3A)(a) of the Telecommunications (Interception and\nAccess) Act 1979 has effect after the commencement of this item (in\naddition to its effect as amended by this Act) as if it also contained a\nreference to the following provisions of the Criminal Code, as in force\nimmediately before the commencement of this item:\n\n(a) section 271.8;\n\n(b) section 271.9.\n\nSchedule 7  Amendment of the War Crimes Act 1945\n\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\nNo. 34, 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-6-sec-32-norm"
        }
      ],
      "cml:integrityHash": "cd4007dde9a652731c45c90fe9421e27df32c8feee27a23e9b947455a8dc279e",
      "skos:note": "Reference to provisions of the Criminal Code"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-6-sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Transitional—serious offences",
      "values:kind": "section",
      "cof:pageNumber": 113,
      "values:originalText": "Paragraph 5D(3A)(a) of the Telecommunications (Interception and\nAccess) Act 1979 has effect after the commencement of this item (in\naddition to its effect as amended by this Act) as if it also contained a\nreference to the following provisions of the Criminal Code, as in force\nimmediately before the commencement of this item:\n\n(a) section 271.8;\n\n(b) section 271.9.\n\nSchedule 7  Amendment of the War Crimes Act 1945\n\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\nNo. 34, 2018"
    },
