      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.71",
      "values:originalText": "Insert:\naccount has the same meaning as in the Proceeds of Crime Act\n2002.\nagent has the same meaning as in the Proceeds of Crime Act 2002.\nauthorised officer has the same meaning as in the Proceeds of\nCrime Act 2002.\ndefendant has the meaning given by section 40AA.\nenforcement agency has the same meaning as in the Proceeds of\nCrime Act 2002.",
      "skos:definition": "Insert:\naccount has the same meaning as in the Proceeds of Crime Act\n2002.\nagent has the same meaning as in the Proceeds of Crime Act 2002.\nauthorised officer has the same meaning as in the Proceeds of\nCrime Act 2002.\ndefendant has the meaning given by section 40AA.\nenforcement agency has the same meaning as in the Proceeds of\nCrime Act 2002.",
      "cml:asserts": [
        {
