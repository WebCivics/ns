    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Subsection 34ZB(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.90",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) However, Part 3-5 of the Proceeds of Crime Act applies as if:\n\n(a) a reference in that Part to tainted property were a reference to\ntainted property within the meaning of this Act; and\n\n(b) a reference in that Part to evidential material were a reference\nto evidential material as defined in subsection 3(1) of this Act\nfor the purposes of this Subdivision; and\n\n(c) the words “or section 34ZD, 34ZE or 34ZF of the Mutual\nAssistance Act” were inserted after “this Act” in\nparagraph 254(1)(a) of the Proceeds of Crime Act; and\n\n(d) paragraphs 227(1)(a), (b), (h) and (ha) and 228(1)(d) and (da)\nand sections 256 to 262 of the Proceeds of Crime Act were\nomitted.\nNote:\nSections 34ZC and 34ZCA of this Act also apply in relation to a\nPOCA search warrant. Sections 34ZD to 34ZF of this Act also apply\nin relation to property or things seized under such a warrant.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) However, Part 3-5 of the Proceeds of Crime Act applies as if:\n\n(a) a reference in that Part to tainted property were a reference to\ntainted property within the meaning of this Act; and\n\n(b) a reference in that Part to evidential material were a reference\nto evidential material as defined in subsection 3(1) of this Act\nfor the purposes of this Subdivision; and\n\n(c) the words “or section 34ZD, 34ZE or 34ZF of the Mutual\nAssistance Act” were inserted after “this Act” in\nparagraph 254(1)(a) of the Proceeds of Crime Act; and\n\n(d) paragraphs 227(1)(a), (b), (h) and (ha) and 228(1)(d) and (da)\nand sections 256 to 262 of the Proceeds of Crime Act were\nomitted.\nNote:\nSections 34ZC and 34ZCA of this Act also apply in relation to a\nPOCA search warrant. Sections 34ZD to 34ZF of this Act also apply\nin relation to property or things seized under such a warrant.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-7-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cf7cfe4c60f19fb987ad4e4134f11073860357f869a384479bc427737ed2dd26",
      "skos:note": "Substitute certain provisions of the Proceeds of Crime Act with modifications related to this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Subsection 34ZB(3)",
      "values:kind": "section",
      "cof:pageNumber": 90,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) However, Part 3-5 of the Proceeds of Crime Act applies as if:\n\n(a) a reference in that Part to tainted property were a reference to\ntainted property within the meaning of this Act; and\n\n(b) a reference in that Part to evidential material were a reference\nto evidential material as defined in subsection 3(1) of this Act\nfor the purposes of this Subdivision; and\n\n(c) the words “or section 34ZD, 34ZE or 34ZF of the Mutual\nAssistance Act” were inserted after “this Act” in\nparagraph 254(1)(a) of the Proceeds of Crime Act; and\n\n(d) paragraphs 227(1)(a), (b), (h) and (ha) and 228(1)(d) and (da)\nand sections 256 to 262 of the Proceeds of Crime Act were\nomitted.\nNote:\nSections 34ZC and 34ZCA of this Act also apply in relation to a\nPOCA search warrant. Sections 34ZD to 34ZF of this Act also apply\nin relation to property or things seized under such a warrant."
    },
