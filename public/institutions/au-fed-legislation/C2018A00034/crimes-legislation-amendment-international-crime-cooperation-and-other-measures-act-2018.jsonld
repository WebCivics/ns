      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.23",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) during the period of 180 days starting on the day the carrier\nwas given the notice, the entity did not make an access\nrequest to the Attorney-General to arrange for access to those\ncommunications;",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(c) during the period of 180 days starting on the day the carrier\nwas given the notice, the entity did not make an access\nrequest to the Attorney-General to arrange for access to those\ncommunications;",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-39-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-39-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fc63403a6c88d2ac8f3a3da25698199696ee64a3412de1f3342019b06460eaca",
      "skos:note": "Entity must make access request within 180 days after notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-39",
      "@type": "cof:Section",
      "cof:title": "39 Paragraph 107R(1)(c)",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) during the period of 180 days starting on the day the carrier\nwas given the notice, the entity did not make an access\nrequest to the Attorney-General to arrange for access to those\ncommunications;"
    },
