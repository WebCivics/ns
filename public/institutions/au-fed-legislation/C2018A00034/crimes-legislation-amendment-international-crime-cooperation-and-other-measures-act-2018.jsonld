    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ab",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AB Authorising applications under the Proceeds of Crime Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ab"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.73",
      "values:originalText": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act 2002 as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n\n(a) relates to a proceeding before, or an investigation conducted\nby, the Tribunal; and\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act 2002 as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n\n(a) relates to a proceeding before, or an investigation conducted\nby, the Tribunal; and\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ab-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ab-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9f2f7dbb1b76d6b3b35a61d8eb4721e32c425b3e6c60b1dc52e3c418078fd898",
      "skos:note": "Attorney-General authorises officer to make applications under Proceeds of Crime Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ab",
      "@type": "cof:Section",
      "cof:title": "40AB Authorising applications under the Proceeds of Crime Act",
      "values:kind": "section",
      "cof:pageNumber": 73,
      "values:originalText": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act 2002 as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n\n(a) relates to a proceeding before, or an investigation conducted\nby, the Tribunal; and\n\nSchedule 1  Assistance to international courts and tribunals"
    },
    {
