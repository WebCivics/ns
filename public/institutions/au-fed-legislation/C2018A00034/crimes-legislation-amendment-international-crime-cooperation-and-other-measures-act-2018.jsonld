      "values:originalText": "Omit “under Subdivision B in respect of the property in relation to the\ncrime within the jurisdiction of the ICC, the head of the enforcement\nagency whose authorised officer seized the property”, substitute “as\ndescribed in Subdivision B in respect of the property in relation to the\ncrime within the jurisdiction of the ICC, the responsible enforcement\nagency head”.",
      "skos:definition": "Omit “under Subdivision B in respect of the property in relation to the\ncrime within the jurisdiction of the ICC, the head of the enforcement\nagency whose authorised officer seized the property”, substitute “as\ndescribed in Subdivision B in respect of the property in relation to the\ncrime within the jurisdiction of the ICC, the responsible enforcement\nagency head”.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-185-norm"
        },
