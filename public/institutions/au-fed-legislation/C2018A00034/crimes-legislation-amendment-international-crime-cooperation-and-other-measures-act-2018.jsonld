      "cml:premiseText": "(3) That Part applies as if:"
    },
    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ao",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AO Passing on information given under monitoring orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ao"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.80",
      "values:originalText": "If an enforcement agency is given information under a monitoring\norder made in relation to the Tribunal offence, the enforcement\nagency must, as soon as practicable after receiving the information,\npass the information on to:\n\n(a) the Attorney-General; or\n\n(b) an APS employee who is in the Department and who is\nspecified by the Attorney-General by written notice to the\nenforcement agency.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nSubdivision F—Search warrants relating to proceeds of crime\nand evidential material",
      "skos:definition": "If an enforcement agency is given information under a monitoring\norder made in relation to the Tribunal offence, the enforcement\nagency must, as soon as practicable after receiving the information,\npass the information on to:\n\n(a) the Attorney-General; or\n\n(b) an APS employee who is in the Department and who is\nspecified by the Attorney-General by written notice to the\nenforcement agency.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nSubdivision F—Search warrants relating to proceeds of crime\nand evidential material",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ao-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ao-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b5149bb7ed770c311c1ed8f060ac634284e52f2a1f7cad9b33845f143711b4f0",
      "skos:note": "Pass on information to Attorney-General or APS employee",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ao",
      "@type": "cof:Section",
      "cof:title": "40AO Passing on information given under monitoring orders",
      "values:kind": "section",
      "cof:pageNumber": 80,
      "values:originalText": "If an enforcement agency is given information under a monitoring\norder made in relation to the Tribunal offence, the enforcement\nagency must, as soon as practicable after receiving the information,\npass the information on to:\n\n(a) the Attorney-General; or\n\n(b) an APS employee who is in the Department and who is\nspecified by the Attorney-General by written notice to the\nenforcement agency.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nSubdivision F—Search warrants relating to proceeds of crime\nand evidential material"
    },
