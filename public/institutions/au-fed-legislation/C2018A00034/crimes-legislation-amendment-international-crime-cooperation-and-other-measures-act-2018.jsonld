    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-179",
      "@type": "cml:Concept",
      "skos:prefLabel": "179 Subsection 100(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-179"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.65",
      "values:originalText": "Repeal the subsection, substitute:\n\n(5) This section does not apply to property that has been seized under a\nPOCA search warrant because:\n\n(a) it is evidential material; or\n\n(b) it is property of a kind referred to in subparagraph 99A(a)(iv)\nor (v).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(5) This section does not apply to property that has been seized under a\nPOCA search warrant because:\n\n(a) it is evidential material; or\n\n(b) it is property of a kind referred to in subparagraph 99A(a)(iv)\nor (v).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-179-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-179-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a5f4b37844bcd521a8cb51dd06738dc2e037c425483b7775d2662a4578e50cad",
      "skos:note": "Property seized under POCA search warrant is exempt from this section."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-179",
      "@type": "cof:Section",
      "cof:title": "179 Subsection 100(5)",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "Repeal the subsection, substitute:\n\n(5) This section does not apply to property that has been seized under a\nPOCA search warrant because:\n\n(a) it is evidential material; or\n\n(b) it is property of a kind referred to in subparagraph 99A(a)(iv)\nor (v)."
    },
