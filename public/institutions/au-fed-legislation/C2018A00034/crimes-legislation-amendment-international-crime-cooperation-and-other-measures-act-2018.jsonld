    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-141",
      "@type": "cml:Concept",
      "skos:prefLabel": "141 Section 4 (definition of evidential material)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-141"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.58",
      "values:originalText": "Repeal the definition, substitute:\nevidential material means:\n\n(a) in Subdivision F of Division 14 of Part 4—evidence relating\nto:\n\n(i) property in relation to which a forfeiture order has been\nor could be made; or\n\n(ii) property in relation to which a restraining order has\nbeen or could be made for the purposes of section 82; or\n\n(iii) property of a person in relation to whom a pecuniary\npenalty order may be enforced as described in\nsection 159; or\n\n(iv) proceeds of a crime within the jurisdiction of the ICC;\nor\n\n(v) benefits derived from the commission of a crime within\nthe jurisdiction of the ICC; or\n\n(b) otherwise—a thing relevant to a crime within the jurisdiction\nof the ICC, including such a thing in electronic form.",
      "skos:definition": "Repeal the definition, substitute:\nevidential material means:\n\n(a) in Subdivision F of Division 14 of Part 4—evidence relating\nto:\n\n(i) property in relation to which a forfeiture order has been\nor could be made; or\n\n(ii) property in relation to which a restraining order has\nbeen or could be made for the purposes of section 82; or\n\n(iii) property of a person in relation to whom a pecuniary\npenalty order may be enforced as described in\nsection 159; or\n\n(iv) proceeds of a crime within the jurisdiction of the ICC;\nor\n\n(v) benefits derived from the commission of a crime within\nthe jurisdiction of the ICC; or\n\n(b) otherwise—a thing relevant to a crime within the jurisdiction\nof the ICC, including such a thing in electronic form.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-141-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-141-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-141-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "72c038d1f53d471bee6149ffeac22277071d56853bf5f683fec2b31eca3edeb8",
      "skos:note": "Definition of evidential material"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-141",
      "@type": "cof:Section",
      "cof:title": "141 Section 4 (definition of evidential material)",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "Repeal the definition, substitute:\nevidential material means:\n\n(a) in Subdivision F of Division 14 of Part 4—evidence relating\nto:\n\n(i) property in relation to which a forfeiture order has been\nor could be made; or\n\n(ii) property in relation to which a restraining order has\nbeen or could be made for the purposes of section 82; or\n\n(iii) property of a person in relation to whom a pecuniary\npenalty order may be enforced as described in\nsection 159; or\n\n(iv) proceeds of a crime within the jurisdiction of the ICC;\nor\n\n(v) benefits derived from the commission of a crime within\nthe jurisdiction of the ICC; or\n\n(b) otherwise—a thing relevant to a crime within the jurisdiction\nof the ICC, including such a thing in electronic form."
    },
