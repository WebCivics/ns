    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 3(1) (definition of evidential material)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.89",
      "values:originalText": "Repeal the definition, substitute:\nevidential material means:\n\n(a) in Subdivision F of Division 2 of Part VI—evidence relating\nto:\n\n(i) property in relation to which a foreign forfeiture order\nor foreign restraining order has been or could be made;\nor\n\n(ii) property of a person in relation to whom a foreign\npecuniary penalty order has been or could be made; or\n\n(iii) tainted property; or\n\n(iv) benefits derived from the commission of a foreign\nserious offence; or\n\n(b) otherwise—a thing relevant to a proceeding or investigation,\nincluding such a thing in electronic form.",
      "skos:definition": "Repeal the definition, substitute:\nevidential material means:\n\n(a) in Subdivision F of Division 2 of Part VI—evidence relating\nto:\n\n(i) property in relation to which a foreign forfeiture order\nor foreign restraining order has been or could be made;\nor\n\n(ii) property of a person in relation to whom a foreign\npecuniary penalty order has been or could be made; or\n\n(iii) tainted property; or\n\n(iv) benefits derived from the commission of a foreign\nserious offence; or\n\n(b) otherwise—a thing relevant to a proceeding or investigation,\nincluding such a thing in electronic form.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-2-sec-2-norm"
        }
      ],
      "cml:integrityHash": "6fb7521d1b1083568b0e2125f2cc27556fa8565265b8ffe8db54224a579f2bbf",
      "skos:note": "Definition of evidential material"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-2-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsection 3(1) (definition of evidential material)",
      "values:kind": "section",
      "cof:pageNumber": 89,
      "values:originalText": "Repeal the definition, substitute:\nevidential material means:\n\n(a) in Subdivision F of Division 2 of Part VI—evidence relating\nto:\n\n(i) property in relation to which a foreign forfeiture order\nor foreign restraining order has been or could be made;\nor\n\n(ii) property of a person in relation to whom a foreign\npecuniary penalty order has been or could be made; or\n\n(iii) tainted property; or\n\n(iv) benefits derived from the commission of a foreign\nserious offence; or\n\n(b) otherwise—a thing relevant to a proceeding or investigation,\nincluding such a thing in electronic form."
    },
