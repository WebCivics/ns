    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-8-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 At the end of section 40P",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-8-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.117",
      "values:originalText": "Add:\n\n(2) Despite subsection 14(2) of the Legislation Act 2003, regulations\nmade for the purposes of section 40LA, 40M or 40N may make\nprovision in relation to a matter by applying, adopting or\nincorporating any matter contained in a standard published by, or\non behalf of, Standards Australia or published jointly by, or on\nbehalf of, Standards Australia and Standards New Zealand:\n\n(a) as in force or existing at a particular time; or\n\n(b) as in force or existing from time to time.\n\nSchedule 8  Amendment of the Australian Federal Police Act 1979",
      "skos:definition": "Add:\n\n(2) Despite subsection 14(2) of the Legislation Act 2003, regulations\nmade for the purposes of section 40LA, 40M or 40N may make\nprovision in relation to a matter by applying, adopting or\nincorporating any matter contained in a standard published by, or\non behalf of, Standards Australia or published jointly by, or on\nbehalf of, Standards Australia and Standards New Zealand:\n\n(a) as in force or existing at a particular time; or\n\n(b) as in force or existing from time to time.\n\nSchedule 8  Amendment of the Australian Federal Police Act 1979",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-8-sec-15-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-8-sec-15-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-8-sec-15-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "b0779ece02a6663f626afc08e81482393983544670eb9e8fb1a81020826a95e1",
      "skos:note": "Allows regulations to incorporate standards published by Standards Australia or its partners."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-8-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 At the end of section 40P",
      "values:kind": "section",
      "cof:pageNumber": 117,
      "values:originalText": "Add:\n\n(2) Despite subsection 14(2) of the Legislation Act 2003, regulations\nmade for the purposes of section 40LA, 40M or 40N may make\nprovision in relation to a matter by applying, adopting or\nincorporating any matter contained in a standard published by, or\non behalf of, Standards Australia or published jointly by, or on\nbehalf of, Standards Australia and Standards New Zealand:\n\n(a) as in force or existing at a particular time; or\n\n(b) as in force or existing from time to time.\n\nSchedule 8  Amendment of the Australian Federal Police Act 1979"
    },
