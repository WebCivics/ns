    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-181",
      "@type": "cml:Concept",
      "skos:prefLabel": "181 Subsection 101(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-181"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
