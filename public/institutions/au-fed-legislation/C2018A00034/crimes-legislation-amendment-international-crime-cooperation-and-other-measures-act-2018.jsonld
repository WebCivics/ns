    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-100",
      "@type": "cml:Concept",
      "skos:prefLabel": "100 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-100"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.42",
      "values:originalText": "The amendments made by this Part apply in relation to a request made\nto the Attorney-General by the ICC, a Tribunal or a foreign country:\n\n(a) on or after the commencement of this item; or\n\nAssistance to international courts and tribunals  Schedule 1\nUse of surveillance devices  Part 6\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(b) before the commencement of this item, if, immediately\nbefore that commencement, the Attorney-General had yet to\nmake a decision on the request;\nwhether conduct, a crime or an offence to which the request relates\noccurred before, on or after that commencement.\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "The amendments made by this Part apply in relation to a request made\nto the Attorney-General by the ICC, a Tribunal or a foreign country:\n\n(a) on or after the commencement of this item; or\n\nAssistance to international courts and tribunals  Schedule 1\nUse of surveillance devices  Part 6\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(b) before the commencement of this item, if, immediately\nbefore that commencement, the Attorney-General had yet to\nmake a decision on the request;\nwhether conduct, a crime or an offence to which the request relates\noccurred before, on or after that commencement.\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-100-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-100-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bd508b93060bbb39b7367503760da70e4d55ccfdf15298a277ec6db69a89d334",
      "skos:note": "Amendments apply in relation to a request made by the ICC, Tribunal or foreign country."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-100",
      "@type": "cof:Section",
      "cof:title": "100 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "The amendments made by this Part apply in relation to a request made\nto the Attorney-General by the ICC, a Tribunal or a foreign country:\n\n(a) on or after the commencement of this item; or\n\nAssistance to international courts and tribunals  Schedule 1\nUse of surveillance devices  Part 6\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\n(b) before the commencement of this item, if, immediately\nbefore that commencement, the Attorney-General had yet to\nmake a decision on the request;\nwhether conduct, a crime or an offence to which the request relates\noccurred before, on or after that commencement.\n\nSchedule 1  Assistance to international courts and tribunals"
    },
