    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ag",
      "@type": "cml:Concept",
      "skos:prefLabel": "40AG Retaining produced documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ag"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.76",
      "values:originalText": "(1) An authorised officer who takes possession of a document under a\nproduction order made in respect of a Tribunal offence may retain\nthe document pending a written direction from the\nAttorney-General as to how to deal with the document.\n\n(2) Directions from the Attorney-General may include a direction that\nthe document be sent to the Tribunal.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nSubdivision D—Notices to financial institutions",
      "skos:definition": "(1) An authorised officer who takes possession of a document under a\nproduction order made in respect of a Tribunal offence may retain\nthe document pending a written direction from the\nAttorney-General as to how to deal with the document.\n\n(2) Directions from the Attorney-General may include a direction that\nthe document be sent to the Tribunal.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nSubdivision D—Notices to financial institutions",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ag-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-40ag-ss-2"
        }
      ],
      "cml:integrityHash": "c7f0a309808fa1b8de01f65ae8e7785e0a21d3633a4a70e561ee1f5b503fcd13"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-40ag",
      "@type": "cof:Section",
      "cof:title": "40AG Retaining produced documents",
      "values:kind": "section",
      "cof:pageNumber": 76,
      "values:originalText": "(1) An authorised officer who takes possession of a document under a\nproduction order made in respect of a Tribunal offence may retain\nthe document pending a written direction from the\nAttorney-General as to how to deal with the document.\n\n(2) Directions from the Attorney-General may include a direction that\nthe document be sent to the Tribunal.\n\nAssistance to international courts and tribunals  Schedule 1\nProceeds of crime  Part 8\n\nNo. 34, 2018\nCrimes Legislation Amendment (International Crime Cooperation and\nOther Measures) Act 2018\n\nSubdivision D—Notices to financial institutions"
    },
