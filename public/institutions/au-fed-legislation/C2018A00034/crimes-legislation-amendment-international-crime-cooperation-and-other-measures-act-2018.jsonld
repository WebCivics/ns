    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-98",
      "@type": "cml:Concept",
      "skos:prefLabel": "98 Paragraph 50(1)(ia)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-98"
      },
      "cml:curationStatus": {
