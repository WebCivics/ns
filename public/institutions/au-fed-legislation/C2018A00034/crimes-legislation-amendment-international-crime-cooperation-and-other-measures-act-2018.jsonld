    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102",
      "@type": "cml:Concept",
      "skos:prefLabel": "102 Subsection 23WA(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-102"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.44",
      "values:originalText": "Insert:\nauthorising provision, in relation to a request by a foreign country\nor international tribunal, means whichever of the following\nprovisions that refers to the request:\n\n(a) section 28B of the Mutual Assistance in Criminal Matters Act\n1987;\n\n(b) section 76A of the International Criminal Court Act 2002;\n\n(c) section 32B of the International War Crimes Tribunals Act\n1995.\ncrime within the jurisdiction of the ICC has the same meaning as\nin the International Criminal Court Act 2002.",
      "skos:definition": "Insert:\nauthorising provision, in relation to a request by a foreign country\nor international tribunal, means whichever of the following\nprovisions that refers to the request:\n\n(a) section 28B of the Mutual Assistance in Criminal Matters Act\n1987;\n\n(b) section 76A of the International Criminal Court Act 2002;\n\n(c) section 32B of the International War Crimes Tribunals Act\n1995.\ncrime within the jurisdiction of the ICC has the same meaning as\nin the International Criminal Court Act 2002.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-102-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "19df30db971c7121c427a49508f226cd5c7e10e91dc3bdc67dd210f445a83be8",
      "skos:note": "Defines authorising provision for foreign country or international tribunal requests"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-102",
      "@type": "cof:Section",
      "cof:title": "102 Subsection 23WA(1)",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "Insert:\nauthorising provision, in relation to a request by a foreign country\nor international tribunal, means whichever of the following\nprovisions that refers to the request:\n\n(a) section 28B of the Mutual Assistance in Criminal Matters Act\n1987;\n\n(b) section 76A of the International Criminal Court Act 2002;\n\n(c) section 32B of the International War Crimes Tribunals Act\n1995.\ncrime within the jurisdiction of the ICC has the same meaning as\nin the International Criminal Court Act 2002."
    },
