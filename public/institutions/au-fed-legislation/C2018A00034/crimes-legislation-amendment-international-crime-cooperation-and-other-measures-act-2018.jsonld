    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.17",
      "values:originalText": "The amendments of the International War Crimes Tribunals Act 1995\nmade by this Part apply in relation to the following:\n\n(a) a requirement to produce documents or other articles that is\nmade on or after the commencement of this item;\n\n(b) a requirement to produce documents or other articles that is\nmade before the commencement of this item if:\n\n(i) the documents or other articles had not been produced\nimmediately before the commencement of this item; or\n\n(ii) the documents or other articles were produced before\nthe commencement of this item but, immediately before\nthat commencement, the documents (or copies of the\ndocuments) or other articles had not been sent to the\nAttorney-General as required by subsection 28(2) or (3)\nof that Act.\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "The amendments of the International War Crimes Tribunals Act 1995\nmade by this Part apply in relation to the following:\n\n(a) a requirement to produce documents or other articles that is\nmade on or after the commencement of this item;\n\n(b) a requirement to produce documents or other articles that is\nmade before the commencement of this item if:\n\n(i) the documents or other articles had not been produced\nimmediately before the commencement of this item; or\n\n(ii) the documents or other articles were produced before\nthe commencement of this item but, immediately before\nthat commencement, the documents (or copies of the\ndocuments) or other articles had not been sent to the\nAttorney-General as required by subsection 28(2) or (3)\nof that Act.\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-21-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-21-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-21-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "51560664868796806ae54cc02cdac3d4e9f155ae75ad4f706f0475cc83e32229",
      "skos:note": "Amendments apply to requirements made on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "The amendments of the International War Crimes Tribunals Act 1995\nmade by this Part apply in relation to the following:\n\n(a) a requirement to produce documents or other articles that is\nmade on or after the commencement of this item;\n\n(b) a requirement to produce documents or other articles that is\nmade before the commencement of this item if:\n\n(i) the documents or other articles had not been produced\nimmediately before the commencement of this item; or\n\n(ii) the documents or other articles were produced before\nthe commencement of this item but, immediately before\nthat commencement, the documents (or copies of the\ndocuments) or other articles had not been sent to the\nAttorney-General as required by subsection 28(2) or (3)\nof that Act.\n\nSchedule 1  Assistance to international courts and tribunals"
    },
