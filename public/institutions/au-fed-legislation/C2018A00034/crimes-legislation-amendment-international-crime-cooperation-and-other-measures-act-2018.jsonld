    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-81a",
      "@type": "cml:Concept",
      "skos:prefLabel": "81A Authorising applications under the Proceeds of Crime Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-81a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.59",
      "values:originalText": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n\nSchedule 1  Assistance to international courts and tribunals",
      "skos:definition": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n\nSchedule 1  Assistance to international courts and tribunals",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-81a-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-81a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f2bd3b8b4aecbf3fde8ed541900e3375ba740800c2a34ef32513b53383630581",
      "skos:note": "The Attorney-General may authorise an officer to make applications under the Proceeds of Crime Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-81a",
      "@type": "cof:Section",
      "cof:title": "81A Authorising applications under the Proceeds of Crime Act",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "The Attorney-General may authorise, in writing, an authorised\nofficer of an enforcement agency to make such applications under\nthe Proceeds of Crime Act as are necessary to respond to the\nproceeds request if the Attorney-General is satisfied that the\nproceeds request:\n\nSchedule 1  Assistance to international courts and tribunals"
    },
