    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
