    {
      "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 At the end of subsection 45(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018.pdf, p.13",
      "values:originalText": "Add:\n\n(h) the communication of information for the purpose of\nproviding it to the International Criminal Court, if this has\nbeen authorised under section 69A of the International\nCriminal Court Act 2002; or\n\n(i) the communication of information for the purpose of\nproviding it to a War Crimes Tribunal, if this has been\nauthorised under section 25A of the International War\nCrimes Tribunals Act 1995.\nNote:\nThese paragraphs will be added after those substituted for paragraph 45(4)(f) of the\nSurveillance Devices Act 2004 (see Part 6 of this Schedule).\nTelecommunications (Interception and Access) Act 1979",
      "skos:definition": "Add:\n\n(h) the communication of information for the purpose of\nproviding it to the International Criminal Court, if this has\nbeen authorised under section 69A of the International\nCriminal Court Act 2002; or\n\n(i) the communication of information for the purpose of\nproviding it to a War Crimes Tribunal, if this has been\nauthorised under section 25A of the International War\nCrimes Tribunals Act 1995.\nNote:\nThese paragraphs will be added after those substituted for paragraph 45(4)(f) of the\nSurveillance Devices Act 2004 (see Part 6 of this Schedule).\nTelecommunications (Interception and Access) Act 1979",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-6-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018-sch-1-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "09e40cada80c3a5fc557c4cb0550995e9c5a40b454a2ee390fa4ef7ca69dde52",
      "skos:note": "Authorisation required for communication of information to International Criminal Court or War Crimes Tribunal."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-international-crime-cooperation-and-other-measures-act-2018#sch-1-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 At the end of subsection 45(4)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Add:\n\n(h) the communication of information for the purpose of\nproviding it to the International Criminal Court, if this has\nbeen authorised under section 69A of the International\nCriminal Court Act 2002; or\n\n(i) the communication of information for the purpose of\nproviding it to a War Crimes Tribunal, if this has been\nauthorised under section 25A of the International War\nCrimes Tribunals Act 1995.\nNote:\nThese paragraphs will be added after those substituted for paragraph 45(4)(f) of the\nSurveillance Devices Act 2004 (see Part 6 of this Schedule).\nTelecommunications (Interception and Access) Act 1979"
    },
