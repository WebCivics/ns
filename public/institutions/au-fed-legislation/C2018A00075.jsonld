        "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-descriptionlogic-2",
        "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-alleninterval-3",
        "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-ltl-4",
        "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-diffusion-5",
        "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-deontic-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "847663a766dfa70050b4329833e1fd36be26ba58538ee8ed7c5a3c718ebfad37",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
