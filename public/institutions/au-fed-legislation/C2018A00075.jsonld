    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.18",
      "skos:note": "Preventing, detecting, investigating or dealing with misconduct of a serious nature by certain individuals or entities.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "1 Subsection 3(1)"
      },
      "wasDerivedFrom": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf",
      "asserts": [
        "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-norm",
