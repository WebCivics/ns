    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
