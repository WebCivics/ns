      "realizedBy": "doc:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-7-sec-1",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Dealing with misconduct may occur at any time before or after the misconduct occurs.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal intervals for dealing with misconduct",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "An integrity purpose relating to misconduct of a person covered by a subparagraph of paragraph (a) does not cease to exist merely because the person ceases to be covered by that subparagraph after the misconduct occurs."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Preventing, detecting, investigating or dealing with misconduct of a serious nature.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to prevent misconduct",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Commonwealth entity has the meaning given by section 10 of the Public Governance, Performance and Accountability Act 2013."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Preventing, detecting, investigating or dealing with misconduct of a serious nature is an obligation.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to prevent misconduct",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Commonwealth entity has the meaning given by section 10 of the Public Governance, Performance and Accountability Act 2013."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Target entity means: ... (a) a Privacy Act agency; or (b) a wholly-owned Commonwealth company.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Target entity is an APP entity as defined in section 6 of the Privacy Act 1988.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:premiseText": "A target entity is an APP entity as defined in section 6 of the Privacy Act 1988, because it is either an agency or an organisation for the purposes of that Act (as a wholly-owned Commonwealth company is an organisation as defined in section 6C of that Act)."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Integrity purpose spreads across time and individuals.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Spread of integrity purpose",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spreads",
      "cml:premiseText": "An integrity purpose relating to misconduct of a person covered by a subparagraph of paragraph (a) does not cease to exist merely because the person ceases to be covered by that subparagraph after the misconduct occurs."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Dealing with misconduct may involve repeating actions such as taking legal proceedings.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Repeating actions for dealing with misconduct",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "Taking legal proceedings, disciplinary proceedings or other administrative action is an example of dealing with matters described in paragraphs (a), (b), (c) and (d)."
    },
