      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Section applicability",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicability",
      "cml:premiseText": "(1) Section 86C of the Crimes Act 1914 applies to the collection of sensitive information on and after the commencement of that section."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Section applicability",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicability",
      "cml:premiseText": "(2) Section 86D of the Crimes Act 1914 applies to the use of personal information by a target entity on or after the commencement of that section, whether the entity collected the information before, on or after that commencement."
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-4-logic-deontic-3",
      "@type": "cml:LogicApplication",
