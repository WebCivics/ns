    <https://ns.webcivics.net/cml/operator> "ClassInclusion";
    <https://ns.webcivics.net/cml/logicSummary> "Target entity is an APP entity as defined in section 6 of the Privacy Act 1988.";
    <https://ns.webcivics.net/cml/premiseText> "A target entity is an APP entity as defined in section 6 of the Privacy Act 1988, because it is either an agency or an organisation for the purposes of that Act (as a wholly-owned Commonwealth company is an organisation as defined in section 6C of that Act).";
    <https://ns.webcivics.net/cml/conclusionText> "Target entity means: ... (a) a Privacy Act agency; or (b) a wholly-owned Commonwealth company.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::dl";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
