doc:sch-2-sec-5 a cof:Section ;
    cof:title "5 After subsection 23H(1)" ;
    values:kind "section" ;
    values:originalText "Add:  (1A) To avoid doubt, the obligations imposed by subsection (1) do not limit and are not limited by any other obligations imposed, or rights conferred, by this section.  (1AB) If a representative of an Aboriginal legal assistance organisation is notified under subsection (1), the investigating official must not question the person until the earlier of the following times:  Obligations of investigating officials  Schedule 2  No. 75, 2018 Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2018  (a) the representative has communicated with the person;  (b) 2 hours have elapsed since the representative was notified." ;
    cof:pageNumber "8"^^xsd:integer .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-2-sec-6 a cml:Concept ;
    skos:prefLabel "6 Subsection 23H(2B)"@en ;
    cml:realizedBy doc:sch-2-sec-6 ;
    values:originalText "Repeal the subsection, substitute:  (2B) If an interview friend is not chosen under subsection (2A), the investigating official must choose a representative of an Aboriginal legal assistance organisation in the State or Territory in which the person is located to be the person’s interview friend." ;
    skos:definition "Repeal the subsection, substitute:  (2B) If an interview friend is not chosen under subsection (2A), the investigating official must choose a representative of an Aboriginal legal assistance organisation in the State or Territory in which the person is located to be the person’s interview friend."@en ;
    cml:integrityHash "843ec34ad5cca4387b6877e7e1d005377b3ebbcca7323bbbe816b53a4088a302" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Must choose representative of Aboriginal legal assistance organisation as interview friend." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
