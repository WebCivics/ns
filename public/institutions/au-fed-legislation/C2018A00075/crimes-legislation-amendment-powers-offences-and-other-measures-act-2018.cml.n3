    cml:hasPart concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-2-ss-1a ;
    cml:hasPart concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-2-ss-1b ;
    cml:hasPart concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-2-ss-1c ;
    cml:hasPart concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-2-ss-1d ;
    cml:hasPart concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-2-ss-1e ;
