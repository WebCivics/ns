    values:partOf concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86e ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "Disclosure of personal information to target entity for integrity purposes is required if a law limits disclosure and exempts it from the limitation." ;
