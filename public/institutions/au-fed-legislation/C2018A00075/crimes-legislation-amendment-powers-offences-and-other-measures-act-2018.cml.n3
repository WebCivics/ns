    cml:premiseText "(a) the person is, or has been, an entrusted person; and (b) information came to the knowledge or into the possession of the person in the person’s capacity as an entrusted person;" ;
    cml:conclusionText "The person knows they are an entrusted person." ;
    cml:executionSurface "modalities::epistemic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-2-ss-1b cml:asserts concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-2-ss-1b-logic-ltl-5 .
