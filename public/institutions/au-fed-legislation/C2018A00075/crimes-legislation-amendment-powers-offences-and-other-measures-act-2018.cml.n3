concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-2-sec-15 a cml:Concept ;
    skos:prefLabel "15 Paragraphs 23WG(4)(a) and (b)"@en ;
    cml:realizedBy doc:sch-2-sec-15 ;
    values:originalText "Repeal the paragraphs, substitute:  (a) inform the suspect that a representative of an Aboriginal legal assistance organisation will be notified that the suspect is to be asked to consent to a forensic procedure; and  (b) notify such a representative that the suspect is to be asked to consent to a forensic procedure.  Controlled operation disclosure offence  Schedule 3  No. 75, 2018 Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2018" ;
    skos:definition "Repeal the paragraphs, substitute:  (a) inform the suspect that a representative of an Aboriginal legal assistance organisation will be notified that the suspect is to be asked to consent to a forensic procedure; and  (b) notify such a representative that the suspect is to be asked to consent to a forensic procedure.  Controlled operation disclosure offence  Schedule 3  No. 75, 2018 Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2018"@en ;
    cml:integrityHash "e323173e5cc632e091675fb0e7771892ee137a735b50a3af771bfc90d807d083" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Notify Aboriginal legal assistance organisation representative of forensic procedure consent request." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf> ;
