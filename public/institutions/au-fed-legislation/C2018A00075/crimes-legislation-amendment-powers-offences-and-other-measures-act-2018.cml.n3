doc:sch-6-sec-1-ss-7 a cof:Section ;
    cof:title "1(7) Subsection 15YR(6)" ;
    values:kind "subsection" ;
    values:originalText "(7) A person who makes an application for leave under this section must take reasonable steps to give written notice of the application to each of the following:  (a) the prosecutor in the proceeding;  (b) each defendant in the proceeding;  (c) each other party to the proceeding to whom subsection (1A) applies." ;
    cof:pageNumber "17"^^xsd:integer .

concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1-ss-8 a cml:Concept ;
    skos:prefLabel "1(8) Subsection 15YR(6)"@en ;
    cml:realizedBy doc:sch-6-sec-1-ss-8 ;
    values:originalText "(8) If a party referred to in paragraph (7)(c) is a child at the time the application is made, the notice must be given to a parent, guardian or legal representative of the party." ;
    skos:definition "(8) If a party referred to in paragraph (7)(c) is a child at the time the application is made, the notice must be given to a parent, guardian or legal representative of the party."@en ;
    cml:integrityHash "d8fda8497fa622cc07097f1b894a81a423b9a29f4e9e9db48a60aa644bcfcf6d" ;
    values:partOf concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1 ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Notice must be given to a parent, guardian or legal representative of the party if the child is referred to in paragraph (7)(c) at the time of application. Consider submissions and other evidence as necessary for determining an application." ;
