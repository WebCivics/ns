concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-2 a cml:Concept ;
    skos:prefLabel "2 Application of amendment"@en ;
    cml:realizedBy doc:sch-6-sec-2 ;
    values:originalText "The amendment of section 15YR of the Crimes Act 1914 made by this Schedule applies in relation to applications made on or after the commencement of this Schedule.  Schedule 7  Personal information that may be relevant for integrity purposes  Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2018 No. 75, 2018" ;
    skos:definition "The amendment of section 15YR of the Crimes Act 1914 made by this Schedule applies in relation to applications made on or after the commencement of this Schedule.  Schedule 7  Personal information that may be relevant for integrity purposes  Crimes Legislation Amendment (Powers, Offences and Other Measures) Act 2018 No. 75, 2018"@en ;
    cml:integrityHash "a2d207c62cc546d7e2e3effef30dd5b85e7905f29843ab42ff0e712975ec00ee" ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Amendment applies on or after commencement of Schedule." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
