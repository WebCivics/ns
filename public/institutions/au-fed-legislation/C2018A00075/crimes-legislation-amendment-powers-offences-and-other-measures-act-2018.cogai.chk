  operator: Repeats;
  summary: Repeating actions for dealing with misconduct;
  executionSurface: modalities::temporal_ltl;
  curationStatus: Proposed;
  @condition: Taking legal proceedings, disciplinary proceedings or other administrative action is an example of dealing with matters described in paragraphs (a), (b), (c) and (d).;
  @action: Dealing with misconduct may involve repeating actions such as taking legal proceedings.;
}

