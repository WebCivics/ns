      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Australian Federal Police Act 1979  Schedule 1\n\nNo. 75, 2018\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendment of the Australian Federal Police Act 1979  Schedule 1\n\nNo. 75, 2018\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sec-3-norm"
        }
      ],
      "cml:integrityHash": "1dc71eac328d175a612c1fc12c0d32900fc6776f4939d873e6e1e7af3da17372",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
