      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86e-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission to disclose personal information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "person, body or authority reasonably believes",
      "cml:conclusionText": "personal information related to target entity's functions or activities"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86e-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "86E(3) Disclosure of personal information to target entity for integrity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-7-sec-86e-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.20",
      "values:originalText": "(3) Subsection (2) applies to a disclosure by a target entity other than\nthe Australian Federal Police only if it is made for the target entity\nby a person who is authorised to make disclosures for integrity\npurposes by:\n\n(a) the accountable authority (within the meaning of the Public\nGovernance, Performance and Accountability Act 2013) of\nthe entity, if it is a Commonwealth entity; or\n\n(b) the entity or its principal executive (within the meaning of\nthe Privacy Act 1988), if it is a Privacy Act agency other than\na Commonwealth entity; or\n\n(c) a director of the entity, if it is a wholly-owned\nCommonwealth company.\n86F  This Part does not limit other laws\n\nTo avoid doubt, this Part does not impliedly limit other laws\n(whether written or unwritten) that authorise collection, use or\ndisclosure of personal information.",
      "skos:definition": "(3) Subsection (2) applies to a disclosure by a target entity other than\nthe Australian Federal Police only if it is made for the target entity\nby a person who is authorised to make disclosures for integrity\npurposes by:\n\n(a) the accountable authority (within the meaning of the Public\nGovernance, Performance and Accountability Act 2013) of\nthe entity, if it is a Commonwealth entity; or\n\n(b) the entity or its principal executive (within the meaning of\nthe Privacy Act 1988), if it is a Privacy Act agency other than\na Commonwealth entity; or\n\n(c) a director of the entity, if it is a wholly-owned\nCommonwealth company.\n86F  This Part does not limit other laws\n\nTo avoid doubt, this Part does not impliedly limit other laws\n(whether written or unwritten) that authorise collection, use or\ndisclosure of personal information.",
      "values:partOf": {
        "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86e"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86e-ss-3-norm"
        },
