      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.15",
      "values:originalText": "The amendments made by this Schedule apply in relation to conduct\nengaged in on or after the commencement of this Schedule.\n\nSchedule 5  Removing obsolete reference to death penalty\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018",
      "skos:definition": "The amendments made by this Schedule apply in relation to conduct\nengaged in on or after the commencement of this Schedule.\n\nSchedule 5  Removing obsolete reference to death penalty\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018",
      "cml:asserts": [
