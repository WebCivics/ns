    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 15YR(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-6-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.17",
      "values:originalText": "Repeal the subsection, substitute:\n\n(6) An application for leave under this section must be in writing.\n\n(7) A person who makes an application for leave under this section\nmust take reasonable steps to give written notice of the application\nto each of the following:\n\n(a) the prosecutor in the proceeding;\n\n(b) each defendant in the proceeding;\n\n(c) each other party to the proceeding to whom subsection (1A)\napplies.\n\n(8) If a party referred to in paragraph (7)(c) is a child at the time the\napplication is made, the notice must be given to a parent, guardian\nor legal representative of the party.\n\n(9) A notice under subsection (7) must:\n\n(a) be given no later than 3 business days before the day the\napplication is to be heard; and\n\n(b) be accompanied by a copy of the application.\n\n(10) An application for leave under this section must not be determined\nunless the court:\n\n(a) is satisfied the applicant has taken reasonable steps to give\nnotice of the application in accordance with subsections (7),\n(8) and (9); and\n\n(b) has considered such submissions and other evidence as it\nthinks necessary for determining the application.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(6) An application for leave under this section must be in writing.\n\n(7) A person who makes an application for leave under this section\nmust take reasonable steps to give written notice of the application\nto each of the following:\n\n(a) the prosecutor in the proceeding;\n\n(b) each defendant in the proceeding;\n\n(c) each other party to the proceeding to whom subsection (1A)\napplies.\n\n(8) If a party referred to in paragraph (7)(c) is a child at the time the\napplication is made, the notice must be given to a parent, guardian\nor legal representative of the party.\n\n(9) A notice under subsection (7) must:\n\n(a) be given no later than 3 business days before the day the\napplication is to be heard; and\n\n(b) be accompanied by a copy of the application.\n\n(10) An application for leave under this section must not be determined\nunless the court:\n\n(a) is satisfied the applicant has taken reasonable steps to give\nnotice of the application in accordance with subsections (7),\n(8) and (9); and\n\n(b) has considered such submissions and other evidence as it\nthinks necessary for determining the application.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1-ss-6"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1-ss-7"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1-ss-8"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1-ss-9"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1-ss-10"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-6-sec-1-ss-8"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-6-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 15YR(6)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Repeal the subsection, substitute:\n\n(6) An application for leave under this section must be in writing.\n\n(7) A person who makes an application for leave under this section\nmust take reasonable steps to give written notice of the application\nto each of the following:\n\n(a) the prosecutor in the proceeding;\n\n(b) each defendant in the proceeding;\n\n(c) each other party to the proceeding to whom subsection (1A)\napplies.\n\n(8) If a party referred to in paragraph (7)(c) is a child at the time the\napplication is made, the notice must be given to a parent, guardian\nor legal representative of the party.\n\n(9) A notice under subsection (7) must:\n\n(a) be given no later than 3 business days before the day the\napplication is to be heard; and\n\n(b) be accompanied by a copy of the application.\n\n(10) An application for leave under this section must not be determined\nunless the court:\n\n(a) is satisfied the applicant has taken reasonable steps to give\nnotice of the application in accordance with subsections (7),\n(8) and (9); and\n\n(b) has considered such submissions and other evidence as it\nthinks necessary for determining the application."
    },
