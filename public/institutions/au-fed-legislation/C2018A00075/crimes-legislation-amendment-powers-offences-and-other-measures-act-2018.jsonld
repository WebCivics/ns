    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-2-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Paragraphs 23WG(4)(a) and (b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-2-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.10",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) inform the suspect that a representative of an Aboriginal legal\nassistance organisation will be notified that the suspect is to\nbe asked to consent to a forensic procedure; and\n\n(b) notify such a representative that the suspect is to be asked to\nconsent to a forensic procedure.\n\nControlled operation disclosure offence  Schedule 3\n\nNo. 75, 2018\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(a) inform the suspect that a representative of an Aboriginal legal\nassistance organisation will be notified that the suspect is to\nbe asked to consent to a forensic procedure; and\n\n(b) notify such a representative that the suspect is to be asked to\nconsent to a forensic procedure.\n\nControlled operation disclosure offence  Schedule 3\n\nNo. 75, 2018\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-2-sec-15-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-2-sec-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e323173e5cc632e091675fb0e7771892ee137a735b50a3af771bfc90d807d083",
      "skos:note": "Notify Aboriginal legal assistance organisation representative of forensic procedure consent request."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-2-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Paragraphs 23WG(4)(a) and (b)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) inform the suspect that a representative of an Aboriginal legal\nassistance organisation will be notified that the suspect is to\nbe asked to consent to a forensic procedure; and\n\n(b) notify such a representative that the suspect is to be asked to\nconsent to a forensic procedure.\n\nControlled operation disclosure offence  Schedule 3\n\nNo. 75, 2018\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-2-sec-15-norm",
