    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-7-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.22",
      "values:originalText": "(1)\nSection 86C of the Crimes Act 1914 applies to the collection of\nsensitive information on and after the commencement of that section.\n(2)\nSection 86D of the Crimes Act 1914 applies to the use of personal\ninformation by a target entity on or after the commencement of that\nsection, whether the entity collected the information before, on or after\nthat commencement.\n(3)\nSection 86E of the Crimes Act 1914 applies to the disclosure of personal\ninformation on or after the commencement of that section, whether the\nperson, body or authority making the disclosure collected the\ninformation before, on or after that commencement.\n\nExemptions to spent convictions scheme  Schedule 8\n\nNo. 75, 2018\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018",
      "skos:definition": "(1)\nSection 86C of the Crimes Act 1914 applies to the collection of\nsensitive information on and after the commencement of that section.\n(2)\nSection 86D of the Crimes Act 1914 applies to the use of personal\ninformation by a target entity on or after the commencement of that\nsection, whether the entity collected the information before, on or after\nthat commencement.\n(3)\nSection 86E of the Crimes Act 1914 applies to the disclosure of personal\ninformation on or after the commencement of that section, whether the\nperson, body or authority making the disclosure collected the\ninformation before, on or after that commencement.\n\nExemptions to spent convictions scheme  Schedule 8\n\nNo. 75, 2018\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-4-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-4-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-4-logic-deontic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-4-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "2a20301cfffd3d4a936ced0e3b5aadae8c7b648479b1883dd917fa663a965e9a",
      "skos:note": "Applicability of sections 86C, 86D, and 86E of the Crimes Act 1914"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-7-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Application",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "(1)\nSection 86C of the Crimes Act 1914 applies to the collection of\nsensitive information on and after the commencement of that section.\n(2)\nSection 86D of the Crimes Act 1914 applies to the use of personal\ninformation by a target entity on or after the commencement of that\nsection, whether the entity collected the information before, on or after\nthat commencement.\n(3)\nSection 86E of the Crimes Act 1914 applies to the disclosure of personal\ninformation on or after the commencement of that section, whether the\nperson, body or authority making the disclosure collected the\ninformation before, on or after that commencement.\n\nExemptions to spent convictions scheme  Schedule 8\n\nNo. 75, 2018\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018"
    },
