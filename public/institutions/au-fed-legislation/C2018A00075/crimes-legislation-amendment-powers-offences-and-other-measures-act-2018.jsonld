        }
      ],
      "cml:integrityHash": "444a9377367406251fd5d18078a16b46b6a62a08f2522768b4eba73de2bc7a9b",
      "skos:note": "Amendments apply in relation to conduct engaged in on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-4-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "The amendments made by this Schedule apply in relation to conduct\nengaged in on or after the commencement of this Schedule.\n\nSchedule 5  Removing obsolete reference to death penalty\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018"
