      "@type": "cml:Concept",
      "skos:prefLabel": "4 Paragraphs 23H(1)(a) and (b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-2-sec-4"
      },
