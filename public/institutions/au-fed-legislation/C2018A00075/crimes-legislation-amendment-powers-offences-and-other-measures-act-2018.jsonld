    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86b",
      "@type": "cml:Concept",
      "skos:prefLabel": "86B Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-7-sec-86b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.19",
      "values:originalText": "This Part authorises collection, use and disclosure of personal\ninformation for preventing, detecting, investigating or dealing\nwith:\n\nSchedule 7  Personal information that may be relevant for integrity purposes\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018\n\n(a)\nserious misconduct by persons working for\nCommonwealth bodies; or\n\n(b)\nfraud affecting Commonwealth bodies; or\n\n(c)\noffences against Chapter 7 of the Criminal Code (which\nis about the proper administration of Government).\nThe authorisation is relevant to laws (such as privacy laws) that\nlimit the collection, use and disclosure of personal information\nunless authorised by law.",
      "skos:definition": "This Part authorises collection, use and disclosure of personal\ninformation for preventing, detecting, investigating or dealing\nwith:\n\nSchedule 7  Personal information that may be relevant for integrity purposes\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018\n\n(a)\nserious misconduct by persons working for\nCommonwealth bodies; or\n\n(b)\nfraud affecting Commonwealth bodies; or\n\n(c)\noffences against Chapter 7 of the Criminal Code (which\nis about the proper administration of Government).\nThe authorisation is relevant to laws (such as privacy laws) that\nlimit the collection, use and disclosure of personal information\nunless authorised by law.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86b-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "739c64bc7d3143f208b955757a1f4005f7eb70430e725ea2f0597a06ad000480",
      "skos:note": "Authorization for collection, use and disclosure of personal information for integrity purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-7-sec-86b",
      "@type": "cof:Section",
      "cof:title": "86B Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "This Part authorises collection, use and disclosure of personal\ninformation for preventing, detecting, investigating or dealing\nwith:\n\nSchedule 7  Personal information that may be relevant for integrity purposes\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018\n\n(a)\nserious misconduct by persons working for\nCommonwealth bodies; or\n\n(b)\nfraud affecting Commonwealth bodies; or\n\n(c)\noffences against Chapter 7 of the Criminal Code (which\nis about the proper administration of Government).\nThe authorisation is relevant to laws (such as privacy laws) that\nlimit the collection, use and disclosure of personal information\nunless authorised by law."
    },
