    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 15GC",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-3-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf"
      },
      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.11",
      "values:originalText": "Insert:\nentrusted person means:\n\n(a) a participant in a controlled operation; or\n\n(b) any of the following:\n\n(i) the Commissioner or an AFP appointee (within the\nmeaning of the Australian Federal Police Act 1979);\n\n(ii) a member of the police force of a State or Territory;\n\n(iii) a staff member (within the meaning of the Law\nEnforcement Integrity Commissioner Act 2006) of the\nImmigration and Border Protection Department;\n\n(iv) the Chief Executive Officer of the ACC, a member of\nthe staff of the ACC (within the meaning of the\nAustralian Crime Commission Act 2002) or a person\nappointed under subsection 46B(1) of that Act;\n\n(v) a staff member (within the meaning of the Law\nEnforcement Integrity Commissioner Act 2006) of the\nAustralian Commission for Law Enforcement Integrity;\nor\n\n(c) an officer or staff member of a government agency, or an\nintegrity agency for a State or Territory, with which the\nIntegrity Commissioner is jointly investigating a corruption\nissue under subsection 26(2) of the Law Enforcement\nIntegrity Commissioner Act 2006, if a controlled operation\nrelates to the investigation; or\n\n(d) an officer (within the meaning of section 35 of the\nOmbudsman Act 1976); or\n\n(e) a person who has entered into a contract, agreement or\narrangement with:\n\n(i) a law enforcement agency; or\n\nSchedule 3  Controlled operation disclosure offence\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018\n\n(ii) a government agency, or an integrity agency, mentioned\nin paragraph (c); or\n\n(iii) the Commonwealth Ombudsman;\n\n(other than as a person mentioned in paragraphs (b) to (d)).",
      "skos:definition": "Insert:\nentrusted person means:\n\n(a) a participant in a controlled operation; or\n\n(b) any of the following:\n\n(i) the Commissioner or an AFP appointee (within the\nmeaning of the Australian Federal Police Act 1979);\n\n(ii) a member of the police force of a State or Territory;\n\n(iii) a staff member (within the meaning of the Law\nEnforcement Integrity Commissioner Act 2006) of the\nImmigration and Border Protection Department;\n\n(iv) the Chief Executive Officer of the ACC, a member of\nthe staff of the ACC (within the meaning of the\nAustralian Crime Commission Act 2002) or a person\nappointed under subsection 46B(1) of that Act;\n\n(v) a staff member (within the meaning of the Law\nEnforcement Integrity Commissioner Act 2006) of the\nAustralian Commission for Law Enforcement Integrity;\nor\n\n(c) an officer or staff member of a government agency, or an\nintegrity agency for a State or Territory, with which the\nIntegrity Commissioner is jointly investigating a corruption\nissue under subsection 26(2) of the Law Enforcement\nIntegrity Commissioner Act 2006, if a controlled operation\nrelates to the investigation; or\n\n(d) an officer (within the meaning of section 35 of the\nOmbudsman Act 1976); or\n\n(e) a person who has entered into a contract, agreement or\narrangement with:\n\n(i) a law enforcement agency; or\n\nSchedule 3  Controlled operation disclosure offence\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018\n\n(ii) a government agency, or an integrity agency, mentioned\nin paragraph (c); or\n\n(iii) the Commonwealth Ombudsman;\n\n(other than as a person mentioned in paragraphs (b) to (d)).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-1-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-1-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-1-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-1-logic-descriptionlogic-3"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-1-logic-descriptionlogic-4"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-1-logic-descriptionlogic-5"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-3-sec-1-logic-descriptionlogic-6"
        }
      ],
      "cml:integrityHash": "e03ca3b12ad30c33a9e9ad374903b943f22e7bfea321fe0e5253769382fd2d15",
      "skos:note": "Defines 'entrusted person'"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-3-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Section 15GC",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Insert:\nentrusted person means:\n\n(a) a participant in a controlled operation; or\n\n(b) any of the following:\n\n(i) the Commissioner or an AFP appointee (within the\nmeaning of the Australian Federal Police Act 1979);\n\n(ii) a member of the police force of a State or Territory;\n\n(iii) a staff member (within the meaning of the Law\nEnforcement Integrity Commissioner Act 2006) of the\nImmigration and Border Protection Department;\n\n(iv) the Chief Executive Officer of the ACC, a member of\nthe staff of the ACC (within the meaning of the\nAustralian Crime Commission Act 2002) or a person\nappointed under subsection 46B(1) of that Act;\n\n(v) a staff member (within the meaning of the Law\nEnforcement Integrity Commissioner Act 2006) of the\nAustralian Commission for Law Enforcement Integrity;\nor\n\n(c) an officer or staff member of a government agency, or an\nintegrity agency for a State or Territory, with which the\nIntegrity Commissioner is jointly investigating a corruption\nissue under subsection 26(2) of the Law Enforcement\nIntegrity Commissioner Act 2006, if a controlled operation\nrelates to the investigation; or\n\n(d) an officer (within the meaning of section 35 of the\nOmbudsman Act 1976); or\n\n(e) a person who has entered into a contract, agreement or\narrangement with:\n\n(i) a law enforcement agency; or\n\nSchedule 3  Controlled operation disclosure offence\n\nCrimes Legislation Amendment (Powers, Offences and Other\nMeasures) Act 2018\nNo. 75, 2018\n\n(ii) a government agency, or an integrity agency, mentioned\nin paragraph (c); or\n\n(iii) the Commonwealth Ombudsman;\n\n(other than as a person mentioned in paragraphs (b) to (d))."
    },
