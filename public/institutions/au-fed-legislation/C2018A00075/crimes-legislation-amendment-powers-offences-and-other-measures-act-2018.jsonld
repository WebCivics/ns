      "dc:source": "crimes-legislation-amendment-powers-offences-and-other-measures-act-2018.pdf, p.8",
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) inform the person that a representative of an Aboriginal legal\nassistance organisation in the State or Territory in which the\nperson is located will be notified that the person is under\narrest or is a protected suspect (as the case requires); and\n\n(b) notify such a representative that the person is under arrest or\nis a protected suspect (as the case requires).",
      "skos:definition": "Repeal the paragraphs, substitute:\n\n(a) inform the person that a representative of an Aboriginal legal\nassistance organisation in the State or Territory in which the\nperson is located will be notified that the person is under\narrest or is a protected suspect (as the case requires); and\n\n(b) notify such a representative that the person is under arrest or\nis a protected suspect (as the case requires).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-2-sec-4-norm"
        },
        {
          "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-2-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8c6a3fd84cec41d1933ba224b91c30d1bceab9e60738614a20b15a5016de33a2",
      "skos:note": "Notify Aboriginal legal assistance organisation of arrest or protected suspect status."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-2-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Paragraphs 23H(1)(a) and (b)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the paragraphs, substitute:\n\n(a) inform the person that a representative of an Aboriginal legal\nassistance organisation in the State or Territory in which the\nperson is located will be notified that the person is under\narrest or is a protected suspect (as the case requires); and\n\n(b) notify such a representative that the person is under arrest or\nis a protected suspect (as the case requires)."
    },
