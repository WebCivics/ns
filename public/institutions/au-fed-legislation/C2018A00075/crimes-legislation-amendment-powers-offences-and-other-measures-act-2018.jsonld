      "cml:integrityHash": "643dbc33f525daec97a2d46da373e4dd864e4bd6c6e70a0c4f6f8d8108d6b4a1",
      "skos:note": "Disclosure of personal information to target entity for integrity purpose"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-powers-offences-and-other-measures-act-2018#sch-7-sec-86e-ss-2",
      "@type": "cof:Section",
      "cof:title": "86E(2) Disclosure of personal information to target entity for integrity",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(2) For the purposes of the exemption, the person, body or authority\nmay disclose to a target entity for an integrity purpose personal\ninformation that the person, body or authority reasonably believes\nis related to one or more of the target entity’s functions or\nactivities.\nLimit on subsection (2) for disclosures by target entity"
    },
    {
      "@id": "concept:crimes-legislation-amendment-powers-offences-and-other-measures-act-2018-sch-7-sec-86e-ss-2-norm",
      "@type": "values:Permission",
