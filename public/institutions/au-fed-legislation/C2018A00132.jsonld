      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exception applies if the person deselects the charge within a certain time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "If the person deselects the optional carbon offset charge later in the online booking process, the single price does not need to include the carbon offset charge after the charge is deselected."
    },
    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The airline's obligation to include the carbon offset charge is waived if the person deselects it within a certain time frame.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Reasoning about obligation",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "=",
      "cml:premiseText": "If the person deselects the optional carbon offset charge later in the online booking process, the single price does not need to include the carbon offset charge after the charge is deselected."
    },
    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The airline's AI system must include the carbon offset charge in the flight price if preselected.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Artificial intelligence application",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "=",
      "cml:premiseText": "The online booking system can be designed to automatically include the carbon offset charge if preselected."
    },
    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The airline must include the carbon offset charge in the flight price if preselected.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Duty to include carbon offset charge",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "This is because the person has not, at or before the time of the representation, deselected the charge on the online booking site."
    },
    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The airline must inform the person about the option to pay for a carbon offset charge.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
