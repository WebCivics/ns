    cml:operator "=" ;
    cml:logicSummary "Duty to include carbon offset charge" ;
    cml:premiseText "This is because the person has not, at or before the time of the representation, deselected the charge on the online booking site." ;
    cml:conclusionText "The airline must include the carbon offset charge in the flight price if preselected." ;
