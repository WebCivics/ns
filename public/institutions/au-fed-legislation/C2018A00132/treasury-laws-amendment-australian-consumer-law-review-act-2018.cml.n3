doc:sch-1-sec-2-ss-1 a cof:Section ;
    cof:title "2(1) Subsections 137H(1) and (2)" ;
    values:kind "subsection" ;
    values:originalText "(1) In:  (a) an action against a person under subsection 236(1) of the Australian Consumer Law; or  (b) proceedings for an order against a person under subsection 237(1) or 239(1) of the Australian Consumer Law; a finding of any fact made by a court, or an admission of any fact made by the person, is prima facie evidence of that fact if the finding or admission is made in proceedings to which subsection (3) of this section applies." ;
    cof:pageNumber "7"^^xsd:integer .

concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-1-sec-2-ss-2 a cml:Concept ;
    skos:prefLabel "2(2) Subsections 137H(1) and (2)"@en ;
    cml:realizedBy doc:sch-1-sec-2-ss-2 ;
    values:originalText "(2) The finding or admission may be proved by production of:  (a) in any case—a document under the seal of the court from which the finding or admission appears; or  (b) in the case of an admission—a document from which the admission appears that is filed in the court." ;
    skos:definition "(2) The finding or admission may be proved by production of:  (a) in any case—a document under the seal of the court from which the finding or admission appears; or  (b) in the case of an admission—a document from which the admission appears that is filed in the court."@en ;
    cml:integrityHash "ea89367ebfd4ae0b7367311e751c3c6c5aa4b27605c868d0ba9ebcd5a636b370" ;
    values:partOf concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-1-sec-2 ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Provision for proving finding or admission" ;
    dc:description "Document under the seal of the court or a filed document" ;
    cml:curationStatus cml:Proposed ;
