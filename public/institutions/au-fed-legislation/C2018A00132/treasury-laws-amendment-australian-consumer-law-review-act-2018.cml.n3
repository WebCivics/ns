concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2 cml:asserts concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-alleninterval-1 .
concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-alleninterval-1 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Temporal interval" ;
    cml:premiseText "If the person deselects the optional carbon offset charge later in the online booking process, the single price does not need to include the carbon offset charge after the charge is deselected." ;
    cml:conclusionText "The exception applies if the person deselects the charge within a certain time frame." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2 cml:asserts concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-deontic-2 .
concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Duty to include carbon offset charge" ;
    cml:premiseText "This is because the person has not, at or before the time of the representation, deselected the charge on the online booking site." ;
    cml:conclusionText "The airline must include the carbon offset charge in the flight price if preselected." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2 cml:asserts concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-argumentation-3 .
concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "=" ;
    cml:logicSummary "Reasoning about obligation" ;
    cml:premiseText "If the person deselects the optional carbon offset charge later in the online booking process, the single price does not need to include the carbon offset charge after the charge is deselected." ;
    cml:conclusionText "The airline's obligation to include the carbon offset charge is waived if the person deselects it within a certain time frame." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2 cml:asserts concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-diffusion-4 .
