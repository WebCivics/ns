    cml:modality cml:Diffusion ;
    cml:operator "=" ;
    cml:logicSummary "Spread of information" ;
    cml:premiseText "This exception provides for the spread of information about the optional carbon offset charge." ;
    cml:conclusionText "The airline must inform the person about the option to pay for a carbon offset charge." ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2 cml:asserts concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-cogai-5 .
