concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-1 a cml:Concept ;
    skos:prefLabel "1 Paragraph 48(7)(a) of Schedule 2"@en ;
    cml:realizedBy doc:sch-5-sec-1 ;
    values:originalText "Repeal the paragraph, substitute:  (a) a charge of any description payable to the person making the representation by another person unless:  (i) the charge is payable at the option of the other person; and  (ii) at or before the time of the representation, the other person has either deselected the charge or not expressly requested that the charge be applied;" ;
    skos:definition "Repeal the paragraph, substitute:  (a) a charge of any description payable to the person making the representation by another person unless:  (i) the charge is payable at the option of the other person; and  (ii) at or before the time of the representation, the other person has either deselected the charge or not expressly requested that the charge be applied;"@en ;
    cml:integrityHash "4d91216c76d70ea263d281b01120655064450c54326162adc6291e61d99ac828" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Repeal of a charge payable to another person unless certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
