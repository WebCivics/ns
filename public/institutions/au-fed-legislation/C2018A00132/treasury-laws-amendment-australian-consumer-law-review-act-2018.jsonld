    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-12-sec-301",
      "@type": "cml:Concept",
      "skos:prefLabel": "301 Application—guarantees relating to the supply of services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-12-sec-301"
      },
