      "skos:note": "Omit 'supplying'"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-3-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Paragraph 162(3)(a) of Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Omit “supplying”.\n\nSchedule 4  Unsolicited consumer agreements\n\nTreasury Laws Amendment (Australian Consumer Law Review) Act\nNo. 132, 2018"
    },
    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-3-sec-5-norm",
