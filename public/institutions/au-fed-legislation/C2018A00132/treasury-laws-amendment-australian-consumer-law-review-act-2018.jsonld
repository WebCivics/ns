    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-3-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 2(1) of Schedule 2 (definition of unsolicited",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-3-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf"
      },
      "dc:source": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf, p.9",
      "values:originalText": "services)\nRepeal the definition, substitute:\nunsolicited services means:\n\n(a) services supplied to a person; or\n\n(b) services purported to have been supplied to a person which\nhave not been supplied;\nwithout any request made by the person or on his or her behalf.",
      "skos:definition": "services)\nRepeal the definition, substitute:\nunsolicited services means:\n\n(a) services supplied to a person; or\n\n(b) services purported to have been supplied to a person which\nhave not been supplied;\nwithout any request made by the person or on his or her behalf.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-3-sec-1-norm"
