        }
      ],
      "cml:integrityHash": "3d249b3205e9c2bdf36636e3ff876265a4927ce6312d8fcf22eda391fa286fc3",
      "skos:note": "Commission must investigate or inquire into consumer contracts for court application purposes."
    },
    {
