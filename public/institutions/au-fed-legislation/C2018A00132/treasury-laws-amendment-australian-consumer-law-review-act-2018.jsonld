      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the person deselects the optional carbon offset charge later in the online booking process, the single price does not need to include the carbon offset charge after the charge is deselected.",
      "cml:conclusionText": "The exception applies if the person deselects the charge within a certain time frame."
    },
    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Duty to include carbon offset charge",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "This is because the person has not, at or before the time of the representation, deselected the charge on the online booking site.",
      "cml:conclusionText": "The airline must include the carbon offset charge in the flight price if preselected."
    },
    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Reasoning about obligation",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the person deselects the optional carbon offset charge later in the online booking process, the single price does not need to include the carbon offset charge after the charge is deselected.",
      "cml:conclusionText": "The airline's obligation to include the carbon offset charge is waived if the person deselects it within a certain time frame."
    },
    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Spread of information",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
