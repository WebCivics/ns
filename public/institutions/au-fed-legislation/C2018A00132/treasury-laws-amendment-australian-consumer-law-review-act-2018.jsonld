    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-4-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After subsection 69(1) of Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-4-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf"
      },
      "dc:source": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf, p.10",
      "values:originalText": "Insert:\n\n(1AA) To avoid doubt, a place mentioned in subsection (1)(b)(i) may be a\npublic place, and need not be a place the dealer cannot enter\nwithout the consumer’s consent or invitation.\nNote:\nThis subsection was inserted as a response to the decision of the\nFederal Court of Australia in Australian Competition and Consumer\nCommission v A.C.N. 099 814 749 Pty Ltd [2016] FCA 403.\n\nPricing  Schedule 5\n\nNo. 132, 2018\nTreasury Laws Amendment (Australian Consumer Law Review) Act",
      "skos:definition": "Insert:\n\n(1AA) To avoid doubt, a place mentioned in subsection (1)(b)(i) may be a\npublic place, and need not be a place the dealer cannot enter\nwithout the consumer’s consent or invitation.\nNote:\nThis subsection was inserted as a response to the decision of the\nFederal Court of Australia in Australian Competition and Consumer\nCommission v A.C.N. 099 814 749 Pty Ltd [2016] FCA 403.\n\nPricing  Schedule 5\n\nNo. 132, 2018\nTreasury Laws Amendment (Australian Consumer Law Review) Act",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-4-sec-1-norm"
        }
      ],
      "cml:integrityHash": "665377c5bf8c52aa480a3b5c2933a2de591c76088400f6998609a5b9e17fde64",
      "skos:note": "Clarifies that a place mentioned in subsection (1)(b)(i) may be a public place without needing consumer consent or invitation."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-4-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 After subsection 69(1) of Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Insert:\n\n(1AA) To avoid doubt, a place mentioned in subsection (1)(b)(i) may be a\npublic place, and need not be a place the dealer cannot enter\nwithout the consumer’s consent or invitation.\nNote:\nThis subsection was inserted as a response to the decision of the\nFederal Court of Australia in Australian Competition and Consumer\nCommission v A.C.N. 099 814 749 Pty Ltd [2016] FCA 403.\n\nPricing  Schedule 5\n\nNo. 132, 2018\nTreasury Laws Amendment (Australian Consumer Law Review) Act"
    },
