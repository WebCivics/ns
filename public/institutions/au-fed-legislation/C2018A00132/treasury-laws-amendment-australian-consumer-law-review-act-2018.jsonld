      },
      "dc:source": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf, p.21",
      "values:originalText": "The amendments made by Schedule 9 to the Treasury Laws\nAmendment (Australian Consumer Law Review) Act 2018 apply in\nrelation to services supplied under a contract entered into on or\nafter the day that Schedule commences.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 28 March 2018\nSenate on 13 August 2018]\n\n(78/18)",
      "skos:definition": "The amendments made by Schedule 9 to the Treasury Laws\nAmendment (Australian Consumer Law Review) Act 2018 apply in\nrelation to services supplied under a contract entered into on or\nafter the day that Schedule commences.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 28 March 2018\nSenate on 13 August 2018]\n\n(78/18)",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-12-sec-301-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-12-sec-301-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e1ea36dcdc847a9aaea4bd97ce9f610c70fd206d37dfda07815712149eac50ad",
      "skos:note": "Amendments apply in relation to services supplied under a contract entered into on or after the commencement day."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-12-sec-301",
