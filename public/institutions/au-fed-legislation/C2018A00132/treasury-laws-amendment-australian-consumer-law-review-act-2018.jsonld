      "dc:source": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf, p.13",
      "values:originalText": "The amendments made by this Schedule apply in relation to disclosure\nnotices given on or after the commencement of this Schedule.\n\nSchedule 7  Power to obtain information, documents and evidence\n\nTreasury Laws Amendment (Australian Consumer Law Review) Act\nNo. 132, 2018",
      "skos:definition": "The amendments made by this Schedule apply in relation to disclosure\nnotices given on or after the commencement of this Schedule.\n\nSchedule 7  Power to obtain information, documents and evidence\n\nTreasury Laws Amendment (Australian Consumer Law Review) Act\nNo. 132, 2018",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-6-sec-4-norm"
        }
      ],
      "cml:integrityHash": "bf24265abe1bd9ef70e15b99ef12cddf435a28855c78808cb2453febb007bdad",
      "skos:note": "Amendments apply in relation to disclosure notices given on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-6-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Application",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "The amendments made by this Schedule apply in relation to disclosure\nnotices given on or after the commencement of this Schedule.\n\nSchedule 7  Power to obtain information, documents and evidence\n\nTreasury Laws Amendment (Australian Consumer Law Review) Act\nNo. 132, 2018"
    },
