      "dc:source": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf, p.11",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) a charge of any description payable to the person making the\nrepresentation by another person unless:\n\n(i) the charge is payable at the option of the other person;\nand\n\n(ii) at or before the time of the representation, the other\nperson has either deselected the charge or not expressly\nrequested that the charge be applied;",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) a charge of any description payable to the person making the\nrepresentation by another person unless:\n\n(i) the charge is payable at the option of the other person;\nand\n\n(ii) at or before the time of the representation, the other\nperson has either deselected the charge or not expressly\nrequested that the charge be applied;",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-1-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-5-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4d91216c76d70ea263d281b01120655064450c54326162adc6291e61d99ac828",
      "skos:note": "Repeal of a charge payable to another person unless certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-5-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Paragraph 48(7)(a) of Schedule 2",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) a charge of any description payable to the person making the\nrepresentation by another person unless:\n\n(i) the charge is payable at the option of the other person;\nand\n\n(ii) at or before the time of the representation, the other\nperson has either deselected the charge or not expressly\nrequested that the charge be applied;"
    },
