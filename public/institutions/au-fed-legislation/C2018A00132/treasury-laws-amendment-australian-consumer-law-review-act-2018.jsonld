    {
      "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-7-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 At the end of section 13",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-7-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf"
      },
      "dc:source": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf, p.14",
      "values:originalText": "Add:\n\n(7) If a consumer contract or a small business contract is:\n\n(a) a financial product; or\n\n(b) a contract for the supply, or possible supply, of services that\nare financial services;\nASIC may make such investigations as it thinks expedient into the\nterms of the contract for the purposes of determining whether or\nnot to make an application to the Court under section 12GND.\n\n(8) Expressions used in subsection (7) that are defined in Division 2 of\nPart 2 have the same meaning as in that Division.\nCompetition and Consumer Act 2010",
      "skos:definition": "Add:\n\n(7) If a consumer contract or a small business contract is:\n\n(a) a financial product; or\n\n(b) a contract for the supply, or possible supply, of services that\nare financial services;\nASIC may make such investigations as it thinks expedient into the\nterms of the contract for the purposes of determining whether or\nnot to make an application to the Court under section 12GND.\n\n(8) Expressions used in subsection (7) that are defined in Division 2 of\nPart 2 have the same meaning as in that Division.\nCompetition and Consumer Act 2010",
      "cml:hasPart": [
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-7-sec-1-ss-7"
        },
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-7-sec-1-ss-8"
        }
      ],
      "cml:integrityHash": "f552a1e79bdc74d313b3f0f000e309faa363c9b81f8db6b9d0fb2b41f0dcea48"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-7-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 At the end of section 13",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Add:\n\n(7) If a consumer contract or a small business contract is:\n\n(a) a financial product; or\n\n(b) a contract for the supply, or possible supply, of services that\nare financial services;\nASIC may make such investigations as it thinks expedient into the\nterms of the contract for the purposes of determining whether or\nnot to make an application to the Court under section 12GND.\n\n(8) Expressions used in subsection (7) that are defined in Division 2 of\nPart 2 have the same meaning as in that Division.\nCompetition and Consumer Act 2010"
    },
