      "dc:source": "treasury-laws-amendment-australian-consumer-law-review-act-2018.pdf, p.8",
      "values:originalText": "The amendment made by item 3 of this Schedule applies in relation to\nacts or omissions on or after the day this Schedule commences.\n\nUnsolicited supplies  Schedule 3\n\nNo. 132, 2018\nTreasury Laws Amendment (Australian Consumer Law Review) Act",
      "skos:definition": "The amendment made by item 3 of this Schedule applies in relation to\nacts or omissions on or after the day this Schedule commences.\n\nUnsolicited supplies  Schedule 3\n\nNo. 132, 2018\nTreasury Laws Amendment (Australian Consumer Law Review) Act",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-australian-consumer-law-review-act-2018-sch-2-sec-6-norm"
        }
      ],
      "cml:integrityHash": "55b3f9c9b6f1a3c0e8220d17733a49455b3c40f79882e82c8697af9695dc731e",
      "skos:note": "Commencement of amendment"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-2-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Application",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "The amendment made by item 3 of this Schedule applies in relation to\nacts or omissions on or after the day this Schedule commences.\n\nUnsolicited supplies  Schedule 3\n\nNo. 132, 2018\nTreasury Laws Amendment (Australian Consumer Law Review) Act"
    },
