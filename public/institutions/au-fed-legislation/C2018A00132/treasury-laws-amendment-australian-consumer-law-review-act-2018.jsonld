      "@type": "cml:Concept",
      "skos:prefLabel": "1 Paragraph 48(7)(a) of Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-australian-consumer-law-review-act-2018#sch-5-sec-1"
      },
