concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-84 a cml:Concept ;
    skos:prefLabel "84 Membership"@en ;
    cml:realizedBy doc:sch-2-sec-84 ;
    values:originalText "The Data Governance Board consists of the following members:  (a) the Chair of the Data Governance Board;  (b) the Deputy Chair of the Data Governance Board;  (c) at least 7, and no more than 10, other members." ;
