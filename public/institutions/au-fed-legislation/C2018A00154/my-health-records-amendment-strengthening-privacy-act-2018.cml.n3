concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-96a a cml:Concept ;
    skos:prefLabel "96A Voting at meetings"@en ;
    cml:realizedBy doc:sch-2-sec-96a ;
    values:originalText "(1) A question arising at a meeting of the Data Governance Board is to be determined by a majority of the votes of the members of the Board present and voting.  (2) The person presiding at a meeting of the Board has a deliberative vote and, if the votes are equal, a casting vote." ;
    skos:definition "(1) A question arising at a meeting of the Data Governance Board is to be determined by a majority of the votes of the members of the Board present and voting.  (2) The person presiding at a meeting of the Board has a deliberative vote and, if the votes are equal, a casting vote."@en ;
    cml:integrityHash "24b7caa706ab8702d99d961fdb435970d0f8b5fcbc5b27bce78e5da11c724f8c" ;
    cof:pageNumber "29"^^xsd:integer ;
    cml:hasPart concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-96a-ss-1 ;
    cml:hasPart concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-96a-ss-2 ;
