concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-90 a cml:Concept ;
    skos:prefLabel "90 Resignation"@en ;
    cml:realizedBy doc:sch-2-sec-90 ;
    values:originalText "(1) A member of the Data Governance Board may resign the member’s appointment by giving the Minister a written resignation.  Amendments commencing on Proclamation  Schedule 2  No. 154, 2018 My Health Records Amendment (Strengthening Privacy) Act 2018  (2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day." ;
    skos:definition "(1) A member of the Data Governance Board may resign the member’s appointment by giving the Minister a written resignation.  Amendments commencing on Proclamation  Schedule 2  No. 154, 2018 My Health Records Amendment (Strengthening Privacy) Act 2018  (2) The resignation takes effect on the day it is received by the Minister or, if a later day is specified in the resignation, on that later day."@en ;
    cml:integrityHash "313cc887008239b19da6ee40331005d3cb25b643bbf00d10fced2600c9fec708" ;
    cof:pageNumber "26"^^xsd:integer ;
