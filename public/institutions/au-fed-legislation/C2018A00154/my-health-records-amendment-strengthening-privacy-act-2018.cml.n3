concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-10 a cml:Concept ;
    skos:prefLabel "10 At the end of section 65"@en ;
    cml:realizedBy doc:sch-1-sec-10 ;
    values:originalText "Add:  (3) This subsection covers the following laws:  (a) this Act;  (b) the Auditor-General Act 1997;  (c) the Ombudsman Act 1976;  (d) a law of the Commonwealth to the extent that the law requires or authorises the collection, use or disclosure of information for the purposes of performing the Information Commissioner’s functions in relation to the My Health Record system.  Amendments  Schedule 1  No. 154, 2018 My Health Records Amendment (Strengthening Privacy) Act 2018" ;
    skos:definition "Add:  (3) This subsection covers the following laws:  (a) this Act;  (b) the Auditor-General Act 1997;  (c) the Ombudsman Act 1976;  (d) a law of the Commonwealth to the extent that the law requires or authorises the collection, use or disclosure of information for the purposes of performing the Information Commissioner’s functions in relation to the My Health Record system.  Amendments  Schedule 1  No. 154, 2018 My Health Records Amendment (Strengthening Privacy) Act 2018"@en ;
    cml:integrityHash "640d6b8573722619417fd8b4344a34d090439c15e414fd76ef9d54adcc585769" ;
