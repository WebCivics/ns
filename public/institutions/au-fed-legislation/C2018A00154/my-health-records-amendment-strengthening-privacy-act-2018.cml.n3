concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-1b a cml:Concept ;
    skos:prefLabel "1B After subsection 6(1)"@en ;
    cml:realizedBy doc:sch-1-sec-1b ;
    values:originalText "Insert:  (1A) Despite subsection (1), a person who has parental responsibility for a healthcare recipient aged under 18 is not the authorised representative of the healthcare recipient if the System Operator is satisfied that:  (a) under a court order or a law of the Commonwealth or a State or Territory, the person must be supervised while spending time with the healthcare recipient; or  (b) the life, health or safety of the healthcare recipient or another person would be put at risk if the person were the authorised representative of the healthcare recipient.  Amendments  Schedule 1  No. 154, 2018 My Health Records Amendment (Strengthening Privacy) Act 2018" ;
    skos:definition "Insert:  (1A) Despite subsection (1), a person who has parental responsibility for a healthcare recipient aged under 18 is not the authorised representative of the healthcare recipient if the System Operator is satisfied that:  (a) under a court order or a law of the Commonwealth or a State or Territory, the person must be supervised while spending time with the healthcare recipient; or  (b) the life, health or safety of the healthcare recipient or another person would be put at risk if the person were the authorised representative of the healthcare recipient.  Amendments  Schedule 1  No. 154, 2018 My Health Records Amendment (Strengthening Privacy) Act 2018"@en ;
    cml:integrityHash "a457bdef59a0df169689507e11ffdedf1d69d0d15b8bf66bb00cede63a5176ba" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Supervision required for unaccompanied minors with parental responsibility" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <my-health-records-amendment-strengthening-privacy-act-2018.pdf> ;
    dc:source "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.8" ;
    cml:asserts concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-1b-norm .
