concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-94 a cml:Concept ;
    skos:prefLabel "94 Convening meetings"@en ;
    cml:realizedBy doc:sch-2-sec-94 ;
    values:originalText "(1) The Data Governance Board must hold such meetings as are necessary for the efficient performance of its functions.  (2) The Chair of the Data Governance Board:  (a) may convene a meeting at any time; and  (b) must convene a meeting within 30 days after receiving a written request to do so from another member of the Board." ;
    skos:definition "(1) The Data Governance Board must hold such meetings as are necessary for the efficient performance of its functions.  (2) The Chair of the Data Governance Board:  (a) may convene a meeting at any time; and  (b) must convene a meeting within 30 days after receiving a written request to do so from another member of the Board."@en ;
    cml:integrityHash "155c9ee10b17e3de3d61c104cf92916776d187457380a83153e79227d4f8598b" ;
    cof:pageNumber "28"^^xsd:integer ;
    cml:hasPart concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-94-ss-1 ;
    cml:hasPart concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-94-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
