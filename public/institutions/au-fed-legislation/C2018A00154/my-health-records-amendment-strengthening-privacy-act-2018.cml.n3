concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-70b a cml:Concept ;
    skos:prefLabel "70B Use for prohibited purpose is unauthorised"@en ;
    cml:realizedBy doc:sch-1-sec-70b ;
    values:originalText "(1) Despite Subdivisions A and B, a person is not authorised under this Division to use health information included in a registered healthcare recipient’s My Health Record for a prohibited purpose.  (2) Subsection (1) does not apply if the person is the healthcare recipient, but does apply if the person is the nominated representative of the healthcare recipient (despite subsection 7(2))." ;
    skos:definition "(1) Despite Subdivisions A and B, a person is not authorised under this Division to use health information included in a registered healthcare recipient’s My Health Record for a prohibited purpose.  (2) Subsection (1) does not apply if the person is the healthcare recipient, but does apply if the person is the nominated representative of the healthcare recipient (despite subsection 7(2))."@en ;
    cml:integrityHash "ffc500f063a6deb778b1c233e4c8bbf029221c3904f9178225a5f01a99811314" ;
    cof:pageNumber "18"^^xsd:integer ;
    cml:hasPart concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-70b-ss-1 ;
    cml:hasPart concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-70b-ss-2 ;
    cml:curationStatus cml:Proposed ;
