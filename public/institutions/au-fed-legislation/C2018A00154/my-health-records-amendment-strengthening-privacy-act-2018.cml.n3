    skos:prefLabel "71AA Definitions"@en ;
    cml:realizedBy doc:sch-1-sec-71aa ;
    values:originalText "In this Division: My Health Record of a healthcare recipient includes a My Health Record of the healthcare recipient that has been cancelled or suspended. use information for a purpose includes request or require the information for that purpose." ;
