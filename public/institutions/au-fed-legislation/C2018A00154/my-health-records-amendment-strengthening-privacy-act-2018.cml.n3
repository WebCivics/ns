concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-95 a cml:Concept ;
    skos:prefLabel "95 Presiding at meetings"@en ;
    cml:realizedBy doc:sch-2-sec-95 ;
    values:originalText "(1) The Chair of the Data Governance Board must preside at all meetings at which the Chair is present.  (2) If the Chair is not present at a meeting at which the Deputy Chair is present, the Deputy Chair must preside.  (3) If neither the Chair nor the Deputy Chair is present at a meeting, the other members present must appoint one of themselves to preside." ;
    skos:definition "(1) The Chair of the Data Governance Board must preside at all meetings at which the Chair is present.  (2) If the Chair is not present at a meeting at which the Deputy Chair is present, the Deputy Chair must preside.  (3) If neither the Chair nor the Deputy Chair is present at a meeting, the other members present must appoint one of themselves to preside."@en ;
    cml:integrityHash "05af782b109acfd822971ce7c2e82b8e0a334c49ec2d8ceb47facd8e123f2fd9" ;
