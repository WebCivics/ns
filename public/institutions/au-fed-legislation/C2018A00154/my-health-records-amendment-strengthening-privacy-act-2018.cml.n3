doc:sch-2-sec-96d-ss-3 a cof:Section ;
    cof:title "96D(3) Decisions without meetings" ;
    values:kind "subsection" ;
    values:originalText "(3) For the purposes of paragraph (1)(a), a member is not entitled to vote on a proposed decision if the member would not have been entitled to vote on that proposal if the matter had been considered at a meeting of the Board." ;
    cof:pageNumber "29"^^xsd:integer .

concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-96d-ss-4 a cml:Concept ;
    skos:prefLabel "96D(4) Decisions without meetings"@en ;
    cml:realizedBy doc:sch-2-sec-96d-ss-4 ;
    values:originalText "(4) The Board must keep a record of decisions made in accordance with this section. Note: Section 33B of the Acts Interpretation Act 1901 contains further information about the ways in which members of the Board may participate in meetings." ;
    skos:definition "(4) The Board must keep a record of decisions made in accordance with this section. Note: Section 33B of the Acts Interpretation Act 1901 contains further information about the ways in which members of the Board may participate in meetings."@en ;
