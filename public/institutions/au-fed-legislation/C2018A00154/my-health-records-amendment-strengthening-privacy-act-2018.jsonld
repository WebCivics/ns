        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "my-health-records-amendment-strengthening-privacy-act-2018.pdf"
      },
      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.8",
      "values:originalText": "Insert:\n\n(1A) Despite subsection (1), a person who has parental responsibility for\na healthcare recipient aged under 18 is not the authorised\nrepresentative of the healthcare recipient if the System Operator is\nsatisfied that:\n\n(a) under a court order or a law of the Commonwealth or a State\nor Territory, the person must be supervised while spending\ntime with the healthcare recipient; or\n\n(b) the life, health or safety of the healthcare recipient or another\nperson would be put at risk if the person were the authorised\nrepresentative of the healthcare recipient.\n\nAmendments  Schedule 1\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018",
      "skos:definition": "Insert:\n\n(1A) Despite subsection (1), a person who has parental responsibility for\na healthcare recipient aged under 18 is not the authorised\nrepresentative of the healthcare recipient if the System Operator is\nsatisfied that:\n\n(a) under a court order or a law of the Commonwealth or a State\nor Territory, the person must be supervised while spending\ntime with the healthcare recipient; or\n\n(b) the life, health or safety of the healthcare recipient or another\nperson would be put at risk if the person were the authorised\nrepresentative of the healthcare recipient.\n\nAmendments  Schedule 1\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-1b-norm"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-1b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a457bdef59a0df169689507e11ffdedf1d69d0d15b8bf66bb00cede63a5176ba",
      "skos:note": "Supervision required for unaccompanied minors with parental responsibility"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-1b",
      "@type": "cof:Section",
      "cof:title": "1B After subsection 6(1)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Insert:\n\n(1A) Despite subsection (1), a person who has parental responsibility for\na healthcare recipient aged under 18 is not the authorised\nrepresentative of the healthcare recipient if the System Operator is\nsatisfied that:\n\n(a) under a court order or a law of the Commonwealth or a State\nor Territory, the person must be supervised while spending\ntime with the healthcare recipient; or\n\n(b) the life, health or safety of the healthcare recipient or another\nperson would be put at risk if the person were the authorised\nrepresentative of the healthcare recipient.\n\nAmendments  Schedule 1\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018"
    },
