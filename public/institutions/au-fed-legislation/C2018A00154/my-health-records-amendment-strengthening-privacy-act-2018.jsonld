      ],
      "cml:integrityHash": "a0c8254f05094d3dfe3ef596b20a0dd17c2543d1e766f29c0e339b43a732ac55",
      "skos:note": "Membership requirements for the Data Governance Board"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-84",
      "@type": "cof:Section",
      "cof:title": "84 Membership",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "The Data Governance Board consists of the following members:\n\n(a) the Chair of the Data Governance Board;\n\n(b) the Deputy Chair of the Data Governance Board;\n\n(c) at least 7, and no more than 10, other members."
    },
