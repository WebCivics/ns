    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-69b-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "69B(7) Judicial officers for orders under section 69A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-69b-ss-7"
