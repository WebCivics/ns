          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-69a-ss-6-logic-alleninterval-3"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-69a-ss-6-logic-deontic-4"
