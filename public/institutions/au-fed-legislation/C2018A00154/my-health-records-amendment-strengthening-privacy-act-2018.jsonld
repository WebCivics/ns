    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-88-ss-1",
      "@type": "cof:Section",
      "cof:title": "88(1) Term of appointment and other terms and conditions",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(1) A member of the Data Governance Board holds office for the\nperiod specified in the instrument of appointment. The period must\nnot exceed 5 years."
    },
