    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-88",
      "@type": "cml:Concept",
      "skos:prefLabel": "88 Term of appointment and other terms and conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-88"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "my-health-records-amendment-strengthening-privacy-act-2018.pdf"
      },
      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.26",
      "values:originalText": "(1) A member of the Data Governance Board holds office for the\nperiod specified in the instrument of appointment. The period must\nnot exceed 5 years.\n\n(2) A member of the Data Governance Board holds office on the terms\nand conditions (if any) in relation to matters not covered by this\nPart that are determined by the Minister.",
      "skos:definition": "(1) A member of the Data Governance Board holds office for the\nperiod specified in the instrument of appointment. The period must\nnot exceed 5 years.\n\n(2) A member of the Data Governance Board holds office on the terms\nand conditions (if any) in relation to matters not covered by this\nPart that are determined by the Minister.",
      "cml:hasPart": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-88-ss-1"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-88-ss-2"
        }
      ],
      "cml:integrityHash": "71b3ddc060aa35e59f95db45dc391db9af6ec86efdce19aed7e5b992a97ff547"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-88",
