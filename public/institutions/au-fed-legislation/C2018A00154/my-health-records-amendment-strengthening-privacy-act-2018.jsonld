    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsection 109(7A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "my-health-records-amendment-strengthening-privacy-act-2018.pdf"
      },
      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.32",
      "values:originalText": "Repeal the subsection, substitute:\n\nAmendments commencing on Proclamation  Schedule 2\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018\n\nMy Health Records Rules may relate to research or public health\npurposes\n\n(7A) The My Health Records Rules may, in accordance with\nsection 109A, prescribe a framework to guide the collection, use\nand disclosure of de-identified data and, with the consent of\nhealthcare recipients, health information, for research or public\nhealth purposes.",
      "skos:definition": "Repeal the subsection, substitute:\n\nAmendments commencing on Proclamation  Schedule 2\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018\n\nMy Health Records Rules may relate to research or public health\npurposes\n\n(7A) The My Health Records Rules may, in accordance with\nsection 109A, prescribe a framework to guide the collection, use\nand disclosure of de-identified data and, with the consent of\nhealthcare recipients, health information, for research or public\nhealth purposes.",
      "cml:asserts": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-12-norm"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-12-logic-deontic-1"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-12-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "4452e338d33ee523ddb3419dbf20d3d59ad5e605cf4a164c9dfec672fb9d5109",
      "skos:note": "May relate to research or public health purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Subsection 109(7A)",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "Repeal the subsection, substitute:\n\nAmendments commencing on Proclamation  Schedule 2\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018\n\nMy Health Records Rules may relate to research or public health\npurposes\n\n(7A) The My Health Records Rules may, in accordance with\nsection 109A, prescribe a framework to guide the collection, use\nand disclosure of de-identified data and, with the consent of\nhealthcare recipients, health information, for research or public\nhealth purposes."
    },
