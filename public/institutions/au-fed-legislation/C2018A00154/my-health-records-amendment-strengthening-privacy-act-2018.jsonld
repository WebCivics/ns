      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.22",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(ma) in accordance with the guidance and direction of the Board\nestablished under section 82, to prepare and provide\nde-identified data, and, with the consent of the healthcare\nrecipient, health information, for research or public health\npurposes;",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(ma) in accordance with the guidance and direction of the Board\nestablished under section 82, to prepare and provide\nde-identified data, and, with the consent of the healthcare\nrecipient, health information, for research or public health\npurposes;",
      "cml:asserts": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-2-norm"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "73843b0e0ac14417dcacb8f56e46e0ddc2245c6315da3f26a2a9f2a44c782025",
      "skos:note": "Healthcare recipient must provide de-identified data and health information with consent.",
      "dc:description": "True"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-2",
      "@type": "cof:Section",
