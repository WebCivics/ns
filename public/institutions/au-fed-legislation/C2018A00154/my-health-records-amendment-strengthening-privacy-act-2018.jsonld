    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-1d",
      "@type": "cml:Concept",
      "skos:prefLabel": "1D At the end of subsection 7(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-1d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
