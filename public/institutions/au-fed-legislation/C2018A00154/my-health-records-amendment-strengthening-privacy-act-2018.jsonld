      },
      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.29",
      "values:originalText": "The Data Governance Board may, subject to this Division, regulate\nproceedings at its meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 contains further\ninformation about the ways in which members of the Board may\nparticipate in meetings.",
      "skos:definition": "The Data Governance Board may, subject to this Division, regulate\nproceedings at its meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 contains further\ninformation about the ways in which members of the Board may\nparticipate in meetings.",
      "cml:asserts": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-96b-norm"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-96b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "084fa6c1967988865da1b1e02314d15724f54bddf99cc422243d2827d2f1aca6",
      "skos:note": "Regulate proceedings at meetings as considered appropriate."
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-96b",
      "@type": "cof:Section",
      "cof:title": "96B Conduct of meetings",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "The Data Governance Board may, subject to this Division, regulate\nproceedings at its meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 contains further\ninformation about the ways in which members of the Board may\nparticipate in meetings."
    },
