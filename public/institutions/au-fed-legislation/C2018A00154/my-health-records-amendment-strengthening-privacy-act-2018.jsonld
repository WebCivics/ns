    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-95",
      "@type": "cml:Concept",
      "skos:prefLabel": "95 Presiding at meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-95"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "my-health-records-amendment-strengthening-privacy-act-2018.pdf"
      },
      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.28",
      "values:originalText": "(1) The Chair of the Data Governance Board must preside at all\nmeetings at which the Chair is present.\n\n(2) If the Chair is not present at a meeting at which the Deputy Chair is\npresent, the Deputy Chair must preside.\n\n(3) If neither the Chair nor the Deputy Chair is present at a meeting,\nthe other members present must appoint one of themselves to\npreside.",
      "skos:definition": "(1) The Chair of the Data Governance Board must preside at all\nmeetings at which the Chair is present.\n\n(2) If the Chair is not present at a meeting at which the Deputy Chair is\npresent, the Deputy Chair must preside.\n\n(3) If neither the Chair nor the Deputy Chair is present at a meeting,\nthe other members present must appoint one of themselves to\npreside.",
      "cml:hasPart": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-95-ss-1"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-95-ss-2"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-95-ss-3"
        }
      ],
      "cml:integrityHash": "05af782b109acfd822971ce7c2e82b8e0a334c49ec2d8ceb47facd8e123f2fd9"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-95",
      "@type": "cof:Section",
      "cof:title": "95 Presiding at meetings",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "(1) The Chair of the Data Governance Board must preside at all\nmeetings at which the Chair is present.\n\n(2) If the Chair is not present at a meeting at which the Deputy Chair is\npresent, the Deputy Chair must preside.\n\n(3) If neither the Chair nor the Deputy Chair is present at a meeting,\nthe other members present must appoint one of themselves to\npreside."
    },
