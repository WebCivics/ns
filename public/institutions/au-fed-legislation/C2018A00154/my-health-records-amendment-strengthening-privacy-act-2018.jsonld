    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-94",
      "@type": "cml:Concept",
      "skos:prefLabel": "94 Convening meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-94"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
