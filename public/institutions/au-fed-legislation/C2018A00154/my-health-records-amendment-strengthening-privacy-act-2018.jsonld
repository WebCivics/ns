    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "my-health-records-amendment-strengthening-privacy-act-2018.pdf"
      },
      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nNote:\nThe provisions of the My Health Records (National Application)\nRules 2017 amended or inserted by this Act, and any other provisions\nof those rules, may be amended or repealed by rules made under\n\n\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018\n\nsection 109 of the My Health Records Act 2012 (see subsection 13(5)\nof the Legislation Act 2003).\n\nSchedule 1  Amendments\n\nMy Health Records Amendment (Strengthening Privacy) Act 2018\nNo. 154, 2018",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nNote:\nThe provisions of the My Health Records (National Application)\nRules 2017 amended or inserted by this Act, and any other provisions\nof those rules, may be amended or repealed by rules made under\n\n\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018\n\nsection 109 of the My Health Records Act 2012 (see subsection 13(5)\nof the Legislation Act 2003).\n\nSchedule 1  Amendments\n\nMy Health Records Amendment (Strengthening Privacy) Act 2018\nNo. 154, 2018",
      "cml:asserts": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "f8dd3bb2ac2c0b0b2649fc1e5bec012bbd1ec466c89abf1842bc068652b2ff49",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\nNote:\nThe provisions of the My Health Records (National Application)\nRules 2017 amended or inserted by this Act, and any other provisions\nof those rules, may be amended or repealed by rules made under\n\n\n\nNo. 154, 2018\nMy Health Records Amendment (Strengthening Privacy) Act 2018\n\nsection 109 of the My Health Records Act 2012 (see subsection 13(5)\nof the Legislation Act 2003).\n\nSchedule 1  Amendments\n\nMy Health Records Amendment (Strengthening Privacy) Act 2018\nNo. 154, 2018"
    },
