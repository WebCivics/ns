    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-71a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "71A(2) Offence for use of My Health Record-derived information for",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-71a-ss-2"
      },
      "cml:curationStatus": {
