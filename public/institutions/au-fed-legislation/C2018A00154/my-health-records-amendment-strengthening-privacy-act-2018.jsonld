        }
      ],
      "cml:integrityHash": "09a29d3374e76913c5dee5310c404af39246798c233315c58d4ffaf93aa2320e",
      "skos:note": "The Data Governance Board is prescribed in relation to the Department."
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-96j",
      "@type": "cof:Section",
      "cof:title": "96J Board is part of the Department",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "For the purposes of paragraph (a) of the definition of Department\nof State in section 8 of the Public Governance, Performance and\nAccountability Act 2013, the Data Governance Board is prescribed\nin relation to the Department."
    },
