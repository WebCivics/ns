    },
    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-69a-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Obligation to apply for order",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
