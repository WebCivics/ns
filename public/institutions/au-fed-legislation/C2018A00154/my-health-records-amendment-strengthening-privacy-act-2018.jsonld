      "@type": "cml:Concept",
      "skos:prefLabel": "93 Other paid work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-93"
