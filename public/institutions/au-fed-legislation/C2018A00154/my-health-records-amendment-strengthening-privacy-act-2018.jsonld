    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-2-sec-96b",
      "@type": "cml:Concept",
      "skos:prefLabel": "96B Conduct of meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-96b"
      },
