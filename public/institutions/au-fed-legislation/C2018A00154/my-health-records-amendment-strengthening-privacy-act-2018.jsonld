    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-16-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 After subsection 70(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-16-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "my-health-records-amendment-strengthening-privacy-act-2018.pdf"
      },
      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.16",
      "values:originalText": "Insert:\n\n(3A) The System Operator is authorised to disclose under subsection (3)\nonly the information the relevant person or authority mentioned in\nparagraph (3)(b) needs to identify the matter or concerns\nmentioned in that paragraph with sufficient certainty to:\n\n(a) initiate consideration of the matter or concerns; and\n\n(b) if necessary, apply for an order under section 69A in relation\nto the matter or concerns.",
      "skos:definition": "Insert:\n\n(3A) The System Operator is authorised to disclose under subsection (3)\nonly the information the relevant person or authority mentioned in\nparagraph (3)(b) needs to identify the matter or concerns\nmentioned in that paragraph with sufficient certainty to:\n\n(a) initiate consideration of the matter or concerns; and\n\n(b) if necessary, apply for an order under section 69A in relation\nto the matter or concerns.",
      "cml:asserts": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-16-2-norm"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-16-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c50bd42cd66cae60ecf3d5ed5b9271d912e44910e8f39798b624de23a748fbd2",
      "skos:note": "System Operator can disclose information to relevant person or authority."
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-16-2",
      "@type": "cof:Section",
      "cof:title": "16 After subsection 70(3)",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Insert:\n\n(3A) The System Operator is authorised to disclose under subsection (3)\nonly the information the relevant person or authority mentioned in\nparagraph (3)(b) needs to identify the matter or concerns\nmentioned in that paragraph with sufficient certainty to:\n\n(a) initiate consideration of the matter or concerns; and\n\n(b) if necessary, apply for an order under section 69A in relation\nto the matter or concerns."
    },
    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-16-2-norm",
      "@type": "values:Permission",
