        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-69a-ss-7-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "e5e6552ad48bedf5c44c2135548212addc62ef55496ecc809631dad8f16e0d9e",
      "skos:note": "A designated entity has powers or duties if it can require persons to give information under a law."
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-69a-ss-7",
      "@type": "cof:Section",
      "cof:title": "69A(7) Disclosure to designated entity under order by judicial officer",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(7) A designated entity has powers or duties of the kind mentioned in\nthis subsection if:\n\n(a) the designated entity has power under a law of the\nCommonwealth or a State or Territory (other than a law\ncovered by subsection 65(3)) to require persons to give\ninformation to the designated entity; or\n\n(b) officers of the designated entity are, in the ordinary course of\ntheir duties, authorised to execute warrants to enter premises\nand seize things found, including documents."
    },
