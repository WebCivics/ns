      "cml:integrityHash": "19b948e5be242527cc71e37d78b57f9ecb7e4ce8e46767e09b640410cfa040fa",
      "skos:note": "Cannot disclose health information to a designated entity"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-69a-ss-2",
      "@type": "cof:Section",
      "cof:title": "69A(2) Disclosure to designated entity under order by judicial officer",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(2) Except as mentioned in subsection (1) or in accordance with a law\ncovered by subsection 65(3), a participant in the My Health Record\nsystem, or a healthcare recipient, cannot be required to disclose\nhealth information included in a healthcare recipient’s My Health\nRecord to a designated entity."
    },
