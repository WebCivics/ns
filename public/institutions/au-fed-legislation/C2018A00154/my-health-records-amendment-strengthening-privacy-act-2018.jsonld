      "dc:source": "my-health-records-amendment-strengthening-privacy-act-2018.pdf, p.9",
      "values:originalText": "Add:\nNote:\nDespite this subsection, a nominated representative must not use\ninformation for a prohibited purpose within the meaning of\nsection 70A (even though a healthcare recipient may do so): see\nsubsections 59A(2), 70B(2), 71A(4) and 71B(3).",
      "skos:definition": "Add:\nNote:\nDespite this subsection, a nominated representative must not use\ninformation for a prohibited purpose within the meaning of\nsection 70A (even though a healthcare recipient may do so): see\nsubsections 59A(2), 70B(2), 71A(4) and 71B(3).",
      "cml:asserts": [
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-1d-norm"
        },
        {
          "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-1d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d6e0b3bbd005d5011073bea5d159eac3933be3689ee28dbca5ba0c44a868a658",
      "skos:note": "Must not use information for a prohibited purpose"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-1d",
      "@type": "cof:Section",
      "cof:title": "1D At the end of subsection 7(2)",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "Add:\nNote:\nDespite this subsection, a nominated representative must not use\ninformation for a prohibited purpose within the meaning of\nsection 70A (even though a healthcare recipient may do so): see\nsubsections 59A(2), 70B(2), 71A(4) and 71B(3)."
    },
