    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 At the end of section 65",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-10"
      },
      "cml:curationStatus": {
