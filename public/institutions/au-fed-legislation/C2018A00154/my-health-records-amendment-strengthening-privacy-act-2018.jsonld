        }
      ],
      "cml:integrityHash": "24b7caa706ab8702d99d961fdb435970d0f8b5fcbc5b27bce78e5da11c724f8c"
    },
    {
      "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-2-sec-96a",
      "@type": "cof:Section",
