    {
      "@id": "concept:my-health-records-amendment-strengthening-privacy-act-2018-sch-1-sec-1da",
      "@type": "cml:Concept",
      "skos:prefLabel": "1DA Subsection 6(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/my-health-records-amendment-strengthening-privacy-act-2018#sch-1-sec-1da"
      },
