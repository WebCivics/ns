    {
      "@id": "concept:crimes-currency-act-1981-sec-23-2-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Defines Australian aircraft and ship for liability to prosecution purposes.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligate"
    },
    {
      "@id": "concept:crimes-currency-act-1981-sec-23-2-ss-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "or Australian aircraft means an aircraft that is owned by, or is in the possession or control of, the Commonwealth or an authority of the Commonwealth;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies entities by registration or possession",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Australian aircraft means an aircraft registered or required to be registered under regulations made under the Civil Aviation Act 1988;"
    },
    {
      "@id": "concept:crimes-currency-act-1981-sec-23-2-ss-2-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "or Australian ship means a ship registered in Australia or an external Territory under an Act or Imperial Act relating to the registration of ships that is applicable throughout the whole of Australia and the external Territories;",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies entities by registration or possession",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Australian ship means a ship registered in Australia or an external Territory under an Act or Imperial Act relating to the registration of ships that is applicable throughout the whole of Australia and the external Territories, not being an Act or Imperial Act relating to the registration of ships;"
    },
