    },
    {
      "@id": "concept:crimes-currency-act-1981-sec-1-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The method or methods of transmission mentioned above which it will recognise for the letters of request of the latter High Contracting Party.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal interval for notification is required.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:premiseText": "Until such notification is made by a High Contracting Party, its existing procedure in regard to letters of request shall remain in force."
    },
    {
      "@id": "concept:crimes-currency-act-1981-sec-1-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The method or methods of transmission mentioned above which it will recognise for the letters of request of the latter High Contracting Party.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Requesting countries must notify each other.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "Each High Contracting Party shall notify to each of the other High Contracting Parties..."
    },
    {
      "@id": "concept:crimes-currency-act-1981-sec-1-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The method or methods of transmission mentioned above which it will recognise for the letters of request of the latter High Contracting Party.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
