    {
      "@id": "concept:crimes-currency-act-1981-sec-1-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-currency-act-1981.pdf, p.33",
      "skos:note": "Requesting countries must notify each other of their methods for transmitting letters of request.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "1 This expression has the same meaning as “letters rogatory”."
      },
      "wasDerivedFrom": "crimes-currency-act-1981.pdf",
      "asserts": [
        "concept:crimes-currency-act-1981-sec-1-2-norm",
        "concept:crimes-currency-act-1981-sec-1-2-logic-deontic-1",
        "concept:crimes-currency-act-1981-sec-1-2-logic-alleninterval-2",
        "concept:crimes-currency-act-1981-sec-1-2-logic-ltl-3",
        "concept:crimes-currency-act-1981-sec-1-2-logic-deontic-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "176e63513c23c4b1d285e472f6fdb672fe1de33a1647edb202119ae9e0d333d0",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
