concept:crimes-currency-act-1981-sec-14-ss-2 cml:asserts concept:crimes-currency-act-1981-sec-14-ss-2-logic-deontic-1 .
concept:crimes-currency-act-1981-sec-14-ss-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "=" ;
    cml:logicSummary "Definition of current coin or paper money" ;
    cml:premiseText "(2) For the purposes of this Act, a coin or paper money shall be taken to be a current coin, or current paper money if it is lawfully current in Australia or in a country other than Australia by virtue of a law in force in Australia or in that country, as the case may be." ;
    cml:conclusionText "a coin or paper money shall be taken to be a current coin, or current paper money" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

