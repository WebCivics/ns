concept:crimes-currency-act-1981-article-20 a cml:Concept ;
    skos:prefLabel "20 The present Convention, of which the French and English texts are both"@en ;
    cml:realizedBy doc:article-20 ;
    values:originalText "authentic, shall bear to-day’s date. Until the 31st day of December 1929, it shall be open for signature on behalf of any Member of the League of Nations and on behalf of any non-member State which was represented at the Conference which elaborated the present Convention or to which a copy is communicated by the Council of the League of Nations. It shall be ratified, and the instruments of ratification shall be transmitted to the Secretary-General of the League of Nations, who will notify their receipt to all the Members of the League and to the non-member States aforesaid." ;
    skos:definition "authentic, shall bear to-day’s date. Until the 31st day of December 1929, it shall be open for signature on behalf of any Member of the League of Nations and on behalf of any non-member State which was represented at the Conference which elaborated the present Convention or to which a copy is communicated by the Council of the League of Nations. It shall be ratified, and the instruments of ratification shall be transmitted to the Secretary-General of the League of Nations, who will notify their receipt to all the Members of the League and to the non-member States aforesaid."@en ;
    cml:integrityHash "30b2fa332d92ff31f75821fc86b4f27ccae440a8f5c10e8b2c2c83251f588657" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Convention open for signature until December 31, 1929" ;
