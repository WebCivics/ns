concept:crimes-currency-act-1981-article-7 a cml:Concept ;
    skos:prefLabel "7 In so far as “civil parties” are admitted under the domestic law, foreign"@en ;
    cml:realizedBy doc:article-7 ;
    values:originalText "“civil parties”, including, if necessary, the High Contracting Party whose money has been counterfeited, should be entitled to all rights allowed to inhabitants by the laws of the country in which the case is tried." ;
    skos:definition "“civil parties”, including, if necessary, the High Contracting Party whose money has been counterfeited, should be entitled to all rights allowed to inhabitants by the laws of the country in which the case is tried."@en ;
    cml:integrityHash "1edab529e41d00b6dfc4bee0d44ea2bcd210af1d537243e07ed72139fe221618" ;
    cof:pageNumber "30"^^xsd:integer ;
