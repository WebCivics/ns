concept:crimes-currency-act-1981-article-3 a cml:Concept ;
    skos:prefLabel "3 The following should be punishable as ordinary crimes:"@en ;
    cml:realizedBy doc:article-3 ;
    values:originalText "(1) Any fraudulent making or altering of currency, whatever means are employed; (2) The fraudulent uttering of counterfeit currency;  Schedule  International Convention for the Suppression of Counterfeiting Currency  Crimes (Currency) Act 1981  Compilation date: 11/5/18 Registered: 23/5/18  (3) The introduction into a country of or the receiving or obtaining counterfeit currency with a view to uttering the same and with knowledge that it is counterfeit; (4) Attempts to commit, and any intentional participation in, the foregoing acts; (5) The fraudulent making, receiving or obtaining of instruments or other articles peculiarly adapted for the counterfeiting or altering of currency." ;
    skos:definition "(1) Any fraudulent making or altering of currency, whatever means are employed; (2) The fraudulent uttering of counterfeit currency;  Schedule  International Convention for the Suppression of Counterfeiting Currency  Crimes (Currency) Act 1981  Compilation date: 11/5/18 Registered: 23/5/18  (3) The introduction into a country of or the receiving or obtaining counterfeit currency with a view to uttering the same and with knowledge that it is counterfeit; (4) Attempts to commit, and any intentional participation in, the foregoing acts; (5) The fraudulent making, receiving or obtaining of instruments or other articles peculiarly adapted for the counterfeiting or altering of currency."@en ;
    cml:integrityHash "3eef569782462536323593b29df94aeba9f5948ec1bd927b232e0e64d53421dd" ;
    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Counterfeiting and related activities are prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-currency-act-1981.pdf> ;
