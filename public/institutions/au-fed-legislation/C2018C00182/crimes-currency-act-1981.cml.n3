concept:crimes-currency-act-1981-article-15 a cml:Concept ;
    skos:prefLabel "15 In order to ensure, improve and develop direct international co-operation in"@en ;
    cml:realizedBy doc:article-15 ;
    values:originalText "the prevention and punishment of counterfeiting currency, the representatives of the central offices of the High Contracting Parties should from time to time hold conferences with the participation of representatives of the banks of issue and of the central authorities concerned. The organisation and supervision of a central international information office may form the subject of one of these conferences." ;
    skos:definition "the prevention and punishment of counterfeiting currency, the representatives of the central offices of the High Contracting Parties should from time to time hold conferences with the participation of representatives of the banks of issue and of the central authorities concerned. The organisation and supervision of a central international information office may form the subject of one of these conferences."@en ;
    cml:integrityHash "08a884d1c2c80d8bfb5e23982562de02c786104eec310635d1bcc3a8b09265a2" ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Representatives of central offices and banks must hold conferences to improve international cooperation in preventing counterfeiting currency." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
