concept:crimes-currency-act-1981-article-6 a cml:Concept ;
    skos:prefLabel "6 In countries where the principle of the international recognition of previous"@en ;
    cml:realizedBy doc:article-6 ;
    values:originalText "convictions is recognised, foreign convictions for the offences referred to in Article 3 should, within the conditions prescribed by domestic law, be recognised for the purpose of establishing habitual criminality." ;
