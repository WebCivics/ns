concept:crimes-currency-act-1981-article-5 a cml:Concept ;
    skos:prefLabel "5 No distinction should be made in the scale of punishments for offences"@en ;
    cml:realizedBy doc:article-5 ;
    values:originalText "referred to in Article 3 between acts relating to domestic currency on the one hand and to foreign currency on the other; this provision may not be made subject to any condition of reciprocal treatment by law or by treaty." ;
    skos:definition "referred to in Article 3 between acts relating to domestic currency on the one hand and to foreign currency on the other; this provision may not be made subject to any condition of reciprocal treatment by law or by treaty."@en ;
