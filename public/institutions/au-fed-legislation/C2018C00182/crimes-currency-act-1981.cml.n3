concept:crimes-currency-act-1981-article-2 a cml:Concept ;
    skos:prefLabel "2 In the present Convention, the word “currency” is understood to mean"@en ;
    cml:realizedBy doc:article-2 ;
    values:originalText "paper money (including banknotes) and metallic money, the circulation of which is legally authorised." ;
    skos:definition "paper money (including banknotes) and metallic money, the circulation of which is legally authorised."@en ;
