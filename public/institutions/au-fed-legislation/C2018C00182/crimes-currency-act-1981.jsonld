    {
      "@id": "concept:crimes-currency-act-1981-article-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 The present Convention does not affect the principle that the offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
