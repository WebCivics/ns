      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.37",
      "values:originalText": "(4) That High Contracting Parties are required to execute letters of request\nonly within the limits provided for by their domestic law.\n\nII. RESERVATIONS\nThe High Contracting Parties who make the reservations set forth\nhereunder make their acceptance of the Convention conditional on the said\nreservations; their participation, subject to the said reservations, is accepted by\nthe other High Contracting Parties.",
      "skos:definition": "(4) That High Contracting Parties are required to execute letters of request\nonly within the limits provided for by their domestic law.\n\nII. RESERVATIONS\nThe High Contracting Parties who make the reservations set forth\nhereunder make their acceptance of the Convention conditional on the said\nreservations; their participation, subject to the said reservations, is accepted by\nthe other High Contracting Parties.",
      "values:partOf": {
        "@id": "concept:crimes-currency-act-1981-article-28"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-28-ss-4-norm"
        },
