    {
      "@id": "concept:crimes-currency-act-1981-article-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 No distinction should be made in the scale of punishments for offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-5"
      },
      "cml:curationStatus": {
