    {
      "@id": "concept:crimes-currency-act-1981-article-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 In countries where the principle of the international recognition of previous",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.30",
      "values:originalText": "convictions is recognised, foreign convictions for the offences referred to in\nArticle 3 should, within the conditions prescribed by domestic law, be\nrecognised for the purpose of establishing habitual criminality.",
      "skos:definition": "convictions is recognised, foreign convictions for the offences referred to in\nArticle 3 should, within the conditions prescribed by domestic law, be\nrecognised for the purpose of establishing habitual criminality.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-6-norm"
        }
      ],
      "cml:integrityHash": "8add069dc5a9999f98fcc853bdb76a52d7b3704168ce8bac5ae377954df7db63",
      "skos:note": "Recognize foreign convictions for habitual criminality under domestic law conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-6",
      "@type": "cof:Section",
      "cof:title": "6 In countries where the principle of the international recognition of previous",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "convictions is recognised, foreign convictions for the offences referred to in\nArticle 3 should, within the conditions prescribed by domestic law, be\nrecognised for the purpose of establishing habitual criminality."
    },
