      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.29",
      "values:originalText": "paper money (including banknotes) and metallic money, the circulation of\nwhich is legally authorised.",
      "skos:definition": "paper money (including banknotes) and metallic money, the circulation of\nwhich is legally authorised.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-2-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-2-logic-deontic-1"
        }
      ],
