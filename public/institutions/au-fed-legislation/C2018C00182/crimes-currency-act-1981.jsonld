        }
      ],
      "cml:integrityHash": "b4f6fc89472f079aaa61c8d994bda051399ebf72e546033d5a14a974b152a5c3",
      "skos:note": "States must define, prosecute and punish offenses in conformity with their domestic law."
    },
    {
