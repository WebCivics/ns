      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.35",
      "values:originalText": "accession on behalf of any Member of the League of Nations and any of the\nnon-member States referred to in Article 20 on whose behalf it has not been\nsigned.\nThe instruments of accession shall be transmitted to the Secretary-General\nof the League of Nations, who will notify their receipt to all the Members of the\nLeague and to the non-member States referred to in Article 20.",
      "skos:definition": "accession on behalf of any Member of the League of Nations and any of the\nnon-member States referred to in Article 20 on whose behalf it has not been\nsigned.\nThe instruments of accession shall be transmitted to the Secretary-General\nof the League of Nations, who will notify their receipt to all the Members of the\nLeague and to the non-member States referred to in Article 20.",
      "cml:asserts": [
