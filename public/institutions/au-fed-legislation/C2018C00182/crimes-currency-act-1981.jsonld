    {
      "@id": "concept:crimes-currency-act-1981-article-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 In the present Convention, the word “currency” is understood to mean",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-2"
      },
      "cml:curationStatus": {
