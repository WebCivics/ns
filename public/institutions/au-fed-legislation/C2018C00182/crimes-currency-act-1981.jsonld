      "cml:conclusionText": "None"
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 The present Convention shall not come into force until five ratifications or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.36",
      "values:originalText": "accessions on behalf of Members of the League of Nations or non-member\nStates have been deposited. The date of its coming into force shall be the\nninetieth day after the receipt by the Secretary-General of the League of Nations\nof the fifth ratification or accession.",
      "skos:definition": "accessions on behalf of Members of the League of Nations or non-member\nStates have been deposited. The date of its coming into force shall be the\nninetieth day after the receipt by the Secretary-General of the League of Nations\nof the fifth ratification or accession.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-25-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-25-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3a2310ebbd5ff5ff025e1695114990fdb12ce49a6abd86dbb830bc0fe1ad492e",
      "skos:note": "Ratifications or accessions are required for the Convention to come into force."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-25",
      "@type": "cof:Section",
      "cof:title": "25 The present Convention shall not come into force until five ratifications or",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "accessions on behalf of Members of the League of Nations or non-member\nStates have been deposited. The date of its coming into force shall be the\nninetieth day after the receipt by the Secretary-General of the League of Nations\nof the fifth ratification or accession."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-25-norm",
      "@type": "values:Obligation",
      "cml:modality": {
