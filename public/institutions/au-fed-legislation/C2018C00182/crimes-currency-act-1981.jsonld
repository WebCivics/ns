    {
      "@id": "concept:crimes-currency-act-1981-article-14-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to forward information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Central offices are required to forward details of discoveries.",
      "cml:conclusionText": "The central office must provide the relevant authorities with details of discoveries."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 In order to ensure, improve and develop direct international co-operation in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.33",
      "values:originalText": "the prevention and punishment of counterfeiting currency, the representatives of\nthe central offices of the High Contracting Parties should from time to time hold\nconferences with the participation of representatives of the banks of issue and of\nthe central authorities concerned. The organisation and supervision of a central\ninternational information office may form the subject of one of these\nconferences.",
      "skos:definition": "the prevention and punishment of counterfeiting currency, the representatives of\nthe central offices of the High Contracting Parties should from time to time hold\nconferences with the participation of representatives of the banks of issue and of\nthe central authorities concerned. The organisation and supervision of a central\ninternational information office may form the subject of one of these\nconferences.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-15-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "08a884d1c2c80d8bfb5e23982562de02c786104eec310635d1bcc3a8b09265a2",
      "skos:note": "Representatives of central offices and banks must hold conferences to improve international cooperation in preventing counterfeiting currency."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-15",
      "@type": "cof:Section",
      "cof:title": "15 In order to ensure, improve and develop direct international co-operation in",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "the prevention and punishment of counterfeiting currency, the representatives of\nthe central offices of the High Contracting Parties should from time to time hold\nconferences with the participation of representatives of the banks of issue and of\nthe central authorities concerned. The organisation and supervision of a central\ninternational information office may form the subject of one of these\nconferences."
    },
    {
