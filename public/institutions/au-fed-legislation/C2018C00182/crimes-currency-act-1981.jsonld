        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits extradition of nationals not recognized in their own country",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Foreigners who have committed abroad any offence referred to in Article",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.31",
      "values:originalText": "3, and who are in the territory of a country whose internal legislation recognises\nas a general rule the principle of the prosecution of offences committed abroad,\nshould be punishable in the same way as if the offence had been committed in\nthe territory of that country.\nThe obligation to take proceedings is subject to the condition that\nextradition has been requested and that the country to which application is made\ncannot hand over the person accused for some reason which has no connection\nwith the offence.",
      "skos:definition": "3, and who are in the territory of a country whose internal legislation recognises\nas a general rule the principle of the prosecution of offences committed abroad,\nshould be punishable in the same way as if the offence had been committed in\nthe territory of that country.\nThe obligation to take proceedings is subject to the condition that\nextradition has been requested and that the country to which application is made\ncannot hand over the person accused for some reason which has no connection\nwith the offence.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-9-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a8394869b6e43a6e0063d1f8b8f9d01a5a8c956eb0376191dd0b094ee04ecfa5",
      "skos:note": "Foreigners committing crimes abroad should be punished in the same way as if committed in their home country."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-9",
      "@type": "cof:Section",
      "cof:title": "9 Foreigners who have committed abroad any offence referred to in Article",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "3, and who are in the territory of a country whose internal legislation recognises\nas a general rule the principle of the prosecution of offences committed abroad,\nshould be punishable in the same way as if the offence had been committed in\nthe territory of that country.\nThe obligation to take proceedings is subject to the condition that\nextradition has been requested and that the country to which application is made\ncannot hand over the person accused for some reason which has no connection\nwith the offence."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-9-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-currency-act-1981-article-9"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-9-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to punish foreigners for crimes committed abroad.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Article 9 states that...",
      "cml:conclusionText": "...should be punishable in the same way as if..."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 The offences referred to in Article 3 shall be deemed to be included as",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.31",
      "values:originalText": "extradition crimes in any extradition treaty which has been or may hereafter be\nconcluded between any of the High Contracting Parties.\nThe High Contracting Parties who do not make extradition conditional on\nthe existence of a treaty or reciprocity, henceforward recognise the offences\nreferred to in Article 3 as cases of extradition as between themselves.\nExtradition shall be granted in conformity with the law of the country to\nwhich application is made.",
      "skos:definition": "extradition crimes in any extradition treaty which has been or may hereafter be\nconcluded between any of the High Contracting Parties.\nThe High Contracting Parties who do not make extradition conditional on\nthe existence of a treaty or reciprocity, henceforward recognise the offences\nreferred to in Article 3 as cases of extradition as between themselves.\nExtradition shall be granted in conformity with the law of the country to\nwhich application is made.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-10-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "41c67be2355986a171d5f0c32f21520f7497af92f4a49172505026f00893ce49",
      "skos:note": "Extradition shall be granted in conformity with the law of the country to which application is made."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-10",
      "@type": "cof:Section",
      "cof:title": "10 The offences referred to in Article 3 shall be deemed to be included as",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "extradition crimes in any extradition treaty which has been or may hereafter be\nconcluded between any of the High Contracting Parties.\nThe High Contracting Parties who do not make extradition conditional on\nthe existence of a treaty or reciprocity, henceforward recognise the offences\nreferred to in Article 3 as cases of extradition as between themselves.\nExtradition shall be granted in conformity with the law of the country to\nwhich application is made."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-10-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-currency-act-1981-article-10"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-10-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "shall",
      "cml:logicSummary": "Implies an obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Counterfeit currency, as well as instruments or other articles referred to in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.31",
      "values:originalText": "Article 3(5), should be seized and confiscated. Such currency, instruments or\nother articles should, after confiscation, be handed over on request either to the\nGovernment or bank of issue whose currency is in question, with the exception\nof exhibits whose preservation as a matter of record is required by the law of the\ncountry where the prosecution took place, and any specimens whose\ntransmission to the Central Office mentioned in Article 12 may be deemed\nadvisable. In any event, all such articles should be rendered incapable of use.\n\n\nSchedule  International Convention for the Suppression of Counterfeiting Currency\n\nCrimes (Currency) Act 1981\n\nCompilation date: 11/5/18\nRegistered: 23/5/18",
      "skos:definition": "Article 3(5), should be seized and confiscated. Such currency, instruments or\nother articles should, after confiscation, be handed over on request either to the\nGovernment or bank of issue whose currency is in question, with the exception\nof exhibits whose preservation as a matter of record is required by the law of the\ncountry where the prosecution took place, and any specimens whose\ntransmission to the Central Office mentioned in Article 12 may be deemed\nadvisable. In any event, all such articles should be rendered incapable of use.\n\n\nSchedule  International Convention for the Suppression of Counterfeiting Currency\n\nCrimes (Currency) Act 1981\n\nCompilation date: 11/5/18\nRegistered: 23/5/18",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-11-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c25cc9d9648e039b76c64a44b28e092e92ea23d66687ff5956ee942e7a54825d",
      "skos:note": "Counterfeit currency and instruments should be seized and confiscated."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-11",
      "@type": "cof:Section",
      "cof:title": "11 Counterfeit currency, as well as instruments or other articles referred to in",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Article 3(5), should be seized and confiscated. Such currency, instruments or\nother articles should, after confiscation, be handed over on request either to the\nGovernment or bank of issue whose currency is in question, with the exception\nof exhibits whose preservation as a matter of record is required by the law of the\ncountry where the prosecution took place, and any specimens whose\ntransmission to the Central Office mentioned in Article 12 may be deemed\nadvisable. In any event, all such articles should be rendered incapable of use.\n\n\nSchedule  International Convention for the Suppression of Counterfeiting Currency\n\nCrimes (Currency) Act 1981\n\nCompilation date: 11/5/18\nRegistered: 23/5/18"
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-11-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-currency-act-1981-article-11"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-11-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the use of counterfeit currency and instruments.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 In every country, within the framework of its domestic law, investigations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.32",
      "values:originalText": "on the subject of counterfeiting should be organised by a central office.\nThis central office should be in close contact:\n(a) With the institutions issuing currency;\n(b) With the police authorities within the country;\n(c) With the central offices of other countries.\nIt should centralise, in each country, all information of a nature to facilitate\nthe investigation, prevention and punishment of counterfeiting currency.",
      "skos:definition": "on the subject of counterfeiting should be organised by a central office.\nThis central office should be in close contact:\n(a) With the institutions issuing currency;\n(b) With the police authorities within the country;\n(c) With the central offices of other countries.\nIt should centralise, in each country, all information of a nature to facilitate\nthe investigation, prevention and punishment of counterfeiting currency.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-12-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-12-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-12-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-12-logic-ltl-3"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-12-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-12-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "e5d1152c188345b72c721fd8d5d4a5b0ad48d6b7a03d84c95462342c5102985c",
      "skos:note": "Organise investigations on counterfeiting within a central office."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-12",
      "@type": "cof:Section",
      "cof:title": "12 In every country, within the framework of its domestic law, investigations",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "on the subject of counterfeiting should be organised by a central office.\nThis central office should be in close contact:\n(a) With the institutions issuing currency;\n(b) With the police authorities within the country;\n(c) With the central offices of other countries.\nIt should centralise, in each country, all information of a nature to facilitate\nthe investigation, prevention and punishment of counterfeiting currency."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-12-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-currency-act-1981-article-12"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-12-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must organise investigations on counterfeiting",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Investigations on counterfeiting should be organised by a central office.",
      "cml:conclusionText": "Organise investigations on counterfeiting within a central office."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-12-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Contain information facilitating investigation, prevention and punishment of counterfeiting currency",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The central office should centralise all information of a nature to facilitate the investigation, prevention and punishment of counterfeiting currency.",
      "cml:conclusionText": "Contain information facilitating investigation, prevention and punishment of counterfeiting currency within each country."
    },
