    {
      "@id": "concept:crimes-currency-act-1981-article-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 The present Convention may be denounced on behalf of any Member of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.36",
      "values:originalText": "the League of Nations or non-member State by a notification in writing\naddressed to the Secretary-General of the League of Nations, who will inform\nall the Members of the League and the non-member States referred to in Article\n20. Such denunciation shall take effect one year after the date of its receipt by\nthe Secretary-General of the League of Nations, and shall operate only in\nrespect of the High Contracting Party on whose behalf it was notified.\n\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18",
      "skos:definition": "the League of Nations or non-member State by a notification in writing\naddressed to the Secretary-General of the League of Nations, who will inform\nall the Members of the League and the non-member States referred to in Article\n20. Such denunciation shall take effect one year after the date of its receipt by\nthe Secretary-General of the League of Nations, and shall operate only in\nrespect of the High Contracting Party on whose behalf it was notified.\n\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-27-norm"
