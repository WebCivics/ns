    },
    {
      "@id": "concept:crimes-currency-act-1981-article-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 After the coming into force of the Convention in accordance with Article",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.36",
      "values:originalText": "25, each subsequent ratification or accession shall take effect on the ninetieth\nday from the date of its receipt by the Secretary-General of the League of\nNations.",
      "skos:definition": "25, each subsequent ratification or accession shall take effect on the ninetieth\nday from the date of its receipt by the Secretary-General of the League of\nNations.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-26-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-26-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "85ff7fb3247753f6e81eac56a056b59eeb4e5a2c9a0de2266a999738adda97b9",
      "skos:note": "Each subsequent ratification or accession takes effect on the ninetieth day from the date of its receipt by the Secretary-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-26",
      "@type": "cof:Section",
