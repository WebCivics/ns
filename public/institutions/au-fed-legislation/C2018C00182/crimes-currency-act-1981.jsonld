      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.30",
      "values:originalText": "referred to in Article 3 between acts relating to domestic currency on the one\nhand and to foreign currency on the other; this provision may not be made\nsubject to any condition of reciprocal treatment by law or by treaty.",
      "skos:definition": "referred to in Article 3 between acts relating to domestic currency on the one\nhand and to foreign currency on the other; this provision may not be made\nsubject to any condition of reciprocal treatment by law or by treaty.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-5-norm"
        }
      ],
      "cml:integrityHash": "9db89f5db253b5c7e0ba0d6b144b19452cc11176ef1045df0698c6a5c59b5178",
      "skos:note": "No distinction should be made in the scale of punishments for offences"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-5",
      "@type": "cof:Section",
      "cof:title": "5 No distinction should be made in the scale of punishments for offences",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "referred to in Article 3 between acts relating to domestic currency on the one\nhand and to foreign currency on the other; this provision may not be made\nsubject to any condition of reciprocal treatment by law or by treaty."
    },
