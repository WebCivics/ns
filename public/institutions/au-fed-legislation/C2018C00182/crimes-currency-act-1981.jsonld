      ],
      "cml:integrityHash": "ea6bccefbefaadf53f12a9e9ed39b6f861eaa8fef9650c1c1a76462a646f7e60",
      "skos:note": "Denunciation of the Convention requires a notification to the Secretary-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-27",
      "@type": "cof:Section",
      "cof:title": "27 The present Convention may be denounced on behalf of any Member of",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "the League of Nations or non-member State by a notification in writing\naddressed to the Secretary-General of the League of Nations, who will inform\nall the Members of the League and the non-member States referred to in Article\n20. Such denunciation shall take effect one year after the date of its receipt by\nthe Secretary-General of the League of Nations, and shall operate only in\nrespect of the High Contracting Party on whose behalf it was notified.\n\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18"
    },
