    {
      "@id": "concept:crimes-currency-act-1981-article-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 The present Convention, of which the French and English texts are both",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.35",
      "values:originalText": "authentic, shall bear to-day’s date. Until the 31st day of December 1929, it shall\nbe open for signature on behalf of any Member of the League of Nations and on\nbehalf of any non-member State which was represented at the Conference\nwhich elaborated the present Convention or to which a copy is communicated\nby the Council of the League of Nations.\nIt shall be ratified, and the instruments of ratification shall be transmitted to\nthe Secretary-General of the League of Nations, who will notify their receipt to\nall the Members of the League and to the non-member States aforesaid.",
      "skos:definition": "authentic, shall bear to-day’s date. Until the 31st day of December 1929, it shall\nbe open for signature on behalf of any Member of the League of Nations and on\nbehalf of any non-member State which was represented at the Conference\nwhich elaborated the present Convention or to which a copy is communicated\nby the Council of the League of Nations.\nIt shall be ratified, and the instruments of ratification shall be transmitted to\nthe Secretary-General of the League of Nations, who will notify their receipt to\nall the Members of the League and to the non-member States aforesaid.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-20-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "30b2fa332d92ff31f75821fc86b4f27ccae440a8f5c10e8b2c2c83251f588657",
      "skos:note": "Convention open for signature until December 31, 1929"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-20",
      "@type": "cof:Section",
      "cof:title": "20 The present Convention, of which the French and English texts are both",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "authentic, shall bear to-day’s date. Until the 31st day of December 1929, it shall\nbe open for signature on behalf of any Member of the League of Nations and on\nbehalf of any non-member State which was represented at the Conference\nwhich elaborated the present Convention or to which a copy is communicated\nby the Council of the League of Nations.\nIt shall be ratified, and the instruments of ratification shall be transmitted to\nthe Secretary-General of the League of Nations, who will notify their receipt to\nall the Members of the League and to the non-member States aforesaid."
    },
    {
