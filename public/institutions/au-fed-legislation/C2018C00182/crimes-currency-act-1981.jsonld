    {
      "@id": "concept:crimes-currency-act-1981-article-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 In so far as “civil parties” are admitted under the domestic law, foreign",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.30",
      "values:originalText": "“civil parties”, including, if necessary, the High Contracting Party whose money\nhas been counterfeited, should be entitled to all rights allowed to inhabitants by\nthe laws of the country in which the case is tried.",
      "skos:definition": "“civil parties”, including, if necessary, the High Contracting Party whose money\nhas been counterfeited, should be entitled to all rights allowed to inhabitants by\nthe laws of the country in which the case is tried.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-7-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1edab529e41d00b6dfc4bee0d44ea2bcd210af1d537243e07ed72139fe221618",
      "skos:note": "Entitlement to rights allowed by local laws for foreign civil parties"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-7",
      "@type": "cof:Section",
      "cof:title": "7 In so far as “civil parties” are admitted under the domestic law, foreign",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "“civil parties”, including, if necessary, the High Contracting Party whose money\nhas been counterfeited, should be entitled to all rights allowed to inhabitants by\nthe laws of the country in which the case is tried."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-7-norm",
      "@type": "values:Right",
      "cml:modality": {
        "@id": "cml:Deontic"
