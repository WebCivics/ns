    {
      "@id": "concept:crimes-currency-act-1981-article-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 The High Contracting Parties agree that any disputes which might arise",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.34",
      "values:originalText": "between them relating to the interpretation or application of this Convention\nshall, if they cannot be settled by direct negotiation, be referred for decision to\nthe Permanent Court of International Justice. In case any or all of the High\nContracting Parties parties to such a dispute should not be Parties to the\nProtocol bearing the date of December 16th, 1920, relating to the Permanent\nCourt of International Justice, the dispute shall be referred, at the choice of the\nparties and in accordance with the constitutional procedure of each party, either\nto the Permanent Court of International Justice or to a court of arbitration\nconstituted in accordance with the Convention of October 18th, 1907, for the\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18\n\nPacific Settlement of International Disputes, or to some other court of\narbitration.",
      "skos:definition": "between them relating to the interpretation or application of this Convention\nshall, if they cannot be settled by direct negotiation, be referred for decision to\nthe Permanent Court of International Justice. In case any or all of the High\nContracting Parties parties to such a dispute should not be Parties to the\nProtocol bearing the date of December 16th, 1920, relating to the Permanent\nCourt of International Justice, the dispute shall be referred, at the choice of the\nparties and in accordance with the constitutional procedure of each party, either\nto the Permanent Court of International Justice or to a court of arbitration\nconstituted in accordance with the Convention of October 18th, 1907, for the\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18\n\nPacific Settlement of International Disputes, or to some other court of\narbitration.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-19-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dd6a78930e19a95f833e9e26edc4071722cb8db4a537ba34d5a1ab346db18fc3",
      "skos:note": "Disputes shall be referred to the Permanent Court of International Justice or a court of arbitration."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-19",
      "@type": "cof:Section",
      "cof:title": "19 The High Contracting Parties agree that any disputes which might arise",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "between them relating to the interpretation or application of this Convention\nshall, if they cannot be settled by direct negotiation, be referred for decision to\nthe Permanent Court of International Justice. In case any or all of the High\nContracting Parties parties to such a dispute should not be Parties to the\nProtocol bearing the date of December 16th, 1920, relating to the Permanent\nCourt of International Justice, the dispute shall be referred, at the choice of the\nparties and in accordance with the constitutional procedure of each party, either\nto the Permanent Court of International Justice or to a court of arbitration\nconstituted in accordance with the Convention of October 18th, 1907, for the\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18\n\nPacific Settlement of International Disputes, or to some other court of\narbitration."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-19-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
