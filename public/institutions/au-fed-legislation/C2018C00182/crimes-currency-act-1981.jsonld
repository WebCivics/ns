    {
      "@id": "concept:crimes-currency-act-1981-article-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 The countries which are ready to ratify the Convention under the second",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.35",
      "values:originalText": "paragraph of Article 20 or to accede to the Convention under Article 21 but\ndesire to be allowed to make any reservations with regard to the application of\nthe Convention may inform the Secretary-General of the League of Nations to\nthis effect, who shall forthwith communicate such reservations to the High\nContracting Parties on whose behalf ratifications or accessions have been\ndeposited and enquire whether they have any objection thereto. If within six\nmonths of the date of the communication of the Secretary-General no objections\nhave been received, the participation in the Convention of the country making\nthe reservation shall be deemed to have been accepted by the other High\nContracting Parties subject to the said reservation.",
      "skos:definition": "paragraph of Article 20 or to accede to the Convention under Article 21 but\ndesire to be allowed to make any reservations with regard to the application of\nthe Convention may inform the Secretary-General of the League of Nations to\nthis effect, who shall forthwith communicate such reservations to the High\nContracting Parties on whose behalf ratifications or accessions have been\ndeposited and enquire whether they have any objection thereto. If within six\nmonths of the date of the communication of the Secretary-General no objections\nhave been received, the participation in the Convention of the country making\nthe reservation shall be deemed to have been accepted by the other High\nContracting Parties subject to the said reservation.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-22-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "234b82d885a6bdb50c8e6f5e9ada1cee2d04d11316bed74fd8b97964f9ce42ac",
      "skos:note": "Countries can make reservations with regard to Convention application."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-22",
      "@type": "cof:Section",
      "cof:title": "22 The countries which are ready to ratify the Convention under the second",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "paragraph of Article 20 or to accede to the Convention under Article 21 but\ndesire to be allowed to make any reservations with regard to the application of\nthe Convention may inform the Secretary-General of the League of Nations to\nthis effect, who shall forthwith communicate such reservations to the High\nContracting Parties on whose behalf ratifications or accessions have been\ndeposited and enquire whether they have any objection thereto. If within six\nmonths of the date of the communication of the Secretary-General no objections\nhave been received, the participation in the Convention of the country making\nthe reservation shall be deemed to have been accepted by the other High\nContracting Parties subject to the said reservation."
    },
