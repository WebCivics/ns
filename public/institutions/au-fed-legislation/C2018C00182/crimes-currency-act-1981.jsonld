      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits application to colonies, overseas territories, protectorates or territories under suzerainty or mandate.",
      "cml:executionSurface": "modalities::logic::deontic",
