        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:heldBy": {
        "@id": "values:NaturalPerson"
      }
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasRightTo",
      "cml:logicSummary": "Entitlement to rights",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Local laws allow certain rights",
      "cml:conclusionText": "Foreign civil parties have these rights"
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 In countries where the principle of the extradition of nationals is not",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-currency-act-1981.pdf"
      },
      "dc:source": "crimes-currency-act-1981.pdf, p.30",
      "values:originalText": "recognised, nationals who have returned to the territory of their own country\nafter the commission abroad of an offence referred to in Article 3 should be\npunishable in the same manner as if the offence had been committed in their\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18\n\nown territory, even in a case where the offender has acquired his nationality\nafter the commission of the offence.\nThis provision does not apply if, in a similar case, the extradition of a\nforeigner could not be granted.",
      "skos:definition": "recognised, nationals who have returned to the territory of their own country\nafter the commission abroad of an offence referred to in Article 3 should be\npunishable in the same manner as if the offence had been committed in their\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18\n\nown territory, even in a case where the offender has acquired his nationality\nafter the commission of the offence.\nThis provision does not apply if, in a similar case, the extradition of a\nforeigner could not be granted.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-currency-act-1981-article-8-norm"
        },
        {
          "@id": "concept:crimes-currency-act-1981-article-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b33ac65331f88fdecd87356139f6ed78bb1383a3aebdc5edc5f463f9f53ff982",
      "skos:note": "Extradition of nationals not recognized in their own country"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-8",
      "@type": "cof:Section",
      "cof:title": "8 In countries where the principle of the extradition of nationals is not",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "recognised, nationals who have returned to the territory of their own country\nafter the commission abroad of an offence referred to in Article 3 should be\npunishable in the same manner as if the offence had been committed in their\n\nInternational Convention for the Suppression of Counterfeiting Currency  Schedule\n\nCrimes (Currency) Act 1981\nCompilation date: 11/5/18\nRegistered: 23/5/18\n\nown territory, even in a case where the offender has acquired his nationality\nafter the commission of the offence.\nThis provision does not apply if, in a similar case, the extradition of a\nforeigner could not be granted."
    },
    {
      "@id": "concept:crimes-currency-act-1981-article-8-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-currency-act-1981-article-8"
      },
