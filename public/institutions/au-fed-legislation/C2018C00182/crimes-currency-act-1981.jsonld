      },
      "dc:source": "crimes-currency-act-1981.pdf, p.34",
      "values:originalText": "referred to in Article 3 should in each country, without ever being allowed\nimpunity, be defined, prosecuted and punished in conformity with the general\nrules of its domestic law.",
      "skos:definition": "referred to in Article 3 should in each country, without ever being allowed\nimpunity, be defined, prosecuted and punished in conformity with the general\nrules of its domestic law.",
      "cml:asserts": [
