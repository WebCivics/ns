      "@type": "cml:Concept",
      "skos:prefLabel": "28(4) The present Convention shall be registered by the Secretariat of the League",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-currency-act-1981#article-28-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
