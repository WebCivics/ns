    {
      "@id": "concept:war-crimes-act-1945-sec-10-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The punishment for any other offence against this Act shall not exceed 25 years.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
