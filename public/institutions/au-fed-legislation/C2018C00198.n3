    cml:modality cml:Deontic ;
    cml:operator "Implies" ;
    cml:logicSummary "If A is a serious crime, then it may be a war crime." ;
    cml:premiseText "(3) A serious crime may be a war crime by virtue of either or both of subsections 7(1) and (3), but not otherwise." ;
    cml:conclusionText "(3) A serious crime is a war crime if it meets the conditions in subsections 7(1) and (3)." ;
