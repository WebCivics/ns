concept:war-crimes-act-1945-sec-11 a cml:Concept ;
    skos:prefLabel "11 Only Australian citizens or residents to be prosecuted"@en ;
    cml:realizedBy doc:sec-11 ;
    values:originalText "A person shall not be charged with an offence against this Act unless he or she is:  (a) an Australian citizen; or  (b) a resident of Australia or of an external Territory." ;
