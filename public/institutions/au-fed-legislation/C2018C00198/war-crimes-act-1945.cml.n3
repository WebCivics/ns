concept:war-crimes-act-1945-sec-10 a cml:Concept ;
    skos:prefLabel "10 Punishment"@en ;
    cml:realizedBy doc:sec-10 ;
    values:originalText "(1) The punishment for an offence against this Act involving the wilful killing of a person is imprisonment for life or for any lesser term.  (2) The punishment for any other offence against this Act is imprisonment for not more than 25 years.   War crimes  Part III  Section 11  War Crimes Act 1945 Compilation date: 23/5/18 Registered: 30/5/18" ;
    skos:definition "(1) The punishment for an offence against this Act involving the wilful killing of a person is imprisonment for life or for any lesser term.  (2) The punishment for any other offence against this Act is imprisonment for not more than 25 years.   War crimes  Part III  Section 11  War Crimes Act 1945 Compilation date: 23/5/18 Registered: 30/5/18"@en ;
    cml:integrityHash "827759cc84d9a311b9db2d8a7e06c2a55877c2c288783612f9de39653b0f3e7a" ;
    cof:pageNumber "12"^^xsd:integer ;
