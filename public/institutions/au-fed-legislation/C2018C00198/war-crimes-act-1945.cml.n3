concept:war-crimes-act-1945-sec-6-ss-5 a cml:Concept ;
    skos:prefLabel "6(5) Serious crimes"@en ;
    cml:realizedBy doc:sec-6-ss-5 ;
    values:originalText "(5) Each of the following is a serious crime:  (a) attempting or conspiring to deport or intern a person as mentioned in subsection (4);  (b) aiding, abetting, counselling or procuring the deportation or internment of a person as so mentioned;  (c) being, by act or omission, in any way, directly or indirectly, knowingly concerned in, or party to, the deportation or internment of a person as so mentioned." ;
    skos:definition "(5) Each of the following is a serious crime:  (a) attempting or conspiring to deport or intern a person as mentioned in subsection (4);  (b) aiding, abetting, counselling or procuring the deportation or internment of a person as so mentioned;  (c) being, by act or omission, in any way, directly or indirectly, knowingly concerned in, or party to, the deportation or internment of a person as so mentioned."@en ;
    cml:integrityHash "1610fca10a7dbae62e858ae4458fd060efc6d002d74d59dd37131475c4cd6f55" ;
    values:partOf concept:war-crimes-act-1945-sec-6 ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Deportation or internment of a person as mentioned in subsection (4) is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
