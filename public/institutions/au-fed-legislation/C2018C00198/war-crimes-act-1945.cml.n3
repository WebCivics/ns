doc:sec-6-ss-3 a cof:Section ;
    cof:title "6(3) Serious crimes" ;
    values:kind "subsection" ;
    values:originalText "(3) An act is a serious crime if:  (a) it was done at a particular time outside Australia; and  (b) the law in force at that time in some part of Australia was such that the act would, had it been done at that time in that part, be a serious crime by virtue of subsection (1)." ;
    cof:pageNumber "8"^^xsd:integer .

