    },
    {
      "@id": "concept:c2018c00199-sch-1-sec-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The amendments overlap with corrupt conduct at different times.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Overlaps with corrupt conduct before and after commencement.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlaps",
      "cml:premiseText": "The amendments apply in relation to corruption issues, whether the related corrupt conduct was or may have been engaged in before the commencement or will or may be engaged in after that commencement."
    },
    {
      "@id": "concept:c2018c00199-sch-1-sec-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The amendments apply to all related corrupt conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Applies to all related corrupt conduct.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "appliesTo",
      "cml:premiseText": "Corrupt conduct within the meaning of the Law Enforcement Integrity Commissioner Act 2006."
    },
    {
      "@id": "concept:c2018c00199-sch-1-sec-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The amendments apply to corruption issues.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Holds true for all related corrupt conduct.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:premiseText": "Corrupt conduct within the meaning of the Law Enforcement Integrity Commissioner Act 2006."
    },
    {
      "@id": "concept:c2018c00199-sch-1-sec-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The amendments diffuse to all related corrupt conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffuses to all related corrupt conduct.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:premiseText": "Corrupt conduct within the meaning of the Law Enforcement Integrity Commissioner Act 2006."
    },
    {
      "@id": "concept:c2018c00199-sch-1-sec-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The amendments hold for all related corrupt conduct.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Holds for all related corrupt conduct.",
