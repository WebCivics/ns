    {
      "@id": "concept:c2018c00199-sch-1-sec-3",
      "@type": "cml:Concept",
      "dc:source": "c2018c00199.pdf, p.7",
      "skos:note": "Amendments apply to corruption issues before or after commencement.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "3 Application of amendments"
      },
      "wasDerivedFrom": "c2018c00199.pdf",
      "asserts": [
        "concept:c2018c00199-sch-1-sec-3-norm",
        "concept:c2018c00199-sch-1-sec-3-logic-deontic-1",
        "concept:c2018c00199-sch-1-sec-3-logic-alleninterval-2",
        "concept:c2018c00199-sch-1-sec-3-logic-ltl-3",
        "concept:c2018c00199-sch-1-sec-3-logic-diffusion-4",
        "concept:c2018c00199-sch-1-sec-3-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "0a896482ce6e7215dc87eaed615c712a1a61711a4d42d5f0f2d4b07cc133fd87",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
