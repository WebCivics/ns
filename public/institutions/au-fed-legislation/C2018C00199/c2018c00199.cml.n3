concept:c2018c00199-sch-3-sec-236e a cml:Concept ;
    skos:prefLabel "236E Evidentiary certificates in proceedings for offences"@en ;
    cml:realizedBy doc:sch-3-sec-236e ;
    values:originalText "Who may issue a certificate  (1) A written certificate may be issued under this subsection by:  (a) an officer who participates in the boarding of a ship or aircraft (the target ship or aircraft) under Division 12A; or  (b) if a ship (the target ship) is boarded under Division 12A— the commander of the Commonwealth ship or Commonwealth aircraft whose crew members participated in the boarding; or  Schedule 3  Deterring people smuggling" ;
    skos:definition "Who may issue a certificate  (1) A written certificate may be issued under this subsection by:  (a) an officer who participates in the boarding of a ship or aircraft (the target ship or aircraft) under Division 12A; or  (b) if a ship (the target ship) is boarded under Division 12A— the commander of the Commonwealth ship or Commonwealth aircraft whose crew members participated in the boarding; or  Schedule 3  Deterring people smuggling"@en ;
    cml:integrityHash "6a6fded7097a63f7c37aba7b43e5276ad94973688b9856eb8ecc9f076254fcf3" ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Who may issue a certificate" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
