concept:c2018c00199-sch-6-sec-4-2 a cml:Concept ;
    skos:prefLabel "4 At the end of section 69C (after the note)"@en ;
    cml:realizedBy doc:sch-6-sec-4-2 ;
    values:originalText "Add:  (4) If:  (a) the Commissioner has, under subsection (3), delegated one or more powers, functions or duties to a senior executive AFP employee; and  (b) an AFP employee is acting in, or performing the duties of, the position held or occupied by the senior executive AFP employee; the Commissioner is taken to have delegated the powers, functions or duties mentioned in paragraph (a) to the AFP employee mentioned in paragraph (b). Telecommunications (Interception and Access) Act 1979" ;
    skos:definition "Add:  (4) If:  (a) the Commissioner has, under subsection (3), delegated one or more powers, functions or duties to a senior executive AFP employee; and  (b) an AFP employee is acting in, or performing the duties of, the position held or occupied by the senior executive AFP employee; the Commissioner is taken to have delegated the powers, functions or duties mentioned in paragraph (a) to the AFP employee mentioned in paragraph (b). Telecommunications (Interception and Access) Act 1979"@en ;
    cml:integrityHash "e88a5ed61597846152f193fb64664776286dfc77f71e8c511dc967fd78b2b5ac" ;
    cof:pageNumber "57"^^xsd:integer ;
    skos:note "Commissioner is taken to have delegated powers, functions or duties to an AFP employee if the Commissioner has delegated them under subsection (3) and the AFP employee is acting in or performing the duties of the senior executive AFP employee." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2018c00199.pdf> ;
    dc:source "c2018c00199.pdf, p.57" ;
    cml:asserts concept:c2018c00199-sch-6-sec-4-2-norm .
