doc:sch-6-sec-5-2 a cof:Section ;
    cof:title "5 Subsection 5(1) (definition of Inspector of the Victorian" ;
    values:kind "section" ;
    values:originalText "Inspectorate) Repeal the definition, substitute: Inspector of the Victorian Inspectorate has the same meaning as Inspector has in the Victorian Inspectorate Act." ;
    cof:pageNumber "57"^^xsd:integer .

