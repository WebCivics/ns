concept:c2018c00199-sch-2-sec-18 a cml:Concept ;
    skos:prefLabel "18 Section 15YA"@en ;
    cml:realizedBy doc:sch-2-sec-18 ;
    values:originalText "Insert: special witness has the meaning given by subsection 15YAB(1). special witness proceeding means a proceeding to which subsection 15Y(3) applies. vulnerable adult complainant has the meaning given by section 15YAA. vulnerable adult proceeding means a proceeding to which subsection 15Y(2) applies." ;
    skos:definition "Insert: special witness has the meaning given by subsection 15YAB(1). special witness proceeding means a proceeding to which subsection 15Y(3) applies. vulnerable adult complainant has the meaning given by section 15YAA. vulnerable adult proceeding means a proceeding to which subsection 15Y(2) applies."@en ;
    cml:integrityHash "576b070f1190d4340948a5aba79f7399b5a2878a0145cad00652afa293e284be" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Definitions for special witness, vulnerable adult complainant, and vulnerable adult proceeding." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2018c00199.pdf> ;
