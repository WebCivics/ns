concept:c2018c00199-sch-4-sec-15 a cml:Concept ;
    skos:prefLabel "15 At the end of subsection 75Q(1)"@en ;
    cml:realizedBy doc:sch-4-sec-15 ;
    values:originalText "Add: Note: An example of a reviewable decision relating to 2 persons is a decision refusing to register a person as a remittance affiliate of a  Anti-Money Laundering and Counter-Terrorism Financing amendments  Schedule 4 Main amendments  Part 1  Crimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness Protection and Other Measures) Act 2013 Compilation date: 23/5/18 Registered: 30/5/18  registered remittance network provider, if the provider applied under subsection 75B(2) for that person to be so registered." ;
    skos:definition "Add: Note: An example of a reviewable decision relating to 2 persons is a decision refusing to register a person as a remittance affiliate of a  Anti-Money Laundering and Counter-Terrorism Financing amendments  Schedule 4 Main amendments  Part 1  Crimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness Protection and Other Measures) Act 2013 Compilation date: 23/5/18 Registered: 30/5/18  registered remittance network provider, if the provider applied under subsection 75B(2) for that person to be so registered."@en ;
    cml:integrityHash "048b2fdda4f9cd0044251be902119d1915d140bf04fa322e72676dcaf13f7426" ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Registering a person as a remittance network provider is obligatory if they applied under subsection 75B(2) for that person to be so registered." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2018c00199.pdf> ;
    dc:source "c2018c00199.pdf, p.40" ;
    cml:asserts concept:c2018c00199-sch-4-sec-15-norm .
