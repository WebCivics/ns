concept:c2018c00199-sch-2-sec-49 a cml:Concept ;
    skos:prefLabel "49 Subsection 15YL(3)"@en ;
    cml:realizedBy doc:sch-2-sec-49 ;
    values:originalText "Repeal the subsection, substitute: Persons to whom these alternative arrangements apply  (3) This subsection applies to the following persons:  (a) for a child proceeding—a child witness;  (b) for a vulnerable adult proceeding—a vulnerable adult complainant;  (c) for a special witness proceeding—a special witness for whom an order under subsection 15YAB(3) is in force for this section; unless that person is at least 16 and chooses not to give evidence under the arrangements." ;
    skos:definition "Repeal the subsection, substitute: Persons to whom these alternative arrangements apply  (3) This subsection applies to the following persons:  (a) for a child proceeding—a child witness;  (b) for a vulnerable adult proceeding—a vulnerable adult complainant;  (c) for a special witness proceeding—a special witness for whom an order under subsection 15YAB(3) is in force for this section; unless that person is at least 16 and chooses not to give evidence under the arrangements."@en ;
    cml:integrityHash "94786cfc5c3f1b0149d054bd6ae978cbb305dd7910e3c5a0e3fb0293ac8fa5a6" ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "This subsection applies to specific persons under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2018c00199.pdf> ;
    dc:source "c2018c00199.pdf, p.17" ;
    cml:asserts concept:c2018c00199-sch-2-sec-49-norm .
