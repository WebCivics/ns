concept:c2018c00199-sch-4-sec-233g a cml:Concept ;
    skos:prefLabel "233G Failure to comply does not affect validity"@en ;
    cml:realizedBy doc:sch-4-sec-233g ;
    values:originalText "A failure to comply with subsection 233C(1) or 233E(4) (about giving notice) in relation to a decision does not affect the validity of the decision." ;
