concept:c2018c00199-sch-2-sec-75 a cml:Concept ;
    skos:prefLabel "75 Paragraph 15YR(1)(c)"@en ;
    cml:realizedBy doc:sch-2-sec-75 ;
    values:originalText "Repeal the paragraph, substitute:  (c) the matter:  (i) identifies another person, who is a person to whom subsection (1A) applies (the vulnerable person) in relation to a proceeding, as being a child witness or vulnerable adult complainant; or  (ii) is likely to lead to the vulnerable person being identified as such a person; and  (d) the vulnerable person is not a defendant in the proceeding.  Schedule 2  Supporting victims and witnesses in criminal proceedings" ;
    skos:definition "Repeal the paragraph, substitute:  (c) the matter:  (i) identifies another person, who is a person to whom subsection (1A) applies (the vulnerable person) in relation to a proceeding, as being a child witness or vulnerable adult complainant; or  (ii) is likely to lead to the vulnerable person being identified as such a person; and  (d) the vulnerable person is not a defendant in the proceeding.  Schedule 2  Supporting victims and witnesses in criminal proceedings"@en ;
    cml:integrityHash "208d19dca7ebe65824b08c2be092c4b7f407fa12b2e04b484518c95d277d9d36" ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "Identify vulnerable persons in proceedings" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
