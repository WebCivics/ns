concept:c2018c00199-sch-1-sec-3 a cml:Concept ;
    skos:prefLabel "3 Application of amendments"@en ;
    cml:realizedBy doc:sch-1-sec-3 ;
    values:originalText "The amendments made by items 1 and 2 apply in relation to corruption issues, whether the related corrupt conduct (within the meaning of the Law Enforcement Integrity Commissioner Act 2006):  (a) was or may have been engaged in before the commencement of those items; or  (b) will or may be engaged in after that commencement. Law Enforcement Integrity Commissioner Act 2006" ;
    skos:definition "The amendments made by items 1 and 2 apply in relation to corruption issues, whether the related corrupt conduct (within the meaning of the Law Enforcement Integrity Commissioner Act 2006):  (a) was or may have been engaged in before the commencement of those items; or  (b) will or may be engaged in after that commencement. Law Enforcement Integrity Commissioner Act 2006"@en ;
    cml:integrityHash "0a896482ce6e7215dc87eaed615c712a1a61711a4d42d5f0f2d4b07cc133fd87" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Amendments apply to corruption issues before or after commencement." ;
    cml:curationStatus cml:Proposed ;
