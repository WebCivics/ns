doc:sch-2-sec-19-ss-1 a cof:Section ;
    cof:title "19(1) After section 15YA" ;
    values:kind "subsection" ;
    values:originalText "(1) In a proceeding for a Commonwealth offence, the court may declare a person to be a special witness in relation to the proceeding if satisfied that the person is unlikely to be able to satisfactorily give evidence in the ordinary manner because of:  (a) a disability; or  Supporting victims and witnesses in criminal proceedings  Schedule 2 Vulnerable witness protections  Part 1  Crimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness Protection and Other Measures) Act 2013 Compilation date: 23/5/18 Registered: 30/5/18  (b) intimidation, distress or emotional trauma arising from:  (i) the person’s age, cultural background or relationship to a party to the proceeding; or  (ii) the nature of the evidence; or  (iii) some other relevant factor. Note: Such a declaration can also be made in a related proceeding (see subsection 15Y(5))." ;
    cof:pageNumber "12"^^xsd:integer .

concept:c2018c00199-sch-2-sec-19-ss-2 a cml:Concept ;
    skos:prefLabel "19(2) After section 15YA"@en ;
    cml:realizedBy doc:sch-2-sec-19-ss-2 ;
    values:originalText "(2) A declaration under subsection (1) may be made on the court’s own initiative or on application by or on behalf of a party to the proceeding. Orders that certain protections apply to a special witness" ;
    skos:definition "(2) A declaration under subsection (1) may be made on the court’s own initiative or on application by or on behalf of a party to the proceeding. Orders that certain protections apply to a special witness"@en ;
    cml:integrityHash "c996e653677575b3c8c4c5000b9150470eb9e84dda7e70c9e12e47b14c24ca65" ;
    values:partOf concept:c2018c00199-sch-2-sec-19 ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "A declaration under subsection (1) may be made on the court’s own initiative or on application by or on behalf of a party to the proceeding. Adult can opt out of being treated as vulnerable adult complainant." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2018c00199.pdf> ;
