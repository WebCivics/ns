concept:c2018c00199-sch-2-sec-279-7 a cml:Concept ;
    skos:prefLabel "279 7  Other laws about foreign evidence not affected"@en ;
    cml:realizedBy doc:sch-2-sec-279-7 ;
    values:originalText "This Division does not prevent any other law about taking evidence of a witness outside Australia from applying for the purposes of a proceeding.  Schedule 2  Supporting victims and witnesses in criminal proceedings" ;
