    {
      "@id": "concept:c2018c00199-sch-2-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Paragraph 15YR(1)(c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.23",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) the matter:\n\n(i) identifies another person, who is a person to whom\nsubsection (1A) applies (the vulnerable person) in\nrelation to a proceeding, as being a child witness or\nvulnerable adult complainant; or\n\n(ii) is likely to lead to the vulnerable person being identified\nas such a person; and\n\n(d) the vulnerable person is not a defendant in the proceeding.\n\nSchedule 2  Supporting victims and witnesses in criminal proceedings",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(c) the matter:\n\n(i) identifies another person, who is a person to whom\nsubsection (1A) applies (the vulnerable person) in\nrelation to a proceeding, as being a child witness or\nvulnerable adult complainant; or\n\n(ii) is likely to lead to the vulnerable person being identified\nas such a person; and\n\n(d) the vulnerable person is not a defendant in the proceeding.\n\nSchedule 2  Supporting victims and witnesses in criminal proceedings",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-2-sec-75-norm"
        }
      ],
      "cml:integrityHash": "208d19dca7ebe65824b08c2be092c4b7f407fa12b2e04b484518c95d277d9d36",
      "skos:note": "Identify vulnerable persons in proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Paragraph 15YR(1)(c)",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(c) the matter:\n\n(i) identifies another person, who is a person to whom\nsubsection (1A) applies (the vulnerable person) in\nrelation to a proceeding, as being a child witness or\nvulnerable adult complainant; or\n\n(ii) is likely to lead to the vulnerable person being identified\nas such a person; and\n\n(d) the vulnerable person is not a defendant in the proceeding.\n\nSchedule 2  Supporting victims and witnesses in criminal proceedings"
    },
