      "cml:integrityHash": "7e841a8be6daece23c4539514f6f8915ebb3dec1eafafc9223d674576f7247d4",
      "skos:note": "Vulnerable adult complainant need not be involved in the vulnerable adult proceeding. Court may order application of certain sections to a special witness"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-19-ss-3",
      "@type": "cof:Section",
      "cof:title": "19(3) After section 15YA",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(3) A vulnerable adult complainant need not be involved in the\nvulnerable adult proceeding or the initiation of that proceeding.\n15YAB  Special witnesses\nMeaning of special witness"
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-19-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
