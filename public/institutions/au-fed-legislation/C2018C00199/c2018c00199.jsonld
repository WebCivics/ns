    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-3-3",
      "@type": "cof:Section",
      "cof:title": "3 Subsection 69C(3)",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "Omit “the Deputy Commissioner”, substitute “a Deputy\nCommissioner”.\n\nMiscellaneous amendments  Schedule 6\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18"
    },
    {
      "@id": "concept:c2018c00199-sch-6-sec-3-3-norm",
