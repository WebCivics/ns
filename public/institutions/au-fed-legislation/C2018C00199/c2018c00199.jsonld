    {
      "@id": "concept:c2018c00199-sch-2-sec-279-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "279 4  Application of laws about witnesses",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-279-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.26",
      "values:originalText": "A person who gives evidence under a direction is taken to give it at\nthe courtroom or other place in Australia where the court is sitting.\nNote:\nThis section has effect, for example, for the purposes of laws relating\nto evidence, procedure, contempt of court and perjury.",
      "skos:definition": "A person who gives evidence under a direction is taken to give it at\nthe courtroom or other place in Australia where the court is sitting.\nNote:\nThis section has effect, for example, for the purposes of laws relating\nto evidence, procedure, contempt of court and perjury.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-2-sec-279-4-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-2-sec-279-4-logic-deontic-1"
        },
        {
          "@id": "concept:c2018c00199-sch-2-sec-279-4-logic-alleninterval-2"
        },
        {
