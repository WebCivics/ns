    {
      "@id": "concept:c2018c00199-sch-6-sec-1-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "receives",
      "cml:logicSummary": "Receives the Royal Assent",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act is enacted.",
      "cml:conclusionText": "The day this Act receives the Royal Assent."
    },
    {
      "@id": "concept:c2018c00199-sch-6-sec-1-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "on",
      "cml:logicSummary": "On the day of receipt",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Royal Assent is given on a specific day.",
      "cml:conclusionText": "The day this Act receives the Royal Assent is the specified day."
    },
    {
      "@id": "concept:c2018c00199-sch-6-sec-1-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Implication from receipt of Royal Assent",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Act is enacted and receives the Royal Assent.",
      "cml:conclusionText": "The day this Act receives the Royal Assent is the specified day."
    },
    {
      "@id": "concept:c2018c00199-sch-6-sec-1-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "through",
      "cml:logicSummary": "Spread through the Act",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Royal Assent is given to the Act.",
      "cml:conclusionText": "The day this Act receives the Royal Assent is spread throughout the Act."
    },
    {
      "@id": "concept:c2018c00199-sch-6-sec-1-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "by",
      "cml:logicSummary": "Defined by the State",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The State defines the day of receipt.",
      "cml:conclusionText": "The day this Act receives the Royal Assent is defined by the State."
    },
