      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-19-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "needNot",
      "cml:logicSummary": "Obligation to involve complainant",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A vulnerable adult complainant need not be involved in the vulnerable adult proceeding.",
      "cml:conclusionText": "The state need not involve the complainant."
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-19-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relationship between involve and proceed",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A vulnerable adult complainant need not be involved in the vulnerable adult proceeding.",
      "cml:conclusionText": "The state can proceed without involving the complainant during the proceeding."
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-19-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Temporal relationship between involve and proceed",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A vulnerable adult complainant need not be involved in the vulnerable adult proceeding.",
      "cml:conclusionText": "The state can proceed until involving the complainant is required."
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-19-ss-3-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:logicSummary": "Spread of obligation to involve",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A vulnerable adult complainant need not be involved in the vulnerable adult proceeding.",
      "cml:conclusionText": "The state's obligation to involve the complainant diffuses to other persons or entities."
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-19-ss-3-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "cognizes",
      "cml:logicSummary": "Artificial agent's understanding of obligation",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A vulnerable adult complainant need not be involved in the vulnerable adult proceeding.",
      "cml:conclusionText": "The artificial agent cognizes that the state need not involve the complainant."
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-19-ss-3-logic-deontic-6",
