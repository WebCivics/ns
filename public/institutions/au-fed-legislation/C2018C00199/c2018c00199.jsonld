    {
      "@id": "concept:c2018c00199-sch-4-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 After subsection 139(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.42",
      "values:originalText": "Insert:\n\n(2A) Paragraph (1)(c) does not apply to a false customer name if the\ncustomer’s use of that name is justified, or excused, by or under a\nlaw.\nNote:\nA defendant bears an evidential burden in relation to the matters in\nthis subsection (see subsection 13.3(3) of the Criminal Code).",
      "skos:definition": "Insert:\n\n(2A) Paragraph (1)(c) does not apply to a false customer name if the\ncustomer’s use of that name is justified, or excused, by or under a\nlaw.\nNote:\nA defendant bears an evidential burden in relation to the matters in\nthis subsection (see subsection 13.3(3) of the Criminal Code).",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-4-sec-24-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-4-sec-24-logic-deontic-1"
        },
        {
          "@id": "concept:c2018c00199-sch-4-sec-24-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "2f486594c44caa9e3dcc62e5fbfa80a41231ba84357b7d6e4babd77f69220798",
      "skos:note": "Defendant bears evidential burden in relation to matters in subsection (3)(3) of the Criminal Code."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-24",
      "@type": "cof:Section",
      "cof:title": "24 After subsection 139(2)",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "Insert:\n\n(2A) Paragraph (1)(c) does not apply to a false customer name if the\ncustomer’s use of that name is justified, or excused, by or under a\nlaw.\nNote:\nA defendant bears an evidential burden in relation to the matters in\nthis subsection (see subsection 13.3(3) of the Criminal Code)."
    },
    {
      "@id": "concept:c2018c00199-sch-4-sec-24-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2018c00199-sch-4-sec-24"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2018c00199-sch-4-sec-24-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Defendant bears evidential burden",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2018c00199-sch-4-sec-24-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Evidential Burden",
      "cml:logicSummary": "Defendant must provide evidence",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2018c00199-sch-4-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Subsection 145(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.42",
      "values:originalText": "Repeal the subsection, substitute:\n\nAnti-Money Laundering and Counter-Terrorism Financing amendments  Schedule 4\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(1) The AUSTRAC CEO may, in writing, appoint as an authorised\nofficer for the purposes of this Act:\n\n(a) a member of the staff of AUSTRAC; or\n\n(b) a person whose services are made available to the\nAUSTRAC CEO under subsection 225(3), other than a\nperson covered by paragraph 225(3)(g).\nNote:\nFor revocation, see subsection 33(3) of the Acts Interpretation Act\n1901.",
      "skos:definition": "Repeal the subsection, substitute:\n\nAnti-Money Laundering and Counter-Terrorism Financing amendments  Schedule 4\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(1) The AUSTRAC CEO may, in writing, appoint as an authorised\nofficer for the purposes of this Act:\n\n(a) a member of the staff of AUSTRAC; or\n\n(b) a person whose services are made available to the\nAUSTRAC CEO under subsection 225(3), other than a\nperson covered by paragraph 225(3)(g).\nNote:\nFor revocation, see subsection 33(3) of the Acts Interpretation Act\n1901.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-4-sec-25-norm"
        }
      ],
      "cml:integrityHash": "0b825170e60ce2ce5aa1447482dd17ed4499288dc71362dd89d22baba8231c13",
      "skos:note": "Appoints AUSTRAC staff as authorised officers."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Subsection 145(1)",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "Repeal the subsection, substitute:\n\nAnti-Money Laundering and Counter-Terrorism Financing amendments  Schedule 4\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(1) The AUSTRAC CEO may, in writing, appoint as an authorised\nofficer for the purposes of this Act:\n\n(a) a member of the staff of AUSTRAC; or\n\n(b) a person whose services are made available to the\nAUSTRAC CEO under subsection 225(3), other than a\nperson covered by paragraph 225(3)(g).\nNote:\nFor revocation, see subsection 33(3) of the Acts Interpretation Act\n1901."
    },
    {
      "@id": "concept:c2018c00199-sch-4-sec-25-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2018c00199-sch-4-sec-25"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
