    {
      "@id": "concept:c2018c00199-sch-6-sec-4-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 At the end of section 69C (after the note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-4-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.57",
      "values:originalText": "Add:\n\n(4) If:\n\n(a) the Commissioner has, under subsection (3), delegated one or\nmore powers, functions or duties to a senior executive AFP\nemployee; and\n\n(b) an AFP employee is acting in, or performing the duties of,\nthe position held or occupied by the senior executive AFP\nemployee;\nthe Commissioner is taken to have delegated the powers, functions\nor duties mentioned in paragraph (a) to the AFP employee\nmentioned in paragraph (b).\nTelecommunications (Interception and Access) Act 1979",
      "skos:definition": "Add:\n\n(4) If:\n\n(a) the Commissioner has, under subsection (3), delegated one or\nmore powers, functions or duties to a senior executive AFP\nemployee; and\n\n(b) an AFP employee is acting in, or performing the duties of,\nthe position held or occupied by the senior executive AFP\nemployee;\nthe Commissioner is taken to have delegated the powers, functions\nor duties mentioned in paragraph (a) to the AFP employee\nmentioned in paragraph (b).\nTelecommunications (Interception and Access) Act 1979",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-6-sec-4-2-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-6-sec-4-2-logic-deontic-1"
        },
        {
          "@id": "concept:c2018c00199-sch-6-sec-4-2-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2018c00199-sch-6-sec-4-2-logic-ltl-3"
        },
        {
          "@id": "concept:c2018c00199-sch-6-sec-4-2-logic-argumentation-4"
        }
      ],
      "cml:integrityHash": "e88a5ed61597846152f193fb64664776286dfc77f71e8c511dc967fd78b2b5ac",
      "skos:note": "Commissioner is taken to have delegated powers, functions or duties to an AFP employee if the Commissioner has delegated them under subsection (3) and the AFP employee is acting in or performing the duties of the senior executive AFP employee."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-4-2",
      "@type": "cof:Section",
      "cof:title": "4 At the end of section 69C (after the note)",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "Add:\n\n(4) If:\n\n(a) the Commissioner has, under subsection (3), delegated one or\nmore powers, functions or duties to a senior executive AFP\nemployee; and\n\n(b) an AFP employee is acting in, or performing the duties of,\nthe position held or occupied by the senior executive AFP\nemployee;\nthe Commissioner is taken to have delegated the powers, functions\nor duties mentioned in paragraph (a) to the AFP employee\nmentioned in paragraph (b).\nTelecommunications (Interception and Access) Act 1979"
    },
    {
