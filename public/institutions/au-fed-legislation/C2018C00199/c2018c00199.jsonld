      "dc:source": "c2018c00199.pdf, p.56",
      "values:originalText": "(1D) The provision of police services and regulatory services in an\nexternal Territory must be in accordance with any arrangements in\nforce under subsection (1C) for the Territory.",
      "skos:definition": "(1D) The provision of police services and regulatory services in an\nexternal Territory must be in accordance with any arrangements in\nforce under subsection (1C) for the Territory.",
      "values:partOf": {
        "@id": "concept:c2018c00199-sch-6-sec-1-3"
      },
      "cml:asserts": [
