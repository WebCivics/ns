      "dc:source": "c2018c00199.pdf, p.7",
      "values:originalText": "Omit “if the evidence”, substitute “if giving the evidence”.\n\nSchedule 1  Assisting the Australian Commission for Law Enforcement Integrity\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\n\nCompilation date: 23/5/18\nRegistered: 30/5/18",
      "skos:definition": "Omit “if the evidence”, substitute “if giving the evidence”.\n\nSchedule 1  Assisting the Australian Commission for Law Enforcement Integrity\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\n\nCompilation date: 23/5/18\nRegistered: 30/5/18",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-1-sec-4-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-1-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "626ff367aa5fdc8da0115a0885a09f8b4f4298bd33b437ddb5626e97d7ac1aa2",
      "skos:note": "Omit 'if the evidence', substitute 'if giving the evidence'."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsection 89(1)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit “if the evidence”, substitute “if giving the evidence”.\n\nSchedule 1  Assisting the Australian Commission for Law Enforcement Integrity\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\n\nCompilation date: 23/5/18\nRegistered: 30/5/18"
    },
