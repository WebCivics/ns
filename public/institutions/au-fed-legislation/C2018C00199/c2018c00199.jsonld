    },
    {
      "@id": "concept:c2018c00199-sch-3-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Subsection 236E(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.37",
      "values:originalText": "Repeal the subsection, substitute:\nIssuing a certificate\n\n(1) A written certificate may be issued under this subsection if an\nauthorisation authorises the exercise of maritime powers in relation\nto a vessel or aircraft (the target vessel or aircraft). The certificate\nmay be issued by:\n\n(a) the authorising officer who gave the authorisation; or\n\n(b) a maritime officer who boards the target vessel or aircraft in\naccordance with the authorisation.\nNote:\nFor definitions for this section, see subsection (6).",
      "skos:definition": "Repeal the subsection, substitute:\nIssuing a certificate\n\n(1) A written certificate may be issued under this subsection if an\nauthorisation authorises the exercise of maritime powers in relation\nto a vessel or aircraft (the target vessel or aircraft). The certificate\nmay be issued by:\n\n(a) the authorising officer who gave the authorisation; or\n\n(b) a maritime officer who boards the target vessel or aircraft in\naccordance with the authorisation.\nNote:\nFor definitions for this section, see subsection (6).",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-3-sec-6-norm"
        }
      ],
      "cml:integrityHash": "61d8408e3420356c862136ad8ae7c4905e12305758ea30374316dfd710d58b40",
      "skos:note": "Issuing a certificate under this subsection if an authorisation authorises the exercise of maritime powers."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Subsection 236E(1)",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "Repeal the subsection, substitute:\nIssuing a certificate\n\n(1) A written certificate may be issued under this subsection if an\nauthorisation authorises the exercise of maritime powers in relation\nto a vessel or aircraft (the target vessel or aircraft). The certificate\nmay be issued by:\n\n(a) the authorising officer who gave the authorisation; or\n\n(b) a maritime officer who boards the target vessel or aircraft in\naccordance with the authorisation.\nNote:\nFor definitions for this section, see subsection (6)."
    },
    {
      "@id": "concept:c2018c00199-sch-3-sec-6-norm",
