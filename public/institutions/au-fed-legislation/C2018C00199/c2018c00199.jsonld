          "@id": "concept:c2018c00199-sch-3-sec-9-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "349d5ce8c05c1f42527b89ef6c8db467a4552b52dbcb823dce31912538c3d62e",
      "skos:note": "Repeal subsection and substitute definitions."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Subsection 236E(6)",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Repeal the subsection, substitute:\nDefinitions\n\n(6) In this section:\nauthorisation has the same meaning as in the Maritime Powers Act\n2013.\nauthorising officer has the same meaning as in the Maritime\nPowers Act 2013.\nCommonwealth aircraft has the same meaning as in the Maritime\nPowers Act 2013.\nCommonwealth ship has the same meaning as in the Maritime\nPowers Act 2013.\nmaritime powers has the same meaning as in the Maritime Powers\nAct 2013."
    },
