      },
      "dc:source": "c2018c00199.pdf, p.49",
      "values:originalText": "Omit “Information Privacy Principles set out in section 14 of the\nPrivacy Act 1988”, substitute “Australian Privacy Principles”.\n\nSchedule 5  Assisting the International Residual Mechanism for Criminal Tribunals\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\n\nCompilation date: 23/5/18\nRegistered: 30/5/18",
      "skos:definition": "Omit “Information Privacy Principles set out in section 14 of the\nPrivacy Act 1988”, substitute “Australian Privacy Principles”.\n\nSchedule 5  Assisting the International Residual Mechanism for Criminal Tribunals\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\n\nCompilation date: 23/5/18\nRegistered: 30/5/18",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-4-sec-34-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-4-sec-34-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "883b837573c9545da524203108ee00fcd500f2d9be8aec8a6d1731a322f27921",
      "skos:note": "Replace outdated privacy principles with Australian Privacy Principles."
    },
