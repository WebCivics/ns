    {
      "@id": "concept:c2018c00199-sch-6-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedule(s)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-3-2"
      },
      "cml:curationStatus": {
