      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2018c00199-sch-5-sec-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Repeal",
      "cml:logicSummary": "Obligation to repeal definition",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Definition needs to be repealed",
      "cml:conclusionText": "Definition of Former Yugoslavia Tribunal is repealed"
    },
    {
      "@id": "concept:c2018c00199-sch-5-sec-7-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Substitute",
      "cml:logicSummary": "Definition substitution",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "New definition needed",
      "cml:conclusionText": "Former Yugoslavia Tribunal definition is substituted"
    },
    {
      "@id": "concept:c2018c00199-sch-5-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-5-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.52",
      "values:originalText": "Insert:\nInternational Residual Mechanism for Criminal Tribunals:\n\nAssisting the International Residual Mechanism for Criminal Tribunals  Schedule 5\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(a) means the International Residual Mechanism for Criminal\nTribunals, established by United Nations Security Council\nResolution 1966 S/RES/1966 (2010); and\n\n(b) includes the organs referred to in Article 4 of the Statute of\nthe Tribunal.\nNote 1:\nIn 2013, the text of United Nations Security Council resolutions was\naccessible through the United Nations website (www.un.org).\nNote 2:\nThe United Nations Security Council decided on 22 December 2010\nto establish this Mechanism to carry out residual functions of the\nFormer Yugoslavia Tribunal and the Rwanda Tribunal.",
      "skos:definition": "Insert:\nInternational Residual Mechanism for Criminal Tribunals:\n\nAssisting the International Residual Mechanism for Criminal Tribunals  Schedule 5\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(a) means the International Residual Mechanism for Criminal\nTribunals, established by United Nations Security Council\nResolution 1966 S/RES/1966 (2010); and\n\n(b) includes the organs referred to in Article 4 of the Statute of\nthe Tribunal.\nNote 1:\nIn 2013, the text of United Nations Security Council resolutions was\naccessible through the United Nations website (www.un.org).\nNote 2:\nThe United Nations Security Council decided on 22 December 2010\nto establish this Mechanism to carry out residual functions of the\nFormer Yugoslavia Tribunal and the Rwanda Tribunal.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-5-sec-8-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-5-sec-8-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "b7c8bf6a543a86d55691ef18b7aa186b972266efe500be02503a74cef7faa2d5",
      "skos:note": "Definition of International Residual Mechanism for Criminal Tribunals"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-5-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Section 4",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Insert:\nInternational Residual Mechanism for Criminal Tribunals:\n\nAssisting the International Residual Mechanism for Criminal Tribunals  Schedule 5\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(a) means the International Residual Mechanism for Criminal\nTribunals, established by United Nations Security Council\nResolution 1966 S/RES/1966 (2010); and\n\n(b) includes the organs referred to in Article 4 of the Statute of\nthe Tribunal.\nNote 1:\nIn 2013, the text of United Nations Security Council resolutions was\naccessible through the United Nations website (www.un.org).\nNote 2:\nThe United Nations Security Council decided on 22 December 2010\nto establish this Mechanism to carry out residual functions of the\nFormer Yugoslavia Tribunal and the Rwanda Tribunal."
    },
    {
      "@id": "concept:c2018c00199-sch-5-sec-8-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2018c00199-sch-5-sec-8"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2018c00199-sch-5-sec-8-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Classifies the Mechanism",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Mechanism established by United Nations Security Council Resolution 1966 S/RES/1966 (2010)",
      "cml:conclusionText": "International Residual Mechanism for Criminal Tribunals"
    },
    {
      "@id": "concept:c2018c00199-sch-5-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Section 4 (definition of Rwanda Tribunal)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-5-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.53",
      "values:originalText": "Repeal the definition, substitute:\nRwanda Tribunal:\n\n(a) means the International Criminal Tribunal for the Prosecution\nof Persons Responsible for Genocide and Other Serious\nViolations of International Humanitarian Law Committed in\nthe Territory of Rwanda and Rwandan citizens responsible\nfor genocide and other such violations committed in the\nterritory of neighbouring States, between 1 January 1994 and",
      "skos:definition": "Repeal the definition, substitute:\nRwanda Tribunal:\n\n(a) means the International Criminal Tribunal for the Prosecution\nof Persons Responsible for Genocide and Other Serious\nViolations of International Humanitarian Law Committed in\nthe Territory of Rwanda and Rwandan citizens responsible\nfor genocide and other such violations committed in the\nterritory of neighbouring States, between 1 January 1994 and",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-5-sec-9-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-5-sec-9-logic-deontic-1"
        },
        {
          "@id": "concept:c2018c00199-sch-5-sec-9-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "94f6275466ccb16a4c63926be98308f863e58ddb1f13e639956f193d79165935",
      "skos:note": "Repeal and substitute definition of Rwanda Tribunal"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-5-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Section 4 (definition of Rwanda Tribunal)",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "Repeal the definition, substitute:\nRwanda Tribunal:\n\n(a) means the International Criminal Tribunal for the Prosecution\nof Persons Responsible for Genocide and Other Serious\nViolations of International Humanitarian Law Committed in\nthe Territory of Rwanda and Rwandan citizens responsible\nfor genocide and other such violations committed in the\nterritory of neighbouring States, between 1 January 1994 and"
    },
    {
