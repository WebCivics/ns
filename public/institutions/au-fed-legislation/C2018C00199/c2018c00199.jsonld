      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) Similarly, subsection 15YAB(1) (about special witnesses) also applies to any proceedings connected with a proceeding for a Commonwealth offence.",
      "cml:conclusionText": "The application of special witnesses diffuses during the duration of Commonwealth offences"
    },
    {
