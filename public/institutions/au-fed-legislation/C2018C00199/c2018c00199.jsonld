    {
      "@id": "concept:c2018c00199-sch-2-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Subsection 15YL(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.17",
      "values:originalText": "Repeal the subsection, substitute:\nPersons to whom these alternative arrangements apply\n\n(3) This subsection applies to the following persons:\n\n(a) for a child proceeding—a child witness;\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness for whom\nan order under subsection 15YAB(3) is in force for this\nsection;\nunless that person is at least 16 and chooses not to give evidence\nunder the arrangements.",
      "skos:definition": "Repeal the subsection, substitute:\nPersons to whom these alternative arrangements apply\n\n(3) This subsection applies to the following persons:\n\n(a) for a child proceeding—a child witness;\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness for whom\nan order under subsection 15YAB(3) is in force for this\nsection;\nunless that person is at least 16 and chooses not to give evidence\nunder the arrangements.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-2-sec-49-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-2-sec-49-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "94786cfc5c3f1b0149d054bd6ae978cbb305dd7910e3c5a0e3fb0293ac8fa5a6",
      "skos:note": "This subsection applies to specific persons under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Subsection 15YL(3)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Repeal the subsection, substitute:\nPersons to whom these alternative arrangements apply\n\n(3) This subsection applies to the following persons:\n\n(a) for a child proceeding—a child witness;\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness for whom\nan order under subsection 15YAB(3) is in force for this\nsection;\nunless that person is at least 16 and chooses not to give evidence\nunder the arrangements."
    },
