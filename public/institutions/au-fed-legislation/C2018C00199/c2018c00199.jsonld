    {
      "@id": "concept:c2018c00199-sch-2-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 At the end of section 15YH",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-34"
      },
      "cml:curationStatus": {
