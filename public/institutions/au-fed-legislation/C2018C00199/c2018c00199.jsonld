    {
      "@id": "concept:c2018c00199-sch-2-sec-15yp",
      "@type": "cml:Concept",
      "skos:prefLabel": "15YP Excluding people from the courtroom",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-15yp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.22",
      "values:originalText": "The court may order that some or all of the members of the public\nbe excluded from the courtroom in which any of the following\npersons is giving evidence in a proceeding:\n\n(a) for a child proceeding—a child witness;\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness for whom\nan order under subsection 15YAB(3) is in force for this\nsection.",
      "skos:definition": "The court may order that some or all of the members of the public\nbe excluded from the courtroom in which any of the following\npersons is giving evidence in a proceeding:\n\n(a) for a child proceeding—a child witness;\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness for whom\nan order under subsection 15YAB(3) is in force for this\nsection.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-2-sec-15yp-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-2-sec-15yp-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "879d2a6cf45ea17f5ad82e15dcdf8d931ab831e8b8bf0889b86b653759c1645a",
      "skos:note": "Excluding people from the courtroom"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-15yp",
      "@type": "cof:Section",
      "cof:title": "15YP Excluding people from the courtroom",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "The court may order that some or all of the members of the public\nbe excluded from the courtroom in which any of the following\npersons is giving evidence in a proceeding:\n\n(a) for a child proceeding—a child witness;\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness for whom\nan order under subsection 15YAB(3) is in force for this\nsection."
    },
