    {
      "@id": "concept:c2018c00199-sch-5-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 4(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-5-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
