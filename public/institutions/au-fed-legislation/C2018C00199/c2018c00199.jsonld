      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-3-sec-4-ss-2-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-3-sec-4-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c022fc55c9cd74ee50219799007999bb629978e51b541394f504fdf83104fbae",
      "skos:note": "Court must consider time spent in immigration detention during the period of offence and sentencing."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-4-ss-2",
      "@type": "cof:Section",
      "cof:title": "4(2) At the end of Subdivision A of Division 12 of Part 2",
      "values:kind": "subsection",
      "cof:pageNumber": 32,
      "values:originalText": "(2) The court must take into account any period that the person has\nspent in immigration detention during the period:\n\n(a) starting when the offence was committed; and\n\n(b) ending when the person is sentenced for the offence.\nNote:\nThis enables the court to take into account time spent while not in\npunitive detention."
    },
