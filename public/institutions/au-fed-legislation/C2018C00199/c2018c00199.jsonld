      },
      "dc:source": "c2018c00199.pdf, p.6",
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "skos:definition": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-6-sec-29-4-norm"
        }
      ],
      "cml:integrityHash": "59eba1666204418f83d446df3c428951055e5c4363adcd4a9c7ba5521bc93010",
      "skos:note": "Note on table limitations"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-29-4",
      "@type": "cof:Section",
      "cof:title": "29 June 2013",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act."
