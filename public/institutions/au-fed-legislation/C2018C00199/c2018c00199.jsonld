    {
      "@id": "concept:c2018c00199-sch-4-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 At the end of subsection 75Q(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.40",
      "values:originalText": "Add:\nNote:\nAn example of a reviewable decision relating to 2 persons is a\ndecision refusing to register a person as a remittance affiliate of a\n\nAnti-Money Laundering and Counter-Terrorism Financing amendments  Schedule 4\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\nregistered remittance network provider, if the provider applied under\nsubsection 75B(2) for that person to be so registered.",
      "skos:definition": "Add:\nNote:\nAn example of a reviewable decision relating to 2 persons is a\ndecision refusing to register a person as a remittance affiliate of a\n\nAnti-Money Laundering and Counter-Terrorism Financing amendments  Schedule 4\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\nregistered remittance network provider, if the provider applied under\nsubsection 75B(2) for that person to be so registered.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-4-sec-15-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-4-sec-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "048b2fdda4f9cd0044251be902119d1915d140bf04fa322e72676dcaf13f7426",
      "skos:note": "Registering a person as a remittance network provider is obligatory if they applied under subsection 75B(2) for that person to be so registered."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 At the end of subsection 75Q(1)",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "Add:\nNote:\nAn example of a reviewable decision relating to 2 persons is a\ndecision refusing to register a person as a remittance affiliate of a\n\nAnti-Money Laundering and Counter-Terrorism Financing amendments  Schedule 4\nMain amendments  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\nregistered remittance network provider, if the provider applied under\nsubsection 75B(2) for that person to be so registered."
    },
    {
