    {
      "@id": "concept:c2018c00199-sch-4-sec-233g",
      "@type": "cml:Concept",
      "skos:prefLabel": "233G Failure to comply does not affect validity",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-233g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.47",
      "values:originalText": "A failure to comply with subsection 233C(1) or 233E(4) (about\ngiving notice) in relation to a decision does not affect the validity\nof the decision.",
      "skos:definition": "A failure to comply with subsection 233C(1) or 233E(4) (about\ngiving notice) in relation to a decision does not affect the validity\nof the decision.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-4-sec-233g-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-4-sec-233g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "db862fcad0fa0ccd06a8d3766414e747e7828ca41d4c7a33fa3767d8a4f73687",
      "skos:note": "Failure to provide notice does not affect decision validity",
      "dc:description": "Notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-233g",
      "@type": "cof:Section",
      "cof:title": "233G Failure to comply does not affect validity",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "A failure to comply with subsection 233C(1) or 233E(4) (about\ngiving notice) in relation to a decision does not affect the validity\nof the decision."
    },
