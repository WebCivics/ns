    },
    {
      "@id": "concept:c2018c00199-sch-3-sec-236e",
      "@type": "cml:Concept",
      "skos:prefLabel": "236E Evidentiary certificates in proceedings for offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-236e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.33",
      "values:originalText": "Who may issue a certificate\n\n(1) A written certificate may be issued under this subsection by:\n\n(a) an officer who participates in the boarding of a ship or\naircraft (the target ship or aircraft) under Division 12A; or\n\n(b) if a ship (the target ship) is boarded under Division 12A—\nthe commander of the Commonwealth ship or\nCommonwealth aircraft whose crew members participated in\nthe boarding; or\n\nSchedule 3  Deterring people smuggling",
      "skos:definition": "Who may issue a certificate\n\n(1) A written certificate may be issued under this subsection by:\n\n(a) an officer who participates in the boarding of a ship or\naircraft (the target ship or aircraft) under Division 12A; or\n\n(b) if a ship (the target ship) is boarded under Division 12A—\nthe commander of the Commonwealth ship or\nCommonwealth aircraft whose crew members participated in\nthe boarding; or\n\nSchedule 3  Deterring people smuggling",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-3-sec-236e-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-3-sec-236e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6a6fded7097a63f7c37aba7b43e5276ad94973688b9856eb8ecc9f076254fcf3",
      "skos:note": "Who may issue a certificate"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-236e",
      "@type": "cof:Section",
      "cof:title": "236E Evidentiary certificates in proceedings for offences",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "Who may issue a certificate\n\n(1) A written certificate may be issued under this subsection by:\n\n(a) an officer who participates in the boarding of a ship or\naircraft (the target ship or aircraft) under Division 12A; or\n\n(b) if a ship (the target ship) is boarded under Division 12A—\nthe commander of the Commonwealth ship or\nCommonwealth aircraft whose crew members participated in\nthe boarding; or\n\nSchedule 3  Deterring people smuggling"
    },
    {
