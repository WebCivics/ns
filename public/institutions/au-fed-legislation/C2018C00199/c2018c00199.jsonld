    {
      "@id": "concept:c2018c00199-sch-4-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Paragraph 130(3)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-20"
      },
      "cml:curationStatus": {
