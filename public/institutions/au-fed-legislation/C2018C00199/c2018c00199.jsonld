      "@type": "cml:Concept",
      "skos:prefLabel": "21 Subsection 15YE(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-21"
      },
      "cml:curationStatus": {
