      "dc:source": "c2018c00199.pdf, p.12",
      "values:originalText": "(2) However, the adult is not a vulnerable adult complainant if the\nadult informs the court that he or she does not wish to be treated as\nsuch a complainant.",
      "skos:definition": "(2) However, the adult is not a vulnerable adult complainant if the\nadult informs the court that he or she does not wish to be treated as\nsuch a complainant.",
      "values:partOf": {
        "@id": "concept:c2018c00199-sch-2-sec-19"
      },
      "cml:asserts": [
