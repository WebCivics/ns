    {
      "@id": "concept:c2018c00199-sch-3-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Subsection 236E(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.38",
      "values:originalText": "Repeal the subsection, substitute:\nDefinitions\n\n(6) In this section:\nauthorisation has the same meaning as in the Maritime Powers Act\n2013.\nauthorising officer has the same meaning as in the Maritime\nPowers Act 2013.\nCommonwealth aircraft has the same meaning as in the Maritime\nPowers Act 2013.\nCommonwealth ship has the same meaning as in the Maritime\nPowers Act 2013.\nmaritime powers has the same meaning as in the Maritime Powers\nAct 2013.",
      "skos:definition": "Repeal the subsection, substitute:\nDefinitions\n\n(6) In this section:\nauthorisation has the same meaning as in the Maritime Powers Act\n2013.\nauthorising officer has the same meaning as in the Maritime\nPowers Act 2013.\nCommonwealth aircraft has the same meaning as in the Maritime\nPowers Act 2013.\nCommonwealth ship has the same meaning as in the Maritime\nPowers Act 2013.\nmaritime powers has the same meaning as in the Maritime Powers\nAct 2013.",
      "cml:asserts": [
