      ],
      "cml:integrityHash": "84bdce218527a2832b6f2194a22edfbdca5451488e896c531f59f870f28d4f4c",
      "skos:note": "Application for review of AUSTRAC CEO decisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-233f",
      "@type": "cof:Section",
      "cof:title": "233F Review by the Administrative Appeals Tribunal",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "An application may be made to the Administrative Appeals\nTribunal for review of:\n\n(a) a decision of the AUSTRAC CEO under subsection 233E(2);\nor\n\n(b) a reviewable decision made by the AUSTRAC CEO\npersonally."
