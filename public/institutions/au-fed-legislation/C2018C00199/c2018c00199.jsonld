    },
    {
      "@id": "concept:c2018c00199-sch-3-sec-236d",
      "@type": "cml:Concept",
      "skos:prefLabel": "236D Burden and standard of proof in relation to age",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-236d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.33",
      "values:originalText": "If, in proceedings relating to an offence against this Subdivision:\n\n(a) the defendant claims to have been aged under 18 at the time\nthe offence was alleged to have been, or was, committed, and\n\n(b) the prosecution disputes this claim;\nthe prosecution bears the burden of proving, on the balance of\nprobabilities, that the defendant was aged 18 or over at that time.",
      "skos:definition": "If, in proceedings relating to an offence against this Subdivision:\n\n(a) the defendant claims to have been aged under 18 at the time\nthe offence was alleged to have been, or was, committed, and\n\n(b) the prosecution disputes this claim;\nthe prosecution bears the burden of proving, on the balance of\nprobabilities, that the defendant was aged 18 or over at that time.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-3-sec-236d-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-3-sec-236d-logic-deontic-1"
        },
        {
          "@id": "concept:c2018c00199-sch-3-sec-236d-logic-epistemic-2"
        },
        {
          "@id": "concept:c2018c00199-sch-3-sec-236d-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "9a8cdf37482825e87464636a6635011a643935a617ea072fa7822ea363ea492f",
      "skos:note": "Prosecution bears burden of proving defendant's age at time of alleged offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-3-sec-236d",
      "@type": "cof:Section",
      "cof:title": "236D Burden and standard of proof in relation to age",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "If, in proceedings relating to an offence against this Subdivision:\n\n(a) the defendant claims to have been aged under 18 at the time\nthe offence was alleged to have been, or was, committed, and\n\n(b) the prosecution disputes this claim;\nthe prosecution bears the burden of proving, on the balance of\nprobabilities, that the defendant was aged 18 or over at that time."
    },
    {
      "@id": "concept:c2018c00199-sch-3-sec-236d-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2018c00199-sch-3-sec-236d"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2018c00199-sch-3-sec-236d-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Prosecution bears obligation to prove defendant's age.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2018c00199-sch-3-sec-236d-logic-epistemic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "Probability",
      "cml:logicSummary": "Prosecution must provide evidence on balance of probabilities.",
      "cml:executionSurface": "modalities::epistemic",
