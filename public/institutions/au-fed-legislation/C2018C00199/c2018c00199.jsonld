      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.6",
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAssisting the Australian Commission for Law Enforcement Integrity  Schedule 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18",
      "skos:definition": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAssisting the Australian Commission for Law Enforcement Integrity  Schedule 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-6-sec-3-2-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-6-sec-3-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "6c58caa90c0d3615d8ba1bec6fbbc26135fa32adf728503be3b7fe95d2a137c1",
      "skos:note": "Schedules amendment and repeal rules"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedule(s)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Each Act that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAssisting the Australian Commission for Law Enforcement Integrity  Schedule 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18"
    },
