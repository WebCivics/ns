    {
      "@id": "concept:c2018c00199-sch-6-sec-2-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Transitional—preserving existing arrangements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-2-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.56",
      "values:originalText": "(1)\nThis item applies to arrangements if:\n\n(a) the arrangements were entered into under subsection 8(1C) of\nthe Australian Federal Police Act 1979; and\n\n(b) the arrangements were in force immediately before the\ncommencement of this item.\n(2)\nThe arrangements have effect, after the commencement of this item, as\nif they had been entered into under that subsection as substituted by this\nSchedule.",
      "skos:definition": "(1)\nThis item applies to arrangements if:\n\n(a) the arrangements were entered into under subsection 8(1C) of\nthe Australian Federal Police Act 1979; and\n\n(b) the arrangements were in force immediately before the\ncommencement of this item.\n(2)\nThe arrangements have effect, after the commencement of this item, as\nif they had been entered into under that subsection as substituted by this\nSchedule.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-6-sec-2-3-norm"
        }
      ],
      "cml:integrityHash": "8a50f00974250bf6333a84cb0fa78b0fa737068a169b07fad0c6f93adb376480",
      "skos:note": "Preserving existing arrangements under subsection 8(1C) of the Australian Federal Police Act 1979."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-2-3",
      "@type": "cof:Section",
      "cof:title": "2 Transitional—preserving existing arrangements",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "(1)\nThis item applies to arrangements if:\n\n(a) the arrangements were entered into under subsection 8(1C) of\nthe Australian Federal Police Act 1979; and\n\n(b) the arrangements were in force immediately before the\ncommencement of this item.\n(2)\nThe arrangements have effect, after the commencement of this item, as\nif they had been entered into under that subsection as substituted by this\nSchedule."
    },
