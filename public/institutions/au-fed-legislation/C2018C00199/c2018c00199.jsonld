        },
        {
          "@id": "concept:c2018c00199-sch-6-sec-1-3-ss-1c-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "18f8e91cfa6feac81eae0a63060a4d38ac9922a54d54100e50eb80d17b50f426",
      "skos:note": "Permits entry into arrangements for provision of police and regulatory services"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-6-sec-1-3-ss-1c",
      "@type": "cof:Section",
      "cof:title": "1(1C) Subsection 8(1C)",
      "values:kind": "subsection",
      "cof:pageNumber": 56,
      "values:originalText": "(1C) The Minister and the following person:\n\n(a) for Norfolk Island—the Administrator of Norfolk Island;\n\n(b) for any other external Territory:\n\n(i) the Minister administering the Department that deals\nwith the administration of the Territory; or\n\n(ii) the Territory’s Administrator (if any);\nmay enter into arrangements for the provision of police services\nand regulatory services for that Territory."
    },
