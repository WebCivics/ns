    {
      "@id": "concept:c2018c00199-sch-2-sec-11-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "apply",
      "cml:logicSummary": "Applying special witnesses is an obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) Similarly, subsection 15YAB(1) (about special witnesses) also applies to any proceedings connected with a proceeding for a Commonwealth offence.",
      "cml:conclusionText": "The state must apply special witnesses in Commonwealth offences"
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-11-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Special witnesses apply during Commonwealth offences",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) Similarly, subsection 15YAB(1) (about special witnesses) also applies to any proceedings connected with a proceeding for a Commonwealth offence.",
      "cml:conclusionText": "The application of special witnesses occurs during the duration of Commonwealth offences"
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-11-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
