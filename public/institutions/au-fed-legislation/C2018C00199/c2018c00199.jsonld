    {
      "@id": "concept:c2018c00199-sch-5-sec-827-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "827 S/RES/827 (1993); and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-5-sec-827-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.53",
      "values:originalText": "(ii) annexed to the United Nations Secretary-General’s\nreport S/25704 (1993) given pursuant to paragraph 2 of\n\nSchedule 5  Assisting the International Residual Mechanism for Criminal Tribunals\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\n\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\nUnited Nations Security Council Resolution 808\nS/RES/808 (1993); and\n\n(b) for the Rwanda Tribunal—the Statute of the Tribunal\nannexed to (and adopted by) United Nations Security Council\nResolution 955 S/RES/955 (1994); and\n\n(c) for the International Residual Mechanism for Criminal\nTribunals—the Statute of the Mechanism in Annex 1 to (and\nadopted by) United Nations Security Council Resolution",
      "skos:definition": "(ii) annexed to the United Nations Secretary-General’s\nreport S/25704 (1993) given pursuant to paragraph 2 of\n\nSchedule 5  Assisting the International Residual Mechanism for Criminal Tribunals\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\n\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\nUnited Nations Security Council Resolution 808\nS/RES/808 (1993); and\n\n(b) for the Rwanda Tribunal—the Statute of the Tribunal\nannexed to (and adopted by) United Nations Security Council\nResolution 955 S/RES/955 (1994); and\n\n(c) for the International Residual Mechanism for Criminal\nTribunals—the Statute of the Mechanism in Annex 1 to (and\nadopted by) United Nations Security Council Resolution",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-5-sec-827-2-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-5-sec-827-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "ec0e669065c2fe2f0d15f8a86b776541b46403adbdf9e4c900d43981ef9c953b",
      "skos:note": "Annexed documents for the Rwanda Tribunal and International Residual Mechanism for Criminal Tribunals"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-5-sec-827-2",
      "@type": "cof:Section",
      "cof:title": "827 S/RES/827 (1993); and",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "(ii) annexed to the United Nations Secretary-General’s\nreport S/25704 (1993) given pursuant to paragraph 2 of\n\nSchedule 5  Assisting the International Residual Mechanism for Criminal Tribunals\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\n\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\nUnited Nations Security Council Resolution 808\nS/RES/808 (1993); and\n\n(b) for the Rwanda Tribunal—the Statute of the Tribunal\nannexed to (and adopted by) United Nations Security Council\nResolution 955 S/RES/955 (1994); and\n\n(c) for the International Residual Mechanism for Criminal\nTribunals—the Statute of the Mechanism in Annex 1 to (and\nadopted by) United Nations Security Council Resolution"
    },
