      "dc:source": "c2018c00199.pdf, p.42",
      "values:originalText": "Insert:\n\n(3AA) The undertaking is that the recipient and its officials (if any) will\ncomply with the Information Privacy Principles set out in\nsection 14 of the Privacy Act 1988 in respect of AUSTRAC\ninformation obtained under paragraph (3)(a).",
      "skos:definition": "Insert:\n\n(3AA) The undertaking is that the recipient and its officials (if any) will\ncomply with the Information Privacy Principles set out in\nsection 14 of the Privacy Act 1988 in respect of AUSTRAC\ninformation obtained under paragraph (3)(a).",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-4-sec-21-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-4-sec-21-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f51d39511e2a4f119d95b9350ea3942f7096e1e08697b4593b4abe83145e213a",
      "skos:note": "Recipient and officials must comply with Information Privacy Principles."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-21",
      "@type": "cof:Section",
      "cof:title": "21 After subsection 130(3)",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "Insert:\n\n(3AA) The undertaking is that the recipient and its officials (if any) will\ncomply with the Information Privacy Principles set out in\nsection 14 of the Privacy Act 1988 in respect of AUSTRAC\ninformation obtained under paragraph (3)(a)."
    },
