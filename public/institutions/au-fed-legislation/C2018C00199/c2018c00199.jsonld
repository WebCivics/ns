        },
        {
          "@id": "concept:c2018c00199-sch-2-sec-279-4-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "584e04295ede77bad59114f8e7c79c14ce71a089552bd67d75b5502cf0ec71da",
      "skos:note": "A person who gives evidence under a direction must give it at the courtroom or other place in Australia where the court is sitting."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-279-4",
