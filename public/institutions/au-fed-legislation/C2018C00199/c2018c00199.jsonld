      "@id": "concept:c2018c00199-sch-4-sec-33-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "!",
      "cml:logicSummary": "Repeals and amendments do not affect old law",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2018c00199-sch-4-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Subsection 130(3AA)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-34"
      },
      "cml:curationStatus": {
