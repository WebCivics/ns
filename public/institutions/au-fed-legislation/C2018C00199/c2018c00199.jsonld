    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-11-ss-5",
      "@type": "cof:Section",
      "cof:title": "11(5) Subsection 15Y(2)",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(5) Similarly, subsection 15YAB(1) (about special witnesses) also\napplies to any proceedings connected with a proceeding for a\nCommonwealth offence."
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-11-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
