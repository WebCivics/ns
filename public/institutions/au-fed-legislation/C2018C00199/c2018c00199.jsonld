    {
      "@id": "concept:c2018c00199-sch-1-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-1-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.7",
      "values:originalText": "The amendments made by items 1 and 2 apply in relation to corruption\nissues, whether the related corrupt conduct (within the meaning of the\nLaw Enforcement Integrity Commissioner Act 2006):\n\n(a) was or may have been engaged in before the commencement\nof those items; or\n\n(b) will or may be engaged in after that commencement.\nLaw Enforcement Integrity Commissioner Act 2006",
      "skos:definition": "The amendments made by items 1 and 2 apply in relation to corruption\nissues, whether the related corrupt conduct (within the meaning of the\nLaw Enforcement Integrity Commissioner Act 2006):\n\n(a) was or may have been engaged in before the commencement\nof those items; or\n\n(b) will or may be engaged in after that commencement.\nLaw Enforcement Integrity Commissioner Act 2006",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-1-sec-3-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-1-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:c2018c00199-sch-1-sec-3-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2018c00199-sch-1-sec-3-logic-ltl-3"
        },
        {
          "@id": "concept:c2018c00199-sch-1-sec-3-logic-diffusion-4"
        },
        {
          "@id": "concept:c2018c00199-sch-1-sec-3-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "0a896482ce6e7215dc87eaed615c712a1a61711a4d42d5f0f2d4b07cc133fd87",
      "skos:note": "Amendments apply to corruption issues before or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-1-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "The amendments made by items 1 and 2 apply in relation to corruption\nissues, whether the related corrupt conduct (within the meaning of the\nLaw Enforcement Integrity Commissioner Act 2006):\n\n(a) was or may have been engaged in before the commencement\nof those items; or\n\n(b) will or may be engaged in after that commencement.\nLaw Enforcement Integrity Commissioner Act 2006"
    },
    {
      "@id": "concept:c2018c00199-sch-1-sec-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
