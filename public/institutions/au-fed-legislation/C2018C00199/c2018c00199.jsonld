    {
      "@id": "concept:c2018c00199-sch-2-sec-279-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "279 5  Administration of oaths and affirmations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-279-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.26",
      "values:originalText": "An oath or affirmation to be sworn or made by a witness who is to\ngive evidence under a direction may be administered either:\n\nSupporting victims and witnesses in criminal proceedings  Schedule 2\nVulnerable witness protections  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(a) by means of the video link, in as nearly as practicable the\nsame way as if the witness were to give the evidence at the\ncourtroom or other place in Australia where the court is\nsitting; or\n\n(b) as follows:\n\n(i) on behalf of the court and as directed by it;\n\n(ii) by a person (whether an Australian official or not)\nauthorised by the court;\n\n(iii) at the place where the witness is to give the evidence.",
      "skos:definition": "An oath or affirmation to be sworn or made by a witness who is to\ngive evidence under a direction may be administered either:\n\nSupporting victims and witnesses in criminal proceedings  Schedule 2\nVulnerable witness protections  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(a) by means of the video link, in as nearly as practicable the\nsame way as if the witness were to give the evidence at the\ncourtroom or other place in Australia where the court is\nsitting; or\n\n(b) as follows:\n\n(i) on behalf of the court and as directed by it;\n\n(ii) by a person (whether an Australian official or not)\nauthorised by the court;\n\n(iii) at the place where the witness is to give the evidence.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-2-sec-279-5-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-2-sec-279-5-logic-deontic-1"
        },
        {
          "@id": "concept:c2018c00199-sch-2-sec-279-5-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "f4d1d755831f96b1c8b748121afbd12bd02210d1f5f30ed83059fe071cb11be5",
      "skos:note": "An oath or affirmation may be administered by the court."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-279-5",
      "@type": "cof:Section",
      "cof:title": "279 5  Administration of oaths and affirmations",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "An oath or affirmation to be sworn or made by a witness who is to\ngive evidence under a direction may be administered either:\n\nSupporting victims and witnesses in criminal proceedings  Schedule 2\nVulnerable witness protections  Part 1\n\nCrimes Legislation Amendment (Law Enforcement Integrity, Vulnerable Witness\nProtection and Other Measures) Act 2013\nCompilation date: 23/5/18\nRegistered: 30/5/18\n\n(a) by means of the video link, in as nearly as practicable the\nsame way as if the witness were to give the evidence at the\ncourtroom or other place in Australia where the court is\nsitting; or\n\n(b) as follows:\n\n(i) on behalf of the court and as directed by it;\n\n(ii) by a person (whether an Australian official or not)\nauthorised by the court;\n\n(iii) at the place where the witness is to give the evidence."
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-279-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2018c00199-sch-2-sec-279-5"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-279-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The state is obligated to administer an oath or affirmation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
