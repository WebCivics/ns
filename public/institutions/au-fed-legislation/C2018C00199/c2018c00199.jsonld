      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.41",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) the disclosure:\n\n(i) is for the purposes of, or in connection with, the\nperformance of the official’s duties in connection with\nthe investigation or proposed investigation concerned;\nand\n\n(ii) is to a person who has given a written undertaking as set\nout in subsection (3AA) to the entrusted\nCommonwealth agency official about the information;\n\nSchedule 4  Anti-Money Laundering and Counter-Terrorism Financing amendments",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) the disclosure:\n\n(i) is for the purposes of, or in connection with, the\nperformance of the official’s duties in connection with\nthe investigation or proposed investigation concerned;\nand\n\n(ii) is to a person who has given a written undertaking as set\nout in subsection (3AA) to the entrusted\nCommonwealth agency official about the information;\n\nSchedule 4  Anti-Money Laundering and Counter-Terrorism Financing amendments",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-4-sec-20-norm"
        },
        {
          "@id": "concept:c2018c00199-sch-4-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ec20fef62a7daf9821fc5f0dd84c46a492c3c7900658e4a9f318c33022817f26",
      "skos:note": "Disclosure is for purposes of official duties in connection with investigation or proposed investigation."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Paragraph 130(3)(a)",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) the disclosure:\n\n(i) is for the purposes of, or in connection with, the\nperformance of the official’s duties in connection with\nthe investigation or proposed investigation concerned;\nand\n\n(ii) is to a person who has given a written undertaking as set\nout in subsection (3AA) to the entrusted\nCommonwealth agency official about the information;\n\nSchedule 4  Anti-Money Laundering and Counter-Terrorism Financing amendments"
    },
