    {
      "@id": "concept:c2018c00199-sch-4-sec-233e-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "233E(4) Reconsideration of reviewable decisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2018c00199#sch-4-sec-233e-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
