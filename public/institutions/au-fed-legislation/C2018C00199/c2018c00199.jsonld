      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2018c00199.pdf"
      },
      "dc:source": "c2018c00199.pdf, p.12",
      "values:originalText": "Insert:\nspecial witness has the meaning given by subsection 15YAB(1).\nspecial witness proceeding means a proceeding to which\nsubsection 15Y(3) applies.\nvulnerable adult complainant has the meaning given by\nsection 15YAA.\nvulnerable adult proceeding means a proceeding to which\nsubsection 15Y(2) applies.",
      "skos:definition": "Insert:\nspecial witness has the meaning given by subsection 15YAB(1).\nspecial witness proceeding means a proceeding to which\nsubsection 15Y(3) applies.\nvulnerable adult complainant has the meaning given by\nsection 15YAA.\nvulnerable adult proceeding means a proceeding to which\nsubsection 15Y(2) applies.",
      "cml:asserts": [
        {
          "@id": "concept:c2018c00199-sch-2-sec-18-norm"
        }
      ],
      "cml:integrityHash": "576b070f1190d4340948a5aba79f7399b5a2878a0145cad00652afa293e284be",
      "skos:note": "Definitions for special witness, vulnerable adult complainant, and vulnerable adult proceeding."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2018c00199#sch-2-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Section 15YA",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Insert:\nspecial witness has the meaning given by subsection 15YAB(1).\nspecial witness proceeding means a proceeding to which\nsubsection 15Y(3) applies.\nvulnerable adult complainant has the meaning given by\nsection 15YAA.\nvulnerable adult proceeding means a proceeding to which\nsubsection 15Y(2) applies."
    },
    {
      "@id": "concept:c2018c00199-sch-2-sec-18-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
