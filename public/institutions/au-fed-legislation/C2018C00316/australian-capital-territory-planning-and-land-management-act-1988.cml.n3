concept:australian-capital-territory-planning-and-land-management-act-1988-sec-11 a cml:Concept ;
    skos:prefLabel "11 Effect of Plan"@en ;
    cml:realizedBy doc:sec-11 ;
    values:originalText "(1) An enactment that is inconsistent with the Plan has no effect to the extent of the inconsistency, but an enactment shall be taken to be consistent with the Plan to the extent that it is capable of operating concurrently with the Plan.  (2) The Commonwealth, a Commonwealth authority, the Territory or a Territory authority shall not do any act that is inconsistent with the Plan." ;
    skos:definition "(1) An enactment that is inconsistent with the Plan has no effect to the extent of the inconsistency, but an enactment shall be taken to be consistent with the Plan to the extent that it is capable of operating concurrently with the Plan.  (2) The Commonwealth, a Commonwealth authority, the Territory or a Territory authority shall not do any act that is inconsistent with the Plan."@en ;
    cml:integrityHash "8ad134065ce6c7d6e9487506524fd85897e2d5ac1f24e78ed9d6485e875fd643" ;
    cof:pageNumber "15"^^xsd:integer ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-11-ss-1 ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-11-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.15" .
