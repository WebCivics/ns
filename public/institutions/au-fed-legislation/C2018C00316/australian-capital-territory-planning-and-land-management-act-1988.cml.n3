concept:australian-capital-territory-planning-and-land-management-act-1988-sec-71 a cml:Concept ;
    skos:prefLabel "71 Action on referral by Minister"@en ;
    cml:realizedBy doc:sec-71 ;
    values:originalText "If the Minister refers the draft variation to the Authority, the Authority shall:  (a) reconsider the draft variation;  (b) have any further consultations directed by the Minister and such other consultations as the Authority thinks necessary;  (c) consider any suggestions made by the Minister;  (d) if it thinks fit, alter the draft variation; and  (e) re-submit the draft variation to the Minister for approval; and subsection 70(1) and, if necessary, this section, apply again.   Transitional provisions  Part X Variation of NCDC policies by Authority  Division 4  Section 72  Australian Capital Territory (Planning and Land Management) Act 1988 Compilation date: 1/7/18 Registered: 6/8/18" ;
    skos:definition "If the Minister refers the draft variation to the Authority, the Authority shall:  (a) reconsider the draft variation;  (b) have any further consultations directed by the Minister and such other consultations as the Authority thinks necessary;  (c) consider any suggestions made by the Minister;  (d) if it thinks fit, alter the draft variation; and  (e) re-submit the draft variation to the Minister for approval; and subsection 70(1) and, if necessary, this section, apply again.   Transitional provisions  Part X Variation of NCDC policies by Authority  Division 4  Section 72  Australian Capital Territory (Planning and Land Management) Act 1988 Compilation date: 1/7/18 Registered: 6/8/18"@en ;
    cml:integrityHash "5904c69fcf1b6c082304b81d5c0db74b6a56efc2c164241dc9ee532df5884d4f" ;
    cof:pageNumber "44"^^xsd:integer ;
    skos:note "Authority's actions on referral by Minister" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.44" ;
    cml:asserts concept:australian-capital-territory-planning-and-land-management-act-1988-sec-71-norm .
