    cof:pageNumber "44"^^xsd:integer .

concept:australian-capital-territory-planning-and-land-management-act-1988-sec-72 a cml:Concept ;
    skos:prefLabel "72 Publication and commencement of approved variation"@en ;
    cml:realizedBy doc:sec-72 ;
    values:originalText "(1) Where the Minister approves the draft variation, the Minister shall publish notice of the approval in the Commonwealth Gazette and specify the address where copies of the variation may be inspected and bought.  (2) The variation takes effect on publication of the notice of approval." ;
    skos:definition "(1) Where the Minister approves the draft variation, the Minister shall publish notice of the approval in the Commonwealth Gazette and specify the address where copies of the variation may be inspected and bought.  (2) The variation takes effect on publication of the notice of approval."@en ;
