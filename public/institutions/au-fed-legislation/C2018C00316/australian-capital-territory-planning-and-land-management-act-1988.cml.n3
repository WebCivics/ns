concept:australian-capital-territory-planning-and-land-management-act-1988-sec-84 a cml:Concept ;
    skos:prefLabel "84 Court proceedings"@en ;
    cml:realizedBy doc:sec-84 ;
    values:originalText "Where:  (a) proceedings in a court by or against the NCDC were pending immediately before the repeal of the NCDC Act; and  (b) the proceedings concern a right or liability vested in the Commonwealth or another body, or both, under section 82 or 83; the proceedings may be continued, subject to the direction of the court, by or against the Commonwealth, that other body, or both, as the case requires." ;
    skos:definition "Where:  (a) proceedings in a court by or against the NCDC were pending immediately before the repeal of the NCDC Act; and  (b) the proceedings concern a right or liability vested in the Commonwealth or another body, or both, under section 82 or 83; the proceedings may be continued, subject to the direction of the court, by or against the Commonwealth, that other body, or both, as the case requires."@en ;
    cml:integrityHash "4699b0d503297cffa223f6c2502a5793e01457f3ac3e2392fdb5f0475c23613e" ;
    cof:pageNumber "51"^^xsd:integer ;
    skos:note "Proceedings may be continued by or against the Commonwealth, etc." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
