concept:australian-capital-territory-planning-and-land-management-act-1988-sec-28 a cml:Concept ;
    skos:prefLabel "28 Territory Land"@en ;
    cml:realizedBy doc:sec-28 ;
    values:originalText "At any time when any land in the Territory is not National Land, that land is Territory Land for the purposes of this Act." ;
    skos:definition "At any time when any land in the Territory is not National Land, that land is Territory Land for the purposes of this Act."@en ;
    cml:integrityHash "bd297f240c5c40e4e6176d0053a39949cb18cdbdec5a3ea02db08e160e3b4123" ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "Land in the Territory is considered Territory Land if not National Land." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
