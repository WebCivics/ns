doc:sec-83-ss-1 a cof:Section ;
    cof:title "83(1) Assets, rights and liabilities" ;
    values:kind "subsection" ;
    values:originalText "(1) Subject to section 82, assets, rights and liabilities of the NCDC existing immediately before the repeal of the NCDC Act vest in a body or bodies specified in writing by the Minister." ;
    cof:pageNumber "50"^^xsd:integer .

concept:australian-capital-territory-planning-and-land-management-act-1988-sec-83-ss-2 a cml:Concept ;
    skos:prefLabel "83(2) Assets, rights and liabilities"@en ;
    cml:realizedBy doc:sec-83-ss-2 ;
    values:originalText "(2) In specifying a body for the purposes of subsection (1), the Minister shall have regard to which body or bodies will perform the relevant functions of the NCDC after the repeal of the NCDC Act." ;
    skos:definition "(2) In specifying a body for the purposes of subsection (1), the Minister shall have regard to which body or bodies will perform the relevant functions of the NCDC after the repeal of the NCDC Act."@en ;
