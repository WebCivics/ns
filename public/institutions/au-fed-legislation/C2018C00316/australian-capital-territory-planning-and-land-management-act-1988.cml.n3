    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sec-47-ss-2 a cof:Section ;
    cof:title "47(2) Staff of Authority" ;
    values:kind "subsection" ;
    values:originalText "(2) For the purposes of the Public Service Act 1999:  (a) the Chief Executive and the APS employees assisting the Chief Executive together constitute a Statutory Agency; and  (b) the Chief Executive is the Head of that Statutory Agency." ;
    cof:pageNumber "33"^^xsd:integer .

