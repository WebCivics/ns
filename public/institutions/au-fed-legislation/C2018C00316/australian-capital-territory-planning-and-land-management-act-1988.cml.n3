doc:sec-76 a cof:Section ;
    cof:title "76 Executive’s powers" ;
    values:kind "section" ;
    values:originalText "After receipt of the draft variation submitted for approval, the Executive shall, after such consultation, if any, as the Executive thinks necessary:  (a) approve the draft variation without alteration; or  (b) refer the draft variation to the Territory planning authority with either or both of the following:  (i) directions to conduct further consultations;  (ii) suggested alterations." ;
    cof:pageNumber "47"^^xsd:integer .

concept:australian-capital-territory-planning-and-land-management-act-1988-sec-77 a cml:Concept ;
    skos:prefLabel "77 Action on referral by Executive"@en ;
    cml:realizedBy doc:sec-77 ;
    values:originalText "If the Executive refers the draft variation to the Territory planning authority, the authority shall:  (a) reconsider the draft variation;  (b) have any further consultations directed by the Executive and such other consultations as the authority thinks necessary;  (c) consider any suggestions made by the Executive;  (d) if it thinks fit, alter the draft variation; and  (e) re-submit the draft variation to the Executive for approval; and section 76 and, if necessary, this section, apply again." ;
    skos:definition "If the Executive refers the draft variation to the Territory planning authority, the authority shall:  (a) reconsider the draft variation;  (b) have any further consultations directed by the Executive and such other consultations as the authority thinks necessary;  (c) consider any suggestions made by the Executive;  (d) if it thinks fit, alter the draft variation; and  (e) re-submit the draft variation to the Executive for approval; and section 76 and, if necessary, this section, apply again."@en ;
    cml:integrityHash "53336ea4f882fc0ef29949b46665c9e3d4d3be4b764f0e9f4bb5cd4c66d1939e" ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Authority must reconsider and re-submit draft variation for approval." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
