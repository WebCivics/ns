concept:australian-capital-territory-planning-and-land-management-act-1988-sec-59 a cml:Concept ;
    skos:prefLabel "59 Procedures before establishment of Executive"@en ;
    cml:realizedBy doc:sec-59 ;
    values:originalText "(1) Until the establishment of the Executive on Self-Government Day:  (a) references in this Part to the Executive shall be read as references to the Minister;  (b) subsection 70(2) has no effect; and  (c) references in subsections 74(1) and 79(1) to the Territory Gazette shall be read as references to the Commonwealth Gazette.  (2) Section 78 does not apply to a draft variation submitted or re-submitted to the Minister under section 75 or 77 as affected by this section.  (3) Any steps taken under this Part by the Minister before Self-Government Day have effect on and after that Day as if they had been taken by the Executive." ;
    skos:definition "(1) Until the establishment of the Executive on Self-Government Day:  (a) references in this Part to the Executive shall be read as references to the Minister;  (b) subsection 70(2) has no effect; and  (c) references in subsections 74(1) and 79(1) to the Territory Gazette shall be read as references to the Commonwealth Gazette.  (2) Section 78 does not apply to a draft variation submitted or re-submitted to the Minister under section 75 or 77 as affected by this section.  (3) Any steps taken under this Part by the Minister before Self-Government Day have effect on and after that Day as if they had been taken by the Executive."@en ;
    cml:integrityHash "546e343d8aea78997717fbf013001c0b4d2493670ca40e859588d9f80644beab" ;
    cof:pageNumber "39"^^xsd:integer ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-59-ss-1 ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-59-ss-2 ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-59-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.39" .
