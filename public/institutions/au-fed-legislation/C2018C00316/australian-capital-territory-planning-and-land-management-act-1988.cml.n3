concept:australian-capital-territory-planning-and-land-management-act-1988-sec-65 a cml:Concept ;
    skos:prefLabel "65 Variation or revocation of NCDC policies during transition"@en ;
    cml:realizedBy doc:sec-65 ;
    values:originalText "period  (1) During the transition period, an NCDC policy still in effect may be:  (a) revoked wholly or partly by the National Capital Plan; or  (b) varied under Division 4 or 5." ;
    skos:definition "period  (1) During the transition period, an NCDC policy still in effect may be:  (a) revoked wholly or partly by the National Capital Plan; or  (b) varied under Division 4 or 5."@en ;
    cml:integrityHash "287a300648bf6b51425df1161857a9f03ae57dc8cf4a013eb309cf2f05f74167" ;
    cof:pageNumber "41"^^xsd:integer ;
