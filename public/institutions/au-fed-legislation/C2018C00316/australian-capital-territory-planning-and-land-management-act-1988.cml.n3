doc:sec-28 a cof:Section ;
    cof:title "28 Territory Land" ;
    values:kind "section" ;
    values:originalText "At any time when any land in the Territory is not National Land, that land is Territory Land for the purposes of this Act." ;
    cof:pageNumber "23"^^xsd:integer .

concept:australian-capital-territory-planning-and-land-management-act-1988-sec-29 a cml:Concept ;
    skos:prefLabel "29 Administration of Territory Land and the taking of water on"@en ;
    cml:realizedBy doc:sec-29 ;
    values:originalText "National Land  (1) The Executive, on behalf of the Commonwealth:  (a) has responsibility for the management of Territory Land; and  (b) subject to section 9 of the Seat of Government (Administration) Act 1910, may grant, dispose of, acquire, hold and administer estates in Territory Land; and  (c) has responsibility for:  (i) the management of the taking of water on National Land; and  (ii) the regulation of the taking of water on National Land." ;
    skos:definition "National Land  (1) The Executive, on behalf of the Commonwealth:  (a) has responsibility for the management of Territory Land; and  (b) subject to section 9 of the Seat of Government (Administration) Act 1910, may grant, dispose of, acquire, hold and administer estates in Territory Land; and  (c) has responsibility for:  (i) the management of the taking of water on National Land; and  (ii) the regulation of the taking of water on National Land."@en ;
    cml:integrityHash "f3ba645730299e3c6cec8c0dcd7b216f917bf52dbcd69209992099c803aeac4c" ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "The Executive has responsibility for managing Territory Land and regulating water taking." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.23" ;
    cml:asserts concept:australian-capital-territory-planning-and-land-management-act-1988-sec-29-norm .
