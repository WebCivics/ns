concept:australian-capital-territory-planning-and-land-management-act-1988-sec-39 a cml:Concept ;
    skos:prefLabel "39 Outside employment"@en ;
    cml:realizedBy doc:sec-39 ;
    values:originalText "(1) A full-time member shall not engage in paid employment outside his or her duties except with the approval of the Minister.  (2) If a part-time member engages in paid employment that, in the opinion of the Minister, conflicts with the proper performance of his or her duties, the Minister may, in writing, direct the member to cease that employment." ;
    skos:definition "(1) A full-time member shall not engage in paid employment outside his or her duties except with the approval of the Minister.  (2) If a part-time member engages in paid employment that, in the opinion of the Minister, conflicts with the proper performance of his or her duties, the Minister may, in writing, direct the member to cease that employment."@en ;
    cml:integrityHash "0d59f5aba362f5964310eb5485e4fedf14f390af3f6a1ade855245e0b729c305" ;
    cof:pageNumber "29"^^xsd:integer ;
