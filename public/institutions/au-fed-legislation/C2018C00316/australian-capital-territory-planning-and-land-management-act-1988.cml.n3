concept:australian-capital-territory-planning-and-land-management-act-1988-sec-13 a cml:Concept ;
    skos:prefLabel "13 Plan not to have retrospective effect"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "Where, immediately before the Plan comes into effect, it would be lawful to use any land in a particular way in the exercise of a right derived from an estate in that land, the Plan does not prevent the use of that land in that way during the term of that estate." ;
    skos:definition "Where, immediately before the Plan comes into effect, it would be lawful to use any land in a particular way in the exercise of a right derived from an estate in that land, the Plan does not prevent the use of that land in that way during the term of that estate."@en ;
    cml:integrityHash "2df66f402af377d3b71445c5016f13d48111e6df8103cd9a14d3c019fa89246d" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "No retrospective effect on land use rights" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.15" ;
    cml:asserts concept:australian-capital-territory-planning-and-land-management-act-1988-sec-13-norm .
