doc:sec-73-ss-1 a cof:Section ;
    cof:title "73(1) NCDC policies may be varied by Territory planning authority" ;
    values:kind "subsection" ;
    values:originalText "(1) At any time during the transition period, the Territory planning authority may vary an NCDC policy." ;
    cof:pageNumber "46"^^xsd:integer .

concept:australian-capital-territory-planning-and-land-management-act-1988-sec-73-ss-2 a cml:Concept ;
    skos:prefLabel "73(2) NCDC policies may be varied by Territory planning authority"@en ;
    cml:realizedBy doc:sec-73-ss-2 ;
    values:originalText "(2) A variation by the Territory planning authority:  (a) shall relate to one or more particular blocks or sections of land in the Territory; and  (b) shall be made in accordance with this Division." ;
