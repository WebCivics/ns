concept:australian-capital-territory-planning-and-land-management-act-1988-sec-38 a cml:Concept ;
    skos:prefLabel "38 Leave of absence"@en ;
    cml:realizedBy doc:sec-38 ;
    values:originalText "(1) A full-time member has such recreation leave entitlements as are determined by the Remuneration Tribunal.  (2) The Minister may:  (a) grant a full-time member leave of absence, other than recreation leave, on such terms and conditions as to remuneration or otherwise as the Minister determines in writing; and  (b) grant a part-time member leave to be absent from a meeting or meetings of the Authority." ;
    skos:definition "(1) A full-time member has such recreation leave entitlements as are determined by the Remuneration Tribunal.  (2) The Minister may:  (a) grant a full-time member leave of absence, other than recreation leave, on such terms and conditions as to remuneration or otherwise as the Minister determines in writing; and  (b) grant a part-time member leave to be absent from a meeting or meetings of the Authority."@en ;
    cml:integrityHash "643ca1470b618581f83bfbc06f8c8689907d2bd1d8a6635fe9b3371264d0562d" ;
    cof:pageNumber "29"^^xsd:integer ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-38-ss-1 ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-38-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.29" .
doc:sec-38 a cof:Section ;
    cof:title "38 Leave of absence" ;
    values:kind "section" ;
    values:originalText "(1) A full-time member has such recreation leave entitlements as are determined by the Remuneration Tribunal.  (2) The Minister may:  (a) grant a full-time member leave of absence, other than recreation leave, on such terms and conditions as to remuneration or otherwise as the Minister determines in writing; and  (b) grant a part-time member leave to be absent from a meeting or meetings of the Authority." ;
    cof:pageNumber "29"^^xsd:integer .

