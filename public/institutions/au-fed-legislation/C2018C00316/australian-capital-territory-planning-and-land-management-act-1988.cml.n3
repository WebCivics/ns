concept:australian-capital-territory-planning-and-land-management-act-1988-sec-61 a cml:Concept ;
    skos:prefLabel "61 Application of Canberra Water Supply (Googong Dam) Act"@en ;
    cml:realizedBy doc:sec-61 ;
    values:originalText "before establishment of Executive  (1) Until the establishment of the Executive on Self-Government Day:  (a) references in the Canberra Water Supply (Googong Dam) Act 1974 to the Executive shall be read as references to the Minister;  (b) references in that Act to the Territory shall be read as references to the Commonwealth or a Commonwealth authority; and  (c) section 6A of that Act has no effect.  (2) Any steps taken under that Act by the Minister before Self-Government Day have effect on and after that Day as if they had been taken by the Executive.   Transitional provisions  Part X Continuation of NCDC policies  Division 3  Section 62  Australian Capital Territory (Planning and Land Management) Act 1988 Compilation date: 1/7/18 Registered: 6/8/18" ;
    skos:definition "before establishment of Executive  (1) Until the establishment of the Executive on Self-Government Day:  (a) references in the Canberra Water Supply (Googong Dam) Act 1974 to the Executive shall be read as references to the Minister;  (b) references in that Act to the Territory shall be read as references to the Commonwealth or a Commonwealth authority; and  (c) section 6A of that Act has no effect.  (2) Any steps taken under that Act by the Minister before Self-Government Day have effect on and after that Day as if they had been taken by the Executive.   Transitional provisions  Part X Continuation of NCDC policies  Division 3  Section 62  Australian Capital Territory (Planning and Land Management) Act 1988 Compilation date: 1/7/18 Registered: 6/8/18"@en ;
    cml:integrityHash "847126da44db3a3764ed954ee19140f80564229dc59821575df3719c91524f6c" ;
    cof:pageNumber "40"^^xsd:integer ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-61-ss-1 ;
    cml:hasPart concept:australian-capital-territory-planning-and-land-management-act-1988-sec-61-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.40" .
