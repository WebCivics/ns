concept:australian-capital-territory-planning-and-land-management-act-1988-sec-24 a cml:Concept ;
    skos:prefLabel "24 Plan may be prepared in stages or parts"@en ;
    cml:realizedBy doc:sec-24 ;
    values:originalText "The Plan may be prepared in separate stages or parts and, in such a case, sections 14 to 23 (both inclusive) apply as if references in those sections to the Plan were references to such a stage or part of the Plan.   The Territory Plan  Part IV  Section 25  Australian Capital Territory (Planning and Land Management) Act 1988 Compilation date: 1/7/18 Registered: 6/8/18" ;
    skos:definition "The Plan may be prepared in separate stages or parts and, in such a case, sections 14 to 23 (both inclusive) apply as if references in those sections to the Plan were references to such a stage or part of the Plan.   The Territory Plan  Part IV  Section 25  Australian Capital Territory (Planning and Land Management) Act 1988 Compilation date: 1/7/18 Registered: 6/8/18"@en ;
    cml:integrityHash "970290d23ba7e7d4c78eeca04d00a32833d0803c65e22d54da7cb58463c581d3" ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "Plan may be prepared in stages or parts" ;
