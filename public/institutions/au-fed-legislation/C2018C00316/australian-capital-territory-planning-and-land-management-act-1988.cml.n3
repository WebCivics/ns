concept:australian-capital-territory-planning-and-land-management-act-1988-sec-76 a cml:Concept ;
    skos:prefLabel "76 Executive’s powers"@en ;
    cml:realizedBy doc:sec-76 ;
    values:originalText "After receipt of the draft variation submitted for approval, the Executive shall, after such consultation, if any, as the Executive thinks necessary:  (a) approve the draft variation without alteration; or  (b) refer the draft variation to the Territory planning authority with either or both of the following:  (i) directions to conduct further consultations;  (ii) suggested alterations." ;
    skos:definition "After receipt of the draft variation submitted for approval, the Executive shall, after such consultation, if any, as the Executive thinks necessary:  (a) approve the draft variation without alteration; or  (b) refer the draft variation to the Territory planning authority with either or both of the following:  (i) directions to conduct further consultations;  (ii) suggested alterations."@en ;
    cml:integrityHash "647d35fc518ade7a001593504c3b746f7cc8fac54ce31f4a50383b6353309a15" ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "The Executive must approve or refer a draft variation after consultation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
