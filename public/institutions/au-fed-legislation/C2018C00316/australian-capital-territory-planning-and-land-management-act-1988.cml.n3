concept:australian-capital-territory-planning-and-land-management-act-1988-sec-26 a cml:Concept ;
    skos:prefLabel "26 Territory Plan not to be inconsistent with National Capital Plan"@en ;
    cml:realizedBy doc:sec-26 ;
    values:originalText "The Territory Plan has no effect to the extent that it is inconsistent with the National Capital Plan, but the Territory Plan shall be taken to be consistent with the National Capital Plan to the extent that it is capable of operating concurrently with the National Capital Plan.   Land management  Part V  Section 27  Australian Capital Territory (Planning and Land Management) Act 1988 Compilation date: 1/7/18 Registered: 6/8/18" ;
    skos:definition "The Territory Plan has no effect to the extent that it is inconsistent with the National Capital Plan, but the Territory Plan shall be taken to be consistent with the National Capital Plan to the extent that it is capable of operating concurrently with the National Capital Plan.   Land management  Part V  Section 27  Australian Capital Territory (Planning and Land Management) Act 1988 Compilation date: 1/7/18 Registered: 6/8/18"@en ;
    cml:integrityHash "e476dc0cd0a230094fa0925731e3fec1a30013fe443b7e2e385e23317391bf74" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "The Territory Plan must be consistent with the National Capital Plan to the extent it can operate concurrently." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.22" ;
