concept:australian-capital-territory-planning-and-land-management-act-1988-sec-82 a cml:Concept ;
    skos:prefLabel "82 Contracts"@en ;
    cml:realizedBy doc:sec-82 ;
    values:originalText "Where, immediately before the repeal of the NCDC Act, a contract was subsisting and the NCDC was a party to the contract, the Commonwealth is substituted for the NCDC as a party to the contract." ;
    skos:definition "Where, immediately before the repeal of the NCDC Act, a contract was subsisting and the NCDC was a party to the contract, the Commonwealth is substituted for the NCDC as a party to the contract."@en ;
    cml:integrityHash "108d333d5334fc6ea6184d7ec7f1803f8aa8070f2c6dfed5043d7d97df6615d1" ;
    cof:pageNumber "50"^^xsd:integer ;
    skos:note "Substitution of Commonwealth for NCDC as a party to an existing contract." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-planning-and-land-management-act-1988.pdf> ;
    dc:source "australian-capital-territory-planning-and-land-management-act-1988.pdf, p.50" ;
    cml:asserts concept:australian-capital-territory-planning-and-land-management-act-1988-sec-82-norm .
