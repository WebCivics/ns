concept:australian-capital-territory-planning-and-land-management-act-1988-sec-23 a cml:Concept ;
    skos:prefLabel "23 Amendments of Plan"@en ;
    cml:realizedBy doc:sec-23 ;
    values:originalText "Amendments of the Plan shall be prepared in the same way as the Plan, and sections 14 to 22 (both inclusive) apply to amendments as if references in those sections to the Plan were references to amendments." ;
    skos:definition "Amendments of the Plan shall be prepared in the same way as the Plan, and sections 14 to 22 (both inclusive) apply to amendments as if references in those sections to the Plan were references to amendments."@en ;
