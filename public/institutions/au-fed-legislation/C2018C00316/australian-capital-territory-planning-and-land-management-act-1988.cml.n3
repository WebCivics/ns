concept:australian-capital-territory-planning-and-land-management-act-1988-sec-6-2 a cml:Concept ;
    skos:prefLabel "6 Functions of the Authority"@en ;
    cml:realizedBy doc:sec-6-2 ;
    values:originalText "(1) The functions of the Authority are:  (a) to prepare and administer a National Capital Plan;  (b) to keep the Plan under constant review and to propose amendments to it when necessary;" ;
    skos:definition "(1) The functions of the Authority are:  (a) to prepare and administer a National Capital Plan;  (b) to keep the Plan under constant review and to propose amendments to it when necessary;"@en ;
