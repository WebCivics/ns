      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Minister may also, with the agreement of the Finance Minister, determine that additional amounts be credited to the Fund."
    },
    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister MUST determine that the balance of the Account be reduced.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Amounts may be debited from the Account for the purposes of the Account, which include paying the costs of making investments."
    },
    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister MUST determine that additional amounts be credited to the Fund.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "A total of $2 billion must be credited to the Account, with an initial amount of $250 million credited on 1 July 2019 and additional amounts credited on each 1 July for the following 4 years."
    },
    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister MUST determine that the investments of the Fund meet certain requirements.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The investments of the Fund must be debt securities that meet certain requirements and the investments must be made in accordance with any directions given by the Minister."
    },
    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister MUST determine that additional amounts be credited to the Fund.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must provide",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Minister may also, with the agreement of the Finance Minister, determine that additional amounts be credited to the Fund."
    },
    {
