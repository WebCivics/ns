doc:sec-14-ss-1 a cof:Section ;
    cof:title "14(1) Credits to the Account" ;
    values:kind "subsection" ;
    values:originalText "(1) There must be credited to the Account amounts equal to the following:  (a) $250 million, to be credited on 1 July 2019;  (b) $250 million, to be credited on 1 July 2020;  (c) $500 million, to be credited on 1 July 2021;  (d) $500 million, to be credited on 1 July 2022;  (e) $500 million, to be credited on 1 July 2023;  (f) income derived from an investment of the Fund;  (g) a return of capital, or any other financial distribution, relating to an investment of the Fund;  (h) the proceeds of the realisation of an investment of the Fund." ;
    cof:pageNumber "12"^^xsd:integer .

concept:australian-business-securitisation-fund-act-2019-sec-14-ss-2 a cml:Concept ;
    skos:prefLabel "14(2) Credits to the Account"@en ;
    cml:realizedBy doc:sec-14-ss-2 ;
    values:originalText "(2) The Minister may, by notifiable instrument, determine that an amount equal to a specified amount is to be credited to the Account at a time specified in, or ascertained in accordance with, the determination." ;
    skos:definition "(2) The Minister may, by notifiable instrument, determine that an amount equal to a specified amount is to be credited to the Account at a time specified in, or ascertained in accordance with, the determination."@en ;
    cml:integrityHash "5b550fc998d12a89186ae9d13f4d5325b36245a0bb74fc2e10eb817459f0f9e5" ;
    values:partOf concept:australian-business-securitisation-fund-act-2019-sec-14 ;
