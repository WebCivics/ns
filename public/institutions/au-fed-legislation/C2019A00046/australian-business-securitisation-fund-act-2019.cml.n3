concept:australian-business-securitisation-fund-act-2019-sec-15 a cml:Concept ;
    skos:prefLabel "15 Purposes of the Account"@en ;
    cml:realizedBy doc:sec-15 ;
    values:originalText "The purposes of the Account are as follows:  (a) paying the costs of the making of an investment under section 12;  (b) paying or discharging any other costs, expenses and other obligations incurred by the Commonwealth exclusively in connection with the Fund;   The Australian Business Securitisation Fund  Part 2  Section 16  No. 46, 2019 Australian Business Securitisation Fund Act 2019  (c) reducing the balance of the Account under section 16 (and therefore the available appropriation for the Account) without making a real or notional payment." ;
    skos:definition "The purposes of the Account are as follows:  (a) paying the costs of the making of an investment under section 12;  (b) paying or discharging any other costs, expenses and other obligations incurred by the Commonwealth exclusively in connection with the Fund;   The Australian Business Securitisation Fund  Part 2  Section 16  No. 46, 2019 Australian Business Securitisation Fund Act 2019  (c) reducing the balance of the Account under section 16 (and therefore the available appropriation for the Account) without making a real or notional payment."@en ;
    cml:integrityHash "104236f554c4683531c49281f1ddb0827e368e389bf3aa9706d5a5e1f6f1f0fd" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Paying costs and expenses of the Commonwealth exclusively in connection with the Fund." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-business-securitisation-fund-act-2019.pdf> ;
    dc:source "australian-business-securitisation-fund-act-2019.pdf, p.12" ;
    cml:asserts concept:australian-business-securitisation-fund-act-2019-sec-15-norm .
