concept:australian-business-securitisation-fund-act-2019-sec-3 a cml:Concept ;
    skos:prefLabel "3 Objects of this Act"@en ;
    cml:realizedBy doc:sec-3 ;
    values:originalText "The objects of this Act are to increase the availability, and reduce the cost, of credit provided to small and medium enterprises by the Commonwealth investing in debt securities in accordance with this Act." ;
    skos:definition "The objects of this Act are to increase the availability, and reduce the cost, of credit provided to small and medium enterprises by the Commonwealth investing in debt securities in accordance with this Act."@en ;
    cml:integrityHash "ab929674d015067a79bce0437aafe106d81320f09c6a162d78bc44411163ed7d" ;
    cof:pageNumber "6"^^xsd:integer ;
    skos:note "Increase availability and reduce cost of credit for small and medium enterprises." ;
