doc:sec-19-ss-4 a cof:Section ;
    cof:title "19(4) Delegations by the Minister" ;
    values:kind "subsection" ;
    values:originalText "(4) A person exercising powers or performing functions under a delegation under subsection (1) must comply with any written directions of the Minister." ;
