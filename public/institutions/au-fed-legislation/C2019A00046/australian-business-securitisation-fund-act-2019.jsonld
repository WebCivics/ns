    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-business-securitisation-fund-act-2019.pdf"
      },
      "dc:source": "australian-business-securitisation-fund-act-2019.pdf, p.9",
      "values:originalText": "This Part sets up the Australian Business Securitisation Fund.\nThe Fund consists of the Australian Business Securitisation Fund\nSpecial Account and the investments of the Fund.\nThe investments of the Fund must be debt securities that meet\ncertain requirements and the investments must be made in\naccordance with any directions given by the Minister.\nA total of $2 billion must be credited to the Account, with an initial\namount of $250 million credited on 1 July 2019 and additional\namounts credited on each 1 July for the following 4 years. The\nMinister may also, with the agreement of the Finance Minister,\ndetermine that additional amounts be credited to the Fund.\nAmounts may be debited from the Account for the purposes of the\nAccount, which include paying the costs of making investments.\nThe Minister may also determine that the balance of the Account\nbe reduced.",
      "skos:definition": "This Part sets up the Australian Business Securitisation Fund.\nThe Fund consists of the Australian Business Securitisation Fund\nSpecial Account and the investments of the Fund.\nThe investments of the Fund must be debt securities that meet\ncertain requirements and the investments must be made in\naccordance with any directions given by the Minister.\nA total of $2 billion must be credited to the Account, with an initial\namount of $250 million credited on 1 July 2019 and additional\namounts credited on each 1 July for the following 4 years. The\nMinister may also, with the agreement of the Finance Minister,\ndetermine that additional amounts be credited to the Fund.\nAmounts may be debited from the Account for the purposes of the\nAccount, which include paying the costs of making investments.\nThe Minister may also determine that the balance of the Account\nbe reduced.",
      "cml:asserts": [
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-norm"
        },
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-1"
        },
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-2"
        },
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-3"
        },
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-4"
        },
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "a1af5a6042f1fdd1fec87219ab82d9f8ecdd35ba021080e6e46b32b5f7e6f416",
      "skos:note": "The Minister must determine certain amounts for the Fund."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "This Part sets up the Australian Business Securitisation Fund.\nThe Fund consists of the Australian Business Securitisation Fund\nSpecial Account and the investments of the Fund.\nThe investments of the Fund must be debt securities that meet\ncertain requirements and the investments must be made in\naccordance with any directions given by the Minister.\nA total of $2 billion must be credited to the Account, with an initial\namount of $250 million credited on 1 July 2019 and additional\namounts credited on each 1 July for the following 4 years. The\nMinister may also, with the agreement of the Finance Minister,\ndetermine that additional amounts be credited to the Fund.\nAmounts may be debited from the Account for the purposes of the\nAccount, which include paying the costs of making investments.\nThe Minister may also determine that the balance of the Account\nbe reduced."
    },
    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-9-norm",
      "@type": "values:Obligation",
      "cml:modality": {
