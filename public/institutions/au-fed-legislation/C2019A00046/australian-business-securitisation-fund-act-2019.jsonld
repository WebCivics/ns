    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Establishment of the Australian Business Securitisation Fund",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-business-securitisation-fund-act-2019.pdf"
      },
      "dc:source": "australian-business-securitisation-fund-act-2019.pdf, p.10",
      "values:originalText": "Special Account\n\n(1) The Australian Business Securitisation Fund Special Account is\nestablished by this section.\n\n(2) The Account is a special account for the purposes of the Public\nGovernance, Performance and Accountability Act 2013.\nNote:\nAn Appropriation Act may contain a provision to the effect that, if any\nof the purposes of a special account is a purpose that is covered by an\nitem in the Appropriation Act (whether or not the item expressly refers\nto the special account), then amounts may be debited against the\nappropriation for that item and credited to that special account.",
      "skos:definition": "Special Account\n\n(1) The Australian Business Securitisation Fund Special Account is\nestablished by this section.\n\n(2) The Account is a special account for the purposes of the Public\nGovernance, Performance and Accountability Act 2013.\nNote:\nAn Appropriation Act may contain a provision to the effect that, if any\nof the purposes of a special account is a purpose that is covered by an\nitem in the Appropriation Act (whether or not the item expressly refers\nto the special account), then amounts may be debited against the\nappropriation for that item and credited to that special account.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-11-ss-1"
        },
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-11-ss-2"
        }
      ],
      "cml:integrityHash": "11391a788c4de6fb54741a7688d45bcfc13b696362d179c8b212030d21b210a1"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Establishment of the Australian Business Securitisation Fund",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Special Account\n\n(1) The Australian Business Securitisation Fund Special Account is\nestablished by this section.\n\n(2) The Account is a special account for the purposes of the Public\nGovernance, Performance and Accountability Act 2013.\nNote:\nAn Appropriation Act may contain a provision to the effect that, if any\nof the purposes of a special account is a purpose that is covered by an\nitem in the Appropriation Act (whether or not the item expressly refers\nto the special account), then amounts may be debited against the\nappropriation for that item and credited to that special account."
    },
