    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Reducing the balance of the Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
