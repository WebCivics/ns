        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Constitutional limits",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-business-securitisation-fund-act-2019.pdf"
      },
      "dc:source": "australian-business-securitisation-fund-act-2019.pdf, p.14",
      "values:originalText": "The Minister may exercise a power or perform a function conferred\non the Minister by section 12 only:\n\n(a) with respect to trade or commerce:\n\n(i) between Australia and places outside Australia; or\n\n(ii) among the States; or\n\n(iii) within a Territory, between a State and a Territory or\nbetween 2 Territories; or\n\n(b) with respect to a Territory; or\n\n(c) with respect to the implied power of the Parliament to make\nlaws with respect to nationhood; or\n\n(d) with respect to the executive power of the Commonwealth.",
      "skos:definition": "The Minister may exercise a power or perform a function conferred\non the Minister by section 12 only:\n\n(a) with respect to trade or commerce:\n\n(i) between Australia and places outside Australia; or\n\n(ii) among the States; or\n\n(iii) within a Territory, between a State and a Territory or\nbetween 2 Territories; or\n\n(b) with respect to a Territory; or\n\n(c) with respect to the implied power of the Parliament to make\nlaws with respect to nationhood; or\n\n(d) with respect to the executive power of the Commonwealth.",
      "cml:asserts": [
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-18-norm"
        },
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "34c7c116991672836a4cc231b00eaa6ff1c0f41cb6b499d7b4bb3ccdb86e680e",
      "skos:note": "The Minister may exercise a power or perform a function only under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Constitutional limits",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The Minister may exercise a power or perform a function conferred\non the Minister by section 12 only:\n\n(a) with respect to trade or commerce:\n\n(i) between Australia and places outside Australia; or\n\n(ii) among the States; or\n\n(iii) within a Territory, between a State and a Territory or\nbetween 2 Territories; or\n\n(b) with respect to a Territory; or\n\n(c) with respect to the implied power of the Parliament to make\nlaws with respect to nationhood; or\n\n(d) with respect to the executive power of the Commonwealth."
    },
    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-18-norm",
      "@type": "values:Obligation",
      "cml:modality": {
