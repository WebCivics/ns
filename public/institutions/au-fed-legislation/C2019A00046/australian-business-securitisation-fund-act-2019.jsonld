    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-business-securitisation-fund-act-2019.pdf"
      },
      "dc:source": "australian-business-securitisation-fund-act-2019.pdf, p.14",
      "values:originalText": "This Part contains miscellaneous provisions, including provisions\nabout constitutional limits, delegation of the Minister’s powers and\nfunctions under this Act, reporting on the operation of this Act and\nconducting a review of the operation of this Act.\nThis Part also contains the general rule-making power.",
      "skos:definition": "This Part contains miscellaneous provisions, including provisions\nabout constitutional limits, delegation of the Minister’s powers and\nfunctions under this Act, reporting on the operation of this Act and\nconducting a review of the operation of this Act.\nThis Part also contains the general rule-making power.",
      "cml:asserts": [
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-17-norm"
        }
      ],
      "cml:integrityHash": "25f4c136f1fc32d5fc389dd988908cce93b8d8e7f8b138d834b9ab9d1969b83e",
      "skos:note": "Contains miscellaneous provisions, including general rule-making power."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "This Part contains miscellaneous provisions, including provisions\nabout constitutional limits, delegation of the Minister’s powers and\nfunctions under this Act, reporting on the operation of this Act and\nconducting a review of the operation of this Act.\nThis Part also contains the general rule-making power."
    },
    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-17-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
