    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Purposes of the Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-business-securitisation-fund-act-2019.pdf"
      },
      "dc:source": "australian-business-securitisation-fund-act-2019.pdf, p.12",
      "values:originalText": "The purposes of the Account are as follows:\n\n(a) paying the costs of the making of an investment under\nsection 12;\n\n(b) paying or discharging any other costs, expenses and other\nobligations incurred by the Commonwealth exclusively in\nconnection with the Fund;\n\n\nThe Australian Business Securitisation Fund  Part 2\n\nSection 16\n\nNo. 46, 2019\nAustralian Business Securitisation Fund Act 2019\n\n(c) reducing the balance of the Account under section 16 (and\ntherefore the available appropriation for the Account) without\nmaking a real or notional payment.",
      "skos:definition": "The purposes of the Account are as follows:\n\n(a) paying the costs of the making of an investment under\nsection 12;\n\n(b) paying or discharging any other costs, expenses and other\nobligations incurred by the Commonwealth exclusively in\nconnection with the Fund;\n\n\nThe Australian Business Securitisation Fund  Part 2\n\nSection 16\n\nNo. 46, 2019\nAustralian Business Securitisation Fund Act 2019\n\n(c) reducing the balance of the Account under section 16 (and\ntherefore the available appropriation for the Account) without\nmaking a real or notional payment.",
      "cml:asserts": [
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-15-norm"
        },
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "104236f554c4683531c49281f1ddb0827e368e389bf3aa9706d5a5e1f6f1f0fd",
      "skos:note": "Paying costs and expenses of the Commonwealth exclusively in connection with the Fund."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Purposes of the Account",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "The purposes of the Account are as follows:\n\n(a) paying the costs of the making of an investment under\nsection 12;\n\n(b) paying or discharging any other costs, expenses and other\nobligations incurred by the Commonwealth exclusively in\nconnection with the Fund;\n\n\nThe Australian Business Securitisation Fund  Part 2\n\nSection 16\n\nNo. 46, 2019\nAustralian Business Securitisation Fund Act 2019\n\n(c) reducing the balance of the Account under section 16 (and\ntherefore the available appropriation for the Account) without\nmaking a real or notional payment."
    },
