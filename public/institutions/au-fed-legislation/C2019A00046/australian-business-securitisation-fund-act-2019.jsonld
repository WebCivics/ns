      },
      "dc:source": "australian-business-securitisation-fund-act-2019.pdf, p.8",
      "values:originalText": "This Act extends to acts, omissions, matters and things outside\nAustralia.\n\n\nThe Australian Business Securitisation Fund  Part 2\n\nSection 9\n\nNo. 46, 2019\nAustralian Business Securitisation Fund Act 2019",
      "skos:definition": "This Act extends to acts, omissions, matters and things outside\nAustralia.\n\n\nThe Australian Business Securitisation Fund  Part 2\n\nSection 9\n\nNo. 46, 2019\nAustralian Business Securitisation Fund Act 2019",
      "cml:asserts": [
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-8-norm"
        }
      ],
      "cml:integrityHash": "c215d5147ba4d9ac485ac701ae70e885003522a61625b1be4a583aba093cb5a5",
      "skos:note": "Act extends to acts, omissions, matters and things outside Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Extra-territorial application",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "This Act extends to acts, omissions, matters and things outside\nAustralia.\n\n\nThe Australian Business Securitisation Fund  Part 2\n\nSection 9\n\nNo. 46, 2019\nAustralian Business Securitisation Fund Act 2019"
    },
    {
