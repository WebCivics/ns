      "skos:note": "Investment of the Fund is exempt from Section 58 of the Public Governance, Performance and Accountability Act 2013."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-12-ss-5",
      "@type": "cof:Section",
