      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The investments of the Fund must be debt securities that meet certain requirements and the investments must be made in accordance with any directions given by the Minister.",
      "cml:conclusionText": "The Minister MUST determine that the investments of the Fund meet certain requirements."
    },
    {
