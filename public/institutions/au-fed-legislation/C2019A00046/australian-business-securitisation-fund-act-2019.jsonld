    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Objects of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-business-securitisation-fund-act-2019.pdf"
      },
      "dc:source": "australian-business-securitisation-fund-act-2019.pdf, p.6",
      "values:originalText": "The objects of this Act are to increase the availability, and reduce\nthe cost, of credit provided to small and medium enterprises by the\nCommonwealth investing in debt securities in accordance with this\nAct.",
      "skos:definition": "The objects of this Act are to increase the availability, and reduce\nthe cost, of credit provided to small and medium enterprises by the\nCommonwealth investing in debt securities in accordance with this\nAct.",
      "cml:asserts": [
        {
          "@id": "concept:australian-business-securitisation-fund-act-2019-sec-3-norm"
        }
      ],
      "cml:integrityHash": "ab929674d015067a79bce0437aafe106d81320f09c6a162d78bc44411163ed7d",
      "skos:note": "Increase availability and reduce cost of credit for small and medium enterprises."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Objects of this Act",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "The objects of this Act are to increase the availability, and reduce\nthe cost, of credit provided to small and medium enterprises by the\nCommonwealth investing in debt securities in accordance with this\nAct."
    },
