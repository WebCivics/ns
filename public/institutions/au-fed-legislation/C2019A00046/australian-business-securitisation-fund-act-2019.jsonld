    {
      "@id": "concept:australian-business-securitisation-fund-act-2019-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Review of operation of this Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-business-securitisation-fund-act-2019#sec-21"
      },
