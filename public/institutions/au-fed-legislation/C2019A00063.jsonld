    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eu-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision overlaps with Part 4 of the Regulatory Powers Act.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Identifies the temporal overlap between the provision and the regulatory powers act.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "Note 1: The proceedings for a contravention referred to in paragraph (a) would be instituted under Part 4 of the Regulatory Powers Act."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eu-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Proceedings may not be instituted against a person in relation to contravention of certain provisions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits proceedings against a person in relation to contravention of certain provisions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(5) If an act or omission constitutes:  (a) a contravention of one or more of the privacy safeguard penalty provisions; and  (b) a contravention of one or more civil penalty provisions of the consumer data rules; proceedings may be instituted against a person in relation to the contravention of any one or more of those provisions."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eu-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "There is an obligation to institute proceedings against a person in relation to contravention of certain provisions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Imposes an obligation to institute proceedings against a person in relation to contravention of certain provisions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "(5) If an act or omission constitutes:  (a) a contravention of one or more of the privacy safeguard penalty provisions; and  (b) a contravention of one or more civil penalty provisions of the consumer data rules; proceedings may be instituted against a person in relation to the contravention of any one or more of those provisions."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eu-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The provision repeats with Part VI of this Act.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Identifies the recurring nature of the provision.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "Note 2: The proceedings for a contravention referred to in paragraph (b) would be instituted under Part VI of this Act."
    },
