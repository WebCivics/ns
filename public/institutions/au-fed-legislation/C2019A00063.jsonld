      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "The CDR data must be within a class specified in an instrument.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is-a",
      "cml:premiseText": "(i) is information within a class of information specified, as described in paragraph 56AC(2)(a), in an instrument designating a sector under subsection 56AC(2)"
    },
