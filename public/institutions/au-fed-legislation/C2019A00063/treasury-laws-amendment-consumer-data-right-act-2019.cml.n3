    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2019.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.80" .
doc:sch-1-sec-56fd a cof:Section ;
