    cml:modality cml:Deontic ;
    cml:operator "obligation" ;
    cml:logicSummary "Recovery obligation" ;
    cml:conclusionText "A person who suffers loss or damage may recover the amount by action against another person." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31 cml:asserts concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31-logic-alleninterval-2 .
