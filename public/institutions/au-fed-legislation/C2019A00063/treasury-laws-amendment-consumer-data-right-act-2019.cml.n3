concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56an a cml:Concept ;
    skos:prefLabel "56AN Extension to external Territories"@en ;
    cml:realizedBy doc:sch-1-sec-56an ;
    values:originalText "Each of the following provisions (the CDR provisions) extends to every external Territory:  (a) a provision of this Part;  (b) a provision of the regulations made for the purposes of a provision of this Part;  (c) a provision of the consumer data rules;  (d) another provision of this Act to the extent that it relates to a provision covered by paragraph (a), (b) or (c);  (e) a provision of the Regulatory Powers Act to the extent that it applies in relation to a provision of this Part;  (f) a provision of the Privacy Act 1988 to the extent that it applies as described in section 56ES or 56ET of this Act." ;
    skos:definition "Each of the following provisions (the CDR provisions) extends to every external Territory:  (a) a provision of this Part;  (b) a provision of the regulations made for the purposes of a provision of this Part;  (c) a provision of the consumer data rules;  (d) another provision of this Act to the extent that it relates to a provision covered by paragraph (a), (b) or (c);  (e) a provision of the Regulatory Powers Act to the extent that it applies in relation to a provision of this Part;  (f) a provision of the Privacy Act 1988 to the extent that it applies as described in section 56ES or 56ET of this Act."@en ;
    cml:integrityHash "a39665554ad93caf39907b12f9924d9cd692919ac440ea0d8b6e6ae39e7984ec" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Extends provisions of this Part to external Territories" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2019.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.18" ;
    cml:asserts concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56an-norm .
