concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bn-ss-5 a cml:Concept ;
    skos:prefLabel "56BN(5) Misleading or deceptive conduct—offence"@en ;
    cml:realizedBy doc:sch-1-sec-56bn-ss-5 ;
    values:originalText "(5) An offence against subsection (1) committed by a person other than a body corporate is punishable on conviction by imprisonment for not more than 5 years, a fine of not more than $500,000, or both." ;
    skos:definition "(5) An offence against subsection (1) committed by a person other than a body corporate is punishable on conviction by imprisonment for not more than 5 years, a fine of not more than $500,000, or both."@en ;
