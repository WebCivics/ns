doc:sch-1-sec-56fk-ss-2 a cof:Section ;
    cof:title "56FK(2) Function and powers of the Data Standards Body" ;
    values:kind "subsection" ;
    values:originalText "(2) The Data Standards Body has the power to do all other things necessary or convenient to be done for or in connection with the performance of the Data Standards Body’s function." ;
    cof:pageNumber "83"^^xsd:integer .

concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56fk-ss-3 a cml:Concept ;
    skos:prefLabel "56FK(3) Function and powers of the Data Standards Body"@en ;
    cml:realizedBy doc:sch-1-sec-56fk-ss-3 ;
    values:originalText "(3) The Data Standards Body must comply with the consumer data rules when assisting the Data Standards Chair, including complying with any requirements specified in those rules about:  (a) the Body’s composition; or  Schedule 1  Consumer data right" ;
    skos:definition "(3) The Data Standards Body must comply with the consumer data rules when assisting the Data Standards Chair, including complying with any requirements specified in those rules about:  (a) the Body’s composition; or  Schedule 1  Consumer data right"@en ;
