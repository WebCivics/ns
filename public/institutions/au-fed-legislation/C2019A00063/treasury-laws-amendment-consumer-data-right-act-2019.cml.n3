concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-6 a cml:Concept ;
    skos:prefLabel "6 Subsection 9(1)"@en ;
    cml:realizedBy doc:sch-1-sec-6 ;
    values:originalText "Repeal the subsection, substitute:  (1) The privacy functions are functions conferred on the Information Commissioner by an Act (or an instrument under an Act), if:  (a) the functions:  (i) relate to the privacy of an individual; and  (ii) are not freedom of information functions; or  (b) the functions are conferred by:  (i) Part IVD (about the consumer data right) of the Competition and Consumer Act 2010; or  (ii) an instrument made under that Part; or  (iii) another Act because of that Part." ;
    skos:definition "Repeal the subsection, substitute:  (1) The privacy functions are functions conferred on the Information Commissioner by an Act (or an instrument under an Act), if:  (a) the functions:  (i) relate to the privacy of an individual; and  (ii) are not freedom of information functions; or  (b) the functions are conferred by:  (i) Part IVD (about the consumer data right) of the Competition and Consumer Act 2010; or  (ii) an instrument made under that Part; or  (iii) another Act because of that Part."@en ;
    cml:integrityHash "ca03905564ea6015beb6560c975fb9a7d91592c64ba512532b8f38557a0777ae" ;
    cof:pageNumber "95"^^xsd:integer ;
    skos:note "Repeal subsection 9(1) and substitute with new provisions regarding privacy functions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
