doc:sch-1-sec-56gb-ss-2 a cof:Section ;
    cof:title "56GB(2) Referring to instruments as in force from time to time" ;
    values:kind "subsection" ;
    values:originalText "(2) An instrument to which this section applies may make provision in relation to a matter by applying, adopting or incorporating (with or without modification) any matter contained in any other instrument or writing:  (a) as in force or existing at a particular time; or  (b) as in force or existing from time to time." ;
    cof:pageNumber "88"^^xsd:integer .

concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gb-ss-3 a cml:Concept ;
    skos:prefLabel "56GB(3) Referring to instruments as in force from time to time"@en ;
    cml:realizedBy doc:sch-1-sec-56gb-ss-3 ;
    values:originalText "(3) Subsection (2) has effect despite subsection 14(2) of the Legislation Act 2003." ;
    skos:definition "(3) Subsection (2) has effect despite subsection 14(2) of the Legislation Act 2003."@en ;
    cml:integrityHash "08638f9f1f6d3018d519b74cb4a521d2b8f0dada61069bbbbe91fc8335c23fa7" ;
    values:partOf concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gb ;
