concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gd a cml:Concept ;
    skos:prefLabel "56GD Exemptions by the Commission"@en ;
    cml:realizedBy doc:sch-1-sec-56gd ;
    values:originalText "(1) The provisions covered by this section are:  (a) the following provisions:  (i) the provisions of this Part;  (ii) the provisions of regulations made for the purposes of the provisions of this Part;  (iii) the provisions of the consumer data rules; and  (b) definitions in this Act, or in the regulations or consumer data rules, as they apply to references in provisions referred to in paragraph (a).  (2) The Commission may, by written notice given to a person, exempt the person, in relation to particular CDR data or one or more classes of CDR data, from all or specified provisions covered by this section.  (3) An exemption under subsection (2):  Schedule 1  Consumer data right" ;
    skos:definition "(1) The provisions covered by this section are:  (a) the following provisions:  (i) the provisions of this Part;  (ii) the provisions of regulations made for the purposes of the provisions of this Part;  (iii) the provisions of the consumer data rules; and  (b) definitions in this Act, or in the regulations or consumer data rules, as they apply to references in provisions referred to in paragraph (a).  (2) The Commission may, by written notice given to a person, exempt the person, in relation to particular CDR data or one or more classes of CDR data, from all or specified provisions covered by this section.  (3) An exemption under subsection (2):  Schedule 1  Consumer data right"@en ;
    cml:integrityHash "1767b98a0b4ba4434a45e61a9513b113afbea9f566bd971b44420cdf72c4fd33" ;
    cof:pageNumber "89"^^xsd:integer ;
    cml:hasPart concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gd-ss-1 ;
    cml:hasPart concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gd-ss-2 ;
    cml:hasPart concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gd-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2019.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.89" .
