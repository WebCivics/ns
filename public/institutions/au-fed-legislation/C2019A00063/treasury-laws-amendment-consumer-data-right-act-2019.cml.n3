concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cc-ss-4 a cml:Concept ;
    skos:prefLabel "56CC(4) Prohibition on holding out—offence"@en ;
    cml:realizedBy doc:sch-1-sec-56cc-ss-4 ;
    values:originalText "(4) An offence against subsection (1) committed by a person other than a body corporate is punishable on conviction by imprisonment for not more than 5 years, a fine of not more than $500,000, or both." ;
    skos:definition "(4) An offence against subsection (1) committed by a person other than a body corporate is punishable on conviction by imprisonment for not more than 5 years, a fine of not more than $500,000, or both."@en ;
    cml:integrityHash "892c75a5777da4e54623d90bbbccca29f81ad221b60b47d603aaebaf095cf11e" ;
