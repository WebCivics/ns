    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-56as-ss-3 a cof:Section ;
    cof:title "56AS(3) Participating government entities of a State or Territory—" ;
    values:kind "subsection" ;
    values:originalText "(3) If:  (a) a State or Territory has agreed to an entity of the State or Territory participating under this Part; and  (b) the entity is a body corporate; the entity is taken to have also agreed to participate under this Part." ;
    cof:pageNumber "22"^^xsd:integer .

concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56at a cml:Concept ;
    skos:prefLabel "56AT Participating government entities of a State or Territory—"@en ;
    cml:realizedBy doc:sch-1-sec-56at ;
    values:originalText "revocation  (1) The Minister may, by notifiable instrument, revoke a declaration made under subsection 56AS(1) that an entity is a participating entity for a State or Territory.  (2) If a State or Territory requests in writing the Minister to revoke a declaration made under subsection 56AS(1) that an entity is a participating entity for the State or Territory, the Minister must, under subsection (1) of this section, revoke the declaration as soon as practicable.  (3) If the Minister revokes a declaration made under subsection 56AS(1) in relation to an entity, then, despite the revocation, subsection 56AR(2) continues to apply to the entity in relation to:  (a) any right, privilege, obligation or liability acquired, accrued or incurred before the revocation; and  (b) any investigation, legal proceeding or remedy in respect of any such right, privilege, obligation or liability; as if the declaration were still in force.  Consumer data right  Schedule 1 Main amendments  Part 1  No. 63, 2019 Treasury Laws Amendment (Consumer Data Right) Act 2019" ;
    skos:definition "revocation  (1) The Minister may, by notifiable instrument, revoke a declaration made under subsection 56AS(1) that an entity is a participating entity for a State or Territory.  (2) If a State or Territory requests in writing the Minister to revoke a declaration made under subsection 56AS(1) that an entity is a participating entity for the State or Territory, the Minister must, under subsection (1) of this section, revoke the declaration as soon as practicable.  (3) If the Minister revokes a declaration made under subsection 56AS(1) in relation to an entity, then, despite the revocation, subsection 56AR(2) continues to apply to the entity in relation to:  (a) any right, privilege, obligation or liability acquired, accrued or incurred before the revocation; and  (b) any investigation, legal proceeding or remedy in respect of any such right, privilege, obligation or liability; as if the declaration were still in force.  Consumer data right  Schedule 1 Main amendments  Part 1  No. 63, 2019 Treasury Laws Amendment (Consumer Data Right) Act 2019"@en ;
    cml:integrityHash "2a3c5fe92785106889f22a9633aef8bd8ff1ca1d6a82f3808ecc732dc56b12bd" ;
    cof:pageNumber "22"^^xsd:integer ;
