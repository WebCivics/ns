concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cd a cml:Concept ;
    skos:prefLabel "56CD Prohibition on holding out—civil penalty"@en ;
    cml:realizedBy doc:sch-1-sec-56cd ;
    values:originalText "A person must not hold out that the person:  (a) is an accredited person; or  (b) is an accredited person holding an accreditation that has been granted at a particular level (see paragraph 56BH(1)(d)); or  (c) is an accredited data recipient of CDR data; if that is not the case. Note: For enforcement, see Part VI (including section 76 for an order for payment of a pecuniary penalty). Subdivision B—Register of Accredited Persons" ;
    skos:definition "A person must not hold out that the person:  (a) is an accredited person; or  (b) is an accredited person holding an accreditation that has been granted at a particular level (see paragraph 56BH(1)(d)); or  (c) is an accredited data recipient of CDR data; if that is not the case. Note: For enforcement, see Part VI (including section 76 for an order for payment of a pecuniary penalty). Subdivision B—Register of Accredited Persons"@en ;
    cml:integrityHash "0170bc605fe5a10fbbc39b61bcec1a5d48e03a68deaec3f1bbc1fe55ec87ac0b" ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Prohibition on holding out that a person is accredited or has a specific accreditation level." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2019.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.45" ;
    cml:asserts concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cd-norm .
