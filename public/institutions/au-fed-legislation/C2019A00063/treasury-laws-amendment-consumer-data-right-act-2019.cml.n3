concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ey-ss-7 a cml:Concept ;
    skos:prefLabel "56EY(7) Actions for damages"@en ;
    cml:realizedBy doc:sch-1-sec-56ey-ss-7 ;
    values:originalText "(7) Section 86A (about transfer of matters) applies in relation to a proceeding under subsection (1) of this section as if paragraph 86A(1)(b) also referred to a matter for determination arising under:  (a) a provision of the privacy safeguards; or  Schedule 1  Consumer data right" ;
    skos:definition "(7) Section 86A (about transfer of matters) applies in relation to a proceeding under subsection (1) of this section as if paragraph 86A(1)(b) also referred to a matter for determination arising under:  (a) a provision of the privacy safeguards; or  Schedule 1  Consumer data right"@en ;
    cml:integrityHash "979779fab48356f4c570496c15c67aa3d609bfcb515c01208d8bc4bf7a018ab7" ;
    values:partOf concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ey ;
    cof:pageNumber "76"^^xsd:integer ;
    skos:note "Section applies in relation to a proceeding under subsection (1) of this section as if paragraph 86A(1)(b) also referred to a matter for determination arising under the privacy safeguards." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
