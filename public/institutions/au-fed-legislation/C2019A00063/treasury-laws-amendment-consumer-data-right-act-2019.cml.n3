concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56fl a cml:Concept ;
    skos:prefLabel "56FL Acting appointments"@en ;
    cml:realizedBy doc:sch-1-sec-56fl ;
    values:originalText "The Minister may, by written instrument, appoint a person to act as the Data Standards Chair:  (a) during a vacancy in the office of Data Standards Chair (whether or not an appointment has previously been made to the office); or  (b) during any period, or during all periods, when the Data Standards Chair:  (i) is absent from duty or from Australia; or  (ii) is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see sections 33AB and 33A of the Acts Interpretation Act 1901." ;
    skos:definition "The Minister may, by written instrument, appoint a person to act as the Data Standards Chair:  (a) during a vacancy in the office of Data Standards Chair (whether or not an appointment has previously been made to the office); or  (b) during any period, or during all periods, when the Data Standards Chair:  (i) is absent from duty or from Australia; or  (ii) is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see sections 33AB and 33A of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "080ebc13785ecc1d8734b435e2005731cc8134630f917976228a440a415e2c54" ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "The Minister may appoint a person to act as Data Standards Chair." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
