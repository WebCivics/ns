concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eu-ss-6 a cml:Concept ;
    skos:prefLabel "56EU(6) Civil penalty provisions"@en ;
    cml:realizedBy doc:sch-1-sec-56eu-ss-6 ;
