concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bl a cml:Concept ;
    skos:prefLabel "56BL Obligation to comply with consumer data rules"@en ;
    cml:realizedBy doc:sch-1-sec-56bl ;
    values:originalText "The consumer data rules may provide that specified provisions of the rules are civil penalty provisions (within the meaning of the Regulatory Powers Act). Note: Sections 76 to 77 deal with enforcing the civil penalty provisions." ;
    skos:definition "The consumer data rules may provide that specified provisions of the rules are civil penalty provisions (within the meaning of the Regulatory Powers Act). Note: Sections 76 to 77 deal with enforcing the civil penalty provisions."@en ;
    cml:integrityHash "844e70f97e4e755b808f2a2de181283e0dd2a7921287b89bd1dcbb82185531bc" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Consumer data rules may provide for civil penalty provisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2019.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.35" ;
    cml:asserts concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bl-norm .
