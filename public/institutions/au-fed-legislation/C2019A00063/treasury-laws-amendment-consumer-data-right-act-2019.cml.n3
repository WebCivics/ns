concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cb a cml:Concept ;
    skos:prefLabel "56CB Review of decisions refusing to accredit"@en ;
    cml:realizedBy doc:sch-1-sec-56cb ;
    values:originalText "Applications may be made to the Administrative Appeals Tribunal for review of decisions of the Data Recipient Accreditor under subsection 56CA(1) refusing to accredit persons. Note: For AAT review of decisions to vary, suspend or revoke accreditations, see subsection 56BH(4)." ;
    skos:definition "Applications may be made to the Administrative Appeals Tribunal for review of decisions of the Data Recipient Accreditor under subsection 56CA(1) refusing to accredit persons. Note: For AAT review of decisions to vary, suspend or revoke accreditations, see subsection 56BH(4)."@en ;
    cml:integrityHash "5de282492ca0ecb1658c66be395be903e24742495ba1791e66de63fe04073c36" ;
    cof:pageNumber "44"^^xsd:integer ;
    skos:note "Review of decisions refusing to accredit" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
