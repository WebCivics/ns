concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56br a cml:Concept ;
    skos:prefLabel "56BR Ministerial consent to rules required"@en ;
    cml:realizedBy doc:sch-1-sec-56br ;
    values:originalText "The Commission must not make consumer data rules under subsection 56BA(1) unless the Minister has consented, in writing, to the making of the rules. Note: In an emergency, consent is not required (see section 56BS).  Consumer data right  Schedule 1 Main amendments  Part 1  No. 63, 2019 Treasury Laws Amendment (Consumer Data Right) Act 2019" ;
    skos:definition "The Commission must not make consumer data rules under subsection 56BA(1) unless the Minister has consented, in writing, to the making of the rules. Note: In an emergency, consent is not required (see section 56BS).  Consumer data right  Schedule 1 Main amendments  Part 1  No. 63, 2019 Treasury Laws Amendment (Consumer Data Right) Act 2019"@en ;
    cml:integrityHash "01d753326b02f2b4c20d47e7aa7a0d2276f41b08f9cf72ab4a47a1fb9879e9bd" ;
    cof:pageNumber "38"^^xsd:integer ;
    skos:note "Ministerial consent required for consumer data rules" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2019.pdf> ;
