    values:partOf concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bn ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Offence against subsection (1) punishable by imprisonment or fine." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
