concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31 a cml:Concept ;
    skos:prefLabel "31 Subsection 82(1)"@en ;
    cml:realizedBy doc:sch-1-sec-31 ;
    values:originalText "Repeal the subsection, substitute:  (1) A person who suffers loss or damage by conduct of another person that was done in contravention of:  (a) a provision of Part IV or IVB; or  (b) section 55B, 60C or 60K; or  (c) subsection 56BN(1), 56BO(1), 56BU(1) or 56CC(1) or section 56CD; or  (d) a civil penalty provision of the consumer data rules; may recover the amount of the loss or damage by action against that other person or against any person involved in the contravention. Note: Any legal proceeding in progress under subsection 82(1) of the Competition and Consumer Act 2010 when that subsection is so repealed will continue as if the repeal had not happened (see subsection 7(2) of the Acts Interpretation Act 1901)." ;
    skos:definition "Repeal the subsection, substitute:  (1) A person who suffers loss or damage by conduct of another person that was done in contravention of:  (a) a provision of Part IV or IVB; or  (b) section 55B, 60C or 60K; or  (c) subsection 56BN(1), 56BO(1), 56BU(1) or 56CC(1) or section 56CD; or  (d) a civil penalty provision of the consumer data rules; may recover the amount of the loss or damage by action against that other person or against any person involved in the contravention. Note: Any legal proceeding in progress under subsection 82(1) of the Competition and Consumer Act 2010 when that subsection is so repealed will continue as if the repeal had not happened (see subsection 7(2) of the Acts Interpretation Act 1901)."@en ;
    cml:integrityHash "76cb46fa627e993603db2a8d0807967f64797a09345582c58a6cf97fa7597ae7" ;
    cof:pageNumber "102"^^xsd:integer ;
    skos:note "Recovery of loss or damage from contravention" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2019.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.102" ;
    cml:asserts concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31-norm .
