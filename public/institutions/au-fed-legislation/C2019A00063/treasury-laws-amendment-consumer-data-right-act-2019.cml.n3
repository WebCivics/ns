concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-8 a cml:Concept ;
    skos:prefLabel "8 At the end of section 29"@en ;
    cml:realizedBy doc:sch-1-sec-8 ;
    values:originalText "Add:  (5) This subsection covers information that:  (a) was acquired in the course of performing a function described in paragraph 9(1)(b) (about the consumer data right), or exercising a related power; or  (b) could be relevant to either of the following decisions:  (i) a decision under subsection 56CA(1) (about accreditation for the consumer data right) of the Competition and Consumer Act 2010;  (ii) a decision under the consumer data rules (within the meaning of that Act) relating to a person’s accreditation under subsection 56CA(1) of that Act." ;
    skos:definition "Add:  (5) This subsection covers information that:  (a) was acquired in the course of performing a function described in paragraph 9(1)(b) (about the consumer data right), or exercising a related power; or  (b) could be relevant to either of the following decisions:  (i) a decision under subsection 56CA(1) (about accreditation for the consumer data right) of the Competition and Consumer Act 2010;  (ii) a decision under the consumer data rules (within the meaning of that Act) relating to a person’s accreditation under subsection 56CA(1) of that Act."@en ;
    cml:integrityHash "31d0a693c0bb8b53d65adbd8291aed8811ab0252640571042038886b2a839ac5" ;
    cof:pageNumber "96"^^xsd:integer ;
    skos:note "Relevant information for accreditation decisions under the Competition and Consumer Act 2010" ;
    cml:curationStatus cml:Proposed ;
