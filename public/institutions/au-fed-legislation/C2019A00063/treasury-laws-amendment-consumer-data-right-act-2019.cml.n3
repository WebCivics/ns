concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ex a cml:Concept ;
    skos:prefLabel "56EX Injunctions"@en ;
    cml:realizedBy doc:sch-1-sec-56ex ;
    values:originalText "Enforceable provisions  (1) Each provision of the privacy safeguards is enforceable under Part 7 of the Regulatory Powers Act. Note: Part 7 of the Regulatory Powers Act creates a framework for using injunctions to enforce provisions.  Schedule 1  Consumer data right" ;
    skos:definition "Enforceable provisions  (1) Each provision of the privacy safeguards is enforceable under Part 7 of the Regulatory Powers Act. Note: Part 7 of the Regulatory Powers Act creates a framework for using injunctions to enforce provisions.  Schedule 1  Consumer data right"@en ;
    cml:integrityHash "00f5690f4775fe1792ad705b474a68c3dee686734cfffa9bd57867f541e4cff6" ;
    cof:pageNumber "75"^^xsd:integer ;
    skos:note "Enforceable provisions of privacy safeguards" ;
    cml:curationStatus cml:Proposed ;
