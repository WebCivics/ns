    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2019.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.75" .
