concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56fc a cml:Concept ;
    skos:prefLabel "56FC Data standards must be published"@en ;
    cml:realizedBy doc:sch-1-sec-56fc ;
    values:originalText "The Data Standards Chair must publish on the internet a copy of each data standard made under subsection 56FA(1). Note: Once published, the data standards will be available for free." ;
