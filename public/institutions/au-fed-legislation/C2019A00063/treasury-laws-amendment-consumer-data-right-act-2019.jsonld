    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-157aa-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "157AA(3) Disclosure of CDR-related information by Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-157aa-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
