      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nConsumer data right  Schedule 1\nMain amendments  Part 1\n\nNo. 63, 2019\nTreasury Laws Amendment (Consumer Data Right) Act 2019",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nConsumer data right  Schedule 1\nMain amendments  Part 1\n\nNo. 63, 2019\nTreasury Laws Amendment (Consumer Data Right) Act 2019",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sec-3-norm"
        }
      ],
      "cml:integrityHash": "a62e0e7049b9257119d9514f6fe849a5f9641a84ae8244371c3196b9bd1b3d5c",
      "skos:note": "Schedules have effect according to their terms."
    },
    {
