      "cml:integrityHash": "5627535b2ca475d2a88b5054719402bf95473f3ab0c06252496e1988f16fdd91",
      "skos:note": "Soliciting CDR data from CDR participant or through a designated gateway"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ef-ss-2",
      "@type": "cof:Section",
      "cof:title": "56EF(2) Privacy safeguard 3—soliciting CDR data from CDR",
      "values:kind": "subsection",
      "cof:pageNumber": 57,
      "values:originalText": "(2) Subsection (1) applies whether the collection is directly from the\nCDR participant or indirectly from the CDR participant through a\ndesignated gateway for the CDR data.\nNote:\nThe valid request referred to in paragraph (1)(a) could be given\nthrough a designated gateway (see section 56BG)."
    },
