    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ei-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "56EI(3) Privacy safeguard 6—use or disclosure of CDR data by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ei-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.58",
      "values:originalText": "(3) Neither subsection (1) nor (2) applies to the use or disclosure of\nCDR data for the purposes of direct marketing.\nNote:\nSection 56EJ deals with the use or disclosure of CDR data for the\npurposes of direct marketing.",
      "skos:definition": "(3) Neither subsection (1) nor (2) applies to the use or disclosure of\nCDR data for the purposes of direct marketing.\nNote:\nSection 56EJ deals with the use or disclosure of CDR data for the\npurposes of direct marketing.",
      "values:partOf": {
        "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ei"
      },
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ei-ss-3-norm"
        }
      ],
      "cml:integrityHash": "7de7040806a35a580700647a28924dbca529a5dcdef2847c56dd73069cd33309",
      "skos:note": "Exemption from subsections (1) and (2) for direct marketing purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ei-ss-3",
      "@type": "cof:Section",
      "cof:title": "56EI(3) Privacy safeguard 6—use or disclosure of CDR data by",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(3) Neither subsection (1) nor (2) applies to the use or disclosure of\nCDR data for the purposes of direct marketing.\nNote:\nSection 56EJ deals with the use or disclosure of CDR data for the\npurposes of direct marketing."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ei-ss-3-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
