    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gh",
      "@type": "cml:Concept",
      "skos:prefLabel": "56GH Review of the operation of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56gh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.93",
      "values:originalText": "(1) The Minister must cause an independent review to be conducted of\nthe operation of this Part.\n\n(2) The persons who conduct the review must complete it, and give the\nMinister a written report of the review, before 1 July 2022.\n\n(3) The Minister must cause copies of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe report is given to the Minister.",
      "skos:definition": "(1) The Minister must cause an independent review to be conducted of\nthe operation of this Part.\n\n(2) The persons who conduct the review must complete it, and give the\nMinister a written report of the review, before 1 July 2022.\n\n(3) The Minister must cause copies of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe report is given to the Minister.",
      "cml:hasPart": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gh-ss-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gh-ss-2"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gh-ss-3"
        }
      ],
      "cml:integrityHash": "93ddfbb80372d95c88ae7910e6eb485d7fe67af6dafdaf8498f2ad8978468b11"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56gh",
      "@type": "cof:Section",
      "cof:title": "56GH Review of the operation of this Part",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "(1) The Minister must cause an independent review to be conducted of\nthe operation of this Part.\n\n(2) The persons who conduct the review must complete it, and give the\nMinister a written report of the review, before 1 July 2022.\n\n(3) The Minister must cause copies of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe report is given to the Minister."
    },
