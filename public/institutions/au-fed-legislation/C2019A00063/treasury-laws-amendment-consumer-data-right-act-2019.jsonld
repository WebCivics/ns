      "cml:logicSummary": "Conditional obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the act or omission occurs wholly or partly in Australia, or wholly or partly on board an Australian aircraft or an Australian ship;",
      "cml:conclusionText": "the CDR provisions apply."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ao-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
