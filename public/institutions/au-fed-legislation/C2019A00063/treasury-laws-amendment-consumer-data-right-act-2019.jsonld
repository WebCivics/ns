        }
      ],
      "cml:integrityHash": "af8873c304122743afd591dbef64136f7cb2c064c35d4400d158d0e756fcd36b",
      "skos:note": "Provision for proving a finding or admission in court",
      "dc:description": "Document under the seal of the court or a document filed in the court"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ey-ss-4",
      "@type": "cof:Section",
      "cof:title": "56EY(4) Actions for damages",
      "values:kind": "subsection",
      "cof:pageNumber": 76,
      "values:originalText": "(4) The finding or admission may be proved by production of:\n\n(a) in any case—a document under the seal of the court from\nwhich the finding or admission appears; or\n\n(b) in the case of an admission—a document from which the\nadmission appears that is filed in the court.\nJurisdiction etc."
    },
