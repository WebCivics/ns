        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cn-ss-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cn-ss-2"
        }
      ],
      "cml:integrityHash": "0cfab2f6aa3ee38f1338ccb93838efd87ffd3d285479c31b95bf2d1c78a4cc37"
