    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cl-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CL(3) Functions, powers and annual report",
      "cml:realizedBy": {
