    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bp",
      "@type": "cml:Concept",
      "skos:prefLabel": "56BP Matters to which Commission must have regard when making",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56bp"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.38",
      "values:originalText": "the rules\n\nBefore making consumer data rules under subsection 56BA(1), the\nCommission must consider the kinds of matters referred to in\nparagraphs 56AD(1)(a) and (b).",
      "skos:definition": "the rules\n\nBefore making consumer data rules under subsection 56BA(1), the\nCommission must consider the kinds of matters referred to in\nparagraphs 56AD(1)(a) and (b).",
