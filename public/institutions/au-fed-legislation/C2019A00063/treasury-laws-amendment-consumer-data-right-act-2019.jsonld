    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ea",
      "@type": "cml:Concept",
      "skos:prefLabel": "56EA Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ea"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.51",
      "values:originalText": "This Division sets out privacy safeguards that protect the privacy\nor confidentiality of CDR consumers’ CDR data, whether the CDR\nconsumers are individuals or bodies corporate.\n\nSchedule 1  Consumer data right",
      "skos:definition": "This Division sets out privacy safeguards that protect the privacy\nor confidentiality of CDR consumers’ CDR data, whether the CDR\nconsumers are individuals or bodies corporate.\n\nSchedule 1  Consumer data right",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ea-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ea-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bb0fed24a4a450bc7e78574c275a30d1fc3b562fb3eb99ae60dc3e86ea2454cf",
      "skos:note": "Protects privacy of CDR consumers' data"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ea",
      "@type": "cof:Section",
      "cof:title": "56EA Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "This Division sets out privacy safeguards that protect the privacy\nor confidentiality of CDR consumers’ CDR data, whether the CDR\nconsumers are individuals or bodies corporate.\n\nSchedule 1  Consumer data right"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ea-norm",
      "@type": "values:Obligation",
      "cml:modality": {
