      "cml:premiseText": "(3) If a finding of any fact is made by a court...",
      "cml:conclusionText": "The finding or admission may be used as prima facie evidence in any proceeding under subsection (1)"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ey-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
