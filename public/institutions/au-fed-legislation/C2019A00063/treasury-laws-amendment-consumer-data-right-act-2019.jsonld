    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Paragraph 83(1)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-33"
      },
