    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gf-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "56GF(5) Constitutional basis",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56gf-ss-5"
