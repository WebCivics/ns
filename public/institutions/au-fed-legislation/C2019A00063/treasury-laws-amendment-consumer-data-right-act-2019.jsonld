      "cml:integrityHash": "892c75a5777da4e54623d90bbbccca29f81ad221b60b47d603aaebaf095cf11e",
      "skos:note": "Offence against subsection (1) committed by a person other than a body corporate is punishable."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56cc-ss-4",
      "@type": "cof:Section",
      "cof:title": "56CC(4) Prohibition on holding out—offence",
      "values:kind": "subsection",
      "cof:pageNumber": 44,
      "values:originalText": "(4) An offence against subsection (1) committed by a person other\nthan a body corporate is punishable on conviction by imprisonment\nfor not more than 5 years, a fine of not more than $500,000, or\nboth."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cc-ss-4-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
