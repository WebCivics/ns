      },
      "cml:premiseText": "(3) If a finding of any fact is made by a court...",
      "cml:conclusionText": "The finding or admission has a temporal relationship with the proceeding under subsection (1)"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ey-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "right",
      "cml:logicSummary": "Right to use prima facie evidence",
      "cml:executionSurface": "modalities::logic::deontic",
