        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bn-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5042023a4f93d73388522ee1deee322ab219673eb81ff5909c3fec554c6d21c4",
      "skos:note": "Prohibition on misleading or deceptive conduct"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56bn-ss-2",
      "@type": "cof:Section",
      "cof:title": "56BN(2) Misleading or deceptive conduct—offence",
      "values:kind": "subsection",
      "cof:pageNumber": 36,
      "values:originalText": "(2) Subsection (1) does not apply if the conduct is not misleading or\ndeceptive in a material particular.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection (see subsection 13.3(3) of the Criminal Code).\nPenalty—body corporate"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bn-ss-2-norm",
