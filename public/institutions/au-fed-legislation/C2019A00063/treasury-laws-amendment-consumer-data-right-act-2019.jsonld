        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eo-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must destroy redundant data",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "CDR entity is not required to retain the redundant data by or under an Australian law or a court/tribunal order.",
      "cml:conclusionText": "Destroy the redundant data"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eo-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must ensure de-identification of redundant data",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Redundant data does not relate to any current or anticipated legal proceedings; or dispute resolution proceedings; to which the CDR entity is a party.",
      "cml:conclusionText": "Ensure that the redundant data is de-identified"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eo-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Redundant data is not retained for more than a certain period of time",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the CDR entity is not required to retain the redundant data by or under an Australian law or a court/tribunal order.",
      "cml:conclusionText": "Not applicable"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eo-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "BUT",
      "cml:logicSummary": "Redundant data is retained for more than a certain period of time",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the CDR entity is not required to retain the redundant data by or under an Australian law or a court/tribunal order.",
      "cml:conclusionText": "Retain the redundant data"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ep",
      "@type": "cml:Concept",
      "skos:prefLabel": "56EP Privacy safeguard 13—correction of CDR data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ep"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.65",
      "values:originalText": "Obligation on data holders\n\n(1) If:\n\n(a) a CDR consumer for CDR data gives a request to a data\nholder of the CDR data (including a request given through a\ndesignated gateway for the CDR data); and\n\n(b) the request is for the data holder to correct the CDR data; and\n\n(c) the data holder was earlier required or authorised under the\nconsumer data rules to disclose the CDR data;\n\nSchedule 1  Consumer data right",
      "skos:definition": "Obligation on data holders\n\n(1) If:\n\n(a) a CDR consumer for CDR data gives a request to a data\nholder of the CDR data (including a request given through a\ndesignated gateway for the CDR data); and\n\n(b) the request is for the data holder to correct the CDR data; and\n\n(c) the data holder was earlier required or authorised under the\nconsumer data rules to disclose the CDR data;\n\nSchedule 1  Consumer data right",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ep-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ep-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e7c7bbc40371f7a4334d9bcf306841af328fefe8d7053d858a7a758d9a7bdc22",
      "skos:note": "Data holder must correct CDR data upon request from consumer."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ep",
      "@type": "cof:Section",
