        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The exemption applies to instruments made before the later of July 2020 and the end of the 3-month period starting on the day this Part commences.",
      "cml:conclusionText": "The exemption applies to instruments made before the defined temporal interval."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-2-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
