    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bl",
      "@type": "cml:Concept",
      "skos:prefLabel": "56BL Obligation to comply with consumer data rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56bl"
      },
