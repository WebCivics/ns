      ],
      "cml:integrityHash": "70030372266e7106d4b0366df0dc8c0f4aa31248ca15d73934df88e2bc1cf8ef",
      "skos:note": "Commission must consider certain matters when making consumer data rules."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56bp",
      "@type": "cof:Section",
      "cof:title": "56BP Matters to which Commission must have regard when making",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "the rules\n\nBefore making consumer data rules under subsection 56BA(1), the\nCommission must consider the kinds of matters referred to in\nparagraphs 56AD(1)(a) and (b)."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bp-norm",
      "@type": "values:Obligation",
      "cml:modality": {
