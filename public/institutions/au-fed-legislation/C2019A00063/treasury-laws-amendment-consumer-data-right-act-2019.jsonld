    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 At the end of section 29",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.96",
      "values:originalText": "Add:\n\n(5) This subsection covers information that:\n\n(a) was acquired in the course of performing a function\ndescribed in paragraph 9(1)(b) (about the consumer data\nright), or exercising a related power; or\n\n(b) could be relevant to either of the following decisions:\n\n(i) a decision under subsection 56CA(1) (about\naccreditation for the consumer data right) of the\nCompetition and Consumer Act 2010;\n\n(ii) a decision under the consumer data rules (within the\nmeaning of that Act) relating to a person’s accreditation\nunder subsection 56CA(1) of that Act.",
      "skos:definition": "Add:\n\n(5) This subsection covers information that:\n\n(a) was acquired in the course of performing a function\ndescribed in paragraph 9(1)(b) (about the consumer data\nright), or exercising a related power; or\n\n(b) could be relevant to either of the following decisions:\n\n(i) a decision under subsection 56CA(1) (about\naccreditation for the consumer data right) of the\nCompetition and Consumer Act 2010;\n\n(ii) a decision under the consumer data rules (within the\nmeaning of that Act) relating to a person’s accreditation\nunder subsection 56CA(1) of that Act.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-8-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "31d0a693c0bb8b53d65adbd8291aed8811ab0252640571042038886b2a839ac5",
      "skos:note": "Relevant information for accreditation decisions under the Competition and Consumer Act 2010"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 At the end of section 29",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "Add:\n\n(5) This subsection covers information that:\n\n(a) was acquired in the course of performing a function\ndescribed in paragraph 9(1)(b) (about the consumer data\nright), or exercising a related power; or\n\n(b) could be relevant to either of the following decisions:\n\n(i) a decision under subsection 56CA(1) (about\naccreditation for the consumer data right) of the\nCompetition and Consumer Act 2010;\n\n(ii) a decision under the consumer data rules (within the\nmeaning of that Act) relating to a person’s accreditation\nunder subsection 56CA(1) of that Act."
    },
