      "cml:integrityHash": "719679a4950fb63dbd35b8d7951d5f9edd6ebe2ff08abaf01c2edc9e61402925",
      "skos:note": "Must include information about the performance and exercise of Data Standards Chair's functions in annual report. Minister may grant Data Standards Chair leave of absence on terms and conditions determined by Minister.",
      "dc:description": "Yes"
    },
    {
