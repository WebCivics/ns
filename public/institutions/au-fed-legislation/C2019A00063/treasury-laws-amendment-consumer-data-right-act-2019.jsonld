    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56eu-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "56EU(4) Civil penalty provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56eu-ss-4"
