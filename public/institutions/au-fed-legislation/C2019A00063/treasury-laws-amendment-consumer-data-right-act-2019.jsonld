      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsections 56AD(2) and (3) of the Competition and Consumer Act 2010 do not apply.",
      "cml:conclusionText": "An instrument under subsection 56AC(2) is exempt."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
