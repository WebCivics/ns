      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cd",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CD Prohibition on holding out—civil penalty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56cd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.45",
      "values:originalText": "A person must not hold out that the person:\n\n(a) is an accredited person; or\n\n(b) is an accredited person holding an accreditation that has been\ngranted at a particular level (see paragraph 56BH(1)(d)); or\n\n(c) is an accredited data recipient of CDR data;\nif that is not the case.\nNote:\nFor enforcement, see Part VI (including section 76 for an order for\npayment of a pecuniary penalty).\nSubdivision B—Register of Accredited Persons",
      "skos:definition": "A person must not hold out that the person:\n\n(a) is an accredited person; or\n\n(b) is an accredited person holding an accreditation that has been\ngranted at a particular level (see paragraph 56BH(1)(d)); or\n\n(c) is an accredited data recipient of CDR data;\nif that is not the case.\nNote:\nFor enforcement, see Part VI (including section 76 for an order for\npayment of a pecuniary penalty).\nSubdivision B—Register of Accredited Persons",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cd-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cd-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0170bc605fe5a10fbbc39b61bcec1a5d48e03a68deaec3f1bbc1fe55ec87ac0b",
      "skos:note": "Prohibition on holding out that a person is accredited or has a specific accreditation level."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56cd",
      "@type": "cof:Section",
      "cof:title": "56CD Prohibition on holding out—civil penalty",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "A person must not hold out that the person:\n\n(a) is an accredited person; or\n\n(b) is an accredited person holding an accreditation that has been\ngranted at a particular level (see paragraph 56BH(1)(d)); or\n\n(c) is an accredited data recipient of CDR data;\nif that is not the case.\nNote:\nFor enforcement, see Part VI (including section 76 for an order for\npayment of a pecuniary penalty).\nSubdivision B—Register of Accredited Persons"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cd-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cd"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cd-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits holding out that a person is accredited or has a specific accreditation level.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ce",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CE Register of Accredited Persons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ce"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.45",
      "values:originalText": "(1) The Accreditation Registrar must establish and maintain a register\nfor the purposes of this Part, to be known as the Register of\nAccredited Persons.\n\n(2) The Accreditation Registrar must maintain the register by\nelectronic means.\n\n(3) The register is not a legislative instrument.\n\n(4) The consumer data rules may make provision for or in relation to\nthe following:\n\n(a) the inclusion in the register of entries for accredited persons;\n\n(b) the correction of entries in the register;\n\nSchedule 1  Consumer data right",
      "skos:definition": "(1) The Accreditation Registrar must establish and maintain a register\nfor the purposes of this Part, to be known as the Register of\nAccredited Persons.\n\n(2) The Accreditation Registrar must maintain the register by\nelectronic means.\n\n(3) The register is not a legislative instrument.\n\n(4) The consumer data rules may make provision for or in relation to\nthe following:\n\n(a) the inclusion in the register of entries for accredited persons;\n\n(b) the correction of entries in the register;\n\nSchedule 1  Consumer data right",
      "cml:hasPart": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ce-ss-1"
