    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56am-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "if",
      "cml:logicSummary": "Conditional obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The chargeable CDR data is used in chargeable circumstances if it meets specified conditions.",
      "cml:conclusionText": "The chargeable CDR data must be used in those circumstances."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56am-ss-3-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": ":",
      "cml:logicSummary": "Definition of chargeable CDR data",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The chargeable CDR data is used in chargeable circumstances if it meets specified conditions.",
      "cml:conclusionText": "The chargeable CDR data is defined as the information that meets those conditions."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56am-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ":",
      "cml:logicSummary": "Temporal relation between use and circumstances",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The chargeable CDR data is used in chargeable circumstances if it meets specified conditions.",
      "cml:conclusionText": "The use of the chargeable CDR data must occur within those circumstances."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56am-ss-3-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": ":",
      "cml:logicSummary": "Recurring trace of use and circumstances",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The chargeable CDR data is used in chargeable circumstances if it meets specified conditions.",
      "cml:conclusionText": "The use of the chargeable CDR data must recur within those circumstances."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56am-ss-3-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": ":",
      "cml:logicSummary": "Spread of information about use and circumstances",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The chargeable CDR data is used in chargeable circumstances if it meets specified conditions.",
      "cml:conclusionText": "The information about the use of the chargeable CDR data must spread within those circumstances."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56am-ss-3-logic-cogai-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": ":",
      "cml:logicSummary": "Artificial intelligence application to use and circumstances",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The chargeable CDR data is used in chargeable circumstances if it meets specified conditions.",
      "cml:conclusionText": "The artificial intelligence system must apply the rules for using the chargeable CDR data within those circumstances."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56an",
      "@type": "cml:Concept",
      "skos:prefLabel": "56AN Extension to external Territories",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56an"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.18",
      "values:originalText": "Each of the following provisions (the CDR provisions) extends to\nevery external Territory:\n\n(a) a provision of this Part;\n\n(b) a provision of the regulations made for the purposes of a\nprovision of this Part;\n\n(c) a provision of the consumer data rules;\n\n(d) another provision of this Act to the extent that it relates to a\nprovision covered by paragraph (a), (b) or (c);\n\n(e) a provision of the Regulatory Powers Act to the extent that it\napplies in relation to a provision of this Part;\n\n(f) a provision of the Privacy Act 1988 to the extent that it\napplies as described in section 56ES or 56ET of this Act.",
      "skos:definition": "Each of the following provisions (the CDR provisions) extends to\nevery external Territory:\n\n(a) a provision of this Part;\n\n(b) a provision of the regulations made for the purposes of a\nprovision of this Part;\n\n(c) a provision of the consumer data rules;\n\n(d) another provision of this Act to the extent that it relates to a\nprovision covered by paragraph (a), (b) or (c);\n\n(e) a provision of the Regulatory Powers Act to the extent that it\napplies in relation to a provision of this Part;\n\n(f) a provision of the Privacy Act 1988 to the extent that it\napplies as described in section 56ES or 56ET of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56an-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56an-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56an-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a39665554ad93caf39907b12f9924d9cd692919ac440ea0d8b6e6ae39e7984ec",
      "skos:note": "Extends provisions of this Part to external Territories"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56an",
      "@type": "cof:Section",
      "cof:title": "56AN Extension to external Territories",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Each of the following provisions (the CDR provisions) extends to\nevery external Territory:\n\n(a) a provision of this Part;\n\n(b) a provision of the regulations made for the purposes of a\nprovision of this Part;\n\n(c) a provision of the consumer data rules;\n\n(d) another provision of this Act to the extent that it relates to a\nprovision covered by paragraph (a), (b) or (c);\n\n(e) a provision of the Regulatory Powers Act to the extent that it\napplies in relation to a provision of this Part;\n\n(f) a provision of the Privacy Act 1988 to the extent that it\napplies as described in section 56ES or 56ET of this Act."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56an-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
