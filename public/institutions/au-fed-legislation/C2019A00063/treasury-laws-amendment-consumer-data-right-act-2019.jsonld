    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "56AA Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.7",
      "values:originalText": "The object of this Part is:\n\n(a) to enable consumers in certain sectors of the Australian\neconomy to require information relating to themselves in\nthose sectors to be disclosed safely, efficiently and\nconveniently:\n\n(i) to themselves for use as they see fit; or\n\n(ii) to accredited persons for use subject to privacy\nsafeguards; and\n\n(b) to enable any person to efficiently and conveniently access\ninformation in those sectors that:\n\n(i) is about goods (such as products) or services; and\n\n(ii) does not relate to any identifiable, or reasonably\nidentifiable, consumers; and\n\n(c) as a result of paragraphs (a) and (b), to create more choice\nand competition, or to otherwise promote the public interest.",
      "skos:definition": "The object of this Part is:\n\n(a) to enable consumers in certain sectors of the Australian\neconomy to require information relating to themselves in\nthose sectors to be disclosed safely, efficiently and\nconveniently:\n\n(i) to themselves for use as they see fit; or\n\n(ii) to accredited persons for use subject to privacy\nsafeguards; and\n\n(b) to enable any person to efficiently and conveniently access\ninformation in those sectors that:\n\n(i) is about goods (such as products) or services; and\n\n(ii) does not relate to any identifiable, or reasonably\nidentifiable, consumers; and\n\n(c) as a result of paragraphs (a) and (b), to create more choice\nand competition, or to otherwise promote the public interest.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56aa-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5f6d47852e1b3b53b50431c8ff693b108e0f42d95bdb6717b28891856dd1b42a",
      "skos:note": "To enable consumers in certain sectors of the Australian economy to require information relating to themselves."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56aa",
      "@type": "cof:Section",
      "cof:title": "56AA Object of this Part",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "The object of this Part is:\n\n(a) to enable consumers in certain sectors of the Australian\neconomy to require information relating to themselves in\nthose sectors to be disclosed safely, efficiently and\nconveniently:\n\n(i) to themselves for use as they see fit; or\n\n(ii) to accredited persons for use subject to privacy\nsafeguards; and\n\n(b) to enable any person to efficiently and conveniently access\ninformation in those sectors that:\n\n(i) is about goods (such as products) or services; and\n\n(ii) does not relate to any identifiable, or reasonably\nidentifiable, consumers; and\n\n(c) as a result of paragraphs (a) and (b), to create more choice\nand competition, or to otherwise promote the public interest."
    },
