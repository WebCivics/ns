      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) An exemption under paragraph (2)(a) or (b), or a declaration under paragraph (2)(c):"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ge-ss-3-logic-deontic-2",
