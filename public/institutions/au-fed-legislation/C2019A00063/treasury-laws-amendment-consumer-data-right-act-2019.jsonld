      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the act or omission is by (or on behalf of) an Australian person;",
      "cml:conclusionText": "the CDR provisions apply."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ao-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
