        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bl-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "844e70f97e4e755b808f2a2de181283e0dd2a7921287b89bd1dcbb82185531bc",
      "skos:note": "Consumer data rules may provide for civil penalty provisions."
    },
