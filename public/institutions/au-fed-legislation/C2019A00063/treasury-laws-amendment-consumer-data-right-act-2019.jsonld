    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gg-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "56GG(3) Compensation for acquisition of property",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56gg-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.92",
      "values:originalText": "(3) If the 2 persons do not agree on the amount of the compensation,\nthe person to whom compensation is payable may institute\nproceedings in:\n\n(a) the Federal Court; or\n\n(b) the Supreme Court of a State or Territory;\nfor the recovery from the other person of such reasonable amount\nof compensation as the Court determines.",
      "skos:definition": "(3) If the 2 persons do not agree on the amount of the compensation,\nthe person to whom compensation is payable may institute\nproceedings in:\n\n(a) the Federal Court; or\n\n(b) the Supreme Court of a State or Territory;\nfor the recovery from the other person of such reasonable amount\nof compensation as the Court determines.",
      "values:partOf": {
        "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56gg"
      },
      "cml:asserts": [
