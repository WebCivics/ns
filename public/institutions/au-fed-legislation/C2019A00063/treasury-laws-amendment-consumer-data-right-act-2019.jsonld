      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.36",
      "values:originalText": "(2) Subsection (1) does not apply if the conduct is not misleading or\ndeceptive in a material particular.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection (see subsection 13.3(3) of the Criminal Code).\nPenalty—body corporate",
      "skos:definition": "(2) Subsection (1) does not apply if the conduct is not misleading or\ndeceptive in a material particular.\nNote:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection (see subsection 13.3(3) of the Criminal Code).\nPenalty—body corporate",
      "values:partOf": {
        "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bn"
      },
      "cml:asserts": [
        {
