      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.96",
      "values:originalText": "The consumer data right matters are a statement of the\nperformance of the functions conferred as described in\nparagraph 9(1)(b).\nCompetition and Consumer Act 2010",
      "skos:definition": "The consumer data right matters are a statement of the\nperformance of the functions conferred as described in\nparagraph 9(1)(b).\nCompetition and Consumer Act 2010",
      "cml:asserts": [
