    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56fg",
      "@type": "cml:Concept",
      "skos:prefLabel": "56FG Appointment of the Data Standards Chair",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56fg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.82",
      "values:originalText": "(1) The Data Standards Chair is to be appointed, on a full-time basis or\na part-time basis, by the Minister by written instrument.\n\n(2) The Data Standards Chair holds office for the period specified in\nthe instrument of appointment. The period must not exceed 3 years.\nNote 1:\nThe Minister will be the Data Standards Chair in the absence of an\nappointment under this section (see the definition of Data Standards\nChair in subsection 4(1)).\nNote 2:\nThe Data Standards Chair may be reappointed (see section 33AA of\nthe Acts Interpretation Act 1901).",
      "skos:definition": "(1) The Data Standards Chair is to be appointed, on a full-time basis or\na part-time basis, by the Minister by written instrument.\n\n(2) The Data Standards Chair holds office for the period specified in\nthe instrument of appointment. The period must not exceed 3 years.\nNote 1:\nThe Minister will be the Data Standards Chair in the absence of an\nappointment under this section (see the definition of Data Standards\nChair in subsection 4(1)).\nNote 2:\nThe Data Standards Chair may be reappointed (see section 33AA of\nthe Acts Interpretation Act 1901).",
      "cml:hasPart": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56fg-ss-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56fg-ss-2"
        }
      ],
      "cml:integrityHash": "1ac7f24902c79391f0c0e6027d47dbcd1296e475c589104639b1b03bdca76571"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56fg",
      "@type": "cof:Section",
      "cof:title": "56FG Appointment of the Data Standards Chair",
      "values:kind": "section",
      "cof:pageNumber": 82,
      "values:originalText": "(1) The Data Standards Chair is to be appointed, on a full-time basis or\na part-time basis, by the Minister by written instrument.\n\n(2) The Data Standards Chair holds office for the period specified in\nthe instrument of appointment. The period must not exceed 3 years.\nNote 1:\nThe Minister will be the Data Standards Chair in the absence of an\nappointment under this section (see the definition of Data Standards\nChair in subsection 4(1)).\nNote 2:\nThe Data Standards Chair may be reappointed (see section 33AA of\nthe Acts Interpretation Act 1901)."
    },
