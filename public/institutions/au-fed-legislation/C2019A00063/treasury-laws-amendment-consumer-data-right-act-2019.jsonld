      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The exemption takes effect after the later of July 2020 and the end of the 3-month period starting on the day this Part commences.",
      "cml:conclusionText": "The exemption takes effect after July 2020 or the end of the 3-month period."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-2-logic-ltl-3",
