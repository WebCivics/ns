      },
      "cml:premiseText": "Small business operator with accreditation under subsection 56CA(1) of the Competition and Consumer Act 2010",
      "cml:conclusionText": "This Act applies"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-79-logic-alleninterval-2",
