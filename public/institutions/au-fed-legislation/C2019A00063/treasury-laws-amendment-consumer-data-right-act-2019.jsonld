      "cml:conclusionText": "The person has the right to use the finding or admission as prima facie evidence in any proceeding under subsection (1)"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ey-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "56EY(4) Actions for damages",
      "cml:realizedBy": {
