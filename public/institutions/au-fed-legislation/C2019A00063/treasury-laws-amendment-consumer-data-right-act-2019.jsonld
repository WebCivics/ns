          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ak-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "36755cb064db6951e6bf8388355981903cb9e78b62807591efa5b3b1cf6e9266",
      "skos:note": "Must be an accredited data recipient to hold CDR data"
    },
