      "@type": "cml:Concept",
      "skos:prefLabel": "56FM Terms and conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56fm"
