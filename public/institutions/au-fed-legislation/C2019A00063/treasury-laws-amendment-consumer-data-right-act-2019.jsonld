    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56bw-ss-3",
      "@type": "cof:Section",
      "cof:title": "56BW(3) Review by the Tribunal of determinations specifying",
      "values:kind": "subsection",
