    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cb",
      "@type": "cml:Concept",
      "skos:prefLabel": "56CB Review of decisions refusing to accredit",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56cb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.44",
      "values:originalText": "Applications may be made to the Administrative Appeals Tribunal\nfor review of decisions of the Data Recipient Accreditor under\nsubsection 56CA(1) refusing to accredit persons.\nNote:\nFor AAT review of decisions to vary, suspend or revoke\naccreditations, see subsection 56BH(4).",
      "skos:definition": "Applications may be made to the Administrative Appeals Tribunal\nfor review of decisions of the Data Recipient Accreditor under\nsubsection 56CA(1) refusing to accredit persons.\nNote:\nFor AAT review of decisions to vary, suspend or revoke\naccreditations, see subsection 56BH(4).",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cb-norm"
        }
      ],
      "cml:integrityHash": "5de282492ca0ecb1658c66be395be903e24742495ba1791e66de63fe04073c36",
      "skos:note": "Review of decisions refusing to accredit"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56cb",
      "@type": "cof:Section",
      "cof:title": "56CB Review of decisions refusing to accredit",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "Applications may be made to the Administrative Appeals Tribunal\nfor review of decisions of the Data Recipient Accreditor under\nsubsection 56CA(1) refusing to accredit persons.\nNote:\nFor AAT review of decisions to vary, suspend or revoke\naccreditations, see subsection 56BH(4)."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56cb-norm",
      "@type": "values:Obligation",
      "cml:modality": {
