    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bo",
      "@type": "cml:Concept",
      "skos:prefLabel": "56BO Misleading or deceptive conduct—civil penalty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56bo"
