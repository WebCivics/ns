        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-157aa-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "54c804d1ab5749b91533004bbc5aec89f544537e90d2d560a9a461148a76a240",
      "skos:note": "Disclosure of CDR-related information to certain agencies"
    },
    {
