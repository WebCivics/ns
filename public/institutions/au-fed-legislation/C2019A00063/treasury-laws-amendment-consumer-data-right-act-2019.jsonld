    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Subsection 82(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.102",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A person who suffers loss or damage by conduct of another person\nthat was done in contravention of:\n\n(a) a provision of Part IV or IVB; or\n\n(b) section 55B, 60C or 60K; or\n\n(c) subsection 56BN(1), 56BO(1), 56BU(1) or 56CC(1) or\nsection 56CD; or\n\n(d) a civil penalty provision of the consumer data rules;\nmay recover the amount of the loss or damage by action against\nthat other person or against any person involved in the\ncontravention.\nNote:\nAny legal proceeding in progress under subsection 82(1) of the Competition and\nConsumer Act 2010 when that subsection is so repealed will continue as if the repeal\nhad not happened (see subsection 7(2) of the Acts Interpretation Act 1901).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) A person who suffers loss or damage by conduct of another person\nthat was done in contravention of:\n\n(a) a provision of Part IV or IVB; or\n\n(b) section 55B, 60C or 60K; or\n\n(c) subsection 56BN(1), 56BO(1), 56BU(1) or 56CC(1) or\nsection 56CD; or\n\n(d) a civil penalty provision of the consumer data rules;\nmay recover the amount of the loss or damage by action against\nthat other person or against any person involved in the\ncontravention.\nNote:\nAny legal proceeding in progress under subsection 82(1) of the Competition and\nConsumer Act 2010 when that subsection is so repealed will continue as if the repeal\nhad not happened (see subsection 7(2) of the Acts Interpretation Act 1901).",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "76cb46fa627e993603db2a8d0807967f64797a09345582c58a6cf97fa7597ae7",
      "skos:note": "Recovery of loss or damage from contravention"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Subsection 82(1)",
      "values:kind": "section",
      "cof:pageNumber": 102,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A person who suffers loss or damage by conduct of another person\nthat was done in contravention of:\n\n(a) a provision of Part IV or IVB; or\n\n(b) section 55B, 60C or 60K; or\n\n(c) subsection 56BN(1), 56BO(1), 56BU(1) or 56CC(1) or\nsection 56CD; or\n\n(d) a civil penalty provision of the consumer data rules;\nmay recover the amount of the loss or damage by action against\nthat other person or against any person involved in the\ncontravention.\nNote:\nAny legal proceeding in progress under subsection 82(1) of the Competition and\nConsumer Act 2010 when that subsection is so repealed will continue as if the repeal\nhad not happened (see subsection 7(2) of the Acts Interpretation Act 1901)."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-31"
