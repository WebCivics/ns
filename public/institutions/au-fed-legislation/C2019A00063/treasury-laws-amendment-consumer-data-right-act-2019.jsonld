    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-70",
      "@type": "cof:Section",
      "cof:title": "70 After section 157A",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "Insert:\n\nConsumer data right  Schedule 1\nOther amendments  Part 2\n\nNo. 63, 2019\nTreasury Laws Amendment (Consumer Data Right) Act 2019"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-70-norm",
      "@type": "values:Undertaking",
