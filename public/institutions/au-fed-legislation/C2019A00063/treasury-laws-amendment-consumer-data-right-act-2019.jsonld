      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibits charging a fee in inappropriate circumstances when required",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
