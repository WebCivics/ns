    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56cc-ss-1",
      "@type": "cof:Section",
      "cof:title": "56CC(1) Prohibition on holding out—offence",
      "values:kind": "subsection",
      "cof:pageNumber": 44,
      "values:originalText": "(1) A person commits an offence if the person holds out that the\nperson:\n\n(a) is an accredited person; or\n\n(b) is an accredited person holding an accreditation that has been\ngranted at a particular level (see paragraph 56BH(1)(d)); or\n\n(c) is an accredited data recipient of CDR data;\nif that is not the case.\nPenalty—body corporate"
    },
