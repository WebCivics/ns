    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56bn-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "56BN(2) Misleading or deceptive conduct—offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56bn-ss-2"
