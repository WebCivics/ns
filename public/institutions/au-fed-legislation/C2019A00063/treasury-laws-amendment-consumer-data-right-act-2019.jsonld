      "skos:note": "Statement of performance of functions conferred under the Competition and Consumer Act 2010"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-32a",
      "@type": "cof:Section",
