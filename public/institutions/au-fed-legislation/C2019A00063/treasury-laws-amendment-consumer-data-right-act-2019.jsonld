      ],
      "cml:integrityHash": "fb9964648d635cbed3bb21d4d8c9c7485b6857bcdcde100dc6061488e45ed2c7",
      "skos:note": "Limitation on pecuniary penalty liability"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56eu-ss-6",
      "@type": "cof:Section",
