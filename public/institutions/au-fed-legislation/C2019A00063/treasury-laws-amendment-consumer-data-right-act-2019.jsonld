        }
      ],
      "cml:integrityHash": "979779fab48356f4c570496c15c67aa3d609bfcb515c01208d8bc4bf7a018ab7",
      "skos:note": "Section applies in relation to a proceeding under subsection (1) of this section as if paragraph 86A(1)(b) also referred to a matter for determination arising under the privacy safeguards."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ey-ss-7",
      "@type": "cof:Section",
      "cof:title": "56EY(7) Actions for damages",
      "values:kind": "subsection",
      "cof:pageNumber": 76,
      "values:originalText": "(7) Section 86A (about transfer of matters) applies in relation to a\nproceeding under subsection (1) of this section as if\nparagraph 86A(1)(b) also referred to a matter for determination\narising under:\n\n(a) a provision of the privacy safeguards; or\n\nSchedule 1  Consumer data right"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ey-ss-7-norm",
