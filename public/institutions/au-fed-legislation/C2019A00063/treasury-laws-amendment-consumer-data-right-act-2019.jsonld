    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ey-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "56EY(7) Actions for damages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2019#sch-1-sec-56ey-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2019.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2019.pdf, p.76",
      "values:originalText": "(7) Section 86A (about transfer of matters) applies in relation to a\nproceeding under subsection (1) of this section as if\nparagraph 86A(1)(b) also referred to a matter for determination\narising under:\n\n(a) a provision of the privacy safeguards; or\n\nSchedule 1  Consumer data right",
      "skos:definition": "(7) Section 86A (about transfer of matters) applies in relation to a\nproceeding under subsection (1) of this section as if\nparagraph 86A(1)(b) also referred to a matter for determination\narising under:\n\n(a) a provision of the privacy safeguards; or\n\nSchedule 1  Consumer data right",
      "values:partOf": {
        "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2019-sch-1-sec-56ey"
      },
      "cml:asserts": [
