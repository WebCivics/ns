      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-16-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Records produced during a private session are classified as records produced by the Commission.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Classification of records produced during a private session as records produced by the Commission.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "classify",
      "cml:premiseText": "(4) Section 9 (custody and use of records of Royal Commission)"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-16-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Records produced during a private session must be treated as if they were produced by the Commission.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to treat records produced during a private session as if they were produced by the Commission.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:premiseText": "(4) Section 9 (custody and use of records of Royal Commission)"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-16-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The obligation to treat records produced during a private session as if they were produced by the Commission diffuses to the Commission's staff and members.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Spread of obligations from the Commission to its staff and members.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuse",
      "cml:premiseText": "(4) Section 9 (custody and use of records of Royal Commission)"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-16-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Records produced during a private session occur until the production of records by the Commission.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Temporal relationship between records produced during a private session and those produced by the Commission.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:premiseText": "(4) Section 9 (custody and use of records of Royal Commission)"
