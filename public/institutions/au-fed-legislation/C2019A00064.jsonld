      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1",
      "@type": "cml:Concept",
      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.7",
      "skos:note": "Definition of staff member for Royal Commission",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "1 Subsection 1B(1)"
      },
      "wasDerivedFrom": "royal-commissions-amendment-private-sessions-act-2019.pdf",
      "asserts": [
        "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-norm",
        "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-descriptionlogic-1",
        "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-alleninterval-2",
        "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-3",
        "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-4",
        "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-5",
        "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "e7c19409080af5912757b462cccf9c817cb64aaf68e1ea17ffab4ba0e8f7e14d",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-1",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employment of a staff member is included in the temporal interval of the person's engagement",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal relation",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "includes",
      "cml:premiseText": "A staff member may be employed by a person who performs functions or duties for the Commission"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The engagement of a staff member is included in the set of persons who are contractors for the Commission",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Inclusive relation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "A staff member may be engaged by, or on behalf of, the Commonwealth as a contractor"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The appointment of a person is included in the set of persons who are appointed to assist the Commission",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Inclusive relation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "A person may be appointed or otherwise engaged by, or on behalf of, the Commonwealth to assist the Commission as counsel"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The appointment of a legal practitioner is included in the set of persons who are appointed to assist the Commission",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Inclusive relation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "A legal practitioner may be appointed by the Attorney-General to assist the Commission"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The employment of a person is included in the set of persons who are engaged by, or on behalf of, the Commonwealth as contractors for the Commission",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Inclusive relation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:premiseText": "A person may be employed by a person to whom paragraph (b) or this paragraph applies"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Staff member is a class in the Commission's hierarchy",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Staff member is a person who performs functions or duties relating to the Commission"
    },
