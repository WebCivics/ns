    cml:premiseText "(3) Sections 6F (power of Commission in relation to documents and other things), 6P (Commission may communicate information) and 9 (custody and use of records of Royal Commission) apply as if..." ;
    cml:conclusionText "...were produced before, delivered or given to, or otherwise obtained or received by, the Commission." ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-16-ss-3 a cof:Section ;
    cof:title "16(3) Subsections 6OC(3) and (4)" ;
    values:kind "subsection" ;
    values:originalText "(3) Sections 6F (power of Commission in relation to documents and other things), 6P (Commission may communicate information) and 9 (custody and use of records of Royal Commission) apply as if information, a document, record or other thing that was:  (a) obtained at a private session for a Royal Commission by a member holding the private session; or  (b) given to a member, or member of the staff, of a Royal Commission for the purposes of a private session (whether or  Schedule 1  Main amendments  Royal Commissions Amendment (Private Sessions) Act 2019 No. 64, 2019  not a private session was, or is to be, held for the Commission); were produced before, delivered or given to, or otherwise obtained or received by, the Commission." ;
    cof:pageNumber "9"^^xsd:integer .

concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-16-ss-4 a cml:Concept ;
    skos:prefLabel "16(4) Subsections 6OC(3) and (4)"@en ;
    cml:realizedBy doc:sch-1-sec-16-ss-4 ;
    values:originalText "(4) Section 9 (custody and use of records of Royal Commission) also applies as if a record that was produced:  (a) at a private session for a Royal Commission by a member holding the private session; or  (b) by a member, or member of the staff, of a Royal Commission for the purposes of a private session (whether or not a private session was, or is to be, held for the Commission); were produced by the Commission." ;
    skos:definition "(4) Section 9 (custody and use of records of Royal Commission) also applies as if a record that was produced:  (a) at a private session for a Royal Commission by a member holding the private session; or  (b) by a member, or member of the staff, of a Royal Commission for the purposes of a private session (whether or not a private session was, or is to be, held for the Commission); were produced by the Commission."@en ;
    cml:integrityHash "5209452ce54d2960710d46dc1f4a04ac52c5426457cef7e2bd87b6cbb7773113" ;
    values:partOf concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-16 ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Records produced during a private session must be treated as if they were produced by the Commission." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
