concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-31 a cml:Concept ;
    skos:prefLabel "31 Subparagraphs 6OH(c)(iii) and (iv)"@en ;
    cml:realizedBy doc:sch-1-sec-31 ;
    values:originalText "Repeal the subparagraphs, substitute:  (iii) in the case of information referred to in subparagraph (a)(i) or (ii)—the person makes the record  Schedule 1  Main amendments  Royal Commissions Amendment (Private Sessions) Act 2019 No. 64, 2019  of, uses or discloses the information with the consent of the person who gave the information at the private session;  (iv) in the case of information referred to in subparagraph (a)(iii)—the person makes the record of, uses or discloses the information with the consent of the person who gave the information to the member, or member of the staff, of the Commission." ;
    skos:definition "Repeal the subparagraphs, substitute:  (iii) in the case of information referred to in subparagraph (a)(i) or (ii)—the person makes the record  Schedule 1  Main amendments  Royal Commissions Amendment (Private Sessions) Act 2019 No. 64, 2019  of, uses or discloses the information with the consent of the person who gave the information at the private session;  (iv) in the case of information referred to in subparagraph (a)(iii)—the person makes the record of, uses or discloses the information with the consent of the person who gave the information to the member, or member of the staff, of the Commission."@en ;
    cml:integrityHash "12aa17dae9e5333fd5c84dc2de26f00fc4bd02dbd7da27ce22559ccab9ead934" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Substitute subparagraphs with new obligations regarding information handling." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
