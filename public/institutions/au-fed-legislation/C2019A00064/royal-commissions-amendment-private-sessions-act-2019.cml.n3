concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-33 a cml:Concept ;
    skos:prefLabel "33 At the end of section 6OH"@en ;
    cml:realizedBy doc:sch-1-sec-33 ;
    values:originalText "Add: Note 2: The person who gave the information at the private session, or to the member, or member of the staff, of the Royal Commission, does not commit an offence under this section by making a record of, using or disclosing the information, because the person is not covered by paragraph (a)." ;
    skos:definition "Add: Note 2: The person who gave the information at the private session, or to the member, or member of the staff, of the Royal Commission, does not commit an offence under this section by making a record of, using or disclosing the information, because the person is not covered by paragraph (a)."@en ;
    cml:integrityHash "d21b684c9100f1bb2a6c34898f2abc7ac67b3c428caae475dbc6b9451c203459" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "No offence under this section for making a record of information not covered by paragraph (a)." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
