      },
      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.12",
      "values:originalText": "Add:\nNote 2:\nThe person who gave the information at the private session, or to the\nmember, or member of the staff, of the Royal Commission, does not\ncommit an offence under this section by making a record of, using or\ndisclosing the information, because the person is not covered by\nparagraph (a).",
      "skos:definition": "Add:\nNote 2:\nThe person who gave the information at the private session, or to the\nmember, or member of the staff, of the Royal Commission, does not\ncommit an offence under this section by making a record of, using or\ndisclosing the information, because the person is not covered by\nparagraph (a).",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-33-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-33-logic-deontic-1"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-33-logic-alleninterval-2"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-33-logic-diffusion-3"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-33-logic-cogai-4"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-33-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "d21b684c9100f1bb2a6c34898f2abc7ac67b3c428caae475dbc6b9451c203459",
      "skos:note": "No offence under this section for making a record of information not covered by paragraph (a)."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-33",
      "@type": "cof:Section",
      "cof:title": "33 At the end of section 6OH",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Add:\nNote 2:\nThe person who gave the information at the private session, or to the\nmember, or member of the staff, of the Royal Commission, does not\ncommit an offence under this section by making a record of, using or\ndisclosing the information, because the person is not covered by\nparagraph (a)."
    },
