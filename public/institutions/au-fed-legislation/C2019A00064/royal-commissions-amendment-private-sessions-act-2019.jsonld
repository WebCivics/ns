      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Permission to determine matters",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Commission members are allowed to determine matters during private sessions.",
      "cml:conclusionText": "Commission members can determine matters during private sessions."
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6ob-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Duty to determine matters",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commission members are required to determine matters during private sessions.",
      "cml:conclusionText": "Commission members must determine matters during private sessions."
    },
