    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 At the end of section 6OH",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
