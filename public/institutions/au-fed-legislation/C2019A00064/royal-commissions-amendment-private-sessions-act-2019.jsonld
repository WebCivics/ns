    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Section 6OJ",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-34"
      },
