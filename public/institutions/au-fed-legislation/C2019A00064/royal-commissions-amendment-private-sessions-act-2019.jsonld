      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.12",
      "values:originalText": "Omit “information at a private session.”, substitute:\n\ninformation:\n\n(a) in the case of information referred to in\nsubparagraph 6OH(a)(i) or (ii)—at the private session; or\n\n(b) in the case of information referred to in\nsubparagraph 6OH(a)(iii)—to the member, or member of the\nstaff, of the Commission.\n\nMain amendments  Schedule 1\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019",
      "skos:definition": "Omit “information at a private session.”, substitute:\n\ninformation:\n\n(a) in the case of information referred to in\nsubparagraph 6OH(a)(i) or (ii)—at the private session; or\n\n(b) in the case of information referred to in\nsubparagraph 6OH(a)(iii)—to the member, or member of the\nstaff, of the Commission.\n\nMain amendments  Schedule 1\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-36-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-36-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "283cbfab6961e79d12d33e3f4310e8a42d9527ca1fdd9877c478b6960e819ce3",
      "skos:note": "Omit “information at a private session.”"
    },
