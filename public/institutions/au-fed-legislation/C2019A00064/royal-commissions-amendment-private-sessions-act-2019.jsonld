      },
      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nMain amendments  Schedule 1\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nMain amendments  Schedule 1\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sec-3-norm"
        }
      ],
      "cml:integrityHash": "1229d530e121572c7ff4d068b3ef89cfde2f693d12a56455aa983dfac4ebef5f",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nMain amendments  Schedule 1\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019"
    },
