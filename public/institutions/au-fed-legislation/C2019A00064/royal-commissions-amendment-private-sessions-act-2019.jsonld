      },
      "cml:premiseText": "Staff member is a person who performs functions or duties relating to the Commission",
      "cml:conclusionText": "Staff member is a class in the Commission's hierarchy"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Temporal relation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A staff member may be employed by a person who performs functions or duties for the Commission",
      "cml:conclusionText": "The employment of a staff member is included in the temporal interval of the person's engagement"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Inclusive relation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A staff member may be engaged by, or on behalf of, the Commonwealth as a contractor",
      "cml:conclusionText": "The engagement of a staff member is included in the set of persons who are contractors for the Commission"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Inclusive relation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person may be appointed or otherwise engaged by, or on behalf of, the Commonwealth to assist the Commission as counsel",
      "cml:conclusionText": "The appointment of a person is included in the set of persons who are appointed to assist the Commission"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Inclusive relation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A legal practitioner may be appointed by the Attorney-General to assist the Commission",
      "cml:conclusionText": "The appointment of a legal practitioner is included in the set of persons who are appointed to assist the Commission"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Inclusive relation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person may be employed by a person to whom paragraph (b) or this paragraph applies",
      "cml:conclusionText": "The employment of a person is included in the set of persons who are engaged by, or on behalf of, the Commonwealth as contractors for the Commission"
    },
