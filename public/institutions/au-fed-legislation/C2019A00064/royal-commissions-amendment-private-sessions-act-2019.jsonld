    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 1B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-private-sessions-act-2019.pdf"
      },
      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.7",
      "values:originalText": "Insert:\nmember of the staff, of a Royal Commission, means any of the\nfollowing:\n\n(a) an APS employee who performs functions or duties relating\nto, or for the purposes of, the Commission;\n\n(b) a person engaged by, or on behalf of, the Commonwealth as a\ncontractor to perform functions or duties relating to, or for\nthe purposes of, the Commission;\n\n(c) a person who:\n\n(i) is engaged, or employed, by a person to whom\nparagraph (b) or this paragraph applies; and\n\n(ii) performs functions or duties for the Commission in\nconnection with that engagement or employment;\n\n(d) a person who:\n\n(i) is a legal practitioner appointed by the Attorney-General\nto assist the Commission; or\n\n(ii) is appointed or otherwise engaged by, or on behalf of,\nthe Commonwealth to assist the Commission as\ncounsel.",
      "skos:definition": "Insert:\nmember of the staff, of a Royal Commission, means any of the\nfollowing:\n\n(a) an APS employee who performs functions or duties relating\nto, or for the purposes of, the Commission;\n\n(b) a person engaged by, or on behalf of, the Commonwealth as a\ncontractor to perform functions or duties relating to, or for\nthe purposes of, the Commission;\n\n(c) a person who:\n\n(i) is engaged, or employed, by a person to whom\nparagraph (b) or this paragraph applies; and\n\n(ii) performs functions or duties for the Commission in\nconnection with that engagement or employment;\n\n(d) a person who:\n\n(i) is a legal practitioner appointed by the Attorney-General\nto assist the Commission; or\n\n(ii) is appointed or otherwise engaged by, or on behalf of,\nthe Commonwealth to assist the Commission as\ncounsel.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-alleninterval-2"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-3"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-4"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-5"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-1-logic-deontic-6"
        }
      ],
      "cml:integrityHash": "e7c19409080af5912757b462cccf9c817cb64aaf68e1ea17ffab4ba0e8f7e14d",
      "skos:note": "Definition of staff member for Royal Commission"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 1B(1)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\nmember of the staff, of a Royal Commission, means any of the\nfollowing:\n\n(a) an APS employee who performs functions or duties relating\nto, or for the purposes of, the Commission;\n\n(b) a person engaged by, or on behalf of, the Commonwealth as a\ncontractor to perform functions or duties relating to, or for\nthe purposes of, the Commission;\n\n(c) a person who:\n\n(i) is engaged, or employed, by a person to whom\nparagraph (b) or this paragraph applies; and\n\n(ii) performs functions or duties for the Commission in\nconnection with that engagement or employment;\n\n(d) a person who:\n\n(i) is a legal practitioner appointed by the Attorney-General\nto assist the Commission; or\n\n(ii) is appointed or otherwise engaged by, or on behalf of,\nthe Commonwealth to assist the Commission as\ncounsel."
    },
