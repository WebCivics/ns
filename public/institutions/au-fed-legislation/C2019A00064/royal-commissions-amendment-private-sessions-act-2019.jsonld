      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.10",
      "values:originalText": "Add:\n\nMain amendments  Schedule 1\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019\n\n; (c) a statement or disclosure made by the person to a member, or\nmember of the staff, of a Royal Commission for the purposes\nof a private session (whether or not a private session was, or\nis to be, held for the Commission).",
      "skos:definition": "Add:\n\nMain amendments  Schedule 1\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019\n\n; (c) a statement or disclosure made by the person to a member, or\nmember of the staff, of a Royal Commission for the purposes\nof a private session (whether or not a private session was, or\nis to be, held for the Commission).",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-23-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2afb7c4e271af928b674d0a672974a2307a0e2d744833c204b0e21ceafa81d99",
      "skos:note": "Statement disclosure obligation",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-23",
      "@type": "cof:Section",
      "cof:title": "23 At the end of subsection 6OE(1)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Add:\n\nMain amendments  Schedule 1\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019\n\n; (c) a statement or disclosure made by the person to a member, or\nmember of the staff, of a Royal Commission for the purposes\nof a private session (whether or not a private session was, or\nis to be, held for the Commission)."
    },
