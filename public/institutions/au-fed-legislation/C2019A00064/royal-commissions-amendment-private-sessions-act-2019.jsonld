      "skos:prefLabel": "31 Subparagraphs 6OH(c)(iii) and (iv)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-private-sessions-act-2019.pdf"
      },
      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.11",
      "values:originalText": "Repeal the subparagraphs, substitute:\n\n(iii) in the case of information referred to in\nsubparagraph (a)(i) or (ii)—the person makes the record\n\nSchedule 1  Main amendments\n\nRoyal Commissions Amendment (Private Sessions) Act 2019\nNo. 64, 2019\n\nof, uses or discloses the information with the consent of\nthe person who gave the information at the private\nsession;\n\n(iv) in the case of information referred to in\nsubparagraph (a)(iii)—the person makes the record of,\nuses or discloses the information with the consent of the\nperson who gave the information to the member, or\nmember of the staff, of the Commission.",
      "skos:definition": "Repeal the subparagraphs, substitute:\n\n(iii) in the case of information referred to in\nsubparagraph (a)(i) or (ii)—the person makes the record\n\nSchedule 1  Main amendments\n\nRoyal Commissions Amendment (Private Sessions) Act 2019\nNo. 64, 2019\n\nof, uses or discloses the information with the consent of\nthe person who gave the information at the private\nsession;\n\n(iv) in the case of information referred to in\nsubparagraph (a)(iii)—the person makes the record of,\nuses or discloses the information with the consent of the\nperson who gave the information to the member, or\nmember of the staff, of the Commission.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-31-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-31-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "12aa17dae9e5333fd5c84dc2de26f00fc4bd02dbd7da27ce22559ccab9ead934",
      "skos:note": "Substitute subparagraphs with new obligations regarding information handling."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Subparagraphs 6OH(c)(iii) and (iv)",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Repeal the subparagraphs, substitute:\n\n(iii) in the case of information referred to in\nsubparagraph (a)(i) or (ii)—the person makes the record\n\nSchedule 1  Main amendments\n\nRoyal Commissions Amendment (Private Sessions) Act 2019\nNo. 64, 2019\n\nof, uses or discloses the information with the consent of\nthe person who gave the information at the private\nsession;\n\n(iv) in the case of information referred to in\nsubparagraph (a)(iii)—the person makes the record of,\nuses or discloses the information with the consent of the\nperson who gave the information to the member, or\nmember of the staff, of the Commission."
    },
