    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Paragraph 6OH(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-private-sessions-act-2019.pdf"
      },
      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.11",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) the person obtains information:\n\n(i) at a private session for a Royal Commission; or\n\n(ii) that was given at a private session for a Royal\nCommission; or\n\n(iii) that was given by a natural person to a member, or\nmember of the staff, of a Royal Commission for the\npurposes of a private session (whether or not a private\nsession was, or is to be, held for the Commission) and\nidentifies the person who gave the information; and",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) the person obtains information:\n\n(i) at a private session for a Royal Commission; or\n\n(ii) that was given at a private session for a Royal\nCommission; or\n\n(iii) that was given by a natural person to a member, or\nmember of the staff, of a Royal Commission for the\npurposes of a private session (whether or not a private\nsession was, or is to be, held for the Commission) and\nidentifies the person who gave the information; and",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-29-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-29-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "29dada5d4044f2871f85594f07d703a4e0ee0be2e407f0a6507218a6cf10b10f",
      "skos:note": "Repeal paragraph and substitute with new obligation to identify information source."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-29",
      "@type": "cof:Section",
