      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.13",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) To avoid doubt, subsection (1) applies in relation to a record\nwhether it came into existence before, during or after a private\nsession (if any) was held.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) To avoid doubt, subsection (1) applies in relation to a record\nwhether it came into existence before, during or after a private\nsession (if any) was held.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-40-norm"
        }
      ],
      "cml:integrityHash": "e53c8098ca1374a4d368b4b9038ce4c9d4d8b03536bfa309993b7e58d3b9343a",
      "skos:note": "Repeal subsection, substitute clause to clarify application of record creation timing."
    },
