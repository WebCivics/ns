        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-alleninterval-2"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-diffusion-3"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-cogai-4"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "4ebddc2c21910819d03988963adc1594ae9b25e2bf6bb31555f1e76ea8d993dc",
      "skos:note": "Protection of certain information given to the Child Sexual Abuse Royal Commission"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-6on-ss-1",
      "@type": "cof:Section",
      "cof:title": "6ON(1) Protection of certain information given to the Child Sexual",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(1) This section applies to information if:\n\nSchedule 1  Main amendments\n\nRoyal Commissions Amendment (Private Sessions) Act 2019\nNo. 64, 2019\n\n(a) the information was given by, or on behalf of, a natural\nperson to the Child Sexual Abuse Royal Commission other\nthan for the purposes of a private session; and\n\n(b) the information contains an account of:\n\n(i) the natural person’s experiences of child sexual abuse in\nan institutional context; or\n\n(ii) what happened to other people regarding child sexual\nabuse in an institutional context; and\n\n(c) the information identifies the natural person who gave the\ninformation, or on whose behalf the information was given;\nand\n\n(d) the Commission indicated that the information, if given,\nwould be treated as confidential; and\n\n(e) the information was treated as confidential by the\nCommission."
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "obligation",
      "cml:logicSummary": "Obligation to protect information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commission indicated that the information, if given, would be treated as confidential.",
      "cml:conclusionText": "A duty to protect the information"
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "within",
      "cml:logicSummary": "Temporal interval for confidentiality treatment",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) the Commission indicated that the information, if given, would be treated as confidential;",
      "cml:conclusionText": "The information is confidential within a certain time frame."
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-diffusion-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:logicSummary": "Diffusion of confidentiality treatment",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(e) the information was treated as confidential by the Commission;",
      "cml:conclusionText": "The confidentiality treatment is diffused to all relevant parties."
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "recognizes",
      "cml:logicSummary": "Recognition of confidentiality classification",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the information identifies the natural person who gave the information, or on whose behalf the information was given;",
      "cml:conclusionText": "The system recognizes the confidentiality classification based on this condition."
    },
    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-6on-ss-1-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "validates",
      "cml:logicSummary": "Validation of confidentiality treatment",
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the information was given by, or on behalf of, a natural person to the Child Sexual Abuse Royal Commission other than for the purposes of a private session;",
      "cml:conclusionText": "The system validates the confidentiality treatment based on this condition."
    },
    {
