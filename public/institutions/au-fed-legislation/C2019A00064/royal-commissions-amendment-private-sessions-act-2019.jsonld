      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.12",
      "values:originalText": "After “private session”, insert “for a Royal Commission or that was\ngiven to a member, or member of the staff, of a Royal Commission for\nthe purposes of a private session (whether or not a private session was,\nor is to be, held for the Commission)”.",
      "skos:definition": "After “private session”, insert “for a Royal Commission or that was\ngiven to a member, or member of the staff, of a Royal Commission for\nthe purposes of a private session (whether or not a private session was,\nor is to be, held for the Commission)”.",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-1-sec-34-norm"
        }
      ],
      "cml:integrityHash": "1fefb525b59979129265d51db625775bf0ae73c071e02ff6a83bfb0c7010385f",
      "skos:note": "Insertion of clause after 'private session'"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-1-sec-34",
      "@type": "cof:Section",
      "cof:title": "34 Section 6OJ",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "After “private session”, insert “for a Royal Commission or that was\ngiven to a member, or member of the staff, of a Royal Commission for\nthe purposes of a private session (whether or not a private session was,\nor is to be, held for the Commission)”."
    },
