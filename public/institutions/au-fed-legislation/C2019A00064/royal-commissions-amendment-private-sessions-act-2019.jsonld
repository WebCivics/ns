    {
      "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-2-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-2-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-private-sessions-act-2019.pdf"
      },
      "dc:source": "royal-commissions-amendment-private-sessions-act-2019.pdf, p.16",
      "values:originalText": "The amendments of section 7 of the Freedom of Information Act 1982\nmade by this Schedule apply in relation to the following:\n\n(a) a request for access, made under section 15 of that Act, that\nis received on or after the commencement of this item;\n\n(b) an application, made under section 48 of that Act, that is\nreceived on or after the commencement of this item.\n\n\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 25 July 2019\nSenate on 31 July 2019]\n\n(130/19)",
      "skos:definition": "The amendments of section 7 of the Freedom of Information Act 1982\nmade by this Schedule apply in relation to the following:\n\n(a) a request for access, made under section 15 of that Act, that\nis received on or after the commencement of this item;\n\n(b) an application, made under section 48 of that Act, that is\nreceived on or after the commencement of this item.\n\n\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 25 July 2019\nSenate on 31 July 2019]\n\n(130/19)",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-2-sec-3-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-2-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:royal-commissions-amendment-private-sessions-act-2019-sch-2-sec-3-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "f63f5fccc01cc0b347054d52573b69979e96a70eec233dfa646e6c219612cd3c",
      "skos:note": "Amendments apply to certain requests and applications made under the Freedom of Information Act 1982 after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-private-sessions-act-2019#sch-2-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "The amendments of section 7 of the Freedom of Information Act 1982\nmade by this Schedule apply in relation to the following:\n\n(a) a request for access, made under section 15 of that Act, that\nis received on or after the commencement of this item;\n\n(b) an application, made under section 48 of that Act, that is\nreceived on or after the commencement of this item.\n\n\n\nNo. 64, 2019\nRoyal Commissions Amendment (Private Sessions) Act 2019\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 25 July 2019\nSenate on 31 July 2019]\n\n(130/19)"
    },
