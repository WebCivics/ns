doc:sch-1-sec-1 a cof:Section ;
    cof:title "1 Section 8" ;
    values:kind "section" ;
    values:originalText "Omit:  (d) providing leadership in relation to behaviour supports. substitute:  (d) providing leadership in relation to behaviour supports; and  (e) establishing, operating and maintaining the NDIS worker screening database (Chapter 6B)." ;
    cof:pageNumber "7"^^xsd:integer .

concept:national-disability-insurance-scheme-amendment-worker-screening-database-act-2019-sch-1-sec-2 a cml:Concept ;
    skos:prefLabel "2 Section 9"@en ;
    cml:realizedBy doc:sch-1-sec-2 ;
    values:originalText "Insert: disclose, in relation to information in the NDIS worker screening database, includes provide electronic access to the information. NDIS worker screening check means an assessment, under an NDIS worker screening law, of whether a person who works, or seeks to work, with people with disability poses a risk to such people. NDIS worker screening database means the database established under section 181Y. NDIS worker screening law means a law of a State or Territory determined in an instrument under subsection 10B(1)." ;
    skos:definition "Insert: disclose, in relation to information in the NDIS worker screening database, includes provide electronic access to the information. NDIS worker screening check means an assessment, under an NDIS worker screening law, of whether a person who works, or seeks to work, with people with disability poses a risk to such people. NDIS worker screening database means the database established under section 181Y. NDIS worker screening law means a law of a State or Territory determined in an instrument under subsection 10B(1)."@en ;
    cml:integrityHash "2e4e588950d77ce2f9633af54742d932937147de906c0977de5a7ceec8075e06" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Requires disclosure of information in the NDIS worker screening database." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
