    skos:prefLabel "1 Section 8"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Omit:  (d) providing leadership in relation to behaviour supports. substitute:  (d) providing leadership in relation to behaviour supports; and  (e) establishing, operating and maintaining the NDIS worker screening database (Chapter 6B)." ;
    skos:definition "Omit:  (d) providing leadership in relation to behaviour supports. substitute:  (d) providing leadership in relation to behaviour supports; and  (e) establishing, operating and maintaining the NDIS worker screening database (Chapter 6B)."@en ;
