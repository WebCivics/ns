concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-4 a cml:Concept ;
    skos:prefLabel "4 After paragraph 92(2)(c)"@en ;
    cml:realizedBy doc:sch-2-sec-4 ;
    values:originalText "Insert:  (ca) if an amount has been paid (whether or not to the person) for treatment under a relevant DVA law relating to services referred to in paragraph (1)(a)—that the person is to repay to the Commonwealth an amount equal to the whole or a specified part of the amount paid for the treatment;  (cb) that any amount for treatment under a relevant DVA law that would otherwise be payable for services referred to in paragraph (1)(a) is to cease to be payable;" ;
    skos:definition "Insert:  (ca) if an amount has been paid (whether or not to the person) for treatment under a relevant DVA law relating to services referred to in paragraph (1)(a)—that the person is to repay to the Commonwealth an amount equal to the whole or a specified part of the amount paid for the treatment;  (cb) that any amount for treatment under a relevant DVA law that would otherwise be payable for services referred to in paragraph (1)(a) is to cease to be payable;"@en ;
    cml:integrityHash "746baf41606b9774a5658cf20fe460fdb730c9403ef1176231892fb744d693b9" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Repayment obligation for treatment under relevant DVA law" ;
    cml:curationStatus cml:Proposed ;
