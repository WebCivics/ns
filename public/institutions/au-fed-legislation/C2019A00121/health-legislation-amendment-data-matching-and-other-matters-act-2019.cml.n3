concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 81(1)"@en ;
    cml:realizedBy doc:sch-2-sec-1 ;
    values:originalText "Insert: relevant DVA law means any of the following:  (a) the Australian Participants in British Nuclear Tests and British Commonwealth Occupation Force (Treatment) Act 2006;  (b) Chapter 6 of the Military Rehabilitation and Compensation Act 2004;  (c) the Safety, Rehabilitation and Compensation (Defence-related Claims) Act 1988;  (d) the Treatment Benefits (Special Access) Act 2019;  (e) Part V of the Veterans’ Entitlements Act 1986;  (f) any other Commonwealth law prescribed by the regulations for the purposes of this paragraph." ;
    skos:definition "Insert: relevant DVA law means any of the following:  (a) the Australian Participants in British Nuclear Tests and British Commonwealth Occupation Force (Treatment) Act 2006;  (b) Chapter 6 of the Military Rehabilitation and Compensation Act 2004;  (c) the Safety, Rehabilitation and Compensation (Defence-related Claims) Act 1988;  (d) the Treatment Benefits (Special Access) Act 2019;  (e) Part V of the Veterans’ Entitlements Act 1986;  (f) any other Commonwealth law prescribed by the regulations for the purposes of this paragraph."@en ;
    cml:integrityHash "a5047f50cab3137cc7318ff2672b82bf4a45c2026e448e42b019db1cdf6be9cd" ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Defines relevant DVA law" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
