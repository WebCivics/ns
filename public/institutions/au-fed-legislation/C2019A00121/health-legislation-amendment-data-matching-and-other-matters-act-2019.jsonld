    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 At the end of subsection 61(8)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-9"
      },
      "cml:curationStatus": {
