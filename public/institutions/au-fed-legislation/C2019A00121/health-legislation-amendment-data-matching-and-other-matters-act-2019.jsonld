      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.17",
      "values:originalText": "Insert:\nrelevant DVA law means any of the following:\n\n(a) the Australian Participants in British Nuclear Tests and\nBritish Commonwealth Occupation Force (Treatment) Act\n2006;\n\n(b) Chapter 6 of the Military Rehabilitation and Compensation\nAct 2004;\n\n(c) the Safety, Rehabilitation and Compensation\n(Defence-related Claims) Act 1988;\n\n(d) the Treatment Benefits (Special Access) Act 2019;\n\n(e) Part V of the Veterans’ Entitlements Act 1986;\n\n(f) any other Commonwealth law prescribed by the regulations\nfor the purposes of this paragraph.",
      "skos:definition": "Insert:\nrelevant DVA law means any of the following:\n\n(a) the Australian Participants in British Nuclear Tests and\nBritish Commonwealth Occupation Force (Treatment) Act\n2006;\n\n(b) Chapter 6 of the Military Rehabilitation and Compensation\nAct 2004;\n\n(c) the Safety, Rehabilitation and Compensation\n(Defence-related Claims) Act 1988;\n\n(d) the Treatment Benefits (Special Access) Act 2019;\n\n(e) Part V of the Veterans’ Entitlements Act 1986;\n\n(f) any other Commonwealth law prescribed by the regulations\nfor the purposes of this paragraph.",
      "cml:asserts": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-1-norm"
        }
      ],
      "cml:integrityHash": "a5047f50cab3137cc7318ff2672b82bf4a45c2026e448e42b019db1cdf6be9cd",
      "skos:note": "Defines relevant DVA law"
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 81(1)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Insert:\nrelevant DVA law means any of the following:\n\n(a) the Australian Participants in British Nuclear Tests and\nBritish Commonwealth Occupation Force (Treatment) Act\n2006;\n\n(b) Chapter 6 of the Military Rehabilitation and Compensation\nAct 2004;\n\n(c) the Safety, Rehabilitation and Compensation\n(Defence-related Claims) Act 1988;\n\n(d) the Treatment Benefits (Special Access) Act 2019;\n\n(e) Part V of the Veterans’ Entitlements Act 1986;\n\n(f) any other Commonwealth law prescribed by the regulations\nfor the purposes of this paragraph."
    },
