      },
      "prov:wasDerivedFrom": {
        "@id": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf"
      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.16",
      "values:originalText": "Add:\nNote:\nThe Secretary may also disclose therapeutic goods information\nprovided to the Department to the Chief Executive Medicare for the\npurpose of certain data-matching: see section 132C of the National\nHealth Act 1953.\n\nOther amendments  Schedule 2\nProfessional Services Review Scheme  Part 1\n\nNo. 121, 2019\nHealth Legislation Amendment (Data-matching and Other Matters) Act",
      "skos:definition": "Add:\nNote:\nThe Secretary may also disclose therapeutic goods information\nprovided to the Department to the Chief Executive Medicare for the\npurpose of certain data-matching: see section 132C of the National\nHealth Act 1953.\n\nOther amendments  Schedule 2\nProfessional Services Review Scheme  Part 1\n\nNo. 121, 2019\nHealth Legislation Amendment (Data-matching and Other Matters) Act",
      "cml:asserts": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-9-norm"
        }
      ],
      "cml:integrityHash": "d776df57771c46325d9575b80190509c8ddce95291d87e359f0c0730cb945fa6",
      "skos:note": "Disclosure of therapeutic goods information for data-matching purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 At the end of subsection 61(8)",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Add:\nNote:\nThe Secretary may also disclose therapeutic goods information\nprovided to the Department to the Chief Executive Medicare for the\npurpose of certain data-matching: see section 132C of the National\nHealth Act 1953.\n\nOther amendments  Schedule 2\nProfessional Services Review Scheme  Part 1\n\nNo. 121, 2019\nHealth Legislation Amendment (Data-matching and Other Matters) Act"
    },
