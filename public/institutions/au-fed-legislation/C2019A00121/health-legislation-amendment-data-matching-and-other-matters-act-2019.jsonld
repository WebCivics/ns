    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-132c",
      "@type": "cml:Concept",
      "skos:prefLabel": "132C Secretary may disclose therapeutic goods information to the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-132c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf"
      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.10",
      "values:originalText": "Chief Executive Medicare\n\n(1) The Secretary may disclose to the Chief Executive Medicare\ntherapeutic goods information (within the meaning of\nsubsection 61(1) of the Therapeutic Goods Act 1989) for the\npurpose of facilitating the matching of that information under\nsubsection 132B(1).\nNote:\nThis subsection constitutes an authorisation for the purposes of the\nPrivacy Act 1988.\n\n(2) The Chief Executive Medicare may use information disclosed in\naccordance with subsection (1) for the purpose of facilitating the\nmatching of that information under subsection 132B(1).",
      "skos:definition": "Chief Executive Medicare\n\n(1) The Secretary may disclose to the Chief Executive Medicare\ntherapeutic goods information (within the meaning of\nsubsection 61(1) of the Therapeutic Goods Act 1989) for the\npurpose of facilitating the matching of that information under\nsubsection 132B(1).\nNote:\nThis subsection constitutes an authorisation for the purposes of the\nPrivacy Act 1988.\n\n(2) The Chief Executive Medicare may use information disclosed in\naccordance with subsection (1) for the purpose of facilitating the\nmatching of that information under subsection 132B(1).",
      "cml:hasPart": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-132c-ss-1"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-132c-ss-2"
        }
      ],
      "cml:integrityHash": "3b787b19df1a54fe6fdf9a7d33d3610b502d61f75561bd20f1372ef9f6971b12"
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-132c",
      "@type": "cof:Section",
      "cof:title": "132C Secretary may disclose therapeutic goods information to the",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Chief Executive Medicare\n\n(1) The Secretary may disclose to the Chief Executive Medicare\ntherapeutic goods information (within the meaning of\nsubsection 61(1) of the Therapeutic Goods Act 1989) for the\npurpose of facilitating the matching of that information under\nsubsection 132B(1).\nNote:\nThis subsection constitutes an authorisation for the purposes of the\nPrivacy Act 1988.\n\n(2) The Chief Executive Medicare may use information disclosed in\naccordance with subsection (1) for the purpose of facilitating the\nmatching of that information under subsection 132B(1)."
    },
