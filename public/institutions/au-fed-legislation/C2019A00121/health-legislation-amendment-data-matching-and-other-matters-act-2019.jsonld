    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 81(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-2-sec-1"
      },
      "cml:curationStatus": {
