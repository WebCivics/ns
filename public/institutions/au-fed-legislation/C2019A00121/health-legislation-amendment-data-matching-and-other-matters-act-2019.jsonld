    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 After subsection 130(5H)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf"
      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.15",
      "values:originalText": "Insert:\n\n(5J) Notwithstanding anything contained in the preceding provisions of\nthis section, a person may divulge information to a Commonwealth\nentity for the purpose of facilitating the matching of that\ninformation by the Commonwealth entity under\nsubsection 132B(1) of the National Health Act 1953.\nPrivacy Act 1988",
      "skos:definition": "Insert:\n\n(5J) Notwithstanding anything contained in the preceding provisions of\nthis section, a person may divulge information to a Commonwealth\nentity for the purpose of facilitating the matching of that\ninformation by the Commonwealth entity under\nsubsection 132B(1) of the National Health Act 1953.\nPrivacy Act 1988",
      "cml:asserts": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-6-norm"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bedaeb90f3a40d3989e2386a16333182a917f5dae034da746b9348bea07dd04d",
      "skos:note": "Permits divulgence of information for matching purposes."
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 After subsection 130(5H)",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Insert:\n\n(5J) Notwithstanding anything contained in the preceding provisions of\nthis section, a person may divulge information to a Commonwealth\nentity for the purpose of facilitating the matching of that\ninformation by the Commonwealth entity under\nsubsection 132B(1) of the National Health Act 1953.\nPrivacy Act 1988"
    },
