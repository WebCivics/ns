    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 After paragraph 92(2)(c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-2-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf"
      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.18",
      "values:originalText": "Insert:\n\n(ca) if an amount has been paid (whether or not to the person) for\ntreatment under a relevant DVA law relating to services\nreferred to in paragraph (1)(a)—that the person is to repay to\nthe Commonwealth an amount equal to the whole or a\nspecified part of the amount paid for the treatment;\n\n(cb) that any amount for treatment under a relevant DVA law that\nwould otherwise be payable for services referred to in\nparagraph (1)(a) is to cease to be payable;",
      "skos:definition": "Insert:\n\n(ca) if an amount has been paid (whether or not to the person) for\ntreatment under a relevant DVA law relating to services\nreferred to in paragraph (1)(a)—that the person is to repay to\nthe Commonwealth an amount equal to the whole or a\nspecified part of the amount paid for the treatment;\n\n(cb) that any amount for treatment under a relevant DVA law that\nwould otherwise be payable for services referred to in\nparagraph (1)(a) is to cease to be payable;",
      "cml:asserts": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-4-norm"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "746baf41606b9774a5658cf20fe460fdb730c9403ef1176231892fb744d693b9",
      "skos:note": "Repayment obligation for treatment under relevant DVA law"
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-2-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 After paragraph 92(2)(c)",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Insert:\n\n(ca) if an amount has been paid (whether or not to the person) for\ntreatment under a relevant DVA law relating to services\nreferred to in paragraph (1)(a)—that the person is to repay to\nthe Commonwealth an amount equal to the whole or a\nspecified part of the amount paid for the treatment;\n\n(cb) that any amount for treatment under a relevant DVA law that\nwould otherwise be payable for services referred to in\nparagraph (1)(a) is to cease to be payable;"
    },
    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-4-norm",
