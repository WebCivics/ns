    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 At the end of subsection 33C(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf"
      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.15",
      "values:originalText": "Add:\n\n; (f) whether the matching of information under Part VIIIA of the\nNational Health Act 1953, and the handling of information\nrelating to that matching, is in accordance with that Part,\nincluding:\n\n(i) any terms and conditions relating to the matching of the\ninformation determined by the Chief Executive\nMedicare under paragraph 132B(3)(a) of that Act; and\n\n(ii) the principles made by the Minister under\nsubsection 132F(1) of that Act.\nPrivate Health Insurance Act 2007",
      "skos:definition": "Add:\n\n; (f) whether the matching of information under Part VIIIA of the\nNational Health Act 1953, and the handling of information\nrelating to that matching, is in accordance with that Part,\nincluding:\n\n(i) any terms and conditions relating to the matching of the\ninformation determined by the Chief Executive\nMedicare under paragraph 132B(3)(a) of that Act; and\n\n(ii) the principles made by the Minister under\nsubsection 132F(1) of that Act.\nPrivate Health Insurance Act 2007",
      "cml:asserts": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-7-norm"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-7-logic-deontic-1"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-7-logic-alleninterval-2"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-7-logic-ltl-3"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-7-logic-diffusion-4"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-7-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "9d3f2d18373d32e38de929d12d95057f3df819814895d0bf679c4914696050c9",
      "skos:note": "Ensure matching of information under Part VIIIA is in accordance with that Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 At the end of subsection 33C(1)",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Add:\n\n; (f) whether the matching of information under Part VIIIA of the\nNational Health Act 1953, and the handling of information\nrelating to that matching, is in accordance with that Part,\nincluding:\n\n(i) any terms and conditions relating to the matching of the\ninformation determined by the Chief Executive\nMedicare under paragraph 132B(3)(a) of that Act; and\n\n(ii) the principles made by the Minister under\nsubsection 132F(1) of that Act.\nPrivate Health Insurance Act 2007"
    },
