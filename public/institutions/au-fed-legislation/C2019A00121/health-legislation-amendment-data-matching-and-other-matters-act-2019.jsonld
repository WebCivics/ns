    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-132a",
      "@type": "cml:Concept",
      "skos:prefLabel": "132A Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-132a"
