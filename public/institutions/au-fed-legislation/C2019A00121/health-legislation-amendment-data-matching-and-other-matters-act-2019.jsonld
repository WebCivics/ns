    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 At the end of subsection 92(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-2-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf"
      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.18",
      "values:originalText": "Add:\n\n; and (f) if the agreement provides for the person under review to pay\nto the Commonwealth an amount equal to the whole or a\nspecified part of the amount paid for treatment under a\nrelevant DVA law and the amount or part of the amount is\nnot paid—the unpaid amount is a debt due by the person to\nthe Commonwealth and is recoverable by action in any court\nof competent jurisdiction.",
      "skos:definition": "Add:\n\n; and (f) if the agreement provides for the person under review to pay\nto the Commonwealth an amount equal to the whole or a\nspecified part of the amount paid for treatment under a\nrelevant DVA law and the amount or part of the amount is\nnot paid—the unpaid amount is a debt due by the person to\nthe Commonwealth and is recoverable by action in any court\nof competent jurisdiction.",
      "cml:asserts": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-5-norm"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "29f20bcd81d570cbe962d09f71b1bffdfcc1fc24c5692ed2d78376507b647f0c",
      "skos:note": "Debt due by person to Commonwealth if unpaid amount not paid"
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-2-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 At the end of subsection 92(4)",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Add:\n\n; and (f) if the agreement provides for the person under review to pay\nto the Commonwealth an amount equal to the whole or a\nspecified part of the amount paid for treatment under a\nrelevant DVA law and the amount or part of the amount is\nnot paid—the unpaid amount is a debt due by the person to\nthe Commonwealth and is recoverable by action in any court\nof competent jurisdiction."
    },
    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
