    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 After paragraph 106U(1)(cb)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-2-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf"
      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.18",
      "values:originalText": "Insert:\n\n(d) that any amount for treatment under a relevant DVA law that\nwould otherwise be payable for a service in the provision of\nwhich the person is stated in a report under section 106L to\nhave engaged in inappropriate practice ceases to be payable;\n\n(da) if an amount has been paid (whether or not to the person\nunder review) for treatment under a relevant DVA law\nrelating to a service:\n\n(i) that was rendered or initiated by the person under\nreview or an associated person; and\n\n(ii) in connection with the rendering or initiation of which\nthe person under review or an associated person is\nstated in a report under section 106L (other than a report\nbased on a finding made under subsection 106K(2) or\n106KB(3)) to have engaged in inappropriate practice;\n\nOther amendments  Schedule 2\nProfessional Services Review Scheme  Part 1\n\nNo. 121, 2019\nHealth Legislation Amendment (Data-matching and Other Matters) Act\n\nthat the person under review repay to the Commonwealth the\nwhole or a part of the amount paid for that service;",
      "skos:definition": "Insert:\n\n(d) that any amount for treatment under a relevant DVA law that\nwould otherwise be payable for a service in the provision of\nwhich the person is stated in a report under section 106L to\nhave engaged in inappropriate practice ceases to be payable;\n\n(da) if an amount has been paid (whether or not to the person\nunder review) for treatment under a relevant DVA law\nrelating to a service:\n\n(i) that was rendered or initiated by the person under\nreview or an associated person; and\n\n(ii) in connection with the rendering or initiation of which\nthe person under review or an associated person is\nstated in a report under section 106L (other than a report\nbased on a finding made under subsection 106K(2) or\n106KB(3)) to have engaged in inappropriate practice;\n\nOther amendments  Schedule 2\nProfessional Services Review Scheme  Part 1\n\nNo. 121, 2019\nHealth Legislation Amendment (Data-matching and Other Matters) Act\n\nthat the person under review repay to the Commonwealth the\nwhole or a part of the amount paid for that service;",
      "cml:asserts": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-6-norm"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-2-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3cb8cd08e22e01b11c6c23a9141845056421c4efda41b451be777ad9814d3648",
      "skos:note": "Ceases payment of amount for treatment under relevant DVA law"
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-2-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 After paragraph 106U(1)(cb)",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Insert:\n\n(d) that any amount for treatment under a relevant DVA law that\nwould otherwise be payable for a service in the provision of\nwhich the person is stated in a report under section 106L to\nhave engaged in inappropriate practice ceases to be payable;\n\n(da) if an amount has been paid (whether or not to the person\nunder review) for treatment under a relevant DVA law\nrelating to a service:\n\n(i) that was rendered or initiated by the person under\nreview or an associated person; and\n\n(ii) in connection with the rendering or initiation of which\nthe person under review or an associated person is\nstated in a report under section 106L (other than a report\nbased on a finding made under subsection 106K(2) or\n106KB(3)) to have engaged in inappropriate practice;\n\nOther amendments  Schedule 2\nProfessional Services Review Scheme  Part 1\n\nNo. 121, 2019\nHealth Legislation Amendment (Data-matching and Other Matters) Act\n\nthat the person under review repay to the Commonwealth the\nwhole or a part of the amount paid for that service;"
    },
