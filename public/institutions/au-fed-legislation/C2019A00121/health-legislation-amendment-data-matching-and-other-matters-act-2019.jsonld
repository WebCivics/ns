    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-132e",
      "@type": "cml:Concept",
      "skos:prefLabel": "132E Breach of provision of this Part is an interference with privacy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-132e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf"
      },
      "dc:source": "health-legislation-amendment-data-matching-and-other-matters-act-2019.pdf, p.11",
      "values:originalText": "A breach of a provision of this Part in relation to an individual\nconstitutes an act or practice involving interference with the\nprivacy of the individual for the purposes of section 13 of the\nPrivacy Act 1988.\nNote:\nThe act or practice may be the subject of a complaint under section 36\nof the Privacy Act 1988.",
      "skos:definition": "A breach of a provision of this Part in relation to an individual\nconstitutes an act or practice involving interference with the\nprivacy of the individual for the purposes of section 13 of the\nPrivacy Act 1988.\nNote:\nThe act or practice may be the subject of a complaint under section 36\nof the Privacy Act 1988.",
      "cml:asserts": [
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-132e-norm"
        },
        {
          "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-132e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e19571a96be5daa19879180ed8d5be44cd1e22205c51cc6e87b91c6c126ba86f",
      "skos:note": "Interference with privacy constitutes a breach of this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/health-legislation-amendment-data-matching-and-other-matters-act-2019#sch-1-sec-132e",
      "@type": "cof:Section",
      "cof:title": "132E Breach of provision of this Part is an interference with privacy",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "A breach of a provision of this Part in relation to an individual\nconstitutes an act or practice involving interference with the\nprivacy of the individual for the purposes of section 13 of the\nPrivacy Act 1988.\nNote:\nThe act or practice may be the subject of a complaint under section 36\nof the Privacy Act 1988."
    },
    {
      "@id": "concept:health-legislation-amendment-data-matching-and-other-matters-act-2019-sch-1-sec-132e-norm",
      "@type": "values:Obligation",
