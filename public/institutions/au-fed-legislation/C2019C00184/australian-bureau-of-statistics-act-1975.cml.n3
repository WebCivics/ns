doc:sec-3-2 a cof:Section ;
    cof:title "3 Interpretation" ;
    values:kind "section" ;
    values:originalText "In this Act, unless the contrary intention appears: Bureau means the Australian Bureau of Statistics established by subsection 5(1). Chairperson means the Chairperson of the Council holding office under subsection 19(2). Council means the Australian Statistics Advisory Council established by section 17. member means a member of the Council. Statistician means the Australian Statistician referred to in subsection 5(2)." ;
    cof:pageNumber "5"^^xsd:integer .

concept:australian-bureau-of-statistics-act-1975-sec-4 a cml:Concept ;
    skos:prefLabel "4 Australian Statistician to have functions etc. of Commonwealth"@en ;
    cml:realizedBy doc:sec-4 ;
    values:originalText "Statistician  (2) After the commencement of this Act:  (a) the Australian Statistician shall:  (i) have the functions, powers and duties expressed by any Act, or by any regulations or other instrument made under any Act, to be conferred or imposed on the Commonwealth Statistician; and  (ii) have the functions and powers expressed by a law of a Territory, or by any regulations or other instrument made under such a law, to be conferred on the Commonwealth Statistician; and  (b) a reference in any Act, in any law of a Territory, or in an instrument under any Act or law of a Territory, to the Commonwealth Statistician shall have effect as if the office of Australian Statistician were a continuation of the office of the Commonwealth Statistician.   Australian Bureau of Statistics and Australian Statistician  Part II  Section 5  Australian Bureau of Statistics Act 1975 Compilation date: 3/5/19 Registered: 10/5/19" ;
    skos:definition "Statistician  (2) After the commencement of this Act:  (a) the Australian Statistician shall:  (i) have the functions, powers and duties expressed by any Act, or by any regulations or other instrument made under any Act, to be conferred or imposed on the Commonwealth Statistician; and  (ii) have the functions and powers expressed by a law of a Territory, or by any regulations or other instrument made under such a law, to be conferred on the Commonwealth Statistician; and  (b) a reference in any Act, in any law of a Territory, or in an instrument under any Act or law of a Territory, to the Commonwealth Statistician shall have effect as if the office of Australian Statistician were a continuation of the office of the Commonwealth Statistician.   Australian Bureau of Statistics and Australian Statistician  Part II  Section 5  Australian Bureau of Statistics Act 1975 Compilation date: 3/5/19 Registered: 10/5/19"@en ;
    cml:integrityHash "f812b68a3f5c7b431f8817c39ea14ea1390027d6d4b60720678b2694c786f162" ;
    cof:pageNumber "6"^^xsd:integer ;
    skos:note "Functions and powers of Australian Statistician" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-bureau-of-statistics-act-1975.pdf> ;
    dc:source "australian-bureau-of-statistics-act-1975.pdf, p.6" ;
    cml:asserts concept:australian-bureau-of-statistics-act-1975-sec-4-norm .
