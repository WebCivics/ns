concept:australian-bureau-of-statistics-act-1975-sec-3-2 a cml:Concept ;
    skos:prefLabel "3 Interpretation"@en ;
    cml:realizedBy doc:sec-3-2 ;
    values:originalText "In this Act, unless the contrary intention appears: Bureau means the Australian Bureau of Statistics established by subsection 5(1). Chairperson means the Chairperson of the Council holding office under subsection 19(2). Council means the Australian Statistics Advisory Council established by section 17. member means a member of the Council. Statistician means the Australian Statistician referred to in subsection 5(2)." ;
    skos:definition "In this Act, unless the contrary intention appears: Bureau means the Australian Bureau of Statistics established by subsection 5(1). Chairperson means the Chairperson of the Council holding office under subsection 19(2). Council means the Australian Statistics Advisory Council established by section 17. member means a member of the Council. Statistician means the Australian Statistician referred to in subsection 5(2)."@en ;
    cml:integrityHash "824bf7ffa24411f1898c6629285a9911a470fcf714673a17d3dbcbc43af8d8b6" ;
    cof:pageNumber "5"^^xsd:integer ;
