doc:sec-12-ss-3 a cof:Section ;
    cof:title "12(3) Removal from office" ;
    values:kind "subsection" ;
    values:originalText "(3) Where the Governor-General suspends the Statistician from office, the Minister shall cause a statement of the ground of the suspension to be laid before each House of the Parliament within 7 sitting days of that House after the suspension." ;
    cof:pageNumber "10"^^xsd:integer .

concept:australian-bureau-of-statistics-act-1975-sec-12-ss-4 a cml:Concept ;
    skos:prefLabel "12(4) Removal from office"@en ;
    cml:realizedBy doc:sec-12-ss-4 ;
    values:originalText "(4) Where such a statement has been laid before a House of the Parliament, that House may, within 15 sitting days of that House after the day on which the statement has been laid before it, by resolution, declare that the Statistician should be removed from office and, if each House so passes such a resolution, the Governor-General shall remove the Statistician from office." ;
    skos:definition "(4) Where such a statement has been laid before a House of the Parliament, that House may, within 15 sitting days of that House after the day on which the statement has been laid before it, by resolution, declare that the Statistician should be removed from office and, if each House so passes such a resolution, the Governor-General shall remove the Statistician from office."@en ;
