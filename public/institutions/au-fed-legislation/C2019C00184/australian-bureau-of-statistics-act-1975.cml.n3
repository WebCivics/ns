concept:australian-bureau-of-statistics-act-1975-sec-7 a cml:Concept ;
    skos:prefLabel "7 Appointment and tenure of office of Statistician"@en ;
    cml:realizedBy doc:sec-7 ;
    values:originalText "(1) The Statistician shall be appointed by the Governor-General and, subject to this Act, holds office for such period, not exceeding 7 years, as is specified in the instrument of his or her appointment but is eligible for re-appointment." ;
    skos:definition "(1) The Statistician shall be appointed by the Governor-General and, subject to this Act, holds office for such period, not exceeding 7 years, as is specified in the instrument of his or her appointment but is eligible for re-appointment."@en ;
    cml:integrityHash "ecb765bcf97d864f0e9e80b68fae97819c27b3679a41813a05962a7d7aaabb10" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "The Statistician shall be appointed by the Governor-General and holds office for a specified period." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
