doc:sec-16a-ss-1 a cof:Section ;
    cof:title "16A(1) Persons seconded to the Bureau" ;
    values:kind "subsection" ;
    values:originalText "(1) The Statistician may arrange with:  (a) a governmental agency or governmental authority; or  (b) an international organisation of an intergovernmental character; for the services of officers or employees of the agency, authority or organisation to be made available to assist in the carrying out of the functions of the Statistician." ;
    cof:pageNumber "13"^^xsd:integer .

concept:australian-bureau-of-statistics-act-1975-sec-16a-ss-2 a cml:Concept ;
    skos:prefLabel "16A(2) Persons seconded to the Bureau"@en ;
    cml:realizedBy doc:sec-16a-ss-2 ;
    values:originalText "(2) Subsection (1) applies to an agency, authority or organisation, whether in Australia or in a foreign country." ;
    skos:definition "(2) Subsection (1) applies to an agency, authority or organisation, whether in Australia or in a foreign country."@en ;
