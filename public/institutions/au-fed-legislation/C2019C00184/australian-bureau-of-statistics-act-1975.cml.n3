concept:australian-bureau-of-statistics-act-1975-sec-24 a cml:Concept ;
    skos:prefLabel "24 Annual report on the Council"@en ;
    cml:realizedBy doc:sec-24 ;
    values:originalText "(1) The Council must, as soon as practicable after 30 June in each year, prepare and submit to the Minister, for presentation to the Parliament, a report relating to matters connected with the operation of this Act.  (2) The Minister must cause a copy of the report to be laid before each House of the Parliament within 15 sitting days of that House after its receipt by the Minister." ;
    skos:definition "(1) The Council must, as soon as practicable after 30 June in each year, prepare and submit to the Minister, for presentation to the Parliament, a report relating to matters connected with the operation of this Act.  (2) The Minister must cause a copy of the report to be laid before each House of the Parliament within 15 sitting days of that House after its receipt by the Minister."@en ;
    cml:integrityHash "4e5d48411a2b41027d204a3c03523e10dbc572500cde1cafa4deebf6e05d4d43" ;
    cof:pageNumber "17"^^xsd:integer ;
