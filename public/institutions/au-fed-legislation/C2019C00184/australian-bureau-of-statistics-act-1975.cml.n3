concept:australian-bureau-of-statistics-act-1975-sec-6-ss-3 a cml:Concept ;
    skos:prefLabel "6(3) Functions of Bureau"@en ;
    cml:realizedBy doc:sec-6-ss-3 ;
    values:originalText "(3) Subject to subsection (4), each new proposal for the collection of information for statistical purposes by the Bureau shall be laid before both Houses of the Parliament before its implementation, unless the proposal is for the collection of information on a voluntary basis." ;
    skos:definition "(3) Subject to subsection (4), each new proposal for the collection of information for statistical purposes by the Bureau shall be laid before both Houses of the Parliament before its implementation, unless the proposal is for the collection of information on a voluntary basis."@en ;
    cml:integrityHash "e7b929c4a83f6555ad8f6883f86d954f186c021f3737ee92290f4bcfef291531" ;
    values:partOf concept:australian-bureau-of-statistics-act-1975-sec-6 ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Proposal for information collection must be laid before Parliament." ;
