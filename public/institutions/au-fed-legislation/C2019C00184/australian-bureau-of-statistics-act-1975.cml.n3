concept:australian-bureau-of-statistics-act-1975-sec-8 a cml:Concept ;
    skos:prefLabel "8 Statistician not to undertake any other work"@en ;
    cml:realizedBy doc:sec-8 ;
    values:originalText "The Statistician shall not engage in paid employment outside the duties of his or her office except with the approval of the Minister." ;
    skos:definition "The Statistician shall not engage in paid employment outside the duties of his or her office except with the approval of the Minister."@en ;
