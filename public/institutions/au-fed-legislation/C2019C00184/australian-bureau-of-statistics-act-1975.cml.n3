    values:partOf concept:australian-bureau-of-statistics-act-1975-sec-12 ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Parliament can declare the Statistician should be removed from office within 15 sitting days." ;
    cml:curationStatus cml:Proposed ;
