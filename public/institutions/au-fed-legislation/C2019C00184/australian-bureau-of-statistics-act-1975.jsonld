    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-12-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "12(7) Removal from office",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-12-ss-7"
      },
      "cml:curationStatus": {
