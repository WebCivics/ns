    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Remuneration and allowances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.10",
      "values:originalText": "(1) The Statistician shall be paid such remuneration as is determined\nby the Remuneration Tribunal, but, if no determination of that\nremuneration by the Tribunal is in operation, the Statistician shall\nbe paid such remuneration as is prescribed.\n\n(2) The Statistician shall be paid such allowances as are prescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "skos:definition": "(1) The Statistician shall be paid such remuneration as is determined\nby the Remuneration Tribunal, but, if no determination of that\nremuneration by the Tribunal is in operation, the Statistician shall\nbe paid such remuneration as is prescribed.\n\n(2) The Statistician shall be paid such allowances as are prescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-9-ss-1"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-9-ss-2"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-9-ss-3"
        }
      ],
      "cml:integrityHash": "2512eeef678319593f230bdf5df85f20aaaa13da9b607024d86aaec858e4cabb"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Remuneration and allowances",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) The Statistician shall be paid such remuneration as is determined\nby the Remuneration Tribunal, but, if no determination of that\nremuneration by the Tribunal is in operation, the Statistician shall\nbe paid such remuneration as is prescribed.\n\n(2) The Statistician shall be paid such allowances as are prescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973."
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-9-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "9(1) Remuneration and allowances",
      "cml:realizedBy": {
