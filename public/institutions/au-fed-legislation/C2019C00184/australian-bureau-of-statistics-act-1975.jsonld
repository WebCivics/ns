      }
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-6-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "6(3) Functions of Bureau",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-6-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.8",
      "values:originalText": "(3) Subject to subsection (4), each new proposal for the collection of\ninformation for statistical purposes by the Bureau shall be laid\nbefore both Houses of the Parliament before its implementation,\nunless the proposal is for the collection of information on a\nvoluntary basis.",
      "skos:definition": "(3) Subject to subsection (4), each new proposal for the collection of\ninformation for statistical purposes by the Bureau shall be laid\nbefore both Houses of the Parliament before its implementation,\nunless the proposal is for the collection of information on a\nvoluntary basis.",
      "values:partOf": {
        "@id": "concept:australian-bureau-of-statistics-act-1975-sec-6"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-6-ss-3-norm"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-6-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e7b929c4a83f6555ad8f6883f86d954f186c021f3737ee92290f4bcfef291531",
      "skos:note": "Proposal for information collection must be laid before Parliament."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-6-ss-3",
      "@type": "cof:Section",
      "cof:title": "6(3) Functions of Bureau",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(3) Subject to subsection (4), each new proposal for the collection of\ninformation for statistical purposes by the Bureau shall be laid\nbefore both Houses of the Parliament before its implementation,\nunless the proposal is for the collection of information on a\nvoluntary basis."
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-6-ss-3-norm",
      "@type": "values:Obligation",
