    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-24",
      "@type": "cml:Concept",
      "skos:prefLabel": "24 Annual report on the Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-24"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.17",
      "values:originalText": "(1) The Council must, as soon as practicable after 30 June in each\nyear, prepare and submit to the Minister, for presentation to the\nParliament, a report relating to matters connected with the\noperation of this Act.\n\n(2) The Minister must cause a copy of the report to be laid before each\nHouse of the Parliament within 15 sitting days of that House after\nits receipt by the Minister.",
      "skos:definition": "(1) The Council must, as soon as practicable after 30 June in each\nyear, prepare and submit to the Minister, for presentation to the\nParliament, a report relating to matters connected with the\noperation of this Act.\n\n(2) The Minister must cause a copy of the report to be laid before each\nHouse of the Parliament within 15 sitting days of that House after\nits receipt by the Minister.",
