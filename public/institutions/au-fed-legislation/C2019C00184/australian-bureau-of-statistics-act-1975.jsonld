    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-16a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "16A(3) Persons seconded to the Bureau",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-16a-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.13",
      "values:originalText": "(3) Subsection (1) has effect in addition to, and not in substitution for,\na provision of the Public Service Act 1999 that provides for the\nmaking of arrangements under which a person performs services in\nthe Bureau.\nNote:\nPersons whose services are made available in accordance with\narrangements made under the Public Service Act 1999 are covered by\nsubsection 16(1) of this Act.",
      "skos:definition": "(3) Subsection (1) has effect in addition to, and not in substitution for,\na provision of the Public Service Act 1999 that provides for the\nmaking of arrangements under which a person performs services in\nthe Bureau.\nNote:\nPersons whose services are made available in accordance with\narrangements made under the Public Service Act 1999 are covered by\nsubsection 16(1) of this Act.",
      "values:partOf": {
        "@id": "concept:australian-bureau-of-statistics-act-1975-sec-16a"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-16a-ss-3-norm"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-16a-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-16a-ss-3-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-16a-ss-3-logic-argumentation-3"
        }
      ],
      "cml:integrityHash": "a8c61003cfc94a931034242d2db86c36f898f8e5ef20dafecd6e497529bf16dc",
      "skos:note": "Persons seconded to the Bureau must comply with subsection (1) in addition to arrangements made under the Public Service Act 1999."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-16a-ss-3",
      "@type": "cof:Section",
      "cof:title": "16A(3) Persons seconded to the Bureau",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(3) Subsection (1) has effect in addition to, and not in substitution for,\na provision of the Public Service Act 1999 that provides for the\nmaking of arrangements under which a person performs services in\nthe Bureau.\nNote:\nPersons whose services are made available in accordance with\narrangements made under the Public Service Act 1999 are covered by\nsubsection 16(1) of this Act."
    },
