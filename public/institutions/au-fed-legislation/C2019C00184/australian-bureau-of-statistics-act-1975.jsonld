    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.10",
      "values:originalText": "The Statistician may resign his or her office by writing signed by\nthe Statistician and delivered to the Governor-General.",
      "skos:definition": "The Statistician may resign his or her office by writing signed by\nthe Statistician and delivered to the Governor-General.",
      "cml:asserts": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-11-norm"
        }
      ],
      "cml:integrityHash": "6dade7dc90873a35a8e6bc07756e705ec06b275e6211962a60c640cd4a807500",
      "skos:note": "The Statistician may resign by writing and delivering to the Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Resignation",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "The Statistician may resign his or her office by writing signed by\nthe Statistician and delivered to the Governor-General."
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-11-norm",
