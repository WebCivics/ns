    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-10-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Leave of absence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-10-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
