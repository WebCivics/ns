    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.5",
      "values:originalText": "In this Act, unless the contrary intention appears:\nBureau means the Australian Bureau of Statistics established by\nsubsection 5(1).\nChairperson means the Chairperson of the Council holding office\nunder subsection 19(2).\nCouncil means the Australian Statistics Advisory Council\nestablished by section 17.\nmember means a member of the Council.\nStatistician means the Australian Statistician referred to in\nsubsection 5(2).",
      "skos:definition": "In this Act, unless the contrary intention appears:\nBureau means the Australian Bureau of Statistics established by\nsubsection 5(1).\nChairperson means the Chairperson of the Council holding office\nunder subsection 19(2).\nCouncil means the Australian Statistics Advisory Council\nestablished by section 17.\nmember means a member of the Council.\nStatistician means the Australian Statistician referred to in\nsubsection 5(2).",
      "cml:asserts": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-3-2-norm"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-3-2-logic-deontic-1"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-3-2-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-3-2-logic-descriptionlogic-3"
        }
      ],
      "cml:integrityHash": "824bf7ffa24411f1898c6629285a9911a470fcf714673a17d3dbcbc43af8d8b6",
      "skos:note": "Definitions for terms used in the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Interpretation",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "In this Act, unless the contrary intention appears:\nBureau means the Australian Bureau of Statistics established by\nsubsection 5(1).\nChairperson means the Chairperson of the Council holding office\nunder subsection 19(2).\nCouncil means the Australian Statistics Advisory Council\nestablished by section 17.\nmember means a member of the Council.\nStatistician means the Australian Statistician referred to in\nsubsection 5(2)."
    },
