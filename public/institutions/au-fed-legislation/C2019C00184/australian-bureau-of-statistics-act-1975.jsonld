    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Remuneration of members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.15",
      "values:originalText": "(1) A member of the Council shall be paid such remuneration as is\ndetermined by the Remuneration Tribunal, but, if no determination\nof that remuneration by the Tribunal is in operation, the member\nshall be paid such remuneration as is prescribed.\n\n(2) A member of the Council shall be paid such allowances as are\nprescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "skos:definition": "(1) A member of the Council shall be paid such remuneration as is\ndetermined by the Remuneration Tribunal, but, if no determination\nof that remuneration by the Tribunal is in operation, the member\nshall be paid such remuneration as is prescribed.\n\n(2) A member of the Council shall be paid such allowances as are\nprescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-21-ss-1"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-21-ss-2"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-21-ss-3"
        }
      ],
      "cml:integrityHash": "64925a7dfb7e16c0f4ebf6a2d7fb56f3e33d8fc79411d74deb76b443bed2aaf0"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Remuneration of members",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "(1) A member of the Council shall be paid such remuneration as is\ndetermined by the Remuneration Tribunal, but, if no determination\nof that remuneration by the Tribunal is in operation, the member\nshall be paid such remuneration as is prescribed.\n\n(2) A member of the Council shall be paid such allowances as are\nprescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973."
    },
