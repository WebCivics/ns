          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-18-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b36326a86ee8a6db28762231e31e47828bd03b8ab653b5c31ea43642a90a0489",
      "skos:note": "Seeking advice from the Council on matters of a kind referred to in subsection (1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-18-ss-2",
      "@type": "cof:Section",
      "cof:title": "18(2) Functions of Council",
      "values:kind": "subsection",
      "cof:pageNumber": 14,
      "values:originalText": "(2) Either the Minister or the Statistician, or both of them, may refer\nmatters of the kind referred to in subsection (1) to the Council for\nthe purpose of seeking the advice of the Council in relation to those\nmatters."
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-18-ss-2-norm",
