    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Appointment and tenure of office of Statistician",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.9",
      "values:originalText": "(1) The Statistician shall be appointed by the Governor-General and,\nsubject to this Act, holds office for such period, not exceeding 7\nyears, as is specified in the instrument of his or her appointment\nbut is eligible for re-appointment.",
      "skos:definition": "(1) The Statistician shall be appointed by the Governor-General and,\nsubject to this Act, holds office for such period, not exceeding 7\nyears, as is specified in the instrument of his or her appointment\nbut is eligible for re-appointment.",
      "cml:asserts": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-7-norm"
        }
      ],
      "cml:integrityHash": "ecb765bcf97d864f0e9e80b68fae97819c27b3679a41813a05962a7d7aaabb10",
      "skos:note": "The Statistician shall be appointed by the Governor-General and holds office for a specified period."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Appointment and tenure of office of Statistician",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "(1) The Statistician shall be appointed by the Governor-General and,\nsubject to this Act, holds office for such period, not exceeding 7\nyears, as is specified in the instrument of his or her appointment\nbut is eligible for re-appointment."
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-7-norm",
      "@type": "values:Obligation",
      "cml:modality": {
