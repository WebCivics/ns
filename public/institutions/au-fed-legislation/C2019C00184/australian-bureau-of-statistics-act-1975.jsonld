      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.14",
      "values:originalText": "There is hereby established a Council to be known as the\nAustralian Statistics Advisory Council.",
      "skos:definition": "There is hereby established a Council to be known as the\nAustralian Statistics Advisory Council.",
      "cml:asserts": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-17-norm"
        }
      ],
      "cml:integrityHash": "de657d253e4655fdf271a41e21363d5fcb5f00fc3b0d7c26e64fc4b6b833e724",
      "skos:note": "Establishment of Australian Statistics Advisory Council"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Establishment of Council",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "There is hereby established a Council to be known as the\nAustralian Statistics Advisory Council."
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-17-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
