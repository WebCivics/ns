        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Statistician not to undertake any other work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-bureau-of-statistics-act-1975.pdf"
      },
      "dc:source": "australian-bureau-of-statistics-act-1975.pdf, p.10",
      "values:originalText": "The Statistician shall not engage in paid employment outside the\nduties of his or her office except with the approval of the Minister.",
      "skos:definition": "The Statistician shall not engage in paid employment outside the\nduties of his or her office except with the approval of the Minister.",
      "cml:asserts": [
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-8-norm"
        },
        {
          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "de8e451e1d30c17c7be315e5304e9d5a9a18891484ee2a8687dbfbaae1f134cd",
      "skos:note": "The Statistician shall not engage in paid employment outside the duties of his or her office except with the approval of the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Statistician not to undertake any other work",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "The Statistician shall not engage in paid employment outside the\nduties of his or her office except with the approval of the Minister."
    },
    {
      "@id": "concept:australian-bureau-of-statistics-act-1975-sec-8-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
