          "@id": "concept:australian-bureau-of-statistics-act-1975-sec-9-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b3e08482d704c0b19cb8aa581a190ddf55c23f45d72b41985cb700702527baa5",
      "skos:note": "Statue specifies remuneration for the Statistician."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-bureau-of-statistics-act-1975#sec-9-ss-1",
      "@type": "cof:Section",
      "cof:title": "9(1) Remuneration and allowances",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(1) The Statistician shall be paid such remuneration as is determined\nby the Remuneration Tribunal, but, if no determination of that\nremuneration by the Tribunal is in operation, the Statistician shall\nbe paid such remuneration as is prescribed."
    },
