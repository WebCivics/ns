      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Chair means the Chair of the Council.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
