      "cml:logicSummary": "Class hierarchy definition",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Associate member means a person holding an appointment under subsection 7(4)."
    },
    {
      "@id": "concept:australian-heritage-council-act-2003-sec-3-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Meet the registration criterion has the meaning given by subsection 22(2).",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy definition",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Council means the Australian Heritage Council established under section 4."
    },
