concept:australian-heritage-council-act-2003-sec-17 a cml:Concept ;
    skos:prefLabel "17 Quorum"@en ;
    cml:realizedBy doc:sec-17 ;
    values:originalText "A majority of the members for the time being holding office, other than associate members, constitutes a quorum." ;
