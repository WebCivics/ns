doc:sec-7-ss-3 a cof:Section ;
    cof:title "7(3) Appointment of members" ;
    values:kind "subsection" ;
    values:originalText "(3) In appointing the members other than the Chair and associate members, the Minister must ensure that:  (a) 2 of them have substantial experience or expertise concerning natural heritage; and  (b) 2 of them have substantial experience or expertise concerning historic heritage; and  (c) 2 of them are indigenous persons with substantial experience or expertise concerning indigenous heritage, at least one of whom represents the interests of indigenous people." ;
    cof:pageNumber "9"^^xsd:integer .

concept:australian-heritage-council-act-2003-sec-7-ss-4 a cml:Concept ;
    skos:prefLabel "7(4) Appointment of members"@en ;
    cml:realizedBy doc:sec-7-ss-4 ;
    values:originalText "(4) The Minister may appoint as an associate member a person who has substantial experience or expertise described in paragraph (3)(a), (b) or (c). The Minister may not appoint more than 2 persons to be associate members at one time." ;
    skos:definition "(4) The Minister may appoint as an associate member a person who has substantial experience or expertise described in paragraph (3)(a), (b) or (c). The Minister may not appoint more than 2 persons to be associate members at one time."@en ;
    cml:integrityHash "fa9e73a9c659bb3871933bbc53145472da2643c64c4072b658bebf87d76915cb" ;
    values:partOf concept:australian-heritage-council-act-2003-sec-7 ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "The Minister may appoint associate members." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
