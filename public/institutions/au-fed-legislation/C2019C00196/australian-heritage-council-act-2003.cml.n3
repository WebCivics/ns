doc:sec-16-ss-1 a cof:Section ;
    cof:title "16(1) Who presides at meetings" ;
    values:kind "subsection" ;
    values:originalText "(1) The Chair presides at all meetings at which he or she is present." ;
    cof:pageNumber "13"^^xsd:integer .

concept:australian-heritage-council-act-2003-sec-16-ss-2 a cml:Concept ;
    skos:prefLabel "16(2) Who presides at meetings"@en ;
    cml:realizedBy doc:sec-16-ss-2 ;
    values:originalText "(2) If the Chair is not present at a meeting, the members present, other than associate members, may elect a member, other than an associate member, to preside at the meeting." ;
    skos:definition "(2) If the Chair is not present at a meeting, the members present, other than associate members, may elect a member, other than an associate member, to preside at the meeting."@en ;
