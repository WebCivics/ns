    {
      "@id": "concept:australian-heritage-council-act-2003-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Functions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.7",
      "values:originalText": "These are the functions of the Council:\n\n(a) to make assessments under Divisions 1A and 3A of Part 15\nof the Environment Protection and Biodiversity Conservation\nAct 1999;\n\n(b) to advise the Minister on conserving and protecting places\nincluded, or being considered for inclusion, in the National\nHeritage List or Commonwealth Heritage List;\n\n(c) to nominate places for inclusion in the National Heritage List\nor Commonwealth Heritage List;\n\n(ca) to advise the Minister, in accordance with section 390P of the\nEnvironment Protection and Biodiversity Conservation\nAct 1999, in relation to the inclusion of places in, and the\nremoval of places from, the List of Overseas Places of\nHistoric Significance to Australia;\n\n(d) to advise the Minister on:\n\n(i) promotional, research, training or educational activities\nrelating to heritage; and\n\n(ii) national policies relating to heritage; and\n\n(iii) grants or other financial assistance relating to heritage;\nand\n\n(iv) the monitoring of the condition of places included in the\nNational Heritage List or Commonwealth Heritage List;\nand\n\n(v) the Commonwealth’s responsibilities for underwater\ncultural heritage; and\n\n(vi) other matters relating to heritage;",
      "skos:definition": "These are the functions of the Council:\n\n(a) to make assessments under Divisions 1A and 3A of Part 15\nof the Environment Protection and Biodiversity Conservation\nAct 1999;\n\n(b) to advise the Minister on conserving and protecting places\nincluded, or being considered for inclusion, in the National\nHeritage List or Commonwealth Heritage List;\n\n(c) to nominate places for inclusion in the National Heritage List\nor Commonwealth Heritage List;\n\n(ca) to advise the Minister, in accordance with section 390P of the\nEnvironment Protection and Biodiversity Conservation\nAct 1999, in relation to the inclusion of places in, and the\nremoval of places from, the List of Overseas Places of\nHistoric Significance to Australia;\n\n(d) to advise the Minister on:\n\n(i) promotional, research, training or educational activities\nrelating to heritage; and\n\n(ii) national policies relating to heritage; and\n\n(iii) grants or other financial assistance relating to heritage;\nand\n\n(iv) the monitoring of the condition of places included in the\nNational Heritage List or Commonwealth Heritage List;\nand\n\n(v) the Commonwealth’s responsibilities for underwater\ncultural heritage; and\n\n(vi) other matters relating to heritage;",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-5-norm"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ffc522d75737c22ffcfb40052da042310058ae2dff528719acda9f01b3396aa5",
      "skos:note": "Functions of the Council"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Functions",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "These are the functions of the Council:\n\n(a) to make assessments under Divisions 1A and 3A of Part 15\nof the Environment Protection and Biodiversity Conservation\nAct 1999;\n\n(b) to advise the Minister on conserving and protecting places\nincluded, or being considered for inclusion, in the National\nHeritage List or Commonwealth Heritage List;\n\n(c) to nominate places for inclusion in the National Heritage List\nor Commonwealth Heritage List;\n\n(ca) to advise the Minister, in accordance with section 390P of the\nEnvironment Protection and Biodiversity Conservation\nAct 1999, in relation to the inclusion of places in, and the\nremoval of places from, the List of Overseas Places of\nHistoric Significance to Australia;\n\n(d) to advise the Minister on:\n\n(i) promotional, research, training or educational activities\nrelating to heritage; and\n\n(ii) national policies relating to heritage; and\n\n(iii) grants or other financial assistance relating to heritage;\nand\n\n(iv) the monitoring of the condition of places included in the\nNational Heritage List or Commonwealth Heritage List;\nand\n\n(v) the Commonwealth’s responsibilities for underwater\ncultural heritage; and\n\n(vi) other matters relating to heritage;"
    },
