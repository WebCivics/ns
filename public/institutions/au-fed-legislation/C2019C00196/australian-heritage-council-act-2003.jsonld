    {
      "@id": "concept:australian-heritage-council-act-2003-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Acting appointments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.10",
      "values:originalText": "The Minister may appoint a member, other than an associate\nmember, to act as the Chair:\n\n(a) during a vacancy in the office of Chair (whether or not an\nappointment has previously been made to the office); or\n\n(b) during any period, or during all periods, when the Chair is\nabsent from duty or from Australia, or is for any reason\nunable to perform the duties of the office.\nNote:\nSection 33A of the Acts Interpretation Act 1901 has provisions\nrelating to acting appointments.",
      "skos:definition": "The Minister may appoint a member, other than an associate\nmember, to act as the Chair:\n\n(a) during a vacancy in the office of Chair (whether or not an\nappointment has previously been made to the office); or\n\n(b) during any period, or during all periods, when the Chair is\nabsent from duty or from Australia, or is for any reason\nunable to perform the duties of the office.\nNote:\nSection 33A of the Acts Interpretation Act 1901 has provisions\nrelating to acting appointments.",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-9-norm"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-9-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9ba0bd7ae97ca0fbf4b0d9c1690cfc13e97a8c69ff2411e1f65a0119f1ab0625",
      "skos:note": "The Minister may appoint a member to act as Chair."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Acting appointments",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "The Minister may appoint a member, other than an associate\nmember, to act as the Chair:\n\n(a) during a vacancy in the office of Chair (whether or not an\nappointment has previously been made to the office); or\n\n(b) during any period, or during all periods, when the Chair is\nabsent from duty or from Australia, or is for any reason\nunable to perform the duties of the office.\nNote:\nSection 33A of the Acts Interpretation Act 1901 has provisions\nrelating to acting appointments."
    },
