    {
      "@id": "concept:australian-heritage-council-act-2003-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Term of office of members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.10",
      "values:originalText": "(1) A member is to be appointed on a part-time basis.\n\n(2) A member holds office for the period specified in the instrument of\nappointment. The period must not exceed 3 years, or 1 year for an\nappointment of an associate member.\n\n(3) A member cannot be appointed for more than 2 consecutive\nperiods.",
      "skos:definition": "(1) A member is to be appointed on a part-time basis.\n\n(2) A member holds office for the period specified in the instrument of\nappointment. The period must not exceed 3 years, or 1 year for an\nappointment of an associate member.\n\n(3) A member cannot be appointed for more than 2 consecutive\nperiods.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-8-ss-1"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-8-ss-2"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-8-ss-3"
        }
      ],
      "cml:integrityHash": "bceb8d51f2a45855fb9260597af9be22e2ce333f835bed98b1c2d646f0471848"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Term of office of members",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) A member is to be appointed on a part-time basis.\n\n(2) A member holds office for the period specified in the instrument of\nappointment. The period must not exceed 3 years, or 1 year for an\nappointment of an associate member.\n\n(3) A member cannot be appointed for more than 2 consecutive\nperiods."
    },
