      ],
      "cml:integrityHash": "1339fb594616642f42af384525d549444715a2a638ec3ed06f2f6db517456a0c",
      "skos:note": "Member must be paid remuneration determined by the Remuneration Tribunal or prescribed."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-11-ss-1",
      "@type": "cof:Section",
      "cof:title": "11(1) Remuneration and allowances of members",
      "values:kind": "subsection",
      "cof:pageNumber": 11,
      "values:originalText": "(1) A member is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the member is to be paid the\nremuneration that is prescribed."
