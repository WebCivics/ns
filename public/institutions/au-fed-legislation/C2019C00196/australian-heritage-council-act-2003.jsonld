    {
      "@id": "concept:australian-heritage-council-act-2003-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Outside employment or other activities that conflict with a",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-10"
      },
      "cml:curationStatus": {
