    {
      "@id": "concept:australian-heritage-council-act-2003-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Remuneration and allowances of members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.11",
      "values:originalText": "(1) A member is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the member is to be paid the\nremuneration that is prescribed.\n\n(2) A member is to be paid the allowances that are prescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal\nAct 1973.",
      "skos:definition": "(1) A member is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the member is to be paid the\nremuneration that is prescribed.\n\n(2) A member is to be paid the allowances that are prescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal\nAct 1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-11-ss-1"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-11-ss-2"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-11-ss-3"
        }
      ],
      "cml:integrityHash": "258ba44bec5411d8e265a96458733b3501c08ca6d881446e5758761af3d4c445"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Remuneration and allowances of members",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "(1) A member is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the member is to be paid the\nremuneration that is prescribed.\n\n(2) A member is to be paid the allowances that are prescribed.\n\n(3) This section has effect subject to the Remuneration Tribunal\nAct 1973."
    },
    {
      "@id": "concept:australian-heritage-council-act-2003-sec-11-ss-1",
