      "cml:integrityHash": "3ec9128206d7e6586699bb0197328df3d22911750f7078536dcdd752524ed595",
      "skos:note": "Member cannot engage in paid employment or activities that conflict with duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Outside employment or other activities that conflict with a",
