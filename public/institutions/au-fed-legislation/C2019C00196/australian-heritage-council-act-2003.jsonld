    {
      "@id": "concept:australian-heritage-council-act-2003-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Who presides at meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.13",
      "values:originalText": "(1) The Chair presides at all meetings at which he or she is present.\n\n(2) If the Chair is not present at a meeting, the members present, other\nthan associate members, may elect a member, other than an\nassociate member, to preside at the meeting.",
      "skos:definition": "(1) The Chair presides at all meetings at which he or she is present.\n\n(2) If the Chair is not present at a meeting, the members present, other\nthan associate members, may elect a member, other than an\nassociate member, to preside at the meeting.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-16-ss-1"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-16-ss-2"
        }
      ],
      "cml:integrityHash": "6b9e01d98a0d98c683496442ac1d05cdd6b1652b6b8b4d29cfb540567585e018"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Who presides at meetings",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) The Chair presides at all meetings at which he or she is present.\n\n(2) If the Chair is not present at a meeting, the members present, other\nthan associate members, may elect a member, other than an\nassociate member, to preside at the meeting."
    },
