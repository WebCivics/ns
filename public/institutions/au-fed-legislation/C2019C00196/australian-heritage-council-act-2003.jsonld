      },
      "cml:premiseText": "Membership of an organisation",
      "cml:conclusionText": "does not conflict with proper performance of a member's duties"
    },
    {
      "@id": "concept:australian-heritage-council-act-2003-sec-10a-logic-alleninterval-2",
