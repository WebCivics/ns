    {
      "@id": "concept:australian-heritage-council-act-2003-sec-1-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 July 2019",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-1-2"
      },
