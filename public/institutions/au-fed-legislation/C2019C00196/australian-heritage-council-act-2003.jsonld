    {
      "@id": "concept:australian-heritage-council-act-2003-sec-10a",
      "@type": "cml:Concept",
      "skos:prefLabel": "10A No conflict with a member’s duty",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-10a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.10",
      "values:originalText": "For the purposes of section 10, membership of an organisation with\nsimilar goals and interests to those of the Council shall not be taken\nto conflict with the proper performance of a member’s duties.\n\n\nConstitution of the Council  Part 3\n\nSection 11\n\nAustralian Heritage Council Act 2003\nCompilation date: 1/7/19\nRegistered: 1/7/19",
      "skos:definition": "For the purposes of section 10, membership of an organisation with\nsimilar goals and interests to those of the Council shall not be taken\nto conflict with the proper performance of a member’s duties.\n\n\nConstitution of the Council  Part 3\n\nSection 11\n\nAustralian Heritage Council Act 2003\nCompilation date: 1/7/19\nRegistered: 1/7/19",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-10a-norm"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-10a-logic-deontic-1"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-10a-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "61b390d008ae12dc0a9a96886c38053dcf3d92dd22c1abe05888826128a51ddd",
      "skos:note": "No conflict with membership and duty"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-10a",
      "@type": "cof:Section",
      "cof:title": "10A No conflict with a member’s duty",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "For the purposes of section 10, membership of an organisation with\nsimilar goals and interests to those of the Council shall not be taken\nto conflict with the proper performance of a member’s duties.\n\n\nConstitution of the Council  Part 3\n\nSection 11\n\nAustralian Heritage Council Act 2003\nCompilation date: 1/7/19\nRegistered: 1/7/19"
    },
