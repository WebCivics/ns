    {
      "@id": "concept:australian-heritage-council-act-2003-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Membership of the Council",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.9",
      "values:originalText": "The Council consists of:\n\n(a) the Chair; and\n\n(b) 6 members other than the Chair and associate members; and\n\n(c) each associate member (if any) who has been appointed.",
      "skos:definition": "The Council consists of:\n\n(a) the Chair; and\n\n(b) 6 members other than the Chair and associate members; and\n\n(c) each associate member (if any) who has been appointed.",
