      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.11",
      "values:originalText": "(1) A member is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the member is to be paid the\nremuneration that is prescribed.",
      "skos:definition": "(1) A member is to be paid the remuneration that is determined by the\nRemuneration Tribunal. If no determination of that remuneration\nby the Tribunal is in operation, the member is to be paid the\nremuneration that is prescribed.",
      "values:partOf": {
        "@id": "concept:australian-heritage-council-act-2003-sec-11"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-11-ss-1-norm"
