    {
      "@id": "concept:australian-heritage-council-act-2003-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Conduct of meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.14",
      "values:originalText": "The Council may, subject to this Part, regulate proceedings at its\nmeetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc.\n\n\nMeetings of the Council  Part 4\n\nSection 20A\n\nAustralian Heritage Council Act 2003\nCompilation date: 1/7/19\nRegistered: 1/7/19",
      "skos:definition": "The Council may, subject to this Part, regulate proceedings at its\nmeetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc.\n\n\nMeetings of the Council  Part 4\n\nSection 20A\n\nAustralian Heritage Council Act 2003\nCompilation date: 1/7/19\nRegistered: 1/7/19",
      "cml:asserts": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-20-norm"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f5cce62ce29b15439a156929694aa9c2b61f9e7b3cbc42f345c7b6b448e8c24c",
      "skos:note": "The Council may regulate proceedings at its meetings as it considers appropriate.",
      "dc:references": [
        "sec-33B"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Conduct of meetings",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The Council may, subject to this Part, regulate proceedings at its\nmeetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc.\n\n\nMeetings of the Council  Part 4\n\nSection 20A\n\nAustralian Heritage Council Act 2003\nCompilation date: 1/7/19\nRegistered: 1/7/19"
    },
    {
      "@id": "concept:australian-heritage-council-act-2003-sec-20-norm",
