        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-heritage-council-act-2003-sec-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition on termination",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-heritage-council-act-2003-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Times and places of meetings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-heritage-council-act-2003.pdf"
      },
      "dc:source": "australian-heritage-council-act-2003.pdf, p.13",
      "values:originalText": "(1) The Council is to hold such meetings as are necessary for the\nefficient performance of its functions.\n\n(2) Meetings are to be held at the times and places determined by the\nCouncil.\n\n(3) The Chair may call a meeting at any time. However, the Chair\nmust call a meeting if a majority of the members for the time being\nholding office, other than associate members, request the Chair to\ndo so.\n\n(4) The Minister may, at any time, direct the Chair to call a meeting.\n\n(5) The Chair must ensure that at least 4 meetings are held each year.",
      "skos:definition": "(1) The Council is to hold such meetings as are necessary for the\nefficient performance of its functions.\n\n(2) Meetings are to be held at the times and places determined by the\nCouncil.\n\n(3) The Chair may call a meeting at any time. However, the Chair\nmust call a meeting if a majority of the members for the time being\nholding office, other than associate members, request the Chair to\ndo so.\n\n(4) The Minister may, at any time, direct the Chair to call a meeting.\n\n(5) The Chair must ensure that at least 4 meetings are held each year.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-14-ss-1"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-14-ss-2"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-14-ss-3"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-14-ss-4"
        },
        {
          "@id": "concept:australian-heritage-council-act-2003-sec-14-ss-5"
        }
      ],
      "cml:integrityHash": "59934a8b27032f7bf16189055df9490db784662f621892b3ab91231910e74b81"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Times and places of meetings",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) The Council is to hold such meetings as are necessary for the\nefficient performance of its functions.\n\n(2) Meetings are to be held at the times and places determined by the\nCouncil.\n\n(3) The Chair may call a meeting at any time. However, the Chair\nmust call a meeting if a majority of the members for the time being\nholding office, other than associate members, request the Chair to\ndo so.\n\n(4) The Minister may, at any time, direct the Chair to call a meeting.\n\n(5) The Chair must ensure that at least 4 meetings are held each year."
    },
