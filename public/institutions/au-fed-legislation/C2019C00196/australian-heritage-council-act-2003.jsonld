      "skos:note": "Council membership requirements"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Membership of the Council",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "The Council consists of:\n\n(a) the Chair; and\n\n(b) 6 members other than the Chair and associate members; and\n\n(c) each associate member (if any) who has been appointed."
    },
