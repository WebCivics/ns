        }
      ],
      "cml:integrityHash": "5e893b336e67cf2905bc63708c5a4c4aa5a71bf85ec8536eb71ff1605b45ac40",
      "skos:note": "Establishs the Australian Heritage Council."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-heritage-council-act-2003#sec-4",
