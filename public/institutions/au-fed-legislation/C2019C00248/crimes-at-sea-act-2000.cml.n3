concept:crimes-at-sea-act-2000-sch-1-sec-13 a cml:Concept ;
    skos:prefLabel "13 Definitions"@en ;
    cml:realizedBy doc:sch-1-sec-13 ;
    values:originalText "In this Part: baseline of Australia’s territorial sea means the baseline from which the breadth of the territorial sea is to be measured under section 7 of the Seas and Submerged Lands Act 1973 (Commonwealth)." ;
    skos:definition "In this Part: baseline of Australia’s territorial sea means the baseline from which the breadth of the territorial sea is to be measured under section 7 of the Seas and Submerged Lands Act 1973 (Commonwealth)."@en ;
    cml:integrityHash "debaa9d742fca37d0816050a43df2ddce783527421befd89fac92559c4638cf8" ;
    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Defines baseline of Australia's territorial sea" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
