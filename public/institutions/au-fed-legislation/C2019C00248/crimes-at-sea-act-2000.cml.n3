concept:crimes-at-sea-act-2000-sch-1-sec-4 a cml:Concept ;
    skos:prefLabel "4 Evidentiary presumption about the locus of an offence"@en ;
    cml:realizedBy doc:sch-1-sec-4 ;
    values:originalText "If, in proceedings for a maritime offence, an alleged act, omission or state of affairs, that is an element of the offence, is proved, an allegation in the information or complaint that the act, omission or state of affairs happened in the adjacent area, inner adjacent area, or outer adjacent area for a particular State is taken to be proved in the absence of proof to the contrary.  The cooperative scheme  Schedule 1 The intergovernmental agreement  Part 3  Clause 5  Crimes at Sea Act 2000 Compilation date: 30/8/19 Registered: 2/9/19" ;
    skos:definition "If, in proceedings for a maritime offence, an alleged act, omission or state of affairs, that is an element of the offence, is proved, an allegation in the information or complaint that the act, omission or state of affairs happened in the adjacent area, inner adjacent area, or outer adjacent area for a particular State is taken to be proved in the absence of proof to the contrary.  The cooperative scheme  Schedule 1 The intergovernmental agreement  Part 3  Clause 5  Crimes at Sea Act 2000 Compilation date: 30/8/19 Registered: 2/9/19"@en ;
    cml:integrityHash "4a42fc7e63de0a5f6d50596619c7699fc88dcdb17fa59ce63e6a5c31d8f96756" ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Evidentiary presumption about the locus of an offence" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-at-sea-act-2000.pdf> ;
    dc:source "crimes-at-sea-act-2000.pdf, p.24" ;
