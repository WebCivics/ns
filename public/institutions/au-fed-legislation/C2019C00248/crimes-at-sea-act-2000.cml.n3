    cml:operator "requires" ;
    cml:logicSummary "The Commonwealth Attorney-general's written consent is required for certain maritime offences." ;
    cml:premiseText "(1) The Commonwealth Attorney-general’s written consent is required..." ;
    cml:conclusionText "...before a charge of a maritime offence can proceed to hearing or determination..." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
