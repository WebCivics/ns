concept:crimes-at-sea-act-2000-sch-2-sec-6b a cml:Concept ;
    skos:prefLabel "6B Transit of persons accused of offences against the laws of"@en ;
    cml:realizedBy doc:sch-2-sec-6b ;
    values:originalText "Timor-Leste  (1) If Timor-Leste wishes to transport in custody through Australia a person (the accused) who has been arrested for an offence against a criminal law in force in Timor-Leste that applies in the Greater Sunrise special regime area, the following provisions apply:  (a) the accused may be transported in custody through Australia; and" ;
    skos:definition "Timor-Leste  (1) If Timor-Leste wishes to transport in custody through Australia a person (the accused) who has been arrested for an offence against a criminal law in force in Timor-Leste that applies in the Greater Sunrise special regime area, the following provisions apply:  (a) the accused may be transported in custody through Australia; and"@en ;
    cml:integrityHash "62ea1d5261b62cf8e8ae7cd406035ba0a583ebdbb64ecca96571192b4123ec5f" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Permits transportation of accused persons through Australia" ;
    cml:curationStatus cml:Proposed ;
