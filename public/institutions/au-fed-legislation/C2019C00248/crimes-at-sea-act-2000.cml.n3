concept:crimes-at-sea-act-2000-sch-1-sec-7-ss-4 a cml:Concept ;
    skos:prefLabel "7(4) Commonwealth Attorney-General’s consent required for certain"@en ;
    cml:realizedBy doc:sch-1-sec-7-ss-4 ;
    values:originalText "(4) If the Commonwealth Attorney-General declines to grant consent, the court in which the suspected offender has been charged with the offence must permanently stay the proceedings." ;
    skos:definition "(4) If the Commonwealth Attorney-General declines to grant consent, the court in which the suspected offender has been charged with the offence must permanently stay the proceedings."@en ;
