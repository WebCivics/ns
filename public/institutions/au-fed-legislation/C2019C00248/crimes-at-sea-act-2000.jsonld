    {
      "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-2-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.17",
      "values:originalText": "(1) The Governor-General may make regulations prescribing matters:\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n\n(2) However, this section does not authorise the making of regulations\nfor the purposes of the cooperative scheme.\nNote:\nThe Governor-General has power to make regulations for the purposes\nof the cooperative scheme under clause 12 of the scheme.\n\nSchedule 1  The cooperative scheme",
      "skos:definition": "(1) The Governor-General may make regulations prescribing matters:\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n\n(2) However, this section does not authorise the making of regulations\nfor the purposes of the cooperative scheme.\nNote:\nThe Governor-General has power to make regulations for the purposes\nof the cooperative scheme under clause 12 of the scheme.\n\nSchedule 1  The cooperative scheme",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-9-ss-1"
        },
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-9-ss-2"
        }
      ],
      "cml:integrityHash": "e63854e0a4f3c891a303396b5e7f905cb3672ec0d195b4cd74406a8fd70dca5b"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-2-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Regulations",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "(1) The Governor-General may make regulations prescribing matters:\n\n(a) required or permitted by this Act to be prescribed; or\n\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.\n\n(2) However, this section does not authorise the making of regulations\nfor the purposes of the cooperative scheme.\nNote:\nThe Governor-General has power to make regulations for the purposes\nof the cooperative scheme under clause 12 of the scheme.\n\nSchedule 1  The cooperative scheme"
    },
    {
      "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-9-ss-1",
      "@type": "cml:Concept",
