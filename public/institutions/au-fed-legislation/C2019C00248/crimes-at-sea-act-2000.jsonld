    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.29",
      "values:originalText": "In this Part:\nbaseline of Australia’s territorial sea means the baseline from\nwhich the breadth of the territorial sea is to be measured under\nsection 7 of the Seas and Submerged Lands Act 1973\n(Commonwealth).",
      "skos:definition": "In this Part:\nbaseline of Australia’s territorial sea means the baseline from\nwhich the breadth of the territorial sea is to be measured under\nsection 7 of the Seas and Submerged Lands Act 1973\n(Commonwealth).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-13-norm"
        },
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-13-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "debaa9d742fca37d0816050a43df2ddce783527421befd89fac92559c4638cf8",
      "skos:note": "Defines baseline of Australia's territorial sea"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "In this Part:\nbaseline of Australia’s territorial sea means the baseline from\nwhich the breadth of the territorial sea is to be measured under\nsection 7 of the Seas and Submerged Lands Act 1973\n(Commonwealth)."
    },
    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-13-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
