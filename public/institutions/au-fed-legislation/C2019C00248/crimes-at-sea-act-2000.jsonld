    {
      "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Ratification of cooperative scheme",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-2-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.8",
      "values:originalText": "To the extent that it lies within the legislative competence of the\nCommonwealth to give the cooperative scheme the force of law, it\nhas the force of law.\n\n\nApplication of criminal law outside adjacent area  Part 3\n\nSection 6\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19",
      "skos:definition": "To the extent that it lies within the legislative competence of the\nCommonwealth to give the cooperative scheme the force of law, it\nhas the force of law.\n\n\nApplication of criminal law outside adjacent area  Part 3\n\nSection 6\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19",
      "cml:asserts": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-5-norm"
        },
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b63e19ba845b85c0b42f41721a4332229fd280380a1053b559e56607acb40cf1",
      "skos:note": "The Commonwealth has the force of law to give the cooperative scheme."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-2-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Ratification of cooperative scheme",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "To the extent that it lies within the legislative competence of the\nCommonwealth to give the cooperative scheme the force of law, it\nhas the force of law.\n\n\nApplication of criminal law outside adjacent area  Part 3\n\nSection 6\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19"
    },
