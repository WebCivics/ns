    {
      "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-2-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.6",
      "values:originalText": "(1) Sections 1 and 2 commence on the day on which this Act receives\nthe Royal Assent.\n\n(2) Subject to subsection (3), the remaining provisions of this Act\ncommence on a day to be fixed by Proclamation.\n\n(3) If the provisions referred to in subsection (2) do not commence\nunder that subsection within the period of 12 months beginning on\nthe day on which this Act receives the Royal Assent, they\ncommence on the first day after the end of that period.",
      "skos:definition": "(1) Sections 1 and 2 commence on the day on which this Act receives\nthe Royal Assent.\n\n(2) Subject to subsection (3), the remaining provisions of this Act\ncommence on a day to be fixed by Proclamation.\n\n(3) If the provisions referred to in subsection (2) do not commence\nunder that subsection within the period of 12 months beginning on\nthe day on which this Act receives the Royal Assent, they\ncommence on the first day after the end of that period.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-2-ss-1"
        },
