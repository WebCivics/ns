    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
