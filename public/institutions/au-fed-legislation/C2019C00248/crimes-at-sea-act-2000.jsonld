      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-5-ss-2-norm"
        }
      ],
      "cml:integrityHash": "28aa080e6ea877e535bda9fb40a28249a1e1ec1db03cfdb04f03447728357beb",
      "skos:note": "Concurrent responsibility in specified parts of the adjacent area."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-5-ss-2",
      "@type": "cof:Section",
      "cof:title": "5(2) Intergovernmental agreement",
      "values:kind": "subsection",
      "cof:pageNumber": 25,
      "values:originalText": "(2) The intergovernmental agreement may provide for concurrent\nresponsibility in specified parts of the adjacent area."
    },
    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-5-ss-2-norm",
      "@type": "values:Obligation",
