    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Baselines",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.30",
      "values:originalText": "The baseline for a State is the part of the baseline of Australia’s\nterritorial sea from which the part of the territorial sea that is within\nthe adjacent area for that State is measured.",
      "skos:definition": "The baseline for a State is the part of the baseline of Australia’s\nterritorial sea from which the part of the territorial sea that is within\nthe adjacent area for that State is measured.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-15-norm"
        }
      ],
      "cml:integrityHash": "6686b1f300d2b49db54c2cbb0dfdfe42b2f0d1875116f1ebc404aeca3beb2382",
      "skos:note": "Defines baseline for a State's territorial sea"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Baselines",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "The baseline for a State is the part of the baseline of Australia’s\nterritorial sea from which the part of the territorial sea that is within\nthe adjacent area for that State is measured."
    },
