    {
      "@id": "concept:crimes-at-sea-act-2000-sch-2-sec-6-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "6(3) Application of Australian criminal law outside the adjacent area",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-2-sec-6-ss-3"
      },
      "cml:curationStatus": {
