    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-7-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "7(5) Commonwealth Attorney-General’s consent required for certain",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-7-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.26",
      "values:originalText": "(5) In any proceedings, an apparently genuine document purporting to\nbe a copy of a written consent granted by the Commonwealth\n\nThe cooperative scheme  Schedule 1\nLimitations and exclusions  Part 4\n\nClause 8\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19\n\nAttorney-General in accordance with this clause will be accepted,\nin the absence of proof to the contrary, as proof of such consent.",
      "skos:definition": "(5) In any proceedings, an apparently genuine document purporting to\nbe a copy of a written consent granted by the Commonwealth\n\nThe cooperative scheme  Schedule 1\nLimitations and exclusions  Part 4\n\nClause 8\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19\n\nAttorney-General in accordance with this clause will be accepted,\nin the absence of proof to the contrary, as proof of such consent.",
      "values:partOf": {
        "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-7"
      },
      "cml:asserts": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-7-ss-5-norm"
        },
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-7-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "df99bbf627a044bb071147066569bd4c6abc31d73e581cad089304118f38fef5",
      "skos:note": "Commonwealth Attorney-general's consent required for certain documents"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-7-ss-5",
      "@type": "cof:Section",
      "cof:title": "7(5) Commonwealth Attorney-General’s consent required for certain",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(5) In any proceedings, an apparently genuine document purporting to\nbe a copy of a written consent granted by the Commonwealth\n\nThe cooperative scheme  Schedule 1\nLimitations and exclusions  Part 4\n\nClause 8\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19\n\nAttorney-General in accordance with this clause will be accepted,\nin the absence of proof to the contrary, as proof of such consent."
    },
