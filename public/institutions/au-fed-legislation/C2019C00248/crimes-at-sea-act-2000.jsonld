    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Evidentiary presumption about the locus of an offence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.24",
      "values:originalText": "If, in proceedings for a maritime offence, an alleged act, omission\nor state of affairs, that is an element of the offence, is proved, an\nallegation in the information or complaint that the act, omission or\nstate of affairs happened in the adjacent area, inner adjacent area,\nor outer adjacent area for a particular State is taken to be proved in\nthe absence of proof to the contrary.\n\nThe cooperative scheme  Schedule 1\nThe intergovernmental agreement  Part 3\n\nClause 5\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19",
      "skos:definition": "If, in proceedings for a maritime offence, an alleged act, omission\nor state of affairs, that is an element of the offence, is proved, an\nallegation in the information or complaint that the act, omission or\nstate of affairs happened in the adjacent area, inner adjacent area,\nor outer adjacent area for a particular State is taken to be proved in\nthe absence of proof to the contrary.\n\nThe cooperative scheme  Schedule 1\nThe intergovernmental agreement  Part 3\n\nClause 5\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19",
      "cml:asserts": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-4-norm"
        }
      ],
      "cml:integrityHash": "4a42fc7e63de0a5f6d50596619c7699fc88dcdb17fa59ce63e6a5c31d8f96756",
      "skos:note": "Evidentiary presumption about the locus of an offence"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Evidentiary presumption about the locus of an offence",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "If, in proceedings for a maritime offence, an alleged act, omission\nor state of affairs, that is an element of the offence, is proved, an\nallegation in the information or complaint that the act, omission or\nstate of affairs happened in the adjacent area, inner adjacent area,\nor outer adjacent area for a particular State is taken to be proved in\nthe absence of proof to the contrary.\n\nThe cooperative scheme  Schedule 1\nThe intergovernmental agreement  Part 3\n\nClause 5\n\nCrimes at Sea Act 2000\nCompilation date: 30/8/19\nRegistered: 2/9/19"
    },
    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-4-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-4"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Intergovernmental agreement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.25",
      "values:originalText": "(1) The Commonwealth Attorney-General, on behalf of the\nCommonwealth, and the participating State Ministers may enter\ninto an agreement providing for the division of responsibility for\nadministering and enforcing the law relating to maritime offences.\n\n(2) The intergovernmental agreement may provide for concurrent\nresponsibility in specified parts of the adjacent area.",
      "skos:definition": "(1) The Commonwealth Attorney-General, on behalf of the\nCommonwealth, and the participating State Ministers may enter\ninto an agreement providing for the division of responsibility for\nadministering and enforcing the law relating to maritime offences.\n\n(2) The intergovernmental agreement may provide for concurrent\nresponsibility in specified parts of the adjacent area.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-5-ss-1"
        },
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-5-ss-2"
        }
      ],
      "cml:integrityHash": "68219b5106893bad2dc3ed4e22a54678e2990dc6fd62c7b178a5c0a5a9382a7c"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Intergovernmental agreement",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "(1) The Commonwealth Attorney-General, on behalf of the\nCommonwealth, and the participating State Ministers may enter\ninto an agreement providing for the division of responsibility for\nadministering and enforcing the law relating to maritime offences.\n\n(2) The intergovernmental agreement may provide for concurrent\nresponsibility in specified parts of the adjacent area."
    },
