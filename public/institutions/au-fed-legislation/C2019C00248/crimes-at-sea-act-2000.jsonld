    {
      "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Non-exclusion of consistent extraterritorial legislative schemes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-at-sea-act-2000.pdf"
      },
      "dc:source": "crimes-at-sea-act-2000.pdf, p.27",
      "values:originalText": "This scheme does not exclude the extraterritorial operation of State\nlaw to the extent that the State law is capable of operating\nextraterritorially consistently with the scheme.",
      "skos:definition": "This scheme does not exclude the extraterritorial operation of State\nlaw to the extent that the State law is capable of operating\nextraterritorially consistently with the scheme.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-8-norm"
        },
        {
          "@id": "concept:crimes-at-sea-act-2000-sch-1-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1dbee438406520ec24f1a66ad61ed05299da926d09a5aa22350735257e3bb01a",
      "skos:note": "State law can operate extraterritorially consistently with the scheme."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-at-sea-act-2000#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Non-exclusion of consistent extraterritorial legislative schemes",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "This scheme does not exclude the extraterritorial operation of State\nlaw to the extent that the State law is capable of operating\nextraterritorially consistently with the scheme."
    },
