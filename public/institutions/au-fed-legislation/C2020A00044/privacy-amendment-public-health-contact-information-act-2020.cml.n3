concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94k a cml:Concept ;
    skos:prefLabel "94K COVID app data not to be retained"@en ;
    cml:realizedBy doc:sch-1-sec-94k ;
    values:originalText "The data store administrator must take all reasonable steps to ensure that COVID app data is not retained on a communication device:  (a) for more than 21 days; or  (b) in any case in which it is not possible to comply with paragraph (a) within 21 days—for longer than the shortest practicable period.  Amendments  Schedule 1  No. 44, 2020 Privacy Amendment (Public Health Contact Information) Act 2020" ;
    skos:definition "The data store administrator must take all reasonable steps to ensure that COVID app data is not retained on a communication device:  (a) for more than 21 days; or  (b) in any case in which it is not possible to comply with paragraph (a) within 21 days—for longer than the shortest practicable period.  Amendments  Schedule 1  No. 44, 2020 Privacy Amendment (Public Health Contact Information) Act 2020"@en ;
    cml:integrityHash "fd2e0d3834960fbc26402823932ea11d204950fb407dccdd5e3d815d43b22345" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Data must not be retained on a communication device for more than 21 days." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-amendment-public-health-contact-information-act-2020.pdf> ;
