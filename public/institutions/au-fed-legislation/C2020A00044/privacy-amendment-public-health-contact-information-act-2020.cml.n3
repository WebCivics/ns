doc:sch-1-sec-94p-ss-2 a cof:Section ;
    cof:title "94P(2) Obligations after the end of the COVIDSafe data period" ;
    values:kind "subsection" ;
    values:originalText "(2) As soon as reasonably practicable after the end of the day determined under subsection 94Y(1), the data store administrator must delete all COVID app data from the National COVIDSafe Data Store." ;
    cof:pageNumber "18"^^xsd:integer .

concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94p-ss-3 a cml:Concept ;
    skos:prefLabel "94P(3) Obligations after the end of the COVIDSafe data period"@en ;
    cml:realizedBy doc:sch-1-sec-94p-ss-3 ;
    values:originalText "(3) As soon as reasonably practicable after the deletion, the data store administrator must:  (a) inform the Health Minister and the Commissioner that all COVID app data has been deleted from the National COVIDSafe Data Store; and  (b) take all reasonable steps to inform all COVIDSafe users (other than former COVIDSafe users) in relation to communication devices that:  (i) all COVID app data has been deleted from the National COVIDSafe Data Store; and  Amendments  Schedule 1  No. 44, 2020 Privacy Amendment (Public Health Contact Information) Act 2020  (ii) COVID app data can no longer be collected; and  (iii) they should delete COVIDSafe from their communication devices." ;
    skos:definition "(3) As soon as reasonably practicable after the deletion, the data store administrator must:  (a) inform the Health Minister and the Commissioner that all COVID app data has been deleted from the National COVIDSafe Data Store; and  (b) take all reasonable steps to inform all COVIDSafe users (other than former COVIDSafe users) in relation to communication devices that:  (i) all COVID app data has been deleted from the National COVIDSafe Data Store; and  Amendments  Schedule 1  No. 44, 2020 Privacy Amendment (Public Health Contact Information) Act 2020  (ii) COVID app data can no longer be collected; and  (iii) they should delete COVIDSafe from their communication devices."@en ;
    cml:integrityHash "07b4c6c43599249fa5b760471b4599cad5e8e32aabe3bceb5f5e3b07b3a89912" ;
    values:partOf concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94p ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Inform Health Minister and Commissioner of COVID app data deletion." ;
    dc:description "Information about COVID app data deletion." ;
    cml:curationStatus cml:Proposed ;
