concept:privacy-amendment-public-health-contact-information-act-2020-sch-2-sec-4 a cml:Concept ;
    skos:prefLabel "4 Transitional"@en ;
    cml:realizedBy doc:sch-2-sec-4 ;
    values:originalText "After the commencement of this item:  (a) the powers of the Commissioner under or in relation to Part VIIIA of the Privacy Act 1988 as amended by this Act continue to apply in relation to matters that arose under or in relation to that Part before that commencement; and  (b) any obligations of the Health Minister or the Commissioner under that Part relating to a report continue to apply; as if the repeals made by items 2 and 3 of this Schedule had not been made.  [Minister’s second reading speech made in— House of Representatives on 12 May 2020 Senate on 13 May 2020]  (75/20)" ;
    skos:definition "After the commencement of this item:  (a) the powers of the Commissioner under or in relation to Part VIIIA of the Privacy Act 1988 as amended by this Act continue to apply in relation to matters that arose under or in relation to that Part before that commencement; and  (b) any obligations of the Health Minister or the Commissioner under that Part relating to a report continue to apply; as if the repeals made by items 2 and 3 of this Schedule had not been made.  [Minister’s second reading speech made in— House of Representatives on 12 May 2020 Senate on 13 May 2020]  (75/20)"@en ;
    cml:integrityHash "51b16e1c12a78b2a740ee807f40d5f952186a712ef99e979897008ac9f7a637b" ;
    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Continuation of powers and obligations after commencement" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
