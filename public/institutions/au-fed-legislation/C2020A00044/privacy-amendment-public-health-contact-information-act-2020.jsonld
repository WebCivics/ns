    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94zd",
      "@type": "cml:Concept",
      "skos:prefLabel": "94ZD Operation of other laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94zd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
