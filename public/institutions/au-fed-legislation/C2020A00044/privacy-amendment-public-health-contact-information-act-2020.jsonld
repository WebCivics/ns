      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 6(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
