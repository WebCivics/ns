      ],
      "cml:integrityHash": "13adcaf80587687a6b62b1b69122d4a4c0d1a7112d5aed0c19a792964da4da74",
      "skos:note": "Incidental collection of COVID app data does not affect admissibility as evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94d-ss-4",
      "@type": "cof:Section",
      "cof:title": "94D(4) Collection, use or disclosure of COVID app data",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(4) The admissibility of the non-COVID app data as evidence in any\nproceedings is not affected by the incidental collection of the\nCOVID app data, or by the subsequent deletion of the COVID app\ndata as required by subparagraph (3)(c)(i)."
    },
    {
