      },
      "cml:premiseText": "(3) A complaint transferred under subsection (2) is taken, for the purposes of this Act, to have been made to that State or Territory authority.",
      "cml:conclusionText": "The State or Territory must take the complaint."
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94v-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
