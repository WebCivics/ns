    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94b",
      "@type": "cml:Concept",
      "skos:prefLabel": "94B Object of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-public-health-contact-information-act-2020.pdf"
      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.9",
      "values:originalText": "The object of this Part is to assist in preventing and controlling the\nentry, emergence, establishment or spread of the coronavirus\nknown as COVID-19 into Australia or any part of Australia by\nproviding stronger privacy protections for COVID app data and\nCOVIDSafe users in order to:\n\n(a) encourage public acceptance and uptake of COVIDSafe; and\n\n(b) enable faster and more effective contact tracing.\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Public Health Contact Information) Act 2020\nNo. 44, 2020",
      "skos:definition": "The object of this Part is to assist in preventing and controlling the\nentry, emergence, establishment or spread of the coronavirus\nknown as COVID-19 into Australia or any part of Australia by\nproviding stronger privacy protections for COVID app data and\nCOVIDSafe users in order to:\n\n(a) encourage public acceptance and uptake of COVIDSafe; and\n\n(b) enable faster and more effective contact tracing.\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Public Health Contact Information) Act 2020\nNo. 44, 2020",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94b-norm"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a1692002e77e496ec681135c39495199453924997a8bdccc94afd1a1fc999483",
      "skos:note": "Encourage public acceptance and uptake of COVIDSafe."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94b",
      "@type": "cof:Section",
      "cof:title": "94B Object of this Part",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "The object of this Part is to assist in preventing and controlling the\nentry, emergence, establishment or spread of the coronavirus\nknown as COVID-19 into Australia or any part of Australia by\nproviding stronger privacy protections for COVID app data and\nCOVIDSafe users in order to:\n\n(a) encourage public acceptance and uptake of COVIDSafe; and\n\n(b) enable faster and more effective contact tracing.\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Public Health Contact Information) Act 2020\nNo. 44, 2020"
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
