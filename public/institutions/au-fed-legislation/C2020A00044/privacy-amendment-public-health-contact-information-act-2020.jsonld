    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94h-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "94H(3) Requiring the use of COVIDSafe",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94h-ss-3"
      },
