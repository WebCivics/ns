    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94m",
      "@type": "cml:Concept",
      "skos:prefLabel": "94M Deletion of data received in error",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-public-health-contact-information-act-2020.pdf"
      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.17",
      "values:originalText": "A person who receives COVID app data in error must, as soon as\npracticable:\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Public Health Contact Information) Act 2020\nNo. 44, 2020\n\n(a) delete the data; and\n\n(b) notify the data store administrator that the person received\nthe data.",
      "skos:definition": "A person who receives COVID app data in error must, as soon as\npracticable:\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Public Health Contact Information) Act 2020\nNo. 44, 2020\n\n(a) delete the data; and\n\n(b) notify the data store administrator that the person received\nthe data.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94m-norm"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94m-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1df47c226458a4c6e6435eb5b930d388430afa6d9946fc9fe1c777618611e6db",
      "skos:note": "Delete COVID app data received in error and notify administrator.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94m",
      "@type": "cof:Section",
      "cof:title": "94M Deletion of data received in error",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "A person who receives COVID app data in error must, as soon as\npracticable:\n\nSchedule 1  Amendments\n\nPrivacy Amendment (Public Health Contact Information) Act 2020\nNo. 44, 2020\n\n(a) delete the data; and\n\n(b) notify the data store administrator that the person received\nthe data."
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94m-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94m"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:NaturalPerson"
      },
      "skos:scopeNote": "borne by: NaturalPerson"
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94m-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to delete data",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94n",
      "@type": "cml:Concept",
      "skos:prefLabel": "94N Effect of deletion of COVIDSafe from a communication device",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-public-health-contact-information-act-2020.pdf"
      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.18",
      "values:originalText": "(1) The data store administrator must not collect from a person,\nthrough a particular communication device, COVID app data\nrelating to the person if the person is a former COVIDSafe user in\nrelation to that device.\n\n(2) A person is a former COVIDSafe user, in relation to a\ncommunication device, at a particular time if:\n\n(a) COVIDSafe has been deleted from the device in relation to\nwhich the person was the COVIDSafe user; and\n\n(b) after COVIDSafe was last deleted from that device—\nCOVIDSafe has not been downloaded to that device.",
      "skos:definition": "(1) The data store administrator must not collect from a person,\nthrough a particular communication device, COVID app data\nrelating to the person if the person is a former COVIDSafe user in\nrelation to that device.\n\n(2) A person is a former COVIDSafe user, in relation to a\ncommunication device, at a particular time if:\n\n(a) COVIDSafe has been deleted from the device in relation to\nwhich the person was the COVIDSafe user; and\n\n(b) after COVIDSafe was last deleted from that device—\nCOVIDSafe has not been downloaded to that device.",
      "cml:hasPart": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94n-ss-1"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94n-ss-2"
        }
      ],
      "cml:integrityHash": "56bac2852a370208fe66dd87e11ed2305a4ad47e8fd6487729c3e1b2ff4d366b"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94n",
      "@type": "cof:Section",
      "cof:title": "94N Effect of deletion of COVIDSafe from a communication device",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "(1) The data store administrator must not collect from a person,\nthrough a particular communication device, COVID app data\nrelating to the person if the person is a former COVIDSafe user in\nrelation to that device.\n\n(2) A person is a former COVIDSafe user, in relation to a\ncommunication device, at a particular time if:\n\n(a) COVIDSafe has been deleted from the device in relation to\nwhich the person was the COVIDSafe user; and\n\n(b) after COVIDSafe was last deleted from that device—\nCOVIDSafe has not been downloaded to that device."
    },
