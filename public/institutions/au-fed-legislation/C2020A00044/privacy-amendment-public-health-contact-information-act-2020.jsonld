    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94n-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "94N(2) Effect of deletion of COVIDSafe from a communication device",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94n-ss-2"
      },
