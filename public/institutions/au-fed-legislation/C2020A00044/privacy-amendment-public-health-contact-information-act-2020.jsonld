      }
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94e",
      "@type": "cml:Concept",
      "skos:prefLabel": "94E COVID app data on communication devices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-public-health-contact-information-act-2020.pdf"
      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.14",
      "values:originalText": "A person commits an offence if:\n\n(a) the person uploads, or causes to be uploaded, data from a\ncommunication device to the National COVIDSafe Data\nStore; and\n\n(b) the data is COVID app data; and\n\n(c) consent to the upload has not been given by:\n\n(i) the COVIDSafe user in relation to that device; or\n\n(ii) if the COVIDSafe user is unable to give consent—a\nparent, guardian or carer of the COVIDSafe user; or\n\n(iii) if the COVIDSafe user has requested a parent, guardian\nor carer of the COVIDSafe user to act on the\nCOVIDSafe user’s behalf—that parent, guardian or\ncarer.\nPenalty: Imprisonment for 5 years or 300 penalty units, or both.",
      "skos:definition": "A person commits an offence if:\n\n(a) the person uploads, or causes to be uploaded, data from a\ncommunication device to the National COVIDSafe Data\nStore; and\n\n(b) the data is COVID app data; and\n\n(c) consent to the upload has not been given by:\n\n(i) the COVIDSafe user in relation to that device; or\n\n(ii) if the COVIDSafe user is unable to give consent—a\nparent, guardian or carer of the COVIDSafe user; or\n\n(iii) if the COVIDSafe user has requested a parent, guardian\nor carer of the COVIDSafe user to act on the\nCOVIDSafe user’s behalf—that parent, guardian or\ncarer.\nPenalty: Imprisonment for 5 years or 300 penalty units, or both.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94e-norm"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94e-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94e-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94e-logic-diffusion-3"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94e-logic-cogai-4"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94e-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "f952531b53ca99ffcced4f08624748ec4907fbfc437eff6e62e11d6a369670d6",
      "skos:note": "Uploading COVID app data without consent is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94e",
      "@type": "cof:Section",
      "cof:title": "94E COVID app data on communication devices",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "A person commits an offence if:\n\n(a) the person uploads, or causes to be uploaded, data from a\ncommunication device to the National COVIDSafe Data\nStore; and\n\n(b) the data is COVID app data; and\n\n(c) consent to the upload has not been given by:\n\n(i) the COVIDSafe user in relation to that device; or\n\n(ii) if the COVIDSafe user is unable to give consent—a\nparent, guardian or carer of the COVIDSafe user; or\n\n(iii) if the COVIDSafe user has requested a parent, guardian\nor carer of the COVIDSafe user to act on the\nCOVIDSafe user’s behalf—that parent, guardian or\ncarer.\nPenalty: Imprisonment for 5 years or 300 penalty units, or both."
    },
