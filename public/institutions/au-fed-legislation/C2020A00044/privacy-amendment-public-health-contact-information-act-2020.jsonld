        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94h-ss-2-logic-deontic-4"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94h-ss-2-logic-deontic-5"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94h-ss-2-logic-deontic-6"
