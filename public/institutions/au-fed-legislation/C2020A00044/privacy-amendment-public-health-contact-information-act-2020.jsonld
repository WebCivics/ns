    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94u-ss-5",
      "@type": "cof:Section",
      "cof:title": "94U(5) Investigation under section 40 to cease if COVID data offence",
      "values:kind": "subsection",
      "cof:pageNumber": 21,
      "values:originalText": "(5) Upon receiving notice under subsection (3) or (4) the\nCommissioner may continue the investigation discontinued under\nparagraph (2)(c)."
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94u-ss-5-norm",
