    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94zc",
      "@type": "cml:Concept",
      "skos:prefLabel": "94ZC COVID app data remains property of the Commonwealth",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94zc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-public-health-contact-information-act-2020.pdf"
      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.27",
      "values:originalText": "COVID app data is the property of the Commonwealth, and\nremains the property of the Commonwealth even after it is\ndisclosed to, or used by:\n\n(a) a State or Territory health authority; or\n\n(b) any other person or body (other than the Commonwealth or\nan authority of the Commonwealth).",
      "skos:definition": "COVID app data is the property of the Commonwealth, and\nremains the property of the Commonwealth even after it is\ndisclosed to, or used by:\n\n(a) a State or Territory health authority; or\n\n(b) any other person or body (other than the Commonwealth or\nan authority of the Commonwealth).",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94zc-norm"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94zc-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b52e78cc8daa99f3527b69861b7329900c48a8bd1c962d5d9ed3a199ccaecc72",
      "skos:note": "COVID app data remains property of the Commonwealth"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94zc",
      "@type": "cof:Section",
      "cof:title": "94ZC COVID app data remains property of the Commonwealth",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "COVID app data is the property of the Commonwealth, and\nremains the property of the Commonwealth even after it is\ndisclosed to, or used by:\n\n(a) a State or Territory health authority; or\n\n(b) any other person or body (other than the Commonwealth or\nan authority of the Commonwealth)."
    },
