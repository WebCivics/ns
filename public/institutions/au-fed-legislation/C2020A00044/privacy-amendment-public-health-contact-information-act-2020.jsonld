    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-2-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Transitional",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-2-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-public-health-contact-information-act-2020.pdf"
      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.29",
      "values:originalText": "After the commencement of this item:\n\n(a) the powers of the Commissioner under or in relation to Part\nVIIIA of the Privacy Act 1988 as amended by this Act\ncontinue to apply in relation to matters that arose under or in\nrelation to that Part before that commencement; and\n\n(b) any obligations of the Health Minister or the Commissioner\nunder that Part relating to a report continue to apply;\nas if the repeals made by items 2 and 3 of this Schedule had not been\nmade.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 12 May 2020\nSenate on 13 May 2020]\n\n(75/20)",
      "skos:definition": "After the commencement of this item:\n\n(a) the powers of the Commissioner under or in relation to Part\nVIIIA of the Privacy Act 1988 as amended by this Act\ncontinue to apply in relation to matters that arose under or in\nrelation to that Part before that commencement; and\n\n(b) any obligations of the Health Minister or the Commissioner\nunder that Part relating to a report continue to apply;\nas if the repeals made by items 2 and 3 of this Schedule had not been\nmade.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 12 May 2020\nSenate on 13 May 2020]\n\n(75/20)",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-2-sec-4-norm"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-2-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "51b16e1c12a78b2a740ee807f40d5f952186a712ef99e979897008ac9f7a637b",
      "skos:note": "Continuation of powers and obligations after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-2-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Transitional",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "After the commencement of this item:\n\n(a) the powers of the Commissioner under or in relation to Part\nVIIIA of the Privacy Act 1988 as amended by this Act\ncontinue to apply in relation to matters that arose under or in\nrelation to that Part before that commencement; and\n\n(b) any obligations of the Health Minister or the Commissioner\nunder that Part relating to a report continue to apply;\nas if the repeals made by items 2 and 3 of this Schedule had not been\nmade.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 12 May 2020\nSenate on 13 May 2020]\n\n(75/20)"
    },
