        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94n-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "27e8b999c64c282cd343f20de1ed7ee93b2f600f8cf59ad704658ccac4095e04",
      "skos:note": "Person is a former COVIDSafe user if COVIDSafe has been deleted and not downloaded again."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94n-ss-2",
      "@type": "cof:Section",
      "cof:title": "94N(2) Effect of deletion of COVIDSafe from a communication device",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(2) A person is a former COVIDSafe user, in relation to a\ncommunication device, at a particular time if:\n\n(a) COVIDSafe has been deleted from the device in relation to\nwhich the person was the COVIDSafe user; and\n\n(b) after COVIDSafe was last deleted from that device—\nCOVIDSafe has not been downloaded to that device."
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94n-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
