      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.28",
      "values:originalText": "Repeal the instrument.\nPrivacy Act 1988\nNote:\nThe repeals made by items 2 and 3 of this Schedule commence at the end of 90 days\nafter the day determined under subsection 94Y(1) of the Privacy Act 1988 as amended\nby this Act.",
      "skos:definition": "Repeal the instrument.\nPrivacy Act 1988\nNote:\nThe repeals made by items 2 and 3 of this Schedule commence at the end of 90 days\nafter the day determined under subsection 94Y(1) of the Privacy Act 1988 as amended\nby this Act.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-2-sec-1-norm"
        }
      ],
      "cml:integrityHash": "b028107f2bb8af683b10e4a70a2470c791706b36b9f57bf445392dd55b6e3c00",
      "skos:note": "Repeal the instrument"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 The whole of the instrument",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Repeal the instrument.\nPrivacy Act 1988\nNote:\nThe repeals made by items 2 and 3 of this Schedule commence at the end of 90 days\nafter the day determined under subsection 94Y(1) of the Privacy Act 1988 as amended\nby this Act."
    },
