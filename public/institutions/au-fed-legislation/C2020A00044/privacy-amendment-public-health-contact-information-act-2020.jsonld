      "cml:integrityHash": "8d4b815cc74aa87b038bbdf7145ab98b4e8a411fcefac8f6c1bffa14cfcf494a",
      "skos:note": "Complaints are taken to have been made to the relevant State or Territory authority."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94v-ss-3",
      "@type": "cof:Section",
      "cof:title": "94V(3) Referring COVID data matters to State or Territory privacy",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(3) A complaint transferred under subsection (2) is taken, for the\npurposes of this Act, to have been made to that State or Territory\nauthority."
    },
