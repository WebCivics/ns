      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 44, 2020\nPrivacy Amendment (Public Health Contact Information) Act 2020",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 44, 2020\nPrivacy Amendment (Public Health Contact Information) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "de23dadc23f6f32d25524913688cf6d16796c238204338be94871bd996f6ea7d",
      "skos:note": "Legislation in Schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sec-3-2",
      "@type": "cof:Section",
