      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.16",
      "values:originalText": "The data store administrator must take all reasonable steps to\nensure that COVID app data is not retained on a communication\ndevice:\n\n(a) for more than 21 days; or\n\n(b) in any case in which it is not possible to comply with\nparagraph (a) within 21 days—for longer than the shortest\npracticable period.\n\nAmendments  Schedule 1\n\nNo. 44, 2020\nPrivacy Amendment (Public Health Contact Information) Act 2020",
      "skos:definition": "The data store administrator must take all reasonable steps to\nensure that COVID app data is not retained on a communication\ndevice:\n\n(a) for more than 21 days; or\n\n(b) in any case in which it is not possible to comply with\nparagraph (a) within 21 days—for longer than the shortest\npracticable period.\n\nAmendments  Schedule 1\n\nNo. 44, 2020\nPrivacy Amendment (Public Health Contact Information) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94k-norm"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94k-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fd2e0d3834960fbc26402823932ea11d204950fb407dccdd5e3d815d43b22345",
      "skos:note": "Data must not be retained on a communication device for more than 21 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94k",
      "@type": "cof:Section",
      "cof:title": "94K COVID app data not to be retained",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "The data store administrator must take all reasonable steps to\nensure that COVID app data is not retained on a communication\ndevice:\n\n(a) for more than 21 days; or\n\n(b) in any case in which it is not possible to comply with\nparagraph (a) within 21 days—for longer than the shortest\npracticable period.\n\nAmendments  Schedule 1\n\nNo. 44, 2020\nPrivacy Amendment (Public Health Contact Information) Act 2020"
    },
    {
