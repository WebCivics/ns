      "cml:operator": "Overlaps",
      "cml:logicSummary": "Indicates an overlap between the temporal intervals of the complaint and the relevant authority's processing time.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A complaint transferred under subsection (2) is taken, for the purposes of this Act, to have been made to that State or Territory authority.",
      "cml:conclusionText": "The complaint overlaps with the relevant authority's processing time."
    },
    {
