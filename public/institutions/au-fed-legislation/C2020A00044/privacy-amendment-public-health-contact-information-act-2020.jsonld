      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Establishes a temporal relation between the breach and the individual at risk",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
