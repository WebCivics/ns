    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94g",
      "@type": "cml:Concept",
      "skos:prefLabel": "94G Decrypting COVID app data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-amendment-public-health-contact-information-act-2020.pdf"
      },
      "dc:source": "privacy-amendment-public-health-contact-information-act-2020.pdf, p.15",
      "values:originalText": "A person commits an offence if:\n\n(a) the person decrypts encrypted data; and\n\n(b) the data is COVID app data that is stored on a\ncommunication device.\nPenalty: Imprisonment for 5 years or 300 penalty units, or both.",
      "skos:definition": "A person commits an offence if:\n\n(a) the person decrypts encrypted data; and\n\n(b) the data is COVID app data that is stored on a\ncommunication device.\nPenalty: Imprisonment for 5 years or 300 penalty units, or both.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94g-norm"
        },
        {
          "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94g-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ef322e765f8e2d42b7737b87aca7ca2ae94f7280a8f6b7bb7a02d96a9e36f5eb",
      "skos:note": "Decrypting COVID app data is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-amendment-public-health-contact-information-act-2020#sch-1-sec-94g",
      "@type": "cof:Section",
      "cof:title": "94G Decrypting COVID app data",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "A person commits an offence if:\n\n(a) the person decrypts encrypted data; and\n\n(b) the data is COVID app data that is stored on a\ncommunication device.\nPenalty: Imprisonment for 5 years or 300 penalty units, or both."
    },
    {
      "@id": "concept:privacy-amendment-public-health-contact-information-act-2020-sch-1-sec-94g-norm",
