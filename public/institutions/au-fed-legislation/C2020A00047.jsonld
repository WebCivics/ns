    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-3a",
      "@type": "cml:Concept",
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.199",
      "skos:note": "Disallow determination if motion is not withdrawn or disposed of within 15 sitting days.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "1(3A) July 2019 instead of the designated start date); and"
      },
      "wasDerivedFrom": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf",
      "asserts": [
        "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-3a-norm",
        "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-3a-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "5e9a794e466482776adcb3863529e760b1581730147d66cd0cbae2a6070477ca",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-1-3-ss-3a",
      "cml:schemaVersion": "2",
      "partOf": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-3a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(3A) If:  (a) notice of a motion to disallow the determination is given in a House of the Parliament within 15 sitting days of that House after the copy of the determination was tabled in that House under section 38 of the Legislation Act 2003; and  (b) at the end of 15 sitting days of that House after the giving of that notice of motion:  (i) the notice has not been withdrawn and the motion has not been called on; or  (ii) the motion has been called on, moved and (where relevant) seconded and has not been withdrawn or otherwise disposed of; the determination is then taken to have been disallowed, and subsection (3) does not apply to the determination.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits determination if motion is not withdrawn or disposed of within 15 sitting days.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(3A) If:  (a) notice of a motion to disallow the determination is given in a House of the Parliament within 15 sitting days of that House after the copy of the determination was tabled in that House under section 38 of the Legislation Act 2003; and  (b) at the end of 15 sitting days of that House after the giving of that notice of motion:  (i) the notice has not been withdrawn and the motion has not been called on; or  (ii) the motion has been called on, moved and (where relevant) seconded and has not been withdrawn or otherwise disposed of; the determination is then taken to have been disallowed, and subsection (3) does not apply to the determination."
    },
