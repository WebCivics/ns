      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.69",
      "skos:note": "Revocation of functional separation undertaking if breach or contravention occurs.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "151W(1) Revocation of functional separation undertaking"
