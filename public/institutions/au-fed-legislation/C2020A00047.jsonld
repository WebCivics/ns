      "cml:logicSummary": "Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:premiseText": "(1) This section applies to:  (a) a breach by a person of a functional separation undertaking given by the person, so long as the breach occurred when the undertaking was in force; and  (b) a contravention by a person of section 143B, 151ZA, 151ZB, 151ZF, 151ZG, 151ZH or 151ZI."
    },
