      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) This section applies to:  (a) a breach by a person of a functional separation undertaking given by the person, so long as the breach occurred when the undertaking was in force; and  (b) a contravention by a person of section 143B, 151ZA, 151ZB, 151ZF, 151ZG, 151ZH or 151ZI.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
