<https://ns.webcivics.net/concept/telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-95-ss-2-logic-alleninterval-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/AllenInterval>;
    <https://ns.webcivics.net/cml/operator> "Overlaps";
    <https://ns.webcivics.net/cml/logicSummary> "The period during which a person is not a member of an associated group overlaps with the period during which small networks of exempt premises are not chargeable.";
    <https://ns.webcivics.net/cml/premiseText> "(a) A person is not a member of an associated group during the whole or a part of a month.";
    <https://ns.webcivics.net/cml/conclusionText> "If each of those potentially chargeable premises are exempt premises in relation to the person for that month.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-95-ss-2> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-95-ss-2-logic-ltl-3>.
<https://ns.webcivics.net/concept/telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-95-ss-2-logic-ltl-3> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/LTL>;
    <https://ns.webcivics.net/cml/operator> "Until";
    <https://ns.webcivics.net/cml/logicSummary> "Small networks of exempt premises are not chargeable until the end of the period during which a person is not a member of an associated group and has fewer than 2000 potentially chargeable premises.";
    <https://ns.webcivics.net/cml/premiseText> "(a) A person is not a member of an associated group during the whole or a part of a month.";
    <https://ns.webcivics.net/cml/conclusionText> "If each of those potentially chargeable premises are exempt premises in relation to the person for that month.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::temporal_ltl";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-95-ss-2> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-95-ss-2-logic-diffusion-4>.
<https://ns.webcivics.net/concept/telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-95-ss-2-logic-diffusion-4> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Diffusion>;
    <https://ns.webcivics.net/cml/operator> "Diffuses";
    <https://ns.webcivics.net/cml/logicSummary> "The exemption from charging applies to all small networks of exempt premises during the period when a person is not a member of an associated group and has fewer than 2000 potentially chargeable premises.";
    <https://ns.webcivics.net/cml/premiseText> "(b) The total number of potentially chargeable premises in relation to the person for that month is less than 2,000; and";
    <https://ns.webcivics.net/cml/conclusionText> "each of those potentially chargeable premises are exempt premises in relation to the person for that month.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::diffusion";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
