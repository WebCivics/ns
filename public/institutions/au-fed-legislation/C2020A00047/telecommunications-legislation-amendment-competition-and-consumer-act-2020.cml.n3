doc:sch-2-sec-151zh-ss-4 a cof:Section ;
    cof:title "151ZH(4) Statement about the differences between an access" ;
    values:kind "subsection" ;
    values:originalText "(4) or (5), 151ZG(2), (3) or (4) or 151ZH(1), (2), (2A) or (3), the Court may, on the application of:  (a) the ACCC; or  (b) a carrier; or  (c) a carriage service provider; make all or any of the following orders:  (d) an order directing the person to comply with that subsection;  Schedule 2  Local access lines  Telecommunications Legislation Amendment (Competition and Consumer) Act 2020 No. 47, 2020  (e) an order directing the person to compensate any other person (who may be the applicant) who has suffered loss or damage as a result of the contravention;  (f) any other order that the Court thinks appropriate." ;
    cof:pageNumber "84"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zh-ss-2 a cml:Concept ;
    skos:prefLabel "151ZH(2) Statement about the differences between an access"@en ;
    cml:realizedBy doc:sch-2-sec-151zh-ss-2 ;
    values:originalText "(2) The Federal Court may discharge or vary an order granted under this section." ;
    skos:definition "(2) The Federal Court may discharge or vary an order granted under this section."@en ;
    cml:integrityHash "37ecd8a1886567ddc0d72e3fe6245b9724d288e02a6b878355d4be093b9273a2" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zh ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Publish statement on website within 5 business days after variation agreement entry. The Federal Court may discharge or vary an order granted under this section." ;
    dc:description "Yes" ;
