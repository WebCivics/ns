concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-158a a cml:Concept ;
    skos:prefLabel "158A Deemed local access lines"@en ;
    cml:realizedBy doc:sch-2-sec-158a ;
    values:originalText "(1) For the purposes of this Part, if:  (a) a local access line was in existence immediately before the designated commencement date; and  (b) the line is extended on or after the designated commencement date; then:  (c) the extension is taken to be a local access line in its own right; and  (d) the local access line referred to in paragraph (c) is taken to have come into existence on or after the designated commencement date.  (2) Subsection (1) does not apply in determining the meaning of an expression used in:  (a) section 143; or  (b) sections 151ZF, 151ZG and 151ZH, to the extent to which they relate to a line to which section 143 applies; or  (c) any other provision of this Part, so far as that provision relates to:  (i) section 143; or  (ii) section 151ZF, 151ZG or 151ZH, to the extent to which that section relates to a line to which section 143 applies." ;
    skos:definition "(1) For the purposes of this Part, if:  (a) a local access line was in existence immediately before the designated commencement date; and  (b) the line is extended on or after the designated commencement date; then:  (c) the extension is taken to be a local access line in its own right; and  (d) the local access line referred to in paragraph (c) is taken to have come into existence on or after the designated commencement date.  (2) Subsection (1) does not apply in determining the meaning of an expression used in:  (a) section 143; or  (b) sections 151ZF, 151ZG and 151ZH, to the extent to which they relate to a line to which section 143 applies; or  (c) any other provision of this Part, so far as that provision relates to:  (i) section 143; or  (ii) section 151ZF, 151ZG or 151ZH, to the extent to which that section relates to a line to which section 143 applies."@en ;
    cml:integrityHash "bb8e97fbd6f05256f3dd6f7a4f34a04a7f87d4ac9367cce156c231ade67b68d8" ;
    cof:pageNumber "99"^^xsd:integer ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-158a-ss-1 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-158a-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.99" .
doc:sch-2-sec-158a a cof:Section ;
    cof:title "158A Deemed local access lines" ;
    values:kind "section" ;
    values:originalText "(1) For the purposes of this Part, if:  (a) a local access line was in existence immediately before the designated commencement date; and  (b) the line is extended on or after the designated commencement date; then:  (c) the extension is taken to be a local access line in its own right; and  (d) the local access line referred to in paragraph (c) is taken to have come into existence on or after the designated commencement date.  (2) Subsection (1) does not apply in determining the meaning of an expression used in:  (a) section 143; or  (b) sections 151ZF, 151ZG and 151ZH, to the extent to which they relate to a line to which section 143 applies; or  (c) any other provision of this Part, so far as that provision relates to:  (i) section 143; or  (ii) section 151ZF, 151ZG or 151ZH, to the extent to which that section relates to a line to which section 143 applies." ;
    cof:pageNumber "99"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-158a-ss-1 a cml:Concept ;
    skos:prefLabel "158A(1) Deemed local access lines"@en ;
