    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zh ;
    cof:pageNumber "84"^^xsd:integer ;
    skos:note "Reference to an eligible service was made in a declared service. A person must not aid, abet, counsel or procure a contravention of subsection (1), (2) or (2A);" ;
