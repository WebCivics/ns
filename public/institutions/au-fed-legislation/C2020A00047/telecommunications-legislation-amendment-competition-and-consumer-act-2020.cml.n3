doc:sch-2-sec-151q-ss-6 a cof:Section ;
    cof:title "151Q(6) Variation of functional separation undertaking that is in force" ;
    values:kind "subsection" ;
    values:originalText "(6) The ACCC may, by legislative instrument, determine a fee, or a method of ascertaining a fee, for the purposes of paragraph (5)(b)." ;
    cof:pageNumber "64"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151q-ss-7 a cml:Concept ;
    skos:prefLabel "151Q(7) Variation of functional separation undertaking that is in force"@en ;
    cml:realizedBy doc:sch-2-sec-151q-ss-7 ;
    values:originalText "(7) A fee determined under, or ascertained in accordance with, subsection (6) must not be such as to amount to taxation." ;
    skos:definition "(7) A fee determined under, or ascertained in accordance with, subsection (6) must not be such as to amount to taxation."@en ;
    cml:integrityHash "c3c5bd2d089d33ba65d06345bf7691ecd46edd114c31ff264e1ff8f64adf2f2a" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151q ;
    cof:pageNumber "64"^^xsd:integer ;
    skos:note "No fee can be set to amount to taxation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
