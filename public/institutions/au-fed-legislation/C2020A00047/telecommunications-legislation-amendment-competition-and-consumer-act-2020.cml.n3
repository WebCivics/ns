concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-93 a cml:Concept ;
    skos:prefLabel "93 Chargeable premises associated with a local access line"@en ;
    cml:realizedBy doc:sch-4-sec-93 ;
    values:originalText "For the purposes of this Part, if:  (a) a person is a carrier; and  (b) particular premises are potentially chargeable premises in relation to the person for a month; and  (c) the premises are not exempt premises in relation to the person for the month; the premises are chargeable premises associated with a local access line of the person for the month." ;
    skos:definition "For the purposes of this Part, if:  (a) a person is a carrier; and  (b) particular premises are potentially chargeable premises in relation to the person for a month; and  (c) the premises are not exempt premises in relation to the person for the month; the premises are chargeable premises associated with a local access line of the person for the month."@en ;
    cml:integrityHash "3692ee6ae6031f0d0186666ab1a587249c252f70e6eaf9ae29ec987878682079" ;
    cof:pageNumber "166"^^xsd:integer ;
    skos:note "Chargeable premises associated with a local access line" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
