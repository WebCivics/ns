    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143a-ss-9 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143a-ss-10 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
