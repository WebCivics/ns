concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102c-ss-5 a cml:Concept ;
    skos:prefLabel "102C(5) ACMA may accept statements"@en ;
    cml:realizedBy doc:sch-4-sec-102c-ss-5 ;
    values:originalText "(5) If a person is an eligible funding recipient, charge payable by the person in relation to a financial year is payable in 2 instalments, as follows:  (a) an instalment (the base instalment) of so much of the amount of the charge as equals the annual base amount of the person for the financial year;  (b) an instalment (the administrative cost instalment) of so much of the amount of the charge as equals the annual administrative cost amount of the person for the financial year." ;
    skos:definition "(5) If a person is an eligible funding recipient, charge payable by the person in relation to a financial year is payable in 2 instalments, as follows:  (a) an instalment (the base instalment) of so much of the amount of the charge as equals the annual base amount of the person for the financial year;  (b) an instalment (the administrative cost instalment) of so much of the amount of the charge as equals the annual administrative cost amount of the person for the financial year."@en ;
    cml:integrityHash "72896ad8c4de52704f9cc58822456cc2c4c2d080c7c82a19206eff0e0074982c" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102c ;
    cof:pageNumber "184"^^xsd:integer ;
    skos:note "Charge payable by a person in relation to a financial year must be paid in two instalments." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.184" ;
    cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102c-ss-5-norm .
