    values:originalText "(5) Before making a determination under subsection (1), the ACCC must:  (a) publish on the ACCC’s website a notice:  (i) setting out the draft determination; and  (ii) inviting persons to make submissions to the ACCC about the draft determination within the time limit specified in the notice; and  (b) consider any submissions received within the time limit specified in the notice." ;
    cof:pageNumber "46"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151b-ss-6 a cml:Concept ;
    skos:prefLabel "151B(6) Deemed standard functional separation undertaking"@en ;
    cml:realizedBy doc:sch-2-sec-151b-ss-6 ;
    values:originalText "(6) The time limit must not be shorter than 15 business days after the notice is published." ;
    skos:definition "(6) The time limit must not be shorter than 15 business days after the notice is published."@en ;
