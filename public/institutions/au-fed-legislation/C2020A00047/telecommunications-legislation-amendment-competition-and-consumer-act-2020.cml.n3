doc:sch-2-sec-151n-ss-3 a cof:Section ;
    cof:title "151N(3) Variation of expiry time of certain functional separation" ;
    values:kind "subsection" ;
    values:originalText "(3) Subsection 151A(8) does not apply to an expiry time specified in a notice under subsection (1). Joint functional separation undertaking" ;
    cof:pageNumber "61"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151n-ss-4 a cml:Concept ;
    skos:prefLabel "151N(4) Variation of expiry time of certain functional separation"@en ;
    cml:realizedBy doc:sch-2-sec-151n-ss-4 ;
    values:originalText "(4) If:  (a) a joint functional separation undertaking (the existing undertaking) given by 2 or more persons is in force; and  (b) another functional separation undertaking is given to the ACCC by a person who is one of the persons mentioned in paragraph (a); and  (c) the ACCC rejects the other undertaking; the ACCC may, by written notice given to each of the persons mentioned in paragraph (a), vary the existing undertaking by:  (d) omitting the expiry time specified in the existing undertaking; and  (e) substituting the expiry time specified in the notice. Note: See also section 142B." ;
    skos:definition "(4) If:  (a) a joint functional separation undertaking (the existing undertaking) given by 2 or more persons is in force; and  (b) another functional separation undertaking is given to the ACCC by a person who is one of the persons mentioned in paragraph (a); and  (c) the ACCC rejects the other undertaking; the ACCC may, by written notice given to each of the persons mentioned in paragraph (a), vary the existing undertaking by:  (d) omitting the expiry time specified in the existing undertaking; and  (e) substituting the expiry time specified in the notice. Note: See also section 142B."@en ;
    cml:integrityHash "3ca118ae77ee9a537ae5ed81724e7ae5aa025215b808ea22f1b47cd9eb6a8fd6" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151n ;
    cof:pageNumber "61"^^xsd:integer ;
    skos:note "ACCC may vary the expiry time of a joint functional separation undertaking" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.61" ;
    cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151n-ss-4-norm .
