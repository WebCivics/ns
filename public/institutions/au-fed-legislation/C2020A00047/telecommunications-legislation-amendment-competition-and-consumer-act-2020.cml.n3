doc:sch-4-sec-96-ss-10 a cof:Section ;
    cof:title "96(10) Exempt lines—local access lines transitioning to the NBN" ;
    values:kind "subsection" ;
    values:originalText "(10) For the purposes of this section, listed Optus company means:  (a) Optus Networks Pty Limited (ACN 008 570 330); or  (b) Optus Internet Pty Limited (ACN 083 164 532); or  (c) Optus Vision Pty Limited (ACN 066 518 821); or  (d) Optus Vision Media Pty Limited (ACN 070 870 647); or  (e) Optus Systems Pty Limited (ACN 056 541 167); or  (f) SingTel Optus Pty Limited (ACN 052 833 208)." ;
    cof:pageNumber "168"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-96a a cml:Concept ;
    skos:prefLabel "96A Potentially concessional premises"@en ;
    cml:realizedBy doc:sch-4-sec-96a ;
    values:originalText "For the purposes of this Part, if particular premises are potentially chargeable premises in relation to a person for a month because a carriage service provider (who may be the person) supplies a designated broadband service to:  (a) a residential customer who occupies the premises; or  (b) a small business customer who occupies the premises; the premises are potentially concessional premises in relation to the person for that month." ;
    skos:definition "For the purposes of this Part, if particular premises are potentially chargeable premises in relation to a person for a month because a carriage service provider (who may be the person) supplies a designated broadband service to:  (a) a residential customer who occupies the premises; or  (b) a small business customer who occupies the premises; the premises are potentially concessional premises in relation to the person for that month."@en ;
    cml:integrityHash "d9d6d734027eed39ec83a61f19691f5680f1257bc4aac8180d69a559f27c0815" ;
    cof:pageNumber "171"^^xsd:integer ;
    skos:note "Premises are potentially concessional if a carriage service provider supplies broadband to occupants." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.171" ;
