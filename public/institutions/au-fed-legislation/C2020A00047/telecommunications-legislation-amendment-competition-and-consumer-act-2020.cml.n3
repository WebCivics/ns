doc:sch-2-sec-151zd-ss-2 a cof:Section ;
    cof:title "151ZD(2) Compliance with functional separation undertaking" ;
    values:kind "subsection" ;
    values:originalText "(2) A person must not:  (a) aid, abet, counsel or procure a contravention of subsection (1); or  (b) induce, whether by threats or promises or otherwise, a contravention of subsection (1); or  (c) be in any way, directly or indirectly, knowingly concerned in, or party to, a contravention of subsection (1); or  (d) conspire with others to effect a contravention of subsection (1). Civil penalty provisions" ;
    cof:pageNumber "78"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zd-ss-3 a cml:Concept ;
    skos:prefLabel "151ZD(3) Compliance with functional separation undertaking"@en ;
    cml:realizedBy doc:sch-2-sec-151zd-ss-3 ;
    values:originalText "(3) Subsections (1) and (2) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions." ;
    skos:definition "(3) Subsections (1) and (2) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions."@en ;
