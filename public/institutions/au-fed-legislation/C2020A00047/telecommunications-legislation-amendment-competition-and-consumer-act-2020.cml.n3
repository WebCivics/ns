concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-3a a cml:Concept ;
    skos:prefLabel "100(3A) Reporting obligations"@en ;
    cml:realizedBy doc:sch-4-sec-100-ss-3a ;
    values:originalText "(3A) If, at any time during a month covered by the report, the person had an associate in relation to control of:  (a) a telecommunications network; or  (b) a company; or  (c) a local access line; the report must:  (d) set out the name of the associate; and  Funding of fixed wireless broadband and satellite broadband  Schedule 4  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  (e) set out the ACN (if any) of the associate; and  (f) identify the network, company or line, as the case requires; and  (g) identify which paragraph or paragraphs of subsection 152(1) of the Telecommunications Act 1997 resulted in the person having the associate. Transitional" ;
    skos:definition "(3A) If, at any time during a month covered by the report, the person had an associate in relation to control of:  (a) a telecommunications network; or  (b) a company; or  (c) a local access line; the report must:  (d) set out the name of the associate; and  Funding of fixed wireless broadband and satellite broadband  Schedule 4  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  (e) set out the ACN (if any) of the associate; and  (f) identify the network, company or line, as the case requires; and  (g) identify which paragraph or paragraphs of subsection 152(1) of the Telecommunications Act 1997 resulted in the person having the associate. Transitional"@en ;
    cml:integrityHash "1b144219b27f2a2457cdf99f09667740b692c3d9cd995d488a1ae6f9ee16f395" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100 ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "Must report associate information" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
