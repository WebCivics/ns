concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-6 a cml:Concept ;
    skos:prefLabel "6 Subsection 570(4)"@en ;
    cml:realizedBy doc:sch-4-sec-6 ;
    values:originalText "Repeal the subsection, substitute:  (4) The pecuniary penalty payable under subsection (1) by a person other than a body corporate is not to exceed:  (a) in the case of a contravention of subsection 68(1) or (2) that relates to the carrier licence condition set out in Part 1 of Schedule 1 in so far as that condition relates to subsection 97(1) or (1A) of the Telecommunications (Consumer Protection and Service Standards) Act 1999— 10,000 penalty units for each contravention; or  Schedule 4  Funding of fixed wireless broadband and satellite broadband  Telecommunications Legislation Amendment (Competition and Consumer) Act 2020 No. 47, 2020  (b) in any other case—$50,000 for each contravention." ;
    skos:definition "Repeal the subsection, substitute:  (4) The pecuniary penalty payable under subsection (1) by a person other than a body corporate is not to exceed:  (a) in the case of a contravention of subsection 68(1) or (2) that relates to the carrier licence condition set out in Part 1 of Schedule 1 in so far as that condition relates to subsection 97(1) or (1A) of the Telecommunications (Consumer Protection and Service Standards) Act 1999— 10,000 penalty units for each contravention; or  Schedule 4  Funding of fixed wireless broadband and satellite broadband  Telecommunications Legislation Amendment (Competition and Consumer) Act 2020 No. 47, 2020  (b) in any other case—$50,000 for each contravention."@en ;
    cml:integrityHash "b7aa6b5fa5df211166b82d9abce301bf6f5bad6a3b41ae19ad38e1c0ad5a4aa7" ;
    cof:pageNumber "145"^^xsd:integer ;
    skos:note "Maximum pecuniary penalty for contravention of subsection 68(1) or (2)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.145" ;
