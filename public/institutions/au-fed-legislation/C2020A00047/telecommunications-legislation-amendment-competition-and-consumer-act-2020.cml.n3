    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151t-ss-5 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151t-ss-6 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151t-ss-7 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151t-ss-8 ;
