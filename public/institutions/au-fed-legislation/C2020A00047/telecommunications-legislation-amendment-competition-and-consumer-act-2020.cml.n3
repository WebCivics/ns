    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zm ;
    cof:pageNumber "91"^^xsd:integer ;
    skos:note "The ACCC must provide information, reports, and assistance to the Australian Competition Tribunal." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
