    cml:modality cml:LTL ;
    cml:operator "Until" ;
    cml:logicSummary "Small networks of exempt premises are not chargeable until the end of the period during which a person is not a member of an associated group and has fewer than 2000 potentially chargeable premises." ;
    cml:premiseText "(a) A person is not a member of an associated group during the whole or a part of a month." ;
    cml:conclusionText "If each of those potentially chargeable premises are exempt premises in relation to the person for that month." ;
