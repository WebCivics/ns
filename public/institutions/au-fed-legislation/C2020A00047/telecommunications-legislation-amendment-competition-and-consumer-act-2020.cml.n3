doc:sch-2-sec-151zd-ss-1 a cof:Section ;
    cof:title "151ZD(1) Compliance with functional separation undertaking" ;
    values:kind "subsection" ;
    values:originalText "(1) If a functional separation undertaking given by a person is in force, the person must comply with the undertaking.  Local access lines  Schedule 2  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  Note: See also section 142B. Ancillary contraventions" ;
    cof:pageNumber "78"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zd-ss-2 a cml:Concept ;
    skos:prefLabel "151ZD(2) Compliance with functional separation undertaking"@en ;
    cml:realizedBy doc:sch-2-sec-151zd-ss-2 ;
    values:originalText "(2) A person must not:  (a) aid, abet, counsel or procure a contravention of subsection (1); or  (b) induce, whether by threats or promises or otherwise, a contravention of subsection (1); or  (c) be in any way, directly or indirectly, knowingly concerned in, or party to, a contravention of subsection (1); or  (d) conspire with others to effect a contravention of subsection (1). Civil penalty provisions" ;
    skos:definition "(2) A person must not:  (a) aid, abet, counsel or procure a contravention of subsection (1); or  (b) induce, whether by threats or promises or otherwise, a contravention of subsection (1); or  (c) be in any way, directly or indirectly, knowingly concerned in, or party to, a contravention of subsection (1); or  (d) conspire with others to effect a contravention of subsection (1). Civil penalty provisions"@en ;
    cml:integrityHash "2af913823aef16d1bcbb56b2272cb425e2cdc9f695076479c46cf91ce582d05b" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zd ;
    cof:pageNumber "78"^^xsd:integer ;
    skos:note "A person must not aid, abet, counsel or procure a contravention of subsection (1)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.78" ;
    cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zd-ss-2-norm .
