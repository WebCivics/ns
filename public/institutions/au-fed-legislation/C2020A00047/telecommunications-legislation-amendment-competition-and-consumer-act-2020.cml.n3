doc:sch-2-sec-151zl-ss-1 a cof:Section ;
    cof:title "151ZL(1) Review by the Australian Competition Tribunal" ;
    values:kind "subsection" ;
    values:originalText "(1) If the ACCC makes a decision under section 151F to reject a functional separation undertaking that was given by a person or persons, the person or persons may apply to the Australian Competition Tribunal for a review of the decision." ;
    cof:pageNumber "90"^^xsd:integer .

