doc:sch-2-sec-151zf-ss-6 a cof:Section ;
    cof:title "151ZF(6) Eligible services to be supplied on a non-discriminatory basis" ;
    values:kind "subsection" ;
    values:originalText "(6) Subsections (1), (4) and (5) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions." ;
