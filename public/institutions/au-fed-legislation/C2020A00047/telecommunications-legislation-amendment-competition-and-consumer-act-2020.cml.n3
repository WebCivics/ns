concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102c-ss-14 a cml:Concept ;
    skos:prefLabel "102C(14) ACMA may accept statements"@en ;
    cml:realizedBy doc:sch-4-sec-102c-ss-14 ;
    values:originalText "(14) For the purposes of this section, the standard due date for a financial year is:  (a) 31 December next following the financial year; or  (b) if:  (i) a later day is ascertained in accordance with a determination made under subsection (15); and  (ii) the day ascertained in accordance with the determination is not later than 28 February next following the financial year;  the day ascertained in accordance with the determination." ;
    skos:definition "(14) For the purposes of this section, the standard due date for a financial year is:  (a) 31 December next following the financial year; or  (b) if:  (i) a later day is ascertained in accordance with a determination made under subsection (15); and  (ii) the day ascertained in accordance with the determination is not later than 28 February next following the financial year;  the day ascertained in accordance with the determination."@en ;
    cml:integrityHash "50b7c9c2abd240150cb9795e036e11c266ec1645d4a52e558503cec2c105b930" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102c ;
    cof:pageNumber "184"^^xsd:integer ;
    skos:note "Determines standard due date for financial year based on determination made under subsection (15)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
