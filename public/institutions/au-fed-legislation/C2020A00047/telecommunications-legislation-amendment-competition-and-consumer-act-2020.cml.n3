concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102j a cml:Concept ;
    skos:prefLabel "102J Refund of overpayment of charge"@en ;
    cml:realizedBy doc:sch-4-sec-102j ;
    values:originalText "If there is an overpayment of:  (a) charge; or  (b) an instalment of charge; the overpayment is to be refunded by the Secretary on behalf of the Commonwealth." ;
