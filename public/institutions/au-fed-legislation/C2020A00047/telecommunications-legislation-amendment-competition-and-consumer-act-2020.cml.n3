    cof:pageNumber "160"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-86-ss-2 a cml:Concept ;
    skos:prefLabel "86(2) Nominal funding entitlement certificate"@en ;
    cml:realizedBy doc:sch-4-sec-86-ss-2 ;
    values:originalText "(2) If a carrier is an eligible funding recipient at the start of 1 February in a funding financial year, the Secretary must:  Funding of fixed wireless broadband and satellite broadband  Schedule 4  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  (a) issue to the carrier a certificate stating that a specified amount is the nominal funding entitlement of the carrier for the funding financial year; and  (b) do so:  (i) by the end of 31 March in the funding financial year; and  (ii) if the carrier has applied under subsection 98(1) for a charge offset certificate in relation to the previous financial year—before making a decision in response to the application." ;
    skos:definition "(2) If a carrier is an eligible funding recipient at the start of 1 February in a funding financial year, the Secretary must:  Funding of fixed wireless broadband and satellite broadband  Schedule 4  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  (a) issue to the carrier a certificate stating that a specified amount is the nominal funding entitlement of the carrier for the funding financial year; and  (b) do so:  (i) by the end of 31 March in the funding financial year; and  (ii) if the carrier has applied under subsection 98(1) for a charge offset certificate in relation to the previous financial year—before making a decision in response to the application."@en ;
    cml:integrityHash "4bbc848ea9ae32fae608cb7ae491632e95adb655fcd75b2d7de88fb792dc5d18" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-86 ;
    cof:pageNumber "160"^^xsd:integer ;
    skos:note "Secretary must issue a certificate stating the nominal funding entitlement to an eligible carrier by a certain date." ;
    dc:description "Nominal funding entitlement certificate" ;
