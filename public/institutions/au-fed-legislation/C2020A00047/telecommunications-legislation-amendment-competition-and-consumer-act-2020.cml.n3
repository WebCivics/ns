doc:sch-3-sec-360ha-ss-1 a cof:Section ;
    cof:title "360HA(1) Nominated service area—anticipatory notice to be given to" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  Statutory infrastructure providers etc.  Schedule 3 Amendments  Part 1  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  (a) after the commencement of this section, a carrier (other than an NBN corporation) enters into a contract for the installation of telecommunications network infrastructure that will enable the supply of eligible services to premises in the whole of the project area of a real estate development project; and  (b) when the installation is completed, the carrier will be required, by subsection 360H(2), to declare that the whole of the project area is a provisional nominated service area for the purposes of this Part; the carrier must:  (c) give the ACMA a written notice that:  (i) states that the carrier has entered into the contract; and  (ii) specifies the project area; and  (iii) describes the telecommunications network infrastructure that is to be installed under the contract; and  (iv) sets out the carrier’s estimate of the likely completion date for the installation; and  (d) do so within 10 business days after entering into the contract. Note: For the format of the description of the area, see section 360LA." ;
    cof:pageNumber "120"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360ha-ss-2 a cml:Concept ;
    skos:prefLabel "360HA(2) Nominated service area—anticipatory notice to be given to"@en ;
    cml:realizedBy doc:sch-3-sec-360ha-ss-2 ;
    values:originalText "(2) If:  (a) before the commencement of this section, a carrier (other than an NBN corporation) entered into a contract for the installation of telecommunications network infrastructure that will enable the supply of eligible services to premises in the whole of the project area of a real estate development project; and  (b) the installation was not completed before the commencement of this section; and  (c) when the installation is completed, the carrier will be required, by subsection 360H(2), to declare that the whole of the project area is a provisional nominated service area for the purposes of this Part; the carrier must:  (d) give the ACMA a written notice that:  (i) states that the carrier has entered into the contract; and  (ii) specifies the project area; and  Schedule 3  Statutory infrastructure providers etc." ;
    skos:definition "(2) If:  (a) before the commencement of this section, a carrier (other than an NBN corporation) entered into a contract for the installation of telecommunications network infrastructure that will enable the supply of eligible services to premises in the whole of the project area of a real estate development project; and  (b) the installation was not completed before the commencement of this section; and  (c) when the installation is completed, the carrier will be required, by subsection 360H(2), to declare that the whole of the project area is a provisional nominated service area for the purposes of this Part; the carrier must:  (d) give the ACMA a written notice that:  (i) states that the carrier has entered into the contract; and  (ii) specifies the project area; and  Schedule 3  Statutory infrastructure providers etc."@en ;
    cml:integrityHash "3848d197a907e6e4bfd85d270559102bc815a6f14fb550961ed9b9696c79c7f5" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360ha ;
    cof:pageNumber "120"^^xsd:integer ;
    skos:note "Carrier must give written notice to ACMA with contract details and project area." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
