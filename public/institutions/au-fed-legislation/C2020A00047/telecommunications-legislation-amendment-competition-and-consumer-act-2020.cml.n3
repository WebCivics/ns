concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zk a cml:Concept ;
    skos:prefLabel "151ZK Delegation"@en ;
    cml:realizedBy doc:sch-2-sec-151zk ;
    values:originalText "The ACCC may, by writing, delegate to a person who is:  (a) a member of the staff of the ACCC; and  (b) an SES employee or acting SES employee; the ACCC’s powers under any of the following provisions:  Schedule 2  Local access lines  Telecommunications Legislation Amendment (Competition and Consumer) Act 2020 No. 47, 2020  (c) subsection 103(4F) (formal warning);  (d) section 151D (further information);  (e) subsection 151F(7) (extension of decision-making period);  (f) section 151H (serial undertakings);  (g) section 151R (further information);  (h) subsection 151T(7) (extension of decision-making period)." ;
    skos:definition "The ACCC may, by writing, delegate to a person who is:  (a) a member of the staff of the ACCC; and  (b) an SES employee or acting SES employee; the ACCC’s powers under any of the following provisions:  Schedule 2  Local access lines  Telecommunications Legislation Amendment (Competition and Consumer) Act 2020 No. 47, 2020  (c) subsection 103(4F) (formal warning);  (d) section 151D (further information);  (e) subsection 151F(7) (extension of decision-making period);  (f) section 151H (serial undertakings);  (g) section 151R (further information);  (h) subsection 151T(7) (extension of decision-making period)."@en ;
    cml:integrityHash "41bd17fbf056a0cff7ac7c735a0eac728efc13c04006c89d7da8835c2dc2d1f5" ;
    cof:pageNumber "89"^^xsd:integer ;
    skos:note "Delegation of ACCC powers to staff and SES employees" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
