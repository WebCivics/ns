doc:sch-4-sec-100-ss-3a a cof:Section ;
    cof:title "100(3A) Reporting obligations" ;
    values:kind "subsection" ;
    values:originalText "(3A) If, at any time during a month covered by the report, the person had an associate in relation to control of:  (a) a telecommunications network; or  (b) a company; or  (c) a local access line; the report must:  (d) set out the name of the associate; and  Funding of fixed wireless broadband and satellite broadband  Schedule 4  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  (e) set out the ACN (if any) of the associate; and  (f) identify the network, company or line, as the case requires; and  (g) identify which paragraph or paragraphs of subsection 152(1) of the Telecommunications Act 1997 resulted in the person having the associate. Transitional" ;
    cof:pageNumber "178"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-4 a cml:Concept ;
    skos:prefLabel "100(4) Reporting obligations"@en ;
    cml:realizedBy doc:sch-4-sec-100-ss-4 ;
    values:originalText "(4) If:  (a) the report relates to:  (i) the first eligible financial year; or  (ii) the second eligible financial year; or  (iii) the third eligible financial year; or  (iv) the fourth eligible financial year; or  (v) the fifth eligible financial year; and  (b) there are one or more potentially concessional premises in relation to the person for a month in the eligible financial year; the report must set out the total number of potentially concessional premises in relation to the person for that month." ;
    skos:definition "(4) If:  (a) the report relates to:  (i) the first eligible financial year; or  (ii) the second eligible financial year; or  (iii) the third eligible financial year; or  (iv) the fourth eligible financial year; or  (v) the fifth eligible financial year; and  (b) there are one or more potentially concessional premises in relation to the person for a month in the eligible financial year; the report must set out the total number of potentially concessional premises in relation to the person for that month."@en ;
    cml:integrityHash "50c15ee564dac888a89312b357311317ac63fa90c0d8c882d97ce154a346f647" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100 ;
    cof:pageNumber "178"^^xsd:integer ;
    skos:note "Report must set out total number of potentially concessional premises for a month if there are one or more in relation to the person." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
