concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360f a cml:Concept ;
    skos:prefLabel "360F General service area"@en ;
    cml:realizedBy doc:sch-3-sec-360f ;
    values:originalText "For the purposes of the application of this Part after the start of the designated day, the general service area means Australia, other than:  (a) a nominated service area; or  (b) a designated service area." ;
    skos:definition "For the purposes of the application of this Part after the start of the designated day, the general service area means Australia, other than:  (a) a nominated service area; or  (b) a designated service area."@en ;
