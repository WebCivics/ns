    cml:integrityHash "cd67ed7ccc8101af40fc1cf60e51b9eb5353e88481ba560cc31c56050b397549" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360la ;
    cof:pageNumber "125"^^xsd:integer ;
