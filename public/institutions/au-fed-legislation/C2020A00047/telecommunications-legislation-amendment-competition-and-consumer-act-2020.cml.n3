concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360k-ss-3 a cml:Concept ;
    skos:prefLabel "360K(3) Statutory infrastructure provider for a nominated service area"@en ;
    cml:realizedBy doc:sch-3-sec-360k-ss-3 ;
    values:originalText "(3) For the purposes of this Part, if:  (a) immediately before the commencement of this section, a carrier licence held by a carrier was subject to a condition under a declaration mentioned in section 360J; and  (b) as a result of the application of section 360J to the declaration, an area is a nominated service area; the carrier is the statutory infrastructure provider for the nominated service area." ;
    skos:definition "(3) For the purposes of this Part, if:  (a) immediately before the commencement of this section, a carrier licence held by a carrier was subject to a condition under a declaration mentioned in section 360J; and  (b) as a result of the application of section 360J to the declaration, an area is a nominated service area; the carrier is the statutory infrastructure provider for the nominated service area."@en ;
    cml:integrityHash "e4b5875afc85bbf21f87b82ddb02b607762e4c762c6dccaf807ed0d11f8e43de" ;
    values:partOf concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360k ;
    cof:pageNumber "124"^^xsd:integer ;
    skos:note "Carrier is statutory infrastructure provider for nominated service area if conditions are met." ;
