    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102-ss-3 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102-ss-4 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102-ss-5 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102-ss-6 ;
