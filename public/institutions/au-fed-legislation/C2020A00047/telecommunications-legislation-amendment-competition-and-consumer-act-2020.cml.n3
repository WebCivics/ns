    cml:premiseText "(4) The ACCC must not vary a joint functional separation undertaking under subsection (3) unless..." ;
    cml:conclusionText "...unless the variation addresses the matter or matters that constituted the grounds for the revocation of the undertaking under section 151W;" ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-2-sec-151z-ss-4 a cof:Section ;
    cof:title "151Z(4) Variation of functional separation undertaking following" ;
    values:kind "subsection" ;
    values:originalText "(4) The ACCC must not vary a joint functional separation undertaking under subsection (3) unless the variation:  (a) addresses the matter or matters that constituted the grounds for the revocation of the undertaking under section 151W; and  (b) does not address any other matter.  Local access lines  Schedule 2  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  When variation takes effect" ;
    cof:pageNumber "74"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151z-ss-5 a cml:Concept ;
    skos:prefLabel "151Z(5) Variation of functional separation undertaking following"@en ;
    cml:realizedBy doc:sch-2-sec-151z-ss-5 ;
    values:originalText "(5) A variation under subsection (1) or (3) takes effect at the time the notice is given." ;
    skos:definition "(5) A variation under subsection (1) or (3) takes effect at the time the notice is given."@en ;
    cml:integrityHash "4265d11eb39d27be502fcb94dbd06b560b056a07ba20c9a27fbed75c40aa9f26" ;
