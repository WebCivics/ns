doc:sch-3-sec-360l a cof:Section ;
    cof:title "360L Designated service area and statutory infrastructure provider" ;
    values:kind "section" ;
    values:originalText "The Minister may, by legislative instrument, declare that:  (a) a specified area is a designated service area for the purposes of this Part; and  (b) a specified carrier is the statutory infrastructure provider for the designated service area for the purposes of this Part. Note: For the format of the description of the area, see section 360LA. Subdivision D—Format of description of areas" ;
    cof:pageNumber "125"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360la a cml:Concept ;
    skos:prefLabel "360LA Format of description of areas"@en ;
    cml:realizedBy doc:sch-3-sec-360la ;
    values:originalText "(1) An area declared under:  (a) subsection 360D(2); or  (b) subsection 360D(3); or  (c) subsection 360H(2); or  (d) subsection 360H(4); or  (e) subsection 360H(6); or  (f) section 360L; must be described:  (g) in a TAB vector format using the GDA94 coordinate system; or  (h) if another format is determined under subsection (3)—in that other format.  (2) An area specified under:  (a) subsection 360HA(1); or  (b) subsection 360HA(2); or  (c) subsection 360HA(3); or  (d) subsection 360HA(4); must be described:  (e) in a TAB vector format using the GDA94 coordinate system; or  (f) if another format is determined under subsection (3)—in that other format.  Schedule 3  Statutory infrastructure providers etc." ;
    skos:definition "(1) An area declared under:  (a) subsection 360D(2); or  (b) subsection 360D(3); or  (c) subsection 360H(2); or  (d) subsection 360H(4); or  (e) subsection 360H(6); or  (f) section 360L; must be described:  (g) in a TAB vector format using the GDA94 coordinate system; or  (h) if another format is determined under subsection (3)—in that other format.  (2) An area specified under:  (a) subsection 360HA(1); or  (b) subsection 360HA(2); or  (c) subsection 360HA(3); or  (d) subsection 360HA(4); must be described:  (e) in a TAB vector format using the GDA94 coordinate system; or  (f) if another format is determined under subsection (3)—in that other format.  Schedule 3  Statutory infrastructure providers etc."@en ;
    cml:integrityHash "fdf61c102dff05e0f3483841672b038bd7570496351cd1d7eac67c9ed2a471f9" ;
    cof:pageNumber "125"^^xsd:integer ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360la-ss-1 ;
    cml:hasPart concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360la-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf> ;
    dc:source "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.125" .
doc:sch-3-sec-360la a cof:Section ;
    cof:title "360LA Format of description of areas" ;
    values:kind "section" ;
    values:originalText "(1) An area declared under:  (a) subsection 360D(2); or  (b) subsection 360D(3); or  (c) subsection 360H(2); or  (d) subsection 360H(4); or  (e) subsection 360H(6); or  (f) section 360L; must be described:  (g) in a TAB vector format using the GDA94 coordinate system; or  (h) if another format is determined under subsection (3)—in that other format.  (2) An area specified under:  (a) subsection 360HA(1); or  (b) subsection 360HA(2); or  (c) subsection 360HA(3); or  (d) subsection 360HA(4); must be described:  (e) in a TAB vector format using the GDA94 coordinate system; or  (f) if another format is determined under subsection (3)—in that other format.  Schedule 3  Statutory infrastructure providers etc." ;
    cof:pageNumber "125"^^xsd:integer .

