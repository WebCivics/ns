doc:sch-2-sec-151zh-ss-4 a cof:Section ;
    cof:title "151ZH(4) Statement about the differences between an access" ;
    values:kind "subsection" ;
    values:originalText "(4) Subsections (1), (2), (2A) and (3) are civil penalty provisions. Note: Part 31 provides for pecuniary penalties for breaches of civil penalty provisions. Access agreement and variation agreement" ;
    cof:pageNumber "84"^^xsd:integer .

