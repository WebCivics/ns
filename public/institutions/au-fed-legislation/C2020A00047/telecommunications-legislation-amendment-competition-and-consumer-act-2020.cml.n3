concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11 cml:asserts concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-deontic-5 .
concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Must report premises if did not know or could not have ascertained that premises are not recently connected greenfield premises" ;
