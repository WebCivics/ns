    cml:modality cml:Diffusion ;
    cml:operator "Diffuses" ;
    cml:logicSummary "The exemption from charging applies to all small networks of exempt premises during the period when a person is not a member of an associated group and has fewer than 2000 potentially chargeable premises." ;
    cml:premiseText "(b) The total number of potentially chargeable premises in relation to the person for that month is less than 2,000; and" ;
    cml:conclusionText "each of those potentially chargeable premises are exempt premises in relation to the person for that month." ;
