concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102n-ss-6 a cml:Concept ;
    skos:prefLabel "102N(6) Late payment penalty"@en ;
    cml:realizedBy doc:sch-4-sec-102n-ss-6 ;
    values:originalText "(6) If the amount of the late payment penalty for a day is not an amount of whole dollars, the late payment penalty is rounded to the nearest dollar (rounding 50 cents upwards)." ;
    skos:definition "(6) If the amount of the late payment penalty for a day is not an amount of whole dollars, the late payment penalty is rounded to the nearest dollar (rounding 50 cents upwards)."@en ;
