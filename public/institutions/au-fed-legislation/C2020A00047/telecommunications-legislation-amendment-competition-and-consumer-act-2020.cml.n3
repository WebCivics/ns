doc:sch-3-sec-360za-ss-1 a cof:Section ;
    cof:title "360ZA(1) Delegation" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister may, by writing, delegate to the ACMA any or all of the Minister’s powers under the following provisions:  (a) subsection 360D(14);  (b) subsection 360H(3);  (c) subsection 360H(5);  (d) subsection 360H(7);  (e) subsection 360H(11);  (f) subsection 360P(3);  (g) subsection 360P(5);  (h) subsection 360P(10);  (i) subsection 360Q(4);  (j) subsection 360Q(6);  Statutory infrastructure providers etc.  Schedule 3 Amendments  Part 1  No. 47, 2020 Telecommunications Legislation Amendment (Competition and Consumer) Act 2020  (k) subsection 360U(1);  (l) subsection 360U(6);  (m) subsection 360XA(1);  (n) subsection 360Y(3)." ;
    cof:pageNumber "140"^^xsd:integer .

