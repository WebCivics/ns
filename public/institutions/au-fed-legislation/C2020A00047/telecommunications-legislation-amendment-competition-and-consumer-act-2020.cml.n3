    cof:pageNumber "54"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151e-ss-4 a cml:Concept ;
    skos:prefLabel "151E(4) Withdrawal of undertaking that is under consideration"@en ;
    cml:realizedBy doc:sch-2-sec-151e-ss-4 ;
    values:originalText "(4) If:  (a) the person or persons withdraw the undertaking; and  (b) the person or persons have paid a fee in relation to the undertaking; the ACCC may, on behalf of the Commonwealth, refund the whole or a part of the fee." ;
