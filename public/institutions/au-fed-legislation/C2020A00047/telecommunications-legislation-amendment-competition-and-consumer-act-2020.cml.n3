concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151q-ss-6 a cml:Concept ;
    skos:prefLabel "151Q(6) Variation of functional separation undertaking that is in force"@en ;
    cml:realizedBy doc:sch-2-sec-151q-ss-6 ;
    values:originalText "(6) The ACCC may, by legislative instrument, determine a fee, or a method of ascertaining a fee, for the purposes of paragraph (5)(b)." ;
    skos:definition "(6) The ACCC may, by legislative instrument, determine a fee, or a method of ascertaining a fee, for the purposes of paragraph (5)(b)."@en ;
    cml:integrityHash "dbcdd3155903cfdbaa6bb523dafa937973e90b013f40ea4e6ad8189e220264e9" ;
