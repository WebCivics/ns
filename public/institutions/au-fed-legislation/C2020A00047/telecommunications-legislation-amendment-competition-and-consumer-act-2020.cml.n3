doc:sch-2-sec-151w-ss-1 a cof:Section ;
    cof:title "151W(1) Revocation of functional separation undertaking" ;
    values:kind "subsection" ;
    values:originalText "(1) If:  (a) a standard functional separation undertaking given by a person is in force; and  (b) the person has:  (i) breached a fundamental provision of the undertaking; or  (ii) contravened section 151ZF or 151ZG; the ACCC may, by written notice given to the person, revoke the undertaking." ;
    cof:pageNumber "69"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151w-ss-2 a cml:Concept ;
    skos:prefLabel "151W(2) Revocation of functional separation undertaking"@en ;
    cml:realizedBy doc:sch-2-sec-151w-ss-2 ;
    values:originalText "(2) If:  (a) a standard functional separation undertaking given by a person is in force; and  (b) the ACCC is satisfied that the person has an unsatisfactory compliance record in relation to functional separation; the ACCC may, by written notice given to the person, revoke the undertaking." ;
    skos:definition "(2) If:  (a) a standard functional separation undertaking given by a person is in force; and  (b) the ACCC is satisfied that the person has an unsatisfactory compliance record in relation to functional separation; the ACCC may, by written notice given to the person, revoke the undertaking."@en ;
    cml:integrityHash "2eca3ab07e8459182e46200aa5e92cf755b5aad52c0bef6c881076c9959f37d2" ;
