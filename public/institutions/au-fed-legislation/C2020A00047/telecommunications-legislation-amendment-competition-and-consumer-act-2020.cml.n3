doc:sch-2-sec-151h-ss-2 a cof:Section ;
    cof:title "151H(2) Serial undertakings" ;
    values:kind "subsection" ;
    values:originalText "(2) If:  (a) 2 or more persons give the ACCC a joint functional separation undertaking (the first functional separation undertaking); and  (b) the ACCC rejects the first functional separation undertaking; and  (c) those persons subsequently give the ACCC another joint functional separation undertaking; and  (d) the ACCC is satisfied that any or all of the provisions of the first functional separation undertaking are materially similar to any or all of the provisions of the other functional separation undertaking; the ACCC may refuse to consider the other functional separation undertaking. Refund of fee" ;
    cof:pageNumber "57"^^xsd:integer .

concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151h-ss-3 a cml:Concept ;
    skos:prefLabel "151H(3) Serial undertakings"@en ;
    cml:realizedBy doc:sch-2-sec-151h-ss-3 ;
    values:originalText "(3) If:  (a) the ACCC refuses to consider a functional separation undertaking under this section; and  (b) a person or persons have paid a fee in relation to the undertaking; the ACCC must, on behalf of the Commonwealth, refund the fee." ;
    skos:definition "(3) If:  (a) the ACCC refuses to consider a functional separation undertaking under this section; and  (b) a person or persons have paid a fee in relation to the undertaking; the ACCC must, on behalf of the Commonwealth, refund the fee."@en ;
    cml:integrityHash "093259b247b8112a3c766385b84de6ad3d3280e6788032c64b7bf906c1b4a7a8" ;
