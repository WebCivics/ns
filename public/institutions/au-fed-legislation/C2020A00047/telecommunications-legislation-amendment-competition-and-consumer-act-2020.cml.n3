doc:sch-4-sec-79a-ss-2 a cof:Section ;
    cof:title "79A(2) Premises" ;
    values:kind "subsection" ;
    values:originalText "(2) The Minister may, by legislative instrument, determine that, if a location satisfies one or more specified conditions, the location is taken not to be premises for the purposes of this Part. Note: See also section 102ZFB (disallowance of determinations)." ;
    cof:pageNumber "155"^^xsd:integer .

