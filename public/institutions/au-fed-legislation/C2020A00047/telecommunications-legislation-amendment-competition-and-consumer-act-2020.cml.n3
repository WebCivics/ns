concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102g a cml:Concept ;
    skos:prefLabel "102G Evidence of assessment"@en ;
    cml:realizedBy doc:sch-4-sec-102g ;
    values:originalText "Scope  (1) This section applies if a document that purports to be a copy of an assessment under section 102 is produced in a proceeding. Evidence  (2) Except so far as the contrary is established, it must be presumed:  (a) that the document is a copy of the assessment; and  (b) that the ACMA has duly made the assessment; and  (c) that the amounts and other particulars set out in the assessment are correct." ;
    skos:definition "Scope  (1) This section applies if a document that purports to be a copy of an assessment under section 102 is produced in a proceeding. Evidence  (2) Except so far as the contrary is established, it must be presumed:  (a) that the document is a copy of the assessment; and  (b) that the ACMA has duly made the assessment; and  (c) that the amounts and other particulars set out in the assessment are correct."@en ;
    cml:integrityHash "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000" ;
    cof:pageNumber "187"^^xsd:integer ;
