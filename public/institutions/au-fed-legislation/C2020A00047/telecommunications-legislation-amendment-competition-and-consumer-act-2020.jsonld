      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102x",
      "@type": "cml:Concept",
      "skos:prefLabel": "102X ACCC may retain documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102x"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.193",
      "values:originalText": "(1) The ACCC may take, and retain for as long as is necessary,\npossession of a document produced under subsection 102U(2).\n\n(2) The eligible funding recipient otherwise entitled to possession of\nthe document is entitled to be supplied, as soon as practicable, with\na copy certified by the ACCC to be a true copy.\n\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n\n(4) Until a certified copy is supplied, the ACCC must, at such times\nand places as the ACCC thinks appropriate, permit the eligible\nfunding recipient otherwise entitled to possession of the document,\nor a person authorised by that eligible funding recipient, to inspect\nand make copies of, or take extracts from, the document.",
      "skos:definition": "(1) The ACCC may take, and retain for as long as is necessary,\npossession of a document produced under subsection 102U(2).\n\n(2) The eligible funding recipient otherwise entitled to possession of\nthe document is entitled to be supplied, as soon as practicable, with\na copy certified by the ACCC to be a true copy.\n\n(3) The certified copy must be received in all courts and tribunals as\nevidence as if it were the original.\n\n(4) Until a certified copy is supplied, the ACCC must, at such times\nand places as the ACCC thinks appropriate, permit the eligible\nfunding recipient otherwise entitled to possession of the document,\nor a person authorised by that eligible funding recipient, to inspect\nand make copies of, or take extracts from, the document.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102x-ss-1"
        },
