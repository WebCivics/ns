    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102r",
      "@type": "cof:Section",
      "cof:title": "102R Copies of documents",
      "values:kind": "section",
      "cof:pageNumber": 190,
      "values:originalText": "(1) The ACMA may:\n\n(a) inspect a document or copy produced under\nsubsection 102P(2); and\n\n(b) make and retain copies of, or take and retain extracts from,\nsuch a document.\n\n(2) The ACMA may retain possession of a copy of a document\nproduced in accordance with a requirement covered by\nparagraph 102P(2)(c)."
    },
