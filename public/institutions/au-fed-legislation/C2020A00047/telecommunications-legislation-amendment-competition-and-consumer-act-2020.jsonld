    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "100(5) Reporting obligations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-100-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.178",
      "values:originalText": "(5) If:\n\n(a) particular premises are reported as potentially concessional\npremises in relation to the person for a month; and\n\n(b) apart from this subsection, the premises are not potentially\nconcessional premises in relation to the person for the month;\nand\n\n(c) the person:\n\n(i) did not know; and\n\n(ii) could not, with reasonable diligence, have ascertained;\n\nthat the premises are not potentially concessional premises in\nrelation to the person for the month;\nthe premises are taken, for all purposes, to be potentially\nconcessional premises in relation to the person for the month.",
      "skos:definition": "(5) If:\n\n(a) particular premises are reported as potentially concessional\npremises in relation to the person for a month; and\n\n(b) apart from this subsection, the premises are not potentially\nconcessional premises in relation to the person for the month;\nand\n\n(c) the person:\n\n(i) did not know; and\n\n(ii) could not, with reasonable diligence, have ascertained;\n\nthat the premises are not potentially concessional premises in\nrelation to the person for the month;\nthe premises are taken, for all purposes, to be potentially\nconcessional premises in relation to the person for the month.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-logic-deontic-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-logic-deontic-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-logic-deontic-4"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-logic-deontic-5"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-logic-deontic-6"
        }
      ],
      "cml:integrityHash": "3c20c6e28c7a117e50b76997dcc569e25332bc541d737978770046de67f13156",
      "skos:note": "If premises are reported as potentially concessional and the person did not know or could not have known they were not, the premises are taken to be potentially concessional."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-100-ss-5",
      "@type": "cof:Section",
      "cof:title": "100(5) Reporting obligations",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(5) If:\n\n(a) particular premises are reported as potentially concessional\npremises in relation to the person for a month; and\n\n(b) apart from this subsection, the premises are not potentially\nconcessional premises in relation to the person for the month;\nand\n\n(c) the person:\n\n(i) did not know; and\n\n(ii) could not, with reasonable diligence, have ascertained;\n\nthat the premises are not potentially concessional premises in\nrelation to the person for the month;\nthe premises are taken, for all purposes, to be potentially\nconcessional premises in relation to the person for the month."
    },
