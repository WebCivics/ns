    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-97-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "97(4) Anti-avoidance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-97-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
