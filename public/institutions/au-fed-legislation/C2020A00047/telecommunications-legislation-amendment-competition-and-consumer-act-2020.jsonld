      "@type": "cml:Concept",
      "skos:prefLabel": "151A(11) Standard functional separation undertaking",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151a-ss-11"
