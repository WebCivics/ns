    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360e",
      "@type": "cml:Concept",
      "skos:prefLabel": "360E Statutory infrastructure provider for an interim NBN service",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.116",
      "values:originalText": "area\n\nFor the purposes of the application of this Part before the\ndesignated day, if:\n\n(a) an area is a provisional interim NBN service area because of\na section 360D declaration made by NBN Co; and\n\n(b) the whole or a part of the provisional interim NBN service\narea is an interim NBN service area;\nNBN Co is the statutory infrastructure provider for the interim\nNBN service area.\nSubdivision B—Rules applicable after the start of the\ndesignated day",
      "skos:definition": "area\n\nFor the purposes of the application of this Part before the\ndesignated day, if:\n\n(a) an area is a provisional interim NBN service area because of\na section 360D declaration made by NBN Co; and\n\n(b) the whole or a part of the provisional interim NBN service\narea is an interim NBN service area;\nNBN Co is the statutory infrastructure provider for the interim\nNBN service area.\nSubdivision B—Rules applicable after the start of the\ndesignated day",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360e-norm"
        }
      ],
      "cml:integrityHash": "34385eabe2bd773ea2301906cdbe60cdedf2b9b8fa7d1e4dbf5b8753f33af9f7",
      "skos:note": "NBN Co is statutory infrastructure provider for interim NBN service area if provisional interim NBN service area declared by section 360D declaration."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360e",
      "@type": "cof:Section",
      "cof:title": "360E Statutory infrastructure provider for an interim NBN service",
      "values:kind": "section",
      "cof:pageNumber": 116,
      "values:originalText": "area\n\nFor the purposes of the application of this Part before the\ndesignated day, if:\n\n(a) an area is a provisional interim NBN service area because of\na section 360D declaration made by NBN Co; and\n\n(b) the whole or a part of the provisional interim NBN service\narea is an interim NBN service area;\nNBN Co is the statutory infrastructure provider for the interim\nNBN service area.\nSubdivision B—Rules applicable after the start of the\ndesignated day"
    },
