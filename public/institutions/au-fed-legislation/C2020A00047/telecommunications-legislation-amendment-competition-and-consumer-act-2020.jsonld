      "@type": "cof:Section",
      "cof:title": "99(2) Remission or refund of charge",
      "values:kind": "subsection",
      "cof:pageNumber": 177,
      "values:originalText": "(2) The Secretary must inform the ACMA of a remission of charge\nunder subsection (1)."
    },
