    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360",
      "@type": "cml:Concept",
      "skos:prefLabel": "360 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.108",
      "values:originalText": "•\nThe statutory infrastructure provider for a service area must,\non reasonable request by a carriage service provider on behalf\nof an end-user at premises in the service area, connect the\npremises to a qualifying telecommunications network in order\nthat the carriage service provider can provide qualifying\ncarriage services to the end-user at the premises.\n•\nA statutory infrastructure provider must comply with\nstandards, benchmarks and rules determined by the Minister.\n•\nA statutory infrastructure provider must publish the terms and\nconditions on which it offers to:\n\n(a)\nconnect premises; or\n\nStatutory infrastructure providers etc.  Schedule 3\nAmendments  Part 1\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(b)\nsupply related eligible services to carriage service\nproviders.",
      "skos:definition": "•\nThe statutory infrastructure provider for a service area must,\non reasonable request by a carriage service provider on behalf\nof an end-user at premises in the service area, connect the\npremises to a qualifying telecommunications network in order\nthat the carriage service provider can provide qualifying\ncarriage services to the end-user at the premises.\n•\nA statutory infrastructure provider must comply with\nstandards, benchmarks and rules determined by the Minister.\n•\nA statutory infrastructure provider must publish the terms and\nconditions on which it offers to:\n\n(a)\nconnect premises; or\n\nStatutory infrastructure providers etc.  Schedule 3\nAmendments  Part 1\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(b)\nsupply related eligible services to carriage service\nproviders.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a39b8b3da4cdc5f890f7a8a64648c03cc337dc81017373d92999e6da884d0a69",
      "skos:note": "Must connect premises to a qualifying telecommunications network",
      "dc:description": "Qualifying carriage services to the end-user at the premises"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360",
      "@type": "cof:Section",
      "cof:title": "360 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "•\nThe statutory infrastructure provider for a service area must,\non reasonable request by a carriage service provider on behalf\nof an end-user at premises in the service area, connect the\npremises to a qualifying telecommunications network in order\nthat the carriage service provider can provide qualifying\ncarriage services to the end-user at the premises.\n•\nA statutory infrastructure provider must comply with\nstandards, benchmarks and rules determined by the Minister.\n•\nA statutory infrastructure provider must publish the terms and\nconditions on which it offers to:\n\n(a)\nconnect premises; or\n\nStatutory infrastructure providers etc.  Schedule 3\nAmendments  Part 1\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(b)\nsupply related eligible services to carriage service\nproviders."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
