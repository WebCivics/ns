        }
      ],
      "cml:integrityHash": "6a30f71cfe13284aac943149752b2fea1e35acea83e1b7ba43fa87e03f769122",
      "skos:note": "Prohibition on using the line to supply an eligible service unless it is supplied to a carrier or service provider."
    },
