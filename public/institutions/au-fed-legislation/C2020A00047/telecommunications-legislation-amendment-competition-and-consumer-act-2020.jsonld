    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143a-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "143A(5) Class exemptions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-143a-ss-5"
      },
