    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151d",
      "@type": "cml:Concept",
      "skos:prefLabel": "151D Further information about undertaking",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.54",
      "values:originalText": "Scope\n\n(1) This section applies if:\n\n(a) a person gives the ACCC a standard functional separation\nundertaking; or\n\n(b) 2 or more persons give the ACCC a joint functional\nseparation undertaking.\nRequest for further information\n\n(2) The ACCC may request the person or persons to give the ACCC\nfurther information about the undertaking.\n\n(3) The ACCC may refuse to consider the undertaking until the person\nor persons give the ACCC the information.\n\n(4) The ACCC may withdraw its request for further information, in\nwhole or in part.",
      "skos:definition": "Scope\n\n(1) This section applies if:\n\n(a) a person gives the ACCC a standard functional separation\nundertaking; or\n\n(b) 2 or more persons give the ACCC a joint functional\nseparation undertaking.\nRequest for further information\n\n(2) The ACCC may request the person or persons to give the ACCC\nfurther information about the undertaking.\n\n(3) The ACCC may refuse to consider the undertaking until the person\nor persons give the ACCC the information.\n\n(4) The ACCC may withdraw its request for further information, in\nwhole or in part.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151d-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151d-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151d-ss-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151d-ss-4"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151d",
      "@type": "cof:Section",
      "cof:title": "151D Further information about undertaking",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "Scope\n\n(1) This section applies if:\n\n(a) a person gives the ACCC a standard functional separation\nundertaking; or\n\n(b) 2 or more persons give the ACCC a joint functional\nseparation undertaking.\nRequest for further information\n\n(2) The ACCC may request the person or persons to give the ACCC\nfurther information about the undertaking.\n\n(3) The ACCC may refuse to consider the undertaking until the person\nor persons give the ACCC the information.\n\n(4) The ACCC may withdraw its request for further information, in\nwhole or in part."
    },
