        }
      ],
      "cml:integrityHash": "740dce17d22567a56b268cfd9a56479517db703831d72593bd8e74bae6fce8ea",
      "skos:note": "No report or information obtained as a consequence of the report is admissible in evidence against the individual in civil proceedings for the recovery of a penalty or criminal proceedings (other than proceedings for an offence against section 137.1 or 137.2 of the Criminal Code)."
    },
