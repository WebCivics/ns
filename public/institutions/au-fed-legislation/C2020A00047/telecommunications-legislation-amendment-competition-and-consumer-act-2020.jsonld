      },
      "cml:operator": "Recurrently",
      "cml:logicSummary": "The person must provide funding for fixed wireless broadband and satellite broadband repeatedly if they supply a designated service to potentially chargeable premises.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
