    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-156a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Line must be used for residential customers after designated commencement date.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a local access line came into existence before the designated commencement date; and (b) before the designated commencement date, the line was used wholly or principally to supply a superfast carriage service to non-residential customers in Australia;",
      "cml:conclusionText": "the line is taken to have come into existence on or after the designated commencement date."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-156a-ss-1-logic-alleninterval-2",
