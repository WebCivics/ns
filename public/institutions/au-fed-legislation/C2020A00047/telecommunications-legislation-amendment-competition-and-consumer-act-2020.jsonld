      "@type": "cml:Concept",
      "skos:prefLabel": "102C(10) ACMA may accept statements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102c-ss-10"
      },
