    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "100(10) Reporting obligations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-100-ss-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.178",
      "values:originalText": "(10) If:\n\n(a) the report relates to:\n\n(i) the first eligible financial year; or\n\n(ii) the second eligible financial year; or\n\n(iii) the third eligible financial year; or\n\n(iv) the fourth eligible financial year; or\n\n(v) the fifth eligible financial year; and\n\n(b) there are one or more recently connected greenfield premises\nin relation to the person for a month in the eligible financial\nyear;\nthe report must set out the total number of recently connected\ngreenfield premises in relation to the person for that month.",
      "skos:definition": "(10) If:\n\n(a) the report relates to:\n\n(i) the first eligible financial year; or\n\n(ii) the second eligible financial year; or\n\n(iii) the third eligible financial year; or\n\n(iv) the fourth eligible financial year; or\n\n(v) the fifth eligible financial year; and\n\n(b) there are one or more recently connected greenfield premises\nin relation to the person for a month in the eligible financial\nyear;\nthe report must set out the total number of recently connected\ngreenfield premises in relation to the person for that month.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-10-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b81b7d85b69f2aa7a2975b05d444ca93cdc23dc0cbc0a7f9e3e8fe6d2bee21b9",
      "skos:note": "Report must set out total number of recently connected greenfield premises for a month.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-100-ss-10",
      "@type": "cof:Section",
      "cof:title": "100(10) Reporting obligations",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(10) If:\n\n(a) the report relates to:\n\n(i) the first eligible financial year; or\n\n(ii) the second eligible financial year; or\n\n(iii) the third eligible financial year; or\n\n(iv) the fourth eligible financial year; or\n\n(v) the fifth eligible financial year; and\n\n(b) there are one or more recently connected greenfield premises\nin relation to the person for a month in the eligible financial\nyear;\nthe report must set out the total number of recently connected\ngreenfield premises in relation to the person for that month."
    },
