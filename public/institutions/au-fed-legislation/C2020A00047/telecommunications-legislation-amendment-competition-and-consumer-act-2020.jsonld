    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zd-ss-3",
      "@type": "cof:Section",
      "cof:title": "151ZD(3) Compliance with functional separation undertaking",
      "values:kind": "subsection",
      "cof:pageNumber": 78,
      "values:originalText": "(3) Subsections (1) and (2) are civil penalty provisions.\nNote:\nPart 31 provides for pecuniary penalties for breaches of civil penalty\nprovisions."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zd-ss-3-norm",
      "@type": "values:Undertaking",
