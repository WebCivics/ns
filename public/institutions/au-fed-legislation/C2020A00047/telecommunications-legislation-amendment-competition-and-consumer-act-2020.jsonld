      "cml:integrityHash": "d7ff3c62578d62931977094f66fa97b902d4ae8a8b357f45a6bef58202f84a93",
      "skos:note": "Eligible funding recipient commits an offence if contravenes a requirement in notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102u-ss-5",
      "@type": "cof:Section",
      "cof:title": "102U(5) Access to information or documents held by an eligible",
      "values:kind": "subsection",
      "cof:pageNumber": 191,
      "values:originalText": "(5) An eligible funding recipient commits an offence if:\n\n(a) the ACCC has given a notice to the eligible funding recipient\nunder subsection (2); and\n\n(b) the eligible funding recipient engages in conduct; and\n\n(c) the eligible funding recipient’s conduct contravenes a\nrequirement in the notice.\nPenalty for contravention of this subsection: 50 penalty units."
    },
