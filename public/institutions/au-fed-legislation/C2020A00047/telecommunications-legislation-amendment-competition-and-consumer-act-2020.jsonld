        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102w"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102w-ss-2-norm"
        }
      ],
      "cml:integrityHash": "8a91386b56fa9644a7388f0a549a44a4b991850e3c872ed2ea92345efc98fc72",
      "skos:note": "The ACCC may retain possession of a copy of a document produced in accordance with a requirement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102w-ss-2",
      "@type": "cof:Section",
      "cof:title": "102W(2) Copies of documents",
      "values:kind": "subsection",
      "cof:pageNumber": 192,
      "values:originalText": "(2) The ACCC may retain possession of a copy of a document\nproduced in accordance with a requirement covered by\nparagraph 102U(2)(c).\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102w-ss-2-norm",
      "@type": "values:Undertaking",
