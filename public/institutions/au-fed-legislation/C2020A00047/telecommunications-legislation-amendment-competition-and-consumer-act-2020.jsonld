    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-4-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Transitional—election to be bound by deemed standard functional",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sec-4-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.7",
      "values:originalText": "separation undertaking\n\nIf:\n\n(a) in accordance with section 4 of the Acts Interpretation Act\n1901, a determination is made under subsection 151B(1) of\nthe Telecommunications Act 1997 before the commencement\nof Schedule 2 to this Act; and\n\n(b) a corporation is included in a class of corporations specified\nin the determination;\nthe corporation may, before the commencement of that Schedule,\ngive an election to be bound by the determination.",
      "skos:definition": "separation undertaking\n\nIf:\n\n(a) in accordance with section 4 of the Acts Interpretation Act\n1901, a determination is made under subsection 151B(1) of\nthe Telecommunications Act 1997 before the commencement\nof Schedule 2 to this Act; and\n\n(b) a corporation is included in a class of corporations specified\nin the determination;\nthe corporation may, before the commencement of that Schedule,\ngive an election to be bound by the determination.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-4-2-norm"
        }
      ],
      "cml:integrityHash": "c9fe4a64035c502085003d6ec3edb39d0d06eb80dabf0cb3e5c17bd46f779040",
      "skos:note": "Election to be bound by deemed standard functional determination"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sec-4-2",
      "@type": "cof:Section",
      "cof:title": "4 Transitional—election to be bound by deemed standard functional",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "separation undertaking\n\nIf:\n\n(a) in accordance with section 4 of the Acts Interpretation Act\n1901, a determination is made under subsection 151B(1) of\nthe Telecommunications Act 1997 before the commencement\nof Schedule 2 to this Act; and\n\n(b) a corporation is included in a class of corporations specified\nin the determination;\nthe corporation may, before the commencement of that Schedule,\ngive an election to be bound by the determination."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-4-2-norm",
      "@type": "values:Undertaking",
