    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360l",
      "@type": "cml:Concept",
      "skos:prefLabel": "360L Designated service area and statutory infrastructure provider",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.125",
      "values:originalText": "The Minister may, by legislative instrument, declare that:\n\n(a) a specified area is a designated service area for the purposes\nof this Part; and\n\n(b) a specified carrier is the statutory infrastructure provider for\nthe designated service area for the purposes of this Part.\nNote:\nFor the format of the description of the area, see section 360LA.\nSubdivision D—Format of description of areas",
      "skos:definition": "The Minister may, by legislative instrument, declare that:\n\n(a) a specified area is a designated service area for the purposes\nof this Part; and\n\n(b) a specified carrier is the statutory infrastructure provider for\nthe designated service area for the purposes of this Part.\nNote:\nFor the format of the description of the area, see section 360LA.\nSubdivision D—Format of description of areas",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360l-norm"
        }
      ],
      "cml:integrityHash": "242264a1fb1e2e0aa9628567221e2f703a661987d7d1571d4e0010583ac5bbfc",
      "skos:note": "Minister may declare designated service area and statutory infrastructure provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360l",
      "@type": "cof:Section",
      "cof:title": "360L Designated service area and statutory infrastructure provider",
      "values:kind": "section",
      "cof:pageNumber": 125,
      "values:originalText": "The Minister may, by legislative instrument, declare that:\n\n(a) a specified area is a designated service area for the purposes\nof this Part; and\n\n(b) a specified carrier is the statutory infrastructure provider for\nthe designated service area for the purposes of this Part.\nNote:\nFor the format of the description of the area, see section 360LA.\nSubdivision D—Format of description of areas"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360l-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
