    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-41-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "41(3) Subsections 143(2) and (3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-41-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
