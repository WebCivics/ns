    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(1) July 2019 instead of the designated start date); and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-1-3-ss-1"
      },
