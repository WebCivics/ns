      ],
      "cml:integrityHash": "e13195691be23f157d85864d3c40f8d38c7dbd2f5643224bd80071f6ec6ebb31",
      "skos:note": "Definition of associated group for control purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-143a-ss-10",
