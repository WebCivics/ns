    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102zf-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "102ZF(2) Report about the number of premises supplied with",
      "cml:realizedBy": {
