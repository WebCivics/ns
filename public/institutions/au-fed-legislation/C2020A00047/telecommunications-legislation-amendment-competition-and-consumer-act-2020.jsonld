    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 At the end of section 155",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-55"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.92",
      "values:originalText": "Add:\n\n(4) Subsections (1) to (3) do not apply in determining the meaning of\nan expression used in:\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(a) section 142C; or\n\n(b) sections 151ZF, 151ZG and 151ZH, to the extent to which\nthey relate to a line to which section 142C applies; or\n\n(c) any other provision of this Part, so far as that provision\nrelates to:\n\n(i) section 142C; or\n\n(ii) section 151ZF, 151ZG or 151ZH, to the extent to which\nthat section relates to a line to which section 142C\napplies.",
      "skos:definition": "Add:\n\n(4) Subsections (1) to (3) do not apply in determining the meaning of\nan expression used in:\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(a) section 142C; or\n\n(b) sections 151ZF, 151ZG and 151ZH, to the extent to which\nthey relate to a line to which section 142C applies; or\n\n(c) any other provision of this Part, so far as that provision\nrelates to:\n\n(i) section 142C; or\n\n(ii) section 151ZF, 151ZG or 151ZH, to the extent to which\nthat section relates to a line to which section 142C\napplies.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-55-norm"
        }
      ],
      "cml:integrityHash": "7c754a5aaf673974b8c9fb3def0d1eb175d65e807891442623d2311206ca8cb4",
      "skos:note": "Subsections (1) to (3) do not apply in determining the meaning of an expression used in certain provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-55",
      "@type": "cof:Section",
      "cof:title": "55 At the end of section 155",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "Add:\n\n(4) Subsections (1) to (3) do not apply in determining the meaning of\nan expression used in:\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(a) section 142C; or\n\n(b) sections 151ZF, 151ZG and 151ZH, to the extent to which\nthey relate to a line to which section 142C applies; or\n\n(c) any other provision of this Part, so far as that provision\nrelates to:\n\n(i) section 142C; or\n\n(ii) section 151ZF, 151ZG or 151ZH, to the extent to which\nthat section relates to a line to which section 142C\napplies."
    },
