      "@type": "cml:Concept",
      "skos:prefLabel": "102W Copies of documents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102w"
      },
