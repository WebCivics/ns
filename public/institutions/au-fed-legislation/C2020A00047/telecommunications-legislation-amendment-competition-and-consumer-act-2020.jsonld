    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102e",
      "@type": "cml:Concept",
      "skos:prefLabel": "102E Recovery of charge",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.186",
      "values:originalText": "Charge, or an instalment of charge:\n\n(a) is a debt due to the ACMA on behalf of the Commonwealth;\nand\n\n(b) may be recovered by the ACMA, on behalf of the\nCommonwealth, in:\n\n(i) the Federal Court; or\n\n(ii) the Federal Circuit Court; or\n\n(iii) a court of a State or Territory that has jurisdiction in\nrelation to the matter.",
      "skos:definition": "Charge, or an instalment of charge:\n\n(a) is a debt due to the ACMA on behalf of the Commonwealth;\nand\n\n(b) may be recovered by the ACMA, on behalf of the\nCommonwealth, in:\n\n(i) the Federal Court; or\n\n(ii) the Federal Circuit Court; or\n\n(iii) a court of a State or Territory that has jurisdiction in\nrelation to the matter.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102e-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f367c7eb675ce2a6d5d4313fc786b923891b7cb60dcfba6b4a73141526861e5e",
      "skos:note": "Debt due to ACMA on behalf of Commonwealth may be recovered"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102e",
      "@type": "cof:Section",
      "cof:title": "102E Recovery of charge",
      "values:kind": "section",
      "cof:pageNumber": 186,
      "values:originalText": "Charge, or an instalment of charge:\n\n(a) is a debt due to the ACMA on behalf of the Commonwealth;\nand\n\n(b) may be recovered by the ACMA, on behalf of the\nCommonwealth, in:\n\n(i) the Federal Court; or\n\n(ii) the Federal Circuit Court; or\n\n(iii) a court of a State or Territory that has jurisdiction in\nrelation to the matter."
    },
