      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.6",
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.\n\n\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020",
      "skos:definition": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.\n\n\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-26-3-norm"
        }
      ],
      "cml:integrityHash": "db9256df2b084d1cfba6075698f460b336d1f1bd640a4e792e7b0b3b5f0c67db",
      "skos:note": "Note on table limitations and updates"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sec-26-3",
      "@type": "cof:Section",
      "cof:title": "26 May 2020",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Note:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.\n\n\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020"
    },
