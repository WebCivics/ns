    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-5-sec-98b-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "98B(1A) Mapping data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-5-sec-98b-ss-1a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
