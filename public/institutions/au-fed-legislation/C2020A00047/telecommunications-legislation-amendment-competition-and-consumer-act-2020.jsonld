    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360k-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "360K(4) Statutory infrastructure provider for a nominated service area",
      "cml:realizedBy": {
