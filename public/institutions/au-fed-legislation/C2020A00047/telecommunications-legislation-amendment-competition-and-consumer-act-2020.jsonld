    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360xa-ss-3",
      "@type": "cof:Section",
      "cof:title": "360XA(3) Periodic compliance reports",
      "values:kind": "subsection",
      "cof:pageNumber": 138,
