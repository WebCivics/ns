        }
      ],
      "cml:integrityHash": "c19af925b07adbfc1d0f26b906899138fb903b246c9d9ea97c4f9e36a0fe15c4",
      "skos:note": "Exemptions for wholesale customers with reasonable grounds to comply"
    },
    {
