      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.191",
      "values:originalText": "This Subdivision does not affect the law relating to legal\nprofessional privilege.\nSubdivision B—Access to information or documents held by an\neligible funding recipient",
      "skos:definition": "This Subdivision does not affect the law relating to legal\nprofessional privilege.\nSubdivision B—Access to information or documents held by an\neligible funding recipient",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102t-norm"
        }
      ],
      "cml:integrityHash": "1e36f3a8c4982102347f9de9c9e0074f5bd7ae1c9487c9ebd092fa7026af7ce8",
      "skos:note": "Law relating to legal professional privilege not affected"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102t",
      "@type": "cof:Section",
      "cof:title": "102T Law relating to legal professional privilege not affected",
      "values:kind": "section",
      "cof:pageNumber": 191,
      "values:originalText": "This Subdivision does not affect the law relating to legal\nprofessional privilege.\nSubdivision B—Access to information or documents held by an\neligible funding recipient"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102t-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102t"
      },
      "values:deonticStatus": {
