      "skos:note": "Carrier or carriage service provider entitled to reasonable compensation for complying with a requirement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102q",
      "@type": "cof:Section",
      "cof:title": "102Q Copying documents—compensation",
      "values:kind": "section",
      "cof:pageNumber": 190,
      "values:originalText": "A carrier or carriage service provider is entitled to be paid by the\nACMA reasonable compensation for complying with a\nrequirement covered by paragraph 102P(2)(c)."
    },
