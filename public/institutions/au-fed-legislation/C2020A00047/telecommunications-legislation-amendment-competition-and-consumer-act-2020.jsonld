    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-94",
      "@type": "cml:Concept",
      "skos:prefLabel": "94 Potentially chargeable premises",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-94"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.166",
      "values:originalText": "If:\n\n(a) a person is a carrier; and\n\n(b) during a period comprising the whole or a part of a month in\nan eligible financial year, either:\n\n(i) the person owns a local access line, but no nominated\ncarrier declaration is in force in relation to the line; or\n\n(ii) under a nominated carrier declaration, the person is the\nnominated carrier in relation to a local access line; and\n\n(c) the line is not an exempt line in relation to the person for the\nmonth; and\n\n(d) during the whole or a part of the period, a carriage service\nprovider (who may be the person) supplies a designated\nbroadband service to particular premises in Australia using\nthe line;\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\nthe premises are potentially chargeable premises in relation to the\nperson for the month.\nNote:\nThe line does not need to be physically connected to the premises.\nThis is because using has an extended meaning—see subsection 5(1)\nof this Act and section 24 of the Telecommunications Act 1997 (when\nread together with section 18A of the Acts Interpretation Act 1901).",
      "skos:definition": "If:\n\n(a) a person is a carrier; and\n\n(b) during a period comprising the whole or a part of a month in\nan eligible financial year, either:\n\n(i) the person owns a local access line, but no nominated\ncarrier declaration is in force in relation to the line; or\n\n(ii) under a nominated carrier declaration, the person is the\nnominated carrier in relation to a local access line; and\n\n(c) the line is not an exempt line in relation to the person for the\nmonth; and\n\n(d) during the whole or a part of the period, a carriage service\nprovider (who may be the person) supplies a designated\nbroadband service to particular premises in Australia using\nthe line;\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\nthe premises are potentially chargeable premises in relation to the\nperson for the month.\nNote:\nThe line does not need to be physically connected to the premises.\nThis is because using has an extended meaning—see subsection 5(1)\nof this Act and section 24 of the Telecommunications Act 1997 (when\nread together with section 18A of the Acts Interpretation Act 1901).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-94-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-94-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-94-logic-alleninterval-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-94-logic-ltl-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-94-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "256cf331da01e18bf5f225446b0306e34613456ff193a0c7034f5ec8d6bb1268",
      "skos:note": "A person must provide funding for fixed wireless broadband and satellite broadband if they supply a designated service to potentially chargeable premises."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-94",
      "@type": "cof:Section",
      "cof:title": "94 Potentially chargeable premises",
      "values:kind": "section",
      "cof:pageNumber": 166,
      "values:originalText": "If:\n\n(a) a person is a carrier; and\n\n(b) during a period comprising the whole or a part of a month in\nan eligible financial year, either:\n\n(i) the person owns a local access line, but no nominated\ncarrier declaration is in force in relation to the line; or\n\n(ii) under a nominated carrier declaration, the person is the\nnominated carrier in relation to a local access line; and\n\n(c) the line is not an exempt line in relation to the person for the\nmonth; and\n\n(d) during the whole or a part of the period, a carriage service\nprovider (who may be the person) supplies a designated\nbroadband service to particular premises in Australia using\nthe line;\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\nthe premises are potentially chargeable premises in relation to the\nperson for the month.\nNote:\nThe line does not need to be physically connected to the premises.\nThis is because using has an extended meaning—see subsection 5(1)\nof this Act and section 24 of the Telecommunications Act 1997 (when\nread together with section 18A of the Acts Interpretation Act 1901)."
    },
    {
