    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Section 5",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.16",
      "values:originalText": "Omit “residential customers.”, substitute:\n\nresidential customers, and:\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(a) the network came into existence before the designated\ncommencement date; and\n\n(b) the network has not been altered, upgraded or extended on or\nafter the designated commencement date; and\n\n(c) no functional separation undertaking given by the carrier is in\nforce.",
      "skos:definition": "Omit “residential customers.”, substitute:\n\nresidential customers, and:\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(a) the network came into existence before the designated\ncommencement date; and\n\n(b) the network has not been altered, upgraded or extended on or\nafter the designated commencement date; and\n\n(c) no functional separation undertaking given by the carrier is in\nforce.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-6-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "280240b60425430ed6c80b18a19eb38abf5df30cbfe8b9fa3c6c0346322c53f6",
      "skos:note": "Omit 'residential customers.' and substitute with 'residential customers, and: Local access lines'"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Section 5",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Omit “residential customers.”, substitute:\n\nresidential customers, and:\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\n(a) the network came into existence before the designated\ncommencement date; and\n\n(b) the network has not been altered, upgraded or extended on or\nafter the designated commencement date; and\n\n(c) no functional separation undertaking given by the carrier is in\nforce."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-6-norm",
      "@type": "values:Prohibition",
