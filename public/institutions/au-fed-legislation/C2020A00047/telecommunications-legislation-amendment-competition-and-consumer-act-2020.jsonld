    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102ze",
      "@type": "cml:Concept",
      "skos:prefLabel": "102ZE ACMA may give certain information to the ACCC",
      "cml:realizedBy": {
