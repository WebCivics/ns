    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151s-ss-4",
      "@type": "cof:Section",
      "cof:title": "151S(4) Withdrawal of variation that is under consideration",
      "values:kind": "subsection",
      "cof:pageNumber": 65,
      "values:originalText": "(4) If:\n\n(a) the person or persons withdraw the variation; and\n\n(b) the person or persons have paid a fee in relation to the\nvariation;\nthe ACCC may, on behalf of the Commonwealth, refund the whole\nor a part of the fee."
    },
