    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-87",
      "@type": "cml:Concept",
      "skos:prefLabel": "87 Secretary to comply with rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-87"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.162",
      "values:originalText": "(1) The Minister may, by legislative instrument, make rules to be\ncomplied with by the Secretary in relation to the performance of\nthe Secretary’s functions, or the exercise of the Secretary’s powers,\nunder this Division.\n\n(2) The Secretary must comply with any rules in force under\nsubsection (1).\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020",
      "skos:definition": "(1) The Minister may, by legislative instrument, make rules to be\ncomplied with by the Secretary in relation to the performance of\nthe Secretary’s functions, or the exercise of the Secretary’s powers,\nunder this Division.\n\n(2) The Secretary must comply with any rules in force under\nsubsection (1).\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-87-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-87-ss-2"
        }
      ],
      "cml:integrityHash": "246fe6003a79ef9eed4d61124d961a9fffd630ac478d9a97034ccd52a6d7a639"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-87",
      "@type": "cof:Section",
      "cof:title": "87 Secretary to comply with rules",
      "values:kind": "section",
      "cof:pageNumber": 162,
      "values:originalText": "(1) The Minister may, by legislative instrument, make rules to be\ncomplied with by the Secretary in relation to the performance of\nthe Secretary’s functions, or the exercise of the Secretary’s powers,\nunder this Division.\n\n(2) The Secretary must comply with any rules in force under\nsubsection (1).\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020"
    },
