      },
      "cml:premiseText": "The ACCC has given a notice under section 151K in relation to the undertaking.",
      "cml:conclusionText": "Do not disregard a day in the period specified in the notice when calculating the 3-month period."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151f-ss-6-logic-deontic-6",
