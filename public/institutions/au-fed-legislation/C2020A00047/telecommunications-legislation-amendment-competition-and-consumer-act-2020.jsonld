      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) apart from this subsection, the premises are not potentially concessional premises in relation to the person for the month;",
      "cml:conclusionText": "the person must know that the premises are not potentially concessional."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Reasonable diligence requirement",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
