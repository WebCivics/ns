    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zf-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "151ZF(4) Eligible services to be supplied on a non-discriminatory basis",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zf-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.80",
      "values:originalText": "(4) If:\n\n(a) a person supplies, or proposes to supply, an eligible service\nusing a local access line:\n\n(i) to itself; and\n\n(ii) to its wholesale customers or prospective wholesale\ncustomers; and\n\n(b) any of the following conditions is satisfied:\n\n(i) section 142C applies to the line;\n\n(ii) section 143 applies to the line;\n\n(iii) neither section 142C nor section 143 applies to the line,\nand there is in force a functional separation undertaking\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\nthat relates to local access line services supplied, or\nproposed to be supplied, using the line;\nthe person must not, on or after the designated commencement\ndate, discriminate in favour of itself in relation to the supply of the\neligible service.\nAncillary contraventions",
      "skos:definition": "(4) If:\n\n(a) a person supplies, or proposes to supply, an eligible service\nusing a local access line:\n\n(i) to itself; and\n\n(ii) to its wholesale customers or prospective wholesale\ncustomers; and\n\n(b) any of the following conditions is satisfied:\n\n(i) section 142C applies to the line;\n\n(ii) section 143 applies to the line;\n\n(iii) neither section 142C nor section 143 applies to the line,\nand there is in force a functional separation undertaking\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\nthat relates to local access line services supplied, or\nproposed to be supplied, using the line;\nthe person must not, on or after the designated commencement\ndate, discriminate in favour of itself in relation to the supply of the\neligible service.\nAncillary contraventions",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zf"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zf-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zf-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "30514ca09ec034924190ec25755b7a8a5147de8fea4567783e26943d4b5d1b52",
      "skos:note": "Discrimination in favor of itself is prohibited on or after the designated commencement date."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zf-ss-4",
      "@type": "cof:Section",
      "cof:title": "151ZF(4) Eligible services to be supplied on a non-discriminatory basis",
      "values:kind": "subsection",
      "cof:pageNumber": 80,
      "values:originalText": "(4) If:\n\n(a) a person supplies, or proposes to supply, an eligible service\nusing a local access line:\n\n(i) to itself; and\n\n(ii) to its wholesale customers or prospective wholesale\ncustomers; and\n\n(b) any of the following conditions is satisfied:\n\n(i) section 142C applies to the line;\n\n(ii) section 143 applies to the line;\n\n(iii) neither section 142C nor section 143 applies to the line,\nand there is in force a functional separation undertaking\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\nthat relates to local access line services supplied, or\nproposed to be supplied, using the line;\nthe person must not, on or after the designated commencement\ndate, discriminate in favour of itself in relation to the supply of the\neligible service.\nAncillary contraventions"
    },
