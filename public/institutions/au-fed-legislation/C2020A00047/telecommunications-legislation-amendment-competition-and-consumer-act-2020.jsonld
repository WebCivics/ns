      ],
      "cml:integrityHash": "07430eddd150e84a5fc90c44a117ab28d250fa73842939b1bce4d796b7656d6a",
      "skos:note": "Clarifies the use of the word 'Regional' in certain contexts to avoid doubt."
    },
