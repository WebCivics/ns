    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-80a",
      "@type": "cml:Concept",
      "skos:prefLabel": "80A After subsection 564(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-80a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.103",
      "values:originalText": "Insert:\nInjunctions relating to contraventions of section 151ZI\n\n(3AA) If a person has engaged, is engaging or is proposing to engage, in\nany conduct in contravention of section 151ZI, the Federal Court\nmay, on the application of a carrier or a carriage service provider,\ngrant an injunction:\n\n(a) restraining the person from engaging in the conduct; and\n\n(b) if, in the court’s opinion, it is desirable to do so—requiring\nthe person to do something.\n\n(3AB) Subsection (3AA) does not, by implication, limit subsection (1).",
      "skos:definition": "Insert:\nInjunctions relating to contraventions of section 151ZI\n\n(3AA) If a person has engaged, is engaging or is proposing to engage, in\nany conduct in contravention of section 151ZI, the Federal Court\nmay, on the application of a carrier or a carriage service provider,\ngrant an injunction:\n\n(a) restraining the person from engaging in the conduct; and\n\n(b) if, in the court’s opinion, it is desirable to do so—requiring\nthe person to do something.\n\n(3AB) Subsection (3AA) does not, by implication, limit subsection (1).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-80a-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-80a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d4e991f3bb53c4b6efd19e9df5a1a888fbb593a83c4532e78af56f5711995553",
      "skos:note": "Granting injunctions for contraventions of section 151ZI"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-80a",
      "@type": "cof:Section",
      "cof:title": "80A After subsection 564(3)",
      "values:kind": "section",
      "cof:pageNumber": 103,
      "values:originalText": "Insert:\nInjunctions relating to contraventions of section 151ZI\n\n(3AA) If a person has engaged, is engaging or is proposing to engage, in\nany conduct in contravention of section 151ZI, the Federal Court\nmay, on the application of a carrier or a carriage service provider,\ngrant an injunction:\n\n(a) restraining the person from engaging in the conduct; and\n\n(b) if, in the court’s opinion, it is desirable to do so—requiring\nthe person to do something.\n\n(3AB) Subsection (3AA) does not, by implication, limit subsection (1)."
    },
