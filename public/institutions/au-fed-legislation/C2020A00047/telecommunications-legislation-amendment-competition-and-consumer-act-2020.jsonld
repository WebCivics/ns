      },
      "cml:premiseText": "(3) A person must not:\n\n(a) aid, abet, counsel or procure a contravention of\nsubsection (1), (2) or (2A); or"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zh-ss-3-logic-deontic-2",
