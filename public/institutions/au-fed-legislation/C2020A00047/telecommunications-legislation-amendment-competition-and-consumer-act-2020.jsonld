    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "1(3A) July 2019 instead of the designated start date); and",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-1-3-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.199",
      "values:originalText": "(3A) If:\n\n(a) notice of a motion to disallow the determination is given in a\nHouse of the Parliament within 15 sitting days of that House\nafter the copy of the determination was tabled in that House\nunder section 38 of the Legislation Act 2003; and\n\n(b) at the end of 15 sitting days of that House after the giving of\nthat notice of motion:\n\n(i) the notice has not been withdrawn and the motion has\nnot been called on; or\n\n(ii) the motion has been called on, moved and (where\nrelevant) seconded and has not been withdrawn or\notherwise disposed of;\nthe determination is then taken to have been disallowed, and\nsubsection (3) does not apply to the determination.",
      "skos:definition": "(3A) If:\n\n(a) notice of a motion to disallow the determination is given in a\nHouse of the Parliament within 15 sitting days of that House\nafter the copy of the determination was tabled in that House\nunder section 38 of the Legislation Act 2003; and\n\n(b) at the end of 15 sitting days of that House after the giving of\nthat notice of motion:\n\n(i) the notice has not been withdrawn and the motion has\nnot been called on; or\n\n(ii) the motion has been called on, moved and (where\nrelevant) seconded and has not been withdrawn or\notherwise disposed of;\nthe determination is then taken to have been disallowed, and\nsubsection (3) does not apply to the determination.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-3a-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-3a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5e9a794e466482776adcb3863529e760b1581730147d66cd0cbae2a6070477ca",
      "skos:note": "Disallow determination if motion is not withdrawn or disposed of within 15 sitting days."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-1-3-ss-3a",
      "@type": "cof:Section",
      "cof:title": "1(3A) July 2019 instead of the designated start date); and",
      "values:kind": "subsection",
      "cof:pageNumber": 199,
      "values:originalText": "(3A) If:\n\n(a) notice of a motion to disallow the determination is given in a\nHouse of the Parliament within 15 sitting days of that House\nafter the copy of the determination was tabled in that House\nunder section 38 of the Legislation Act 2003; and\n\n(b) at the end of 15 sitting days of that House after the giving of\nthat notice of motion:\n\n(i) the notice has not been withdrawn and the motion has\nnot been called on; or\n\n(ii) the motion has been called on, moved and (where\nrelevant) seconded and has not been withdrawn or\notherwise disposed of;\nthe determination is then taken to have been disallowed, and\nsubsection (3) does not apply to the determination."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3-ss-3a-norm",
      "@type": "values:Prohibition",
