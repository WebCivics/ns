    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142bc",
      "@type": "cml:Concept",
      "skos:prefLabel": "142BC Unsatisfactory compliance record",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142bc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.24",
      "values:originalText": "For the purposes of this Part, the question of whether a person has\nan unsatisfactory compliance record in relation to functional\nseparation is to be determined having regard only to:\n\n(a) any breaches by the person of functional separation\nundertakings given by the person, so long as the breaches\noccurred when the undertakings were in force; and\n\n(b) any contraventions by the person of section 143B, 151ZA,\n151ZB, 151ZF, 151ZG, 151ZH or 151ZI.",
      "skos:definition": "For the purposes of this Part, the question of whether a person has\nan unsatisfactory compliance record in relation to functional\nseparation is to be determined having regard only to:\n\n(a) any breaches by the person of functional separation\nundertakings given by the person, so long as the breaches\noccurred when the undertakings were in force; and\n\n(b) any contraventions by the person of section 143B, 151ZA,\n151ZB, 151ZF, 151ZG, 151ZH or 151ZI.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142bc-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142bc-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142bc-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "d0d333266f57569260547f42ac8ff1983ea9a90428aca3ac4bd8f606ea7c6598",
      "skos:note": "Determine unsatisfactory compliance record based on breaches and contraventions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142bc",
      "@type": "cof:Section",
      "cof:title": "142BC Unsatisfactory compliance record",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "For the purposes of this Part, the question of whether a person has\nan unsatisfactory compliance record in relation to functional\nseparation is to be determined having regard only to:\n\n(a) any breaches by the person of functional separation\nundertakings given by the person, so long as the breaches\noccurred when the undertakings were in force; and\n\n(b) any contraventions by the person of section 143B, 151ZA,\n151ZB, 151ZF, 151ZG, 151ZH or 151ZI."
    },
