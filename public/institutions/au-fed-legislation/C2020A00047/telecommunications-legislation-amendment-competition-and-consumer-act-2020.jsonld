    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102zd",
      "@type": "cml:Concept",
      "skos:prefLabel": "102ZD Publication of charge payments and charge offsets",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102zd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.197",
      "values:originalText": "The ACMA must publish on its website a statement, for each\neligible financial year, that sets out:\n\n(a) the total amount of charge paid by carriers in relation to the\neligible financial year; and\n\n(b) the total of the amounts specified in charge offset certificates\nissued to carriers in relation to the eligible financial year.",
      "skos:definition": "The ACMA must publish on its website a statement, for each\neligible financial year, that sets out:\n\n(a) the total amount of charge paid by carriers in relation to the\neligible financial year; and\n\n(b) the total of the amounts specified in charge offset certificates\nissued to carriers in relation to the eligible financial year.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102zd-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102zd-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0de4b086b36cfdb69c8da9265ca97299b3f0d148b5030a6bb4fed38c02dfbc58",
      "skos:note": "Publish charge payments and charge offsets annually",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102zd",
      "@type": "cof:Section",
      "cof:title": "102ZD Publication of charge payments and charge offsets",
      "values:kind": "section",
      "cof:pageNumber": 197,
      "values:originalText": "The ACMA must publish on its website a statement, for each\neligible financial year, that sets out:\n\n(a) the total amount of charge paid by carriers in relation to the\neligible financial year; and\n\n(b) the total of the amounts specified in charge offset certificates\nissued to carriers in relation to the eligible financial year."
    },
