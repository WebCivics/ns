        }
      ],
      "cml:integrityHash": "e6f56d624e1bda85b1c8573942e6a1cd3cd8794fad2bb75f7ce25ff6f1a86ddc",
      "skos:note": "ACCC must give written notice to person or persons if undertaking is rejected.",
