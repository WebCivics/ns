      "cml:integrityHash": "f6f88f33a3a323df185ddcd5ec97c4f41a181021a92d66af71b7e7958e4f181c",
      "skos:note": "Publish notice and consider submissions before making a decision on the undertaking.",
      "dc:description": "Submissions to the ACCC within the specified time limit"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151g-ss-2",
      "@type": "cof:Section",
      "cof:title": "151G(2) Consultation—acceptance or rejection of undertaking",
      "values:kind": "subsection",
      "cof:pageNumber": 57,
      "values:originalText": "(2) Before making a decision to accept or reject the undertaking, the\nACCC must:\n\n(a) publish on the ACCC’s website a notice:\n\n(i) setting out the undertaking; and\n\n(ii) inviting persons to make submissions to the ACCC\nabout the undertaking within the time limit specified in\nthe notice; and\n\n(b) consider any submissions received within the time limit\nspecified in the notice."
    },
