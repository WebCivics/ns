    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102b",
      "@type": "cml:Concept",
      "skos:prefLabel": "102B Variation of assessments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.184",
      "values:originalText": "(1) The ACMA may vary an assessment made under this Division by\nmaking such alterations and additions as it thinks necessary, even\nif charge has been paid in respect of an assessment.\n\n(2) Unless the contrary intention appears, a varied assessment is taken,\nfor the purposes of this Division, to be an assessment under\nsection 102.",
      "skos:definition": "(1) The ACMA may vary an assessment made under this Division by\nmaking such alterations and additions as it thinks necessary, even\nif charge has been paid in respect of an assessment.\n\n(2) Unless the contrary intention appears, a varied assessment is taken,\nfor the purposes of this Division, to be an assessment under\nsection 102.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102b-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102b-ss-2"
        }
      ],
      "cml:integrityHash": "9767300064c0139f1c5244fcf5be8d99ff595f331013913b680fa798c49497c9"
    },
    {
