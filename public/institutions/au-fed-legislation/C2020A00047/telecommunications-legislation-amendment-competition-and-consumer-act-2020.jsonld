      "skos:prefLabel": "142BA Promotion of the long-term interests of end-users of carriage",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142ba"
