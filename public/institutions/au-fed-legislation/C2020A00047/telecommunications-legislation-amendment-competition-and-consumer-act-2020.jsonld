    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 After paragraph 1(ja) of Schedule 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.146",
      "values:originalText": "Insert:\n\n(jaa) a decision of a kind referred to in subsection 102N(3) (which\ndeals with remission of late payment penalty) of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999;\n\n(jab) a decision to make a notifiable instrument under\nsubsection 102Z(2) or 102ZA(2);\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "Insert:\n\n(jaa) a decision of a kind referred to in subsection 102N(3) (which\ndeals with remission of late payment penalty) of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999;\n\n(jab) a decision to make a notifiable instrument under\nsubsection 102Z(2) or 102ZA(2);\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-7-norm"
        }
      ],
      "cml:integrityHash": "6004cc1f97691773c9da017ca70f9e381563ea64d97c606ef439299a40877e76",
      "skos:note": "Inserts decisions and notifiable instruments into the Telecommunications (Consumer Protection and Service Standards) Act 1999"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 After paragraph 1(ja) of Schedule 4",
      "values:kind": "section",
      "cof:pageNumber": 146,
      "values:originalText": "Insert:\n\n(jaa) a decision of a kind referred to in subsection 102N(3) (which\ndeals with remission of late payment penalty) of the\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999;\n\n(jab) a decision to make a notifiable instrument under\nsubsection 102Z(2) or 102ZA(2);\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999"
    },
