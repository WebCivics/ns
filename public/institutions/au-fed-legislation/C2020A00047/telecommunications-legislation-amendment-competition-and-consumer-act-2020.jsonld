    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360c",
      "@type": "cml:Concept",
      "skos:prefLabel": "360C Definition of service area",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.113",
      "values:originalText": "For the purposes of this Part, service area means:\n\n(a) before the designated day:\n\n(i) an interim NBN service area; or\n\n(ii) a nominated service area; or\n\n(iii) a designated service area; or\n\n(b) after the start of the designated day:\n\n(i) the general service area; or\n\nSchedule 3  Statutory infrastructure providers etc.",
      "skos:definition": "For the purposes of this Part, service area means:\n\n(a) before the designated day:\n\n(i) an interim NBN service area; or\n\n(ii) a nominated service area; or\n\n(iii) a designated service area; or\n\n(b) after the start of the designated day:\n\n(i) the general service area; or\n\nSchedule 3  Statutory infrastructure providers etc.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360c-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360c-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "065e87304c5ca6adea5fa5b68ceab9e045db50372ac558ffb352e32817e5cbc9",
      "skos:note": "Defines service area for the purposes of this Part."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360c",
      "@type": "cof:Section",
      "cof:title": "360C Definition of service area",
      "values:kind": "section",
      "cof:pageNumber": 113,
      "values:originalText": "For the purposes of this Part, service area means:\n\n(a) before the designated day:\n\n(i) an interim NBN service area; or\n\n(ii) a nominated service area; or\n\n(iii) a designated service area; or\n\n(b) after the start of the designated day:\n\n(i) the general service area; or\n\nSchedule 3  Statutory infrastructure providers etc."
    },
