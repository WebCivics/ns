        }
      ],
      "cml:integrityHash": "2a3b1204175c7aa076e0c42ddbc75bd7425f379b88eb4ecb21c5e79463e0e5d0",
      "skos:note": "References to the Competition and Consumer Act 2010 have effect in relation to a review."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zm-ss-7",
      "@type": "cof:Section",
      "cof:title": "151ZM(7) Functions and powers of the Australian Competition",
      "values:kind": "subsection",
      "cof:pageNumber": 91,
      "values:originalText": "(7) Paragraphs 103(1)(a) and (b) and 108(b) of the Competition and\nConsumer Act 2010 have effect, in relation to a review, as if a\nreference in those paragraphs to that Act included a reference to\nthis Part.\nNote:\nDivision 2 of Part IX of the Competition and Consumer Act 2010\napplies to proceedings before the Australian Competition Tribunal."
    },
