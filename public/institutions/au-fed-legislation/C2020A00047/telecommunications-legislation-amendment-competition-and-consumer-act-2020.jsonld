    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151v-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "151V(2) Criteria for accepting variation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151v-ss-2"
