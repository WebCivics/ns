    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After section 152BCCA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-1"
      },
