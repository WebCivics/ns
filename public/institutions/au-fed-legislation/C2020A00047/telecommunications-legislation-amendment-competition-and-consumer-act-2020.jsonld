      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A person must not:\n\n(b) induce, whether by threats or promises or otherwise, a\ncontravention of subsection (1), (2) or (2A); or"
    },
    {
