      "cml:premiseText": "The ACCC has given a notice under section 151K in relation to the undertaking.",
      "cml:conclusionText": "Disregard a day in the period beginning on the day on which the notice was given and ending at the end of the time limit specified by the ACCC when it published the varied undertaking under section 151G."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151f-ss-6-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Obligation to disregard a day in the period beginning on the day on which the ACCC published the undertaking under section 151G and ending at the end of the time limit specified by the ACCC when it published the undertaking under section 151G.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
