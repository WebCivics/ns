    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-1-sec-349a",
      "@type": "cml:Concept",
      "skos:prefLabel": "349A Local access line",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-1-sec-349a"
      },
