      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Line's existence overlaps with designated commencement date if used for residential customers.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) on or after the designated commencement date, following (i) the construction or alteration of premises; or (ii) changes to the activities carried out at premises;",
      "cml:conclusionText": "the line's existence overlaps with the designated commencement date if used for residential customers."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-156a-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurrently",
      "cml:logicSummary": "Line is recurrently used for residential customers after designated commencement date.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) on or after the designated commencement date, following (i) the construction or alteration of premises; or (ii) changes to the activities carried out at premises;",
      "cml:conclusionText": "the line is recurrently used for residential customers after the designated commencement date."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-156a-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Line diffuses into residential market if used for residential customers.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) before the designated commencement date, the line was used wholly or principally to supply a superfast carriage service to non-residential customers in Australia;",
      "cml:conclusionText": "the line diffuses into the residential market if used for residential customers."
    },
    {
