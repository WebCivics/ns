        }
      ],
      "cml:integrityHash": "fbf55729832129dad05d2b04b60fba247cda2bcea168bc3e8f3c1b2b9e6f6ed5",
      "skos:note": "Joint functional separation undertaking"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151c-ss-9",
