    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zj-ss-1",
      "@type": "cof:Section",
      "cof:title": "151ZJ(1) Self-incrimination",
      "values:kind": "subsection",
      "cof:pageNumber": 89,
      "values:originalText": "(1) A person is not excused from:\n\n(a) giving a report in compliance with a provision of a functional\nseparation undertaking covered by subsection 151A(10) or\n151C(10) or (11); or\n\n(b) giving a report or information under section 151ZA:\non the ground that the report or information might tend to\nincriminate the person or expose the person to a penalty."
    },
