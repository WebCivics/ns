      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person must not:\n\n(b) induce, whether by threats or promises or otherwise, a\ncontravention of subsection (2);",
      "cml:conclusionText": "A person must not induce, whether by threats or promises or otherwise, a contravention of subsection (2);"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-41-ss-5-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
