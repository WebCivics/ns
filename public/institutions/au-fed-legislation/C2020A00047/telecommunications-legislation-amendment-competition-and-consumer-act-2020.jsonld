    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 Credits to the Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-90"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.163",
      "values:originalText": "There must be credited to the Regional Broadband Scheme Special\nAccount:\n\n(a) an amount equal to an amount paid to the Commonwealth by\nway of:\n\n(i) charge; or\n\n(ii) an instalment of charge; and\n\n(b) an amount equal to an amount paid to the Commonwealth\nunder a section 80 contract; and\n\n(c) an amount equal to an amount paid to the Commonwealth by\nway of damages or compensation for a breach of a section 80\ncontract; and\n\n(d) an amount equal to an amount paid to the Commonwealth by\nway of the repayment of the whole or a part of a section 80\ngrant.\nNote:\nAn Appropriation Act may contain a provision to the effect that, if any\nof the purposes of a special account is a purpose that is covered by an\nitem in the Appropriation Act (whether or not the item expressly refers\nto the special account), then amounts may be debited against the\nappropriation for that item and credited to that special account.",
      "skos:definition": "There must be credited to the Regional Broadband Scheme Special\nAccount:\n\n(a) an amount equal to an amount paid to the Commonwealth by\nway of:\n\n(i) charge; or\n\n(ii) an instalment of charge; and\n\n(b) an amount equal to an amount paid to the Commonwealth\nunder a section 80 contract; and\n\n(c) an amount equal to an amount paid to the Commonwealth by\nway of damages or compensation for a breach of a section 80\ncontract; and\n\n(d) an amount equal to an amount paid to the Commonwealth by\nway of the repayment of the whole or a part of a section 80\ngrant.\nNote:\nAn Appropriation Act may contain a provision to the effect that, if any\nof the purposes of a special account is a purpose that is covered by an\nitem in the Appropriation Act (whether or not the item expressly refers\nto the special account), then amounts may be debited against the\nappropriation for that item and credited to that special account.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-90-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-90-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2dd522a13e0b1a0cd9d6537958c189c22cf5cf7e583c6f995f316679e3713e7d",
      "skos:note": "Credit amounts to Regional Broadband Scheme Special Account",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-90",
      "@type": "cof:Section",
      "cof:title": "90 Credits to the Account",
      "values:kind": "section",
      "cof:pageNumber": 163,
      "values:originalText": "There must be credited to the Regional Broadband Scheme Special\nAccount:\n\n(a) an amount equal to an amount paid to the Commonwealth by\nway of:\n\n(i) charge; or\n\n(ii) an instalment of charge; and\n\n(b) an amount equal to an amount paid to the Commonwealth\nunder a section 80 contract; and\n\n(c) an amount equal to an amount paid to the Commonwealth by\nway of damages or compensation for a breach of a section 80\ncontract; and\n\n(d) an amount equal to an amount paid to the Commonwealth by\nway of the repayment of the whole or a part of a section 80\ngrant.\nNote:\nAn Appropriation Act may contain a provision to the effect that, if any\nof the purposes of a special account is a purpose that is covered by an\nitem in the Appropriation Act (whether or not the item expressly refers\nto the special account), then amounts may be debited against the\nappropriation for that item and credited to that special account."
    },
