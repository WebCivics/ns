    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-98-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "98(3) Charge offset certificate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-98-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.175",
      "values:originalText": "(3) If:\n\n(a) an application under subsection (1) has been made for the\nissue to a person of a charge offset certificate for the charge\nfinancial year; and\n\n(b) the person is the holder of a nominal funding entitlement\ncertificate in relation to the next financial year; and\n\n(c) rules made under subsection (9) for the purposes of this\nparagraph are in force; and\n\n(d) the conditions set out in those rules are satisfied;\nthe Secretary must:\n\n(e) issue a certificate stating that the person is entitled to a\ncharge offset for the charge financial year equal to the\namount specified in the certificate; and\n\n(f) do so by the end of 31 March next following the charge\nfinancial year.",
      "skos:definition": "(3) If:\n\n(a) an application under subsection (1) has been made for the\nissue to a person of a charge offset certificate for the charge\nfinancial year; and\n\n(b) the person is the holder of a nominal funding entitlement\ncertificate in relation to the next financial year; and\n\n(c) rules made under subsection (9) for the purposes of this\nparagraph are in force; and\n\n(d) the conditions set out in those rules are satisfied;\nthe Secretary must:\n\n(e) issue a certificate stating that the person is entitled to a\ncharge offset for the charge financial year equal to the\namount specified in the certificate; and\n\n(f) do so by the end of 31 March next following the charge\nfinancial year.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-98"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-98-ss-3-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-98-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e28b435c7810738f35151ae3ded3be1adbcd0aebf186267e50aa5eb7831ef249",
      "skos:note": "Secretary must issue a charge offset certificate if conditions are met.",
      "dc:description": "charge offset certificate stating the amount of charge offset"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-98-ss-3",
      "@type": "cof:Section",
      "cof:title": "98(3) Charge offset certificate",
      "values:kind": "subsection",
      "cof:pageNumber": 175,
      "values:originalText": "(3) If:\n\n(a) an application under subsection (1) has been made for the\nissue to a person of a charge offset certificate for the charge\nfinancial year; and\n\n(b) the person is the holder of a nominal funding entitlement\ncertificate in relation to the next financial year; and\n\n(c) rules made under subsection (9) for the purposes of this\nparagraph are in force; and\n\n(d) the conditions set out in those rules are satisfied;\nthe Secretary must:\n\n(e) issue a certificate stating that the person is entitled to a\ncharge offset for the charge financial year equal to the\namount specified in the certificate; and\n\n(f) do so by the end of 31 March next following the charge\nfinancial year."
    },
