      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person must not:\n\n(c) be in any way, directly or indirectly, knowingly concerned in,\nor party to, a contravention of subsection (2);",
      "cml:conclusionText": "A person must not be in any way, directly or indirectly, knowingly concerned in, nor party to, a contravention of subsection (2);"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-41-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
