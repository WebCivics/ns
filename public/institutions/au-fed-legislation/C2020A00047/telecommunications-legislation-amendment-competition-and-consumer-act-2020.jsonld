    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151f-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "151F(4) ACCC to accept or reject functional separation undertaking",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151f-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.55",
      "values:originalText": "(4) If the ACCC rejects the undertaking, the ACCC must give the\nperson or persons a written notice:\n\n(a) stating that the undertaking has been rejected; and\n\n(b) setting out the reasons for the rejection.\nACCC to make decision within 3 months",
      "skos:definition": "(4) If the ACCC rejects the undertaking, the ACCC must give the\nperson or persons a written notice:\n\n(a) stating that the undertaking has been rejected; and\n\n(b) setting out the reasons for the rejection.\nACCC to make decision within 3 months",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151f"
      },
