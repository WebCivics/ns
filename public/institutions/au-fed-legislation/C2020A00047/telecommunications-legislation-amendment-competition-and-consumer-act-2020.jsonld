      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "particular premises are reported as recently connected greenfield premises in relation to the person for a month; and",
      "cml:conclusionText": "the premises are taken, for all purposes, to be recently connected greenfield premises in relation to the person for the month."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must report premises if not reported before",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(11) If:\n\n(a) particular premises are reported as recently connected\ngreenfield premises in relation to the person for a month; and\n\n(b) apart from this subsection, the premises are not recently\nconnected greenfield premises in relation to the person for\nthe month; and",
      "cml:conclusionText": "the premises are taken, for all purposes, to be recently connected greenfield premises in relation to the person for the month."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-epistemic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Epistemic"
      },
      "cml:operator": "COULD NOT",
      "cml:logicSummary": "Could not have ascertained that premises are not recently connected greenfield premises",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) could not, with reasonable diligence, have ascertained;\nthat the premises are not recently connected greenfield\npremises in relation to the person for the month;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "RECENTLY",
      "cml:logicSummary": "Recently connected premises must be reported",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(11) If:\n\n(a) particular premises are reported as recently connected\ngreenfield premises in relation to the person for a month; and"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must report premises if did not know or could not have ascertained that premises are not recently connected greenfield premises",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) could not, with reasonable diligence, have ascertained;\nthat the premises are not recently connected greenfield\npremises in relation to the person for the month;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-101",
      "@type": "cml:Concept",
      "skos:prefLabel": "101 Offence of failing to lodge report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-101"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
