      "cml:integrityHash": "51d28b7885586690cb2f47d3bf572e6162c71e9ae8d3231dccae1def9edbe5e9",
      "skos:note": "Revocation of functional separation undertaking"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151w-ss-9",
      "@type": "cof:Section",
      "cof:title": "151W(9) Revocation of functional separation undertaking",
      "values:kind": "subsection",
      "cof:pageNumber": 69,
      "values:originalText": "(9) A revocation under subsection (6), (7) or (8) takes effect at the\ntime specified in the notice of revocation. The specified time:\n\n(a) must not be earlier than the time the notice is given; and\n\n(b) must not be later than 12 months after the notice is given."
