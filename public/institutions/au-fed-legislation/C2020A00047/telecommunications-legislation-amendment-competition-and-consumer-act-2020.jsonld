      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person must not:\n\n(d) conspire with others to effect a contravention of\nsubsection (2);",
      "cml:conclusionText": "A person must not conspire with others to effect a contravention of subsection (2);"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-41-ss-5-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person must not:\n\n(a) aid, abet, counsel or procure a contravention of subsection (2); or\n\n(b) induce, whether by threats or promises or otherwise, a\ncontravention of subsection (2); or\n\n(c) be in any way, directly or indirectly, knowingly concerned in,\nor party to, a contravention of subsection (2); or\n\n(d) conspire with others to effect a contravention of\nsubsection (2).",
      "cml:conclusionText": "A person must not aid, abet, counsel or procure a contravention of subsection (2), or induce, whether by threats or promises or otherwise, a contravention of subsection (2), or be in any way, directly or indirectly, knowingly concerned in, nor party to, a contravention of subsection (2), or conspire with others to effect a contravention of subsection (2);"
    },
