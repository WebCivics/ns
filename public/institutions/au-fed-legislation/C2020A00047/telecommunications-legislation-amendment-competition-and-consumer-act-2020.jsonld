      "@type": "cml:Concept",
      "skos:prefLabel": "82(9) Condition about compliance with Ministerial determination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-82-ss-9"
