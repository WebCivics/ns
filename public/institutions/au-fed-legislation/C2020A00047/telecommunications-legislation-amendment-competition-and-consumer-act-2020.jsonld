    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zk",
      "@type": "cml:Concept",
      "skos:prefLabel": "151ZK Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zk"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.89",
      "values:originalText": "The ACCC may, by writing, delegate to a person who is:\n\n(a) a member of the staff of the ACCC; and\n\n(b) an SES employee or acting SES employee;\nthe ACCC’s powers under any of the following provisions:\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(c) subsection 103(4F) (formal warning);\n\n(d) section 151D (further information);\n\n(e) subsection 151F(7) (extension of decision-making period);\n\n(f) section 151H (serial undertakings);\n\n(g) section 151R (further information);\n\n(h) subsection 151T(7) (extension of decision-making period).",
      "skos:definition": "The ACCC may, by writing, delegate to a person who is:\n\n(a) a member of the staff of the ACCC; and\n\n(b) an SES employee or acting SES employee;\nthe ACCC’s powers under any of the following provisions:\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(c) subsection 103(4F) (formal warning);\n\n(d) section 151D (further information);\n\n(e) subsection 151F(7) (extension of decision-making period);\n\n(f) section 151H (serial undertakings);\n\n(g) section 151R (further information);\n\n(h) subsection 151T(7) (extension of decision-making period).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zk-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zk-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "41bd17fbf056a0cff7ac7c735a0eac728efc13c04006c89d7da8835c2dc2d1f5",
      "skos:note": "Delegation of ACCC powers to staff and SES employees"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zk",
      "@type": "cof:Section",
      "cof:title": "151ZK Delegation",
      "values:kind": "section",
      "cof:pageNumber": 89,
      "values:originalText": "The ACCC may, by writing, delegate to a person who is:\n\n(a) a member of the staff of the ACCC; and\n\n(b) an SES employee or acting SES employee;\nthe ACCC’s powers under any of the following provisions:\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(c) subsection 103(4F) (formal warning);\n\n(d) section 151D (further information);\n\n(e) subsection 151F(7) (extension of decision-making period);\n\n(f) section 151H (serial undertakings);\n\n(g) section 151R (further information);\n\n(h) subsection 151T(7) (extension of decision-making period)."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zk-norm",
