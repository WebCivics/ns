        }
      ],
      "cml:integrityHash": "80d36af650a18e2a01f8386d9ebae3cd989fa4b971b5fd280d373183a7836cf7",
      "skos:note": "Report must be given to Minister and made available on website within 150 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sec-5-2-ss-8",
      "@type": "cof:Section",
      "cof:title": "5(8) Modelling of Regional Broadband Scheme",
      "values:kind": "subsection",
      "cof:pageNumber": 7,
      "values:originalText": "(8) Before the end of the 150-day period beginning when this section\ncommences, the ACCC must:\n\n\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(a) give the Minister the report; and\n\n(b) make the report available on the ACCC’s website."
    },
