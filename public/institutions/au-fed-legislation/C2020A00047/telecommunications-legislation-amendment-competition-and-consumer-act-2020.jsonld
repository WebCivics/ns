      ],
      "cml:integrityHash": "917f423b5ecffbd9249891243d0dc8143e9acecd7fc7e0789f0a1c298dea7bc7",
      "skos:note": "Committing a scheme to avoid application of certain provisions is an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-97-ss-4",
