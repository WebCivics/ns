      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-143g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
