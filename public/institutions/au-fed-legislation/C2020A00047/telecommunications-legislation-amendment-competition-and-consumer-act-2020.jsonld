      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151q-ss-7",
      "@type": "cof:Section",
      "cof:title": "151Q(7) Variation of functional separation undertaking that is in force",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(7) A fee determined under, or ascertained in accordance with,\nsubsection (6) must not be such as to amount to taxation."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151q-ss-7-norm",
