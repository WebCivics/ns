        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "223a8c880c40e1a4021a2a0a1cd8214af5aac1465b3412bd905e00d74a719dd7",
      "skos:note": "Issuing formal warnings for contraventions of the service provider rule set."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-22",
      "@type": "cof:Section",
      "cof:title": "22 After subsection 103(4E)",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Insert:\n\n(4F) The ACCC may issue a formal warning if a person contravenes the\nservice provider rule set out in Part 1 of Schedule 2 in so far as that\nrule relates to section 142C, 143, 143B, 151ZA, 151ZB, 151ZD,\n151ZF, 151ZG, 151ZH or 151ZI."
    },
