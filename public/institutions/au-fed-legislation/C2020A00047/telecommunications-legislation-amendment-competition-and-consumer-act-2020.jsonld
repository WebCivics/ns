      "skos:note": "Revocation of functional separation undertaking"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151w-ss-4",
      "@type": "cof:Section",
      "cof:title": "151W(4) Revocation of functional separation undertaking",
      "values:kind": "subsection",
      "cof:pageNumber": 69,
      "values:originalText": "(4) A revocation under subsection (1), (2) or (3) takes effect at the\ntime specified in the notice of revocation. The specified time:\n\n(a) must not be earlier than the time the notice is given; and\n\n(b) must not be later than 12 months after the notice is given."
    },
