    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102k",
      "@type": "cml:Concept",
      "skos:prefLabel": "102K Cancellation of certain exemptions from charge",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.187",
      "values:originalText": "(1) This section cancels the effect of a provision of another Act that\nwould have the effect of exempting a person from liability to pay\ncharge.\n\n(2) The cancellation does not apply if the provision of the other Act is\nenacted after the commencement of this section and refers\nspecifically to charge imposed by the Telecommunications\n(Regional Broadband Scheme) Charge Act 2020.\n\nSchedule 4  Funding of fixed wireless broadband and satellite broadband\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020",
      "skos:definition": "(1) This section cancels the effect of a provision of another Act that\nwould have the effect of exempting a person from liability to pay\ncharge.\n\n(2) The cancellation does not apply if the provision of the other Act is\nenacted after the commencement of this section and refers\nspecifically to charge imposed by the Telecommunications\n(Regional Broadband Scheme) Charge Act 2020.\n\nSchedule 4  Funding of fixed wireless broadband and satellite broadband\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102k-ss-1"
        },
