      "skos:prefLabel": "143D(11) Publication of list of persons who have elected to be bound by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-143d-ss-11"
      },
