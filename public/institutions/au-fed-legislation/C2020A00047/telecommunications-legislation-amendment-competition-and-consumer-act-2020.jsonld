    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Subsection 156(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.95",
      "values:originalText": "Omit “subsection (2) does not apply to the extension.”, substitute:\nthen:\n\n(d) subsection (2) does not apply to the extension at any time\nbefore the designated commencement date; and\n\n(e) if, at a time that occurs on or after the designated\ncommencement date, there is in force a legally enforceable\nagreement that satisfies the following conditions:\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(i) the agreement provides for the transfer of ownership or\ncontrol of the infrastructure of the extension to an NBN\ncorporation;\n\n(ii) the agreement is covered by a determination made under\nsubsection 577BA(9);\n\nsubsection (2) of this section does not apply to the extension\nat that time; and\n\n(f) if, at a time that occurs on or after the designated\ncommencement date, there is in force a legally enforceable\nagreement that satisfies the following conditions:\n\n(i) the contract provides for the deactivation or\ndecommissioning of the infrastructure of the extension;\n\n(ii) the contract was entered into between NBN Co and the\nlisted Optus companies (see subsection (7));\n\nsubsection (2) does not apply to the extension at that time.",
      "skos:definition": "Omit “subsection (2) does not apply to the extension.”, substitute:\nthen:\n\n(d) subsection (2) does not apply to the extension at any time\nbefore the designated commencement date; and\n\n(e) if, at a time that occurs on or after the designated\ncommencement date, there is in force a legally enforceable\nagreement that satisfies the following conditions:\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(i) the agreement provides for the transfer of ownership or\ncontrol of the infrastructure of the extension to an NBN\ncorporation;\n\n(ii) the agreement is covered by a determination made under\nsubsection 577BA(9);\n\nsubsection (2) of this section does not apply to the extension\nat that time; and\n\n(f) if, at a time that occurs on or after the designated\ncommencement date, there is in force a legally enforceable\nagreement that satisfies the following conditions:\n\n(i) the contract provides for the deactivation or\ndecommissioning of the infrastructure of the extension;\n\n(ii) the contract was entered into between NBN Co and the\nlisted Optus companies (see subsection (7));\n\nsubsection (2) does not apply to the extension at that time.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-64-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-64-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-64-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "5332d03f68c28dee0bfbb02dce19d01209beab5917412a5f0e13aa8b1b16e17a",
      "skos:note": "Omit subsection (2) does not apply to the extension."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-64",
      "@type": "cof:Section",
      "cof:title": "64 Subsection 156(4)",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "Omit “subsection (2) does not apply to the extension.”, substitute:\nthen:\n\n(d) subsection (2) does not apply to the extension at any time\nbefore the designated commencement date; and\n\n(e) if, at a time that occurs on or after the designated\ncommencement date, there is in force a legally enforceable\nagreement that satisfies the following conditions:\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(i) the agreement provides for the transfer of ownership or\ncontrol of the infrastructure of the extension to an NBN\ncorporation;\n\n(ii) the agreement is covered by a determination made under\nsubsection 577BA(9);\n\nsubsection (2) of this section does not apply to the extension\nat that time; and\n\n(f) if, at a time that occurs on or after the designated\ncommencement date, there is in force a legally enforceable\nagreement that satisfies the following conditions:\n\n(i) the contract provides for the deactivation or\ndecommissioning of the infrastructure of the extension;\n\n(ii) the contract was entered into between NBN Co and the\nlisted Optus companies (see subsection (7));\n\nsubsection (2) does not apply to the extension at that time."
    },
