    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142b",
      "@type": "cml:Concept",
      "skos:prefLabel": "142B Functional separation undertaking given by a person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.23",
      "values:originalText": "A reference in this Part to a functional separation undertaking\ngiven by a person is a reference to a functional separation\nundertaking given by the person either:\n\n(a) alone; or\n\n(b) jointly with one or more other persons.",
      "skos:definition": "A reference in this Part to a functional separation undertaking\ngiven by a person is a reference to a functional separation\nundertaking given by the person either:\n\n(a) alone; or\n\n(b) jointly with one or more other persons.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142b-norm"
        }
      ],
      "cml:integrityHash": "3c41c440cf22f070714a49205567ce6e34bb660157131d7ebb80e02208af5d32",
      "skos:note": "Defines functional separation undertaking given by a person."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142b",
      "@type": "cof:Section",
      "cof:title": "142B Functional separation undertaking given by a person",
      "values:kind": "section",
