    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102f",
      "@type": "cml:Concept",
      "skos:prefLabel": "102F Validity of assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102f"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.186",
      "values:originalText": "The validity of an assessment under this Division is not affected by\na contravention of this Division.\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020",
      "skos:definition": "The validity of an assessment under this Division is not affected by\na contravention of this Division.\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102f-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102f-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "096e6aa1e69f9899b34814c73702e3a783f6cb129544ea971d27f1a3f5774c45",
      "skos:note": "Assessment validity unaffected by contravention"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102f",
      "@type": "cof:Section",
      "cof:title": "102F Validity of assessment",
      "values:kind": "section",
      "cof:pageNumber": 186,
      "values:originalText": "The validity of an assessment under this Division is not affected by\na contravention of this Division.\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102f-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102f"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102f-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If there is a contravention, then assessment validity is not affected.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "There is a contravention.",
      "cml:conclusionText": "Assessment validity is not affected."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102g",
      "@type": "cml:Concept",
      "skos:prefLabel": "102G Evidence of assessment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.187",
      "values:originalText": "Scope\n\n(1) This section applies if a document that purports to be a copy of an\nassessment under section 102 is produced in a proceeding.\nEvidence\n\n(2) Except so far as the contrary is established, it must be presumed:\n\n(a) that the document is a copy of the assessment; and\n\n(b) that the ACMA has duly made the assessment; and\n\n(c) that the amounts and other particulars set out in the\nassessment are correct.",
      "skos:definition": "Scope\n\n(1) This section applies if a document that purports to be a copy of an\nassessment under section 102 is produced in a proceeding.\nEvidence\n\n(2) Except so far as the contrary is established, it must be presumed:\n\n(a) that the document is a copy of the assessment; and\n\n(b) that the ACMA has duly made the assessment; and\n\n(c) that the amounts and other particulars set out in the\nassessment are correct.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102g-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102g-ss-2"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102g",
      "@type": "cof:Section",
      "cof:title": "102G Evidence of assessment",
      "values:kind": "section",
      "cof:pageNumber": 187,
      "values:originalText": "Scope\n\n(1) This section applies if a document that purports to be a copy of an\nassessment under section 102 is produced in a proceeding.\nEvidence\n\n(2) Except so far as the contrary is established, it must be presumed:\n\n(a) that the document is a copy of the assessment; and\n\n(b) that the ACMA has duly made the assessment; and\n\n(c) that the amounts and other particulars set out in the\nassessment are correct."
    },
