    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-98-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "98(4) Charge offset certificate",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-98-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.175",
      "values:originalText": "(4) The amount specified in the certificate:\n\n(a) must be the amount ascertained in accordance with rules\nmade under subsection (9); and\n\n(b) must not exceed the nominal funding entitlement of the\nperson for the next financial year; and\n\n(c) must not exceed the annual base amount of the person for the\ncharge financial year.",
      "skos:definition": "(4) The amount specified in the certificate:\n\n(a) must be the amount ascertained in accordance with rules\nmade under subsection (9); and\n\n(b) must not exceed the nominal funding entitlement of the\nperson for the next financial year; and\n\n(c) must not exceed the annual base amount of the person for the\ncharge financial year.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-98"
      },
      "cml:asserts": [
