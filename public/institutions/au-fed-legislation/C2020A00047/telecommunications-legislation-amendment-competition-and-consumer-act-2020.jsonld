    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.7",
      "values:originalText": "(1) Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\n(2) The provisions of the Carrier Licence Conditions (Networks\nsupplying Superfast Carriage Services to Residential Customers)\nDeclaration 2014 amended or inserted by this Act, and any other\nprovisions of that instrument, may be varied by an instrument\nmade under subsection 63(5) of the Telecommunications Act 1997,\nor revoked by an instrument made under subsection 63(6) of that\nAct (see subsection 13(5) of the Legislation Act 2003).\n\n(3) The provisions of the Legislation (Exemptions and Other Matters)\nRegulation 2015 amended or inserted by this Act, and any other\nprovisions of that instrument, may be amended or repealed by\nregulations made under section 62 of the Legislation Act 2003 (see\nsubsection 13(5) of the Legislation Act 2003).",
      "skos:definition": "(1) Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\n(2) The provisions of the Carrier Licence Conditions (Networks\nsupplying Superfast Carriage Services to Residential Customers)\nDeclaration 2014 amended or inserted by this Act, and any other\nprovisions of that instrument, may be varied by an instrument\nmade under subsection 63(5) of the Telecommunications Act 1997,\nor revoked by an instrument made under subsection 63(6) of that\nAct (see subsection 13(5) of the Legislation Act 2003).\n\n(3) The provisions of the Legislation (Exemptions and Other Matters)\nRegulation 2015 amended or inserted by this Act, and any other\nprovisions of that instrument, may be amended or repealed by\nregulations made under section 62 of the Legislation Act 2003 (see\nsubsection 13(5) of the Legislation Act 2003).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-3-2-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-3-2-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-3-2-ss-3"
        }
      ],
      "cml:integrityHash": "8622c070fce93e39fd4f38aa67f7e4d0fff8360a0b5213862561a48f10507911"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "(1) Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\n(2) The provisions of the Carrier Licence Conditions (Networks\nsupplying Superfast Carriage Services to Residential Customers)\nDeclaration 2014 amended or inserted by this Act, and any other\nprovisions of that instrument, may be varied by an instrument\nmade under subsection 63(5) of the Telecommunications Act 1997,\nor revoked by an instrument made under subsection 63(6) of that\nAct (see subsection 13(5) of the Legislation Act 2003).\n\n(3) The provisions of the Legislation (Exemptions and Other Matters)\nRegulation 2015 amended or inserted by this Act, and any other\nprovisions of that instrument, may be amended or repealed by\nregulations made under section 62 of the Legislation Act 2003 (see\nsubsection 13(5) of the Legislation Act 2003)."
    },
