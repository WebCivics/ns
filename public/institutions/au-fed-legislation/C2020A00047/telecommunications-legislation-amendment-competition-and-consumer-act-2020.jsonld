        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360la",
      "@type": "cml:Concept",
      "skos:prefLabel": "360LA Format of description of areas",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360la"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.125",
      "values:originalText": "(1) An area declared under:\n\n(a) subsection 360D(2); or\n\n(b) subsection 360D(3); or\n\n(c) subsection 360H(2); or\n\n(d) subsection 360H(4); or\n\n(e) subsection 360H(6); or\n\n(f) section 360L;\nmust be described:\n\n(g) in a TAB vector format using the GDA94 coordinate system;\nor\n\n(h) if another format is determined under subsection (3)—in that\nother format.\n\n(2) An area specified under:\n\n(a) subsection 360HA(1); or\n\n(b) subsection 360HA(2); or\n\n(c) subsection 360HA(3); or\n\n(d) subsection 360HA(4);\nmust be described:\n\n(e) in a TAB vector format using the GDA94 coordinate system;\nor\n\n(f) if another format is determined under subsection (3)—in that\nother format.\n\nSchedule 3  Statutory infrastructure providers etc.",
      "skos:definition": "(1) An area declared under:\n\n(a) subsection 360D(2); or\n\n(b) subsection 360D(3); or\n\n(c) subsection 360H(2); or\n\n(d) subsection 360H(4); or\n\n(e) subsection 360H(6); or\n\n(f) section 360L;\nmust be described:\n\n(g) in a TAB vector format using the GDA94 coordinate system;\nor\n\n(h) if another format is determined under subsection (3)—in that\nother format.\n\n(2) An area specified under:\n\n(a) subsection 360HA(1); or\n\n(b) subsection 360HA(2); or\n\n(c) subsection 360HA(3); or\n\n(d) subsection 360HA(4);\nmust be described:\n\n(e) in a TAB vector format using the GDA94 coordinate system;\nor\n\n(f) if another format is determined under subsection (3)—in that\nother format.\n\nSchedule 3  Statutory infrastructure providers etc.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360la-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360la-ss-2"
        }
      ],
      "cml:integrityHash": "fdf61c102dff05e0f3483841672b038bd7570496351cd1d7eac67c9ed2a471f9"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360la",
      "@type": "cof:Section",
      "cof:title": "360LA Format of description of areas",
      "values:kind": "section",
      "cof:pageNumber": 125,
      "values:originalText": "(1) An area declared under:\n\n(a) subsection 360D(2); or\n\n(b) subsection 360D(3); or\n\n(c) subsection 360H(2); or\n\n(d) subsection 360H(4); or\n\n(e) subsection 360H(6); or\n\n(f) section 360L;\nmust be described:\n\n(g) in a TAB vector format using the GDA94 coordinate system;\nor\n\n(h) if another format is determined under subsection (3)—in that\nother format.\n\n(2) An area specified under:\n\n(a) subsection 360HA(1); or\n\n(b) subsection 360HA(2); or\n\n(c) subsection 360HA(3); or\n\n(d) subsection 360HA(4);\nmust be described:\n\n(e) in a TAB vector format using the GDA94 coordinate system;\nor\n\n(f) if another format is determined under subsection (3)—in that\nother format.\n\nSchedule 3  Statutory infrastructure providers etc."
    },
