      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.92",
      "values:originalText": "Competition Tribunal review\n\nDivision 1 of Part IX of the Competition and Consumer Act 2010\ndoes not apply in relation to a review by the Australian\nCompetition Tribunal of a decision of the ACCC of a kind\nmentioned in section 151ZL of this Act.",
      "skos:definition": "Competition Tribunal review\n\nDivision 1 of Part IX of the Competition and Consumer Act 2010\ndoes not apply in relation to a review by the Australian\nCompetition Tribunal of a decision of the ACCC of a kind\nmentioned in section 151ZL of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zn-norm"
        }
      ],
      "cml:integrityHash": "a4138a61d0bf92819f8f9b64a31d0ac0188a0ceaef82e866de3d99e80a45fb89",
      "skos:note": "Division 1 of Part IX does not apply to a review by the Australian Competition Tribunal of an ACCC decision."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zn",
      "@type": "cof:Section",
      "cof:title": "151ZN Provisions that do not apply in relation to an Australian",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "Competition Tribunal review\n\nDivision 1 of Part IX of the Competition and Consumer Act 2010\ndoes not apply in relation to a review by the Australian\nCompetition Tribunal of a decision of the ACCC of a kind\nmentioned in section 151ZL of this Act."
