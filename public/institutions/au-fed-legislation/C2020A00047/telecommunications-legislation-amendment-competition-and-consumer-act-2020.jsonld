    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sec-5-2-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "5(8) Modelling of Regional Broadband Scheme",
