    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151za-ss-5",
      "@type": "cof:Section",
      "cof:title": "151ZA(5) Reporting obligations following giving of revocation notice",
      "values:kind": "subsection",
      "cof:pageNumber": 75,
      "values:originalText": "(5) Subsections (3) and (4) are civil penalty provisions.\nNote:\nPart 31 provides for pecuniary penalties for breaches of civil penalty\nprovisions.\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151za-ss-5-norm",
      "@type": "values:Obligation",
      "cml:modality": {
