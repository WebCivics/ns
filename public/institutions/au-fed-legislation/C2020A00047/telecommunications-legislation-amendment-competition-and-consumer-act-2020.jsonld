    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102zg",
      "@type": "cml:Concept",
      "skos:prefLabel": "102ZG Delegation by the Secretary",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102zg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.202",
      "values:originalText": "(1) The Secretary may, by writing, delegate any or all of the\nSecretary’s functions or powers under this Part to an SES\nemployee, or acting SES employee, in the Department.\nNote:\nThe expressions SES employee and acting SES employee are defined\nin the Acts Interpretation Act 1901.\n\n(2) A delegate must comply with any written directions of the\nSecretary.\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020",
      "skos:definition": "(1) The Secretary may, by writing, delegate any or all of the\nSecretary’s functions or powers under this Part to an SES\nemployee, or acting SES employee, in the Department.\nNote:\nThe expressions SES employee and acting SES employee are defined\nin the Acts Interpretation Act 1901.\n\n(2) A delegate must comply with any written directions of the\nSecretary.\n\nFunding of fixed wireless broadband and satellite broadband  Schedule 4\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102zg-ss-1"
        },
        {
