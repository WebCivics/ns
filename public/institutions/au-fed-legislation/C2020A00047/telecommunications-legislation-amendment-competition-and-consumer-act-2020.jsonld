      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.197",
      "values:originalText": "The ACMA may give the ACCC information that is relevant to the\nperformance of any of the ACCC’s functions, or the exercise of\nany of the ACCC’s powers, under the Telecommunications\n(Regional Broadband Scheme) Charge Act 2020.",
      "skos:definition": "The ACMA may give the ACCC information that is relevant to the\nperformance of any of the ACCC’s functions, or the exercise of\nany of the ACCC’s powers, under the Telecommunications\n(Regional Broadband Scheme) Charge Act 2020.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102ze-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102ze-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "630fff76a1eaf94be42bac3a891baa8d4fdcdfdbb0e5697560f3fc28c4222473",
      "skos:note": "ACMA must provide information to the ACCC.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102ze",
      "@type": "cof:Section",
      "cof:title": "102ZE ACMA may give certain information to the ACCC",
      "values:kind": "section",
      "cof:pageNumber": 197,
      "values:originalText": "The ACMA may give the ACCC information that is relevant to the\nperformance of any of the ACCC’s functions, or the exercise of\nany of the ACCC’s powers, under the Telecommunications\n(Regional Broadband Scheme) Charge Act 2020."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-102ze-norm",
      "@type": "values:Obligation",
      "cml:modality": {
