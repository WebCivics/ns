      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.199",
      "values:originalText": "(1) The Minister must cause to be conducted a review of the following\nmatters:\n\n(a) the operation of this Part;\n\n(b) the operation of the remaining provisions of this Act to the\nextent to which they relate to this Part;\n\n(c) the operation of the Telecommunications Act 1997 to the\nextent to which that Act relates to this Part;\n\n(d) the operation of the Telecommunications (Regional\nBroadband Scheme) Charge Act 2020;\n\n(e) whether this Part should be amended;\n\n(f) whether the remaining provisions of this Act, to the extent to\nwhich they relate to this Part, should be amended;\n\n(g) whether the Telecommunications Act 1997, to the extent to\nwhich that Act relates to this Part, should be amended;\n\n(h) whether the Telecommunications (Regional Broadband\nScheme) Charge Act 2020 should be amended.",
      "skos:definition": "(1) The Minister must cause to be conducted a review of the following\nmatters:\n\n(a) the operation of this Part;\n\n(b) the operation of the remaining provisions of this Act to the\nextent to which they relate to this Part;\n\n(c) the operation of the Telecommunications Act 1997 to the\nextent to which that Act relates to this Part;\n\n(d) the operation of the Telecommunications (Regional\nBroadband Scheme) Charge Act 2020;\n\n(e) whether this Part should be amended;\n\n(f) whether the remaining provisions of this Act, to the extent to\nwhich they relate to this Part, should be amended;\n\n(g) whether the Telecommunications Act 1997, to the extent to\nwhich that Act relates to this Part, should be amended;\n\n(h) whether the Telecommunications (Regional Broadband\nScheme) Charge Act 2020 should be amended.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-1-3"
      },
