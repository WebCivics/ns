          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zb-ss-5"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zb-ss-6"
        }
      ],
      "cml:integrityHash": "a79f21dc05983660ae169bd7761f67052e7f9daaa1fe60fbabfc7fe2a35c72c3"
