      },
      "cml:premiseText": "The person supplies a designated broadband service to particular premises in Australia using the line.",
      "cml:conclusionText": "The period during which the person supplies a designated broadband service overlaps with the whole or a part of the month."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-94-logic-ltl-3",
      "@type": "cml:LogicApplication",
