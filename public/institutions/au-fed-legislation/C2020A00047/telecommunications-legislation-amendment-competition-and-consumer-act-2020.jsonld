    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151n-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "151N(7) Variation of expiry time of certain functional separation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151n-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
