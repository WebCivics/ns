        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-161-ss-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-161-ss-4"
        }
      ],
      "cml:integrityHash": "daeccc544b90222b3f6736c3519220c1957feb0954e277392c23dca469d02eb3"
