    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Section 142A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
