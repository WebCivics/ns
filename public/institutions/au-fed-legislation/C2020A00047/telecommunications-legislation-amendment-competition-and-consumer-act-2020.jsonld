    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-96a",
      "@type": "cml:Concept",
      "skos:prefLabel": "96A Potentially concessional premises",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-96a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.171",
      "values:originalText": "For the purposes of this Part, if particular premises are potentially\nchargeable premises in relation to a person for a month because a\ncarriage service provider (who may be the person) supplies a\ndesignated broadband service to:\n\n(a) a residential customer who occupies the premises; or\n\n(b) a small business customer who occupies the premises;\nthe premises are potentially concessional premises in relation to\nthe person for that month.",
      "skos:definition": "For the purposes of this Part, if particular premises are potentially\nchargeable premises in relation to a person for a month because a\ncarriage service provider (who may be the person) supplies a\ndesignated broadband service to:\n\n(a) a residential customer who occupies the premises; or\n\n(b) a small business customer who occupies the premises;\nthe premises are potentially concessional premises in relation to\nthe person for that month.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-96a-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-96a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d9d6d734027eed39ec83a61f19691f5680f1257bc4aac8180d69a559f27c0815",
      "skos:note": "Premises are potentially concessional if a carriage service provider supplies broadband to occupants."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-96a",
      "@type": "cof:Section",
      "cof:title": "96A Potentially concessional premises",
      "values:kind": "section",
      "cof:pageNumber": 171,
      "values:originalText": "For the purposes of this Part, if particular premises are potentially\nchargeable premises in relation to a person for a month because a\ncarriage service provider (who may be the person) supplies a\ndesignated broadband service to:\n\n(a) a residential customer who occupies the premises; or\n\n(b) a small business customer who occupies the premises;\nthe premises are potentially concessional premises in relation to\nthe person for that month."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-96a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-96a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-96a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": ">",
