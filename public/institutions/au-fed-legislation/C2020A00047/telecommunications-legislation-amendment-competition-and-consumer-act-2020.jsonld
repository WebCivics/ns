    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151t-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "151T(8) ACCC to accept or reject variation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151t-ss-8"
      },
