        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360k-ss-3-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "e4b5875afc85bbf21f87b82ddb02b607762e4c762c6dccaf807ed0d11f8e43de",
      "skos:note": "Carrier is statutory infrastructure provider for nominated service area if conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360k-ss-3",
      "@type": "cof:Section",
      "cof:title": "360K(3) Statutory infrastructure provider for a nominated service area",
      "values:kind": "subsection",
      "cof:pageNumber": 124,
      "values:originalText": "(3) For the purposes of this Part, if:\n\n(a) immediately before the commencement of this section, a\ncarrier licence held by a carrier was subject to a condition\nunder a declaration mentioned in section 360J; and\n\n(b) as a result of the application of section 360J to the\ndeclaration, an area is a nominated service area;\nthe carrier is the statutory infrastructure provider for the\nnominated service area."
    },
