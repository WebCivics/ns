        }
      ],
      "cml:integrityHash": "400b074f7fe8fa5062adc67875143f689995b26f06c0826514cf874b77dcb079",
      "skos:note": "Grounds for believing a wholesale customer is not creditworthy"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-143a-ss-5",
      "@type": "cof:Section",
      "cof:title": "143A(5) Class exemptions",
      "values:kind": "subsection",
