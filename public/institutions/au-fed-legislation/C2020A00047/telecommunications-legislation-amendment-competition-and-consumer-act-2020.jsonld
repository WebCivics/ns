    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142bb",
      "@type": "cml:Concept",
      "skos:prefLabel": "142BB Terms and conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142bb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.24",
      "values:originalText": "For the purposes of this Part:\n\n(a) a notional contract (however described) between a\ncorporation’s business units is to be treated as if it were an\nactual contract; and\n\n(b) any terms and conditions (whether or not relating to price or\na method of ascertaining price) in such a notional contract are\nto be treated as if they were actual terms and conditions.",
      "skos:definition": "For the purposes of this Part:\n\n(a) a notional contract (however described) between a\ncorporation’s business units is to be treated as if it were an\nactual contract; and\n\n(b) any terms and conditions (whether or not relating to price or\na method of ascertaining price) in such a notional contract are\nto be treated as if they were actual terms and conditions.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142bb-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142bb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "28d159d3188a72eebdd95756b473e9e6beb34182c044cb2d755117fa0469879b",
      "skos:note": "Treat notional contracts as actual contracts for terms and conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142bb",
      "@type": "cof:Section",
      "cof:title": "142BB Terms and conditions",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "For the purposes of this Part:\n\n(a) a notional contract (however described) between a\ncorporation’s business units is to be treated as if it were an\nactual contract; and\n\n(b) any terms and conditions (whether or not relating to price or\na method of ascertaining price) in such a notional contract are\nto be treated as if they were actual terms and conditions."
    },
