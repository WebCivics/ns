      },
      "cml:premiseText": "(a) a part of the infrastructure of a telecommunications network is situated in a particular area...",
      "cml:conclusionText": "...the infrastructure mentioned in paragraph (c) is exempt from sections 142C and 143."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143d-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:logicSummary": "The provision applies during the period when the telecommunications network infrastructure is being developed as a stage of the project.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) on 1 January 2011, was being developed as a particular stage of a real estate development project;",
      "cml:conclusionText": "...the network is extended to another area that is being, or is to be, developed..."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143d-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "The provision applies until the telecommunications network infrastructure is no longer part of an extension to another area.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) before 1 January 2011, was developed as a particular stage of a real estate development project;",
      "cml:conclusionText": "...the infrastructure mentioned in paragraph (c) is exempt from sections 142C and 143."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143d-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Must",
      "cml:logicSummary": "The provision imposes an obligation on carriers to install telecommunications network infrastructure that is part of the extension.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) a carrier installs telecommunications network infrastructure;",
      "cml:conclusionText": "...the infrastructure mentioned in paragraph (c) is part of the extension;"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143d-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "143D(2) Publication of list of persons who have elected to be bound by",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-143d-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.34",
      "values:originalText": "(2) If:\n\n(a) a part of the infrastructure of a telecommunications network\nis situated in a particular area that:\n\n(i) on 1 January 2011, was being developed as a particular\nstage of a real estate development project; or\n\n(ii) before 1 January 2011, was developed as a particular\nstage of a real estate development project; and\n\n(b) during the period:\n\n(i) beginning at the start of the designated commencement\ndate; and\n\n(ii) ending when the Minister makes a declaration under\nsection 48 of the National Broadband Network\nCompanies Act 2011 that, in the Minister’s opinion, the\nnational broadband network should be treated as built\nand fully operational;\n\nthe network is extended to an area that is:\n\n(iii) the project area of a real estate development project\nspecified under subsection (3); or\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(iv) the project area of a real estate development project that\nbelongs to a class of real estate development projects\nspecified under subsection (5); or\n\n(v) the project area of a building redevelopment project\nspecified under subsection (6); or\n\n(vi) the project area of a building redevelopment project that\nbelongs to a class of building redevelopment projects\nspecified under subsection (8); and\n\n(c) a carrier installs telecommunications network infrastructure;\nand\n\n(d) the infrastructure mentioned in paragraph (c) is part of the\nextension;\nthe infrastructure mentioned in paragraph (c) is exempt from\nsections 142C and 143.",
      "skos:definition": "(2) If:\n\n(a) a part of the infrastructure of a telecommunications network\nis situated in a particular area that:\n\n(i) on 1 January 2011, was being developed as a particular\nstage of a real estate development project; or\n\n(ii) before 1 January 2011, was developed as a particular\nstage of a real estate development project; and\n\n(b) during the period:\n\n(i) beginning at the start of the designated commencement\ndate; and\n\n(ii) ending when the Minister makes a declaration under\nsection 48 of the National Broadband Network\nCompanies Act 2011 that, in the Minister’s opinion, the\nnational broadband network should be treated as built\nand fully operational;\n\nthe network is extended to an area that is:\n\n(iii) the project area of a real estate development project\nspecified under subsection (3); or\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(iv) the project area of a real estate development project that\nbelongs to a class of real estate development projects\nspecified under subsection (5); or\n\n(v) the project area of a building redevelopment project\nspecified under subsection (6); or\n\n(vi) the project area of a building redevelopment project that\nbelongs to a class of building redevelopment projects\nspecified under subsection (8); and\n\n(c) a carrier installs telecommunications network infrastructure;\nand\n\n(d) the infrastructure mentioned in paragraph (c) is part of the\nextension;\nthe infrastructure mentioned in paragraph (c) is exempt from\nsections 142C and 143.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143d"
      },
      "cml:asserts": [
