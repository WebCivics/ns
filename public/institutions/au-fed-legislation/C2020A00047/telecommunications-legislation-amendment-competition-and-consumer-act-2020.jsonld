    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Before section 152BEC",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-3"
      },
      "cml:curationStatus": {
