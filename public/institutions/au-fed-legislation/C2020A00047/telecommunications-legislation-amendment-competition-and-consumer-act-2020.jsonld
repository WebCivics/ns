          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-99-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c41751fbc24a30562608b25cb7af6843f1ef21ceb895c5adc9371eb8346b2059",
      "skos:note": "ACMA must vary assessment to reflect remission upon notification."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-99-ss-3",
