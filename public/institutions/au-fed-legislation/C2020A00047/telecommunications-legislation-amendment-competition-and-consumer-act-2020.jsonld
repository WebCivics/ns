    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151zm-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "151ZM(7) Functions and powers of the Australian Competition",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zm-ss-7"
