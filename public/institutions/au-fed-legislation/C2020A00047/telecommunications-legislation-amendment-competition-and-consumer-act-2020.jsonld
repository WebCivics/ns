        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) the person: (i) did not know; and (ii) could not, with reasonable diligence, have ascertained that the premises are not potentially concessional premises in relation to the person for the month;",
      "cml:conclusionText": "the person must have ascertained that the premises are not potentially concessional."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-5-logic-deontic-5",
