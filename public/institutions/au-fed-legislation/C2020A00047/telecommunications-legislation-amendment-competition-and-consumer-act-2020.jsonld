    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "100(4) Reporting obligations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-100-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.178",
      "values:originalText": "(4) If:\n\n(a) the report relates to:\n\n(i) the first eligible financial year; or\n\n(ii) the second eligible financial year; or\n\n(iii) the third eligible financial year; or\n\n(iv) the fourth eligible financial year; or\n\n(v) the fifth eligible financial year; and\n\n(b) there are one or more potentially concessional premises in\nrelation to the person for a month in the eligible financial\nyear;\nthe report must set out the total number of potentially concessional\npremises in relation to the person for that month.",
      "skos:definition": "(4) If:\n\n(a) the report relates to:\n\n(i) the first eligible financial year; or\n\n(ii) the second eligible financial year; or\n\n(iii) the third eligible financial year; or\n\n(iv) the fourth eligible financial year; or\n\n(v) the fifth eligible financial year; and\n\n(b) there are one or more potentially concessional premises in\nrelation to the person for a month in the eligible financial\nyear;\nthe report must set out the total number of potentially concessional\npremises in relation to the person for that month.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "50c15ee564dac888a89312b357311317ac63fa90c0d8c882d97ce154a346f647",
      "skos:note": "Report must set out total number of potentially concessional premises for a month if there are one or more in relation to the person.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-100-ss-4",
      "@type": "cof:Section",
      "cof:title": "100(4) Reporting obligations",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(4) If:\n\n(a) the report relates to:\n\n(i) the first eligible financial year; or\n\n(ii) the second eligible financial year; or\n\n(iii) the third eligible financial year; or\n\n(iv) the fourth eligible financial year; or\n\n(v) the fifth eligible financial year; and\n\n(b) there are one or more potentially concessional premises in\nrelation to the person for a month in the eligible financial\nyear;\nthe report must set out the total number of potentially concessional\npremises in relation to the person for that month."
    },
