      "@type": "cml:Concept",
      "skos:prefLabel": "102U(5) Access to information or documents held by an eligible",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102u-ss-5"
      },
