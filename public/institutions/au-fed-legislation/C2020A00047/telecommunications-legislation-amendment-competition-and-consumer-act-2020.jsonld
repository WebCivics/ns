    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142c-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "142C(3) Supply of eligible services to be on wholesale basis—lines that",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142c-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.25",
      "values:originalText": "(3) Subsection (2) does not apply to the use of the line if a functional\nseparation undertaking given by the first person is in force, unless:\n\n(a) the ACCC has given a notice under section 151W revoking\nthe undertaking; and\n\n(b) the revocation has not taken effect; and\n\n(c) the line came into existence after the notice was given.\nNote 1:\nA functional separation undertaking relates to the supply of eligible\nservices using a local access line, irrespective of when the line came\ninto existence.\nNote 2:\nSee also section 142B.\nAncillary contraventions",
      "skos:definition": "(3) Subsection (2) does not apply to the use of the line if a functional\nseparation undertaking given by the first person is in force, unless:\n\n(a) the ACCC has given a notice under section 151W revoking\nthe undertaking; and\n\n(b) the revocation has not taken effect; and\n\n(c) the line came into existence after the notice was given.\nNote 1:\nA functional separation undertaking relates to the supply of eligible\nservices using a local access line, irrespective of when the line came\ninto existence.\nNote 2:\nSee also section 142B.\nAncillary contraventions",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142c"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142c-ss-3-norm"
        }
      ],
      "cml:integrityHash": "6622be8bb6d684a6dd4948ffcbc9108f9f51d78a555c38fe37e8daf62fe03020",
      "skos:note": "Exemptions from subsection (2) for functional separation undertakings"
    },
    {
