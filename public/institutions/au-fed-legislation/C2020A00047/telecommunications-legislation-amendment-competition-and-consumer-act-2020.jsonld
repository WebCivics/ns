    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143h",
      "@type": "cml:Concept",
      "skos:prefLabel": "143H Exemption—networks marketed as business networks",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-143h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.40",
      "values:originalText": "(1) If:\n\n(a) a local access line is part of the infrastructure of a\ntelecommunications network operated by a carrier; and\n\n(b) the network is marketed by the carrier exclusively as a\nbusiness network; and\n\n(c) the line is used, or proposed to be used, to supply a superfast\ncarriage service wholly or principally to residential\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\ncustomers, or prospective residential customers, in Australia;\nand\n\n(d) that use or proposed use, when considered in relation to the\nuse or proposed use of all of the local access lines that are\npart of the infrastructure of the network, is minor; and\n\n(e) the other conditions (if any) determined under subsection (2)\nhave been satisfied;\nthe line is exempt from section 142C.\n\n(2) The Minister may, by legislative instrument, determine one or\nmore conditions for the purposes of paragraph (1)(e).",
      "skos:definition": "(1) If:\n\n(a) a local access line is part of the infrastructure of a\ntelecommunications network operated by a carrier; and\n\n(b) the network is marketed by the carrier exclusively as a\nbusiness network; and\n\n(c) the line is used, or proposed to be used, to supply a superfast\ncarriage service wholly or principally to residential\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\n\ncustomers, or prospective residential customers, in Australia;\nand\n\n(d) that use or proposed use, when considered in relation to the\nuse or proposed use of all of the local access lines that are\npart of the infrastructure of the network, is minor; and\n\n(e) the other conditions (if any) determined under subsection (2)\nhave been satisfied;\nthe line is exempt from section 142C.\n\n(2) The Minister may, by legislative instrument, determine one or\nmore conditions for the purposes of paragraph (1)(e).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-143h-ss-1"
        },
