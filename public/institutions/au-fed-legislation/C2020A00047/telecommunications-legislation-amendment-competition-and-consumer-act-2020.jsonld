      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person must not:\n\n(a) aid, abet, counsel or procure a contravention of\nsubsection (2);",
      "cml:conclusionText": "A person must not aid, abet, counsel or procure a contravention of subsection (2);"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-41-ss-5-logic-deontic-2",
