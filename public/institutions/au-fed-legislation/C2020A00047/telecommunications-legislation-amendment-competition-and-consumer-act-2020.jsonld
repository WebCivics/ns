        }
      ],
      "cml:integrityHash": "f5b521bbe648f009dbf1b238358ca74e73c7715d08edbc4178f4752431af8367",
      "skos:note": "Civil penalty provisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151zi-ss-3",
      "@type": "cof:Section",
