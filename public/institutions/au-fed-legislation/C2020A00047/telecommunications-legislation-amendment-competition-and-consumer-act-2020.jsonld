    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "100(11) Reporting obligations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-100-ss-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.178",
      "values:originalText": "(11) If:\n\n(a) particular premises are reported as recently connected\ngreenfield premises in relation to the person for a month; and\n\n(b) apart from this subsection, the premises are not recently\nconnected greenfield premises in relation to the person for\nthe month; and\n\n(c) the person:\n\n(i) did not know; and\n\n(ii) could not, with reasonable diligence, have ascertained;\n\nthat the premises are not recently connected greenfield\npremises in relation to the person for the month;\nthe premises are taken, for all purposes, to be recently connected\ngreenfield premises in relation to the person for the month.",
      "skos:definition": "(11) If:\n\n(a) particular premises are reported as recently connected\ngreenfield premises in relation to the person for a month; and\n\n(b) apart from this subsection, the premises are not recently\nconnected greenfield premises in relation to the person for\nthe month; and\n\n(c) the person:\n\n(i) did not know; and\n\n(ii) could not, with reasonable diligence, have ascertained;\n\nthat the premises are not recently connected greenfield\npremises in relation to the person for the month;\nthe premises are taken, for all purposes, to be recently connected\ngreenfield premises in relation to the person for the month.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-deontic-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-epistemic-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-ltl-4"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-100-ss-11-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "6760859f987f78b4718c465eb0f4c899214eba3b426844fe80b8990d5d1e82c2",
      "skos:note": "If premises are not reported as recently connected greenfield premises, the person must report them.",
      "dc:description": "Reporting obligations"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-100-ss-11",
      "@type": "cof:Section",
      "cof:title": "100(11) Reporting obligations",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(11) If:\n\n(a) particular premises are reported as recently connected\ngreenfield premises in relation to the person for a month; and\n\n(b) apart from this subsection, the premises are not recently\nconnected greenfield premises in relation to the person for\nthe month; and\n\n(c) the person:\n\n(i) did not know; and\n\n(ii) could not, with reasonable diligence, have ascertained;\n\nthat the premises are not recently connected greenfield\npremises in relation to the person for the month;\nthe premises are taken, for all purposes, to be recently connected\ngreenfield premises in relation to the person for the month."
    },
