        }
      ],
      "cml:integrityHash": "9f66b580f5a363994dd8d85bb48f064d6ddabaeb656a7b99f6adb94885676aa9",
      "skos:note": "Publish a copy of the notice on the ACCC’s website."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151t-ss-8",
      "@type": "cof:Section",
      "cof:title": "151T(8) ACCC to accept or reject variation",
      "values:kind": "subsection",
      "cof:pageNumber": 66,
      "values:originalText": "(8) As soon as practicable after the ACCC gives a notice under\nsubsection (7), the ACCC must publish a copy of the notice on the\nACCC’s website.\n\nSchedule 2  Local access lines\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020"
    },
    {
