      "cml:integrityHash": "0c5a050f25b6ac4884d1b592efe9229469154c6ad99af36b73b1c3421455922b",
      "skos:note": "Minister may determine premises under specified conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-79a-ss-1",
      "@type": "cof:Section",
      "cof:title": "79A(1) Premises",
      "values:kind": "subsection",
      "cof:pageNumber": 155,
      "values:originalText": "(1) The Minister may, by legislative instrument, determine that, if a\nlocation satisfies one or more specified conditions, the location is\ntaken to be premises for the purposes of this Part.\nNote:\nSee also section 102ZFB (disallowance of determinations)."
    },
