    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360q",
      "@type": "cml:Concept",
      "skos:prefLabel": "360Q Obligation of statutory infrastructure provider to supply",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360q"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
