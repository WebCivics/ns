    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-142bd-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "142BD(3) Designated carriage service",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-142bd-ss-3"
      },
      "cml:curationStatus": {
