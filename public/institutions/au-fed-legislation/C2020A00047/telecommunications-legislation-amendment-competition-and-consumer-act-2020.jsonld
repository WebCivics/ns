    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-151c-ss-1",
      "@type": "cof:Section",
      "cof:title": "151C(1) Joint functional separation undertaking",
      "values:kind": "subsection",
      "cof:pageNumber": 48,
      "values:originalText": "(1) If 2 or more persons are corporations, those persons may give a\njoint written undertaking (a joint functional separation\nundertaking) to the ACCC.\n\nLocal access lines  Schedule 2\n\nNo. 47, 2020\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-2-sec-151c-ss-1-norm",
