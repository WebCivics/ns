      "@type": "cml:Concept",
      "skos:prefLabel": "157 Certain installations and connections are not taken to be an",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-2-sec-157"
      },
