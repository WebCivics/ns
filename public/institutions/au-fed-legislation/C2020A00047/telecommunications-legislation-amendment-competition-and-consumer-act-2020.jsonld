    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Section 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.146",
      "values:originalText": "Before:\n•\nLocal calls are to be charged for on an untimed basis.\ninsert:\n•\nThe Secretary is responsible for entering into contracts, and\nmaking grants, relating to:\n\n(a)\nfixed wireless broadband; and\n\n(b)\nsatellite broadband.\n•\nThe ACMA will assess and collect the charge imposed on\ncarriers by the Telecommunications (Regional Broadband\nScheme) Charge Act 2020.\n•\nThe proceeds of the charge will be used to:\n\n(a)\npay contractors and grant recipients; and\n\n(b)\noffset designated administrative costs.",
      "skos:definition": "Before:\n•\nLocal calls are to be charged for on an untimed basis.\ninsert:\n•\nThe Secretary is responsible for entering into contracts, and\nmaking grants, relating to:\n\n(a)\nfixed wireless broadband; and\n\n(b)\nsatellite broadband.\n•\nThe ACMA will assess and collect the charge imposed on\ncarriers by the Telecommunications (Regional Broadband\nScheme) Charge Act 2020.\n•\nThe proceeds of the charge will be used to:\n\n(a)\npay contractors and grant recipients; and\n\n(b)\noffset designated administrative costs.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-8-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-8-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0aa1365f5cd07af3cc46453f0a1058fb45eba93b855277e6fa2fe21a614860cd",
      "skos:note": "Local calls are charged on an untimed basis."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Section 4",
      "values:kind": "section",
      "cof:pageNumber": 146,
      "values:originalText": "Before:\n•\nLocal calls are to be charged for on an untimed basis.\ninsert:\n•\nThe Secretary is responsible for entering into contracts, and\nmaking grants, relating to:\n\n(a)\nfixed wireless broadband; and\n\n(b)\nsatellite broadband.\n•\nThe ACMA will assess and collect the charge imposed on\ncarriers by the Telecommunications (Regional Broadband\nScheme) Charge Act 2020.\n•\nThe proceeds of the charge will be used to:\n\n(a)\npay contractors and grant recipients; and\n\n(b)\noffset designated administrative costs."
    },
