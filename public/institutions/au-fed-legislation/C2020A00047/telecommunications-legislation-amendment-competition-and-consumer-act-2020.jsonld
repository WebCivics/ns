    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-92",
      "@type": "cml:Concept",
      "skos:prefLabel": "92 Purposes of the Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-92"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.164",
      "values:originalText": "The purposes of the Regional Broadband Scheme Special Account\nare as follows:\n\n(a) to pay amounts payable by the Commonwealth under a\ncontract entered into under section 80;\n\n(b) to make grants under section 80;\n\n(c) to make distributions in accordance with section 91;\n\n(d) to pay refunds under section 99 or 102J.\nNote:\nSee section 80 of the Public Governance, Performance and\nAccountability Act 2013 (which deals with special accounts).",
      "skos:definition": "The purposes of the Regional Broadband Scheme Special Account\nare as follows:\n\n(a) to pay amounts payable by the Commonwealth under a\ncontract entered into under section 80;\n\n(b) to make grants under section 80;\n\n(c) to make distributions in accordance with section 91;\n\n(d) to pay refunds under section 99 or 102J.\nNote:\nSee section 80 of the Public Governance, Performance and\nAccountability Act 2013 (which deals with special accounts).",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-92-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-92-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "40354662e3723ecad6f086916cf2c51a740fb446acfbd8f6f9e45c7faadf73b3",
      "skos:note": "Purposes of the Regional Broadband Scheme Special Account"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-92",
      "@type": "cof:Section",
      "cof:title": "92 Purposes of the Account",
      "values:kind": "section",
      "cof:pageNumber": 164,
      "values:originalText": "The purposes of the Regional Broadband Scheme Special Account\nare as follows:\n\n(a) to pay amounts payable by the Commonwealth under a\ncontract entered into under section 80;\n\n(b) to make grants under section 80;\n\n(c) to make distributions in accordance with section 91;\n\n(d) to pay refunds under section 99 or 102J.\nNote:\nSee section 80 of the Public Governance, Performance and\nAccountability Act 2013 (which deals with special accounts)."
    },
