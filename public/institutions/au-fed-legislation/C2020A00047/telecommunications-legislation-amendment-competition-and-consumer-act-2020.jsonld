    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-3-sec-360p-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "360P(7) Obligation of statutory infrastructure provider to connect",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-3-sec-360p-ss-7"
