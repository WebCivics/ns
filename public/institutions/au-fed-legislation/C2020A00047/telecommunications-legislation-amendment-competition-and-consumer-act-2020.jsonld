    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-competition-and-consumer-act-2020.pdf, p.147",
      "values:originalText": "•\nThe Secretary is responsible for entering into contracts, and\nmaking grants, relating to:\n\n(a)\nfixed wireless broadband; and\n\n(b)\nsatellite broadband.\n•\nThe ACMA will assess and collect the charge imposed on\ncarriers by the Telecommunications (Regional Broadband\nScheme) Charge Act 2020.\n•\nThe proceeds of the charge will be used to:\n\n(a)\npay contractors and grant recipients; and\n\nSchedule 4  Funding of fixed wireless broadband and satellite broadband\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(b)\noffset designated administrative costs.",
      "skos:definition": "•\nThe Secretary is responsible for entering into contracts, and\nmaking grants, relating to:\n\n(a)\nfixed wireless broadband; and\n\n(b)\nsatellite broadband.\n•\nThe ACMA will assess and collect the charge imposed on\ncarriers by the Telecommunications (Regional Broadband\nScheme) Charge Act 2020.\n•\nThe proceeds of the charge will be used to:\n\n(a)\npay contractors and grant recipients; and\n\nSchedule 4  Funding of fixed wireless broadband and satellite broadband\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(b)\noffset designated administrative costs.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-75-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-75-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6abbf5cb601fd55d9b925197edcb2e944ff4159ce047fe399a2fcff143006aad",
      "skos:note": "The Secretary is responsible for entering into contracts and making grants relating to fixed wireless broadband and satellite broadband."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 147,
      "values:originalText": "•\nThe Secretary is responsible for entering into contracts, and\nmaking grants, relating to:\n\n(a)\nfixed wireless broadband; and\n\n(b)\nsatellite broadband.\n•\nThe ACMA will assess and collect the charge imposed on\ncarriers by the Telecommunications (Regional Broadband\nScheme) Charge Act 2020.\n•\nThe proceeds of the charge will be used to:\n\n(a)\npay contractors and grant recipients; and\n\nSchedule 4  Funding of fixed wireless broadband and satellite broadband\n\nTelecommunications Legislation Amendment (Competition and\nConsumer) Act 2020\nNo. 47, 2020\n\n(b)\noffset designated administrative costs."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-75-norm",
