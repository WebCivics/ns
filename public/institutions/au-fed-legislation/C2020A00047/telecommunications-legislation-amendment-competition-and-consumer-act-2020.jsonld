      "cml:integrityHash": "1e644d2be74611643c59a1b77d7b2ed58af87b19c217eb63b5df3116033bd19f",
      "skos:note": "Assessment variation is taken as an assessment under section 102."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-102b-ss-2",
      "@type": "cof:Section",
      "cof:title": "102B(2) Variation of assessments",
      "values:kind": "subsection",
      "cof:pageNumber": 184,
      "values:originalText": "(2) Unless the contrary intention appears, a varied assessment is taken,\nfor the purposes of this Division, to be an assessment under\nsection 102."
    },
