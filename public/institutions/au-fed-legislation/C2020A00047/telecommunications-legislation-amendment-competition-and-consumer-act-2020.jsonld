          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-98-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-competition-and-consumer-act-2020-sch-4-sec-98-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b0218117dc426c9a4a8f76336eae16624a14ee53b7ea9b39f078d1e2baf455fd",
      "skos:note": "The amount specified in the certificate must not exceed certain limits."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-competition-and-consumer-act-2020#sch-4-sec-98-ss-4",
      "@type": "cof:Section",
      "cof:title": "98(4) Charge offset certificate",
      "values:kind": "subsection",
      "cof:pageNumber": 175,
      "values:originalText": "(4) The amount specified in the certificate:\n\n(a) must be the amount ascertained in accordance with rules\nmade under subsection (9); and\n\n(b) must not exceed the nominal funding entitlement of the\nperson for the next financial year; and\n\n(c) must not exceed the annual base amount of the person for the\ncharge financial year."
    },
