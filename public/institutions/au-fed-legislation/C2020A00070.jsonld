    {
      "@id": "concept:c2020a00070-sch-8-sec-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Rehabilitation program duration is necessary",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Sentence length should include time for rehabilitation program",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "In determining the length of any sentence or non-parole period—to include sufficient time for the person to undertake a rehabilitation program."
    },
    {
      "@id": "concept:c2020a00070-sch-8-sec-3-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Longer sentence length is implied by rehabilitation",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Rehabilitation implies longer sentence length",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:premiseText": "In determining the length of any sentence or non-parole period—to include sufficient time for the person to undertake a rehabilitation program."
    },
    {
      "@id": "concept:c2020a00070-sch-8-sec-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Rehabilitation is mandatory",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to rehabilitate",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "Court must consider rehabilitation when passing sentence."
    },
    {
      "@id": "concept:c2020a00070-sch-8-sec-3-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Rehabilitation is necessary for sentence duration",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Rehabilitation is a relevant factor in sentencing",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The court must have regard to the objective of rehabilitating the person"
    },
    {
      "@id": "concept:c2020a00070-sch-8-sec-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Rehabilitation is necessary for sentence duration",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Sentence should be long enough for rehabilitation",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": ">=",
      "cml:premiseText": "In determining the length of any sentence or non-parole period—to include sufficient time for the person to undertake a rehabilitation program."
