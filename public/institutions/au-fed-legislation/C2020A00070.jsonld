    {
      "@id": "concept:c2020a00070-sch-4-sec-474-3-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A person (the sender) commits an offence if:...",
      "cml:confidence": {
