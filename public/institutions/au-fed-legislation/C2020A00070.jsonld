    {
      "@id": "concept:c2020a00070-sch-4-sec-272-2-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2020a00070.pdf, p.16",
      "skos:note": "Engaging in conduct to make a child under 16 engage in sexual activity outside Australia is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "272(1) Section 272"
      },
      "wasDerivedFrom": "c2020a00070.pdf",
      "asserts": [
        "concept:c2020a00070-sch-4-sec-272-2-ss-1-norm",
        "concept:c2020a00070-sch-4-sec-272-2-ss-1-logic-deontic-1",
        "concept:c2020a00070-sch-4-sec-272-2-ss-1-logic-deontic-2",
        "concept:c2020a00070-sch-4-sec-272-2-ss-1-logic-deontic-3"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "b01b210946b042a720835444b8fe7e1d52f8b65b6220f07bce11ad4a486a9c33",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2020a00070#sch-4-sec-272-2-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:c2020a00070-sch-4-sec-272-2"
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-272-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The defendant commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits engaging in conduct to make a child under 16 engage in sexual activity outside Australia.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the defendant engages in conduct in relation to another person (the third party); and (b) the defendant does so with the intention of making it easier to procure a person (the child) to engage in sexual activity (whether or not with the defendant) outside Australia;"
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-272-2-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The defendant commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits engaging in conduct to make a child under 16 engage in sexual activity inside Australia.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(d) one or more of the following apply: (i) the conduct referred to in paragraph (a) occurs wholly or partly outside Australia;"
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-272-2-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The defendant commits an offence if...",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits engaging in conduct to make a child under 16 engage in sexual activity with the third party inside Australia.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(iii) the conduct referred to in paragraph (a) occurs wholly in Australia and both the third party and the child are in Australia when that conduct occurs."
    },
