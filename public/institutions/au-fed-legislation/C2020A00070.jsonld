      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The offence is registrable if it meets this condition.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
