      },
      "cml:operator": "BETWEEN",
      "cml:premiseText": "(a) the age and maturity of the person in relation to whom the offence was committed;"
    },
    {
      "@id": "concept:c2020a00070-sch-9-sec-474-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
