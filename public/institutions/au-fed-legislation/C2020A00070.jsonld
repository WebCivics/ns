    {
      "@id": "concept:c2020a00070-sch-9-sec-474-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2020a00070.pdf, p.46",
      "skos:note": "Court must consider age and maturity of the person in relation to whom the offence was committed when determining sentence.",
