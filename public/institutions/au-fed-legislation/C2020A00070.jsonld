        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits sending unsolicited sexual messages to minors.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:premiseText": "(a) the sender uses a carriage service to transmit a communication to another person (the recipient); and (b) the sender does this with the intention of making it easier to procure a person (the child) to engage in sexual activity with the sender; and (c) the child is someone who is, or who the sender believes to be, under 16 years of age;"
    },
