concept:c2020a00070-sch-13-sec-4 a cml:Concept ;
    skos:prefLabel "4 Subsection 19APB(2)"@en ;
    cml:realizedBy doc:sch-13-sec-4 ;
    values:originalText "Repeal the subsection, substitute:  (2) Subsection (1) has effect as if the parole period or the licence period had not ended without the parole order or licence being revoked, if in relation to the parole order or licence:  (a) a determination referred to in subsection 19AQ(1) or (2) is made at a time after the end of the parole period or licence period; and  Revocation of parole order or licence  Schedule 13  No. 70, 2020 Crimes Legislation Amendment (Sexual Crimes Against Children and Community Protection Measures) Act 2020  (b) the time the parole order or licence is taken to have been revoked under subsection 19AQ(1) or (2) is during the parole period or licence period." ;
    skos:definition "Repeal the subsection, substitute:  (2) Subsection (1) has effect as if the parole period or the licence period had not ended without the parole order or licence being revoked, if in relation to the parole order or licence:  (a) a determination referred to in subsection 19AQ(1) or (2) is made at a time after the end of the parole period or licence period; and  Revocation of parole order or licence  Schedule 13  No. 70, 2020 Crimes Legislation Amendment (Sexual Crimes Against Children and Community Protection Measures) Act 2020  (b) the time the parole order or licence is taken to have been revoked under subsection 19AQ(1) or (2) is during the parole period or licence period."@en ;
    cml:integrityHash "2484e058877ff56824e0813107e34c252e8d4fc37da84c6571443c91b3308744" ;
    cof:pageNumber "52"^^xsd:integer ;
    skos:note "Repeal subsection, substitute with new effect for parole order or licence revocation" ;
    cml:curationStatus cml:Proposed ;
