    cml:conclusionText "...other than an offence against subsection 272.8(1) or (2), 272.9(1) or (2), section 272.10, 272.11" ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

