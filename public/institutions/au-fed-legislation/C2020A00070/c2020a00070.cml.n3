concept:c2020a00070-sch-10-sec-2-ss-7 a cml:Concept ;
    skos:prefLabel "2(7) At the end of section 19"@en ;
    cml:realizedBy doc:sch-10-sec-2-ss-7 ;
    values:originalText "(7) If the court imposes a term of imprisonment other than in accordance with subsection (5), the court must:  (a) state its reasons for imposing the sentence in that manner; and  (b) cause the reasons to be entered in the records of the court." ;
    skos:definition "(7) If the court imposes a term of imprisonment other than in accordance with subsection (5), the court must:  (a) state its reasons for imposing the sentence in that manner; and  (b) cause the reasons to be entered in the records of the court."@en ;
    cml:integrityHash "fad0e8b0b12895e68dd09f7c017abb6be05275d8f8a1bce4ee4a3742dacb5e21" ;
    values:partOf concept:c2020a00070-sch-10-sec-2 ;
    cof:pageNumber "48"^^xsd:integer ;
