concept:c2020a00070-sch-7-sec-4-ss-4 a cml:Concept ;
    skos:prefLabel "4(4) After section 15AA"@en ;
    cml:realizedBy doc:sch-7-sec-4-ss-4 ;
    values:originalText "(4) Despite any law of the Commonwealth, the Director of Public Prosecutions or the person may appeal against a decision of a bail authority:  (a) to grant bail to the person despite subsection (1) on the basis that the bail authority is satisfied that circumstances exist to grant bail; or  (b) to refuse to grant bail to the person on the basis that the bail authority is not satisfied that circumstances exist to grant bail." ;
    skos:definition "(4) Despite any law of the Commonwealth, the Director of Public Prosecutions or the person may appeal against a decision of a bail authority:  (a) to grant bail to the person despite subsection (1) on the basis that the bail authority is satisfied that circumstances exist to grant bail; or  (b) to refuse to grant bail to the person on the basis that the bail authority is not satisfied that circumstances exist to grant bail."@en ;
    cml:integrityHash "a244b2bfbd2c64f1bef6fedde9aa55f511467f7f11e6accaaca3f204112e2bec" ;
    values:partOf concept:c2020a00070-sch-7-sec-4 ;
