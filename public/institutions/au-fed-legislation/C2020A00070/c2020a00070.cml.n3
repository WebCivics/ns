concept:c2020a00070-sch-6-sec-7 a cml:Concept ;
    skos:prefLabel "7 Saving provision"@en ;
    cml:realizedBy doc:sch-6-sec-7 ;
    values:originalText "An instrument in force immediately before the commencement of this item, that was made for the purposes of a provision of the Crimes Act 1914 referred to in column 1 of an item in the following table, remains in force on and after that commencement as if it had been made for the purposes of the provision of that Act referred to in column 2 of that item.  Saving of instruments Item Column 1 Old provision Column 2 Renumbered provision Subsection 16AAA(3) Subsection 16AAAA(3) Subsection 16AAA(4) Subsection 16AAAA(4)   Schedule 6  Minimum sentences" ;
    skos:definition "An instrument in force immediately before the commencement of this item, that was made for the purposes of a provision of the Crimes Act 1914 referred to in column 1 of an item in the following table, remains in force on and after that commencement as if it had been made for the purposes of the provision of that Act referred to in column 2 of that item.  Saving of instruments Item Column 1 Old provision Column 2 Renumbered provision Subsection 16AAA(3) Subsection 16AAAA(3) Subsection 16AAA(4) Subsection 16AAAA(4)   Schedule 6  Minimum sentences"@en ;
    cml:integrityHash "364c1006368ed5a5297c3ecefb71da27ee49829155d6b723ec5238c7c685fb34" ;
    cof:pageNumber "37"^^xsd:integer ;
    skos:note "Saving provision for instruments in force before commencement" ;
