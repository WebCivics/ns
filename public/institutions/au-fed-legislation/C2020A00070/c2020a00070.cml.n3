doc:sch-8-sec-1 a cof:Section ;
    cof:title "1 Paragraph 16A(2)(g)" ;
    values:kind "section" ;
    values:originalText "Repeal the paragraph, substitute:  (g) if the person has pleaded guilty to the charge in respect of the offence:  (i) that fact; and  (ii) the timing of the plea; and  (iii) the degree to which that fact and the timing of the plea resulted in any benefit to the community, or any victim of, or witness to, the offence;" ;
    cof:pageNumber "43"^^xsd:integer .

concept:c2020a00070-sch-8-sec-2 a cml:Concept ;
    skos:prefLabel "2 After paragraph 16A(2)(m)"@en ;
    cml:realizedBy doc:sch-8-sec-2 ;
    values:originalText "Insert:  (ma) if the person’s standing in the community was used by the person to aid in the commission of the offence—that fact as a reason for aggravating the seriousness of the criminal behaviour to which the offence relates;" ;
    skos:definition "Insert:  (ma) if the person’s standing in the community was used by the person to aid in the commission of the offence—that fact as a reason for aggravating the seriousness of the criminal behaviour to which the offence relates;"@en ;
    cml:integrityHash "c582317e6245c96ed66b96b641a6f0d79dcc36d935c321013340e18f296a694c" ;
    cof:pageNumber "43"^^xsd:integer ;
    skos:note "Aggravating seriousness of criminal behaviour based on community standing used to aid in commission of offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
