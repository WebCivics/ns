    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Obligation to rehabilitate" ;
    cml:premiseText "Court must consider rehabilitation when passing sentence." ;
    cml:conclusionText "Rehabilitation is mandatory" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-8-sec-3 cml:asserts concept:c2020a00070-sch-8-sec-3-logic-alleninterval-2 .
