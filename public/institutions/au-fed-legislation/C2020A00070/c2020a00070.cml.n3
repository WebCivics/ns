    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Sentence length should include time for rehabilitation program" ;
    cml:premiseText "In determining the length of any sentence or non-parole period—to include sufficient time for the person to undertake a rehabilitation program." ;
    cml:conclusionText "Rehabilitation program duration is necessary" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-8-sec-3 cml:asserts concept:c2020a00070-sch-8-sec-3-logic-ltl-3 .
