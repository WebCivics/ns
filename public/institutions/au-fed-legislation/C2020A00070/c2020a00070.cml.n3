concept:c2020a00070-sch-3-sec-5 a cml:Concept ;
    skos:prefLabel "5 At the end of Division 3 of Part IAD"@en ;
    cml:realizedBy doc:sch-3-sec-5 ;
    values:originalText "Add: 15YHA  Committal proceedings—cross-examination of vulnerable persons  (1) A person is not to cross-examine, at committal proceedings or proceedings of a similar kind, a person to whom subsection (2) applies.  (2) This subsection applies to the following persons:  (a) for a child proceeding—a child witness;  Schedule 3  Cross-examination of vulnerable persons at committal proceedings  Crimes Legislation Amendment (Sexual Crimes Against Children and Community Protection Measures) Act 2020 No. 70, 2020  (b) for a vulnerable adult proceeding—a vulnerable adult complainant;  (c) for a special witness proceeding—a special witness for whom an order under subsection 15YAB(3) is in force for this section." ;
    skos:definition "Add: 15YHA  Committal proceedings—cross-examination of vulnerable persons  (1) A person is not to cross-examine, at committal proceedings or proceedings of a similar kind, a person to whom subsection (2) applies.  (2) This subsection applies to the following persons:  (a) for a child proceeding—a child witness;  Schedule 3  Cross-examination of vulnerable persons at committal proceedings  Crimes Legislation Amendment (Sexual Crimes Against Children and Community Protection Measures) Act 2020 No. 70, 2020  (b) for a vulnerable adult proceeding—a vulnerable adult complainant;  (c) for a special witness proceeding—a special witness for whom an order under subsection 15YAB(3) is in force for this section."@en ;
    cml:integrityHash "0eb32068e18b6718fb0c2020ed0268c69e8be418f6c2f359aa60bf39a460d5ed" ;
    cof:pageNumber "13"^^xsd:integer ;
    cml:hasPart concept:c2020a00070-sch-3-sec-5-ss-1 ;
    cml:hasPart concept:c2020a00070-sch-3-sec-5-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2020a00070.pdf> ;
