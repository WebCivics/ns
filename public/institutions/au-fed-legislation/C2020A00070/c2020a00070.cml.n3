doc:sch-13-sec-19aq-ss-1 a cof:Section ;
    cof:title "19AQ(1) Parole order or licence revoked following further offence" ;
    values:kind "subsection" ;
    values:originalText "(1) If a person to whom a parole order relates is sentenced to life imprisonment or to a sentence of, or sentences aggregating, more than 3 months in respect of a federal, State or Territory offence (the new offence) committed during the parole period, the court that sentences the person for the new offence must determine the time (the revocation time) when the parole order is taken to have been revoked." ;
    cof:pageNumber "53"^^xsd:integer .

concept:c2020a00070-sch-13-sec-19aq-ss-2 a cml:Concept ;
    skos:prefLabel "19AQ(2) Parole order or licence revoked following further offence"@en ;
    cml:realizedBy doc:sch-13-sec-19aq-ss-2 ;
    values:originalText "(2) If a person to whom a licence relates is sentenced to life imprisonment or to a sentence of, or sentences aggregating, more than 3 months in respect of a federal, State or Territory offence (the new offence) committed during the licence period, the court that sentences the person for the new offence must determine the time (the revocation time) when the licence is taken to have been revoked." ;
    skos:definition "(2) If a person to whom a licence relates is sentenced to life imprisonment or to a sentence of, or sentences aggregating, more than 3 months in respect of a federal, State or Territory offence (the new offence) committed during the licence period, the court that sentences the person for the new offence must determine the time (the revocation time) when the licence is taken to have been revoked."@en ;
    cml:integrityHash "38ff81b744d51be0325c1aa5fdd17e0e53ce9615ed63068b20dec0d5ee1937a7" ;
    values:partOf concept:c2020a00070-sch-13-sec-19aq ;
    cof:pageNumber "53"^^xsd:integer ;
    skos:note "Court must determine revocation time for licence." ;
    cml:curationStatus cml:Proposed ;
