concept:c2020a00070-sch-6-sec-2 cml:asserts concept:c2020a00070-sch-6-sec-2-logic-deontic-1 .
concept:c2020a00070-sch-6-sec-2-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Imposes a sentence of imprisonment" ;
    cml:premiseText "If a person is convicted of an offence..." ;
    cml:conclusionText "The court must impose a sentence of imprisonment" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-6-sec-2 cml:asserts concept:c2020a00070-sch-6-sec-2-logic-alleninterval-2 .
concept:c2020a00070-sch-6-sec-2-logic-alleninterval-2 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Specifies the minimum sentence for each offence" ;
    cml:premiseText "offence against subsection 272.8(1) of the Criminal Code 6 years..." ;
    cml:conclusionText "The minimum sentence is at least 6 years" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-6-sec-2 cml:asserts concept:c2020a00070-sch-6-sec-2-logic-argumentation-3 .
concept:c2020a00070-sch-6-sec-2-logic-argumentation-3 a cml:LogicApplication ;
    cml:modality cml:Argumentation ;
    cml:operator "IMPLIES" ;
    cml:logicSummary "Establishes a causal relationship between the offence and the penalty" ;
    cml:premiseText "If a person is convicted of an offence..." ;
    cml:conclusionText "The court must impose a sentence of imprisonment based on the offence" ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2020a00070-sch-6-sec-2 cml:asserts concept:c2020a00070-sch-6-sec-2-logic-diffusion-4 .
concept:c2020a00070-sch-6-sec-2-logic-diffusion-4 a cml:LogicApplication ;
    cml:modality cml:Diffusion ;
    cml:operator "IS-SPREAD-TO" ;
    cml:logicSummary "Applies to all persons convicted of the specified offences" ;
    cml:premiseText "Subject to section 16AAC..." ;
    cml:conclusionText "The minimum penalty applies to all persons convicted of the offence" ;
    cml:executionSurface "modalities::diffusion" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

