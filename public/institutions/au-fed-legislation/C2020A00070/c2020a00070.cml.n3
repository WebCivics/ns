concept:c2020a00070-sch-6-sec-2 a cml:Concept ;
    skos:prefLabel "2 After section 16AA"@en ;
    cml:realizedBy doc:sch-6-sec-2 ;
    values:originalText "Insert: 16AAA  Minimum penalties for certain offences  Subject to section 16AAC, if a person is convicted of an offence described in column 1 of an item in the following table, the court must impose a sentence of imprisonment of at least the period specified in column 2 of that item.  Minimum penalty Item Column 1 Offence Column 2 Sentence of imprisonment offence against subsection 272.8(1) of the Criminal Code 6 years offence against subsection 272.8(2) of the Criminal Code 6 years offence against subsection 272.9(1) of the Criminal Code 5 years offence against subsection 272.9(2) of the Criminal Code 5 years offence against section 272.10 of the Criminal Code 7 years offence against section 272.11 of the Criminal Code 7 years offence against section 272.18 of the 6 years  Schedule 6  Minimum sentences" ;
    skos:definition "Insert: 16AAA  Minimum penalties for certain offences  Subject to section 16AAC, if a person is convicted of an offence described in column 1 of an item in the following table, the court must impose a sentence of imprisonment of at least the period specified in column 2 of that item.  Minimum penalty Item Column 1 Offence Column 2 Sentence of imprisonment offence against subsection 272.8(1) of the Criminal Code 6 years offence against subsection 272.8(2) of the Criminal Code 6 years offence against subsection 272.9(1) of the Criminal Code 5 years offence against subsection 272.9(2) of the Criminal Code 5 years offence against section 272.10 of the Criminal Code 7 years offence against section 272.11 of the Criminal Code 7 years offence against section 272.18 of the 6 years  Schedule 6  Minimum sentences"@en ;
    cml:integrityHash "63525e89dfa5cfbde7b4af70a7a493b5b7ad67afd0b6676807fd5301ad358639" ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Minimum penalties for certain offences" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
