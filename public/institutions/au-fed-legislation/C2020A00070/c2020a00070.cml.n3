concept:c2020a00070-sch-11-sec-3 a cml:Concept ;
    skos:prefLabel "3 After subsection 20(1A)"@en ;
    cml:realizedBy doc:sch-11-sec-3 ;
    values:originalText "Insert:  (1B) If at least one of the offences the person is convicted of is a Commonwealth child sex offence, the court must specify under paragraph (1)(b), as mentioned in subparagraph (1)(a)(iv), the conditions that the person will, during the specified period:  (a) be subject to the supervision of a probation officer appointed in accordance with the order; and  (b) obey all reasonable directions of the probation officer; and  Schedule 11  Conditional release of offenders after conviction  Crimes Legislation Amendment (Sexual Crimes Against Children and Community Protection Measures) Act 2020 No. 70, 2020  (c) not travel interstate or overseas without the written permission of the probation officer; and  (d) undertake such treatment or rehabilitation programs that the probation officer reasonably directs." ;
    skos:definition "Insert:  (1B) If at least one of the offences the person is convicted of is a Commonwealth child sex offence, the court must specify under paragraph (1)(b), as mentioned in subparagraph (1)(a)(iv), the conditions that the person will, during the specified period:  (a) be subject to the supervision of a probation officer appointed in accordance with the order; and  (b) obey all reasonable directions of the probation officer; and  Schedule 11  Conditional release of offenders after conviction  Crimes Legislation Amendment (Sexual Crimes Against Children and Community Protection Measures) Act 2020 No. 70, 2020  (c) not travel interstate or overseas without the written permission of the probation officer; and  (d) undertake such treatment or rehabilitation programs that the probation officer reasonably directs."@en ;
    cml:integrityHash "3c9eb60d9727a6274c912cb146887e59d8f3b3133b35866025fe811041893f1f" ;
    cof:pageNumber "49"^^xsd:integer ;
    skos:note "Probation conditions for offenders convicted of Commonwealth child sex offences" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
