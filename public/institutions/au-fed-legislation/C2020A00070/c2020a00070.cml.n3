doc:sch-9-sec-474-ss-1 a cof:Section ;
    cof:title "474(1) 29AA  Sentencing" ;
    values:kind "subsection" ;
    values:originalText "(1) In determining the sentence to be passed, or the order to be made, in respect of a person for an offence against this Subdivision, the court must take into account the following matters:  (a) the age and maturity of the person in relation to whom the offence was committed;  (b) if that person was under 10 when the offence was committed—that fact as a reason for aggravating the seriousness of the criminal behaviour to which the offence relates;  (c) the number of people involved in the commission of the offence." ;
    cof:pageNumber "46"^^xsd:integer .

concept:c2020a00070-sch-9-sec-474-ss-2 a cml:Concept ;
    skos:prefLabel "474(2) 29AA  Sentencing"@en ;
    cml:realizedBy doc:sch-9-sec-474-ss-2 ;
    values:originalText "(2) However, the court need only take into account a matter mentioned in subsection (1) so far as the matter is known to the court and, for a matter mentioned in paragraph (1)(a) or (c), relevant." ;
    skos:definition "(2) However, the court need only take into account a matter mentioned in subsection (1) so far as the matter is known to the court and, for a matter mentioned in paragraph (1)(a) or (c), relevant."@en ;
    cml:integrityHash "5a2f4156774f6f8cf2c40321c597e64216eec8a6a7639e7be7abdac77ca62151" ;
    values:partOf concept:c2020a00070-sch-9-sec-474 ;
