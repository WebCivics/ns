    {
      "@id": "concept:c2020a00070-sch-3-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 At the end of Division 3 of Part IAD",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-3-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.13",
      "values:originalText": "Add:\n15YHA  Committal proceedings—cross-examination of vulnerable\npersons\n\n(1) A person is not to cross-examine, at committal proceedings or\nproceedings of a similar kind, a person to whom subsection (2)\napplies.\n\n(2) This subsection applies to the following persons:\n\n(a) for a child proceeding—a child witness;\n\nSchedule 3  Cross-examination of vulnerable persons at committal proceedings\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness for whom\nan order under subsection 15YAB(3) is in force for this\nsection.",
      "skos:definition": "Add:\n15YHA  Committal proceedings—cross-examination of vulnerable\npersons\n\n(1) A person is not to cross-examine, at committal proceedings or\nproceedings of a similar kind, a person to whom subsection (2)\napplies.\n\n(2) This subsection applies to the following persons:\n\n(a) for a child proceeding—a child witness;\n\nSchedule 3  Cross-examination of vulnerable persons at committal proceedings\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020\n\n(b) for a vulnerable adult proceeding—a vulnerable adult\ncomplainant;\n\n(c) for a special witness proceeding—a special witness for whom\nan order under subsection 15YAB(3) is in force for this\nsection.",
      "cml:hasPart": [
        {
          "@id": "concept:c2020a00070-sch-3-sec-5-ss-1"
        },
        {
          "@id": "concept:c2020a00070-sch-3-sec-5-ss-2"
        }
      ],
      "cml:integrityHash": "0eb32068e18b6718fb0c2020ed0268c69e8be418f6c2f359aa60bf39a460d5ed"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-3-sec-5",
