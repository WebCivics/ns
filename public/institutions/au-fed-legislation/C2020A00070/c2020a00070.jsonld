    {
      "@id": "concept:c2020a00070-sch-4-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Subsection 474.25A(1) of the Criminal Code (before the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.22",
      "values:originalText": "penalty)\nInsert:\nNote:\nBecause of the definition of engage in sexual activity in the\nDictionary, this offence covers (for example):\n(a) a person using a carriage service to see or hear, in real time, a\nperson under 16 engage in sexual activity; and\n(b) a person engaging in sexual activity that is seen or heard, in real\ntime, by a person under 16 using a carriage service.",
      "skos:definition": "penalty)\nInsert:\nNote:\nBecause of the definition of engage in sexual activity in the\nDictionary, this offence covers (for example):\n(a) a person using a carriage service to see or hear, in real time, a\nperson under 16 engage in sexual activity; and\n(b) a person engaging in sexual activity that is seen or heard, in real\ntime, by a person under 16 using a carriage service.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-4-sec-25-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-25-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c86588316c66fa6404f244547d72b8eaf1a4320c3191222a54af5d7650878a56",
      "skos:note": "Prohibits using a carriage service to see or hear a person under 16 engage in sexual activity."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Subsection 474.25A(1) of the Criminal Code (before the",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "penalty)\nInsert:\nNote:\nBecause of the definition of engage in sexual activity in the\nDictionary, this offence covers (for example):\n(a) a person using a carriage service to see or hear, in real time, a\nperson under 16 engage in sexual activity; and\n(b) a person engaging in sexual activity that is seen or heard, in real\ntime, by a person under 16 using a carriage service."
    },
