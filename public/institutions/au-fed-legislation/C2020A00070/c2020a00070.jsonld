    },
    {
      "@id": "concept:c2020a00070-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.10",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nRevocation of parole order or licence to protect safety  Schedule 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nRevocation of parole order or licence to protect safety  Schedule 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "ab41a085372e6266b7b8a48c8055985f82fdf251d8af322003c8976161331ad0",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nRevocation of parole order or licence to protect safety  Schedule 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020"
    },
    {
      "@id": "concept:c2020a00070-sec-3-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2020a00070-sec-3-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2020a00070-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After paragraph 19AU(3)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.11",
      "values:originalText": "Insert:\n\n(ba) in the opinion of the Attorney-General it is necessary to\nrevoke the parole order or licence without giving notice to\nthe person in the interests of ensuring the safety and\nprotection of the community or of another person; or",
      "skos:definition": "Insert:\n\n(ba) in the opinion of the Attorney-General it is necessary to\nrevoke the parole order or licence without giving notice to\nthe person in the interests of ensuring the safety and\nprotection of the community or of another person; or",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-1-sec-1-norm"
        },
