    {
      "@id": "concept:c2020a00070-sch-8-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Paragraph 16A(2)(g)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-8-sec-1"
