    {
      "@id": "concept:c2020a00070-sch-4-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Subsections 471.27(3) and (4) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.19",
      "values:originalText": "Repeal the subsections, substitute:\nProof of belief about age—evidence of representation\n\n(3) For the purposes of this Subdivision, evidence that a person was\nrepresented to the defendant as being under, of, at least or over a\nparticular age is, in the absence of evidence to the contrary, proof\nthat the defendant believed the person to be under, of, at least or\nover that age (as the case requires).",
      "skos:definition": "Repeal the subsections, substitute:\nProof of belief about age—evidence of representation\n\n(3) For the purposes of this Subdivision, evidence that a person was\nrepresented to the defendant as being under, of, at least or over a\nparticular age is, in the absence of evidence to the contrary, proof\nthat the defendant believed the person to be under, of, at least or\nover that age (as the case requires).",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-4-sec-13-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5216c2a48f37775ac4cf2c7c8f8b6c369b16de323262eef2f963b3b55f6de36b",
      "skos:note": "Proof of belief about age is evidence that the defendant believed the person to be under, of, at least or over a particular age."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Subsections 471.27(3) and (4) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Repeal the subsections, substitute:\nProof of belief about age—evidence of representation\n\n(3) For the purposes of this Subdivision, evidence that a person was\nrepresented to the defendant as being under, of, at least or over a\nparticular age is, in the absence of evidence to the contrary, proof\nthat the defendant believed the person to be under, of, at least or\nover that age (as the case requires)."
    },
