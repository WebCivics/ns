    {
      "@id": "concept:c2020a00070-sch-4-sec-474-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "474 27A, evidence that a person was represented to the defendant",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-474-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
