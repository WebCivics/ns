      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of electronic service creation, development, alteration or maintenance",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) creating, developing, altering or maintaining an\nelectronic service;"
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-474-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of electronic service control or moderation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) controlling or moderating an electronic service;"
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-474-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of electronic service advertising or promotion",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(iii) making available, advertising or promoting an\nelectronic service;"
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-474-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of assisting in doing anything covered by a preceding subparagraph",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(iv) assisting in doing anything covered by a preceding\nsubparagraph;"
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-474-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "474(2) 23A  Conduct for the purposes of electronic service used for",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-474-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.20",
      "values:originalText": "(2) A person may be found guilty of an offence against subsection (1)\neven if:\n\n(a) committing the offence against section 474.22 or 474.23 is\nimpossible; or\n\n(b) the electronic service is incapable of being used as mentioned\nin paragraph (1)(b):\n\n(i) at the time the person engages in the conduct mentioned\nin paragraph (1)(a); or\n\n(ii) at any other time.",
      "skos:definition": "(2) A person may be found guilty of an offence against subsection (1)\neven if:\n\n(a) committing the offence against section 474.22 or 474.23 is\nimpossible; or\n\n(b) the electronic service is incapable of being used as mentioned\nin paragraph (1)(b):\n\n(i) at the time the person engages in the conduct mentioned\nin paragraph (1)(a); or\n\n(ii) at any other time.",
      "values:partOf": {
        "@id": "concept:c2020a00070-sch-4-sec-474"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-4-sec-474-ss-2-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-474-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-474-ss-2-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "50cf06df568ce4a4ad18dbdc07783c752d16c9c78cba7d08988175b1febfc756",
      "skos:note": "A person may be found guilty of an offence even if the electronic service is impossible or incapable."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-474-ss-2",
      "@type": "cof:Section",
      "cof:title": "474(2) 23A  Conduct for the purposes of electronic service used for",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(2) A person may be found guilty of an offence against subsection (1)\neven if:\n\n(a) committing the offence against section 474.22 or 474.23 is\nimpossible; or\n\n(b) the electronic service is incapable of being used as mentioned\nin paragraph (1)(b):\n\n(i) at the time the person engages in the conduct mentioned\nin paragraph (1)(a); or\n\n(ii) at any other time."
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-474-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2020a00070-sch-4-sec-474-ss-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-474-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Impossibility does not excuse an obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The electronic service is impossible.",
      "cml:conclusionText": "A person may be found guilty of an offence."
    },
    {
      "@id": "concept:c2020a00070-sch-4-sec-474-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Incapability does not negate permission.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The electronic service is incapable.",
      "cml:conclusionText": "A person may engage in the conduct."
    },
    {
