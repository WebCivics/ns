      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2020a00070-sch-9-sec-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to consider only known matters.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Court must take into account a matter mentioned in subsection (1) so far as the matter is known to the court.",
      "cml:conclusionText": "The court need only take into account a matter mentioned in subsection (1) so far as the matter is known to the court and, for a matter mentioned in paragraph (1)(a) or (c), relevant."
    },
