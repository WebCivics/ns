      },
      "dc:source": "c2020a00070.pdf, p.43",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(g) if the person has pleaded guilty to the charge in respect of the\noffence:\n\n(i) that fact; and\n\n(ii) the timing of the plea; and\n\n(iii) the degree to which that fact and the timing of the plea\nresulted in any benefit to the community, or any victim\nof, or witness to, the offence;",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(g) if the person has pleaded guilty to the charge in respect of the\noffence:\n\n(i) that fact; and\n\n(ii) the timing of the plea; and\n\n(iii) the degree to which that fact and the timing of the plea\nresulted in any benefit to the community, or any victim\nof, or witness to, the offence;",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-8-sec-1-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-8-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9366de461f04925c8ae5c40f03120081d31a1145cf1cfb143add3e8c7d065cd6",
      "skos:note": "Repeal paragraph and substitute with new obligation"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-8-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Paragraph 16A(2)(g)",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(g) if the person has pleaded guilty to the charge in respect of the\noffence:\n\n(i) that fact; and\n\n(ii) the timing of the plea; and\n\n(iii) the degree to which that fact and the timing of the plea\nresulted in any benefit to the community, or any victim\nof, or witness to, the offence;"
    },
