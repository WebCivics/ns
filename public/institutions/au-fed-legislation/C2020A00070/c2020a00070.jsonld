      },
      "dc:source": "c2020a00070.pdf, p.47",
      "values:originalText": "The amendments made by this Schedule apply in determining the\nsentence to be passed, or the order to be made, in respect of a person for\nan offence that is committed on or after the commencement of this item.\n\nSchedule 10  Cumulative sentences\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020",
      "skos:definition": "The amendments made by this Schedule apply in determining the\nsentence to be passed, or the order to be made, in respect of a person for\nan offence that is committed on or after the commencement of this item.\n\nSchedule 10  Cumulative sentences\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-9-sec-5-norm"
        }
      ],
      "cml:integrityHash": "7b9262865c172ed4a3c81f74d1beecad74351d4174e8bb727f8e08e7f6d4c3fc",
      "skos:note": "Amendments apply to sentence determination after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-9-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 47,
      "values:originalText": "The amendments made by this Schedule apply in determining the\nsentence to be passed, or the order to be made, in respect of a person for\nan offence that is committed on or after the commencement of this item.\n\nSchedule 10  Cumulative sentences\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020"
    },
