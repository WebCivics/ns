    {
      "@id": "concept:c2020a00070-sch-8-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-8-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.44",
      "values:originalText": "The amendments made by this Schedule apply in relation to\ndetermining, on or after the commencement of this Schedule, a sentence\nto be passed, or an order to be made, in respect of a person for a federal\noffence that the person was charged with, or convicted of, on or after\nthat commencement.\n\nAdditional sentencing factors for certain offences  Schedule 9\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "skos:definition": "The amendments made by this Schedule apply in relation to\ndetermining, on or after the commencement of this Schedule, a sentence\nto be passed, or an order to be made, in respect of a person for a federal\noffence that the person was charged with, or convicted of, on or after\nthat commencement.\n\nAdditional sentencing factors for certain offences  Schedule 9\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-8-sec-7-norm"
        }
      ],
      "cml:integrityHash": "2846bf3cf048ceff2be6f04a2f57102b9b1469e536372867ef8ba934a72ce07a",
      "skos:note": "Application provision for amendments made by this Schedule"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-8-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "The amendments made by this Schedule apply in relation to\ndetermining, on or after the commencement of this Schedule, a sentence\nto be passed, or an order to be made, in respect of a person for a federal\noffence that the person was charged with, or convicted of, on or after\nthat commencement.\n\nAdditional sentencing factors for certain offences  Schedule 9\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020"
    },
    {
      "@id": "concept:c2020a00070-sch-8-sec-7-norm",
