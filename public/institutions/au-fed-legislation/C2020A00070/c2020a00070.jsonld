    {
      "@id": "concept:c2020a00070-sch-12-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-12-sec-3"
      },
      "cml:curationStatus": {
