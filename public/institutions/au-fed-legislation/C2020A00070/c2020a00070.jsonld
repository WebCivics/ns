      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Prescribed authority has an obligation to consider parole time.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
