    {
      "@id": "concept:c2020a00070-sch-13-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Subsection 19APB(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-13-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.52",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) Subsection (1) has effect as if the parole period or the licence\nperiod had not ended without the parole order or licence being\nrevoked, if in relation to the parole order or licence:\n\n(a) a determination referred to in subsection 19AQ(1) or (2) is\nmade at a time after the end of the parole period or licence\nperiod; and\n\nRevocation of parole order or licence  Schedule 13\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\n\n(b) the time the parole order or licence is taken to have been\nrevoked under subsection 19AQ(1) or (2) is during the parole\nperiod or licence period.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) Subsection (1) has effect as if the parole period or the licence\nperiod had not ended without the parole order or licence being\nrevoked, if in relation to the parole order or licence:\n\n(a) a determination referred to in subsection 19AQ(1) or (2) is\nmade at a time after the end of the parole period or licence\nperiod; and\n\nRevocation of parole order or licence  Schedule 13\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\n\n(b) the time the parole order or licence is taken to have been\nrevoked under subsection 19AQ(1) or (2) is during the parole\nperiod or licence period.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-13-sec-4-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-13-sec-4-logic-deontic-1"
        },
        {
          "@id": "concept:c2020a00070-sch-13-sec-4-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "2484e058877ff56824e0813107e34c252e8d4fc37da84c6571443c91b3308744",
      "skos:note": "Repeal subsection, substitute with new effect for parole order or licence revocation"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-13-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsection 19APB(2)",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) Subsection (1) has effect as if the parole period or the licence\nperiod had not ended without the parole order or licence being\nrevoked, if in relation to the parole order or licence:\n\n(a) a determination referred to in subsection 19AQ(1) or (2) is\nmade at a time after the end of the parole period or licence\nperiod; and\n\nRevocation of parole order or licence  Schedule 13\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\n\n(b) the time the parole order or licence is taken to have been\nrevoked under subsection 19AQ(1) or (2) is during the parole\nperiod or licence period."
    },
    {
      "@id": "concept:c2020a00070-sch-13-sec-4-norm",
