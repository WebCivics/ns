    {
      "@id": "concept:c2020a00070-sch-6-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 At the end of subsection 16A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-6-sec-1"
      },
      "cml:curationStatus": {
