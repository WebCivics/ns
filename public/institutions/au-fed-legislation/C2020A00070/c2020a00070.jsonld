    {
      "@id": "concept:c2020a00070-sch-4-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Paragraph 272.10(1)(b) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.15",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) one or more of the following apply:\n\n(i) the child has a mental impairment at the time the person\ncommits the underlying offence;\n\n(ii) the person is in a position of trust or authority in relation\nto the child, or the child is otherwise under the care,\nsupervision or authority of the person, at the time the\nperson commits the underlying offence;\n\nSchedule 4  Strengthening child sex offences",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) one or more of the following apply:\n\n(i) the child has a mental impairment at the time the person\ncommits the underlying offence;\n\n(ii) the person is in a position of trust or authority in relation\nto the child, or the child is otherwise under the care,\nsupervision or authority of the person, at the time the\nperson commits the underlying offence;\n\nSchedule 4  Strengthening child sex offences",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-4-sec-4-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "51f359dccbeb38601bd7f788c77bb4476a5b07f0968fc46d5ffa64216480fb0f",
      "skos:note": "Repeal of paragraph and substitution with new conditions for child sex offences"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Paragraph 272.10(1)(b) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) one or more of the following apply:\n\n(i) the child has a mental impairment at the time the person\ncommits the underlying offence;\n\n(ii) the person is in a position of trust or authority in relation\nto the child, or the child is otherwise under the care,\nsupervision or authority of the person, at the time the\nperson commits the underlying offence;\n\nSchedule 4  Strengthening child sex offences"
    },
