      "cml:integrityHash": "ef9c35f4d868180b7f51fd3e899f6af6694e801e041c22124a67876aa1f30495",
      "skos:note": "Prohibits causing a person under 16 to engage in sexual activity that is seen or heard by another person using a carriage service."
    },
