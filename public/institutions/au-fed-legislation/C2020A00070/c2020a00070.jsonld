      },
      "dc:source": "c2020a00070.pdf, p.31",
      "values:originalText": "Add:\nNote:\nMinimum penalties apply for certain offences—see sections 16AAA,\n16AAB and 16AAC.",
      "skos:definition": "Add:\nNote:\nMinimum penalties apply for certain offences—see sections 16AAA,\n16AAB and 16AAC.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-6-sec-1-norm"
        }
      ],
      "cml:integrityHash": "691e639c813ffc1c71daead3b4cefaf0d17aeb842981c469a9e5bdc599188d62",
      "skos:note": "Minimum penalties apply for certain offences"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-6-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 At the end of subsection 16A(1)",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Add:\nNote:\nMinimum penalties apply for certain offences—see sections 16AAA,\n16AAB and 16AAC."
    },
    {
      "@id": "concept:c2020a00070-sch-6-sec-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
