    {
      "@id": "concept:c2020a00070-sch-2-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Application and saving provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-2-sec-3"
      },
      "cml:curationStatus": {
