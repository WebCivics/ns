      },
      "cml:premiseText": "The person must be subject to the supervision of a probation officer appointed in accordance with the order.",
      "cml:conclusionText": "The supervision period is an ordered trace during which the person must comply with the conditions."
    },
    {
      "@id": "concept:c2020a00070-sch-11-sec-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must obey all reasonable directions of the probation officer",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
