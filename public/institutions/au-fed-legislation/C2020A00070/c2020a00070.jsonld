      },
      "dc:source": "c2020a00070.pdf, p.39",
      "values:originalText": "The amendment made by this Division applies in relation to a decision,\nmade on or after the commencement of this Division, by a bail authority\nto grant bail to a person charged with, or convicted of, an offence\n(whether the person was charged with, or convicted of, the offence\nbefore, on or after that commencement).",
      "skos:definition": "The amendment made by this Division applies in relation to a decision,\nmade on or after the commencement of this Division, by a bail authority\nto grant bail to a person charged with, or convicted of, an offence\n(whether the person was charged with, or convicted of, the offence\nbefore, on or after that commencement).",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-7-sec-2-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-7-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0330dab9ed1cbca94d7521966cc431c8f9be0780f66023229059451fe5f602ed",
      "skos:note": "Application provision for bail decisions made after Division commencement"
    },
    {
