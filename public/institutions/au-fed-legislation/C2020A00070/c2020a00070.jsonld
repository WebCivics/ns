      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.24",
      "values:originalText": "as being under, of, at least or over a particular age is, in the\nabsence of evidence to the contrary, proof that the defendant\nbelieved the person to be under, of, at least or over that age (as the\ncase requires).\n\nStrengthening child sex offences  Schedule 4\nMain amendments  Part 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "skos:definition": "as being under, of, at least or over a particular age is, in the\nabsence of evidence to the contrary, proof that the defendant\nbelieved the person to be under, of, at least or over that age (as the\ncase requires).\n\nStrengthening child sex offences  Schedule 4\nMain amendments  Part 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-4-sec-474-5-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-474-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "016d8abfee20eb5346bf7e98afa594e22f4e201c937ea63c6817c971a4260948",
      "skos:note": "Belief of defendant's age is proof in absence of evidence to the contrary."
    },
    {
