    {
      "@id": "concept:c2020a00070-sch-13-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 19AA(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-13-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.52",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) If a prescribed authority is fixing a non-parole period under\nsection 19AW in respect of a federal offender:\n\n(a) who is released on parole or licence; and\n\n(b) whose parole order or licence has subsequently been revoked\nunder section 19AU; and\n\n(c) who does not get the benefit of subsection (2) in calculating\nthe part of any federal sentence of imprisonment remaining to\nbe served at the time of release;\nthe prescribed authority must have regard to the period of time\nspent by the person on parole or licence before that parole order or\nlicence was revoked.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) If a prescribed authority is fixing a non-parole period under\nsection 19AW in respect of a federal offender:\n\n(a) who is released on parole or licence; and\n\n(b) whose parole order or licence has subsequently been revoked\nunder section 19AU; and\n\n(c) who does not get the benefit of subsection (2) in calculating\nthe part of any federal sentence of imprisonment remaining to\nbe served at the time of release;\nthe prescribed authority must have regard to the period of time\nspent by the person on parole or licence before that parole order or\nlicence was revoked.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-13-sec-2-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-13-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "70e76ac1364e883106ca24d9e52dbd5bbf08ccd56fb56a70bc24a88d803ee8ed",
      "skos:note": "Prescribed authority must have regard to parole time when revoking parole order or licence."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-13-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsection 19AA(3)",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) If a prescribed authority is fixing a non-parole period under\nsection 19AW in respect of a federal offender:\n\n(a) who is released on parole or licence; and\n\n(b) whose parole order or licence has subsequently been revoked\nunder section 19AU; and\n\n(c) who does not get the benefit of subsection (2) in calculating\nthe part of any federal sentence of imprisonment remaining to\nbe served at the time of release;\nthe prescribed authority must have regard to the period of time\nspent by the person on parole or licence before that parole order or\nlicence was revoked."
    },
    {
      "@id": "concept:c2020a00070-sch-13-sec-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
