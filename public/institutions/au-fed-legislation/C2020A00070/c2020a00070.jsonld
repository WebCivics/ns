      "skos:note": "Court must state reasons and record them.",
      "dc:description": "Reasons for granting bail"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-7-sec-4-ss-3",
      "@type": "cof:Section",
      "cof:title": "4(3) After section 15AA",
      "values:kind": "subsection",
