      },
      "dc:source": "c2020a00070.pdf, p.30",
      "values:originalText": "Repeal the penalty, substitute:\nPenalty: Imprisonment for 10 years.\n\nMinimum sentences  Schedule 6\nMain amendments  Part 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "skos:definition": "Repeal the penalty, substitute:\nPenalty: Imprisonment for 10 years.\n\nMinimum sentences  Schedule 6\nMain amendments  Part 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-5-sec-21-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-5-sec-21-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c8926c93c866c3b1ea53444322ff6ae5ba4eb09e0e2adb1a658f32cc6bf212e0",
      "skos:note": "Repeal of penalty and substitution with imprisonment for 10 years."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-5-sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Subsection 474.27A(1) of the Criminal Code (penalty)",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "Repeal the penalty, substitute:\nPenalty: Imprisonment for 10 years.\n\nMinimum sentences  Schedule 6\nMain amendments  Part 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020"
    },
