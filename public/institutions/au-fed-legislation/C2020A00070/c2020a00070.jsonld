    {
      "@id": "concept:c2020a00070-sch-9-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-9-sec-5"
      },
      "cml:curationStatus": {
