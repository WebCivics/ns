      "@type": "cml:Concept",
      "skos:prefLabel": "474(2) 27AA  Using a carriage service to “groom” another person to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-474-3-ss-2"
