    {
      "@id": "concept:c2020a00070-sch-6-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Saving provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-6-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.37",
      "values:originalText": "An instrument in force immediately before the commencement of this\nitem, that was made for the purposes of a provision of the Crimes Act\n1914 referred to in column 1 of an item in the following table, remains\nin force on and after that commencement as if it had been made for the\npurposes of the provision of that Act referred to in column 2 of that\nitem.\n\nSaving of instruments\nItem\nColumn 1\nOld provision\nColumn 2\nRenumbered provision\nSubsection 16AAA(3)\nSubsection 16AAAA(3)\nSubsection 16AAA(4)\nSubsection 16AAAA(4)\n\n\nSchedule 6  Minimum sentences",
      "skos:definition": "An instrument in force immediately before the commencement of this\nitem, that was made for the purposes of a provision of the Crimes Act\n1914 referred to in column 1 of an item in the following table, remains\nin force on and after that commencement as if it had been made for the\npurposes of the provision of that Act referred to in column 2 of that\nitem.\n\nSaving of instruments\nItem\nColumn 1\nOld provision\nColumn 2\nRenumbered provision\nSubsection 16AAA(3)\nSubsection 16AAAA(3)\nSubsection 16AAA(4)\nSubsection 16AAAA(4)\n\n\nSchedule 6  Minimum sentences",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-6-sec-7-norm"
        }
      ],
      "cml:integrityHash": "364c1006368ed5a5297c3ecefb71da27ee49829155d6b723ec5238c7c685fb34",
      "skos:note": "Saving provision for instruments in force before commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-6-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Saving provision",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "An instrument in force immediately before the commencement of this\nitem, that was made for the purposes of a provision of the Crimes Act\n1914 referred to in column 1 of an item in the following table, remains\nin force on and after that commencement as if it had been made for the\npurposes of the provision of that Act referred to in column 2 of that\nitem.\n\nSaving of instruments\nItem\nColumn 1\nOld provision\nColumn 2\nRenumbered provision\nSubsection 16AAA(3)\nSubsection 16AAAA(3)\nSubsection 16AAA(4)\nSubsection 16AAAA(4)\n\n\nSchedule 6  Minimum sentences"
    },
