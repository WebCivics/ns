    {
      "@id": "concept:c2020a00070-sch-6-sec-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Imposes a sentence of imprisonment",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If a person is convicted of an offence...",
      "cml:conclusionText": "The court must impose a sentence of imprisonment"
    },
    {
      "@id": "concept:c2020a00070-sch-6-sec-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Specifies the minimum sentence for each offence",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "offence against subsection 272.8(1)\nof the Criminal Code\n6 years...",
      "cml:conclusionText": "The minimum sentence is at least 6 years"
    },
    {
      "@id": "concept:c2020a00070-sch-6-sec-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Establishes a causal relationship between the offence and the penalty",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If a person is convicted of an offence...",
      "cml:conclusionText": "The court must impose a sentence of imprisonment based on the offence"
    },
    {
      "@id": "concept:c2020a00070-sch-6-sec-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS-SPREAD-TO",
      "cml:logicSummary": "Applies to all persons convicted of the specified offences",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subject to section 16AAC...",
      "cml:conclusionText": "The minimum penalty applies to all persons convicted of the offence"
    },
    {
      "@id": "concept:c2020a00070-sch-6-sec-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS-A",
      "cml:logicSummary": "Uses artificial intelligence to determine the minimum penalty",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Minimum penalties for certain offences...",
      "cml:conclusionText": "The system uses AI to determine the minimum penalty"
    },
    {
      "@id": "concept:c2020a00070-sch-6-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Application provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-6-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.36",
      "values:originalText": "(1)\nSubject to subitem (2), the amendments made by this Part apply in\nrelation to conduct engaged in on or after the commencement of this\nPart.\n(2)\nSection 16AAB of the Crimes Act 1914, as inserted by this Part, applies\nin relation to a conviction for a Commonwealth child sexual abuse\noffence where the relevant conduct was engaged in on or after the\ncommencement of this Part (regardless of whether the relevant previous\nconviction of the person for a child sexual abuse offence occurred\nbefore, on or after that commencement).\n\nMinimum sentences  Schedule 6\nTechnical amendments  Part 2\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "skos:definition": "(1)\nSubject to subitem (2), the amendments made by this Part apply in\nrelation to conduct engaged in on or after the commencement of this\nPart.\n(2)\nSection 16AAB of the Crimes Act 1914, as inserted by this Part, applies\nin relation to a conviction for a Commonwealth child sexual abuse\noffence where the relevant conduct was engaged in on or after the\ncommencement of this Part (regardless of whether the relevant previous\nconviction of the person for a child sexual abuse offence occurred\nbefore, on or after that commencement).\n\nMinimum sentences  Schedule 6\nTechnical amendments  Part 2\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-6-sec-3-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-6-sec-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "904e17d4871b2b9b95a582f3d903a7ebcb23e75dfb6b2e8b120478b2e3d42916",
      "skos:note": "Amendments apply in relation to conduct engaged on or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-6-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Application provisions",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "(1)\nSubject to subitem (2), the amendments made by this Part apply in\nrelation to conduct engaged in on or after the commencement of this\nPart.\n(2)\nSection 16AAB of the Crimes Act 1914, as inserted by this Part, applies\nin relation to a conviction for a Commonwealth child sexual abuse\noffence where the relevant conduct was engaged in on or after the\ncommencement of this Part (regardless of whether the relevant previous\nconviction of the person for a child sexual abuse offence occurred\nbefore, on or after that commencement).\n\nMinimum sentences  Schedule 6\nTechnical amendments  Part 2\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020"
    },
