    {
      "@id": "concept:c2020a00070-sch-4-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 After subsection 471.29(1) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.20",
      "values:originalText": "Insert:\n\n(1A) It is a defence to a prosecution for an offence against\nsection 471.25A if the defendant proves that, at the time he or she\ncaused the article to be carried, the defendant believed that the\nchild was at least 16.\nNote:\nA defendant bears a legal burden in relation to the matter in this\nsubsection, see section 13.4.",
      "skos:definition": "Insert:\n\n(1A) It is a defence to a prosecution for an offence against\nsection 471.25A if the defendant proves that, at the time he or she\ncaused the article to be carried, the defendant believed that the\nchild was at least 16.\nNote:\nA defendant bears a legal burden in relation to the matter in this\nsubsection, see section 13.4.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-4-sec-20-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "77ae3cd2aeb216b8b9d493297ff179aac822fef0fb60e05baf8800eab263adc9",
      "skos:note": "Defence for prosecution under section 471.25A"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 After subsection 471.29(1) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Insert:\n\n(1A) It is a defence to a prosecution for an offence against\nsection 471.25A if the defendant proves that, at the time he or she\ncaused the article to be carried, the defendant believed that the\nchild was at least 16.\nNote:\nA defendant bears a legal burden in relation to the matter in this\nsubsection, see section 13.4."
    },
