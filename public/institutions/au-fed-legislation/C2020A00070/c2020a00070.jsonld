      },
      "cml:premiseText": "The court must specify under paragraph (1)(b) the conditions that the person will, during the specified period...",
      "cml:conclusionText": "The person must obey all reasonable directions of the probation officer."
    },
    {
      "@id": "concept:c2020a00070-sch-11-sec-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must not travel interstate or overseas without written permission of the probation officer",
      "cml:executionSurface": "modalities::logic::deontic",
