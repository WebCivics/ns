      "cml:logicSummary": "Obligation to decline fixing a non-parole period if conditions are met",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
