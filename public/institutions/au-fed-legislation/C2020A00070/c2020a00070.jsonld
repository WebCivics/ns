      "dc:source": "c2020a00070.pdf, p.12",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A video recording of an interview of a person to whom\nsubsection (1A) applies in a proceeding may be admitted as\nevidence in chief if a constable, or a person of a kind specified in\nthe regulations, conducted the interview.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) A video recording of an interview of a person to whom\nsubsection (1A) applies in a proceeding may be admitted as\nevidence in chief if a constable, or a person of a kind specified in\nthe regulations, conducted the interview.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-2-sec-1-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-2-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2236c62409b7084cc51d4b2ac2253baf58469bcba12156b8c6089464d3467de2",
      "skos:note": "Admit video recording of interview as evidence in chief."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-2-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 15YM(1)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) A video recording of an interview of a person to whom\nsubsection (1A) applies in a proceeding may be admitted as\nevidence in chief if a constable, or a person of a kind specified in\nthe regulations, conducted the interview."
    },
