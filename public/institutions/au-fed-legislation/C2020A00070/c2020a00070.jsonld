    {
      "@id": "concept:c2020a00070-sch-4-sec-29",
      "@type": "cml:Concept",
      "skos:prefLabel": "29 Paragraph 474.25B(1)(b) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-29"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.22",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) one or more of the following apply:\n\n(i) the child has a mental impairment at the time the person\ncommits the underlying offence;\n\nStrengthening child sex offences  Schedule 4\nMain amendments  Part 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\n\n(ii) the person is in a position of trust or authority in relation\nto the child, or the child is otherwise under the care,\nsupervision or authority of the person, at the time the\nperson commits the underlying offence;\n\n(iii) the child is subjected to cruel, inhuman or degrading\ntreatment in connection with the sexual activity referred\nto in subsection 474.25A(1) or (2);\n\n(iv) the child dies as a result of physical harm suffered in\nconnection with the sexual activity referred to in\nsubsection 474.25A(1) or (2).",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) one or more of the following apply:\n\n(i) the child has a mental impairment at the time the person\ncommits the underlying offence;\n\nStrengthening child sex offences  Schedule 4\nMain amendments  Part 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\n\n(ii) the person is in a position of trust or authority in relation\nto the child, or the child is otherwise under the care,\nsupervision or authority of the person, at the time the\nperson commits the underlying offence;\n\n(iii) the child is subjected to cruel, inhuman or degrading\ntreatment in connection with the sexual activity referred\nto in subsection 474.25A(1) or (2);\n\n(iv) the child dies as a result of physical harm suffered in\nconnection with the sexual activity referred to in\nsubsection 474.25A(1) or (2).",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-4-sec-29-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-29-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2b53ca4dfeffcb9d8817e08dfc2e13758709914269b96648d68744116a04f628",
      "skos:note": "Repeal of paragraph 474.25B(1)(b) and substitution with new conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-29",
      "@type": "cof:Section",
      "cof:title": "29 Paragraph 474.25B(1)(b) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) one or more of the following apply:\n\n(i) the child has a mental impairment at the time the person\ncommits the underlying offence;\n\nStrengthening child sex offences  Schedule 4\nMain amendments  Part 1\n\nNo. 70, 2020\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\n\n(ii) the person is in a position of trust or authority in relation\nto the child, or the child is otherwise under the care,\nsupervision or authority of the person, at the time the\nperson commits the underlying offence;\n\n(iii) the child is subjected to cruel, inhuman or degrading\ntreatment in connection with the sexual activity referred\nto in subsection 474.25A(1) or (2);\n\n(iv) the child dies as a result of physical harm suffered in\nconnection with the sexual activity referred to in\nsubsection 474.25A(1) or (2)."
    },
