        "@id": "cml:Proposed"
      },
      "cml:premiseText": "In determining the length of any sentence or non-parole period—to include sufficient time for the person to undertake a rehabilitation program.",
      "cml:conclusionText": "Rehabilitation program duration is necessary"
    },
    {
      "@id": "concept:c2020a00070-sch-8-sec-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Sentence should be long enough for rehabilitation",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "In determining the length of any sentence or non-parole period—to include sufficient time for the person to undertake a rehabilitation program.",
      "cml:conclusionText": "Rehabilitation is necessary for sentence duration"
    },
    {
      "@id": "concept:c2020a00070-sch-8-sec-3-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "IMPLIES",
      "cml:logicSummary": "Rehabilitation implies longer sentence length",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "In determining the length of any sentence or non-parole period—to include sufficient time for the person to undertake a rehabilitation program.",
      "cml:conclusionText": "Longer sentence length is implied by rehabilitation"
    },
    {
      "@id": "concept:c2020a00070-sch-8-sec-3-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Rehabilitation is a relevant factor in sentencing",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The court must have regard to the objective of rehabilitating the person",
      "cml:conclusionText": "Rehabilitation is necessary for sentence duration"
    },
