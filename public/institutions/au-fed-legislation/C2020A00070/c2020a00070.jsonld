    {
      "@id": "concept:c2020a00070-sch-4-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 After subsection 474.29(5) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.26",
      "values:originalText": "Insert:\n\n(5A) It is a defence to a prosecution for an offence against\nsection 474.27AA if the defendant proves that, at the time the\ncommunication was transmitted, the defendant believed that the\nchild was at least 16 years of age.\nNote:\nA defendant bears a legal burden in relation to the matter in this\nsubsection, see section 13.4.",
      "skos:definition": "Insert:\n\n(5A) It is a defence to a prosecution for an offence against\nsection 474.27AA if the defendant proves that, at the time the\ncommunication was transmitted, the defendant believed that the\nchild was at least 16 years of age.\nNote:\nA defendant bears a legal burden in relation to the matter in this\nsubsection, see section 13.4.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-4-sec-42-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-4-sec-42-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "efd983e6d9fd1d46ea70d8667ef9af7eff24a88549bea892c8c4569c11d0903a",
      "skos:note": "Defence for prosecution under section 474.27AA"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-42",
      "@type": "cof:Section",
      "cof:title": "42 After subsection 474.29(5) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Insert:\n\n(5A) It is a defence to a prosecution for an offence against\nsection 474.27AA if the defendant proves that, at the time the\ncommunication was transmitted, the defendant believed that the\nchild was at least 16 years of age.\nNote:\nA defendant bears a legal burden in relation to the matter in this\nsubsection, see section 13.4."
    },
