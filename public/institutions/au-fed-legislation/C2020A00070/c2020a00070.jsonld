      }
    },
    {
      "@id": "concept:c2020a00070-sch-11-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 20(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-11-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.49",
      "values:originalText": "Omit “If”, substitute “Subject to subsection (1B), if”.",
      "skos:definition": "Omit “If”, substitute “Subject to subsection (1B), if”.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-11-sec-2-norm"
        }
      ],
      "cml:integrityHash": "27805469be5974065be4c2a374d11d260a31bd048ee8b826b3aefea1149fb903",
      "skos:note": "Omit ‘If’, substitute ‘Subject to subsection (1B), if’."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-11-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsection 20(1A)",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Omit “If”, substitute “Subject to subsection (1B), if”."
    },
    {
      "@id": "concept:c2020a00070-sch-11-sec-2-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2020a00070-sch-11-sec-2"
      },
