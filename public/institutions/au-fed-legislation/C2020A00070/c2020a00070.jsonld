      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2020a00070-sch-11-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 After subsection 20(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-11-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.49",
      "values:originalText": "Insert:\n\n(1B) If at least one of the offences the person is convicted of is a\nCommonwealth child sex offence, the court must specify under\nparagraph (1)(b), as mentioned in subparagraph (1)(a)(iv), the\nconditions that the person will, during the specified period:\n\n(a) be subject to the supervision of a probation officer appointed\nin accordance with the order; and\n\n(b) obey all reasonable directions of the probation officer; and\n\nSchedule 11  Conditional release of offenders after conviction\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020\n\n(c) not travel interstate or overseas without the written\npermission of the probation officer; and\n\n(d) undertake such treatment or rehabilitation programs that the\nprobation officer reasonably directs.",
      "skos:definition": "Insert:\n\n(1B) If at least one of the offences the person is convicted of is a\nCommonwealth child sex offence, the court must specify under\nparagraph (1)(b), as mentioned in subparagraph (1)(a)(iv), the\nconditions that the person will, during the specified period:\n\n(a) be subject to the supervision of a probation officer appointed\nin accordance with the order; and\n\n(b) obey all reasonable directions of the probation officer; and\n\nSchedule 11  Conditional release of offenders after conviction\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020\n\n(c) not travel interstate or overseas without the written\npermission of the probation officer; and\n\n(d) undertake such treatment or rehabilitation programs that the\nprobation officer reasonably directs.",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-11-sec-3-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-11-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:c2020a00070-sch-11-sec-3-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2020a00070-sch-11-sec-3-logic-ltl-3"
        },
        {
          "@id": "concept:c2020a00070-sch-11-sec-3-logic-deontic-4"
        },
        {
          "@id": "concept:c2020a00070-sch-11-sec-3-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "3c9eb60d9727a6274c912cb146887e59d8f3b3133b35866025fe811041893f1f",
      "skos:note": "Probation conditions for offenders convicted of Commonwealth child sex offences"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-11-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 After subsection 20(1A)",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Insert:\n\n(1B) If at least one of the offences the person is convicted of is a\nCommonwealth child sex offence, the court must specify under\nparagraph (1)(b), as mentioned in subparagraph (1)(a)(iv), the\nconditions that the person will, during the specified period:\n\n(a) be subject to the supervision of a probation officer appointed\nin accordance with the order; and\n\n(b) obey all reasonable directions of the probation officer; and\n\nSchedule 11  Conditional release of offenders after conviction\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020\n\n(c) not travel interstate or overseas without the written\npermission of the probation officer; and\n\n(d) undertake such treatment or rehabilitation programs that the\nprobation officer reasonably directs."
    },
    {
      "@id": "concept:c2020a00070-sch-11-sec-3-norm",
