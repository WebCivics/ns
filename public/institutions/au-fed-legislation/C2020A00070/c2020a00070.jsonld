      },
      "cml:premiseText": "The court must specify under paragraph (1)(b) the conditions that the person will, during the specified period...",
      "cml:conclusionText": "The person must be subject to the supervision of a probation officer appointed in accordance with the order."
    },
    {
      "@id": "concept:c2020a00070-sch-11-sec-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Probation supervision is a temporal interval",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
