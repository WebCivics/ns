        },
        {
          "@id": "concept:c2020a00070-sch-1-sec-2-logic-deontic-3"
        },
        {
          "@id": "concept:c2020a00070-sch-1-sec-2-logic-epistemic-4"
        }
      ],
      "cml:integrityHash": "f42cb0da9683bfd0d4470943418017f8696975f2f89f28ec8079c586a7b094d7",
      "skos:note": "Application provision for Schedule 2"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2020a00070#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "The amendment made by this Schedule applies in relation to a\nrevocation made on or after the commencement of this Schedule\n(whether the parole order was made, or the licence was granted, before,\non or after that commencement).\n\nSchedule 2  Use of video recordings\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020"
    },
