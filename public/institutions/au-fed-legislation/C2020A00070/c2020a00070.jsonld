    {
      "@id": "concept:c2020a00070-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2020a00070.pdf"
      },
      "dc:source": "c2020a00070.pdf, p.11",
      "values:originalText": "The amendment made by this Schedule applies in relation to a\nrevocation made on or after the commencement of this Schedule\n(whether the parole order was made, or the licence was granted, before,\non or after that commencement).\n\nSchedule 2  Use of video recordings\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020",
      "skos:definition": "The amendment made by this Schedule applies in relation to a\nrevocation made on or after the commencement of this Schedule\n(whether the parole order was made, or the licence was granted, before,\non or after that commencement).\n\nSchedule 2  Use of video recordings\n\nCrimes Legislation Amendment (Sexual Crimes Against Children and\nCommunity Protection Measures) Act 2020\nNo. 70, 2020",
      "cml:asserts": [
        {
          "@id": "concept:c2020a00070-sch-1-sec-2-norm"
        },
        {
          "@id": "concept:c2020a00070-sch-1-sec-2-logic-alleninterval-1"
        },
