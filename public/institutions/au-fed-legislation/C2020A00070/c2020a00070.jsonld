    {
      "@id": "concept:c2020a00070-sch-13-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Paragraphs 19AT(1)(a) and (b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-13-sec-17"
      },
      "cml:curationStatus": {
