        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal interval",
      "cml:logicSummary": "3-year period for review",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The person or persons undertaking the review must give the Attorney-General a written report of the review within 12 months after the end of the 3-year period."
    },
    {
      "@id": "concept:c2020a00070-sch-15-sec-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Reporting requirements for review",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) The Attorney-General must cause a copy of the report of the review to be laid before each House of the Parliament within 15 sitting days of that House after its receipt by the Attorney-General."
    },
    {
      "@id": "concept:c2020a00070-sch-15-sec-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permission",
      "cml:logicSummary": "Attorney-General's discretion in selecting reviewers",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The review must be undertaken by one or more persons who, in the Attorney-General’s opinion, possess appropriate qualifications to undertake the review."
    }
  ]
}