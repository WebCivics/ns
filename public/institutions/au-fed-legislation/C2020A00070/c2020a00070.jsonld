      "@id": "concept:c2020a00070-sch-4-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 272.9(1) of the Criminal Code (before the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00070#sch-4-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
