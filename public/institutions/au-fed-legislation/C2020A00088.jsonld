      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36d-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...and (c) the Minister is satisfied that...",
