      "cml:logicSummary": "Prohibits seeking review of citizenship cessation determination",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "A person may seek review of a determination made under this subsection in the High Court of Australia under section 75 of the Constitution, or in the Federal Court of Australia under section 39B of the Judiciary Act 1903."
