      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister must observe the rules of natural justice.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Minister must observe the rules of natural justice in making the decision.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Minister has a duty to act fairly and impartially."
    },
    {
