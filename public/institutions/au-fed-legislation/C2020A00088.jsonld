      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibits ceasing citizenship for certain convictions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) the person has been convicted of an offence, or offences, against one or more of the provisions specified in subsection (5); and"
    },
