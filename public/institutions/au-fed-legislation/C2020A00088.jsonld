      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister must revoke or refuse the application.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
