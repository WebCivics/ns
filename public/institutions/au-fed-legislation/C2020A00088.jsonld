      "cml:logicSummary": "Prohibits ceasing citizenship for certain convictions based on public interest",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(d) the Minister is satisfied that it would be contrary to the public interest for the person to remain an Australian citizen (see section 36E);"
    },
