      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister must revoke the determination if it is in the public interest.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Minister may revoke the determination if it is in the public interest.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Minister has a discretion to revoke the determination."
    },
