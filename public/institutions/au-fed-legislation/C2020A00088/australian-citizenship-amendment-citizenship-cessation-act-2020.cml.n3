concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-19 a cml:Concept ;
    skos:prefLabel "19 Application of section 36D of amended Act"@en ;
    cml:realizedBy doc:sch-1-sec-19 ;
    values:originalText "Section 36D of the amended Act applies in relation to a conviction of a person:  (a) that occurs after commencement; or  (b) that occurred before commencement, if:  (i) the conviction occurred on or after 29 May 2003; and  (ii) the person was sentenced to a period of imprisonment of at least 3 years, or to periods of imprisonment that total at least 3 years, in respect of the conviction." ;
    skos:definition "Section 36D of the amended Act applies in relation to a conviction of a person:  (a) that occurs after commencement; or  (b) that occurred before commencement, if:  (i) the conviction occurred on or after 29 May 2003; and  (ii) the person was sentenced to a period of imprisonment of at least 3 years, or to periods of imprisonment that total at least 3 years, in respect of the conviction."@en ;
    cml:integrityHash "3441e3843f1aa046f575645829859757f30b10372dfabd4cc2c99ed2447d0b31" ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Section applies in relation to a conviction of a person after commencement or before commencement under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
