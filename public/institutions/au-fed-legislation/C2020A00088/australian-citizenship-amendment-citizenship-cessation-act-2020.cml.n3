concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-11 a cml:Concept ;
    skos:prefLabel "11 Subsection 51B(1)"@en ;
    cml:realizedBy doc:sch-1-sec-11 ;
    values:originalText "Repeal the subsection, substitute:  (1) As soon as practicable after each reporting period, the Minister must table a report in each House of the Parliament that sets out the following:  (a) the number of notices given by the Minister under paragraph 36F(1)(a) (notice of citizenship cessation) during the reporting period;  (b) for each notice that was given under paragraph 36F(1)(a) during the reporting period—a brief statement of the matters that are the basis for the determination to which the notice relates;  (c) the number of notices given by the Minister under subsection 36H(4) during the reporting period (notice of decision on application to have citizenship cessation determination revoked).  Amendments  Schedule 1 Amendments  Part 1  No. 88, 2020 Australian Citizenship Amendment (Citizenship Cessation) Act 2020" ;
    skos:definition "Repeal the subsection, substitute:  (1) As soon as practicable after each reporting period, the Minister must table a report in each House of the Parliament that sets out the following:  (a) the number of notices given by the Minister under paragraph 36F(1)(a) (notice of citizenship cessation) during the reporting period;  (b) for each notice that was given under paragraph 36F(1)(a) during the reporting period—a brief statement of the matters that are the basis for the determination to which the notice relates;  (c) the number of notices given by the Minister under subsection 36H(4) during the reporting period (notice of decision on application to have citizenship cessation determination revoked).  Amendments  Schedule 1 Amendments  Part 1  No. 88, 2020 Australian Citizenship Amendment (Citizenship Cessation) Act 2020"@en ;
    cml:integrityHash "c1d4cc20a90fcf5048a2a4d82a8b99198c4f52a62d2941e10487a572af988bdf" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Table a report on citizenship cessation notices and revocation decisions" ;
    dc:description "report in each House of the Parliament" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-citizenship-cessation-act-2020.pdf> ;
    dc:source "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.22" ;
