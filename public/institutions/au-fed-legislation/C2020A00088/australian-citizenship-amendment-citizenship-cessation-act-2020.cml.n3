concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36a a cml:Concept ;
    skos:prefLabel "36A Purpose of this Subdivision"@en ;
    cml:realizedBy doc:sch-1-sec-36a ;
    values:originalText "This Subdivision is enacted because the Parliament recognises that Australian citizenship is a common bond, involving reciprocal rights and obligations, and that citizens may, through certain conduct incompatible with the shared values of the Australian community, demonstrate that they have severed that bond and repudiated their allegiance to Australia." ;
    skos:definition "This Subdivision is enacted because the Parliament recognises that Australian citizenship is a common bond, involving reciprocal rights and obligations, and that citizens may, through certain conduct incompatible with the shared values of the Australian community, demonstrate that they have severed that bond and repudiated their allegiance to Australia."@en ;
    cml:integrityHash "516026a6f81d1adf8d05d456210a077fe1914ea239c6939062288499d8370cb8" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Citizens may demonstrate that they have severed the bond of Australian citizenship through certain conduct." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-citizenship-amendment-citizenship-cessation-act-2020.pdf> ;
    dc:source "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.8" ;
    cml:asserts concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36a-norm .
