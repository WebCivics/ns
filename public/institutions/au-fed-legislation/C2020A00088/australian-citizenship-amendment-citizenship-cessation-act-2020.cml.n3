doc:sch-1-sec-36g-ss-5 a cof:Section ;
    cof:title "36G(5) Determination that notice of citizenship cessation should not be" ;
    values:kind "subsection" ;
    values:originalText "(5) If the Minister extends the determination for 1 year under subsection (4):  (a) the Minister must consider whether to revoke the determination at least every 90 days after extending it; and  (b) the determination is taken to be revoked at the end of that year." ;
    cof:pageNumber "17"^^xsd:integer .

