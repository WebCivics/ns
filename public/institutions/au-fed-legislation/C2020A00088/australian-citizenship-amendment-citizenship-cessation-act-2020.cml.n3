concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36l a cml:Concept ;
    skos:prefLabel "36L No resumption of citizenship if citizenship ceases under this"@en ;
    cml:realizedBy doc:sch-1-sec-36l ;
    values:originalText "Subdivision  If a person ceases to be an Australian citizen under this Subdivision, Divisions 1 and 2 of this Part do not apply in relation to the person after that cessation. Note: The effect of this section is that, unless a determination under section 36B or 36D is revoked (see sections 36H, 36J and 36K), the person can never become an Australian citizen again." ;
    skos:definition "Subdivision  If a person ceases to be an Australian citizen under this Subdivision, Divisions 1 and 2 of this Part do not apply in relation to the person after that cessation. Note: The effect of this section is that, unless a determination under section 36B or 36D is revoked (see sections 36H, 36J and 36K), the person can never become an Australian citizen again."@en ;
    cml:integrityHash "56ed07587b7c5b65670921718847bfb72ac79dbf44736e5b9c53a2fe8767bd9a" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "No resumption of citizenship if citizenship ceases under this subdivision." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
