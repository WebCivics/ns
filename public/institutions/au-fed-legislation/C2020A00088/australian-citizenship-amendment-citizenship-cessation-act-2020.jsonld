        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsections 51C(1) and (2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.23",
      "values:originalText": "Repeal the subsections, substitute:\n\n(1) The Minister must, in writing, inform the Parliamentary Joint\nCommittee on Intelligence and Security as soon as practicable if\nany of the following events occurs:\n\n(a) the Minister gives a person a notice under\nparagraph 36F(1)(a) (notice of citizenship cessation);\n\n(b) the Minister makes a determination under subsection 36G(1)\n(that notice of citizenship cessation should not be given);\n\n(c) the Minister gives a person notice, under subsection 36H(4)\nor 36J(3), that the Minister has decided to revoke a\ndetermination made under subsection 36B(1) or 36D(1).",
      "skos:definition": "Repeal the subsections, substitute:\n\n(1) The Minister must, in writing, inform the Parliamentary Joint\nCommittee on Intelligence and Security as soon as practicable if\nany of the following events occurs:\n\n(a) the Minister gives a person a notice under\nparagraph 36F(1)(a) (notice of citizenship cessation);\n\n(b) the Minister makes a determination under subsection 36G(1)\n(that notice of citizenship cessation should not be given);\n\n(c) the Minister gives a person notice, under subsection 36H(4)\nor 36J(3), that the Minister has decided to revoke a\ndetermination made under subsection 36B(1) or 36D(1).",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-12-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "90205bc1e34fdb061e2f1cdeb393a2c0028453d9772d0878d271010032c81e9f",
      "skos:note": "Inform the Parliamentary Joint Committee on Intelligence and Security of certain events.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Subsections 51C(1) and (2)",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Repeal the subsections, substitute:\n\n(1) The Minister must, in writing, inform the Parliamentary Joint\nCommittee on Intelligence and Security as soon as practicable if\nany of the following events occurs:\n\n(a) the Minister gives a person a notice under\nparagraph 36F(1)(a) (notice of citizenship cessation);\n\n(b) the Minister makes a determination under subsection 36G(1)\n(that notice of citizenship cessation should not be given);\n\n(c) the Minister gives a person notice, under subsection 36H(4)\nor 36J(3), that the Minister has decided to revoke a\ndetermination made under subsection 36B(1) or 36D(1)."
    },
    {
