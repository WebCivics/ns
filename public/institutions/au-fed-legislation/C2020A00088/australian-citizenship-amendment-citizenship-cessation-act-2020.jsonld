    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Application of section 36D of amended Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.28",
      "values:originalText": "Section 36D of the amended Act applies in relation to a conviction of a\nperson:\n\n(a) that occurs after commencement; or\n\n(b) that occurred before commencement, if:\n\n(i) the conviction occurred on or after 29 May 2003; and\n\n(ii) the person was sentenced to a period of imprisonment of\nat least 3 years, or to periods of imprisonment that total\nat least 3 years, in respect of the conviction.",
      "skos:definition": "Section 36D of the amended Act applies in relation to a conviction of a\nperson:\n\n(a) that occurs after commencement; or\n\n(b) that occurred before commencement, if:\n\n(i) the conviction occurred on or after 29 May 2003; and\n\n(ii) the person was sentenced to a period of imprisonment of\nat least 3 years, or to periods of imprisonment that total\nat least 3 years, in respect of the conviction.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-19-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-19-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3441e3843f1aa046f575645829859757f30b10372dfabd4cc2c99ed2447d0b31",
      "skos:note": "Section applies in relation to a conviction of a person after commencement or before commencement under certain conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Application of section 36D of amended Act",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Section 36D of the amended Act applies in relation to a conviction of a\nperson:\n\n(a) that occurs after commencement; or\n\n(b) that occurred before commencement, if:\n\n(i) the conviction occurred on or after 29 May 2003; and\n\n(ii) the person was sentenced to a period of imprisonment of\nat least 3 years, or to periods of imprisonment that total\nat least 3 years, in respect of the conviction."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-19-norm",
      "@type": "values:Obligation",
      "cml:modality": {
