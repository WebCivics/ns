    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Section 51B report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.28",
      "values:originalText": "A report prepared for the purposes of section 51B of the amended Act\nin relation to the reporting period in which commencement occurs must\nset out:\n\nAmendments  Schedule 1\nApplication and transitional provisions  Part 2\n\nNo. 88, 2020\nAustralian Citizenship Amendment (Citizenship Cessation) Act 2020\n\n(a) for the part of the reporting period that occurs before\ncommencement—the matters required by subsection 51B(1)\nof the Act as in force immediately before commencement;\nand\n\n(b) for the part of the reporting period that occurs after\ncommencement—the matters required by subsection 51B(1)\nof the amended Act.",
      "skos:definition": "A report prepared for the purposes of section 51B of the amended Act\nin relation to the reporting period in which commencement occurs must\nset out:\n\nAmendments  Schedule 1\nApplication and transitional provisions  Part 2\n\nNo. 88, 2020\nAustralian Citizenship Amendment (Citizenship Cessation) Act 2020\n\n(a) for the part of the reporting period that occurs before\ncommencement—the matters required by subsection 51B(1)\nof the Act as in force immediately before commencement;\nand\n\n(b) for the part of the reporting period that occurs after\ncommencement—the matters required by subsection 51B(1)\nof the amended Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-21-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-21-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "7570da7c62943fefc917d2157c80ead31e8b0570f8edab09de32492fcad6bc74",
      "skos:note": "Reporting requirements for section 51B of the amended Act",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-21",
      "@type": "cof:Section",
      "cof:title": "21 Section 51B report",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "A report prepared for the purposes of section 51B of the amended Act\nin relation to the reporting period in which commencement occurs must\nset out:\n\nAmendments  Schedule 1\nApplication and transitional provisions  Part 2\n\nNo. 88, 2020\nAustralian Citizenship Amendment (Citizenship Cessation) Act 2020\n\n(a) for the part of the reporting period that occurs before\ncommencement—the matters required by subsection 51B(1)\nof the Act as in force immediately before commencement;\nand\n\n(b) for the part of the reporting period that occurs after\ncommencement—the matters required by subsection 51B(1)\nof the amended Act."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-21-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-21"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-21-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Reporting period includes before and after commencement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
