    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 At the end of section 32A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.7",
      "values:originalText": "Add:\n•\nfor certain conduct or convictions, the Minister can make a\ndetermination ceasing your citizenship if the Minister is\nsatisfied you have repudiated your allegiance to Australia and\nthat it would be contrary to the public interest for you to\nremain an Australia citizen: see Subdivision C (citizenship\ncessation determinations).",
      "skos:definition": "Add:\n•\nfor certain conduct or convictions, the Minister can make a\ndetermination ceasing your citizenship if the Minister is\nsatisfied you have repudiated your allegiance to Australia and\nthat it would be contrary to the public interest for you to\nremain an Australia citizen: see Subdivision C (citizenship\ncessation determinations).",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-5-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a203b51e2888ebe6cc26882fd0985b151f56dd157a49c5e166cec7c31fb89ecc",
      "skos:note": "Minister can make a determination ceasing citizenship if repudiated allegiance to Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 At the end of section 32A",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Add:\n•\nfor certain conduct or convictions, the Minister can make a\ndetermination ceasing your citizenship if the Minister is\nsatisfied you have repudiated your allegiance to Australia and\nthat it would be contrary to the public interest for you to\nremain an Australia citizen: see Subdivision C (citizenship\ncessation determinations)."
    },
