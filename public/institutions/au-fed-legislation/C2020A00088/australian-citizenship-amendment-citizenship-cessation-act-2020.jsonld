      }
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Subsection 51C(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
