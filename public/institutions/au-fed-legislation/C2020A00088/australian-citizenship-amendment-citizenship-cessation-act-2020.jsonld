        }
      ],
      "cml:integrityHash": "1151a4e696249aa61338aa2554589f6c8f1e615c0e024239abe45c348b85b4b2",
      "skos:note": "Determination revocation period"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36g-ss-3",
      "@type": "cof:Section",
      "cof:title": "36G(3) Determination that notice of citizenship cessation should not be",
      "values:kind": "subsection",
      "cof:pageNumber": 17,
      "values:originalText": "(3) If the Minister does not revoke the determination within 5 years of\nmaking it, the determination is taken to be revoked at the end of the\n5 years unless the Minister extends the determination under\nsubsection (4)."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36g-ss-3-norm",
