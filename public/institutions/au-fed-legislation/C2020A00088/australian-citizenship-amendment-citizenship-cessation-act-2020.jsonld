        }
      ],
      "cml:integrityHash": "4420dac4dbbc7a02ef51f955c39bed96e3fc25c43977518eddc58601e19c1e1f",
      "skos:note": "Minister cannot make determination if person would not be a national or citizen of any country."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36d-ss-2",
      "@type": "cof:Section",
      "cof:title": "36D(2) Citizenship cessation determination for certain convictions",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(2) However, the Minister must not make a determination if the\nMinister is satisfied that the person would, if the Minister were to\nmake the determination, become a person who is not a national or\ncitizen of any country."
    },
