      "cml:integrityHash": "032e1edee9ee90938e4638e06dc358c63d3aa5eb831ea9dc7f6ac86404a408f7",
      "skos:note": "If Minister revokes determination, person's citizenship is taken never to have ceased."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36h-ss-6",
      "@type": "cof:Section",
      "cof:title": "36H(6) Revocation of citizenship cessation determination on",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(6) If the Minister revokes the determination under subsection (3), the\nperson’s citizenship is taken never to have ceased under\nsection 36B or 36D (as applicable) because of the determination.\nHowever, the validity of anything done in reliance on the\ndetermination before the revocation is not affected."
    },
