      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits seeking review of citizenship cessation determination",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "A person may seek review of a determination made under this subsection in the High Court of Australia under section 75 of the Constitution, or in the Federal Court of Australia under section 39B of the Judiciary Act 1903.",
      "cml:conclusionText": "...or in the Federal Court of Australia under section 39B of the Judiciary Act 1903."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36d-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "36D(2) Citizenship cessation determination for certain convictions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36d-ss-2"
