    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36g-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "36G(3) Determination that notice of citizenship cessation should not be",
      "cml:realizedBy": {
