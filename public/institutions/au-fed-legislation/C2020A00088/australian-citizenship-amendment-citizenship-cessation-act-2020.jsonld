    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Section 4 (paragraph (aa) of the definition of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-14"
      },
      "cml:curationStatus": {
