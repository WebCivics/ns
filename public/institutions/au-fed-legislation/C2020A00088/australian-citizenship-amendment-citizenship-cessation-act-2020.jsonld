    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Paragraph 29(1)(ca)",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(ca) to commence, by the third anniversary of the day the\nAustralian Citizenship Amendment (Citizenship Cessation)\nAct 2020 commenced, a review of the operation,\neffectiveness and implications of Subdivision C of Division 3\nof Part 2 of the Australian Citizenship Act 2007 (citizenship\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-15-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
