      }
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Australian citizenship",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.29",
      "values:originalText": "The amendments of the Act made by this Schedule apply in relation to a\nperson, in accordance with this Part, regardless of:\n\n(a) whether the person became an Australian citizen before or\nafter commencement; or\n\n(b) whether the person ceased to be an Australian citizen before\ncommencement.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 19 September 2019\nSenate on 3 September 2020]\n\n(175/19)",
      "skos:definition": "The amendments of the Act made by this Schedule apply in relation to a\nperson, in accordance with this Part, regardless of:\n\n(a) whether the person became an Australian citizen before or\nafter commencement; or\n\n(b) whether the person ceased to be an Australian citizen before\ncommencement.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 19 September 2019\nSenate on 3 September 2020]\n\n(175/19)",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-22-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b868ec3ca54fda6efb7a6869e1a30fdee8e8e9e79f83802a7c63c8fdbb6e4e16",
      "skos:note": "Amendments apply regardless of citizenship status before or after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Australian citizenship",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "The amendments of the Act made by this Schedule apply in relation to a\nperson, in accordance with this Part, regardless of:\n\n(a) whether the person became an Australian citizen before or\nafter commencement; or\n\n(b) whether the person ceased to be an Australian citizen before\ncommencement.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 19 September 2019\nSenate on 3 September 2020]\n\n(175/19)"
    },
