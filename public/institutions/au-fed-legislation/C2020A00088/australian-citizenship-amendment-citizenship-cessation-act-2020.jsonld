    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Application of section 36B of amended Act",
      "cml:realizedBy": {
