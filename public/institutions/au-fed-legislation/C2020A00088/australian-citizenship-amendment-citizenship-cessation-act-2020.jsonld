    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36g-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "36G(4) Determination that notice of citizenship cessation should not be",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36g-ss-4"
      },
      "cml:curationStatus": {
