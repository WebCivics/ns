      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.23",
      "values:originalText": "Repeal the subsection, substitute:\n\n(5) The briefing must include details of the matters that are the basis\nfor the notice, determination or revocation.\nIndependent National Security Legislation Monitor Act 2010",
      "skos:definition": "Repeal the subsection, substitute:\n\n(5) The briefing must include details of the matters that are the basis\nfor the notice, determination or revocation.\nIndependent National Security Legislation Monitor Act 2010",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-13-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e3ebb21e21eedc7702745d5f0f14df8c7d309454d7a4c7024b39b8dafaeb5f9e",
      "skos:note": "Must include details of basis for notice, determination or revocation"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Subsection 51C(5)",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Repeal the subsection, substitute:\n\n(5) The briefing must include details of the matters that are the basis\nfor the notice, determination or revocation.\nIndependent National Security Legislation Monitor Act 2010"
    },
