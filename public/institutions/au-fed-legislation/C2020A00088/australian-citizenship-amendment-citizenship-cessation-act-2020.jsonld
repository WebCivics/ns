      "cml:operator": "applies",
      "cml:logicSummary": "Section applies to convictions after or before commencement under specified conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
