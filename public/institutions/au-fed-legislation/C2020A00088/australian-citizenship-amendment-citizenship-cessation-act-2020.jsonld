    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36a",
      "@type": "cml:Concept",
      "skos:prefLabel": "36A Purpose of this Subdivision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.8",
      "values:originalText": "This Subdivision is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia.",
      "skos:definition": "This Subdivision is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36a-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "516026a6f81d1adf8d05d456210a077fe1914ea239c6939062288499d8370cb8",
      "skos:note": "Citizens may demonstrate that they have severed the bond of Australian citizenship through certain conduct."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36a",
      "@type": "cof:Section",
      "cof:title": "36A Purpose of this Subdivision",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "This Subdivision is enacted because the Parliament recognises that\nAustralian citizenship is a common bond, involving reciprocal\nrights and obligations, and that citizens may, through certain\nconduct incompatible with the shared values of the Australian\ncommunity, demonstrate that they have severed that bond and\nrepudiated their allegiance to Australia."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36a-norm",
