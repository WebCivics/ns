    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Subsection 51B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.22",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) As soon as practicable after each reporting period, the Minister\nmust table a report in each House of the Parliament that sets out the\nfollowing:\n\n(a) the number of notices given by the Minister under\nparagraph 36F(1)(a) (notice of citizenship cessation) during\nthe reporting period;\n\n(b) for each notice that was given under paragraph 36F(1)(a)\nduring the reporting period—a brief statement of the matters\nthat are the basis for the determination to which the notice\nrelates;\n\n(c) the number of notices given by the Minister under\nsubsection 36H(4) during the reporting period (notice of\ndecision on application to have citizenship cessation\ndetermination revoked).\n\nAmendments  Schedule 1\nAmendments  Part 1\n\nNo. 88, 2020\nAustralian Citizenship Amendment (Citizenship Cessation) Act 2020",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) As soon as practicable after each reporting period, the Minister\nmust table a report in each House of the Parliament that sets out the\nfollowing:\n\n(a) the number of notices given by the Minister under\nparagraph 36F(1)(a) (notice of citizenship cessation) during\nthe reporting period;\n\n(b) for each notice that was given under paragraph 36F(1)(a)\nduring the reporting period—a brief statement of the matters\nthat are the basis for the determination to which the notice\nrelates;\n\n(c) the number of notices given by the Minister under\nsubsection 36H(4) during the reporting period (notice of\ndecision on application to have citizenship cessation\ndetermination revoked).\n\nAmendments  Schedule 1\nAmendments  Part 1\n\nNo. 88, 2020\nAustralian Citizenship Amendment (Citizenship Cessation) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-11-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c1d4cc20a90fcf5048a2a4d82a8b99198c4f52a62d2941e10487a572af988bdf",
      "skos:note": "Table a report on citizenship cessation notices and revocation decisions",
      "dc:description": "report in each House of the Parliament"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Subsection 51B(1)",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) As soon as practicable after each reporting period, the Minister\nmust table a report in each House of the Parliament that sets out the\nfollowing:\n\n(a) the number of notices given by the Minister under\nparagraph 36F(1)(a) (notice of citizenship cessation) during\nthe reporting period;\n\n(b) for each notice that was given under paragraph 36F(1)(a)\nduring the reporting period—a brief statement of the matters\nthat are the basis for the determination to which the notice\nrelates;\n\n(c) the number of notices given by the Minister under\nsubsection 36H(4) during the reporting period (notice of\ndecision on application to have citizenship cessation\ndetermination revoked).\n\nAmendments  Schedule 1\nAmendments  Part 1\n\nNo. 88, 2020\nAustralian Citizenship Amendment (Citizenship Cessation) Act 2020"
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-11-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-11"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-11-logic-deontic-1",
      "@type": "cml:LogicApplication",
