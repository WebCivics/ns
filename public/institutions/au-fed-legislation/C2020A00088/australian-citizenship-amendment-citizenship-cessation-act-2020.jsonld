    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Declared terrorist organisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.28",
      "values:originalText": "Despite the repeal of section 35AA of the Act by this Schedule, a\ndeclaration in force under that section immediately before\ncommencement continues in force, after commencement, as if it had\nbeen made under section 36C of the amended Act.",
      "skos:definition": "Despite the repeal of section 35AA of the Act by this Schedule, a\ndeclaration in force under that section immediately before\ncommencement continues in force, after commencement, as if it had\nbeen made under section 36C of the amended Act.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-20-norm"
        }
      ],
      "cml:integrityHash": "b33a717c838837deb556c3e0108000d6f8f8ca1ad7a26708cb527289fecfa343",
      "skos:note": "Continuation of declarations under repealed section"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Declared terrorist organisations",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Despite the repeal of section 35AA of the Act by this Schedule, a\ndeclaration in force under that section immediately before\ncommencement continues in force, after commencement, as if it had\nbeen made under section 36C of the amended Act."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-20-norm",
      "@type": "values:Undertaking",
