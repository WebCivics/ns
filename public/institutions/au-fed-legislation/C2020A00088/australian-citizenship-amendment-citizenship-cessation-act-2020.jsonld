      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The severity of the conduct to which the determination relates;"
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36e-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
