      "dc:source": "australian-citizenship-amendment-citizenship-cessation-act-2020.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nAmendments  Part 1\n\nNo. 88, 2020\nAustralian Citizenship Amendment (Citizenship Cessation) Act 2020",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nAmendments  Part 1\n\nNo. 88, 2020\nAustralian Citizenship Amendment (Citizenship Cessation) Act 2020",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sec-3-norm"
        }
      ],
      "cml:integrityHash": "a2602a81e9cd0b5b49c5dff361917bf61bfa7ca4a917abc02db13c02ec45e5fb",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
