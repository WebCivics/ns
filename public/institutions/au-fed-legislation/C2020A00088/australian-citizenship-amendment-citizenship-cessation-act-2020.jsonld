      ],
      "cml:integrityHash": "7d24834424463fa210ca9e73e068d7f3c3b0342d9ce5bf10bba32885e9de77c6",
      "skos:note": "Citizenship cessation determination for certain convictions"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36d-ss-4",
      "@type": "cof:Section",
      "cof:title": "36D(4) Citizenship cessation determination for certain convictions",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(4) Subsection (1) applies to a person who is an Australian citizen\nregardless of how the person became an Australian citizen\n(including a person who became an Australian citizen upon the\nperson’s birth)."
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36d-ss-4-norm",
