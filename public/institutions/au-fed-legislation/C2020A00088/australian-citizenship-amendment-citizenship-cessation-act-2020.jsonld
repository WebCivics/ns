    {
      "@id": "concept:australian-citizenship-amendment-citizenship-cessation-act-2020-sch-1-sec-36h-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "36H(5) Revocation of citizenship cessation determination on",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-cessation-act-2020#sch-1-sec-36h-ss-5"
