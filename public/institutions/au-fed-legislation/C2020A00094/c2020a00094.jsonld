    {
      "@id": "concept:c2020a00094-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2020a00094#sec-3"
      },
      "cml:curationStatus": {
