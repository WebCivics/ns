<https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-1> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Prohibition";
    <https://ns.webcivics.net/cml/logicSummary> "Prohibits conduct with proceeds of general crime.";
    <https://ns.webcivics.net/cml/premiseText> "(a) the person engages in conduct in relation to money or other property; and (b) the money or property is proceeds of general crime;";
    <https://ns.webcivics.net/cml/conclusionText> "The conduct is an offence.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-2>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-2> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Requires person to be negligent about nature of money or property.";
    <https://ns.webcivics.net/cml/premiseText> "(c) the person is negligent as to the fact that the money or property is proceeds of general crime;";
    <https://ns.webcivics.net/cml/conclusionText> "The person has a duty to disclose the nature of the money or property.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-alleninterval-3>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-alleninterval-3> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/AllenInterval>;
    <https://ns.webcivics.net/cml/operator> "Overlaps";
    <https://ns.webcivics.net/cml/logicSummary> "Defines temporal interval for conduct with proceeds of general crime.";
    <https://ns.webcivics.net/cml/premiseText> "(e) when the conduct occurs, the value of the money and other property is $1,000,000 or more.";
    <https://ns.webcivics.net/cml/conclusionText> "The conduct occurs within a specific temporal interval.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::interval_reasoning";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a> <https://ns.webcivics.net/cml/asserts> <https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-4>.
<https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-4> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Permission";
    <https://ns.webcivics.net/cml/logicSummary> "Allows person to engage in conduct with proceeds of general crime if value exceeds $1,000,000.";
    <https://ns.webcivics.net/cml/premiseText> "(e) when the conduct occurs, the value of the money and other property is $1,000,000 or more.";
    <https://ns.webcivics.net/cml/conclusionText> "The person has permission to engage in conduct with proceeds of general crime if the value exceeds $1,000,000.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
