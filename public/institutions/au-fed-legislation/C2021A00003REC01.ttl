<https://ns.webcivics.net/concept/crimes-legislation-amendment-economic-disruption-act-2021-sch-1-sec-21-ss-3a-logic-deontic-5> a <https://ns.webcivics.net/cml/LogicApplication>;
    <https://ns.webcivics.net/cml/modality> <https://ns.webcivics.net/cml/Deontic>;
    <https://ns.webcivics.net/cml/operator> "Obligation";
    <https://ns.webcivics.net/cml/logicSummary> "Requires person to disclose nature of money or property.";
    <https://ns.webcivics.net/cml/premiseText> "(d) the conduct concealed or disguised any or all of the following: (i) the nature of the money or property;";
    <https://ns.webcivics.net/cml/conclusionText> "The person has a duty to disclose the nature of the money or property.";
    <https://ns.webcivics.net/cml/executionSurface> "modalities::logic::deontic";
    <https://ns.webcivics.net/cml/confidence> 1.0000;
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>.
