concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-6-sec-18 a cml:Concept ;
    skos:prefLabel "18 Section 338"@en ;
    cml:realizedBy doc:sch-6-sec-18 ;
    values:originalText "Insert: International Criminal Court has the same meaning as in the Criminal Code. International War Crimes Tribunal means a Tribunal (within the meaning of the International War Crimes Tribunals Act 1995). Mutual Assistance Department means the Department administered by the Minister who administers the Mutual Assistance Act." ;
    skos:definition "Insert: International Criminal Court has the same meaning as in the Criminal Code. International War Crimes Tribunal means a Tribunal (within the meaning of the International War Crimes Tribunals Act 1995). Mutual Assistance Department means the Department administered by the Minister who administers the Mutual Assistance Act."@en ;
    cml:integrityHash "c1f90407e18a12e6aa5351d267542200f4ee5721b8bd9200cb3fa58e48701938" ;
    cof:pageNumber "61"^^xsd:integer ;
