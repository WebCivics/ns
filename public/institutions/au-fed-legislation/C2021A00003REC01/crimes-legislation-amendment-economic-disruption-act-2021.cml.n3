concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-298f a cml:Concept ;
    skos:prefLabel "298F Debits from the COAG Reform Fund"@en ;
    cml:realizedBy doc:sch-7-sec-298f ;
    values:originalText "If an amount has been credited under paragraph 298E(1)(b) to the *COAG Reform Fund for a purpose in relation to a grant of financial assistance to a State or Territory, the Treasurer must: (a) ensure that the COAG Reform Fund is debited for the purposes of making the grant; and (b) do so as soon as practicable after the amount has been credited." ;
    skos:definition "If an amount has been credited under paragraph 298E(1)(b) to the *COAG Reform Fund for a purpose in relation to a grant of financial assistance to a State or Territory, the Treasurer must: (a) ensure that the COAG Reform Fund is debited for the purposes of making the grant; and (b) do so as soon as practicable after the amount has been credited."@en ;
    cml:integrityHash "4d69a5430be8c7d1dd6474e50aca1886bd3f0a8db6690a25534ab15d4a45db49" ;
    cof:pageNumber "82"^^xsd:integer ;
    skos:note "Ensure COAG Reform Fund is debited for grant purposes." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
