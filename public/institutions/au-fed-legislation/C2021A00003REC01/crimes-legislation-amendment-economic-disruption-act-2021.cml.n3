    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-7-sec-38 a cof:Section ;
    cof:title "38 Paragraphs 281(a) and (b)" ;
    values:kind "section" ;
    values:originalText "Repeal the paragraphs, substitute: (a) if the property was covered by a *restraining order—are taken to be covered by the restraining order; or (b) if the property was covered by a *forfeiture order—are taken to be covered by the forfeiture order; or (c) if the property was forfeited under section 92—are taken to be forfeited under that section; or (d) if the property was subject to a charge under section 142— are taken to be subject to the charge; or (e) if the property was subject to a charge under section 169— are taken to be subject to the charge; or  Official Trustee  Schedule 7 General amendments  Part 1 No. 3, 2021 Crimes Legislation Amendment (Economic Disruption) Act 2021 (f) if the property was subject to a charge under section 179SA—are taken to be subject to the charge." ;
    cof:pageNumber "76"^^xsd:integer .

concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-39 a cml:Concept ;
    skos:prefLabel "39 At the end of section 281"@en ;
    cml:realizedBy doc:sch-7-sec-39 ;
    values:originalText "Add: (2) If the *controlled property: (a) was covered by a *restraining order or *forfeiture order; and (b) was so covered on the basis that the property was *proceeds of an offence, or an *instrument of an offence, to which the restraining order or forfeiture order relates; amounts realised from any sale of the property under section 278 continue to be proceeds of that offence or an instrument of that offence." ;
    skos:definition "Add: (2) If the *controlled property: (a) was covered by a *restraining order or *forfeiture order; and (b) was so covered on the basis that the property was *proceeds of an offence, or an *instrument of an offence, to which the restraining order or forfeiture order relates; amounts realised from any sale of the property under section 278 continue to be proceeds of that offence or an instrument of that offence."@en ;
    cml:integrityHash "6490e8df1a9c35dfe1fe0398310857b0eca3f7ee77a9c73a9d7667bfdc99dfa5" ;
    cof:pageNumber "77"^^xsd:integer ;
    skos:note "Proceeds of an offence or instrument of that offence continue to be proceeds of that offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-economic-disruption-act-2021.pdf> ;
    dc:source "crimes-legislation-amendment-economic-disruption-act-2021.pdf, p.77" ;
