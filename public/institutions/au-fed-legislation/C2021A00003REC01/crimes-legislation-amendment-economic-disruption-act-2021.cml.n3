concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-3-sec-9 a cml:Concept ;
    skos:prefLabel "9 After paragraph 202(5)(eb)"@en ;
    cml:realizedBy doc:sch-3-sec-9 ;
    values:originalText "Insert: (ec) a document relevant to determining whether, in a case where a person has made an application under section 57A for an order under section 57 in relation to an *interest in property: (i) the amount paid to the Commonwealth under paragraph 89(1)(c) would not be property that is covered by subsection 57(6); and (ii) if the whole or a part of the amount paid to the Commonwealth under paragraph 89(1)(c) would be borrowed by the person under a loan—the person’s financial circumstances are such that the person will be able to repay the loan, meet the person’s eligible living expenses and meet any eligible debts of the person,  Schedule 3  Buy-backs" ;
    skos:definition "Insert: (ec) a document relevant to determining whether, in a case where a person has made an application under section 57A for an order under section 57 in relation to an *interest in property: (i) the amount paid to the Commonwealth under paragraph 89(1)(c) would not be property that is covered by subsection 57(6); and (ii) if the whole or a part of the amount paid to the Commonwealth under paragraph 89(1)(c) would be borrowed by the person under a loan—the person’s financial circumstances are such that the person will be able to repay the loan, meet the person’s eligible living expenses and meet any eligible debts of the person,  Schedule 3  Buy-backs"@en ;
    cml:integrityHash "8beecde3125f422a34d4f249c2cf0d8db4fee7864de8217f7d5c074ea56e730f" ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Person must be able to repay loan and meet expenses" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
