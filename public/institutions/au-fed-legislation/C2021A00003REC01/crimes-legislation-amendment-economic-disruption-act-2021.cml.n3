concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-3-sec-14 a cml:Concept ;
    skos:prefLabel "14 Transitional—section 57 of the Proceeds of Crime Act"@en ;
    cml:realizedBy doc:sch-3-sec-14 ;
    values:originalText "Despite the amendment made by item 1, the Proceeds of Crime Act 2002 continues to apply, in relation to: (a) an application made before the commencement of this item for an order under section 57 of that Act; and (b) an order made under section 57 of that Act: (i) after the commencement of this item, in response to such an application; or (ii) before the commencement of this item; as if that amendment had not been made." ;
    skos:definition "Despite the amendment made by item 1, the Proceeds of Crime Act 2002 continues to apply, in relation to: (a) an application made before the commencement of this item for an order under section 57 of that Act; and (b) an order made under section 57 of that Act: (i) after the commencement of this item, in response to such an application; or (ii) before the commencement of this item; as if that amendment had not been made."@en ;
    cml:integrityHash "b2d1279ef468e097450c96e04de117f39c9a030f6cbec7141afb47114ea32f87" ;
    cof:pageNumber "50"^^xsd:integer ;
    skos:note "Continuation of Proceeds of Crime Act 2002 despite amendment" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-economic-disruption-act-2021.pdf> ;
    dc:source "crimes-legislation-amendment-economic-disruption-act-2021.pdf, p.50" ;
    cml:asserts concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-3-sec-14-norm .
