concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-38 a cml:Concept ;
    skos:prefLabel "38 Paragraphs 281(a) and (b)"@en ;
    cml:realizedBy doc:sch-7-sec-38 ;
    values:originalText "Repeal the paragraphs, substitute: (a) if the property was covered by a *restraining order—are taken to be covered by the restraining order; or (b) if the property was covered by a *forfeiture order—are taken to be covered by the forfeiture order; or (c) if the property was forfeited under section 92—are taken to be forfeited under that section; or (d) if the property was subject to a charge under section 142— are taken to be subject to the charge; or (e) if the property was subject to a charge under section 169— are taken to be subject to the charge; or  Official Trustee  Schedule 7 General amendments  Part 1 No. 3, 2021 Crimes Legislation Amendment (Economic Disruption) Act 2021 (f) if the property was subject to a charge under section 179SA—are taken to be subject to the charge." ;
    skos:definition "Repeal the paragraphs, substitute: (a) if the property was covered by a *restraining order—are taken to be covered by the restraining order; or (b) if the property was covered by a *forfeiture order—are taken to be covered by the forfeiture order; or (c) if the property was forfeited under section 92—are taken to be forfeited under that section; or (d) if the property was subject to a charge under section 142— are taken to be subject to the charge; or (e) if the property was subject to a charge under section 169— are taken to be subject to the charge; or  Official Trustee  Schedule 7 General amendments  Part 1 No. 3, 2021 Crimes Legislation Amendment (Economic Disruption) Act 2021 (f) if the property was subject to a charge under section 179SA—are taken to be subject to the charge."@en ;
    cml:integrityHash "f96d1415d5f6a96150f0d15b4d61d26a462327458e148e955c5276c6255721a9" ;
    cof:pageNumber "76"^^xsd:integer ;
    skos:note "Property covered by a restraining order or forfeiture order is taken to be so." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-economic-disruption-act-2021.pdf> ;
    dc:source "crimes-legislation-amendment-economic-disruption-act-2021.pdf, p.76" ;
    cml:asserts concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-38-norm .
