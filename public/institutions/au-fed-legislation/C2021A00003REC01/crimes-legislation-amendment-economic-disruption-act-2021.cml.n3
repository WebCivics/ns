concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-298c a cml:Concept ;
    skos:prefLabel "298C Minister has powers etc. of the Commonwealth"@en ;
    cml:realizedBy doc:sch-7-sec-298c ;
    values:originalText "(1) The Minister, on behalf of the Commonwealth, has all the rights, responsibilities, duties and powers of the Commonwealth in relation to the Commonwealth’s capacity as the grantor of a grant made under section 298A. (2) Without limiting subsection (1): (a) a section 298A grant is to be paid by the Minister on behalf of the Commonwealth; and (b) an amount payable to the Commonwealth by way of the repayment of the whole or a part of a section 298A grant is to be paid to the Minister on behalf of the Commonwealth; and (c) the Minister may institute an action or proceeding on behalf of the Commonwealth in relation to a matter that concerns a section 298A grant." ;
    skos:definition "(1) The Minister, on behalf of the Commonwealth, has all the rights, responsibilities, duties and powers of the Commonwealth in relation to the Commonwealth’s capacity as the grantor of a grant made under section 298A. (2) Without limiting subsection (1): (a) a section 298A grant is to be paid by the Minister on behalf of the Commonwealth; and (b) an amount payable to the Commonwealth by way of the repayment of the whole or a part of a section 298A grant is to be paid to the Minister on behalf of the Commonwealth; and (c) the Minister may institute an action or proceeding on behalf of the Commonwealth in relation to a matter that concerns a section 298A grant."@en ;
    cml:integrityHash "fe1511443225919d886c8ba3379f37f01a1ad88c2c296f2034eec188f996ee7b" ;
    cof:pageNumber "81"^^xsd:integer ;
    cml:hasPart concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-298c-ss-1 ;
    cml:hasPart concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-298c-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-legislation-amendment-economic-disruption-act-2021.pdf> ;
    dc:source "crimes-legislation-amendment-economic-disruption-act-2021.pdf, p.81" .
