doc:sch-7-sec-298e-ss-1 a cof:Section ;
    cof:title "298E(1) Channelling State/Territory grants through the COAG" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Minister decides that a grant of financial assistance should be made to a State or Territory under section 298A, the Minister must, by writing, direct that, as soon as practicable, a specified amount (which must equal the amount of the grant) is to be: (a) debited from the *Confiscated Assets Account; and (b) credited to the *COAG Reform Fund." ;
    cof:pageNumber "81"^^xsd:integer .

concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-298e-ss-2 a cml:Concept ;
    skos:prefLabel "298E(2) Channelling State/Territory grants through the COAG"@en ;
    cml:realizedBy doc:sch-7-sec-298e-ss-2 ;
    values:originalText "(2) The direction must be expressed to be given in order to enable the amount to be debited from the *COAG Reform Fund for the purpose of making the grant." ;
    skos:definition "(2) The direction must be expressed to be given in order to enable the amount to be debited from the *COAG Reform Fund for the purpose of making the grant."@en ;
