concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-36 a cml:Concept ;
    skos:prefLabel "36 At the end of section 279"@en ;
    cml:realizedBy doc:sch-7-sec-36 ;
    values:originalText "Add: Pre-disposal agreement (5) Subsection (1) does not require written notice of the proposed disposal of the *controlled property to be given to a person who has agreed in writing to the disposal of the controlled property. (6) If: (a) a person has agreed to the disposal of the *controlled property; and (b) the *Official Trustee disposes of the property; the Official Trustee must: (c) give the person written notice of the disposal of the property; and (d) do so as soon as practicable after the disposal of the property." ;
    skos:definition "Add: Pre-disposal agreement (5) Subsection (1) does not require written notice of the proposed disposal of the *controlled property to be given to a person who has agreed in writing to the disposal of the controlled property. (6) If: (a) a person has agreed to the disposal of the *controlled property; and (b) the *Official Trustee disposes of the property; the Official Trustee must: (c) give the person written notice of the disposal of the property; and (d) do so as soon as practicable after the disposal of the property."@en ;
    cml:integrityHash "288c7d7b39a912c31881cfb26c4a254735ee57a9b5f115b8d7a709d9f8c85711" ;
    cof:pageNumber "76"^^xsd:integer ;
    cml:hasPart concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-36-ss-5 ;
    cml:hasPart concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-7-sec-36-ss-6 ;
