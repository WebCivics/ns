doc:sch-3-sec-57a-ss-1 a cof:Section ;
    cof:title "57A(1) Applying for an order under section 57" ;
    values:kind "subsection" ;
    values:originalText "(1) A person may apply to a court for an order under section 57 in relation to an *interest in property if an application for a *forfeiture order that could specify property in which the person claims that interest has been made to the court, but the forfeiture order is yet to be made. After a forfeiture order has been made" ;
    cof:pageNumber "41"^^xsd:integer .

concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-3-sec-57a-ss-2 a cml:Concept ;
    skos:prefLabel "57A(2) Applying for an order under section 57"@en ;
    cml:realizedBy doc:sch-3-sec-57a-ss-2 ;
    values:originalText "(2) A person who claims to have had an *interest in property specified in a *forfeiture order immediately before the forfeiture order was made may, at any time after the forfeiture order is made, apply to the court that made the forfeiture order for an order under section 57 in relation to the interest." ;
    skos:definition "(2) A person who claims to have had an *interest in property specified in a *forfeiture order immediately before the forfeiture order was made may, at any time after the forfeiture order is made, apply to the court that made the forfeiture order for an order under section 57 in relation to the interest."@en ;
    cml:integrityHash "e5db12dc1ede668e4fa04114df13e1026cd8505a733c9f7f12821dfc11dced2e" ;
    values:partOf concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-3-sec-57a ;
    cof:pageNumber "41"^^xsd:integer ;
    skos:note "A person may apply to the court for an order under section 57 after the forfeiture order is made." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
