concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-5-sec-5 a cml:Concept ;
    skos:prefLabel "5 At the end of section 314"@en ;
    cml:realizedBy doc:sch-5-sec-5 ;
    values:originalText "Add: (4) The jurisdiction of a court with respect to matters arising under this Act is not excluded or limited merely because the proceedings relate to, or may otherwise concern, property located outside *Australia.  Schedule 5  Jurisdiction of courts" ;
    skos:definition "Add: (4) The jurisdiction of a court with respect to matters arising under this Act is not excluded or limited merely because the proceedings relate to, or may otherwise concern, property located outside *Australia.  Schedule 5  Jurisdiction of courts"@en ;
