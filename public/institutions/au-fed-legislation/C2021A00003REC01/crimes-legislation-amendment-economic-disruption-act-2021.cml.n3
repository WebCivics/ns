concept:crimes-legislation-amendment-economic-disruption-act-2021-sch-6-sec-17 a cml:Concept ;
    skos:prefLabel "17 Subsection 271(2)"@en ;
    cml:realizedBy doc:sch-6-sec-17 ;
    values:originalText "Omit all the words after “against the natural person,”, substitute: except: (c) proceedings under, or arising out of, section 137.1 or 137.2 of the Criminal Code 1995 (false and misleading information and documents) in relation to giving the information or document; or (d) proceedings for an offence against this Division." ;
    skos:definition "Omit all the words after “against the natural person,”, substitute: except: (c) proceedings under, or arising out of, section 137.1 or 137.2 of the Criminal Code 1995 (false and misleading information and documents) in relation to giving the information or document; or (d) proceedings for an offence against this Division."@en ;
    cml:integrityHash "a05a19c36a3f349f6f9914dbb0377aeed16fc7f28ae3ff32dd47e6ba52834ec4" ;
    cof:pageNumber "61"^^xsd:integer ;
