      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Must consult and obtain consent before spending",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Chief Executive Officer must spend the outcome amount."
    },
