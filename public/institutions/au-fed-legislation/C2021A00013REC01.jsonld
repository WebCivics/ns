        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The provision applies its obligations to things done by, or in relation to, a Registrar or Deputy.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "applies"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-9-logic-deontic-4",
