    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-19",
      "@type": "cml:Concept",
      "dc:source": "c2021a00013rec01.pdf, p.223",
      "skos:note": "Things done by, or in relation to, the Chief Executive Officer are taken as having been done by, or in relation to, the new entity.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "19 Things done by, or in relation to, the Chief Executive"
      },
      "wasDerivedFrom": "c2021a00013rec01.pdf",
      "asserts": [
        "concept:c2021a00013rec01-sch-5-sec-19-norm",
        "concept:c2021a00013rec01-sch-5-sec-19-logic-deontic-1",
        "concept:c2021a00013rec01-sch-5-sec-19-logic-descriptionlogic-2",
        "concept:c2021a00013rec01-sch-5-sec-19-logic-alleninterval-3",
        "concept:c2021a00013rec01-sch-5-sec-19-logic-deontic-4",
        "concept:c2021a00013rec01-sch-5-sec-19-logic-deontic-5",
        "concept:c2021a00013rec01-sch-5-sec-19-logic-deontic-6"
      ],
      "cml:curationStatus": {
