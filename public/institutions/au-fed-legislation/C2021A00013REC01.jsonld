      "dc:source": "c2021a00013rec01.pdf, p.224",
      "skos:note": "Things done by, or in relation to, the Marshal or a Deputy are taken as having been done by, or in relation to, the Marshal or a Deputy of the Federal Circuit and Family Court of Australia (Division 2).",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "22 Things done by, or in relation to, the Marshal or a Deputy"
      },
      "wasDerivedFrom": "c2021a00013rec01.pdf",
