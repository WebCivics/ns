    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The office is the same under both laws.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Same office under old and new law",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "old law means Part IV of the Family Law Act 1975, as in force immediately before the commencement day."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-2-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The titles of judicial offices are part of a hierarchical structure.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Same class hierarchy for judicial offices",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "="
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-2-norm",
