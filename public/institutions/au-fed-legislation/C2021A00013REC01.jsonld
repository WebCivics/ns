      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The provision requires things done by, or in relation to, a Registrar or Deputy to be done by, or in relation to, a Senior Registrar.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must be done by, or in relation to"
