    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Family Court of Australia means the federal court known, immediately before the commencement day, as the Family Court of Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Family Court of a State means a court to which section 41 of the Family Law Act 1975, as amended by this Act, applies."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Federal Circuit Court of Australia means the federal court known, immediately before the commencement day, as the Federal Circuit Court of Australia.",
