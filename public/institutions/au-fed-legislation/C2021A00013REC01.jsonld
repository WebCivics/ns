        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Federal Circuit and Family Court of Australia has the same meaning as in the new law."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Federal Court means the Federal Court of Australia.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Full Court, in relation to the Federal Circuit and Family Court of Australia (Division 1), means 2 or more Judges of the Court."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Continuity of the Family Court of Australia, and Judges and personnel of the Court",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies terms into categories",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "new law means the Federal Circuit and Family Court of Australia Act 2021."
    },
