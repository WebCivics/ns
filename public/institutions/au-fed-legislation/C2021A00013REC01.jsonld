      "cml:logicSummary": "The provision takes things done by, or in relation to, a Registrar or Deputy and applies them to a Senior Registrar.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "takes"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-9-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
