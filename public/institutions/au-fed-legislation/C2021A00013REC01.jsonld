      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Minister may determine that subitem (1) does not apply in relation to a specified thing done by, or in relation to, a Registrar of the Family Court of Australia.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may determine"
    },
