concept:c2021a00013rec01-sch-1-sec-270 a cml:Concept ;
    skos:prefLabel "270 Subsection 249(2)"@en ;
    cml:realizedBy doc:sch-1-sec-270 ;
    values:originalText "Repeal the subsection, substitute: (2) The Chief Judge may appoint committees consisting of Judges, or of Judges and other persons, for the purpose of: (a) advising the Judges of the Federal Circuit and Family Court of Australia (Division 2) in relation to the making of Rules of Court; or (b) advising the Chief Judge in relation to the management of the administrative affairs of the Federal Circuit and Family Court of Australia (Division 2)." ;
    skos:definition "Repeal the subsection, substitute: (2) The Chief Judge may appoint committees consisting of Judges, or of Judges and other persons, for the purpose of: (a) advising the Judges of the Federal Circuit and Family Court of Australia (Division 2) in relation to the making of Rules of Court; or (b) advising the Chief Judge in relation to the management of the administrative affairs of the Federal Circuit and Family Court of Australia (Division 2)."@en ;
    cml:integrityHash "757e63b0a3befd48e8a35b7d45080cf5d88ca25a1ad7bcffc73fa282c6eac61c" ;
    cof:pageNumber "73"^^xsd:integer ;
    skos:note "Repeal subsection, substitute with new appointment rules for the Chief Judge." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2021a00013rec01.pdf> ;
    dc:source "c2021a00013rec01.pdf, p.73" ;
