doc:sch-2-sec-165 a cof:Section ;
    cof:title "165 Subsection 100(1)" ;
    values:kind "section" ;
    values:originalText "Omit “(other than Part X of that Act), the standard Rules of Court and the related Federal Circuit Court Rules”, substitute “(other than Division 4 of Part V of that Act), the standard Rules of Court, the Federal Circuit and Family Court of Australia (Division 1) Rules and the related Federal Circuit and Family Court of Australia (Division 2) Rules”." ;
    cof:pageNumber "98"^^xsd:integer .

