concept:c2021a00013rec01-sch-1-sec-227 a cml:Concept ;
    skos:prefLabel "227 After paragraph 59(2)(r)"@en ;
    cml:realizedBy doc:sch-1-sec-227 ;
    values:originalText "Insert: (ra) the transfer of proceedings from the Federal Circuit and Family Court of Australia (Division 2), including matters relating to costs, such as: (i) the costs of the application for an order transferring such a proceeding; and (ii) the costs for any step in such a proceeding, including steps that occurred before the proceeding was transferred; and (iii) the scale of costs that is to apply; and  Amendments relating to the Federal Circuit and Family Court of Australia  Schedule 1 Application, saving and transitional provisions  Part 2 No. 13, 2021 Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021" ;
    skos:definition "Insert: (ra) the transfer of proceedings from the Federal Circuit and Family Court of Australia (Division 2), including matters relating to costs, such as: (i) the costs of the application for an order transferring such a proceeding; and (ii) the costs for any step in such a proceeding, including steps that occurred before the proceeding was transferred; and (iii) the scale of costs that is to apply; and  Amendments relating to the Federal Circuit and Family Court of Australia  Schedule 1 Application, saving and transitional provisions  Part 2 No. 13, 2021 Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021"@en ;
    cml:integrityHash "ca60da7cc69a936cb3d0c1041c9044fb030c5f75c1d943456981f5d1c6dcb240" ;
    cof:pageNumber "64"^^xsd:integer ;
    skos:note "Transfer of proceedings from Federal Circuit and Family Court of Australia is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
