concept:c2021a00013rec01-sch-1-sec-18pb a cml:Concept ;
    skos:prefLabel "18PB Deputy Marshals"@en ;
    cml:realizedBy doc:sch-1-sec-18pb ;
    values:originalText "A Deputy Marshal of the Court may, subject to any directions of the Marshal of the Court, exercise or perform any of the powers or functions of the Marshal." ;
    skos:definition "A Deputy Marshal of the Court may, subject to any directions of the Marshal of the Court, exercise or perform any of the powers or functions of the Marshal."@en ;
