concept:c2021a00013rec01-sch-2-sec-574 a cml:Concept ;
    skos:prefLabel "574 Subsection 503C(3)"@en ;
    cml:realizedBy doc:sch-2-sec-574 ;
    values:originalText "Omit “the Federal Circuit Court may, on application by the Minister, make such orders as the Federal Court or the Federal Circuit Court considers appropriate for the purpose of ensuring that, in the event that the subsection 503B(1) application is made and the information is disclosed to the Federal Court or the Federal Circuit Court”, substitute “the Federal Circuit and Family Court of Australia (Division 2) may, on application by the Minister, make such orders as the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) considers appropriate for the purpose of ensuring that, in the event that the subsection 503B(1) application is made and the information is disclosed to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2)”." ;
    skos:definition "Omit “the Federal Circuit Court may, on application by the Minister, make such orders as the Federal Court or the Federal Circuit Court considers appropriate for the purpose of ensuring that, in the event that the subsection 503B(1) application is made and the information is disclosed to the Federal Court or the Federal Circuit Court”, substitute “the Federal Circuit and Family Court of Australia (Division 2) may, on application by the Minister, make such orders as the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) considers appropriate for the purpose of ensuring that, in the event that the subsection 503B(1) application is made and the information is disclosed to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2)”."@en ;
    cml:integrityHash "ed966220dbb6e26217fbb55e2bc9acf0c243f322c6c703db98f7494959bdd11f" ;
    cof:pageNumber "159"^^xsd:integer ;
    skos:note "Permits the Federal Circuit and Family Court of Australia (Division 2) to make orders on application by the Minister." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2021a00013rec01.pdf> ;
