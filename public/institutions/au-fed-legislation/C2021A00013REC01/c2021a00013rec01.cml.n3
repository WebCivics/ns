    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-68 a cof:Section ;
    cof:title "68 Paragraphs 46(3A)(a) to (c)" ;
    values:kind "section" ;
    values:originalText "Repeal the paragraphs, substitute: (a) the Federal Circuit and Family Court of Australia (Division 2); (b) a Family Court of a State; (c) the Supreme Court of a State or Territory;" ;
    cof:pageNumber "28"^^xsd:integer .

