concept:c2021a00013rec01-sch-5-sec-37 a cml:Concept ;
    skos:prefLabel "37 Application"@en ;
    cml:realizedBy doc:sch-5-sec-37 ;
    values:originalText "The Federal Circuit and Family Court of Australia Act 2021, including the following provisions of that Act: (a) Division 4 of Part 5 of Chapter 3 (Case management); (b) Division 4 of Part 6 of Chapter 4 (Case management); applies in relation to a proceeding commenced before, on or after the commencement day." ;
    skos:definition "The Federal Circuit and Family Court of Australia Act 2021, including the following provisions of that Act: (a) Division 4 of Part 5 of Chapter 3 (Case management); (b) Division 4 of Part 6 of Chapter 4 (Case management); applies in relation to a proceeding commenced before, on or after the commencement day."@en ;
    cml:integrityHash "cd63c7ea2480aeff50dafce13908a5ac596a0a6a23bc548f7e4847c3bc862e75" ;
    cof:pageNumber "237"^^xsd:integer ;
    skos:note "Applicable to proceedings commenced before, on or after the commencement day." ;
    cml:curationStatus cml:Proposed ;
