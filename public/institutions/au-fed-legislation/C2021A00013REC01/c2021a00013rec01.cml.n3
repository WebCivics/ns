concept:c2021a00013rec01-sch-1-sec-239 a cml:Concept ;
    skos:prefLabel "239 Paragraph 127(1)(a)"@en ;
    cml:realizedBy doc:sch-1-sec-239 ;
    values:originalText "Repeal the paragraph, substitute: (a) the person: (i) has not attained the age of 18 years; or (ii) has attained the age of 18 years but has not attained the age of 25 years and is receiving full-time education at a school, college or university; and" ;
    skos:definition "Repeal the paragraph, substitute: (a) the person: (i) has not attained the age of 18 years; or (ii) has attained the age of 18 years but has not attained the age of 25 years and is receiving full-time education at a school, college or university; and"@en ;
    cml:integrityHash "335ff61aada7e8bae35401c536bad986ef0cf3068147485e93c6a94fbb57cc98" ;
    cof:pageNumber "69"^^xsd:integer ;
    skos:note "Repeal paragraph, substitute with conditions for age and education" ;
    cml:curationStatus cml:Proposed ;
