concept:c2021a00013rec01-sch-1-sec-261 a cml:Concept ;
    skos:prefLabel "261 Subsection 82(2)"@en ;
    cml:realizedBy doc:sch-1-sec-261 ;
    values:originalText "Repeal the subsection, substitute: (2) The Chief Justice may appoint committees consisting of Judges, or of Judges and other persons, for the purpose of: (a) advising the Judges of the Federal Circuit and Family Court of Australia (Division 1) in relation to the making of Rules of Court; or (b) advising the Chief Justice in relation to the management of the administrative affairs of the Federal Circuit and Family Court of Australia (Division 1)." ;
    skos:definition "Repeal the subsection, substitute: (2) The Chief Justice may appoint committees consisting of Judges, or of Judges and other persons, for the purpose of: (a) advising the Judges of the Federal Circuit and Family Court of Australia (Division 1) in relation to the making of Rules of Court; or (b) advising the Chief Justice in relation to the management of the administrative affairs of the Federal Circuit and Family Court of Australia (Division 1)."@en ;
    cml:integrityHash "60f816d86d7a4abc403f4fc0aa155ac9e37ba59f03627b16edfb4ec312cf92f7" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Repeal subsection, substitute with new appointment rules for the Chief Justice." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
