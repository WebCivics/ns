    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Chief Judge must deal with complaint." ;
    cml:premiseText "Complaint made about a Judge of the Federal Circuit Court of Australia." ;
    cml:conclusionText "Chief Judge deals with complaint." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-5-sec-24 cml:asserts concept:c2021a00013rec01-sch-5-sec-24-logic-alleninterval-2 .
