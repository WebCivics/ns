    values:partOf concept:c2021a00013rec01-sch-1-sec-32ad ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "No appeal from a decision confirming the transfer of proceedings." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
