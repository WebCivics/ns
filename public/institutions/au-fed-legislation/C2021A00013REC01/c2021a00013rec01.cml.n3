concept:c2021a00013rec01-sch-1-sec-229 a cml:Concept ;
    skos:prefLabel "229 Application"@en ;
    cml:realizedBy doc:sch-1-sec-229 ;
    values:originalText "The amendments of the Family Law Act 1975 and the Federal Court of Australia Act 1976 made by this Schedule apply in relation to a proceeding commenced before, on or after the commencement day." ;
