    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Duty to consult" ;
    cml:premiseText "Chief Executive Officer must consult the person or persons mentioned in that item about the decision." ;
    cml:conclusionText "The Chief Executive Officer MUST consult the person or persons mentioned in that item about the decision." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-1-sec-196 cml:asserts concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-2 .
concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-2 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Duty to obtain consent from Attorney-General" ;
    cml:premiseText "Either the person or persons mentioned in that item MUST consent to the decision, OR the Attorney-General MUST consent to the decision." ;
    cml:conclusionText "The person or persons mentioned in that item MUST consent to the decision, OR the Attorney-General MUST consent to the decision." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-1-sec-196 cml:asserts concept:c2021a00013rec01-sch-1-sec-196-logic-alleninterval-3 .
concept:c2021a00013rec01-sch-1-sec-196-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Temporal interval for consultation" ;
    cml:premiseText "Before the Chief Executive Officer makes a decision that has the effect of imposing an expenditure obligation relating to the administrative affairs of a court mentioned in an item of the following table." ;
    cml:conclusionText "The consultation must occur before the decision is made." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-1-sec-196 cml:asserts concept:c2021a00013rec01-sch-1-sec-196-logic-ltl-4 .
concept:c2021a00013rec01-sch-1-sec-196-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "RECURSIVE" ;
    cml:logicSummary "Recurring duty to consult" ;
    cml:premiseText "When performing functions, or exercising powers, under this section, the Chief Executive Officer MUST consult the person or persons mentioned in that item about the decision." ;
    cml:conclusionText "The duty to consult is recurring and must be performed every time a decision is made." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-1-sec-196 cml:asserts concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-5 .
concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Duty to obtain consent from Attorney-General" ;
    cml:premiseText "Either the person or persons mentioned in that item MUST consent to the decision, OR the Attorney-General MUST consent to the decision." ;
    cml:conclusionText "The Attorney-General MUST consent to the decision." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-1-sec-196 a cof:Section ;
    cof:title "196 Subsection 18Z(5)" ;
    values:kind "section" ;
    values:originalText "Repeal the subsection, substitute: (5) When performing functions, or exercising powers, under this section, before the Chief Executive Officer makes a decision that has the effect of imposing an expenditure obligation relating to the administrative affairs of a court mentioned in an item of the following table: (a) the Chief Executive Officer must consult the person or persons mentioned in that item about the decision; and (b) either: (i) the person or persons mentioned in that item must consent to the decision; or (ii) the Attorney-General must consent to the decision, after the Attorney-General has consulted the person or persons mentioned in that item about the decision. Consultation about expenditure relating to administrative affairs Item Court Persons to be consulted The Court The Chief Justice The Federal Circuit and Family Court of Australia (Division 1) Both: (a) the Chief Justice of the Federal Circuit and Family Court of Australia (Division 1); and (b) the Chief Justice of the Court The Federal Circuit and Family Court of Australia (Division 2) Both: (a) the Chief Judge of the Federal Circuit and Family Court of Australia (Division 2); and (b) the Chief Justice of the Court" ;
    cof:pageNumber "52"^^xsd:integer .

concept:c2021a00013rec01-sch-1-sec-197 a cml:Concept ;
    skos:prefLabel "197 Subparagraphs 18ZB(a)(iv) to (ix)"@en ;
    cml:realizedBy doc:sch-1-sec-197 ;
    values:originalText "Repeal the subparagraphs, substitute: (iv) the Chief Executive Officer of the Federal Circuit and Family Court of Australia;  Amendments relating to the Federal Circuit and Family Court of Australia  Schedule 1 Amendments  Part 1 No. 13, 2021 Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021 (v) the officers of the Federal Circuit and Family Court of Australia (Division 1) referred to in subsection 103(1) of the Federal Circuit and Family Court of Australia Act 2021; (vi) the staff of the Registries of the Federal Circuit and Family Court of Australia (Division 1) referred to in subsection 103(6) of the Federal Circuit and Family Court of Australia Act 2021; (vii) the officers of the Federal Circuit and Family Court of Australia (Division 2) referred to in section 259 of the Federal Circuit and Family Court of Australia Act 2021; (viii) the staff of the Federal Circuit and Family Court of Australia (Division 2) referred to in section 265 of the Federal Circuit and Family Court of Australia Act 2021;" ;
    skos:definition "Repeal the subparagraphs, substitute: (iv) the Chief Executive Officer of the Federal Circuit and Family Court of Australia;  Amendments relating to the Federal Circuit and Family Court of Australia  Schedule 1 Amendments  Part 1 No. 13, 2021 Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021 (v) the officers of the Federal Circuit and Family Court of Australia (Division 1) referred to in subsection 103(1) of the Federal Circuit and Family Court of Australia Act 2021; (vi) the staff of the Registries of the Federal Circuit and Family Court of Australia (Division 1) referred to in subsection 103(6) of the Federal Circuit and Family Court of Australia Act 2021; (vii) the officers of the Federal Circuit and Family Court of Australia (Division 2) referred to in section 259 of the Federal Circuit and Family Court of Australia Act 2021; (viii) the staff of the Federal Circuit and Family Court of Australia (Division 2) referred to in section 265 of the Federal Circuit and Family Court of Australia Act 2021;"@en ;
    cml:integrityHash "1d50942bd702e2d5921bc75b257766205d306568554edba65172e41b24d68a25" ;
    cof:pageNumber "52"^^xsd:integer ;
