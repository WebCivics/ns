concept:c2021a00013rec01-sch-2-sec-485 a cml:Concept ;
    skos:prefLabel "485 Subsection 4(1) (after paragraph (b) of the definition of"@en ;
    cml:realizedBy doc:sch-2-sec-485 ;
    values:originalText "appropriate current judicial salary) Insert: (ba) in the case of a Judge who was a Chief Justice of the Family Court of Australia—the salary for the time being payable to the Chief Justice of the Federal Circuit and Family Court of Australia (Division 1); and (bb) in the case of a Judge who was a Deputy Chief Justice of the Family Court of Australia—the salary for the time being payable to the Deputy Chief Justice of the Federal Circuit and Family Court of Australia (Division 1); and" ;
    skos:definition "appropriate current judicial salary) Insert: (ba) in the case of a Judge who was a Chief Justice of the Family Court of Australia—the salary for the time being payable to the Chief Justice of the Federal Circuit and Family Court of Australia (Division 1); and (bb) in the case of a Judge who was a Deputy Chief Justice of the Family Court of Australia—the salary for the time being payable to the Deputy Chief Justice of the Federal Circuit and Family Court of Australia (Division 1); and"@en ;
    cml:integrityHash "2f2324087dba0920cde121b3f53628ad2c8c8086796003acdff774ba7e1daf39" ;
    cof:pageNumber "145"^^xsd:integer ;
    skos:note "Judges' salaries" ;
