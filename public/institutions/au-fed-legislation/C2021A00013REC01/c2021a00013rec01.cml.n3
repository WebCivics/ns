concept:c2021a00013rec01-sch-1-sec-18zg a cml:Concept ;
    skos:prefLabel "18ZG Delegation of powers etc. under the Public Service Act 1999"@en ;
    cml:realizedBy doc:sch-1-sec-18zg ;
    values:originalText "Section 78 of the Public Service Act 1999 applies, in relation to the administrative affairs of the Federal Circuit and Family Court of Australia, as if the reference in subsection (7) to another person were a reference to the Chief Executive Officer of the Federal Circuit and Family Court of Australia." ;
    skos:definition "Section 78 of the Public Service Act 1999 applies, in relation to the administrative affairs of the Federal Circuit and Family Court of Australia, as if the reference in subsection (7) to another person were a reference to the Chief Executive Officer of the Federal Circuit and Family Court of Australia."@en ;
    cml:integrityHash "46bebf58b1a0db23b71c34de858b84c4073847a77cc50b9b6e42ed3e069c9ead" ;
    cof:pageNumber "56"^^xsd:integer ;
    skos:note "Delegation of powers under the Public Service Act 1999" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
