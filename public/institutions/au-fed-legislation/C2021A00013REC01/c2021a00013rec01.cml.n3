doc:sch-1-sec-32ad-ss-1 a cof:Section ;
    cof:title "32AD(1) Confirmation of civil proceedings transferred from the" ;
    values:kind "subsection" ;
    values:originalText "(1) If the Federal Circuit and Family Court of Australia (Division 2) makes an order under subsection 153(1) of the Federal Circuit and Family Court of Australia Act 2021 transferring a proceeding to the Court, the Court may, by order, confirm the transfer of the proceeding to the Court. Note: The transfer of a proceeding takes effect on the day the Court makes an order under this section in relation to the proceeding: see subsection 153(4) of the Federal Circuit and Family Court of Australia Act 2021." ;
    cof:pageNumber "62"^^xsd:integer .

concept:c2021a00013rec01-sch-1-sec-32ad-ss-2 a cml:Concept ;
    skos:prefLabel "32AD(2) Confirmation of civil proceedings transferred from the"@en ;
    cml:realizedBy doc:sch-1-sec-32ad-ss-2 ;
    values:originalText "(2) The Court may, in its discretion, receive further evidence to decide whether to make an order under subsection (1). Such evidence may be taken in any of the ways mentioned in section 27." ;
    skos:definition "(2) The Court may, in its discretion, receive further evidence to decide whether to make an order under subsection (1). Such evidence may be taken in any of the ways mentioned in section 27."@en ;
    cml:integrityHash "079269a74d2f94f4c0d08a30a052cafd5064d4e689e41e64634da4f60e61eaf2" ;
    values:partOf concept:c2021a00013rec01-sch-1-sec-32ad ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "Court may receive further evidence to decide on making an order." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
