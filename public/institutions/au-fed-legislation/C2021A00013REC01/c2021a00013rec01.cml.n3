    cml:modality cml:AllenInterval ;
    cml:operator "between" ;
    cml:logicSummary "Temporal interval between amendment and commencement" ;
    cml:premiseText "The amendments take effect on the commencement date." ;
    cml:conclusionText "The amendments apply between the commencement date and the end of the period specified in the Schedule." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-2-sec-147 cml:asserts concept:c2021a00013rec01-sch-2-sec-147-logic-ltl-3 .
