doc:sch-1-sec-233 a cof:Section ;
    cof:title "233 Delegation" ;
    values:kind "section" ;
    values:originalText "An instrument made under section 38W of the Family Law Act 1975 and in force immediately before the commencement day continues in force (and may be dealt with) as if it had been made under section 108 of the Federal Circuit and Family Court of Australia Act 2021." ;
    cof:pageNumber "66"^^xsd:integer .

concept:c2021a00013rec01-sch-1-sec-234 a cml:Concept ;
    skos:prefLabel "234 Proclamation"@en ;
    cml:realizedBy doc:sch-1-sec-234 ;
    values:originalText "Despite the repeal of section 96 of the Family Law Act 1975 by this Act, a Proclamation made under subsection 96(3) of that Act and in force immediately before the commencement day, continues in force (and may be dealt with) as if: (a) it had been made under subsection 47A(5) of the Family Law Act 1975, as inserted by this Act; and (b) the Supreme Courts specified in that Proclamation are also specified for the purposes of appeals in relation to: (i) the Child Support (Assessment) Act 1989; or (ii) the Child Support (Registration and Collection) Act 1988." ;
    skos:definition "Despite the repeal of section 96 of the Family Law Act 1975 by this Act, a Proclamation made under subsection 96(3) of that Act and in force immediately before the commencement day, continues in force (and may be dealt with) as if: (a) it had been made under subsection 47A(5) of the Family Law Act 1975, as inserted by this Act; and (b) the Supreme Courts specified in that Proclamation are also specified for the purposes of appeals in relation to: (i) the Child Support (Assessment) Act 1989; or (ii) the Child Support (Registration and Collection) Act 1988."@en ;
    cml:integrityHash "c6c455de6986b43d4dfa0f9a9dc0f76a665afdd8acd0eae56a3b5ee7e344e4dc" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "Continuation of a proclamation despite repeal" ;
