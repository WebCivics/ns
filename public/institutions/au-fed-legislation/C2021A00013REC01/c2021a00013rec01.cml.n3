concept:c2021a00013rec01-sch-2-sec-3b a cml:Concept ;
    skos:prefLabel "3B Service in more than one judicial office"@en ;
    cml:realizedBy doc:sch-2-sec-3b ;
    values:originalText "To avoid doubt, a person may satisfy the definition of Judge at a particular time even if the person also holds, at the same time, an office as a Judge of the Federal Circuit and Family Court of Australia (Division 2). Note: See paragraph (a) of the definition of Judge in section 3. Judges’ Pensions Act 1968" ;
    skos:definition "To avoid doubt, a person may satisfy the definition of Judge at a particular time even if the person also holds, at the same time, an office as a Judge of the Federal Circuit and Family Court of Australia (Division 2). Note: See paragraph (a) of the definition of Judge in section 3. Judges’ Pensions Act 1968"@en ;
    cml:integrityHash "8818902754e383f61c4265d020da433b97c14ad721aedf79d6ddb292ff3f7e71" ;
    cof:pageNumber "145"^^xsd:integer ;
    skos:note "A person may satisfy the definition of Judge even if holding another office." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
