concept:c2021a00013rec01-sch-5-sec-17 a cml:Concept ;
    skos:prefLabel "17 Application of subsection 25B(1) of the Acts Interpretation"@en ;
    cml:realizedBy doc:sch-5-sec-17 ;
    values:originalText "Act 1901 Subsection 25B(1) of the Acts Interpretation Act 1901 applies as if: (a) the Federal Circuit Court of Australia were a body; and (b) the offices of Chief Judge and Judge were offices." ;
    skos:definition "Act 1901 Subsection 25B(1) of the Acts Interpretation Act 1901 applies as if: (a) the Federal Circuit Court of Australia were a body; and (b) the offices of Chief Judge and Judge were offices."@en ;
    cml:integrityHash "ebf737ed74cd8db9dbded927f38f55cec630b7a2eb65ce3ea5fd2808355966b5" ;
    cof:pageNumber "222"^^xsd:integer ;
    skos:note "Act applies as if Federal Circuit Court of Australia were a body and offices of Chief Judge and Judge were offices." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2021a00013rec01.pdf> ;
