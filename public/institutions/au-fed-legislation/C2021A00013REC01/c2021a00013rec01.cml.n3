    cml:modality cml:Argumentation ;
    cml:operator "IMPLIES" ;
    cml:logicSummary "Chief Judge's dealing with complaint implies a duty to address concerns about Judges." ;
    cml:premiseText "Chief Judge deals with complaint." ;
    cml:conclusionText "Chief Judge addresses concerns about Judges." ;
    cml:executionSurface "modalities::argumentation" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-5-sec-24 cml:asserts concept:c2021a00013rec01-sch-5-sec-24-logic-dialectical-4 .
