concept:c2021a00013rec01-sch-2-sec-581 a cml:Concept ;
    skos:prefLabel "581 Subsection 3(1)"@en ;
    cml:realizedBy doc:sch-2-sec-581 ;
    values:originalText "Insert: eligible Judge means a Judge of the Federal Circuit and Family Court of Australia (Division 2) in relation to whom a consent under subsection 38ZC(1) and a nomination under subsection 38ZC(2) are in force." ;
