concept:c2021a00013rec01-sch-1-sec-55aa a cml:Concept ;
    skos:prefLabel "55AA Actions by or against Marshal"@en ;
    cml:realizedBy doc:sch-1-sec-55aa ;
    values:originalText "If the Marshal or a Deputy Marshal is a party to a proceeding in the Court: (a) all writs, summonses, orders, warrants, precepts, process and commands in the proceeding which should, in the ordinary course, be directed to the Marshal must be directed to such disinterested person as the Court or a Judge appoints; and (b) the person so appointed may execute and return them." ;
    skos:definition "If the Marshal or a Deputy Marshal is a party to a proceeding in the Court: (a) all writs, summonses, orders, warrants, precepts, process and commands in the proceeding which should, in the ordinary course, be directed to the Marshal must be directed to such disinterested person as the Court or a Judge appoints; and (b) the person so appointed may execute and return them."@en ;
    cml:integrityHash "edd8791789551c1fbaf8be3303255b4ac55eafde99c1c5832f5af1a33db2c258" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Marshal must direct writs and commands to a disinterested person appointed by the Court or Judge." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2021a00013rec01.pdf> ;
