concept:c2021a00013rec01-sch-3-sec-5 a cml:Concept ;
    skos:prefLabel "5 Seals and stamps"@en ;
    cml:realizedBy doc:sch-3-sec-5 ;
    values:originalText "Despite the repeal of the Federal Circuit Court of Australia Act 1999: (a) the seal of the Federal Circuit Court of Australia, existing immediately before the commencement day, may be affixed to documents (in accordance with subsection 178(3) of the Federal Circuit and Family Court of Australia Act 2021) until the end of the 12-month period beginning on the commencement day, as if it were the seal of the Federal Circuit and Family Court of Australia (Division 2); and (b) a Federal Circuit Court of Australia stamp, existing immediately before the commencement day, may be affixed to documents (in accordance with subsection 179(3) of the Federal Circuit and Family Court of Australia Act 2021) until the end of the 12-month period beginning on the commencement day, as if it were a stamp of the Federal Circuit and Family Court of Australia (Division 2)." ;
    skos:definition "Despite the repeal of the Federal Circuit Court of Australia Act 1999: (a) the seal of the Federal Circuit Court of Australia, existing immediately before the commencement day, may be affixed to documents (in accordance with subsection 178(3) of the Federal Circuit and Family Court of Australia Act 2021) until the end of the 12-month period beginning on the commencement day, as if it were the seal of the Federal Circuit and Family Court of Australia (Division 2); and (b) a Federal Circuit Court of Australia stamp, existing immediately before the commencement day, may be affixed to documents (in accordance with subsection 179(3) of the Federal Circuit and Family Court of Australia Act 2021) until the end of the 12-month period beginning on the commencement day, as if it were a stamp of the Federal Circuit and Family Court of Australia (Division 2)."@en ;
    cml:integrityHash "2a6b172b54e204b2dc0043adc9788fe0e3496edd6cdd1134303e7231e8aa0eea" ;
    cof:pageNumber "200"^^xsd:integer ;
