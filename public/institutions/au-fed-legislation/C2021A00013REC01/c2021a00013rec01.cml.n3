concept:c2021a00013rec01-sch-5-sec-23 a cml:Concept ;
    skos:prefLabel "23 Registries"@en ;
    cml:realizedBy doc:sch-5-sec-23 ;
    values:originalText "Despite the repeal of the Federal Circuit Court of Australia Act 1999, a Registry of the Federal Circuit Court of Australia, existing immediately before the commencement day, continues in existence on and after that day as a Registry of the Federal Circuit and Family Court of Australia (Division 2)." ;
    skos:definition "Despite the repeal of the Federal Circuit Court of Australia Act 1999, a Registry of the Federal Circuit Court of Australia, existing immediately before the commencement day, continues in existence on and after that day as a Registry of the Federal Circuit and Family Court of Australia (Division 2)."@en ;
    cml:integrityHash "4cc87c6b34a19f5057efe7bf69e8ef397d26d91eb35ca3f5e604ea0cff388e48" ;
    cof:pageNumber "225"^^xsd:integer ;
    skos:note "Registry continuation after repeal" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2021a00013rec01.pdf> ;
    dc:source "c2021a00013rec01.pdf, p.225" ;
