concept:c2021a00013rec01-sch-2-sec-19 a cml:Concept ;
    skos:prefLabel "19 Subsection 3(10)"@en ;
    cml:realizedBy doc:sch-2-sec-19 ;
    values:originalText "Omit all the words after “before the Federal Court”, substitute: by way of: (a) a transfer from the Federal Circuit and Family Court of Australia (Division 2) by the Federal Court under section 32AC of the Federal Court of Australia Act 1976; or (b) a transfer by the Federal Circuit and Family Court of Australia (Division 2) to the Federal Court under section 153 of the Federal Circuit and Family Court of Australia Act 2021 that has been confirmed by the Federal Court under section 32AD of the Federal Court of Australia Act 1976." ;
    skos:definition "Omit all the words after “before the Federal Court”, substitute: by way of: (a) a transfer from the Federal Circuit and Family Court of Australia (Division 2) by the Federal Court under section 32AC of the Federal Court of Australia Act 1976; or (b) a transfer by the Federal Circuit and Family Court of Australia (Division 2) to the Federal Court under section 153 of the Federal Circuit and Family Court of Australia Act 2021 that has been confirmed by the Federal Court under section 32AD of the Federal Court of Australia Act 1976."@en ;
    cml:integrityHash "4ee5ae6a849aa161f8e708168394bba804ac47a9d60fbc4184b07695a7290617" ;
    cof:pageNumber "77"^^xsd:integer ;
    skos:note "Omit all words after 'before the Federal Court' and substitute with a transfer from the Federal Circuit and Family Court of Australia." ;
