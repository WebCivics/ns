concept:c2021a00013rec01-sch-2-sec-186 a cml:Concept ;
    skos:prefLabel "186 At the end of section 16"@en ;
    cml:realizedBy doc:sch-2-sec-186 ;
    values:originalText "Add: (2) Proceedings are also excluded proceedings to the extent that they are: (a) proceedings falling within the original or appellate jurisdiction of the Federal Circuit and Family Court of  Further consequential amendments  Schedule 2  No. 13, 2021 Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021 Australia (Division 1) (see Part 2 of Chapter 3 of the Federal Circuit and Family Court of Australia Act 2021); or (b) proceedings falling within the original jurisdiction of the Federal Circuit and Family Court of Australia (Division 2) under section 132 of that Act." ;
    skos:definition "Add: (2) Proceedings are also excluded proceedings to the extent that they are: (a) proceedings falling within the original or appellate jurisdiction of the Federal Circuit and Family Court of  Further consequential amendments  Schedule 2  No. 13, 2021 Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021 Australia (Division 1) (see Part 2 of Chapter 3 of the Federal Circuit and Family Court of Australia Act 2021); or (b) proceedings falling within the original jurisdiction of the Federal Circuit and Family Court of Australia (Division 2) under section 132 of that Act."@en ;
    cml:integrityHash "dd416e2f216a27dae4b4a04f329f7c8b57c4fceff1c57a89c8ee8bbc31064c66" ;
    cof:pageNumber "102"^^xsd:integer ;
    skos:note "Proceedings are excluded from the extent that they fall within the original or appellate jurisdiction of the Federal Circuit and Family Court of Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2021a00013rec01.pdf> ;
    dc:source "c2021a00013rec01.pdf, p.102" ;
