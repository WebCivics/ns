    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Complaint must occur before commencement day for Chief Judge to deal with it." ;
    cml:premiseText "Complaint made on or after commencement day." ;
    cml:conclusionText "Complaint occurred before commencement day." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-5-sec-24 cml:asserts concept:c2021a00013rec01-sch-5-sec-24-logic-argumentation-3 .
