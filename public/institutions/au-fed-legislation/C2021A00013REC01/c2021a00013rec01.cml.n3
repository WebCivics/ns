concept:c2021a00013rec01-sch-1-sec-47e a cml:Concept ;
    skos:prefLabel "47E Regulations to be sole source of certain appellate jurisdiction"@en ;
    cml:realizedBy doc:sch-1-sec-47e ;
    values:originalText "Despite the provisions of this Division, a court has appellate jurisdiction in relation to a matter arising under regulations made for the purposes of section 111C only as provided by those regulations." ;
    skos:definition "Despite the provisions of this Division, a court has appellate jurisdiction in relation to a matter arising under regulations made for the purposes of section 111C only as provided by those regulations."@en ;
    cml:integrityHash "075d4baa90aa8c0b718ee86cb9d9c86e2d55d9c65dd939617541d73c99fb5ad4" ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "Court has appellate jurisdiction in relation to matters arising under regulations made for the purposes of section 111C." ;
    cml:curationStatus cml:Proposed ;
