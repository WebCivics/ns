concept:c2021a00013rec01-sch-5-sec-7 a cml:Concept ;
    skos:prefLabel "7 Things done by the Family Court of Australia or Judges of"@en ;
    cml:realizedBy doc:sch-5-sec-7 ;
    values:originalText "the Court To avoid doubt, the amendments made by this Act do not affect the validity of anything done, before the commencement day, by or in relation to: (a) the Family Court of Australia; or (b) a Full Court of the Family Court of Australia; or (c) the Chief Justice, the Deputy Chief Justice, a Senior Judge or a Judge of the Family Court of Australia; or  Schedule 5  Transitional provisions" ;
    skos:definition "the Court To avoid doubt, the amendments made by this Act do not affect the validity of anything done, before the commencement day, by or in relation to: (a) the Family Court of Australia; or (b) a Full Court of the Family Court of Australia; or (c) the Chief Justice, the Deputy Chief Justice, a Senior Judge or a Judge of the Family Court of Australia; or  Schedule 5  Transitional provisions"@en ;
    cml:integrityHash "739e3f8ab466747c69cb14a47ec2e716893b440fe3ff2da74ae8608a0a24d937" ;
    cof:pageNumber "217"^^xsd:integer ;
    skos:note "Amendments do not affect validity of actions taken before commencement day." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
