concept:c2021a00013rec01-sch-5-sec-1 a cml:Concept ;
    skos:prefLabel "1 Definitions"@en ;
    cml:realizedBy doc:sch-5-sec-1 ;
    values:originalText "In this Schedule: commencement day means the day this Schedule commences. Family Court of a State means a court to which section 41 of the Family Law Act 1975, as amended by this Act, applies. Family Court of Australia means the federal court known, immediately before the commencement day, as the Family Court of Australia. Federal Circuit and Family Court of Australia has the same meaning as in the new law. Federal Circuit Court of Australia means the federal court known, immediately before the commencement day, as the Federal Circuit Court of Australia. Federal Court means the Federal Court of Australia. Full Court, in relation to the Federal Circuit and Family Court of Australia (Division 1), means 2 or more Judges of the Court. new law means the Federal Circuit and Family Court of Australia Act 2021.  Transitional provisions  Schedule 5 Continuity of the Family Court of Australia, and Judges and personnel of the Court" ;
    skos:definition "In this Schedule: commencement day means the day this Schedule commences. Family Court of a State means a court to which section 41 of the Family Law Act 1975, as amended by this Act, applies. Family Court of Australia means the federal court known, immediately before the commencement day, as the Family Court of Australia. Federal Circuit and Family Court of Australia has the same meaning as in the new law. Federal Circuit Court of Australia means the federal court known, immediately before the commencement day, as the Federal Circuit Court of Australia. Federal Court means the Federal Court of Australia. Full Court, in relation to the Federal Circuit and Family Court of Australia (Division 1), means 2 or more Judges of the Court. new law means the Federal Circuit and Family Court of Australia Act 2021.  Transitional provisions  Schedule 5 Continuity of the Family Court of Australia, and Judges and personnel of the Court"@en ;
    cml:integrityHash "dbcb016582a60fa8698090724fb0e80a11a9f0d07a01d29724c59af7093b63c3" ;
    cof:pageNumber "214"^^xsd:integer ;
    skos:note "Defines terms related to the Family Court of Australia and its judges." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2021a00013rec01.pdf> ;
    dc:source "c2021a00013rec01.pdf, p.214" ;
