concept:c2021a00013rec01-sch-1-sec-195 a cml:Concept ;
    skos:prefLabel "195 Paragraphs 18Z(3)(b) to (e)"@en ;
    cml:realizedBy doc:sch-1-sec-195 ;
    values:originalText "Repeal the paragraphs, substitute: (b) the Chief Justice of the Federal Circuit and Family Court of Australia (Division 1); (c) the Chief Judge of the Federal Circuit and Family Court of Australia (Division 2); (d) the Chief Executive Officer of the Federal Circuit and Family Court of Australia.  Schedule 1  Amendments relating to the Federal Circuit and Family Court of Australia" ;
    skos:definition "Repeal the paragraphs, substitute: (b) the Chief Justice of the Federal Circuit and Family Court of Australia (Division 1); (c) the Chief Judge of the Federal Circuit and Family Court of Australia (Division 2); (d) the Chief Executive Officer of the Federal Circuit and Family Court of Australia.  Schedule 1  Amendments relating to the Federal Circuit and Family Court of Australia"@en ;
    cml:integrityHash "e2a2ca25f48876ddae58de3ccb566d5571bfec02870b239750388430d6cd8c47" ;
    cof:pageNumber "51"^^xsd:integer ;
    skos:note "Repeal and substitute certain judicial positions with new ones." ;
