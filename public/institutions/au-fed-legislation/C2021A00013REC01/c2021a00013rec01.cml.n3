concept:c2021a00013rec01-sch-2-sec-147 a cml:Concept ;
    skos:prefLabel "147 Section 486"@en ;
    cml:realizedBy doc:sch-2-sec-147 ;
    values:originalText "Omit: A magistrate or Judge of the Federal Court, the Federal Circuit Court or a State or Territory court may issue a warrant to authorise entry to premises or taking of possession of premises or a conveyance, if satisfied of certain matters. substitute: A magistrate or Judge of the Federal Court, the Federal Circuit and Family Court of Australia (Division 2) or a State or Territory court may issue a warrant to authorise entry to premises or taking of possession of premises or a conveyance, if satisfied of certain matters.  Further consequential amendments  Schedule 2  No. 13, 2021 Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021 Broadcasting Legislation Amendment (Broadcasting Reform) Act 2017" ;
    skos:definition "Omit: A magistrate or Judge of the Federal Court, the Federal Circuit Court or a State or Territory court may issue a warrant to authorise entry to premises or taking of possession of premises or a conveyance, if satisfied of certain matters. substitute: A magistrate or Judge of the Federal Court, the Federal Circuit and Family Court of Australia (Division 2) or a State or Territory court may issue a warrant to authorise entry to premises or taking of possession of premises or a conveyance, if satisfied of certain matters.  Further consequential amendments  Schedule 2  No. 13, 2021 Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021 Broadcasting Legislation Amendment (Broadcasting Reform) Act 2017"@en ;
    cml:integrityHash "0c1be38ae0737508c1849e1195e5e9f56b42a854f5d6a3c09020d7ff8b3526b2" ;
    cof:pageNumber "94"^^xsd:integer ;
    skos:note "Magistrates and judges cannot issue warrants for entry or possession without certain matters being satisfied." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2021a00013rec01.pdf> ;
    dc:source "c2021a00013rec01.pdf, p.94" ;
    cml:asserts concept:c2021a00013rec01-sch-2-sec-147-norm .
concept:c2021a00013rec01-sch-2-sec-147-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:c2021a00013rec01-sch-2-sec-147 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:c2021a00013rec01-sch-2-sec-147 cml:asserts concept:c2021a00013rec01-sch-2-sec-147-logic-deontic-1 .
concept:c2021a00013rec01-sch-2-sec-147-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "Prohibition of warrant issuance" ;
    cml:premiseText "Magistrates and judges may issue warrants." ;
    cml:conclusionText "They cannot issue warrants without certain matters being satisfied." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-2-sec-147 cml:asserts concept:c2021a00013rec01-sch-2-sec-147-logic-alleninterval-2 .
