    cml:modality cml:Dialectical ;
    cml:operator "NOT-A" ;
    cml:logicSummary "Chief Judge's dealing with complaint does not imply a duty to address all concerns about Judges." ;
    cml:premiseText "Chief Judge deals with complaint." ;
    cml:conclusionText "Chief Judge does not address all concerns about Judges." ;
    cml:executionSurface "modalities::dialectical" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2021a00013rec01-sch-5-sec-24 cml:asserts concept:c2021a00013rec01-sch-5-sec-24-logic-linearlogic-5 .
concept:c2021a00013rec01-sch-5-sec-24-logic-linearlogic-5 a cml:LogicApplication ;
    cml:modality cml:LinearLogic ;
    cml:operator "AND" ;
    cml:logicSummary "Chief Judge's dealing with complaint and addressing concerns about Judges are related duties." ;
    cml:premiseText "Chief Judge deals with complaint." ;
    cml:conclusionText "Chief Judge addresses concerns about Judges." ;
    cml:executionSurface "modalities::linear" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
doc:sch-5-sec-24 a cof:Section ;
    cof:title "24 Complaints" ;
    values:kind "section" ;
    values:originalText "If, in relation to a Judge of the Federal Circuit Court of Australia: (a) a complaint is made, on or after the commencement day, about the Judge; and (b) the circumstances that gave rise to the complaint occurred before the commencement day; then: (c) the Chief Judge may deal with the complaint under section 145 of the new law; and (d) for the purposes of dealing with the complaint, the reference to the Federal Circuit and Family Court of Australia (Division 2) in subparagraph (b)(ii) of the definition of relevant belief in subsection 145(4) of the new law is taken to include a reference to the Federal Circuit Court of Australia.  Schedule 5  Transitional provisions" ;
    cof:pageNumber "225"^^xsd:integer .

concept:c2021a00013rec01-sch-5-sec-25 a cml:Concept ;
    skos:prefLabel "25 Appeals to the High Court"@en ;
    cml:realizedBy doc:sch-5-sec-25 ;
    values:originalText "If: (a) on the day before the commencement day, an application for special leave to appeal could be made under section 95 of the Family Law Act 1975; and (b) despite the amendments to the Family Law Act 1975 made by this Act, on the commencement day the time for making the application has not ended; then, on or after the commencement day, the application may be made to the High Court." ;
    skos:definition "If: (a) on the day before the commencement day, an application for special leave to appeal could be made under section 95 of the Family Law Act 1975; and (b) despite the amendments to the Family Law Act 1975 made by this Act, on the commencement day the time for making the application has not ended; then, on or after the commencement day, the application may be made to the High Court."@en ;
    cml:integrityHash "ab7f1509137bdf53decf4efb62dc3541b2a1c4fd9b53a6c02528dd73c43af5f6" ;
