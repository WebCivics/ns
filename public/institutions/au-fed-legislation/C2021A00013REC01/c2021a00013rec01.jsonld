      },
      "dc:source": "c2021a00013rec01.pdf, p.74",
      "values:originalText": "The amendments made by this Part apply in relation to rules of court\nmade after this Part commences.",
      "skos:definition": "The amendments made by this Part apply in relation to rules of court\nmade after this Part commences.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-273-norm"
        }
      ],
      "cml:integrityHash": "fed0661741fdff5f97ad1ed1e687ed454c5c575bf3626886c152aaab782c5091",
      "skos:note": "Amendments apply in relation to rules of court made after commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-273",
      "@type": "cof:Section",
      "cof:title": "273 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "The amendments made by this Part apply in relation to rules of court\nmade after this Part commences."
    },
    {
