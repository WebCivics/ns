    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-55aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "55AA Actions by or against Marshal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-55aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.63",
      "values:originalText": "If the Marshal or a Deputy Marshal is a party to a proceeding in the\nCourt:\n(a) all writs, summonses, orders, warrants, precepts, process and\ncommands in the proceeding which should, in the ordinary\ncourse, be directed to the Marshal must be directed to such\ndisinterested person as the Court or a Judge appoints; and\n(b) the person so appointed may execute and return them.",
      "skos:definition": "If the Marshal or a Deputy Marshal is a party to a proceeding in the\nCourt:\n(a) all writs, summonses, orders, warrants, precepts, process and\ncommands in the proceeding which should, in the ordinary\ncourse, be directed to the Marshal must be directed to such\ndisinterested person as the Court or a Judge appoints; and\n(b) the person so appointed may execute and return them.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-55aa-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-55aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "edd8791789551c1fbaf8be3303255b4ac55eafde99c1c5832f5af1a33db2c258",
      "skos:note": "Marshal must direct writs and commands to a disinterested person appointed by the Court or Judge."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-55aa",
      "@type": "cof:Section",
      "cof:title": "55AA Actions by or against Marshal",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "If the Marshal or a Deputy Marshal is a party to a proceeding in the\nCourt:\n(a) all writs, summonses, orders, warrants, precepts, process and\ncommands in the proceeding which should, in the ordinary\ncourse, be directed to the Marshal must be directed to such\ndisinterested person as the Court or a Judge appoints; and\n(b) the person so appointed may execute and return them."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-55aa-norm",
