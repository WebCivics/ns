      "dc:source": "c2021a00013rec01.pdf, p.215",
      "values:originalText": "Chief Justice\n(1)\nThe person holding office as the Chief Justice of the Family Court of\nAustralia immediately before the commencement day continues to hold\n\nSchedule 5  Transitional provisions",
      "skos:definition": "Chief Justice\n(1)\nThe person holding office as the Chief Justice of the Family Court of\nAustralia immediately before the commencement day continues to hold\n\nSchedule 5  Transitional provisions",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-3-norm"
        }
      ],
      "cml:integrityHash": "99978287c888e5b4eafc0bf388254215dfda1f7aa4ac2deced524b408eb22640",
      "skos:note": "Continuation of Chief Justice office after commencement day"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-3",
