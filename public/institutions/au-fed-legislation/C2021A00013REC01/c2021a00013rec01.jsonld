    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-97",
      "@type": "cml:Concept",
      "skos:prefLabel": "97 Subsection 46PO(4) (note 2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-97"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.87",
      "values:originalText": "Repeal the note, substitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nNote 2:\nThe Federal Circuit and Family Court of Australia (Division 2), or a\nJudge of that Court, may award costs in proceedings under this\nsection—see section 214 of the Federal Circuit and Family Court of\nAustralia Act 2021.",
      "skos:definition": "Repeal the note, substitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nNote 2:\nThe Federal Circuit and Family Court of Australia (Division 2), or a\nJudge of that Court, may award costs in proceedings under this\nsection—see section 214 of the Federal Circuit and Family Court of\nAustralia Act 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-97-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-97-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6c768b98f1410b53481193fec2c41370ffdbbc4696ebc24b3e328e59d88aef12",
      "skos:note": "Award costs in proceedings under this section"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-97",
      "@type": "cof:Section",
      "cof:title": "97 Subsection 46PO(4) (note 2)",
      "values:kind": "section",
      "cof:pageNumber": 87,
      "values:originalText": "Repeal the note, substitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nNote 2:\nThe Federal Circuit and Family Court of Australia (Division 2), or a\nJudge of that Court, may award costs in proceedings under this\nsection—see section 214 of the Federal Circuit and Family Court of\nAustralia Act 2021."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-97-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-2-sec-97"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
