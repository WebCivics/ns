        }
      ],
      "cml:integrityHash": "82fe4766936845ec14f308052f506c7b9f535f425f017ac3fd443c695aefa728",
      "skos:note": "Omit specific phrases from court rules"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Subsections 4(2) and (2A)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Omit “, the standard Rules of Court or the related Federal Circuit Court\nRules”, substitute “or the applicable Rules of Court”."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-16-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
