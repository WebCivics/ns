      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-19-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits the omission of words after 'before the Federal Court'",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Omit all words after 'before the Federal Court'",
      "cml:conclusionText": "Substitute with a transfer from the Federal Circuit and Family Court of Australia."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-19-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Defines a temporal interval for the transfer",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Transfer by the Federal Circuit and Family Court of Australia (Division 2) to the Federal Court under section 153 of the Federal Circuit and Family Court of Australia Act 2021 that has been confirmed...",
      "cml:conclusionText": "under section 32AD of the Federal Court of Australia Act 1976"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-19-logic-ltl-3",
