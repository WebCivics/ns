      },
      "dc:source": "c2021a00013rec01.pdf, p.153",
      "values:originalText": "Omit “Family Court of Australia or of the Family Court of a State or a\nJudge of the Federal Circuit Court of Australia”, substitute “Federal\nCircuit and Family Court of Australia (Division 1), the Federal Circuit\nand Family Court of Australia (Division 2) or the Family Court of a\nState”.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021",
      "skos:definition": "Omit “Family Court of Australia or of the Family Court of a State or a\nJudge of the Federal Circuit Court of Australia”, substitute “Federal\nCircuit and Family Court of Australia (Division 1), the Federal Circuit\nand Family Court of Australia (Division 2) or the Family Court of a\nState”.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-538-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-538-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2d4f385ee5616795a76ccbc0a7dc6a90ea3c2e513c04327304cd0ce9d496428b",
      "skos:note": "Omit specified court names and substitute with new names."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-538",
      "@type": "cof:Section",
      "cof:title": "538 Subsection 9A(1)",
      "values:kind": "section",
      "cof:pageNumber": 153,
      "values:originalText": "Omit “Family Court of Australia or of the Family Court of a State or a\nJudge of the Federal Circuit Court of Australia”, substitute “Federal\nCircuit and Family Court of Australia (Division 1), the Federal Circuit\nand Family Court of Australia (Division 2) or the Family Court of a\nState”.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021"
    },
