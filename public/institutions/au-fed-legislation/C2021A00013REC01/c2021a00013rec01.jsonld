      },
      "cml:premiseText": "(5) The Governor-General may, by Proclamation...",
      "cml:conclusionText": "...fix a date as the date on or after which appeals to the Supreme Court of a specified State or Territory under this section may not be instituted..."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-47a-ss-5-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
