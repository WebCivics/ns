    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-270",
      "@type": "cml:Concept",
      "skos:prefLabel": "270 Subsection 249(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-270"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.73",
      "values:originalText": "Repeal the subsection, substitute:\n(2) The Chief Judge may appoint committees consisting of Judges, or\nof Judges and other persons, for the purpose of:\n(a) advising the Judges of the Federal Circuit and Family Court\nof Australia (Division 2) in relation to the making of Rules of\nCourt; or\n(b) advising the Chief Judge in relation to the management of the\nadministrative affairs of the Federal Circuit and Family Court\nof Australia (Division 2).",
      "skos:definition": "Repeal the subsection, substitute:\n(2) The Chief Judge may appoint committees consisting of Judges, or\nof Judges and other persons, for the purpose of:\n(a) advising the Judges of the Federal Circuit and Family Court\nof Australia (Division 2) in relation to the making of Rules of\nCourt; or\n(b) advising the Chief Judge in relation to the management of the\nadministrative affairs of the Federal Circuit and Family Court\nof Australia (Division 2).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-270-norm"
        }
      ],
      "cml:integrityHash": "757e63b0a3befd48e8a35b7d45080cf5d88ca25a1ad7bcffc73fa282c6eac61c",
      "skos:note": "Repeal subsection, substitute with new appointment rules for the Chief Judge."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-270",
      "@type": "cof:Section",
      "cof:title": "270 Subsection 249(2)",
      "values:kind": "section",
      "cof:pageNumber": 73,
      "values:originalText": "Repeal the subsection, substitute:\n(2) The Chief Judge may appoint committees consisting of Judges, or\nof Judges and other persons, for the purpose of:\n(a) advising the Judges of the Federal Circuit and Family Court\nof Australia (Division 2) in relation to the making of Rules of\nCourt; or\n(b) advising the Chief Judge in relation to the management of the\nadministrative affairs of the Federal Circuit and Family Court\nof Australia (Division 2)."
    },
