    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-433",
      "@type": "cml:Concept",
      "skos:prefLabel": "433 Subsection 9A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-433"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
