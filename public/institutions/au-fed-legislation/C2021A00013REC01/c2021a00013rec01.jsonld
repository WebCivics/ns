    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-106-2-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "106(2) Appeals from courts of summary jurisdiction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-106-2-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
