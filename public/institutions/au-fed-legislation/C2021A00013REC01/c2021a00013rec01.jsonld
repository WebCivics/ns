    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 Subsection 4(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-17"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.20",
      "values:originalText": "Repeal the subsection, substitute:\n(3) To avoid doubt, for all purposes:\n(a) jurisdiction under a provision of the Federal Circuit and\nFamily Court of Australia Act 2021 referring to this Act is\ntaken to be jurisdiction under this Act; and\n(b) jurisdiction under paragraphs 25(1)(a) and (b) of the Federal\nCircuit and Family Court of Australia Act 2021 is taken to be\njurisdiction under this Act; and\n(c) jurisdiction under section 101 of the Child Support\n(Assessment) Act 1989 and under section 106 of the Child\nSupport (Registration and Collection) Act 1988 is taken to be\njurisdiction under this Act; and\n(d) jurisdiction under the applicable Rules of Court is taken to be\njurisdiction under this Act; and\n(e) proceedings transferred under section 51 or 149 of the\nFederal Circuit and Family Court of Australia Act 2021\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nreferring to this Act are taken to be proceedings under this\nAct; and\n(f) proceedings under the applicable Rules of Court are taken to\nbe proceedings under this Act; and\n(g) an order (however described) made by a court under the\napplicable Rules of Court is taken to be an order made by the\ncourt under this Act.",
      "skos:definition": "Repeal the subsection, substitute:\n(3) To avoid doubt, for all purposes:\n(a) jurisdiction under a provision of the Federal Circuit and\nFamily Court of Australia Act 2021 referring to this Act is\ntaken to be jurisdiction under this Act; and\n(b) jurisdiction under paragraphs 25(1)(a) and (b) of the Federal\nCircuit and Family Court of Australia Act 2021 is taken to be\njurisdiction under this Act; and\n(c) jurisdiction under section 101 of the Child Support\n(Assessment) Act 1989 and under section 106 of the Child\nSupport (Registration and Collection) Act 1988 is taken to be\njurisdiction under this Act; and\n(d) jurisdiction under the applicable Rules of Court is taken to be\njurisdiction under this Act; and\n(e) proceedings transferred under section 51 or 149 of the\nFederal Circuit and Family Court of Australia Act 2021\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nreferring to this Act are taken to be proceedings under this\nAct; and\n(f) proceedings under the applicable Rules of Court are taken to\nbe proceedings under this Act; and\n(g) an order (however described) made by a court under the\napplicable Rules of Court is taken to be an order made by the\ncourt under this Act.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-17-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-17-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6b262e086d83998b473c19628c1595441e6a274326a0e56aae287136ba65ce7d",
      "skos:note": "Jurisdiction under certain acts and rules is taken to be jurisdiction under this Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-17",
      "@type": "cof:Section",
      "cof:title": "17 Subsection 4(3)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Repeal the subsection, substitute:\n(3) To avoid doubt, for all purposes:\n(a) jurisdiction under a provision of the Federal Circuit and\nFamily Court of Australia Act 2021 referring to this Act is\ntaken to be jurisdiction under this Act; and\n(b) jurisdiction under paragraphs 25(1)(a) and (b) of the Federal\nCircuit and Family Court of Australia Act 2021 is taken to be\njurisdiction under this Act; and\n(c) jurisdiction under section 101 of the Child Support\n(Assessment) Act 1989 and under section 106 of the Child\nSupport (Registration and Collection) Act 1988 is taken to be\njurisdiction under this Act; and\n(d) jurisdiction under the applicable Rules of Court is taken to be\njurisdiction under this Act; and\n(e) proceedings transferred under section 51 or 149 of the\nFederal Circuit and Family Court of Australia Act 2021\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nreferring to this Act are taken to be proceedings under this\nAct; and\n(f) proceedings under the applicable Rules of Court are taken to\nbe proceedings under this Act; and\n(g) an order (however described) made by a court under the\napplicable Rules of Court is taken to be an order made by the\ncourt under this Act."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-17-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-17"
