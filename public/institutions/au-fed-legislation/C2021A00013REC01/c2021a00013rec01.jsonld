    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-140-ss-7c",
      "@type": "cml:Concept",
      "skos:prefLabel": "140(7C) After subsection 111C(7A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-140-ss-7c"
      },
      "cml:curationStatus": {
