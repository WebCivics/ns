    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.199",
      "values:originalText": "In this Part:\ncommencement day means the day this Schedule commences.",
      "skos:definition": "In this Part:\ncommencement day means the day this Schedule commences.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-2-norm"
        }
      ],
      "cml:integrityHash": "ebe03e2890bd689d21beda7d85e4a8fb4584e09bda19a05f151ed598fd4c5cec",
      "skos:note": "Defines commencement day as the day the Schedule commences."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 199,
      "values:originalText": "In this Part:\ncommencement day means the day this Schedule commences."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-2-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-3-sec-2"
      },
      "values:deonticStatus": {
