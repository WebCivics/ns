      },
      "dc:source": "c2021a00013rec01.pdf, p.20",
      "values:originalText": "Omit “, the standard Rules of Court or the related Federal Circuit Court\nRules”, substitute “or the applicable Rules of Court”.",
      "skos:definition": "Omit “, the standard Rules of Court or the related Federal Circuit Court\nRules”, substitute “or the applicable Rules of Court”.",
      "cml:asserts": [
