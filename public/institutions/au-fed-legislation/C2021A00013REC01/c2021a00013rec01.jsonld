      "cml:logicSummary": "Jurisdiction is taken from other acts and rules.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Subsection 8(1)",
      "cml:realizedBy": {
