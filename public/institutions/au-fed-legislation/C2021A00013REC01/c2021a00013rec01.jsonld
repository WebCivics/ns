        }
      ],
      "cml:integrityHash": "f61442258c998ab436f26d0a9c333386f7b39d3416a7799a6a7d8cd830bc8c86",
      "skos:note": "Omit all words after 'have been instituted in' and substitute with the Federal Circuit and Family Court of Australia (Division 2)"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-51",
