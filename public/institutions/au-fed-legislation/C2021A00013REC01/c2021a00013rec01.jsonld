        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-230-logic-diffusion-4"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-230-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "012c8d3b25c51eb192c30886675be9a306466a85ea5a8e2036af6d599dcde41d",
      "skos:note": "Continuation of written authorisation under Family Law Act 1975"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-230",
      "@type": "cof:Section",
      "cof:title": "230 Authorisation about handling complaints",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "A written authorisation made under subsection 21B(3A) of the Family\nLaw Act 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 48(2) of the Federal Circuit and Family Court of Australia\nAct 2021."
    },
