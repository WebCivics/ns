      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.42",
      "values:originalText": "(7B) The power of the Chief Justice of the Federal Circuit and Family\nCourt of Australia (Division 1) under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders.",
      "skos:definition": "(7B) The power of the Chief Justice of the Federal Circuit and Family\nCourt of Australia (Division 1) under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders.",
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-140"
      },
