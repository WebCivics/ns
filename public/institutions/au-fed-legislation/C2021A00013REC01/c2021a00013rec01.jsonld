      "dc:source": "c2021a00013rec01.pdf, p.12",
      "values:originalText": "Parts 1 and 2\nAt the same time as the Federal Circuit and\nFamily Court of Australia Act 2021\ncommences.\nHowever, the provisions do not commence\nat all if that Act does not commence.",
      "skos:definition": "Parts 1 and 2\nAt the same time as the Federal Circuit and\nFamily Court of Australia Act 2021\ncommences.\nHowever, the provisions do not commence\nat all if that Act does not commence.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sec-2-2-norm"
        }
      ],
      "cml:integrityHash": "500061a8b204b6fd8b10cf0cf947a6a59118df1859094a0354fc29e940277799",
      "skos:note": "Conditional commencement of Schedule 1."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sec-2-2",
      "@type": "cof:Section",
      "cof:title": "2 Schedule 1,",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Parts 1 and 2\nAt the same time as the Federal Circuit and\nFamily Court of Australia Act 2021\ncommences.\nHowever, the provisions do not commence\nat all if that Act does not commence."
    },
