    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Things done by, or in relation to, the Marshal or a Deputy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-22"
      },
      "cml:curationStatus": {
