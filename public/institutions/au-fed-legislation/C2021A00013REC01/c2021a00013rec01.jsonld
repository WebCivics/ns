    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Arrangements with other courts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
