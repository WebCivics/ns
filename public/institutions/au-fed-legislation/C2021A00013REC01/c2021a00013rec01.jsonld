    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-140",
      "@type": "cml:Concept",
      "skos:prefLabel": "140 After subsection 111C(7A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-140"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
