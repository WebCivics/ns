      "dc:source": "c2021a00013rec01.pdf, p.119",
      "values:originalText": "Omit “Federal Circuit Court”, substitute “Federal Circuit and Family\nCourt of Australia (Division 2)”.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021",
      "skos:definition": "Omit “Federal Circuit Court”, substitute “Federal Circuit and Family\nCourt of Australia (Division 2)”.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-309-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-309-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "edae6be8c1966968cbb9bad477d6c9e132985890db4da072919aa09b387109d3",
      "skos:note": "Omit 'Federal Circuit Court', substitute 'Federal Circuit and Family\nCourt of Australia (Division 2)'"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-309",
      "@type": "cof:Section",
      "cof:title": "309 Subsection 86(3)",
      "values:kind": "section",
      "cof:pageNumber": 119,
      "values:originalText": "Omit “Federal Circuit Court”, substitute “Federal Circuit and Family\nCourt of Australia (Division 2)”.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021"
    },
