    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-101-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "101 Appeals from courts of summary jurisdiction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-101-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.98",
      "values:originalText": "(1) A Family Court of a State has jurisdiction to hear and determine\nappeals from a decree of a court of summary jurisdiction of the\nState.\nNote:\nSee sections 47A and 47B of the Family Law Act 1975.\n(2) The Supreme Court of the Northern Territory has jurisdiction to\nhear and determine appeals from a decree of a court of summary\njurisdiction of the Northern Territory.\nNote:\nSee sections 47A and 47B of the Family Law Act 1975.",
      "skos:definition": "(1) A Family Court of a State has jurisdiction to hear and determine\nappeals from a decree of a court of summary jurisdiction of the\nState.\nNote:\nSee sections 47A and 47B of the Family Law Act 1975.\n(2) The Supreme Court of the Northern Territory has jurisdiction to\nhear and determine appeals from a decree of a court of summary\njurisdiction of the Northern Territory.\nNote:\nSee sections 47A and 47B of the Family Law Act 1975.",
      "cml:hasPart": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-101-2-ss-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-101-2-ss-2"
        }
      ],
      "cml:integrityHash": "468d65aca88df61533ce4f929f3ed1e07f5486c7f4164d761e87d5bf5261f4c2"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-101-2",
      "@type": "cof:Section",
      "cof:title": "101 Appeals from courts of summary jurisdiction",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "(1) A Family Court of a State has jurisdiction to hear and determine\nappeals from a decree of a court of summary jurisdiction of the\nState.\nNote:\nSee sections 47A and 47B of the Family Law Act 1975.\n(2) The Supreme Court of the Northern Territory has jurisdiction to\nhear and determine appeals from a decree of a court of summary\njurisdiction of the Northern Territory.\nNote:\nSee sections 47A and 47B of the Family Law Act 1975."
    },
