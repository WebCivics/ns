    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Subsection 11(8A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
