    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-559",
      "@type": "cml:Concept",
      "skos:prefLabel": "559 Subsection 486C(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-559"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.156",
      "values:originalText": "Omit “Federal Circuit Court’s jurisdiction”, substitute “jurisdiction of\nthe Federal Circuit and Family Court of Australia (Division 2)”.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "Omit “Federal Circuit Court’s jurisdiction”, substitute “jurisdiction of\nthe Federal Circuit and Family Court of Australia (Division 2)”.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-559-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-559-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6e191a896c16f95b45a062e65a32c37e41074ad043eecb0a20424ac48799c776",
      "skos:note": "Omit 'Federal Circuit Court's jurisdiction' and substitute with 'jurisdiction of the Federal Circuit and Family Court of Australia (Division 2)'"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-559",
      "@type": "cof:Section",
      "cof:title": "559 Subsection 486C(3)",
      "values:kind": "section",
      "cof:pageNumber": 156,
      "values:originalText": "Omit “Federal Circuit Court’s jurisdiction”, substitute “jurisdiction of\nthe Federal Circuit and Family Court of Australia (Division 2)”.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-559-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-2-sec-559"
      },
      "values:deonticStatus": {
