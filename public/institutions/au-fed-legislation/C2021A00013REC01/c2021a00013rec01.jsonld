    },
    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Determination of other terms and conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.201",
      "values:originalText": "A determination by the Governor-General under clause 8 of Schedule 1\nto the Federal Circuit Court of Australia Act 1999 and in force\nimmediately before the commencement day continues in force (and may\nbe dealt with) as if it had been made under subsection 119(1) of the\nFederal Circuit and Family Court of Australia Act 2021.",
      "skos:definition": "A determination by the Governor-General under clause 8 of Schedule 1\nto the Federal Circuit Court of Australia Act 1999 and in force\nimmediately before the commencement day continues in force (and may\nbe dealt with) as if it had been made under subsection 119(1) of the\nFederal Circuit and Family Court of Australia Act 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-10-norm"
        }
      ],
      "cml:integrityHash": "0b9ad8ee8ecbb47a7bcf6f7576796b853fc510b54265681143f8e90ae0c92618",
      "skos:note": "Continuation of determination under clause 8 of Schedule 1"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Determination of other terms and conditions",
      "values:kind": "section",
      "cof:pageNumber": 201,
      "values:originalText": "A determination by the Governor-General under clause 8 of Schedule 1\nto the Federal Circuit Court of Australia Act 1999 and in force\nimmediately before the commencement day continues in force (and may\nbe dealt with) as if it had been made under subsection 119(1) of the\nFederal Circuit and Family Court of Australia Act 2021."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-10-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
