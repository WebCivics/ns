    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-39g",
      "@type": "cml:Concept",
      "skos:prefLabel": "39G Jurisdiction in relation to transferred matters under other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-39g"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.25",
      "values:originalText": "Commonwealth laws\nIf proceedings in relation to a matter arising under a law of the\nCommonwealth are transferred under this Act or the Federal\nCircuit and Family Court of Australia Act 2021 to a court that has\njurisdiction conferred on or invested in it by this Division, the\njurisdiction so conferred on or invested in the court includes\njurisdiction in relation to that matter.",
      "skos:definition": "Commonwealth laws\nIf proceedings in relation to a matter arising under a law of the\nCommonwealth are transferred under this Act or the Federal\nCircuit and Family Court of Australia Act 2021 to a court that has\njurisdiction conferred on or invested in it by this Division, the\njurisdiction so conferred on or invested in the court includes\njurisdiction in relation to that matter.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-39g-norm"
        }
      ],
      "cml:integrityHash": "f885f4f7d1359ceb0ccba81d32a4e95507fe803d8c701b0dede02a3f63daa60a",
      "skos:note": "Jurisdiction in relation to transferred matters under other laws"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-39g",
      "@type": "cof:Section",
      "cof:title": "39G Jurisdiction in relation to transferred matters under other",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Commonwealth laws\nIf proceedings in relation to a matter arising under a law of the\nCommonwealth are transferred under this Act or the Federal\nCircuit and Family Court of Australia Act 2021 to a court that has\njurisdiction conferred on or invested in it by this Division, the\njurisdiction so conferred on or invested in the court includes\njurisdiction in relation to that matter."
    },
