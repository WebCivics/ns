    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-107-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "107 Appeals to High Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-107-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.101",
      "values:originalText": "(1) An appeal must not be brought directly to the High Court from a\ndecree of a court exercising original jurisdiction under this Act\n(other than the Federal Circuit and Family Court of Australia).\nNote:\nIn relation to the Federal Circuit and Family Court of Australia, see\nsections 55 and 155 of the Federal Circuit and Family Court of\nAustralia Act 2021.\n(2) If, apart from this subsection, subsection (1) is to any extent\ninconsistent with section 73 of the Constitution, this Act has effect\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nas if the words “, except by special leave of the High Court” were\nadded at the end of subsection (1).",
      "skos:definition": "(1) An appeal must not be brought directly to the High Court from a\ndecree of a court exercising original jurisdiction under this Act\n(other than the Federal Circuit and Family Court of Australia).\nNote:\nIn relation to the Federal Circuit and Family Court of Australia, see\nsections 55 and 155 of the Federal Circuit and Family Court of\nAustralia Act 2021.\n(2) If, apart from this subsection, subsection (1) is to any extent\ninconsistent with section 73 of the Constitution, this Act has effect\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nas if the words “, except by special leave of the High Court” were\nadded at the end of subsection (1).",
      "cml:hasPart": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-107-2-ss-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-107-2-ss-2"
        }
      ],
      "cml:integrityHash": "9124e79c9bca29d5c84876760cc1a635be8e336ec115bd2499f61c324c4a7850"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-107-2",
