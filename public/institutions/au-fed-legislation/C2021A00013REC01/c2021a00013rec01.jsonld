      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-226",
      "@type": "cml:Concept",
      "skos:prefLabel": "226 After subsection 59(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-226"
      },
      "cml:curationStatus": {
