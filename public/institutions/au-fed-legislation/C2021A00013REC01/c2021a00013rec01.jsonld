    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-210",
      "@type": "cml:Concept",
      "skos:prefLabel": "210 Section 86AA (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-210"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.106",
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153 of\nthe Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976.",
      "skos:definition": "Repeal the note, substitute:\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153 of\nthe Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-210-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-210-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "801e0f6274113513c4ffc6c8706d323bc5a3834f9312b87e90b37349ea085a00",
      "skos:note": "Repeal note and substitute with new notes."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-210",
      "@type": "cof:Section",
      "cof:title": "210 Section 86AA (note)",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153 of\nthe Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976."
    },
