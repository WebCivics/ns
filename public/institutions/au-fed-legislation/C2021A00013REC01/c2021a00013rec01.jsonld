      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.200",
      "values:originalText": "An arrangement made under subsection 91(1) of the Federal Circuit\nCourt of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 247(1) of the Federal Circuit and\nFamily Court of Australia Act 2021.\n\nRepeal of the Federal Circuit Court of Australia Act 1999  Schedule 3\nSaving and transitional provisions  Part 2\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "An arrangement made under subsection 91(1) of the Federal Circuit\nCourt of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 247(1) of the Federal Circuit and\nFamily Court of Australia Act 2021.\n\nRepeal of the Federal Circuit Court of Australia Act 1999  Schedule 3\nSaving and transitional provisions  Part 2\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-8-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-8-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "e522d27571da82cc7fb309f7b4d1c95ffe8139d068ea0193e964a11b17f55a7d",
      "skos:note": "Continuation of arrangements under Federal Circuit Court of Australia Act 1999"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Arrangements with agencies or organisations",
      "values:kind": "section",
      "cof:pageNumber": 200,
      "values:originalText": "An arrangement made under subsection 91(1) of the Federal Circuit\nCourt of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 247(1) of the Federal Circuit and\nFamily Court of Australia Act 2021.\n\nRepeal of the Federal Circuit Court of Australia Act 1999  Schedule 3\nSaving and transitional provisions  Part 2\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
