    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-774",
      "@type": "cml:Concept",
      "skos:prefLabel": "774 Section 42YM",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-774"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.191",
      "values:originalText": "Omit:\nThe Secretary can seek injunctions from the Federal Court or\nFederal Circuit Court to restrain a person from contravening this\nAct or the regulations, or to compel compliance with this Act or\nthe regulations.\nsubstitute:\nThe Secretary can seek injunctions from the Federal Court or\nFederal Circuit and Family Court of Australia (Division 2) to\nrestrain a person from contravening this Act or the regulations, or\nto compel compliance with this Act or the regulations.",
      "skos:definition": "Omit:\nThe Secretary can seek injunctions from the Federal Court or\nFederal Circuit Court to restrain a person from contravening this\nAct or the regulations, or to compel compliance with this Act or\nthe regulations.\nsubstitute:\nThe Secretary can seek injunctions from the Federal Court or\nFederal Circuit and Family Court of Australia (Division 2) to\nrestrain a person from contravening this Act or the regulations, or\nto compel compliance with this Act or the regulations.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-774-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-774-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a3d9163c4b6f2e39c4ad3412839ea7bda86c07b45337b44b4866b9c2b531feb9",
      "skos:note": "Restraining a person from contravening the Act or regulations."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-774",
      "@type": "cof:Section",
      "cof:title": "774 Section 42YM",
      "values:kind": "section",
      "cof:pageNumber": 191,
      "values:originalText": "Omit:\nThe Secretary can seek injunctions from the Federal Court or\nFederal Circuit Court to restrain a person from contravening this\nAct or the regulations, or to compel compliance with this Act or\nthe regulations.\nsubstitute:\nThe Secretary can seek injunctions from the Federal Court or\nFederal Circuit and Family Court of Australia (Division 2) to\nrestrain a person from contravening this Act or the regulations, or\nto compel compliance with this Act or the regulations."
    },
