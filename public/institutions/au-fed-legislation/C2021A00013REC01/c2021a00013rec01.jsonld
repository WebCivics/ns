    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Subsections 4(2) and (2A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
