      },
      "dc:source": "c2021a00013rec01.pdf, p.37",
      "values:originalText": "Omit “a judge, Judicial Registrar, Registrar or magistrate”, substitute “a\nperson”.",
      "skos:definition": "Omit “a judge, Judicial Registrar, Registrar or magistrate”, substitute “a\nperson”.",
      "cml:asserts": [
