    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-274",
      "@type": "cml:Concept",
      "skos:prefLabel": "274 Continuity of rules of court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-274"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.74",
      "values:originalText": "The amendments made by this Part:\n(a) do not affect the continuity of any rules of court that are in\nforce immediately before this Part commences; and\n(b) to avoid doubt, do not prevent the amendment or repeal of\nthose rules of court.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "The amendments made by this Part:\n(a) do not affect the continuity of any rules of court that are in\nforce immediately before this Part commences; and\n(b) to avoid doubt, do not prevent the amendment or repeal of\nthose rules of court.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-274-norm"
        }
      ],
      "cml:integrityHash": "fe9584c74ceff81ead8b2c844c1c18418a7e94caaba6fccc048c4acc7d874e5a",
      "skos:note": "Continuity of rules of court"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-274",
      "@type": "cof:Section",
      "cof:title": "274 Continuity of rules of court",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "The amendments made by this Part:\n(a) do not affect the continuity of any rules of court that are in\nforce immediately before this Part commences; and\n(b) to avoid doubt, do not prevent the amendment or repeal of\nthose rules of court.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
