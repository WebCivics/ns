    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-540",
      "@type": "cml:Concept",
      "skos:prefLabel": "540 After subitem 6(6) of Schedule 4",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-540"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.154",
      "values:originalText": "Insert:\n(6A)\nTo avoid doubt, on and after the day Schedule 1 to the Federal Circuit\nand Family Court of Australia (Consequential Amendments and\nTransitional Provisions) Act 2021 commences, an appeal mentioned in\nsubitem (6) may not be referred to the Full Court of the Federal Circuit\nand Family Court of Australia (Division 1).\nMaternity Leave (Commonwealth Employees) Act 1973",
      "skos:definition": "Insert:\n(6A)\nTo avoid doubt, on and after the day Schedule 1 to the Federal Circuit\nand Family Court of Australia (Consequential Amendments and\nTransitional Provisions) Act 2021 commences, an appeal mentioned in\nsubitem (6) may not be referred to the Full Court of the Federal Circuit\nand Family Court of Australia (Division 1).\nMaternity Leave (Commonwealth Employees) Act 1973",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-540-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-540-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5b858408b1b30e22036bbf1d7f1c27cbbb053d3a6ae279ec50d7d3f3d7e7435b",
      "skos:note": "Appeals may not be referred to the Full Court after a certain date."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-540",
      "@type": "cof:Section",
      "cof:title": "540 After subitem 6(6) of Schedule 4",
      "values:kind": "section",
      "cof:pageNumber": 154,
      "values:originalText": "Insert:\n(6A)\nTo avoid doubt, on and after the day Schedule 1 to the Federal Circuit\nand Family Court of Australia (Consequential Amendments and\nTransitional Provisions) Act 2021 commences, an appeal mentioned in\nsubitem (6) may not be referred to the Full Court of the Federal Circuit\nand Family Court of Australia (Division 1).\nMaternity Leave (Commonwealth Employees) Act 1973"
    },
