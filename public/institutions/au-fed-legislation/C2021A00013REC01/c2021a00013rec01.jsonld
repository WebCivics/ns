    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-167",
      "@type": "cml:Concept",
      "skos:prefLabel": "167 Paragraphs 144(a) and (b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-167"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.99",
      "values:originalText": "Repeal the paragraphs, substitute:\n(a) if the decision is not a decision of a Full Court of the Federal\nCircuit and Family Court of Australia (Division 1) and an\napplication is not made for leave to appeal against the\ndecision within the period for making such an application—\nthe decision becomes final at the end of that period; or\n(b) if the decision is a decision of a Full Court of the Federal\nCircuit and Family Court of Australia (Division 1) and an\napplication is not made for special leave to appeal to the High\nCourt within the period of 30 days after the making of the\ndecision—the decision becomes final at the end of that\nperiod.\nChild Support (Registration and Collection) Act 1988",
      "skos:definition": "Repeal the paragraphs, substitute:\n(a) if the decision is not a decision of a Full Court of the Federal\nCircuit and Family Court of Australia (Division 1) and an\napplication is not made for leave to appeal against the\ndecision within the period for making such an application—\nthe decision becomes final at the end of that period; or\n(b) if the decision is a decision of a Full Court of the Federal\nCircuit and Family Court of Australia (Division 1) and an\napplication is not made for special leave to appeal to the High\nCourt within the period of 30 days after the making of the\ndecision—the decision becomes final at the end of that\nperiod.\nChild Support (Registration and Collection) Act 1988",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-167-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-167-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ab37cb99b3de7bd053b91dcf6c1c911beb23cbac1185c9de9c0d7de664160490",
      "skos:note": "Decision becomes final after specified period without appeal."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-167",
      "@type": "cof:Section",
      "cof:title": "167 Paragraphs 144(a) and (b)",
      "values:kind": "section",
      "cof:pageNumber": 99,
      "values:originalText": "Repeal the paragraphs, substitute:\n(a) if the decision is not a decision of a Full Court of the Federal\nCircuit and Family Court of Australia (Division 1) and an\napplication is not made for leave to appeal against the\ndecision within the period for making such an application—\nthe decision becomes final at the end of that period; or\n(b) if the decision is a decision of a Full Court of the Federal\nCircuit and Family Court of Australia (Division 1) and an\napplication is not made for special leave to appeal to the High\nCourt within the period of 30 days after the making of the\ndecision—the decision becomes final at the end of that\nperiod.\nChild Support (Registration and Collection) Act 1988"
    },
