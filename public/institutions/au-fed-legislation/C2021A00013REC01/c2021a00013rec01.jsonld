    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-232",
      "@type": "cml:Concept",
      "skos:prefLabel": "232 Arrangements with agencies or organisations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-232"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.66",
      "values:originalText": "An arrangement made under subsection 38BAB(1) of the Family Law\nAct 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 80(1) of the Federal Circuit and Family Court of Australia\nAct 2021.",
      "skos:definition": "An arrangement made under subsection 38BAB(1) of the Family Law\nAct 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 80(1) of the Federal Circuit and Family Court of Australia\nAct 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-232-norm"
        }
      ],
      "cml:integrityHash": "4f35380d7f6727b3e41d5e412d56cc3287c4c6bd132bb8543a700f5baabae322",
      "skos:note": "Continuation of arrangements under Family Law Act 1975"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-232",
      "@type": "cof:Section",
      "cof:title": "232 Arrangements with agencies or organisations",
      "values:kind": "section",
      "cof:pageNumber": 66,
      "values:originalText": "An arrangement made under subsection 38BAB(1) of the Family Law\nAct 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 80(1) of the Federal Circuit and Family Court of Australia\nAct 2021."
    },
