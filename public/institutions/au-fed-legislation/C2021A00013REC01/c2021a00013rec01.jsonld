    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-102-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "102 Appeals to High Court",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-102-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.98",
      "values:originalText": "(1) An appeal must not be brought directly to the High Court from a\ndecree of a court exercising original jurisdiction under this Act\n(other than the Federal Circuit and Family Court of Australia).\nNote:\nIn relation to the Federal Circuit and Family Court of Australia, see\nsections 55 and 155 of the Federal Circuit and Family Court of\nAustralia Act 2021.\n(2) If, apart from this subsection, subsection (1) is to any extent\ninconsistent with section 73 of the Constitution, this Act has effect\nas if the words “, except by special leave of the High Court” were\nadded at the end of subsection (1).\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "(1) An appeal must not be brought directly to the High Court from a\ndecree of a court exercising original jurisdiction under this Act\n(other than the Federal Circuit and Family Court of Australia).\nNote:\nIn relation to the Federal Circuit and Family Court of Australia, see\nsections 55 and 155 of the Federal Circuit and Family Court of\nAustralia Act 2021.\n(2) If, apart from this subsection, subsection (1) is to any extent\ninconsistent with section 73 of the Constitution, this Act has effect\nas if the words “, except by special leave of the High Court” were\nadded at the end of subsection (1).\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:hasPart": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-102-2-ss-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-102-2-ss-2"
        }
      ],
      "cml:integrityHash": "917beae58212c501b32042fe63c167dfad7e02bf17429dfaeb4c1d4b030ccfd5"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-102-2",
