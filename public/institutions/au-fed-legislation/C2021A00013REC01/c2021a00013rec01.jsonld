    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Appointments to judicial offices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
