    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-310",
      "@type": "cml:Concept",
      "skos:prefLabel": "310 Subsection 86(3) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-310"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.120",
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court: see section 153\nof the Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2): see section 32AB\nof the Federal Court of Australia Act 1976.",
      "skos:definition": "Repeal the note, substitute:\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court: see section 153\nof the Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2): see section 32AB\nof the Federal Court of Australia Act 1976.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-310-norm"
        }
      ],
      "cml:integrityHash": "ecd89d8ba36abb5682277403c9a8c212ce8036c209de4cd8fd731ef42c965fdb",
      "skos:note": "Repeal note and substitute with new notes for transfers of proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-310",
      "@type": "cof:Section",
      "cof:title": "310 Subsection 86(3) (note)",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court: see section 153\nof the Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2): see section 32AB\nof the Federal Court of Australia Act 1976."
    },
