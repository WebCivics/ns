      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.92",
      "values:originalText": "Repeal the subsection, substitute:\n(1) If a proceeding is pending in the Federal Court, the Federal Court\nmay, on the application of a party to the proceeding or of its own\nmotion, transfer the proceeding to the Federal Circuit and Family\nCourt of Australia (Division 1).",
      "skos:definition": "Repeal the subsection, substitute:\n(1) If a proceeding is pending in the Federal Court, the Federal Court\nmay, on the application of a party to the proceeding or of its own\nmotion, transfer the proceeding to the Federal Circuit and Family\nCourt of Australia (Division 1).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-130-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-130-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b5ad9e525a4a98d744ef2802fe93657ff85d2c7015f29895e1e6ad1a6ea1fdd3",
      "skos:note": "Transfer proceeding to Federal Circuit and Family Court of Australia (Division 1) on application or motion."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-130",
      "@type": "cof:Section",
      "cof:title": "130 Subsection 35A(1)",
      "values:kind": "section",
      "cof:pageNumber": 92,
      "values:originalText": "Repeal the subsection, substitute:\n(1) If a proceeding is pending in the Federal Court, the Federal Court\nmay, on the application of a party to the proceeding or of its own\nmotion, transfer the proceeding to the Federal Circuit and Family\nCourt of Australia (Division 1)."
    },
