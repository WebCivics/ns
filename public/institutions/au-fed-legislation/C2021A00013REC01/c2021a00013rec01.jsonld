        }
      ],
      "cml:integrityHash": "ac998f8a6f55fdc64f9505383148dd2294e280cddf31ba4811ff25de0852ce05",
      "skos:note": "Consultation requirement before making Rules of Court"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-32ac-ss-5",
      "@type": "cof:Section",
      "cof:title": "32AC(5) Discretionary transfer of civil proceedings from the Federal",
      "values:kind": "subsection",
      "cof:pageNumber": 60,
      "values:originalText": "(5) Before Rules of Court are made for the purposes of subsection (3)\nor (4), the Court must consult the Federal Circuit and Family Court\nof Australia (Division 2)."
    },
