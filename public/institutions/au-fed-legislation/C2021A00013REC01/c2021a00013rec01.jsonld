      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "takes",
      "cml:logicSummary": "Implies obligation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
