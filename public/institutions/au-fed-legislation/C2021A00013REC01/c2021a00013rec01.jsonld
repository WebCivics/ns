    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-230",
      "@type": "cml:Concept",
      "skos:prefLabel": "230 Authorisation about handling complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-230"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.65",
      "values:originalText": "A written authorisation made under subsection 21B(3A) of the Family\nLaw Act 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 48(2) of the Federal Circuit and Family Court of Australia\nAct 2021.",
      "skos:definition": "A written authorisation made under subsection 21B(3A) of the Family\nLaw Act 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 48(2) of the Federal Circuit and Family Court of Australia\nAct 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-230-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-230-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-230-logic-alleninterval-2"
        },
        {
