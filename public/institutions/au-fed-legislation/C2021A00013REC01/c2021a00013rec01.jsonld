      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.63",
      "values:originalText": "Insert:\n(1A) The Judges of the Court, or a majority of them, may make Rules of\nCourt prescribing matters required or permitted by:\n(a) any other provision of this Act; or\n(b) any other law of the Commonwealth;\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "skos:definition": "Insert:\n(1A) The Judges of the Court, or a majority of them, may make Rules of\nCourt prescribing matters required or permitted by:\n(a) any other provision of this Act; or\n(b) any other law of the Commonwealth;\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-226-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-226-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "38f495e2d69267a8841af1a04087e573d7a384c2da9907b3d2fc0488adf63714",
      "skos:note": "May make Rules of Court"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-226",
      "@type": "cof:Section",
      "cof:title": "226 After subsection 59(1)",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "Insert:\n(1A) The Judges of the Court, or a majority of them, may make Rules of\nCourt prescribing matters required or permitted by:\n(a) any other provision of this Act; or\n(b) any other law of the Commonwealth;\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia"
    },
    {
