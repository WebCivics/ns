    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-184",
      "@type": "cml:Concept",
      "skos:prefLabel": "184 Subsection 6(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-184"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.49",
      "values:originalText": "Repeal the subsection, substitute:\n(2) A person is not to be appointed as a Judge unless:\n(a) the person:\n(i) is or has been a Judge of a prescribed court or of a court\nof a State; or\n(ii) has been enrolled as a legal practitioner of the High\nCourt or of the Supreme Court of a State or Territory for\nnot less than 5 years; and\n(b) the person has appropriate knowledge, skills and experience\nto deal with the kinds of matters that may come before the\nCourt.",
      "skos:definition": "Repeal the subsection, substitute:\n(2) A person is not to be appointed as a Judge unless:\n(a) the person:\n(i) is or has been a Judge of a prescribed court or of a court\nof a State; or\n(ii) has been enrolled as a legal practitioner of the High\nCourt or of the Supreme Court of a State or Territory for\nnot less than 5 years; and\n(b) the person has appropriate knowledge, skills and experience\nto deal with the kinds of matters that may come before the\nCourt.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-184-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-184-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0a81f5360bd99c436352a937a238b9003a4b14d4e7dd1ef81cf8b7f00af05b98",
      "skos:note": "A person must meet certain qualifications to be appointed as a Judge."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-184",
      "@type": "cof:Section",
      "cof:title": "184 Subsection 6(2)",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Repeal the subsection, substitute:\n(2) A person is not to be appointed as a Judge unless:\n(a) the person:\n(i) is or has been a Judge of a prescribed court or of a court\nof a State; or\n(ii) has been enrolled as a legal practitioner of the High\nCourt or of the Supreme Court of a State or Territory for\nnot less than 5 years; and\n(b) the person has appropriate knowledge, skills and experience\nto deal with the kinds of matters that may come before the\nCourt."
    },
