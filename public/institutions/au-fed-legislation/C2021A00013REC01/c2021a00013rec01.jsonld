    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-141",
      "@type": "cml:Concept",
      "skos:prefLabel": "141 Paragraph 111CV(1A)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-141"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.42",
      "values:originalText": "Repeal the paragraph, substitute:\n(b) the Chief Executive Officer; and\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(ba) a Senior Registrar or Registrar of the Federal Circuit and\nFamily Court of Australia (Division 1); and\n(bb) a Senior Registrar or Registrar of the Federal Circuit and\nFamily Court of Australia (Division 2); and",
      "skos:definition": "Repeal the paragraph, substitute:\n(b) the Chief Executive Officer; and\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(ba) a Senior Registrar or Registrar of the Federal Circuit and\nFamily Court of Australia (Division 1); and\n(bb) a Senior Registrar or Registrar of the Federal Circuit and\nFamily Court of Australia (Division 2); and",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-141-norm"
        }
      ],
      "cml:integrityHash": "b0485cfe2e0461e8bac4dd065af05925ef705cd0484c985cc9e6f86480f61e42",
      "skos:note": "Repeal and substitute paragraph, amend Federal Circuit and Family Court of Australia Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-141",
      "@type": "cof:Section",
      "cof:title": "141 Paragraph 111CV(1A)(b)",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "Repeal the paragraph, substitute:\n(b) the Chief Executive Officer; and\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(ba) a Senior Registrar or Registrar of the Federal Circuit and\nFamily Court of Australia (Division 1); and\n(bb) a Senior Registrar or Registrar of the Federal Circuit and\nFamily Court of Australia (Division 2); and"
    },
