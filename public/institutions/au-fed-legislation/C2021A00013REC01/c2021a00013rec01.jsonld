        },
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-6-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "3bf6868a2a8871fd697d26df8d2652f5d299e539cfc13344277d84fe56860b41",
      "skos:note": "Continuation of written authorisation upon commencement day"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-6",
