      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.42",
      "values:originalText": "Insert:\n(7B) The power of the Chief Justice of the Federal Circuit and Family\nCourt of Australia (Division 1) under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders.\n(7C) The power of the Chief Judge of the Federal Circuit and Family\nCourt of Australia (Division 2) under Chapter 4 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders.",
      "skos:definition": "Insert:\n(7B) The power of the Chief Justice of the Federal Circuit and Family\nCourt of Australia (Division 1) under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders.\n(7C) The power of the Chief Judge of the Federal Circuit and Family\nCourt of Australia (Division 2) under Chapter 4 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders.",
      "cml:hasPart": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-140-ss-7b"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-140-ss-7c"
        }
      ],
      "cml:integrityHash": "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-140",
      "@type": "cof:Section",
      "cof:title": "140 After subsection 111C(7A)",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "Insert:\n(7B) The power of the Chief Justice of the Federal Circuit and Family\nCourt of Australia (Division 1) under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders.\n(7C) The power of the Chief Judge of the Federal Circuit and Family\nCourt of Australia (Division 2) under Chapter 4 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-140-ss-7b",
      "@type": "cml:Concept",
      "skos:prefLabel": "140(7B) After subsection 111C(7A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-140-ss-7b"
      },
