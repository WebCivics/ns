      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.79",
      "values:originalText": "Repeal the subsection, substitute:\n(8A) The Federal Circuit and Family Court of Australia (Division 2)\nRules may make provision for and in relation to service on\nappropriate persons of copies of documents lodged with a Registry\nof the Federal Circuit and Family Court of Australia (Division 2)\nunder this Act.",
      "skos:definition": "Repeal the subsection, substitute:\n(8A) The Federal Circuit and Family Court of Australia (Division 2)\nRules may make provision for and in relation to service on\nappropriate persons of copies of documents lodged with a Registry\nof the Federal Circuit and Family Court of Australia (Division 2)\nunder this Act.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-33-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0fa91ca21b8deccd0627c59aac98dccd2c5045aec661ce09fe79411f4ee6ea08",
      "skos:note": "Substitute subsection (8A) with new provision regarding service on appropriate persons of documents lodged with a Registry."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Subsection 11(8A)",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "Repeal the subsection, substitute:\n(8A) The Federal Circuit and Family Court of Australia (Division 2)\nRules may make provision for and in relation to service on\nappropriate persons of copies of documents lodged with a Registry\nof the Federal Circuit and Family Court of Australia (Division 2)\nunder this Act."
    },
