          "@id": "concept:c2021a00013rec01-sch-1-sec-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6ed7da6f4bdf437048bc4fa69a8400ac1f648cf9d93bf837fb9358a85c82d7a9",
      "skos:note": "Reference to a Family Court of a State is a reference to a court to which section 41 applies."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Subsection 4(1A)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Repeal the subsection, substitute:\n(1A) In this Act and the applicable Rules of Court, a reference to a\nFamily Court of a State is a reference to a court to which section 41\napplies."
    },
    {
