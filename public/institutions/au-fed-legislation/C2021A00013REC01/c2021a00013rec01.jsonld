      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-183",
      "@type": "cml:Concept",
      "skos:prefLabel": "183 Paragraphs 110W(3)(a) and (b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-183"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.102",
      "values:originalText": "Repeal the paragraphs, substitute:\n(a) a decision is a decision of a court (other than a decision of the\nFull Court of the Federal Circuit and Family Court of\nAustralia (Division 1)) under Part VIII; and\n(b) an application may be made for leave to appeal against the\ndecision; and\nCivil Dispute Resolution Act 2011",
      "skos:definition": "Repeal the paragraphs, substitute:\n(a) a decision is a decision of a court (other than a decision of the\nFull Court of the Federal Circuit and Family Court of\nAustralia (Division 1)) under Part VIII; and\n(b) an application may be made for leave to appeal against the\ndecision; and\nCivil Dispute Resolution Act 2011",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-183-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-183-logic-deontic-1"
        }
      ],
