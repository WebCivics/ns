    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Prior judicial service",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.237",
      "values:originalText": "Paragraph 123(3)(b) of the Federal Circuit and Family Court of\nAustralia Act 2021 has effect, on and after the commencement day, as if\nparagraph (c) of the definition of prior judicial service in\nsubsection 7(1) of that Act included a reference to a Federal Magistrate.\nNote:\nThe appointment of a Federal Magistrate under the former Federal Magistrates Act\n1999 continued as an appointment of a Judge of the Federal Circuit Court of Australia:\nsee subitem 8(1) of Schedule 2 to the Federal Circuit Court of Australia Legislation\nAmendment Act 2012. See also item 15 of this Schedule.",
      "skos:definition": "Paragraph 123(3)(b) of the Federal Circuit and Family Court of\nAustralia Act 2021 has effect, on and after the commencement day, as if\nparagraph (c) of the definition of prior judicial service in\nsubsection 7(1) of that Act included a reference to a Federal Magistrate.\nNote:\nThe appointment of a Federal Magistrate under the former Federal Magistrates Act\n1999 continued as an appointment of a Judge of the Federal Circuit Court of Australia:\nsee subitem 8(1) of Schedule 2 to the Federal Circuit Court of Australia Legislation\nAmendment Act 2012. See also item 15 of this Schedule.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-36-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-36-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-36-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "e5b3b0209bfe61abb1b17ae40d50d3e637647cbefaa90fa99684fea7cbc6eab2",
      "skos:note": "Prior judicial service includes Federal Magistrate appointments"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Prior judicial service",
      "values:kind": "section",
      "cof:pageNumber": 237,
      "values:originalText": "Paragraph 123(3)(b) of the Federal Circuit and Family Court of\nAustralia Act 2021 has effect, on and after the commencement day, as if\nparagraph (c) of the definition of prior judicial service in\nsubsection 7(1) of that Act included a reference to a Federal Magistrate.\nNote:\nThe appointment of a Federal Magistrate under the former Federal Magistrates Act\n1999 continued as an appointment of a Judge of the Federal Circuit Court of Australia:\nsee subitem 8(1) of Schedule 2 to the Federal Circuit Court of Australia Legislation\nAmendment Act 2012. See also item 15 of this Schedule."
    },
