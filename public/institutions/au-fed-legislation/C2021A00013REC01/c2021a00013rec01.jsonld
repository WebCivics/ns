      "cml:integrityHash": "db5f15ba337ac9772f789460f695fcf29be48b982afd2c4a2eeba02f7517321c",
      "skos:note": "Repeal and substitute court names"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-68",
      "@type": "cof:Section",
      "cof:title": "68 Paragraphs 46(3A)(a) to (c)",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Repeal the paragraphs, substitute:\n(a) the Federal Circuit and Family Court of Australia\n(Division 2);\n(b) a Family Court of a State;\n(c) the Supreme Court of a State or Territory;"
    },
