      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-560-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "560 Subsection 486C(3A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-560-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.157",
      "values:originalText": "Repeal the subsection, substitute:\n(3A) This section applies to:\n(a) proceedings:\n(i) that are transferred to the Federal Court under\nsection 153 of the Federal Circuit and Family Court of\nAustralia Act 2021; and\n(ii) whose transfer are confirmed by the Federal Court\nunder section 32AD of the Federal Court of Australia\nAct 1976; and\n(b) proceedings in which the Federal Court has jurisdiction under\nparagraph 476A(1)(b) or (c).\n(3B) To avoid doubt, this section does not apply to proceedings that are\ntransferred to the Federal Court under section 32AC of the Federal\nCourt of Australia Act 1976.",
      "skos:definition": "Repeal the subsection, substitute:\n(3A) This section applies to:\n(a) proceedings:\n(i) that are transferred to the Federal Court under\nsection 153 of the Federal Circuit and Family Court of\nAustralia Act 2021; and\n(ii) whose transfer are confirmed by the Federal Court\nunder section 32AD of the Federal Court of Australia\nAct 1976; and\n(b) proceedings in which the Federal Court has jurisdiction under\nparagraph 476A(1)(b) or (c).\n(3B) To avoid doubt, this section does not apply to proceedings that are\ntransferred to the Federal Court under section 32AC of the Federal\nCourt of Australia Act 1976.",
      "cml:hasPart": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-560-2-ss-3a"
        },
