        }
      ],
      "cml:integrityHash": "a989323247a32d43530ec7acc6a74fcea3fc25409bd684640ec21dd2ed705a68",
      "skos:note": "Extends power to make Rules of Court for adoption orders."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-140-ss-7b",
      "@type": "cof:Section",
      "cof:title": "140(7B) After subsection 111C(7A)",
      "values:kind": "subsection",
      "cof:pageNumber": 42,
      "values:originalText": "(7B) The power of the Chief Justice of the Federal Circuit and Family\nCourt of Australia (Division 1) under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders."
    },
