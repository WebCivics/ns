    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-81",
      "@type": "cml:Concept",
      "skos:prefLabel": "81 Subsection 55A(13)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-81"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.85",
      "values:originalText": "Insert:\nJudge of the Federal Circuit and Family Court of Australia\n(Division 2) means a Judge of the Federal Circuit and Family\nCourt of Australia (Division 2) in a personal capacity and not as a\ncourt or a member of a court.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021",
      "skos:definition": "Insert:\nJudge of the Federal Circuit and Family Court of Australia\n(Division 2) means a Judge of the Federal Circuit and Family\nCourt of Australia (Division 2) in a personal capacity and not as a\ncourt or a member of a court.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-81-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-81-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "bf90471d4672a01662ed75cab722829ae3ab223b141692a60d5524596db0d105",
      "skos:note": "Definition of Judge of the Federal Circuit and Family Court of Australia (Division 2)"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-81",
      "@type": "cof:Section",
      "cof:title": "81 Subsection 55A(13)",
      "values:kind": "section",
      "cof:pageNumber": 85,
      "values:originalText": "Insert:\nJudge of the Federal Circuit and Family Court of Australia\n(Division 2) means a Judge of the Federal Circuit and Family\nCourt of Australia (Division 2) in a personal capacity and not as a\ncourt or a member of a court.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-81-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-2-sec-81"
      },
