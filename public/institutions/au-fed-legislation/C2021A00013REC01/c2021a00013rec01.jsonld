    {
      "@id": "concept:c2021a00013rec01-sch-4-sec-47ba-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "47BA(3) Appeals relating to matters arising under Part VIIIC",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-4-sec-47ba-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
