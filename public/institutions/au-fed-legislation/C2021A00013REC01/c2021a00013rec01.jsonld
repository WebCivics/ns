    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-71",
      "@type": "cml:Concept",
      "skos:prefLabel": "71 Subsection 56(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-71"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.32",
      "values:originalText": "Omit all the words after “certificate”, substitute:\nthat certifies that the divorce order has taken effect and is signed\nby:\n(a) if the court is the Federal Circuit and Family Court of\nAustralia (Division 1)—the Chief Executive Officer, or a\nSenior Registrar or Registrar of the Court; or\n(b) if the court is the Federal Circuit and Family Court of\nAustralia (Division 2)—the Chief Executive Officer, or a\nSenior Registrar or Registrar of the Court; or\n(c) in relation to any other court—the Registrar of that court.\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "Omit all the words after “certificate”, substitute:\nthat certifies that the divorce order has taken effect and is signed\nby:\n(a) if the court is the Federal Circuit and Family Court of\nAustralia (Division 1)—the Chief Executive Officer, or a\nSenior Registrar or Registrar of the Court; or\n(b) if the court is the Federal Circuit and Family Court of\nAustralia (Division 2)—the Chief Executive Officer, or a\nSenior Registrar or Registrar of the Court; or\n(c) in relation to any other court—the Registrar of that court.\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-71-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-71-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9349ecccebd0adc094cbc9722a9abdfec3cd8bf4d905dbccf3031ef89cc951f5",
      "skos:note": "Specify the authority for issuing a divorce order certificate."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-71",
      "@type": "cof:Section",
      "cof:title": "71 Subsection 56(2)",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "Omit all the words after “certificate”, substitute:\nthat certifies that the divorce order has taken effect and is signed\nby:\n(a) if the court is the Federal Circuit and Family Court of\nAustralia (Division 1)—the Chief Executive Officer, or a\nSenior Registrar or Registrar of the Court; or\n(b) if the court is the Federal Circuit and Family Court of\nAustralia (Division 2)—the Chief Executive Officer, or a\nSenior Registrar or Registrar of the Court; or\n(c) in relation to any other court—the Registrar of that court.\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
