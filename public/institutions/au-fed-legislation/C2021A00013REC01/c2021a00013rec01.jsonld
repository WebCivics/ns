      "dc:source": "c2021a00013rec01.pdf, p.17",
      "values:originalText": "Repeal the following definitions:\n(a) definition of administrative affairs;\n(b) definition of appeal;\n(c) definition of Appeal Division.",
      "skos:definition": "Repeal the following definitions:\n(a) definition of administrative affairs;\n(b) definition of appeal;\n(c) definition of Appeal Division.",
      "cml:asserts": [
