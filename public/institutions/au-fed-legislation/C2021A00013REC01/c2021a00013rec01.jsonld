      },
      "cml:premiseText": "Family Court of a State means a court to which section 41 of the Family Law Act 1975, as amended by this Act, applies.",
      "cml:conclusionText": "Family Court of Australia means the federal court known, immediately before the commencement day, as the Family Court of Australia."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
