      "dc:source": "c2021a00013rec01.pdf, p.93",
      "values:originalText": "Repeal the note, substitute:\nNote:\nRules of Court made under Chapter 3 of the Federal Circuit and\nFamily Court of Australia Act 2021 (rather than Rules of Court made\nunder the Federal Court of Australia Act 1976) apply in relation to\nproceedings transferred to the Federal Circuit and Family Court of\nAustralia (Division 1) under this section.",
      "skos:definition": "Repeal the note, substitute:\nNote:\nRules of Court made under Chapter 3 of the Federal Circuit and\nFamily Court of Australia Act 2021 (rather than Rules of Court made\nunder the Federal Court of Australia Act 1976) apply in relation to\nproceedings transferred to the Federal Circuit and Family Court of\nAustralia (Division 1) under this section.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-138-norm"
        }
      ],
      "cml:integrityHash": "5a13500f6ece058f4b8ed7ff2b1d6d6a8f8d8e4292e02379e55868476d7fb68d",
      "skos:note": "Repeal note and substitute with new rule"
    },
    {
