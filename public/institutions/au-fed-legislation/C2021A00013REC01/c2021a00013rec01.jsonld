      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "includes",
      "cml:logicSummary": "Includes temporal intervals for things done by, or in relation to, the Marshal or a Deputy.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Registries",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.220",
      "values:originalText": "Despite the repeal of Part IV of the Family Law Act 1975, a Registry of\nthe Family Court of Australia, existing immediately before the\ncommencement day, continues in existence on and after that day as a\nRegistry of the Federal Circuit and Family Court of Australia\n(Division 1).",
      "skos:definition": "Despite the repeal of Part IV of the Family Law Act 1975, a Registry of\nthe Family Court of Australia, existing immediately before the\ncommencement day, continues in existence on and after that day as a\nRegistry of the Federal Circuit and Family Court of Australia\n(Division 1).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-12-norm"
        }
      ],
      "cml:integrityHash": "c6486323fc2e8d9c384e70b2cb4c56639f465f3295e40d0ec878e1a991ab20ae",
      "skos:note": "Registry continues in existence after commencement day"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Registries",
      "values:kind": "section",
      "cof:pageNumber": 220,
      "values:originalText": "Despite the repeal of Part IV of the Family Law Act 1975, a Registry of\nthe Family Court of Australia, existing immediately before the\ncommencement day, continues in existence on and after that day as a\nRegistry of the Federal Circuit and Family Court of Australia\n(Division 1)."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-12-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-5-sec-12"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.220",
      "values:originalText": "If, in relation to a Judge of the Family Court of Australia:\n(a) a complaint is made, on or after the commencement day,\nabout the Judge; and\n(b) the circumstances that gave rise to the complaint occurred\nbefore the commencement day;\nthen:\n(c) the Chief Justice may deal with the complaint under\nsection 48 of the new law; and\n(d) for the purposes of dealing with the complaint, the reference\nto the Federal Circuit and Family Court of Australia\n(Division 1) in subparagraph (b)(ii) of the definition of\nrelevant belief in subsection 48(4) of the new law is taken to\ninclude a reference to the Family Court of Australia.\n\nTransitional provisions  Schedule 5\nContinuity of the Federal Circuit Court of Australia, and Judges and personnel of the\nCourt  Part 3\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "If, in relation to a Judge of the Family Court of Australia:\n(a) a complaint is made, on or after the commencement day,\nabout the Judge; and\n(b) the circumstances that gave rise to the complaint occurred\nbefore the commencement day;\nthen:\n(c) the Chief Justice may deal with the complaint under\nsection 48 of the new law; and\n(d) for the purposes of dealing with the complaint, the reference\nto the Federal Circuit and Family Court of Australia\n(Division 1) in subparagraph (b)(ii) of the definition of\nrelevant belief in subsection 48(4) of the new law is taken to\ninclude a reference to the Family Court of Australia.\n\nTransitional provisions  Schedule 5\nContinuity of the Federal Circuit Court of Australia, and Judges and personnel of the\nCourt  Part 3\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-13-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-13-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-13-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-13-logic-ltl-3"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-13-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "efb550be35455ed98efa1ff337c5d212ccebc78e09c3a8e4351c9a1ebc52605e",
      "skos:note": "Chief Justice must deal with complaint about Judge if complaint made on or after commencement day and circumstances gave rise to complaint occurred before commencement day."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Complaints",
      "values:kind": "section",
      "cof:pageNumber": 220,
      "values:originalText": "If, in relation to a Judge of the Family Court of Australia:\n(a) a complaint is made, on or after the commencement day,\nabout the Judge; and\n(b) the circumstances that gave rise to the complaint occurred\nbefore the commencement day;\nthen:\n(c) the Chief Justice may deal with the complaint under\nsection 48 of the new law; and\n(d) for the purposes of dealing with the complaint, the reference\nto the Federal Circuit and Family Court of Australia\n(Division 1) in subparagraph (b)(ii) of the definition of\nrelevant belief in subsection 48(4) of the new law is taken to\ninclude a reference to the Family Court of Australia.\n\nTransitional provisions  Schedule 5\nContinuity of the Federal Circuit Court of Australia, and Judges and personnel of the\nCourt  Part 3\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-13-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-5-sec-13"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-13-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Chief Justice must deal with complaint.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Complaint made on or after commencement day.",
      "cml:conclusionText": "Chief Justice deals with complaint."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-13-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Complaint must be made on or after commencement day for Chief Justice to deal with complaint.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Complaint must occur before commencement day for Chief Justice not to deal with complaint.",
      "cml:conclusionText": "Complaint made on or after commencement day implies Chief Justice deals with complaint."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-13-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "AND",
      "cml:logicSummary": "Chief Justice must deal with complaint if complaint made on or after commencement day and circumstances gave rise to complaint occurred before commencement day.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Complaint made on or after commencement day.",
      "cml:conclusionText": "Chief Justice deals with complaint."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-13-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MAY",
      "cml:logicSummary": "Chief Justice may deal with complaint if circumstances gave rise to complaint occurred before commencement day.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Complaint made on or after commencement day.",
      "cml:conclusionText": "Chief Justice may deal with complaint."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-14",
