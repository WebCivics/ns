      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-3-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Authorisation about handling complaints",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.199",
      "values:originalText": "A written authorisation made under subsection 12(3AB) of the Federal\nCircuit Court of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 145(2) of the Federal Circuit and\nFamily Court of Australia Act 2021.\n\nSchedule 3  Repeal of the Federal Circuit Court of Australia Act 1999",
      "skos:definition": "A written authorisation made under subsection 12(3AB) of the Federal\nCircuit Court of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 145(2) of the Federal Circuit and\nFamily Court of Australia Act 2021.\n\nSchedule 3  Repeal of the Federal Circuit Court of Australia Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-4-norm"
        }
      ],
      "cml:integrityHash": "a550f0b64b54aaa5e45c2ff538114ea18a9eed839d82fec1ca8df767bd1f8405",
      "skos:note": "Continuation of written authorisation under specific conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Authorisation about handling complaints",
      "values:kind": "section",
      "cof:pageNumber": 199,
      "values:originalText": "A written authorisation made under subsection 12(3AB) of the Federal\nCircuit Court of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 145(2) of the Federal Circuit and\nFamily Court of Australia Act 2021.\n\nSchedule 3  Repeal of the Federal Circuit Court of Australia Act 1999"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-4-norm",
