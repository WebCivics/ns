    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-219",
      "@type": "cml:Concept",
      "skos:prefLabel": "219 Subsection 32AB(8A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-219"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
