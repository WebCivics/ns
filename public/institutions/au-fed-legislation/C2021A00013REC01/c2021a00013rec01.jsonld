      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.136",
      "values:originalText": "Repeal the subsection, substitute:\nChild support or family law matters\n(1) The Federal Circuit and Family Court of Australia (Division 1)\nmay, on the application of a party to a proceeding before the\nFederal Circuit and Family Court of Australia (Division 2) in a\nchild support or family law matter, exercise the same power to\nmake an order of the kind referred to in Division 1 as the Federal\nCircuit and Family Court of Australia (Division 1) has under that\nDivision for the purpose of a proceeding in the Federal Circuit and\nFamily Court of Australia (Division 1).",
      "skos:definition": "Repeal the subsection, substitute:\nChild support or family law matters\n(1) The Federal Circuit and Family Court of Australia (Division 1)\nmay, on the application of a party to a proceeding before the\nFederal Circuit and Family Court of Australia (Division 2) in a\nchild support or family law matter, exercise the same power to\nmake an order of the kind referred to in Division 1 as the Federal\nCircuit and Family Court of Australia (Division 1) has under that\nDivision for the purpose of a proceeding in the Federal Circuit and\nFamily Court of Australia (Division 1).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-433-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-433-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "53956e056487d953aa27e25d8bb770d4aa673c9607a7d4d829aa3158c4485dab",
      "skos:note": "Allow exercise of power by Division 1 in certain circumstances"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-433",
      "@type": "cof:Section",
      "cof:title": "433 Subsection 9A(1)",
      "values:kind": "section",
      "cof:pageNumber": 136,
      "values:originalText": "Repeal the subsection, substitute:\nChild support or family law matters\n(1) The Federal Circuit and Family Court of Australia (Division 1)\nmay, on the application of a party to a proceeding before the\nFederal Circuit and Family Court of Australia (Division 2) in a\nchild support or family law matter, exercise the same power to\nmake an order of the kind referred to in Division 1 as the Federal\nCircuit and Family Court of Australia (Division 1) has under that\nDivision for the purpose of a proceeding in the Federal Circuit and\nFamily Court of Australia (Division 1)."
    },
