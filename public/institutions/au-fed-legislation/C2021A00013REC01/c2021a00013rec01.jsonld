    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-693",
      "@type": "cml:Concept",
      "skos:prefLabel": "693 Subsection 56A(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-693"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
