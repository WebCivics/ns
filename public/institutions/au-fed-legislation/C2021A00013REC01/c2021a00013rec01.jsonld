    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-32ac-ss-1",
      "@type": "cof:Section",
      "cof:title": "32AC(1) Discretionary transfer of civil proceedings from the Federal",
      "values:kind": "subsection",
