    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-147",
      "@type": "cml:Concept",
      "skos:prefLabel": "147 Section 486",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-147"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.94",
      "values:originalText": "Omit:\nA magistrate or Judge of the Federal Court, the Federal Circuit\nCourt or a State or Territory court may issue a warrant to authorise\nentry to premises or taking of possession of premises or a\nconveyance, if satisfied of certain matters.\nsubstitute:\nA magistrate or Judge of the Federal Court, the Federal Circuit and\nFamily Court of Australia (Division 2) or a State or Territory court\nmay issue a warrant to authorise entry to premises or taking of\npossession of premises or a conveyance, if satisfied of certain\nmatters.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nBroadcasting Legislation Amendment (Broadcasting\nReform) Act 2017",
      "skos:definition": "Omit:\nA magistrate or Judge of the Federal Court, the Federal Circuit\nCourt or a State or Territory court may issue a warrant to authorise\nentry to premises or taking of possession of premises or a\nconveyance, if satisfied of certain matters.\nsubstitute:\nA magistrate or Judge of the Federal Court, the Federal Circuit and\nFamily Court of Australia (Division 2) or a State or Territory court\nmay issue a warrant to authorise entry to premises or taking of\npossession of premises or a conveyance, if satisfied of certain\nmatters.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nBroadcasting Legislation Amendment (Broadcasting\nReform) Act 2017",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-147-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-147-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-147-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-147-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "0c1be38ae0737508c1849e1195e5e9f56b42a854f5d6a3c09020d7ff8b3526b2",
      "skos:note": "Magistrates and judges cannot issue warrants for entry or possession without certain matters being satisfied."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-147",
      "@type": "cof:Section",
      "cof:title": "147 Section 486",
      "values:kind": "section",
      "cof:pageNumber": 94,
      "values:originalText": "Omit:\nA magistrate or Judge of the Federal Court, the Federal Circuit\nCourt or a State or Territory court may issue a warrant to authorise\nentry to premises or taking of possession of premises or a\nconveyance, if satisfied of certain matters.\nsubstitute:\nA magistrate or Judge of the Federal Court, the Federal Circuit and\nFamily Court of Australia (Division 2) or a State or Territory court\nmay issue a warrant to authorise entry to premises or taking of\npossession of premises or a conveyance, if satisfied of certain\nmatters.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nBroadcasting Legislation Amendment (Broadcasting\nReform) Act 2017"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-147-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-2-sec-147"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-147-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "forbid",
      "cml:logicSummary": "Prohibition of warrant issuance",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Magistrates and judges may issue warrants.",
      "cml:conclusionText": "They cannot issue warrants without certain matters being satisfied."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-147-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "between",
      "cml:logicSummary": "Temporal interval between amendment and commencement",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The amendments take effect on the commencement date.",
      "cml:conclusionText": "The amendments apply between the commencement date and the end of the period specified in the Schedule."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-147-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Temporal interval until amendment",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The amendments take effect on the commencement date.",
      "cml:conclusionText": "The amendments apply until the end of the period specified in the Schedule."
    },
