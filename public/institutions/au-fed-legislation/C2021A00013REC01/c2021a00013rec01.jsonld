      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.200",
      "values:originalText": "An arrangement made under subsection 90(1) of the Federal Circuit\nCourt of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 246(1) of the Federal Circuit and\nFamily Court of Australia Act 2021.",
      "skos:definition": "An arrangement made under subsection 90(1) of the Federal Circuit\nCourt of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 246(1) of the Federal Circuit and\nFamily Court of Australia Act 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-7-norm"
        }
      ],
      "cml:integrityHash": "af4a0ad5d85339c991d2c2d17daacc4e9b6e65272e237167748314d99bbeb9d2",
      "skos:note": "Continuation of arrangements with other courts"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Arrangements with other courts",
      "values:kind": "section",
      "cof:pageNumber": 200,
      "values:originalText": "An arrangement made under subsection 90(1) of the Federal Circuit\nCourt of Australia Act 1999 and in force immediately before the\ncommencement day continues in force (and may be dealt with) as if it\nhad been made under subsection 246(1) of the Federal Circuit and\nFamily Court of Australia Act 2021."
    },
