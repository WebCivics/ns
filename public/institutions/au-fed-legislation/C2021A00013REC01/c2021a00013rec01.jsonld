    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-47a-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "47A(6) Appeals from courts of summary jurisdiction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-47a-ss-6"
      },
      "cml:curationStatus": {
