    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-714",
      "@type": "cml:Concept",
      "skos:prefLabel": "714 Paragraphs 73(2)(b) to (ca)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-714"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.182",
      "values:originalText": "Repeal the paragraphs, substitute:\n(b) the Chief Executive Officer and Principal Registrar of the\nFederal Court is the chief executive officer of the Federal\nCourt; and\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(c) the Chief Executive Officer and Principal Registrar of the\nFederal Circuit and Family Court of Australia is the chief\nexecutive officer of the following courts:\n(i) the Federal Circuit and Family Court of Australia\n(Division 1);\n(ii) the Federal Circuit and Family Court of Australia\n(Division 2); and\nRegulatory Powers (Standard Provisions) Act 2014",
      "skos:definition": "Repeal the paragraphs, substitute:\n(b) the Chief Executive Officer and Principal Registrar of the\nFederal Court is the chief executive officer of the Federal\nCourt; and\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(c) the Chief Executive Officer and Principal Registrar of the\nFederal Circuit and Family Court of Australia is the chief\nexecutive officer of the following courts:\n(i) the Federal Circuit and Family Court of Australia\n(Division 1);\n(ii) the Federal Circuit and Family Court of Australia\n(Division 2); and\nRegulatory Powers (Standard Provisions) Act 2014",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-714-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-714-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "497486a64cff8ee4a8e089fd7ed7827551d68a22fa3251cb23a32e41a51db87f",
      "skos:note": "Repeal and substitute certain provisions related to the Chief Executive Officer and Principal Registrar of the Federal Court."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-714",
      "@type": "cof:Section",
      "cof:title": "714 Paragraphs 73(2)(b) to (ca)",
      "values:kind": "section",
      "cof:pageNumber": 182,
      "values:originalText": "Repeal the paragraphs, substitute:\n(b) the Chief Executive Officer and Principal Registrar of the\nFederal Court is the chief executive officer of the Federal\nCourt; and\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(c) the Chief Executive Officer and Principal Registrar of the\nFederal Circuit and Family Court of Australia is the chief\nexecutive officer of the following courts:\n(i) the Federal Circuit and Family Court of Australia\n(Division 1);\n(ii) the Federal Circuit and Family Court of Australia\n(Division 2); and\nRegulatory Powers (Standard Provisions) Act 2014"
    },
