    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-47a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "47A(3) Appeals from courts of summary jurisdiction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-47a-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
