      },
      "dc:source": "c2021a00013rec01.pdf, p.69",
      "values:originalText": "Repeal the paragraph, substitute:\n(a) the person:\n(i) has not attained the age of 18 years; or\n(ii) has attained the age of 18 years but has not attained the\nage of 25 years and is receiving full-time education at a\nschool, college or university; and",
      "skos:definition": "Repeal the paragraph, substitute:\n(a) the person:\n(i) has not attained the age of 18 years; or\n(ii) has attained the age of 18 years but has not attained the\nage of 25 years and is receiving full-time education at a\nschool, college or university; and",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-239-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-239-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-239-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "335ff61aada7e8bae35401c536bad986ef0cf3068147485e93c6a94fbb57cc98",
      "skos:note": "Repeal paragraph, substitute with conditions for age and education"
    },
