    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Paragraphs 45(2)(a) and (b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-61"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.27",
      "values:originalText": "Repeal the paragraphs, substitute:\n(a) the first-mentioned court is the Federal Circuit and Family\nCourt of Australia (Division 1) and the other court is the\nFederal Circuit and Family Court of Australia (Division 2);\nor\n(b) the first-mentioned court is the Federal Circuit and Family\nCourt of Australia (Division 2) and the other court is the\nFederal Circuit and Family Court of Australia (Division 1).",
      "skos:definition": "Repeal the paragraphs, substitute:\n(a) the first-mentioned court is the Federal Circuit and Family\nCourt of Australia (Division 1) and the other court is the\nFederal Circuit and Family Court of Australia (Division 2);\nor\n(b) the first-mentioned court is the Federal Circuit and Family\nCourt of Australia (Division 2) and the other court is the\nFederal Circuit and Family Court of Australia (Division 1).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-61-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-61-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "18b3e002ba6ebac3409637fba7db8e36a6998ac0b512e03b825a60af95187e87",
      "skos:note": "Repeal and substitute court names"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-61",
      "@type": "cof:Section",
      "cof:title": "61 Paragraphs 45(2)(a) and (b)",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "Repeal the paragraphs, substitute:\n(a) the first-mentioned court is the Federal Circuit and Family\nCourt of Australia (Division 1) and the other court is the\nFederal Circuit and Family Court of Australia (Division 2);\nor\n(b) the first-mentioned court is the Federal Circuit and Family\nCourt of Australia (Division 2) and the other court is the\nFederal Circuit and Family Court of Australia (Division 1)."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-61-norm",
