      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Instrument about Commonwealth tenancy disputes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.199",
      "values:originalText": "Despite the repeal of the Federal Circuit Court of Australia Act 1999:\n(a) an instrument made under section 10AA of the Federal\nCircuit Court of Australia Act 1999 and in force immediately\nbefore the commencement day continues in force (and may\nbe dealt with) as if it had been made under section 133 of the\nFederal Circuit and Family Court of Australia Act 2021; and\n(b) on and after the commencement day, the instrument is to be\nknown as the Federal Circuit and Family Court of Australia\n(Division 2) (Commonwealth Tenancy Disputes) Instrument\n2015; and\n(c) on and after the commencement day, the instrument applies\nas if:\n(i) the reference in section 3 of the instrument to\nsection 10AA of the Federal Circuit Court of Australia\nAct 1999 were a reference to section 133 of the Federal\nCircuit and Family Court of Australia Act 2021; and\n(ii) the reference in section 4 of the instrument to the\nFederal Circuit Court of Australia Act 1999 were a\nreference to the Federal Circuit and Family Court of\nAustralia Act 2021; and\n(iii) any reference in the instrument to the Federal Circuit\nCourt of Australia were a reference to the Federal\nCircuit and Family Court of Australia (Division 2).",
      "skos:definition": "Despite the repeal of the Federal Circuit Court of Australia Act 1999:\n(a) an instrument made under section 10AA of the Federal\nCircuit Court of Australia Act 1999 and in force immediately\nbefore the commencement day continues in force (and may\nbe dealt with) as if it had been made under section 133 of the\nFederal Circuit and Family Court of Australia Act 2021; and\n(b) on and after the commencement day, the instrument is to be\nknown as the Federal Circuit and Family Court of Australia\n(Division 2) (Commonwealth Tenancy Disputes) Instrument\n2015; and\n(c) on and after the commencement day, the instrument applies\nas if:\n(i) the reference in section 3 of the instrument to\nsection 10AA of the Federal Circuit Court of Australia\nAct 1999 were a reference to section 133 of the Federal\nCircuit and Family Court of Australia Act 2021; and\n(ii) the reference in section 4 of the instrument to the\nFederal Circuit Court of Australia Act 1999 were a\nreference to the Federal Circuit and Family Court of\nAustralia Act 2021; and\n(iii) any reference in the instrument to the Federal Circuit\nCourt of Australia were a reference to the Federal\nCircuit and Family Court of Australia (Division 2).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-3-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-3-sec-3-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "7c61473aa9fe020b7734a0a23d3741de5dbe98de6ef0148a84707cf06c062790",
      "skos:note": "Continuation of instrument under new name and application"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Instrument about Commonwealth tenancy disputes",
      "values:kind": "section",
      "cof:pageNumber": 199,
      "values:originalText": "Despite the repeal of the Federal Circuit Court of Australia Act 1999:\n(a) an instrument made under section 10AA of the Federal\nCircuit Court of Australia Act 1999 and in force immediately\nbefore the commencement day continues in force (and may\nbe dealt with) as if it had been made under section 133 of the\nFederal Circuit and Family Court of Australia Act 2021; and\n(b) on and after the commencement day, the instrument is to be\nknown as the Federal Circuit and Family Court of Australia\n(Division 2) (Commonwealth Tenancy Disputes) Instrument\n2015; and\n(c) on and after the commencement day, the instrument applies\nas if:\n(i) the reference in section 3 of the instrument to\nsection 10AA of the Federal Circuit Court of Australia\nAct 1999 were a reference to section 133 of the Federal\nCircuit and Family Court of Australia Act 2021; and\n(ii) the reference in section 4 of the instrument to the\nFederal Circuit Court of Australia Act 1999 were a\nreference to the Federal Circuit and Family Court of\nAustralia Act 2021; and\n(iii) any reference in the instrument to the Federal Circuit\nCourt of Australia were a reference to the Federal\nCircuit and Family Court of Australia (Division 2)."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-3-sec-3-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-3-sec-3"
      },
      "values:deonticStatus": {
