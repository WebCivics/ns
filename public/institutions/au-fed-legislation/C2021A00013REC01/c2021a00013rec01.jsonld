    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-98",
      "@type": "cml:Concept",
      "skos:prefLabel": "98 Section 69ZO",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-98"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.36",
      "values:originalText": "Repeal the section, substitute:\n69ZO  This Division also applies to proceedings in Chambers\nThe following persons, when hearing child-related proceedings in\nChambers, have all of the duties and powers that a court has under\nthis Division:\n(a) in the case of the Federal Circuit and Family Court of\nAustralia (Division 1)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court;\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(b) in the case of the Federal Circuit and Family Court of\nAustralia (Division 2)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court;\n(c) in any other case—a Judge, Registrar or magistrate.\nNote:\nAn order made in Chambers has the same effect as an order made in\nopen court.",
      "skos:definition": "Repeal the section, substitute:\n69ZO  This Division also applies to proceedings in Chambers\nThe following persons, when hearing child-related proceedings in\nChambers, have all of the duties and powers that a court has under\nthis Division:\n(a) in the case of the Federal Circuit and Family Court of\nAustralia (Division 1)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court;\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(b) in the case of the Federal Circuit and Family Court of\nAustralia (Division 2)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court;\n(c) in any other case—a Judge, Registrar or magistrate.\nNote:\nAn order made in Chambers has the same effect as an order made in\nopen court.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-98-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-98-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c9d30825db0b86e24b086d07adbcbaa3ba11d732b10601596c7ac368d8ebcdb8",
      "skos:note": "Duties and powers for hearing child-related proceedings in Chambers"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-98",
      "@type": "cof:Section",
      "cof:title": "98 Section 69ZO",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "Repeal the section, substitute:\n69ZO  This Division also applies to proceedings in Chambers\nThe following persons, when hearing child-related proceedings in\nChambers, have all of the duties and powers that a court has under\nthis Division:\n(a) in the case of the Federal Circuit and Family Court of\nAustralia (Division 1)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court;\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(b) in the case of the Federal Circuit and Family Court of\nAustralia (Division 2)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court;\n(c) in any other case—a Judge, Registrar or magistrate.\nNote:\nAn order made in Chambers has the same effect as an order made in\nopen court."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-98-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-98"
