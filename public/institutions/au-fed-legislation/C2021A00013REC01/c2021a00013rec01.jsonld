    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-194",
      "@type": "cml:Concept",
      "skos:prefLabel": "194 Paragraphs 18Z(1)(b) and (c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-194"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.51",
      "values:originalText": "Repeal the paragraphs, substitute:\n(b) providing the corporate services of the Federal Circuit and\nFamily Court of Australia (Division 1);\n(c) providing the corporate services of the Federal Circuit and\nFamily Court of Australia (Division 2).",
      "skos:definition": "Repeal the paragraphs, substitute:\n(b) providing the corporate services of the Federal Circuit and\nFamily Court of Australia (Division 1);\n(c) providing the corporate services of the Federal Circuit and\nFamily Court of Australia (Division 2).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-194-norm"
        }
      ],
      "cml:integrityHash": "6df17b11aecebc71b55b507fd6a1080ae27957e228de0e4530065fbc6a6a7361",
      "skos:note": "Substitute corporate services of Federal Circuit and Family Court of Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-194",
      "@type": "cof:Section",
      "cof:title": "194 Paragraphs 18Z(1)(b) and (c)",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "Repeal the paragraphs, substitute:\n(b) providing the corporate services of the Federal Circuit and\nFamily Court of Australia (Division 1);\n(c) providing the corporate services of the Federal Circuit and\nFamily Court of Australia (Division 2)."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-194-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-194"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-195",
      "@type": "cml:Concept",
      "skos:prefLabel": "195 Paragraphs 18Z(3)(b) to (e)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-195"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.51",
      "values:originalText": "Repeal the paragraphs, substitute:\n(b) the Chief Justice of the Federal Circuit and Family Court of\nAustralia (Division 1);\n(c) the Chief Judge of the Federal Circuit and Family Court of\nAustralia (Division 2);\n(d) the Chief Executive Officer of the Federal Circuit and Family\nCourt of Australia.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "skos:definition": "Repeal the paragraphs, substitute:\n(b) the Chief Justice of the Federal Circuit and Family Court of\nAustralia (Division 1);\n(c) the Chief Judge of the Federal Circuit and Family Court of\nAustralia (Division 2);\n(d) the Chief Executive Officer of the Federal Circuit and Family\nCourt of Australia.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-195-norm"
        }
      ],
      "cml:integrityHash": "e2a2ca25f48876ddae58de3ccb566d5571bfec02870b239750388430d6cd8c47",
      "skos:note": "Repeal and substitute certain judicial positions with new ones."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-195",
      "@type": "cof:Section",
      "cof:title": "195 Paragraphs 18Z(3)(b) to (e)",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "Repeal the paragraphs, substitute:\n(b) the Chief Justice of the Federal Circuit and Family Court of\nAustralia (Division 1);\n(c) the Chief Judge of the Federal Circuit and Family Court of\nAustralia (Division 2);\n(d) the Chief Executive Officer of the Federal Circuit and Family\nCourt of Australia.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-195-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-195"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-196",
      "@type": "cml:Concept",
      "skos:prefLabel": "196 Subsection 18Z(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-196"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.52",
      "values:originalText": "Repeal the subsection, substitute:\n(5) When performing functions, or exercising powers, under this\nsection, before the Chief Executive Officer makes a decision that\nhas the effect of imposing an expenditure obligation relating to the\nadministrative affairs of a court mentioned in an item of the\nfollowing table:\n(a) the Chief Executive Officer must consult the person or\npersons mentioned in that item about the decision; and\n(b) either:\n(i) the person or persons mentioned in that item must\nconsent to the decision; or\n(ii) the Attorney-General must consent to the decision, after\nthe Attorney-General has consulted the person or\npersons mentioned in that item about the decision.\nConsultation about expenditure relating to administrative affairs\nItem\nCourt\nPersons to be consulted\nThe Court\nThe Chief Justice\nThe Federal Circuit and Family\nCourt of Australia (Division 1)\nBoth:\n(a) the Chief Justice of the Federal\nCircuit and Family Court of\nAustralia (Division 1); and\n(b) the Chief Justice of the Court\nThe Federal Circuit and Family\nCourt of Australia (Division 2)\nBoth:\n(a) the Chief Judge of the Federal\nCircuit and Family Court of\nAustralia (Division 2); and\n(b) the Chief Justice of the Court",
      "skos:definition": "Repeal the subsection, substitute:\n(5) When performing functions, or exercising powers, under this\nsection, before the Chief Executive Officer makes a decision that\nhas the effect of imposing an expenditure obligation relating to the\nadministrative affairs of a court mentioned in an item of the\nfollowing table:\n(a) the Chief Executive Officer must consult the person or\npersons mentioned in that item about the decision; and\n(b) either:\n(i) the person or persons mentioned in that item must\nconsent to the decision; or\n(ii) the Attorney-General must consent to the decision, after\nthe Attorney-General has consulted the person or\npersons mentioned in that item about the decision.\nConsultation about expenditure relating to administrative affairs\nItem\nCourt\nPersons to be consulted\nThe Court\nThe Chief Justice\nThe Federal Circuit and Family\nCourt of Australia (Division 1)\nBoth:\n(a) the Chief Justice of the Federal\nCircuit and Family Court of\nAustralia (Division 1); and\n(b) the Chief Justice of the Court\nThe Federal Circuit and Family\nCourt of Australia (Division 2)\nBoth:\n(a) the Chief Judge of the Federal\nCircuit and Family Court of\nAustralia (Division 2); and\n(b) the Chief Justice of the Court",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-196-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-2"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-alleninterval-3"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-ltl-4"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-5"
        }
      ],
      "cml:integrityHash": "e438b40f2ad5536d50f576d35ca7459c5526050f8110ff96bd4a0d1097a7bfa1",
      "skos:note": "Consultation before imposing expenditure obligation"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-196",
      "@type": "cof:Section",
      "cof:title": "196 Subsection 18Z(5)",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Repeal the subsection, substitute:\n(5) When performing functions, or exercising powers, under this\nsection, before the Chief Executive Officer makes a decision that\nhas the effect of imposing an expenditure obligation relating to the\nadministrative affairs of a court mentioned in an item of the\nfollowing table:\n(a) the Chief Executive Officer must consult the person or\npersons mentioned in that item about the decision; and\n(b) either:\n(i) the person or persons mentioned in that item must\nconsent to the decision; or\n(ii) the Attorney-General must consent to the decision, after\nthe Attorney-General has consulted the person or\npersons mentioned in that item about the decision.\nConsultation about expenditure relating to administrative affairs\nItem\nCourt\nPersons to be consulted\nThe Court\nThe Chief Justice\nThe Federal Circuit and Family\nCourt of Australia (Division 1)\nBoth:\n(a) the Chief Justice of the Federal\nCircuit and Family Court of\nAustralia (Division 1); and\n(b) the Chief Justice of the Court\nThe Federal Circuit and Family\nCourt of Australia (Division 2)\nBoth:\n(a) the Chief Judge of the Federal\nCircuit and Family Court of\nAustralia (Division 2); and\n(b) the Chief Justice of the Court"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-196-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-196"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to consult",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Chief Executive Officer must consult the person or persons mentioned in that item about the decision.",
      "cml:conclusionText": "The Chief Executive Officer MUST consult the person or persons mentioned in that item about the decision."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to obtain consent from Attorney-General",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Either the person or persons mentioned in that item MUST consent to the decision, OR the Attorney-General MUST consent to the decision.",
      "cml:conclusionText": "The person or persons mentioned in that item MUST consent to the decision, OR the Attorney-General MUST consent to the decision."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Temporal interval for consultation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Before the Chief Executive Officer makes a decision that has the effect of imposing an expenditure obligation relating to the administrative affairs of a court mentioned in an item of the following table.",
      "cml:conclusionText": "The consultation must occur before the decision is made."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "RECURSIVE",
      "cml:logicSummary": "Recurring duty to consult",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "When performing functions, or exercising powers, under this section, the Chief Executive Officer MUST consult the person or persons mentioned in that item about the decision.",
      "cml:conclusionText": "The duty to consult is recurring and must be performed every time a decision is made."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-196-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Duty to obtain consent from Attorney-General",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Either the person or persons mentioned in that item MUST consent to the decision, OR the Attorney-General MUST consent to the decision.",
      "cml:conclusionText": "The Attorney-General MUST consent to the decision."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-197",
