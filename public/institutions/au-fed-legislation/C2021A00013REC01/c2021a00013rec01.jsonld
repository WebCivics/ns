    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-32ac-ss-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "32AC(10) Discretionary transfer of civil proceedings from the Federal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-32ac-ss-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
