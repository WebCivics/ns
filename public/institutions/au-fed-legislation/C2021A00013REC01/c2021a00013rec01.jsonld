    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-423",
      "@type": "cml:Concept",
      "skos:prefLabel": "423 Subsection 3(1) (paragraphs (j), (ja) and (k) of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-423"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.134",
      "values:originalText": "definition of Federal appeal)\nRepeal the paragraphs, substitute:\n(j) an appeal to the Full Court of the Federal Circuit and Family\nCourt of Australia (Division 1) from a judgment of the\nFederal Circuit and Family Court of Australia (Division 1)\nconstituted by a single Judge; or\n(ja) an appeal to the Federal Circuit and Family Court of\nAustralia (Division 1) from a judgment of the Federal Circuit\nand Family Court of Australia (Division 2); or\n(k) an appeal to the Federal Circuit and Family Court of\nAustralia (Division 1) from a judgment of a court of a State, a\ncourt of an internal Territory (including the Northern\nTerritory) or a court of Norfolk Island.",
      "skos:definition": "definition of Federal appeal)\nRepeal the paragraphs, substitute:\n(j) an appeal to the Full Court of the Federal Circuit and Family\nCourt of Australia (Division 1) from a judgment of the\nFederal Circuit and Family Court of Australia (Division 1)\nconstituted by a single Judge; or\n(ja) an appeal to the Federal Circuit and Family Court of\nAustralia (Division 1) from a judgment of the Federal Circuit\nand Family Court of Australia (Division 2); or\n(k) an appeal to the Federal Circuit and Family Court of\nAustralia (Division 1) from a judgment of a court of a State, a\ncourt of an internal Territory (including the Northern\nTerritory) or a court of Norfolk Island.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-423-norm"
        }
      ],
      "cml:integrityHash": "a4fa5b20b6fbb4e506d97baf0808a6872c4d177c61a7459d608fa01d4a367c25",
      "skos:note": "Repeal paragraphs, substitute with appeals to specific courts."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-423",
      "@type": "cof:Section",
      "cof:title": "423 Subsection 3(1) (paragraphs (j), (ja) and (k) of the",
      "values:kind": "section",
      "cof:pageNumber": 134,
      "values:originalText": "definition of Federal appeal)\nRepeal the paragraphs, substitute:\n(j) an appeal to the Full Court of the Federal Circuit and Family\nCourt of Australia (Division 1) from a judgment of the\nFederal Circuit and Family Court of Australia (Division 1)\nconstituted by a single Judge; or\n(ja) an appeal to the Federal Circuit and Family Court of\nAustralia (Division 1) from a judgment of the Federal Circuit\nand Family Court of Australia (Division 2); or\n(k) an appeal to the Federal Circuit and Family Court of\nAustralia (Division 1) from a judgment of a court of a State, a\ncourt of an internal Territory (including the Northern\nTerritory) or a court of Norfolk Island."
    },
