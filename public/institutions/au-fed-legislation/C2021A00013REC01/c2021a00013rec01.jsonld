    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-83",
      "@type": "cml:Concept",
      "skos:prefLabel": "83 Subsection 65D(3) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-83"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.34",
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nThe applicant may apply to the Federal Circuit and Family Court of\nAustralia (Division 1) for the application for the parenting order or for\nthe proceedings under Subdivision E of Division 13A of Part VII, or\nboth, to be transferred to the Federal Circuit and Family Court of\nAustralia (Division 2): see section 52 of the Federal Circuit and\nFamily Court of Australia Act 2021.\nNote 2:\nThe applicant may apply to the Federal Circuit and Family Court of\nAustralia (Division 2) for the application for the parenting order or for\nthe proceedings under Subdivision E of Division 13A of Part VII, or\nboth, to be transferred to the Federal Circuit and Family Court of\nAustralia (Division 1): see section 149 of the Federal Circuit and\nFamily Court of Australia Act 2021.\nNote 3:\nProceedings may also be transferred from the Federal Circuit and\nFamily Court of Australia (Division 2) to the Federal Circuit and\nFamily Court of Australia (Division 1) by order of the Chief Justice:\nsee section 51 of the Federal Circuit and Family Court of Australia\nAct 2021.",
      "skos:definition": "Repeal the note, substitute:\nNote 1:\nThe applicant may apply to the Federal Circuit and Family Court of\nAustralia (Division 1) for the application for the parenting order or for\nthe proceedings under Subdivision E of Division 13A of Part VII, or\nboth, to be transferred to the Federal Circuit and Family Court of\nAustralia (Division 2): see section 52 of the Federal Circuit and\nFamily Court of Australia Act 2021.\nNote 2:\nThe applicant may apply to the Federal Circuit and Family Court of\nAustralia (Division 2) for the application for the parenting order or for\nthe proceedings under Subdivision E of Division 13A of Part VII, or\nboth, to be transferred to the Federal Circuit and Family Court of\nAustralia (Division 1): see section 149 of the Federal Circuit and\nFamily Court of Australia Act 2021.\nNote 3:\nProceedings may also be transferred from the Federal Circuit and\nFamily Court of Australia (Division 2) to the Federal Circuit and\nFamily Court of Australia (Division 1) by order of the Chief Justice:\nsee section 51 of the Federal Circuit and Family Court of Australia\nAct 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-83-norm"
        }
      ],
      "cml:integrityHash": "7a911ded26d876822aa93f6d32e0a16e529c89b45ce7a4cbe44e36532c5b11a1",
      "skos:note": "Transfer of proceedings between Federal Circuit and Family Court divisions"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-83",
      "@type": "cof:Section",
      "cof:title": "83 Subsection 65D(3) (note)",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "Repeal the note, substitute:\nNote 1:\nThe applicant may apply to the Federal Circuit and Family Court of\nAustralia (Division 1) for the application for the parenting order or for\nthe proceedings under Subdivision E of Division 13A of Part VII, or\nboth, to be transferred to the Federal Circuit and Family Court of\nAustralia (Division 2): see section 52 of the Federal Circuit and\nFamily Court of Australia Act 2021.\nNote 2:\nThe applicant may apply to the Federal Circuit and Family Court of\nAustralia (Division 2) for the application for the parenting order or for\nthe proceedings under Subdivision E of Division 13A of Part VII, or\nboth, to be transferred to the Federal Circuit and Family Court of\nAustralia (Division 1): see section 149 of the Federal Circuit and\nFamily Court of Australia Act 2021.\nNote 3:\nProceedings may also be transferred from the Federal Circuit and\nFamily Court of Australia (Division 2) to the Federal Circuit and\nFamily Court of Australia (Division 1) by order of the Chief Justice:\nsee section 51 of the Federal Circuit and Family Court of Australia\nAct 2021."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-83-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
