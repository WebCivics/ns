          "@id": "concept:c2021a00013rec01-sch-3-sec-1-norm"
        }
      ],
      "cml:integrityHash": "93da753d8fa29afea13af40e835466a6b60483248891d30a3f7124242d195f51",
      "skos:note": "Repeal the Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-3-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 The whole of the Act",
      "values:kind": "section",
      "cof:pageNumber": 198,
      "values:originalText": "Repeal the Act.\n\nRepeal of the Federal Circuit Court of Australia Act 1999  Schedule 3\nSaving and transitional provisions  Part 2\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
