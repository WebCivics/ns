    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-231",
      "@type": "cml:Concept",
      "skos:prefLabel": "231 Arrangements with other courts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-231"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.65",
      "values:originalText": "An arrangement made under subsection 38BAA(1) of the Family Law\nAct 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 79(1) of the Federal Circuit and Family Court of Australia\nAct 2021.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "skos:definition": "An arrangement made under subsection 38BAA(1) of the Family Law\nAct 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 79(1) of the Federal Circuit and Family Court of Australia\nAct 2021.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-231-norm"
        }
      ],
      "cml:integrityHash": "1f9874e844322ba9e5ba14a6a72e6e5a9ebe2f101896760bf612198070398107",
      "skos:note": "Continuation of arrangements with other courts"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-231",
      "@type": "cof:Section",
      "cof:title": "231 Arrangements with other courts",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "An arrangement made under subsection 38BAA(1) of the Family Law\nAct 1975 and in force immediately before the commencement day\ncontinues in force (and may be dealt with) as if it had been made under\nsubsection 79(1) of the Federal Circuit and Family Court of Australia\nAct 2021.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia"
    },
