          "@id": "concept:c2021a00013rec01-sch-1-sec-219-norm"
        }
      ],
      "cml:integrityHash": "96e46ea12a7a556a4c413d67062177a340a2394b6e62e27010bac3181be71c90",
      "skos:note": "Repeal subsection, substitute with new jurisdiction for Federal Circuit and Family Court of Australia"
    },
    {
