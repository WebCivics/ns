    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-261",
      "@type": "cml:Concept",
      "skos:prefLabel": "261 Subsection 82(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-261"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.72",
      "values:originalText": "Repeal the subsection, substitute:\n(2) The Chief Justice may appoint committees consisting of Judges, or\nof Judges and other persons, for the purpose of:\n(a) advising the Judges of the Federal Circuit and Family Court\nof Australia (Division 1) in relation to the making of Rules of\nCourt; or\n(b) advising the Chief Justice in relation to the management of\nthe administrative affairs of the Federal Circuit and Family\nCourt of Australia (Division 1).",
      "skos:definition": "Repeal the subsection, substitute:\n(2) The Chief Justice may appoint committees consisting of Judges, or\nof Judges and other persons, for the purpose of:\n(a) advising the Judges of the Federal Circuit and Family Court\nof Australia (Division 1) in relation to the making of Rules of\nCourt; or\n(b) advising the Chief Justice in relation to the management of\nthe administrative affairs of the Federal Circuit and Family\nCourt of Australia (Division 1).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-261-norm"
        }
      ],
      "cml:integrityHash": "60f816d86d7a4abc403f4fc0aa155ac9e37ba59f03627b16edfb4ec312cf92f7",
      "skos:note": "Repeal subsection, substitute with new appointment rules for the Chief Justice."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-261",
      "@type": "cof:Section",
      "cof:title": "261 Subsection 82(2)",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "Repeal the subsection, substitute:\n(2) The Chief Justice may appoint committees consisting of Judges, or\nof Judges and other persons, for the purpose of:\n(a) advising the Judges of the Federal Circuit and Family Court\nof Australia (Division 1) in relation to the making of Rules of\nCourt; or\n(b) advising the Chief Justice in relation to the management of\nthe administrative affairs of the Federal Circuit and Family\nCourt of Australia (Division 1)."
    },
