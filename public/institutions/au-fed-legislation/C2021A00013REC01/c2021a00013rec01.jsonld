      },
      "dc:source": "c2021a00013rec01.pdf, p.60",
      "values:originalText": "(10) This section does not apply to proceedings of a kind specified in\nthe regulations.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "skos:definition": "(10) This section does not apply to proceedings of a kind specified in\nthe regulations.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-32ac"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-32ac-ss-10-norm"
        }
      ],
      "cml:integrityHash": "fa4eb934beb001b7ed74f01bcc8fc598216ac9030e2d848c14d086ec62939f72",
      "skos:note": "Section does not apply to proceedings of a kind specified in the regulations."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-32ac-ss-10",
      "@type": "cof:Section",
      "cof:title": "32AC(10) Discretionary transfer of civil proceedings from the Federal",
      "values:kind": "subsection",
      "cof:pageNumber": 60,
      "values:originalText": "(10) This section does not apply to proceedings of a kind specified in\nthe regulations.\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-32ac-ss-10-norm",
      "@type": "values:Obligation",
      "cml:modality": {
