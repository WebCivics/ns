      "dc:source": "c2021a00013rec01.pdf, p.164",
      "values:originalText": "Repeal the note, substitute:\nNote 2:\nFor transfers from the Federal Court to the Federal Circuit and Family\nCourt of Australia (Division 2): see section 32AB of the Federal\nCourt of Australia Act 1976.\nNote 3:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 2) to the Federal Court: see section 153 of the Federal\nCircuit and Family Court of Australia Act 2021 and section 32AC of\nthe Federal Court of Australia Act 1976.",
      "skos:definition": "Repeal the note, substitute:\nNote 2:\nFor transfers from the Federal Court to the Federal Circuit and Family\nCourt of Australia (Division 2): see section 32AB of the Federal\nCourt of Australia Act 1976.\nNote 3:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 2) to the Federal Court: see section 153 of the Federal\nCircuit and Family Court of Australia Act 2021 and section 32AC of\nthe Federal Court of Australia Act 1976.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-610-norm"
        }
      ],
      "cml:integrityHash": "d3715b18c1814bbd3688e1b9a5b38385670633ae0b071403a26d1dc712bb6574",
      "skos:note": "Repeal note and substitute with new references."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-610",
      "@type": "cof:Section",
      "cof:title": "610 Subsection 191(2) (note 2)",
      "values:kind": "section",
      "cof:pageNumber": 164,
      "values:originalText": "Repeal the note, substitute:\nNote 2:\nFor transfers from the Federal Court to the Federal Circuit and Family\nCourt of Australia (Division 2): see section 32AB of the Federal\nCourt of Australia Act 1976.\nNote 3:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 2) to the Federal Court: see section 153 of the Federal\nCircuit and Family Court of Australia Act 2021 and section 32AC of\nthe Federal Court of Australia Act 1976."
    },
