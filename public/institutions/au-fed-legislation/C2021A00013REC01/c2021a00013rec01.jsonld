      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-98-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Duties and powers",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The following persons...",
      "cml:conclusionText": "have all of the duties and powers that a court has under this Division:"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-99",
      "@type": "cml:Concept",
      "skos:prefLabel": "99 Subsection 69ZR(3)",
      "cml:realizedBy": {
