    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-18pb",
      "@type": "cml:Concept",
      "skos:prefLabel": "18PB Deputy Marshals",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-18pb"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.51",
      "values:originalText": "A Deputy Marshal of the Court may, subject to any directions of\nthe Marshal of the Court, exercise or perform any of the powers or\nfunctions of the Marshal.",
      "skos:definition": "A Deputy Marshal of the Court may, subject to any directions of\nthe Marshal of the Court, exercise or perform any of the powers or\nfunctions of the Marshal.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-18pb-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-18pb-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "15e5237b5511cdfe92cceef0b0db7b167c0146e980b76b2cbf4f5b53eae45f97",
      "skos:note": "Deputy Marshals may exercise or perform Marshal's powers and functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-18pb",
      "@type": "cof:Section",
      "cof:title": "18PB Deputy Marshals",
      "values:kind": "section",
      "cof:pageNumber": 51,
      "values:originalText": "A Deputy Marshal of the Court may, subject to any directions of\nthe Marshal of the Court, exercise or perform any of the powers or\nfunctions of the Marshal."
    },
