    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-233",
      "@type": "cml:Concept",
      "skos:prefLabel": "233 Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-233"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.66",
      "values:originalText": "An instrument made under section 38W of the Family Law Act 1975\nand in force immediately before the commencement day continues in\nforce (and may be dealt with) as if it had been made under section 108\nof the Federal Circuit and Family Court of Australia Act 2021.",
      "skos:definition": "An instrument made under section 38W of the Family Law Act 1975\nand in force immediately before the commencement day continues in\nforce (and may be dealt with) as if it had been made under section 108\nof the Federal Circuit and Family Court of Australia Act 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-233-norm"
        }
      ],
      "cml:integrityHash": "d51f1a7e7c94113556405b866fc98b05c0aa9151f56b1c7a7e88fa57b4853eac",
      "skos:note": "Continuation of certain instruments under section 38W Family Law Act 1975"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-233",
      "@type": "cof:Section",
      "cof:title": "233 Delegation",
      "values:kind": "section",
      "cof:pageNumber": 66,
      "values:originalText": "An instrument made under section 38W of the Family Law Act 1975\nand in force immediately before the commencement day continues in\nforce (and may be dealt with) as if it had been made under section 108\nof the Federal Circuit and Family Court of Australia Act 2021."
    },
    {
