          "@id": "concept:c2021a00013rec01-sch-1-sec-1-norm"
        }
      ],
      "cml:integrityHash": "5fdfde5e48c21837f94a1298bb8db7ae2cdfc2954cfd6eab03abb69a9e0cea57",
      "skos:note": "Substitute applicable Rules of Court"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 4(1)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Omit “, the standard Rules of Court and the related Federal Circuit\nCourt Rules, unless the contrary intention appears”, substitute “and the\napplicable Rules of Court”."
    },
