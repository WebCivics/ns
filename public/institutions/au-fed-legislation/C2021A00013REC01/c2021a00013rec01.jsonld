    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-101",
      "@type": "cml:Concept",
      "skos:prefLabel": "101 Section 46PSA (note 2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-101"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
