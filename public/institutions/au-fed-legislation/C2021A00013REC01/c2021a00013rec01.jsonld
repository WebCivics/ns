    {
      "@id": "concept:c2021a00013rec01-sch-4-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Subparagraph 4(8)(b)(ii) of Schedule 2",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-4-sec-3"
      },
      "cml:curationStatus": {
