    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-646",
      "@type": "cml:Concept",
      "skos:prefLabel": "646 Subsection 3(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-646"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.169",
      "values:originalText": "Insert:\nchief executive officer, in relation to a court or tribunal, means the\nperson holding the office, or performing the duties, of:\n(a) in relation to the High Court—the Chief Executive and\nPrincipal Registrar of the Court; or\n(b) in relation to the Federal Court of Australia—the Chief\nExecutive Officer and Principal Registrar of the Court; or\n(c) in relation to the Federal Circuit and Family Court of\nAustralia (Division 1)—the Chief Executive Officer and\nPrincipal Registrar of the Federal Circuit and Family Court of\nAustralia (Division 1); or\n(d) in relation to the Federal Circuit and Family Court of\nAustralia (Division 2)—the Chief Executive Officer and\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nPrincipal Registrar of the Federal Circuit and Family Court of\nAustralia (Division 1); or\n(e) in relation to the Administrative Appeals Tribunal—the\nRegistrar of the Tribunal; or\n(f) in relation to a court or tribunal declared by the regulations—\nthe office declared by those regulations to be the office of the\nchief executive officer of the court or tribunal for the\npurposes of this Act; or\n(g) an office prescribed by the regulations in lieu of an office\nreferred to in paragraph (a), (b), (c), (d) or (e).",
      "skos:definition": "Insert:\nchief executive officer, in relation to a court or tribunal, means the\nperson holding the office, or performing the duties, of:\n(a) in relation to the High Court—the Chief Executive and\nPrincipal Registrar of the Court; or\n(b) in relation to the Federal Court of Australia—the Chief\nExecutive Officer and Principal Registrar of the Court; or\n(c) in relation to the Federal Circuit and Family Court of\nAustralia (Division 1)—the Chief Executive Officer and\nPrincipal Registrar of the Federal Circuit and Family Court of\nAustralia (Division 1); or\n(d) in relation to the Federal Circuit and Family Court of\nAustralia (Division 2)—the Chief Executive Officer and\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nPrincipal Registrar of the Federal Circuit and Family Court of\nAustralia (Division 1); or\n(e) in relation to the Administrative Appeals Tribunal—the\nRegistrar of the Tribunal; or\n(f) in relation to a court or tribunal declared by the regulations—\nthe office declared by those regulations to be the office of the\nchief executive officer of the court or tribunal for the\npurposes of this Act; or\n(g) an office prescribed by the regulations in lieu of an office\nreferred to in paragraph (a), (b), (c), (d) or (e).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-646-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-646-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-646-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "a557b47169832fdbbaf7854dbcf1b8170ee43d3c47c32e3ba202814e72ea2cbf",
      "skos:note": "Defines chief executive officer in relation to courts and tribunals."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-646",
      "@type": "cof:Section",
      "cof:title": "646 Subsection 3(1)",
      "values:kind": "section",
      "cof:pageNumber": 169,
      "values:originalText": "Insert:\nchief executive officer, in relation to a court or tribunal, means the\nperson holding the office, or performing the duties, of:\n(a) in relation to the High Court—the Chief Executive and\nPrincipal Registrar of the Court; or\n(b) in relation to the Federal Court of Australia—the Chief\nExecutive Officer and Principal Registrar of the Court; or\n(c) in relation to the Federal Circuit and Family Court of\nAustralia (Division 1)—the Chief Executive Officer and\nPrincipal Registrar of the Federal Circuit and Family Court of\nAustralia (Division 1); or\n(d) in relation to the Federal Circuit and Family Court of\nAustralia (Division 2)—the Chief Executive Officer and\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nPrincipal Registrar of the Federal Circuit and Family Court of\nAustralia (Division 1); or\n(e) in relation to the Administrative Appeals Tribunal—the\nRegistrar of the Tribunal; or\n(f) in relation to a court or tribunal declared by the regulations—\nthe office declared by those regulations to be the office of the\nchief executive officer of the court or tribunal for the\npurposes of this Act; or\n(g) an office prescribed by the regulations in lieu of an office\nreferred to in paragraph (a), (b), (c), (d) or (e)."
    },
