    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Matters before a Judge or Full Court of the Family Court of",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-28"
      },
      "cml:curationStatus": {
