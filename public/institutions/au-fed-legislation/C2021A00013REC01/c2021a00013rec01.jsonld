    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-47e",
      "@type": "cml:Concept",
      "skos:prefLabel": "47E Regulations to be sole source of certain appellate jurisdiction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-47e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.32",
      "values:originalText": "Despite the provisions of this Division, a court has appellate\njurisdiction in relation to a matter arising under regulations made\nfor the purposes of section 111C only as provided by those\nregulations.",
      "skos:definition": "Despite the provisions of this Division, a court has appellate\njurisdiction in relation to a matter arising under regulations made\nfor the purposes of section 111C only as provided by those\nregulations.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-47e-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-47e-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-47e-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-47e-logic-ltl-3"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-47e-logic-diffusion-4"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-47e-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "075d4baa90aa8c0b718ee86cb9d9c86e2d55d9c65dd939617541d73c99fb5ad4",
      "skos:note": "Court has appellate jurisdiction in relation to matters arising under regulations made for the purposes of section 111C."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-47e",
      "@type": "cof:Section",
      "cof:title": "47E Regulations to be sole source of certain appellate jurisdiction",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "Despite the provisions of this Division, a court has appellate\njurisdiction in relation to a matter arising under regulations made\nfor the purposes of section 111C only as provided by those\nregulations."
    },
