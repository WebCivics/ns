    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-786",
      "@type": "cml:Concept",
      "skos:prefLabel": "786 Subsection 194(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-786"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.193",
      "values:originalText": "Repeal the subsection (including the note), substitute:\n(3) This section does not apply in relation to a transfer of proceedings\nbetween the Federal Court and the Federal Circuit and Family\nCourt of Australia (Division 2).\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153 of\nthe Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976.",
      "skos:definition": "Repeal the subsection (including the note), substitute:\n(3) This section does not apply in relation to a transfer of proceedings\nbetween the Federal Court and the Federal Circuit and Family\nCourt of Australia (Division 2).\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153 of\nthe Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-786-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-786-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-786-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "7eb850923402783b45074c3e4f4369d2c76101ccb158e3a650a850f9bb1698be",
      "skos:note": "Does not apply in relation to a transfer of proceedings between the Federal Court and the Federal Circuit and Family Court of Australia (Division 2)."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-786",
      "@type": "cof:Section",
      "cof:title": "786 Subsection 194(3)",
      "values:kind": "section",
      "cof:pageNumber": 193,
      "values:originalText": "Repeal the subsection (including the note), substitute:\n(3) This section does not apply in relation to a transfer of proceedings\nbetween the Federal Court and the Federal Circuit and Family\nCourt of Australia (Division 2).\nNote 1:\nFor transfers of proceedings from the Federal Circuit and Family\nCourt of Australia (Division 2) to the Federal Court, see section 153 of\nthe Federal Circuit and Family Court of Australia Act 2021 and\nsection 32AC of the Federal Court of Australia Act 1976.\nNote 2:\nFor transfers of proceedings from the Federal Court to the Federal\nCircuit and Family Court of Australia (Division 2), see section 32AB\nof the Federal Court of Australia Act 1976."
    },
