    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-201-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must consult and obtain consent before spending",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
