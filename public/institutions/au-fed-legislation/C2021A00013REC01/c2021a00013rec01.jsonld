        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "32AD(3) Confirmation of civil proceedings transferred from the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-32ad-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.62",
      "values:originalText": "(3) The Court has jurisdiction in a matter that:\n(a) is the subject of a proceeding transferred to the Court by the\nFederal Circuit and Family Court of Australia (Division 2);\nand\n(b) is a matter in which the Court does not have jurisdiction apart\nfrom this subsection.\nTo avoid doubt, the Court’s jurisdiction under this subsection is not\nsubject to limits set by another provision.",
      "skos:definition": "(3) The Court has jurisdiction in a matter that:\n(a) is the subject of a proceeding transferred to the Court by the\nFederal Circuit and Family Court of Australia (Division 2);\nand\n(b) is a matter in which the Court does not have jurisdiction apart\nfrom this subsection.\nTo avoid doubt, the Court’s jurisdiction under this subsection is not\nsubject to limits set by another provision.",
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-32ad"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-3-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-3-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-3-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "fed5dad9e04c050f651f7452253a2cb0f07147909e02448d2d958423b6232e4f",
      "skos:note": "Court has jurisdiction in a matter transferred from the Federal Circuit and Family Court of Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-32ad-ss-3",
      "@type": "cof:Section",
      "cof:title": "32AD(3) Confirmation of civil proceedings transferred from the",
      "values:kind": "subsection",
      "cof:pageNumber": 62,
      "values:originalText": "(3) The Court has jurisdiction in a matter that:\n(a) is the subject of a proceeding transferred to the Court by the\nFederal Circuit and Family Court of Australia (Division 2);\nand\n(b) is a matter in which the Court does not have jurisdiction apart\nfrom this subsection.\nTo avoid doubt, the Court’s jurisdiction under this subsection is not\nsubject to limits set by another provision."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasJurisdiction",
      "cml:logicSummary": "Court has jurisdiction in a matter.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The Court has jurisdiction in a matter that:"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "withinTemporalInterval",
      "cml:logicSummary": "Matter is within a temporal interval.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) is a matter in which the Court does not have jurisdiction apart from this subsection."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "32AD(4) Confirmation of civil proceedings transferred from the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-32ad-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.62",
      "values:originalText": "(4) An appeal does not lie from a decision of the Court in relation to an\norder made under subsection (1) confirming the transfer of a\nproceeding.",
      "skos:definition": "(4) An appeal does not lie from a decision of the Court in relation to an\norder made under subsection (1) confirming the transfer of a\nproceeding.",
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-32ad"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-4-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-32ad-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "edfd15cb83642e3b39d7ae98db160ad287c7c8950c6f15f631904c2fef343bff",
      "skos:note": "No appeal from a decision confirming the transfer of proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-32ad-ss-4",
      "@type": "cof:Section",
      "cof:title": "32AD(4) Confirmation of civil proceedings transferred from the",
      "values:kind": "subsection",
      "cof:pageNumber": 62,
      "values:originalText": "(4) An appeal does not lie from a decision of the Court in relation to an\norder made under subsection (1) confirming the transfer of a\nproceeding."
    },
