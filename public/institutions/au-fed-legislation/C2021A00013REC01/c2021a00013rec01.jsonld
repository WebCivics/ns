    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Subsection 4(1) (definition of Registrar)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
