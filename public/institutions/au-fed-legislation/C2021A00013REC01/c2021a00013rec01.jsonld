    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-35",
      "@type": "cml:Concept",
      "skos:prefLabel": "35 Application of case management provisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-35"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.236",
      "values:originalText": "Division 4 of Part 5 of Chapter 3 of the Federal Circuit and Family\nCourt of Australia Act 2021 (Case management) applies in relation to:\n(a) a proceeding commenced before the commencement day that\nwill come before the Federal Circuit and Family Court of\nAustralia (Division 1) because of an item of this Part; and\n(b) a proceeding commencing on or after the commencement day\nthat comes before the Federal Circuit and Family Court of\nAustralia (Division 1) because of an item of this Part.\n\nTransitional provisions  Schedule 5\nMiscellaneous  Part 5\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "Division 4 of Part 5 of Chapter 3 of the Federal Circuit and Family\nCourt of Australia Act 2021 (Case management) applies in relation to:\n(a) a proceeding commenced before the commencement day that\nwill come before the Federal Circuit and Family Court of\nAustralia (Division 1) because of an item of this Part; and\n(b) a proceeding commencing on or after the commencement day\nthat comes before the Federal Circuit and Family Court of\nAustralia (Division 1) because of an item of this Part.\n\nTransitional provisions  Schedule 5\nMiscellaneous  Part 5\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-35-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-35-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3070fc383d73f1faf2c0a3e33f10d415c3bc8acfd2bc18b2922942b27796a552",
      "skos:note": "Division 4 of Part 5 of Chapter 3 applies to proceedings before the Federal Circuit and Family Court of Australia (Division 1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-35",
      "@type": "cof:Section",
      "cof:title": "35 Application of case management provisions",
      "values:kind": "section",
      "cof:pageNumber": 236,
      "values:originalText": "Division 4 of Part 5 of Chapter 3 of the Federal Circuit and Family\nCourt of Australia Act 2021 (Case management) applies in relation to:\n(a) a proceeding commenced before the commencement day that\nwill come before the Federal Circuit and Family Court of\nAustralia (Division 1) because of an item of this Part; and\n(b) a proceeding commencing on or after the commencement day\nthat comes before the Federal Circuit and Family Court of\nAustralia (Division 1) because of an item of this Part.\n\nTransitional provisions  Schedule 5\nMiscellaneous  Part 5\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
