      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to make APS employees available",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-18zg",
      "@type": "cml:Concept",
      "skos:prefLabel": "18ZG Delegation of powers etc. under the Public Service Act 1999",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-18zg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.56",
      "values:originalText": "Section 78 of the Public Service Act 1999 applies, in relation to the\nadministrative affairs of the Federal Circuit and Family Court of\nAustralia, as if the reference in subsection (7) to another person\nwere a reference to the Chief Executive Officer of the Federal\nCircuit and Family Court of Australia.",
      "skos:definition": "Section 78 of the Public Service Act 1999 applies, in relation to the\nadministrative affairs of the Federal Circuit and Family Court of\nAustralia, as if the reference in subsection (7) to another person\nwere a reference to the Chief Executive Officer of the Federal\nCircuit and Family Court of Australia.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-18zg-norm"
        }
      ],
      "cml:integrityHash": "46bebf58b1a0db23b71c34de858b84c4073847a77cc50b9b6e42ed3e069c9ead",
      "skos:note": "Delegation of powers under the Public Service Act 1999"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-18zg",
      "@type": "cof:Section",
      "cof:title": "18ZG Delegation of powers etc. under the Public Service Act 1999",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "Section 78 of the Public Service Act 1999 applies, in relation to the\nadministrative affairs of the Federal Circuit and Family Court of\nAustralia, as if the reference in subsection (7) to another person\nwere a reference to the Chief Executive Officer of the Federal\nCircuit and Family Court of Australia."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-18zg-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-18zg"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-204",
      "@type": "cml:Concept",
      "skos:prefLabel": "204 Paragraphs 18ZH(1)(b) and (c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-204"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.56",
      "values:originalText": "Repeal the paragraphs, substitute:\n(b) the officers of the Federal Circuit and Family Court of\nAustralia (Division 1) referred to in paragraphs 103(1)(a) to\n(e) of the Federal Circuit and Family Court of Australia Act\n2021;\n(c) the officers of the Federal Circuit and Family Court of\nAustralia (Division 2) referred to in paragraphs 259(1)(a) to\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(g) of the Federal Circuit and Family Court of Australia Act\n2021;",
      "skos:definition": "Repeal the paragraphs, substitute:\n(b) the officers of the Federal Circuit and Family Court of\nAustralia (Division 1) referred to in paragraphs 103(1)(a) to\n(e) of the Federal Circuit and Family Court of Australia Act\n2021;\n(c) the officers of the Federal Circuit and Family Court of\nAustralia (Division 2) referred to in paragraphs 259(1)(a) to\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(g) of the Federal Circuit and Family Court of Australia Act\n2021;",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-204-norm"
        }
      ],
      "cml:integrityHash": "b6db45ea0c6212fbe45f951f975340d7de55ff4ac32d4144003e9ee5b5f4b0d5",
      "skos:note": "Repeal and substitute certain officers of the Federal Circuit and Family Court of Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-204",
      "@type": "cof:Section",
      "cof:title": "204 Paragraphs 18ZH(1)(b) and (c)",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "Repeal the paragraphs, substitute:\n(b) the officers of the Federal Circuit and Family Court of\nAustralia (Division 1) referred to in paragraphs 103(1)(a) to\n(e) of the Federal Circuit and Family Court of Australia Act\n2021;\n(c) the officers of the Federal Circuit and Family Court of\nAustralia (Division 2) referred to in paragraphs 259(1)(a) to\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\n(g) of the Federal Circuit and Family Court of Australia Act\n2021;"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-204-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-204"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-205",
      "@type": "cml:Concept",
      "skos:prefLabel": "205 Subsections 18ZH(2) and (3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-205"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.57",
      "values:originalText": "Repeal the subsections, substitute:\n(2) The Chief Executive Officer may delegate the Chief Executive\nOfficer’s powers under paragraph (1)(b) or (c) to appoint any or all\nof the officers to the Chief Executive Officer of the Federal Circuit\nand Family Court of Australia.\n(3) The appointment of a person to more than one office, or an office\nor offices of more than one court, mentioned in subsection (1) may\nbe made in a single instrument.",
      "skos:definition": "Repeal the subsections, substitute:\n(2) The Chief Executive Officer may delegate the Chief Executive\nOfficer’s powers under paragraph (1)(b) or (c) to appoint any or all\nof the officers to the Chief Executive Officer of the Federal Circuit\nand Family Court of Australia.\n(3) The appointment of a person to more than one office, or an office\nor offices of more than one court, mentioned in subsection (1) may\nbe made in a single instrument.",
      "cml:hasPart": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-205-ss-2"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-205-ss-3"
        }
      ],
      "cml:integrityHash": "45006b563b2fa2182b7ea81cca2aac16faa404d7946d1c0f51f91fbff6cf069d"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-205",
      "@type": "cof:Section",
      "cof:title": "205 Subsections 18ZH(2) and (3)",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "Repeal the subsections, substitute:\n(2) The Chief Executive Officer may delegate the Chief Executive\nOfficer’s powers under paragraph (1)(b) or (c) to appoint any or all\nof the officers to the Chief Executive Officer of the Federal Circuit\nand Family Court of Australia.\n(3) The appointment of a person to more than one office, or an office\nor offices of more than one court, mentioned in subsection (1) may\nbe made in a single instrument."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-205-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "205(2) Subsections 18ZH(2) and (3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-205-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
