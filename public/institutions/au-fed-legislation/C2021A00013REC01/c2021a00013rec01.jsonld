    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-229",
      "@type": "cml:Concept",
      "skos:prefLabel": "229 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-229"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.65",
      "values:originalText": "The amendments of the Family Law Act 1975 and the Federal Court of\nAustralia Act 1976 made by this Schedule apply in relation to a\nproceeding commenced before, on or after the commencement day.",
      "skos:definition": "The amendments of the Family Law Act 1975 and the Federal Court of\nAustralia Act 1976 made by this Schedule apply in relation to a\nproceeding commenced before, on or after the commencement day.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-229-norm"
        }
      ],
      "cml:integrityHash": "b327ac55a0472e4bb9502e6644e4c9a95795abc62d99c33c4d05d7d24a9818e7",
      "skos:note": "Amendments apply to proceedings commenced before, on or after commencement day."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-229",
      "@type": "cof:Section",
      "cof:title": "229 Application",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "The amendments of the Family Law Act 1975 and the Federal Court of\nAustralia Act 1976 made by this Schedule apply in relation to a\nproceeding commenced before, on or after the commencement day."
    },
