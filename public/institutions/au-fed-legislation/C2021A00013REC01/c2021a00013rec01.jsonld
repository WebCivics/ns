    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-315",
      "@type": "cml:Concept",
      "skos:prefLabel": "315 Section 23",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-315"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.120",
      "values:originalText": "Omit:\n•\nProceedings for the recovery of penalties are to be instituted in\nthe Federal Court or the Federal Circuit Court.\nsubstitute:\n•\nProceedings for the recovery of penalties are to be instituted in\nthe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2).\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "Omit:\n•\nProceedings for the recovery of penalties are to be instituted in\nthe Federal Court or the Federal Circuit Court.\nsubstitute:\n•\nProceedings for the recovery of penalties are to be instituted in\nthe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2).\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-315-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-315-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "786ae2916c8fea15d249e2cef1188f579a8af898d7c0bc1ae28d6e6d97b5b8c5",
      "skos:note": "Omit proceedings for recovery of penalties in Federal Court or Federal Circuit Court."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-315",
      "@type": "cof:Section",
      "cof:title": "315 Section 23",
      "values:kind": "section",
      "cof:pageNumber": 120,
      "values:originalText": "Omit:\n•\nProceedings for the recovery of penalties are to be instituted in\nthe Federal Court or the Federal Circuit Court.\nsubstitute:\n•\nProceedings for the recovery of penalties are to be instituted in\nthe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2).\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
