    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-111",
      "@type": "cml:Concept",
      "skos:prefLabel": "111 Subsection 97(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-111"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.38",
      "values:originalText": "Omit all the words after “heard”, substitute:\nby:\n(a) in the case of the Federal Circuit and Family Court of\nAustralia (Division 1)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court, sitting in\nChambers; and\n(b) in the case of the Federal Circuit and Family Court of\nAustralia (Division 2)—a Judge, the Chief Executive Officer,\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nor a Senior Registrar or Registrar of the Court, sitting in\nChambers; and\n(c) in any other case—a Judge, Registrar or magistrate sitting in\nChambers.",
      "skos:definition": "Omit all the words after “heard”, substitute:\nby:\n(a) in the case of the Federal Circuit and Family Court of\nAustralia (Division 1)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court, sitting in\nChambers; and\n(b) in the case of the Federal Circuit and Family Court of\nAustralia (Division 2)—a Judge, the Chief Executive Officer,\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nor a Senior Registrar or Registrar of the Court, sitting in\nChambers; and\n(c) in any other case—a Judge, Registrar or magistrate sitting in\nChambers.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-111-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-111-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "85486a3bcade71c556facb446b264dabd3f62389605e9703d50050f8cbd889df",
      "skos:note": "Substitute judges for certain court officials"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-111",
      "@type": "cof:Section",
      "cof:title": "111 Subsection 97(1A)",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Omit all the words after “heard”, substitute:\nby:\n(a) in the case of the Federal Circuit and Family Court of\nAustralia (Division 1)—a Judge, the Chief Executive Officer,\nor a Senior Registrar or Registrar of the Court, sitting in\nChambers; and\n(b) in the case of the Federal Circuit and Family Court of\nAustralia (Division 2)—a Judge, the Chief Executive Officer,\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nAmendments  Part 1\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nor a Senior Registrar or Registrar of the Court, sitting in\nChambers; and\n(c) in any other case—a Judge, Registrar or magistrate sitting in\nChambers."
    },
