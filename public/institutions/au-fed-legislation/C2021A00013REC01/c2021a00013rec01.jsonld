    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-18zc",
      "@type": "cml:Concept",
      "skos:prefLabel": "18ZC Delegation of powers etc. under the finance law",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-18zc"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.53",
      "values:originalText": "Section 110 of the Public Governance, Performance and\nAccountability Act 2013 applies as if:\n(a) for the delegation of a matter that relates to the administrative\naffairs of the Federal Circuit and Family Court of Australia\n(Division 1)—a reference to an official were a reference to:\n(i) the Chief Executive Officer of the Federal Circuit and\nFamily Court of Australia; or\n(ii) the holder of an office or position referred to in\nsubparagraph 18ZB(a)(v) or (vi) of this Act, being an\noffice or position that, at the time the delegation is\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "skos:definition": "Section 110 of the Public Governance, Performance and\nAccountability Act 2013 applies as if:\n(a) for the delegation of a matter that relates to the administrative\naffairs of the Federal Circuit and Family Court of Australia\n(Division 1)—a reference to an official were a reference to:\n(i) the Chief Executive Officer of the Federal Circuit and\nFamily Court of Australia; or\n(ii) the holder of an office or position referred to in\nsubparagraph 18ZB(a)(v) or (vi) of this Act, being an\noffice or position that, at the time the delegation is\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-18zc-norm"
        }
      ],
      "cml:integrityHash": "14c7c21a375fcee5386c39fb2b79ae67e537ee6a94efa95fd7ddf2be6366eae2",
      "skos:note": "Delegation of powers under the finance law"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-18zc",
      "@type": "cof:Section",
      "cof:title": "18ZC Delegation of powers etc. under the finance law",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "Section 110 of the Public Governance, Performance and\nAccountability Act 2013 applies as if:\n(a) for the delegation of a matter that relates to the administrative\naffairs of the Federal Circuit and Family Court of Australia\n(Division 1)—a reference to an official were a reference to:\n(i) the Chief Executive Officer of the Federal Circuit and\nFamily Court of Australia; or\n(ii) the holder of an office or position referred to in\nsubparagraph 18ZB(a)(v) or (vi) of this Act, being an\noffice or position that, at the time the delegation is\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-18zc-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-18zc"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-200",
      "@type": "cml:Concept",
      "skos:prefLabel": "200 Subparagraphs 18ZD(1)(b)(ii) to (iv)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-200"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.54",
      "values:originalText": "Repeal the subparagraphs, substitute:\n(ii) the administrative affairs of the Federal Circuit and\nFamily Court of Australia (Division 1); or\n(iii) the administrative affairs of the Federal Circuit and\nFamily Court of Australia (Division 2); or\n(iv) the corporate services of the Court, the Federal Circuit\nand Family Court of Australia (Division 1) and the\nFederal Circuit and Family Court of Australia\n(Division 2), as referred to in subsection 18Z(1); and",
      "skos:definition": "Repeal the subparagraphs, substitute:\n(ii) the administrative affairs of the Federal Circuit and\nFamily Court of Australia (Division 1); or\n(iii) the administrative affairs of the Federal Circuit and\nFamily Court of Australia (Division 2); or\n(iv) the corporate services of the Court, the Federal Circuit\nand Family Court of Australia (Division 1) and the\nFederal Circuit and Family Court of Australia\n(Division 2), as referred to in subsection 18Z(1); and",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-200-norm"
        }
      ],
      "cml:integrityHash": "af872616cd2ff2541f1b8e80a65b5ab73f02c13f52efb1669ebd50bb500788d9",
      "skos:note": "Repeal and substitute certain administrative affairs"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-200",
      "@type": "cof:Section",
      "cof:title": "200 Subparagraphs 18ZD(1)(b)(ii) to (iv)",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "Repeal the subparagraphs, substitute:\n(ii) the administrative affairs of the Federal Circuit and\nFamily Court of Australia (Division 1); or\n(iii) the administrative affairs of the Federal Circuit and\nFamily Court of Australia (Division 2); or\n(iv) the corporate services of the Court, the Federal Circuit\nand Family Court of Australia (Division 1) and the\nFederal Circuit and Family Court of Australia\n(Division 2), as referred to in subsection 18Z(1); and"
    },
    {
