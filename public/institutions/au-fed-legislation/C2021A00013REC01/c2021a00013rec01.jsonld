    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-391",
      "@type": "cml:Concept",
      "skos:prefLabel": "391 Paragraph 576(2)(ca)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-391"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
