    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-323",
      "@type": "cml:Concept",
      "skos:prefLabel": "323 Section 33",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-323"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.121",
      "values:originalText": "Omit:\n•\nThe Federal Court or the Federal Circuit Court may grant\ninjunctions in relation to contraventions of civil penalty\nprovisions.\nsubstitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may grant injunctions in relation to\ncontraventions of civil penalty provisions.",
      "skos:definition": "Omit:\n•\nThe Federal Court or the Federal Circuit Court may grant\ninjunctions in relation to contraventions of civil penalty\nprovisions.\nsubstitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may grant injunctions in relation to\ncontraventions of civil penalty provisions.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-323-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-323-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cf1e04a955b56e70b0b76083b2772751cfd57aac43b48bdab572af2a10dcbe63",
      "skos:note": "Granting injunctions in relation to contraventions of civil penalty provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-323",
      "@type": "cof:Section",
      "cof:title": "323 Section 33",
      "values:kind": "section",
      "cof:pageNumber": 121,
      "values:originalText": "Omit:\n•\nThe Federal Court or the Federal Circuit Court may grant\ninjunctions in relation to contraventions of civil penalty\nprovisions.\nsubstitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may grant injunctions in relation to\ncontraventions of civil penalty provisions."
    },
