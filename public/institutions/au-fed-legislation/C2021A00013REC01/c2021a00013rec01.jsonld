      "dc:source": "c2021a00013rec01.pdf, p.12",
      "values:originalText": "No. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvisions\nCommencement\nDate/Details\n(a) at the same time as the commencement\nof the provisions covered by table item 2;\nand\n(b) immediately after the commencement of\nSchedule 2 to the Aged Care Legislation\nAmendment (New Commissioner\nFunctions) Act 2019.\nHowever, the provisions do not commence\nat all if the event mentioned in paragraph (b)\ndoes not occur.\n(paragraph (a)\napplies)",
      "skos:definition": "No. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvisions\nCommencement\nDate/Details\n(a) at the same time as the commencement\nof the provisions covered by table item 2;\nand\n(b) immediately after the commencement of\nSchedule 2 to the Aged Care Legislation\nAmendment (New Commissioner\nFunctions) Act 2019.\nHowever, the provisions do not commence\nat all if the event mentioned in paragraph (b)\ndoes not occur.\n(paragraph (a)\napplies)",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sec-1-8-norm"
        }
      ],
      "cml:integrityHash": "cc3ddf96c9efd4030a84a37a445b2fb8f5eef3fc2fb9d262a0d04b03b2714f57",
      "skos:note": "Commencement details for Federal Circuit and Family Court of Australia (Consequential Amendments and Transitional Provisions) Act 2021"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sec-1-8",
      "@type": "cof:Section",
      "cof:title": "1 September",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "No. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nCommencement information\nColumn 1\nColumn 2\nColumn 3\nProvisions\nCommencement\nDate/Details\n(a) at the same time as the commencement\nof the provisions covered by table item 2;\nand\n(b) immediately after the commencement of\nSchedule 2 to the Aged Care Legislation\nAmendment (New Commissioner\nFunctions) Act 2019.\nHowever, the provisions do not commence\nat all if the event mentioned in paragraph (b)\ndoes not occur.\n(paragraph (a)\napplies)"
    },
