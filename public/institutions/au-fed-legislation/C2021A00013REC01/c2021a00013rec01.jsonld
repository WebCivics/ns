      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.227",
      "values:originalText": "Australia\nMatters to be substantively heard by the Federal Circuit and\nFamily Court of Australia (Division 1)\n(1)\nSubject to subitems (3) and (4), if:\n(a) before the commencement day, any of the following occur:\n(i) an application is made under section 94AA of the\nFamily Law Act 1975 for leave to appeal under Part X\nof that Act;\n\nSchedule 5  Transitional provisions",
      "skos:definition": "Australia\nMatters to be substantively heard by the Federal Circuit and\nFamily Court of Australia (Division 1)\n(1)\nSubject to subitems (3) and (4), if:\n(a) before the commencement day, any of the following occur:\n(i) an application is made under section 94AA of the\nFamily Law Act 1975 for leave to appeal under Part X\nof that Act;\n\nSchedule 5  Transitional provisions",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-28-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-28-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e8a1fb7a9f5a394fae8a9de17d071d178345e5e78dd9ffd16acfe0dc6dd1faa6",
      "skos:note": "Matters to be substantively heard by the Federal Circuit and Family Court of Australia (Division 1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-28",
      "@type": "cof:Section",
      "cof:title": "28 Matters before a Judge or Full Court of the Family Court of",
      "values:kind": "section",
      "cof:pageNumber": 227,
      "values:originalText": "Australia\nMatters to be substantively heard by the Federal Circuit and\nFamily Court of Australia (Division 1)\n(1)\nSubject to subitems (3) and (4), if:\n(a) before the commencement day, any of the following occur:\n(i) an application is made under section 94AA of the\nFamily Law Act 1975 for leave to appeal under Part X\nof that Act;\n\nSchedule 5  Transitional provisions"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-28-norm",
