      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.101",
      "values:originalText": "(2) The Supreme Court of the Northern Territory has jurisdiction to\nhear and determine appeals from a decree of a court of summary\njurisdiction of the Northern Territory.\nNote:\nSee sections 47A and 47B of the Family Law Act 1975.",
      "skos:definition": "(2) The Supreme Court of the Northern Territory has jurisdiction to\nhear and determine appeals from a decree of a court of summary\njurisdiction of the Northern Territory.\nNote:\nSee sections 47A and 47B of the Family Law Act 1975.",
      "values:partOf": {
