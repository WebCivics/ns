      },
      "dc:source": "c2021a00013rec01.pdf, p.137",
      "values:originalText": "Omit “Federal Circuit Court of Australia” (wherever occurring),\nsubstitute “Federal Circuit and Family Court of Australia (Division 2)”.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nGovernment Procurement (Judicial Review) Act 2018",
      "skos:definition": "Omit “Federal Circuit Court of Australia” (wherever occurring),\nsubstitute “Federal Circuit and Family Court of Australia (Division 2)”.\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nGovernment Procurement (Judicial Review) Act 2018",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-444-norm"
        },
        {
