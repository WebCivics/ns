    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-586",
      "@type": "cml:Concept",
      "skos:prefLabel": "586 Subsection 13AA(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-586"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.160",
      "values:originalText": "Repeal the subsection, substitute:\n(2) In the case of an eligible Judge, subject to the Rules of Court made\nunder Chapter 4 of the Federal Circuit and Family Court of\nAustralia Act 2021, the order may be enforced as if the order were\nan order of the Federal Circuit and Family Court of Australia\n(Division 2).\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "Repeal the subsection, substitute:\n(2) In the case of an eligible Judge, subject to the Rules of Court made\nunder Chapter 4 of the Federal Circuit and Family Court of\nAustralia Act 2021, the order may be enforced as if the order were\nan order of the Federal Circuit and Family Court of Australia\n(Division 2).\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-586-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-586-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f5583c8ad0e8c55a76c971433eefe7111013a9551b626ec5f5276458b5f0c581",
      "skos:note": "Enforce order as if it were an order of the Federal Circuit and Family Court of Australia (Division 2)"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-586",
      "@type": "cof:Section",
      "cof:title": "586 Subsection 13AA(2)",
      "values:kind": "section",
      "cof:pageNumber": 160,
      "values:originalText": "Repeal the subsection, substitute:\n(2) In the case of an eligible Judge, subject to the Rules of Court made\nunder Chapter 4 of the Federal Circuit and Family Court of\nAustralia Act 2021, the order may be enforced as if the order were\nan order of the Federal Circuit and Family Court of Australia\n(Division 2).\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
