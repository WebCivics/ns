      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-550",
      "@type": "cml:Concept",
      "skos:prefLabel": "550 After subsection 476A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-550"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.155",
      "values:originalText": "Insert:\n(1A) To avoid doubt, the Federal Court does not have original\njurisdiction in relation to a migration decision under subsection (1)\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nin respect of proceedings that are transferred to the Federal Court\nunder section 32AC of the Federal Court of Australia Act 1976.",
      "skos:definition": "Insert:\n(1A) To avoid doubt, the Federal Court does not have original\njurisdiction in relation to a migration decision under subsection (1)\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nin respect of proceedings that are transferred to the Federal Court\nunder section 32AC of the Federal Court of Australia Act 1976.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-550-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-550-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d2422a493437e462a2e1b5c9f976a5fb527cbaec6e71d9f08da864cd2d88ae71",
      "skos:note": "No original jurisdiction in relation to migration decisions under subsection (1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-550",
      "@type": "cof:Section",
      "cof:title": "550 After subsection 476A(1)",
      "values:kind": "section",
      "cof:pageNumber": 155,
      "values:originalText": "Insert:\n(1A) To avoid doubt, the Federal Court does not have original\njurisdiction in relation to a migration decision under subsection (1)\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nin respect of proceedings that are transferred to the Federal Court\nunder section 32AC of the Federal Court of Australia Act 1976."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-550-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-2-sec-550"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-550-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of original jurisdiction",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (1)",
      "cml:conclusionText": "Federal Court does not have original jurisdiction"
    },
