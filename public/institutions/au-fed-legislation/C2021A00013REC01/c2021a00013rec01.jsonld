        }
      ],
      "cml:integrityHash": "19ae6c812d6310fd58a21a78f037e5bebc2d9a924551dc28babaabc8aef5286b",
      "skos:note": "Continuation of written authorisation under Family Law Act 1975"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-235",
      "@type": "cof:Section",
      "cof:title": "235 Oaths and affirmations",
      "values:kind": "section",
      "cof:pageNumber": 66,
