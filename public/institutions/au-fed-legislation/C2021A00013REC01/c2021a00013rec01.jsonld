    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-574",
      "@type": "cml:Concept",
      "skos:prefLabel": "574 Subsection 503C(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-574"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.159",
      "values:originalText": "Omit “the Federal Circuit Court may, on application by the Minister,\nmake such orders as the Federal Court or the Federal Circuit Court\nconsiders appropriate for the purpose of ensuring that, in the event that\nthe subsection 503B(1) application is made and the information is\ndisclosed to the Federal Court or the Federal Circuit Court”, substitute\n“the Federal Circuit and Family Court of Australia (Division 2) may, on\napplication by the Minister, make such orders as the Federal Court or\nthe Federal Circuit and Family Court of Australia (Division 2) considers\nappropriate for the purpose of ensuring that, in the event that the\nsubsection 503B(1) application is made and the information is disclosed\nto the Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2)”.",
      "skos:definition": "Omit “the Federal Circuit Court may, on application by the Minister,\nmake such orders as the Federal Court or the Federal Circuit Court\nconsiders appropriate for the purpose of ensuring that, in the event that\nthe subsection 503B(1) application is made and the information is\ndisclosed to the Federal Court or the Federal Circuit Court”, substitute\n“the Federal Circuit and Family Court of Australia (Division 2) may, on\napplication by the Minister, make such orders as the Federal Court or\nthe Federal Circuit and Family Court of Australia (Division 2) considers\nappropriate for the purpose of ensuring that, in the event that the\nsubsection 503B(1) application is made and the information is disclosed\nto the Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2)”.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-574-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-574-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ed966220dbb6e26217fbb55e2bc9acf0c243f322c6c703db98f7494959bdd11f",
      "skos:note": "Permits the Federal Circuit and Family Court of Australia (Division 2) to make orders on application by the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-574",
      "@type": "cof:Section",
      "cof:title": "574 Subsection 503C(3)",
      "values:kind": "section",
      "cof:pageNumber": 159,
      "values:originalText": "Omit “the Federal Circuit Court may, on application by the Minister,\nmake such orders as the Federal Court or the Federal Circuit Court\nconsiders appropriate for the purpose of ensuring that, in the event that\nthe subsection 503B(1) application is made and the information is\ndisclosed to the Federal Court or the Federal Circuit Court”, substitute\n“the Federal Circuit and Family Court of Australia (Division 2) may, on\napplication by the Minister, make such orders as the Federal Court or\nthe Federal Circuit and Family Court of Australia (Division 2) considers\nappropriate for the purpose of ensuring that, in the event that the\nsubsection 503B(1) application is made and the information is disclosed\nto the Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2)”."
    },
