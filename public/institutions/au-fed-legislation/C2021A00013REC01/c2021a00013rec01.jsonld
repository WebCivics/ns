    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-671",
      "@type": "cml:Concept",
      "skos:prefLabel": "671 Section 205",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-671"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.173",
      "values:originalText": "Omit:\nJurisdiction is conferred on the Federal Court, the Federal Circuit\nCourt, courts of States and Territories and the Family Court. PPS\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nmatters can be transferred between courts in accordance with\nprocedures set out in this Part.\nsubstitute:\nJurisdiction is conferred on the Federal Court, the Federal Circuit\nand Family Court of Australia (Division 1), the Federal Circuit and\nFamily Court of Australia (Division 2) and courts of States and\nTerritories. PPS matters can be transferred between courts in\naccordance with procedures set out in this Part.",
      "skos:definition": "Omit:\nJurisdiction is conferred on the Federal Court, the Federal Circuit\nCourt, courts of States and Territories and the Family Court. PPS\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nmatters can be transferred between courts in accordance with\nprocedures set out in this Part.\nsubstitute:\nJurisdiction is conferred on the Federal Court, the Federal Circuit\nand Family Court of Australia (Division 1), the Federal Circuit and\nFamily Court of Australia (Division 2) and courts of States and\nTerritories. PPS matters can be transferred between courts in\naccordance with procedures set out in this Part.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-671-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-671-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "23644894f96cf02cc7bdb112540c67244620e4537d3ff02ebfee7fce0241cab6",
      "skos:note": "Jurisdiction is conferred on specified courts."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-671",
      "@type": "cof:Section",
      "cof:title": "671 Section 205",
      "values:kind": "section",
      "cof:pageNumber": 173,
      "values:originalText": "Omit:\nJurisdiction is conferred on the Federal Court, the Federal Circuit\nCourt, courts of States and Territories and the Family Court. PPS\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\nmatters can be transferred between courts in accordance with\nprocedures set out in this Part.\nsubstitute:\nJurisdiction is conferred on the Federal Court, the Federal Circuit\nand Family Court of Australia (Division 1), the Federal Circuit and\nFamily Court of Australia (Division 2) and courts of States and\nTerritories. PPS matters can be transferred between courts in\naccordance with procedures set out in this Part."
    },
