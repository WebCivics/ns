    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-62",
      "@type": "cml:Concept",
      "skos:prefLabel": "62 Subsection 45(2) (notes 1 and 2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-62"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.27",
      "values:originalText": "Repeal the notes, substitute:\nNote 1:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 1) to the Federal Circuit and Family Court of Australia\n(Division 2), see section 52 of the Federal Circuit and Family Court\nof Australia Act 2021.\nNote 2:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 2) to the Federal Circuit and Family Court of Australia\n(Division 1), see sections 51 and 149 of the Federal Circuit and\nFamily Court of Australia Act 2021.",
      "skos:definition": "Repeal the notes, substitute:\nNote 1:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 1) to the Federal Circuit and Family Court of Australia\n(Division 2), see section 52 of the Federal Circuit and Family Court\nof Australia Act 2021.\nNote 2:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 2) to the Federal Circuit and Family Court of Australia\n(Division 1), see sections 51 and 149 of the Federal Circuit and\nFamily Court of Australia Act 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-62-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-62-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "ecf783caf6ab8a8adcdca0d1adaff28bd07aa8d3ab805069883427e73d308b30",
      "skos:note": "Repeal notes and substitute with new references to other sections."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-62",
      "@type": "cof:Section",
      "cof:title": "62 Subsection 45(2) (notes 1 and 2)",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "Repeal the notes, substitute:\nNote 1:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 1) to the Federal Circuit and Family Court of Australia\n(Division 2), see section 52 of the Federal Circuit and Family Court\nof Australia Act 2021.\nNote 2:\nFor transfers from the Federal Circuit and Family Court of Australia\n(Division 2) to the Federal Circuit and Family Court of Australia\n(Division 1), see sections 51 and 149 of the Federal Circuit and\nFamily Court of Australia Act 2021."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-62-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-62"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-62-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Identify temporal intervals in notes",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Notes have dates",
      "cml:conclusionText": "Temporal interval identified"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-63",
      "@type": "cml:Concept",
      "skos:prefLabel": "63 Subparagraphs 46(1)(a)(i) to (iii)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-63"
