    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Paragraph (zf) of Schedule 1",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.81",
      "values:originalText": "Repeal the paragraph, substitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\n(zf) the following decisions under the Federal Circuit and Family\nCourt of Australia Act 2021:\n(i) decisions of the Chief Justice of the Federal Circuit and\nFamily Court of Australia (Division 1) or the Minister\nwhether to consent as mentioned in paragraph 12(1)(a)\nof that Act;\n(ii) decisions of the Chief Justice or Deputy Chief Justice of\nthe Federal Circuit and Family Court of Australia\n(Division 1) in the exercise of, or in assisting in the\nexercise of, the functions or powers mentioned in\nsubsection 47(2) of that Act;\n(iii) decisions of the Chief Judge or a Deputy Chief Judge of\nthe Federal Circuit and Family Court of Australia\n(Division 2) in the exercise of, or in assisting in the\nexercise of, the functions or powers mentioned in\nsubsection 144(2) of that Act;\n(iv) decisions of the Chief Judge of the Federal Circuit and\nFamily Court of Australia (Division 2) in the exercise of\nthe functions or powers mentioned in subsection 147(1)\nof that Act.\nAdmiralty Act 1988",
      "skos:definition": "Repeal the paragraph, substitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\n(zf) the following decisions under the Federal Circuit and Family\nCourt of Australia Act 2021:\n(i) decisions of the Chief Justice of the Federal Circuit and\nFamily Court of Australia (Division 1) or the Minister\nwhether to consent as mentioned in paragraph 12(1)(a)\nof that Act;\n(ii) decisions of the Chief Justice or Deputy Chief Justice of\nthe Federal Circuit and Family Court of Australia\n(Division 1) in the exercise of, or in assisting in the\nexercise of, the functions or powers mentioned in\nsubsection 47(2) of that Act;\n(iii) decisions of the Chief Judge or a Deputy Chief Judge of\nthe Federal Circuit and Family Court of Australia\n(Division 2) in the exercise of, or in assisting in the\nexercise of, the functions or powers mentioned in\nsubsection 144(2) of that Act;\n(iv) decisions of the Chief Judge of the Federal Circuit and\nFamily Court of Australia (Division 2) in the exercise of\nthe functions or powers mentioned in subsection 147(1)\nof that Act.\nAdmiralty Act 1988",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-56-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-56-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d5a6133f4646c33f3272700537a87623f3037ddb31d87e4b41b1dfe830e912e6",
      "skos:note": "Repeal and substitute certain decisions under the Federal Circuit and Family Court of Australia Act 2021"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Paragraph (zf) of Schedule 1",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "Repeal the paragraph, substitute:\n\nSchedule 2  Further consequential amendments\n\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nNo. 13, 2021\n(zf) the following decisions under the Federal Circuit and Family\nCourt of Australia Act 2021:\n(i) decisions of the Chief Justice of the Federal Circuit and\nFamily Court of Australia (Division 1) or the Minister\nwhether to consent as mentioned in paragraph 12(1)(a)\nof that Act;\n(ii) decisions of the Chief Justice or Deputy Chief Justice of\nthe Federal Circuit and Family Court of Australia\n(Division 1) in the exercise of, or in assisting in the\nexercise of, the functions or powers mentioned in\nsubsection 47(2) of that Act;\n(iii) decisions of the Chief Judge or a Deputy Chief Judge of\nthe Federal Circuit and Family Court of Australia\n(Division 2) in the exercise of, or in assisting in the\nexercise of, the functions or powers mentioned in\nsubsection 144(2) of that Act;\n(iv) decisions of the Chief Judge of the Federal Circuit and\nFamily Court of Australia (Division 2) in the exercise of\nthe functions or powers mentioned in subsection 147(1)\nof that Act.\nAdmiralty Act 1988"
    },
