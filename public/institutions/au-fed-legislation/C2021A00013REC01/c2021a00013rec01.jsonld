    {
      "@id": "concept:c2021a00013rec01-sch-4-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Subsection 47A(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-4-sec-7"
      },
      "cml:curationStatus": {
