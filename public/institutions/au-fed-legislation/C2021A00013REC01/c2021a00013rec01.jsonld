      },
      "dc:source": "c2021a00013rec01.pdf, p.130",
      "values:originalText": "Repeal the paragraph, substitute:\n(ca) mediating any proceedings, part of proceedings or matter\narising out of any proceedings that, under section 53A of the\nFederal Court of Australia Act 1976 or section 169 of the\nFederal Circuit and Family Court of Australia Act 2021,\nhave been referred by the Fair Work Division of the Federal\nCourt or Federal Circuit and Family Court of Australia\n(Division 2) to the FWC for mediation;",
      "skos:definition": "Repeal the paragraph, substitute:\n(ca) mediating any proceedings, part of proceedings or matter\narising out of any proceedings that, under section 53A of the\nFederal Court of Australia Act 1976 or section 169 of the\nFederal Circuit and Family Court of Australia Act 2021,\nhave been referred by the Fair Work Division of the Federal\nCourt or Federal Circuit and Family Court of Australia\n(Division 2) to the FWC for mediation;",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-391-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-391-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0c7fd11df5218d2ac2cc7212cf4bf71745351a040122bafe2aa47d694d3a32fc",
      "skos:note": "Prohibition on mediating proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-391",
      "@type": "cof:Section",
      "cof:title": "391 Paragraph 576(2)(ca)",
      "values:kind": "section",
      "cof:pageNumber": 130,
      "values:originalText": "Repeal the paragraph, substitute:\n(ca) mediating any proceedings, part of proceedings or matter\narising out of any proceedings that, under section 53A of the\nFederal Court of Australia Act 1976 or section 169 of the\nFederal Circuit and Family Court of Australia Act 2021,\nhave been referred by the Fair Work Division of the Federal\nCourt or Federal Circuit and Family Court of Australia\n(Division 2) to the FWC for mediation;"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-391-norm",
