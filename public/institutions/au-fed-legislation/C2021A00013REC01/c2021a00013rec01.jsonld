    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-163",
      "@type": "cml:Concept",
      "skos:prefLabel": "163 At the end of subsection 123(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-163"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.45",
      "values:originalText": "Add:\nNote 1:\nFor other powers to make Rules of Court, see section 109A and\nsubsection 111C(7A).\nNote 2:\nThe power to make Rules of Court under this section will be amended\n18 months after the commencement of the Federal Circuit and Family\nCourt of Australia Act 2021, to provide for the Rules to be made by\nthe Judges of the Federal Circuit and Family Court of Australia\n(Division 1), or a majority of them (see Part 4 of Schedule 1 to the\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021).\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "skos:definition": "Add:\nNote 1:\nFor other powers to make Rules of Court, see section 109A and\nsubsection 111C(7A).\nNote 2:\nThe power to make Rules of Court under this section will be amended\n18 months after the commencement of the Federal Circuit and Family\nCourt of Australia Act 2021, to provide for the Rules to be made by\nthe Judges of the Federal Circuit and Family Court of Australia\n(Division 1), or a majority of them (see Part 4 of Schedule 1 to the\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021).\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-163-norm"
        }
      ],
      "cml:integrityHash": "e2142b3e8105758b64db83f5cfe7944550209e62c41d220fb03cfd89b038c864",
      "skos:note": "Amendment of power to make Rules of Court"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-163",
      "@type": "cof:Section",
      "cof:title": "163 At the end of subsection 123(1)",
      "values:kind": "section",
      "cof:pageNumber": 45,
      "values:originalText": "Add:\nNote 1:\nFor other powers to make Rules of Court, see section 109A and\nsubsection 111C(7A).\nNote 2:\nThe power to make Rules of Court under this section will be amended\n18 months after the commencement of the Federal Circuit and Family\nCourt of Australia Act 2021, to provide for the Rules to be made by\nthe Judges of the Federal Circuit and Family Court of Australia\n(Division 1), or a majority of them (see Part 4 of Schedule 1 to the\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021).\n\nSchedule 1  Amendments relating to the Federal Circuit and Family Court of Australia"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-163-norm",
