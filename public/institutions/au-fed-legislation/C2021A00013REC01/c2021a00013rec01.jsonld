    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Subsection 4(1) (definition of applicable Rules of Court)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.17",
      "values:originalText": "Repeal the definition, substitute:\napplicable Rules of Court:\n(a) in relation to the Federal Circuit and Family Court of\nAustralia (Division 1)—means the Federal Circuit and\nFamily Court of Australia (Division 1) Rules; and\n(b) in relation to the Federal Circuit and Family Court of\nAustralia (Division 2)—means the related Federal Circuit and\nFamily Court of Australia (Division 2) Rules; and\n(c) in relation to any other court—means the standard Rules of\nCourt.",
      "skos:definition": "Repeal the definition, substitute:\napplicable Rules of Court:\n(a) in relation to the Federal Circuit and Family Court of\nAustralia (Division 1)—means the Federal Circuit and\nFamily Court of Australia (Division 1) Rules; and\n(b) in relation to the Federal Circuit and Family Court of\nAustralia (Division 2)—means the related Federal Circuit and\nFamily Court of Australia (Division 2) Rules; and\n(c) in relation to any other court—means the standard Rules of\nCourt.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-3-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-3-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "d0e8c4f6d4a53fd0ae6d4d2b7ace8f9dd9b0cc02001b6d913b7c4c8ba1568e51",
      "skos:note": "Definition of applicable Rules of Court"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Subsection 4(1) (definition of applicable Rules of Court)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Repeal the definition, substitute:\napplicable Rules of Court:\n(a) in relation to the Federal Circuit and Family Court of\nAustralia (Division 1)—means the Federal Circuit and\nFamily Court of Australia (Division 1) Rules; and\n(b) in relation to the Federal Circuit and Family Court of\nAustralia (Division 2)—means the related Federal Circuit and\nFamily Court of Australia (Division 2) Rules; and\n(c) in relation to any other court—means the standard Rules of\nCourt."
    },
