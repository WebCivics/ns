      },
      "dc:source": "c2021a00013rec01.pdf, p.17",
      "values:originalText": "Omit “, the standard Rules of Court and the related Federal Circuit\nCourt Rules, unless the contrary intention appears”, substitute “and the\napplicable Rules of Court”.",
      "skos:definition": "Omit “, the standard Rules of Court and the related Federal Circuit\nCourt Rules, unless the contrary intention appears”, substitute “and the\napplicable Rules of Court”.",
      "cml:asserts": [
