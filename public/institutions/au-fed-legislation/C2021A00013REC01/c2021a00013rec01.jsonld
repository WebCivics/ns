      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-81-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Identifies a specific type of judge",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Judge of the Federal Circuit and Family Court of Australia (Division 2)",
      "cml:conclusionText": "a Judge of the Federal Circuit and Family Court of Australia (Division 2) in a personal capacity and not as a court or a member of a court."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-82",
      "@type": "cml:Concept",
      "skos:prefLabel": "82 Subsection 55A(13) (definition of Judge of the Federal",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-82"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.86",
