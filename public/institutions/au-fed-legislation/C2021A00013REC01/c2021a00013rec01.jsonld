    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-445",
      "@type": "cml:Concept",
      "skos:prefLabel": "445 Section 3",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-445"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.138",
      "values:originalText": "Omit:\n•\nThe Federal Court or the Federal Circuit Court may grant an\ninjunction in relation to a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement).\n•\nThe Federal Court or the Federal Circuit Court may order the\npayment of compensation for a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement).\nsubstitute:\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may grant an injunction in relation to a\ncontravention of the relevant Commonwealth Procurement\nRules (so far as those rules relate to a covered procurement).\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may order the payment of\ncompensation for a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement).",
      "skos:definition": "Omit:\n•\nThe Federal Court or the Federal Circuit Court may grant an\ninjunction in relation to a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement).\n•\nThe Federal Court or the Federal Circuit Court may order the\npayment of compensation for a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement).\nsubstitute:\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may grant an injunction in relation to a\ncontravention of the relevant Commonwealth Procurement\nRules (so far as those rules relate to a covered procurement).\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may order the payment of\ncompensation for a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-445-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-445-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0504fe9fb21da13cac5c361a538e200ac37f69e8631a698f72fa39f54fc1f4a1",
      "skos:note": "Omit injunction and compensation orders for contravention of Commonwealth Procurement Rules."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-445",
      "@type": "cof:Section",
      "cof:title": "445 Section 3",
      "values:kind": "section",
      "cof:pageNumber": 138,
      "values:originalText": "Omit:\n•\nThe Federal Court or the Federal Circuit Court may grant an\ninjunction in relation to a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement).\n•\nThe Federal Court or the Federal Circuit Court may order the\npayment of compensation for a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement).\nsubstitute:\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may grant an injunction in relation to a\ncontravention of the relevant Commonwealth Procurement\nRules (so far as those rules relate to a covered procurement).\n•\nThe Federal Court or the Federal Circuit and Family Court of\nAustralia (Division 2) may order the payment of\ncompensation for a contravention of the relevant\nCommonwealth Procurement Rules (so far as those rules\nrelate to a covered procurement)."
    },
