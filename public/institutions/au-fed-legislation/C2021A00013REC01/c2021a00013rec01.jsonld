      },
      "dc:source": "c2021a00013rec01.pdf, p.62",
      "values:originalText": "Omit “The Governor-General shall”, substitute “The Minister must”.",
      "skos:definition": "Omit “The Governor-General shall”, substitute “The Minister must”.",
      "cml:asserts": [
