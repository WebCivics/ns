      "dc:source": "c2021a00013rec01.pdf, p.208",
      "values:originalText": "Insert:\n(da) a judgment of the Family Court of Western Australia\nexercising original or appellate jurisdiction under:\n(i) the Family Law Act 1975 (other than Part VIIIC); or\n(ii) the Child Support (Assessment) Act 1989; or\n(iii) the Child Support (Registration and Collection) Act\n1988; and",
      "skos:definition": "Insert:\n(da) a judgment of the Family Court of Western Australia\nexercising original or appellate jurisdiction under:\n(i) the Family Law Act 1975 (other than Part VIIIC); or\n(ii) the Child Support (Assessment) Act 1989; or\n(iii) the Child Support (Registration and Collection) Act\n1988; and",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-4-sec-12-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-4-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fbd26e45f80112686e0b427bf9398c018969e181366d77dafd2e628f8f7e3771",
      "skos:note": "Insertion of judgments from specific courts"
    },
