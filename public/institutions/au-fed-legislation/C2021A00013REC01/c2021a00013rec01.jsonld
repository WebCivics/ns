    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-689",
      "@type": "cml:Concept",
      "skos:prefLabel": "689 Subsection 56(1) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-689"
      },
      "cml:curationStatus": {
