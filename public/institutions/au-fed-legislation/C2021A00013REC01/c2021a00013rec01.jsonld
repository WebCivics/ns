      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continuation",
      "cml:logicSummary": "Continues to serve in new role",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Immediate predecessor was an officer/staff member",
      "cml:conclusionText": "Current person continues as officer/staff member"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-5-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "Includes staff members from old law",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Staff members were part of old law registries",
      "cml:conclusionText": "New role includes staff members from old law"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Application of subsection 25B(1) of the Acts Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.217",
      "values:originalText": "Act 1901\nSubsection 25B(1) of the Acts Interpretation Act 1901 applies as if:\n(a) the Family Court of Australia were a body; and\n(b) the offices of Chief Justice, Deputy Chief Justice, Senior\nJudge and Judge were offices.",
      "skos:definition": "Act 1901\nSubsection 25B(1) of the Acts Interpretation Act 1901 applies as if:\n(a) the Family Court of Australia were a body; and\n(b) the offices of Chief Justice, Deputy Chief Justice, Senior\nJudge and Judge were offices.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-6-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bf48d0d50e4bc12030abe6149d1a77f364a3234de8fcf05995d0a9fdda9f4730",
      "skos:note": "Application of subsection 25B(1) of the Acts Interpretation Act 1901 to the Family Court of Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Application of subsection 25B(1) of the Acts Interpretation",
      "values:kind": "section",
      "cof:pageNumber": 217,
      "values:originalText": "Act 1901\nSubsection 25B(1) of the Acts Interpretation Act 1901 applies as if:\n(a) the Family Court of Australia were a body; and\n(b) the offices of Chief Justice, Deputy Chief Justice, Senior\nJudge and Judge were offices."
    },
    {
