    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-227",
      "@type": "cml:Concept",
      "skos:prefLabel": "227 After paragraph 59(2)(r)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-227"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.64",
      "values:originalText": "Insert:\n(ra) the transfer of proceedings from the Federal Circuit and\nFamily Court of Australia (Division 2), including matters\nrelating to costs, such as:\n(i) the costs of the application for an order transferring such\na proceeding; and\n(ii) the costs for any step in such a proceeding, including\nsteps that occurred before the proceeding was\ntransferred; and\n(iii) the scale of costs that is to apply; and\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nApplication, saving and transitional provisions  Part 2\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "skos:definition": "Insert:\n(ra) the transfer of proceedings from the Federal Circuit and\nFamily Court of Australia (Division 2), including matters\nrelating to costs, such as:\n(i) the costs of the application for an order transferring such\na proceeding; and\n(ii) the costs for any step in such a proceeding, including\nsteps that occurred before the proceeding was\ntransferred; and\n(iii) the scale of costs that is to apply; and\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nApplication, saving and transitional provisions  Part 2\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-227-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-227-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ca60da7cc69a936cb3d0c1041c9044fb030c5f75c1d943456981f5d1c6dcb240",
      "skos:note": "Transfer of proceedings from Federal Circuit and Family Court of Australia is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-227",
      "@type": "cof:Section",
      "cof:title": "227 After paragraph 59(2)(r)",
      "values:kind": "section",
      "cof:pageNumber": 64,
      "values:originalText": "Insert:\n(ra) the transfer of proceedings from the Federal Circuit and\nFamily Court of Australia (Division 2), including matters\nrelating to costs, such as:\n(i) the costs of the application for an order transferring such\na proceeding; and\n(ii) the costs for any step in such a proceeding, including\nsteps that occurred before the proceeding was\ntransferred; and\n(iii) the scale of costs that is to apply; and\n\nAmendments relating to the Federal Circuit and Family Court of Australia  Schedule 1\nApplication, saving and transitional provisions  Part 2\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021"
    },
    {
