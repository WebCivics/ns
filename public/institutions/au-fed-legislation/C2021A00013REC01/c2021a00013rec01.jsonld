    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-304",
      "@type": "cml:Concept",
      "skos:prefLabel": "304 Section 82",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-304"
      },
