    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-234",
      "@type": "cml:Concept",
      "skos:prefLabel": "234 Proclamation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-234"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.66",
      "values:originalText": "Despite the repeal of section 96 of the Family Law Act 1975 by this Act,\na Proclamation made under subsection 96(3) of that Act and in force\nimmediately before the commencement day, continues in force (and\nmay be dealt with) as if:\n(a) it had been made under subsection 47A(5) of the Family Law\nAct 1975, as inserted by this Act; and\n(b) the Supreme Courts specified in that Proclamation are also\nspecified for the purposes of appeals in relation to:\n(i) the Child Support (Assessment) Act 1989; or\n(ii) the Child Support (Registration and Collection) Act\n1988.",
      "skos:definition": "Despite the repeal of section 96 of the Family Law Act 1975 by this Act,\na Proclamation made under subsection 96(3) of that Act and in force\nimmediately before the commencement day, continues in force (and\nmay be dealt with) as if:\n(a) it had been made under subsection 47A(5) of the Family Law\nAct 1975, as inserted by this Act; and\n(b) the Supreme Courts specified in that Proclamation are also\nspecified for the purposes of appeals in relation to:\n(i) the Child Support (Assessment) Act 1989; or\n(ii) the Child Support (Registration and Collection) Act\n1988.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-234-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-234-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "c6c455de6986b43d4dfa0f9a9dc0f76a665afdd8acd0eae56a3b5ee7e344e4dc",
      "skos:note": "Continuation of a proclamation despite repeal"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-234",
      "@type": "cof:Section",
      "cof:title": "234 Proclamation",
      "values:kind": "section",
      "cof:pageNumber": 66,
      "values:originalText": "Despite the repeal of section 96 of the Family Law Act 1975 by this Act,\na Proclamation made under subsection 96(3) of that Act and in force\nimmediately before the commencement day, continues in force (and\nmay be dealt with) as if:\n(a) it had been made under subsection 47A(5) of the Family Law\nAct 1975, as inserted by this Act; and\n(b) the Supreme Courts specified in that Proclamation are also\nspecified for the purposes of appeals in relation to:\n(i) the Child Support (Assessment) Act 1989; or\n(ii) the Child Support (Registration and Collection) Act\n1988."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-234-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-1-sec-234"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-234-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relationship between the repeal and continuation of the proclamation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-1-sec-235",
      "@type": "cml:Concept",
      "skos:prefLabel": "235 Oaths and affirmations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-235"
      },
      "cml:curationStatus": {
