    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-711",
      "@type": "cml:Concept",
      "skos:prefLabel": "711 Section 9",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-711"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.182",
      "values:originalText": "Omit:\nThe Federal Court or Federal Circuit Court may make orders for\ncivil remedies (including compensation, injunctions and\nreinstatement of employment) if a reprisal is taken against a person\nbecause of a public interest disclosure (including a proposed or a\nsuspected public interest disclosure).\nsubstitute:\nThe Federal Court or Federal Circuit and Family Court of Australia\n(Division 2) may make orders for civil remedies (including\ncompensation, injunctions and reinstatement of employment) if a\nreprisal is taken against a person because of a public interest\ndisclosure (including a proposed or a suspected public interest\ndisclosure).",
      "skos:definition": "Omit:\nThe Federal Court or Federal Circuit Court may make orders for\ncivil remedies (including compensation, injunctions and\nreinstatement of employment) if a reprisal is taken against a person\nbecause of a public interest disclosure (including a proposed or a\nsuspected public interest disclosure).\nsubstitute:\nThe Federal Court or Federal Circuit and Family Court of Australia\n(Division 2) may make orders for civil remedies (including\ncompensation, injunctions and reinstatement of employment) if a\nreprisal is taken against a person because of a public interest\ndisclosure (including a proposed or a suspected public interest\ndisclosure).",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-711-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-711-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f07b6230ed4e138907ca5d71a50dba0f90076c804ab4a6b929e47a8010f7d4b8",
      "skos:note": "Federal Court or Federal Circuit and Family Court of Australia may not make orders for civil remedies if a reprisal is taken against a person because of a public interest disclosure."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-711",
      "@type": "cof:Section",
      "cof:title": "711 Section 9",
      "values:kind": "section",
      "cof:pageNumber": 182,
      "values:originalText": "Omit:\nThe Federal Court or Federal Circuit Court may make orders for\ncivil remedies (including compensation, injunctions and\nreinstatement of employment) if a reprisal is taken against a person\nbecause of a public interest disclosure (including a proposed or a\nsuspected public interest disclosure).\nsubstitute:\nThe Federal Court or Federal Circuit and Family Court of Australia\n(Division 2) may make orders for civil remedies (including\ncompensation, injunctions and reinstatement of employment) if a\nreprisal is taken against a person because of a public interest\ndisclosure (including a proposed or a suspected public interest\ndisclosure)."
    },
    {
