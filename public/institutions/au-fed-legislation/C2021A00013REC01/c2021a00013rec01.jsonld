    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-158",
      "@type": "cml:Concept",
      "skos:prefLabel": "158 Subsection 5(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-158"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.96",
      "values:originalText": "Insert:\nFederal Circuit and Family Court of Australia means:\n(a) the Federal Circuit and Family Court of Australia\n(Division 1); or\n(b) the Federal Circuit and Family Court of Australia\n(Division 2).\nFederal Circuit and Family Court of Australia (Division 1) Rules\nmeans the Rules of Court made under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nFull Court of the Federal Circuit and Family Court of Australia\n(Division 1) has the same meaning as Full Court in the Federal\nCircuit and Family Court of Australia Act 2021.\nrelated Federal Circuit and Family Court of Australia\n(Division 2) Rules has the same meaning as in the Family Law Act\n1975.",
      "skos:definition": "Insert:\nFederal Circuit and Family Court of Australia means:\n(a) the Federal Circuit and Family Court of Australia\n(Division 1); or\n(b) the Federal Circuit and Family Court of Australia\n(Division 2).\nFederal Circuit and Family Court of Australia (Division 1) Rules\nmeans the Rules of Court made under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nFull Court of the Federal Circuit and Family Court of Australia\n(Division 1) has the same meaning as Full Court in the Federal\nCircuit and Family Court of Australia Act 2021.\nrelated Federal Circuit and Family Court of Australia\n(Division 2) Rules has the same meaning as in the Family Law Act\n1975.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-158-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-158-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-158-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "9b4b068958ff0c076a47e68247aa4f823f58a64fdc68af2b203faab52ca9fe99",
      "skos:note": "Defines terms related to Federal Circuit and Family Court of Australia"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-158",
      "@type": "cof:Section",
      "cof:title": "158 Subsection 5(1)",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "Insert:\nFederal Circuit and Family Court of Australia means:\n(a) the Federal Circuit and Family Court of Australia\n(Division 1); or\n(b) the Federal Circuit and Family Court of Australia\n(Division 2).\nFederal Circuit and Family Court of Australia (Division 1) Rules\nmeans the Rules of Court made under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021.\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nFull Court of the Federal Circuit and Family Court of Australia\n(Division 1) has the same meaning as Full Court in the Federal\nCircuit and Family Court of Australia Act 2021.\nrelated Federal Circuit and Family Court of Australia\n(Division 2) Rules has the same meaning as in the Family Law Act\n1975."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-158-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-2-sec-158"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-158-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy definition",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Federal Circuit and Family Court of Australia (Division 1) Rules means the Rules of Court made under Chapter 3 of the Federal Circuit and Family Court of Australia Act 2021.",
      "cml:conclusionText": "Full Court of the Federal Circuit and Family Court of Australia (Division 1) has the same meaning as Full Court in the Federal Circuit and Family Court of Australia Act 2021."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-158-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy definition",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Federal Circuit and Family Court of Australia (Division 2) Rules means the Rules of Court made under Chapter 3 of the Federal Circuit and Family Court of Australia Act 2021.",
      "cml:conclusionText": "related Federal Circuit and Family Court of Australia (Division 2) Rules has the same meaning as in the Family Law Act 1975."
    },
