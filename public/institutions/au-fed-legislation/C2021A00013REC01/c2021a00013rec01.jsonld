    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-549",
      "@type": "cml:Concept",
      "skos:prefLabel": "549 Paragraph 476A(1)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-549"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.155",
      "values:originalText": "Repeal the paragraph, substitute:\n(a) both:\n(i) the Federal Circuit and Family Court of Australia\n(Division 2) transfers a proceeding pending in that court\nin relation to the decision to the Federal Court under\nsection 153 of the Federal Circuit and Family Court of\nAustralia Act 2021; and\n(ii) the Federal Court confirms the transfer under\nsection 32AD of the Federal Court of Australia Act\n1976; or",
      "skos:definition": "Repeal the paragraph, substitute:\n(a) both:\n(i) the Federal Circuit and Family Court of Australia\n(Division 2) transfers a proceeding pending in that court\nin relation to the decision to the Federal Court under\nsection 153 of the Federal Circuit and Family Court of\nAustralia Act 2021; and\n(ii) the Federal Court confirms the transfer under\nsection 32AD of the Federal Court of Australia Act\n1976; or",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-549-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-549-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "54bb07f1c92756caa279c2724cda13f1d234e868a0f9680c22fe1ff43efdcc31",
      "skos:note": "Repeal paragraph and substitute with transfer of proceedings to Federal Court."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-549",
      "@type": "cof:Section",
      "cof:title": "549 Paragraph 476A(1)(a)",
      "values:kind": "section",
      "cof:pageNumber": 155,
      "values:originalText": "Repeal the paragraph, substitute:\n(a) both:\n(i) the Federal Circuit and Family Court of Australia\n(Division 2) transfers a proceeding pending in that court\nin relation to the decision to the Federal Court under\nsection 153 of the Federal Circuit and Family Court of\nAustralia Act 2021; and\n(ii) the Federal Court confirms the transfer under\nsection 32AD of the Federal Court of Australia Act\n1976; or"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-549-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
