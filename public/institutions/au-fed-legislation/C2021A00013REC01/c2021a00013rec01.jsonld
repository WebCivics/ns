      "dc:source": "c2021a00013rec01.pdf, p.99",
      "values:originalText": "Insert:\nFederal Circuit and Family Court of Australia means:\n(a) the Federal Circuit and Family Court of Australia\n(Division 1); or\n(b) the Federal Circuit and Family Court of Australia\n(Division 2).\nFederal Circuit and Family Court of Australia (Division 1) Rules\nmeans the Rules of Court made under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021.",
      "skos:definition": "Insert:\nFederal Circuit and Family Court of Australia means:\n(a) the Federal Circuit and Family Court of Australia\n(Division 1); or\n(b) the Federal Circuit and Family Court of Australia\n(Division 2).\nFederal Circuit and Family Court of Australia (Division 1) Rules\nmeans the Rules of Court made under Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-169-norm"
        },
