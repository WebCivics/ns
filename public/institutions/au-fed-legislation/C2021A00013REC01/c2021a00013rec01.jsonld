    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-538",
      "@type": "cml:Concept",
      "skos:prefLabel": "538 Subsection 9A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-538"
