      },
      "dc:source": "c2021a00013rec01.pdf, p.88",
      "values:originalText": "Repeal the note, substitute:\nNote 2:\nThe Federal Circuit and Family Court of Australia (Division 2), or a\nJudge of that Court, may award costs in proceedings under\nsection 46PO—see section 214 of the Federal Circuit and Family\nCourt of Australia Act 2021.",
      "skos:definition": "Repeal the note, substitute:\nNote 2:\nThe Federal Circuit and Family Court of Australia (Division 2), or a\nJudge of that Court, may award costs in proceedings under\nsection 46PO—see section 214 of the Federal Circuit and Family\nCourt of Australia Act 2021.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-101-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-101-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "841e4491f4fb46aaeabb6d8f1cf4fff7b4b54a4a782ece6a9f7dc3794680b9ed",
      "skos:note": "Award costs in proceedings under section 46PO"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-101",
      "@type": "cof:Section",
      "cof:title": "101 Section 46PSA (note 2)",
      "values:kind": "section",
      "cof:pageNumber": 88,
      "values:originalText": "Repeal the note, substitute:\nNote 2:\nThe Federal Circuit and Family Court of Australia (Division 2), or a\nJudge of that Court, may award costs in proceedings under\nsection 46PO—see section 214 of the Federal Circuit and Family\nCourt of Australia Act 2021."
    },
