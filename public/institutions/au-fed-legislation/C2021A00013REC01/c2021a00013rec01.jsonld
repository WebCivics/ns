      "cml:integrityHash": "e25d559488f935cdbdbf26039f35ff22c1eb6aac6cf345f1eea0e5b00bec1cd3",
      "skos:note": "Extends power to make Rules of Court for adoption orders."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-140-ss-7c",
      "@type": "cof:Section",
      "cof:title": "140(7C) After subsection 111C(7A)",
      "values:kind": "subsection",
      "cof:pageNumber": 42,
      "values:originalText": "(7C) The power of the Chief Judge of the Federal Circuit and Family\nCourt of Australia (Division 2) under Chapter 4 of the Federal\nCircuit and Family Court of Australia Act 2021 to make Rules of\nCourt extends to making Rules of Court for or in relation to the\nmaking of adoption orders."
    },
