      },
      "cml:premiseText": "Full Court, in relation to the Federal Circuit and Family Court of Australia (Division 1), means 2 or more Judges of the Court.",
      "cml:conclusionText": "Federal Court means the Federal Court of Australia."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-1-logic-descriptionlogic-5",
