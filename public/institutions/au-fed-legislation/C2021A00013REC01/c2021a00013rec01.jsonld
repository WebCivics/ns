    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 Application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.237",
      "values:originalText": "The Federal Circuit and Family Court of Australia Act 2021, including\nthe following provisions of that Act:\n(a) Division 4 of Part 5 of Chapter 3 (Case management);\n(b) Division 4 of Part 6 of Chapter 4 (Case management);\napplies in relation to a proceeding commenced before, on or after the\ncommencement day.",
      "skos:definition": "The Federal Circuit and Family Court of Australia Act 2021, including\nthe following provisions of that Act:\n(a) Division 4 of Part 5 of Chapter 3 (Case management);\n(b) Division 4 of Part 6 of Chapter 4 (Case management);\napplies in relation to a proceeding commenced before, on or after the\ncommencement day.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-37-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-5-sec-37-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cd63c7ea2480aeff50dafce13908a5ac596a0a6a23bc548f7e4847c3bc862e75",
      "skos:note": "Applicable to proceedings commenced before, on or after the commencement day."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-5-sec-37",
      "@type": "cof:Section",
      "cof:title": "37 Application",
      "values:kind": "section",
      "cof:pageNumber": 237,
      "values:originalText": "The Federal Circuit and Family Court of Australia Act 2021, including\nthe following provisions of that Act:\n(a) Division 4 of Part 5 of Chapter 3 (Case management);\n(b) Division 4 of Part 6 of Chapter 4 (Case management);\napplies in relation to a proceeding commenced before, on or after the\ncommencement day."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-37-norm",
