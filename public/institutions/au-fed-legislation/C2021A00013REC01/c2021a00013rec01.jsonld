    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-130",
      "@type": "cml:Concept",
      "skos:prefLabel": "130 Subsection 35A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-130"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
