        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-304-logic-diffusion-4"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-304-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "3d4e8ced50ca7cd5cfd2beecf93a61c8b43459760193db49b6780a427c9c12cc",
      "skos:note": "Jurisdiction of courts under the Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-304",
      "@type": "cof:Section",
      "cof:title": "304 Section 82",
      "values:kind": "section",
      "cof:pageNumber": 119,
      "values:originalText": "Omit:\nUnder Part 2, the Federal Court and the Federal Circuit Court are\ngiven jurisdiction in relation to matters arising under the Act. Other\nprescribed courts have jurisdiction if the Act so provides.\nsubstitute:\nUnder Part 2, the Federal Court and the Federal Circuit and Family\nCourt of Australia (Division 2) are given jurisdiction in relation to\nmatters arising under the Act. Other prescribed courts have\njurisdiction if the Act so provides."
    },
