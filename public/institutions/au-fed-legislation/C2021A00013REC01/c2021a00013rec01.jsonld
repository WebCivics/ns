      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-11-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "equivalence",
      "cml:logicSummary": "Equates things done by, or in relation to, the Marshal or a Deputy with those done by, or in relation to, the Marshal or a Deputy of the specified court.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2021a00013rec01-sch-5-sec-11-logic-alleninterval-3",
