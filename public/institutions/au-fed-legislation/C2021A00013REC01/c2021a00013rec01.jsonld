        },
        {
          "@id": "concept:c2021a00013rec01-sch-1-sec-47a-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4574f727d270cc33abd11db48837200035e5e83a7ed07d0a0a463906740f67b7",
      "skos:note": "Appeal must be instituted within prescribed time"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-1-sec-47a-ss-3",
      "@type": "cof:Section",
      "cof:title": "47A(3) Appeals from courts of summary jurisdiction",
      "values:kind": "subsection",
      "cof:pageNumber": 28,
      "values:originalText": "(3) An appeal under subsection (1) must be instituted within:\n(a) in the case of an appeal to the Federal Circuit and Family\nCourt of Australia (Division 1):\n(i) the time prescribed by the Federal Circuit and Family\nCourt (Division 1) Rules; or\n(ii) such further time as is allowed in accordance with those\nRules; and\n(b) in any other case:\n(i) the time prescribed by the standard Rules of Court; or\n(ii) such further time as is allowed in accordance with those\nRules."
    },
