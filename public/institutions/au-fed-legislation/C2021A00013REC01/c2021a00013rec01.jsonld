      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Omit",
      "cml:logicSummary": "Prohibition on using outdated jurisdiction terminology",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
