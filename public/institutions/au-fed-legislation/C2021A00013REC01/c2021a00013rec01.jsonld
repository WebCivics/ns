    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Subsection 3(10)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.77",
      "values:originalText": "Omit all the words after “before the Federal Court”, substitute:\nby way of:\n(a) a transfer from the Federal Circuit and Family Court of\nAustralia (Division 2) by the Federal Court under\nsection 32AC of the Federal Court of Australia Act 1976; or\n(b) a transfer by the Federal Circuit and Family Court of\nAustralia (Division 2) to the Federal Court under section 153\nof the Federal Circuit and Family Court of Australia Act\n2021 that has been confirmed by the Federal Court under\nsection 32AD of the Federal Court of Australia Act 1976.",
      "skos:definition": "Omit all the words after “before the Federal Court”, substitute:\nby way of:\n(a) a transfer from the Federal Circuit and Family Court of\nAustralia (Division 2) by the Federal Court under\nsection 32AC of the Federal Court of Australia Act 1976; or\n(b) a transfer by the Federal Circuit and Family Court of\nAustralia (Division 2) to the Federal Court under section 153\nof the Federal Circuit and Family Court of Australia Act\n2021 that has been confirmed by the Federal Court under\nsection 32AD of the Federal Court of Australia Act 1976.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-19-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-19-logic-deontic-1"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-19-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-19-logic-ltl-3"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-19-logic-diffusion-4"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-19-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "4ee5ae6a849aa161f8e708168394bba804ac47a9d60fbc4184b07695a7290617",
      "skos:note": "Omit all words after 'before the Federal Court' and substitute with a transfer from the Federal Circuit and Family Court of Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Subsection 3(10)",
      "values:kind": "section",
      "cof:pageNumber": 77,
      "values:originalText": "Omit all the words after “before the Federal Court”, substitute:\nby way of:\n(a) a transfer from the Federal Circuit and Family Court of\nAustralia (Division 2) by the Federal Court under\nsection 32AC of the Federal Court of Australia Act 1976; or\n(b) a transfer by the Federal Circuit and Family Court of\nAustralia (Division 2) to the Federal Court under section 153\nof the Federal Circuit and Family Court of Australia Act\n2021 that has been confirmed by the Federal Court under\nsection 32AD of the Federal Court of Australia Act 1976."
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-19-norm",
