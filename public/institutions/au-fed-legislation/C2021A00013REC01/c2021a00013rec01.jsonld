    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-186",
      "@type": "cml:Concept",
      "skos:prefLabel": "186 At the end of section 16",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-186"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.102",
      "values:originalText": "Add:\n(2) Proceedings are also excluded proceedings to the extent that they\nare:\n(a) proceedings falling within the original or appellate\njurisdiction of the Federal Circuit and Family Court of\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nAustralia (Division 1) (see Part 2 of Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021); or\n(b) proceedings falling within the original jurisdiction of the\nFederal Circuit and Family Court of Australia (Division 2)\nunder section 132 of that Act.",
      "skos:definition": "Add:\n(2) Proceedings are also excluded proceedings to the extent that they\nare:\n(a) proceedings falling within the original or appellate\njurisdiction of the Federal Circuit and Family Court of\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nAustralia (Division 1) (see Part 2 of Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021); or\n(b) proceedings falling within the original jurisdiction of the\nFederal Circuit and Family Court of Australia (Division 2)\nunder section 132 of that Act.",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-186-norm"
        }
      ],
      "cml:integrityHash": "dd416e2f216a27dae4b4a04f329f7c8b57c4fceff1c57a89c8ee8bbc31064c66",
      "skos:note": "Proceedings are excluded from the extent that they fall within the original or appellate jurisdiction of the Federal Circuit and Family Court of Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-186",
      "@type": "cof:Section",
      "cof:title": "186 At the end of section 16",
      "values:kind": "section",
      "cof:pageNumber": 102,
      "values:originalText": "Add:\n(2) Proceedings are also excluded proceedings to the extent that they\nare:\n(a) proceedings falling within the original or appellate\njurisdiction of the Federal Circuit and Family Court of\n\nFurther consequential amendments  Schedule 2\n\nNo. 13, 2021\nFederal Circuit and Family Court of Australia (Consequential\nAmendments and Transitional Provisions) Act 2021\nAustralia (Division 1) (see Part 2 of Chapter 3 of the Federal\nCircuit and Family Court of Australia Act 2021); or\n(b) proceedings falling within the original jurisdiction of the\nFederal Circuit and Family Court of Australia (Division 2)\nunder section 132 of that Act."
    },
