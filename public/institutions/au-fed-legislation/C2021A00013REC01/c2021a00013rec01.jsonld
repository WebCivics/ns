    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-182",
      "@type": "cml:Concept",
      "skos:prefLabel": "182 Paragraph 110W(2)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-182"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.102",
      "values:originalText": "Repeal the paragraph, substitute:\n(a) a decision is a decision of the Full Court of the Federal\nCircuit and Family Court of Australia (Division 1); and",
      "skos:definition": "Repeal the paragraph, substitute:\n(a) a decision is a decision of the Full Court of the Federal\nCircuit and Family Court of Australia (Division 1); and",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-182-norm"
        },
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-182-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e2a18889a62df119a29192c6c10c47f9099d3f02763164cab118afbd8ffbfaef",
      "skos:note": "Repeal and substitute a decision with the Full Court of the Federal Circuit and Family Court of Australia (Division 1)"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-182",
      "@type": "cof:Section",
      "cof:title": "182 Paragraph 110W(2)(a)",
      "values:kind": "section",
      "cof:pageNumber": 102,
      "values:originalText": "Repeal the paragraph, substitute:\n(a) a decision is a decision of the Full Court of the Federal\nCircuit and Family Court of Australia (Division 1); and"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-182-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2021a00013rec01-sch-2-sec-182"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-182-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Repeal",
      "cml:logicSummary": "Obligation to repeal",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
