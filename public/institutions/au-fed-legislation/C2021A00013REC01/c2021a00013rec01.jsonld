    {
      "@id": "concept:c2021a00013rec01-sch-2-sec-3b",
      "@type": "cml:Concept",
      "skos:prefLabel": "3B Service in more than one judicial office",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-3b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2021a00013rec01.pdf"
      },
      "dc:source": "c2021a00013rec01.pdf, p.145",
      "values:originalText": "To avoid doubt, a person may satisfy the definition of Judge at a\nparticular time even if the person also holds, at the same time, an\noffice as a Judge of the Federal Circuit and Family Court of\nAustralia (Division 2).\nNote:\nSee paragraph (a) of the definition of Judge in section 3.\nJudges’ Pensions Act 1968",
      "skos:definition": "To avoid doubt, a person may satisfy the definition of Judge at a\nparticular time even if the person also holds, at the same time, an\noffice as a Judge of the Federal Circuit and Family Court of\nAustralia (Division 2).\nNote:\nSee paragraph (a) of the definition of Judge in section 3.\nJudges’ Pensions Act 1968",
      "cml:asserts": [
        {
          "@id": "concept:c2021a00013rec01-sch-2-sec-3b-norm"
        }
      ],
      "cml:integrityHash": "8818902754e383f61c4265d020da433b97c14ad721aedf79d6ddb292ff3f7e71",
      "skos:note": "A person may satisfy the definition of Judge even if holding another office."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2021a00013rec01#sch-2-sec-3b",
      "@type": "cof:Section",
      "cof:title": "3B Service in more than one judicial office",
      "values:kind": "section",
      "cof:pageNumber": 145,
      "values:originalText": "To avoid doubt, a person may satisfy the definition of Judge at a\nparticular time even if the person also holds, at the same time, an\noffice as a Judge of the Federal Circuit and Family Court of\nAustralia (Division 2).\nNote:\nSee paragraph (a) of the definition of Judge in section 3.\nJudges’ Pensions Act 1968"
    },
    {
