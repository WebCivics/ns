      "cml:logicSummary": "Request for supply of scheme information occurs within a specific time frame",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "The Australian repairer or scheme RTO requests the data provider to supply the scheme information in writing, and pays or offers to pay the scheme price"
    },
    {
      "@id": "concept:c2021a00054-sch-1-sec-57cb-ss-1-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The request for supply of scheme information implies that the data provider must supply the scheme information",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.6000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Request for supply of scheme information implies that data provider must supply scheme information",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:premiseText": "If the Australian repairer or scheme RTO requests the data provider to supply the scheme information, then the data provider must supply the scheme information"
    },
    {
      "@id": "concept:c2021a00054-sch-1-sec-57cb-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The request for supply of scheme information can be inferred from other information",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Request for supply of scheme information can be inferred from other information",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Inference",
      "cml:premiseText": "If the Australian repairer or scheme RTO requests the data provider to supply the scheme information, then it can be inferred that the request is related to a specific make, model and year of scheme vehicle"
    },
    {
