concept:c2021a00054-sch-1-sec-57da a cml:Concept ;
    skos:prefLabel "57DA Safety and security information—packaging"@en ;
    cml:realizedBy doc:sch-1-sec-57da ;
    values:originalText "A data provider must, in a scheme offer, separate safety and security information from other scheme information to the extent it is reasonably practicable to do so. Civil penalty:  (a) for a body corporate—600 penalty units; and  (b) for a person other than a body corporate—120 penalty units.  Schedule 1  Motor vehicle service and repair information sharing scheme" ;
    skos:definition "A data provider must, in a scheme offer, separate safety and security information from other scheme information to the extent it is reasonably practicable to do so. Civil penalty:  (a) for a body corporate—600 penalty units; and  (b) for a person other than a body corporate—120 penalty units.  Schedule 1  Motor vehicle service and repair information sharing scheme"@en ;
    cml:integrityHash "bc6a9e4a579764d9429c1745a826d7a21e6dbd87f0caebbf917b020e3a0958b5" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Separate safety and security information from other scheme information." ;
    dc:description "yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
