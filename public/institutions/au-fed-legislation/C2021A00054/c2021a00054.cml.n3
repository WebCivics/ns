concept:c2021a00054-sch-1-sec-57bg a cml:Concept ;
    skos:prefLabel "57BG Supply of scheme information between related bodies"@en ;
    cml:realizedBy doc:sch-1-sec-57bg ;
    values:originalText "corporate  To avoid doubt, this Part applies in relation to a supply of scheme information about a scheme vehicle from a data provider to an Australian repairer even if the data provider and the Australian repairer are related bodies corporate." ;
    skos:definition "corporate  To avoid doubt, this Part applies in relation to a supply of scheme information about a scheme vehicle from a data provider to an Australian repairer even if the data provider and the Australian repairer are related bodies corporate."@en ;
    cml:integrityHash "393d998c06ca0a170855a2deb1ed0f9eace4328248412f65eea64b694e3bac31" ;
