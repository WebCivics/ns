doc:sch-1-sec-57fb-ss-4 a cof:Section ;
    cof:title "57FB(4) Scheme adviser—functions" ;
    values:kind "subsection" ;
    values:originalText "(4) Section 34C of the Acts Interpretation Act 1901 does not apply in relation to a report mentioned in this section. Note: Section 34C of the Acts Interpretation Act 1901 would otherwise require any periodic reports to be given to the Minister and tabled in Parliament." ;
    cof:pageNumber "28"^^xsd:integer .

concept:c2021a00054-sch-1-sec-57ga a cml:Concept ;
    skos:prefLabel "57GA Civil penalty provisions"@en ;
    cml:realizedBy doc:sch-1-sec-57ga ;
    values:originalText "A provision of this Part that is of one of the following kinds and sets out at its foot a pecuniary penalty indicated by the words “civil penalty” is a civil penalty provision for the purposes of this Part and paragraphs 76(1A)(cc) and (1B)(aac):  (a) a subsection;  (b) a section that is not divided into subsections." ;
    skos:definition "A provision of this Part that is of one of the following kinds and sets out at its foot a pecuniary penalty indicated by the words “civil penalty” is a civil penalty provision for the purposes of this Part and paragraphs 76(1A)(cc) and (1B)(aac):  (a) a subsection;  (b) a section that is not divided into subsections."@en ;
    cml:integrityHash "0df7dd6bdb3bda0a612d63086a2d092f77fe3703ef7bac307a7b886c0513e1e0" ;
    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Defines civil penalty provisions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
