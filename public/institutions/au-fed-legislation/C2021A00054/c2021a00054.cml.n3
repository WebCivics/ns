concept:c2021a00054-sch-1-sec-57eb a cml:Concept ;
    skos:prefLabel "57EB Resolving disputes"@en ;
    cml:realizedBy doc:sch-1-sec-57eb ;
    values:originalText "A party to the dispute (the initiating party) may initiate action to resolve the dispute against another party (the responding party) in accordance with the procedure set out in this Division." ;
    skos:definition "A party to the dispute (the initiating party) may initiate action to resolve the dispute against another party (the responding party) in accordance with the procedure set out in this Division."@en ;
