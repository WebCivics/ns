concept:c2021a00054-sch-1-sec-27 a cml:Concept ;
    skos:prefLabel "27 At the end of paragraph 113P(1)(b)"@en ;
    cml:realizedBy doc:sch-1-sec-27 ;
    values:originalText "Add:  (iv) a work comprising scheme information within the meaning of Part IVE of the Competition and Consumer Act 2010 (which provides for a motor vehicle service and repair information sharing scheme); and     No. 54, 2021 Competition and Consumer Amendment (Motor Vehicle Service and Repair Information Sharing Scheme) Act 2021  [Minister’s second reading speech made in— House of Representatives on 24 March 2021 Senate on 15 June 2021]  (41/21)" ;
    skos:definition "Add:  (iv) a work comprising scheme information within the meaning of Part IVE of the Competition and Consumer Act 2010 (which provides for a motor vehicle service and repair information sharing scheme); and     No. 54, 2021 Competition and Consumer Amendment (Motor Vehicle Service and Repair Information Sharing Scheme) Act 2021  [Minister’s second reading speech made in— House of Representatives on 24 March 2021 Senate on 15 June 2021]  (41/21)"@en ;
    cml:integrityHash "1fdf5ca11f248736dde736a8f9edfbc4c84e141c2a3cbf9e8b25cb716b6a782f" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Add scheme information within the meaning of Part IVE of the Competition and Consumer Act 2010" ;
    cml:curationStatus cml:Proposed ;
