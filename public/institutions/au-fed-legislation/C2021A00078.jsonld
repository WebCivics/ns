      "cml:operator": "Recognizes",
      "cml:premiseText": "The Act authorizes disclosure of information."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-169-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Disclosure is authorized if it complies with an order or request from a foreign country.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorization",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:premiseText": "The Act authorizes disclosure of information."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-169-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Personal information diffuses if it is disclosed in compliance with an order or request from a foreign country.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
