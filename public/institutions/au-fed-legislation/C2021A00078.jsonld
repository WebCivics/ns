      "@type": "cml:LogicApplication",
      "cml:conclusionText": "it is necessary to make an application under Part 2 or 3 of this Schedule for an international production order by telephone if, and only if:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Urgent circumstances necessitate the application.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Necessity",
      "cml:premiseText": "an imminent risk of serious harm to a person or substantial damage to property exists"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-17a-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "the order is necessary for the purpose of dealing with that risk; and",
      "cml:confidence": {
        "@type": "xsd:decimal",
