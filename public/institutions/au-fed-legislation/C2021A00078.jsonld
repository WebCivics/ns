      "cml:logicSummary": "Reasonable grounds exist for suspecting the communications provider holds certain data",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "there are reasonable grounds for suspecting that the prescribed communications provider holds, or is likely to commence to hold, any of the following telecommunications data"
