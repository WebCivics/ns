      },
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:logicSummary": "Validation of data against schema",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "Validation",
      "cml:premiseText": "(a) is in respect of a particular person (the relevant person); and (b) is directed to a prescribed communications provider."
    },
