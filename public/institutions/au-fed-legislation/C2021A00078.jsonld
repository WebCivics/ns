      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The clause applies if the issuing authority has an international production order that overlaps with the control order IPO agency's application under clause 72.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Temporal overlap between clauses",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:premiseText": "(a) is in respect of a particular person (the relevant person); and (b) is directed to a prescribed communications provider."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-78-ss-1-logic-cogai-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The control order IPO agency must recognize the individual or entity as a particular person for the purposes of this clause.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "Recognition of entities and individuals",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Entity recognition",
      "cml:premiseText": "(a) is in respect of a particular person (the relevant person); and (b) is directed to a prescribed communications provider."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-78-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The control order IPO agency must not apply under clause 72 to an issuing authority for an international production order that is in respect of a particular person and directed to a prescribed communications provider.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Prohibition of action",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:premiseText": "(a) is in respect of a particular person (the relevant person); and (b) is directed to a prescribed communications provider."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-78-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The control order IPO agency must not apply under clause 72 to an issuing authority for an international production order that is recurring in nature.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Recurring trace of actions",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:premiseText": "(a) is in respect of a particular person (the relevant person); and (b) is directed to a prescribed communications provider."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-78-ss-1-logic-shacl-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The control order IPO agency must validate the issuing authority's application under clause 72 against this schema.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
