    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13b-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Australian Designated Authority official means: (a) the Australian Designated Authority; or (b) a person who: (i) is an APS employee in the Department administered by the Attorney-General; and (ii) has duties relating to the functions or powers of the Australian Designated Authority under Schedule 1 to the Telecommunications (Interception and Access) Act 1979.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Identifies the same meaning as in Schedule 1 to the Telecommunications (Interception and Access) Act 1979",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "same-as",
      "cml:premiseText": "Australian Designated Authority has the same meaning as in Schedule 1 to the Telecommunications (Interception and Access) Act 1979."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13b-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "IPO information means: (a) protected information within the meaning of Schedule 1 to the Telecommunications (Interception and Access) Act 1979; or (b) information relevant to the operation of that Schedule.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Identifies the same meaning as in the Telecommunications (Interception and Access) Act 1979",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "same-as",
      "cml:premiseText": "IGIS official has the same meaning as in the Telecommunications (Interception and Access) Act 1979."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13b-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
