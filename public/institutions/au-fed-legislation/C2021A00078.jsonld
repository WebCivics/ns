    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-126-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The civil penalty provision is enforceable.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Enforceability of civil penalty provisions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "enforceable",
      "cml:premiseText": "(1) A civil penalty provision in this Part is enforceable under Part 4 of the Regulatory Powers (Standard Provisions) Act 2014."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-126-ss-1-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The part is allowed to enforce the civil penalty provision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorization to enforce civil penalty provisions",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "allowedBy",
      "cml:premiseText": "Part 4 of the Regulatory Powers (Standard Provisions) Act 2014 allows a civil penalty provision to be enforced by obtaining an order for a person to pay a pecuniary penalty for the contravention of the provision."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-126-ss-1-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The enforcement mechanism is by obtaining an order for a person to pay a pecuniary penalty for the contravention of the provision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Enforcement mechanism",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "by",
      "cml:premiseText": "(1) A civil penalty provision in this Part is enforceable under Part 4 of the Regulatory Powers (Standard Provisions) Act 2014."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-126-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The purpose of enforcement is for a person to pay a pecuniary penalty for the contravention of the provision.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
