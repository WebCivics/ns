      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "It is not practicable in the circumstances to make the application in writing.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Practicability",
      "cml:premiseText": "it is not practicable in the circumstances to make the application in writing"
