      "@type": "cml:Concept",
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.110",
      "skos:note": "Control order IPO agency must not apply under clause 72 to an issuing authority for an international production order that is in respect of a particular person and directed to a prescribed communications provider.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "78(1) Issue of international production order—control order"
