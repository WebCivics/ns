doc:sch-1-sec-7-2-ss-2 a cof:Section ;
    cof:title "7(2) Storage/back-up service" ;
    values:kind "subsection" ;
    values:originalText "(2) For the purposes of this Schedule, a person does not provide a storage/back-up service merely because the person supplies a transmission service that enables material to be uploaded for storage or back-up." ;
    cof:pageNumber "40"^^xsd:integer .

