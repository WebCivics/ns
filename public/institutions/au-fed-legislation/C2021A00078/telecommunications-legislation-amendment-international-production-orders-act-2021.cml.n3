concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-5b a cml:Concept ;
    skos:prefLabel "5B After paragraph 29(1)(be)"@en ;
    cml:realizedBy doc:sch-1-sec-5b ;
    values:originalText "Insert:  (bf) to commence, by the earlier of the following:  (i) the fifth anniversary of the day on which Schedule 1 to the Telecommunications (Interception and Access) Act 1979 commences;  (ii) the third anniversary of the day on which the first designated international agreement (within the meaning of that Schedule) enters into force for Australia;  a review of the operation, effectiveness and implications of that Schedule; and International Criminal Court Act 2002" ;
    skos:definition "Insert:  (bf) to commence, by the earlier of the following:  (i) the fifth anniversary of the day on which Schedule 1 to the Telecommunications (Interception and Access) Act 1979 commences;  (ii) the third anniversary of the day on which the first designated international agreement (within the meaning of that Schedule) enters into force for Australia;  a review of the operation, effectiveness and implications of that Schedule; and International Criminal Court Act 2002"@en ;
    cml:integrityHash "e31d30bc27550b00851fafdbad2e2637d14b698d51bb991e5180b3384aac32f1" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Conditional commencement of Schedule 1 to the Telecommunications (Interception and Access) Act 1979" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
