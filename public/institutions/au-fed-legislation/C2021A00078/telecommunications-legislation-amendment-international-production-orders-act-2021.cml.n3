concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-151 a cml:Concept ;
    skos:prefLabel "151 Simplified outline of this Part"@en ;
    cml:realizedBy doc:sch-1-sec-151 ;
    values:originalText "• Protected information must not be used, recorded or disclosed, unless an exception applies. • Protected information must not be admitted in evidence, unless an exception applies." ;
    skos:definition "• Protected information must not be used, recorded or disclosed, unless an exception applies. • Protected information must not be admitted in evidence, unless an exception applies."@en ;
    cml:integrityHash "db6f1f86a32d863d729bea7b6e8350ad2da256a02375e27923bc16b45c614998" ;
    cof:pageNumber "190"^^xsd:integer ;
    skos:note "Protected information cannot be used, recorded or disclosed without an exception." ;
    cml:curationStatus cml:Proposed ;
