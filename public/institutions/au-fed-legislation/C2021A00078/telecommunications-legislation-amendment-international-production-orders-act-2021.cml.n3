concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-96 a cml:Concept ;
    skos:prefLabel "96 Information to be given on telephone application"@en ;
    cml:realizedBy doc:sch-1-sec-96 ;
    values:originalText "The information given to a nominated AAT Security Division member in connection with a telephone application under clause 92 to the nominated AAT Security Division member:  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021  (a) must include particulars of the urgent circumstances because of which the person making the application on the Organisation’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 94 or 95 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the nominated AAT Security Division member directs." ;
    skos:definition "The information given to a nominated AAT Security Division member in connection with a telephone application under clause 92 to the nominated AAT Security Division member:  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021  (a) must include particulars of the urgent circumstances because of which the person making the application on the Organisation’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 94 or 95 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the nominated AAT Security Division member directs."@en ;
    cml:integrityHash "ebc79151d9e6fbfdf6c008a0ab28e50b3cbdbd44d4ddc8ef8a152e81a6c7f238" ;
    cof:pageNumber "134"^^xsd:integer ;
    skos:note "Must provide information on telephone application" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
