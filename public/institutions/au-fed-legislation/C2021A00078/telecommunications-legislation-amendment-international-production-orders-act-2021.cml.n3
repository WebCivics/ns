doc:sch-1-sec-117-ss-2 a cof:Section ;
    cof:title "117(2) Giving of instrument of revocation—the Organisation" ;
    values:kind "subsection" ;
    values:originalText "(2) If:  (a) the Australian Designated Authority gave an international production order to the prescribed communications provider to whom the order is directed; and  (b) the order was subsequently revoked under clause 116; the Australian Designated Authority must:  (c) give the instrument of revocation to the prescribed communications provider; and  (d) do so as soon as practicable after the instrument of revocation is given to the Australian Designated Authority." ;
    cof:pageNumber "154"^^xsd:integer .

concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-117-ss-3 a cml:Concept ;
    skos:prefLabel "117(3) Giving of instrument of revocation—the Organisation"@en ;
    cml:realizedBy doc:sch-1-sec-117-ss-3 ;
    values:originalText "(3) A revocation under clause 116 takes effect:  (a) if the instrument of revocation is required to be given to the prescribed communications provider concerned—when the instrument is given; or  (b) otherwise—when the revocation is made." ;
    skos:definition "(3) A revocation under clause 116 takes effect:  (a) if the instrument of revocation is required to be given to the prescribed communications provider concerned—when the instrument is given; or  (b) otherwise—when the revocation is made."@en ;
    cml:integrityHash "1b70e634d1ef81e336a20781785ff5606904b3cb31ba6603d5d0b712e158b974" ;
    values:partOf concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-117 ;
    cof:pageNumber "154"^^xsd:integer ;
    skos:note "Revocation takes effect upon giving of instrument or at the time of revocation." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
