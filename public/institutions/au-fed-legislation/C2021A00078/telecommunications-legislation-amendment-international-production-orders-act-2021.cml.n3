concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-174 a cml:Concept ;
    skos:prefLabel "174 Certified copy of international production order—interception"@en ;
    cml:realizedBy doc:sch-1-sec-174 ;
    values:originalText "agency  (1) A document certified in writing by a certifying officer of an interception agency to be a true copy of an international production order issued under clause 30 is to be received in evidence in a proceeding mentioned in clause 153 or 157 as if it were the original international production order.  (2) The document is to be known as a certified copy of the original international production order." ;
    skos:definition "agency  (1) A document certified in writing by a certifying officer of an interception agency to be a true copy of an international production order issued under clause 30 is to be received in evidence in a proceeding mentioned in clause 153 or 157 as if it were the original international production order.  (2) The document is to be known as a certified copy of the original international production order."@en ;
    cml:integrityHash "c4b2af4722ee54e317672875b2d8cf49aa884bf5820ec6091114fea5ec6560e4" ;
    cof:pageNumber "223"^^xsd:integer ;
