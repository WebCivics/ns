concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-41-2 a cml:Concept ;
    skos:prefLabel "41 Issue of further international production order"@en ;
    cml:realizedBy doc:sch-1-sec-41-2 ;
    values:originalText "If:  (a) an international production order (the original order) was issued under clause 39; and  (b) the original order was in respect of a particular person; and  (c) the original order was directed to a prescribed communications provider; this Schedule does not prevent the issue of a further international production order under clause 39 that:  (d) is in respect of the person; and  (e) is directed to the provider.  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021" ;
    skos:definition "If:  (a) an international production order (the original order) was issued under clause 39; and  (b) the original order was in respect of a particular person; and  (c) the original order was directed to a prescribed communications provider; this Schedule does not prevent the issue of a further international production order under clause 39 that:  (d) is in respect of the person; and  (e) is directed to the provider.  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021"@en ;
    cml:integrityHash "d9e554bb142db48a7ae856b0e845ab9e97ba71d066f6e2eacd4a9192a3dcae49" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Issue of further international production order under clause 39 that is in respect of the person and directed to the provider." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-international-production-orders-act-2021.pdf> ;
