doc:sch-1-sec-36-2-ss-1 a cof:Section ;
    cof:title "36(1) Affidavits to accompany written application" ;
    values:kind "subsection" ;
    values:originalText "(1) An application under clause 33 must, if it is in writing, be accompanied by an affidavit complying with this clause." ;
    cof:pageNumber "66"^^xsd:integer .

