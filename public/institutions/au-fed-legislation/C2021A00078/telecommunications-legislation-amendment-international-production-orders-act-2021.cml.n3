concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-12-2 a cml:Concept ;
    skos:prefLabel "12 Use of a thing"@en ;
    cml:realizedBy doc:sch-1-sec-12-2 ;
    values:originalText "A reference in this Schedule to the use of a thing is a reference to the use of the thing either:  (a) in isolation; or  (b) in conjunction with one or more other things. Note: See also section 18A of the Acts Interpretation Act 1901." ;
    skos:definition "A reference in this Schedule to the use of a thing is a reference to the use of the thing either:  (a) in isolation; or  (b) in conjunction with one or more other things. Note: See also section 18A of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "f307d3f30366556719cf9bbb34178fb83263c2a28f4dc55790c7c898d22e9e9a" ;
    cof:pageNumber "42"^^xsd:integer ;
    skos:note "Reference to use of a thing is in isolation or conjunction with other things." ;
