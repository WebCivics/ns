concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-50 a cml:Concept ;
    skos:prefLabel "50 Issue of further international production order"@en ;
    cml:realizedBy doc:sch-1-sec-50 ;
    values:originalText "If:  (a) an international production order (the original order) was issued under clause 48; and  (b) the original order was directed to a prescribed communications provider; and  (c) the original order relates to the investigation by an enforcement agency of a serious category 1 offence, or serious category 1 offences; this Schedule does not prevent the issue of a further international production order under clause 48 that:  (d) is directed to the provider; and  (e) relates to the investigation by the enforcement agency of that offence or those offences.  Schedule 1  Amendments" ;
    skos:definition "If:  (a) an international production order (the original order) was issued under clause 48; and  (b) the original order was directed to a prescribed communications provider; and  (c) the original order relates to the investigation by an enforcement agency of a serious category 1 offence, or serious category 1 offences; this Schedule does not prevent the issue of a further international production order under clause 48 that:  (d) is directed to the provider; and  (e) relates to the investigation by the enforcement agency of that offence or those offences.  Schedule 1  Amendments"@en ;
    cml:integrityHash "6b8c5e486ab7fcb2ed877ff6e4c686a159361509d406c8049f9e32a9fd03d7d6" ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Issue of further international production order under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-international-production-orders-act-2021.pdf> ;
    dc:source "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.79" ;
