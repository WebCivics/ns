doc:sch-1-sec-14-2-ss-3 a cof:Section ;
    cof:title "14(3) Eligible judge" ;
    values:kind "subsection" ;
    values:originalText "(3) The Attorney-General may, by writing, declare Judges in relation to whom consents are in force under subclause (2) to be eligible Judges for the purposes of this Schedule." ;
    cof:pageNumber "43"^^xsd:integer .

concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-14-2-ss-4 a cml:Concept ;
