concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-184 a cml:Concept ;
    skos:prefLabel "184 Other functions or powers not limited"@en ;
    cml:realizedBy doc:sch-1-sec-184 ;
    values:originalText "This Schedule is not intended to limit the functions or powers of:  (a) a relevant agency; or  (b) the Organisation; or  (c) any other body or person; to request or obtain assistance or information from:  (d) a prescribed communications provider; or  (e) any other body or person.  Amendments  Schedule 1 Application provisions  Part 2  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021" ;
    skos:definition "This Schedule is not intended to limit the functions or powers of:  (a) a relevant agency; or  (b) the Organisation; or  (c) any other body or person; to request or obtain assistance or information from:  (d) a prescribed communications provider; or  (e) any other body or person.  Amendments  Schedule 1 Application provisions  Part 2  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021"@en ;
    cml:integrityHash "72487667668112601d86df2f9a651cd1fdd4a524a6cec54ba8347bc25400fda1" ;
    cof:pageNumber "228"^^xsd:integer ;
    skos:note "Request for assistance or information from a prescribed communications provider is not limited." ;
