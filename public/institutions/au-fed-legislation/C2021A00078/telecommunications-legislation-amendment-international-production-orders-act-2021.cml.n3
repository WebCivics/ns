    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-70-ss-3 ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-70-ss-4 ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-70-ss-5 ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-70-ss-6 ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-70-ss-7 ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-70-ss-8 ;
