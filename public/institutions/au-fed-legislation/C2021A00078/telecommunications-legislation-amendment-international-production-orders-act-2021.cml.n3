concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-109 a cml:Concept ;
    skos:prefLabel "109 Issue of further international production order"@en ;
    cml:realizedBy doc:sch-1-sec-109 ;
    values:originalText "If:  (a) an international production order (the original order) was issued under clause 107; and  (b) the original order was in respect of a particular person; and  (c) the original order was directed to a prescribed communications provider; this Schedule does not prevent the issue of a further international production order under clause 107 that:  (d) is in respect of the person; and  (e) is directed to the provider." ;
    skos:definition "If:  (a) an international production order (the original order) was issued under clause 107; and  (b) the original order was in respect of a particular person; and  (c) the original order was directed to a prescribed communications provider; this Schedule does not prevent the issue of a further international production order under clause 107 that:  (d) is in respect of the person; and  (e) is directed to the provider."@en ;
    cml:integrityHash "e79b7cff3c57bcfb88cfc7c26813889b68f79a66e3fc049cca9f88eb5de86624" ;
    cof:pageNumber "147"^^xsd:integer ;
    skos:note "Issue of further international production order under clause 107 that is in respect of the person and directed to the provider." ;
