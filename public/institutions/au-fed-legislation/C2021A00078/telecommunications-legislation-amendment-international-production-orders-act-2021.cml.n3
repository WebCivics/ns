concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-61-ss-8 a cml:Concept ;
    skos:prefLabel "61(8) Content of international production order"@en ;
    cml:realizedBy doc:sch-1-sec-61-ss-8 ;
    values:originalText "(8) If the order directs a prescribed communications provider to disclose telecommunications data to the control order IPO agency, the order may require the provider to disclose that data to the agency in a specified way." ;
    skos:definition "(8) If the order directs a prescribed communications provider to disclose telecommunications data to the control order IPO agency, the order may require the provider to disclose that data to the agency in a specified way."@en ;
