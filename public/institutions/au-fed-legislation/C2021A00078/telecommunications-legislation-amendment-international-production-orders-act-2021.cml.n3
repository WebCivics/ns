concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-4-2-ss-4 a cml:Concept ;
    skos:prefLabel "4(4) Message application service"@en ;
    cml:realizedBy doc:sch-1-sec-4-2-ss-4 ;
    values:originalText "(4) For the purposes of this Schedule, a person does not provide a message application service merely because the person provides a billing service, or a fee collection service, in relation to a message application service." ;
    skos:definition "(4) For the purposes of this Schedule, a person does not provide a message application service merely because the person provides a billing service, or a fee collection service, in relation to a message application service."@en ;
    cml:integrityHash "8682c46cd146ada43226cf14989ce28fe0247cf321983b76930c8e680f3f99b2" ;
