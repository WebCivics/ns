concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-131-ss-4 a cml:Concept ;
    skos:prefLabel "131(4) Annual reports by the Minister"@en ;
    cml:realizedBy doc:sch-1-sec-131-ss-4 ;
    values:originalText "(4) For the purposes of section 34C of the Acts Interpretation Act 1901, a report that subclause (1) requires to be prepared as soon as practicable after the end of a financial year is taken to be a periodic report that this Act requires a person to furnish to the Minister and that relates to the administration of this Schedule during the financial year." ;
    skos:definition "(4) For the purposes of section 34C of the Acts Interpretation Act 1901, a report that subclause (1) requires to be prepared as soon as practicable after the end of a financial year is taken to be a periodic report that this Act requires a person to furnish to the Minister and that relates to the administration of this Schedule during the financial year."@en ;
    cml:integrityHash "81061c4b7ce3bad1cb81dfafe57386b073ecb35e46ad19927687d4f3e7202521" ;
    values:partOf concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-131 ;
    cof:pageNumber "164"^^xsd:integer ;
    skos:note "Annual reports by the Minister are required." ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
