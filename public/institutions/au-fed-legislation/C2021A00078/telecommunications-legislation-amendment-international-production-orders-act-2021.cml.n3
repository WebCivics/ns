concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-67 a cml:Concept ;
    skos:prefLabel "67 Information to be given on telephone application"@en ;
    cml:realizedBy doc:sch-1-sec-67 ;
    values:originalText "The information given to an issuing authority in connection with a telephone application under clause 63 to the issuing authority:  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021  (a) must include particulars of the urgent circumstances because of which the person making the application on the control order IPO agency’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 65 or 66 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the issuing authority directs." ;
    skos:definition "The information given to an issuing authority in connection with a telephone application under clause 63 to the issuing authority:  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021  (a) must include particulars of the urgent circumstances because of which the person making the application on the control order IPO agency’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 65 or 66 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the issuing authority directs."@en ;
    cml:integrityHash "97cf5546968f869b6cc38a7c0c2d8e6f5fb26ccfb43aec5b200f10af8bd70d1b" ;
    cof:pageNumber "100"^^xsd:integer ;
    skos:note "Information must be provided on telephone application" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
