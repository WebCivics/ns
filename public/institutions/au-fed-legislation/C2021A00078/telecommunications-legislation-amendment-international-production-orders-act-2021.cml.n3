    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79-ss-5 ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79-ss-6 ;
    cml:curationStatus cml:Proposed ;
