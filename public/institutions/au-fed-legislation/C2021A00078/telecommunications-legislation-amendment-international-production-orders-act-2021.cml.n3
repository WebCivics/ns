concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3a-ss-4 a cml:Concept ;
    skos:prefLabel "3A(4) Disallowance of regulations relating to designated international"@en ;
    cml:realizedBy doc:sch-1-sec-3a-ss-4 ;
    values:originalText "(4) If:  (a) notice of a motion to disallow the regulations is given in a House of the Parliament within 15 sitting days of that House after the copy of the regulations was tabled in that House under section 38 of the Legislation Act 2003; and  (b) at the end of 15 sitting days of that House after the giving of that notice of motion:  (i) the notice has not been withdrawn and the motion has not been called on; or  (ii) the motion has been called on, moved and (where relevant) seconded and has not been withdrawn or otherwise disposed of;  Schedule 1  Amendments" ;
    skos:definition "(4) If:  (a) notice of a motion to disallow the regulations is given in a House of the Parliament within 15 sitting days of that House after the copy of the regulations was tabled in that House under section 38 of the Legislation Act 2003; and  (b) at the end of 15 sitting days of that House after the giving of that notice of motion:  (i) the notice has not been withdrawn and the motion has not been called on; or  (ii) the motion has been called on, moved and (where relevant) seconded and has not been withdrawn or otherwise disposed of;  Schedule 1  Amendments"@en ;
    cml:integrityHash "8f94c1cc7401c7c8f09dd47f44fe1fc15c1fa8de303a4b7c42420209d1f132db" ;
    values:partOf concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3a ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Disallowance of regulations relating to designated international" ;
