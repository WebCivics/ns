concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-105 a cml:Concept ;
    skos:prefLabel "105 Information to be given on telephone application"@en ;
    cml:realizedBy doc:sch-1-sec-105 ;
    values:originalText "The information given to a nominated AAT Security Division member in connection with a telephone application under clause 101 to the nominated AAT Security Division member:  (a) must include particulars of the urgent circumstances because of which the person making the application on the Organisation’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 103 or 104 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the nominated AAT Security Division member directs.  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021" ;
    skos:definition "The information given to a nominated AAT Security Division member in connection with a telephone application under clause 101 to the nominated AAT Security Division member:  (a) must include particulars of the urgent circumstances because of which the person making the application on the Organisation’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 103 or 104 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the nominated AAT Security Division member directs.  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021"@en ;
    cml:integrityHash "23a8b4fefd205dd196d5d065d8b6a699a233a48b99de11ef013cd938acd4a091" ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "Must provide information on telephone application" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
