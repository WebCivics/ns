doc:sch-1-sec-63-ss-3 a cof:Section ;
    cof:title "63(3) Application for international production order—control order" ;
    values:kind "subsection" ;
    values:originalText "(3) The application must be made on the control order IPO agency’s behalf by:  (a) if the agency is referred to in subclause 22(3)—a person referred to in that subclause in relation to the agency; or  (b) otherwise:  (i) the chief officer of the agency; or  (ii) an officer of the agency (by whatever name called) who holds, or is acting in, an office or position in the agency nominated under subclause (4)." ;
    cof:pageNumber "99"^^xsd:integer .

concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-63-ss-4 a cml:Concept ;
    skos:prefLabel "63(4) Application for international production order—control order"@en ;
    cml:realizedBy doc:sch-1-sec-63-ss-4 ;
    values:originalText "(4) The chief officer of the control order IPO agency may, in writing, nominate for the purposes of subparagraph (3)(b)(ii) an office or position in the agency that is involved in the management of the agency." ;
    skos:definition "(4) The chief officer of the control order IPO agency may, in writing, nominate for the purposes of subparagraph (3)(b)(ii) an office or position in the agency that is involved in the management of the agency."@en ;
    cml:integrityHash "63e0a921b77328db4416a3e2ccd8f80c3d8a5e4b5dde580df9571e53dd6369fc" ;
    values:partOf concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-63 ;
    cof:pageNumber "99"^^xsd:integer ;
    skos:note "Nomination of office or position in the agency for management purposes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
