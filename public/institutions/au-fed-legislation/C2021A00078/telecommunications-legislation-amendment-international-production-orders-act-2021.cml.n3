doc:sch-1-sec-104-ss-1 a cof:Section ;
    cof:title "104(1) Affidavits to accompany written application" ;
    values:kind "subsection" ;
    values:originalText "(1) An application under clause 101 must, if it is in writing, be accompanied by an affidavit complying with this clause." ;
    cof:pageNumber "142"^^xsd:integer .

