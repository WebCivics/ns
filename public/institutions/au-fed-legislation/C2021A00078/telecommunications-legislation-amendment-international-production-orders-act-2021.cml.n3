doc:sch-1-sec-116 a cof:Section ;
    cof:title "116 Revocation of international production orders—the" ;
    values:kind "section" ;
    values:originalText "Organisation  (1) If an international production order was issued under Part 4 of this Schedule, the Director-General of Security:  (a) may revoke the order; and  Schedule 1  Amendments" ;
