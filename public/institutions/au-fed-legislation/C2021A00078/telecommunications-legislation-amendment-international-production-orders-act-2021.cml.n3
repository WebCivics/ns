doc:sch-1-sec-172-ss-4 a cof:Section ;
    cof:title "172(4) International production order issued in response to a telephone" ;
    values:kind "subsection" ;
    values:originalText "(4) A cancellation under subclause (3) is to be set out in a written instrument." ;
    cof:pageNumber "220"^^xsd:integer .

concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-172-ss-5 a cml:Concept ;
    skos:prefLabel "172(5) International production order issued in response to a telephone"@en ;
    cml:realizedBy doc:sch-1-sec-172-ss-5 ;
    values:originalText "(5) If the international production order is cancelled by the issuing person under subclause (3):  (a) the issuing person must:  (i) give the instrument of cancellation to the Australian Designated Authority; and  (ii) do so as soon as practicable after the order is cancelled; and  (b) if the telephone application was made on behalf of a relevant agency—the Australian Designated Authority must:  (i) inform the chief officer of the relevant agency of the cancellation; and  (ii) do so as soon as practicable after the instrument of cancellation is given to the Australian Designated Authority; and  (c) if the telephone application was made on behalf of the Organisation—the Australian Designated Authority must:  (i) inform the Organisation of the cancellation; and  (ii) do so as soon as practicable after the instrument of cancellation is given to the Australian Designated Authority.  Schedule 1  Amendments" ;
    skos:definition "(5) If the international production order is cancelled by the issuing person under subclause (3):  (a) the issuing person must:  (i) give the instrument of cancellation to the Australian Designated Authority; and  (ii) do so as soon as practicable after the order is cancelled; and  (b) if the telephone application was made on behalf of a relevant agency—the Australian Designated Authority must:  (i) inform the chief officer of the relevant agency of the cancellation; and  (ii) do so as soon as practicable after the instrument of cancellation is given to the Australian Designated Authority; and  (c) if the telephone application was made on behalf of the Organisation—the Australian Designated Authority must:  (i) inform the Organisation of the cancellation; and  (ii) do so as soon as practicable after the instrument of cancellation is given to the Australian Designated Authority.  Schedule 1  Amendments"@en ;
    cml:integrityHash "ffd172a4aa0b26c7d0d6d2c1f326cda2dcad7869c4cff496e70505ad259e6189" ;
    values:partOf concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-172 ;
    cof:pageNumber "220"^^xsd:integer ;
    skos:note "Issuing person must give instrument of cancellation to Australian Designated Authority as soon as practicable after order is cancelled." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-international-production-orders-act-2021.pdf> ;
