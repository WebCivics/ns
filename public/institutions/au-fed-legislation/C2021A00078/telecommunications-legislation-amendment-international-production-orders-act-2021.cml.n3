concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-31-2 a cml:Concept ;
    skos:prefLabel "31 Content of international production order"@en ;
    cml:realizedBy doc:sch-1-sec-31-2 ;
    values:originalText "Scope  (1) This clause applies to an international production order issued under clause 30 in response to an application made by an interception agency. Content  (2) The order must be signed by the eligible Judge or nominated AAT member who issued it.  (3) The order must set out the following:  (a) the date on which the order was issued;  (b) the name of the interception agency;  Schedule 1  Amendments" ;
    skos:definition "Scope  (1) This clause applies to an international production order issued under clause 30 in response to an application made by an interception agency. Content  (2) The order must be signed by the eligible Judge or nominated AAT member who issued it.  (3) The order must set out the following:  (a) the date on which the order was issued;  (b) the name of the interception agency;  Schedule 1  Amendments"@en ;
    cml:integrityHash "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000" ;
    cof:pageNumber "61"^^xsd:integer ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-31-2-ss-1 ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-31-2-ss-2 ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-31-2-ss-3 ;
