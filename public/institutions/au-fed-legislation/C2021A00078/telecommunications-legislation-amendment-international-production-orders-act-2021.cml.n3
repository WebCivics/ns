concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13a a cml:Concept ;
    skos:prefLabel "13A After subsection 35(3)"@en ;
    cml:realizedBy doc:sch-1-sec-13a ;
    values:originalText "Insert:  (3A) Subsection (2) does not prevent an officer from divulging or communicating IPO information to an IGIS official if:  (a) the information is relevant to the functions or powers of the Inspector-General of Intelligence and Security; and  (b) the Ombudsman is satisfied on reasonable grounds that the Inspector-General of Intelligence and Security has satisfactory arrangements in place for protecting the information.  Schedule 1  Amendments" ;
    skos:definition "Insert:  (3A) Subsection (2) does not prevent an officer from divulging or communicating IPO information to an IGIS official if:  (a) the information is relevant to the functions or powers of the Inspector-General of Intelligence and Security; and  (b) the Ombudsman is satisfied on reasonable grounds that the Inspector-General of Intelligence and Security has satisfactory arrangements in place for protecting the information.  Schedule 1  Amendments"@en ;
    cml:integrityHash "70463b9217d4e21cd2be696445fe62a83f6621ff39bca4734cd3183fd06512a6" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Disclosure of IPO information to IGIS official under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
