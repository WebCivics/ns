    cof:pageNumber "203"^^xsd:integer ;
    skos:note "Manager must issue evidentiary certificate to comply with international production order" ;
    dc:description "facts with respect to acts or things done by the provider" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
