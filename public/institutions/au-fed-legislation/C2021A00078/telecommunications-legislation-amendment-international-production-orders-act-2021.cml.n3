    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-114-ss-3 cml:asserts concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-114-ss-3-logic-ltl-3 .
concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-114-ss-3-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "during" ;
    cml:logicSummary "Ceasing ground for revocation during control orders" ;
    cml:premiseText "(3) For the purposes of the application of subclause (1)" ;
    cml:conclusionText "that ground is taken to have ceased to exist if, and only if, neither that control order, nor any succeeding control order, is in force" ;
