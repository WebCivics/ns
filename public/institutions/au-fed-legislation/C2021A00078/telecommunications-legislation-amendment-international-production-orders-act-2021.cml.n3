concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-152-ss-2 a cml:Concept ;
    skos:prefLabel "152(2) Prohibition on use, recording or disclosure of protected"@en ;
    cml:realizedBy doc:sch-1-sec-152-ss-2 ;
