concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13 a cml:Concept ;
    skos:prefLabel "13 Subsection 13A(2) (at the end of the table)"@en ;
    cml:realizedBy doc:sch-1-sec-13 ;
    values:originalText "Add:  material that is or includes protected IPO intercept information a serious offence punishable by a maximum penalty of imprisonment for 7 years or more, imprisonment for life or the death penalty material that is or includes: (a) protected IPO stored communications information; or (b) protected IPO telecommunications data information a serious offence punishable by a maximum penalty of imprisonment for 3 years or more, imprisonment for life or the death penalty Ombudsman Act 1976" ;
    skos:definition "Add:  material that is or includes protected IPO intercept information a serious offence punishable by a maximum penalty of imprisonment for 7 years or more, imprisonment for life or the death penalty material that is or includes: (a) protected IPO stored communications information; or (b) protected IPO telecommunications data information a serious offence punishable by a maximum penalty of imprisonment for 3 years or more, imprisonment for life or the death penalty Ombudsman Act 1976"@en ;
    cml:integrityHash "5c3f8938542e42b28603edf55fb911f6f2d9b7a0e23e33282616834e429504ce" ;
    cof:pageNumber "15"^^xsd:integer ;
