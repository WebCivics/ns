doc:sch-1-sec-79-ss-3 a cof:Section ;
    cof:title "79(3) Content of international production order" ;
    values:kind "subsection" ;
    values:originalText "(3) The order must set out the following:  (a) the date on which the order was issued;  (b) the name of the control order IPO agency;  (c) the name of the prescribed communications provider to whom the order is directed;  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021  (d) the name of the designated international agreement nominated in the application for the order;  (e) a statement to the effect that the order is issued on the basis of a control order made in relation to a person;  (f) the name of the person;  (g) either:  (i) a statement to the effect that the control order is an interim control order; or  (ii) a statement to the effect that the control order is a confirmed control order." ;
    cof:pageNumber "114"^^xsd:integer .

concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79-ss-4 a cml:Concept ;
    skos:prefLabel "79(4) Content of international production order"@en ;
    cml:realizedBy doc:sch-1-sec-79-ss-4 ;
    values:originalText "(4) If the order directs a prescribed communications provider to disclose telecommunications data to the control order IPO agency, the order may require the provider to disclose that data to the agency in a specified way." ;
    skos:definition "(4) If the order directs a prescribed communications provider to disclose telecommunications data to the control order IPO agency, the order may require the provider to disclose that data to the agency in a specified way."@en ;
    cml:integrityHash "e7b7e433fc7a219db9627595f9196c4fe667379823951a1f01532542c6eab4ba" ;
    values:partOf concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79 ;
    cof:pageNumber "114"^^xsd:integer ;
    skos:note "Provider must disclose data in a specified way if required by the order." ;
    dc:description "true" ;
