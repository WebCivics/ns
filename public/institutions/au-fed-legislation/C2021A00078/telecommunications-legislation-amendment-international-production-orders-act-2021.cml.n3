concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-102 a cml:Concept ;
    skos:prefLabel "102 Form of application"@en ;
    cml:realizedBy doc:sch-1-sec-102 ;
    values:originalText "(1) An application under clause 101 must be in writing.  (2) If the person making an application under clause 101 for an international production order on the Organisation’s behalf thinks it necessary, because of urgent circumstances, to make the application by telephone, the person may make the application by telephone.  Schedule 1  Amendments" ;
    skos:definition "(1) An application under clause 101 must be in writing.  (2) If the person making an application under clause 101 for an international production order on the Organisation’s behalf thinks it necessary, because of urgent circumstances, to make the application by telephone, the person may make the application by telephone.  Schedule 1  Amendments"@en ;
    cml:integrityHash "53b55b0f7b0482caf6c1cc1289259f67bda6543e1b583e289fe2e3be8722adad" ;
    cof:pageNumber "141"^^xsd:integer ;
    cml:hasPart concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-102-ss-1 ;
