concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-100 a cml:Concept ;
    skos:prefLabel "100 Issue of further international production order"@en ;
    cml:realizedBy doc:sch-1-sec-100 ;
    values:originalText "If:  (a) an international production order (the original order) was issued under clause 98; and  (b) the original order was in respect of a particular person; and  (c) the original order was directed to a prescribed communications provider; this Schedule does not prevent the issue of a further international production order under clause 98 that:  (d) is in respect of the person; and  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021  (e) is directed to the provider." ;
    skos:definition "If:  (a) an international production order (the original order) was issued under clause 98; and  (b) the original order was in respect of a particular person; and  (c) the original order was directed to a prescribed communications provider; this Schedule does not prevent the issue of a further international production order under clause 98 that:  (d) is in respect of the person; and  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021  (e) is directed to the provider."@en ;
    cml:integrityHash "fd7f54b05734dd0a7c9c9ffc0bf20134b525cb79b76c46b5bac33c1d55abef7b" ;
    cof:pageNumber "140"^^xsd:integer ;
    skos:note "Issue of further international production order under clause 98 is permitted if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
