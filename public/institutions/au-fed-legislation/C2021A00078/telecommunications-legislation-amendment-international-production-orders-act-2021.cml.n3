concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-103 a cml:Concept ;
    skos:prefLabel "103 Contents of written application"@en ;
    cml:realizedBy doc:sch-1-sec-103 ;
    values:originalText "An application under clause 101 must, if it is in writing, set out:  (a) a statement to the effect that the application is made by the Organisation; and  (b) the name of the person making the application on the Organisation’s behalf." ;
    skos:definition "An application under clause 101 must, if it is in writing, set out:  (a) a statement to the effect that the application is made by the Organisation; and  (b) the name of the person making the application on the Organisation’s behalf."@en ;
    cml:integrityHash "4b445d15b198032cf966d43d72f536d8e73fdbc46e21a2090a9e5e2c4b8de799" ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "Application must provide Organisation's name and person making application on behalf of the organisation." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
