doc:sch-1-sec-3a-ss-1 a cof:Section ;
    cof:title "3A(1) Disallowance of regulations relating to designated international" ;
    values:kind "subsection" ;
    values:originalText "(1) This clause applies to regulations made for the purposes of clause 3. Disallowance" ;
    cof:pageNumber "35"^^xsd:integer .

concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3a-ss-2 a cml:Concept ;
    skos:prefLabel "3A(2) Disallowance of regulations relating to designated international"@en ;
    cml:realizedBy doc:sch-1-sec-3a-ss-2 ;
    values:originalText "(2) Either House of the Parliament may, following a motion upon notice, pass a resolution disallowing the regulations. For the resolution to be effective:  (a) the notice must be given in that House within 15 sitting days of that House after the copy of the regulations was tabled in that House under section 38 of the Legislation Act 2003; and  (b) the resolution must be passed, in pursuance of the motion, within 15 sitting days of that House after the giving of that notice." ;
    skos:definition "(2) Either House of the Parliament may, following a motion upon notice, pass a resolution disallowing the regulations. For the resolution to be effective:  (a) the notice must be given in that House within 15 sitting days of that House after the copy of the regulations was tabled in that House under section 38 of the Legislation Act 2003; and  (b) the resolution must be passed, in pursuance of the motion, within 15 sitting days of that House after the giving of that notice."@en ;
    cml:integrityHash "fdd03a0c4a40331ac07ba4f2262505ac34ca2770112760e5d5688e527eb96dff" ;
    values:partOf concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3a ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Resolution to disallow regulations must be passed within 15 sitting days after notice is given." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
