concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-134-ss-3 a cml:Concept ;
    skos:prefLabel "134(3) Other records to be kept—relevant agencies"@en ;
    cml:realizedBy doc:sch-1-sec-134-ss-3 ;
    values:originalText "(3) The period for which the chief officer of a relevant agency must cause a particular item to be kept in the agency’s records under subclause (1) is the period:  (a) starting when the item came into existence; and  (b) ending:  (i) when 3 years have elapsed since the item came into existence; or  (ii) when the Ombudsman gives a report to the Minister under clause 150 that is about records that include the item;  Schedule 1  Amendments" ;
    skos:definition "(3) The period for which the chief officer of a relevant agency must cause a particular item to be kept in the agency’s records under subclause (1) is the period:  (a) starting when the item came into existence; and  (b) ending:  (i) when 3 years have elapsed since the item came into existence; or  (ii) when the Ombudsman gives a report to the Minister under clause 150 that is about records that include the item;  Schedule 1  Amendments"@en ;
    cml:integrityHash "6024c75dfa6bbd19e3d47bdffa898c4f469c33bab9d06422fbd976b2624e0ec0" ;
    values:partOf concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-134 ;
    cof:pageNumber "170"^^xsd:integer ;
    skos:note "Agency must keep records for 3 years or upon Ombudsman report" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
