concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-173 a cml:Concept ;
    skos:prefLabel "173 Duty of nominated AAT Security Division member"@en ;
    cml:realizedBy doc:sch-1-sec-173 ;
    values:originalText "It is the duty of a nominated AAT Security Division member to ensure, so far as the member is able to do so, that, in or in connection with the performance of a function, or the exercise of a power, conferred on the member by this Schedule, information is not communicated or made available to a person contrary to the requirements of security (within the ordinary meaning of that expression).  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021" ;
    skos:definition "It is the duty of a nominated AAT Security Division member to ensure, so far as the member is able to do so, that, in or in connection with the performance of a function, or the exercise of a power, conferred on the member by this Schedule, information is not communicated or made available to a person contrary to the requirements of security (within the ordinary meaning of that expression).  Amendments  Schedule 1 General amendments  Part 1  No. 78, 2021 Telecommunications Legislation Amendment (International Production Orders) Act 2021"@en ;
    cml:integrityHash "85c2797eb191fcbd9550eaf32bada511bea04e38c92777c454b5d137f2b33458" ;
    cof:pageNumber "222"^^xsd:integer ;
    skos:note "Duty of nominated AAT Security Division member to ensure information is not communicated contrary to security requirements." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <telecommunications-legislation-amendment-international-production-orders-act-2021.pdf> ;
    dc:source "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.222" ;
