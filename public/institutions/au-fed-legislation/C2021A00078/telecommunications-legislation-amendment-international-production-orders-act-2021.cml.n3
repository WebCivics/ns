concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-76 a cml:Concept ;
    skos:prefLabel "76 Information to be given on telephone application"@en ;
    cml:realizedBy doc:sch-1-sec-76 ;
    values:originalText "The information given to an issuing authority in connection with a telephone application under clause 72 to the issuing authority:  (a) must include particulars of the urgent circumstances because of which the person making the application on the control order IPO agency’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 74 or 75 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the issuing authority directs.  Schedule 1  Amendments" ;
    skos:definition "The information given to an issuing authority in connection with a telephone application under clause 72 to the issuing authority:  (a) must include particulars of the urgent circumstances because of which the person making the application on the control order IPO agency’s behalf thinks it necessary to make the application by telephone; and  (b) must include each matter that, if the application had been made in writing, clause 74 or 75 would have required the application, or an affidavit accompanying it, to set out; and  (c) must be given orally or in writing, as the issuing authority directs.  Schedule 1  Amendments"@en ;
    cml:integrityHash "5c913f99167a9979c2e006e2787bc5bb45d3dc2ef976e25476877693033a7b4c" ;
    cof:pageNumber "109"^^xsd:integer ;
    skos:note "Must provide information on telephone application" ;
    dc:description "true" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
