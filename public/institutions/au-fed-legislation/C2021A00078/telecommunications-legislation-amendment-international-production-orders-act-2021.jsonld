    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-100",
      "@type": "cml:Concept",
      "skos:prefLabel": "100 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-100"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.140",
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 98; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 98 that:\n\n(d) is in respect of the person; and\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(e) is directed to the provider.",
      "skos:definition": "If:\n\n(a) an international production order (the original order) was\nissued under clause 98; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 98 that:\n\n(d) is in respect of the person; and\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(e) is directed to the provider.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-100-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-100-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fd7f54b05734dd0a7c9c9ffc0bf20134b525cb79b76c46b5bac33c1d55abef7b",
      "skos:note": "Issue of further international production order under clause 98 is permitted if certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-100",
      "@type": "cof:Section",
      "cof:title": "100 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 140,
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 98; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 98 that:\n\n(d) is in respect of the person; and\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(e) is directed to the provider."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-100-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-100"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-100-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Permission granted",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Original order issued under clause 98",
      "cml:conclusionText": "Further international production order permitted"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-101",
      "@type": "cml:Concept",
      "skos:prefLabel": "101 Application for international production order—national",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-101"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.141",
      "values:originalText": "security\n\n(1) The Organisation may apply to a nominated AAT Security\nDivision member for an international production order under\nclause 107 that:\n\n(a) is in respect of a particular person; and\n\n(b) is directed to a prescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the Organisation’s behalf by:\n\n(a) the Director-General of Security; or\n\n(b) a Deputy Director-General of Security; or\n\n(c) an eligible position-holder in relation to whom an\nauthorisation is in force under subclause (4).\n\n(4) The Director-General of Security may authorise in writing, for the\npurposes of subclause (3), eligible position-holders who, or classes\nof eligible position-holders who, are entitled under subclause (1) to\nmake applications on the Organisation’s behalf.",
      "skos:definition": "security\n\n(1) The Organisation may apply to a nominated AAT Security\nDivision member for an international production order under\nclause 107 that:\n\n(a) is in respect of a particular person; and\n\n(b) is directed to a prescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the Organisation’s behalf by:\n\n(a) the Director-General of Security; or\n\n(b) a Deputy Director-General of Security; or\n\n(c) an eligible position-holder in relation to whom an\nauthorisation is in force under subclause (4).\n\n(4) The Director-General of Security may authorise in writing, for the\npurposes of subclause (3), eligible position-holders who, or classes\nof eligible position-holders who, are entitled under subclause (1) to\nmake applications on the Organisation’s behalf.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-101-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-101-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-101-ss-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-101-ss-4"
        }
      ],
      "cml:integrityHash": "5d2d3ceb7abe552344276d47d36a8175b7aeb250a9bf0bf00e850cd23ecf2e43"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-101",
      "@type": "cof:Section",
      "cof:title": "101 Application for international production order—national",
      "values:kind": "section",
      "cof:pageNumber": 141,
      "values:originalText": "security\n\n(1) The Organisation may apply to a nominated AAT Security\nDivision member for an international production order under\nclause 107 that:\n\n(a) is in respect of a particular person; and\n\n(b) is directed to a prescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the Organisation’s behalf by:\n\n(a) the Director-General of Security; or\n\n(b) a Deputy Director-General of Security; or\n\n(c) an eligible position-holder in relation to whom an\nauthorisation is in force under subclause (4).\n\n(4) The Director-General of Security may authorise in writing, for the\npurposes of subclause (3), eligible position-holders who, or classes\nof eligible position-holders who, are entitled under subclause (1) to\nmake applications on the Organisation’s behalf."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-101-ss-1",
