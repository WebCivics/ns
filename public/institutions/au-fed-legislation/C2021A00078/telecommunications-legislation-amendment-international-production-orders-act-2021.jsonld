      "cml:operator": "Entity recognition",
      "cml:logicSummary": "Recognition of entities and individuals",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
