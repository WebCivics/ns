        }
      ],
      "cml:integrityHash": "8682c46cd146ada43226cf14989ce28fe0247cf321983b76930c8e680f3f99b2",
      "skos:note": "No provision of a message application service solely because of other services."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-4-2-ss-4",
      "@type": "cof:Section",
      "cof:title": "4(4) Message application service",
      "values:kind": "subsection",
      "cof:pageNumber": 38,
      "values:originalText": "(4) For the purposes of this Schedule, a person does not provide a\nmessage application service merely because the person provides a\nbilling service, or a fee collection service, in relation to a message\napplication service."
    },
