      },
      "cml:premiseText": "The Act authorizes disclosure of information.",
      "cml:conclusionText": "Disclosure is authorized if it complies with an order or request from a foreign country."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-169-logic-alleninterval-2",
