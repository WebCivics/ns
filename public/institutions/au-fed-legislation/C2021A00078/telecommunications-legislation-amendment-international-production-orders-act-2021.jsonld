    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-67",
      "@type": "cml:Concept",
      "skos:prefLabel": "67 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-67"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.100",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 63 to the issuing authority:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 65 or 66 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application under clause 63 to the issuing authority:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 65 or 66 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-67-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-67-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "97cf5546968f869b6cc38a7c0c2d8e6f5fb26ccfb43aec5b200f10af8bd70d1b",
      "skos:note": "Information must be provided on telephone application",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-67",
      "@type": "cof:Section",
      "cof:title": "67 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 100,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 63 to the issuing authority:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 65 or 66 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects."
    },
    {
