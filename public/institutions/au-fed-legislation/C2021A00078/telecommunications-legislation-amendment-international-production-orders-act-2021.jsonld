    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-5b",
      "@type": "cml:Concept",
      "skos:prefLabel": "5B After paragraph 29(1)(be)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-5b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.12",
      "values:originalText": "Insert:\n\n(bf) to commence, by the earlier of the following:\n\n(i) the fifth anniversary of the day on which Schedule 1 to\nthe Telecommunications (Interception and Access) Act\n1979 commences;\n\n(ii) the third anniversary of the day on which the first\ndesignated international agreement (within the meaning\nof that Schedule) enters into force for Australia;\n\na review of the operation, effectiveness and implications of\nthat Schedule; and\nInternational Criminal Court Act 2002",
      "skos:definition": "Insert:\n\n(bf) to commence, by the earlier of the following:\n\n(i) the fifth anniversary of the day on which Schedule 1 to\nthe Telecommunications (Interception and Access) Act\n1979 commences;\n\n(ii) the third anniversary of the day on which the first\ndesignated international agreement (within the meaning\nof that Schedule) enters into force for Australia;\n\na review of the operation, effectiveness and implications of\nthat Schedule; and\nInternational Criminal Court Act 2002",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-5b-norm"
        }
      ],
      "cml:integrityHash": "e31d30bc27550b00851fafdbad2e2637d14b698d51bb991e5180b3384aac32f1",
      "skos:note": "Conditional commencement of Schedule 1 to the Telecommunications (Interception and Access) Act 1979"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-5b",
      "@type": "cof:Section",
      "cof:title": "5B After paragraph 29(1)(be)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Insert:\n\n(bf) to commence, by the earlier of the following:\n\n(i) the fifth anniversary of the day on which Schedule 1 to\nthe Telecommunications (Interception and Access) Act\n1979 commences;\n\n(ii) the third anniversary of the day on which the first\ndesignated international agreement (within the meaning\nof that Schedule) enters into force for Australia;\n\na review of the operation, effectiveness and implications of\nthat Schedule; and\nInternational Criminal Court Act 2002"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-5b-norm",
      "@type": "values:Undertaking",
