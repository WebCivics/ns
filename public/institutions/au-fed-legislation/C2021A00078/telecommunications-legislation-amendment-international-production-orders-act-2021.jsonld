    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-160",
      "@type": "cml:Concept",
      "skos:prefLabel": "160 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-160"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.203",
      "values:originalText": "•\nA manager of a prescribed communications provider may\nissue an evidentiary certificate setting out facts with respect to\nacts or things done by the provider in order to comply with an\ninternational production order.\n\nSchedule 1  Amendments",
      "skos:definition": "•\nA manager of a prescribed communications provider may\nissue an evidentiary certificate setting out facts with respect to\nacts or things done by the provider in order to comply with an\ninternational production order.\n\nSchedule 1  Amendments",
