      ],
      "cml:integrityHash": "3228b4e4814042ea3cc26b33fd0a375fbb1c6284416d5b2df04986c3168156fc",
      "skos:note": "Must provide instrument of revocation to prescribed communications provider",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-115-ss-2",
      "@type": "cof:Section",
      "cof:title": "115(2) Giving of instrument of revocation—relevant agency",
      "values:kind": "subsection",
      "cof:pageNumber": 153,
      "values:originalText": "(2) If:\n\n(a) the Australian Designated Authority gave an international\nproduction order to the prescribed communications provider\nto whom the order is directed; and\n\n(b) the order was subsequently revoked under clause 114;\nthe Australian Designated Authority must:\n\n(c) give the instrument of revocation to the prescribed\ncommunications provider; and\n\n(d) do so as soon as practicable after the instrument of revocation\nis given to the Australian Designated Authority."
    },
