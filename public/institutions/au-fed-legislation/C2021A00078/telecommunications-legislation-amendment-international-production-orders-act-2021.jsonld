    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-140-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "140(3) Destruction of records",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-140-ss-3"
