      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.65",
      "values:originalText": "An application under clause 33 must, if it is in writing, set out:\n\n(a) the name of the criminal law-enforcement agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf.\n\nSchedule 1  Amendments",
      "skos:definition": "An application under clause 33 must, if it is in writing, set out:\n\n(a) the name of the criminal law-enforcement agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-35-2-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-35-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ef0bb4f78aca024545ae4d4c2d06220a68c5d5fe7d32873218bc74154c3cdc2a",
      "skos:note": "Application must provide agency name and applicant name.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-35-2",
      "@type": "cof:Section",
      "cof:title": "35 Contents of written application",
      "values:kind": "section",
      "cof:pageNumber": 65,
      "values:originalText": "An application under clause 33 must, if it is in writing, set out:\n\n(a) the name of the criminal law-enforcement agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf.\n\nSchedule 1  Amendments"
    },
