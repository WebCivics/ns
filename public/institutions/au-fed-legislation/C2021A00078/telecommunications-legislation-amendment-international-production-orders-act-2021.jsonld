    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-104",
      "@type": "cml:Concept",
      "skos:prefLabel": "104 Affidavits to accompany written application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-104"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.142",
      "values:originalText": "(1) An application under clause 101 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out.",
      "skos:definition": "(1) An application under clause 101 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-104-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-104-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-104-ss-3"
        }
      ],
      "cml:integrityHash": "d4d51a27ed41b8e4ef0246f3e2acbd01697f59065655f993cc62e51eebd63401"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-104",
      "@type": "cof:Section",
      "cof:title": "104 Affidavits to accompany written application",
      "values:kind": "section",
      "cof:pageNumber": 142,
      "values:originalText": "(1) An application under clause 101 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out."
    },
