    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-52-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "52(3) Application for international production order—control order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-52-ss-3"
      },
      "cml:curationStatus": {
