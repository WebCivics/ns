      },
      "cml:premiseText": "There is a designated international agreement between Australia and one or more foreign countries.",
      "cml:conclusionText": "The agreement overlaps with the Privacy Act 1988."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-169-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:logicSummary": "Repeating disclosure of information",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The disclosure of information in compliance with any such order or request, to the extent that the information contains personal information, is taken to be a disclosure that is authorized by this Act.",
      "cml:conclusionText": "Disclosure of information repeats if it complies with an order or request from a foreign country."
    },
    {
