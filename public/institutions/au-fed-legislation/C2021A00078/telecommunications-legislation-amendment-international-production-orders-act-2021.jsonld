    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-1-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Simplified outline of this Schedule",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-1-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
