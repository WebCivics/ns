    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-102",
      "@type": "cml:Concept",
      "skos:prefLabel": "102 Form of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-102"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.141",
      "values:originalText": "(1) An application under clause 101 must be in writing.\n\n(2) If the person making an application under clause 101 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\n\nSchedule 1  Amendments",
      "skos:definition": "(1) An application under clause 101 must be in writing.\n\n(2) If the person making an application under clause 101 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\n\nSchedule 1  Amendments",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-102-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-102-ss-2"
        }
      ],
      "cml:integrityHash": "53b55b0f7b0482caf6c1cc1289259f67bda6543e1b583e289fe2e3be8722adad"
    },
