        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3a-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fdd03a0c4a40331ac07ba4f2262505ac34ca2770112760e5d5688e527eb96dff",
      "skos:note": "Resolution to disallow regulations must be passed within 15 sitting days after notice is given."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-3a-ss-2",
      "@type": "cof:Section",
      "cof:title": "3A(2) Disallowance of regulations relating to designated international",
      "values:kind": "subsection",
      "cof:pageNumber": 35,
      "values:originalText": "(2) Either House of the Parliament may, following a motion upon\nnotice, pass a resolution disallowing the regulations. For the\nresolution to be effective:\n\n(a) the notice must be given in that House within 15 sitting days\nof that House after the copy of the regulations was tabled in\nthat House under section 38 of the Legislation Act 2003; and\n\n(b) the resolution must be passed, in pursuance of the motion,\nwithin 15 sitting days of that House after the giving of that\nnotice."
    },
