        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-54-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "ff1047f8a10d1c0d4381025b4aaab92f80fd6c03c72bb4f5b0b38bd7ff62fadb",
      "skos:note": "Application must provide agency name and applicant name.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-54",
      "@type": "cof:Section",
      "cof:title": "54 Contents of application",
      "values:kind": "section",
      "cof:pageNumber": 82,
      "values:originalText": "A written application under clause 52 by a control order IPO\nagency for an international production order must set out:\n\n(a) the name of the agency; and\n\n(b) the name of the person making the application on the\nagency’s behalf."
    },
