    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-30-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Issue of international production order—enforcement of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-30-2"
      },
