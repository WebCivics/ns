    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-94",
      "@type": "cml:Concept",
      "skos:prefLabel": "94 Contents of written application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-94"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.134",
      "values:originalText": "An application under clause 92 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.",
      "skos:definition": "An application under clause 92 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-94-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-94-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "87f19527fba53cd1bab2e3fcfd31529a1768cb8649d3f0ce3c4b85d2e2786eff",
      "skos:note": "Application must provide Organisation's name and person making application on behalf of the organisation.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-94",
      "@type": "cof:Section",
      "cof:title": "94 Contents of written application",
      "values:kind": "section",
      "cof:pageNumber": 134,
      "values:originalText": "An application under clause 92 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf."
    },
