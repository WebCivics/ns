        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-38-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Giving further information to issuing authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-38-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.66",
      "values:originalText": "(1) An issuing authority may require further information to be given in\nconnection with an application under clause 33 to the issuing\nauthority for an international production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the issuing authority\ndirects.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\nSubdivision B—International production orders relating to\nstored communications",
      "skos:definition": "(1) An issuing authority may require further information to be given in\nconnection with an application under clause 33 to the issuing\nauthority for an international production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the issuing authority\ndirects.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\nSubdivision B—International production orders relating to\nstored communications",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-38-2-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-38-2-ss-2"
        }
      ],
      "cml:integrityHash": "60d0c3becce2ebd8409b3c333761148a3d725f899ab1724895c6c87444ca8cac"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-38-2",
      "@type": "cof:Section",
      "cof:title": "38 Giving further information to issuing authority",
      "values:kind": "section",
      "cof:pageNumber": 66,
      "values:originalText": "(1) An issuing authority may require further information to be given in\nconnection with an application under clause 33 to the issuing\nauthority for an international production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the issuing authority\ndirects.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\nSubdivision B—International production orders relating to\nstored communications"
    },
