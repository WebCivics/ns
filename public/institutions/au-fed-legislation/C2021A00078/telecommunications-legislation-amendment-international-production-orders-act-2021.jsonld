    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-61-ss-2",
      "@type": "cof:Section",
      "cof:title": "61(2) Content of international production order",
      "values:kind": "subsection",
      "cof:pageNumber": 96,
      "values:originalText": "(2) The order must be signed by the eligible Judge or nominated AAT\nmember who issued it."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-61-ss-2-norm",
