      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.215",
      "values:originalText": "(4) A document purporting to be a certificate issued under\nsubclause (1), (2) or (3):\n\n(a) is to be received in evidence in a proceeding in Australia\nwithout further proof; and\n\n(b) in a proceeding in Australia, is prima facie evidence of the\nmatters stated in the document.",
      "skos:definition": "(4) A document purporting to be a certificate issued under\nsubclause (1), (2) or (3):\n\n(a) is to be received in evidence in a proceeding in Australia\nwithout further proof; and\n\n(b) in a proceeding in Australia, is prima facie evidence of the\nmatters stated in the document.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-165"
      },
      "cml:asserts": [
        {
