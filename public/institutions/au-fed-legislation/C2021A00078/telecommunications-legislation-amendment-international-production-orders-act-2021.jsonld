    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-165-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "165(4) Evidentiary certificates—telecommunications data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-165-ss-4"
      },
      "cml:curationStatus": {
