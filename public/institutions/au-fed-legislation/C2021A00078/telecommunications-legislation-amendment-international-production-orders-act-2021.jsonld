    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13b",
      "@type": "cml:Concept",
      "skos:prefLabel": "13B At the end of section 35",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-13b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.16",
      "values:originalText": "Add:\n\n(9) In this section:\nAustralian Designated Authority has the same meaning as in\nSchedule 1 to the Telecommunications (Interception and Access)\nAct 1979.\nAustralian Designated Authority official means:\n\n(a) the Australian Designated Authority; or\n\n(b) a person who:\n\n(i) is an APS employee in the Department administered by\nthe Attorney-General; and\n\n(ii) has duties relating to the functions or powers of the\nAustralian Designated Authority under Schedule 1 to\nthe Telecommunications (Interception and Access) Act\n1979.\nIGIS official has the same meaning as in the Telecommunications\n(Interception and Access) Act 1979.\nIPO information means:\n\n(a) protected information within the meaning of Schedule 1 to\nthe Telecommunications (Interception and Access) Act 1979;\nor\n\n(b) information relevant to the operation of that Schedule.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\nTelecommunications (Interception and Access) Act 1979",
      "skos:definition": "Add:\n\n(9) In this section:\nAustralian Designated Authority has the same meaning as in\nSchedule 1 to the Telecommunications (Interception and Access)\nAct 1979.\nAustralian Designated Authority official means:\n\n(a) the Australian Designated Authority; or\n\n(b) a person who:\n\n(i) is an APS employee in the Department administered by\nthe Attorney-General; and\n\n(ii) has duties relating to the functions or powers of the\nAustralian Designated Authority under Schedule 1 to\nthe Telecommunications (Interception and Access) Act\n1979.\nIGIS official has the same meaning as in the Telecommunications\n(Interception and Access) Act 1979.\nIPO information means:\n\n(a) protected information within the meaning of Schedule 1 to\nthe Telecommunications (Interception and Access) Act 1979;\nor\n\n(b) information relevant to the operation of that Schedule.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\nTelecommunications (Interception and Access) Act 1979",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13b-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13b-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13b-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13b-logic-descriptionlogic-3"
        }
      ],
      "cml:integrityHash": "8f3d2713595ab91dbe578dc1bf4a004a5b328a6ff7d31bdba8f9c14e82dbd33f",
      "skos:note": "Definitions for Australian Designated Authority and IPO information"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-13b",
      "@type": "cof:Section",
      "cof:title": "13B At the end of section 35",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Add:\n\n(9) In this section:\nAustralian Designated Authority has the same meaning as in\nSchedule 1 to the Telecommunications (Interception and Access)\nAct 1979.\nAustralian Designated Authority official means:\n\n(a) the Australian Designated Authority; or\n\n(b) a person who:\n\n(i) is an APS employee in the Department administered by\nthe Attorney-General; and\n\n(ii) has duties relating to the functions or powers of the\nAustralian Designated Authority under Schedule 1 to\nthe Telecommunications (Interception and Access) Act\n1979.\nIGIS official has the same meaning as in the Telecommunications\n(Interception and Access) Act 1979.\nIPO information means:\n\n(a) protected information within the meaning of Schedule 1 to\nthe Telecommunications (Interception and Access) Act 1979;\nor\n\n(b) information relevant to the operation of that Schedule.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\nTelecommunications (Interception and Access) Act 1979"
    },
