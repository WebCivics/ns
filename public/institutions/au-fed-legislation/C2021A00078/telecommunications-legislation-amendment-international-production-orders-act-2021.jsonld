    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-144-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "144(4) Power to obtain relevant information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-144-ss-4"
      },
      "cml:curationStatus": {
