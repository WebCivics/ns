        }
      ],
      "cml:integrityHash": "28bc4c86fbf005dd66b3d5e2cbc08f4767fae62f9725aadff5957d50204ffa08",
      "skos:note": "Required documents to be given by Australian Designated Authority",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-171",
