    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3-2-ss-1a",
      "@type": "cml:Concept",
      "skos:prefLabel": "3(1A) Designated international agreement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-3-2-ss-1a"
      },
      "cml:curationStatus": {
