      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.153",
      "values:originalText": "Organisation\n\n(1) If an international production order was issued under Part 4 of this\nSchedule, the Director-General of Security:\n\n(a) may revoke the order; and\n\nSchedule 1  Amendments",
      "skos:definition": "Organisation\n\n(1) If an international production order was issued under Part 4 of this\nSchedule, the Director-General of Security:\n\n(a) may revoke the order; and\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-116-norm"
        }
      ],
      "cml:integrityHash": "e89b949b4b1593b840275d4a8ffc3920f616e3ae95e0b86c516e03b28b578214",
      "skos:note": "Revocation of international production orders"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-116",
      "@type": "cof:Section",
      "cof:title": "116 Revocation of international production orders—the",
      "values:kind": "section",
      "cof:pageNumber": 153,
      "values:originalText": "Organisation\n\n(1) If an international production order was issued under Part 4 of this\nSchedule, the Director-General of Security:\n\n(a) may revoke the order; and\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-116-norm",
      "@type": "values:Permission",
