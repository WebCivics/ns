    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "79(4) Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-79-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.114",
      "values:originalText": "(4) If the order directs a prescribed communications provider to\ndisclose telecommunications data to the control order IPO agency,\nthe order may require the provider to disclose that data to the\nagency in a specified way.",
      "skos:definition": "(4) If the order directs a prescribed communications provider to\ndisclose telecommunications data to the control order IPO agency,\nthe order may require the provider to disclose that data to the\nagency in a specified way.",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79"
      },
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79-ss-4-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e7b7e433fc7a219db9627595f9196c4fe667379823951a1f01532542c6eab4ba",
      "skos:note": "Provider must disclose data in a specified way if required by the order.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-79-ss-4",
      "@type": "cof:Section",
      "cof:title": "79(4) Content of international production order",
      "values:kind": "subsection",
      "cof:pageNumber": 114,
      "values:originalText": "(4) If the order directs a prescribed communications provider to\ndisclose telecommunications data to the control order IPO agency,\nthe order may require the provider to disclose that data to the\nagency in a specified way."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-79-ss-4-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
