    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-47",
      "@type": "cml:Concept",
      "skos:prefLabel": "47 Giving further information to issuing authority",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-47"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.74",
      "values:originalText": "(1) An issuing authority may require further information to be given in\nconnection with an application under clause 42 to the issuing\nauthority for an international production order.\n\n(2) The further information:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the issuing authority\ndirects.\nSubdivision B—International production orders relating to\ntelecommunications data",
      "skos:definition": "(1) An issuing authority may require further information to be given in\nconnection with an application under clause 42 to the issuing\nauthority for an international production order.\n\n(2) The further information:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the issuing authority\ndirects.\nSubdivision B—International production orders relating to\ntelecommunications data",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-47-ss-1"
        },
