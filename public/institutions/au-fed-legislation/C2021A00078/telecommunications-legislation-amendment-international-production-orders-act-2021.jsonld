    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-149",
      "@type": "cml:Concept",
      "skos:prefLabel": "149 Ombudsman not to be sued",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-149"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.188",
      "values:originalText": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nPart.",
      "skos:definition": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nPart.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-149-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-149-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-149-logic-deontic-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-149-logic-linearlogic-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-149-logic-alleninterval-4"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-149-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "62bf054aaf85932a8e237e5d796bcc3fa8860d751f2d50c751fe27801428fa69",
      "skos:note": "Ombudsman not liable to action for acts done in good faith"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-149",
      "@type": "cof:Section",
      "cof:title": "149 Ombudsman not to be sued",
      "values:kind": "section",
      "cof:pageNumber": 188,
      "values:originalText": "The Ombudsman, an inspecting officer, or a person acting under an\ninspecting officer’s direction or authority, is not liable to an action,\nsuit or proceeding for or in relation to an act done, or omitted to be\ndone, in good faith in the performance or exercise, or the purported\nperformance or exercise, of a function or power conferred by this\nPart."
    },
