      ],
      "cml:integrityHash": "62cf647d88d8598fefe93eae9408c95bb586d7ba84c13487a856c25b5a0f1a8b",
      "skos:note": "Permits telephone application under urgent circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-102-ss-2",
      "@type": "cof:Section",
      "cof:title": "102(2) Form of application",
      "values:kind": "subsection",
      "cof:pageNumber": 141,
      "values:originalText": "(2) If the person making an application under clause 101 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\n\nSchedule 1  Amendments"
    },
