    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-31-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-31-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.61",
      "values:originalText": "Scope\n\n(1) This clause applies to an international production order issued\nunder clause 30 in response to an application made by an\ninterception agency.\nContent\n\n(2) The order must be signed by the eligible Judge or nominated AAT\nmember who issued it.\n\n(3) The order must set out the following:\n\n(a) the date on which the order was issued;\n\n(b) the name of the interception agency;\n\nSchedule 1  Amendments",
      "skos:definition": "Scope\n\n(1) This clause applies to an international production order issued\nunder clause 30 in response to an application made by an\ninterception agency.\nContent\n\n(2) The order must be signed by the eligible Judge or nominated AAT\nmember who issued it.\n\n(3) The order must set out the following:\n\n(a) the date on which the order was issued;\n\n(b) the name of the interception agency;\n\nSchedule 1  Amendments",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-31-2-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-31-2-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-31-2-ss-3"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-31-2",
      "@type": "cof:Section",
      "cof:title": "31 Content of international production order",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "Scope\n\n(1) This clause applies to an international production order issued\nunder clause 30 in response to an application made by an\ninterception agency.\nContent\n\n(2) The order must be signed by the eligible Judge or nominated AAT\nmember who issued it.\n\n(3) The order must set out the following:\n\n(a) the date on which the order was issued;\n\n(b) the name of the interception agency;\n\nSchedule 1  Amendments"
    },
