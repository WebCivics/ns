    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-87",
      "@type": "cml:Concept",
      "skos:prefLabel": "87 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-87"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.122",
      "values:originalText": "The information given to a nominated AAT Security Division\nmember in connection with a telephone application under clause 83\nto the nominated AAT Security Division member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 85 or 86 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated AAT\nSecurity Division member directs.",
      "skos:definition": "The information given to a nominated AAT Security Division\nmember in connection with a telephone application under clause 83\nto the nominated AAT Security Division member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 85 or 86 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated AAT\nSecurity Division member directs.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-87-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-87-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "48e6c244dc0d497facd766d90a53bbfa4c93716dfc81b275ae4989e51a6332b4",
      "skos:note": "Information must be provided to AAT Security Division member",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-87",
      "@type": "cof:Section",
      "cof:title": "87 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 122,
      "values:originalText": "The information given to a nominated AAT Security Division\nmember in connection with a telephone application under clause 83\nto the nominated AAT Security Division member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 85 or 86 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated AAT\nSecurity Division member directs."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-87-norm",
