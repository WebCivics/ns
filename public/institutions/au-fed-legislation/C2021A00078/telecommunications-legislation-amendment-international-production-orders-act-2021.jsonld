      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-109",
      "@type": "cml:Concept",
      "skos:prefLabel": "109 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-109"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.147",
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 107; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 107 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.",
      "skos:definition": "If:\n\n(a) an international production order (the original order) was\nissued under clause 107; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 107 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-109-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-109-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e79b7cff3c57bcfb88cfc7c26813889b68f79a66e3fc049cca9f88eb5de86624",
      "skos:note": "Issue of further international production order under clause 107 that is in respect of the person and directed to the provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-109",
      "@type": "cof:Section",
      "cof:title": "109 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 147,
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 107; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 107 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider."
    },
