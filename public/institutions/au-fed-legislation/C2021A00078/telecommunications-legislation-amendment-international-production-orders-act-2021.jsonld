    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-41-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-41-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.72",
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 39; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 39 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021",
      "skos:definition": "If:\n\n(a) an international production order (the original order) was\nissued under clause 39; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 39 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-41-2-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-41-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d9e554bb142db48a7ae856b0e845ab9e97ba71d066f6e2eacd4a9192a3dcae49",
      "skos:note": "Issue of further international production order under clause 39 that is in respect of the person and directed to the provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-41-2",
      "@type": "cof:Section",
      "cof:title": "41 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 39; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 39 that:\n\n(d) is in respect of the person; and\n\n(e) is directed to the provider.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-41-2-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-41-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
