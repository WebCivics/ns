      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.142",
      "values:originalText": "An application under clause 101 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.",
      "skos:definition": "An application under clause 101 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-103-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-103-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4b445d15b198032cf966d43d72f536d8e73fdbc46e21a2090a9e5e2c4b8de799",
      "skos:note": "Application must provide Organisation's name and person making application on behalf of the organisation.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-103",
      "@type": "cof:Section",
      "cof:title": "103 Contents of written application",
      "values:kind": "section",
      "cof:pageNumber": 142,
      "values:originalText": "An application under clause 101 must, if it is in writing, set out:\n\n(a) a statement to the effect that the application is made by the\nOrganisation; and\n\n(b) the name of the person making the application on the\nOrganisation’s behalf."
    },
