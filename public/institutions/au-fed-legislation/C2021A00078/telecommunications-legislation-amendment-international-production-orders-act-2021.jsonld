    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-184",
      "@type": "cml:Concept",
      "skos:prefLabel": "184 Other functions or powers not limited",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-184"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.228",
      "values:originalText": "This Schedule is not intended to limit the functions or powers of:\n\n(a) a relevant agency; or\n\n(b) the Organisation; or\n\n(c) any other body or person;\nto request or obtain assistance or information from:\n\n(d) a prescribed communications provider; or\n\n(e) any other body or person.\n\nAmendments  Schedule 1\nApplication provisions  Part 2\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021",
      "skos:definition": "This Schedule is not intended to limit the functions or powers of:\n\n(a) a relevant agency; or\n\n(b) the Organisation; or\n\n(c) any other body or person;\nto request or obtain assistance or information from:\n\n(d) a prescribed communications provider; or\n\n(e) any other body or person.\n\nAmendments  Schedule 1\nApplication provisions  Part 2\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-184-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-184-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "72487667668112601d86df2f9a651cd1fdd4a524a6cec54ba8347bc25400fda1",
      "skos:note": "Request for assistance or information from a prescribed communications provider is not limited."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-184",
      "@type": "cof:Section",
      "cof:title": "184 Other functions or powers not limited",
      "values:kind": "section",
      "cof:pageNumber": 228,
      "values:originalText": "This Schedule is not intended to limit the functions or powers of:\n\n(a) a relevant agency; or\n\n(b) the Organisation; or\n\n(c) any other body or person;\nto request or obtain assistance or information from:\n\n(d) a prescribed communications provider; or\n\n(e) any other body or person.\n\nAmendments  Schedule 1\nApplication provisions  Part 2\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021"
    },
