    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 Giving further information to eligible Judge or nominated AAT",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.84",
      "values:originalText": "member\n\n(1) An eligible Judge or nominated AAT member may require further\ninformation to be given in connection with an application under\nclause 52 to the eligible Judge or nominated AAT member for an\ninternational production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the eligible Judge or\nnominated AAT member directs.",
      "skos:definition": "member\n\n(1) An eligible Judge or nominated AAT member may require further\ninformation to be given in connection with an application under\nclause 52 to the eligible Judge or nominated AAT member for an\ninternational production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the eligible Judge or\nnominated AAT member directs.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-57-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-57-ss-2"
        }
      ],
      "cml:integrityHash": "e31ab643c44f7a0ec824b59d1194d60dac334200d845e61d2d289daa0f087ea4"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-57",
      "@type": "cof:Section",
      "cof:title": "57 Giving further information to eligible Judge or nominated AAT",
      "values:kind": "section",
      "cof:pageNumber": 84,
      "values:originalText": "member\n\n(1) An eligible Judge or nominated AAT member may require further\ninformation to be given in connection with an application under\nclause 52 to the eligible Judge or nominated AAT member for an\ninternational production order.\n\n(2) The further information:\n\n(a) must be given on oath if the application was made in writing;\nand\n\n(b) must be given orally or otherwise, as the eligible Judge or\nnominated AAT member directs."
    },
