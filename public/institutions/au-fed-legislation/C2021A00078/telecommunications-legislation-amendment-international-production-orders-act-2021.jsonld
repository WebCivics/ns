        }
      ],
      "cml:integrityHash": "9498357ef2f4beb17cf137687eb879ad508a6671e05743dc6c0c09b3debbcf7c",
      "skos:note": "Prescribed communications provider must intercept messages, voice calls or video calls in a specified way."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-61-ss-6",
