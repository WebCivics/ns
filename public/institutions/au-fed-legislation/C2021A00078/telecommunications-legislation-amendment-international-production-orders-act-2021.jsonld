    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-76",
      "@type": "cml:Concept",
      "skos:prefLabel": "76 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-76"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.109",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 72 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 74 or 75 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nSchedule 1  Amendments",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application under clause 72 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 74 or 75 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-76-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-76-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5c913f99167a9979c2e006e2787bc5bb45d3dc2ef976e25476877693033a7b4c",
      "skos:note": "Must provide information on telephone application",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-76",
      "@type": "cof:Section",
      "cof:title": "76 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 109,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 72 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 74 or 75 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.\n\nSchedule 1  Amendments"
    },
