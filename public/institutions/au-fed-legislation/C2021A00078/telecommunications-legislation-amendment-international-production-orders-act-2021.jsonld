    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-52-ss-1",
      "@type": "cof:Section",
      "cof:title": "52(1) Application for international production order—control order",
      "values:kind": "subsection",
      "cof:pageNumber": 81,
      "values:originalText": "(1) A control order IPO agency may apply to an eligible Judge or\nnominated AAT member for an international production order\nunder clause 60 that:\n\n(a) is in respect of:\n\n(i) one or more individual transmission services; or\n\n(ii) one or more individual message/call application\nservices; and\n\n(b) is directed to a prescribed communications provider."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-52-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
