    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-178",
      "@type": "cml:Concept",
      "skos:prefLabel": "178 Certified copy of international production order—the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-178"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.225",
      "values:originalText": "Organisation\nInterception\n\n(1) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 89 is\nto be received in evidence in a proceeding mentioned in clause 153\nor 157 as if it were the original international production order.\n\n(2) The document is to be known as a certified copy of the original\ninternational production order.\nStored communications\n\n(3) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 98 is\nto be received in evidence in a proceeding mentioned in clause 153\nor 158 as if it were the original international production order.\n\n(4) The document is to be known as a certified copy of the original\ninternational production order.\nTelecommunications data\n\n(5) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 107\nis to be received in evidence in:\n\n(a) a proceeding mentioned in clause 153; or\n\n(b) a proceeding for a purpose mentioned in clause 159;\nas if it were the original international production order.\n\nSchedule 1  Amendments",
      "skos:definition": "Organisation\nInterception\n\n(1) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 89 is\nto be received in evidence in a proceeding mentioned in clause 153\nor 157 as if it were the original international production order.\n\n(2) The document is to be known as a certified copy of the original\ninternational production order.\nStored communications\n\n(3) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 98 is\nto be received in evidence in a proceeding mentioned in clause 153\nor 158 as if it were the original international production order.\n\n(4) The document is to be known as a certified copy of the original\ninternational production order.\nTelecommunications data\n\n(5) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 107\nis to be received in evidence in:\n\n(a) a proceeding mentioned in clause 153; or\n\n(b) a proceeding for a purpose mentioned in clause 159;\nas if it were the original international production order.\n\nSchedule 1  Amendments",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-178-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-178-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-178-ss-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-178-ss-4"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-178-ss-5"
        }
      ],
      "cml:integrityHash": "6541b07cf5a3789a3a49a52c8c227dec56f4c3cdca3f742f9bfa910f9e68b384"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-178",
      "@type": "cof:Section",
      "cof:title": "178 Certified copy of international production order—the",
      "values:kind": "section",
      "cof:pageNumber": 225,
      "values:originalText": "Organisation\nInterception\n\n(1) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 89 is\nto be received in evidence in a proceeding mentioned in clause 153\nor 157 as if it were the original international production order.\n\n(2) The document is to be known as a certified copy of the original\ninternational production order.\nStored communications\n\n(3) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 98 is\nto be received in evidence in a proceeding mentioned in clause 153\nor 158 as if it were the original international production order.\n\n(4) The document is to be known as a certified copy of the original\ninternational production order.\nTelecommunications data\n\n(5) A document certified in writing by a certifying person to be a true\ncopy of an international production order issued under clause 107\nis to be received in evidence in:\n\n(a) a proceeding mentioned in clause 153; or\n\n(b) a proceeding for a purpose mentioned in clause 159;\nas if it were the original international production order.\n\nSchedule 1  Amendments"
    },
