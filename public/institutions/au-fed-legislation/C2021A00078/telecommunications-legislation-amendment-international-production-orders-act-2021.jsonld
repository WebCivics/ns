      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.115",
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 78; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\n\nSchedule 1  Amendments",
      "skos:definition": "If:\n\n(a) an international production order (the original order) was\nissued under clause 78; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-80-norm"
        }
      ],
      "cml:integrityHash": "9db54ac80d498aaa0ece0f1c6d0aa672f569a4c30f17b9dd6545ad3dfe10a866",
      "skos:note": "Conditional commencement of further international production order"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-80",
      "@type": "cof:Section",
      "cof:title": "80 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 115,
      "values:originalText": "If:\n\n(a) an international production order (the original order) was\nissued under clause 78; and\n\n(b) the original order was in respect of a particular person; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-80-norm",
      "@type": "values:Undertaking",
