    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-128",
      "@type": "cml:Concept",
      "skos:prefLabel": "128 Annual reports by relevant agencies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-128"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.161",
      "values:originalText": "The chief officer of a relevant agency must, within 3 months after\nthe end of each financial year, give the Minister a written report\nthat sets out:\n\n(a) the relevant statistics about applications made by the agency\nunder clause 22 during the financial year; and\n\n(b) the relevant statistics about applications made by the agency\nunder clause 33 during the financial year; and\n\n(c) the relevant statistics about applications made by the agency\nunder clause 42 during the financial year; and\n\n(d) the relevant statistics about applications made by the agency\nunder clause 52 during the financial year; and\n\n(e) the relevant statistics about applications made by the agency\nunder clause 63 during the financial year; and\n\n(f) the relevant statistics about applications made by the agency\nunder clause 72 during the financial year; and\n\n(g) for each designated international agreement—the number of\napplications made by the agency under Part 2 or 3 of this\nSchedule during the financial year that nominated the\ndesignated international agreement; and\n\n(h) if one or more international production orders were issued\nbefore the end of the financial year in response to\napplications made by the agency:\n\n(i) the number of occasions during the financial year on\nwhich protected information obtained in accordance\nwith those orders was shared with other relevant\nagencies; and\n\n(ii) the number of arrests that were made during the\nfinancial year on the basis of protected information\nobtained in accordance with those orders; and\n\n(iii) the number of prosecutions where protected information\nobtained in accordance with those orders was used in\nevidence during the financial year; and\n\n(iv) the number of convictions during the financial year\nwhere protected information obtained in accordance\n\nSchedule 1  Amendments",
      "skos:definition": "The chief officer of a relevant agency must, within 3 months after\nthe end of each financial year, give the Minister a written report\nthat sets out:\n\n(a) the relevant statistics about applications made by the agency\nunder clause 22 during the financial year; and\n\n(b) the relevant statistics about applications made by the agency\nunder clause 33 during the financial year; and\n\n(c) the relevant statistics about applications made by the agency\nunder clause 42 during the financial year; and\n\n(d) the relevant statistics about applications made by the agency\nunder clause 52 during the financial year; and\n\n(e) the relevant statistics about applications made by the agency\nunder clause 63 during the financial year; and\n\n(f) the relevant statistics about applications made by the agency\nunder clause 72 during the financial year; and\n\n(g) for each designated international agreement—the number of\napplications made by the agency under Part 2 or 3 of this\nSchedule during the financial year that nominated the\ndesignated international agreement; and\n\n(h) if one or more international production orders were issued\nbefore the end of the financial year in response to\napplications made by the agency:\n\n(i) the number of occasions during the financial year on\nwhich protected information obtained in accordance\nwith those orders was shared with other relevant\nagencies; and\n\n(ii) the number of arrests that were made during the\nfinancial year on the basis of protected information\nobtained in accordance with those orders; and\n\n(iii) the number of prosecutions where protected information\nobtained in accordance with those orders was used in\nevidence during the financial year; and\n\n(iv) the number of convictions during the financial year\nwhere protected information obtained in accordance\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-128-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-128-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b815fd8a54aae221f00697d8c087895d8cfc7705fc8ec515f48e78b269b099f9",
      "skos:note": "Annual reports by relevant agencies must be provided within 3 months after the end of each financial year.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-128",
      "@type": "cof:Section",
      "cof:title": "128 Annual reports by relevant agencies",
      "values:kind": "section",
      "cof:pageNumber": 161,
      "values:originalText": "The chief officer of a relevant agency must, within 3 months after\nthe end of each financial year, give the Minister a written report\nthat sets out:\n\n(a) the relevant statistics about applications made by the agency\nunder clause 22 during the financial year; and\n\n(b) the relevant statistics about applications made by the agency\nunder clause 33 during the financial year; and\n\n(c) the relevant statistics about applications made by the agency\nunder clause 42 during the financial year; and\n\n(d) the relevant statistics about applications made by the agency\nunder clause 52 during the financial year; and\n\n(e) the relevant statistics about applications made by the agency\nunder clause 63 during the financial year; and\n\n(f) the relevant statistics about applications made by the agency\nunder clause 72 during the financial year; and\n\n(g) for each designated international agreement—the number of\napplications made by the agency under Part 2 or 3 of this\nSchedule during the financial year that nominated the\ndesignated international agreement; and\n\n(h) if one or more international production orders were issued\nbefore the end of the financial year in response to\napplications made by the agency:\n\n(i) the number of occasions during the financial year on\nwhich protected information obtained in accordance\nwith those orders was shared with other relevant\nagencies; and\n\n(ii) the number of arrests that were made during the\nfinancial year on the basis of protected information\nobtained in accordance with those orders; and\n\n(iii) the number of prosecutions where protected information\nobtained in accordance with those orders was used in\nevidence during the financial year; and\n\n(iv) the number of convictions during the financial year\nwhere protected information obtained in accordance\n\nSchedule 1  Amendments"
    },
