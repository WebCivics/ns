      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The disclosure of information contains personal information.",
      "cml:conclusionText": "Personal information diffuses if it is disclosed in compliance with an order or request from a foreign country."
    },
