      ],
      "cml:integrityHash": "c2640fa3021412243369d6a4408f4d196b9d325a556d5a8bf23c7dc3242692a4",
      "skos:note": "Chief officer may nominate an office for agency management"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-33-2-ss-4",
      "@type": "cof:Section",
      "cof:title": "33(4) Application for international production order—enforcement of",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(4) The chief officer of the criminal law-enforcement agency may, in\nwriting, nominate for the purposes of subparagraph (3)(b)(ii) an\noffice or position in the agency that is involved in the management\nof the agency."
    },
