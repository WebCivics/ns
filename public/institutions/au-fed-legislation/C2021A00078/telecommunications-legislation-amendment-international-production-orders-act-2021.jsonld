    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-96",
      "@type": "cml:Concept",
      "skos:prefLabel": "96 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-96"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.134",
      "values:originalText": "The information given to a nominated AAT Security Division\nmember in connection with a telephone application under clause 92\nto the nominated AAT Security Division member:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 94 or 95 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated AAT\nSecurity Division member directs.",
      "skos:definition": "The information given to a nominated AAT Security Division\nmember in connection with a telephone application under clause 92\nto the nominated AAT Security Division member:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 94 or 95 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated AAT\nSecurity Division member directs.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-96-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-96-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ebc79151d9e6fbfdf6c008a0ab28e50b3cbdbd44d4ddc8ef8a152e81a6c7f238",
      "skos:note": "Must provide information on telephone application",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-96",
      "@type": "cof:Section",
      "cof:title": "96 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 134,
      "values:originalText": "The information given to a nominated AAT Security Division\nmember in connection with a telephone application under clause 92\nto the nominated AAT Security Division member:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nOrganisation’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 94 or 95 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the nominated AAT\nSecurity Division member directs."
    },
