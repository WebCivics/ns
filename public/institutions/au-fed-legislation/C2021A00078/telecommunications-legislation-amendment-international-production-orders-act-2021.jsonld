    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-163-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "163(4) Evidentiary certificates—interception",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-163-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.212",
      "values:originalText": "(4) A document purporting to be a certificate issued under\nsubclause (1), (2) or (3):\n\n(a) is to be received in evidence in a proceeding in Australia\nwithout further proof; and\n\n(b) in a proceeding in Australia, is prima facie evidence of the\nmatters stated in the document.\n\nSchedule 1  Amendments",
      "skos:definition": "(4) A document purporting to be a certificate issued under\nsubclause (1), (2) or (3):\n\n(a) is to be received in evidence in a proceeding in Australia\nwithout further proof; and\n\n(b) in a proceeding in Australia, is prima facie evidence of the\nmatters stated in the document.\n\nSchedule 1  Amendments",
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-163"
      },
