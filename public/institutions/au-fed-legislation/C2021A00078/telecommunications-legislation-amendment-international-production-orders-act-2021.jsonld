        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-150-ss-8-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "a98e820e51be14bc6c790cc870de3fe5bb6c208d15075db73112399e71f6d319",
      "skos:note": "Report cannot include information that could endanger a person's safety, prejudice an investigation or prosecution, or compromise relevant agency activities."
    },
