        }
      ],
      "cml:integrityHash": "e22d1f402fd1dbb6d1eb4edd2e18e1abf424c60c47c6d5da9434b11516245238",
      "skos:note": "Failure to comply with a requirement results in an offence."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-144-ss-4",
      "@type": "cof:Section",
      "cof:title": "144(4) Power to obtain relevant information",
      "values:kind": "subsection",
      "cof:pageNumber": 184,
      "values:originalText": "(4) A person commits an offence if:\n\n(a) the person is subject to a requirement under subclause (1) or\n(2); and\n\n(b) the person omits to do an act; and\n\n(c) the omission breaches the requirement.\nPenalty for an offence against this subclause:\nImprisonment\nfor 6 months."
    },
