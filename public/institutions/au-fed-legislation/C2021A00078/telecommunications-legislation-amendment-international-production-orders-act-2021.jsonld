    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-176",
      "@type": "cml:Concept",
      "skos:prefLabel": "176 Certified copy of international production order—enforcement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-176"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.223",
      "values:originalText": "agency\n\n(1) A document certified in writing by a certifying officer of an\nenforcement agency to be a true copy of an international\nproduction order issued under clause 48 is to be received in\nevidence in:\n\n(a) a proceeding mentioned in clause 153; or\n\n(b) a proceeding for a purpose mentioned in clause 159;\nas if it were the original international production order.\n\n(2) The document is to be known as a certified copy of the original\ninternational production order.\n\nSchedule 1  Amendments",
      "skos:definition": "agency\n\n(1) A document certified in writing by a certifying officer of an\nenforcement agency to be a true copy of an international\nproduction order issued under clause 48 is to be received in\nevidence in:\n\n(a) a proceeding mentioned in clause 153; or\n\n(b) a proceeding for a purpose mentioned in clause 159;\nas if it were the original international production order.\n\n(2) The document is to be known as a certified copy of the original\ninternational production order.\n\nSchedule 1  Amendments",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-176-ss-1"
        },
        {
