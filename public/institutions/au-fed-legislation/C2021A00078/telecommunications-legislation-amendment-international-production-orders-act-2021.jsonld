      "cml:integrityHash": "56b9bd91bdc0e35df7a625da51852ac9c3730af60397722ee7ecde0579c14225",
      "skos:note": "Must provide instrument of revocation to prescribed communications provider",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-117-ss-2",
      "@type": "cof:Section",
      "cof:title": "117(2) Giving of instrument of revocation—the Organisation",
      "values:kind": "subsection",
      "cof:pageNumber": 154,
      "values:originalText": "(2) If:\n\n(a) the Australian Designated Authority gave an international\nproduction order to the prescribed communications provider\nto whom the order is directed; and\n\n(b) the order was subsequently revoked under clause 116;\nthe Australian Designated Authority must:\n\n(c) give the instrument of revocation to the prescribed\ncommunications provider; and\n\n(d) do so as soon as practicable after the instrument of revocation\nis given to the Australian Designated Authority."
    },
