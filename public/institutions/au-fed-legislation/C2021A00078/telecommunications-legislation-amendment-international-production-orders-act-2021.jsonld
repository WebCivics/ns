    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-72",
      "@type": "cml:Concept",
      "skos:prefLabel": "72 Application for international production order—control order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-72"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.108",
      "values:originalText": "(1) A control order IPO agency may apply to an issuing authority for\nan international production order under clause 78 that:\n\n(a) is in respect of a particular person; and\n\n(b) is directed to a prescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the control order IPO agency’s\nbehalf by an authorised officer of the agency.",
      "skos:definition": "(1) A control order IPO agency may apply to an issuing authority for\nan international production order under clause 78 that:\n\n(a) is in respect of a particular person; and\n\n(b) is directed to a prescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the control order IPO agency’s\nbehalf by an authorised officer of the agency.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-72-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-72-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-72-ss-3"
        }
      ],
      "cml:integrityHash": "18d3202a66b23526814c07900ef8ac26f1cd08a35a43e0a7b8f0618943f2e631"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-72",
      "@type": "cof:Section",
      "cof:title": "72 Application for international production order—control order",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "(1) A control order IPO agency may apply to an issuing authority for\nan international production order under clause 78 that:\n\n(a) is in respect of a particular person; and\n\n(b) is directed to a prescribed communications provider.\n\n(2) The application must nominate a designated international\nagreement.\n\n(3) The application must be made on the control order IPO agency’s\nbehalf by an authorised officer of the agency."
    },
