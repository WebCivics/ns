    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-163-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "163(3) Evidentiary certificates—interception",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-163-ss-3"
      },
      "cml:curationStatus": {
