          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-111-ss-3"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-111-ss-4"
        },
