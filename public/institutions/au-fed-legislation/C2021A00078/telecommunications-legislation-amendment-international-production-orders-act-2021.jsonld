    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-145",
      "@type": "cml:Concept",
      "skos:prefLabel": "145 Ombudsman to be given information and access despite other",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-145"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.185",
      "values:originalText": "laws\n\n(1) Despite any other law, a person is not excused from giving\ninformation, answering a question, or giving access to a document,\nas and when required under this Part, on the ground that giving the\ninformation, answering the question, or giving access to the\ndocument, as the case may be:\n\n(a) would contravene a law; or\n\n(b) would be contrary to the public interest; or\n\nSchedule 1  Amendments",
      "skos:definition": "laws\n\n(1) Despite any other law, a person is not excused from giving\ninformation, answering a question, or giving access to a document,\nas and when required under this Part, on the ground that giving the\ninformation, answering the question, or giving access to the\ndocument, as the case may be:\n\n(a) would contravene a law; or\n\n(b) would be contrary to the public interest; or\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-145-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-145-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "27c14932faf30bd1fdf6b4253b1a2fe4382da58e20761d33b3c71d3797cd6d7e",
      "skos:note": "Must provide information despite other laws",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-145",
      "@type": "cof:Section",
      "cof:title": "145 Ombudsman to be given information and access despite other",
      "values:kind": "section",
      "cof:pageNumber": 185,
      "values:originalText": "laws\n\n(1) Despite any other law, a person is not excused from giving\ninformation, answering a question, or giving access to a document,\nas and when required under this Part, on the ground that giving the\ninformation, answering the question, or giving access to the\ndocument, as the case may be:\n\n(a) would contravene a law; or\n\n(b) would be contrary to the public interest; or\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-145-norm",
