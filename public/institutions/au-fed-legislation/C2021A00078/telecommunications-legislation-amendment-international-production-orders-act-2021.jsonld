    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-162",
      "@type": "cml:Concept",
      "skos:prefLabel": "162 Evidentiary certificates—voluntary provision of associated",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-162"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.205",
      "values:originalText": "information by prescribed communications providers\nInterception\n\n(1) If:\n\n(a) an international production order is directed to a prescribed\ncommunications provider; and\n\n(b) the provider is not an individual; and\n\n(c) either:\n\n(i) the order requires the provider to intercept\ncommunications carried by one or more individual\ntransmission services, and make those intercepted\ncommunications available to a relevant agency or the\nOrganisation; or\n\n(ii) the order requires the provider to intercept messages\nsent or received, voice calls made or received, or video\ncalls made or received, using one or more individual\nmessage/call application services, and make those\nintercepted messages, voice calls or video calls\navailable to a relevant agency or the Organisation;\n\nSchedule 1  Amendments",
      "skos:definition": "information by prescribed communications providers\nInterception\n\n(1) If:\n\n(a) an international production order is directed to a prescribed\ncommunications provider; and\n\n(b) the provider is not an individual; and\n\n(c) either:\n\n(i) the order requires the provider to intercept\ncommunications carried by one or more individual\ntransmission services, and make those intercepted\ncommunications available to a relevant agency or the\nOrganisation; or\n\n(ii) the order requires the provider to intercept messages\nsent or received, voice calls made or received, or video\ncalls made or received, using one or more individual\nmessage/call application services, and make those\nintercepted messages, voice calls or video calls\navailable to a relevant agency or the Organisation;\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-162-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-162-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2f8ba6bac9e3530068b191946747fbfcf0ca553786b9da0411abd2b999bccd54",
      "skos:note": "Prescribed communications providers must provide information upon request.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-162",
      "@type": "cof:Section",
      "cof:title": "162 Evidentiary certificates—voluntary provision of associated",
      "values:kind": "section",
      "cof:pageNumber": 205,
      "values:originalText": "information by prescribed communications providers\nInterception\n\n(1) If:\n\n(a) an international production order is directed to a prescribed\ncommunications provider; and\n\n(b) the provider is not an individual; and\n\n(c) either:\n\n(i) the order requires the provider to intercept\ncommunications carried by one or more individual\ntransmission services, and make those intercepted\ncommunications available to a relevant agency or the\nOrganisation; or\n\n(ii) the order requires the provider to intercept messages\nsent or received, voice calls made or received, or video\ncalls made or received, using one or more individual\nmessage/call application services, and make those\nintercepted messages, voice calls or video calls\navailable to a relevant agency or the Organisation;\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-162-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-162"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-162-logic-deontic-1",
