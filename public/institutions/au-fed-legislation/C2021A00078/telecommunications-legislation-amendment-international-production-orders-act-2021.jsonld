    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Identification of a particular person",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-13-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.42",
      "values:originalText": "For the purposes of this Schedule, a particular person may be\nidentified:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) by the person’s full name; or\n\n(b) by a name by which the person is commonly known; or\n\n(c) as the person to whom a particular individual transmission\nservice is supplied; or\n\n(d) as the person to whom a particular individual message/call\napplication service is provided; or\n\n(e) as the person who has a particular account with a prescribed\ncommunications provider; or\n\n(f) as the person who has a particular telephone number; or\n\n(g) as the person who has a particular email address; or\n\n(h) as the person who has a particular internet protocol address;\nor\n\n(i) as the person who has a device that has a particular unique\nidentifier (for example, an electronic serial number or a\nMedia Access Control address); or\n\n(j) by any other unique identifying factor that is applicable to the\nperson.",
      "skos:definition": "For the purposes of this Schedule, a particular person may be\nidentified:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) by the person’s full name; or\n\n(b) by a name by which the person is commonly known; or\n\n(c) as the person to whom a particular individual transmission\nservice is supplied; or\n\n(d) as the person to whom a particular individual message/call\napplication service is provided; or\n\n(e) as the person who has a particular account with a prescribed\ncommunications provider; or\n\n(f) as the person who has a particular telephone number; or\n\n(g) as the person who has a particular email address; or\n\n(h) as the person who has a particular internet protocol address;\nor\n\n(i) as the person who has a device that has a particular unique\nidentifier (for example, an electronic serial number or a\nMedia Access Control address); or\n\n(j) by any other unique identifying factor that is applicable to the\nperson.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13-2-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13-2-logic-deontic-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-13-2-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "8e73dc5f7d74707a8c29908381de452d19845db1e7f40bddd80b318efd818bab",
      "skos:note": "A particular person may be identified by multiple unique factors."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-13-2",
      "@type": "cof:Section",
      "cof:title": "13 Identification of a particular person",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "For the purposes of this Schedule, a particular person may be\nidentified:\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021\n\n(a) by the person’s full name; or\n\n(b) by a name by which the person is commonly known; or\n\n(c) as the person to whom a particular individual transmission\nservice is supplied; or\n\n(d) as the person to whom a particular individual message/call\napplication service is provided; or\n\n(e) as the person who has a particular account with a prescribed\ncommunications provider; or\n\n(f) as the person who has a particular telephone number; or\n\n(g) as the person who has a particular email address; or\n\n(h) as the person who has a particular internet protocol address;\nor\n\n(i) as the person who has a device that has a particular unique\nidentifier (for example, an electronic serial number or a\nMedia Access Control address); or\n\n(j) by any other unique identifying factor that is applicable to the\nperson."
    },
