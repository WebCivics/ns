    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-46",
      "@type": "cml:Concept",
      "skos:prefLabel": "46 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-46"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.74",
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 42 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nenforcement agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 44 or 45 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "skos:definition": "The information given to an issuing authority in connection with a\ntelephone application under clause 42 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nenforcement agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 44 or 45 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-46-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-46-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "28f5cdd873edf55643d1ce049286e351718530d5c15b63c20af7e4c68c51f8c7",
      "skos:note": "Information must be provided on telephone application",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-46",
      "@type": "cof:Section",
      "cof:title": "46 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 74,
      "values:originalText": "The information given to an issuing authority in connection with a\ntelephone application under clause 42 to the issuing authority:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the\nenforcement agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 44 or 45 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\n(c) must be given orally or in writing, as the issuing authority\ndirects."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-46-norm",
