    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-158",
      "@type": "cml:Concept",
      "skos:prefLabel": "158 Exceptions—international production orders relating to stored",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-158"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.202",
      "values:originalText": "communications\n\nProtected information that:\n\n(a) was obtained in accordance with an international production\norder issued under clause 39, 69 or 98; or\n\n(b) relates to an international production order issued under\nclause 39, 69 or 98;\nmay be used, recorded or disclosed, or may be admitted in\nevidence, for any of the following purposes:\n\n(c) a proceeding for the confiscation or forfeiture of property in\nconnection with the commission of a serious category 1\noffence;\n\n(d) a proceeding for the extradition of a person from a State or\nTerritory to another State or Territory, in so far as the\nproceeding relates to a serious category 1 offence;\n\n(e) a proceeding by way of a coroner’s inquest if, in the opinion\nof the coroner, the event that is the subject of the inquest may\nhave resulted from the commission of a serious category 1\noffence;\n\n(f) a proceeding for recovery of a pecuniary penalty for a\ncontravention that would, if proved, render the person\ncommitting the contravention liable to:\n\n(i) a pecuniary penalty, or a maximum pecuniary penalty,\nof at least 60 penalty units if the contravention is\ncommitted by an individual; or\n\n(ii) if the contravention cannot be committed by an\nindividual—a pecuniary penalty, or a maximum\npecuniary penalty, of at least 300 penalty units;\n\n(g) a proceeding under the Spam Act 2003;\n\n(h) a police disciplinary proceeding.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021",
      "skos:definition": "communications\n\nProtected information that:\n\n(a) was obtained in accordance with an international production\norder issued under clause 39, 69 or 98; or\n\n(b) relates to an international production order issued under\nclause 39, 69 or 98;\nmay be used, recorded or disclosed, or may be admitted in\nevidence, for any of the following purposes:\n\n(c) a proceeding for the confiscation or forfeiture of property in\nconnection with the commission of a serious category 1\noffence;\n\n(d) a proceeding for the extradition of a person from a State or\nTerritory to another State or Territory, in so far as the\nproceeding relates to a serious category 1 offence;\n\n(e) a proceeding by way of a coroner’s inquest if, in the opinion\nof the coroner, the event that is the subject of the inquest may\nhave resulted from the commission of a serious category 1\noffence;\n\n(f) a proceeding for recovery of a pecuniary penalty for a\ncontravention that would, if proved, render the person\ncommitting the contravention liable to:\n\n(i) a pecuniary penalty, or a maximum pecuniary penalty,\nof at least 60 penalty units if the contravention is\ncommitted by an individual; or\n\n(ii) if the contravention cannot be committed by an\nindividual—a pecuniary penalty, or a maximum\npecuniary penalty, of at least 300 penalty units;\n\n(g) a proceeding under the Spam Act 2003;\n\n(h) a police disciplinary proceeding.\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-158-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-158-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "44558f3037c2e1681e46e71c88cbf56103107bd9ccdaf394b1e1829659ab7e94",
      "skos:note": "Protected information may be used for specific purposes in certain proceedings."
    },
