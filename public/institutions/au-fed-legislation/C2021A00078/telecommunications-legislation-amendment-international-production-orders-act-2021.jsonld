    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Information to be given on telephone application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.83",
      "values:originalText": "The information given to an eligible Judge or nominated AAT\nmember in connection with a telephone application under clause 52\nto the eligible Judge or nominated AAT member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 54 or 55 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\nSchedule 1  Amendments",
      "skos:definition": "The information given to an eligible Judge or nominated AAT\nmember in connection with a telephone application under clause 52\nto the eligible Judge or nominated AAT member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 54 or 55 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-56-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-56-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f266a547356d17adcec1f5f544b97e1607034ca40574dfa710205ea50737f31b",
      "skos:note": "Information must be provided to an eligible Judge or nominated AAT member on telephone application.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Information to be given on telephone application",
      "values:kind": "section",
      "cof:pageNumber": 83,
      "values:originalText": "The information given to an eligible Judge or nominated AAT\nmember in connection with a telephone application under clause 52\nto the eligible Judge or nominated AAT member:\n\n(a) must include particulars of the urgent circumstances because\nof which the person making the application on the control\norder IPO agency’s behalf thinks it necessary to make the\napplication by telephone; and\n\n(b) must include each matter that, if the application had been\nmade in writing, clause 54 or 55 would have required the\napplication, or an affidavit accompanying it, to set out; and\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-56-norm",
      "@type": "values:Obligation",
      "cml:modality": {
