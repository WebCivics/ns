    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-173",
      "@type": "cml:Concept",
      "skos:prefLabel": "173 Duty of nominated AAT Security Division member",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-173"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.222",
      "values:originalText": "It is the duty of a nominated AAT Security Division member to\nensure, so far as the member is able to do so, that, in or in\nconnection with the performance of a function, or the exercise of a\npower, conferred on the member by this Schedule, information is\nnot communicated or made available to a person contrary to the\nrequirements of security (within the ordinary meaning of that\nexpression).\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021",
      "skos:definition": "It is the duty of a nominated AAT Security Division member to\nensure, so far as the member is able to do so, that, in or in\nconnection with the performance of a function, or the exercise of a\npower, conferred on the member by this Schedule, information is\nnot communicated or made available to a person contrary to the\nrequirements of security (within the ordinary meaning of that\nexpression).\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-173-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-173-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "85c2797eb191fcbd9550eaf32bada511bea04e38c92777c454b5d137f2b33458",
      "skos:note": "Duty of nominated AAT Security Division member to ensure information is not communicated contrary to security requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-173",
      "@type": "cof:Section",
      "cof:title": "173 Duty of nominated AAT Security Division member",
      "values:kind": "section",
      "cof:pageNumber": 222,
      "values:originalText": "It is the duty of a nominated AAT Security Division member to\nensure, so far as the member is able to do so, that, in or in\nconnection with the performance of a function, or the exercise of a\npower, conferred on the member by this Schedule, information is\nnot communicated or made available to a person contrary to the\nrequirements of security (within the ordinary meaning of that\nexpression).\n\nAmendments  Schedule 1\nGeneral amendments  Part 1\n\nNo. 78, 2021\nTelecommunications Legislation Amendment (International Production\nOrders) Act 2021"
    },
