        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(7) A requirement under subclause (6)"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-61-ss-7-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Allow",
      "cml:logicSummary": "Enabling indirect availability of intercepted messages",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) require that intercepted messages, voice calls or video calls be made available to the control order IPO agency indirectly via the Australian Designated Authority."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-61-ss-7-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:logicSummary": "Granting permission for indirect availability",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) require that intercepted messages, voice calls or video calls be made available to the control order IPO agency indirectly via the Australian Designated Authority."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-61-ss-7-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Temporal overlap between direct and indirect availability",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) require that intercepted messages, voice calls or video calls be made available to the control order IPO agency directly; (b) require that intercepted messages, voice calls or video calls be made available to the control order IPO agency indirectly via the Australian Designated Authority."
    },
    {
