    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-151",
      "@type": "cml:Concept",
      "skos:prefLabel": "151 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-151"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.190",
      "values:originalText": "•\nProtected information must not be used, recorded or disclosed,\nunless an exception applies.\n•\nProtected information must not be admitted in evidence,\nunless an exception applies.",
      "skos:definition": "•\nProtected information must not be used, recorded or disclosed,\nunless an exception applies.\n•\nProtected information must not be admitted in evidence,\nunless an exception applies.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-151-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-151-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "db6f1f86a32d863d729bea7b6e8350ad2da256a02375e27923bc16b45c614998",
      "skos:note": "Protected information cannot be used, recorded or disclosed without an exception."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-151",
      "@type": "cof:Section",
      "cof:title": "151 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 190,
      "values:originalText": "•\nProtected information must not be used, recorded or disclosed,\nunless an exception applies.\n•\nProtected information must not be admitted in evidence,\nunless an exception applies."
    },
