    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-78-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "78(2) Issue of international production order—control order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-78-ss-2"
