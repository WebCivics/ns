    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-139-ss-1",
      "@type": "cof:Section",
      "cof:title": "139(1) Register of international production orders",
      "values:kind": "subsection",
      "cof:pageNumber": 178,
      "values:originalText": "(1) The Australian Designated Authority must cause to be kept a\nregister of international production orders."
    },
