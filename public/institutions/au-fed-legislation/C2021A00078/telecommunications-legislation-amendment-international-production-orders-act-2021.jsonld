    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-98",
      "@type": "cml:Concept",
      "skos:prefLabel": "98 Issue of international production order—national security",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-98"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.135",
      "values:originalText": "Scope\n\n(1) This clause applies if the Organisation applies, under clause 92, to\na nominated AAT Security Division member for an international\nproduction order that:\n\n(a) is in respect of a particular person (the relevant person); and\n\n(b) is directed to a prescribed communications provider.\n\nSchedule 1  Amendments",
      "skos:definition": "Scope\n\n(1) This clause applies if the Organisation applies, under clause 92, to\na nominated AAT Security Division member for an international\nproduction order that:\n\n(a) is in respect of a particular person (the relevant person); and\n\n(b) is directed to a prescribed communications provider.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-98-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-98-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cfc99a3b9cb9b157cc05ef89c2458b3ae79dcafcc0e8d58178c37b3869781b95",
      "skos:note": "International production order directed to a prescribed communications provider is subject to national security review."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-98",
      "@type": "cof:Section",
      "cof:title": "98 Issue of international production order—national security",
      "values:kind": "section",
      "cof:pageNumber": 135,
      "values:originalText": "Scope\n\n(1) This clause applies if the Organisation applies, under clause 92, to\na nominated AAT Security Division member for an international\nproduction order that:\n\n(a) is in respect of a particular person (the relevant person); and\n\n(b) is directed to a prescribed communications provider.\n\nSchedule 1  Amendments"
    },
