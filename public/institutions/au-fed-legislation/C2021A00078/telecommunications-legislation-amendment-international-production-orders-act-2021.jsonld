    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-32-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Issue of further international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-32-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.63",
      "values:originalText": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 30; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 30 that is:\n\n(d) in respect of any or all of those services; and\n\n(e) directed to the provider;\nso long as the period specified in the further order for the purposes\nof subparagraph 30(2)(i)(i) of this Schedule begins after the end of\n\nSchedule 1  Amendments",
      "skos:definition": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 30; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 30 that is:\n\n(d) in respect of any or all of those services; and\n\n(e) directed to the provider;\nso long as the period specified in the further order for the purposes\nof subparagraph 30(2)(i)(i) of this Schedule begins after the end of\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-32-2-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-32-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "044f080249016cbd022e80cd2991f218dd78f54eec1c089547a2fdf30a860392",
      "skos:note": "Issue of further international production order under clause 30 is permitted as long as certain conditions are met."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-32-2",
      "@type": "cof:Section",
      "cof:title": "32 Issue of further international production order",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "(1) If:\n\n(a) an international production order (the original order) was\nissued under clause 30; and\n\n(b) the original order was in respect of one or more individual\ntransmission services; and\n\n(c) the original order was directed to a prescribed\ncommunications provider;\nthis Schedule does not prevent the issue of a further international\nproduction order under clause 30 that is:\n\n(d) in respect of any or all of those services; and\n\n(e) directed to the provider;\nso long as the period specified in the further order for the purposes\nof subparagraph 30(2)(i)(i) of this Schedule begins after the end of\n\nSchedule 1  Amendments"
    },
