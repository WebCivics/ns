    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-120",
      "@type": "cml:Concept",
      "skos:prefLabel": "120 Simplified outline of this Part",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-120"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.155",
      "values:originalText": "•\nIf an international production order is given to a prescribed\ncommunications provider, the provider may object to the order\non the grounds that the order does not comply with the\ndesignated international agreement nominated in the\napplication for the order.\n•\nThe Australian Designated Authority may cancel an\ninternational production order.\n\nSchedule 1  Amendments",
      "skos:definition": "•\nIf an international production order is given to a prescribed\ncommunications provider, the provider may object to the order\non the grounds that the order does not comply with the\ndesignated international agreement nominated in the\napplication for the order.\n•\nThe Australian Designated Authority may cancel an\ninternational production order.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-120-norm"
        }
      ],
      "cml:integrityHash": "4af71a8b7d014bd5e9f99f3ab4f12eb2572394b29839ef13d7efc41b2bf0799d",
      "skos:note": "Communications provider may object to international production order on grounds of non-compliance with designated agreement."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-120",
      "@type": "cof:Section",
      "cof:title": "120 Simplified outline of this Part",
      "values:kind": "section",
      "cof:pageNumber": 155,
      "values:originalText": "•\nIf an international production order is given to a prescribed\ncommunications provider, the provider may object to the order\non the grounds that the order does not comply with the\ndesignated international agreement nominated in the\napplication for the order.\n•\nThe Australian Designated Authority may cancel an\ninternational production order.\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-120-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-120"
