    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3c",
      "@type": "cml:Concept",
      "skos:prefLabel": "3C Australia’s treaty-making process",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-3c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.38",
      "values:originalText": "Nothing in this Schedule is intended to modify or limit the\napplication of Australia’s treaty-making process relating to a\ndesignated international agreement, including the following\nproposed treaty actions:\n\n(a) an amendment of a designated international agreement;\n\n(b) an extension of the duration of a designated international\nagreement.",
      "skos:definition": "Nothing in this Schedule is intended to modify or limit the\napplication of Australia’s treaty-making process relating to a\ndesignated international agreement, including the following\nproposed treaty actions:\n\n(a) an amendment of a designated international agreement;\n\n(b) an extension of the duration of a designated international\nagreement.",
      "cml:asserts": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3c-norm"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-3c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "015c746c0671a5e71f5c5e6363f75e0cb33135516c01f99b31533008c444f682",
      "skos:note": "Nothing in this Schedule is intended to modify or limit the application of Australia’s treaty-making process."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-3c",
      "@type": "cof:Section",
      "cof:title": "3C Australia’s treaty-making process",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Nothing in this Schedule is intended to modify or limit the\napplication of Australia’s treaty-making process relating to a\ndesignated international agreement, including the following\nproposed treaty actions:\n\n(a) an amendment of a designated international agreement;\n\n(b) an extension of the duration of a designated international\nagreement."
    },
