    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-61-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "61(6) Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-61-ss-6"
      },
      "cml:curationStatus": {
