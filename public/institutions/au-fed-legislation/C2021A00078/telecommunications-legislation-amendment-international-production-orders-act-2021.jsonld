        }
      ],
      "cml:integrityHash": "e31ab643c44f7a0ec824b59d1194d60dac334200d845e61d2d289daa0f087ea4"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-88",
      "@type": "cof:Section",
      "cof:title": "88 Giving further information to nominated AAT Security Division",
      "values:kind": "section",
