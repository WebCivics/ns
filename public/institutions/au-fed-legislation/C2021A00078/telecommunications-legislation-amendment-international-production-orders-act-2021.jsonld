        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-165-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "af9781850faadca17b7d08fce48688265745f499bc86dfc56318daf15ec408f1",
      "skos:note": "Exhibiting a document purporting to be a certificate is prima facie evidence in Australian proceedings."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-165-ss-4",
      "@type": "cof:Section",
      "cof:title": "165(4) Evidentiary certificates—telecommunications data",
      "values:kind": "subsection",
      "cof:pageNumber": 215,
      "values:originalText": "(4) A document purporting to be a certificate issued under\nsubclause (1), (2) or (3):\n\n(a) is to be received in evidence in a proceeding in Australia\nwithout further proof; and\n\n(b) in a proceeding in Australia, is prima facie evidence of the\nmatters stated in the document."
    },
