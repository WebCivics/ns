    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-93",
      "@type": "cml:Concept",
      "skos:prefLabel": "93 Form of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-93"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.134",
      "values:originalText": "(1) An application under clause 92 must be in writing.\n\n(2) If the person making an application under clause 92 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\nNote:\nSee also clause 17A (urgent circumstances) and clause 172 (action\nrequired).",
      "skos:definition": "(1) An application under clause 92 must be in writing.\n\n(2) If the person making an application under clause 92 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\nNote:\nSee also clause 17A (urgent circumstances) and clause 172 (action\nrequired).",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-93-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-93-ss-2"
        }
      ],
      "cml:integrityHash": "310b3981ae324f3529de8d7c63c4d09794a6e25202bdf8d9afed0b3f35255737"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-93",
      "@type": "cof:Section",
      "cof:title": "93 Form of application",
      "values:kind": "section",
      "cof:pageNumber": 134,
      "values:originalText": "(1) An application under clause 92 must be in writing.\n\n(2) If the person making an application under clause 92 for an\ninternational production order on the Organisation’s behalf thinks\nit necessary, because of urgent circumstances, to make the\napplication by telephone, the person may make the application by\ntelephone.\nNote:\nSee also clause 17A (urgent circumstances) and clause 172 (action\nrequired)."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-93-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "93(1) Form of application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-93-ss-1"
