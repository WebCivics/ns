    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-36-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Affidavits to accompany written application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-36-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf"
      },
      "dc:source": "telecommunications-legislation-amendment-international-production-orders-act-2021.pdf, p.66",
      "values:originalText": "(1) An application under clause 33 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out.",
      "skos:definition": "(1) An application under clause 33 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out.",
      "cml:hasPart": [
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-36-2-ss-1"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-36-2-ss-2"
        },
        {
          "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-36-2-ss-3"
        }
      ],
      "cml:integrityHash": "4757143c2ebdea39aaf919a44364652b49ed55e517fba02354e43ce1a2baad46"
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-36-2",
      "@type": "cof:Section",
      "cof:title": "36 Affidavits to accompany written application",
      "values:kind": "section",
      "cof:pageNumber": 66,
      "values:originalText": "(1) An application under clause 33 must, if it is in writing, be\naccompanied by an affidavit complying with this clause.\n\n(2) The affidavit must set out the facts and other grounds on which the\napplication is based.\n\n(3) Despite subclause (1), a written application may be accompanied\nby 2 or more affidavits that together set out each matter that, apart\nfrom this subclause, this clause would have required an affidavit\naccompanying the application to set out."
    },
