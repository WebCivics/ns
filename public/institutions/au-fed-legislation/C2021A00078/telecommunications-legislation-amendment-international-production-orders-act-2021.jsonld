      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffuses the provision's application to multiple providers.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(4) If the order directs a prescribed communications provider to intercept communications...",
      "cml:conclusionText": "...the order may require the provider to: (a) intercept those communications in a specified way; and (b) make those intercepted communications available to the Organisation in a specified way."
    },
    {
      "@id": "concept:telecommunications-legislation-amendment-international-production-orders-act-2021-sch-1-sec-90-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "90(5) Content of international production order",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-90-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
