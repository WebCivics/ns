      "cml:integrityHash": "02c7f52edbf4105bd3df6f6d1c4df09611f4804b2dceead4927123bb358e6938",
      "skos:note": "Issuing authority may require further information."
    },
    {
      "@id": "https://ns.webcivics.net/values/telecommunications-legislation-amendment-international-production-orders-act-2021#sch-1-sec-68-ss-1",
      "@type": "cof:Section",
      "cof:title": "68(1) Giving further information to issuing authority",
      "values:kind": "subsection",
      "cof:pageNumber": 101,
      "values:originalText": "(1) An issuing authority may require further information to be given in\nconnection with an application under clause 63 to the issuing\nauthority for an international production order."
    },
