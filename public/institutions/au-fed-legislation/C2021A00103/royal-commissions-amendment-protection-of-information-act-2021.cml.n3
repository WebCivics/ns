concept:royal-commissions-amendment-protection-of-information-act-2021-sch-1-sec-10 a cml:Concept ;
    skos:prefLabel "10 Application provision"@en ;
    cml:realizedBy doc:sch-1-sec-10 ;
    values:originalText "The amendment of section 7 of the Freedom of Information Act 1982 made by this Schedule applies in relation to the following:  (a) a request for access, made under section 15 of that Act, that is received on or after the day the final report of the Disability Royal Commission is submitted to the Governor-General;  (b) an application, made under section 48 of that Act, that is received on or after the day the final report of the Disability Royal Commission is submitted to the Governor-General.    Royal Commissions Amendment (Protection of Information) Act 2021 No. 103, 2021  [Minister’s second reading speech made in— Senate on 17 March 2021 House of Representatives on 30 August 2021]  (29/21)" ;
    skos:definition "The amendment of section 7 of the Freedom of Information Act 1982 made by this Schedule applies in relation to the following:  (a) a request for access, made under section 15 of that Act, that is received on or after the day the final report of the Disability Royal Commission is submitted to the Governor-General;  (b) an application, made under section 48 of that Act, that is received on or after the day the final report of the Disability Royal Commission is submitted to the Governor-General.    Royal Commissions Amendment (Protection of Information) Act 2021 No. 103, 2021  [Minister’s second reading speech made in— Senate on 17 March 2021 House of Representatives on 30 August 2021]  (29/21)"@en ;
    cml:integrityHash "8b51653f639172d86b9313a4b993fa9ed1d4a53ec80417c9f09a50541111a9ac" ;
    cof:pageNumber "11"^^xsd:integer ;
    skos:note "Amendment applies to certain requests under the Freedom of Information Act 1982 after a specific report is submitted." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
