      "dc:source": "royal-commissions-amendment-protection-of-information-act-2021.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nMain amendments  Part 1\n\nNo. 103, 2021\nRoyal Commissions Amendment (Protection of Information) Act 2021",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nMain amendments  Part 1\n\nNo. 103, 2021\nRoyal Commissions Amendment (Protection of Information) Act 2021",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-protection-of-information-act-2021-sec-3-norm"
        }
      ],
      "cml:integrityHash": "aaf9ecef7fbba26aa5f7a685e7cc6aa245e54996022051c74aeec31e014b68cb",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
