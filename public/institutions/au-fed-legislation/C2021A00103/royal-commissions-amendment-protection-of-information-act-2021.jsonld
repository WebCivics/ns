    {
      "@id": "concept:royal-commissions-amendment-protection-of-information-act-2021-sch-1-sec-5a",
      "@type": "cml:Concept",
      "skos:prefLabel": "5A After section 6OE(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-protection-of-information-act-2021#sch-1-sec-5a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-protection-of-information-act-2021.pdf"
      },
      "dc:source": "royal-commissions-amendment-protection-of-information-act-2021.pdf, p.8",
      "values:originalText": "Insert:\n\n(1A) The following are also not admissible in evidence against a natural\nperson in any civil or criminal proceedings in any court of the\nCommonwealth, of a State or of a Territory:\n\n(a) a statement or disclosure made on behalf of the person at a\nprivate session;\n\n(b) the production of a document or other thing on behalf of the\nperson at a private session;\n\n(c) a statement or disclosure made on behalf of the person to a\nmember, or member of the staff, of a Royal Commission for\nthe purposes of a private session (whether or not a private\nsession was, or is to be, held for the Commission).",
      "skos:definition": "Insert:\n\n(1A) The following are also not admissible in evidence against a natural\nperson in any civil or criminal proceedings in any court of the\nCommonwealth, of a State or of a Territory:\n\n(a) a statement or disclosure made on behalf of the person at a\nprivate session;\n\n(b) the production of a document or other thing on behalf of the\nperson at a private session;\n\n(c) a statement or disclosure made on behalf of the person to a\nmember, or member of the staff, of a Royal Commission for\nthe purposes of a private session (whether or not a private\nsession was, or is to be, held for the Commission).",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-protection-of-information-act-2021-sch-1-sec-5a-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-protection-of-information-act-2021-sch-1-sec-5a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "256fb3f370d24f3d63ff5c78e698ebb5019fa231298988bc2bf2a278deb829da",
      "skos:note": "Prohibition on admissible evidence in civil or criminal proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-protection-of-information-act-2021#sch-1-sec-5a",
      "@type": "cof:Section",
      "cof:title": "5A After section 6OE(1)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Insert:\n\n(1A) The following are also not admissible in evidence against a natural\nperson in any civil or criminal proceedings in any court of the\nCommonwealth, of a State or of a Territory:\n\n(a) a statement or disclosure made on behalf of the person at a\nprivate session;\n\n(b) the production of a document or other thing on behalf of the\nperson at a private session;\n\n(c) a statement or disclosure made on behalf of the person to a\nmember, or member of the staff, of a Royal Commission for\nthe purposes of a private session (whether or not a private\nsession was, or is to be, held for the Commission)."
    },
