    {
      "@id": "concept:royal-commissions-amendment-protection-of-information-act-2021-sch-1-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-protection-of-information-act-2021#sch-1-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-protection-of-information-act-2021.pdf"
      },
      "dc:source": "royal-commissions-amendment-protection-of-information-act-2021.pdf, p.11",
      "values:originalText": "The amendment of section 7 of the Freedom of Information Act 1982\nmade by this Schedule applies in relation to the following:\n\n(a) a request for access, made under section 15 of that Act, that\nis received on or after the day the final report of the\nDisability Royal Commission is submitted to the\nGovernor-General;\n\n(b) an application, made under section 48 of that Act, that is\nreceived on or after the day the final report of the Disability\nRoyal Commission is submitted to the Governor-General.\n\n\n\nRoyal Commissions Amendment (Protection of Information) Act 2021\nNo. 103, 2021\n\n[Minister’s second reading speech made in—\nSenate on 17 March 2021\nHouse of Representatives on 30 August 2021]\n\n(29/21)",
      "skos:definition": "The amendment of section 7 of the Freedom of Information Act 1982\nmade by this Schedule applies in relation to the following:\n\n(a) a request for access, made under section 15 of that Act, that\nis received on or after the day the final report of the\nDisability Royal Commission is submitted to the\nGovernor-General;\n\n(b) an application, made under section 48 of that Act, that is\nreceived on or after the day the final report of the Disability\nRoyal Commission is submitted to the Governor-General.\n\n\n\nRoyal Commissions Amendment (Protection of Information) Act 2021\nNo. 103, 2021\n\n[Minister’s second reading speech made in—\nSenate on 17 March 2021\nHouse of Representatives on 30 August 2021]\n\n(29/21)",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-protection-of-information-act-2021-sch-1-sec-10-norm"
        },
        {
          "@id": "concept:royal-commissions-amendment-protection-of-information-act-2021-sch-1-sec-10-logic-deontic-1"
        },
        {
          "@id": "concept:royal-commissions-amendment-protection-of-information-act-2021-sch-1-sec-10-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "8b51653f639172d86b9313a4b993fa9ed1d4a53ec80417c9f09a50541111a9ac",
      "skos:note": "Amendment applies to certain requests under the Freedom of Information Act 1982 after a specific report is submitted."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-protection-of-information-act-2021#sch-1-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "The amendment of section 7 of the Freedom of Information Act 1982\nmade by this Schedule applies in relation to the following:\n\n(a) a request for access, made under section 15 of that Act, that\nis received on or after the day the final report of the\nDisability Royal Commission is submitted to the\nGovernor-General;\n\n(b) an application, made under section 48 of that Act, that is\nreceived on or after the day the final report of the Disability\nRoyal Commission is submitted to the Governor-General.\n\n\n\nRoyal Commissions Amendment (Protection of Information) Act 2021\nNo. 103, 2021\n\n[Minister’s second reading speech made in—\nSenate on 17 March 2021\nHouse of Representatives on 30 August 2021]\n\n(29/21)"
    },
