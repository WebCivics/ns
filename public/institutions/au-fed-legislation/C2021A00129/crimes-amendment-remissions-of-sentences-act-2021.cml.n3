concept:crimes-amendment-remissions-of-sentences-act-2021-sch-1-sec-10 a cml:Concept ;
    skos:prefLabel "10 After subsection 19AW(3)"@en ;
    cml:realizedBy doc:sch-1-sec-10 ;
    values:originalText "Insert:  (3A) Before fixing a non-parole period under paragraph (1)(f) in respect of the outstanding sentence or sentences, the prescribed authority must have regard to the period of time spent by the person on parole or licence before the parole order or licence was revoked under subsection 19AU(1)." ;
    skos:definition "Insert:  (3A) Before fixing a non-parole period under paragraph (1)(f) in respect of the outstanding sentence or sentences, the prescribed authority must have regard to the period of time spent by the person on parole or licence before the parole order or licence was revoked under subsection 19AU(1)."@en ;
    cml:integrityHash "23c08d70ac17ebc8a096b0f345e5258da5b86a6552233f0ef4cecfca412a9892" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Must regard period of time spent on parole or licence before revocation" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-remissions-of-sentences-act-2021.pdf> ;
