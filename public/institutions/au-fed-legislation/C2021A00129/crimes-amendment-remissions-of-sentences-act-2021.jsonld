    {
      "@id": "concept:crimes-amendment-remissions-of-sentences-act-2021-sch-1-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 After subsection 19AW(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-remissions-of-sentences-act-2021#sch-1-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-remissions-of-sentences-act-2021.pdf"
      },
      "dc:source": "crimes-amendment-remissions-of-sentences-act-2021.pdf, p.8",
      "values:originalText": "Insert:\n\n(3A) Before fixing a non-parole period under paragraph (1)(f) in respect\nof the outstanding sentence or sentences, the prescribed authority\nmust have regard to the period of time spent by the person on\nparole or licence before the parole order or licence was revoked\nunder subsection 19AU(1).",
      "skos:definition": "Insert:\n\n(3A) Before fixing a non-parole period under paragraph (1)(f) in respect\nof the outstanding sentence or sentences, the prescribed authority\nmust have regard to the period of time spent by the person on\nparole or licence before the parole order or licence was revoked\nunder subsection 19AU(1).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-remissions-of-sentences-act-2021-sch-1-sec-10-norm"
        },
        {
          "@id": "concept:crimes-amendment-remissions-of-sentences-act-2021-sch-1-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "23c08d70ac17ebc8a096b0f345e5258da5b86a6552233f0ef4cecfca412a9892",
      "skos:note": "Must regard period of time spent on parole or licence before revocation"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-remissions-of-sentences-act-2021#sch-1-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 After subsection 19AW(3)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Insert:\n\n(3A) Before fixing a non-parole period under paragraph (1)(f) in respect\nof the outstanding sentence or sentences, the prescribed authority\nmust have regard to the period of time spent by the person on\nparole or licence before the parole order or licence was revoked\nunder subsection 19AU(1)."
    },
    {
      "@id": "concept:crimes-amendment-remissions-of-sentences-act-2021-sch-1-sec-10-norm",
