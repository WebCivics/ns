      "skos:note": "Modify subsection (3) to include subsection (3A)"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-remissions-of-sentences-act-2021#sch-1-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Paragraph 19AW(1)(f)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit “subsection (3)”, substitute “subsections (3) and (3A)”.\n\nSchedule 1  Amendments\n\nCrimes Amendment (Remissions of Sentences) Act 2021\nNo. 129, 2021"
    },
    {
