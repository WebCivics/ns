concept:human-rights-legislation-amendment-act-2017-sch-2-sec-32a a cml:Concept ;
    skos:prefLabel "32A Reports to the Minister"@en ;
    cml:realizedBy doc:sch-2-sec-32a ;
    values:originalText "If:  (a) the Commission has inquired into an act or practice (whether a systemic practice or otherwise) that may constitute discrimination; and  (b) the Commission is of the opinion that the act or practice constitutes discrimination; the Commission may report to the Minister in relation to the inquiry.  Schedule 2  Amendment of the Australian Human Rights Commission Act 1986  Human Rights Legislation Amendment Act 2017  Compilation date: 01/09/2021 Registered: 03/11/2021" ;
    skos:definition "If:  (a) the Commission has inquired into an act or practice (whether a systemic practice or otherwise) that may constitute discrimination; and  (b) the Commission is of the opinion that the act or practice constitutes discrimination; the Commission may report to the Minister in relation to the inquiry.  Schedule 2  Amendment of the Australian Human Rights Commission Act 1986  Human Rights Legislation Amendment Act 2017  Compilation date: 01/09/2021 Registered: 03/11/2021"@en ;
    cml:integrityHash "06804c9bf1739efb8123cec76f875dce972bd1a24b67557ffbd33c67f6a16eb3" ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "Commission may report to Minister on inquiry into discrimination" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <human-rights-legislation-amendment-act-2017.pdf> ;
    dc:source "human-rights-legislation-amendment-act-2017.pdf, p.9" ;
    cml:asserts concept:human-rights-legislation-amendment-act-2017-sch-2-sec-32a-norm .
