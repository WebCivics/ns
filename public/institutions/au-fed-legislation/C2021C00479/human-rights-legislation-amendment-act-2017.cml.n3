doc:sch-2-sec-46pj-ss-6 a cof:Section ;
    cof:title "46PJ(6) President may hold conferences" ;
    values:kind "subsection" ;
    values:originalText "(6) Subsection (5) is an offence of strict liability. Note: For strict liability, see section 6.1 of the Criminal Code. Expenses for attendance" ;
    cof:pageNumber "17"^^xsd:integer .

concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pj-ss-7 a cml:Concept ;
    skos:prefLabel "46PJ(7) President may hold conferences"@en ;
    cml:realizedBy doc:sch-2-sec-46pj-ss-7 ;
    values:originalText "(7) A person who is required to attend the conference is entitled to be paid, by the Commonwealth, a reasonable sum for the person’s expenses of attendance." ;
    skos:definition "(7) A person who is required to attend the conference is entitled to be paid, by the Commonwealth, a reasonable sum for the person’s expenses of attendance."@en ;
