concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20a a cml:Concept ;
    skos:prefLabel "20A Reports to the Minister"@en ;
    cml:realizedBy doc:sch-2-sec-20a ;
    values:originalText "If:  (a) the Commission has inquired into an act or practice that may be inconsistent with or contrary to any human right; and  (b) the Commission is of the opinion that the act or practice is inconsistent with or contrary to any human right; the Commission may report to the Minister in relation to the inquiry." ;
    skos:definition "If:  (a) the Commission has inquired into an act or practice that may be inconsistent with or contrary to any human right; and  (b) the Commission is of the opinion that the act or practice is inconsistent with or contrary to any human right; the Commission may report to the Minister in relation to the inquiry."@en ;
    cml:integrityHash "088ef9b7237f44f0cc3dbede8e8c085d7c60256ba81fb80be60e6dfe2df2c500" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Commission may report to Minister on inquiry into human rights issue." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <human-rights-legislation-amendment-act-2017.pdf> ;
    dc:source "human-rights-legislation-amendment-act-2017.pdf, p.8" ;
    cml:asserts concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20a-norm .
