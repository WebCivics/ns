doc:sch-2-sec-56 a cof:Section ;
    cof:title "56 Subsection 46PS(1)" ;
    values:kind "section" ;
    values:originalText "After “terminated under”, insert “paragraph 46PF(1)(b) or”." ;
    cof:pageNumber "20"^^xsd:integer .

concept:human-rights-legislation-amendment-act-2017-sch-2-sec-57 a cml:Concept ;
    skos:prefLabel "57 After section 46PS"@en ;
    cml:realizedBy doc:sch-2-sec-57 ;
    values:originalText "Insert: 46PSA  Costs—court may have regard to an offer to settle  If:  (a) proceedings have been instituted under section 46PO against a respondent to a terminated complaint; and  (b) an applicant or respondent has made, or makes, an offer to settle the matter the subject of the complaint; and  (c) the offer was or is rejected; the court, or a judge of the court, in deciding whether to award costs in the proceedings, may have regard to the offer. Note 1: The Federal Court, or a judge of that court, may award costs in proceedings under section 46PO—see section 43 of the Federal Court of Australia Act 1976. Note 2: The Federal Circuit Court, or a judge of that court, may award costs in proceedings under section 46PO—see section 79 of the Federal Circuit Court of Australia Act 1999." ;
    skos:definition "Insert: 46PSA  Costs—court may have regard to an offer to settle  If:  (a) proceedings have been instituted under section 46PO against a respondent to a terminated complaint; and  (b) an applicant or respondent has made, or makes, an offer to settle the matter the subject of the complaint; and  (c) the offer was or is rejected; the court, or a judge of the court, in deciding whether to award costs in the proceedings, may have regard to the offer. Note 1: The Federal Court, or a judge of that court, may award costs in proceedings under section 46PO—see section 43 of the Federal Court of Australia Act 1976. Note 2: The Federal Circuit Court, or a judge of that court, may award costs in proceedings under section 46PO—see section 79 of the Federal Circuit Court of Australia Act 1999."@en ;
