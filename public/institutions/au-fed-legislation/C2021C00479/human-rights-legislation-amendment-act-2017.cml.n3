concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk-ss-5 a cml:Concept ;
    skos:prefLabel "46PK(5) Proceedings at conferences"@en ;
    cml:realizedBy doc:sch-2-sec-46pk-ss-5 ;
    values:originalText "(5) Despite paragraph (4)(a), an individual who is unable to attend the conference because the individual has a disability is entitled to nominate another person to attend instead on his or her behalf." ;
    skos:definition "(5) Despite paragraph (4)(a), an individual who is unable to attend the conference because the individual has a disability is entitled to nominate another person to attend instead on his or her behalf."@en ;
    cml:integrityHash "bb0ebaadeaeeb41b79bc047b509494ef9c5b163ae00866a9e01c5f30d0201766" ;
    values:partOf concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Entitlement to nominate another person to attend on behalf of an individual with a disability." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <human-rights-legislation-amendment-act-2017.pdf> ;
