doc:sch-2-sec-27-ss-1 a cof:Section ;
    cof:title "27(1) Subsection 46P(1)" ;
    values:kind "subsection" ;
    values:originalText "(1) A written complaint may be lodged with the Commission:  (a) alleging:  (i) that one or more acts have been done; or  (ii) that one or more omissions or practices have occurred; and  (b) alleging that those acts, omissions or practices are unlawful discrimination. Note: Unlawful discrimination is defined in subsection 3(1)." ;
    cof:pageNumber "11"^^xsd:integer .

concept:human-rights-legislation-amendment-act-2017-sch-2-sec-27-ss-1a a cml:Concept ;
    skos:prefLabel "27(1A) Subsection 46P(1)"@en ;
    cml:realizedBy doc:sch-2-sec-27-ss-1a ;
    values:originalText "(1A) It must be reasonably arguable that the alleged acts, omissions or practices are unlawful discrimination." ;
    skos:definition "(1A) It must be reasonably arguable that the alleged acts, omissions or practices are unlawful discrimination."@en ;
