doc:sch-2-sec-43-ss-1b a cof:Section ;
    cof:title "43(1B) After subsection 46PH(1)" ;
    values:kind "subsection" ;
    values:originalText "(1B) The President must terminate a complaint if the President is satisfied that:  (a) the complaint is trivial, vexatious, misconceived or lacking in substance; or  (b) there is no reasonable prospect of the matter being settled by conciliation." ;
    cof:pageNumber "15"^^xsd:integer .

concept:human-rights-legislation-amendment-act-2017-sch-2-sec-43-ss-1c a cml:Concept ;
    skos:prefLabel "43(1C) After subsection 46PH(1)"@en ;
    cml:realizedBy doc:sch-2-sec-43-ss-1c ;
    values:originalText "(1C) The President must terminate a complaint if the President is satisfied that there would be no reasonable prospect that the Federal Court or the Federal Circuit Court would be satisfied that the alleged acts, omissions or practices are unlawful discrimination." ;
    skos:definition "(1C) The President must terminate a complaint if the President is satisfied that there would be no reasonable prospect that the Federal Court or the Federal Circuit Court would be satisfied that the alleged acts, omissions or practices are unlawful discrimination."@en ;
