concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk-ss-1 a cml:Concept ;
    skos:prefLabel "46PK(1) Proceedings at conferences"@en ;
    cml:realizedBy doc:sch-2-sec-46pk-ss-1 ;
    values:originalText "(1) Evidence of anything said or done by a person in the course of the conciliation of a complaint in accordance with section 46PF is not admissible in any proceedings relating to the alleged acts, omissions or practices." ;
    skos:definition "(1) Evidence of anything said or done by a person in the course of the conciliation of a complaint in accordance with section 46PF is not admissible in any proceedings relating to the alleged acts, omissions or practices."@en ;
    cml:integrityHash "894caea605bc977f141db66955b450b5e39ea28b43bc9113294a453dc5010ca6" ;
    values:partOf concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Prevents admissibility of evidence from reconciliation proceedings in other cases. Conference proceedings must be conducted in an appropriate manner." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <human-rights-legislation-amendment-act-2017.pdf> ;
    dc:source "human-rights-legislation-amendment-act-2017.pdf, p.18" ;
    cml:asserts concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk-ss-1-norm .
