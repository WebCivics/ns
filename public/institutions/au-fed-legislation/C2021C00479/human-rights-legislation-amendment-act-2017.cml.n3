concept:human-rights-legislation-amendment-act-2017-sch-2-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 3(1)"@en ;
    cml:realizedBy doc:sch-2-sec-1 ;
    values:originalText "Insert: alleged acts, omissions or practices, in relation to a complaint, means the acts, omissions or practices that are alleged in the complaint. Note: See also paragraph 23(b) of the Acts Interpretation Act 1901." ;
