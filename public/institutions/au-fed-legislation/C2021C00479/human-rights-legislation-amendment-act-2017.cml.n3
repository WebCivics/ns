concept:human-rights-legislation-amendment-act-2017-sch-2-sec-6 a cml:Concept ;
    skos:prefLabel "6 Paragraph 11(1)(f)"@en ;
    cml:realizedBy doc:sch-2-sec-6 ;
    values:originalText "Repeal the paragraph, substitute:  (f) to:  (i) inquire into any act or practice that may be inconsistent with or contrary to any human right; and  (ii) if the Commission considers it appropriate to do so— endeavour, by conciliation, to effect a settlement of the matters that gave rise to the inquiry; and" ;
    skos:definition "Repeal the paragraph, substitute:  (f) to:  (i) inquire into any act or practice that may be inconsistent with or contrary to any human right; and  (ii) if the Commission considers it appropriate to do so— endeavour, by conciliation, to effect a settlement of the matters that gave rise to the inquiry; and"@en ;
    cml:integrityHash "38716e9d49d76f10c53a5fc8daf628dbbcb3366ffa9291b7f895eaf8ba53de13" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Commission to endeavour by conciliation to effect a settlement of matters that gave rise to inquiry" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
