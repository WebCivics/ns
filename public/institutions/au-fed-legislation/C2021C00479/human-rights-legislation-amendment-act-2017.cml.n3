concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk-ss-6 a cml:Concept ;
    skos:prefLabel "46PK(6) Proceedings at conferences"@en ;
    cml:realizedBy doc:sch-2-sec-46pk-ss-6 ;
    values:originalText "(6) If the person presiding at the conference considers that an individual is unable to participate fully in the conference because the individual has a disability, the individual is entitled to nominate another person to assist him or her at the conference." ;
    skos:definition "(6) If the person presiding at the conference considers that an individual is unable to participate fully in the conference because the individual has a disability, the individual is entitled to nominate another person to assist him or her at the conference."@en ;
    cml:integrityHash "d1fc41f6ab1237772a03944af20f2184b22fc6733f8ed79e7e33d21eb36d80ce" ;
    values:partOf concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Individuals with disabilities can nominate another person to assist at conferences." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
