doc:sch-2-sec-46pk-ss-3 a cof:Section ;
    cof:title "46PK(3) Proceedings at conferences" ;
    values:kind "subsection" ;
    values:originalText "(3) The person presiding at the conference must take all reasonable steps to ensure that the conduct of the conference does not disadvantage any complainant or respondent." ;
    cof:pageNumber "18"^^xsd:integer .

concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk-ss-4 a cml:Concept ;
    skos:prefLabel "46PK(4) Proceedings at conferences"@en ;
    cml:realizedBy doc:sch-2-sec-46pk-ss-4 ;
    values:originalText "(4) Unless the person presiding at the conference consents:  (a) an individual is not entitled to be represented at the conference by another person; and  (b) a body (whether or not incorporated) is not entitled to be represented at the conference otherwise than by a person who is an officer or employee of the body.  Amendment of the Australian Human Rights Commission Act 1986  Schedule 2  Human Rights Legislation Amendment Act 2017 Compilation date: 01/09/2021 Registered: 03/11/2021" ;
    skos:definition "(4) Unless the person presiding at the conference consents:  (a) an individual is not entitled to be represented at the conference by another person; and  (b) a body (whether or not incorporated) is not entitled to be represented at the conference otherwise than by a person who is an officer or employee of the body.  Amendment of the Australian Human Rights Commission Act 1986  Schedule 2  Human Rights Legislation Amendment Act 2017 Compilation date: 01/09/2021 Registered: 03/11/2021"@en ;
    cml:integrityHash "f8e34b259b026d95f73c56098180df7028799d37c80f17c45fc1830a21e52daf" ;
    values:partOf concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pk ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "No representation allowed at conferences without consent." ;
    cml:curationStatus cml:Proposed ;
