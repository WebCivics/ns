concept:human-rights-legislation-amendment-act-2017-sch-2-sec-12 a cml:Concept ;
    skos:prefLabel "12 Paragraph 31(b)"@en ;
    cml:realizedBy doc:sch-2-sec-12 ;
    values:originalText "Repeal the paragraph, substitute:  (b) to:  (i) inquire into any act or practice (including any systemic practice) that may constitute discrimination; and  (ii) if the Commission considers it appropriate to do so— endeavour, by conciliation, to effect a settlement of the matters that gave rise to the inquiry;" ;
    skos:definition "Repeal the paragraph, substitute:  (b) to:  (i) inquire into any act or practice (including any systemic practice) that may constitute discrimination; and  (ii) if the Commission considers it appropriate to do so— endeavour, by conciliation, to effect a settlement of the matters that gave rise to the inquiry;"@en ;
    cml:integrityHash "71e4a8f65a95ad863a5e949c9573c430c2c88dd0cf4a04e0b6f7f187d5bebe14" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Commission to endeavour by conciliation to effect a settlement of matters that gave rise to inquiry" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <human-rights-legislation-amendment-act-2017.pdf> ;
    dc:source "human-rights-legislation-amendment-act-2017.pdf, p.8" ;
    cml:asserts concept:human-rights-legislation-amendment-act-2017-sch-2-sec-12-norm .
