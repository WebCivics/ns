      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "applies",
      "cml:logicSummary": "Exemption consideration is a duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An exemption applies",
      "cml:conclusionText": "Consideration of exemption applies"
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-42-logic-deontic-2",
      "@type": "cml:LogicApplication",
