      },
      "cml:operator": "MUST",
      "cml:logicSummary": "The Commissioner must report.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
