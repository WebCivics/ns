    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Subsection 46MB(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-legislation-amendment-act-2017.pdf"
      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.11",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The National Children’s Commissioner may submit reports to the\nMinister that deal with such matters, relating to the enjoyment and\nexercise of human rights by children in Australia, as the National\nChildren’s Commissioner considers appropriate.\n\n(3A) A report under subsection (3) may include recommendations that\nthe National Children’s Commissioner considers appropriate as to\nthe action that should be taken to ensure the enjoyment and\nexercise of human rights by children in Australia.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) The National Children’s Commissioner may submit reports to the\nMinister that deal with such matters, relating to the enjoyment and\nexercise of human rights by children in Australia, as the National\nChildren’s Commissioner considers appropriate.\n\n(3A) A report under subsection (3) may include recommendations that\nthe National Children’s Commissioner considers appropriate as to\nthe action that should be taken to ensure the enjoyment and\nexercise of human rights by children in Australia.",
      "cml:hasPart": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-25-ss-3"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-25-ss-3a"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Subsection 46MB(3)",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) The National Children’s Commissioner may submit reports to the\nMinister that deal with such matters, relating to the enjoyment and\nexercise of human rights by children in Australia, as the National\nChildren’s Commissioner considers appropriate.\n\n(3A) A report under subsection (3) may include recommendations that\nthe National Children’s Commissioner considers appropriate as to\nthe action that should be taken to ensure the enjoyment and\nexercise of human rights by children in Australia."
    },
