      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-53",
      "@type": "cml:Concept",
      "skos:prefLabel": "53 After subsection 46PO(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-53"
      },
      "cml:curationStatus": {
