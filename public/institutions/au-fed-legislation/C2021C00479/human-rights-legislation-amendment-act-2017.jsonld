      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.6",
      "values:originalText": "Insert:\n\n(6A) The powers of the Commission under sections 20A and 32A must\nbe exercised by the President, and a reference in this Act to the\nCommission or to a member of the Commission must, in relation to\nthe exercise of any of those powers, be read as a reference to the\nPresident.",
      "skos:definition": "Insert:\n\n(6A) The powers of the Commission under sections 20A and 32A must\nbe exercised by the President, and a reference in this Act to the\nCommission or to a member of the Commission must, in relation to\nthe exercise of any of those powers, be read as a reference to the\nPresident.",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-4-norm"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7e56b30c759a1a604861444dd1cc6135f0a1c98a407e50c77b142ebce3ca7e7c",
      "skos:note": "Powers of Commission must be exercised by President"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 After subsection 8(6)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Insert:\n\n(6A) The powers of the Commission under sections 20A and 32A must\nbe exercised by the President, and a reference in this Act to the\nCommission or to a member of the Commission must, in relation to\nthe exercise of any of those powers, be read as a reference to the\nPresident."
    },
