    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 After subsection 46C(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-legislation-amendment-act-2017.pdf"
      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.10",
      "values:originalText": "Insert:\n\n(2A) The Commissioner may submit reports to the Minister regarding\nthe enjoyment and exercise of human rights by Aboriginal persons\nand Torres Strait Islanders.\n\n(2B) The Commissioner may submit reports to the Minister regarding:\n\n(a) the operation of the Native Title Act 1993; and\n\n(b) the effect of that Act on the enjoyment and exercise of human\nrights by Aboriginal persons and Torres Strait Islanders.\n\n(2C) A report under subsection (2A) or (2B) may include\nrecommendations as to the action that should be taken to ensure the\nenjoyment and exercise of human rights by Aboriginal persons and\nTorres Strait Islanders.",
      "skos:definition": "Insert:\n\n(2A) The Commissioner may submit reports to the Minister regarding\nthe enjoyment and exercise of human rights by Aboriginal persons\nand Torres Strait Islanders.\n\n(2B) The Commissioner may submit reports to the Minister regarding:\n\n(a) the operation of the Native Title Act 1993; and\n\n(b) the effect of that Act on the enjoyment and exercise of human\nrights by Aboriginal persons and Torres Strait Islanders.\n\n(2C) A report under subsection (2A) or (2B) may include\nrecommendations as to the action that should be taken to ensure the\nenjoyment and exercise of human rights by Aboriginal persons and\nTorres Strait Islanders.",
      "cml:hasPart": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20-ss-2a"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20-ss-2b"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20-ss-2c"
        }
      ],
      "cml:integrityHash": "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4"
    },
