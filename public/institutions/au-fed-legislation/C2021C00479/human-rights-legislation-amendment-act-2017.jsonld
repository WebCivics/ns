    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-27-ss-1a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to comply with the requirement.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The alleged acts, omissions or practices must be reasonably arguable that they are unlawful discrimination.",
      "cml:conclusionText": "It is obligatory to argue that the alleged acts, omissions or practices are unlawful discrimination."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-27-ss-1a-logic-linearlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LinearLogic"
      },
      "cml:operator": "⇒",
      "cml:logicSummary": "If the alleged acts, omissions or practices are reasonably arguable to be unlawful discrimination, then it must be reasonably arguable that they are unlawful discrimination.",
      "cml:executionSurface": "modalities::linear",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The alleged acts, omissions or practices are reasonably arguable that they are unlawful discrimination.",
      "cml:conclusionText": "It is reasonably arguable that the alleged acts, omissions or practices are unlawful discrimination."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-27-ss-1a-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "The requirement must be within a reasonable time frame of being unlawful discrimination.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The alleged acts, omissions or practices are reasonably arguable that they are unlawful discrimination.",
      "cml:conclusionText": "There is a reasonable time frame between the alleged acts, omissions or practices and them being unlawful discrimination."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-27-ss-1a-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "⇒",
      "cml:logicSummary": "If the alleged acts, omissions or practices are reasonably arguable to be unlawful discrimination, then they must be reasonably arguable to be unlawful discrimination in a wider context.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The alleged acts, omissions or practices are reasonably arguable that they are unlawful discrimination.",
      "cml:conclusionText": "There is a reasonable argument for the alleged acts, omissions or practices being unlawful discrimination in a wider context."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-27-ss-1a-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "The requirement is a subclass of a more general concept of unlawful discrimination.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The alleged acts, omissions or practices are reasonably arguable that they are unlawful discrimination.",
      "cml:conclusionText": "The requirement is a subclass of a more general concept of unlawful discrimination."
    },
