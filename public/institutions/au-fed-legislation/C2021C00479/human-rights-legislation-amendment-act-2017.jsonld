      "cml:integrityHash": "37606c7aa297278943365d8a3c6bd636dd15ed01d269f3683c8d73cf448503df",
      "skos:note": "Prohibition on delegating certain powers"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 After subsection 19(2B)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n\n(2BA) Subsection (2) does not allow the President to delegate a power\nthat can be exercised by the President because of subsection 8(6A)."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-7-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-7"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits delegation of power",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (2) does not allow the President to delegate a power that can be exercised by the President because of subsection 8(6A)",
      "cml:conclusionText": "The President cannot delegate this power."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-7-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlap",
      "cml:logicSummary": "Overlaps with the power that can be exercised by the President",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (2) does not allow the President to delegate a power that can be exercised by the President because of subsection 8(6A)",
      "cml:conclusionText": "The two powers overlap."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-7-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring",
      "cml:logicSummary": "Recurring prohibition on delegation",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (2) does not allow the President to delegate a power that can be exercised by the President because of subsection 8(6A)",
      "cml:conclusionText": "The prohibition is recurring."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-7-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Diffuses the power to other agents",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (2) does not allow the President to delegate a power that can be exercised by the President because of subsection 8(6A)",
      "cml:conclusionText": "The power is diffused to other agents."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-7-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Classify",
      "cml:logicSummary": "Classifies the power as one that requires human oversight",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Subsection (2) does not allow the President to delegate a power that can be exercised by the President because of subsection 8(6A)",
      "cml:conclusionText": "The power is classified as one that requires human oversight."
    },
