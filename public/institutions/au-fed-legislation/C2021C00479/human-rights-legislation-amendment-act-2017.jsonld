      }
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Paragraph 31(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-legislation-amendment-act-2017.pdf"
      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.8",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) to:\n\n(i) inquire into any act or practice (including any systemic\npractice) that may constitute discrimination; and\n\n(ii) if the Commission considers it appropriate to do so—\nendeavour, by conciliation, to effect a settlement of the\nmatters that gave rise to the inquiry;",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(b) to:\n\n(i) inquire into any act or practice (including any systemic\npractice) that may constitute discrimination; and\n\n(ii) if the Commission considers it appropriate to do so—\nendeavour, by conciliation, to effect a settlement of the\nmatters that gave rise to the inquiry;",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-12-norm"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "71e4a8f65a95ad863a5e949c9573c430c2c88dd0cf4a04e0b6f7f187d5bebe14",
      "skos:note": "Commission to endeavour by conciliation to effect a settlement of matters that gave rise to inquiry"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Paragraph 31(b)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(b) to:\n\n(i) inquire into any act or practice (including any systemic\npractice) that may constitute discrimination; and\n\n(ii) if the Commission considers it appropriate to do so—\nendeavour, by conciliation, to effect a settlement of the\nmatters that gave rise to the inquiry;"
    },
