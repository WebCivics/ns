      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.20",
      "values:originalText": "Add:\nNote 1:\nThe Federal Court, or a judge of that court, may award costs in\nproceedings under this section—see section 43 of the Federal Court of\nAustralia Act 1976.\nNote 2:\nThe Federal Circuit Court, or a judge of that court, may award costs in\nproceedings under this section—see section 79 of the Federal Circuit\nCourt of Australia Act 1999.",
      "skos:definition": "Add:\nNote 1:\nThe Federal Court, or a judge of that court, may award costs in\nproceedings under this section—see section 43 of the Federal Court of\nAustralia Act 1976.\nNote 2:\nThe Federal Circuit Court, or a judge of that court, may award costs in\nproceedings under this section—see section 79 of the Federal Circuit\nCourt of Australia Act 1999.",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-54-norm"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-54-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "12f95dc368402927cf71e94ac9d36a22d6983355cf531ff6d47c70542ef9298e",
      "skos:note": "Award costs in proceedings under this section"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-54",
      "@type": "cof:Section",
      "cof:title": "54 At the end of subsection 46PO(4)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Add:\nNote 1:\nThe Federal Court, or a judge of that court, may award costs in\nproceedings under this section—see section 43 of the Federal Court of\nAustralia Act 1976.\nNote 2:\nThe Federal Circuit Court, or a judge of that court, may award costs in\nproceedings under this section—see section 79 of the Federal Circuit\nCourt of Australia Act 1999."
    },
