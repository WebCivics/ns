      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.5",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 2  Amendment of the Australian Human Rights Commission Act 1986\n\nHuman Rights Legislation Amendment Act 2017\n\nCompilation date: 01/09/2021\nRegistered: 03/11/2021",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 2  Amendment of the Australian Human Rights Commission Act 1986\n\nHuman Rights Legislation Amendment Act 2017\n\nCompilation date: 01/09/2021\nRegistered: 03/11/2021",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-3-sec-3-norm"
        }
      ],
      "cml:integrityHash": "c1cb35a6988498ebd5a97e823a8ffb71ab228dc467dd0ae824f8ac76b662ef80",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-3-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 2  Amendment of the Australian Human Rights Commission Act 1986\n\nHuman Rights Legislation Amendment Act 2017\n\nCompilation date: 01/09/2021\nRegistered: 03/11/2021"
    },
