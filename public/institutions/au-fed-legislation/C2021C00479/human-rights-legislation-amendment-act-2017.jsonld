    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20a",
      "@type": "cml:Concept",
      "skos:prefLabel": "20A Reports to the Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-20a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-legislation-amendment-act-2017.pdf"
      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.8",
      "values:originalText": "If:\n\n(a) the Commission has inquired into an act or practice that may\nbe inconsistent with or contrary to any human right; and\n\n(b) the Commission is of the opinion that the act or practice is\ninconsistent with or contrary to any human right;\nthe Commission may report to the Minister in relation to the\ninquiry.",
      "skos:definition": "If:\n\n(a) the Commission has inquired into an act or practice that may\nbe inconsistent with or contrary to any human right; and\n\n(b) the Commission is of the opinion that the act or practice is\ninconsistent with or contrary to any human right;\nthe Commission may report to the Minister in relation to the\ninquiry.",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20a-norm"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "088ef9b7237f44f0cc3dbede8e8c085d7c60256ba81fb80be60e6dfe2df2c500",
      "skos:note": "Commission may report to Minister on inquiry into human rights issue."
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-20a",
      "@type": "cof:Section",
      "cof:title": "20A Reports to the Minister",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "If:\n\n(a) the Commission has inquired into an act or practice that may\nbe inconsistent with or contrary to any human right; and\n\n(b) the Commission is of the opinion that the act or practice is\ninconsistent with or contrary to any human right;\nthe Commission may report to the Minister in relation to the\ninquiry."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20a-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20a"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-20a-logic-deontic-1",
