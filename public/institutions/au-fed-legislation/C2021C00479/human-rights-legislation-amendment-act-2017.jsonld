    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-32a",
      "@type": "cml:Concept",
      "skos:prefLabel": "32A Reports to the Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-32a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-legislation-amendment-act-2017.pdf"
      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.9",
      "values:originalText": "If:\n\n(a) the Commission has inquired into an act or practice (whether\na systemic practice or otherwise) that may constitute\ndiscrimination; and\n\n(b) the Commission is of the opinion that the act or practice\nconstitutes discrimination;\nthe Commission may report to the Minister in relation to the\ninquiry.\n\nSchedule 2  Amendment of the Australian Human Rights Commission Act 1986\n\nHuman Rights Legislation Amendment Act 2017\n\nCompilation date: 01/09/2021\nRegistered: 03/11/2021",
      "skos:definition": "If:\n\n(a) the Commission has inquired into an act or practice (whether\na systemic practice or otherwise) that may constitute\ndiscrimination; and\n\n(b) the Commission is of the opinion that the act or practice\nconstitutes discrimination;\nthe Commission may report to the Minister in relation to the\ninquiry.\n\nSchedule 2  Amendment of the Australian Human Rights Commission Act 1986\n\nHuman Rights Legislation Amendment Act 2017\n\nCompilation date: 01/09/2021\nRegistered: 03/11/2021",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-32a-norm"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-32a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "06804c9bf1739efb8123cec76f875dce972bd1a24b67557ffbd33c67f6a16eb3",
      "skos:note": "Commission may report to Minister on inquiry into discrimination"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-32a",
      "@type": "cof:Section",
      "cof:title": "32A Reports to the Minister",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "If:\n\n(a) the Commission has inquired into an act or practice (whether\na systemic practice or otherwise) that may constitute\ndiscrimination; and\n\n(b) the Commission is of the opinion that the act or practice\nconstitutes discrimination;\nthe Commission may report to the Minister in relation to the\ninquiry.\n\nSchedule 2  Amendment of the Australian Human Rights Commission Act 1986\n\nHuman Rights Legislation Amendment Act 2017\n\nCompilation date: 01/09/2021\nRegistered: 03/11/2021"
    },
