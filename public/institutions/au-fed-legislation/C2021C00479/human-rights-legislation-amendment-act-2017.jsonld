    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 After section 46PS",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-legislation-amendment-act-2017.pdf"
      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.20",
      "values:originalText": "Insert:\n46PSA  Costs—court may have regard to an offer to settle\n\nIf:\n\n(a) proceedings have been instituted under section 46PO against\na respondent to a terminated complaint; and\n\n(b) an applicant or respondent has made, or makes, an offer to\nsettle the matter the subject of the complaint; and\n\n(c) the offer was or is rejected;\nthe court, or a judge of the court, in deciding whether to award\ncosts in the proceedings, may have regard to the offer.\nNote 1:\nThe Federal Court, or a judge of that court, may award costs in\nproceedings under section 46PO—see section 43 of the Federal Court\nof Australia Act 1976.\nNote 2:\nThe Federal Circuit Court, or a judge of that court, may award costs in\nproceedings under section 46PO—see section 79 of the Federal\nCircuit Court of Australia Act 1999.",
      "skos:definition": "Insert:\n46PSA  Costs—court may have regard to an offer to settle\n\nIf:\n\n(a) proceedings have been instituted under section 46PO against\na respondent to a terminated complaint; and\n\n(b) an applicant or respondent has made, or makes, an offer to\nsettle the matter the subject of the complaint; and\n\n(c) the offer was or is rejected;\nthe court, or a judge of the court, in deciding whether to award\ncosts in the proceedings, may have regard to the offer.\nNote 1:\nThe Federal Court, or a judge of that court, may award costs in\nproceedings under section 46PO—see section 43 of the Federal Court\nof Australia Act 1976.\nNote 2:\nThe Federal Circuit Court, or a judge of that court, may award costs in\nproceedings under section 46PO—see section 79 of the Federal\nCircuit Court of Australia Act 1999.",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-57-norm"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-57-logic-deontic-1"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-57-logic-alleninterval-2"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-57-logic-argumentation-3"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-57-logic-diffusion-4"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-57-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "9e50323410f27f527cd8ee68430c0addd10848cfe9d8ea152d427e05dece8a16",
      "skos:note": "Court may have regard to an offer to settle when deciding whether to award costs."
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-57",
      "@type": "cof:Section",
      "cof:title": "57 After section 46PS",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Insert:\n46PSA  Costs—court may have regard to an offer to settle\n\nIf:\n\n(a) proceedings have been instituted under section 46PO against\na respondent to a terminated complaint; and\n\n(b) an applicant or respondent has made, or makes, an offer to\nsettle the matter the subject of the complaint; and\n\n(c) the offer was or is rejected;\nthe court, or a judge of the court, in deciding whether to award\ncosts in the proceedings, may have regard to the offer.\nNote 1:\nThe Federal Court, or a judge of that court, may award costs in\nproceedings under section 46PO—see section 43 of the Federal Court\nof Australia Act 1976.\nNote 2:\nThe Federal Circuit Court, or a judge of that court, may award costs in\nproceedings under section 46PO—see section 79 of the Federal\nCircuit Court of Australia Act 1999."
    },
