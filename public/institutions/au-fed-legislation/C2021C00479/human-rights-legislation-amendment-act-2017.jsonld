        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commissioner has a responsibility to report.",
      "cml:conclusionText": "The Commissioner's responsibility includes reporting."
    },
