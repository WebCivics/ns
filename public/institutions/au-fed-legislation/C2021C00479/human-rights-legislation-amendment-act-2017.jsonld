    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 After subsection 8(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-4"
