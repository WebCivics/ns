    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Subsection 8(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
