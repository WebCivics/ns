        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-10-ss-12"
        }
      ],
      "cml:integrityHash": "f552a1e79bdc74d313b3f0f000e309faa363c9b81f8db6b9d0fb2b41f0dcea48"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-10",
