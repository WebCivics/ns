      "prov:wasDerivedFrom": {
        "@id": "human-rights-legislation-amendment-act-2017.pdf"
      },
      "dc:source": "human-rights-legislation-amendment-act-2017.pdf, p.6",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) The members must co-operate with each other to achieve common\nobjectives, where practicable.\n\n(3) Subsection (2) does not affect the operation of section 44 (which\ndeals with meetings of the Commission).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) The members must co-operate with each other to achieve common\nobjectives, where practicable.\n\n(3) Subsection (2) does not affect the operation of section 44 (which\ndeals with meetings of the Commission).",
      "cml:hasPart": [
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-3-ss-2"
        },
        {
          "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-3-ss-3"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Subsection 8(2)",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) The members must co-operate with each other to achieve common\nobjectives, where practicable.\n\n(3) Subsection (2) does not affect the operation of section 44 (which\ndeals with meetings of the Commission)."
    },
