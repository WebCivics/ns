      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pj-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibition of refusing to attend a conference after notice.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person commits an offence if:\n\n(a) the person has been given a notice under subsection (3)\nrequiring the person to attend a conference; and\n\n(b) the person refuses or fails to comply with the requirement.",
      "cml:conclusionText": "Penalty: 10 penalty units."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pj-ss-5-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Notice overlaps with refusal to attend conference.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person commits an offence if:\n\n(a) the person has been given a notice under subsection (3)\nrequiring the person to attend a conference; and\n\n(b) the person refuses or fails to comply with the requirement.",
      "cml:conclusionText": "The notice and refusal overlap in time."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pj-ss-5-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Refusal occurs after notice expires.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person commits an offence if:\n\n(a) the person has been given a notice under subsection (3)\nrequiring the person to attend a conference; and\n\n(b) the person refuses or fails to comply with the requirement.",
      "cml:conclusionText": "The refusal occurs after the notice expires."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pj-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "There is an obligation to attend a conference after notice.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person commits an offence if:\n\n(a) the person has been given a notice under subsection (3)\nrequiring the person to attend a conference; and\n\n(b) the person refuses or fails to comply with the requirement.",
      "cml:conclusionText": "The person must attend the conference."
    },
    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-46pj-ss-5-logic-argumentation-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Refusal implies an offence.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) A person commits an offence if:\n\n(a) the person has been given a notice under subsection (3)\nrequiring the person to attend a conference; and\n\n(b) the person refuses or fails to comply with the requirement.",
      "cml:conclusionText": "If the person refuses, they commit an offence."
    },
    {
