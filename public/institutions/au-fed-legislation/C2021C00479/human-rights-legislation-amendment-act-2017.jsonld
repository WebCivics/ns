    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-54",
      "@type": "cml:Concept",
      "skos:prefLabel": "54 At the end of subsection 46PO(4)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-54"
