    {
      "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-43-ss-1d",
      "@type": "cof:Section",
      "cof:title": "43(1D) After subsection 46PH(1)",
      "values:kind": "subsection",
      "cof:pageNumber": 15,
      "values:originalText": "(1D) A complaint may be terminated under subsection (1B) or (1C) at\nany time, even if an inquiry into the complaint has begun."
    },
