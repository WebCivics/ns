    {
      "@id": "concept:human-rights-legislation-amendment-act-2017-sch-2-sec-59",
      "@type": "cml:Concept",
      "skos:prefLabel": "59 Transitional—tabling of reports",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-legislation-amendment-act-2017#sch-2-sec-59"
