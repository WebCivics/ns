    cml:hasPart concept:data-availability-and-transparency-consequential-amendments-act-2022-sch-1-sec-36b-ss-2 ;
    cml:hasPart concept:data-availability-and-transparency-consequential-amendments-act-2022-sch-1-sec-36b-ss-3 ;
