        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide accreditation application",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:data-availability-and-transparency-consequential-amendments-act-2022-sch-3-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/data-availability-and-transparency-consequential-amendments-act-2022#sch-3-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "data-availability-and-transparency-consequential-amendments-act-2022.pdf"
      },
      "dc:source": "data-availability-and-transparency-consequential-amendments-act-2022.pdf, p.10",
      "values:originalText": "(1)\nIn this Schedule:\nDAT Act means the Data Availability and Transparency Act 2022.\nrules means rules made by the Minister under item 4.\ntransitional entity means an Australian entity prescribed by the rules.\ntransition period, for a transitional entity, means the period prescribed\nfor the entity by the rules.\n(2)\nOther expressions used in this Schedule that are also used in the DAT\nAct have the same meaning in this Schedule as they have in the DAT\nAct.",
      "skos:definition": "(1)\nIn this Schedule:\nDAT Act means the Data Availability and Transparency Act 2022.\nrules means rules made by the Minister under item 4.\ntransitional entity means an Australian entity prescribed by the rules.\ntransition period, for a transitional entity, means the period prescribed\nfor the entity by the rules.\n(2)\nOther expressions used in this Schedule that are also used in the DAT\nAct have the same meaning in this Schedule as they have in the DAT\nAct.",
      "cml:asserts": [
        {
          "@id": "concept:data-availability-and-transparency-consequential-amendments-act-2022-sch-3-sec-1-norm"
        },
        {
          "@id": "concept:data-availability-and-transparency-consequential-amendments-act-2022-sch-3-sec-1-logic-descriptionlogic-1"
        }
      ],
      "cml:integrityHash": "e9d8b33bd7ef2d3daeafce5e5da0cd96722ed5358e395e214d424408863e77da",
      "skos:note": "Defines terms used in the Schedule."
    },
    {
      "@id": "https://ns.webcivics.net/values/data-availability-and-transparency-consequential-amendments-act-2022#sch-3-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Definitions",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1)\nIn this Schedule:\nDAT Act means the Data Availability and Transparency Act 2022.\nrules means rules made by the Minister under item 4.\ntransitional entity means an Australian entity prescribed by the rules.\ntransition period, for a transitional entity, means the period prescribed\nfor the entity by the rules.\n(2)\nOther expressions used in this Schedule that are also used in the DAT\nAct have the same meaning in this Schedule as they have in the DAT\nAct."
    },
    {
      "@id": "concept:data-availability-and-transparency-consequential-amendments-act-2022-sch-3-sec-1-norm",
