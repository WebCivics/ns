      "cml:integrityHash": "b70b665c3dbfa1828b37bdb333a8da8d044be5f84a2956aa9eb56082c6b1073d",
      "skos:note": "Commences with Data Availability and Transparency Act 2022, but only if that Act commences."
    },
    {
      "@id": "https://ns.webcivics.net/values/data-availability-and-transparency-consequential-amendments-act-2022#sec-1-2",
      "@type": "cof:Section",
      "cof:title": "1 Section 1",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "The whole of\nthis Act\nAt the same time as the Data Availability\nand Transparency Act 2022 commences.\nHowever, the provisions do not commence\nat all if that Act does not commence."
    },
