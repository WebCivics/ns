concept:c2022a00048-sch-1-sec-26 a cml:Concept ;
    skos:prefLabel "26 Existing appointments"@en ;
    cml:realizedBy doc:sch-1-sec-26 ;
    values:originalText "The amendments made by this Schedule do not affect:  (a) the validity of an appointment that was made before the commencement of this item; or  (b) a period of appointment that was specified in an instrument of appointment before that commencement.     Australian Human Rights Commission Legislation Amendment (Selection and Appointment) Act 2022 No. 48, 2022  [Minister’s second reading speech made in— House of Representatives on 27 July 2022 Senate on 3 August 2022]  (60/22)" ;
    skos:definition "The amendments made by this Schedule do not affect:  (a) the validity of an appointment that was made before the commencement of this item; or  (b) a period of appointment that was specified in an instrument of appointment before that commencement.     Australian Human Rights Commission Legislation Amendment (Selection and Appointment) Act 2022 No. 48, 2022  [Minister’s second reading speech made in— House of Representatives on 27 July 2022 Senate on 3 August 2022]  (60/22)"@en ;
    cml:integrityHash "7e44e816400a242b0741f53c1fec9e87a53b5c590e3955797a45efd48b4ef076" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Appointment validity not affected by amendments." ;
