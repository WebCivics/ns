concept:c2022a00048-sch-1-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 53A(1) (note)"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Repeal the note, substitute: Note: Subject to subsection 53B(1A), the Age Discrimination Commissioner may be reappointed: see section 33AA of the Acts Interpretation Act 1901." ;
    skos:definition "Repeal the note, substitute: Note: Subject to subsection 53B(1A), the Age Discrimination Commissioner may be reappointed: see section 33AA of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "fa37282b09f5d40aa8c071434417bb62189f53099222bea533c63463b31ce55b" ;
