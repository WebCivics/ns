concept:c2022a00048-sch-1-sec-4 a cml:Concept ;
    skos:prefLabel "4 After subsection 53B(1)"@en ;
    cml:realizedBy doc:sch-1-sec-4 ;
    values:originalText "Insert:  (1A) A person must not be appointed as the Age Discrimination Commissioner under section 53A for a period if the sum of the following exceeds 7 years:  (a) that period;  Schedule 1  Amendments  Australian Human Rights Commission Legislation Amendment (Selection and Appointment) Act 2022 No. 48, 2022  (b) any periods of previous appointment of the person as the Age Discrimination Commissioner under that section. Australian Human Rights Commission Act 1986" ;
    skos:definition "Insert:  (1A) A person must not be appointed as the Age Discrimination Commissioner under section 53A for a period if the sum of the following exceeds 7 years:  (a) that period;  Schedule 1  Amendments  Australian Human Rights Commission Legislation Amendment (Selection and Appointment) Act 2022 No. 48, 2022  (b) any periods of previous appointment of the person as the Age Discrimination Commissioner under that section. Australian Human Rights Commission Act 1986"@en ;
    cml:integrityHash "7e206113c4fe2e5d2ffc43f61898ba80f87d675ceadebb383b569476040c6c8f" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "No appointment exceeding 7 years is allowed." ;
