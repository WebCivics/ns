concept:c2022a00048-sch-1-sec-9 a cml:Concept ;
    skos:prefLabel "9 After subsection 37(1)"@en ;
    cml:realizedBy doc:sch-1-sec-9 ;
    values:originalText "Insert:  (2) A person must not be appointed as the President under section 8A for a period if the sum of the following exceeds 7 years:  (a) that period;  (b) any periods of previous appointment of the person as the President under that section.  (3) A person must not be appointed as the Human Rights Commissioner under section 8B for a period if the sum of the following exceeds 7 years:  (a) that period;  (b) any periods of previous appointment of the person as the Human Rights Commissioner under that section." ;
    skos:definition "Insert:  (2) A person must not be appointed as the President under section 8A for a period if the sum of the following exceeds 7 years:  (a) that period;  (b) any periods of previous appointment of the person as the President under that section.  (3) A person must not be appointed as the Human Rights Commissioner under section 8B for a period if the sum of the following exceeds 7 years:  (a) that period;  (b) any periods of previous appointment of the person as the Human Rights Commissioner under that section."@en ;
    cml:integrityHash "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4" ;
