concept:c2022a00048-sch-1-sec-12 a cml:Concept ;
    skos:prefLabel "12 After subsection 46D(1)"@en ;
    cml:realizedBy doc:sch-1-sec-12 ;
    values:originalText "Insert:  (1A) A person must not be appointed as the Aboriginal and Torres Strait Islander Social Justice Commissioner under section 46B for a period if the sum of the following exceeds 7 years:  (a) that period;  (b) any periods of previous appointment of the person as the Aboriginal and Torres Strait Islander Social Justice Commissioner under that section." ;
    skos:definition "Insert:  (1A) A person must not be appointed as the Aboriginal and Torres Strait Islander Social Justice Commissioner under section 46B for a period if the sum of the following exceeds 7 years:  (a) that period;  (b) any periods of previous appointment of the person as the Aboriginal and Torres Strait Islander Social Justice Commissioner under that section."@en ;
    cml:integrityHash "2db04bda4d7de81859ebf9034039c6e08aea96e4559d4bd6f875f3817050e08a" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "No appointment exceeding 7 years is allowed." ;
