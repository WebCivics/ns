        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.10",
      "values:originalText": "(2) A person must not be appointed under subsection (1) as the\nNational Children’s Commissioner unless the Minister is satisfied\nthat:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position.",
      "skos:definition": "(2) A person must not be appointed under subsection (1) as the\nNational Children’s Commissioner unless the Minister is satisfied\nthat:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position.",
      "values:partOf": {
        "@id": "concept:c2022a00048-sch-1-sec-13"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-13-ss-2-norm"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-13-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "233f415390cc5e9943d12b8ae5ad3a0241267cf395a8cfc28cbe0a316e0d6455",
      "skos:note": "Must have qualifications, knowledge or experience and a merit-based selection process."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-13-ss-2",
      "@type": "cof:Section",
      "cof:title": "13(2) Subsection 46MC(2)",
      "values:kind": "subsection",
      "cof:pageNumber": 10,
      "values:originalText": "(2) A person must not be appointed under subsection (1) as the\nNational Children’s Commissioner unless the Minister is satisfied\nthat:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position."
    },
