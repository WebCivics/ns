    {
      "@id": "concept:c2022a00048-sch-1-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 After subsection 97(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-25"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.13",
      "values:originalText": "Insert:\n\n(2) A person must not be appointed as the Sex Discrimination\nCommissioner under section 96 for a period if the sum of the\nfollowing exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the Sex\nDiscrimination Commissioner under that section.",
      "skos:definition": "Insert:\n\n(2) A person must not be appointed as the Sex Discrimination\nCommissioner under section 96 for a period if the sum of the\nfollowing exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the Sex\nDiscrimination Commissioner under that section.",
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-25-norm"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-25-logic-deontic-1"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-25-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "06c7698d87817fae6270fc6f77a3358641864a51edf94d6be6338705f8e09794",
      "skos:note": "No appointment exceeding 7 years is allowed."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-25",
      "@type": "cof:Section",
      "cof:title": "25 After subsection 97(1)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Insert:\n\n(2) A person must not be appointed as the Sex Discrimination\nCommissioner under section 96 for a period if the sum of the\nfollowing exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the Sex\nDiscrimination Commissioner under that section."
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-25-norm",
