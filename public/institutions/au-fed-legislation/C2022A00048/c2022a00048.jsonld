        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position."
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-6-ss-2-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "The selection process must occur within a specific time frame.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position."
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-6-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "The selection process must occur within a specific time frame.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position."
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-6-ss-2-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
