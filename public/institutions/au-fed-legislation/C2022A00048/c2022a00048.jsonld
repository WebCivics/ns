    {
      "@id": "concept:c2022a00048-sch-1-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 After subsection 53B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-4"
