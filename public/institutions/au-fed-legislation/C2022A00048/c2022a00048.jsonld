    {
      "@id": "concept:c2022a00048-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 48, 2022\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 48, 2022\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022",
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sec-3-norm"
        }
      ],
      "cml:integrityHash": "55b25347262b1fc5f96f240b5eef57aea3ec1c6512c3fd2d78860af94f1e27c9",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 48, 2022\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022"
    },
