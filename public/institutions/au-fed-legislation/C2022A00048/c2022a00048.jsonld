    {
      "@id": "concept:c2022a00048-sch-1-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 After subsection 30(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.12",
      "values:originalText": "Insert:\n\n(2) A person must not be appointed as the Race Discrimination\nCommissioner under section 29 for a period if the sum of the\nfollowing exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the\nRace Discrimination Commissioner under that section.\n\nAmendments  Schedule 1\n\nNo. 48, 2022\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022\n\nSex Discrimination Act 1984",
      "skos:definition": "Insert:\n\n(2) A person must not be appointed as the Race Discrimination\nCommissioner under section 29 for a period if the sum of the\nfollowing exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the\nRace Discrimination Commissioner under that section.\n\nAmendments  Schedule 1\n\nNo. 48, 2022\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022\n\nSex Discrimination Act 1984",
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-22-norm"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-22-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "35d0c6b4efc5bc84c09767151e87146bc520ecaaccdb45d78471baa6e85f369e",
      "skos:note": "No appointment for more than 7 years without exceeding the sum of previous appointments."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-22",
      "@type": "cof:Section",
      "cof:title": "22 After subsection 30(1)",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Insert:\n\n(2) A person must not be appointed as the Race Discrimination\nCommissioner under section 29 for a period if the sum of the\nfollowing exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the\nRace Discrimination Commissioner under that section.\n\nAmendments  Schedule 1\n\nNo. 48, 2022\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022\n\nSex Discrimination Act 1984"
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-22-norm",
