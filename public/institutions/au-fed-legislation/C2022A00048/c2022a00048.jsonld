    {
      "@id": "concept:c2022a00048-sch-1-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Existing appointments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.13",
      "values:originalText": "The amendments made by this Schedule do not affect:\n\n(a) the validity of an appointment that was made before the\ncommencement of this item; or\n\n(b) a period of appointment that was specified in an instrument\nof appointment before that commencement.\n\n\n\n\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022\nNo. 48, 2022\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 27 July 2022\nSenate on 3 August 2022]\n\n(60/22)",
      "skos:definition": "The amendments made by this Schedule do not affect:\n\n(a) the validity of an appointment that was made before the\ncommencement of this item; or\n\n(b) a period of appointment that was specified in an instrument\nof appointment before that commencement.\n\n\n\n\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022\nNo. 48, 2022\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 27 July 2022\nSenate on 3 August 2022]\n\n(60/22)",
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-26-norm"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-26-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7e44e816400a242b0741f53c1fec9e87a53b5c590e3955797a45efd48b4ef076",
      "skos:note": "Appointment validity not affected by amendments."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Existing appointments",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "The amendments made by this Schedule do not affect:\n\n(a) the validity of an appointment that was made before the\ncommencement of this item; or\n\n(b) a period of appointment that was specified in an instrument\nof appointment before that commencement.\n\n\n\n\nAustralian Human Rights Commission Legislation Amendment\n(Selection and Appointment) Act 2022\nNo. 48, 2022\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 27 July 2022\nSenate on 3 August 2022]\n\n(60/22)"
    },
