      "dc:source": "c2022a00048.pdf, p.10",
      "values:originalText": "Insert:\n\n(1A) A person must not be appointed as the Aboriginal and Torres Strait\nIslander Social Justice Commissioner under section 46B for a\nperiod if the sum of the following exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the\nAboriginal and Torres Strait Islander Social Justice\nCommissioner under that section.",
      "skos:definition": "Insert:\n\n(1A) A person must not be appointed as the Aboriginal and Torres Strait\nIslander Social Justice Commissioner under section 46B for a\nperiod if the sum of the following exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the\nAboriginal and Torres Strait Islander Social Justice\nCommissioner under that section.",
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-12-norm"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-12-logic-deontic-1"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-12-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "2db04bda4d7de81859ebf9034039c6e08aea96e4559d4bd6f875f3817050e08a",
      "skos:note": "No appointment exceeding 7 years is allowed."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 After subsection 46D(1)",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Insert:\n\n(1A) A person must not be appointed as the Aboriginal and Torres Strait\nIslander Social Justice Commissioner under section 46B for a\nperiod if the sum of the following exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the\nAboriginal and Torres Strait Islander Social Justice\nCommissioner under that section."
    },
