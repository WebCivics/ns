      },
      "cml:premiseText": "No previous appointments exceeding 7 years.",
      "cml:conclusionText": "Cannot be appointed for more than 7 years."
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Subsection 96(2)",
      "cml:realizedBy": {
