    {
      "@id": "concept:c2022a00048-sch-1-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 After subsection 114(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-19"
      },
      "cml:curationStatus": {
