        }
      ],
      "cml:integrityHash": "27895f08f36ddf457d05e9e43a450eca860b1123794c8ab4128dcc55485ff932",
      "skos:note": "No reappointment of President under previous appointment"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-5-ss-1b",
      "@type": "cof:Section",
      "cof:title": "5(1B) After subsection 8A(1)",
      "values:kind": "subsection",
