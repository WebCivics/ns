    {
      "@id": "concept:c2022a00048-sch-1-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 At the end of section 46MD",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.11",
      "values:originalText": "Add:\n\n(2) A person must not be appointed as the National Children’s\nCommissioner under section 46MC for a period if the sum of the\nfollowing exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the\nNational Children’s Commissioner under that section.\nDisability Discrimination Act 1992",
      "skos:definition": "Add:\n\n(2) A person must not be appointed as the National Children’s\nCommissioner under section 46MC for a period if the sum of the\nfollowing exceeds 7 years:\n\n(a) that period;\n\n(b) any periods of previous appointment of the person as the\nNational Children’s Commissioner under that section.\nDisability Discrimination Act 1992",
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-16-norm"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-16-logic-deontic-1"
