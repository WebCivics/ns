      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Appointment period exceeds 7 years",
      "cml:conclusionText": "No appointment is allowed"
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 After subsection 8A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-5"
