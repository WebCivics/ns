    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Subsection 53A(1) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.7",
      "values:originalText": "Repeal the note, substitute:\nNote:\nSubject to subsection 53B(1A), the Age Discrimination Commissioner\nmay be reappointed: see section 33AA of the Acts Interpretation Act\n1901.",
      "skos:definition": "Repeal the note, substitute:\nNote:\nSubject to subsection 53B(1A), the Age Discrimination Commissioner\nmay be reappointed: see section 33AA of the Acts Interpretation Act\n1901.",
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-1-norm"
        }
      ],
      "cml:integrityHash": "fa37282b09f5d40aa8c071434417bb62189f53099222bea533c63463b31ce55b",
      "skos:note": "Repeal a note and substitute with new text."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Subsection 53A(1) (note)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the note, substitute:\nNote:\nSubject to subsection 53B(1A), the Age Discrimination Commissioner\nmay be reappointed: see section 33AA of the Acts Interpretation Act\n1901."
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2022a00048-sch-1-sec-1"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Subsection 53A(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.7",
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) A person must not be appointed under subsection (1) as the Age\nDiscrimination Commissioner unless the Minister is satisfied that:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position.\n\n(3) Paragraph (2)(b) does not apply in relation to the reappointment of\na person who, immediately before the start of the period of\nreappointment, holds office as the Age Discrimination\nCommissioner under a previous appointment under subsection (1).",
      "skos:definition": "Repeal the subsection, substitute:\n\n(2) A person must not be appointed under subsection (1) as the Age\nDiscrimination Commissioner unless the Minister is satisfied that:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position.\n\n(3) Paragraph (2)(b) does not apply in relation to the reappointment of\na person who, immediately before the start of the period of\nreappointment, holds office as the Age Discrimination\nCommissioner under a previous appointment under subsection (1).",
      "cml:hasPart": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-2-ss-2"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-2-ss-3"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsection 53A(2)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Repeal the subsection, substitute:\n\n(2) A person must not be appointed under subsection (1) as the Age\nDiscrimination Commissioner unless the Minister is satisfied that:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position.\n\n(3) Paragraph (2)(b) does not apply in relation to the reappointment of\na person who, immediately before the start of the period of\nreappointment, holds office as the Age Discrimination\nCommissioner under a previous appointment under subsection (1)."
    },
    {
      "@id": "concept:c2022a00048-sch-1-sec-2-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2(2) Subsection 53A(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-2-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022a00048.pdf"
      },
      "dc:source": "c2022a00048.pdf, p.7",
      "values:originalText": "(2) A person must not be appointed under subsection (1) as the Age\nDiscrimination Commissioner unless the Minister is satisfied that:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position.",
      "skos:definition": "(2) A person must not be appointed under subsection (1) as the Age\nDiscrimination Commissioner unless the Minister is satisfied that:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position.",
      "values:partOf": {
        "@id": "concept:c2022a00048-sch-1-sec-2"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2022a00048-sch-1-sec-2-ss-2-norm"
        },
        {
          "@id": "concept:c2022a00048-sch-1-sec-2-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cd4872fd3e28cc2c56693bb2235ac98612e6e2c5600213656373ff4f4a1c70ca",
      "skos:note": "Must have qualifications, knowledge or experience and a merit-based selection process."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022a00048#sch-1-sec-2-ss-2",
      "@type": "cof:Section",
      "cof:title": "2(2) Subsection 53A(2)",
      "values:kind": "subsection",
      "cof:pageNumber": 7,
      "values:originalText": "(2) A person must not be appointed under subsection (1) as the Age\nDiscrimination Commissioner unless the Minister is satisfied that:\n\n(a) the person has appropriate qualifications, knowledge or\nexperience; and\n\n(b) the selection of the person for the appointment is the result of\na process that:\n\n(i) was merit-based; and\n\n(ii) included public advertising of the position."
    },
