      "dc:source": "crimes-amendment-penalty-unit-act-2022.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 82, 2022\nCrimes Amendment (Penalty Unit) Act 2022",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 82, 2022\nCrimes Amendment (Penalty Unit) Act 2022",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-penalty-unit-act-2022-sec-3-norm"
        }
      ],
      "cml:integrityHash": "d114f93442e04f5be92968d2bd082bd2d6a96adb1115f1586cb4f7e8b59d9583",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-penalty-unit-act-2022#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 82, 2022\nCrimes Amendment (Penalty Unit) Act 2022"
