      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Comply with declaration requirements",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "COMPLIANCE",
      "cml:premiseText": "(d) give the Commissioner, within 14 days after the end of the period specified in the declaration, evidence that the actions required by paragraphs (b) and (c) were taken in accordance with this section and the declaration."
    },
