      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Identify respondent and agency",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "IDENTITY",
      "cml:premiseText": "(i) the identity and contact details of the respondent or, if the respondent is the principal executive of an agency, the agency;"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-52a-ss-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Describe conduct constituting interference with privacy",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "DESCRIPTION",
      "cml:premiseText": "(ii) a description of the conduct engaged in by the respondent that constitutes the interference with the privacy of an individual;"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-52a-ss-1-logic-descriptionlogic-4",
