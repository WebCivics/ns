      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Describe steps to be taken to prevent repetition or continuation",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ACTION",
      "cml:premiseText": "(iii) the steps (if any) undertaken, or to be undertaken, by the respondent to ensure the conduct is not repeated or continued;"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-52a-ss-1-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Publish statement in specified manner",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "PUBLICATION",
      "cml:premiseText": "(c) if required by the declaration—publish, or otherwise communicate, the statement in the manner specified by the declaration;"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-52a-ss-1-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
