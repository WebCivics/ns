      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Refusal to provide information is recognized by CogAI as a contravention if it occurs during the time period when the person is required to give information",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
