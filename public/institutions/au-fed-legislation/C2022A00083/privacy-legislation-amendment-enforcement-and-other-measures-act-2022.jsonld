    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38",
      "@type": "cml:Concept",
      "skos:prefLabel": "38 Subsection 66(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-enforcement-and-other-measures-act-2022#sch-1-sec-38"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-legislation-amendment-enforcement-and-other-measures-act-2022.pdf"
      },
      "dc:source": "privacy-legislation-amendment-enforcement-and-other-measures-act-2022.pdf, p.19",
      "values:originalText": "Repeal the subsection, substitute:\nBasic contravention\n\n(1) A person contravenes this subsection if:\n\nSchedule 1  Amendments\n\nPrivacy Legislation Amendment (Enforcement and Other Measures)\nAct 2022\nNo. 83, 2022\n\n(a) the person is required to give information, answer a question\nor produce a document or record under this Act; and\n\n(b) the person refuses or fails to do so.\nCivil penalty:\n60 penalty units.",
      "skos:definition": "Repeal the subsection, substitute:\nBasic contravention\n\n(1) A person contravenes this subsection if:\n\nSchedule 1  Amendments\n\nPrivacy Legislation Amendment (Enforcement and Other Measures)\nAct 2022\nNo. 83, 2022\n\n(a) the person is required to give information, answer a question\nor produce a document or record under this Act; and\n\n(b) the person refuses or fails to do so.\nCivil penalty:\n60 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-norm"
        },
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-alleninterval-2"
        },
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-ltl-3"
        },
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-diffusion-4"
        },
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "e93722a748697581a2b1c555fc24641fd0fff364a1213d69e4af85ac40d143de",
      "skos:note": "Refusal to provide information under the Act"
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-enforcement-and-other-measures-act-2022#sch-1-sec-38",
      "@type": "cof:Section",
      "cof:title": "38 Subsection 66(1)",
      "values:kind": "section",
      "cof:pageNumber": 19,
      "values:originalText": "Repeal the subsection, substitute:\nBasic contravention\n\n(1) A person contravenes this subsection if:\n\nSchedule 1  Amendments\n\nPrivacy Legislation Amendment (Enforcement and Other Measures)\nAct 2022\nNo. 83, 2022\n\n(a) the person is required to give information, answer a question\nor produce a document or record under this Act; and\n\n(b) the person refuses or fails to do so.\nCivil penalty:\n60 penalty units."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Prohibits refusal to provide information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "State requires person to give information",
      "cml:conclusionText": "Person contravenes subsection if refuses or fails to do so"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Refusal to provide information overlaps with the requirement to give information",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Schedule 1 Amendments",
      "cml:conclusionText": "Refusal to provide information is a contravention if it occurs during the time period when the person is required to give information"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:logicSummary": "Refusal to provide information repeats the requirement to give information",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Schedule 1 Amendments",
      "cml:conclusionText": "Refusal to provide information is a repeated contravention if it occurs during the time period when the person is required to give information"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Diffusion of refusal to provide information diffuses the requirement to give information",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Schedule 1 Amendments",
      "cml:conclusionText": "Refusal to provide information diffuses the requirement to give information if it occurs during the time period when the person is required to give information"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-38-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:logicSummary": "CogAI recognizes refusal to provide information as a contravention",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Schedule 1 Amendments",
      "cml:conclusionText": "Refusal to provide information is recognized by CogAI as a contravention if it occurs during the time period when the person is required to give information"
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-39",
      "@type": "cml:Concept",
      "skos:prefLabel": "39 After subsection 66(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-enforcement-and-other-measures-act-2022#sch-1-sec-39"
      },
      "cml:curationStatus": {
