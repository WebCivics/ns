      "@type": "cml:Concept",
      "skos:prefLabel": "26WU(7) Power to obtain information and documents relating to",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-enforcement-and-other-measures-act-2022#sch-1-sec-26wu-ss-7"
