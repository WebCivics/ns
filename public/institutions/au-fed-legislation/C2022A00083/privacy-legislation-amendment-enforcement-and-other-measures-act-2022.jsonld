      "dc:source": "privacy-legislation-amendment-enforcement-and-other-measures-act-2022.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 83, 2022\nPrivacy Legislation Amendment (Enforcement and Other Measures)\nAct 2022",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 83, 2022\nPrivacy Legislation Amendment (Enforcement and Other Measures)\nAct 2022",
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sec-3-norm"
        }
      ],
      "cml:integrityHash": "13871f73140d6bb1af68fc842a82227ffef2a3880b014cc7277ce674874ce635",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
