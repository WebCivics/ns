      }
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Paragraph 29(2)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-enforcement-and-other-measures-act-2022#sch-1-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "privacy-legislation-amendment-enforcement-and-other-measures-act-2022.pdf"
      },
      "dc:source": "privacy-legislation-amendment-enforcement-and-other-measures-act-2022.pdf, p.8",
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing an information commissioner\nfunction or exercising a related power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing an information\ncommissioner function or exercising a related power; or\n\n(aa) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing a freedom of information function\nor exercising a related power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing a freedom of\ninformation function or exercising a related power; or\n\n(ab) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing a privacy function or exercising a\nrelated power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing a privacy\nfunction or exercising a related power; or",
      "skos:definition": "Repeal the paragraph, substitute:\n\n(a) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing an information commissioner\nfunction or exercising a related power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing an information\ncommissioner function or exercising a related power; or\n\n(aa) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing a freedom of information function\nor exercising a related power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing a freedom of\ninformation function or exercising a related power; or\n\n(ab) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing a privacy function or exercising a\nrelated power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing a privacy\nfunction or exercising a related power; or",
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-7-norm"
        },
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "af9090c4a7d086e008be10ab563d58b9d0c440459dcdfd67a1827daa796ffd3b",
      "skos:note": "Repeal paragraph 29(2)(a) and substitute with new conditions for information commissioner functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-enforcement-and-other-measures-act-2022#sch-1-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Paragraph 29(2)(a)",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Repeal the paragraph, substitute:\n\n(a) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing an information commissioner\nfunction or exercising a related power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing an information\ncommissioner function or exercising a related power; or\n\n(aa) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing a freedom of information function\nor exercising a related power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing a freedom of\ninformation function or exercising a related power; or\n\n(ab) both of the following apply:\n\n(i) the information was acquired by the person in the\ncourse of performing a privacy function or exercising a\nrelated power;\n\n(ii) the person records, discloses or otherwise uses the\ninformation in the course of performing a privacy\nfunction or exercising a related power; or"
    },
