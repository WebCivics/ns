      "dc:source": "privacy-legislation-amendment-enforcement-and-other-measures-act-2022.pdf, p.20",
      "values:originalText": "Repeal the note, substitute:\nNote:\nA person who wishes to rely on this subsection bears an evidential\nburden in relation to the matter in this subsection: see\nsubsection 13.3(3) of the Criminal Code and section 96 of the\nRegulatory Powers Act.",
      "skos:definition": "Repeal the note, substitute:\nNote:\nA person who wishes to rely on this subsection bears an evidential\nburden in relation to the matter in this subsection: see\nsubsection 13.3(3) of the Criminal Code and section 96 of the\nRegulatory Powers Act.",
      "cml:asserts": [
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-41-norm"
        },
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-41-logic-deontic-1"
        },
        {
          "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-41-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "b8e18bfd42b31ab2e7f00a78ce1e7500c79e3b27ee1d48be0674901981357752",
      "skos:note": "A person who wishes to rely on this subsection bears an evidential burden."
    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-enforcement-and-other-measures-act-2022#sch-1-sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Subsection 66(1B) (note)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Repeal the note, substitute:\nNote:\nA person who wishes to rely on this subsection bears an evidential\nburden in relation to the matter in this subsection: see\nsubsection 13.3(3) of the Criminal Code and section 96 of the\nRegulatory Powers Act."
    },
