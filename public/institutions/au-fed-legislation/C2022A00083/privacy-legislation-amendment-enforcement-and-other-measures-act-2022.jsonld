    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-14-ss-5-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Temporal interval for calculation period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) For the purposes of paragraph (3)(c), the adjusted turnover...",
      "cml:conclusionText": "The calculation is for a period during which the body corporate, and any related body corporate, have made or are likely to make supplies..."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-14-ss-5-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Recurring trace of supply values",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) For the purposes of paragraph (3)(c), the adjusted turnover...",
      "cml:conclusionText": "The sum is of values of all supplies that the body corporate, and any related body corporate, have made or are likely to make during the period..."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-14-ss-5-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Classifies adjusted turnover calculation as an obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) For the purposes of paragraph (3)(c), the adjusted turnover...",
      "cml:conclusionText": "The sum is a calculated value for the purpose of determining the adjusted turnover of a body corporate during a period."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-14-ss-5-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Classifies supplies not made by or to related bodies corporate as excluded",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(5) For the purposes of paragraph (3)(c), the adjusted turnover...",
      "cml:conclusionText": "The sum excludes supplies that are input taxed; or not for consideration; or not made in connection with an enterprise..."
    },
    {
