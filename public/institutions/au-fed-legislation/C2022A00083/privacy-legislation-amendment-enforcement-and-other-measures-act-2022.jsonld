    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-33b-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Commissioner has an obligation to consider certain factors.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Commissioner is required to disclose information if it is in the public interest.",
      "cml:conclusionText": "Commissioner must have regard to the rights and interests of complainants or respondents."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-33b-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BETWEEN",
      "cml:logicSummary": "Commissioner's decision-making process is bounded by temporal intervals.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Commissioner's factors for disclosure are relevant within a specific time frame.",
      "cml:conclusionText": "Commissioner must consider the factors within a reasonable timeframe."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-33b-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "BUT",
      "cml:logicSummary": "Commissioner's decision-making process is bounded by temporal intervals and other conditions.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Commissioner's factors for disclosure are relevant within a specific time frame, but also subject to other conditions.",
      "cml:conclusionText": "Commissioner must consider the factors within a reasonable timeframe, but also subject to other conditions."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-33b-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Commissioner's decision-making process is part of a larger diffusion process.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Commissioner's factors for disclosure are part of a broader process.",
      "cml:conclusionText": "Commissioner must consider the rights and interests of complainants or respondents within the context of this process."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-33b-ss-2-logic-cogai-5",
