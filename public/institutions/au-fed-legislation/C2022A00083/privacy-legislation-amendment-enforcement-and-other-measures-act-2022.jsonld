    },
    {
      "@id": "https://ns.webcivics.net/values/privacy-legislation-amendment-enforcement-and-other-measures-act-2022#sch-1-sec-33a-ss-6",
      "@type": "cof:Section",
      "cof:title": "33A(6) Commissioner may share information with other authorities",
      "values:kind": "subsection",
      "cof:pageNumber": 13,
      "values:originalText": "(6) To avoid doubt, the Commissioner may share information or\ndocuments with a receiving body under this section whether or not\nthe Commissioner is transferring a complaint or part of a complaint\nto the body."
    },
    {
      "@id": "concept:privacy-legislation-amendment-enforcement-and-other-measures-act-2022-sch-1-sec-33a-ss-6-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
