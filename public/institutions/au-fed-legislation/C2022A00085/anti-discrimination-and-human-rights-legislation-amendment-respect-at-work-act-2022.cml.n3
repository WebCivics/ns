concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-6-sec-10 a cml:Concept ;
    skos:prefLabel "10 Subsection 13(5)"@en ;
    cml:realizedBy doc:sch-6-sec-10 ;
    values:originalText "Repeal the subsection (not including the heading), substitute:  (5) The public report must be signed by:  (a) if the relevant employer is a Commonwealth entity—the accountable authority (within the meaning of the Public Governance, Performance and Accountability Act 2013) of the Commonwealth entity; and  (b) otherwise—the chief executive officer (however described) of the relevant employer." ;
    skos:definition "Repeal the subsection (not including the heading), substitute:  (5) The public report must be signed by:  (a) if the relevant employer is a Commonwealth entity—the accountable authority (within the meaning of the Public Governance, Performance and Accountability Act 2013) of the Commonwealth entity; and  (b) otherwise—the chief executive officer (however described) of the relevant employer."@en ;
    cml:integrityHash "81434c6a78c2d7be59d407024097784250b09aa0c65aa01d62a6670cf9227c78" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "Accountable authority must sign public report" ;
