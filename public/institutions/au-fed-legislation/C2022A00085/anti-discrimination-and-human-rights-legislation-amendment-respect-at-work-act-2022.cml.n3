doc:sch-6-sec-7 a cof:Section ;
    cof:title "7 After subsection 5(11)" ;
    values:kind "section" ;
    values:originalText "Insert:  (11A) By virtue of this subsection, this Act has the effect it would have if each reference in this Act to a relevant employer were, by express provision, confined to a relevant employer that is a Commonwealth company or a Commonwealth entity." ;
    cof:pageNumber "34"^^xsd:integer .

