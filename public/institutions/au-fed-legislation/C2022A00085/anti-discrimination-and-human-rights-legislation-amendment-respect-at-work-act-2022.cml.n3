concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-8-ss-6 a cml:Concept ;
    skos:prefLabel "8(6) After section 46PO"@en ;
    cml:realizedBy doc:sch-4-sec-8-ss-6 ;
    values:originalText "(6) A proceeding commenced by a representative application may not be settled or discontinued without the approval of the court concerned." ;
    skos:definition "(6) A proceeding commenced by a representative application may not be settled or discontinued without the approval of the court concerned."@en ;
