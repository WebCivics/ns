concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-6-sec-7 a cml:Concept ;
    skos:prefLabel "7 After subsection 5(11)"@en ;
    cml:realizedBy doc:sch-6-sec-7 ;
    values:originalText "Insert:  (11A) By virtue of this subsection, this Act has the effect it would have if each reference in this Act to a relevant employer were, by express provision, confined to a relevant employer that is a Commonwealth company or a Commonwealth entity." ;
    skos:definition "Insert:  (11A) By virtue of this subsection, this Act has the effect it would have if each reference in this Act to a relevant employer were, by express provision, confined to a relevant employer that is a Commonwealth company or a Commonwealth entity."@en ;
