concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-3-sec-35p a cml:Concept ;
    skos:prefLabel "35P Commission to give opportunity for making of submissions"@en ;
    cml:realizedBy doc:sch-3-sec-35p ;
    values:originalText "In an inquiry into a matter under this Division, the Commission must not make an adverse finding about a person unless it has given a reasonable opportunity to the person, to do, at the option of the person, either or both of the following:  (a) to appear before the Commission, whether in person or by a representative, and make oral submissions in relation to the matter;  (b) to make written submissions to the Commission in relation to the matter." ;
    skos:definition "In an inquiry into a matter under this Division, the Commission must not make an adverse finding about a person unless it has given a reasonable opportunity to the person, to do, at the option of the person, either or both of the following:  (a) to appear before the Commission, whether in person or by a representative, and make oral submissions in relation to the matter;  (b) to make written submissions to the Commission in relation to the matter."@en ;
    cml:integrityHash "eb4362db9bdd4b9f796e705535472206d7ac49e788b835555bf5dfca0aa6bcbf" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "Commission must give a reasonable opportunity to a person to make submissions before making an adverse finding." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf> ;
    dc:source "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.27" ;
    cml:asserts concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-3-sec-35p-norm .
