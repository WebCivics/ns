doc:sch-2-sec-35h-ss-2 a cof:Section ;
    cof:title "35H(2) Review of compliance notice" ;
    values:kind "subsection" ;
    values:originalText "(2) At any time after the application has been made, the court concerned may stay the operation of the notice on the terms and conditions that the court considers appropriate." ;
    cof:pageNumber "21"^^xsd:integer .

