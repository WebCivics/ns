doc:sch-2-sec-35d a cof:Section ;
    cof:title "35D Application of certain provisions of Division 3" ;
    values:kind "section" ;
    values:originalText "Sections 21, 22, 23 and 24 and subsection 26(1) apply in relation to the functions of the Commission set out in section 35A, and in relation to the performance of those functions, as if:  (a) references in section 21 to a matter under examination or inquiry under Division 3 were references to a matter under inquiry under this Division; and  (b) a reference in any of those provisions to another of those provisions were a reference to that other provision as applied by this section." ;
    cof:pageNumber "18"^^xsd:integer .

concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35e a cml:Concept ;
    skos:prefLabel "35E Notification of findings and recommendations"@en ;
    cml:realizedBy doc:sch-2-sec-35e ;
    values:originalText "If, as a result of an inquiry into a person’s compliance with the positive duty in relation to sex discrimination, the Commission finds that the person is not complying, the Commission:  Positive duty  Schedule 2 Compliance  Part 2  No. 85, 2022 Anti-Discrimination and Human Rights Legislation Amendment (Respect at Work) Act 2022  (a) must notify the person in writing of its finding and the reasons for the finding; and  (b) may notify the person of any recommendations by the Commission for preventing a repetition or continuation of the failure to comply." ;
    skos:definition "If, as a result of an inquiry into a person’s compliance with the positive duty in relation to sex discrimination, the Commission finds that the person is not complying, the Commission:  Positive duty  Schedule 2 Compliance  Part 2  No. 85, 2022 Anti-Discrimination and Human Rights Legislation Amendment (Respect at Work) Act 2022  (a) must notify the person in writing of its finding and the reasons for the finding; and  (b) may notify the person of any recommendations by the Commission for preventing a repetition or continuation of the failure to comply."@en ;
    cml:integrityHash "df5a67897c202b4f198c85e02c95aca821ddc9d73827a40fac2c3052b034675a" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Commission must notify person of finding and reasons for finding." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
