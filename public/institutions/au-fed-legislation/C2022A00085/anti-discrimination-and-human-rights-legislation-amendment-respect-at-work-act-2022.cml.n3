doc:sch-2-sec-35g-ss-6 a cof:Section ;
    cof:title "35G(6) Reconsideration of compliance notice" ;
    values:kind "subsection" ;
    values:originalText "(6) After reconsidering a compliance notice, the President must:  (a) affirm the compliance notice; or  (b) vary the compliance notice; or  (c) revoke the compliance notice." ;
    cof:pageNumber "20"^^xsd:integer .

concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35g-ss-7 a cml:Concept ;
    skos:prefLabel "35G(7) Reconsideration of compliance notice"@en ;
    cml:realizedBy doc:sch-2-sec-35g-ss-7 ;
    values:originalText "(7) The President must give written notice of a decision under subsection (6) to the person to whom the compliance notice was given, setting out the reasons for the decision. Decisions by delegates" ;
