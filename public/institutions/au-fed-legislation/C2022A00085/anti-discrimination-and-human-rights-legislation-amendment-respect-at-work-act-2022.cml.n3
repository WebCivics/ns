concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35j a cml:Concept ;
    skos:prefLabel "35J Enforcement of compliance notice"@en ;
    cml:realizedBy doc:sch-2-sec-35j ;
    values:originalText "(1) The President may apply to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) for an order under subsection (2) if:  (a) a person has been given a compliance notice; and  (b) the notice has not been revoked or cancelled; and  (c) the notice is not being reconsidered under section 35G or reviewed under section 35H; and  (d) the President considers that the person has not complied with the notice.  Schedule 2  Positive duty" ;
    skos:definition "(1) The President may apply to the Federal Court or the Federal Circuit and Family Court of Australia (Division 2) for an order under subsection (2) if:  (a) a person has been given a compliance notice; and  (b) the notice has not been revoked or cancelled; and  (c) the notice is not being reconsidered under section 35G or reviewed under section 35H; and  (d) the President considers that the person has not complied with the notice.  Schedule 2  Positive duty"@en ;
    cml:integrityHash "37bef7c34ffea456f6bb803f4a7c96d52e819e443408c0f15aacfe33bd33e245" ;
    cof:pageNumber "21"^^xsd:integer ;
    skos:note "The President may apply for an order if a person has not complied with a compliance notice." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf> ;
    dc:source "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.21" ;
    cml:asserts concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35j-norm .
