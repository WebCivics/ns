    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-4-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.31",
      "values:originalText": "Despite the amendments of Division 2 of Part IIB of the Australian\nHuman Rights Commission Act 1986 made by this Schedule, that\nDivision continues to apply, as if those amendments had not been made,\nin relation to:\n\n(a) any complaint that was terminated under Division 1 of\nPart IIB of that Act before the commencement of this item;\nand\n\n(b) any application made under subsection 46PO(1) of that Act,\nwhether before or after that commencement, if the complaint\non which the application is based was terminated under\nDivision 1 of Part IIB of that Act before that commencement.\n\nSchedule 6  Amendment of the Workplace Gender Equality Act 2012\n\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\nNo. 85, 2022",
      "skos:definition": "Despite the amendments of Division 2 of Part IIB of the Australian\nHuman Rights Commission Act 1986 made by this Schedule, that\nDivision continues to apply, as if those amendments had not been made,\nin relation to:\n\n(a) any complaint that was terminated under Division 1 of\nPart IIB of that Act before the commencement of this item;\nand\n\n(b) any application made under subsection 46PO(1) of that Act,\nwhether before or after that commencement, if the complaint\non which the application is based was terminated under\nDivision 1 of Part IIB of that Act before that commencement.\n\nSchedule 6  Amendment of the Workplace Gender Equality Act 2012\n\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\nNo. 85, 2022",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9-logic-deontic-1"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9-logic-alleninterval-2"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9-logic-argumentation-3"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9-logic-diffusion-4"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "281064edf54b116fd11e0c6cd36b43e05646d61a9d190789bfe5d5070652f167",
      "skos:note": "Continues to apply Division 1 of Part IIB of the Australian Human Rights Commission Act 1986 in relation to certain complaints and applications."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-4-sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Despite the amendments of Division 2 of Part IIB of the Australian\nHuman Rights Commission Act 1986 made by this Schedule, that\nDivision continues to apply, as if those amendments had not been made,\nin relation to:\n\n(a) any complaint that was terminated under Division 1 of\nPart IIB of that Act before the commencement of this item;\nand\n\n(b) any application made under subsection 46PO(1) of that Act,\nwhether before or after that commencement, if the complaint\non which the application is based was terminated under\nDivision 1 of Part IIB of that Act before that commencement.\n\nSchedule 6  Amendment of the Workplace Gender Equality Act 2012\n\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\nNo. 85, 2022"
    },
    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9-norm",
