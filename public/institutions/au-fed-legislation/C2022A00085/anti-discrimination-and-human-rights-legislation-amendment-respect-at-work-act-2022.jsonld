    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35j",
      "@type": "cml:Concept",
      "skos:prefLabel": "35J Enforcement of compliance notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35j"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.21",
      "values:originalText": "(1) The President may apply to the Federal Court or the Federal\nCircuit and Family Court of Australia (Division 2) for an order\nunder subsection (2) if:\n\n(a) a person has been given a compliance notice; and\n\n(b) the notice has not been revoked or cancelled; and\n\n(c) the notice is not being reconsidered under section 35G or\nreviewed under section 35H; and\n\n(d) the President considers that the person has not complied with\nthe notice.\n\nSchedule 2  Positive duty",
      "skos:definition": "(1) The President may apply to the Federal Court or the Federal\nCircuit and Family Court of Australia (Division 2) for an order\nunder subsection (2) if:\n\n(a) a person has been given a compliance notice; and\n\n(b) the notice has not been revoked or cancelled; and\n\n(c) the notice is not being reconsidered under section 35G or\nreviewed under section 35H; and\n\n(d) the President considers that the person has not complied with\nthe notice.\n\nSchedule 2  Positive duty",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35j-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35j-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "37bef7c34ffea456f6bb803f4a7c96d52e819e443408c0f15aacfe33bd33e245",
      "skos:note": "The President may apply for an order if a person has not complied with a compliance notice."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35j",
      "@type": "cof:Section",
      "cof:title": "35J Enforcement of compliance notice",
      "values:kind": "section",
      "cof:pageNumber": 21,
      "values:originalText": "(1) The President may apply to the Federal Court or the Federal\nCircuit and Family Court of Australia (Division 2) for an order\nunder subsection (2) if:\n\n(a) a person has been given a compliance notice; and\n\n(b) the notice has not been revoked or cancelled; and\n\n(c) the notice is not being reconsidered under section 35G or\nreviewed under section 35H; and\n\n(d) the President considers that the person has not complied with\nthe notice.\n\nSchedule 2  Positive duty"
    },
    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35j-norm",
