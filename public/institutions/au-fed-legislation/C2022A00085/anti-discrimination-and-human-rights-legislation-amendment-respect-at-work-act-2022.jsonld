    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 After subsection 46PO(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-4-sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.28",
      "values:originalText": "Insert:\n\n(2A) The application may be made:\n\n(a) by an affected person in relation to the terminated complaint:\n\n(i) on that person’s own behalf; or\n\n(ii) on behalf of that person and one or more other affected\npersons in relation to the terminated complaint; or\n\n(b) by 2 or more affected persons in relation to the terminated\ncomplaint:\n\nRepresentative applications  Schedule 4\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\n\n(i) on their own behalf; or\n\n(ii) on behalf of themselves and one or more other affected\npersons in relation to the terminated complaint; or\n\n(c) by a person or trade union who lodged the terminated\ncomplaint, on behalf of one or more affected persons in\nrelation to the terminated complaint.\nNote:\nPart IVA of the Federal Court of Australia Act 1976 also allows\nrepresentative proceedings to be commenced in the Federal Court in\ncertain circumstances.",
      "skos:definition": "Insert:\n\n(2A) The application may be made:\n\n(a) by an affected person in relation to the terminated complaint:\n\n(i) on that person’s own behalf; or\n\n(ii) on behalf of that person and one or more other affected\npersons in relation to the terminated complaint; or\n\n(b) by 2 or more affected persons in relation to the terminated\ncomplaint:\n\nRepresentative applications  Schedule 4\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\n\n(i) on their own behalf; or\n\n(ii) on behalf of themselves and one or more other affected\npersons in relation to the terminated complaint; or\n\n(c) by a person or trade union who lodged the terminated\ncomplaint, on behalf of one or more affected persons in\nrelation to the terminated complaint.\nNote:\nPart IVA of the Federal Court of Australia Act 1976 also allows\nrepresentative proceedings to be commenced in the Federal Court in\ncertain circumstances.",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-5-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "63fbd9dd3410292388127af15d9eab72e0a3ca66f166620759826dd0db40e895",
      "skos:note": "Application may be made by affected persons or a person/trade union on behalf of others in relation to a terminated complaint."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-4-sec-5",
      "@type": "cof:Section",
      "cof:title": "5 After subsection 46PO(2)",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "Insert:\n\n(2A) The application may be made:\n\n(a) by an affected person in relation to the terminated complaint:\n\n(i) on that person’s own behalf; or\n\n(ii) on behalf of that person and one or more other affected\npersons in relation to the terminated complaint; or\n\n(b) by 2 or more affected persons in relation to the terminated\ncomplaint:\n\nRepresentative applications  Schedule 4\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\n\n(i) on their own behalf; or\n\n(ii) on behalf of themselves and one or more other affected\npersons in relation to the terminated complaint; or\n\n(c) by a person or trade union who lodged the terminated\ncomplaint, on behalf of one or more affected persons in\nrelation to the terminated complaint.\nNote:\nPart IVA of the Federal Court of Australia Act 1976 also allows\nrepresentative proceedings to be commenced in the Federal Court in\ncertain circumstances."
    },
