    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-6-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Subsection 13(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-6-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.35",
      "values:originalText": "Repeal the subsection (not including the heading), substitute:\n\n(5) The public report must be signed by:\n\n(a) if the relevant employer is a Commonwealth entity—the\naccountable authority (within the meaning of the Public\nGovernance, Performance and Accountability Act 2013) of\nthe Commonwealth entity; and\n\n(b) otherwise—the chief executive officer (however described)\nof the relevant employer.",
      "skos:definition": "Repeal the subsection (not including the heading), substitute:\n\n(5) The public report must be signed by:\n\n(a) if the relevant employer is a Commonwealth entity—the\naccountable authority (within the meaning of the Public\nGovernance, Performance and Accountability Act 2013) of\nthe Commonwealth entity; and\n\n(b) otherwise—the chief executive officer (however described)\nof the relevant employer.",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-6-sec-10-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-6-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "81434c6a78c2d7be59d407024097784250b09aa0c65aa01d62a6670cf9227c78",
      "skos:note": "Accountable authority must sign public report"
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-6-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Subsection 13(5)",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "Repeal the subsection (not including the heading), substitute:\n\n(5) The public report must be signed by:\n\n(a) if the relevant employer is a Commonwealth entity—the\naccountable authority (within the meaning of the Public\nGovernance, Performance and Accountability Act 2013) of\nthe Commonwealth entity; and\n\n(b) otherwise—the chief executive officer (however described)\nof the relevant employer."
    },
