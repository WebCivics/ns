      "cml:integrityHash": "87e76e840289f684aa1565798a2a05f9a0eaff416b8bc09a738a5f1d1e81e1b9",
      "skos:note": "Must affirm, vary or revoke a compliance notice after reconsideration."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35g-ss-6",
      "@type": "cof:Section",
      "cof:title": "35G(6) Reconsideration of compliance notice",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(6) After reconsidering a compliance notice, the President must:\n\n(a) affirm the compliance notice; or\n\n(b) vary the compliance notice; or\n\n(c) revoke the compliance notice."
    },
