    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-1-sec-8a",
      "@type": "cml:Concept",
      "skos:prefLabel": "8A Workplace environment that is hostile for 2 or more reasons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-1-sec-8a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.8",
      "values:originalText": "For the purposes of this Act, a workplace environment may be\noffensive, intimidating or humiliating to a person by reason of:\n\n(a) the sex of the person; or\n\n(b) a characteristic that appertains generally to persons of the sex\nof the person; or\n\n(c) a characteristic that is generally imputed to persons of the sex\nof the person;\nif it is offensive, intimidating or humiliating by reason of 2 or more\nmatters that include the sex or the characteristic, whether or not the\nsex or the characteristic is the dominant or substantial reason.\n\nHostile workplace environments  Schedule 1\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022",
      "skos:definition": "For the purposes of this Act, a workplace environment may be\noffensive, intimidating or humiliating to a person by reason of:\n\n(a) the sex of the person; or\n\n(b) a characteristic that appertains generally to persons of the sex\nof the person; or\n\n(c) a characteristic that is generally imputed to persons of the sex\nof the person;\nif it is offensive, intimidating or humiliating by reason of 2 or more\nmatters that include the sex or the characteristic, whether or not the\nsex or the characteristic is the dominant or substantial reason.\n\nHostile workplace environments  Schedule 1\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-1-sec-8a-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-1-sec-8a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7a1b1b5a8bad72605014f49c6f169a814b48167defba28f5c5fb497f8a148fb6",
      "skos:note": "Workplace environment must not be hostile for 2 or more reasons"
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-1-sec-8a",
      "@type": "cof:Section",
      "cof:title": "8A Workplace environment that is hostile for 2 or more reasons",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "For the purposes of this Act, a workplace environment may be\noffensive, intimidating or humiliating to a person by reason of:\n\n(a) the sex of the person; or\n\n(b) a characteristic that appertains generally to persons of the sex\nof the person; or\n\n(c) a characteristic that is generally imputed to persons of the sex\nof the person;\nif it is offensive, intimidating or humiliating by reason of 2 or more\nmatters that include the sex or the characteristic, whether or not the\nsex or the characteristic is the dominant or substantial reason.\n\nHostile workplace environments  Schedule 1\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022"
    },
