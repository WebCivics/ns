      "@type": "cml:Concept",
      "skos:prefLabel": "8(3) After section 46PO",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-4-sec-8-ss-3"
