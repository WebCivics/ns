    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-3-sec-35n",
      "@type": "cml:Concept",
      "skos:prefLabel": "35N Application of certain provisions of Division 3",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-3-sec-35n"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.26",
      "values:originalText": "Sections 21, 22, 23 and 24 and subsection 26(1) apply in relation to\nthe functions of the Commission set out in section 35L, and in\nrelation to the performance of those functions, as if:\n\n(a) references in section 21 to a matter under examination or\ninquiry under Division 3 were references to a matter under\ninquiry under this Division; and\n\n(b) a reference in any of those provisions to another of those\nprovisions were a reference to that other provision as applied\nby this section.\n\nInquiries into systemic unlawful discrimination  Schedule 3\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022",
      "skos:definition": "Sections 21, 22, 23 and 24 and subsection 26(1) apply in relation to\nthe functions of the Commission set out in section 35L, and in\nrelation to the performance of those functions, as if:\n\n(a) references in section 21 to a matter under examination or\ninquiry under Division 3 were references to a matter under\ninquiry under this Division; and\n\n(b) a reference in any of those provisions to another of those\nprovisions were a reference to that other provision as applied\nby this section.\n\nInquiries into systemic unlawful discrimination  Schedule 3\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-3-sec-35n-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-3-sec-35n-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "875efa89b33fa03260ced8ac3a89dea63cc01d81ed5681585767a5c3f955af2b",
      "skos:note": "Sections 21, 22, 23 and 24 apply in relation to the functions of the Commission set out in section 35L."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-3-sec-35n",
      "@type": "cof:Section",
      "cof:title": "35N Application of certain provisions of Division 3",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Sections 21, 22, 23 and 24 and subsection 26(1) apply in relation to\nthe functions of the Commission set out in section 35L, and in\nrelation to the performance of those functions, as if:\n\n(a) references in section 21 to a matter under examination or\ninquiry under Division 3 were references to a matter under\ninquiry under this Division; and\n\n(b) a reference in any of those provisions to another of those\nprovisions were a reference to that other provision as applied\nby this section.\n\nInquiries into systemic unlawful discrimination  Schedule 3\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022"
    },
