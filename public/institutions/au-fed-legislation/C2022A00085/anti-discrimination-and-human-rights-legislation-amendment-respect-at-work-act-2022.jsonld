    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35e",
      "@type": "cml:Concept",
      "skos:prefLabel": "35E Notification of findings and recommendations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.18",
      "values:originalText": "If, as a result of an inquiry into a person’s compliance with the\npositive duty in relation to sex discrimination, the Commission\nfinds that the person is not complying, the Commission:\n\nPositive duty  Schedule 2\nCompliance  Part 2\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\n\n(a) must notify the person in writing of its finding and the\nreasons for the finding; and\n\n(b) may notify the person of any recommendations by the\nCommission for preventing a repetition or continuation of the\nfailure to comply.",
      "skos:definition": "If, as a result of an inquiry into a person’s compliance with the\npositive duty in relation to sex discrimination, the Commission\nfinds that the person is not complying, the Commission:\n\nPositive duty  Schedule 2\nCompliance  Part 2\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\n\n(a) must notify the person in writing of its finding and the\nreasons for the finding; and\n\n(b) may notify the person of any recommendations by the\nCommission for preventing a repetition or continuation of the\nfailure to comply.",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35e-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35e-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "df5a67897c202b4f198c85e02c95aca821ddc9d73827a40fac2c3052b034675a",
      "skos:note": "Commission must notify person of finding and reasons for finding.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35e",
      "@type": "cof:Section",
      "cof:title": "35E Notification of findings and recommendations",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "If, as a result of an inquiry into a person’s compliance with the\npositive duty in relation to sex discrimination, the Commission\nfinds that the person is not complying, the Commission:\n\nPositive duty  Schedule 2\nCompliance  Part 2\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\n\n(a) must notify the person in writing of its finding and the\nreasons for the finding; and\n\n(b) may notify the person of any recommendations by the\nCommission for preventing a repetition or continuation of the\nfailure to comply."
    },
    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35e-norm",
      "@type": "values:Obligation",
