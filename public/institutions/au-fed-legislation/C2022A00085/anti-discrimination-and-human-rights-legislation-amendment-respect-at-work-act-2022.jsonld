        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-3-sec-35l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
