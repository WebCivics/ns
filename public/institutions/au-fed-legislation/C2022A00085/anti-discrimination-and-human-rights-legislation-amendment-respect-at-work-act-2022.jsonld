    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35d",
      "@type": "cml:Concept",
      "skos:prefLabel": "35D Application of certain provisions of Division 3",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.18",
      "values:originalText": "Sections 21, 22, 23 and 24 and subsection 26(1) apply in relation to\nthe functions of the Commission set out in section 35A, and in\nrelation to the performance of those functions, as if:\n\n(a) references in section 21 to a matter under examination or\ninquiry under Division 3 were references to a matter under\ninquiry under this Division; and\n\n(b) a reference in any of those provisions to another of those\nprovisions were a reference to that other provision as applied\nby this section.",
      "skos:definition": "Sections 21, 22, 23 and 24 and subsection 26(1) apply in relation to\nthe functions of the Commission set out in section 35A, and in\nrelation to the performance of those functions, as if:\n\n(a) references in section 21 to a matter under examination or\ninquiry under Division 3 were references to a matter under\ninquiry under this Division; and\n\n(b) a reference in any of those provisions to another of those\nprovisions were a reference to that other provision as applied\nby this section.",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35d-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35d-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "17f27c53fe28759911bca7605ebef960368921300a337a713af41457bd0328ea",
      "skos:note": "Application of certain provisions of Division 3 to Commission functions"
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35d",
      "@type": "cof:Section",
      "cof:title": "35D Application of certain provisions of Division 3",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Sections 21, 22, 23 and 24 and subsection 26(1) apply in relation to\nthe functions of the Commission set out in section 35A, and in\nrelation to the performance of those functions, as if:\n\n(a) references in section 21 to a matter under examination or\ninquiry under Division 3 were references to a matter under\ninquiry under this Division; and\n\n(b) a reference in any of those provisions to another of those\nprovisions were a reference to that other provision as applied\nby this section."
    },
