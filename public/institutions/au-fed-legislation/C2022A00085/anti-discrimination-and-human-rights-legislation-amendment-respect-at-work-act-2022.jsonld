    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 After subsection 19(2C)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-21"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.17",
      "values:originalText": "Insert:\n\n(2D) Subsection (2) does not allow the President to delegate a power\nunder section 35F, 35G or 35J to a person other than a member of\nthe staff of the Commission who is:\n\n(a) an SES employee; or\n\n(b) an acting SES employee; or\n\n(c) classified as Executive Level 2 or equivalent; or\n\n(d) acting in a position usually occupied by a member of the staff\nof the Commission who is so classified.\nNote:\nThe expressions SES employee and acting SES employee are defined\nin the Acts Interpretation Act 1901.",
      "skos:definition": "Insert:\n\n(2D) Subsection (2) does not allow the President to delegate a power\nunder section 35F, 35G or 35J to a person other than a member of\nthe staff of the Commission who is:\n\n(a) an SES employee; or\n\n(b) an acting SES employee; or\n\n(c) classified as Executive Level 2 or equivalent; or\n\n(d) acting in a position usually occupied by a member of the staff\nof the Commission who is so classified.\nNote:\nThe expressions SES employee and acting SES employee are defined\nin the Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-21-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-21-logic-deontic-1"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-21-logic-alleninterval-2"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-21-logic-ltl-3"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-21-logic-cogai-4"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-21-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "0ec6777fd3d07a0f7c2f0f22c6b7aeecc537f0f9f8bb09cf6afe3e730d23e813",
      "skos:note": "Delegation of power under certain sections is restricted to specific individuals."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-21",
      "@type": "cof:Section",
      "cof:title": "21 After subsection 19(2C)",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Insert:\n\n(2D) Subsection (2) does not allow the President to delegate a power\nunder section 35F, 35G or 35J to a person other than a member of\nthe staff of the Commission who is:\n\n(a) an SES employee; or\n\n(b) an acting SES employee; or\n\n(c) classified as Executive Level 2 or equivalent; or\n\n(d) acting in a position usually occupied by a member of the staff\nof the Commission who is so classified.\nNote:\nThe expressions SES employee and acting SES employee are defined\nin the Acts Interpretation Act 1901."
    },
