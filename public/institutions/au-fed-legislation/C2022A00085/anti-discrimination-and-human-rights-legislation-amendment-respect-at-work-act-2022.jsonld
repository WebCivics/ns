      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.26",
      "values:originalText": "The Commission may perform the functions referred to in\nparagraph 35L(1)(a) when:\n\n(a) the Commission is requested to do so by the Minister; or\n\n(b) it appears to the Commission to be desirable to do so.",
      "skos:definition": "The Commission may perform the functions referred to in\nparagraph 35L(1)(a) when:\n\n(a) the Commission is requested to do so by the Minister; or\n\n(b) it appears to the Commission to be desirable to do so.",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-3-sec-35m-norm"
        },
