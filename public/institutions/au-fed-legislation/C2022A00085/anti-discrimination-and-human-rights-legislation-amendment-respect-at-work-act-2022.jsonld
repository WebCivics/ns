      "cml:integrityHash": "437ccc6be7caa93f459b3710e80a53a773804c096c038cbae502d53b9b18745f",
      "skos:note": "The President must give a written notice to a person not complying with the positive duty in relation to sex discrimination."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35f-ss-1",
      "@type": "cof:Section",
      "cof:title": "35F(1) Giving of compliance notice",
      "values:kind": "subsection",
      "cof:pageNumber": 19,
      "values:originalText": "(1) If, as a result of an inquiry into a person’s compliance with the\npositive duty in relation to sex discrimination, the Commission\nfinds that the person is not complying, the President may give the\nperson a written notice."
    },
