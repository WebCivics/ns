        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "35AA Performance of functions relating to positive duty in relation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.16",
      "values:originalText": "to sex discrimination\n\nIn performing its functions under section 35A, the Commission\nmust have regard to:\n\n(a) the need for guidelines and other materials to be available in\nmultiple languages; and\n\n(b) the cultural diversity of Australian workplaces.",
      "skos:definition": "to sex discrimination\n\nIn performing its functions under section 35A, the Commission\nmust have regard to:\n\n(a) the need for guidelines and other materials to be available in\nmultiple languages; and\n\n(b) the cultural diversity of Australian workplaces.",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35aa-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6b5b9cf89d842a8767184cb65a1799dc61fe65567628bd5b0673ccce51ccaa0d",
      "skos:note": "Commission must have regard to guidelines and cultural diversity in performing its functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35aa",
      "@type": "cof:Section",
      "cof:title": "35AA Performance of functions relating to positive duty in relation",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "to sex discrimination\n\nIn performing its functions under section 35A, the Commission\nmust have regard to:\n\n(a) the need for guidelines and other materials to be available in\nmultiple languages; and\n\n(b) the cultural diversity of Australian workplaces."
    },
