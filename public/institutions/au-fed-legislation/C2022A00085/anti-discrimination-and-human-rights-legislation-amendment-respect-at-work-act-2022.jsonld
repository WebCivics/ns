    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-6-sec-5b",
      "@type": "cml:Concept",
      "skos:prefLabel": "5B Binding the Crown",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-6-sec-5b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.34",
      "values:originalText": "This Act binds the Crown in right of the Commonwealth.\nHowever, it does not bind the Crown in right of a State, of the\nAustralian Capital Territory or of the Northern Territory.",
      "skos:definition": "This Act binds the Crown in right of the Commonwealth.\nHowever, it does not bind the Crown in right of a State, of the\nAustralian Capital Territory or of the Northern Territory.",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-6-sec-5b-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-6-sec-5b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4aa7b251527907ec7df5bc01f98e34a55a6ea5fe13c77a049b118b94b76605de",
      "skos:note": "The Act binds the Crown in certain jurisdictions."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-6-sec-5b",
      "@type": "cof:Section",
      "cof:title": "5B Binding the Crown",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "This Act binds the Crown in right of the Commonwealth.\nHowever, it does not bind the Crown in right of a State, of the\nAustralian Capital Territory or of the Northern Territory."
    },
