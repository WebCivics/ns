    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35b",
      "@type": "cml:Concept",
      "skos:prefLabel": "35B Performance of inquiry function relating to positive duty in",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.17",
      "values:originalText": "relation to sex discrimination\n\n(1) The Commission may inquire into a person’s compliance with the\npositive duty in relation to sex discrimination if the Commission\nreasonably suspects that the person is not complying.\n\n(2) The Commission must act fairly in the performance of the function\nreferred to in paragraph 35A(d).\n\nSchedule 2  Positive duty",
      "skos:definition": "relation to sex discrimination\n\n(1) The Commission may inquire into a person’s compliance with the\npositive duty in relation to sex discrimination if the Commission\nreasonably suspects that the person is not complying.\n\n(2) The Commission must act fairly in the performance of the function\nreferred to in paragraph 35A(d).\n\nSchedule 2  Positive duty",
      "cml:hasPart": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35b-ss-1"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35b-ss-2"
        }
      ],
      "cml:integrityHash": "0bbd07c865f3f96f3f06dd9f0c4b352af97f5a5c80d646730491d82b355becf8"
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35b",
      "@type": "cof:Section",
      "cof:title": "35B Performance of inquiry function relating to positive duty in",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "relation to sex discrimination\n\n(1) The Commission may inquire into a person’s compliance with the\npositive duty in relation to sex discrimination if the Commission\nreasonably suspects that the person is not complying.\n\n(2) The Commission must act fairly in the performance of the function\nreferred to in paragraph 35A(d).\n\nSchedule 2  Positive duty"
    },
