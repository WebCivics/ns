        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35c-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b153eb0b1a4996031b3d9e347c1a62e1ad174ae131b822fb5d2a4a27d0ad2cfe",
      "skos:note": "Commission must give person opportunity to comply with sex discrimination duty"
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35c-ss-2",
      "@type": "cof:Section",
      "cof:title": "35C(2) Commission to notify person and give opportunity for making",
      "values:kind": "subsection",
      "cof:pageNumber": 18,
      "values:originalText": "(2) The Commission must not find that a person is not complying with\nthe positive duty in relation to sex discrimination unless it has\ngiven a reasonable opportunity to the person, to do, at the option of\nthe person, either or both of the following:\n\n(a) to appear before the Commission, whether in person or by a\nrepresentative, and make oral submissions in relation to the\nperson’s compliance;\n\n(b) to make written submissions to the Commission in relation to\nthe person’s compliance."
    },
