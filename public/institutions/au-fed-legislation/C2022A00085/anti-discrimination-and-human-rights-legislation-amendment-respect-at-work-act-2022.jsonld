      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.41",
      "values:originalText": "(1) It is unlawful for a person to commit an act of victimisation against\nanother person.\nNote 1:\nSee also subsection 27(2) (offences relating to administration of this\nAct).\nNote 2:\nSee also the definition of unlawful discrimination in the Australian\nHuman Rights Commission Act 1986.\n\nSchedule 7  Victimisation",
      "skos:definition": "(1) It is unlawful for a person to commit an act of victimisation against\nanother person.\nNote 1:\nSee also subsection 27(2) (offences relating to administration of this\nAct).\nNote 2:\nSee also the definition of unlawful discrimination in the Australian\nHuman Rights Commission Act 1986.\n\nSchedule 7  Victimisation",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-7-sec-18aa-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-7-sec-18aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "14a0c853de7a21804c2a43921354527804c260c6c26b672f4e6394c132f59bf1",
      "skos:note": "It is unlawful for a person to commit an act of victimisation against another person."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-7-sec-18aa",
      "@type": "cof:Section",
      "cof:title": "18AA Victimisation",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "(1) It is unlawful for a person to commit an act of victimisation against\nanother person.\nNote 1:\nSee also subsection 27(2) (offences relating to administration of this\nAct).\nNote 2:\nSee also the definition of unlawful discrimination in the Australian\nHuman Rights Commission Act 1986.\n\nSchedule 7  Victimisation"
    },
