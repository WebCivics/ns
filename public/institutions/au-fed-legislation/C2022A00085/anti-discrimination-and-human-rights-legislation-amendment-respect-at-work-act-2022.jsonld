    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-2-sec-35g-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "35G(8) Reconsideration of compliance notice",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-2-sec-35g-ss-8"
      },
