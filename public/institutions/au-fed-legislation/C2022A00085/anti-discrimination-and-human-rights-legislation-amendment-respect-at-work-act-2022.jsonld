        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-3-sec-35m-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "e575acb4bf473fe8c9c1240e7cc59a452cc9e0044cf1a3e08501b9eb87fb38c9",
      "skos:note": "Commission may perform functions upon request or deemed desirable"
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-3-sec-35m",
      "@type": "cof:Section",
      "cof:title": "35M Performance of functions relating to systemic discrimination",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "The Commission may perform the functions referred to in\nparagraph 35L(1)(a) when:\n\n(a) the Commission is requested to do so by the Minister; or\n\n(b) it appears to the Commission to be desirable to do so."
    },
