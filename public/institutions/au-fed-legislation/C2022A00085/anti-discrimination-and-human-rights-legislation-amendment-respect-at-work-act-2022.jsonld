      }
    },
    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sec-4-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Review of operation of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sec-4-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf"
      },
      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.7",
      "values:originalText": "(1) The Minister must cause an independent review to be conducted of\nthe operation of the amendments made by this Act.\n\n(2) Without limiting subsection (1), the review must consider whether:\n\n(a) the amendments made by this Act are operating effectively;\nand\n\n(b) the Australian Human Rights Commission has capacity to\ncarry out the functions relating to compliance with the\npositive duty in relation to sex discrimination in Division 4A\nof Part II of the Australian Human Rights Commission Act\n1986, as inserted by Part 2 of Schedule 2 to this Act.\n\n(3) The review must commence as soon as practicable after the end of\nthe period of 2 years after the day Division 2 of Part 2 of\nSchedule 2 to this Act commences and, in any event, not later than\n3 years after that day.\n\n(4) The persons who conduct the review must give the Minister a\nwritten report of the review as soon as practicable and, in any\nevent, not later than 9 months after commencement of the review.\n\n(5) The Minister must cause a copy of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe report is given to the Minister.\n\nSchedule 1  Hostile workplace environments\n\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\nNo. 85, 2022",
      "skos:definition": "(1) The Minister must cause an independent review to be conducted of\nthe operation of the amendments made by this Act.\n\n(2) Without limiting subsection (1), the review must consider whether:\n\n(a) the amendments made by this Act are operating effectively;\nand\n\n(b) the Australian Human Rights Commission has capacity to\ncarry out the functions relating to compliance with the\npositive duty in relation to sex discrimination in Division 4A\nof Part II of the Australian Human Rights Commission Act\n1986, as inserted by Part 2 of Schedule 2 to this Act.\n\n(3) The review must commence as soon as practicable after the end of\nthe period of 2 years after the day Division 2 of Part 2 of\nSchedule 2 to this Act commences and, in any event, not later than\n3 years after that day.\n\n(4) The persons who conduct the review must give the Minister a\nwritten report of the review as soon as practicable and, in any\nevent, not later than 9 months after commencement of the review.\n\n(5) The Minister must cause a copy of the report to be tabled in each\nHouse of the Parliament within 15 sitting days of that House after\nthe report is given to the Minister.\n\nSchedule 1  Hostile workplace environments\n\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022\nNo. 85, 2022",
      "cml:hasPart": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sec-4-2-ss-1"
        },
