      "@type": "cml:Concept",
      "skos:prefLabel": "18AA Victimisation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-7-sec-18aa"
