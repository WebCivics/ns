      "dc:source": "anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022.pdf, p.42",
      "values:originalText": "Omit “2 or 3”, substitute “2, 3 or 5”.\n\nVictimisation  Schedule 7\nApplication and transitional provisions  Part 2\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022",
      "skos:definition": "Omit “2 or 3”, substitute “2, 3 or 5”.\n\nVictimisation  Schedule 7\nApplication and transitional provisions  Part 2\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022",
      "cml:asserts": [
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-7-sec-16-norm"
        },
        {
          "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-7-sec-16-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7e7318e82439215b8ff3ec5593f24f9aaf7b4b87e88e890f743fef28f8d19668",
      "skos:note": "Substitute numbers in a provision."
    },
    {
      "@id": "https://ns.webcivics.net/values/anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022#sch-7-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Section 105",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "Omit “2 or 3”, substitute “2, 3 or 5”.\n\nVictimisation  Schedule 7\nApplication and transitional provisions  Part 2\n\nNo. 85, 2022\nAnti-Discrimination and Human Rights Legislation Amendment\n(Respect at Work) Act 2022"
    },
    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-7-sec-16-norm",
      "@type": "values:Obligation",
