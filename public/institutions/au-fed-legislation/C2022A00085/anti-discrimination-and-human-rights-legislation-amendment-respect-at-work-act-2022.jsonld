      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Continues",
      "cml:logicSummary": "Division 1 of Part IIB continues to apply",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Amendments made by this Schedule",
      "cml:conclusionText": "Division 1 of Part IIB continues to apply"
    },
    {
      "@id": "concept:anti-discrimination-and-human-rights-legislation-amendment-respect-at-work-act-2022-sch-4-sec-9-logic-alleninterval-2",
