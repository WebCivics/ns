      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Staff-elected Director has obligation to perform services under contract",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "(b) the person (the relevant person) performs services for the Corporation, under the direction and control of the Managing Director or an employee of the Corporation, under:"
    },
    {
