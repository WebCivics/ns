    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Corporation does not have to retain the record.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If the record is not in the custody of a court, then the Corporation does not have to retain it.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "The obligation imposed by this section on the Corporation to retain a record does not apply at any time when the record is in the custody of a court."
