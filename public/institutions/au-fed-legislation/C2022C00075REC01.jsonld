      "cml:logicSummary": "Staff-elected Director has obligation to devote time to duties",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasObligation",
      "cml:premiseText": "(2) A person is eligible to be a candidate for election, and to hold office, as the staff-elected Director if:"
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-13a-ss-2-logic-deontic-2",
