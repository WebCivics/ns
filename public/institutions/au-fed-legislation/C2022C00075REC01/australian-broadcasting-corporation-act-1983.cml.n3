concept:australian-broadcasting-corporation-act-1983-sec-24k a cml:Concept ;
    skos:prefLabel "24K Disclosure of interests to the Secretary of the Prime Minister’s"@en ;
    cml:realizedBy doc:sec-24k ;
    values:originalText "Department A member of the Nomination Panel must give written notice to the Secretary of the Prime Minister’s Department of all interests, pecuniary or otherwise, that the member has or acquires and that conflict or could conflict with the proper performance of the member’s functions." ;
    skos:definition "Department A member of the Nomination Panel must give written notice to the Secretary of the Prime Minister’s Department of all interests, pecuniary or otherwise, that the member has or acquires and that conflict or could conflict with the proper performance of the member’s functions."@en ;
    cml:integrityHash "477849926079459600314442a45eca9064b68dbe83459cef10cd0f17fcd42e70" ;
    cof:pageNumber "38"^^xsd:integer ;
    skos:note "Member must disclose interests to Secretary of Prime Minister’s Department." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
