concept:australian-broadcasting-corporation-act-1983-sec-24y a cml:Concept ;
    skos:prefLabel "24Y Department’s annual report"@en ;
    cml:realizedBy doc:sec-24y ;
    values:originalText "The Department’s annual report for a financial year must include a statement in relation to each selection process for the appointment of a Director referred to in paragraph 12(1)(b) or (c) that was completed in that financial year." ;
    skos:definition "The Department’s annual report for a financial year must include a statement in relation to each selection process for the appointment of a Director referred to in paragraph 12(1)(b) or (c) that was completed in that financial year."@en ;
    cml:integrityHash "ba96bbeb5978100ba1cf3af4f29ef8c89eaa55f1ea8bd5274187f88164048a53" ;
    cof:pageNumber "43"^^xsd:integer ;
    skos:note "Annual report must include statement on selection process for Director appointment." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
