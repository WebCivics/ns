    skos:prefLabel "13(2) Tenure of Managing Director"@en ;
    cml:realizedBy doc:sec-13-ss-2 ;
    values:originalText "(2) Where the person holding office as Managing Director is re-appointed, the re-appointment shall be for a period not exceeding 5 years." ;
