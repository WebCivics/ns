    cml:hasPart concept:australian-broadcasting-corporation-act-1983-sec-78-ss-4 ;
    cml:hasPart concept:australian-broadcasting-corporation-act-1983-sec-78-ss-5 ;
    cml:hasPart concept:australian-broadcasting-corporation-act-1983-sec-78-ss-6 ;
    cml:hasPart concept:australian-broadcasting-corporation-act-1983-sec-78-ss-7 ;
    cml:curationStatus cml:Proposed ;
