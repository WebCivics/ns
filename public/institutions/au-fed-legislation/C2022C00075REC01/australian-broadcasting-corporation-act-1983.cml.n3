concept:australian-broadcasting-corporation-act-1983-sec-7 a cml:Concept ;
    skos:prefLabel "7 Establishment of Australian Broadcasting Corporation Board"@en ;
    cml:realizedBy doc:sec-7 ;
    values:originalText "There shall be a Board of Directors of the Corporation under the name Australian Broadcasting Corporation Board, which shall be constituted as provided by Part III." ;
    skos:definition "There shall be a Board of Directors of the Corporation under the name Australian Broadcasting Corporation Board, which shall be constituted as provided by Part III."@en ;
