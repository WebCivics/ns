    skos:prefLabel "24E Membership"@en ;
    cml:realizedBy doc:sec-24e ;
    values:originalText "The Nomination Panel consists of the following members: (a) the Chair of the Nomination Panel; (b) at least 2, and not more than 3, other members." ;
