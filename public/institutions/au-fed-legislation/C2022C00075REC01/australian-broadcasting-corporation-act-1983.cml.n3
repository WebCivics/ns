concept:australian-broadcasting-corporation-act-1983-sec-24p a cml:Concept ;
    skos:prefLabel "24P Other terms and conditions"@en ;
    cml:realizedBy doc:sec-24p ;
    values:originalText "A member of the Nomination Panel holds office on the terms and conditions (if any) in relation to matters not covered by this Act that are determined by the Secretary of the Prime Minister’s Department." ;
