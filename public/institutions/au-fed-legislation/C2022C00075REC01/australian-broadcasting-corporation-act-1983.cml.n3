concept:australian-broadcasting-corporation-act-1983-sec-79 a cml:Concept ;
    skos:prefLabel "79 Application of Broadcasting Act"@en ;
    cml:realizedBy doc:sec-79 ;
    values:originalText "Except where the Broadcasting Services Act 1992 otherwise expressly provides, that Act does not apply in relation to the broadcasting services provided by the Corporation." ;
    skos:definition "Except where the Broadcasting Services Act 1992 otherwise expressly provides, that Act does not apply in relation to the broadcasting services provided by the Corporation."@en ;
    cml:integrityHash "47470ac3936cc63f36d38f238115db51a15f6c479945c6d4cc3b5e2c3a49154c" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "The Broadcasting Act does not apply in relation to broadcasting services provided by the Corporation." ;
    cml:curationStatus cml:Proposed ;
