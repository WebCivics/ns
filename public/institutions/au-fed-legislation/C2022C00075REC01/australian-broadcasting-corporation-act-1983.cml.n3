concept:australian-broadcasting-corporation-act-1983-sec-24m a cml:Concept ;
    skos:prefLabel "24M Resignation"@en ;
    cml:realizedBy doc:sec-24m ;
    values:originalText "(1) A member of the Nomination Panel may resign his or her appointment by giving the Secretary of the Prime Minister’s Department a written resignation. (2) The resignation takes effect on the day it is received by the Secretary of the Prime Minister’s Department or, if a later day is specified in the resignation, on that later day." ;
    skos:definition "(1) A member of the Nomination Panel may resign his or her appointment by giving the Secretary of the Prime Minister’s Department a written resignation. (2) The resignation takes effect on the day it is received by the Secretary of the Prime Minister’s Department or, if a later day is specified in the resignation, on that later day."@en ;
    cml:integrityHash "845a3efc0bc33cd4dda32d3cecd2862624ea7f18cb8d43fdaa12d833995049b1" ;
    cof:pageNumber "38"^^xsd:integer ;
