concept:australian-broadcasting-corporation-act-1983-sec-13 a cml:Concept ;
    skos:prefLabel "13 Tenure of Managing Director"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "(1) Subject to subsection (2), the Managing Director shall be appointed by the Board for a period of 5 years, but is eligible for re-appointment. (2) Where the person holding office as Managing Director is re-appointed, the re-appointment shall be for a period not exceeding 5 years. (3) The Managing Director holds office, subject to this Part, on such terms and conditions as are determined by the Board." ;
    skos:definition "(1) Subject to subsection (2), the Managing Director shall be appointed by the Board for a period of 5 years, but is eligible for re-appointment. (2) Where the person holding office as Managing Director is re-appointed, the re-appointment shall be for a period not exceeding 5 years. (3) The Managing Director holds office, subject to this Part, on such terms and conditions as are determined by the Board."@en ;
    cml:integrityHash "47b2fb8efba5037ef58e10483fe045de1523eeefa71fe2b6f7cdf932d4e3ab90" ;
    cof:pageNumber "22"^^xsd:integer ;
    cml:hasPart concept:australian-broadcasting-corporation-act-1983-sec-13-ss-1 ;
    cml:hasPart concept:australian-broadcasting-corporation-act-1983-sec-13-ss-2 ;
    cml:hasPart concept:australian-broadcasting-corporation-act-1983-sec-13-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-broadcasting-corporation-act-1983.pdf> ;
    dc:source "australian-broadcasting-corporation-act-1983.pdf, p.22" .
