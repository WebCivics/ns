doc:sec-20-ss-4 a cof:Section ;
    cof:title "20(4) Acting Managing Director" ;
    values:kind "subsection" ;
    values:originalText "(4) An employee of the Corporation who is acting as Managing Director shall continue to be paid the remuneration and allowances payable to him or her as such an employee but shall also be paid: (a) so much of any remuneration payable to the Managing Director as exceeds the remuneration that so continues to be paid to the employee; (b) so much of any allowance payable to the Managing Director as exceeds the corresponding allowance that so continues to be paid to the employee; and (c) if an allowance is payable to the Managing Director in respect of which there is no corresponding allowance payable to the employee—that allowance." ;
    cof:pageNumber "26"^^xsd:integer .

concept:australian-broadcasting-corporation-act-1983-sec-20-ss-6 a cml:Concept ;
    skos:prefLabel "20(6) Acting Managing Director"@en ;
    cml:realizedBy doc:sec-20-ss-6 ;
    values:originalText "(6) The appointment of a person to act as Managing Director ceases to have effect if he or she resigns the appointment by writing signed by him or her delivered to the Chairperson or, if a Director is acting as Chairperson, to the Director so acting." ;
    skos:definition "(6) The appointment of a person to act as Managing Director ceases to have effect if he or she resigns the appointment by writing signed by him or her delivered to the Chairperson or, if a Director is acting as Chairperson, to the Director so acting."@en ;
    cml:integrityHash "a8b19eb6d716753f84600b02665e521e15a2e78153fafd3c010b0608f2af0e0d" ;
    values:partOf concept:australian-broadcasting-corporation-act-1983-sec-20 ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Resignation requirement for Managing Director appointment" ;
    cml:curationStatus cml:Proposed ;
