concept:australian-broadcasting-corporation-act-1983-sec-24r a cml:Concept ;
    skos:prefLabel "24R Presiding at meetings"@en ;
    cml:realizedBy doc:sec-24r ;
    values:originalText "(1) The Chair presides at all meetings at which he or she is present. (2) If the Chair is not present at a meeting, the members present must appoint one of themselves to preside." ;
