doc:sec-24k a cof:Section ;
    cof:title "24K Disclosure of interests to the Secretary of the Prime Minister’s" ;
    values:kind "section" ;
    values:originalText "Department A member of the Nomination Panel must give written notice to the Secretary of the Prime Minister’s Department of all interests, pecuniary or otherwise, that the member has or acquires and that conflict or could conflict with the proper performance of the member’s functions." ;
    cof:pageNumber "38"^^xsd:integer .

concept:australian-broadcasting-corporation-act-1983-sec-24l a cml:Concept ;
    skos:prefLabel "24L Disclosure of interests to the Nomination Panel"@en ;
    cml:realizedBy doc:sec-24l ;
    values:originalText "(1) A member of the Nomination Panel who has an interest, pecuniary or otherwise, in a matter being considered or about to be considered by the Nomination Panel must disclose the nature of the interest to a meeting of the Nomination Panel. (2) The disclosure must be made as soon as possible after the relevant facts have come to the member’s knowledge. (3) The disclosure must be recorded in the minutes of the meeting." ;
    skos:definition "(1) A member of the Nomination Panel who has an interest, pecuniary or otherwise, in a matter being considered or about to be considered by the Nomination Panel must disclose the nature of the interest to a meeting of the Nomination Panel. (2) The disclosure must be made as soon as possible after the relevant facts have come to the member’s knowledge. (3) The disclosure must be recorded in the minutes of the meeting."@en ;
    cml:integrityHash "58eb17077531aaefd4b250c51daf3d559ce4df8263b2e96fe5b40be215da92de" ;
    cof:pageNumber "38"^^xsd:integer ;
