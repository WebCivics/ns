concept:australian-broadcasting-corporation-act-1983-sec-32 a cml:Concept ;
    skos:prefLabel "32 Staff of Corporation"@en ;
    cml:realizedBy doc:sec-32 ;
    values:originalText "(1) The Corporation may engage such employees as are necessary for the performance of its functions and the exercise of its powers. (2) The terms and conditions of employment shall be determined by the Corporation." ;
