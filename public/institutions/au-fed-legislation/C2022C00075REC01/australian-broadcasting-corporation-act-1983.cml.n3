    values:partOf concept:australian-broadcasting-corporation-act-1983-sec-22 ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Prevents Managing Director from participating in Board decisions regarding employment terms." ;
    cml:curationStatus cml:Proposed ;
