concept:australian-broadcasting-corporation-act-1983-sec-33 a cml:Concept ;
    skos:prefLabel "33 The Corporation is to achieve and maintain high standards as an"@en ;
    cml:realizedBy doc:sec-33 ;
    values:originalText "employer The Corporation shall endeavour to achieve and maintain high standards as an employer in relation to terms and conditions of employment, occupational health, industrial safety, industrial democracy, non-discriminatory employment practices and other matters.   Finance  Part VI  Section 67 Australian Broadcasting Corporation Act 1983 Compilation date: 18/02/2022 Registered: 23/02/2022" ;
    skos:definition "employer The Corporation shall endeavour to achieve and maintain high standards as an employer in relation to terms and conditions of employment, occupational health, industrial safety, industrial democracy, non-discriminatory employment practices and other matters.   Finance  Part VI  Section 67 Australian Broadcasting Corporation Act 1983 Compilation date: 18/02/2022 Registered: 23/02/2022"@en ;
    cml:integrityHash "d79e539df41ec4a98fe91b1ca6353853d6d1212b71cb2337a71c78bd56b87a36" ;
    cof:pageNumber "56"^^xsd:integer ;
