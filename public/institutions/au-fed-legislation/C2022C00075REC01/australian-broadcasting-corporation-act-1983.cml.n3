doc:sec-13-ss-1 a cof:Section ;
    cof:title "13(1) Tenure of Managing Director" ;
    values:kind "subsection" ;
    values:originalText "(1) Subject to subsection (2), the Managing Director shall be appointed by the Board for a period of 5 years, but is eligible for re-appointment." ;
    cof:pageNumber "22"^^xsd:integer .

