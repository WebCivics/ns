    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24w",
      "@type": "cml:Concept",
      "skos:prefLabel": "24W Selection criteria",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24w"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
