    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79",
      "@type": "cml:Concept",
      "skos:prefLabel": "79 Application of Broadcasting Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.63",
      "values:originalText": "Except where the Broadcasting Services Act 1992 otherwise\nexpressly provides, that Act does not apply in relation to the\nbroadcasting services provided by the Corporation.",
      "skos:definition": "Except where the Broadcasting Services Act 1992 otherwise\nexpressly provides, that Act does not apply in relation to the\nbroadcasting services provided by the Corporation.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "47470ac3936cc63f36d38f238115db51a15f6c479945c6d4cc3b5e2c3a49154c",
      "skos:note": "The Broadcasting Act does not apply in relation to broadcasting services provided by the Corporation."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79",
      "@type": "cof:Section",
      "cof:title": "79 Application of Broadcasting Act",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "Except where the Broadcasting Services Act 1992 otherwise\nexpressly provides, that Act does not apply in relation to the\nbroadcasting services provided by the Corporation."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "does not apply",
      "cml:logicSummary": "The Broadcasting Act does not apply",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Corporation provides broadcasting services",
      "cml:conclusionText": "The Broadcasting Act does not apply"
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "79AA Report by ACMA on degradation of signal quality",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.63",
      "values:originalText": "If:\n(a) a person has made a complaint to the Corporation about\ndegradation of the quality of signal reception of a national\nbroadcasting service; and\n(b) within 60 days after making the complaint, the person did not\nreceive a response that the person regarded as adequate; and\n(c) the signal concerned is received from an analog terrestrial\nradiocommunications transmitter;\nthe Minister may direct the ACMA to conduct an investigation into\nthe matter.",
      "skos:definition": "If:\n(a) a person has made a complaint to the Corporation about\ndegradation of the quality of signal reception of a national\nbroadcasting service; and\n(b) within 60 days after making the complaint, the person did not\nreceive a response that the person regarded as adequate; and\n(c) the signal concerned is received from an analog terrestrial\nradiocommunications transmitter;\nthe Minister may direct the ACMA to conduct an investigation into\nthe matter.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79aa-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79aa-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "db610dc5b477434ac5086918296d8ea6790d2071d4deeac0ed4f5702c782a42b",
      "skos:note": "Investigate degradation of signal quality if complaint not responded to within 60 days."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79aa",
      "@type": "cof:Section",
      "cof:title": "79AA Report by ACMA on degradation of signal quality",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "If:\n(a) a person has made a complaint to the Corporation about\ndegradation of the quality of signal reception of a national\nbroadcasting service; and\n(b) within 60 days after making the complaint, the person did not\nreceive a response that the person regarded as adequate; and\n(c) the signal concerned is received from an analog terrestrial\nradiocommunications transmitter;\nthe Minister may direct the ACMA to conduct an investigation into\nthe matter."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79aa-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79aa"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79aa-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Minister may direct ACMA to investigate.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Complaint not responded to within 60 days.",
      "cml:conclusionText": "Investigation required."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79a",
      "@type": "cml:Concept",
      "skos:prefLabel": "79A Broadcasting of political or controversial matter",
      "cml:realizedBy": {
