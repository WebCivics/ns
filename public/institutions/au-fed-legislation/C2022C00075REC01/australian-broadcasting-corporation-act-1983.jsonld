    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31aa",
      "@type": "cml:Concept",
      "skos:prefLabel": "31AA Corporation or prescribed companies to be the only providers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-31aa"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.53",
      "values:originalText": "of Commonwealth-funded international broadcasting\nservices\nThe Commonwealth must not enter into a contract or other\narrangement with a person or body other than:\n(a) the Corporation; or\n(b) a prescribed company (within the meaning of section 25A);\nif the contract or arrangement:\n(c) is for the provision of international broadcasting services;\nand\n(d) provides for the Commonwealth to make payments to the\nperson or body.",
      "skos:definition": "of Commonwealth-funded international broadcasting\nservices\nThe Commonwealth must not enter into a contract or other\narrangement with a person or body other than:\n(a) the Corporation; or\n(b) a prescribed company (within the meaning of section 25A);\nif the contract or arrangement:\n(c) is for the provision of international broadcasting services;\nand\n(d) provides for the Commonwealth to make payments to the\nperson or body.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31aa-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31aa-logic-deontic-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31aa-logic-alleninterval-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31aa-logic-argumentation-3"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31aa-logic-diffusion-4"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31aa-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "245909253f25e2c6b9b2f8dc6a21305ff5e0b12997e805e90bb562dfa2964601",
      "skos:note": "Only Commonwealth-funded international broadcasting services can be provided by the Corporation or prescribed companies.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-31aa",
      "@type": "cof:Section",
      "cof:title": "31AA Corporation or prescribed companies to be the only providers",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "of Commonwealth-funded international broadcasting\nservices\nThe Commonwealth must not enter into a contract or other\narrangement with a person or body other than:\n(a) the Corporation; or\n(b) a prescribed company (within the meaning of section 25A);\nif the contract or arrangement:\n(c) is for the provision of international broadcasting services;\nand\n(d) provides for the Commonwealth to make payments to the\nperson or body."
    },
