        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-5-logic-ltl-3"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-5-logic-diffusion-4"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-5-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "e2871f48ef9ba1d2c6efd3d2727806f1376d4dc7789bce1abf495781ff76898f",
      "skos:note": "Ceases to apply after a period of 3 months if proceedings are not instituted."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79b-ss-5",
      "@type": "cof:Section",
      "cof:title": "79B(5) Records of matter broadcast",
      "values:kind": "subsection",
      "cof:pageNumber": 68,
      "values:originalText": "(5) If the proceedings are not instituted within a period of 3 months\nafter the notice is given to the Corporation, subsection (4) ceases to\napply to the record at the end of that period."
    },
