    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-11-ss-5",
      "@type": "cof:Section",
      "cof:title": "11(5) Advisory Councils and committees",
      "values:kind": "subsection",
