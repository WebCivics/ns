    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-11-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "11(6) Advisory Councils and committees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-11-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
