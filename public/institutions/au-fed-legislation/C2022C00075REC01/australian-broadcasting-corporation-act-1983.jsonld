        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-11-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "297fcd988f520b1f34731a935537c515225f6c04c5c9e22b8473d40ffc2ef0b5",
      "skos:note": "The Board must include a broad representation of the Australian community in the Advisory Council membership."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-11-ss-6",
      "@type": "cof:Section",
      "cof:title": "11(6) Advisory Councils and committees",
      "values:kind": "subsection",
      "cof:pageNumber": 16,
      "values:originalText": "(6) In making appointments to the Australian Broadcasting\nCorporation Advisory Council, the Board shall have regard to the\ndesirability of including in the membership of that Advisory\nCouncil a broad representation of the Australian community."
    },
