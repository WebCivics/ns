        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-26-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bf380200f2941fa4e764908ba2c331b04c97f1c76a38c3eac1750364d72eca20",
      "skos:note": "Corporation must have regard to services of the Special Broadcasting Service Corporation."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Corporation to have regard to services of the Special",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "Broadcasting Service Corporation\nIn performing its functions, the Corporation must have regard to\nthe services provided by the Special Broadcasting Service\nCorporation.\n\n\nPowers and duties of the Corporation  Part IV\n\nSection 27\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022"
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-26-norm",
      "@type": "values:Obligation",
