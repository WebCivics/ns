        }
      ],
      "cml:integrityHash": "f938c5cb036ac42c490ba7c04c1e1dcb5699acdba6d32e4b8857736bc1af89fb",
      "skos:note": "If a person ceases to be eligible for election, the election must proceed as if they were not a candidate."
    },
