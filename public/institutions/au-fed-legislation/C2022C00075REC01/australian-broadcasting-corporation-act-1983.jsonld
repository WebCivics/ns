    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Staff of Corporation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-32"
