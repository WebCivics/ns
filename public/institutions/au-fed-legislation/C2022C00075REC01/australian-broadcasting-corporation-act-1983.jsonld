        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24b-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "24B(3) Functions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24b-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.32",
      "values:originalText": "(3) The Nomination Panel must invite written applications by persons\nseeking to be appointed as a Director referred to in\nparagraph 12(1)(b) or (c) by advertisements published:\n(a) on the Department’s website; and\n(b) in one or more other forms that are readily accessible by\npotential applicants.\nExample:\nPublication in a form mentioned in paragraph (b) could be publication\non a website other than the Department’s website.\nOne selection process for 2 or more appointments",
      "skos:definition": "(3) The Nomination Panel must invite written applications by persons\nseeking to be appointed as a Director referred to in\nparagraph 12(1)(b) or (c) by advertisements published:\n(a) on the Department’s website; and\n(b) in one or more other forms that are readily accessible by\npotential applicants.\nExample:\nPublication in a form mentioned in paragraph (b) could be publication\non a website other than the Department’s website.\nOne selection process for 2 or more appointments",
      "values:partOf": {
