    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-11-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "11(7) Advisory Councils and committees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-11-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.16",
      "values:originalText": "(7) In the case of each Advisory Council, the Board shall appoint one\nof the members of the Advisory Council to be the Chairperson of\nthe Advisory Council and another of the members of the Advisory\nCouncil to be the Deputy Chairperson of the Advisory Council.",
      "skos:definition": "(7) In the case of each Advisory Council, the Board shall appoint one\nof the members of the Advisory Council to be the Chairperson of\nthe Advisory Council and another of the members of the Advisory\nCouncil to be the Deputy Chairperson of the Advisory Council.",
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-11"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-11-ss-7-norm"
        }
      ],
      "cml:integrityHash": "a201fb7f725638eb80621ce11c65738fd5f9ef69f826b82b33e9ec21772e8bc3",
      "skos:note": "Appointment of Chairperson and Deputy Chairperson for Advisory Councils"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-11-ss-7",
      "@type": "cof:Section",
      "cof:title": "11(7) Advisory Councils and committees",
      "values:kind": "subsection",
      "cof:pageNumber": 16,
      "values:originalText": "(7) In the case of each Advisory Council, the Board shall appoint one\nof the members of the Advisory Council to be the Chairperson of\nthe Advisory Council and another of the members of the Advisory\nCouncil to be the Deputy Chairperson of the Advisory Council."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-11-ss-7-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
