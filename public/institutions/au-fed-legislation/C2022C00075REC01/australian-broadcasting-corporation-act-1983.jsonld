    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-67",
      "@type": "cml:Concept",
      "skos:prefLabel": "67 Moneys of the Corporation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-67"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
