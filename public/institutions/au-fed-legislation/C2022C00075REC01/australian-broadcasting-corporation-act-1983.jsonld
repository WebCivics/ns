    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-20-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "20(6) Acting Managing Director",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-20-ss-6"
