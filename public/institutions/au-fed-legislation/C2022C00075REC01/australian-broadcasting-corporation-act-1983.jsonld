    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-22-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "22(7) Meetings of the Board",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-22-ss-7"
