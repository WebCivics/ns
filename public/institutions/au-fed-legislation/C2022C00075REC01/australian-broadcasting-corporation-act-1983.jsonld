    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24c",
      "@type": "cml:Concept",
      "skos:prefLabel": "24C Nomination Panel not subject to direction",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.34",
      "values:originalText": "The Nomination Panel is not subject to direction by or on behalf of\nthe Government of the Commonwealth.\n\n\nMerit-based appointment of non-executive Directors  Part IIIA\nEstablishment and functions of Nomination Panel  Division 1\nSection 24D\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "skos:definition": "The Nomination Panel is not subject to direction by or on behalf of\nthe Government of the Commonwealth.\n\n\nMerit-based appointment of non-executive Directors  Part IIIA\nEstablishment and functions of Nomination Panel  Division 1\nSection 24D\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24c-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7cbece10c754d71c176ff0ac1d65251d72c1d191883099b9ff03d80cd48112fb",
      "skos:note": "The Nomination Panel is not subject to direction by or on behalf of the Government."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24c",
      "@type": "cof:Section",
      "cof:title": "24C Nomination Panel not subject to direction",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "The Nomination Panel is not subject to direction by or on behalf of\nthe Government of the Commonwealth.\n\n\nMerit-based appointment of non-executive Directors  Part IIIA\nEstablishment and functions of Nomination Panel  Division 1\nSection 24D\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022"
    },
