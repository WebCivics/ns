          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-22-ss-1-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-22-ss-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f89e8d93c1c54935eaf8eed1d0ea74247e7c8b571578dc4bf4ea8503c039e501",
      "skos:note": "Chairperson must convene meetings of the Board as necessary and on written request from Directors."
    },
