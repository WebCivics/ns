    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 Remuneration and allowances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.24",
      "values:originalText": "(1) The Managing Director shall be paid by the Corporation such\nremuneration as is determined by the Remuneration Tribunal.\n(2) The non-executive Directors shall be paid by the Corporation such\nremuneration as is determined by the Remuneration Tribunal.\n(3) Subject to the Remuneration Tribunal Act 1973:\n(a) the Managing Director shall be paid by the Corporation such\nallowances as are determined by the Board; and\n(b) the non-executive Directors shall be paid by the Corporation\nsuch allowances as are prescribed by the regulations.",
      "skos:definition": "(1) The Managing Director shall be paid by the Corporation such\nremuneration as is determined by the Remuneration Tribunal.\n(2) The non-executive Directors shall be paid by the Corporation such\nremuneration as is determined by the Remuneration Tribunal.\n(3) Subject to the Remuneration Tribunal Act 1973:\n(a) the Managing Director shall be paid by the Corporation such\nallowances as are determined by the Board; and\n(b) the non-executive Directors shall be paid by the Corporation\nsuch allowances as are prescribed by the regulations.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-14-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-14-ss-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-14-ss-3"
        }
      ],
      "cml:integrityHash": "54077746c85eac5838c298c027f3e7f460e3245374a07d982187f6ac3c083917"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-14",
      "@type": "cof:Section",
      "cof:title": "14 Remuneration and allowances",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "(1) The Managing Director shall be paid by the Corporation such\nremuneration as is determined by the Remuneration Tribunal.\n(2) The non-executive Directors shall be paid by the Corporation such\nremuneration as is determined by the Remuneration Tribunal.\n(3) Subject to the Remuneration Tribunal Act 1973:\n(a) the Managing Director shall be paid by the Corporation such\nallowances as are determined by the Board; and\n(b) the non-executive Directors shall be paid by the Corporation\nsuch allowances as are prescribed by the regulations."
    },
