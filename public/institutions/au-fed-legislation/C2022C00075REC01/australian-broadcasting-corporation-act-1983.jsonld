    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-25b",
      "@type": "cml:Concept",
      "skos:prefLabel": "25B Hedging contracts etc.",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-25b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.47",
      "values:originalText": "(1) Subject to subsection (3), the Corporation may enter into or deal\nwith contracts, and make other arrangements, in relation to\nfinancial futures or foreign currency (including foreign currency\nfutures) for the purpose of reducing or eliminating risks of adverse\nfinancial consequences to the Corporation in relation to:\n(a) any contract (including a contract that may be entered into\nunder this section), or proposed contract, involving the\npayment or receipt of money by the Corporation; or",
      "skos:definition": "(1) Subject to subsection (3), the Corporation may enter into or deal\nwith contracts, and make other arrangements, in relation to\nfinancial futures or foreign currency (including foreign currency\nfutures) for the purpose of reducing or eliminating risks of adverse\nfinancial consequences to the Corporation in relation to:\n(a) any contract (including a contract that may be entered into\nunder this section), or proposed contract, involving the\npayment or receipt of money by the Corporation; or",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-25b-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-25b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5b1906a986197ca15cf29152679390c67903a682504320e90e4f7cc30dc22322",
      "skos:note": "The Corporation may enter into contracts to reduce financial risks."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-25b",
