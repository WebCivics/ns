    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-78-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "78(5) Power of Minister to give directions to Corporation in the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-78-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.62",
      "values:originalText": "(5) Where the Minister gives a direction to the Corporation under this\nsection, the Minister shall cause a statement setting out particulars\nof, and the reasons for, the direction to be laid before each House\nof the Parliament within 7 sitting days of that House after the\ndirection was given.\n\n\nMiscellaneous  Part VIII\n\nSection 79\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "skos:definition": "(5) Where the Minister gives a direction to the Corporation under this\nsection, the Minister shall cause a statement setting out particulars\nof, and the reasons for, the direction to be laid before each House\nof the Parliament within 7 sitting days of that House after the\ndirection was given.\n\n\nMiscellaneous  Part VIII\n\nSection 79\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-78"
      },
      "cml:asserts": [
