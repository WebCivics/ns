      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.51",
      "values:originalText": "The Corporation may make broadcasting facilities and staff\navailable to a person for the purpose of providing a broadcasting\nservice under the Broadcasting Services Act 1992.",
