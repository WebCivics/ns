    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Acting Chairperson",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.26",
      "values:originalText": "Where there is no Chairperson or the Chairperson is absent from\nduty or from Australia or is, for any other reason, unable to\nperform the functions of Chairperson:\n(a) the Deputy Chairperson shall act as Chairperson; or\n(b) if there is no Deputy Chairperson, or the Deputy Chairperson\nis absent from duty or from Australia or is, for any other\nreason, unable to act as Chairperson, the Governor-General\nmay appoint a non-executive Director to act as Chairperson,\nbut any such appointment ceases to have effect if:\n(i) where there is no Deputy Chairperson—a non-executive\nDirector is appointed as Deputy Chairperson; or\n(ii) where the Deputy Chairperson is absent from duty or\nfrom Australia or is, for any other reason, unable to act\nas Chairperson—the Deputy Chairperson ceases to be\nso absent or becomes able to act as Chairperson.\nNote:\nFor rules that apply to persons acting as the Chairperson, see\nsections 33AB and 33A of the Acts Interpretation Act 1901.",
      "skos:definition": "Where there is no Chairperson or the Chairperson is absent from\nduty or from Australia or is, for any other reason, unable to\nperform the functions of Chairperson:\n(a) the Deputy Chairperson shall act as Chairperson; or\n(b) if there is no Deputy Chairperson, or the Deputy Chairperson\nis absent from duty or from Australia or is, for any other\nreason, unable to act as Chairperson, the Governor-General\nmay appoint a non-executive Director to act as Chairperson,\nbut any such appointment ceases to have effect if:\n(i) where there is no Deputy Chairperson—a non-executive\nDirector is appointed as Deputy Chairperson; or\n(ii) where the Deputy Chairperson is absent from duty or\nfrom Australia or is, for any other reason, unable to act\nas Chairperson—the Deputy Chairperson ceases to be\nso absent or becomes able to act as Chairperson.\nNote:\nFor rules that apply to persons acting as the Chairperson, see\nsections 33AB and 33A of the Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-19-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-19-logic-deontic-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-19-logic-linearlogic-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-19-logic-alleninterval-3"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-19-logic-argumentation-4"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-19-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "b800a605ad3ec67a8aa5abdab20abf43e7febced61cf1c80c4b66507291f52fd",
      "skos:note": "If Chairperson is absent, Deputy Chairperson or Governor-General must act as Chairperson."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Acting Chairperson",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "Where there is no Chairperson or the Chairperson is absent from\nduty or from Australia or is, for any other reason, unable to\nperform the functions of Chairperson:\n(a) the Deputy Chairperson shall act as Chairperson; or\n(b) if there is no Deputy Chairperson, or the Deputy Chairperson\nis absent from duty or from Australia or is, for any other\nreason, unable to act as Chairperson, the Governor-General\nmay appoint a non-executive Director to act as Chairperson,\nbut any such appointment ceases to have effect if:\n(i) where there is no Deputy Chairperson—a non-executive\nDirector is appointed as Deputy Chairperson; or\n(ii) where the Deputy Chairperson is absent from duty or\nfrom Australia or is, for any other reason, unable to act\nas Chairperson—the Deputy Chairperson ceases to be\nso absent or becomes able to act as Chairperson.\nNote:\nFor rules that apply to persons acting as the Chairperson, see\nsections 33AB and 33A of the Acts Interpretation Act 1901."
    },
