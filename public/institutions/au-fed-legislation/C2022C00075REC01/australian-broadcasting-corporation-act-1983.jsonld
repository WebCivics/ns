    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Exercise of power not prevented by delegation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A delegation under this section does not prevent the exercise of a power by the Managing Director.",
      "cml:conclusionText": "The Managing Director can still exercise their power."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24-ss-3-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Delegation and exercise of power do not overlap in time.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A delegation under this section does not prevent the exercise of a power by the Managing Director.",
      "cml:conclusionText": "The exercise of power and delegation do not overlap."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24-ss-3-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Delegation is until the exercise of power.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A delegation under this section does not prevent the exercise of a power by the Managing Director.",
      "cml:conclusionText": "The delegation ends when the power is exercised."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24-ss-3-logic-diffusion-4",
