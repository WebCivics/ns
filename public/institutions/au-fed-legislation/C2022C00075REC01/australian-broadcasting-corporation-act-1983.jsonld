      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The Corporation has an obligation to acknowledge a debt and issue an instrument.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
