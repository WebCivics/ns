    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-70b-ss-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The Corporation has an obligation to raise money from a non-borrowing source.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the Corporation issues an instrument that acknowledges a debt;",
      "cml:conclusionText": "the Corporation shall be taken to raise money otherwise than by borrowing."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-70b-ss-8-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The instrument is issued in consideration of credit provided.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the instrument is issued in consideration of the provision of credit;",
      "cml:conclusionText": "the Corporation shall be taken to raise money otherwise than by borrowing."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-70b-ss-8-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "The Corporation must raise money from a non-borrowing source.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the Corporation issues an instrument that acknowledges a debt;",
      "cml:conclusionText": "the amount of money raised shall be taken to be the amount of the value of the credit provided."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-70b-ss-8-logic-linearlogic-4",
