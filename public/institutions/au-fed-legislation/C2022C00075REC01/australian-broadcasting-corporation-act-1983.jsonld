        }
      ],
      "cml:integrityHash": "1dbf36ffc5df981e0a45fc9fa450ee2bacfe50423123791f3810c7fa92baabb8",
      "skos:note": "Make program schedule available on equal terms to publishers of Australian newspapers, magazines or journals."
    },
    {
