    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31c",
      "@type": "cml:Concept",
      "skos:prefLabel": "31C Corporate plans to be given to Minister",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-31c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.54",
      "values:originalText": "As soon as practicable after the Board revises a corporate plan, it\nmust give a copy of the plan to the Minister.\n\n\nCorporate plans  Part IVA\n\nSection 31C\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022\nNote:\nA corporate plan must be given to the responsible Minister and the\nFinance Minister under subsection 35(1) of the Public Governance,\nPerformance and Accountability Act 2013.",
      "skos:definition": "As soon as practicable after the Board revises a corporate plan, it\nmust give a copy of the plan to the Minister.\n\n\nCorporate plans  Part IVA\n\nSection 31C\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022\nNote:\nA corporate plan must be given to the responsible Minister and the\nFinance Minister under subsection 35(1) of the Public Governance,\nPerformance and Accountability Act 2013.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31c-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31c-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "499cd3a3f35e4c99904b3d43714e34989fd5d6327e4e93a4adabedfe42dc3f22",
      "skos:note": "Must provide corporate plan to Minister upon revision",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-31c",
      "@type": "cof:Section",
      "cof:title": "31C Corporate plans to be given to Minister",
      "values:kind": "section",
      "cof:pageNumber": 54,
      "values:originalText": "As soon as practicable after the Board revises a corporate plan, it\nmust give a copy of the plan to the Minister.\n\n\nCorporate plans  Part IVA\n\nSection 31C\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022\nNote:\nA corporate plan must be given to the responsible Minister and the\nFinance Minister under subsection 35(1) of the Public Governance,\nPerformance and Accountability Act 2013."
    },
