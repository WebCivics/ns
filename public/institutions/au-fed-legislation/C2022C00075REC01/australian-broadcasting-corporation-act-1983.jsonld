    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 February 2022",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
