    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Establishment of Australian Broadcasting Corporation Board",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.14",
      "values:originalText": "There shall be a Board of Directors of the Corporation under the\nname Australian Broadcasting Corporation Board, which shall be\nconstituted as provided by Part III.",
      "skos:definition": "There shall be a Board of Directors of the Corporation under the\nname Australian Broadcasting Corporation Board, which shall be\nconstituted as provided by Part III.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-7-norm"
        }
      ],
      "cml:integrityHash": "a4eb8b78ba6b23b974b2af55c566959e960face18431a6a69642e9929822385c",
      "skos:note": "Establishment of Australian Broadcasting Corporation Board"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Establishment of Australian Broadcasting Corporation Board",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "There shall be a Board of Directors of the Corporation under the\nname Australian Broadcasting Corporation Board, which shall be\nconstituted as provided by Part III."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-7-norm",
