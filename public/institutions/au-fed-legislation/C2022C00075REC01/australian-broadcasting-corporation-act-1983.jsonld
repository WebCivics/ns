    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24k",
      "@type": "cml:Concept",
      "skos:prefLabel": "24K Disclosure of interests to the Secretary of the Prime Minister’s",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24k"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.38",
      "values:originalText": "Department\nA member of the Nomination Panel must give written notice to the\nSecretary of the Prime Minister’s Department of all interests,\npecuniary or otherwise, that the member has or acquires and that\nconflict or could conflict with the proper performance of the\nmember’s functions.",
      "skos:definition": "Department\nA member of the Nomination Panel must give written notice to the\nSecretary of the Prime Minister’s Department of all interests,\npecuniary or otherwise, that the member has or acquires and that\nconflict or could conflict with the proper performance of the\nmember’s functions.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24k-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24k-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "477849926079459600314442a45eca9064b68dbe83459cef10cd0f17fcd42e70",
      "skos:note": "Member must disclose interests to Secretary of Prime Minister’s Department.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24k",
      "@type": "cof:Section",
      "cof:title": "24K Disclosure of interests to the Secretary of the Prime Minister’s",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "Department\nA member of the Nomination Panel must give written notice to the\nSecretary of the Prime Minister’s Department of all interests,\npecuniary or otherwise, that the member has or acquires and that\nconflict or could conflict with the proper performance of the\nmember’s functions."
    },
