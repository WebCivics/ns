    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 The Corporation is to achieve and maintain high standards as an",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.56",
      "values:originalText": "employer\nThe Corporation shall endeavour to achieve and maintain high\nstandards as an employer in relation to terms and conditions of\nemployment, occupational health, industrial safety, industrial\ndemocracy, non-discriminatory employment practices and other\nmatters.\n\n\nFinance  Part VI\n\nSection 67\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "skos:definition": "employer\nThe Corporation shall endeavour to achieve and maintain high\nstandards as an employer in relation to terms and conditions of\nemployment, occupational health, industrial safety, industrial\ndemocracy, non-discriminatory employment practices and other\nmatters.\n\n\nFinance  Part VI\n\nSection 67\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-33-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d79e539df41ec4a98fe91b1ca6353853d6d1212b71cb2337a71c78bd56b87a36",
      "skos:note": "Maintain high standards as an employer"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-33",
      "@type": "cof:Section",
      "cof:title": "33 The Corporation is to achieve and maintain high standards as an",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "employer\nThe Corporation shall endeavour to achieve and maintain high\nstandards as an employer in relation to terms and conditions of\nemployment, occupational health, industrial safety, industrial\ndemocracy, non-discriminatory employment practices and other\nmatters.\n\n\nFinance  Part VI\n\nSection 67\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022"
    },
