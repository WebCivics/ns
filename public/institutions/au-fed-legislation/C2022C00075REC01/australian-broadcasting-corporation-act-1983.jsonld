        }
      ],
      "cml:integrityHash": "6bae819c3dd62da6d0fc3f5b5d11baa541157e833bbab75e1c6a906d85f0e8cb",
      "skos:note": "Terms and conditions for Managing Director's office"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-13-ss-3",
      "@type": "cof:Section",
