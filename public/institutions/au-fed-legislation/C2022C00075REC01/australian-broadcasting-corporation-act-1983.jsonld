      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24n-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition on termination under certain conditions.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) The Secretary...",
      "cml:conclusionText": "The appointment may not be terminated."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24n-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal Interval",
      "cml:logicSummary": "Temporal interval for absence from meetings.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "b) the member is absent, except on leave of absence, from 3 consecutive meetings...",
      "cml:conclusionText": "Absence from 3 consecutive meetings without leave constitutes a condition for termination."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24n-ss-2-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Implication of failure to comply with disclosure of interests.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "c) the member fails, without reasonable excuse, to comply with section 24K or 24L...",
      "cml:conclusionText": "Failure to comply with disclosure of interests implies termination."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24n-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Diffusion of conditions for termination.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the member... (b) the member...",
      "cml:conclusionText": "Conditions for termination diffuse across multiple scenarios."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24p",
      "@type": "cml:Concept",
      "skos:prefLabel": "24P Other terms and conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24p"
      },
      "cml:curationStatus": {
