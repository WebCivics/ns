    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-11-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "11(5) Advisory Councils and committees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-11-ss-5"
      },
      "cml:curationStatus": {
