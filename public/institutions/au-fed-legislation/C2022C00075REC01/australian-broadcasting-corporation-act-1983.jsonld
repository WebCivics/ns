    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-70a",
      "@type": "cml:Concept",
      "skos:prefLabel": "70A Borrowing from Commonwealth",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-70a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
