      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.57",
      "values:originalText": "(1) There are payable to the Corporation such moneys as are\nappropriated by the Parliament for the purposes of the Corporation.\n(2) The Finance Minister may give directions as to the amounts in\nwhich, and the times at which, moneys referred to in subsection (1)\nare to be paid to the Corporation.",
      "skos:definition": "(1) There are payable to the Corporation such moneys as are\nappropriated by the Parliament for the purposes of the Corporation.\n(2) The Finance Minister may give directions as to the amounts in\nwhich, and the times at which, moneys referred to in subsection (1)\nare to be paid to the Corporation.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-67-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-67-ss-2"
        }
      ],
      "cml:integrityHash": "86011d91cf2a0983cb56e74f2e91053c78b6cec2ff35fb0056ed8ddaf3017eaf"
    },
