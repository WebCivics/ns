    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24h",
      "@type": "cml:Concept",
      "skos:prefLabel": "24H Remuneration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24h"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.37",
      "values:originalText": "(1) A member of the Nomination Panel is to be paid the remuneration\nthat is determined by the Remuneration Tribunal. If no\ndetermination of that remuneration by the Tribunal is in operation,\nthe member is to be paid the remuneration that is prescribed by the\nregulations.\n(2) A member of the Nomination Panel is to be paid the allowances\nthat are prescribed by the regulations.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "skos:definition": "(1) A member of the Nomination Panel is to be paid the remuneration\nthat is determined by the Remuneration Tribunal. If no\ndetermination of that remuneration by the Tribunal is in operation,\nthe member is to be paid the remuneration that is prescribed by the\nregulations.\n(2) A member of the Nomination Panel is to be paid the allowances\nthat are prescribed by the regulations.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24h-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24h-ss-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24h-ss-3"
        }
      ],
      "cml:integrityHash": "ad78d1f9429ed1a88433673017eadd4f8e92c915426a05d2a96472ba0edfb22e"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24h",
      "@type": "cof:Section",
      "cof:title": "24H Remuneration",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "(1) A member of the Nomination Panel is to be paid the remuneration\nthat is determined by the Remuneration Tribunal. If no\ndetermination of that remuneration by the Tribunal is in operation,\nthe member is to be paid the remuneration that is prescribed by the\nregulations.\n(2) A member of the Nomination Panel is to be paid the allowances\nthat are prescribed by the regulations.\n(3) This section has effect subject to the Remuneration Tribunal Act\n1973."
    },
