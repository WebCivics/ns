        }
      ],
      "cml:integrityHash": "93750619f67aca63c104e45068c77596a5ed507fbecf24a77bee957412dbf82c",
      "skos:note": "Statement must be laid before Parliament within 7 sitting days of direction given.",
      "dc:description": "Particulars and reasons for direction"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-78-ss-5",
