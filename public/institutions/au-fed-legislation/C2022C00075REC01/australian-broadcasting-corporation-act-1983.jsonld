      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.32",
      "values:originalText": "The Nomination Panel is established by this section.",
      "skos:definition": "The Nomination Panel is established by this section.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24a-norm"
        }
      ],
      "cml:integrityHash": "90aff1a6fb0d99318eddbf675615de8555ed5a12da44e92f01257bf8804bf972",
      "skos:note": "Establishment of Nomination Panel"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24a",
      "@type": "cof:Section",
      "cof:title": "24A Establishment",
      "values:kind": "section",
      "cof:pageNumber": 32,
      "values:originalText": "The Nomination Panel is established by this section."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24a-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24a"
      },
