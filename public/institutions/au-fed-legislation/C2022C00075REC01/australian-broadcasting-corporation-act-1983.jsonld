        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-13a-ss-6-logic-diffusion-5"
        }
      ],
      "cml:integrityHash": "9d83fd1e925d43bd01a6bb9cce03cd01ab8b83d87085ef3a000910b7bf31cccd",
      "skos:note": "Staff-elected Director cannot be elected again."
    },
