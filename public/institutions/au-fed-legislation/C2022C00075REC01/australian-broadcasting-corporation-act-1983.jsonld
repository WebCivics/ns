    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Duties of the Managing Director",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.16",
      "values:originalText": "(1) The affairs of the Corporation shall, subject to subsection (2), be\nmanaged by the Managing Director.\n(2) The Managing Director shall, in managing any of the affairs of the\nCorporation and in exercising any powers conferred on him or her\nby this Act, act in accordance with any policies determined, and\nany directions given to him or her, by the Board.\n(3) All acts and things done in the name of, or on behalf of, the\nCorporation by the Managing Director shall be taken to have been\ndone by the Corporation.",
      "skos:definition": "(1) The affairs of the Corporation shall, subject to subsection (2), be\nmanaged by the Managing Director.\n(2) The Managing Director shall, in managing any of the affairs of the\nCorporation and in exercising any powers conferred on him or her\nby this Act, act in accordance with any policies determined, and\nany directions given to him or her, by the Board.\n(3) All acts and things done in the name of, or on behalf of, the\nCorporation by the Managing Director shall be taken to have been\ndone by the Corporation.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-10-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-10-ss-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-10-ss-3"
        }
      ],
      "cml:integrityHash": "a6ae70aad995718f6faff983f4e3063d367bffba95a43d3168c34fcc609bbbdd"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Duties of the Managing Director",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "(1) The affairs of the Corporation shall, subject to subsection (2), be\nmanaged by the Managing Director.\n(2) The Managing Director shall, in managing any of the affairs of the\nCorporation and in exercising any powers conferred on him or her\nby this Act, act in accordance with any policies determined, and\nany directions given to him or her, by the Board.\n(3) All acts and things done in the name of, or on behalf of, the\nCorporation by the Managing Director shall be taken to have been\ndone by the Corporation."
    },
