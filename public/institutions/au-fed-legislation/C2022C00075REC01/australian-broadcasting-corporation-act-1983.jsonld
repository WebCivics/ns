    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-23-2-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "Obligation to exercise power",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A delegation of a power under this section does not prevent the exercise of the power by the Corporation.",
      "cml:conclusionText": "The Corporation must exercise its power."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-23-2-ss-3-logic-linearlogic-2",
