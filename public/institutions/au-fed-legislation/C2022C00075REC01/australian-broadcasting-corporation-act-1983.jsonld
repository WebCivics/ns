    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-14a",
      "@type": "cml:Concept",
      "skos:prefLabel": "14A Leave of absence of Managing Director",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-14a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.24",
      "values:originalText": "(1) The Managing Director has such recreation leave entitlements as\nare determined by the Remuneration Tribunal.\n(2) The Managing Director may take recreation leave only with the\nBoard’s approval.\n(3) The Board may grant the Managing Director leave of absence,\nother than recreation leave, on such terms and conditions as to\nremuneration or otherwise as the Board determines.",
      "skos:definition": "(1) The Managing Director has such recreation leave entitlements as\nare determined by the Remuneration Tribunal.\n(2) The Managing Director may take recreation leave only with the\nBoard’s approval.\n(3) The Board may grant the Managing Director leave of absence,\nother than recreation leave, on such terms and conditions as to\nremuneration or otherwise as the Board determines.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-14a-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-14a-ss-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-14a-ss-3"
        }
      ],
      "cml:integrityHash": "2bd640edd79628bf9a81b391954d9c57fb39a0775cf0ffdccbbd4303e326c914"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-14a",
      "@type": "cof:Section",
      "cof:title": "14A Leave of absence of Managing Director",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "(1) The Managing Director has such recreation leave entitlements as\nare determined by the Remuneration Tribunal.\n(2) The Managing Director may take recreation leave only with the\nBoard’s approval.\n(3) The Board may grant the Managing Director leave of absence,\nother than recreation leave, on such terms and conditions as to\nremuneration or otherwise as the Board determines."
    },
