      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Delegation diffuses to the Managing Director's power.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A delegation under this section does not prevent the exercise of a power by the Managing Director.",
      "cml:conclusionText": "The delegation affects the Managing Director's power."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24a",
      "@type": "cml:Concept",
      "skos:prefLabel": "24A Establishment",
