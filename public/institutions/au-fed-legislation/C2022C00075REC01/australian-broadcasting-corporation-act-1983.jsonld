    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "79B(6) Records of matter broadcast",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79b-ss-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.68",
      "values:originalText": "(6) The obligation imposed by this section on the Corporation to retain\na record does not apply at any time when the record is in the\ncustody of a court in connection with proceedings instituted in the\ncourt.",
      "skos:definition": "(6) The obligation imposed by this section on the Corporation to retain\na record does not apply at any time when the record is in the\ncustody of a court in connection with proceedings instituted in the\ncourt.",
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-6-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5728156789c97ed352da7f2f4e49b3e8a885579f7f20cdfcabe0470433365aa3",
      "skos:note": "The Corporation must retain a record when it is not in the custody of a court."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79b-ss-6",
      "@type": "cof:Section",
      "cof:title": "79B(6) Records of matter broadcast",
      "values:kind": "subsection",
      "cof:pageNumber": 68,
      "values:originalText": "(6) The obligation imposed by this section on the Corporation to retain\na record does not apply at any time when the record is in the\ncustody of a court in connection with proceedings instituted in the\ncourt."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-6-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-6"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If the record is not in the custody of a court, then the Corporation does not have to retain it.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The obligation imposed by this section on the Corporation to retain a record does not apply at any time when the record is in the custody of a court.",
      "cml:conclusionText": "The Corporation does not have to retain the record."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "79B(7) Records of matter broadcast",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79b-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.68",
      "values:originalText": "(7) Subsection (1) does not apply to or in relation to proceedings of the\nSenate or of the House of Representatives broadcast or\nre-broadcast by the Corporation pursuant to the Parliamentary\nProceedings Broadcasting Act 1946.",
      "skos:definition": "(7) Subsection (1) does not apply to or in relation to proceedings of the\nSenate or of the House of Representatives broadcast or\nre-broadcast by the Corporation pursuant to the Parliamentary\nProceedings Broadcasting Act 1946.",
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-79b-ss-7-norm"
        }
      ],
      "cml:integrityHash": "bc4dd88363416ab10ab01e7d5877ec854f20104983355ea4b2f86945e68e2d27",
      "skos:note": "Exemption from subsection (1) for Senate and House of Representatives proceedings"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-79b-ss-7",
      "@type": "cof:Section",
      "cof:title": "79B(7) Records of matter broadcast",
      "values:kind": "subsection",
      "cof:pageNumber": 68,
      "values:originalText": "(7) Subsection (1) does not apply to or in relation to proceedings of the\nSenate or of the House of Representatives broadcast or\nre-broadcast by the Corporation pursuant to the Parliamentary\nProceedings Broadcasting Act 1946."
    },
