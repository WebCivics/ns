    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-20-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "20(8) Acting Managing Director",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-20-ss-8"
