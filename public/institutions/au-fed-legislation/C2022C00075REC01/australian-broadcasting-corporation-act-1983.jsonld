    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24l",
      "@type": "cml:Concept",
      "skos:prefLabel": "24L Disclosure of interests to the Nomination Panel",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24l"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.38",
      "values:originalText": "(1) A member of the Nomination Panel who has an interest, pecuniary\nor otherwise, in a matter being considered or about to be\nconsidered by the Nomination Panel must disclose the nature of the\ninterest to a meeting of the Nomination Panel.\n(2) The disclosure must be made as soon as possible after the relevant\nfacts have come to the member’s knowledge.\n(3) The disclosure must be recorded in the minutes of the meeting.",
      "skos:definition": "(1) A member of the Nomination Panel who has an interest, pecuniary\nor otherwise, in a matter being considered or about to be\nconsidered by the Nomination Panel must disclose the nature of the\ninterest to a meeting of the Nomination Panel.\n(2) The disclosure must be made as soon as possible after the relevant\nfacts have come to the member’s knowledge.\n(3) The disclosure must be recorded in the minutes of the meeting.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24l-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24l-ss-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24l-ss-3"
        }
      ],
      "cml:integrityHash": "58eb17077531aaefd4b250c51daf3d559ce4df8263b2e96fe5b40be215da92de"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24l",
      "@type": "cof:Section",
      "cof:title": "24L Disclosure of interests to the Nomination Panel",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "(1) A member of the Nomination Panel who has an interest, pecuniary\nor otherwise, in a matter being considered or about to be\nconsidered by the Nomination Panel must disclose the nature of the\ninterest to a meeting of the Nomination Panel.\n(2) The disclosure must be made as soon as possible after the relevant\nfacts have come to the member’s knowledge.\n(3) The disclosure must be recorded in the minutes of the meeting."
    },
