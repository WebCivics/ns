      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.40",
      "values:originalText": "The Nomination Panel may, subject to this Division, regulate\nproceedings at its meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc.\n\n\nMerit-based appointment of non-executive Directors  Part IIIA\nMeetings of Nomination Panel  Division 3\nSection 24V\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "skos:definition": "The Nomination Panel may, subject to this Division, regulate\nproceedings at its meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc.\n\n\nMerit-based appointment of non-executive Directors  Part IIIA\nMeetings of Nomination Panel  Division 3\nSection 24V\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24u-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24u-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0314a7449caa4bc0748e4ba667fe997a01cd8a373105ab061ac72df340823e47",
      "skos:note": "Regulate proceedings at meetings as considered appropriate."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24u",
      "@type": "cof:Section",
      "cof:title": "24U Conduct of meetings",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "The Nomination Panel may, subject to this Division, regulate\nproceedings at its meetings as it considers appropriate.\nNote:\nSection 33B of the Acts Interpretation Act 1901 provides for\nparticipation in meetings by telephone etc.\n\n\nMerit-based appointment of non-executive Directors  Part IIIA\nMeetings of Nomination Panel  Division 3\nSection 24V\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022"
    },
