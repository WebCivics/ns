    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24m",
      "@type": "cml:Concept",
      "skos:prefLabel": "24M Resignation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24m"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.38",
      "values:originalText": "(1) A member of the Nomination Panel may resign his or her\nappointment by giving the Secretary of the Prime Minister’s\nDepartment a written resignation.\n(2) The resignation takes effect on the day it is received by the\nSecretary of the Prime Minister’s Department or, if a later day is\nspecified in the resignation, on that later day.",
      "skos:definition": "(1) A member of the Nomination Panel may resign his or her\nappointment by giving the Secretary of the Prime Minister’s\nDepartment a written resignation.\n(2) The resignation takes effect on the day it is received by the\nSecretary of the Prime Minister’s Department or, if a later day is\nspecified in the resignation, on that later day.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24m-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24m-ss-2"
        }
      ],
      "cml:integrityHash": "845a3efc0bc33cd4dda32d3cecd2862624ea7f18cb8d43fdaa12d833995049b1"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24m",
      "@type": "cof:Section",
      "cof:title": "24M Resignation",
      "values:kind": "section",
      "cof:pageNumber": 38,
      "values:originalText": "(1) A member of the Nomination Panel may resign his or her\nappointment by giving the Secretary of the Prime Minister’s\nDepartment a written resignation.\n(2) The resignation takes effect on the day it is received by the\nSecretary of the Prime Minister’s Department or, if a later day is\nspecified in the resignation, on that later day."
    },
