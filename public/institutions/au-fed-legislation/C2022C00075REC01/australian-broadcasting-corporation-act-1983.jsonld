    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Corporation to have regard to services of the Special",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.48",
      "values:originalText": "Broadcasting Service Corporation\nIn performing its functions, the Corporation must have regard to\nthe services provided by the Special Broadcasting Service\nCorporation.\n\n\nPowers and duties of the Corporation  Part IV\n\nSection 27\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "skos:definition": "Broadcasting Service Corporation\nIn performing its functions, the Corporation must have regard to\nthe services provided by the Special Broadcasting Service\nCorporation.\n\n\nPowers and duties of the Corporation  Part IV\n\nSection 27\nAustralian Broadcasting Corporation Act 1983\nCompilation date: 18/02/2022\nRegistered: 23/02/2022",
      "cml:asserts": [
