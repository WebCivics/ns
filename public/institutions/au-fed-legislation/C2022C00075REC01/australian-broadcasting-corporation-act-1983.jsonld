    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24y",
      "@type": "cml:Concept",
      "skos:prefLabel": "24Y Department’s annual report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24y"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.43",
      "values:originalText": "The Department’s annual report for a financial year must include a\nstatement in relation to each selection process for the appointment\nof a Director referred to in paragraph 12(1)(b) or (c) that was\ncompleted in that financial year.",
      "skos:definition": "The Department’s annual report for a financial year must include a\nstatement in relation to each selection process for the appointment\nof a Director referred to in paragraph 12(1)(b) or (c) that was\ncompleted in that financial year.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24y-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24y-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ba96bbeb5978100ba1cf3af4f29ef8c89eaa55f1ea8bd5274187f88164048a53",
      "skos:note": "Annual report must include statement on selection process for Director appointment.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24y",
      "@type": "cof:Section",
      "cof:title": "24Y Department’s annual report",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "The Department’s annual report for a financial year must include a\nstatement in relation to each selection process for the appointment\nof a Director referred to in paragraph 12(1)(b) or (c) that was\ncompleted in that financial year."
    },
