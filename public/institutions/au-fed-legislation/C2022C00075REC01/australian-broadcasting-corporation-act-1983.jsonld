        }
      ],
      "cml:integrityHash": "d19485b71dfdebe7c3c5448e40fa6da211d61c682fc1c3f3a840e3890d519f5e",
      "skos:note": "Terms and conditions for Nomination Panel members"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24p",
      "@type": "cof:Section",
