      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.22",
      "values:originalText": "(6) A person who has been elected as the staff-elected Director at 2\nelections is not eligible for election at any other election of the\nstaff-elected Director.",
      "skos:definition": "(6) A person who has been elected as the staff-elected Director at 2\nelections is not eligible for election at any other election of the\nstaff-elected Director.",
      "values:partOf": {
