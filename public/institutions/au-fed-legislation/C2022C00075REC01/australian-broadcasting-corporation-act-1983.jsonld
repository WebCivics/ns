      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) A delegation of a power under this section does not prevent the exercise of the power by the Corporation.",
      "cml:conclusionText": "The exercise of power is conjunction with the delegation"
    },
    {
