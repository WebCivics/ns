      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.57",
      "values:originalText": "(1) The Finance Minister may, on behalf of the Commonwealth, lend\nmoney to the Corporation.\n(2) The money shall be lent on the terms and conditions determined by\nthe Finance Minister.\n(3) A determination under subsection (2) shall be in writing.",
      "skos:definition": "(1) The Finance Minister may, on behalf of the Commonwealth, lend\nmoney to the Corporation.\n(2) The money shall be lent on the terms and conditions determined by\nthe Finance Minister.\n(3) A determination under subsection (2) shall be in writing.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-70a-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-70a-ss-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-70a-ss-3"
        }
      ],
      "cml:integrityHash": "2aa45b63f28c5bcd16f4b85141c171b29288c286033849686df9e7f2b899e7b8"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-70a",
      "@type": "cof:Section",
      "cof:title": "70A Borrowing from Commonwealth",
      "values:kind": "section",
      "cof:pageNumber": 57,
      "values:originalText": "(1) The Finance Minister may, on behalf of the Commonwealth, lend\nmoney to the Corporation.\n(2) The money shall be lent on the terms and conditions determined by\nthe Finance Minister.\n(3) A determination under subsection (2) shall be in writing."
    },
