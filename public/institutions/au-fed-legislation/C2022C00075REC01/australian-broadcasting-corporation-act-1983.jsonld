      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24n-ss-1",
      "@type": "cof:Section",
      "cof:title": "24N(1) Termination of appointment",
      "values:kind": "subsection",
      "cof:pageNumber": 38,
      "values:originalText": "(1) The Secretary of the Prime Minister’s Department may terminate\nthe appointment of a member of the Nomination Panel for\nmisbehaviour or physical or mental incapacity."
    },
