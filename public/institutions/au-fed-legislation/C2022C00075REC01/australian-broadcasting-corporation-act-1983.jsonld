      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.16",
      "values:originalText": "(6) In making appointments to the Australian Broadcasting\nCorporation Advisory Council, the Board shall have regard to the\ndesirability of including in the membership of that Advisory\nCouncil a broad representation of the Australian community.",
      "skos:definition": "(6) In making appointments to the Australian Broadcasting\nCorporation Advisory Council, the Board shall have regard to the\ndesirability of including in the membership of that Advisory\nCouncil a broad representation of the Australian community.",
