    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-20-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "20(4) Acting Managing Director",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-20-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.26",
      "values:originalText": "(4) An employee of the Corporation who is acting as Managing\nDirector shall continue to be paid the remuneration and allowances\npayable to him or her as such an employee but shall also be paid:\n(a) so much of any remuneration payable to the Managing\nDirector as exceeds the remuneration that so continues to be\npaid to the employee;\n(b) so much of any allowance payable to the Managing Director\nas exceeds the corresponding allowance that so continues to\nbe paid to the employee; and\n(c) if an allowance is payable to the Managing Director in\nrespect of which there is no corresponding allowance payable\nto the employee—that allowance.",
      "skos:definition": "(4) An employee of the Corporation who is acting as Managing\nDirector shall continue to be paid the remuneration and allowances\npayable to him or her as such an employee but shall also be paid:\n(a) so much of any remuneration payable to the Managing\nDirector as exceeds the remuneration that so continues to be\npaid to the employee;\n(b) so much of any allowance payable to the Managing Director\nas exceeds the corresponding allowance that so continues to\nbe paid to the employee; and\n(c) if an allowance is payable to the Managing Director in\nrespect of which there is no corresponding allowance payable\nto the employee—that allowance.",
      "values:partOf": {
        "@id": "concept:australian-broadcasting-corporation-act-1983-sec-20"
      },
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-20-ss-4-norm"
