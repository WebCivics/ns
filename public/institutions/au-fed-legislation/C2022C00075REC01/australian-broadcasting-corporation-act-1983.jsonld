      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.36",
      "values:originalText": "The Nomination Panel consists of the following members:\n(a) the Chair of the Nomination Panel;\n(b) at least 2, and not more than 3, other members.",
      "skos:definition": "The Nomination Panel consists of the following members:\n(a) the Chair of the Nomination Panel;\n(b) at least 2, and not more than 3, other members.",
      "cml:asserts": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24e-norm"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24e-logic-deontic-1"
        }
      ],
