      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "No other Director is available to act as Chairperson.",
      "cml:conclusionText": "The absence of both Chairperson and Deputy Chairperson creates a gap in leadership."
    },
