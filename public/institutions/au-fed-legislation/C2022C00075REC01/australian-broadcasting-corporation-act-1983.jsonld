    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24e",
      "@type": "cml:Concept",
      "skos:prefLabel": "24E Membership",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24e"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
