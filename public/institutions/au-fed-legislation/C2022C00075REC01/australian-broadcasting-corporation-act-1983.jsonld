      },
      "cml:premiseText": "(2) Where the person holding office as Managing Director is re-appointed, the re-appointment shall be for a period not exceeding 5 years.",
      "cml:conclusionText": "The re-appointment period must be fixed at 5 years or less."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-13-ss-2-logic-diffusion-4",
