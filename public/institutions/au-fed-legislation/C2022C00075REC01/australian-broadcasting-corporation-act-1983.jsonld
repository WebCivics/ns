          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-31b-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "cff84cae3f280170a82b7bf396f0373af703d9f8cea9be52babbc76caafeb6d1",
      "skos:note": "Definition of subsidiary for application of section 35"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-31b-ss-4",
      "@type": "cof:Section",
      "cof:title": "31B(4) Matters to be included in corporate plans",
      "values:kind": "subsection",
      "cof:pageNumber": 54,
      "values:originalText": "(4) For the purposes of the application of section 35 of the Public\nGovernance, Performance and Accountability Act 2013 in relation\nto the Corporation, subsidiary is taken to have the meaning given\nby subsection (3) of this section, despite the definition of\nsubsidiary in section 8 of that Act."
    },
