      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-13a-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "13A(6) Staff-elected Director",
