    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Tenure of Managing Director",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-broadcasting-corporation-act-1983.pdf"
      },
      "dc:source": "australian-broadcasting-corporation-act-1983.pdf, p.22",
      "values:originalText": "(1) Subject to subsection (2), the Managing Director shall be appointed\nby the Board for a period of 5 years, but is eligible for\nre-appointment.\n(2) Where the person holding office as Managing Director is\nre-appointed, the re-appointment shall be for a period not\nexceeding 5 years.\n(3) The Managing Director holds office, subject to this Part, on such\nterms and conditions as are determined by the Board.",
      "skos:definition": "(1) Subject to subsection (2), the Managing Director shall be appointed\nby the Board for a period of 5 years, but is eligible for\nre-appointment.\n(2) Where the person holding office as Managing Director is\nre-appointed, the re-appointment shall be for a period not\nexceeding 5 years.\n(3) The Managing Director holds office, subject to this Part, on such\nterms and conditions as are determined by the Board.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-13-ss-1"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-13-ss-2"
        },
        {
          "@id": "concept:australian-broadcasting-corporation-act-1983-sec-13-ss-3"
        }
      ],
      "cml:integrityHash": "47b2fb8efba5037ef58e10483fe045de1523eeefa71fe2b6f7cdf932d4e3ab90"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Tenure of Managing Director",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "(1) Subject to subsection (2), the Managing Director shall be appointed\nby the Board for a period of 5 years, but is eligible for\nre-appointment.\n(2) Where the person holding office as Managing Director is\nre-appointed, the re-appointment shall be for a period not\nexceeding 5 years.\n(3) The Managing Director holds office, subject to this Part, on such\nterms and conditions as are determined by the Board."
    },
