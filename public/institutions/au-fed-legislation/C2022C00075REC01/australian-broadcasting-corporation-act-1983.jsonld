      ],
      "cml:integrityHash": "8fd5209a37fbe1181ea4642ad65972f254af3ee6ae4fdcb078cb7196641243d1",
      "skos:note": "Exercise of power by Managing Director not prevented by delegation."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-broadcasting-corporation-act-1983#sec-24-ss-3",
      "@type": "cof:Section",
      "cof:title": "24(3) Delegation by Managing Director",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(3) A delegation under this section does not prevent the exercise of a\npower by the Managing Director."
    },
    {
      "@id": "concept:australian-broadcasting-corporation-act-1983-sec-24-ss-3-norm",
