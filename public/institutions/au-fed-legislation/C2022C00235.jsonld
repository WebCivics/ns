    {
      "@id": "concept:c2022c00235-sch-1-sec-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "AFCA scheme has a specific definition",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for definitions",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "AFCA scheme is defined as the external dispute resolution scheme for which an authorisation under Part 7.10A is in force."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Staff members have specific definitions",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy for staff members",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "AFCA staff member is defined as a director, officer or employee of AFCA or a person engaged as a consultant to, or to perform services for, AFCA."
    },
