doc:sch-1-sec-1050-ss-3 a cof:Section ;
    cof:title "1050(3) Minister may authorise an external dispute resolution scheme" ;
    values:kind "subsection" ;
    values:originalText "(3) An authorisation of an external dispute resolution scheme must not come into force while an authorisation of another external dispute resolution scheme is in force." ;
    cof:pageNumber "12"^^xsd:integer .

concept:c2022c00235-sch-1-sec-1050-ss-4 a cml:Concept ;
    skos:prefLabel "1050(4) Minister may authorise an external dispute resolution scheme"@en ;
    cml:realizedBy doc:sch-1-sec-1050-ss-4 ;
    values:originalText "(4) The Minister may, by notifiable instrument, vary or revoke an authorisation of an external dispute resolution scheme." ;
