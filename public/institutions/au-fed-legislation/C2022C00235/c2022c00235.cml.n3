doc:sch-1-sec-1054b-ss-2 a cof:Section ;
    cof:title "1054B(2) Power to require attendance at conciliation conferences" ;
    values:kind "subsection" ;
    values:originalText "(2) The notice must also fix the date, time and place for the conference.  External dispute resolution  Schedule 1 Amendments applying from the day after Royal Assent  Part 1  Treasury Laws Amendment (Putting Consumers First—Establishment of the Australian Financial Complaints Authority) Act 2018 Compilation date: 10/08/2022 Registered: 25/08/2022" ;
    cof:pageNumber "26"^^xsd:integer .

concept:c2022c00235-sch-1-sec-1054b-ss-3 a cml:Concept ;
    skos:prefLabel "1054B(3) Power to require attendance at conciliation conferences"@en ;
    cml:realizedBy doc:sch-1-sec-1054b-ss-3 ;
    values:originalText "(3) If the complainant fails to attend the conference, AFCA may deal with the complaint as if it had been withdrawn by the complainant." ;
    skos:definition "(3) If the complainant fails to attend the conference, AFCA may deal with the complaint as if it had been withdrawn by the complainant."@en ;
    cml:integrityHash "09ad64640c286dab7581f44698c1a1e0638592222afee2969bf78ab8ddbc42cd" ;
