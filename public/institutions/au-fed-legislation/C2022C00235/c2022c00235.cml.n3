doc:sch-1-sec-1055b-ss-1 a cof:Section ;
    cof:title "1055B(1) Operation of determination of superannuation complaint" ;
    values:kind "subsection" ;
    values:originalText "(1) Subject to subsection (2), a determination of a superannuation complaint by AFCA comes into operation immediately upon the making of the determination." ;
