concept:c2022c00235-sch-1-sec-1055b-ss-2 a cml:Concept ;
    skos:prefLabel "1055B(2) Operation of determination of superannuation complaint"@en ;
    cml:realizedBy doc:sch-1-sec-1055b-ss-2 ;
    values:originalText "(2) AFCA may specify in the determination that the determination is not to come into operation until a later date specified in the  External dispute resolution  Schedule 1 Amendments applying from the day after Royal Assent  Part 1  Treasury Laws Amendment (Putting Consumers First—Establishment of the Australian Financial Complaints Authority) Act 2018 Compilation date: 10/08/2022 Registered: 25/08/2022  determination and, if a later date is so specified, the determination comes into operation on that date." ;
    skos:definition "(2) AFCA may specify in the determination that the determination is not to come into operation until a later date specified in the  External dispute resolution  Schedule 1 Amendments applying from the day after Royal Assent  Part 1  Treasury Laws Amendment (Putting Consumers First—Establishment of the Australian Financial Complaints Authority) Act 2018 Compilation date: 10/08/2022 Registered: 25/08/2022  determination and, if a later date is so specified, the determination comes into operation on that date."@en ;
    cml:integrityHash "6c9c06e24eb3e470e7fb6468f5502d4998dd5a761559c509e3502547f10556b9" ;
    values:partOf concept:c2022c00235-sch-1-sec-1055b ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Determination may come into operation on a later date specified in the determination." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2022c00235.pdf> ;
