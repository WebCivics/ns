doc:sch-1-sec-1052c-ss-1 a cof:Section ;
    cof:title "1052C(1) General directions to AFCA" ;
    values:kind "subsection" ;
    values:originalText "(1) If ASIC considers that AFCA has not done all things reasonably practicable to ensure compliance with:  (a) the mandatory requirements for the AFCA scheme under section 1051; or  (b) a condition of the authorisation of the AFCA scheme imposed by the Minister under paragraph 1050(5)(b); or  (c) regulatory requirements issued under section 1052A; ASIC may give AFCA written notice that it intends to give AFCA a specified direction under this section." ;
    cof:pageNumber "18"^^xsd:integer .

concept:c2022c00235-sch-1-sec-1052c-ss-2 a cml:Concept ;
    skos:prefLabel "1052C(2) General directions to AFCA"@en ;
    cml:realizedBy doc:sch-1-sec-1052c-ss-2 ;
    values:originalText "(2) The notice must set out:  (a) the specific measures that the direction will require AFCA to take to comply with the requirements or condition; and  (b) the reasons for ASIC’s intention to give the direction. Issuing a direction" ;
    skos:definition "(2) The notice must set out:  (a) the specific measures that the direction will require AFCA to take to comply with the requirements or condition; and  (b) the reasons for ASIC’s intention to give the direction. Issuing a direction"@en ;
