    cml:operator "BETWEEN" ;
    cml:logicSummary "Temporal interval between complaint and determination" ;
    cml:premiseText "(a) a superannuation complaint has been made concerning a disability benefit (whether under a contract of insurance or otherwise);" ;
    cml:conclusionText "The person must comply with any determination made in respect of the person by AFCA." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2022c00235-sch-1-sec-1055d cml:asserts concept:c2022c00235-sch-1-sec-1055d-logic-ltl-3 .
