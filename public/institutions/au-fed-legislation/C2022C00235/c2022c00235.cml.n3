    cml:modality cml:LTL ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Temporal interval between complaint and commencement" ;
    cml:premiseText "(a) a superannuation complaint has been made concerning a disability benefit (whether under a contract of insurance or otherwise);" ;
    cml:conclusionText "The person must comply with any determination made in respect of the person by AFCA." ;
    cml:executionSurface "modalities::temporal_ltl" ;
