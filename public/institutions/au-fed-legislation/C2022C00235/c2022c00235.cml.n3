    values:originalText "Note: This table relates only to the provisions of this Act as originally enacted. It will not be amended to deal with any later amendments of this Act.  (2) Any information in column 3 of the table is not part of this Act. Information may be inserted in this column, or information in it may be edited, in any published version of this Act." ;
    cof:pageNumber "8"^^xsd:integer .

concept:c2022c00235-sch-3-sec-3-2 a cml:Concept ;
    skos:prefLabel "3 Schedules"@en ;
    cml:realizedBy doc:sch-3-sec-3-2 ;
    values:originalText "Legislation that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule concerned, and any other item in a Schedule to this Act has effect according to its terms." ;
    skos:definition "Legislation that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule concerned, and any other item in a Schedule to this Act has effect according to its terms."@en ;
    cml:integrityHash "451ffd68058b1e0feb697eca15b67f99f88953e3d620122de73723d8ad8ce2fa" ;
    cof:pageNumber "8"^^xsd:integer ;
