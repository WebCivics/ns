    skos:prefLabel "8 Schedule 3"@en ;
    cml:realizedBy doc:sch-3-sec-8 ;
    values:originalText "A day or days to be fixed by Proclamation. However, if any of the provisions do not commence within the period of 4 years beginning on the day this Act receives the Royal Assent, they commence on the day after the end of that period." ;
