concept:c2022c00235-sch-1-sec-1054b-ss-4 a cml:Concept ;
    skos:prefLabel "1054B(4) Power to require attendance at conciliation conferences"@en ;
    cml:realizedBy doc:sch-1-sec-1054b-ss-4 ;
    values:originalText "(4) A person (other than the complainant) commits an offence if he or she does not attend a conference when required to do so under this section. Penalty: 30 penalty units." ;
    skos:definition "(4) A person (other than the complainant) commits an offence if he or she does not attend a conference when required to do so under this section. Penalty: 30 penalty units."@en ;
    cml:integrityHash "bd8a6344adf8b8290b555d4385fe1eca616a2a112102861eea6e5c8580f89a16" ;
    values:partOf concept:c2022c00235-sch-1-sec-1054b ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Failure to attend conciliation conference is an offence." ;
    cml:curationStatus cml:Proposed ;
