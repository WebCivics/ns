concept:c2022c00235-sch-1-sec-46 a cml:Concept ;
    skos:prefLabel "46 Section 292-330 (note)"@en ;
    cml:realizedBy doc:sch-1-sec-46 ;
    values:originalText "Repeal the note, substitute: Note: If a person is dissatisfied with a statement given to the Commissioner by a superannuation provider under section 390-5 in Schedule 1 to the Taxation Administration Act 1953, the person may make a complaint under the AFCA scheme (within the meaning of Chapter 7 of the Corporations Act 2001). National Consumer Credit Protection Act 2009" ;
    skos:definition "Repeal the note, substitute: Note: If a person is dissatisfied with a statement given to the Commissioner by a superannuation provider under section 390-5 in Schedule 1 to the Taxation Administration Act 1953, the person may make a complaint under the AFCA scheme (within the meaning of Chapter 7 of the Corporations Act 2001). National Consumer Credit Protection Act 2009"@en ;
    cml:integrityHash "5dd5ac8aca437c370446b834c86d5c69fe0d3764aa42956e1c563e387e2f6872" ;
    cof:pageNumber "48"^^xsd:integer ;
    skos:note "Complaint procedure under AFCA scheme for dissatisfied individuals" ;
