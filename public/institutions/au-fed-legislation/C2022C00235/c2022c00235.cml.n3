    values:partOf concept:c2022c00235-sch-1-sec-1052c ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Notice must set out specific measures and reasons for direction." ;
    dc:description "(a) the specific measures that the direction will require AFCA to take to comply with the requirements or condition; (b) the reasons for ASIC’s intention to give the direction." ;
