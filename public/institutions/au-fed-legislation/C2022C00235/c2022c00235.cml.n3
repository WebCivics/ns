concept:c2022c00235-sch-1-sec-5 a cml:Concept ;
    skos:prefLabel "5 At the end of section 7A"@en ;
    cml:realizedBy doc:sch-1-sec-5 ;
    values:originalText "Add:  (4) The Tribunal Chairperson may, by writing, delegate any or all of his or her functions or powers to any Tribunal member.  Schedule 1  External dispute resolution" ;
