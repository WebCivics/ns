    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1054b-ss-2",
      "@type": "cof:Section",
      "cof:title": "1054B(2) Power to require attendance at conciliation conferences",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(2) The notice must also fix the date, time and place for the\nconference.\n\nExternal dispute resolution  Schedule 1\nAmendments applying from the day after Royal Assent  Part 1\n\nTreasury Laws Amendment (Putting Consumers First—Establishment of the\nAustralian Financial Complaints Authority) Act 2018\nCompilation date: 10/08/2022\nRegistered: 25/08/2022"
    },
