      },
      "cml:premiseText": "(3) If, under subsection 1055(4) or (5), the determination varies a\ndecision of another person...",
      "cml:conclusionText": "...is, for all purposes (other than the making of a complaint about the decision)..."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1055b-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "taken to be",
      "cml:logicSummary": "Decision is taken to be a decision of another person.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
