    {
      "@id": "concept:c2022c00235-sch-1-sec-1052c-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "1052C(3) General directions to AFCA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052c-ss-3"
