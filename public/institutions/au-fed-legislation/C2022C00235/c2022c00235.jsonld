      "cml:integrityHash": "dbe273760bad014248a6ed21f502ba43e13081f6fc4497f7706b8d8d4d8eef16",
      "skos:note": "Determination of superannuation complaint comes into operation immediately upon making."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1055b-ss-1",
      "@type": "cof:Section",
      "cof:title": "1055B(1) Operation of determination of superannuation complaint",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(1) Subject to subsection (2), a determination of a superannuation\ncomplaint by AFCA comes into operation immediately upon the\nmaking of the determination."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1055b-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
