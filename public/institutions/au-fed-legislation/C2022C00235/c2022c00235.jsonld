    {
      "@id": "concept:c2022c00235-sch-1-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Section 155-90 in Schedule 1 (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-28"
      },
      "cml:curationStatus": {
