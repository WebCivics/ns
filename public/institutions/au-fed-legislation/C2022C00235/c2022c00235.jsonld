        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2022c00235-sch-2-sec-243c-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "243C(2) ASIC may publish internal dispute resolution data",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-2-sec-243c-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.55",
      "values:originalText": "(2) Information published under this section may relate to a particular\nentity, or may be information from which a particular entity may\nbe identified, but must not be personal information within the\nmeaning of the Privacy Act 1988.\nCorporations Act 2001",
      "skos:definition": "(2) Information published under this section may relate to a particular\nentity, or may be information from which a particular entity may\nbe identified, but must not be personal information within the\nmeaning of the Privacy Act 1988.\nCorporations Act 2001",
