    {
      "@id": "concept:c2022c00235-sch-1-sec-46",
      "@type": "cml:Concept",
      "skos:prefLabel": "46 Section 292-330 (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-46"
      },
      "cml:curationStatus": {
