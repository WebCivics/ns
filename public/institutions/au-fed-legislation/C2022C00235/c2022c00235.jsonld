    {
      "@id": "concept:c2022c00235-sch-2-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 After subsection 912A(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-2-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
