      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to comply with determination",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "AFCA joins the person under subsection 1054(1) as a party to the complaint.",
      "cml:conclusionText": "The person must comply with any determination made in respect of the person by AFCA."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1055d-logic-alleninterval-2",
