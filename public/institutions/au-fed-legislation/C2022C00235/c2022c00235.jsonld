        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1057b",
      "@type": "cml:Concept",
      "skos:prefLabel": "1057B Sending of documents to, and disclosure of documents by, the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1057b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.35",
      "values:originalText": "Federal Court\n\nIf an appeal is instituted in the Federal Court from AFCA’s\ndetermination of a superannuation complaint:\n\n(a) AFCA must send to the Court all documents that were before\nAFCA in connection with the consideration of the matter to\nwhich the appeal relates; and\n\n(b) at the conclusion of the proceeding before the Court in\nrelation to the appeal, the Court must return the documents to\nAFCA.\nSubdivision F—Secrecy",
      "skos:definition": "Federal Court\n\nIf an appeal is instituted in the Federal Court from AFCA’s\ndetermination of a superannuation complaint:\n\n(a) AFCA must send to the Court all documents that were before\nAFCA in connection with the consideration of the matter to\nwhich the appeal relates; and\n\n(b) at the conclusion of the proceeding before the Court in\nrelation to the appeal, the Court must return the documents to\nAFCA.\nSubdivision F—Secrecy",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1057b-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1057b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "65861cff4bf8d69a30f36252b03db62de4d42f751d2a4b20d9afc4f7d1539c05",
      "skos:note": "AFCA must send documents to the Federal Court and return them after a proceeding."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1057b",
      "@type": "cof:Section",
      "cof:title": "1057B Sending of documents to, and disclosure of documents by, the",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "Federal Court\n\nIf an appeal is instituted in the Federal Court from AFCA’s\ndetermination of a superannuation complaint:\n\n(a) AFCA must send to the Court all documents that were before\nAFCA in connection with the consideration of the matter to\nwhich the appeal relates; and\n\n(b) at the conclusion of the proceeding before the Court in\nrelation to the appeal, the Court must return the documents to\nAFCA.\nSubdivision F—Secrecy"
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1057b-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-1-sec-1057b"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1057b-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to send documents",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "AFCA must send documents",
      "cml:conclusionText": "Federal Court must receive documents"
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1058",
      "@type": "cml:Concept",
      "skos:prefLabel": "1058 Secrecy",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1058"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.35",
      "values:originalText": "(1) An AFCA staff member must not directly or indirectly:\n\n(a) make a record of, or disclose to any person, court or\ninvestigating authority, any information acquired by the staff\n\nSchedule 1  External dispute resolution",
      "skos:definition": "(1) An AFCA staff member must not directly or indirectly:\n\n(a) make a record of, or disclose to any person, court or\ninvestigating authority, any information acquired by the staff\n\nSchedule 1  External dispute resolution",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1058-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1058-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ef79c80b4ebe0d0a99ecff113a89a006d2139785f7fb032c48ce851f7eceee18",
      "skos:note": "Disclose information to anyone"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1058",
      "@type": "cof:Section",
      "cof:title": "1058 Secrecy",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "(1) An AFCA staff member must not directly or indirectly:\n\n(a) make a record of, or disclose to any person, court or\ninvestigating authority, any information acquired by the staff\n\nSchedule 1  External dispute resolution"
    },
