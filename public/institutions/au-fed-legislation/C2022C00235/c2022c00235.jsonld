      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.30",
      "values:originalText": "(1) Subject to subsection (2), a determination of a superannuation\ncomplaint by AFCA comes into operation immediately upon the\nmaking of the determination.",
      "skos:definition": "(1) Subject to subsection (2), a determination of a superannuation\ncomplaint by AFCA comes into operation immediately upon the\nmaking of the determination.",
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-1-sec-1055b"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1055b-ss-1-norm"
