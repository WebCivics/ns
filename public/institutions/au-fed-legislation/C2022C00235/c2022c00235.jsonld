        }
      ],
      "cml:integrityHash": "ea3211d8717137bdd50c1c15d600609cb55bf921195ba31b3de35dd56877fda7",
      "skos:note": "Commencement provision for provisions not commenced within 4 years"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-3-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Schedule 3",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "A day or days to be fixed by Proclamation.\nHowever, if any of the provisions do not\ncommence within the period of 4 years\nbeginning on the day this Act receives the\nRoyal Assent, they commence on the day\nafter the end of that period."
    },
