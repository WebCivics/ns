      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.56",
      "values:originalText": "Insert:\n\n(2A) ASIC may, by legislative instrument, specify information that\nfinancial services licensees must give ASIC relating to their\ninternal dispute resolution procedures and the operation of their\ninternal dispute resolution procedures.\n\n(2B) An instrument under subsection (2A) must not specify any\ninformation that is personal information within the meaning of the\nPrivacy Act 1988.",
      "skos:definition": "Insert:\n\n(2A) ASIC may, by legislative instrument, specify information that\nfinancial services licensees must give ASIC relating to their\ninternal dispute resolution procedures and the operation of their\ninternal dispute resolution procedures.\n\n(2B) An instrument under subsection (2A) must not specify any\ninformation that is personal information within the meaning of the\nPrivacy Act 1988.",
      "cml:hasPart": [
        {
          "@id": "concept:c2022c00235-sch-2-sec-3-ss-2a"
        },
        {
          "@id": "concept:c2022c00235-sch-2-sec-3-ss-2b"
        }
      ],
      "cml:integrityHash": "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-2-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 After subsection 912A(2)",
      "values:kind": "section",
      "cof:pageNumber": 56,
      "values:originalText": "Insert:\n\n(2A) ASIC may, by legislative instrument, specify information that\nfinancial services licensees must give ASIC relating to their\ninternal dispute resolution procedures and the operation of their\ninternal dispute resolution procedures.\n\n(2B) An instrument under subsection (2A) must not specify any\ninformation that is personal information within the meaning of the\nPrivacy Act 1988."
    },
