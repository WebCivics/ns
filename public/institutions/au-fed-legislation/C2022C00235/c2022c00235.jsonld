    {
      "@id": "concept:c2022c00235-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsection 57(2) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.39",
      "values:originalText": "Repeal the note, substitute:\nNote:\nA person affected by the outcome of the reconsideration of the\ndecision may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under the Superannuation (Resolution of Complaints) Act 1993,\nbut not on or after the day on or after which complaints cannot be\nmade because of section 14AB of that Act.\nAustralian Prudential Regulation Authority Act 1998",
      "skos:definition": "Repeal the note, substitute:\nNote:\nA person affected by the outcome of the reconsideration of the\ndecision may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under the Superannuation (Resolution of Complaints) Act 1993,\nbut not on or after the day on or after which complaints cannot be\nmade because of section 14AB of that Act.\nAustralian Prudential Regulation Authority Act 1998",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-12-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-12-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f0e7aecf6a7ce513730ad6fca78befae831fd76407f825c8f994b90c9c326de9",
      "skos:note": "A person affected by the outcome of reconsideration may make a complaint under specific schemes."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Subsection 57(2) (note)",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "Repeal the note, substitute:\nNote:\nA person affected by the outcome of the reconsideration of the\ndecision may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under the Superannuation (Resolution of Complaints) Act 1993,\nbut not on or after the day on or after which complaints cannot be\nmade because of section 14AB of that Act.\nAustralian Prudential Regulation Authority Act 1998"
    },
