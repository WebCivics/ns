    {
      "@id": "concept:c2022c00235-sch-2-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Transitional provision for giving written reasons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-2-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.59",
      "values:originalText": "Until the first time an instrument made under subsection 101(1B) of the\nSuperannuation Industry (Supervision) Act 1993 as amended by this\nPart comes into force, paragraph 101(1)(d) of that Act as so amended\nhas effect as if:\n\n(a) the requirements of paragraphs 101(1)(c) to (e) of that Act as\nin force immediately before the commencement of this Part\nwere the requirements specified under subsection 101(1B) of\nthat Act as so amended; and\n\n(b) subsection 101(1A) of that Act as in force immediately\nbefore that commencement still had effect.",
      "skos:definition": "Until the first time an instrument made under subsection 101(1B) of the\nSuperannuation Industry (Supervision) Act 1993 as amended by this\nPart comes into force, paragraph 101(1)(d) of that Act as so amended\nhas effect as if:\n\n(a) the requirements of paragraphs 101(1)(c) to (e) of that Act as\nin force immediately before the commencement of this Part\nwere the requirements specified under subsection 101(1B) of\nthat Act as so amended; and\n\n(b) subsection 101(1A) of that Act as in force immediately\nbefore that commencement still had effect.",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-2-sec-10-norm"
        }
      ],
      "cml:integrityHash": "8fc97970c180e2a0a352bce2dea11099ede02599ebeb172f59e973f94772e976",
      "skos:note": "Transitional provision for giving written reasons"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-2-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Transitional provision for giving written reasons",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "Until the first time an instrument made under subsection 101(1B) of the\nSuperannuation Industry (Supervision) Act 1993 as amended by this\nPart comes into force, paragraph 101(1)(d) of that Act as so amended\nhas effect as if:\n\n(a) the requirements of paragraphs 101(1)(c) to (e) of that Act as\nin force immediately before the commencement of this Part\nwere the requirements specified under subsection 101(1B) of\nthat Act as so amended; and\n\n(b) subsection 101(1A) of that Act as in force immediately\nbefore that commencement still had effect."
    },
    {
