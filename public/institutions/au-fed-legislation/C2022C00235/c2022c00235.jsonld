    {
      "@id": "concept:c2022c00235-sch-1-sec-52",
      "@type": "cml:Concept",
      "skos:prefLabel": "52 Subsection 24(3) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-52"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.49",
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a member is dissatisfied with an assessment in so far as it relates to\nthe calculation of the member’s surchargeable contributions, as based\non an amount or amounts set out in a statement given to the\nCommissioner by a superannuation provider under section 13, the\nmember may make a complaint under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001) about the\nunfairness or unreasonableness of the superannuation provider’s\ndecision to set out the amount or any of the amounts in the statement.\nSuperannuation (Resolution of Complaints) Act 1993",
      "skos:definition": "Repeal the note, substitute:\nNote:\nIf a member is dissatisfied with an assessment in so far as it relates to\nthe calculation of the member’s surchargeable contributions, as based\non an amount or amounts set out in a statement given to the\nCommissioner by a superannuation provider under section 13, the\nmember may make a complaint under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001) about the\nunfairness or unreasonableness of the superannuation provider’s\ndecision to set out the amount or any of the amounts in the statement.\nSuperannuation (Resolution of Complaints) Act 1993",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-52-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-52-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4098cd29ae7064acaaacc19b8f644cf1bd2cb3586f1db27a2520c20b2f15eb0f",
      "skos:note": "Member may make a complaint under AFCA scheme about superannuation provider's decision."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-52",
      "@type": "cof:Section",
      "cof:title": "52 Subsection 24(3) (note)",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a member is dissatisfied with an assessment in so far as it relates to\nthe calculation of the member’s surchargeable contributions, as based\non an amount or amounts set out in a statement given to the\nCommissioner by a superannuation provider under section 13, the\nmember may make a complaint under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001) about the\nunfairness or unreasonableness of the superannuation provider’s\ndecision to set out the amount or any of the amounts in the statement.\nSuperannuation (Resolution of Complaints) Act 1993"
    },
    {
