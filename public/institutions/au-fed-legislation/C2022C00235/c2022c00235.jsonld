    {
      "@id": "concept:c2022c00235-sch-1-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Subsection 57(2) (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-45"
