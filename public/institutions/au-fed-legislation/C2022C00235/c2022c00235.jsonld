      "skos:note": "AFCA must give written notice of decision and reasons to a person who should not be a party to the complaint."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1054-ss-3",
      "@type": "cof:Section",
      "cof:title": "1054(3) Power to join other parties to superannuation complaint",
