    {
      "@id": "concept:c2022c00235-sch-1-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Section 292-330 (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.40",
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a statement given to the Commissioner\nby a superannuation provider under section 390-5 in Schedule 1 to the\nTaxation Administration Act 1953, the person may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under section 15CA of the Superannuation (Resolution of\nComplaints) Act 1993, but not on or after the day on or after\nwhich complaints cannot be made because of section 14AB of\nthat Act.\nRetirement Savings Accounts Act 1997",
      "skos:definition": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a statement given to the Commissioner\nby a superannuation provider under section 390-5 in Schedule 1 to the\nTaxation Administration Act 1953, the person may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under section 15CA of the Superannuation (Resolution of\nComplaints) Act 1993, but not on or after the day on or after\nwhich complaints cannot be made because of section 14AB of\nthat Act.\nRetirement Savings Accounts Act 1997",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-15-norm"
        }
      ],
      "cml:integrityHash": "6563561505f35e3a92bf6048ad5154b3e097c15331b4419c087c6f5ef18f79d8",
      "skos:note": "Complaint procedure under AFCA scheme and Superannuation (Resolution of Complaints) Act 1993"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Section 292-330 (note)",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a statement given to the Commissioner\nby a superannuation provider under section 390-5 in Schedule 1 to the\nTaxation Administration Act 1953, the person may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under section 15CA of the Superannuation (Resolution of\nComplaints) Act 1993, but not on or after the day on or after\nwhich complaints cannot be made because of section 14AB of\nthat Act.\nRetirement Savings Accounts Act 1997"
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-15-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-1-sec-15"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 Subsection 95(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.40",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1A) If it appears to ASIC that an RSA provider has refused or failed to\ngive effect to:\n\n(a) a determination of the Superannuation Complaints Tribunal\nunder sections 37D to 37G of the Superannuation\n(Resolution of Complaints) Act 1993; or\n\n(b) a determination made under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001);\n\nExternal dispute resolution  Schedule 1\nAmendments applying once the first authorisation of an external dispute resolution\nscheme comes into force  Part 2\n\nTreasury Laws Amendment (Putting Consumers First—Establishment of the\nAustralian Financial Complaints Authority) Act 2018\nCompilation date: 10/08/2022\nRegistered: 25/08/2022\n\nASIC may, by written notice, tell the RSA provider that ASIC\nproposes to conduct an investigation of the whole or a part of the\naffairs of the RSA provider.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1A) If it appears to ASIC that an RSA provider has refused or failed to\ngive effect to:\n\n(a) a determination of the Superannuation Complaints Tribunal\nunder sections 37D to 37G of the Superannuation\n(Resolution of Complaints) Act 1993; or\n\n(b) a determination made under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001);\n\nExternal dispute resolution  Schedule 1\nAmendments applying once the first authorisation of an external dispute resolution\nscheme comes into force  Part 2\n\nTreasury Laws Amendment (Putting Consumers First—Establishment of the\nAustralian Financial Complaints Authority) Act 2018\nCompilation date: 10/08/2022\nRegistered: 25/08/2022\n\nASIC may, by written notice, tell the RSA provider that ASIC\nproposes to conduct an investigation of the whole or a part of the\naffairs of the RSA provider.",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-16-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-16-logic-deontic-1"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-16-logic-ltl-2"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-16-logic-cogai-3"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-16-logic-shacl-4"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-16-logic-n3logic-5"
        }
      ],
      "cml:integrityHash": "ec49bd87521e50a2b90fafadd679b46f2166a365e25fceaef8c72987419cb46b",
      "skos:note": "ASIC may tell RSA provider that ASIC proposes to conduct an investigation."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-16",
      "@type": "cof:Section",
      "cof:title": "16 Subsection 95(1A)",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1A) If it appears to ASIC that an RSA provider has refused or failed to\ngive effect to:\n\n(a) a determination of the Superannuation Complaints Tribunal\nunder sections 37D to 37G of the Superannuation\n(Resolution of Complaints) Act 1993; or\n\n(b) a determination made under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001);\n\nExternal dispute resolution  Schedule 1\nAmendments applying once the first authorisation of an external dispute resolution\nscheme comes into force  Part 2\n\nTreasury Laws Amendment (Putting Consumers First—Establishment of the\nAustralian Financial Complaints Authority) Act 2018\nCompilation date: 10/08/2022\nRegistered: 25/08/2022\n\nASIC may, by written notice, tell the RSA provider that ASIC\nproposes to conduct an investigation of the whole or a part of the\naffairs of the RSA provider."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-16-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-1-sec-16"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-16-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibition of RSA provider's refusal or failure to give effect to determinations.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ASIC proposes to conduct an investigation.",
      "cml:conclusionText": "RSA provider must not refuse or fail to give effect to determinations."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-16-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring Trace",
      "cml:logicSummary": "Recurring trace of RSA providers' refusal or failure to give effect to determinations.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ASIC proposes to conduct an investigation.",
      "cml:conclusionText": "RSA provider's refusal or failure to give effect to determinations is a recurring issue."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-16-logic-cogai-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Entity Classification",
      "cml:logicSummary": "Classification of RSA providers as entities that refuse or fail to give effect to determinations.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ASIC proposes to conduct an investigation.",
      "cml:conclusionText": "RSA provider is classified as a non-compliant entity if they refuse or fail to give effect to determinations."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-16-logic-shacl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:SHACL"
      },
      "cml:operator": "Schema Validation",
      "cml:logicSummary": "Validation of RSA providers' refusal or failure to give effect to determinations against schema.",
      "cml:executionSurface": "modalities::logic::shacl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ASIC proposes to conduct an investigation.",
      "cml:conclusionText": "RSA provider's refusal or failure to give effect to determinations is invalid according to schema."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-16-logic-n3logic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:N3Logic"
      },
      "cml:operator": "Ontology Alignment",
      "cml:logicSummary": "Alignment of RSA providers' refusal or failure to give effect to determinations with ontology.",
      "cml:executionSurface": "modalities::logic::n3_compiler",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "ASIC proposes to conduct an investigation.",
      "cml:conclusionText": "RSA provider's refusal or failure to give effect to determinations is aligned with ontology."
    },
