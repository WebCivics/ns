      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.48",
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a statement given to the Commissioner\nby a superannuation provider under section 390-5 in Schedule 1 to the\nTaxation Administration Act 1953, the person may make a complaint\nunder the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001).\nNational Consumer Credit Protection Act 2009",
      "skos:definition": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a statement given to the Commissioner\nby a superannuation provider under section 390-5 in Schedule 1 to the\nTaxation Administration Act 1953, the person may make a complaint\nunder the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001).\nNational Consumer Credit Protection Act 2009",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-46-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-46-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "5dd5ac8aca437c370446b834c86d5c69fe0d3764aa42956e1c563e387e2f6872",
      "skos:note": "Complaint procedure under AFCA scheme for dissatisfied individuals"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-46",
      "@type": "cof:Section",
      "cof:title": "46 Section 292-330 (note)",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a statement given to the Commissioner\nby a superannuation provider under section 390-5 in Schedule 1 to the\nTaxation Administration Act 1953, the person may make a complaint\nunder the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001).\nNational Consumer Credit Protection Act 2009"
    },
