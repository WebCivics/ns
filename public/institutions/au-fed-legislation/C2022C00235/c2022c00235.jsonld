        }
      ],
      "cml:integrityHash": "bec0af4949dd58364a10cdf1a3bf0d2efeb6a5ca3895d3225a1bfa20c4e4d98e",
      "skos:note": "Consideration of material changes to the AFCA scheme"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052d-ss-3",
      "@type": "cof:Section",
