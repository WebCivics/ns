      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "AFCA must give written reasons for its determination of a\nsuperannuation complaint."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1055a-norm",
      "@type": "values:Obligation",
