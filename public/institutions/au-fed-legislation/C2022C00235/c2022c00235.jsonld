    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1051a",
      "@type": "cml:Concept",
      "skos:prefLabel": "1051A General considerations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1051a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
