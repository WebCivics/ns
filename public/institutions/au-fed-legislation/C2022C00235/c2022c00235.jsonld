      "skos:note": "ASIC may revoke a direction to AFCA with written notice if it is no longer necessary or appropriate."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052c-ss-10",
      "@type": "cof:Section",
