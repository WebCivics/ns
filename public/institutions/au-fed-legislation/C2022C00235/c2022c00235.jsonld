        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to provide particulars.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "1052E(2) Referring matters to appropriate authorities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052e-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.20",
      "values:originalText": "(2) However, if:\n\n(a) the complaint relates to the scheme provided for by the\nAustralian Defence Force Cover Act 2015; and\n\n(b) subsection (1) applies because AFCA becomes aware that:\n\n(i) a serious contravention of any law may have occurred;\nor\n\n(ii) a party to the complaint may have refused or failed to\ngive effect to a determination made by AFCA;\nAFCA must instead give particulars of the contravention, refusal or\nfailure to the Minister administering that Act and the Minister\n\nExternal dispute resolution  Schedule 1\nAmendments applying from the day after Royal Assent  Part 1\n\nTreasury Laws Amendment (Putting Consumers First—Establishment of the\nAustralian Financial Complaints Authority) Act 2018\nCompilation date: 10/08/2022\nRegistered: 25/08/2022\n\nadministering the Public Governance, Performance and\nAccountability Act 2013.\nReferring settled complaints",
      "skos:definition": "(2) However, if:\n\n(a) the complaint relates to the scheme provided for by the\nAustralian Defence Force Cover Act 2015; and\n\n(b) subsection (1) applies because AFCA becomes aware that:\n\n(i) a serious contravention of any law may have occurred;\nor\n\n(ii) a party to the complaint may have refused or failed to\ngive effect to a determination made by AFCA;\nAFCA must instead give particulars of the contravention, refusal or\nfailure to the Minister administering that Act and the Minister\n\nExternal dispute resolution  Schedule 1\nAmendments applying from the day after Royal Assent  Part 1\n\nTreasury Laws Amendment (Putting Consumers First—Establishment of the\nAustralian Financial Complaints Authority) Act 2018\nCompilation date: 10/08/2022\nRegistered: 25/08/2022\n\nadministering the Public Governance, Performance and\nAccountability Act 2013.\nReferring settled complaints",
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-1-sec-1052e"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-2-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "05246495767198be7aaa2f666e7435a809ec7d817b7c69bc0cd76692dd4ccee9",
      "skos:note": "Must provide particulars of contravention, refusal or failure to the Minister administering the relevant Act.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052e-ss-2",
      "@type": "cof:Section",
      "cof:title": "1052E(2) Referring matters to appropriate authorities",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(2) However, if:\n\n(a) the complaint relates to the scheme provided for by the\nAustralian Defence Force Cover Act 2015; and\n\n(b) subsection (1) applies because AFCA becomes aware that:\n\n(i) a serious contravention of any law may have occurred;\nor\n\n(ii) a party to the complaint may have refused or failed to\ngive effect to a determination made by AFCA;\nAFCA must instead give particulars of the contravention, refusal or\nfailure to the Minister administering that Act and the Minister\n\nExternal dispute resolution  Schedule 1\nAmendments applying from the day after Royal Assent  Part 1\n\nTreasury Laws Amendment (Putting Consumers First—Establishment of the\nAustralian Financial Complaints Authority) Act 2018\nCompilation date: 10/08/2022\nRegistered: 25/08/2022\n\nadministering the Public Governance, Performance and\nAccountability Act 2013.\nReferring settled complaints"
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
