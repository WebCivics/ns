      },
      "dc:source": "c2022c00235.pdf, p.48",
      "values:originalText": "Repeal the note, substitute:\nNote:\nA person affected by the outcome of the reconsideration of the\ndecision may make a complaint under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001).\nIncome Tax Assessment Act 1997",
      "skos:definition": "Repeal the note, substitute:\nNote:\nA person affected by the outcome of the reconsideration of the\ndecision may make a complaint under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001).\nIncome Tax Assessment Act 1997",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-45-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-45-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b1f03ed2ca8f9bea70adaaccccd4438408d78a5ed29bfd21c6c41e75735eecd4",
      "skos:note": "Repeal note and substitute with new note allowing complaint under AFCA scheme."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Subsection 57(2) (note)",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "Repeal the note, substitute:\nNote:\nA person affected by the outcome of the reconsideration of the\ndecision may make a complaint under the AFCA scheme (within the\nmeaning of Chapter 7 of the Corporations Act 2001).\nIncome Tax Assessment Act 1997"
    },
    {
