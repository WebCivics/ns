      "dc:source": "c2022c00235.pdf, p.8",
      "values:originalText": "(6) The report is not a legislative instrument.\n\nSchedule 1  External dispute resolution",
      "skos:definition": "(6) The report is not a legislative instrument.\n\nSchedule 1  External dispute resolution",
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-3-sec-4-2"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-3-sec-4-2-ss-6-norm"
        }
      ],
      "cml:integrityHash": "9f662003343100f5fbf432668a790dfa1aa7ec5075d01872db99b57951e1c7c1",
      "skos:note": "Review of operation of amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-3-sec-4-2-ss-6",
      "@type": "cof:Section",
