    {
      "@id": "concept:c2022c00235-sch-1-sec-1052ba",
      "@type": "cml:Concept",
      "skos:prefLabel": "1052BA Directions to ensure sufficient financing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052ba"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.17",
      "values:originalText": "(1) ASIC may give AFCA a written direction under this section if\nASIC considers that AFCA has not done all things reasonably\npracticable to ensure that the operations of the AFCA scheme are\nsufficiently financed.\n\n(2) The direction must set out the specific measures that AFCA must\ntake to ensure that the operations of the AFCA scheme are\nsufficiently financed.\n\n(3) ASIC must not give a direction under this section unless ASIC has\ngiven AFCA written notice of at least 1 month of ASIC’s intention\nto issue the direction.\n\nSchedule 1  External dispute resolution",
      "skos:definition": "(1) ASIC may give AFCA a written direction under this section if\nASIC considers that AFCA has not done all things reasonably\npracticable to ensure that the operations of the AFCA scheme are\nsufficiently financed.\n\n(2) The direction must set out the specific measures that AFCA must\ntake to ensure that the operations of the AFCA scheme are\nsufficiently financed.\n\n(3) ASIC must not give a direction under this section unless ASIC has\ngiven AFCA written notice of at least 1 month of ASIC’s intention\nto issue the direction.\n\nSchedule 1  External dispute resolution",
      "cml:hasPart": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052ba-ss-1"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052ba-ss-2"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052ba-ss-3"
        }
      ],
      "cml:integrityHash": "63bdb597e87b691d44dbe66667eeb39e58d49c0f6a7c32c992e2736a81c14dc3"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052ba",
      "@type": "cof:Section",
      "cof:title": "1052BA Directions to ensure sufficient financing",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "(1) ASIC may give AFCA a written direction under this section if\nASIC considers that AFCA has not done all things reasonably\npracticable to ensure that the operations of the AFCA scheme are\nsufficiently financed.\n\n(2) The direction must set out the specific measures that AFCA must\ntake to ensure that the operations of the AFCA scheme are\nsufficiently financed.\n\n(3) ASIC must not give a direction under this section unless ASIC has\ngiven AFCA written notice of at least 1 month of ASIC’s intention\nto issue the direction.\n\nSchedule 1  External dispute resolution"
    },
