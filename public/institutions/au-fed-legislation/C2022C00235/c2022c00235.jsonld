    {
      "@id": "concept:c2022c00235-sch-1-sec-1055a",
      "@type": "cml:Concept",
      "skos:prefLabel": "1055A AFCA to give reasons",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1055a"
      },
      "cml:curationStatus": {
