    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1056a-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "1056A(3) Joining persons to complaints relating to death benefit",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1056a-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.33",
      "values:originalText": "(3) A person (other than a person referred to in any of paragraphs\n1054(1)(b) to (f)) may be joined as a party to the complaint under\nsection 1054 only if:\n\n(a) the person applies in accordance with paragraph (2)(c) of this\nsection; or\n\n(b) AFCA is satisfied that, in all the circumstances, the person\nshould be joined as a party despite not so applying.\nSubdivision E—Appeals to the Federal Court",
      "skos:definition": "(3) A person (other than a person referred to in any of paragraphs\n1054(1)(b) to (f)) may be joined as a party to the complaint under\nsection 1054 only if:\n\n(a) the person applies in accordance with paragraph (2)(c) of this\nsection; or\n\n(b) AFCA is satisfied that, in all the circumstances, the person\nshould be joined as a party despite not so applying.\nSubdivision E—Appeals to the Federal Court",
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-1-sec-1056a"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1056a-ss-3-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1056a-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "c55242a03454736935f152c4c24f1b329b52a2d74ff8d12f05222b378b0d8766",
      "skos:note": "A person may be joined as a party to the complaint under section 1054."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1056a-ss-3",
      "@type": "cof:Section",
      "cof:title": "1056A(3) Joining persons to complaints relating to death benefit",
      "values:kind": "subsection",
      "cof:pageNumber": 33,
      "values:originalText": "(3) A person (other than a person referred to in any of paragraphs\n1054(1)(b) to (f)) may be joined as a party to the complaint under\nsection 1054 only if:\n\n(a) the person applies in accordance with paragraph (2)(c) of this\nsection; or\n\n(b) AFCA is satisfied that, in all the circumstances, the person\nshould be joined as a party despite not so applying.\nSubdivision E—Appeals to the Federal Court"
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1056a-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
