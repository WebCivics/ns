      }
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "1052E(3) Referring matters to appropriate authorities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052e-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.20",
      "values:originalText": "(3) If:\n\n(a) the parties to a complaint made under the AFCA scheme\nagree to a settlement of the complaint; and\n\n(b) AFCA thinks the settlement may require investigation;\nAFCA may give particulars of the settlement to one or more of\nAPRA, ASIC or the Commissioner of Taxation.\nReferring systemic issues",
      "skos:definition": "(3) If:\n\n(a) the parties to a complaint made under the AFCA scheme\nagree to a settlement of the complaint; and\n\n(b) AFCA thinks the settlement may require investigation;\nAFCA may give particulars of the settlement to one or more of\nAPRA, ASIC or the Commissioner of Taxation.\nReferring systemic issues",
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-1-sec-1052e"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-3-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "dc3007e5863bc4b3e196bac5adc58cdbd1d40064f455c6c3032f3ecdba34434e",
      "skos:note": "AFCA may refer systemic issues to APRA, ASIC or the Commissioner of Taxation."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052e-ss-3",
      "@type": "cof:Section",
      "cof:title": "1052E(3) Referring matters to appropriate authorities",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(3) If:\n\n(a) the parties to a complaint made under the AFCA scheme\nagree to a settlement of the complaint; and\n\n(b) AFCA thinks the settlement may require investigation;\nAFCA may give particulars of the settlement to one or more of\nAPRA, ASIC or the Commissioner of Taxation.\nReferring systemic issues"
    },
