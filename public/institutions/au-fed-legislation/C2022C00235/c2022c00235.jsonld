    {
      "@id": "concept:c2022c00235-sch-1-sec-1052a",
      "@type": "cml:Concept",
      "skos:prefLabel": "1052A ASIC may issue regulatory requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.16",
      "values:originalText": "ASIC may, by legislative instrument, issue to AFCA regulatory\nrequirements relating to:\n\n(a) compliance with the mandatory requirements for the AFCA\nscheme under section 1051; or\n\n(b) any of the general considerations for the AFCA scheme\nunder section 1051A.",
      "skos:definition": "ASIC may, by legislative instrument, issue to AFCA regulatory\nrequirements relating to:\n\n(a) compliance with the mandatory requirements for the AFCA\nscheme under section 1051; or\n\n(b) any of the general considerations for the AFCA scheme\nunder section 1051A.",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052a-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "2ab6ac5f9f1500260c00da6c091a4837bad5e098e02aa24b2680af85bd0c7768",
      "skos:note": "ASIC may issue regulatory requirements"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052a",
      "@type": "cof:Section",
      "cof:title": "1052A ASIC may issue regulatory requirements",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "ASIC may, by legislative instrument, issue to AFCA regulatory\nrequirements relating to:\n\n(a) compliance with the mandatory requirements for the AFCA\nscheme under section 1051; or\n\n(b) any of the general considerations for the AFCA scheme\nunder section 1051A."
    },
