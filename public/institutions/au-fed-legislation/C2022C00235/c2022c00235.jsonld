    {
      "@id": "concept:c2022c00235-sch-3-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Subsection 95(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-3-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.62",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1A) If it appears to ASIC that an RSA provider has refused or failed to\ngive effect to a determination made under the AFCA scheme\n(within the meaning of Chapter 7 of the Corporations Act 2001),\nASIC may, by written notice, tell the RSA provider that ASIC\nproposes to conduct an investigation of the whole or a part of the\naffairs of the RSA provider.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1A) If it appears to ASIC that an RSA provider has refused or failed to\ngive effect to a determination made under the AFCA scheme\n(within the meaning of Chapter 7 of the Corporations Act 2001),\nASIC may, by written notice, tell the RSA provider that ASIC\nproposes to conduct an investigation of the whole or a part of the\naffairs of the RSA provider.",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-3-sec-13-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-3-sec-13-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "74a97d78b47c63893d9c7cbaefaaf1c707e79043c62b08fd766c47bd86381323",
      "skos:note": "ASIC may conduct an investigation if RSA provider refuses or fails to give effect to AFCA determination."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-3-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Subsection 95(1A)",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1A) If it appears to ASIC that an RSA provider has refused or failed to\ngive effect to a determination made under the AFCA scheme\n(within the meaning of Chapter 7 of the Corporations Act 2001),\nASIC may, by written notice, tell the RSA provider that ASIC\nproposes to conduct an investigation of the whole or a part of the\naffairs of the RSA provider."
    },
