          "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-4-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9bebdcbc18ed693df760c8a684a83eda954eb4cdc5d8c78a637d7fb6cda608fa",
      "skos:note": "Must provide particulars of systemic issue to one or more authorities.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1052e-ss-4",
      "@type": "cof:Section",
      "cof:title": "1052E(4) Referring matters to appropriate authorities",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(4) If AFCA considers that there is a systemic issue arising from the\nconsideration of complaints under the AFCA scheme, AFCA must\ngive particulars of the issue to one or more of APRA, ASIC or the\nCommissioner of Taxation."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1052e-ss-4-norm",
