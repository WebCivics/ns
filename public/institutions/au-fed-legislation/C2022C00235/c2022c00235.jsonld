      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1055b-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "imposes",
      "cml:logicSummary": "Imposes obligation on the state.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) Subject to subsection (2), a determination of a superannuation complaint by AFCA comes into operation immediately upon the making of the determination.",
      "cml:conclusionText": "The state is obligated to implement the determination."
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1055b-ss-1-logic-alleninterval-2",
