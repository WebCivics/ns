    {
      "@id": "concept:c2022c00235-sch-1-sec-1055d",
      "@type": "cml:Concept",
      "skos:prefLabel": "1055D Compliance with determinations under the AFCA scheme",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1055d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.31",
      "values:originalText": "If:\n\n(a) a superannuation complaint has been made concerning a\ndisability benefit (whether under a contract of insurance or\notherwise); and\n\n(b) a determination is made by AFCA that a person other than a\nmember of the AFCA scheme is responsible for determining\neither or both of the existence and the extent of the disability;\nand\n\n(c) AFCA joins the person under subsection 1054(1) as a party\nto the complaint;\nthe person must comply with any determination made in respect of\nthe person by AFCA.\n\nSchedule 1  External dispute resolution",
      "skos:definition": "If:\n\n(a) a superannuation complaint has been made concerning a\ndisability benefit (whether under a contract of insurance or\notherwise); and\n\n(b) a determination is made by AFCA that a person other than a\nmember of the AFCA scheme is responsible for determining\neither or both of the existence and the extent of the disability;\nand\n\n(c) AFCA joins the person under subsection 1054(1) as a party\nto the complaint;\nthe person must comply with any determination made in respect of\nthe person by AFCA.\n\nSchedule 1  External dispute resolution",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-1055d-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1055d-logic-deontic-1"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1055d-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1055d-logic-ltl-3"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-1055d-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "a79d8a3b2f712f7520c998633576b3676be4cc9e0d5e2806546c6006a473bacf",
      "skos:note": "Must comply with any determination made in respect of the person by AFCA."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1055d",
      "@type": "cof:Section",
      "cof:title": "1055D Compliance with determinations under the AFCA scheme",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "If:\n\n(a) a superannuation complaint has been made concerning a\ndisability benefit (whether under a contract of insurance or\notherwise); and\n\n(b) a determination is made by AFCA that a person other than a\nmember of the AFCA scheme is responsible for determining\neither or both of the existence and the extent of the disability;\nand\n\n(c) AFCA joins the person under subsection 1054(1) as a party\nto the complaint;\nthe person must comply with any determination made in respect of\nthe person by AFCA.\n\nSchedule 1  External dispute resolution"
    },
    {
      "@id": "concept:c2022c00235-sch-1-sec-1055d-norm",
