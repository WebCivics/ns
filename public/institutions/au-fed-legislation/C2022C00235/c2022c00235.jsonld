        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-28-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "6319594351fedb94fefec54ef1d4b17731812b22e5ea92c71958aa3d60d05b6f",
      "skos:note": "Individual may make a complaint under AFCA scheme or Superannuation (Resolution of Complaints) Act 1993"
    },
    {
