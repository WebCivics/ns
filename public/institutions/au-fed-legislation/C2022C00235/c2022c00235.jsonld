    {
      "@id": "concept:c2022c00235-sch-1-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Subsection 133-120(2) in Schedule 1 (note)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.43",
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a notice given to the Commissioner\nunder this subsection, the person may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under section 15CA of the Superannuation (Resolution of\nComplaints) Act 1993, but not on or after the day on or after\nwhich complaints cannot be made because of section 14AB of\nthat Act.",
      "skos:definition": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a notice given to the Commissioner\nunder this subsection, the person may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under section 15CA of the Superannuation (Resolution of\nComplaints) Act 1993, but not on or after the day on or after\nwhich complaints cannot be made because of section 14AB of\nthat Act.",
      "cml:asserts": [
        {
          "@id": "concept:c2022c00235-sch-1-sec-26-norm"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-26-logic-deontic-1"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-26-logic-epistemic-2"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-26-logic-ltl-3"
        },
        {
          "@id": "concept:c2022c00235-sch-1-sec-26-logic-argumentation-4"
        }
      ],
      "cml:integrityHash": "f192966c062acecd5281b2b47e34313c0a293fd20b79e8ce5d01a338476d954b",
      "skos:note": "Dissatisfied person may make complaint under AFCA scheme or Superannuation (Resolution of Complaints) Act 1993"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Subsection 133-120(2) in Schedule 1 (note)",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "Repeal the note, substitute:\nNote:\nIf a person is dissatisfied with a notice given to the Commissioner\nunder this subsection, the person may make a complaint:\n(a) under the AFCA scheme (within the meaning of Chapter 7 of the\nCorporations Act 2001), but not before the authorisation of the\nscheme comes into force; or\n(b) under section 15CA of the Superannuation (Resolution of\nComplaints) Act 1993, but not on or after the day on or after\nwhich complaints cannot be made because of section 14AB of\nthat Act."
    },
