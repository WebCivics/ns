      "skos:note": "AFCA may deal with the complaint as if it had been withdrawn by the complainant."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1054b-ss-3",
      "@type": "cof:Section",
      "cof:title": "1054B(3) Power to require attendance at conciliation conferences",
      "values:kind": "subsection",
      "cof:pageNumber": 26,
      "values:originalText": "(3) If the complainant fails to attend the conference, AFCA may deal\nwith the complaint as if it had been withdrawn by the complainant."
    },
