      },
      "dc:source": "c2022c00235.pdf, p.30",
      "values:originalText": "AFCA must give written reasons for its determination of a\nsuperannuation complaint.",
      "skos:definition": "AFCA must give written reasons for its determination of a\nsuperannuation complaint.",
      "cml:asserts": [
