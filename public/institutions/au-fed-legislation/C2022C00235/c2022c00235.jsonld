        }
      ],
      "cml:integrityHash": "ff2ad78d3f24baa94f0eb14179701f0972b2cb1001377fa26eb79f8ddb92a56c",
      "skos:note": "AFCA must provide written reasons for its determination of a superannuation complaint.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1055a",
      "@type": "cof:Section",
