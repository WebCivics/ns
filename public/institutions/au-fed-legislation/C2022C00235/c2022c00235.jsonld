    {
      "@id": "concept:c2022c00235-sch-1-sec-1050-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "1050(5) Minister may authorise an external dispute resolution scheme",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1050-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
