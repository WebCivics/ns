    {
      "@id": "concept:c2022c00235-sch-1-sec-1054b-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "1054B(4) Power to require attendance at conciliation conferences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2022c00235#sch-1-sec-1054b-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2022c00235.pdf"
      },
      "dc:source": "c2022c00235.pdf, p.26",
      "values:originalText": "(4) A person (other than the complainant) commits an offence if he or\nshe does not attend a conference when required to do so under this\nsection.\nPenalty: 30 penalty units.",
      "skos:definition": "(4) A person (other than the complainant) commits an offence if he or\nshe does not attend a conference when required to do so under this\nsection.\nPenalty: 30 penalty units.",
      "values:partOf": {
        "@id": "concept:c2022c00235-sch-1-sec-1054b"
      },
