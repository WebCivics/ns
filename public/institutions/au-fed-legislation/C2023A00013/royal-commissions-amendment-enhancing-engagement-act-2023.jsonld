      "dc:source": "royal-commissions-amendment-enhancing-engagement-act-2023.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nMain amendments  Part 1\n\nNo. 13, 2023\nRoyal Commissions Amendment (Enhancing Engagement) Act 2023",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nMain amendments  Part 1\n\nNo. 13, 2023\nRoyal Commissions Amendment (Enhancing Engagement) Act 2023",
      "cml:asserts": [
        {
          "@id": "concept:royal-commissions-amendment-enhancing-engagement-act-2023-sec-3-norm"
        }
      ],
      "cml:integrityHash": "8a31120046af08ca9c632d38c17bfe9d7dbe047f5d4a9aeb67008a7c232bcfc0",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-enhancing-engagement-act-2023#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\nMain amendments  Part 1\n\nNo. 13, 2023\nRoyal Commissions Amendment (Enhancing Engagement) Act 2023"
    },
