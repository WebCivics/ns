    {
      "@id": "concept:royal-commissions-amendment-enhancing-engagement-act-2023-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Section 6OA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/royal-commissions-amendment-enhancing-engagement-act-2023#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "royal-commissions-amendment-enhancing-engagement-act-2023.pdf"
      },
      "dc:source": "royal-commissions-amendment-enhancing-engagement-act-2023.pdf, p.7",
      "values:originalText": "Insert:\nDefence and Veteran Suicide Royal Commission means the Royal\nCommission into Defence and Veteran Suicide, issued by the\nGovernor-General by Letters Patent on 8 July 2021 (and including\nany later variations of those Letters Patent).\ndefence member means a member of the Defence Force.\nveteran means a person who has served, or is serving, as a member\nof the Permanent Forces or as a member of the Reserves.",
      "skos:definition": "Insert:\nDefence and Veteran Suicide Royal Commission means the Royal\nCommission into Defence and Veteran Suicide, issued by the\nGovernor-General by Letters Patent on 8 July 2021 (and including\nany later variations of those Letters Patent).\ndefence member means a member of the Defence Force.\nveteran means a person who has served, or is serving, as a member\nof the Permanent Forces or as a member of the Reserves.",
      "cml:asserts": [
        {
