concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-1-sec-214b-ss-4 a cml:Concept ;
    skos:prefLabel "214B(4) Collection, use or disclosure of information"@en ;
    cml:realizedBy doc:sch-1-sec-214b-ss-4 ;
    values:originalText "(4) A VET data system is a computer system used by one or more of the following to collect, store and manage information collected in accordance with the Data Provision Requirements, or any equivalent requirements in a non-referring State:  (a) the Department;  (b) VET Regulators;  (c) State or Territory authorities (other than VET Regulators) that deal with, or have responsibility for, matters relating to VET;  (d) the National Centre for Vocational Education Research;  (e) registered training organisations." ;
    skos:definition "(4) A VET data system is a computer system used by one or more of the following to collect, store and manage information collected in accordance with the Data Provision Requirements, or any equivalent requirements in a non-referring State:  (a) the Department;  (b) VET Regulators;  (c) State or Territory authorities (other than VET Regulators) that deal with, or have responsibility for, matters relating to VET;  (d) the National Centre for Vocational Education Research;  (e) registered training organisations."@en ;
    cml:integrityHash "8ccfe450f703956a75f24f5936fc6b76e3ae906a1176cb3afd82d79f8783bde2" ;
    values:partOf concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-1-sec-214b ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "VET data system must collect, store and manage information" ;
