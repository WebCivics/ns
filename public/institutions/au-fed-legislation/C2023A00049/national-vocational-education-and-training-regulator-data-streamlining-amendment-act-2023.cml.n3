doc:sch-1-sec-214b-ss-1 a cof:Section ;
    cof:title "214B(1) Collection, use or disclosure of information" ;
    values:kind "subsection" ;
    values:originalText "(1) The collection, use or disclosure of information for the purposes of designing, building, operating, maintaining or testing a VET data system in circumstances specified in a legislative instrument under subsection (2) is authorised by this Act." ;
    cof:pageNumber "9"^^xsd:integer .

concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-1-sec-214b-ss-2 a cml:Concept ;
