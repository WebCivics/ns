concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-6-sec-1 a cml:Concept ;
    skos:prefLabel "1 Definitions"@en ;
    cml:realizedBy doc:sch-6-sec-1 ;
    values:originalText "In this Schedule: Amending Act means the National Vocational Education and Training Regulator (Data Streamlining) Amendment Act 2023. commencement time means the time at which Schedule 1 to the Amending Act commences. Principal Act means the National Vocational Education and Training Regulator Act 2011." ;
    skos:definition "In this Schedule: Amending Act means the National Vocational Education and Training Regulator (Data Streamlining) Amendment Act 2023. commencement time means the time at which Schedule 1 to the Amending Act commences. Principal Act means the National Vocational Education and Training Regulator Act 2011."@en ;
    cml:integrityHash "1e769b1d1e5eb4cc1e754584532a87354b68d1c302f13fffd073def4364652d4" ;
    cof:pageNumber "10"^^xsd:integer ;
