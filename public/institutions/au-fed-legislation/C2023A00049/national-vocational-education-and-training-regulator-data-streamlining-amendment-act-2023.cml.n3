concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-1-sec-214b-ss-5 a cml:Concept ;
    skos:prefLabel "214B(5) Collection, use or disclosure of information"@en ;
    cml:realizedBy doc:sch-1-sec-214b-ss-5 ;
    values:originalText "(5) A National VET data system is a VET data system operated and maintained by either of the following, or under contracts to which either of the following is a party:  (a) the Commonwealth;  (b) if a notifiable instrument is in force under subsection (6)— the National Centre for Vocational Education Research.  Schedule 1  Amendments  National Vocational Education and Training Regulator (Data Streamlining) Amendment Act 2023 No. 49, 2023" ;
    skos:definition "(5) A National VET data system is a VET data system operated and maintained by either of the following, or under contracts to which either of the following is a party:  (a) the Commonwealth;  (b) if a notifiable instrument is in force under subsection (6)— the National Centre for Vocational Education Research.  Schedule 1  Amendments  National Vocational Education and Training Regulator (Data Streamlining) Amendment Act 2023 No. 49, 2023"@en ;
    cml:integrityHash "b773a0f9582541767d3624c21273bb3c4405ce6551ebdfc4666d523748347b58" ;
    values:partOf concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-1-sec-214b ;
    cof:pageNumber "9"^^xsd:integer ;
    skos:note "A National VET data system must be operated and maintained by the Commonwealth or under contracts to which neither is a party." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
