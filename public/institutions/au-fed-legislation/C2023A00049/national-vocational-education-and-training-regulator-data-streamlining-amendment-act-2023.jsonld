      "@id": "concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-6-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Saving of Data Provision Requirements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023#sch-6-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
