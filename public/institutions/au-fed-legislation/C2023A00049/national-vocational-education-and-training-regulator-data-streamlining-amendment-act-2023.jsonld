    {
      "@id": "concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 At the end of section 210B",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023#sch-1-sec-8"
