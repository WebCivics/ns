      },
      "prov:wasDerivedFrom": {
        "@id": "national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023.pdf"
      },
      "dc:source": "national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023.pdf, p.10",
      "values:originalText": "The amendments to sections 210A and 210B of the Principal Act made\nby Schedule 1 to the Amending Act apply to the use, disclosure or\nrelease of information on or after the commencement time, regardless of\nwhether the information was collected before, on or after the\ncommencement time.",
      "skos:definition": "The amendments to sections 210A and 210B of the Principal Act made\nby Schedule 1 to the Amending Act apply to the use, disclosure or\nrelease of information on or after the commencement time, regardless of\nwhether the information was collected before, on or after the\ncommencement time.",
      "cml:asserts": [
        {
          "@id": "concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-6-sec-2-norm"
        },
        {
          "@id": "concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-6-sec-2-logic-alleninterval-1"
        }
      ],
      "cml:integrityHash": "5173425b0f8f58908f38ce9e1f9bde09819474dee08872cc77f58e5f9497f92f",
      "skos:note": "Amendments apply to use, disclosure or release of information on or after commencement time."
    },
    {
      "@id": "https://ns.webcivics.net/values/national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023#sch-6-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "The amendments to sections 210A and 210B of the Principal Act made\nby Schedule 1 to the Amending Act apply to the use, disclosure or\nrelease of information on or after the commencement time, regardless of\nwhether the information was collected before, on or after the\ncommencement time."
    },
