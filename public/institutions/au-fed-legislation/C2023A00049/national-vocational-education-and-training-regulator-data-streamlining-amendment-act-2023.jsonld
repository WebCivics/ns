    {
      "@id": "concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-1-sec-214b-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "214B(5) Collection, use or disclosure of information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023#sch-1-sec-214b-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
