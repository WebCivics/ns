    {
      "@id": "concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-6-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023#sch-6-sec-2"
