      },
      "dc:source": "national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023.pdf, p.10",
      "values:originalText": "Requirements made under subsection 187(1) of the Principal Act that\nwere in force immediately before the commencement time continue in\nforce (and may be dealt with) as if they had been made under that\nsubsection as amended by the Amending Act.\n\n\n\nNo. 49, 2023\nNational Vocational Education and Training Regulator (Data\nStreamlining) Amendment Act 2023\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 9 March 2023\nSenate on 24 March 2023]\n\n(23/23)",
      "skos:definition": "Requirements made under subsection 187(1) of the Principal Act that\nwere in force immediately before the commencement time continue in\nforce (and may be dealt with) as if they had been made under that\nsubsection as amended by the Amending Act.\n\n\n\nNo. 49, 2023\nNational Vocational Education and Training Regulator (Data\nStreamlining) Amendment Act 2023\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 9 March 2023\nSenate on 24 March 2023]\n\n(23/23)",
      "cml:asserts": [
        {
          "@id": "concept:national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023-sch-6-sec-3-norm"
        }
      ],
      "cml:integrityHash": "37c6fa646df6453f081e90bdd3606d501499f73bd008c68004522e861225a6a9",
      "skos:note": "Continuation of data provision requirements under amended subsection"
    },
    {
      "@id": "https://ns.webcivics.net/values/national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023#sch-6-sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Saving of Data Provision Requirements",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "Requirements made under subsection 187(1) of the Principal Act that\nwere in force immediately before the commencement time continue in\nforce (and may be dealt with) as if they had been made under that\nsubsection as amended by the Amending Act.\n\n\n\nNo. 49, 2023\nNational Vocational Education and Training Regulator (Data\nStreamlining) Amendment Act 2023\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 9 March 2023\nSenate on 24 March 2023]\n\n(23/23)"
    },
