        }
      ],
      "cml:integrityHash": "e971266edbe9c72432f960b7acdc80a9486fe84795e8076064239bd10a7b73c6",
      "skos:note": "Agreement by Ministerial Council is required for certain requirements."
    },
    {
      "@id": "https://ns.webcivics.net/values/national-vocational-education-and-training-regulator-data-streamlining-amendment-act-2023#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Subsection 187(1)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit “, as agreed by the Ministerial Council”, substitute:\n\nthat:\n\n(a) have been agreed by the Ministerial Council; or\n\n(b) if the Ministerial Council has agreed that a specified kind of\nrequirement may be endorsed by a specified person or body\nby means of a specified procedure in specified circumstances\n(if any)—are of the specified kind and have been endorsed by\nthe specified person or body by means of the specified\nprocedure in the specified circumstances (if any)."
    },
