concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-4-sec-2 a cml:Concept ;
    skos:prefLabel "2 Transitional—appointments"@en ;
    cml:realizedBy doc:sch-4-sec-2 ;
    values:originalText "(1) An appointment: (a) made under paragraph 33(3)(a) of the Criminology Research Act 1971; and (b) in force immediately before the commencement of this item;  Criminology Research Act 1971  Schedule 4  No. 63, 2023 Crimes and Other Legislation Amendment (Omnibus) Act 2023 has effect, from that commencement, as if it had been made for the purposes of paragraph 33(4)(b) of that Act, as amended by this Schedule. (2) An appointment: (a) made under paragraph 33(3)(b) of the Criminology Research Act 1971; and (b) in force immediately before the commencement of this item; has effect, from that commencement, as if it had been made for the purposes of subsection 33(6) of that Act, as amended by this Schedule.  Schedule 5  Obtaining foreign materials  Crimes and Other Legislation Amendment (Omnibus) Act 2023 No. 63, 2023" ;
    skos:definition "(1) An appointment: (a) made under paragraph 33(3)(a) of the Criminology Research Act 1971; and (b) in force immediately before the commencement of this item;  Criminology Research Act 1971  Schedule 4  No. 63, 2023 Crimes and Other Legislation Amendment (Omnibus) Act 2023 has effect, from that commencement, as if it had been made for the purposes of paragraph 33(4)(b) of that Act, as amended by this Schedule. (2) An appointment: (a) made under paragraph 33(3)(b) of the Criminology Research Act 1971; and (b) in force immediately before the commencement of this item; has effect, from that commencement, as if it had been made for the purposes of subsection 33(6) of that Act, as amended by this Schedule.  Schedule 5  Obtaining foreign materials  Crimes and Other Legislation Amendment (Omnibus) Act 2023 No. 63, 2023"@en ;
    cml:integrityHash "58de8a13a9fa8c5c29b4f5cc668049d20aebfab9647068d9786cab91e5e4828a" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Transitional appointments under Criminology Research Act 1971 have effect from commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-and-other-legislation-amendment-omnibus-act-2023.pdf> ;
    dc:source "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf, p.18" ;
