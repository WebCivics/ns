concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-5 a cml:Concept ;
    skos:prefLabel "5 After subsection 126(3)"@en ;
    cml:realizedBy doc:sch-1-sec-5 ;
    values:originalText "Insert: (3A) Subsection (3) does not apply if the AUSTRAC information: (a) was obtained under section 41 (reports of suspicious matters); or (b) was obtained under section 49 (further information to be given to the AUSTRAC CEO etc.), in so far as that section relates to a communication under section 41; or (c) was obtained under section 16 of the Financial Transaction Reports Act 1988 (reports of suspect transactions)." ;
    skos:definition "Insert: (3A) Subsection (3) does not apply if the AUSTRAC information: (a) was obtained under section 41 (reports of suspicious matters); or (b) was obtained under section 49 (further information to be given to the AUSTRAC CEO etc.), in so far as that section relates to a communication under section 41; or (c) was obtained under section 16 of the Financial Transaction Reports Act 1988 (reports of suspect transactions)."@en ;
    cml:integrityHash "8dc78e5e15ed26fce5ccd24c688fbe0e4561bb84faf655d5f40261149ea61b8a" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Exempts AUSTRAC information from subsection (3) under certain conditions." ;
