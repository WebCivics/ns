concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sec-3-2 a cml:Concept ;
    skos:prefLabel "3 Schedules"@en ;
    cml:realizedBy doc:sec-3-2 ;
    values:originalText "Legislation that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule concerned, and any other item in a Schedule to this Act has effect according to its terms.  Schedule 1  Anti-Money Laundering and Counter-Terrorism Financing Act 2006" ;
    skos:definition "Legislation that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule concerned, and any other item in a Schedule to this Act has effect according to its terms.  Schedule 1  Anti-Money Laundering and Counter-Terrorism Financing Act 2006"@en ;
    cml:integrityHash "1dee5c71d44cd208f4d2d956575b921ed1ec12f20751fc28e13594317023997a" ;
    cof:pageNumber "7"^^xsd:integer ;
