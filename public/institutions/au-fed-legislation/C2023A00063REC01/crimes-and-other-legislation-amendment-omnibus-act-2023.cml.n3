doc:sch-9-sec-17a-ss-5 a cof:Section ;
    cof:title "17A(5) Suspension of protection and assistance on request by" ;
    values:kind "subsection" ;
    values:originalText "(5) Subject to subsection (6), protection or assistance must not be provided under the NWPP to a participant while a suspension under this section is in effect for the participant." ;
    cof:pageNumber "28"^^xsd:integer .

concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-9-sec-17a-ss-6 a cml:Concept ;
    skos:prefLabel "17A(6) Suspension of protection and assistance on request by"@en ;
    cml:realizedBy doc:sch-9-sec-17a-ss-6 ;
    values:originalText "(6) However, subsection (5) does not prevent protection or assistance being provided under the NWPP to a participant while a suspension under this section is in effect for the participant if the Commissioner is satisfied that, in the circumstances, it is necessary and reasonable for the protection or assistance to be provided despite the suspension." ;
    skos:definition "(6) However, subsection (5) does not prevent protection or assistance being provided under the NWPP to a participant while a suspension under this section is in effect for the participant if the Commissioner is satisfied that, in the circumstances, it is necessary and reasonable for the protection or assistance to be provided despite the suspension."@en ;
    cml:integrityHash "15e36604afaaffe421ba0c85785fa4dd59ced09e24683fc0a9bb29aa206dc5f9" ;
    values:partOf concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-9-sec-17a ;
    cof:pageNumber "28"^^xsd:integer ;
    skos:note "Protection or assistance can be provided despite a suspension if necessary and reasonable." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
