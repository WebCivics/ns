concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 51B(1)"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Repeal the subsection, substitute: (1) If: (a) a person commences to provide a designated service; and (b) the person’s name is not entered on the Reporting Entities Roll; the person must, no later than 28 days after the day on which the person commences to provide the designated service, apply under subsection 51E(1) for enrolment as a reporting entity." ;
    skos:definition "Repeal the subsection, substitute: (1) If: (a) a person commences to provide a designated service; and (b) the person’s name is not entered on the Reporting Entities Roll; the person must, no later than 28 days after the day on which the person commences to provide the designated service, apply under subsection 51E(1) for enrolment as a reporting entity."@en ;
    cml:integrityHash "92a70b7103282c153980a5ccd53ff7ed26f0b0e00b8d9aa873fe8a980ef649ee" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Must apply for enrolment as a reporting entity within 28 days of providing a designated service." ;
    dc:description "Enrolment application under subsection 51E(1)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-and-other-legislation-amendment-omnibus-act-2023.pdf> ;
    dc:source "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf, p.8" ;
    cml:asserts concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-1-norm .
concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-1-norm a values:Obligation ;
    cml:modality cml:Deontic ;
    values:partOf concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-1 ;
    values:borneBy values:State ;
    skos:scopeNote "borne by: State" ;
    values:deonticStatus values:HeuristicDerived ;
