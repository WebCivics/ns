doc:sch-9-sec-17a-ss-4 a cof:Section ;
    cof:title "17A(4) Suspension of protection and assistance on request by" ;
    values:kind "subsection" ;
    values:originalText "(4) If a participant makes a request under subsection (1), the Commissioner must, as soon as practicable after the request is made: (a) give written notice to the participant of the Commissioner’s decision to suspend, or not to suspend, protection and assistance; and (b) notify the relevant approved authority of that decision. Effect of suspension" ;
    cof:pageNumber "28"^^xsd:integer .

concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-9-sec-17a-ss-5 a cml:Concept ;
    skos:prefLabel "17A(5) Suspension of protection and assistance on request by"@en ;
    cml:realizedBy doc:sch-9-sec-17a-ss-5 ;
