doc:sch-1-sec-2-ss-2c a cof:Section ;
    cof:title "2(2C) After subsection 51B(2)" ;
    values:kind "subsection" ;
    values:originalText "(2C) A person who contravenes subsection (1) by failing to apply for enrolment as a reporting entity by a particular time (the enrolment deadline) is taken to commit a separate contravention of that subsection on each day that occurs: (a) on or after the day on which the enrolment deadline occurs; and (b) on or before the day on which the person’s obligation to apply for enrolment ends (see subsection (2B))." ;
    cof:pageNumber "8"^^xsd:integer .

concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-2-ss-2d a cml:Concept ;
    skos:prefLabel "2(2D) After subsection 51B(2)"@en ;
    cml:realizedBy doc:sch-1-sec-2-ss-2d ;
    values:originalText "(2D) To avoid doubt, a person does not contravene subsection (1) more than once on any particular day, even if the person commences to provide a designated service more than once on a particular day or during a particular period." ;
    skos:definition "(2D) To avoid doubt, a person does not contravene subsection (1) more than once on any particular day, even if the person commences to provide a designated service more than once on a particular day or during a particular period."@en ;
    cml:integrityHash "c4fcdc9649b678ddea9c429d2ae6fcf02357b76396a6afec2b745a76f3b91b72" ;
    values:partOf concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-2 ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Prohibition on repeated contravention of subsection (1) on the same day" ;
    cml:curationStatus cml:Proposed ;
