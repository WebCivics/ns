doc:sch-4-sec-1-ss-3 a cof:Section ;
    cof:title "1(3) Subsections 33(3) and (4)" ;
    values:kind "subsection" ;
    values:originalText "(3) The Advisory Council consists of the following members: (a) a representative of the Commonwealth; (b) a representative of each State, the Australian Capital Territory and the Northern Territory." ;
    cof:pageNumber "18"^^xsd:integer .

concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-4-sec-1-ss-4 a cml:Concept ;
    skos:prefLabel "1(4) Subsections 33(3) and (4)"@en ;
    cml:realizedBy doc:sch-4-sec-1-ss-4 ;
    values:originalText "(4) The representative of the Commonwealth is: (a) if the Minister designates in writing a position in the Department for the purposes of this paragraph—the person for the time being occupying that position; or (b) otherwise—the person appointed by the Minister in writing." ;
