    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sec-3-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Schedules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sec-3-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf, p.7",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Anti-Money Laundering and Counter-Terrorism Financing Act 2006",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Anti-Money Laundering and Counter-Terrorism Financing Act 2006",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "1dee5c71d44cd208f4d2d956575b921ed1ec12f20751fc28e13594317023997a",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sec-3-2",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nSchedule 1  Anti-Money Laundering and Counter-Terrorism Financing Act 2006"
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sec-3-2-norm",
