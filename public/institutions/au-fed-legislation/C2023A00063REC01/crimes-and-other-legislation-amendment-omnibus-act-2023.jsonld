      "cml:integrityHash": "ae4a07296f9ee2bc24b054f544f8fad8791422dd4dabada3dc65cc59e526dc11",
      "skos:note": "Refusal of consent to transfer by Attorney-General prevents application of sections 26-32."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-6-sec-24a-ss-2",
      "@type": "cof:Section",
      "cof:title": "24A(2) Decision by the Attorney-General to refuse consent to transfer",
      "values:kind": "subsection",
      "cof:pageNumber": 23,
      "values:originalText": "(2) Sections 26 to 32 do not apply for the transfer of the prisoner if the\nAttorney-General decides under subsection (1) of this section to\nrefuse consent to the transfer."
    },
