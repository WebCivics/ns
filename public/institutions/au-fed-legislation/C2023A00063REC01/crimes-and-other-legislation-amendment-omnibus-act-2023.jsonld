        }
      ],
      "cml:integrityHash": "15e36604afaaffe421ba0c85785fa4dd59ced09e24683fc0a9bb29aa206dc5f9",
      "skos:note": "Protection or assistance can be provided despite a suspension if necessary and reasonable."
    },
    {
