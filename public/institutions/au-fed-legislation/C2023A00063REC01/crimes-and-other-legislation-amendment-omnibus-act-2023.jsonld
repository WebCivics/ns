    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-10-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsection 5(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-10-sec-12"
      },
      "cml:curationStatus": {
