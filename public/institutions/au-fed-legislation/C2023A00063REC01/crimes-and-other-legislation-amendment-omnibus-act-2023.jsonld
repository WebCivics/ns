    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-5-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Subsection 22(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-5-sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf, p.20",
      "values:originalText": "Repeal the subsection, substitute:\n(2) The testimony must purport to be signed or certified by:\n(a) a judge, magistrate or officer in or of the foreign country\nconcerned; or\n(b) a person who is authorised, by or under a law of the foreign\ncountry concerned, to:\n(i) administer an oath or affirmation; or\n(ii) impose an obligation on the person giving the testimony\nto tell the truth.",
      "skos:definition": "Repeal the subsection, substitute:\n(2) The testimony must purport to be signed or certified by:\n(a) a judge, magistrate or officer in or of the foreign country\nconcerned; or\n(b) a person who is authorised, by or under a law of the foreign\ncountry concerned, to:\n(i) administer an oath or affirmation; or\n(ii) impose an obligation on the person giving the testimony\nto tell the truth.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-5-sec-4-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-5-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a45afc3e69775998b9ff3617f5f869b1402fc68a41e1191de8a806a9a3ca3b38",
      "skos:note": "Testimony must be signed or certified by a judge, magistrate, or officer in the foreign country concerned."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-5-sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Subsection 22(2)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Repeal the subsection, substitute:\n(2) The testimony must purport to be signed or certified by:\n(a) a judge, magistrate or officer in or of the foreign country\nconcerned; or\n(b) a person who is authorised, by or under a law of the foreign\ncountry concerned, to:\n(i) administer an oath or affirmation; or\n(ii) impose an obligation on the person giving the testimony\nto tell the truth."
    },
