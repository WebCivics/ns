        }
      ],
      "cml:integrityHash": "8dc78e5e15ed26fce5ccd24c688fbe0e4561bb84faf655d5f40261149ea61b8a",
      "skos:note": "Exempts AUSTRAC information from subsection (3) under certain conditions."
    },
    {
