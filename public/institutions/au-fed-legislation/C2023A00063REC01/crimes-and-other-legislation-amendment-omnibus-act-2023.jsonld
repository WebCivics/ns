      "@type": "cml:Concept",
      "skos:prefLabel": "14 September",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sec-14-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
