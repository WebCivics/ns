    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-4-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Transitional—appointments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-4-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf, p.18",
      "values:originalText": "(1)\nAn appointment:\n(a) made under paragraph 33(3)(a) of the Criminology Research\nAct 1971; and\n(b) in force immediately before the commencement of this item;\n\nCriminology Research Act 1971  Schedule 4\n\nNo. 63, 2023\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nhas effect, from that commencement, as if it had been made for the\npurposes of paragraph 33(4)(b) of that Act, as amended by this\nSchedule.\n(2)\nAn appointment:\n(a) made under paragraph 33(3)(b) of the Criminology Research\nAct 1971; and\n(b) in force immediately before the commencement of this item;\nhas effect, from that commencement, as if it had been made for the\npurposes of subsection 33(6) of that Act, as amended by this\nSchedule.\n\nSchedule 5  Obtaining foreign materials\n\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nNo. 63, 2023",
      "skos:definition": "(1)\nAn appointment:\n(a) made under paragraph 33(3)(a) of the Criminology Research\nAct 1971; and\n(b) in force immediately before the commencement of this item;\n\nCriminology Research Act 1971  Schedule 4\n\nNo. 63, 2023\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nhas effect, from that commencement, as if it had been made for the\npurposes of paragraph 33(4)(b) of that Act, as amended by this\nSchedule.\n(2)\nAn appointment:\n(a) made under paragraph 33(3)(b) of the Criminology Research\nAct 1971; and\n(b) in force immediately before the commencement of this item;\nhas effect, from that commencement, as if it had been made for the\npurposes of subsection 33(6) of that Act, as amended by this\nSchedule.\n\nSchedule 5  Obtaining foreign materials\n\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nNo. 63, 2023",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-4-sec-2-norm"
        }
      ],
      "cml:integrityHash": "58de8a13a9fa8c5c29b4f5cc668049d20aebfab9647068d9786cab91e5e4828a",
      "skos:note": "Transitional appointments under Criminology Research Act 1971 have effect from commencement."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-4-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Transitional—appointments",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "(1)\nAn appointment:\n(a) made under paragraph 33(3)(a) of the Criminology Research\nAct 1971; and\n(b) in force immediately before the commencement of this item;\n\nCriminology Research Act 1971  Schedule 4\n\nNo. 63, 2023\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nhas effect, from that commencement, as if it had been made for the\npurposes of paragraph 33(4)(b) of that Act, as amended by this\nSchedule.\n(2)\nAn appointment:\n(a) made under paragraph 33(3)(b) of the Criminology Research\nAct 1971; and\n(b) in force immediately before the commencement of this item;\nhas effect, from that commencement, as if it had been made for the\npurposes of subsection 33(6) of that Act, as amended by this\nSchedule.\n\nSchedule 5  Obtaining foreign materials\n\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nNo. 63, 2023"
    },
