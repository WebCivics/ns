      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf, p.36",
      "values:originalText": "Insert:\nIndependent Commission Against Corruption (SA) means the\nIndependent Commission Against Corruption of South Australia.\n\nAmendments relating to the South Australian Independent Commission Against\nCorruption  Schedule 10\n\nNo. 63, 2023\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nIndependent Commission Against Corruption Act (SA) means the\nIndependent Commission Against Corruption Act 2012 (SA).",
      "skos:definition": "Insert:\nIndependent Commission Against Corruption (SA) means the\nIndependent Commission Against Corruption of South Australia.\n\nAmendments relating to the South Australian Independent Commission Against\nCorruption  Schedule 10\n\nNo. 63, 2023\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nIndependent Commission Against Corruption Act (SA) means the\nIndependent Commission Against Corruption Act 2012 (SA).",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-10-sec-12-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-10-sec-12-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-10-sec-12-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "df5f17c57ab2ebbc7322cf5eb2f810418e8549a54be8634ff5bda24fc65838c8",
      "skos:note": "Definition of Independent Commission Against Corruption (SA)"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-10-sec-12",
      "@type": "cof:Section",
      "cof:title": "12 Subsection 5(1)",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "Insert:\nIndependent Commission Against Corruption (SA) means the\nIndependent Commission Against Corruption of South Australia.\n\nAmendments relating to the South Australian Independent Commission Against\nCorruption  Schedule 10\n\nNo. 63, 2023\nCrimes and Other Legislation Amendment (Omnibus) Act 2023\nIndependent Commission Against Corruption Act (SA) means the\nIndependent Commission Against Corruption Act 2012 (SA)."
    },
