    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-6-sec-33a",
      "@type": "cml:Concept",
      "skos:prefLabel": "33A Decision by the Attorney-General to refuse consent to transfer",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-6-sec-33a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
