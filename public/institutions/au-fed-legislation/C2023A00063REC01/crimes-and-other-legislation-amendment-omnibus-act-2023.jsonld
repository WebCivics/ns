    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-228a",
      "@type": "cml:Concept",
      "skos:prefLabel": "228A AUSTRAC CEO may use computers to take administrative",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-1-sec-228a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-omnibus-act-2023.pdf, p.11",
      "values:originalText": "action\n(1) The AUSTRAC CEO may, in writing, arrange for the use, under\nthe AUSTRAC CEO’s control, of computer programs for any\npurposes for which the AUSTRAC CEO may or must take\nadministrative action under a provision prescribed by the\nAML/CTF Rules for the purposes of this subsection.\n\nSchedule 1  Anti-Money Laundering and Counter-Terrorism Financing Act 2006",
      "skos:definition": "action\n(1) The AUSTRAC CEO may, in writing, arrange for the use, under\nthe AUSTRAC CEO’s control, of computer programs for any\npurposes for which the AUSTRAC CEO may or must take\nadministrative action under a provision prescribed by the\nAML/CTF Rules for the purposes of this subsection.\n\nSchedule 1  Anti-Money Laundering and Counter-Terrorism Financing Act 2006",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-228a-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-act-2023-sch-1-sec-228a-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a253aae7f3e198358ea08f49be0818e4bd333aa94768775fd59d0c54a4ebc853",
      "skos:note": "AUSTRAC CEO may use computers to take administrative action under the AUSTRAC CEO's control."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus-act-2023#sch-1-sec-228a",
      "@type": "cof:Section",
      "cof:title": "228A AUSTRAC CEO may use computers to take administrative",
      "values:kind": "section",
      "cof:pageNumber": 11,
      "values:originalText": "action\n(1) The AUSTRAC CEO may, in writing, arrange for the use, under\nthe AUSTRAC CEO’s control, of computer programs for any\npurposes for which the AUSTRAC CEO may or must take\nadministrative action under a provision prescribed by the\nAML/CTF Rules for the purposes of this subsection.\n\nSchedule 1  Anti-Money Laundering and Counter-Terrorism Financing Act 2006"
    },
