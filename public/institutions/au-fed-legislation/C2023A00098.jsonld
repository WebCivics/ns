      "cml:operator": "validates",
      "cml:premiseText": "Legal proceedings include any proceedings before a court or tribunal, and include proceedings that are pending or concluded."
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The thing done is valid and effective for all purposes if it relates to federally relevant criminal activity within the meaning of the ACC Act.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Applies to federally relevant criminal activity within the meaning of the ACC Act",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "appliesTo",
      "cml:premiseText": "The thing done relates to federally relevant criminal activity within the meaning of the ACC Act as in force at the time when the authorization was given or the determination was made."
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The thing done is always valid and effective.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Always applies",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "always",
      "cml:premiseText": "The thing done is as valid and effective, and is taken for all purposes always to have been as valid and effective."
    },
