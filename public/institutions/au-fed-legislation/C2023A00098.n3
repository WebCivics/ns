    cml:modality cml:Deontic ;
    cml:operator "validates" ;
    cml:logicSummary "Validations for acquisitions of property" ;
    cml:premiseText "If the operation of this item would result in an acquisition of property from a person otherwise than on just terms." ;
    cml:conclusionText "The Commonwealth is liable to pay a reasonable amount of compensation to the person." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
