concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "validates" ;
    cml:logicSummary "Validations for authorizations and determinations" ;
    cml:premiseText "The Board of the Australian Crime Commission gave an authorization or made a determination." ;
    cml:conclusionText "The thing done is as valid and effective, and is taken for all purposes always to have been as valid and effective." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1 cml:asserts concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1-logic-descriptionlogic-2 .
concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1-logic-descriptionlogic-2 a cml:LogicApplication ;
    cml:modality cml:DescriptionLogic ;
    cml:operator "appliesTo" ;
    cml:logicSummary "Applies to federally relevant criminal activity within the meaning of the ACC Act" ;
    cml:premiseText "The thing done relates to federally relevant criminal activity within the meaning of the ACC Act as in force at the time when the authorization was given or the determination was made." ;
    cml:conclusionText "The thing done is valid and effective for all purposes if it relates to federally relevant criminal activity within the meaning of the ACC Act." ;
    cml:executionSurface "modalities::dl" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1 cml:asserts concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1-logic-alleninterval-3 .
concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator "within" ;
    cml:logicSummary "Within a specific time period" ;
    cml:premiseText "The authorization or determination was given on or after 4 September 2013 and before 10 December 2022." ;
    cml:conclusionText "The thing done is valid and effective within the specified time period." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "0.5000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1 cml:asserts concept:crimes-and-other-legislation-amendment-omnibus-sch-3-sec-1-logic-ltl-4 .
