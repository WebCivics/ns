concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-1 a cml:Concept ;
    skos:prefLabel "1 Subsection 16(1) (definition of parole order)"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Omit “subsection 19AL(1) or (2)”, substitute “subsection 19AL(1) or (1A), paragraph 19AL(2)(b) or subsection 19AL(2A), (6) or (7)”." ;
