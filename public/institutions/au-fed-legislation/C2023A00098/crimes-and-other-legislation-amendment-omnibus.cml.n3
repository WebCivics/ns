doc:sch-1-sec-1 a cof:Section ;
    cof:title "1 Subsection 16(1) (definition of parole order)" ;
    values:kind "section" ;
    values:originalText "Omit “subsection 19AL(1) or (2)”, substitute “subsection 19AL(1) or (1A), paragraph 19AL(2)(b) or subsection 19AL(2A), (6) or (7)”." ;
    cof:pageNumber "7"^^xsd:integer .

concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-2 a cml:Concept ;
    skos:prefLabel "2 After subsection 19AL(1)"@en ;
    cml:realizedBy doc:sch-1-sec-2 ;
    values:originalText "Insert:  (1A) If the Attorney-General does not, under subsection (1), make, or refuse to make, a parole order for a person before the end of the non-parole period referred to in that subsection, the Attorney-General must, as soon as practicable after the end of that period, make, or refuse to make, a parole order for the person." ;
    skos:definition "Insert:  (1A) If the Attorney-General does not, under subsection (1), make, or refuse to make, a parole order for a person before the end of the non-parole period referred to in that subsection, the Attorney-General must, as soon as practicable after the end of that period, make, or refuse to make, a parole order for the person."@en ;
    cml:integrityHash "1e9dfdb3d176119a4f12647b0afc074514a215d14bd442a71f839ad24f6045f3" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Attorney-General must make parole order after non-parole period ends." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
