      "dc:source": "crimes-and-other-legislation-amendment-omnibus.pdf, p.7",
      "values:originalText": "Insert:\n\n(1A) If the Attorney-General does not, under subsection (1), make, or\nrefuse to make, a parole order for a person before the end of the\nnon-parole period referred to in that subsection, the\nAttorney-General must, as soon as practicable after the end of that\nperiod, make, or refuse to make, a parole order for the person.",
      "skos:definition": "Insert:\n\n(1A) If the Attorney-General does not, under subsection (1), make, or\nrefuse to make, a parole order for a person before the end of the\nnon-parole period referred to in that subsection, the\nAttorney-General must, as soon as practicable after the end of that\nperiod, make, or refuse to make, a parole order for the person.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-2-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1e9dfdb3d176119a4f12647b0afc074514a215d14bd442a71f839ad24f6045f3",
      "skos:note": "Attorney-General must make parole order after non-parole period ends."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 After subsection 19AL(1)",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Insert:\n\n(1A) If the Attorney-General does not, under subsection (1), make, or\nrefuse to make, a parole order for a person before the end of the\nnon-parole period referred to in that subsection, the\nAttorney-General must, as soon as practicable after the end of that\nperiod, make, or refuse to make, a parole order for the person."
    },
