      }
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Subsection 51A(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus#sch-2-sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-omnibus.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-omnibus.pdf, p.13",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) This section applies if a substance or plant is a border controlled\ndrug, a border controlled plant or a border controlled precursor\nbecause of a determination made under Subdivision C of\nDivision 301 of the Criminal Code (which deals with emergency\nMinisterial determinations of serious drugs and precursors).\nNote:\nBorder controlled drug, border controlled plant and border\ncontrolled precursor have the same meaning as in Part 9.1 of the\nCriminal Code (see subsection 4(1) of this Act). In that Part, those\nterms include substances or plants that are, under Subdivision C of\nDivision 301 of the Criminal Code, taken, for the purposes of the Part,\nto be border controlled drugs, border controlled plants or border\ncontrolled precursors only in relation to particular offences against the\nPart, or particular elements of those offences.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) This section applies if a substance or plant is a border controlled\ndrug, a border controlled plant or a border controlled precursor\nbecause of a determination made under Subdivision C of\nDivision 301 of the Criminal Code (which deals with emergency\nMinisterial determinations of serious drugs and precursors).\nNote:\nBorder controlled drug, border controlled plant and border\ncontrolled precursor have the same meaning as in Part 9.1 of the\nCriminal Code (see subsection 4(1) of this Act). In that Part, those\nterms include substances or plants that are, under Subdivision C of\nDivision 301 of the Criminal Code, taken, for the purposes of the Part,\nto be border controlled drugs, border controlled plants or border\ncontrolled precursors only in relation to particular offences against the\nPart, or particular elements of those offences.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-logic-alleninterval-2"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-logic-argumentation-3"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-logic-diffusion-4"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "5ab9556b82a950e35527642363b1b30138ef4f52caa1ae6ae54ef69d68bcbde9",
      "skos:note": "Repeal subsection, substitute with new provision for border controlled substances and plants."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus#sch-2-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Subsection 51A(1)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) This section applies if a substance or plant is a border controlled\ndrug, a border controlled plant or a border controlled precursor\nbecause of a determination made under Subdivision C of\nDivision 301 of the Criminal Code (which deals with emergency\nMinisterial determinations of serious drugs and precursors).\nNote:\nBorder controlled drug, border controlled plant and border\ncontrolled precursor have the same meaning as in Part 9.1 of the\nCriminal Code (see subsection 4(1) of this Act). In that Part, those\nterms include substances or plants that are, under Subdivision C of\nDivision 301 of the Criminal Code, taken, for the purposes of the Part,\nto be border controlled drugs, border controlled plants or border\ncontrolled precursors only in relation to particular offences against the\nPart, or particular elements of those offences."
    },
