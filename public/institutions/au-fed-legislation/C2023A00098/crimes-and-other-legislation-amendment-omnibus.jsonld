      "@type": "cml:Concept",
      "skos:prefLabel": "1 Section 300.2 of the Criminal Code (definition of border",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus#sch-2-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
