    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Subsection 112A(1)",
      "cml:realizedBy": {
