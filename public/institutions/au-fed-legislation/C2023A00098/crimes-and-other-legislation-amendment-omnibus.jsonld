      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-omnibus.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-omnibus.pdf, p.12",
      "values:originalText": "Insert:\n\n(1A) However:\n\nBorder controlled drugs, plants and precursors  Schedule 2\n\nNo. 98, 2023\nCrimes and Other Legislation Amendment (Omnibus No. 2) Act 2023\n\n(a) a determination made under subsection (1) may provide that\na determined border controlled precursor is taken, for the\npurposes of this Part, to be a border controlled precursor only\nin relation to particular offences against this Part, or\nparticular elements of those offences; and\n\n(b) if such a determination so provides, then the determined\nborder controlled precursor is taken, for the purposes of this\nPart, to be a border controlled precursor only in relation to\nthose offences or elements.\nConditions on making a determination\nCustoms Act 1901",
      "skos:definition": "Insert:\n\n(1A) However:\n\nBorder controlled drugs, plants and precursors  Schedule 2\n\nNo. 98, 2023\nCrimes and Other Legislation Amendment (Omnibus No. 2) Act 2023\n\n(a) a determination made under subsection (1) may provide that\na determined border controlled precursor is taken, for the\npurposes of this Part, to be a border controlled precursor only\nin relation to particular offences against this Part, or\nparticular elements of those offences; and\n\n(b) if such a determination so provides, then the determined\nborder controlled precursor is taken, for the purposes of this\nPart, to be a border controlled precursor only in relation to\nthose offences or elements.\nConditions on making a determination\nCustoms Act 1901",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-17-norm"
        }
      ],
      "cml:integrityHash": "56acd7b7c1e7cac8de81b4e8eeea6fdc48b0a484694250c915286df6a1a9d21c",
      "skos:note": "Customs Act 1901: Conditions on making a determination"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus#sch-2-sec-17",
      "@type": "cof:Section",
      "cof:title": "17 After subsection 301.14(1) of the Criminal Code",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Insert:\n\n(1A) However:\n\nBorder controlled drugs, plants and precursors  Schedule 2\n\nNo. 98, 2023\nCrimes and Other Legislation Amendment (Omnibus No. 2) Act 2023\n\n(a) a determination made under subsection (1) may provide that\na determined border controlled precursor is taken, for the\npurposes of this Part, to be a border controlled precursor only\nin relation to particular offences against this Part, or\nparticular elements of those offences; and\n\n(b) if such a determination so provides, then the determined\nborder controlled precursor is taken, for the purposes of this\nPart, to be a border controlled precursor only in relation to\nthose offences or elements.\nConditions on making a determination\nCustoms Act 1901"
    },
