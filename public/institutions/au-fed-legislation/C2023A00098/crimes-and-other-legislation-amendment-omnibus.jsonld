      },
      "cml:premiseText": "Repeal must occur before new provision can take effect.",
      "cml:conclusionText": "New provision takes effect after repeal."
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Justifies the necessity of substitution in place of repeal.",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Repeal would lead to a gap in regulation.",
      "cml:conclusionText": "Substitution fills this gap."
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
