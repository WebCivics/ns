    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-17",
      "@type": "cml:Concept",
      "skos:prefLabel": "17 After subsection 301.14(1) of the Criminal Code",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus#sch-2-sec-17"
      },
      "cml:curationStatus": {
