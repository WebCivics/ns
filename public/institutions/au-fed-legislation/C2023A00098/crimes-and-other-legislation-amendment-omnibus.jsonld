      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "New provision applies to all border controlled substances and plants.",
      "cml:conclusionText": "New provision supersedes old one in all cases."
    },
    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-18-logic-cogai-5",
