      "dc:source": "crimes-and-other-legislation-amendment-omnibus.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nRelease on parole  Schedule 1\n\nNo. 98, 2023\nCrimes and Other Legislation Amendment (Omnibus No. 2) Act 2023",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nRelease on parole  Schedule 1\n\nNo. 98, 2023\nCrimes and Other Legislation Amendment (Omnibus No. 2) Act 2023",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sec-3-norm"
        }
      ],
      "cml:integrityHash": "877f8b81eca158a64c14bbf2cd14e5790083f7b45ce30a55b2c61a29bbd8c023",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus#sec-3",
      "@type": "cof:Section",
      "cof:title": "3 Schedules",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nRelease on parole  Schedule 1\n\nNo. 98, 2023\nCrimes and Other Legislation Amendment (Omnibus No. 2) Act 2023"
    },
