      "dc:source": "crimes-and-other-legislation-amendment-omnibus.pdf, p.7",
      "values:originalText": "Insert:\n\n(2A) If the Attorney-General does not, under paragraph (2)(b),\nreconsider the making of a parole order for a person and either\nmake, or refuse to make, such an order before the end of the 12\nmonth period referred to in that paragraph, the Attorney-General\nmust, as soon as practicable after the end of that period, reconsider\nand either make, or refuse to make, a parole order for the person.\nContents of parole order",
      "skos:definition": "Insert:\n\n(2A) If the Attorney-General does not, under paragraph (2)(b),\nreconsider the making of a parole order for a person and either\nmake, or refuse to make, such an order before the end of the 12\nmonth period referred to in that paragraph, the Attorney-General\nmust, as soon as practicable after the end of that period, reconsider\nand either make, or refuse to make, a parole order for the person.\nContents of parole order",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-4-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-4-logic-deontic-1"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-4-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "7a8444fb9f3dfbb18340612a847ad777e7009abb9f798606c5e2effcbfac6645",
      "skos:note": "The Attorney-General must reconsider and make a parole order for a person if not done within 12 months."
    },
