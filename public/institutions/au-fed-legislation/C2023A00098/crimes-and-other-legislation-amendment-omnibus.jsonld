      "dc:source": "crimes-and-other-legislation-amendment-omnibus.pdf, p.8",
      "values:originalText": "The amendments made by this Schedule apply in relation to a\nnon-parole period fixed before, on or after the commencement of this\nSchedule, whether or not that non-parole period ended before that\ncommencement.\n\nBorder controlled drugs, plants and precursors  Schedule 2\n\nNo. 98, 2023\nCrimes and Other Legislation Amendment (Omnibus No. 2) Act 2023",
      "skos:definition": "The amendments made by this Schedule apply in relation to a\nnon-parole period fixed before, on or after the commencement of this\nSchedule, whether or not that non-parole period ended before that\ncommencement.\n\nBorder controlled drugs, plants and precursors  Schedule 2\n\nNo. 98, 2023\nCrimes and Other Legislation Amendment (Omnibus No. 2) Act 2023",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-10-norm"
        }
      ],
      "cml:integrityHash": "d019cae541656d383afe897097cb0021eef7c8815601f161f008535607337d6b",
      "skos:note": "Amendments apply to non-parole periods fixed before, on or after commencement."
    },
