    {
      "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Subsection 112A(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-and-other-legislation-amendment-omnibus#sch-2-sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-and-other-legislation-amendment-omnibus.pdf"
      },
      "dc:source": "crimes-and-other-legislation-amendment-omnibus.pdf, p.14",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) Subsection (4) applies if a substance is a border controlled\nprecursor because of a determination made under section 301.14 of\nthe Criminal Code (which deals with emergency Ministerial\ndeterminations of serious drug precursors).\nNote:\nBorder controlled precursor has the same meaning as in Part 9.1 of\nthe Criminal Code (see subsection 4(1) of this Act). In that Part, that\nterm includes substances that are, under section 301.14 of the\nCriminal Code, taken, for the purposes of the Part, to be border\ncontrolled precursors only in relation to particular offences against the\nPart, or particular elements of those offences.\nDefence Force Discipline Act 1982",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) Subsection (4) applies if a substance is a border controlled\nprecursor because of a determination made under section 301.14 of\nthe Criminal Code (which deals with emergency Ministerial\ndeterminations of serious drug precursors).\nNote:\nBorder controlled precursor has the same meaning as in Part 9.1 of\nthe Criminal Code (see subsection 4(1) of this Act). In that Part, that\nterm includes substances that are, under section 301.14 of the\nCriminal Code, taken, for the purposes of the Part, to be border\ncontrolled precursors only in relation to particular offences against the\nPart, or particular elements of those offences.\nDefence Force Discipline Act 1982",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-2-sec-20-norm"
        }
      ],
      "cml:integrityHash": "646843ed6d9e675b43add4b1be3a9b66a30e95bf7fdf2311808bc5d6aa6b3336",
      "skos:note": "Repeal subsection, substitute with new provision"
    },
