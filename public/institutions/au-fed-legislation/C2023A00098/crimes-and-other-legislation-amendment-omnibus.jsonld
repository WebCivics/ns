      "dc:source": "crimes-and-other-legislation-amendment-omnibus.pdf, p.8",
      "values:originalText": "Insert:\n\n(7) If the Attorney-General does not, in accordance with\nsubsection (6), make, or refuse to make, a parole order for a person\nbefore:\n\n(a) the end of the period referred to in paragraph (6)(a); or\n\n(b) the date of the expected release referred to in\nparagraph (6)(b);\nthe Attorney-General must, as soon as practicable after the end of\nthat period or the date of that expected release, make, or refuse to\nmake, a parole order for the person.",
      "skos:definition": "Insert:\n\n(7) If the Attorney-General does not, in accordance with\nsubsection (6), make, or refuse to make, a parole order for a person\nbefore:\n\n(a) the end of the period referred to in paragraph (6)(a); or\n\n(b) the date of the expected release referred to in\nparagraph (6)(b);\nthe Attorney-General must, as soon as practicable after the end of\nthat period or the date of that expected release, make, or refuse to\nmake, a parole order for the person.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-7-norm"
        },
        {
          "@id": "concept:crimes-and-other-legislation-amendment-omnibus-sch-1-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ef4dd8f732ed66c7305a2fca4735b2d219d2f250a67f0813fa99445f1a93a5a6",
      "skos:note": "The Attorney-General must make a parole order for a person within a certain period."
    },
