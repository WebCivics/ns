    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits ceasing to be an Australian citizen if convicted of serious offence and sentenced to at least 3 years imprisonment." ;
    cml:premiseText "(a) a person is convicted of one or more serious offences; (b) the court has decided to impose on the person, in respect of the conviction or convictions, a period of imprisonment that is at least 3 years or periods of imprisonment that total at least 3 years;" ;
    cml:conclusionText "the court may, when imposing such a period or periods of imprisonment on the person in respect of the conviction or convictions, also order at that time as part of the sentence or sentences that the person ceases to be an Australian citizen." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


