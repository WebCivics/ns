    {
      "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Subsection 51B(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf, p.13",
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) As soon as practicable after a reporting period ends, the Minister\nmust table a report in each House of the Parliament that sets out the\nnumber of applications made under section 36D to which both of\nthe following apply:\n\n(a) the applications were made during the reporting period to\nwhich the report relates or during an earlier reporting period;\n\n(b) the applications relate to persons who, during the reporting\nperiod to which the report relates, were convicted and\nsentenced for one or more serious offences.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(1) As soon as practicable after a reporting period ends, the Minister\nmust table a report in each House of the Parliament that sets out the\nnumber of applications made under section 36D to which both of\nthe following apply:\n\n(a) the applications were made during the reporting period to\nwhich the report relates or during an earlier reporting period;\n\n(b) the applications relate to persons who, during the reporting\nperiod to which the report relates, were convicted and\nsentenced for one or more serious offences.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-7-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f02bd0ad0709c9ef238a187a0cdffec750c6d1b7606bfeb3b72c81f9db9501bf",
      "skos:note": "Must table a report in each House of the Parliament"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-7",
      "@type": "cof:Section",
      "cof:title": "7 Subsection 51B(1)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the subsection, substitute:\n\n(1) As soon as practicable after a reporting period ends, the Minister\nmust table a report in each House of the Parliament that sets out the\nnumber of applications made under section 36D to which both of\nthe following apply:\n\n(a) the applications were made during the reporting period to\nwhich the report relates or during an earlier reporting period;\n\n(b) the applications relate to persons who, during the reporting\nperiod to which the report relates, were convicted and\nsentenced for one or more serious offences."
    },
