    {
      "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Section 32A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf, p.7",
      "values:originalText": "Omit:\n•\nfor certain conduct or convictions, the Minister can make a\ndetermination ceasing your citizenship if the Minister is\nsatisfied you have repudiated your allegiance to Australia and\nthat it would be contrary to the public interest for you to\nremain an Australia citizen: see Subdivision C (citizenship\ncessation determinations).\nsubstitute:\n•\nif you are convicted of certain offences and an order is made\nby a court that you cease to be an Australian citizen: see\nSubdivision C (citizenship cessation).",
      "skos:definition": "Omit:\n•\nfor certain conduct or convictions, the Minister can make a\ndetermination ceasing your citizenship if the Minister is\nsatisfied you have repudiated your allegiance to Australia and\nthat it would be contrary to the public interest for you to\nremain an Australia citizen: see Subdivision C (citizenship\ncessation determinations).\nsubstitute:\n•\nif you are convicted of certain offences and an order is made\nby a court that you cease to be an Australian citizen: see\nSubdivision C (citizenship cessation).",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-2-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "557dc0343e3c35d5bc4d9d4109aa95203521354b51ef93765d4a37b762f439e8",
      "skos:note": "Ceasing citizenship for repudiation of allegiance and public interest."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Section 32A",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "Omit:\n•\nfor certain conduct or convictions, the Minister can make a\ndetermination ceasing your citizenship if the Minister is\nsatisfied you have repudiated your allegiance to Australia and\nthat it would be contrary to the public interest for you to\nremain an Australia citizen: see Subdivision C (citizenship\ncessation determinations).\nsubstitute:\n•\nif you are convicted of certain offences and an order is made\nby a court that you cease to be an Australian citizen: see\nSubdivision C (citizenship cessation)."
    },
