      }
    },
    {
      "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Subsection 51B(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf, p.13",
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) In this section:\nreporting period means:\n\n(a) the period of 12 months beginning on the day the Australian\nCitizenship Amendment (Citizenship Repudiation) Act 2023\ncommences; or\n\n(b) each subsequent 12-month period.",
      "skos:definition": "Repeal the subsection, substitute:\n\n(3) In this section:\nreporting period means:\n\n(a) the period of 12 months beginning on the day the Australian\nCitizenship Amendment (Citizenship Repudiation) Act 2023\ncommences; or\n\n(b) each subsequent 12-month period.",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-8-norm"
        }
      ],
      "cml:integrityHash": "607cbc5b3c04c9d344cd24cb362da60d305f21657b23ff460b932c6b5da798f5",
      "skos:note": "Repeal subsection and substitute with new definition of reporting period."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Subsection 51B(3)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the subsection, substitute:\n\n(3) In this section:\nreporting period means:\n\n(a) the period of 12 months beginning on the day the Australian\nCitizenship Amendment (Citizenship Repudiation) Act 2023\ncommences; or\n\n(b) each subsequent 12-month period."
    },
