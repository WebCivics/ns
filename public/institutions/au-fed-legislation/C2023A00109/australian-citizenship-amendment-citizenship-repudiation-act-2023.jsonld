    {
      "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 Application provision",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf"
      },
      "dc:source": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf, p.16",
      "values:originalText": "Section 36C of the Australian Citizenship Act 2007, as inserted by this\nSchedule, applies in relation to a conviction of a person if:\n\n(a) the conviction occurs after the commencement of this item;\nand\n\n(b) the person engaged in the conduct to which the conviction\nrelates on or after 12 December 2015.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 November 2023\nSenate on 30 November 2023]\n\n(163/23)",
      "skos:definition": "Section 36C of the Australian Citizenship Act 2007, as inserted by this\nSchedule, applies in relation to a conviction of a person if:\n\n(a) the conviction occurs after the commencement of this item;\nand\n\n(b) the person engaged in the conduct to which the conviction\nrelates on or after 12 December 2015.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 November 2023\nSenate on 30 November 2023]\n\n(163/23)",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-18-norm"
        },
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f8897f9101fac7fcc8507b587f02e24e7b8fc1a45df68bc930b672833f73d293",
      "skos:note": "Conviction applies if it occurs after commencement and the person engaged in conduct on or after 12 December 2015."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-18",
      "@type": "cof:Section",
      "cof:title": "18 Application provision",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "Section 36C of the Australian Citizenship Act 2007, as inserted by this\nSchedule, applies in relation to a conviction of a person if:\n\n(a) the conviction occurs after the commencement of this item;\nand\n\n(b) the person engaged in the conduct to which the conviction\nrelates on or after 12 December 2015.\n\n[Minister’s second reading speech made in—\nHouse of Representatives on 29 November 2023\nSenate on 30 November 2023]\n\n(163/23)"
    },
