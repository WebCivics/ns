      "dc:source": "australian-citizenship-amendment-citizenship-repudiation-act-2023.pdf, p.11",
      "values:originalText": "(1) The Minister may make an application for an order to be made by a\ncourt under subsection 36C(1) in relation to a person.\n\nSchedule 1  Amendments",
      "skos:definition": "(1) The Minister may make an application for an order to be made by a\ncourt under subsection 36C(1) in relation to a person.\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-36d-norm"
        }
