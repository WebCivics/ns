    {
      "@id": "concept:australian-citizenship-amendment-citizenship-repudiation-act-2023-sch-1-sec-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "14 After subsection 6(1E)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-citizenship-amendment-citizenship-repudiation-act-2023#sch-1-sec-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
