    {
      "@id": "concept:c2023c00239-sch-3-sec-15b",
      "@type": "cml:Concept",
      "dc:source": "c2023c00239.pdf, p.13",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15B Meaning of mortgage broker"
      },
      "wasDerivedFrom": "c2023c00239.pdf",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:hasPart": [
        {
          "@id": "concept:c2023c00239-sch-3-sec-15b-ss-1"
        },
        {
          "@id": "concept:c2023c00239-sch-3-sec-15b-ss-2"
        }
      ],
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2023c00239#sch-3-sec-15b",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:c2023c00239-sch-3-sec-15b-ss-1",
      "@type": "cml:Concept",
      "dc:source": "c2023c00239.pdf, p.13",
      "skos:note": "A licensee is a mortgage broker if they carry on a business of providing credit assistance in relation to credit contracts secured by mortgages over residential property.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "15B(1) Meaning of mortgage broker"
      },
      "wasDerivedFrom": "c2023c00239.pdf",
      "asserts": [
        "concept:c2023c00239-sch-3-sec-15b-ss-1-norm",
        "concept:c2023c00239-sch-3-sec-15b-ss-1-logic-deontic-1"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "3dee54c84bd6fadfe20e1713ae9bdf652c9ef1b4a177fa2f1909a75ecb27b3c7",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2023c00239#sch-3-sec-15b-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:c2023c00239-sch-3-sec-15b"
    },
    {
      "@id": "concept:c2023c00239-sch-3-sec-15b-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A licensee is a mortgage broker if:  (a) the licensee carries on a business of providing credit assistance in relation to credit contracts secured by mortgages over residential property; and  (b) the licensee does not perform the obligations, or exercise the rights, of a credit provider in relation to the majority of those credit contracts; and  (c) in carrying on the business, the licensee provides credit assistance in relation to credit contracts offered by more than one credit provider.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Definition of a mortgage broker",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:premiseText": "(1) A licensee is a mortgage broker if:  (a) the licensee carries on a business of providing credit assistance in relation to credit contracts secured by mortgages over residential property; and  (b) the licensee does not perform the obligations, or exercise the rights, of a credit provider in relation to the majority of those credit contracts; and  (c) in carrying on the business, the licensee provides credit assistance in relation to credit contracts offered by more than one credit provider."
    },
