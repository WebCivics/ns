<https://ns.webcivics.net/concept/c2023c00239-sch-3-sec-15b-ss-1> a <https://ns.webcivics.net/cml/Concept>;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "15B(1) Meaning of mortgage broker"@en;
    <https://ns.webcivics.net/cml/realizedBy> <https://ns.webcivics.net/values/c2023c00239#sch-3-sec-15b-ss-1>;
    <https://ns.webcivics.net/cml/integrityHash> "3dee54c84bd6fadfe20e1713ae9bdf652c9ef1b4a177fa2f1909a75ecb27b3c7";
    <https://ns.webcivics.net/values/partOf> <https://ns.webcivics.net/concept/c2023c00239-sch-3-sec-15b>;
    <http://www.w3.org/2004/02/skos/core#note> "A licensee is a mortgage broker if they carry on a business of providing credit assistance in relation to credit contracts secured by mortgages over residential property.";
    <https://ns.webcivics.net/cml/curationStatus> <https://ns.webcivics.net/cml/Proposed>;
    <https://ns.webcivics.net/cml/schemaVersion> "2";
