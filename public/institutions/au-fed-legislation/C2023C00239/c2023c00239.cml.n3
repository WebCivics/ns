concept:c2023c00239-sch-3-sec-158nb a cml:Concept ;
    skos:prefLabel "158NB Licensee must not accept conflicted remuneration"@en ;
    cml:realizedBy doc:sch-3-sec-158nb ;
    values:originalText "A licensee must not accept conflicted remuneration in circumstances prescribed by the regulations if:  (a) the licensee is a mortgage broker; or  (b) the licensee is a mortgage intermediary. Civil penalty: 5,000 penalty units." ;
    skos:definition "A licensee must not accept conflicted remuneration in circumstances prescribed by the regulations if:  (a) the licensee is a mortgage broker; or  (b) the licensee is a mortgage intermediary. Civil penalty: 5,000 penalty units."@en ;
