concept:c2023c00239-sch-10-sec-2 a cml:Concept ;
    skos:prefLabel "2 Application of best interests obligations"@en ;
    cml:realizedBy doc:sch-10-sec-2 ;
    values:originalText "Division 2 of Part 3-5A of the National Credit Act, as inserted by item 5 of Schedule 3 to the amending Act, applies in relation to the provision of credit assistance to a consumer on or after 1 July 2020 (whether or not the assistance was sought, or commenced being provided, before that day)." ;
    skos:definition "Division 2 of Part 3-5A of the National Credit Act, as inserted by item 5 of Schedule 3 to the amending Act, applies in relation to the provision of credit assistance to a consumer on or after 1 July 2020 (whether or not the assistance was sought, or commenced being provided, before that day)."@en ;
    cml:integrityHash "9eb9cef2b51b209d43c8e0909b1fcf90ff0172d1047c54ddd314f6d7fb385918" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Division 2 of Part 3-5A applies to credit assistance on or after July 1, 2020." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
