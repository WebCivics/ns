concept:c2023c00239-sch-3-sec-158ld a cml:Concept ;
    skos:prefLabel "158LD Application of this Subdivision"@en ;
    cml:realizedBy doc:sch-3-sec-158ld ;
    values:originalText "This Subdivision applies in relation to credit assistance provided to a consumer in relation to a credit contract by a credit representative acting within the scope of the credit representative’s actual or apparent authority from a licensee, if either the credit representative or the licensee is a mortgage broker." ;
    skos:definition "This Subdivision applies in relation to credit assistance provided to a consumer in relation to a credit contract by a credit representative acting within the scope of the credit representative’s actual or apparent authority from a licensee, if either the credit representative or the licensee is a mortgage broker."@en ;
