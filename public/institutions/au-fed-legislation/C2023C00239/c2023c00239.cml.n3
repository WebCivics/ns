concept:c2023c00239-sch-3-sec-15a a cml:Concept ;
    skos:prefLabel "15A Meaning of associate"@en ;
    cml:realizedBy doc:sch-3-sec-15a ;
    values:originalText "(1) If a person is associated with a credit provider for the purposes of the National Credit Code:  (a) the person is an associate of the credit provider; and  (b) the credit provider is an associate of the person.  (2) In any other case, a person is an associate of another person in the circumstances prescribed by the regulations.  Mortgage brokers  Schedule 3 Main amendments  Part 1  Financial Sector Reform (Hayne Royal Commission Response—Protecting Consumers (2019 Measures)) Act 2020 Compilation date: 15/09/2023 Registered: 21/09/2023" ;
    skos:definition "(1) If a person is associated with a credit provider for the purposes of the National Credit Code:  (a) the person is an associate of the credit provider; and  (b) the credit provider is an associate of the person.  (2) In any other case, a person is an associate of another person in the circumstances prescribed by the regulations.  Mortgage brokers  Schedule 3 Main amendments  Part 1  Financial Sector Reform (Hayne Royal Commission Response—Protecting Consumers (2019 Measures)) Act 2020 Compilation date: 15/09/2023 Registered: 21/09/2023"@en ;
    cml:integrityHash "b299c7cdc102c8a30a539b5f686580006af0e3e86fb03139fb2de6e90f44454d" ;
    cof:pageNumber "12"^^xsd:integer ;
    cml:hasPart concept:c2023c00239-sch-3-sec-15a-ss-1 ;
