doc:sch-3-sec-158nd-ss-1 a cof:Section ;
    cof:title "158ND(1) Employer must not give employees conflicted remuneration" ;
    values:kind "subsection" ;
    values:originalText "(1) An employer of a licensee must not give the licensee conflicted remuneration in circumstances prescribed by the regulations if the licensee is:  (a) a mortgage broker; or  (b) a mortgage intermediary. Civil penalty: 5,000 penalty units." ;
    cof:pageNumber "20"^^xsd:integer .

