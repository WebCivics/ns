doc:sch-3-sec-15a-ss-1 a cof:Section ;
    cof:title "15A(1) Meaning of associate" ;
    values:kind "subsection" ;
    values:originalText "(1) If a person is associated with a credit provider for the purposes of the National Credit Code:  (a) the person is an associate of the credit provider; and  (b) the credit provider is an associate of the person." ;
    cof:pageNumber "12"^^xsd:integer .

concept:c2023c00239-sch-3-sec-15a-ss-2 a cml:Concept ;
    skos:prefLabel "15A(2) Meaning of associate"@en ;
    cml:realizedBy doc:sch-3-sec-15a-ss-2 ;
    values:originalText "(2) In any other case, a person is an associate of another person in the circumstances prescribed by the regulations.  Mortgage brokers  Schedule 3 Main amendments  Part 1  Financial Sector Reform (Hayne Royal Commission Response—Protecting Consumers (2019 Measures)) Act 2020 Compilation date: 15/09/2023 Registered: 21/09/2023" ;
