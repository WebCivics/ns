concept:c2023c00239-sch-2-sec-3 a cml:Concept ;
    skos:prefLabel "3 Section 761A"@en ;
    cml:realizedBy doc:sch-2-sec-3 ;
    values:originalText "Insert: funeral expenses facility means a scheme or arrangement for the provision of benefits consisting of the payment of money, on the death of a person, for the purpose of meeting the whole or a part of the expenses of and incidental to the funeral, burial or cremation of the person." ;
