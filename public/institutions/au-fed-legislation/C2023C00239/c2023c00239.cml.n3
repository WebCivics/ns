concept:c2023c00239-sch-1-sec-4 a cml:Concept ;
    skos:prefLabel "4 At the end of section 12BI"@en ;
    cml:realizedBy doc:sch-1-sec-4 ;
    values:originalText "Add:  (4) For the purposes of applying paragraph (1)(a) to an Insurance Contracts Act insurance contract, have regard to the main subject matter of the contract only to the extent that it describes what is being insured." ;
