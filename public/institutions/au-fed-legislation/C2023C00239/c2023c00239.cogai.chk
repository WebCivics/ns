c2023c00239-sch-3-sec-15b-ss-1-logic-33 {
  activation: 1.0000;
  type: LogicApplication;
  provision: sch-3-sec-15b-ss-1;
  logic: Deontic;
  operator: is;
  summary: Definition of a mortgage broker;
  executionSurface: modalities::logic::deontic;
  curationStatus: Proposed;
  @condition: (1) A licensee is a mortgage broker if: (a) the licensee carries on a business of providing credit assistance in relation to credit contracts secured by mortgages over residential property; and (b) the licensee does not perform the obligations, or exercise the rights, of a credit provider in relation to the majority of those credit contracts; and (c) in carrying on the business, the licensee provides credit assistance in relation to credit contracts offered by more than one credit provider.;
  @action: (1) A licensee is a mortgage broker if: (a) the licensee carries on a business of providing credit assistance in relation to credit contracts secured by mortgages over residential property; and (b) the licensee does not perform the obligations, or exercise the rights, of a credit provider in relation to the majority of those credit contracts; and (c) in carrying on the business, the licensee provides credit assistance in relation to credit contracts offered by more than one credit provider.;
}

