    cml:hasPart concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-8-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
