    {
      "@id": "concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-government-service-consequential-provisions-act-1994#sec-3"
      },
      "cml:curationStatus": {
