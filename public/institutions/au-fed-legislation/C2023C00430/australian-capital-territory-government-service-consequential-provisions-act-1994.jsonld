    {
      "@id": "concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Arrangements relating to staffing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-government-service-consequential-provisions-act-1994#sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-government-service-consequential-provisions-act-1994.pdf"
      },
      "dc:source": "australian-capital-territory-government-service-consequential-provisions-act-1994.pdf, p.10",
      "values:originalText": "An Agency Head (within the meaning of the Public Service Act\n1999) may arrange with an appropriate authority of the Australian\nCapital Territory:\n\n(a) for the services of officers or employees in the Agency\n(within the meaning of that Act) to be made available to the\nauthority; or\n\n(b) for the services of officers or employees of the Australian\nCapital Territory Government Service to be made available\nto the Agency Head.\n\n\nMiscellaneous  Part 5\n\nSection 25\n\nAustralian Capital Territory Government Service (Consequential Provisions)\nAct 1994\nCompilation date: 18/10/2023\nRegistered: 14/11/2023",
      "skos:definition": "An Agency Head (within the meaning of the Public Service Act\n1999) may arrange with an appropriate authority of the Australian\nCapital Territory:\n\n(a) for the services of officers or employees in the Agency\n(within the meaning of that Act) to be made available to the\nauthority; or\n\n(b) for the services of officers or employees of the Australian\nCapital Territory Government Service to be made available\nto the Agency Head.\n\n\nMiscellaneous  Part 5\n\nSection 25\n\nAustralian Capital Territory Government Service (Consequential Provisions)\nAct 1994\nCompilation date: 18/10/2023\nRegistered: 14/11/2023",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-10-norm"
        },
        {
          "@id": "concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-10-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "ce5e8ff5a4f29d3ed1438d71ac7170ac6742379774abdfa236ac6d6aca1ee7f9",
      "skos:note": "Agency Head may arrange for services of officers or employees to be made available to an appropriate authority."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-government-service-consequential-provisions-act-1994#sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Arrangements relating to staffing",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "An Agency Head (within the meaning of the Public Service Act\n1999) may arrange with an appropriate authority of the Australian\nCapital Territory:\n\n(a) for the services of officers or employees in the Agency\n(within the meaning of that Act) to be made available to the\nauthority; or\n\n(b) for the services of officers or employees of the Australian\nCapital Territory Government Service to be made available\nto the Agency Head.\n\n\nMiscellaneous  Part 5\n\nSection 25\n\nAustralian Capital Territory Government Service (Consequential Provisions)\nAct 1994\nCompilation date: 18/10/2023\nRegistered: 14/11/2023"
    },
    {
