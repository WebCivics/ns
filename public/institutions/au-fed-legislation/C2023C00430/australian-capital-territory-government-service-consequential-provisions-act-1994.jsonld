    {
      "@id": "concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-25-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "25(6) Leave entitlements",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-government-service-consequential-provisions-act-1994#sec-25-ss-6"
