    {
      "@id": "concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-government-service-consequential-provisions-act-1994#sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-government-service-consequential-provisions-act-1994.pdf"
      },
      "dc:source": "australian-capital-territory-government-service-consequential-provisions-act-1994.pdf, p.5",
      "values:originalText": "(1) This Act commences on a day to be fixed by Proclamation.\n\n(2) If this Act does not commence under subsection (1) within 18\nmonths after the day on which it receives the Royal Assent, this\nAct is repealed on the first day after the end of that period.",
      "skos:definition": "(1) This Act commences on a day to be fixed by Proclamation.\n\n(2) If this Act does not commence under subsection (1) within 18\nmonths after the day on which it receives the Royal Assent, this\nAct is repealed on the first day after the end of that period.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-2-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-government-service-consequential-provisions-act-1994-sec-2-ss-2"
        }
      ],
      "cml:integrityHash": "01d58bbdc8d55c33077255408e87956fea5ff3b1643cabef7fdef7cfbf9d764e"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-government-service-consequential-provisions-act-1994#sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Commencement",
      "values:kind": "section",
      "cof:pageNumber": 5,
      "values:originalText": "(1) This Act commences on a day to be fixed by Proclamation.\n\n(2) If this Act does not commence under subsection (1) within 18\nmonths after the day on which it receives the Royal Assent, this\nAct is repealed on the first day after the end of that period."
    },
