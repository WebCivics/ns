      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-government-service-consequential-provisions-act-1994.pdf"
      },
      "dc:source": "australian-capital-territory-government-service-consequential-provisions-act-1994.pdf, p.5",
      "values:originalText": "(1) In this Act, unless the contrary intention appears:\nACT Branch means the branch of the Australian Public Service\nreferred to in subsection 21(2) of the A.C.T. Self-Government\n(Consequential Provisions) Act 1988.\nACT officer means a person who is an officer within the meaning\nof the Public Sector Management Act 1994 of the Australian\nCapital Territory.\nPublic Service Act means the Public Service Act 1922.\ntransfer day means the day on which this Act commences.",
      "skos:definition": "(1) In this Act, unless the contrary intention appears:\nACT Branch means the branch of the Australian Public Service\nreferred to in subsection 21(2) of the A.C.T. Self-Government\n(Consequential Provisions) Act 1988.\nACT officer means a person who is an officer within the meaning\nof the Public Sector Management Act 1994 of the Australian\nCapital Territory.\nPublic Service Act means the Public Service Act 1922.\ntransfer day means the day on which this Act commences.",
      "cml:asserts": [
