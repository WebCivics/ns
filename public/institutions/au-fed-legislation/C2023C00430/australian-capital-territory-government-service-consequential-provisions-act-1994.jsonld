    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-government-service-consequential-provisions-act-1994#sec-2-ss-2",
      "@type": "cof:Section",
      "cof:title": "2(2) Commencement",
      "values:kind": "subsection",
      "cof:pageNumber": 5,
      "values:originalText": "(2) If this Act does not commence under subsection (1) within 18\nmonths after the day on which it receives the Royal Assent, this\nAct is repealed on the first day after the end of that period."
    },
