    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the action of causing an offer of the provision of a benefit, or a promise of the provision of a benefit, to be made to another person with the intention of improperly influencing a foreign public official." ;
    cml:premiseText "The first-mentioned person causes an offer of the provision of a benefit, or a promise of the provision of a benefit, to be made to another person with the intention of improperly influencing a foreign public official." ;
    cml:conclusionText "The person commits an offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-70-ss-1 cml:asserts concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-70-ss-1-logic-deontic-5 .
concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-70-ss-1-logic-deontic-5 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the action of obtaining or retaining business or a business or personal advantage with the intention of improperly influencing a foreign public official." ;
    cml:premiseText "The person does so with the intention of improperly influencing a foreign public official (who may be the other person) in order to obtain or retain business or a business or personal advantage (whether or not for the first-mentioned person)." ;
    cml:conclusionText "The person commits an offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


