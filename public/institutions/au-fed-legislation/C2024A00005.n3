    cml:operator "Prohibit" ;
    cml:logicSummary "Prohibits the action of offering to provide, or promising to provide, a benefit to another person with the intention of improperly influencing a foreign public official." ;
    cml:premiseText "The person offers to provide, or promises to provide, a benefit to another person with the intention of improperly influencing a foreign public official." ;
    cml:conclusionText "The person commits an offence." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
