    {
      "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Review of operation of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-combatting-foreign-bribery-act-2024#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-combatting-foreign-bribery-act-2024.pdf"
      },
      "dc:source": "crimes-legislation-amendment-combatting-foreign-bribery-act-2024.pdf, p.7",
      "values:originalText": "(1) The Minister must cause a review of the operation of the\namendments made by this Act to be conducted as soon as\npracticable after the end of the period of 18 months starting on the\nday Part 2 of Schedule 1 to this Act commences.\n(2) The persons who conduct the review must give the Minister a\nwritten report of the review.\n(3) The Minister must cause a copy of the report of the review to be\ntabled in each House of the Parliament within 15 sitting days of\nthat House after the Minister receives the report.\n\nSchedule 1  Amendments",
      "skos:definition": "(1) The Minister must cause a review of the operation of the\namendments made by this Act to be conducted as soon as\npracticable after the end of the period of 18 months starting on the\nday Part 2 of Schedule 1 to this Act commences.\n(2) The persons who conduct the review must give the Minister a\nwritten report of the review.\n(3) The Minister must cause a copy of the report of the review to be\ntabled in each House of the Parliament within 15 sitting days of\nthat House after the Minister receives the report.\n\nSchedule 1  Amendments",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sec-4-ss-1"
        },
        {
          "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sec-4-ss-2"
        },
        {
          "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sec-4-ss-3"
        }
      ],
      "cml:integrityHash": "cea5707c018beb101a3f6bee3fe108ccce649c5b67a2d615fa859b77217dbe61"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-combatting-foreign-bribery-act-2024#sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Review of operation of amendments",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "(1) The Minister must cause a review of the operation of the\namendments made by this Act to be conducted as soon as\npracticable after the end of the period of 18 months starting on the\nday Part 2 of Schedule 1 to this Act commences.\n(2) The persons who conduct the review must give the Minister a\nwritten report of the review.\n(3) The Minister must cause a copy of the report of the review to be\ntabled in each House of the Parliament within 15 sitting days of\nthat House after the Minister receives the report.\n\nSchedule 1  Amendments"
    },
