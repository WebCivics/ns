      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-combatting-foreign-bribery-act-2024.pdf"
      },
      "dc:source": "crimes-legislation-amendment-combatting-foreign-bribery-act-2024.pdf, p.16",
      "values:originalText": "The amendments made by this Part apply in relation to conduct engaged\nin on or after the commencement of this Part.\n\nAmendments  Schedule 1\nOther amendments  Part 2\nNo. 5, 2024\nCrimes Legislation Amendment (Combatting Foreign Bribery) Act",
      "skos:definition": "The amendments made by this Part apply in relation to conduct engaged\nin on or after the commencement of this Part.\n\nAmendments  Schedule 1\nOther amendments  Part 2\nNo. 5, 2024\nCrimes Legislation Amendment (Combatting Foreign Bribery) Act",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-10-norm"
        }
      ],
      "cml:integrityHash": "1eba39c23238c14fb9db3827de6be7b25723fd49def805f438772c60cd921413",
      "skos:note": "Commencement of amendments"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-combatting-foreign-bribery-act-2024#sch-1-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Application of amendments",
      "values:kind": "section",
      "cof:pageNumber": 16,
      "values:originalText": "The amendments made by this Part apply in relation to conduct engaged\nin on or after the commencement of this Part.\n\nAmendments  Schedule 1\nOther amendments  Part 2\nNo. 5, 2024\nCrimes Legislation Amendment (Combatting Foreign Bribery) Act"
    },
    {
      "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-10-norm",
