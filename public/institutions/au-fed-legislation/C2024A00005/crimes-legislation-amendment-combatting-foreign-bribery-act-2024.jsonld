      "cml:premiseText": "(c)(i) if the value of the business or advantage is insignificant—that fact;"
    },
    {
      "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-70-2-ss-2-logic-deontic-4",
