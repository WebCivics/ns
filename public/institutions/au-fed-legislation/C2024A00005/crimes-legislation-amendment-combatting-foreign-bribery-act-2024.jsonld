      "skos:prefLabel": "70(2) 5A  Failing to prevent bribery of a foreign public official",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-combatting-foreign-bribery-act-2024#sch-1-sec-70-3-ss-2"
