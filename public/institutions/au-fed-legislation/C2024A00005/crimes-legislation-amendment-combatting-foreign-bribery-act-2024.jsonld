    {
      "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Application of amendments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-combatting-foreign-bribery-act-2024#sch-1-sec-10"
      },
      "cml:curationStatus": {
