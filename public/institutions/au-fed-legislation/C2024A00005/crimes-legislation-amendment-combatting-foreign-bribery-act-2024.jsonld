    {
      "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-12",
      "@type": "cml:Concept",
      "skos:prefLabel": "12 Subsection 26-52(2A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-combatting-foreign-bribery-act-2024#sch-1-sec-12"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-legislation-amendment-combatting-foreign-bribery-act-2024.pdf"
      },
      "dc:source": "crimes-legislation-amendment-combatting-foreign-bribery-act-2024.pdf, p.17",
      "values:originalText": "Omit “a business advantage”, substitute “a business or personal\nadvantage”.",
      "skos:definition": "Omit “a business advantage”, substitute “a business or personal\nadvantage”.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sch-1-sec-12-norm"
        }
      ],
      "cml:integrityHash": "82c270b6c23ee767e7de1d791b79b7cace2d9664b29df06ab87dd357ae0dc393",
      "skos:note": "Substitute 'business or personal advantage' for 'business advantage'"
