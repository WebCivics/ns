      "dc:source": "crimes-legislation-amendment-combatting-foreign-bribery-act-2024.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\n\n\nNo. 5, 2024\nCrimes Legislation Amendment (Combatting Foreign Bribery) Act",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\n\n\nNo. 5, 2024\nCrimes Legislation Amendment (Combatting Foreign Bribery) Act",
      "cml:asserts": [
        {
          "@id": "concept:crimes-legislation-amendment-combatting-foreign-bribery-act-2024-sec-3-2-norm"
        }
      ],
      "cml:integrityHash": "c831b4edf3146415346e9dfca7e4f77d32eec5d8ddb4eb08ea60cc2ec83eb226",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-legislation-amendment-combatting-foreign-bribery-act-2024#sec-3-2",
