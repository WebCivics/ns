doc:sch-1-sec-154zq-ss-4 a cof:Section ;
    cof:title "154ZQ(4) Minister may grant approval" ;
    values:kind "subsection" ;
    values:originalText "(4) For the purposes of paragraphs (2)(c) and (3)(a), the designated complaints determination may prescribe matters to which the Minister: (a) must have regard; or (b) may have regard. Maximum number of designated complainants" ;
    cof:pageNumber "16"^^xsd:integer .

concept:competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act-sch-1-sec-154zq-ss-5 a cml:Concept ;
    skos:prefLabel "154ZQ(5) Minister may grant approval"@en ;
    cml:realizedBy doc:sch-1-sec-154zq-ss-5 ;
    values:originalText "(5) However, the Minister must not grant the approval if doing so would result in the number of designated complainants being above the limit prescribed in the designated complaints determination." ;
    skos:definition "(5) However, the Minister must not grant the approval if doing so would result in the number of designated complainants being above the limit prescribed in the designated complaints determination."@en ;
    cml:integrityHash "0b51c2d6a9686973006fbbb2e4d32e12e18ceb02eab4695e1c37089aa9acabdc" ;
