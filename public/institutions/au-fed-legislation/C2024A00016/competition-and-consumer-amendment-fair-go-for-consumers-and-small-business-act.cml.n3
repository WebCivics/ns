doc:sch-1-sec-154zr-ss-4 a cof:Section ;
    cof:title "154ZR(4) Conditions in approval" ;
    values:kind "subsection" ;
    values:originalText "(4) If the Minister gives the applicant a notice under subsection (3), the Minister must give the Commission a copy of the notice as soon as practicable." ;
    cof:pageNumber "17"^^xsd:integer .

concept:competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act-sch-1-sec-154zs a cml:Concept ;
    skos:prefLabel "154ZS Contents of approval"@en ;
    cml:realizedBy doc:sch-1-sec-154zs ;
    values:originalText "The approval must set out the following: (a) the name of the designated complainant; (b) the date (if any) on which the approval ceases to be in force; (c) the conditions (if any) to which the approval is subject." ;
    skos:definition "The approval must set out the following: (a) the name of the designated complainant; (b) the date (if any) on which the approval ceases to be in force; (c) the conditions (if any) to which the approval is subject."@en ;
