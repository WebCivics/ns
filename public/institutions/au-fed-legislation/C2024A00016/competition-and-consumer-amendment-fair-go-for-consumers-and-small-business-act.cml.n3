    cml:hasPart concept:competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act-sch-1-sec-154zv-ss-5 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
