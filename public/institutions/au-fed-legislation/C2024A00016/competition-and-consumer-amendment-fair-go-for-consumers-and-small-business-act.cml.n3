concept:competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act-sch-1-sec-154zj a cml:Concept ;
    skos:prefLabel "154ZJ Notice—no further action on complaint—contents"@en ;
    cml:realizedBy doc:sch-1-sec-154zj ;
    values:originalText "A notice given under subsection 154ZH(1) must set out the following: (a) a summary of the complaint; (b) which of subsections 154ZH(2), (3), (4) and (5) apply in relation to the complaint; (c) the reasons for the Commission’s decision." ;
    skos:definition "A notice given under subsection 154ZH(1) must set out the following: (a) a summary of the complaint; (b) which of subsections 154ZH(2), (3), (4) and (5) apply in relation to the complaint; (c) the reasons for the Commission’s decision."@en ;
    cml:integrityHash "da70a118c5c85c6ae7e45754f66e5b6ae2cca5c2bd885c7f1292374f1e0b8a19" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Notice must set out summary of complaint, reasons for Commission's decision." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act.pdf> ;
    dc:source "competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act.pdf, p.12" ;
