doc:sec-4-ss-3 a cof:Section ;
    cof:title "4(3) Review of operation of amendments" ;
    values:kind "subsection" ;
    values:originalText "(3) The persons who undertake the review must give the Minister a written report of the review within 6 months of the commencement of the review." ;
    cof:pageNumber "6"^^xsd:integer .

