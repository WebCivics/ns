concept:competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act-sch-1-sec-154zt a cml:Concept ;
    skos:prefLabel "154ZT Notice of decision on application for approval"@en ;
    cml:realizedBy doc:sch-1-sec-154zt ;
    values:originalText "(1) If the Minister: (a) decides to grant the approval; or (b) decides not to grant the approval; the Minister must give the applicant, as soon as practicable: (c) notice of the decision; and (d) if the decision is to grant the approval—a copy of the approval. (2) If the Minister decides to grant the approval, as soon as practicable after granting the approval, the Minister: (a) must give a copy of the notice of the decision to the Commission; and (b) must publish the name of the entity on the Department’s website; and (c) may publish all or parts of the conditions (if any) to which the approval is subject on the Department’s website." ;
    skos:definition "(1) If the Minister: (a) decides to grant the approval; or (b) decides not to grant the approval; the Minister must give the applicant, as soon as practicable: (c) notice of the decision; and (d) if the decision is to grant the approval—a copy of the approval. (2) If the Minister decides to grant the approval, as soon as practicable after granting the approval, the Minister: (a) must give a copy of the notice of the decision to the Commission; and (b) must publish the name of the entity on the Department’s website; and (c) may publish all or parts of the conditions (if any) to which the approval is subject on the Department’s website."@en ;
    cml:integrityHash "88fc8fd09082613fa9a9bdd15062a108a5f141fb1e67f150da972dc0897a2a52" ;
    cof:pageNumber "18"^^xsd:integer ;
    cml:hasPart concept:competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act-sch-1-sec-154zt-ss-1 ;
    cml:hasPart concept:competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act-sch-1-sec-154zt-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act.pdf> ;
    dc:source "competition-and-consumer-amendment-fair-go-for-consumers-and-small-business-act.pdf, p.18" .
