      "cml:logicSummary": "Temporal intervals for notice giving",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "Notice given by a carrier or carriage service provider determines the anticipated service area"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360b-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The carrier or carriage service provider must provide services within the designated area",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Carrier or carriage service providers are responsible for nominated and anticipated service areas",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "The carrier or carriage service provider is declared by the Minister as the statutory infrastructure provider"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360b-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Minister must provide information about the designated service area and its statutory infrastructure provider",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Minister declares designated service areas and their statutory infrastructure providers",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "The Minister has the authority to declare designated service areas"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360b-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "NBN Co must provide services within the designated area",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "NBN Co is the statutory infrastructure provider for general service areas",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "NBN Co is declared as the statutory infrastructure provider for general service areas"
    },
