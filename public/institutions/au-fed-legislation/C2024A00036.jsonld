    {
      "@id": "concept:c2024a00036-sch-1-sec-360b-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The notice must be given within a certain timeframe to determine the statutory infrastructure provider",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
