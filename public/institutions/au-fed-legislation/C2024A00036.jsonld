    {
      "@id": "concept:c2024a00036-sch-1-sec-360ae",
      "@type": "cml:Concept",
      "dc:source": "c2024a00036.pdf, p.11",
      "skos:note": "A person is in a position to exercise control of a facility if they own it or have significant influence over its operation.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "360AE When a person is in a position to exercise control of a facility"
      },
      "wasDerivedFrom": "c2024a00036.pdf",
      "asserts": [
        "concept:c2024a00036-sch-1-sec-360ae-norm",
        "concept:c2024a00036-sch-1-sec-360ae-logic-deontic-1",
        "concept:c2024a00036-sch-1-sec-360ae-logic-alleninterval-2",
        "concept:c2024a00036-sch-1-sec-360ae-logic-argumentation-3",
        "concept:c2024a00036-sch-1-sec-360ae-logic-diffusion-4"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "1c797554ba1ee2f34c795e3b138885b84903c61243e0d7c8c89dddce8f583710",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2024a00036#sch-1-sec-360ae",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ae-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Person is in a position to exercise control of the facility during that period.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "During the period of control",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "Person exercises control of facility during a certain period."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ae-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Person is in a position to exercise control if they have control.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::argumentation",
      "cml:logicSummary": "Implication of control",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:premiseText": "Person has control implies they are in a position to exercise control."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ae-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Person is in a position to exercise control of the facility.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Has control",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "hasControl",
      "cml:premiseText": "Person owns facility or has significant influence over its operation."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ae-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Person's influence diffuses through the facility.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "Diffusion of influence",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "diffuses",
      "cml:premiseText": "Person's influence spreads through the facility."
    },
