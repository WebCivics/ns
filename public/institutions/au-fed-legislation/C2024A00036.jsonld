    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-10",
      "@type": "cml:Concept",
      "dc:source": "c2024a00036.pdf, p.50",
      "skos:note": "Not required to comply with a benchmark if it's inconsistent with an access agreement entered into before the benchmark's commencement.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "142(10) At the end of section 360U"
      },
      "wasDerivedFrom": "c2024a00036.pdf",
      "asserts": [
        "concept:c2024a00036-sch-1-sec-142-ss-10-norm",
        "concept:c2024a00036-sch-1-sec-142-ss-10-logic-deontic-1",
        "concept:c2024a00036-sch-1-sec-142-ss-10-logic-alleninterval-2",
        "concept:c2024a00036-sch-1-sec-142-ss-10-logic-ltl-3",
        "concept:c2024a00036-sch-1-sec-142-ss-10-logic-diffusion-4",
        "concept:c2024a00036-sch-1-sec-142-ss-10-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "cc48316d49ed2693ed9b36a7986599575475c8d89172c2987b4b5313b48164d6",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:c2024a00036#sch-1-sec-142-ss-10",
      "cml:schemaVersion": "2",
      "partOf": "concept:c2024a00036-sch-1-sec-142"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-10-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The benchmark's commencement overlaps with the agreement's entry.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(a) the agreement was entered into before the commencement of the benchmark; and (b) the agreement has not been varied after the commencement of the benchmark."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-10-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The statutory infrastructure provider recognizes the access agreement.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Recognizes",
      "cml:premiseText": "(a) the agreement was entered into before the commencement of the benchmark; and (b) the agreement has not been varied after the commencement of the benchmark."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-10-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The statutory infrastructure provider is not required to comply with the benchmark.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "If A, then B.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:premiseText": "(a) the agreement was entered into before the commencement of the benchmark; and (b) the agreement has not been varied after the commencement of the benchmark."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-10-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The benchmark's variation spreads to the agreement.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Spreads",
      "cml:premiseText": "(a) the agreement was entered into before the commencement of the benchmark; and (b) the agreement has not been varied after the commencement of the benchmark."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-10-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The benchmark's repetition is tied to the agreement's variation.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "(a) the agreement was entered into before the commencement of the benchmark; and (b) the agreement has not been varied after the commencement of the benchmark."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-10-norm",
      "@type": "doc:Obligation",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
