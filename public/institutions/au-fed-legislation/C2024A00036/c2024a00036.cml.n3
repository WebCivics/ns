concept:c2024a00036-sch-2-sec-372jd a cml:Concept ;
    skos:prefLabel "372JD Extension of time for compliance with remedial notices"@en ;
    cml:realizedBy doc:sch-2-sec-372jd ;
    values:originalText "Scope (1) This section applies if a person has been given a remedial notice. Extension of compliance period (2) The ACMA may, by written notice given to the person, extend the compliance period for the remedial notice. (3) However, the ACMA may extend the compliance period only if the period has not ended. (4) In this section, compliance period means the period stated in the remedial notice under section 372JB, and includes that period as extended under this section." ;
    skos:definition "Scope (1) This section applies if a person has been given a remedial notice. Extension of compliance period (2) The ACMA may, by written notice given to the person, extend the compliance period for the remedial notice. (3) However, the ACMA may extend the compliance period only if the period has not ended. (4) In this section, compliance period means the period stated in the remedial notice under section 372JB, and includes that period as extended under this section."@en ;
    cml:integrityHash "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000" ;
    cof:pageNumber "72"^^xsd:integer ;
    cml:hasPart concept:c2024a00036-sch-2-sec-372jd-ss-1 ;
    cml:hasPart concept:c2024a00036-sch-2-sec-372jd-ss-2 ;
