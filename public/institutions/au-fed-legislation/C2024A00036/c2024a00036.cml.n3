    cml:logicSummary "Statutory infrastructure provider has an obligation to pay damages for contravention of designated compensable standard or rule" ;
    cml:premiseText "Subsection 360U(1) and subsection 360V(1)" ;
    cml:conclusionText "Liability for contravention" ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

