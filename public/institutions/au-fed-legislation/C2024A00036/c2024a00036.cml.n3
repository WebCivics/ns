    cml:premiseText "(3) The period stated for compliance with the remedial notice must be reasonable in all the circumstances." ;
    cml:conclusionText "The period contains a temporal interval" ;
    cml:executionSurface "sparql_library::parsers::chk_parser" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .
