concept:c2024a00036-sch-3-sec-59da-ss-7 a cml:Concept ;
    skos:prefLabel "59DA(7) Disclosure of information that relates to the affairs of a"@en ;
    cml:realizedBy doc:sch-3-sec-59da-ss-7 ;
    values:originalText "(7) Subsections (1), (2) and (3) do not authorise the disclosure of anything that is likely to enable the identification of an end-user of a carriage service." ;
    skos:definition "(7) Subsections (1), (2) and (3) do not authorise the disclosure of anything that is likely to enable the identification of an end-user of a carriage service."@en ;
    cml:integrityHash "e8315ebbbd6f755cd40daed466ea56d6c770fb30258fb059d0b24db38fda4a7f" ;
    values:partOf concept:c2024a00036-sch-3-sec-59da ;
    cof:pageNumber "75"^^xsd:integer ;
    skos:note "Disclosure of information that relates to the affairs of a carriage service is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2024a00036.pdf> ;
