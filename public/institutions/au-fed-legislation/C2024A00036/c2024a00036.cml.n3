concept:c2024a00036-sch-4-sec-8c a cml:Concept ;
    skos:prefLabel "8C Meaning of service area"@en ;
    cml:realizedBy doc:sch-4-sec-8c ;
    values:originalText "For the purposes of this Part, a service area is: (a) a geographical area within Australia; or (b) any area of land; or (c) any premises or part of premises; regardless of size." ;
    skos:definition "For the purposes of this Part, a service area is: (a) a geographical area within Australia; or (b) any area of land; or (c) any premises or part of premises; regardless of size."@en ;
    cml:integrityHash "bcee7f588b5f16492f603d885eaf6b279865d2dfe90f538bad50c89b2a82924f" ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Definition of service area" ;
    cml:curationStatus cml:Proposed ;
