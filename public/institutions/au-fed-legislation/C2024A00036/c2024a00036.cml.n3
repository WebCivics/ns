concept:c2024a00036-sch-1-sec-127 a cml:Concept ;
    skos:prefLabel "127 Paragraph 360R(2)(b)"@en ;
    cml:realizedBy doc:sch-1-sec-127 ;
    values:originalText "Repeal the paragraph, substitute: (b) do so: (i) if it is reasonably practicable for the notice to be given at least 12 months before the time when the first person will become no longer able to fulfil the first person’s obligations under section 360P or 360Q—at least 12 months before that time; or (ii) in any other case—not later than 10 business days after the time when the first person becomes no longer able to fulfil the first person’s obligations under section 360P or 360Q." ;
    skos:definition "Repeal the paragraph, substitute: (b) do so: (i) if it is reasonably practicable for the notice to be given at least 12 months before the time when the first person will become no longer able to fulfil the first person’s obligations under section 360P or 360Q—at least 12 months before that time; or (ii) in any other case—not later than 10 business days after the time when the first person becomes no longer able to fulfil the first person’s obligations under section 360P or 360Q."@en ;
    cml:integrityHash "8afa487cc458840f3fca9addb77966908fb6ca06314019336ec8392ffb08ceb1" ;
    cof:pageNumber "46"^^xsd:integer ;
    skos:note "Notice must be given at least 12 months before the first person can no longer fulfill their obligations." ;
    cml:curationStatus cml:Proposed ;
