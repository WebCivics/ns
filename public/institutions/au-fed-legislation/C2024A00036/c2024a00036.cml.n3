    cof:title "53(17) Subsections 360H(14), (15), (16) and (17)" ;
    values:kind "subsection" ;
    values:originalText "(17) The ACMA may, by legislative instrument: (a) specify the information that must accompany an application under subsection (15); or (b) specify the documents that must accompany an application under subsection (15). Note: For variation and revocation, see subsection 33(3) of the Acts Interpretation Act 1901." ;
    cof:pageNumber "18"^^xsd:integer .

concept:c2024a00036-sch-1-sec-53-ss-17a a cml:Concept ;
    skos:prefLabel "53(17A) Subsections 360H(14), (15), (16) and (17)"@en ;
    cml:realizedBy doc:sch-1-sec-53-ss-17a ;
    values:originalText "(17A) If, under subsection (14), a carrier varies a declaration made by the carrier under this section, the carrier must: (a) give a copy of the variation to the ACMA; and (b) do so within 10 business days after making the variation." ;
    skos:definition "(17A) If, under subsection (14), a carrier varies a declaration made by the carrier under this section, the carrier must: (a) give a copy of the variation to the ACMA; and (b) do so within 10 business days after making the variation."@en ;
    cml:integrityHash "398a5d936ed9e63b377d234ae94da10efa8b720ce198c2622cce9774da46fc70" ;
    values:partOf concept:c2024a00036-sch-1-sec-53 ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Carrier must provide variation to ACMA within 10 business days." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
