concept:c2024a00036-sch-1-sec-360c a cml:Concept ;
    skos:prefLabel "360C Service area"@en ;
    cml:realizedBy doc:sch-1-sec-360c ;
    values:originalText "For the purposes of this Part, service area means: (a) the general service area; or (b) a nominated service area; or (c) an anticipated service area; or (d) a designated service area." ;
    skos:definition "For the purposes of this Part, service area means: (a) the general service area; or (b) a nominated service area; or (c) an anticipated service area; or (d) a designated service area."@en ;
