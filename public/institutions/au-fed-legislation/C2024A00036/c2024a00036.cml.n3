concept:c2024a00036-sch-1-sec-25 a cml:Concept ;
    skos:prefLabel "25 At the end of section 360F"@en ;
    cml:realizedBy doc:sch-1-sec-25 ;
    values:originalText "Add: (2) For the purposes of this section, if: (a) an area (the notice area) is specified in a notice under section 360HA or 360HC; and (b) the notice area neither consists of, nor is included in: (i) a nominated service area; or (ii) a designated service area; then: (c) if NBN Co provides qualifying carriage services to end-users at one or more premises in the area—so much of the notice area as does not include those premises is a pending area; or (d) in any other case—the notice area is a pending area. Note: For anticipated service areas, see section 360KA." ;
    skos:definition "Add: (2) For the purposes of this section, if: (a) an area (the notice area) is specified in a notice under section 360HA or 360HC; and (b) the notice area neither consists of, nor is included in: (i) a nominated service area; or (ii) a designated service area; then: (c) if NBN Co provides qualifying carriage services to end-users at one or more premises in the area—so much of the notice area as does not include those premises is a pending area; or (d) in any other case—the notice area is a pending area. Note: For anticipated service areas, see section 360KA."@en ;
    cml:integrityHash "5edb507c5a461509d663934ab5dd23d88af532834f8cfc8456d20981f6a12515" ;
    cof:pageNumber "15"^^xsd:integer ;
    skos:note "Specify notice area as pending if not included in nominated or designated service areas" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2024a00036.pdf> ;
    dc:source "c2024a00036.pdf, p.15" ;
    cml:asserts concept:c2024a00036-sch-1-sec-25-norm .
