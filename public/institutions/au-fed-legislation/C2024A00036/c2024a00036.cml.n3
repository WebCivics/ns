    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Temporal intervals for notice giving" ;
    cml:premiseText "Notice given by a carrier or carriage service provider determines the anticipated service area" ;
    cml:conclusionText "The notice must be given within a certain timeframe to determine the statutory infrastructure provider" ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:c2024a00036-sch-1-sec-360b cml:asserts concept:c2024a00036-sch-1-sec-360b-logic-deontic-2 .
