    values:kind "subsection" ;
    values:originalText "(4) The Minister may, by legislative instrument, declare that: (a) a specified development area mentioned in subsection (1) is not a nominated service area for the purposes of this Part; and (b) a specified area is a nominated service area for the purposes of this Part. Note 1: For variation and revocation, see subsection 33(3) of the Acts Interpretation Act 1901. Note 2: For the format of the description of the area, see section 360LA." ;
    cof:pageNumber "31"^^xsd:integer .

concept:c2024a00036-sch-1-sec-76-ss-5 a cml:Concept ;
    skos:prefLabel "76(5) At the end of section 360J"@en ;
    cml:realizedBy doc:sch-1-sec-76-ss-5 ;
    values:originalText "(5) An area must not be specified in a declaration in accordance with paragraph (4)(b) unless at least one point in the area is also a point in the development area specified in the declaration in accordance with paragraph (4)(a)." ;
    skos:definition "(5) An area must not be specified in a declaration in accordance with paragraph (4)(b) unless at least one point in the area is also a point in the development area specified in the declaration in accordance with paragraph (4)(a)."@en ;
    cml:integrityHash "7859ef9d6f241d884c393f22058d44c84aac055f775d490a8d06a58d4204642c" ;
    values:partOf concept:c2024a00036-sch-1-sec-76 ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Cannot specify an area in a declaration without it being part of the development area." ;
