concept:c2024a00036-sch-1-sec-360na a cml:Concept ;
    skos:prefLabel "360NA Proximity to a project area"@en ;
    cml:realizedBy doc:sch-1-sec-360na ;
    values:originalText "For the purposes of this Subdivision, telecommunications network infrastructure forming part of a mobile network is in proximity to a project area if, and only if, once fully deployed and operational, the infrastructure is technically capable of being used to supply carriage services within the whole of the project area." ;
    skos:definition "For the purposes of this Subdivision, telecommunications network infrastructure forming part of a mobile network is in proximity to a project area if, and only if, once fully deployed and operational, the infrastructure is technically capable of being used to supply carriage services within the whole of the project area."@en ;
    cml:integrityHash "c5921554b283d099954fe4d6ed9e3b6ce803b9853cd15314dfda729d8f2d9601" ;
    cof:pageNumber "41"^^xsd:integer ;
    skos:note "Telecommunications network infrastructure must be technically capable of supplying carriage services within the project area." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2024a00036.pdf> ;
    dc:source "c2024a00036.pdf, p.41" ;
