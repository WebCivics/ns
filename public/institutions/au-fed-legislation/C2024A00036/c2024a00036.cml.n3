concept:c2024a00036-sch-1-sec-133 a cml:Concept ;
    skos:prefLabel "133 Paragraph 360R(3)(d)"@en ;
    cml:realizedBy doc:sch-1-sec-133 ;
    values:originalText "Repeal the paragraph, substitute: (d) do so: (i) if it is reasonably practicable for the notice to be given at least 90 days before the time when the first person  Statutory infrastructure providers  Schedule 1 Amendments  Part 1 No. 36, 2024 Telecommunications Legislation Amendment (Enhancing Consumer Safeguards and Other Measures) Act 2024 becomes no longer able to fulfil the first person’s obligations under section 360P or 360Q—at least 90 days before that time; or (ii) in any other case—not later than 10 business days after the time when the other person becomes the statutory infrastructure provider for the area." ;
    skos:definition "Repeal the paragraph, substitute: (d) do so: (i) if it is reasonably practicable for the notice to be given at least 90 days before the time when the first person  Statutory infrastructure providers  Schedule 1 Amendments  Part 1 No. 36, 2024 Telecommunications Legislation Amendment (Enhancing Consumer Safeguards and Other Measures) Act 2024 becomes no longer able to fulfil the first person’s obligations under section 360P or 360Q—at least 90 days before that time; or (ii) in any other case—not later than 10 business days after the time when the other person becomes the statutory infrastructure provider for the area."@en ;
    cml:integrityHash "eddabbd6411530f22183f2726f6621890ae060981337409767e6bc540e064c26" ;
    cof:pageNumber "46"^^xsd:integer ;
    skos:note "Statutory infrastructure providers must give notice at least 90 days before ceasing to fulfill obligations." ;
    dc:description "Notice" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <c2024a00036.pdf> ;
