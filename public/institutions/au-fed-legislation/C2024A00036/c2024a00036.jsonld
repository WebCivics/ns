      ],
      "cml:integrityHash": "8453ac5531b3c309603dc265672a47819067d003ac9245e18601a13dcfccb50a",
      "skos:note": "ACMA has power to make legislative instrument"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-142-ss-14",
      "@type": "cof:Section",
      "cof:title": "142(14) At the end of section 360U",
      "values:kind": "subsection",
      "cof:pageNumber": 50,
      "values:originalText": "(14) Benchmarks set under subsection (11) may make provision for or\nin relation to a matter by conferring a power on the ACMA to\nmake a legislative instrument.\nProvider must meet or exceed other benchmarks"
    },
