    {
      "@id": "concept:c2024a00036-sch-2-sec-372jd",
      "@type": "cml:Concept",
      "skos:prefLabel": "372JD Extension of time for compliance with remedial notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-2-sec-372jd"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.72",
      "values:originalText": "Scope\n(1) This section applies if a person has been given a remedial notice.\nExtension of compliance period\n(2) The ACMA may, by written notice given to the person, extend the\ncompliance period for the remedial notice.\n(3) However, the ACMA may extend the compliance period only if the\nperiod has not ended.\n(4) In this section, compliance period means the period stated in the\nremedial notice under section 372JB, and includes that period as\nextended under this section.",
      "skos:definition": "Scope\n(1) This section applies if a person has been given a remedial notice.\nExtension of compliance period\n(2) The ACMA may, by written notice given to the person, extend the\ncompliance period for the remedial notice.\n(3) However, the ACMA may extend the compliance period only if the\nperiod has not ended.\n(4) In this section, compliance period means the period stated in the\nremedial notice under section 372JB, and includes that period as\nextended under this section.",
      "cml:hasPart": [
        {
          "@id": "concept:c2024a00036-sch-2-sec-372jd-ss-1"
        },
        {
          "@id": "concept:c2024a00036-sch-2-sec-372jd-ss-2"
        },
        {
          "@id": "concept:c2024a00036-sch-2-sec-372jd-ss-3"
        },
        {
          "@id": "concept:c2024a00036-sch-2-sec-372jd-ss-4"
        }
      ],
      "cml:integrityHash": "b073f6c68ef8721107fd9815b19b2c35ec111d526b75c2123d1111ba64424000"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-2-sec-372jd",
      "@type": "cof:Section",
      "cof:title": "372JD Extension of time for compliance with remedial notices",
      "values:kind": "section",
      "cof:pageNumber": 72,
      "values:originalText": "Scope\n(1) This section applies if a person has been given a remedial notice.\nExtension of compliance period\n(2) The ACMA may, by written notice given to the person, extend the\ncompliance period for the remedial notice.\n(3) However, the ACMA may extend the compliance period only if the\nperiod has not ended.\n(4) In this section, compliance period means the period stated in the\nremedial notice under section 372JB, and includes that period as\nextended under this section."
    },
