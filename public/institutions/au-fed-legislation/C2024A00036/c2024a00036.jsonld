    {
      "@id": "concept:c2024a00036-sch-1-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Section 360J",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.31",
      "values:originalText": "Before “For the purposes of this Part,”, insert “(1)”.",
      "skos:definition": "Before “For the purposes of this Part,”, insert “(1)”.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-75-norm"
        }
      ],
      "cml:integrityHash": "956bc8e168b4087ac696586d1a4b64f93ef7c944a7f5d1575425c81e272dcbae",
      "skos:note": "Insertion of '(1)' before 'For the purposes of this Part'"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-75",
      "@type": "cof:Section",
      "cof:title": "75 Section 360J",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Before “For the purposes of this Part,”, insert “(1)”."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-75-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
