    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "142(15) At the end of section 360U",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-142-ss-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.50",
      "values:originalText": "(15) A statutory infrastructure provider must meet or exceed a\nminimum benchmark set by an instrument under subsection (11).",
      "skos:definition": "(15) A statutory infrastructure provider must meet or exceed a\nminimum benchmark set by an instrument under subsection (11).",
      "values:partOf": {
        "@id": "concept:c2024a00036-sch-1-sec-142"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-142-ss-15-norm"
