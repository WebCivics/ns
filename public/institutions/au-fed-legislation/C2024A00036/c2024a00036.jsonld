      },
      "dc:source": "c2024a00036.pdf, p.49",
      "values:originalText": "Add:\nNote 1:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\nNote 2:\nSee also section 589 (instruments under this Act may provide for\nmatters by reference to other instruments).",
      "skos:definition": "Add:\nNote 1:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\nNote 2:\nSee also section 589 (instruments under this Act may provide for\nmatters by reference to other instruments).",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-138-norm"
        }
      ],
      "cml:integrityHash": "64feca130728b74abd82e4b0c4d4b821858fb85e06b7612e9bc2bed7f27efb6b",
      "skos:note": "References other instruments for variation and revocation"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-138",
      "@type": "cof:Section",
      "cof:title": "138 At the end of subsection 360U(1)",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Add:\nNote 1:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\nNote 2:\nSee also section 589 (instruments under this Act may provide for\nmatters by reference to other instruments)."
    },
