    {
      "@id": "concept:c2024a00036-sch-3-sec-59da-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "59DA(3) Disclosure of information that relates to the affairs of a",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-3-sec-59da-ss-3"
      },
