        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-15-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to meet or exceed a minimum benchmark",
      "cml:executionSurface": "modalities::logic::deontic",
