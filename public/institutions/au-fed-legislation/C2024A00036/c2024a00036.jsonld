        }
      ],
      "cml:integrityHash": "fc065a56148e343e31b4a3eb3454c4375bab5de7fcedaa876e42414b75074d88",
      "skos:note": "Must consider relevant guidelines when exercising powers."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-5-sec-572m-ss-1",
      "@type": "cof:Section",
