      "dc:source": "c2024a00036.pdf, p.52",
      "values:originalText": "Insert:\n(1AA) Rules under subsection (1) may be of general application or may\nbe limited as provided in the rules.\n(1AB) Subsection (1AA) of this section does not, by implication, limit\nsubsection 33(3A) of the Acts Interpretation Act 1901.",
      "skos:definition": "Insert:\n(1AA) Rules under subsection (1) may be of general application or may\nbe limited as provided in the rules.\n(1AB) Subsection (1AA) of this section does not, by implication, limit\nsubsection 33(3A) of the Acts Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-145-norm"
        }
      ],
      "cml:integrityHash": "a426698630aceb62fcbf5c245f033c3254a0147b0698b648c281c61142126560",
      "skos:note": "Rules under subsection (1) may be of general application or may be limited."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-145",
      "@type": "cof:Section",
      "cof:title": "145 After subsection 360V(1)",
      "values:kind": "section",
