      "skos:note": "Modify 'For the purposes of the application of this Part after the start of\nthe designated day, the' to '(1) For the purposes of this Part,\nthe'"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-23",
