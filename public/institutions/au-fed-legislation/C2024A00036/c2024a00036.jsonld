      ],
      "cml:integrityHash": "4dab61d953841d5df1cb24d6b0b7453190da87955e9560a9310f491db8ff711c",
      "skos:note": "The Minister may determine conditions under which this section has effect as if certain areas were service areas."
    },
    {
