    {
      "@id": "concept:c2024a00036-sch-4-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Subsection 12A(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-4-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.79",
      "values:originalText": "Repeal the subsection, substitute:\n\nSchedule 4  Primary universal service providers\n\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\nNo. 36, 2024\n(3) In exercising the Minister’s powers under this section in relation to\na service obligation, the Minister must ensure that at all times each\npoint in Australia is within a service area for which there is at least\none primary universal service provider in respect of that service\nobligation.",
      "skos:definition": "Repeal the subsection, substitute:\n\nSchedule 4  Primary universal service providers\n\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\nNo. 36, 2024\n(3) In exercising the Minister’s powers under this section in relation to\na service obligation, the Minister must ensure that at all times each\npoint in Australia is within a service area for which there is at least\none primary universal service provider in respect of that service\nobligation.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-4-sec-6-norm"
        },
        {
          "@id": "concept:c2024a00036-sch-4-sec-6-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1ed76c5e16d4408c8b165566b51ba2295d013d510b1cebbc287599bb3ad06f15",
      "skos:note": "Ensure at all times each point in Australia is within a service area for which there is at least one primary universal service provider."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-4-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Subsection 12A(3)",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "Repeal the subsection, substitute:\n\nSchedule 4  Primary universal service providers\n\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\nNo. 36, 2024\n(3) In exercising the Minister’s powers under this section in relation to\na service obligation, the Minister must ensure that at all times each\npoint in Australia is within a service area for which there is at least\none primary universal service provider in respect of that service\nobligation."
    },
