      ],
      "cml:integrityHash": "0122cde534b6b51297754c5b9afd4e8a829281923c2cc9c405484eee8089dced",
      "skos:note": "Damages for breach of a designated compensable standard"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-360vd",
      "@type": "cof:Section",
      "cof:title": "360VD Damages for breach of a designated compensable standard",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "or designated compensable rule\n(1) If:\n(a) a statutory infrastructure provider contravenes a designated\ncompensable standard; and\n(b) the standard is determined under subsection 360U(1); and\n\nSchedule 1  Statutory infrastructure providers"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360vd-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
