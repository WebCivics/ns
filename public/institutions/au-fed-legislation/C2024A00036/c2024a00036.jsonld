      "cml:operator": "CONTAINS",
      "cml:logicSummary": "Temporal interval of a reasonable period",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(3) The period stated for compliance with the remedial notice must be\nreasonable in all the circumstances.",
      "cml:conclusionText": "The period contains a temporal interval"
    },
    {
