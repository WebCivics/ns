      "skos:note": "Must provide explanatory material to statutory infrastructure providers. Must cooperate and provide assistance during compliance audit",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-156-ss-3",
