    {
      "@id": "concept:c2024a00036-sch-1-sec-133",
      "@type": "cml:Concept",
      "skos:prefLabel": "133 Paragraph 360R(3)(d)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-133"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.46",
      "values:originalText": "Repeal the paragraph, substitute:\n(d) do so:\n(i) if it is reasonably practicable for the notice to be given\nat least 90 days before the time when the first person\n\nStatutory infrastructure providers  Schedule 1\nAmendments  Part 1\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\nbecomes no longer able to fulfil the first person’s\nobligations under section 360P or 360Q—at least 90\ndays before that time; or\n(ii) in any other case—not later than 10 business days after\nthe time when the other person becomes the statutory\ninfrastructure provider for the area.",
      "skos:definition": "Repeal the paragraph, substitute:\n(d) do so:\n(i) if it is reasonably practicable for the notice to be given\nat least 90 days before the time when the first person\n\nStatutory infrastructure providers  Schedule 1\nAmendments  Part 1\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\nbecomes no longer able to fulfil the first person’s\nobligations under section 360P or 360Q—at least 90\ndays before that time; or\n(ii) in any other case—not later than 10 business days after\nthe time when the other person becomes the statutory\ninfrastructure provider for the area.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-133-norm"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-133-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "eddabbd6411530f22183f2726f6621890ae060981337409767e6bc540e064c26",
      "skos:note": "Statutory infrastructure providers must give notice at least 90 days before ceasing to fulfill obligations.",
      "dc:description": "Notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-133",
      "@type": "cof:Section",
      "cof:title": "133 Paragraph 360R(3)(d)",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "Repeal the paragraph, substitute:\n(d) do so:\n(i) if it is reasonably practicable for the notice to be given\nat least 90 days before the time when the first person\n\nStatutory infrastructure providers  Schedule 1\nAmendments  Part 1\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\nbecomes no longer able to fulfil the first person’s\nobligations under section 360P or 360Q—at least 90\ndays before that time; or\n(ii) in any other case—not later than 10 business days after\nthe time when the other person becomes the statutory\ninfrastructure provider for the area."
    },
