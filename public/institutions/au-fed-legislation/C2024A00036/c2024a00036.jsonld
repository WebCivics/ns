        }
      ],
      "cml:integrityHash": "b16b4345d4c8e2e37cd9d4f6714be912ff033c6193980e137139de841776a908",
      "skos:note": "Annotate or remove notice from Register"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-163-ss-4",
      "@type": "cof:Section",
      "cof:title": "163(4) At the end of section 360Z",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(4) If an area specified in a notice given under a provision mentioned\nin paragraph (1)(c) consists of, or is included in, a nominated\nservice area, the ACMA may:\n(a) annotate the copy of the notice that is included in the\nRegister with a statement to the effect that the area specified\nin the notice consists of, or is included in, a specified\nnominated service area; or\n(b) remove the notice from the Register."
    },
