      "cml:operator": "canVetoAction",
      "cml:logicSummary": "Can veto action",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(ii) the first person, either alone or together with an associate of the first person, is in a position to veto any action taken by the board of directors of the company;",
      "cml:conclusionText": "The first person can veto an action taken by the board of directors."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ad-ss-1-logic-alleninterval-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "During certain periods",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) a company other than the first person legally or beneficially owns the facility (whether alone or together with one or more other persons), and:",
      "cml:conclusionText": "The first person can exercise control of the facility during certain periods."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ad-ss-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "mustExerciseControl",
      "cml:logicSummary": "Must exercise control",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) the first person is in a position, either alone or together with an associate of the first person, to exercise control of the company;",
      "cml:conclusionText": "The first person must exercise control of the company."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ad-ss-2",
