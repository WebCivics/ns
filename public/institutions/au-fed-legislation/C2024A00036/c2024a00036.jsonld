      },
      "dc:source": "c2024a00036.pdf, p.75",
      "values:originalText": "(5) A disclosure under subsection (1), (2) or (3) may involve\ndisclosing the identity of a carrier or carriage service provider.",
      "skos:definition": "(5) A disclosure under subsection (1), (2) or (3) may involve\ndisclosing the identity of a carrier or carriage service provider.",
      "values:partOf": {
        "@id": "concept:c2024a00036-sch-3-sec-59da"
      },
      "cml:asserts": [
