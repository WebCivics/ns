    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-78-ss-1a-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Carriage service provider's declaration applies during provisional nominated service area period.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an area is a provisional nominated service area because of a declaration made by a carriage service provider under section 360HB;",
      "cml:conclusionText": "the carriage service provider's declaration applies during the provisional nominated service area period."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-78-ss-1a-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Carriage service provider is statutory infrastructure provider for nominated service area.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the whole or a part of the provisional nominated service area is a nominated service area;",
      "cml:conclusionText": "the carriage service provider is the statutory infrastructure provider for the nominated service area."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-78-ss-1a-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Carriage service provider's declaration applies to nominated service area.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) an area is a provisional nominated service area because of a declaration made by a carriage service provider under section 360HB;",
      "cml:conclusionText": "the carriage service provider's declaration applies to the nominated service area."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-78-ss-1b",
      "@type": "cml:Concept",
      "skos:prefLabel": "78(1B) After subsection 360K(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-78-ss-1b"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.32",
      "values:originalText": "(1B) The Minister may, by legislative instrument, declare that:\n(a) subsection (1A) does not apply to a specified nominated\nservice area; and\n(b) a specified carriage service provider is the statutory\ninfrastructure provider for the nominated service area for the\npurposes of this Part.\nNote:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.",
      "skos:definition": "(1B) The Minister may, by legislative instrument, declare that:\n(a) subsection (1A) does not apply to a specified nominated\nservice area; and\n(b) a specified carriage service provider is the statutory\ninfrastructure provider for the nominated service area for the\npurposes of this Part.\nNote:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.",
      "values:partOf": {
        "@id": "concept:c2024a00036-sch-1-sec-78"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-78-ss-1b-norm"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-78-ss-1b-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "743b36270681122896098e16610b4c26c0d29a54ca69a6c3a842056f4bb5b8e8",
      "skos:note": "Minister may declare exemptions or designations for nominated service areas."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-78-ss-1b",
      "@type": "cof:Section",
      "cof:title": "78(1B) After subsection 360K(1)",
      "values:kind": "subsection",
      "cof:pageNumber": 32,
      "values:originalText": "(1B) The Minister may, by legislative instrument, declare that:\n(a) subsection (1A) does not apply to a specified nominated\nservice area; and\n(b) a specified carriage service provider is the statutory\ninfrastructure provider for the nominated service area for the\npurposes of this Part.\nNote:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901."
    },
