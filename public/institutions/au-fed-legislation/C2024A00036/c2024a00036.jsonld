    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-14",
      "@type": "cml:Concept",
      "skos:prefLabel": "142(14) At the end of section 360U",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-142-ss-14"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
