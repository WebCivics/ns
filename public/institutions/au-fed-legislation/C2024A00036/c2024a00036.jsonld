    {
      "@id": "concept:c2024a00036-sch-1-sec-127",
      "@type": "cml:Concept",
      "skos:prefLabel": "127 Paragraph 360R(2)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-127"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.46",
      "values:originalText": "Repeal the paragraph, substitute:\n(b) do so:\n(i) if it is reasonably practicable for the notice to be given\nat least 12 months before the time when the first person\nwill become no longer able to fulfil the first person’s\nobligations under section 360P or 360Q—at least 12\nmonths before that time; or\n(ii) in any other case—not later than 10 business days after\nthe time when the first person becomes no longer able to\nfulfil the first person’s obligations under section 360P or\n360Q.",
      "skos:definition": "Repeal the paragraph, substitute:\n(b) do so:\n(i) if it is reasonably practicable for the notice to be given\nat least 12 months before the time when the first person\nwill become no longer able to fulfil the first person’s\nobligations under section 360P or 360Q—at least 12\nmonths before that time; or\n(ii) in any other case—not later than 10 business days after\nthe time when the first person becomes no longer able to\nfulfil the first person’s obligations under section 360P or\n360Q.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-127-norm"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-127-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8afa487cc458840f3fca9addb77966908fb6ca06314019336ec8392ffb08ceb1",
      "skos:note": "Notice must be given at least 12 months before the first person can no longer fulfill their obligations."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-127",
      "@type": "cof:Section",
      "cof:title": "127 Paragraph 360R(2)(b)",
      "values:kind": "section",
      "cof:pageNumber": 46,
      "values:originalText": "Repeal the paragraph, substitute:\n(b) do so:\n(i) if it is reasonably practicable for the notice to be given\nat least 12 months before the time when the first person\nwill become no longer able to fulfil the first person’s\nobligations under section 360P or 360Q—at least 12\nmonths before that time; or\n(ii) in any other case—not later than 10 business days after\nthe time when the first person becomes no longer able to\nfulfil the first person’s obligations under section 360P or\n360Q."
    },
