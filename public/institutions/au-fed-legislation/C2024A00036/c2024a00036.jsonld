    {
      "@id": "concept:c2024a00036-sch-1-sec-360vh",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VH Compensation rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-360vh"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.58",
      "values:originalText": "The Minister may, by legislative instrument, make rules\n(compensation rules) prescribing matters required or permitted by\nthis Division to be prescribed by the compensation rules.\nNote:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.",
      "skos:definition": "The Minister may, by legislative instrument, make rules\n(compensation rules) prescribing matters required or permitted by\nthis Division to be prescribed by the compensation rules.\nNote:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-360vh-norm"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-360vh-logic-deontic-1"
        },
        {
