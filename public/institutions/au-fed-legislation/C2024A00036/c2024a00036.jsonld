    {
      "@id": "concept:c2024a00036-sch-1-sec-360vg",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VG Savings of other laws and remedies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-360vg"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.58",
      "values:originalText": "(1) This Division is not intended to exclude or limit the concurrent\noperation of any law of a State or Territory.\n(2) This Division does not limit, restrict or otherwise affect any right\nor remedy a person would have if this Division had not been\nenacted.\n(3) This Division does not limit, restrict or otherwise affect the\noperation of the Telecommunications Industry Ombudsman\nscheme. In particular, this Division does not affect a customer’s\nright to complain to the Telecommunications Industry\nOmbudsman.\n(4) Subsection (3) does not, by implication, limit subsection (2).",
      "skos:definition": "(1) This Division is not intended to exclude or limit the concurrent\noperation of any law of a State or Territory.\n(2) This Division does not limit, restrict or otherwise affect any right\nor remedy a person would have if this Division had not been\nenacted.\n(3) This Division does not limit, restrict or otherwise affect the\noperation of the Telecommunications Industry Ombudsman\nscheme. In particular, this Division does not affect a customer’s\nright to complain to the Telecommunications Industry\nOmbudsman.\n(4) Subsection (3) does not, by implication, limit subsection (2).",
      "cml:hasPart": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-360vg-ss-1"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-360vg-ss-2"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-360vg-ss-3"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-360vg-ss-4"
        }
      ],
      "cml:integrityHash": "3db1ddd4c85336cb023a38a524ef4d31b9c22c4e5f1cfdf5256e28cb310500c6"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-360vg",
      "@type": "cof:Section",
      "cof:title": "360VG Savings of other laws and remedies",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "(1) This Division is not intended to exclude or limit the concurrent\noperation of any law of a State or Territory.\n(2) This Division does not limit, restrict or otherwise affect any right\nor remedy a person would have if this Division had not been\nenacted.\n(3) This Division does not limit, restrict or otherwise affect the\noperation of the Telecommunications Industry Ombudsman\nscheme. In particular, this Division does not affect a customer’s\nright to complain to the Telecommunications Industry\nOmbudsman.\n(4) Subsection (3) does not, by implication, limit subsection (2)."
    },
