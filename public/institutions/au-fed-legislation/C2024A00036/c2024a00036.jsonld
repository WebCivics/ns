    {
      "@id": "concept:c2024a00036-sch-4-sec-14-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "14(6) At the end of section 12D",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-4-sec-14-ss-6"
