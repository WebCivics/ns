      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Statutory infrastructure providers must comply with designated compensable standards",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
