    {
      "@id": "concept:c2024a00036-sch-3-sec-59da-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "59DA(7) Disclosure of information that relates to the affairs of a",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-3-sec-59da-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.75",
      "values:originalText": "(7) Subsections (1), (2) and (3) do not authorise the disclosure of\nanything that is likely to enable the identification of an end-user of\na carriage service.",
      "skos:definition": "(7) Subsections (1), (2) and (3) do not authorise the disclosure of\nanything that is likely to enable the identification of an end-user of\na carriage service.",
      "values:partOf": {
        "@id": "concept:c2024a00036-sch-3-sec-59da"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-3-sec-59da-ss-7-norm"
        },
        {
          "@id": "concept:c2024a00036-sch-3-sec-59da-ss-7-logic-deontic-1"
        },
        {
          "@id": "concept:c2024a00036-sch-3-sec-59da-ss-7-logic-alleninterval-2"
        },
        {
          "@id": "concept:c2024a00036-sch-3-sec-59da-ss-7-logic-ltl-3"
