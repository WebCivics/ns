      "skos:note": "Does not limit disclosure under other provisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-3-sec-59da-ss-6",
      "@type": "cof:Section",
      "cof:title": "59DA(6) Disclosure of information that relates to the affairs of a",
