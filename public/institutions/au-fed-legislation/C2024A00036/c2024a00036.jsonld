      }
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-76",
      "@type": "cml:Concept",
      "skos:prefLabel": "76 At the end of section 360J",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-76"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.31",
      "values:originalText": "Add:\n(2) Subsection (1) has effect subject to subsections (3) and (4).\n(3) The Minister may, by legislative instrument, declare that a\nspecified development area mentioned in subsection (1) is not a\nnominated service area for the purposes of this Part.\nNote:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\n(4) The Minister may, by legislative instrument, declare that:\n(a) a specified development area mentioned in subsection (1) is\nnot a nominated service area for the purposes of this Part;\nand\n(b) a specified area is a nominated service area for the purposes\nof this Part.\nNote 1:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\nNote 2:\nFor the format of the description of the area, see section 360LA.\n(5) An area must not be specified in a declaration in accordance with\nparagraph (4)(b) unless at least one point in the area is also a point\nin the development area specified in the declaration in accordance\nwith paragraph (4)(a).",
      "skos:definition": "Add:\n(2) Subsection (1) has effect subject to subsections (3) and (4).\n(3) The Minister may, by legislative instrument, declare that a\nspecified development area mentioned in subsection (1) is not a\nnominated service area for the purposes of this Part.\nNote:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\n(4) The Minister may, by legislative instrument, declare that:\n(a) a specified development area mentioned in subsection (1) is\nnot a nominated service area for the purposes of this Part;\nand\n(b) a specified area is a nominated service area for the purposes\nof this Part.\nNote 1:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\nNote 2:\nFor the format of the description of the area, see section 360LA.\n(5) An area must not be specified in a declaration in accordance with\nparagraph (4)(b) unless at least one point in the area is also a point\nin the development area specified in the declaration in accordance\nwith paragraph (4)(a).",
      "cml:hasPart": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-76-ss-2"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-76-ss-3"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-76-ss-4"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-76-ss-5"
        }
      ],
      "cml:integrityHash": "f552a1e79bdc74d313b3f0f000e309faa363c9b81f8db6b9d0fb2b41f0dcea48"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-76",
      "@type": "cof:Section",
      "cof:title": "76 At the end of section 360J",
      "values:kind": "section",
      "cof:pageNumber": 31,
      "values:originalText": "Add:\n(2) Subsection (1) has effect subject to subsections (3) and (4).\n(3) The Minister may, by legislative instrument, declare that a\nspecified development area mentioned in subsection (1) is not a\nnominated service area for the purposes of this Part.\nNote:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\n(4) The Minister may, by legislative instrument, declare that:\n(a) a specified development area mentioned in subsection (1) is\nnot a nominated service area for the purposes of this Part;\nand\n(b) a specified area is a nominated service area for the purposes\nof this Part.\nNote 1:\nFor variation and revocation, see subsection 33(3) of the Acts\nInterpretation Act 1901.\nNote 2:\nFor the format of the description of the area, see section 360LA.\n(5) An area must not be specified in a declaration in accordance with\nparagraph (4)(b) unless at least one point in the area is also a point\nin the development area specified in the declaration in accordance\nwith paragraph (4)(a)."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-76-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "76(2) At the end of section 360J",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-76-ss-2"
