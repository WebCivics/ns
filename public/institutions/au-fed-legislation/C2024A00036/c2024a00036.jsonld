          "@id": "concept:c2024a00036-sch-1-sec-142-ss-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "45497c53a5e533fabd23fb0132fe3e1239236d5a6bc95f2118983c5eb397c996",
      "skos:note": "Must meet or exceed a minimum benchmark set by an instrument under subsection (11)",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-142-ss-15",
      "@type": "cof:Section",
      "cof:title": "142(15) At the end of section 360U",
      "values:kind": "subsection",
      "cof:pageNumber": 50,
      "values:originalText": "(15) A statutory infrastructure provider must meet or exceed a\nminimum benchmark set by an instrument under subsection (11)."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-142-ss-15-norm",
      "@type": "values:Obligation",
      "cml:modality": {
