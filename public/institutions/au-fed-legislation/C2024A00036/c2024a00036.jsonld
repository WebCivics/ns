        }
      ],
      "cml:integrityHash": "e8315ebbbd6f755cd40daed466ea56d6c770fb30258fb059d0b24db38fda4a7f",
      "skos:note": "Disclosure of information that relates to the affairs of a carriage service is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-3-sec-59da-ss-7",
      "@type": "cof:Section",
      "cof:title": "59DA(7) Disclosure of information that relates to the affairs of a",
      "values:kind": "subsection",
      "cof:pageNumber": 75,
      "values:originalText": "(7) Subsections (1), (2) and (3) do not authorise the disclosure of\nanything that is likely to enable the identification of an end-user of\na carriage service."
    },
    {
      "@id": "concept:c2024a00036-sch-3-sec-59da-ss-7-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
