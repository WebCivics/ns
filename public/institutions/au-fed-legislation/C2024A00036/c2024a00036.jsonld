      },
      "dc:source": "c2024a00036.pdf, p.14",
      "values:originalText": "Omit “For the purposes of the application of this Part after the start of\nthe designated day, the”, substitute “(1) For the purposes of this Part,\nthe”.",
      "skos:definition": "Omit “For the purposes of the application of this Part after the start of\nthe designated day, the”, substitute “(1) For the purposes of this Part,\nthe”.",
