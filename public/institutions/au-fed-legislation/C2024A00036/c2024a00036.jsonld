    {
      "@id": "concept:c2024a00036-sch-1-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Section 360A",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.8",
      "values:originalText": "Insert:\nradiocommunications fixed voice call means a voice call provided\nusing a carriage service:\n\nStatutory infrastructure providers  Schedule 1\nAmendments  Part 1\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\n(a) supplied by means of a telecommunications network other\nthan a fixed-line telecommunications network; and\n(b) marketed to customers, or potential customers, as a carriage\nservice that enables end-users to make and receive voice calls\nat premises occupied or used by the end-users.",
      "skos:definition": "Insert:\nradiocommunications fixed voice call means a voice call provided\nusing a carriage service:\n\nStatutory infrastructure providers  Schedule 1\nAmendments  Part 1\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\n(a) supplied by means of a telecommunications network other\nthan a fixed-line telecommunications network; and\n(b) marketed to customers, or potential customers, as a carriage\nservice that enables end-users to make and receive voice calls\nat premises occupied or used by the end-users.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-13-norm"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-13-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-13-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-13-logic-alleninterval-3"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-13-logic-ltl-4"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-13-logic-deontic-5"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-13-logic-deontic-6"
        }
      ],
      "cml:integrityHash": "515ea041bb8b3300ec4db75548093f0ee3c948d4db3dad684cdbe9d090e9f271",
      "skos:note": "Definition of radiocommunications fixed voice call"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Section 360A",
      "values:kind": "section",
      "cof:pageNumber": 8,
      "values:originalText": "Insert:\nradiocommunications fixed voice call means a voice call provided\nusing a carriage service:\n\nStatutory infrastructure providers  Schedule 1\nAmendments  Part 1\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024\n(a) supplied by means of a telecommunications network other\nthan a fixed-line telecommunications network; and\n(b) marketed to customers, or potential customers, as a carriage\nservice that enables end-users to make and receive voice calls\nat premises occupied or used by the end-users."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-13-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2024a00036-sch-1-sec-13"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-13-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "radiocommunications fixed voice call is a subclass of carriage service",
      "cml:conclusionText": "carriage service is a superclass of radiocommunications fixed voice call"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-13-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "radiocommunications fixed voice call is a subclass of telecommunications network",
      "cml:conclusionText": "telecommunications network is a superclass of radiocommunications fixed voice call"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-13-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Temporal relation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "radiocommunications fixed voice call is provided using a carriage service",
      "cml:conclusionText": "carriage service is provided before radiocommunications fixed voice call"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-13-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Recurring trace",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "radiocommunications fixed voice call is marketed to customers",
      "cml:conclusionText": "customers are marketed before radiocommunications fixed voice call"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-13-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "end-users must be able to make and receive voice calls at premises occupied or used by the end-users",
      "cml:conclusionText": "end-users have a duty to make and receive voice calls at premises occupied or used by the end-users"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-13-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Duty",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "statutory infrastructure providers must supply radiocommunications fixed voice call using a telecommunications network other than a fixed-line telecommunications network",
      "cml:conclusionText": "statutory infrastructure providers have a duty to supply radiocommunications fixed voice call using a telecommunications network other than a fixed-line telecommunications network"
    },
    {
