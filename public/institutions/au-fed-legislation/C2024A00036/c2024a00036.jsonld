    {
      "@id": "concept:c2024a00036-sch-4-sec-8c",
      "@type": "cml:Concept",
      "skos:prefLabel": "8C Meaning of service area",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-4-sec-8c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.79",
      "values:originalText": "For the purposes of this Part, a service area is:\n(a) a geographical area within Australia; or\n(b) any area of land; or\n(c) any premises or part of premises;\nregardless of size.",
      "skos:definition": "For the purposes of this Part, a service area is:\n(a) a geographical area within Australia; or\n(b) any area of land; or\n(c) any premises or part of premises;\nregardless of size.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-4-sec-8c-norm"
        }
      ],
      "cml:integrityHash": "bcee7f588b5f16492f603d885eaf6b279865d2dfe90f538bad50c89b2a82924f",
      "skos:note": "Definition of service area"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-4-sec-8c",
      "@type": "cof:Section",
      "cof:title": "8C Meaning of service area",
      "values:kind": "section",
      "cof:pageNumber": 79,
      "values:originalText": "For the purposes of this Part, a service area is:\n(a) a geographical area within Australia; or\n(b) any area of land; or\n(c) any premises or part of premises;\nregardless of size."
    },
    {
