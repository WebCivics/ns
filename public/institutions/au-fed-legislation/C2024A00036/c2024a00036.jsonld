    {
      "@id": "concept:c2024a00036-sch-1-sec-146",
      "@type": "cml:Concept",
      "skos:prefLabel": "146 After subsection 360V(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-146"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.52",
      "values:originalText": "Insert:\n(1B) Rules under subsection (1) may declare that a specified rule set out\nin those rules is a designated compensable rule for the purposes of\nthis Part.\n(1C) Rules under subsection (1) may declare that a specified number of\ndays is the relevant number of days for the purposes of the\napplication of subsection 360VE(1) to a specified designated\ncompensable rule.\n(1D) Subsection (1) does not, by implication, limit the power to\ndetermine standards under subsection 360U(1).",
      "skos:definition": "Insert:\n(1B) Rules under subsection (1) may declare that a specified rule set out\nin those rules is a designated compensable rule for the purposes of\nthis Part.\n(1C) Rules under subsection (1) may declare that a specified number of\ndays is the relevant number of days for the purposes of the\napplication of subsection 360VE(1) to a specified designated\ncompensable rule.\n(1D) Subsection (1) does not, by implication, limit the power to\ndetermine standards under subsection 360U(1).",
      "cml:hasPart": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-146-ss-1b"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-146-ss-1c"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-146-ss-1d"
        }
      ],
      "cml:integrityHash": "8445d5cfe714f4491bdd7be3a32948e53e2a96ef2d6d75ca8d501fbc73a359c4"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-146",
      "@type": "cof:Section",
      "cof:title": "146 After subsection 360V(1A)",
      "values:kind": "section",
      "cof:pageNumber": 52,
      "values:originalText": "Insert:\n(1B) Rules under subsection (1) may declare that a specified rule set out\nin those rules is a designated compensable rule for the purposes of\nthis Part.\n(1C) Rules under subsection (1) may declare that a specified number of\ndays is the relevant number of days for the purposes of the\napplication of subsection 360VE(1) to a specified designated\ncompensable rule.\n(1D) Subsection (1) does not, by implication, limit the power to\ndetermine standards under subsection 360U(1)."
    },
