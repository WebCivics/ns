    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-24",
      "@type": "cof:Section",
      "cof:title": "24 After paragraph 360F(a)",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "Insert:\n(aa) a pending area (see subsection (2)); or\n(ab) an anticipated service area; or\n\nStatutory infrastructure providers  Schedule 1\nAmendments  Part 1\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024"
    },
    {
