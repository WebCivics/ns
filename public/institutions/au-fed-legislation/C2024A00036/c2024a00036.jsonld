        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Statutory infrastructure provider has an obligation to consider reasonable basis for dispute of liability",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) In making a decision under subsection (1)",
      "cml:conclusionText": "must have regard to whether there is any reasonable basis for the statutory infrastructure provider to dispute the liability."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Temporal relation",
      "cml:logicSummary": "Temporal relation between decision-making and consideration of reasonable basis",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) In making a decision under subsection (1)",
      "cml:conclusionText": "The statutory infrastructure provider must consider the reasonable basis for dispute of liability at the time of decision-making."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Recurring trace",
      "cml:logicSummary": "Recurring trace of consideration of reasonable basis",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) In making a decision under subsection (1)",
      "cml:conclusionText": "The statutory infrastructure provider must consider the reasonable basis for dispute of liability in a recurring manner."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffusive relation",
      "cml:logicSummary": "Diffusive relation between decision-making and consideration of reasonable basis",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) In making a decision under subsection (1)",
      "cml:conclusionText": "The statutory infrastructure provider must diffuse the consideration of the reasonable basis for dispute of liability."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Knowledge representation",
      "cml:logicSummary": "Knowledge representation of statutory infrastructure providers and their obligations",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) In making a decision under subsection (1)",
      "cml:conclusionText": "The statutory infrastructure provider must represent the reasonable basis for dispute of liability in its knowledge base."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "360VE(3) Time for payment of damages",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-360ve-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.55",
      "values:originalText": "(3) If a statutory infrastructure provider makes a decision under\nsubsection (1) not to accept a liability to pay damages to a\nparticular customer, the statutory infrastructure provider must give\nthe customer written notification of the decision within 14 weeks\nafter the decision is made.\n\nSchedule 1  Statutory infrastructure providers",
      "skos:definition": "(3) If a statutory infrastructure provider makes a decision under\nsubsection (1) not to accept a liability to pay damages to a\nparticular customer, the statutory infrastructure provider must give\nthe customer written notification of the decision within 14 weeks\nafter the decision is made.\n\nSchedule 1  Statutory infrastructure providers",
      "values:partOf": {
        "@id": "concept:c2024a00036-sch-1-sec-360ve"
      },
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-3-norm"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "4425ef6eedba7ccdae1cd2e51002c5421ff7f21b8318ed89f38067f5d4425868",
      "skos:note": "Statutory infrastructure provider must notify customer of decision within 14 weeks",
      "dc:description": "Written notification"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-360ve-ss-3",
      "@type": "cof:Section",
      "cof:title": "360VE(3) Time for payment of damages",
      "values:kind": "subsection",
      "cof:pageNumber": 55,
      "values:originalText": "(3) If a statutory infrastructure provider makes a decision under\nsubsection (1) not to accept a liability to pay damages to a\nparticular customer, the statutory infrastructure provider must give\nthe customer written notification of the decision within 14 weeks\nafter the decision is made.\n\nSchedule 1  Statutory infrastructure providers"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:c2024a00036-sch-1-sec-360ve-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
