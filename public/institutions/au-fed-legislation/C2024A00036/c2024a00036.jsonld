    {
      "@id": "concept:c2024a00036-sch-2-sec-372je",
      "@type": "cml:Concept",
      "skos:prefLabel": "372JE Variation of remedial notices",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-2-sec-372je"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.72",
      "values:originalText": "Scope\n(1) This section applies if a person has been given a remedial notice.\nVariation\n(2) The ACMA may, by written notice given to the person, vary the\nnotice.\n(3) The ACMA may also, in accordance with section 372JD, extend\nthe compliance period for a remedial notice.\n\nDeployment of optical fibre  Schedule 2\n\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024",
      "skos:definition": "Scope\n(1) This section applies if a person has been given a remedial notice.\nVariation\n(2) The ACMA may, by written notice given to the person, vary the\nnotice.\n(3) The ACMA may also, in accordance with section 372JD, extend\nthe compliance period for a remedial notice.\n\nDeployment of optical fibre  Schedule 2\n\nNo. 36, 2024\nTelecommunications Legislation Amendment (Enhancing Consumer\nSafeguards and Other Measures) Act 2024",
      "cml:hasPart": [
