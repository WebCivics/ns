      }
    },
    {
      "@id": "concept:c2024a00036-sch-5-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Saving—guidelines under subsection 572M(2) of the",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-5-sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.85",
      "values:originalText": "Telecommunications Act 1997\n(1)\nThis item applies to guidelines that are in force under\nsubsection 572M(2) of the Telecommunications Act 1997 immediately\nbefore the commencement of this item.\n(2)\nThe guidelines continue in force (and may be dealt with), on and after\nthat commencement, as if they had been made under\nsubsection 572M(2) of the Telecommunications Act 1997 as substituted\nby this Schedule.\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "skos:definition": "Telecommunications Act 1997\n(1)\nThis item applies to guidelines that are in force under\nsubsection 572M(2) of the Telecommunications Act 1997 immediately\nbefore the commencement of this item.\n(2)\nThe guidelines continue in force (and may be dealt with), on and after\nthat commencement, as if they had been made under\nsubsection 572M(2) of the Telecommunications Act 1997 as substituted\nby this Schedule.\nTelecommunications (Consumer Protection and Service\nStandards) Act 1999",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-5-sec-8-norm"
        }
      ],
      "cml:integrityHash": "a10c7ecd241ecfcdb44c2beadf23a9aba9f270cec1eb362b3593b81a82e1cef1",
      "skos:note": "Guidelines under subsection 572M(2) of the Telecommunications Act 1997 continue in force after commencement."
    },
    {
