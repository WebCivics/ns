    },
    {
      "@id": "concept:c2024a00036-sch-3-sec-59da-ss-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits disclosure of information that relates to the affairs of a carriage service.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(7) Subsections (1), (2) and (3)",
      "cml:conclusionText": "Nothing in these subsections authorises the disclosure of anything that is likely to enable the identification of an end-user of a carriage service."
    },
    {
      "@id": "concept:c2024a00036-sch-3-sec-59da-ss-7-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Discloses information that overlaps with an end-user's affairs.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
