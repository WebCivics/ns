    {
      "@id": "concept:c2024a00036-sch-1-sec-76-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "76(5) At the end of section 360J",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-76-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
