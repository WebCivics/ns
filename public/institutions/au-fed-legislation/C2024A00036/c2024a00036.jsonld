    {
      "@id": "concept:c2024a00036-sch-1-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Subsections 360H(8) and (9)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.18",
      "values:originalText": "Repeal the subsections, substitute:\nDeclaration to be made available\n(8) If a declaration made by a carrier is in force under this section, the\ncarrier must make a copy of the declaration available on its\nwebsite.\n(9) If a carrier makes a declaration under this section, the carrier must:\n(a) give a copy of the declaration to the ACMA; and\n(b) do so within 10 business days after making the declaration.",
      "skos:definition": "Repeal the subsections, substitute:\nDeclaration to be made available\n(8) If a declaration made by a carrier is in force under this section, the\ncarrier must make a copy of the declaration available on its\nwebsite.\n(9) If a carrier makes a declaration under this section, the carrier must:\n(a) give a copy of the declaration to the ACMA; and\n(b) do so within 10 business days after making the declaration.",
      "cml:hasPart": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-49-ss-8"
        },
        {
          "@id": "concept:c2024a00036-sch-1-sec-49-ss-9"
        }
      ],
      "cml:integrityHash": "a6b9f5ecf0b4463d699deda2a7d8214571978af7b3dd6909a37437f9cce3252c"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Subsections 360H(8) and (9)",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Repeal the subsections, substitute:\nDeclaration to be made available\n(8) If a declaration made by a carrier is in force under this section, the\ncarrier must make a copy of the declaration available on its\nwebsite.\n(9) If a carrier makes a declaration under this section, the carrier must:\n(a) give a copy of the declaration to the ACMA; and\n(b) do so within 10 business days after making the declaration."
    },
