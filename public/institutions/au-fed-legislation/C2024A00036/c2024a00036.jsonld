    {
      "@id": "concept:c2024a00036-sch-1-sec-139",
      "@type": "cml:Concept",
      "skos:prefLabel": "139 After subsection 360U(3A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-139"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
