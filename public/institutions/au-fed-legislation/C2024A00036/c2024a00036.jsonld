    {
      "@id": "concept:c2024a00036-sch-1-sec-360c",
      "@type": "cml:Concept",
      "skos:prefLabel": "360C Service area",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-360c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "c2024a00036.pdf"
      },
      "dc:source": "c2024a00036.pdf, p.14",
      "values:originalText": "For the purposes of this Part, service area means:\n(a) the general service area; or\n(b) a nominated service area; or\n(c) an anticipated service area; or\n(d) a designated service area.",
      "skos:definition": "For the purposes of this Part, service area means:\n(a) the general service area; or\n(b) a nominated service area; or\n(c) an anticipated service area; or\n(d) a designated service area.",
      "cml:asserts": [
        {
          "@id": "concept:c2024a00036-sch-1-sec-360c-norm"
        }
      ],
      "cml:integrityHash": "51d22d8bf5eeb694c345db8e1fa1d054646aaec5982565ad4feb5575945475e7",
      "skos:note": "Definition of service area"
    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-360c",
      "@type": "cof:Section",
      "cof:title": "360C Service area",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "For the purposes of this Part, service area means:\n(a) the general service area; or\n(b) a nominated service area; or\n(c) an anticipated service area; or\n(d) a designated service area."
    },
