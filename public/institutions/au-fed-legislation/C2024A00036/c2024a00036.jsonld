      "cml:premiseText": "(a) the first person legally or beneficially owns the facility",
      "cml:conclusionText": "The first person has control of the facility."
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-360ad-ss-1-logic-deontic-3",
