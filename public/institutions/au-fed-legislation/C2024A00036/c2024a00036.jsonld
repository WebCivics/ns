    {
      "@id": "concept:c2024a00036-sch-1-sec-76-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "76(4) At the end of section 360J",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-76-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
