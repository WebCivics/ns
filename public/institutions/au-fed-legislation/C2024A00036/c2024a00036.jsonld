    },
    {
      "@id": "https://ns.webcivics.net/values/c2024a00036#sch-1-sec-19",
      "@type": "cof:Section",
      "cof:title": "19 Section 360B",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "Repeal the section, substitute:"
    },
    {
      "@id": "concept:c2024a00036-sch-1-sec-19-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
