    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-103-ss-2a-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "...the action service provider must take reasonable steps to ensure that the CDR data is, having regard to the purpose for which it is held, accurate, up to date and complete.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "CDR data has a value (accuracy, completeness)",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "hasValue",
      "cml:premiseText": "(2A) If a person as an action service provider for a type of CDR action is required or authorised under the consumer data rules to disclose CDR data..."
    },
