concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110 a cml:Concept ;
    skos:prefLabel "110 After subsection 56ER(1A)"@en ;
    cml:realizedBy doc:sch-1-sec-110 ;
    values:originalText "Insert: (1B) The Information Commissioner may assess whether an action service provider for a type of CDR action, who has been or may be disclosed CDR data under the consumer data rules, is maintaining and handling the CDR data in accordance with: (a) the privacy safeguards; or (b) the consumer data rules to the extent that those rules relate to: (i) the privacy safeguards; or (ii) the privacy or confidentiality of the CDR data." ;
    skos:definition "Insert: (1B) The Information Commissioner may assess whether an action service provider for a type of CDR action, who has been or may be disclosed CDR data under the consumer data rules, is maintaining and handling the CDR data in accordance with: (a) the privacy safeguards; or (b) the consumer data rules to the extent that those rules relate to: (i) the privacy safeguards; or (ii) the privacy or confidentiality of the CDR data."@en ;
    cml:integrityHash "9248d4ec316e328b5d3b849123112786bdf43dc9266fc697aad634588ad783e4" ;
    cof:pageNumber "49"^^xsd:integer ;
    skos:note "The Information Commissioner may assess an action service provider's compliance with privacy safeguards and consumer data rules." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
