concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-43-ss-1 a cml:Concept ;
    skos:prefLabel "43(1) After section 56AM"@en ;
    cml:realizedBy doc:sch-1-sec-43-ss-1 ;
    values:originalText "(1) A person is an action service provider, for a type of CDR action, if the person: (a) is within a class of data holders (of CDR data) declared in the CDR declaration for that type of CDR action; or (b) is a voluntary action service provider for that type of CDR action.  Schedule 1  Amendments" ;
    skos:definition "(1) A person is an action service provider, for a type of CDR action, if the person: (a) is within a class of data holders (of CDR data) declared in the CDR declaration for that type of CDR action; or (b) is a voluntary action service provider for that type of CDR action.  Schedule 1  Amendments"@en ;
    cml:integrityHash "e0c8ae43ea1effb0bcde5a7c85abcc10ac0c974ccb8060ff8a703d7fa3010647" ;
    values:partOf concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-43 ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Person must be within a class of data holders or voluntary action service provider for CDR action. A CDR action is an action of a type declared under section 56ACA." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2024.pdf> ;
