concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-161 a cml:Concept ;
    skos:prefLabel "161 Subsection 56AS(1)"@en ;
    cml:realizedBy doc:sch-1-sec-161 ;
    values:originalText "Repeal the subsection, substitute: (1) The Minister may, by notifiable instrument, declare that an entity is a participating entity, for a State or Territory, in one or more of the following specified capacities: (a) as a data holder of CDR data; (b) as an accredited person; (c) as a designated gateway for CDR data; (d) as an action service provider for a type of CDR action. Note: An entity may be declared by class (see subsection 13(3) of the Legislation Act 2003)." ;
    skos:definition "Repeal the subsection, substitute: (1) The Minister may, by notifiable instrument, declare that an entity is a participating entity, for a State or Territory, in one or more of the following specified capacities: (a) as a data holder of CDR data; (b) as an accredited person; (c) as a designated gateway for CDR data; (d) as an action service provider for a type of CDR action. Note: An entity may be declared by class (see subsection 13(3) of the Legislation Act 2003)."@en ;
    cml:integrityHash "b326a47f8fc5cdfefa0de8dedaa4350e73bbb60e3300da9e14ed3f43b0ea4d55" ;
    cof:pageNumber "58"^^xsd:integer ;
    skos:note "Declare entity as participating entity in specified capacities." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
