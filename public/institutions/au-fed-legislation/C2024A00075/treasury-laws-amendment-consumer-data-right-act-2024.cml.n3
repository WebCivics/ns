concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-95 a cml:Concept ;
    skos:prefLabel "95 After subsection 56ED(6)"@en ;
    cml:realizedBy doc:sch-1-sec-95 ;
    values:originalText "Insert: (6A) If the CDR entity is a person who, as an action service provider for a type of CDR action, has been or may be disclosed CDR data under the consumer data rules, the CDR entity’s policy must contain the following information: (a) how a CDR consumer for the CDR data may access the CDR data and seek the correction of the CDR data; (b) how a CDR consumer for the CDR data may complain about a failure of the CDR entity to comply with this Part or the consumer data rules, and how the CDR entity will deal with such a complaint." ;
    skos:definition "Insert: (6A) If the CDR entity is a person who, as an action service provider for a type of CDR action, has been or may be disclosed CDR data under the consumer data rules, the CDR entity’s policy must contain the following information: (a) how a CDR consumer for the CDR data may access the CDR data and seek the correction of the CDR data; (b) how a CDR consumer for the CDR data may complain about a failure of the CDR entity to comply with this Part or the consumer data rules, and how the CDR entity will deal with such a complaint."@en ;
    cml:integrityHash "2ee3c3e6d9c89c57320d8d689cc4388d01886a661ce2b952d6cfd7a79526e4c2" ;
    cof:pageNumber "43"^^xsd:integer ;
    skos:note "CDR entity must provide information to consumers about access and complaint procedures." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
