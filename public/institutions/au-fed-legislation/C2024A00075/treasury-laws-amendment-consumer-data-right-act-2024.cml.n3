concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-56ef a cml:Concept ;
    skos:prefLabel "56EF Privacy safeguard 3—soliciting CDR data from participants"@en ;
    cml:realizedBy doc:sch-1-sec-56ef ;
    values:originalText "under the consumer data rules (1) A person covered by column 1 of an item of the following table must not seek to collect CDR data under the consumer data rules from another person covered by column 2 of that item unless:  Schedule 1  Amendments" ;
    skos:definition "under the consumer data rules (1) A person covered by column 1 of an item of the following table must not seek to collect CDR data under the consumer data rules from another person covered by column 2 of that item unless:  Schedule 1  Amendments"@en ;
    cml:integrityHash "02434264bfa33cb173f97563705cb0f95de3d312b967ddee3ddb784750204dd9" ;
    cof:pageNumber "43"^^xsd:integer ;
    skos:note "No one can collect CDR data from another person unless specified in Schedule 1 Amendments" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2024.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.43" ;
    cml:asserts concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-56ef-norm .
