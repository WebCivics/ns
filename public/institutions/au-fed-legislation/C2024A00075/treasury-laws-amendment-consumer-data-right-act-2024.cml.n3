concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-54 a cml:Concept ;
    skos:prefLabel "54 Subsection 56BD(1) (note 1)"@en ;
    cml:realizedBy doc:sch-1-sec-54 ;
    values:originalText "Repeal the note, substitute: Note 1: This means CDR data cannot be required to be disclosed if it is only CDR data because it is directly or indirectly derived from: (a) other CDR data within a class specified, as described in paragraph 56AC(2)(a), in an instrument designating a sector under subsection 56AC(2); or (b) other CDR data, about a CDR consumer for a CDR action, that an accredited action initiator is authorised to use to prepare or give a valid instruction for the performance of the CDR action." ;
    skos:definition "Repeal the note, substitute: Note 1: This means CDR data cannot be required to be disclosed if it is only CDR data because it is directly or indirectly derived from: (a) other CDR data within a class specified, as described in paragraph 56AC(2)(a), in an instrument designating a sector under subsection 56AC(2); or (b) other CDR data, about a CDR consumer for a CDR action, that an accredited action initiator is authorised to use to prepare or give a valid instruction for the performance of the CDR action."@en ;
    cml:integrityHash "93cb2a88733906b109094bd204036453aea005cc0aca4a7fc564e47b88a19b32" ;
    cof:pageNumber "20"^^xsd:integer ;
    skos:note "Repeal note and substitute with new definition for CDR data disclosure" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2024.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.20" ;
