concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-183 a cml:Concept ;
    skos:prefLabel "183 Transitional—existing exemptions by Commission"@en ;
    cml:realizedBy doc:sch-1-sec-183 ;
    values:originalText "An exemption under subsection 56GD(2) of the Competition and Consumer Act 2010 that is in force immediately before the commencement of this Part continues in force (and may be dealt with) as if the exemption had been given under that subsection as substituted by this Part." ;
    skos:definition "An exemption under subsection 56GD(2) of the Competition and Consumer Act 2010 that is in force immediately before the commencement of this Part continues in force (and may be dealt with) as if the exemption had been given under that subsection as substituted by this Part."@en ;
