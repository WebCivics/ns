    values:kind "section" ;
    values:originalText "Insert: Disclosures to designated gateways" ;
    cof:pageNumber "46"^^xsd:integer .

concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-102 a cml:Concept ;
    skos:prefLabel "102 At the end of section 56EM"@en ;
    cml:realizedBy doc:sch-1-sec-102 ;
    values:originalText "Add: Disclosures by action service providers (4) If a person as an action service provider for a type of CDR action is required or authorised under the consumer data rules to disclose CDR data to another person, the action service provider must: (a) take the steps specified in the consumer data rules to notify CDR consumers for the CDR data of the disclosure; and (b) ensure that this notification: (i) is given to those of the CDR consumers (if there are more than one) that the consumer data rules require to be notified; and (ii) covers the matters specified in those rules; and (iii) is given at or before the time specified in those rules. Note: This subsection is a civil penalty provision (see section 56EU).  Amendments  Schedule 1 Changes to the Privacy safeguards  Part 6 No. 75, 2024 Treasury Laws Amendment (Consumer Data Right) Act 2024" ;
    skos:definition "Add: Disclosures by action service providers (4) If a person as an action service provider for a type of CDR action is required or authorised under the consumer data rules to disclose CDR data to another person, the action service provider must: (a) take the steps specified in the consumer data rules to notify CDR consumers for the CDR data of the disclosure; and (b) ensure that this notification: (i) is given to those of the CDR consumers (if there are more than one) that the consumer data rules require to be notified; and (ii) covers the matters specified in those rules; and (iii) is given at or before the time specified in those rules. Note: This subsection is a civil penalty provision (see section 56EU).  Amendments  Schedule 1 Changes to the Privacy safeguards  Part 6 No. 75, 2024 Treasury Laws Amendment (Consumer Data Right) Act 2024"@en ;
    cml:integrityHash "4da6eb8cda7eaaf415c64bf498ef5617f54156e088101bde341ac45972f76d30" ;
    cof:pageNumber "46"^^xsd:integer ;
    skos:note "Must disclose CDR data to notified consumers" ;
    dc:description "Notification of disclosure" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
