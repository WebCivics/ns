    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2024.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.17" .
doc:sch-1-sec-43 a cof:Section ;
    cof:title "43 After section 56AM" ;
    values:kind "section" ;
    values:originalText "Insert: 56AMA  Meanings of CDR action and CDR declaration (1) A CDR action is an action of a type declared under section 56ACA. (2) A CDR declaration, for a type of CDR action, is the declaration under section 56ACA that declares actions of that type. 56AMB  Meanings of action service provider and voluntary action service provider (1) A person is an action service provider, for a type of CDR action, if the person: (a) is within a class of data holders (of CDR data) declared in the CDR declaration for that type of CDR action; or (b) is a voluntary action service provider for that type of CDR action.  Schedule 1  Amendments" ;
    cof:pageNumber "17"^^xsd:integer .

concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-43-ss-1 a cml:Concept ;
    skos:prefLabel "43(1) After section 56AM"@en ;
    cml:realizedBy doc:sch-1-sec-43-ss-1 ;
    values:originalText "(1) A CDR action is an action of a type declared under section 56ACA." ;
    skos:definition "(1) A CDR action is an action of a type declared under section 56ACA."@en ;
    cml:integrityHash "d8a2346ebd9fb6f9d351766e93a300951ca6a6121233f72fe30537f7a59fa31b" ;
    values:partOf concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-43 ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Person must be within a class of data holders or voluntary action service provider for CDR action. A CDR action is an action of a type declared under section 56ACA." ;
