concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-75 a cml:Concept ;
    skos:prefLabel "75 After paragraph 56BP(a)"@en ;
    cml:realizedBy doc:sch-1-sec-75 ;
    values:originalText "Insert: (aa) consider the following kinds of matters in relation to making a rule described in subsection 56BGA(2) (about fees at the instruction layer) for a type of CDR action: (i) whether performers of actions of that type currently charge fees for processing instructions to perform such actions; (ii) whether the incentive to perform actions of that type would be reduced if fees could not be charged for processing such instructions; (iii) the marginal cost of processing such instructions in accordance with the consumer data rules; and" ;
    skos:definition "Insert: (aa) consider the following kinds of matters in relation to making a rule described in subsection 56BGA(2) (about fees at the instruction layer) for a type of CDR action: (i) whether performers of actions of that type currently charge fees for processing instructions to perform such actions; (ii) whether the incentive to perform actions of that type would be reduced if fees could not be charged for processing such instructions; (iii) the marginal cost of processing such instructions in accordance with the consumer data rules; and"@en ;
    cml:integrityHash "f24818ca386a2001446774752a50caed9f098042eb292563ca1b58a474d0cc4d" ;
    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Consider certain matters when making a rule about fees for CDR actions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
