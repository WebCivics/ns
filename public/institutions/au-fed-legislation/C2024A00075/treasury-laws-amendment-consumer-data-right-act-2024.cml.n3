doc:sch-1-sec-56eg-ss-1 a cof:Section ;
    cof:title "56EG(1) Privacy safeguard 4—dealing with unsolicited CDR data from" ;
    values:kind "subsection" ;
    values:originalText "(1) A person must destroy CDR data as soon as practicable after collecting it if: (a) the person (the collector) collected the CDR data while covered by column 1 of an item of the following table, and from a person covered by column 2 of that item; and (b) the collector collected the CDR data: (i) purportedly under the consumer data rules; but (ii) not as the result of seeking to collect the CDR data under the consumer data rules; and (c) the collector is not required to retain the CDR data by or under an Australian law or a court/tribunal order; and (d) in the case where item 3 of the table applies, the circumstances specified in the consumer data rules do not apply. Dealing with unsolicited CDR data from participants in CDR Item Column 1 A collector who: Column 2 collects the CDR data from: is an accredited person a CDR participant for the CDR data as an accredited action initiator for a type of CDR action an action service provider for that type of CDR action as an action service provider for a type of CDR action an accredited action initiator for that type of CDR action Note: This subsection is a civil penalty provision (see section 56EU)." ;
    cof:pageNumber "45"^^xsd:integer .

concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-56eg-ss-2 a cml:Concept ;
    skos:prefLabel "56EG(2) Privacy safeguard 4—dealing with unsolicited CDR data from"@en ;
    cml:realizedBy doc:sch-1-sec-56eg-ss-2 ;
    values:originalText "(2) Subsection (1) applies whether the collection is directly or indirectly from the person mentioned in column 2 of the table. Example: For item 1 of the table, the collection could be from the CDR participant through a designated gateway (see section 56BG)." ;
    skos:definition "(2) Subsection (1) applies whether the collection is directly or indirectly from the person mentioned in column 2 of the table. Example: For item 1 of the table, the collection could be from the CDR participant through a designated gateway (see section 56BG)."@en ;
    cml:integrityHash "928327f3992a99f645f23df459c3081207bbbf8c1aa82ccb99c5ab70e36606db" ;
    values:partOf concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-56eg ;
    cof:pageNumber "45"^^xsd:integer ;
    skos:note "Subsection (1) applies to all collection of data from the person mentioned in column 2 of the table." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2024.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.45" ;
