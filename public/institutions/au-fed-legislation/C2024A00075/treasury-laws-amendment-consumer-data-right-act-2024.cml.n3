concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-38 a cml:Concept ;
    skos:prefLabel "38 At the end of section 56AJ"@en ;
    cml:realizedBy doc:sch-1-sec-38 ;
    values:originalText "Add: Fifth case—person is specified in the designation instrument and conditions in the consumer data rules are met (5) This subsection applies to a person and CDR data if: (a) the person, or a class of persons to which the person belongs, is specified, as described in paragraph 56AC(2)(b), in the designation instrument as holding a class of information to which the CDR data belongs; and (b) the CDR data, or any other CDR data from which it was directly or indirectly derived, was disclosed to the person under the consumer data rules; and (c) the conditions specified in the consumer data rules are met." ;
    skos:definition "Add: Fifth case—person is specified in the designation instrument and conditions in the consumer data rules are met (5) This subsection applies to a person and CDR data if: (a) the person, or a class of persons to which the person belongs, is specified, as described in paragraph 56AC(2)(b), in the designation instrument as holding a class of information to which the CDR data belongs; and (b) the CDR data, or any other CDR data from which it was directly or indirectly derived, was disclosed to the person under the consumer data rules; and (c) the conditions specified in the consumer data rules are met."@en ;
    cml:integrityHash "759f49c96885a4efff9df1ac8766eb47a9e883641498dc4c089b06381bec7e11" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Person specified in designation instrument and meets conditions must comply with CDR data rules." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <treasury-laws-amendment-consumer-data-right-act-2024.pdf> ;
    dc:source "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.16" ;
    cml:asserts concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-38-norm .
