concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-184 a cml:Concept ;
    skos:prefLabel "184 Subsection 56GE(2)"@en ;
    cml:realizedBy doc:sch-1-sec-184 ;
    values:originalText "Repeal the subsection, substitute: (2) The regulations may: (a) exempt a particular person in relation to: (i) particular CDR data or one or more classes of CDR data; or (ii) a particular CDR action or one or more types of CDR actions; from all or specified provisions covered by this section; or (b) exempt a class of persons in relation to: (i) particular CDR data or one or more classes of CDR data; or (ii) a particular CDR action or one or more types of CDR actions; from all or specified provisions covered by this section; or (c) declare that provisions covered by this section apply in relation to: (i) a particular person in relation to particular CDR data or one or more classes of CDR data; or (ii) a class of persons in relation to particular CDR data or one or more classes of CDR data; or (iii) a particular person in relation to a particular CDR action or one or more types of CDR actions; or  Schedule 1  Amendments" ;
    skos:definition "Repeal the subsection, substitute: (2) The regulations may: (a) exempt a particular person in relation to: (i) particular CDR data or one or more classes of CDR data; or (ii) a particular CDR action or one or more types of CDR actions; from all or specified provisions covered by this section; or (b) exempt a class of persons in relation to: (i) particular CDR data or one or more classes of CDR data; or (ii) a particular CDR action or one or more types of CDR actions; from all or specified provisions covered by this section; or (c) declare that provisions covered by this section apply in relation to: (i) a particular person in relation to particular CDR data or one or more classes of CDR data; or (ii) a class of persons in relation to particular CDR data or one or more classes of CDR data; or (iii) a particular person in relation to a particular CDR action or one or more types of CDR actions; or  Schedule 1  Amendments"@en ;
    cml:integrityHash "6fa2f69e19462f51337af5318aadb6ed426bf57a2b7d434008042b20051494f7" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Exempt particular persons or classes from specified provisions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
