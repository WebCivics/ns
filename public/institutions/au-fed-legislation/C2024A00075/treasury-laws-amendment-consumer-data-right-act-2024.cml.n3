doc:sec-3-2 a cof:Section ;
    cof:title "3 Schedules" ;
    values:kind "section" ;
    values:originalText "Legislation that is specified in a Schedule to this Act is amended or repealed as set out in the applicable items in the Schedule    No. 75, 2024 Treasury Laws Amendment (Consumer Data Right) Act 2024 concerned, and any other item in a Schedule to this Act has effect according to its terms.  Schedule 1  Amendments" ;
    cof:pageNumber "6"^^xsd:integer .

