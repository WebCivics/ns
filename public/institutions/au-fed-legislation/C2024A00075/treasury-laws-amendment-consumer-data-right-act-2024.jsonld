    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-88",
      "@type": "cml:Concept",
      "skos:prefLabel": "88 Section 56EA",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-88"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.41",
      "values:originalText": "Omit:\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders and designated gateways, in relation to their\nhandling or future handling of the CDR data.\nsubstitute:\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders, designated gateways and action service\nproviders, in relation to their handling or future handling of the\nCDR data.\nThe circumstances in which these safeguards can apply to an\naccredited person include where the person is an accredited action\ninitiator for a type of CDR action who is or may become an\naccredited data recipient of CDR data.",
      "skos:definition": "Omit:\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders and designated gateways, in relation to their\nhandling or future handling of the CDR data.\nsubstitute:\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders, designated gateways and action service\nproviders, in relation to their handling or future handling of the\nCDR data.\nThe circumstances in which these safeguards can apply to an\naccredited person include where the person is an accredited action\ninitiator for a type of CDR action who is or may become an\naccredited data recipient of CDR data.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-88-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-88-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-88-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "500f67aa050a54a8c6e306f8473d319717e5ad73f2521f8dee85e5560a68fae5",
      "skos:note": "Privacy safeguards apply to accredited persons and data holders/designated gateways."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-88",
      "@type": "cof:Section",
      "cof:title": "88 Section 56EA",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "Omit:\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders and designated gateways, in relation to their\nhandling or future handling of the CDR data.\nsubstitute:\nThe privacy safeguards apply mainly to accredited persons, but\nalso to data holders, designated gateways and action service\nproviders, in relation to their handling or future handling of the\nCDR data.\nThe circumstances in which these safeguards can apply to an\naccredited person include where the person is an accredited action\ninitiator for a type of CDR action who is or may become an\naccredited data recipient of CDR data."
    },
