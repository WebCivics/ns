          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-162-norm"
        }
      ],
      "cml:integrityHash": "52fde62c9033828870ad2b887923b4f51139f86ffff2c3e0890a134d8bc0de99",
      "skos:note": "Insertion of phrase in those capacities"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-162",
      "@type": "cof:Section",
      "cof:title": "162 Subsections 56AS(2) and (3)",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "After “this Part” (wherever occurring), insert “in those capacities”.\n\nAmendments  Schedule 1\nMiscellaneous amendments  Part 8\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024"
    },
