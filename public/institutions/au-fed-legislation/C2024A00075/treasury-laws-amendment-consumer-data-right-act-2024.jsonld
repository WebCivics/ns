      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.42",
      "values:originalText": "Insert:\n; and (e) if a small business operator (within the meaning of the\nPrivacy Act 1988) is an action service provider for a type of\nCDR action, the Privacy Act 1988 applies:\n(i) subject to paragraphs (ab) to (c) of this subsection; and\n(ii) in relation to personal information disclosed to the\nprovider under the consumer data rules;\nas if the provider were an organisation (within the meaning\nof the Privacy Act 1988).",
      "skos:definition": "Insert:\n; and (e) if a small business operator (within the meaning of the\nPrivacy Act 1988) is an action service provider for a type of\nCDR action, the Privacy Act 1988 applies:\n(i) subject to paragraphs (ab) to (c) of this subsection; and\n(ii) in relation to personal information disclosed to the\nprovider under the consumer data rules;\nas if the provider were an organisation (within the meaning\nof the Privacy Act 1988).",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-90-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-90-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-90-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "a4bec7df5d43d0c22a2e5d407d8ba3dbf472398b51dc9a24918925b7b63ea2e5",
      "skos:note": "Privacy Act 1988 applies to small business operators providing CDRActions."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-90",
      "@type": "cof:Section",
      "cof:title": "90 After paragraph 56EC(4)(d)",
      "values:kind": "section",
      "cof:pageNumber": 42,
      "values:originalText": "Insert:\n; and (e) if a small business operator (within the meaning of the\nPrivacy Act 1988) is an action service provider for a type of\nCDR action, the Privacy Act 1988 applies:\n(i) subject to paragraphs (ab) to (c) of this subsection; and\n(ii) in relation to personal information disclosed to the\nprovider under the consumer data rules;\nas if the provider were an organisation (within the meaning\nof the Privacy Act 1988)."
    },
