    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 After paragraph 56EC(4)(d)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-90"
      },
