    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 At the end of section 56AK",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.17",
      "values:originalText": "Add:\n(2) This subsection covers CDR data for a person if:\n(a) the CDR data is information that relates to a CDR consumer\nfor a CDR action; and\n(b) the person is authorised by the consumer data rules to use or\ndisclose that information to prepare or give a valid\ninstruction for the performance of the CDR action on behalf\nof the CDR consumer.\nNote:\nThis CDR data is information that is CDR data because of\nparagraph 56AI(1)(aa). Paragraph 56BGA(1)(d) ensures the rules can\ngive the authorisation referred to in paragraph (b) of this subsection.",
      "skos:definition": "Add:\n(2) This subsection covers CDR data for a person if:\n(a) the CDR data is information that relates to a CDR consumer\nfor a CDR action; and\n(b) the person is authorised by the consumer data rules to use or\ndisclose that information to prepare or give a valid\ninstruction for the performance of the CDR action on behalf\nof the CDR consumer.\nNote:\nThis CDR data is information that is CDR data because of\nparagraph 56AI(1)(aa). Paragraph 56BGA(1)(d) ensures the rules can\ngive the authorisation referred to in paragraph (b) of this subsection.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-42-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-42-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-42-logic-alleninterval-2"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-42-logic-deontic-3"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-42-logic-deontic-4"
        }
      ],
      "cml:integrityHash": "e87204765d9664e4955bcd206be6f1df0da4f252848c3a69bd368bebcbaf3cd8",
      "skos:note": "Authorisation required for using CDR data"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-42",
      "@type": "cof:Section",
      "cof:title": "42 At the end of section 56AK",
      "values:kind": "section",
      "cof:pageNumber": 17,
      "values:originalText": "Add:\n(2) This subsection covers CDR data for a person if:\n(a) the CDR data is information that relates to a CDR consumer\nfor a CDR action; and\n(b) the person is authorised by the consumer data rules to use or\ndisclose that information to prepare or give a valid\ninstruction for the performance of the CDR action on behalf\nof the CDR consumer.\nNote:\nThis CDR data is information that is CDR data because of\nparagraph 56AI(1)(aa). Paragraph 56BGA(1)(d) ensures the rules can\ngive the authorisation referred to in paragraph (b) of this subsection."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-42-norm",
      "@type": "values:Obligation",
      "cml:modality": {
