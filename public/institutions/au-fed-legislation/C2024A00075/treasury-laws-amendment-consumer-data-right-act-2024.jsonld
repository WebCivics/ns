      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.13",
      "values:originalText": "Insert:\n(aa) information that:\n(i) relates to a CDR consumer for a CDR action; and\n(ii) an accredited action initiator for CDR actions of that\ntype is authorised by the consumer data rules to use, or\ndisclose, to prepare or give a valid instruction for the\nperformance of the CDR action on behalf of the CDR\nconsumer; or",
      "skos:definition": "Insert:\n(aa) information that:\n(i) relates to a CDR consumer for a CDR action; and\n(ii) an accredited action initiator for CDR actions of that\ntype is authorised by the consumer data rules to use, or\ndisclose, to prepare or give a valid instruction for the\nperformance of the CDR action on behalf of the CDR\nconsumer; or",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-24-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-24-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "84bb321278d80426e23257abc36e1250b1cc723c2b4cc9bfcba7afea54a8b4bc",
      "skos:note": "Authorisation for use of consumer data by accredited action initiators"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-24",
      "@type": "cof:Section",
