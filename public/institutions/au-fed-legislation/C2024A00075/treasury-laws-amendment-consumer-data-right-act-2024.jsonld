    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After paragraph 56AA(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
