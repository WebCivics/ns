      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.61",
      "values:originalText": "Repeal the section, substitute:\n56GAB  Concurrent operation of other laws\nThe CDR provisions are not intended to exclude or limit the\noperation of a law of the Commonwealth, or of a State or Territory,\nthat is capable of operating concurrently with the CDR provisions.",
      "skos:definition": "Repeal the section, substitute:\n56GAB  Concurrent operation of other laws\nThe CDR provisions are not intended to exclude or limit the\noperation of a law of the Commonwealth, or of a State or Territory,\nthat is capable of operating concurrently with the CDR provisions.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-178-norm"
        }
      ],
      "cml:integrityHash": "b4304e7192c222c3ac2067e0b977c44b3d84ed462a4b2a8a206172757967dfca",
      "skos:note": "The CDR provisions do not exclude or limit the operation of other laws."
    },
