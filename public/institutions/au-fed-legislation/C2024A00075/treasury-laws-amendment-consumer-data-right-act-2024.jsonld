    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-183",
      "@type": "cml:Concept",
      "skos:prefLabel": "183 Transitional—existing exemptions by Commission",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-183"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.63",
      "values:originalText": "An exemption under subsection 56GD(2) of the Competition and\nConsumer Act 2010 that is in force immediately before the\ncommencement of this Part continues in force (and may be dealt with)\nas if the exemption had been given under that subsection as substituted\nby this Part.",
      "skos:definition": "An exemption under subsection 56GD(2) of the Competition and\nConsumer Act 2010 that is in force immediately before the\ncommencement of this Part continues in force (and may be dealt with)\nas if the exemption had been given under that subsection as substituted\nby this Part.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-183-norm"
        }
      ],
      "cml:integrityHash": "b42228a248c926dc4d674c09a0dba962370a52107f3c05baf61fe445de613dca",
      "skos:note": "Continuation of existing exemptions under subsection 56GD(2) of the Competition and Consumer Act 2010"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-183",
      "@type": "cof:Section",
      "cof:title": "183 Transitional—existing exemptions by Commission",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "An exemption under subsection 56GD(2) of the Competition and\nConsumer Act 2010 that is in force immediately before the\ncommencement of this Part continues in force (and may be dealt with)\nas if the exemption had been given under that subsection as substituted\nby this Part."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-183-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
