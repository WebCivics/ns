    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 After subsection 56AJ(3)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.15",
      "values:originalText": "Insert:\nThird case—reciprocity arising from the person being a voluntary\naction service provider for a type of CDR action\n(3A) This subsection applies to a person and CDR data if:\n(a) neither the CDR data, nor any other CDR data from which it\nwas directly or indirectly derived, was disclosed to the person\nunder the consumer data rules; and\n(b) the designation instrument (see subsection (1)) also specifies,\nas described in paragraph 56AC(2)(b), a class of persons (the\ncore data holders) as holding a class of information to which\nthe CDR data belongs; and\n(c) the person is not a core data holder, but is a voluntary action\nservice provider for a type of CDR action; and\n(d) the classes of data holders declared in the CDR declaration\nfor that type of CDR action include the core data holders; and\n\nSchedule 1  Amendments",
      "skos:definition": "Insert:\nThird case—reciprocity arising from the person being a voluntary\naction service provider for a type of CDR action\n(3A) This subsection applies to a person and CDR data if:\n(a) neither the CDR data, nor any other CDR data from which it\nwas directly or indirectly derived, was disclosed to the person\nunder the consumer data rules; and\n(b) the designation instrument (see subsection (1)) also specifies,\nas described in paragraph 56AC(2)(b), a class of persons (the\ncore data holders) as holding a class of information to which\nthe CDR data belongs; and\n(c) the person is not a core data holder, but is a voluntary action\nservice provider for a type of CDR action; and\n(d) the classes of data holders declared in the CDR declaration\nfor that type of CDR action include the core data holders; and\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-alleninterval-3"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-ltl-4"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-deontic-5"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-descriptionlogic-6"
        }
      ],
      "cml:integrityHash": "98e9bff85d73152b2c26523daa2e5277ef96650dc90830b33565d8a5d0fdff68",
      "skos:note": "Disclosure of CDR data to a person is prohibited if they are not a core data holder."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-36",
      "@type": "cof:Section",
      "cof:title": "36 After subsection 56AJ(3)",
      "values:kind": "section",
      "cof:pageNumber": 15,
      "values:originalText": "Insert:\nThird case—reciprocity arising from the person being a voluntary\naction service provider for a type of CDR action\n(3A) This subsection applies to a person and CDR data if:\n(a) neither the CDR data, nor any other CDR data from which it\nwas directly or indirectly derived, was disclosed to the person\nunder the consumer data rules; and\n(b) the designation instrument (see subsection (1)) also specifies,\nas described in paragraph 56AC(2)(b), a class of persons (the\ncore data holders) as holding a class of information to which\nthe CDR data belongs; and\n(c) the person is not a core data holder, but is a voluntary action\nservice provider for a type of CDR action; and\n(d) the classes of data holders declared in the CDR declaration\nfor that type of CDR action include the core data holders; and\n\nSchedule 1  Amendments"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
