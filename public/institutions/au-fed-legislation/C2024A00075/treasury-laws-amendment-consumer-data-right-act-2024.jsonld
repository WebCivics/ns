    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-65",
      "@type": "cml:Concept",
      "skos:prefLabel": "65 After paragraph 56BI(1)(c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-65"
      },
