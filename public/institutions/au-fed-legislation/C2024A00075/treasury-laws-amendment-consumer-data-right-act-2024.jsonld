      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.27",
      "values:originalText": "Insert:\n(ca) a power for a CDR consumer for a CDR action to direct an\naccredited action initiator for CDR actions of that type to\ngive the consumer, or an accredited person, reports about:\n(i) the consumer’s valid request made to the initiator, under\nrules like those described in subsection 56BGA(1), for\nthe giving of a valid instruction for the performance of\nthe CDR action; or\n\nSchedule 1  Amendments",
      "skos:definition": "Insert:\n(ca) a power for a CDR consumer for a CDR action to direct an\naccredited action initiator for CDR actions of that type to\ngive the consumer, or an accredited person, reports about:\n(i) the consumer’s valid request made to the initiator, under\nrules like those described in subsection 56BGA(1), for\nthe giving of a valid instruction for the performance of\nthe CDR action; or\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-65-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-65-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-65-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "cb121dd1a3806830d917bef0e716d2f074ba5a67a7a7d73d071ba2654f2691f9",
      "skos:note": "Consumer has power to direct action initiator for CDR actions of that type."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-65",
      "@type": "cof:Section",
      "cof:title": "65 After paragraph 56BI(1)(c)",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "Insert:\n(ca) a power for a CDR consumer for a CDR action to direct an\naccredited action initiator for CDR actions of that type to\ngive the consumer, or an accredited person, reports about:\n(i) the consumer’s valid request made to the initiator, under\nrules like those described in subsection 56BGA(1), for\nthe giving of a valid instruction for the performance of\nthe CDR action; or\n\nSchedule 1  Amendments"
    },
