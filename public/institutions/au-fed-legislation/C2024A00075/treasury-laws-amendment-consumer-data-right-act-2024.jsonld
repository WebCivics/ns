      "cml:operator": "allows",
      "cml:logicSummary": "Granting permission for data holder",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
