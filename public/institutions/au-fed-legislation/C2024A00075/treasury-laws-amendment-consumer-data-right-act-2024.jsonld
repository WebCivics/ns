      }
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-181",
      "@type": "cml:Concept",
      "skos:prefLabel": "181 Subsection 56GC(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-181"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.62",
      "values:originalText": "Repeal the subsection, substitute:\n(1) If a person (the CDR entity), acting as described in an item of the\nfollowing table, does something mentioned in that item:\n(a) in good faith; and\n(b) in compliance with the CDR provisions; and\n(c) in compliance with each law (if any) of the Commonwealth,\nof a State or of a Territory prescribed by the regulations;\nthe CDR entity is not liable to an action or other proceeding,\nwhether civil or criminal, for or in relation to the thing in that item.\nDoing a CDR thing in good faith in compliance with the CDR provisions etc.\nItem\nWhen acting:\nthe things are:\n(a) as a data holder of CDR data; or\n(b) as an accredited data recipient of\nCDR data; or\n(c) as a designated gateway for CDR\ndata\n(a) providing the data to another\nperson; or\n(b) otherwise allowing another\nperson access to the data.\nas an accredited action initiator for a\ntype of CDR action\ngiving an instruction that is a valid\ninstruction for the performance of a\nCDR action of that type.\nas an action service provider for a\ntype of CDR action\nprocessing an instruction that is a\nvalid instruction for the performance\nof a CDR action of that type.\nNote 1:\nItem 3 of the table is focussing on the instruction layer not the action\nlayer, and so does not cover performance of the CDR action.\nNote 2:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection for a criminal action or criminal proceeding (see\nsubsection 13.3(3) of the Criminal Code).",
      "skos:definition": "Repeal the subsection, substitute:\n(1) If a person (the CDR entity), acting as described in an item of the\nfollowing table, does something mentioned in that item:\n(a) in good faith; and\n(b) in compliance with the CDR provisions; and\n(c) in compliance with each law (if any) of the Commonwealth,\nof a State or of a Territory prescribed by the regulations;\nthe CDR entity is not liable to an action or other proceeding,\nwhether civil or criminal, for or in relation to the thing in that item.\nDoing a CDR thing in good faith in compliance with the CDR provisions etc.\nItem\nWhen acting:\nthe things are:\n(a) as a data holder of CDR data; or\n(b) as an accredited data recipient of\nCDR data; or\n(c) as a designated gateway for CDR\ndata\n(a) providing the data to another\nperson; or\n(b) otherwise allowing another\nperson access to the data.\nas an accredited action initiator for a\ntype of CDR action\ngiving an instruction that is a valid\ninstruction for the performance of a\nCDR action of that type.\nas an action service provider for a\ntype of CDR action\nprocessing an instruction that is a\nvalid instruction for the performance\nof a CDR action of that type.\nNote 1:\nItem 3 of the table is focussing on the instruction layer not the action\nlayer, and so does not cover performance of the CDR action.\nNote 2:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection for a criminal action or criminal proceeding (see\nsubsection 13.3(3) of the Criminal Code).",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-181-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-181-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-181-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "12a8ad7387de2eda1d43fb1538c4502e71b00c70d7eb68d32b13eee6df0ac6f8",
      "skos:note": "No liability for actions taken in good faith and compliance with laws."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-181",
      "@type": "cof:Section",
      "cof:title": "181 Subsection 56GC(1)",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "Repeal the subsection, substitute:\n(1) If a person (the CDR entity), acting as described in an item of the\nfollowing table, does something mentioned in that item:\n(a) in good faith; and\n(b) in compliance with the CDR provisions; and\n(c) in compliance with each law (if any) of the Commonwealth,\nof a State or of a Territory prescribed by the regulations;\nthe CDR entity is not liable to an action or other proceeding,\nwhether civil or criminal, for or in relation to the thing in that item.\nDoing a CDR thing in good faith in compliance with the CDR provisions etc.\nItem\nWhen acting:\nthe things are:\n(a) as a data holder of CDR data; or\n(b) as an accredited data recipient of\nCDR data; or\n(c) as a designated gateway for CDR\ndata\n(a) providing the data to another\nperson; or\n(b) otherwise allowing another\nperson access to the data.\nas an accredited action initiator for a\ntype of CDR action\ngiving an instruction that is a valid\ninstruction for the performance of a\nCDR action of that type.\nas an action service provider for a\ntype of CDR action\nprocessing an instruction that is a\nvalid instruction for the performance\nof a CDR action of that type.\nNote 1:\nItem 3 of the table is focussing on the instruction layer not the action\nlayer, and so does not cover performance of the CDR action.\nNote 2:\nA defendant bears an evidential burden in relation to the matter in this\nsubsection for a criminal action or criminal proceeding (see\nsubsection 13.3(3) of the Criminal Code)."
    },
    {
