    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110",
      "@type": "cml:Concept",
      "skos:prefLabel": "110 After subsection 56ER(1A)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-110"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.49",
      "values:originalText": "Insert:\n(1B) The Information Commissioner may assess whether an action\nservice provider for a type of CDR action, who has been or may be\ndisclosed CDR data under the consumer data rules, is maintaining\nand handling the CDR data in accordance with:\n(a) the privacy safeguards; or\n(b) the consumer data rules to the extent that those rules relate\nto:\n(i) the privacy safeguards; or\n(ii) the privacy or confidentiality of the CDR data.",
      "skos:definition": "Insert:\n(1B) The Information Commissioner may assess whether an action\nservice provider for a type of CDR action, who has been or may be\ndisclosed CDR data under the consumer data rules, is maintaining\nand handling the CDR data in accordance with:\n(a) the privacy safeguards; or\n(b) the consumer data rules to the extent that those rules relate\nto:\n(i) the privacy safeguards; or\n(ii) the privacy or confidentiality of the CDR data.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110-logic-descriptionlogic-2"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110-logic-descriptionlogic-3"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110-logic-alleninterval-4"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110-logic-ltl-5"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-110-logic-diffusion-6"
        }
      ],
      "cml:integrityHash": "9248d4ec316e328b5d3b849123112786bdf43dc9266fc697aad634588ad783e4",
      "skos:note": "The Information Commissioner may assess an action service provider's compliance with privacy safeguards and consumer data rules."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-110",
      "@type": "cof:Section",
      "cof:title": "110 After subsection 56ER(1A)",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "Insert:\n(1B) The Information Commissioner may assess whether an action\nservice provider for a type of CDR action, who has been or may be\ndisclosed CDR data under the consumer data rules, is maintaining\nand handling the CDR data in accordance with:\n(a) the privacy safeguards; or\n(b) the consumer data rules to the extent that those rules relate\nto:\n(i) the privacy safeguards; or\n(ii) the privacy or confidentiality of the CDR data."
    },
