      "cml:integrityHash": "ada958e417063784f2420f907c9d5d642600008b17c8adc7e91754c62d71d647",
      "skos:note": "CDR provisions apply to acts or omissions by Australian persons or occurring wholly or partly in Australia."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-155-ss-3b",
