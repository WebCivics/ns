      "cml:premiseText": "Delegate must perform delegated function or exercise delegated power",
      "cml:conclusionText": "Delegation by the Secretary is a type of artificial intelligence application"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-178",
      "@type": "cml:Concept",
      "skos:prefLabel": "178 Section 56GAB",
      "cml:realizedBy": {
