        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is authorised by the consumer data rules",
      "cml:conclusionText": "The CDR data can be used"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-42-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Authorisation is valid during the preparation or giving of an instruction",
      "cml:executionSurface": "modalities::interval_reasoning",
