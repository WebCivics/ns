      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.40",
      "values:originalText": "The repeal of sections 56CC and 56CD of the Competition and\nConsumer Act 2010 by this Part applies in relation to acts or omissions\non or after the commencement of this Part.\n\nAmendments  Schedule 1\nChanges to the Privacy safeguards  Part 6\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024",
      "skos:definition": "The repeal of sections 56CC and 56CD of the Competition and\nConsumer Act 2010 by this Part applies in relation to acts or omissions\non or after the commencement of this Part.\n\nAmendments  Schedule 1\nChanges to the Privacy safeguards  Part 6\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-87-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-87-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d67076292970c8636e9b0913f98979653e7dd3b45d7bf98a7b19573c300e8af9",
      "skos:note": "Repeal of sections 56CC and 56CD applies after commencement"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-87",
      "@type": "cof:Section",
      "cof:title": "87 Application of repeals",
      "values:kind": "section",
      "cof:pageNumber": 40,
      "values:originalText": "The repeal of sections 56CC and 56CD of the Competition and\nConsumer Act 2010 by this Part applies in relation to acts or omissions\non or after the commencement of this Part.\n\nAmendments  Schedule 1\nChanges to the Privacy safeguards  Part 6\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024"
    },
