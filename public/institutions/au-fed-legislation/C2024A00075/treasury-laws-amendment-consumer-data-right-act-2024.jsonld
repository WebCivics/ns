    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-89",
      "@type": "cml:Concept",
      "skos:prefLabel": "89 Paragraphs 56EC(4)(aa), (b) and (c)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-89"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.41",
      "values:originalText": "Repeal the paragraphs, substitute:\n(aa) if section 56ED or 56EE applies to an accredited person in\nrelation to CDR data—the corresponding Australian Privacy\nPrinciple does not apply to the accredited person in relation\nto the CDR data; and\n(ab) if section 56EF or 56EG applies to a person:\n(i) who is an accredited person; or\n(ii) as a CDR action participant;\nin relation to CDR data—the corresponding Australian\nPrivacy Principle does not apply to the person in relation to\nthe CDR data; and\n\nSchedule 1  Amendments",
      "skos:definition": "Repeal the paragraphs, substitute:\n(aa) if section 56ED or 56EE applies to an accredited person in\nrelation to CDR data—the corresponding Australian Privacy\nPrinciple does not apply to the accredited person in relation\nto the CDR data; and\n(ab) if section 56EF or 56EG applies to a person:\n(i) who is an accredited person; or\n(ii) as a CDR action participant;\nin relation to CDR data—the corresponding Australian\nPrivacy Principle does not apply to the person in relation to\nthe CDR data; and\n\nSchedule 1  Amendments",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-89-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-89-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "be5e89e0867811b2d7ac57d45fb7327abd7e3d783989b2eb44862e486acce810",
      "skos:note": "Repeal of Australian Privacy Principles for accredited persons in relation to CDR data"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-89",
      "@type": "cof:Section",
      "cof:title": "89 Paragraphs 56EC(4)(aa), (b) and (c)",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "Repeal the paragraphs, substitute:\n(aa) if section 56ED or 56EE applies to an accredited person in\nrelation to CDR data—the corresponding Australian Privacy\nPrinciple does not apply to the accredited person in relation\nto the CDR data; and\n(ab) if section 56EF or 56EG applies to a person:\n(i) who is an accredited person; or\n(ii) as a CDR action participant;\nin relation to CDR data—the corresponding Australian\nPrivacy Principle does not apply to the person in relation to\nthe CDR data; and\n\nSchedule 1  Amendments"
    },
    {
