      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.59",
      "values:originalText": "government entities of a State or Territory\nA declaration under subsection 56AS(1) of the Competition and\nConsumer Act 2010 in force immediately before the commencement of\nthis Part continues in force (and may be dealt with) as if that\ndeclaration:\n(a) had been made under that subsection as substituted by this\nPart; and\n(b) had declared the applicable entity as a participating entity, for\nthe applicable State or Territory, in the capacity as a data\nholder of CDR data.",
      "skos:definition": "government entities of a State or Territory\nA declaration under subsection 56AS(1) of the Competition and\nConsumer Act 2010 in force immediately before the commencement of\nthis Part continues in force (and may be dealt with) as if that\ndeclaration:\n(a) had been made under that subsection as substituted by this\nPart; and\n(b) had declared the applicable entity as a participating entity, for\nthe applicable State or Territory, in the capacity as a data\nholder of CDR data.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-163-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-163-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "6ecf667f360cda62664f7d4e36b46e61dccd38331513b2f57451ab5089edf3ac",
      "skos:note": "Existing declarations of participating entities continue in force."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-163",
      "@type": "cof:Section",
      "cof:title": "163 Transitional—existing declarations of participating",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "government entities of a State or Territory\nA declaration under subsection 56AS(1) of the Competition and\nConsumer Act 2010 in force immediately before the commencement of\nthis Part continues in force (and may be dealt with) as if that\ndeclaration:\n(a) had been made under that subsection as substituted by this\nPart; and\n(b) had declared the applicable entity as a participating entity, for\nthe applicable State or Territory, in the capacity as a data\nholder of CDR data."
    },
