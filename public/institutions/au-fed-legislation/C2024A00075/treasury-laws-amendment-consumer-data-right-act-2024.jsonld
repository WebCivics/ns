    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Paragraph 56AI(1)(b)",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "Repeal the paragraph, substitute:\n(b) information that is not covered by paragraph (a) or (aa) of\nthis subsection, but is wholly or partly derived from\ninformation covered by:\n(i) paragraph (a) or (aa) of this subsection; or\n(ii) a previous application of this paragraph."
    },
