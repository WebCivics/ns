      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.51",
      "values:originalText": "Add:\n(iv) a paragraph that states that an act or practice of an\naction service provider for a type of CDR action, who\nhas been or may be disclosed CDR data under the\nconsumer data rules, has breached a privacy safeguard;\nand",
      "skos:definition": "Add:\n(iv) a paragraph that states that an act or practice of an\naction service provider for a type of CDR action, who\nhas been or may be disclosed CDR data under the\nconsumer data rules, has breached a privacy safeguard;\nand",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-120-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-120-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-120-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "4013b5d3196ea9124bc005ef2d6d3b29250aef1043bc682f16d80a047fdb434e",
      "skos:note": "Disclose CDR data under consumer data rules if breach of privacy safeguard"
    },
    {
