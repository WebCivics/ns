    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-175",
      "@type": "cml:Concept",
      "skos:prefLabel": "175 After subsection 56FD(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-175"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.60",
      "values:originalText": "Insert:\n(2A) A contract is taken to be in force between:\n(a) an action service provider for a type of CDR action to which\na binding data standard applies; and\n(b) each accredited action initiator for a CDR action of that type;\nunder which each of those persons:\n(c) agrees to observe the standard to the extent that the standard\napplies to the person; and\n(d) agrees to engage in conduct that the person is required by the\nstandard to engage in.\nNote:\nThis means the action service provider will be taken to have a separate\ncontract with each of those accredited action initiators.\n\nAmendments  Schedule 1\nMiscellaneous amendments  Part 8\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024",
      "skos:definition": "Insert:\n(2A) A contract is taken to be in force between:\n(a) an action service provider for a type of CDR action to which\na binding data standard applies; and\n(b) each accredited action initiator for a CDR action of that type;\nunder which each of those persons:\n(c) agrees to observe the standard to the extent that the standard\napplies to the person; and\n(d) agrees to engage in conduct that the person is required by the\nstandard to engage in.\nNote:\nThis means the action service provider will be taken to have a separate\ncontract with each of those accredited action initiators.\n\nAmendments  Schedule 1\nMiscellaneous amendments  Part 8\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-175-norm"
        }
      ],
      "cml:integrityHash": "5c919fa4911665e466e8592976ab3310fc3fc8fd095cce1a4531c53a980a36ad",
      "skos:note": "Defines contract force between action service provider and accredited initiators under a binding data standard."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-175",
      "@type": "cof:Section",
      "cof:title": "175 After subsection 56FD(2)",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "Insert:\n(2A) A contract is taken to be in force between:\n(a) an action service provider for a type of CDR action to which\na binding data standard applies; and\n(b) each accredited action initiator for a CDR action of that type;\nunder which each of those persons:\n(c) agrees to observe the standard to the extent that the standard\napplies to the person; and\n(d) agrees to engage in conduct that the person is required by the\nstandard to engage in.\nNote:\nThis means the action service provider will be taken to have a separate\ncontract with each of those accredited action initiators.\n\nAmendments  Schedule 1\nMiscellaneous amendments  Part 8\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024"
    },
