    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-177",
      "@type": "cml:Concept",
      "skos:prefLabel": "177 Before subsection 56GAA(1)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-177"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
