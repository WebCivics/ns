    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-95",
      "@type": "cml:Concept",
      "skos:prefLabel": "95 After subsection 56ED(6)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-95"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.43",
      "values:originalText": "Insert:\n(6A) If the CDR entity is a person who, as an action service provider for\na type of CDR action, has been or may be disclosed CDR data\nunder the consumer data rules, the CDR entity’s policy must\ncontain the following information:\n(a) how a CDR consumer for the CDR data may access the CDR\ndata and seek the correction of the CDR data;\n(b) how a CDR consumer for the CDR data may complain about\na failure of the CDR entity to comply with this Part or the\nconsumer data rules, and how the CDR entity will deal with\nsuch a complaint.",
      "skos:definition": "Insert:\n(6A) If the CDR entity is a person who, as an action service provider for\na type of CDR action, has been or may be disclosed CDR data\nunder the consumer data rules, the CDR entity’s policy must\ncontain the following information:\n(a) how a CDR consumer for the CDR data may access the CDR\ndata and seek the correction of the CDR data;\n(b) how a CDR consumer for the CDR data may complain about\na failure of the CDR entity to comply with this Part or the\nconsumer data rules, and how the CDR entity will deal with\nsuch a complaint.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-95-norm"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-95-logic-deontic-1"
        },
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-95-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "2ee3c3e6d9c89c57320d8d689cc4388d01886a661ce2b952d6cfd7a79526e4c2",
      "skos:note": "CDR entity must provide information to consumers about access and complaint procedures.",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-95",
      "@type": "cof:Section",
      "cof:title": "95 After subsection 56ED(6)",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "Insert:\n(6A) If the CDR entity is a person who, as an action service provider for\na type of CDR action, has been or may be disclosed CDR data\nunder the consumer data rules, the CDR entity’s policy must\ncontain the following information:\n(a) how a CDR consumer for the CDR data may access the CDR\ndata and seek the correction of the CDR data;\n(b) how a CDR consumer for the CDR data may complain about\na failure of the CDR entity to comply with this Part or the\nconsumer data rules, and how the CDR entity will deal with\nsuch a complaint."
    },
