      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.6",
      "values:originalText": "(paragraph (a)\napplies)\nNote:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "skos:definition": "(paragraph (a)\napplies)\nNote:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sec-27-2-norm"
        }
      ],
      "cml:integrityHash": "59e5e23099a3996d59a10e48e2be42f3751858de5475c264a0a4986c9dcb725a",
      "skos:note": "Note: This table relates only to the provisions of this Act as originally enacted."
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sec-27-2",
      "@type": "cof:Section",
      "cof:title": "27 August 2024",
      "values:kind": "section",
      "cof:pageNumber": 6,
      "values:originalText": "(paragraph (a)\napplies)\nNote:\nThis table relates only to the provisions of this Act as originally\nenacted. It will not be amended to deal with any later amendments of\nthis Act.\n(2) Any information in column 3 of the table is not part of this Act.\nInformation may be inserted in this column, or information in it\nmay be edited, in any published version of this Act."
    },
