      }
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-181-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "CDR entity is a data holder, accredited data recipient, or designated gateway.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-182",
      "@type": "cml:Concept",
      "skos:prefLabel": "182 Subsection 56GD(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-182"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.62",
      "values:originalText": "Repeal the subsection, substitute:\n\nAmendments  Schedule 1\nMiscellaneous amendments  Part 8\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024\n(2) The Commission may, by written notice given to a person, exempt\nthe person in relation to:\n(a) particular CDR data or one or more classes of CDR data; or\n(b) a particular CDR action or one or more types of CDR\nactions;\nfrom all or specified provisions covered by this section.",
      "skos:definition": "Repeal the subsection, substitute:\n\nAmendments  Schedule 1\nMiscellaneous amendments  Part 8\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024\n(2) The Commission may, by written notice given to a person, exempt\nthe person in relation to:\n(a) particular CDR data or one or more classes of CDR data; or\n(b) a particular CDR action or one or more types of CDR\nactions;\nfrom all or specified provisions covered by this section.",
      "cml:asserts": [
        {
          "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-182-norm"
        }
      ],
      "cml:integrityHash": "73f98f68a823ba994209248d9c66125af0ebde89f7e56f03a9fea47da0b70c76",
      "skos:note": "Exempt from provisions covered by this section"
    },
    {
      "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-182",
      "@type": "cof:Section",
      "cof:title": "182 Subsection 56GD(2)",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "Repeal the subsection, substitute:\n\nAmendments  Schedule 1\nMiscellaneous amendments  Part 8\nNo. 75, 2024\nTreasury Laws Amendment (Consumer Data Right) Act 2024\n(2) The Commission may, by written notice given to a person, exempt\nthe person in relation to:\n(a) particular CDR data or one or more classes of CDR data; or\n(b) a particular CDR action or one or more types of CDR\nactions;\nfrom all or specified provisions covered by this section."
    },
