      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Disclosing CDR data to a person is prohibited.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Neither the CDR data nor any other CDR data from which it was directly or indirectly derived was disclosed to the person."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "The classes of data holders declared in the CDR declaration for that type of CDR action include the core data holders.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The designation instrument also specifies, as described in paragraph 56AC(2)(b), a class of persons (the core data holders) as holding a class of information to which the CDR data belongs."
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "The person is not a core data holder, but is a voluntary action service provider for a type of CDR action.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The person is not a core data holder, but is a voluntary action service provider for a type of CDR action; and"
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-36-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
