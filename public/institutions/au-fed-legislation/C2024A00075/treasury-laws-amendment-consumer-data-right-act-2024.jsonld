      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "No liability for actions taken in good faith and compliance with laws.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
