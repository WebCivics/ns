      },
      "values:partOf": {
        "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-183"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:treasury-laws-amendment-consumer-data-right-act-2024-sch-1-sec-184",
      "@type": "cml:Concept",
      "skos:prefLabel": "184 Subsection 56GE(2)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/treasury-laws-amendment-consumer-data-right-act-2024#sch-1-sec-184"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "treasury-laws-amendment-consumer-data-right-act-2024.pdf"
      },
      "dc:source": "treasury-laws-amendment-consumer-data-right-act-2024.pdf, p.63",
      "values:originalText": "Repeal the subsection, substitute:\n(2) The regulations may:\n(a) exempt a particular person in relation to:\n(i) particular CDR data or one or more classes of CDR\ndata; or\n(ii) a particular CDR action or one or more types of CDR\nactions;\nfrom all or specified provisions covered by this section; or\n(b) exempt a class of persons in relation to:\n(i) particular CDR data or one or more classes of CDR\ndata; or\n(ii) a particular CDR action or one or more types of CDR\nactions;\nfrom all or specified provisions covered by this section; or\n(c) declare that provisions covered by this section apply in\nrelation to:\n(i) a particular person in relation to particular CDR data or\none or more classes of CDR data; or\n(ii) a class of persons in relation to particular CDR data or\none or more classes of CDR data; or\n(iii) a particular person in relation to a particular CDR action\nor one or more types of CDR actions; or\n\nSchedule 1  Amendments",
      "skos:definition": "Repeal the subsection, substitute:\n(2) The regulations may:\n(a) exempt a particular person in relation to:\n(i) particular CDR data or one or more classes of CDR\ndata; or\n(ii) a particular CDR action or one or more types of CDR\nactions;\nfrom all or specified provisions covered by this section; or\n(b) exempt a class of persons in relation to:\n(i) particular CDR data or one or more classes of CDR\ndata; or\n(ii) a particular CDR action or one or more types of CDR\nactions;\nfrom all or specified provisions covered by this section; or\n(c) declare that provisions covered by this section apply in\nrelation to:\n(i) a particular person in relation to particular CDR data or\none or more classes of CDR data; or\n(ii) a class of persons in relation to particular CDR data or\none or more classes of CDR data; or\n(iii) a particular person in relation to a particular CDR action\nor one or more types of CDR actions; or\n\nSchedule 1  Amendments",
      "cml:asserts": [
