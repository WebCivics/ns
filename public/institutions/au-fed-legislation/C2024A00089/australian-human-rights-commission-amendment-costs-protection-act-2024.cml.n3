doc:sch-1-sec-3-ss-1 a cof:Section ;
    cof:title "3(1) Section 46PSA" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies to proceedings (including an appeal) in a court that relate to an application made by a person (the applicant) under section 46PO in respect of one or more respondents to a terminated complaint. When respondent liable for costs" ;
    cof:pageNumber "7"^^xsd:integer .

concept:australian-human-rights-commission-amendment-costs-protection-act-2024-sch-1-sec-3-ss-2 a cml:Concept ;
    skos:prefLabel "3(2) Section 46PSA"@en ;
    cml:realizedBy doc:sch-1-sec-3-ss-2 ;
    values:originalText "(2) Subject to subsection (4), if the applicant is successful in proceedings on one or more grounds, the court must order each respondent against whom the applicant is successful to pay the applicant’s costs." ;
    skos:definition "(2) Subject to subsection (4), if the applicant is successful in proceedings on one or more grounds, the court must order each respondent against whom the applicant is successful to pay the applicant’s costs."@en ;
    cml:integrityHash "ec83eb83f2fd54987950cc12b0cc12e0f79c9caf2b8105c9b82562446c139d31" ;
    values:partOf concept:australian-human-rights-commission-amendment-costs-protection-act-2024-sch-1-sec-3 ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Respondents must pay applicant's costs if successful in proceedings." ;
    cml:curationStatus cml:Proposed ;
