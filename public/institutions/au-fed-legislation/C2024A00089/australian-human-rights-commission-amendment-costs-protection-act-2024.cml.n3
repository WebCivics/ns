    values:partOf concept:australian-human-rights-commission-amendment-costs-protection-act-2024-sch-1-sec-3 ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Court not required to order respondent to pay costs incurred due to applicant's unreasonable act or omission." ;
    cml:curationStatus cml:Proposed ;
