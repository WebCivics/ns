        }
      ],
      "cml:integrityHash": "02a266a6007e8cf1f71035d93ecb72d49f0ae1c8bc2061a3bc400c59b55d8db7"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-human-rights-commission-amendment-costs-protection-act-2024#sch-1-sec-3",
