    <https://ns.webcivics.net/cml/operator> "=";
    <https://ns.webcivics.net/cml/logicSummary> "Class hierarchy for telecommunications facilities";
    <https://ns.webcivics.net/cml/premiseText> "telecommunications facility means a facility within the meaning of the Telecommunications Act 1997.";
