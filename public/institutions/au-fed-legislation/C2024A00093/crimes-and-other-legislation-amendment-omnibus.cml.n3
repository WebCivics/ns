doc:sch-5-sec-47 a cof:Section ;
    cof:title "47 Subsection 5(1)" ;
    values:kind "section" ;
    values:originalText "Insert: member of the staff of the Inspector of the Independent Commission Against Corruption (SA) means a person covered by an arrangement referred to in clause 4 of Schedule 4 to the Independent Commission Against Corruption Act (SA)." ;
