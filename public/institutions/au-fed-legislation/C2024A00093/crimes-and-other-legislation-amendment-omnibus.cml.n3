    cml:modality cml:Deontic ;
    cml:operator "MUST" ;
    cml:logicSummary "Inspector must deal with complaints and misconduct" ;
    cml:premiseText "Inspector of the Independent Commission Against Corruption (NSW) is responsible for dealing with complaints and misconduct." ;
    cml:conclusionText "The Inspector must deal with complaints and misconduct on the part of the Independent Commission Against Corruption (NSW) or an officer thereof." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-and-other-legislation-amendment-omnibus-sch-5-sec-65 cml:asserts concept:crimes-and-other-legislation-amendment-omnibus-sch-5-sec-65-logic-alleninterval-3 .
concept:crimes-and-other-legislation-amendment-omnibus-sch-5-sec-65-logic-alleninterval-3 a cml:LogicApplication ;
    cml:modality cml:AllenInterval ;
    cml:operator ">=" ;
    cml:logicSummary "Inspector must audit operations within a certain timeframe" ;
    cml:premiseText "The Inspector must audit the operations of the Independent Commission Against Corruption (NSW) for the purpose of monitoring compliance with the law." ;
    cml:conclusionText "The Inspector must audit the operations of the Independent Commission Against Corruption (NSW) at least once per year." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-and-other-legislation-amendment-omnibus-sch-5-sec-65 cml:asserts concept:crimes-and-other-legislation-amendment-omnibus-sch-5-sec-65-logic-ltl-4 .
concept:crimes-and-other-legislation-amendment-omnibus-sch-5-sec-65-logic-ltl-4 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator ">=" ;
    cml:logicSummary "Inspector must deal with complaints and misconduct within a certain timeframe" ;
    cml:premiseText "The Inspector must deal with complaints and misconduct on the part of the Independent Commission Against Corruption (NSW) or an officer thereof." ;
    cml:conclusionText "The Inspector must deal with complaints and misconduct within 30 days of receiving a complaint." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:crimes-and-other-legislation-amendment-omnibus-sch-5-sec-65 cml:asserts concept:crimes-and-other-legislation-amendment-omnibus-sch-5-sec-65-logic-deontic-5 .
