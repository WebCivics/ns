concept:crimes-and-other-legislation-amendment-omnibus-sch-4-sec-168 a cml:Concept ;
    skos:prefLabel "168 Industry assistance—Telecommunications Act 1997"@en ;
    cml:realizedBy doc:sch-4-sec-168 ;
    values:originalText "If, before the commencement of this Schedule, a power was exercised or a function or duty was performed by the Communications Access Co-ordinator under Part 15 of the Telecommunications Act 1997 on a day, then, on and after that commencement, a Communications Access Coordinator is taken to have exercised the power or performed the function or duty on that day." ;
    skos:definition "If, before the commencement of this Schedule, a power was exercised or a function or duty was performed by the Communications Access Co-ordinator under Part 15 of the Telecommunications Act 1997 on a day, then, on and after that commencement, a Communications Access Coordinator is taken to have exercised the power or performed the function or duty on that day."@en ;
    cml:integrityHash "4026ab5aa66451d8e0c367047724a82425dde43e92ee25b70a508fd497a98776" ;
    cof:pageNumber "55"^^xsd:integer ;
    skos:note "Continuity of Communications Access Coordinator's powers and duties" ;
