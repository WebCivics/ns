doc:sch-4-sec-7a-ss-3 a cof:Section ;
    cof:title "7A(3) Communications Security Coordinator" ;
    values:kind "subsection" ;
    values:originalText "(3) The Home Affairs Minister must only specify a person or class of persons in an instrument made under subsection (2) if the person is an APS employee, or the class consists wholly of APS employees, in the Home Affairs Department. Instrument must specify certain functions or powers" ;
    cof:pageNumber "32"^^xsd:integer .

