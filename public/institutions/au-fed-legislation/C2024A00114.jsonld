      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The temporal overlap is considered.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The person's consent overlaps with their age.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "TemporalOverlap",
      "cml:premiseText": "The person informs the court that they do not wish to be treated as such a complainant."
    },
    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person is not considered a child complainant.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Right to opt out of being treated as a child complainant.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "OptOut",
      "cml:premiseText": "The person informs the court that they do not wish to be treated as such a complainant."
    },
    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The person's refusal is respected.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Right to refuse being treated as a child complainant.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "RightToRefuse",
      "cml:premiseText": "The person informs the court that they do not wish to be treated as such a complainant."
    },
    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-2-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The information is disseminated.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The person's consent spreads information about their refusal.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "InformationSpread",
      "cml:premiseText": "The person informs the court that they do not wish to be treated as such a complainant."
    },
    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-2-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The recurring trace is updated accordingly.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The person's consent is part of a recurring trace.",
