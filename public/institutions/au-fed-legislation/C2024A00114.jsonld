    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-1",
      "@type": "cml:Concept",
      "dc:source": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf, p.10",
      "skos:note": "Defines a child witness in relation to a child proceeding. A child complainant in a child proceeding is defined as a child who is or was involved in the initiation of the proceeding.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "17A(1) After section 15YAB"
      },
      "wasDerivedFrom": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf",
