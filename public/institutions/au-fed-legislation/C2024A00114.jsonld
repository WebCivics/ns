    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-2",
      "@type": "cml:Concept",
      "dc:source": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf, p.10",
      "skos:note": "A person who is 18 or over can opt out of being treated as a child complainant. A person over 18 can opt out of being treated as a child witness.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "17A(2) After section 15YAB"
      },
