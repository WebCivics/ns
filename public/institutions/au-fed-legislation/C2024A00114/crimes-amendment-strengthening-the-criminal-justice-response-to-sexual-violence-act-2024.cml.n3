doc:sch-1-sec-17a-ss-1 a cof:Section ;
    cof:title "17A(1) After section 15YAB" ;
    values:kind "subsection" ;
    values:originalText "(1) A child witness, in relation to a child proceeding: (a) is a child (including a child complainant) who is a witness in the proceeding; and (b) includes a witness in the proceeding who was a child at the time the offence concerned was alleged to have been committed." ;
    cof:pageNumber "10"^^xsd:integer .

concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-2 a cml:Concept ;
    skos:prefLabel "17A(2) After section 15YAB"@en ;
    cml:realizedBy doc:sch-1-sec-17a-ss-2 ;
    values:originalText "(2) However, a person who is 18 or over is not a child witness if the person informs the court that the person does not wish to be treated as such a witness." ;
    skos:definition "(2) However, a person who is 18 or over is not a child witness if the person informs the court that the person does not wish to be treated as such a witness."@en ;
    cml:integrityHash "2d18889310171db4c441f574f730f1e0df6c2486f2c38282b808d56939469bcf" ;
    values:partOf concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "A person who is 18 or over can opt out of being treated as a child complainant. A person over 18 can opt out of being treated as a child witness." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
