concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-30 a cml:Concept ;
    skos:prefLabel "30 At the end of section 15YK"@en ;
    cml:realizedBy doc:sch-1-sec-30 ;
    values:originalText "Add: (2) The following must be allowed to see the vulnerable person, and any person present with the vulnerable person, on one or more television monitors while the evidence is given: (a) a defendant and the defendant’s legal representative (if any); (b) if there is a jury in the proceeding—the members of the jury." ;
    skos:definition "Add: (2) The following must be allowed to see the vulnerable person, and any person present with the vulnerable person, on one or more television monitors while the evidence is given: (a) a defendant and the defendant’s legal representative (if any); (b) if there is a jury in the proceeding—the members of the jury."@en ;
    cml:integrityHash "2b8cf68a4b5e48741cc9297147cc10a01173de0a6cabcfb39d7bc4c449a1df19" ;
    cof:pageNumber "19"^^xsd:integer ;
    skos:note "Allow vulnerable person and any present person to see evidence on television monitors." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
