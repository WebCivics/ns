doc:sch-1-sec-17a-ss-2 a cof:Section ;
    cof:title "17A(2) After section 15YAB" ;
    values:kind "subsection" ;
    values:originalText "(2) However, a person who is 18 or over is not a child complainant if the person informs the court that the person does not wish to be treated as such a complainant. 15YAD  Child witnesses" ;
    cof:pageNumber "10"^^xsd:integer .

concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-1 a cml:Concept ;
    skos:prefLabel "17A(1) After section 15YAB"@en ;
    cml:realizedBy doc:sch-1-sec-17a-ss-1 ;
    values:originalText "(1) A child witness, in relation to a child proceeding: (a) is a child (including a child complainant) who is a witness in the proceeding; and (b) includes a witness in the proceeding who was a child at the time the offence concerned was alleged to have been committed." ;
    skos:definition "(1) A child witness, in relation to a child proceeding: (a) is a child (including a child complainant) who is a witness in the proceeding; and (b) includes a witness in the proceeding who was a child at the time the offence concerned was alleged to have been committed."@en ;
    cml:integrityHash "564b96f832ae402101685d69ee6e6cd087fe08a75ac4fc271c77c021dd666582" ;
    values:partOf concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Defines a child witness in relation to a child proceeding. A child complainant in a child proceeding is defined as a child who is or was involved in the initiation of the proceeding." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf> ;
    dc:source "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf, p.10" ;
    cml:asserts concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-1-norm .
