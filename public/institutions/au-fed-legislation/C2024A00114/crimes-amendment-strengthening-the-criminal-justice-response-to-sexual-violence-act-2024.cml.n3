concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-2 a cml:Concept ;
    skos:prefLabel "17A(2) After section 15YAB"@en ;
    cml:realizedBy doc:sch-1-sec-17a-ss-2 ;
    values:originalText "(2) However, a person who is 18 or over is not a child complainant if the person informs the court that the person does not wish to be treated as such a complainant. 15YAD  Child witnesses" ;
    skos:definition "(2) However, a person who is 18 or over is not a child complainant if the person informs the court that the person does not wish to be treated as such a complainant. 15YAD  Child witnesses"@en ;
    cml:integrityHash "a4e01957ce131cd16e14ff28003ea912eca519bfeb5df01a000938dfef37a846" ;
    values:partOf concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "A person who is 18 or over can opt out of being treated as a child complainant. A person over 18 can opt out of being treated as a child witness." ;
