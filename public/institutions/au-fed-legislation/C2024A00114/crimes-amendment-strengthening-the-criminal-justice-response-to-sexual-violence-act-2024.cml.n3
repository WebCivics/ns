concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-1 a cml:Concept ;
    skos:prefLabel "1 After paragraph 15Y(1)(b)"@en ;
    cml:realizedBy doc:sch-1-sec-1 ;
    values:originalText "Insert: (ba) an offence against Division 268 of the Criminal Code that is: (ia) genocide (within the meaning of that Code); or (i) a crime against humanity (within the meaning of that Code); or (ii) a war crime (within the meaning of that Code); or (iii) a crime against the administration of the justice of the International Criminal Court (within the meaning of that Code);" ;
    skos:definition "Insert: (ba) an offence against Division 268 of the Criminal Code that is: (ia) genocide (within the meaning of that Code); or (i) a crime against humanity (within the meaning of that Code); or (ii) a war crime (within the meaning of that Code); or (iii) a crime against the administration of the justice of the International Criminal Court (within the meaning of that Code);"@en ;
    cml:integrityHash "319fbce612282ebc6ec7f49eb5a0f476ad15cd8793e66f744f2370873df17624" ;
    cof:pageNumber "7"^^xsd:integer ;
    skos:note "Offences against certain crimes" ;
