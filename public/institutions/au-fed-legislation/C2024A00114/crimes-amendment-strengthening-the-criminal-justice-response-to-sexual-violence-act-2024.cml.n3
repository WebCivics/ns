concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-53 a cml:Concept ;
    skos:prefLabel "53 Paragraph 15YR(1)(c)"@en ;
    cml:realizedBy doc:sch-1-sec-53 ;
    values:originalText "Repeal the paragraph, substitute: (c) the matter identifies, or is likely to lead to the identification of, another person (the vulnerable person) as: (i) a child witness or child complainant in a child proceeding; or (ii) a vulnerable adult complainant in a vulnerable adult proceeding; or (iii) in the case of a special witness in a special witness proceeding for whom an order under subsection 15YAB(3) is in force for this subparagraph—a special witness in a special witness proceeding; and" ;
    skos:definition "Repeal the paragraph, substitute: (c) the matter identifies, or is likely to lead to the identification of, another person (the vulnerable person) as: (i) a child witness or child complainant in a child proceeding; or (ii) a vulnerable adult complainant in a vulnerable adult proceeding; or (iii) in the case of a special witness in a special witness proceeding for whom an order under subsection 15YAB(3) is in force for this subparagraph—a special witness in a special witness proceeding; and"@en ;
    cml:integrityHash "5f39f9f0c330d6c25d6f8c2e2ae6d2fbc51574349b582f087b15993fcd157a06" ;
    cof:pageNumber "23"^^xsd:integer ;
    skos:note "Repeal paragraph and substitute with new definition for vulnerable person" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
