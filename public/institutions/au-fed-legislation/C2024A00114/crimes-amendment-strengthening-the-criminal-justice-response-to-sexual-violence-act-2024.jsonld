        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-17a-ss-1-norm"
        }
      ],
      "cml:integrityHash": "564b96f832ae402101685d69ee6e6cd087fe08a75ac4fc271c77c021dd666582",
      "skos:note": "Defines a child witness in relation to a child proceeding. A child complainant in a child proceeding is defined as a child who is or was involved in the initiation of the proceeding."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-17a-ss-1",
