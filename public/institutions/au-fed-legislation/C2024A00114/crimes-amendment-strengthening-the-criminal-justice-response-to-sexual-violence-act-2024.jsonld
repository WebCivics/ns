        }
      ],
      "cml:integrityHash": "c07ff0e84cb2ce9381de87928abad7c9ccc9363fc09e7f9e5d0d396d432a152d",
      "skos:note": "Court must consider certain factors when deciding if evidence has substantial probative value."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-26-ss-4",
      "@type": "cof:Section",
