    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-27a",
      "@type": "cml:Concept",
      "skos:prefLabel": "27A After section 15YF",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-27a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf"
      },
      "dc:source": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf, p.18",
      "values:originalText": "Insert:\n15YFA  Unrepresented defendants—cross-examination of vulnerable\nadult complainants\n(1) A defendant in a vulnerable adult proceeding who is not\nrepresented by counsel is not to cross-examine a vulnerable adult\ncomplainant.\n\nAmendments  Schedule 1\n\nNo. 114, 2024\nCrimes Amendment (Strengthening the Criminal Justice Response to\nSexual Violence) Act 2024\nNote:\nA person is not to cross-examine certain persons at committal\nproceedings or proceedings of a similar kind—see section 15YHA.\n(2) A person appointed by the court is to ask the vulnerable adult\ncomplainant any questions that the defendant requests the person to\nask the complainant.",
      "skos:definition": "Insert:\n15YFA  Unrepresented defendants—cross-examination of vulnerable\nadult complainants\n(1) A defendant in a vulnerable adult proceeding who is not\nrepresented by counsel is not to cross-examine a vulnerable adult\ncomplainant.\n\nAmendments  Schedule 1\n\nNo. 114, 2024\nCrimes Amendment (Strengthening the Criminal Justice Response to\nSexual Violence) Act 2024\nNote:\nA person is not to cross-examine certain persons at committal\nproceedings or proceedings of a similar kind—see section 15YHA.\n(2) A person appointed by the court is to ask the vulnerable adult\ncomplainant any questions that the defendant requests the person to\nask the complainant.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-27a-ss-1"
        },
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-27a-ss-2"
        }
      ],
      "cml:integrityHash": "0272ab4799d4dfe5b39276cae48a391acd8f5e288122afa9d7ed420530721383"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-27a",
      "@type": "cof:Section",
      "cof:title": "27A After section 15YF",
      "values:kind": "section",
      "cof:pageNumber": 18,
      "values:originalText": "Insert:\n15YFA  Unrepresented defendants—cross-examination of vulnerable\nadult complainants\n(1) A defendant in a vulnerable adult proceeding who is not\nrepresented by counsel is not to cross-examine a vulnerable adult\ncomplainant.\n\nAmendments  Schedule 1\n\nNo. 114, 2024\nCrimes Amendment (Strengthening the Criminal Justice Response to\nSexual Violence) Act 2024\nNote:\nA person is not to cross-examine certain persons at committal\nproceedings or proceedings of a similar kind—see section 15YHA.\n(2) A person appointed by the court is to ask the vulnerable adult\ncomplainant any questions that the defendant requests the person to\nask the complainant."
    },
