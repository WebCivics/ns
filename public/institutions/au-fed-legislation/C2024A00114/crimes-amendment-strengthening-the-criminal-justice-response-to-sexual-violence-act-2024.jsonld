    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Subsection 15YM(4) (not including the notes)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf"
      },
      "dc:source": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf, p.20",
      "values:originalText": "Repeal the subsection, substitute:\n(2) However, a recording that is an audio recording only must not be\nadmitted under subsection (1) unless the court is satisfied that\nextraordinary circumstances require the use of audio recording\nonly.\n(4) Subject to Divisions 2A and 3, if a video or audio recording of an\ninterview of a person is admitted as evidence in chief under\nsubsection (1), the person must be available for cross-examination\nand re-examination.",
      "skos:definition": "Repeal the subsection, substitute:\n(2) However, a recording that is an audio recording only must not be\nadmitted under subsection (1) unless the court is satisfied that\nextraordinary circumstances require the use of audio recording\nonly.\n(4) Subject to Divisions 2A and 3, if a video or audio recording of an\ninterview of a person is admitted as evidence in chief under\nsubsection (1), the person must be available for cross-examination\nand re-examination.",
      "cml:hasPart": [
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-36-ss-2"
        },
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-36-ss-4"
        }
      ],
      "cml:integrityHash": "fc61fc4a50e655d12b70c909f99174b3a8932dca19bfcf9d8128e3cad72db45b"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Subsection 15YM(4) (not including the notes)",
      "values:kind": "section",
      "cof:pageNumber": 20,
      "values:originalText": "Repeal the subsection, substitute:\n(2) However, a recording that is an audio recording only must not be\nadmitted under subsection (1) unless the court is satisfied that\nextraordinary circumstances require the use of audio recording\nonly.\n(4) Subject to Divisions 2A and 3, if a video or audio recording of an\ninterview of a person is admitted as evidence in chief under\nsubsection (1), the person must be available for cross-examination\nand re-examination."
    },
