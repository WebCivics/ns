    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 After paragraph 15Y(1)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf"
      },
      "dc:source": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf, p.7",
      "values:originalText": "Insert:\n(ba) an offence against Division 268 of the Criminal Code that is:\n(ia) genocide (within the meaning of that Code); or\n(i) a crime against humanity (within the meaning of that\nCode); or\n(ii) a war crime (within the meaning of that Code); or\n(iii) a crime against the administration of the justice of the\nInternational Criminal Court (within the meaning of that\nCode);",
      "skos:definition": "Insert:\n(ba) an offence against Division 268 of the Criminal Code that is:\n(ia) genocide (within the meaning of that Code); or\n(i) a crime against humanity (within the meaning of that\nCode); or\n(ii) a war crime (within the meaning of that Code); or\n(iii) a crime against the administration of the justice of the\nInternational Criminal Court (within the meaning of that\nCode);",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-1-norm"
        },
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-1-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "319fbce612282ebc6ec7f49eb5a0f476ad15cd8793e66f744f2370873df17624",
      "skos:note": "Offences against certain crimes"
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-1",
