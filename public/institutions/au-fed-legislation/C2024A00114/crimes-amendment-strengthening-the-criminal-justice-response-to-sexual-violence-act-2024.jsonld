      "dc:source": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf, p.6",
      "values:originalText": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 114, 2024\nCrimes Amendment (Strengthening the Criminal Justice Response to\nSexual Violence) Act 2024",
      "skos:definition": "Legislation that is specified in a Schedule to this Act is amended or\nrepealed as set out in the applicable items in the Schedule\nconcerned, and any other item in a Schedule to this Act has effect\naccording to its terms.\n\nAmendments  Schedule 1\n\nNo. 114, 2024\nCrimes Amendment (Strengthening the Criminal Justice Response to\nSexual Violence) Act 2024",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sec-3-norm"
        }
      ],
      "cml:integrityHash": "ebf8f9e016de9e93bb34b5e7e6fd6b14668eea64304be3fbfac7a060870108de",
      "skos:note": "Legislation in schedules is amended or repealed according to its terms."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sec-3",
