      "@type": "cml:Concept",
      "skos:prefLabel": "5 Before paragraph 15Y(2)(a)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-5"
      },
