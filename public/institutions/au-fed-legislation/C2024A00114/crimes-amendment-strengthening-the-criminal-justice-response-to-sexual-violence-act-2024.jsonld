        },
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-36-ss-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1895c326ad8dee5a359bb61735f791fcbc55574d0872f9b7260cfd1fa3d1fd5c",
      "skos:note": "Person must be available for cross-examination and re-examination if video or audio recording of interview is admitted as evidence."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-36-ss-4",
      "@type": "cof:Section",
      "cof:title": "36(4) Subsection 15YM(4) (not including the notes)",
      "values:kind": "subsection",
      "cof:pageNumber": 20,
      "values:originalText": "(4) Subject to Divisions 2A and 3, if a video or audio recording of an\ninterview of a person is admitted as evidence in chief under\nsubsection (1), the person must be available for cross-examination\nand re-examination."
    },
    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-36-ss-4-norm",
