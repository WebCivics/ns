      ],
      "cml:integrityHash": "2b8cf68a4b5e48741cc9297147cc10a01173de0a6cabcfb39d7bc4c449a1df19",
      "skos:note": "Allow vulnerable person and any present person to see evidence on television monitors."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-30",
