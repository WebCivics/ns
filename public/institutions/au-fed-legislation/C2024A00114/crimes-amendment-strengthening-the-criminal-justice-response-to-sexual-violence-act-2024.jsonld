      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-55-ss-2a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
