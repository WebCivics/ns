      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-57",
      "@type": "cml:Concept",
      "skos:prefLabel": "57 Subsection 15YR(5)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-57"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf"
      },
      "dc:source": "crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024.pdf, p.25",
      "values:originalText": "Repeal the subsection, substitute:\n(5) For the purpose of giving leave after the proceeding has been\ncompleted, the court need not be constituted by the same judicial\nofficers who constituted the court in the proceeding.",
      "skos:definition": "Repeal the subsection, substitute:\n(5) For the purpose of giving leave after the proceeding has been\ncompleted, the court need not be constituted by the same judicial\nofficers who constituted the court in the proceeding.",
      "cml:asserts": [
        {
          "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-57-norm"
        }
      ],
      "cml:integrityHash": "25c67a5e4e5b9409b0464ad50abe1bf3ff104eab44a6cfae9d81cc063ab45494",
      "skos:note": "Court need not be constituted by the same judicial officers who constituted the court in the proceeding."
    },
    {
      "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-57",
      "@type": "cof:Section",
      "cof:title": "57 Subsection 15YR(5)",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "Repeal the subsection, substitute:\n(5) For the purpose of giving leave after the proceeding has been\ncompleted, the court need not be constituted by the same judicial\nofficers who constituted the court in the proceeding."
    },
