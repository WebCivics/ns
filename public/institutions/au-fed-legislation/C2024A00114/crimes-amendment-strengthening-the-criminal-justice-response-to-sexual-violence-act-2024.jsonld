    {
      "@id": "concept:crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024-sch-1-sec-24c",
      "@type": "cml:Concept",
      "skos:prefLabel": "24C At the end of subsection 15YC(2)(b)",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/crimes-amendment-strengthening-the-criminal-justice-response-to-sexual-violence-act-2024#sch-1-sec-24c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
