      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The personal info must be used in the computer program",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
