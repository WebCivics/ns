    {
      "@id": "concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-1-2-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The decision must affect individual rights or interests",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Decision affects individual rights or interests",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:premiseText": "the decision could reasonably be expected to significantly affect the rights or interests of an individual;"
    },
    {
      "@id": "concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-1-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The entity must have arranged for a computer program",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Entity has arranged for computer program",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "the entity has arranged for a computer program to make, or do a thing that is substantially and directly related to making, a decision;"
    },
    {
      "@id": "concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-1-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The decision must affect individual rights or interests",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Decision affects individual rights or interests",
      "cml:modality": {
