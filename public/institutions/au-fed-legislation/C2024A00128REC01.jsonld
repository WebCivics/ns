      "cml:logicSummary": "Personal info used in computer program",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:premiseText": "personal information about the individual is used in the operation of the computer program to make the decision or do the thing that is substantially and directly related to making the decision."
    },
