    cml:modality cml:LTL ;
    cml:operator "BUT" ;
    cml:logicSummary "Conditional commencement" ;
    cml:premiseText "(b) otherwise—before the earlier of: (i) the day that is 1 year after the day on which the plaintiff became aware of the invasion of privacy; and (ii) the day that is 3 years after the invasion of privacy occurred." ;
    cml:conclusionText "Commencement is conditional upon awareness or a specific timeframe." ;
