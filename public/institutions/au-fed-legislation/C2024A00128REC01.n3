concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-19-ss-1-norm a values:Prohibition ;
    cml:modality cml:Deontic ;
    values:partOf concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-19-ss-1 ;
    values:borneBy values:Agent ;
    values:deonticStatus values:HeuristicDerived ;
    cml:curationStatus cml:Proposed .
concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-19-ss-1 cml:asserts concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-19-ss-1-logic-deontic-1 .
concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-19-ss-1-logic-deontic-1 a cml:LogicApplication ;
    cml:modality cml:Deontic ;
    cml:operator "forbid" ;
    cml:logicSummary "Prohibits subsequent publication of substantially the same information in a different manner." ;
    cml:premiseText "(a) a publisher publishes information that relates to an individual to the public (the first publication); and (b) the publisher or an associate of the publisher subsequently publishes (whether or not to the public) information that is substantially the same (the subsequent publication); and (c) the manner of the subsequent publication is not materially different from the manner of the first publication." ;
    cml:conclusionText "(1) This clause applies if: (a) a publisher publishes information that relates to an individual to the public (the first publication); and (b) the publisher or an associate of the publisher subsequently publishes (whether or not to the public) information that is substantially the same (the subsequent publication); and (c) the manner of the subsequent publication is not materially different from the manner of the first publication." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .


