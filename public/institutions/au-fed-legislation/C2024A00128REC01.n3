    cml:modality cml:AllenInterval ;
    cml:operator "BETWEEN" ;
    cml:logicSummary "Temporal interval for commencement" ;
    cml:premiseText "(i) the day that is 1 year after the day on which the plaintiff became aware of the invasion of privacy; and (ii) the day that is 3 years after the invasion of privacy occurred." ;
    cml:conclusionText "The commencement period falls within a specific temporal interval." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-14-ss-1 cml:asserts concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-14-ss-1-logic-ltl-3 .
