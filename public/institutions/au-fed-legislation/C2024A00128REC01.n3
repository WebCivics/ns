concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-19-ss-1 a cml:Concept ;
    skos:prefLabel "19(1) Single publication rule"@en ;
    cml:realizedBy doc:sch-2-sec-19-ss-1 ;
    cml:integrityHash "415524ee10d29e74fae41fb070c9855c105ac13feb9aeff0f3ebf6fab45d1bd8" ;
    values:partOf concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-19 ;
    skos:note "Prohibits subsequent publication of substantially the same information in a different manner." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-and-other-legislation-amendment-act-2024.pdf> ;
    dc:source "privacy-and-other-legislation-amendment-act-2024.pdf, p.82" ;
