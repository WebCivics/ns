doc:sch-1-sec-33f a cof:Section ;
    cof:title "33F Commissioner may invite submissions" ;
    values:kind "section" ;
    values:originalText "The Commissioner may invite submissions on matters that are the subject of a public inquiry. Note: Under subsection 33E(6), the Commissioner may require submissions to be in writing." ;
    cof:pageNumber "47"^^xsd:integer .

concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-33g a cml:Concept ;
    skos:prefLabel "33G Commissioner not bound by the rules of evidence"@en ;
    cml:realizedBy doc:sch-1-sec-33g ;
    values:originalText "The Commissioner is not bound by the rules of evidence and may inform themselves on any matter in such manner as the Commissioner thinks fit." ;
    skos:definition "The Commissioner is not bound by the rules of evidence and may inform themselves on any matter in such manner as the Commissioner thinks fit."@en ;
