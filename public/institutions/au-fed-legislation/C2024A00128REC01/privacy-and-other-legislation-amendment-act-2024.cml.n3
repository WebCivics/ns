doc:sch-1-sec-13h-ss-1 a cof:Section ;
    cof:title "13H(1) Civil penalty provision for interference with privacy of" ;
    values:kind "subsection" ;
    values:originalText "(1) An entity contravenes this subsection if the entity does an act, or engages in a practice, that is an interference with the privacy of an individual." ;
    cof:pageNumber "37"^^xsd:integer .

