concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-35 a cml:Concept ;
    skos:prefLabel "35 Application of amendment"@en ;
    cml:realizedBy doc:sch-1-sec-35 ;
    values:originalText "The amendment of clause 11 of Schedule 1 to the Privacy Act 1988 made by this Part applies in relation to information held after the commencement of this Part, regardless of whether the information was acquired or created before or after that commencement.  Privacy reforms  Schedule 1 Overseas data flows  Part 6 No. 128, 2024 Privacy and Other Legislation Amendment Act 2024" ;
    skos:definition "The amendment of clause 11 of Schedule 1 to the Privacy Act 1988 made by this Part applies in relation to information held after the commencement of this Part, regardless of whether the information was acquired or created before or after that commencement.  Privacy reforms  Schedule 1 Overseas data flows  Part 6 No. 128, 2024 Privacy and Other Legislation Amendment Act 2024"@en ;
    cml:integrityHash "a577f00a483e4a175e8139430377510802b559beb02dc0ba697aa4e0aff5ef55" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Amendment of clause 11 of Schedule 1 applies to information held after commencement." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-and-other-legislation-amendment-act-2024.pdf> ;
