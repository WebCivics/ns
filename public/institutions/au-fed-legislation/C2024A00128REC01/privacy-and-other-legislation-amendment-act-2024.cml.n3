    cml:hasPart concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-26xf-ss-8 ;
    cml:hasPart concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-26xf-ss-9 ;
    cml:hasPart concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-26xf-ss-10 ;
