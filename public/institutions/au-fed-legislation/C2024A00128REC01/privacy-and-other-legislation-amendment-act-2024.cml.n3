concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-22 a cml:Concept ;
    skos:prefLabel "22 Intervention of Information Commissioner"@en ;
    cml:realizedBy doc:sch-2-sec-22 ;
    values:originalText "The Information Commissioner may, with the leave of the court: (a) intervene in proceedings under this Schedule; or (b) assist the court as amicus curiae." ;
    skos:definition "The Information Commissioner may, with the leave of the court: (a) intervene in proceedings under this Schedule; or (b) assist the court as amicus curiae."@en ;
