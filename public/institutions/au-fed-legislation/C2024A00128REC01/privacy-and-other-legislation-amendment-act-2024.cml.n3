concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-13j a cml:Concept ;
    skos:prefLabel "13J Alternative orders"@en ;
    cml:realizedBy doc:sch-1-sec-13j ;
    values:originalText "If, in proceedings for an order in relation to a contravention of section 13G, the court: (a) is satisfied that the entity has done an act, or engaged in a practice, that is an interference with the privacy of an individual; but (b) is not satisfied that the interference with privacy is serious;  Schedule 1  Privacy reforms" ;
    skos:definition "If, in proceedings for an order in relation to a contravention of section 13G, the court: (a) is satisfied that the entity has done an act, or engaged in a practice, that is an interference with the privacy of an individual; but (b) is not satisfied that the interference with privacy is serious;  Schedule 1  Privacy reforms"@en ;
    cml:integrityHash "4c9fa24f7e9bacdc024fcc1358451ecae3176615f97f9e73e6d79ca778cc9716" ;
    cof:pageNumber "37"^^xsd:integer ;
    skos:note "Interference with privacy is not serious if court is satisfied." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-and-other-legislation-amendment-act-2024.pdf> ;
    dc:source "privacy-and-other-legislation-amendment-act-2024.pdf, p.37" ;
    cml:asserts concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-13j-norm .
