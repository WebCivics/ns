doc:sch-1-sec-80ka-ss-1 a cof:Section ;
    cof:title "80KA(1) Matters covered by declarations" ;
    values:kind "subsection" ;
    values:originalText "(1) Without limiting section 80J or 80K, an emergency declaration must specify the following matters: (a) the kind or kinds of personal information to which the declaration applies; (b) the entity or class of entities that may collect, use or disclose the personal information; (c) the entity or class of entities that the personal information may be disclosed to; (d) one or more permitted purposes of the collection, use or disclosure. Note: See section 80P (authorisation of collection, use and disclosure of personal information). Specified entities" ;
    cof:pageNumber "13"^^xsd:integer .

concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-80ka-ss-2 a cml:Concept ;
    skos:prefLabel "80KA(2) Matters covered by declarations"@en ;
    cml:realizedBy doc:sch-1-sec-80ka-ss-2 ;
    values:originalText "(2) An entity or class of entities specified for the purposes of paragraph (1)(c): (a) may include a State or Territory authority; and (b) must not be or include a media organisation, the Australian Broadcasting Corporation or the Special Broadcasting Service Corporation. Specified permitted purposes" ;
    skos:definition "(2) An entity or class of entities specified for the purposes of paragraph (1)(c): (a) may include a State or Territory authority; and (b) must not be or include a media organisation, the Australian Broadcasting Corporation or the Special Broadcasting Service Corporation. Specified permitted purposes"@en ;
    cml:integrityHash "1224276867942ec0a2db8cac56e5fd7c73e14b2a62d335a2673662b9e728d38c" ;
    values:partOf concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-80ka ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Entities or classes of entities may include State or Territory authorities, but must not include media organisations." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
