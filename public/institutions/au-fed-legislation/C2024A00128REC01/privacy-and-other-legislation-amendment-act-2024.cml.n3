concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-80uc-ss-7 a cml:Concept ;
    skos:prefLabel "80UC(7) Compliance notices"@en ;
    cml:realizedBy doc:sch-1-sec-80uc-ss-7 ;
    values:originalText "(7) An entity that complies with a notice given under subsection (1) in relation to a contravention of subsection 13K(1) or (2) is not taken by that compliance: (a) to have admitted to contravening that subsection; or (b) to have been found to have contravened that subsection.  Schedule 1  Privacy reforms" ;
    skos:definition "(7) An entity that complies with a notice given under subsection (1) in relation to a contravention of subsection 13K(1) or (2) is not taken by that compliance: (a) to have admitted to contravening that subsection; or (b) to have been found to have contravened that subsection.  Schedule 1  Privacy reforms"@en ;
    cml:integrityHash "2ae021bcf2842b82b67b570e51580bed8c8af91d7f6a30c543577d602a69c82f" ;
    values:partOf concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-80uc ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Compliance with notice relieves liability for contravention of subsections 13K(1) or (2)" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-and-other-legislation-amendment-act-2024.pdf> ;
