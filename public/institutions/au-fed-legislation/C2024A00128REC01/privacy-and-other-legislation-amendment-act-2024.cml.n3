concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-80ka-ss-3 a cml:Concept ;
    skos:prefLabel "80KA(3) Matters covered by declarations"@en ;
    cml:realizedBy doc:sch-1-sec-80ka-ss-3 ;
    values:originalText "(3) A permitted purpose specified for the purposes of paragraph (1)(d) must be a purpose that directly relates to the Commonwealth’s response to an emergency or disaster in respect of which an emergency declaration is in force." ;
    skos:definition "(3) A permitted purpose specified for the purposes of paragraph (1)(d) must be a purpose that directly relates to the Commonwealth’s response to an emergency or disaster in respect of which an emergency declaration is in force."@en ;
    cml:integrityHash "8e393a7a930be99d6d8de85dfdba88caf29f0f6e6cc26408b9607ae3b0685c19" ;
    values:partOf concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-80ka ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Purpose must relate to Commonwealth's response to emergency or disaster" ;
    cml:curationStatus cml:Proposed ;
