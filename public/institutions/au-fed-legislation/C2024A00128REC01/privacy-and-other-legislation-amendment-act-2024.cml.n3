concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-33e-ss-7 a cml:Concept ;
    skos:prefLabel "33E(7) Inquiries by Commissioner"@en ;
    cml:realizedBy doc:sch-1-sec-33e-ss-7 ;
    values:originalText "(7) To avoid doubt, an inquiry does not constitute an investigation under section 40 nor a preliminary inquiry under section 42." ;
