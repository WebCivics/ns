concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-33h a cml:Concept ;
    skos:prefLabel "33H Commissioner’s powers"@en ;
    cml:realizedBy doc:sch-1-sec-33h ;
    values:originalText "Sections 44 (power to obtain information or documents) and 45 (power to examine witnesses) apply for the purposes of a public inquiry in the same way as those provisions apply to an investigation under Part V.  Schedule 1  Privacy reforms" ;
    skos:definition "Sections 44 (power to obtain information or documents) and 45 (power to examine witnesses) apply for the purposes of a public inquiry in the same way as those provisions apply to an investigation under Part V.  Schedule 1  Privacy reforms"@en ;
    cml:integrityHash "c5062cff0be35c8d34f4d0204a66f3b29c5008525bde66da9ab456c3d35b5227" ;
    cof:pageNumber "47"^^xsd:integer ;
    skos:note "Sections 44 and 45 apply to a public inquiry in the same way as they do to an investigation under Part V." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
