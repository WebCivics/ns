    cml:hasPart concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-15-ss-4 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <privacy-and-other-legislation-amendment-act-2024.pdf> ;
    dc:source "privacy-and-other-legislation-amendment-act-2024.pdf, p.79" .
