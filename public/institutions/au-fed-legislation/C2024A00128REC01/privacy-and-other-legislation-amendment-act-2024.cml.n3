concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-70 a cml:Concept ;
    skos:prefLabel "70 At the end of subsection 32(1)"@en ;
    cml:realizedBy doc:sch-1-sec-70 ;
    values:originalText "Add: ; (c) a statement including details about the number of complaints made under section 36 of the Privacy Act 1988 during the year; (d) a statement including details about the number of complaints made under section 36 of the Privacy Act 1988 in relation to which the Commissioner has decided during the year under section 41 of that Act not to investigate, or not to investigate further, and the relevant grounds for the decision." ;
    skos:definition "Add: ; (c) a statement including details about the number of complaints made under section 36 of the Privacy Act 1988 during the year; (d) a statement including details about the number of complaints made under section 36 of the Privacy Act 1988 in relation to which the Commissioner has decided during the year under section 41 of that Act not to investigate, or not to investigate further, and the relevant grounds for the decision."@en ;
    cml:integrityHash "e8d5f5f9ff7b010ceb13490eb4b757f5cbbfb12bf9d97923931f982e052b3f04" ;
    cof:pageNumber "51"^^xsd:integer ;
