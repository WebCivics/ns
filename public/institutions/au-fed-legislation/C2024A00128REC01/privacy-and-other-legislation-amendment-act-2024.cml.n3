doc:sch-2-sec-6-2-ss-2 a cof:Section ;
    cof:title "6(2) Interpretation" ;
    values:kind "subsection" ;
    values:originalText "(2) In determining the meaning of an expression used in a provision of this Schedule, an expression used in the rest of this Act is to be disregarded (unless a provision of this Schedule expressly provides otherwise)." ;
    cof:pageNumber "70"^^xsd:integer .

