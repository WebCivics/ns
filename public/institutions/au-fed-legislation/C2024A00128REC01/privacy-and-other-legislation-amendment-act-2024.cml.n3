    values:partOf concept:privacy-and-other-legislation-amendment-act-2024-sch-2-sec-15 ;
    cof:pageNumber "79"^^xsd:integer ;
    skos:note "Journalist's invasion of privacy is an obligation for the state." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
