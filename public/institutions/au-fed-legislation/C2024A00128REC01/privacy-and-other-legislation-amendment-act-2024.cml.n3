concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-1-3 a cml:Concept ;
    skos:prefLabel "1 8 The information covered by this subclause is:"@en ;
    cml:realizedBy doc:sch-1-sec-1-3 ;
    values:originalText "(a) the kinds of personal information used in the operation of such computer programs; and (b) the kinds of such decisions made solely by the operation of such computer programs; and (c) the kinds of such decisions for which a thing, that is substantially and directly related to making the decision, is done by the operation of such computer programs." ;
    skos:definition "(a) the kinds of personal information used in the operation of such computer programs; and (b) the kinds of such decisions made solely by the operation of such computer programs; and (c) the kinds of such decisions for which a thing, that is substantially and directly related to making the decision, is done by the operation of such computer programs."@en ;
    cml:integrityHash "ea8587e2879340aa59ace5564d3e5ad30ffbc54cecc0578ad6a2892a13b29ee0" ;
    cof:pageNumber "64"^^xsd:integer ;
    skos:note "Reveals kinds of personal information used in computer programs and decisions made solely by them." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
