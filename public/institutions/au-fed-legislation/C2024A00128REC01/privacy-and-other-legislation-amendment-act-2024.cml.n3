doc:sch-1-sec-33e-ss-1 a cof:Section ;
    cof:title "33E(1) Inquiries by Commissioner" ;
    values:kind "subsection" ;
    values:originalText "(1) The Minister may, in writing, direct the Commissioner to conduct, or approve the Commissioner conducting, a public inquiry into a specified matter or specified matters relating to privacy." ;
    cof:pageNumber "46"^^xsd:integer .

concept:privacy-and-other-legislation-amendment-act-2024-sch-1-sec-33e-ss-2 a cml:Concept ;
