concept:human-rights-parliamentary-scrutiny-act-2011-sec-6 a cml:Concept ;
    skos:prefLabel "6 Powers and proceedings of the Committee"@en ;
    cml:realizedBy doc:sec-6 ;
    values:originalText "All matters relating to the powers and proceedings of the Committee are to be determined by resolution of both Houses of the Parliament." ;
    skos:definition "All matters relating to the powers and proceedings of the Committee are to be determined by resolution of both Houses of the Parliament."@en ;
