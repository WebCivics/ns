    cof:pageNumber "6"^^xsd:integer .

concept:human-rights-parliamentary-scrutiny-act-2011-sec-4-2 a cml:Concept ;
    skos:prefLabel "4 Parliamentary Joint Committee on Human Rights"@en ;
    cml:realizedBy doc:sec-4-2 ;
    values:originalText "As soon as practicable after the commencement of the first session of each Parliament, a joint committee of members of the Parliament, to be known as the Parliamentary Joint Committee on Human Rights, is to be appointed according to the practice of the Parliament." ;
    skos:definition "As soon as practicable after the commencement of the first session of each Parliament, a joint committee of members of the Parliament, to be known as the Parliamentary Joint Committee on Human Rights, is to be appointed according to the practice of the Parliament."@en ;
    cml:integrityHash "4d56c5405e27fc5f4d366bbc227c6cb4b8323ae07ef50762870c70e86cccc714" ;
    cof:pageNumber "8"^^xsd:integer ;
    skos:note "Establishment of Parliamentary Joint Committee on Human Rights" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <human-rights-parliamentary-scrutiny-act-2011.pdf> ;
    dc:source "human-rights-parliamentary-scrutiny-act-2011.pdf, p.8" ;
    cml:asserts concept:human-rights-parliamentary-scrutiny-act-2011-sec-4-2-norm .
