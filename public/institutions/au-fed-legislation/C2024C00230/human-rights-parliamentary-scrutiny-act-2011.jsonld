    {
      "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-7-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "7 Functions of the Committee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-parliamentary-scrutiny-act-2011#sec-7-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-parliamentary-scrutiny-act-2011.pdf"
      },
      "dc:source": "human-rights-parliamentary-scrutiny-act-2011.pdf, p.9",
      "values:originalText": "The Committee has the following functions:\n(a) to examine Bills for Acts, and legislative instruments, that\ncome before either House of the Parliament for compatibility\nwith human rights, and to report to both Houses of the\nParliament on that issue;\n(b) to examine Acts for compatibility with human rights, and to\nreport to both Houses of the Parliament on that issue;\n(c) to inquire into any matter relating to human rights which is\nreferred to it by the Attorney-General, and to report to both\nHouses of the Parliament on that matter.",
      "skos:definition": "The Committee has the following functions:\n(a) to examine Bills for Acts, and legislative instruments, that\ncome before either House of the Parliament for compatibility\nwith human rights, and to report to both Houses of the\nParliament on that issue;\n(b) to examine Acts for compatibility with human rights, and to\nreport to both Houses of the Parliament on that issue;\n(c) to inquire into any matter relating to human rights which is\nreferred to it by the Attorney-General, and to report to both\nHouses of the Parliament on that matter.",
      "cml:asserts": [
        {
          "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-7-2-norm"
        },
        {
          "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-7-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e29468a9ae0227d0534319042e5037cf41e35d2311f3d9013327417e8869ee89",
      "skos:note": "The Committee has functions related to human rights examination and reporting."
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-parliamentary-scrutiny-act-2011#sec-7-2",
      "@type": "cof:Section",
      "cof:title": "7 Functions of the Committee",
      "values:kind": "section",
      "cof:pageNumber": 9,
      "values:originalText": "The Committee has the following functions:\n(a) to examine Bills for Acts, and legislative instruments, that\ncome before either House of the Parliament for compatibility\nwith human rights, and to report to both Houses of the\nParliament on that issue;\n(b) to examine Acts for compatibility with human rights, and to\nreport to both Houses of the Parliament on that issue;\n(c) to inquire into any matter relating to human rights which is\nreferred to it by the Attorney-General, and to report to both\nHouses of the Parliament on that matter."
    },
    {
      "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-7-2-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-7-2"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-7-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "The Committee has a function.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Statements of compatibility in relation to Bills",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-parliamentary-scrutiny-act-2011#sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-parliamentary-scrutiny-act-2011.pdf"
      },
      "dc:source": "human-rights-parliamentary-scrutiny-act-2011.pdf, p.10",
      "values:originalText": "(1) A member of Parliament who proposes to introduce a Bill for an\nAct into a House of the Parliament must cause a statement of\ncompatibility to be prepared in respect of that Bill.\n(2) A member of Parliament who introduces a Bill for an Act into a\nHouse of the Parliament, or another member acting on his or her\nbehalf, must cause the statement of compatibility prepared under\nsubsection (1) to be presented to the House.\n(3) A statement of compatibility must include an assessment of\nwhether the Bill is compatible with human rights.\n(4) A statement of compatibility prepared under subsection (1) is not\nbinding on any court or tribunal.\n(5) A failure to comply with this section in relation to a Bill that\nbecomes an Act does not affect the validity, operation or\nenforcement of the Act or any other provision of a law of the\nCommonwealth.",
      "skos:definition": "(1) A member of Parliament who proposes to introduce a Bill for an\nAct into a House of the Parliament must cause a statement of\ncompatibility to be prepared in respect of that Bill.\n(2) A member of Parliament who introduces a Bill for an Act into a\nHouse of the Parliament, or another member acting on his or her\nbehalf, must cause the statement of compatibility prepared under\nsubsection (1) to be presented to the House.\n(3) A statement of compatibility must include an assessment of\nwhether the Bill is compatible with human rights.\n(4) A statement of compatibility prepared under subsection (1) is not\nbinding on any court or tribunal.\n(5) A failure to comply with this section in relation to a Bill that\nbecomes an Act does not affect the validity, operation or\nenforcement of the Act or any other provision of a law of the\nCommonwealth.",
      "cml:hasPart": [
        {
          "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-8-ss-1"
        },
        {
          "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-8-ss-2"
        },
        {
          "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-8-ss-3"
        },
        {
          "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-8-ss-4"
        },
        {
          "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-8-ss-5"
        }
      ],
      "cml:integrityHash": "8a97b92d260cb010f9d04b8b7c148190bb97a8b51d179e0622dd59d5aa8585df"
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-parliamentary-scrutiny-act-2011#sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Statements of compatibility in relation to Bills",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "(1) A member of Parliament who proposes to introduce a Bill for an\nAct into a House of the Parliament must cause a statement of\ncompatibility to be prepared in respect of that Bill.\n(2) A member of Parliament who introduces a Bill for an Act into a\nHouse of the Parliament, or another member acting on his or her\nbehalf, must cause the statement of compatibility prepared under\nsubsection (1) to be presented to the House.\n(3) A statement of compatibility must include an assessment of\nwhether the Bill is compatible with human rights.\n(4) A statement of compatibility prepared under subsection (1) is not\nbinding on any court or tribunal.\n(5) A failure to comply with this section in relation to a Bill that\nbecomes an Act does not affect the validity, operation or\nenforcement of the Act or any other provision of a law of the\nCommonwealth."
    },
