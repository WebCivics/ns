    {
      "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Powers and proceedings of the Committee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-parliamentary-scrutiny-act-2011#sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "human-rights-parliamentary-scrutiny-act-2011.pdf"
      },
      "dc:source": "human-rights-parliamentary-scrutiny-act-2011.pdf, p.9",
      "values:originalText": "All matters relating to the powers and proceedings of the\nCommittee are to be determined by resolution of both Houses of\nthe Parliament.",
      "skos:definition": "All matters relating to the powers and proceedings of the\nCommittee are to be determined by resolution of both Houses of\nthe Parliament.",
