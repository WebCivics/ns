      "skos:note": "Either House of Parliament may appoint a member to fill a vacancy in the Committee."
    },
    {
      "@id": "https://ns.webcivics.net/values/human-rights-parliamentary-scrutiny-act-2011#sec-5-ss-6",
      "@type": "cof:Section",
      "cof:title": "5(6) Membership of the Committee",
      "values:kind": "subsection",
      "cof:pageNumber": 8,
      "values:originalText": "(6) Either House of the Parliament may appoint one of its members to\nfill a vacancy amongst the members of the Committee appointed\nby that House."
    },
