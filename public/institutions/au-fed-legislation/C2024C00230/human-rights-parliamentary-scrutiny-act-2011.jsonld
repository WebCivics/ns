    {
      "@id": "concept:human-rights-parliamentary-scrutiny-act-2011-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Definitions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/human-rights-parliamentary-scrutiny-act-2011#sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
