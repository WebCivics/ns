    {
      "@id": "concept:gene-technology-act-2000-sec-14-logic-descriptionlogic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The compilation is a representation of the law as it stands.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classifies the text of the law as amended.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The compilation shows the text of the law as amended and in force on 14 October 2024."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The notes provide context for understanding changes to the law.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Provides information about amending laws and amendment history.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The notes at the end of this compilation include information about amending laws and the amendment history of provisions of the compiled law."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Uncommenced amendments do not affect the current text of the law.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Describes the effect of uncommenced amendments.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "The effect of uncommenced amendments is not shown in the text of the compiled law."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The compilation does not include all relevant information about applications, saving, and transitional provisions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Provides information about applications, saving, and transitional provisions.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "If the operation of a provision or amendment of the compiled law is affected by an application, saving or transitional provision that is not included in this compilation, details are included in the endnotes."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The compilation does not show the text of the compiled law as modified.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Describes modifications to the compiled law.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "If the compiled law is modified by another law, the compiled law operates as modified but the modification does not amend the text of the law."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-logic-descriptionlogic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The compilation notes any repealed provisions.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Describes self-repealing provisions.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Applicable",
      "cml:premiseText": "If a provision of the compiled law has been repealed in accordance with a provision of the law, details are included in the endnotes."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-norm",
      "@type": "doc:Undertaking",
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "doc:deonticStatus": {
        "@id": "doc:HeuristicDerived"
      },
      "partOf": "concept:gene-technology-act-2000-sec-14"
    },
