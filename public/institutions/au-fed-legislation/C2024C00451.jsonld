    {
      "@id": "concept:gene-technology-act-2000-sec-14-2-ss-1",
      "@type": "cml:Concept",
      "dc:source": "gene-technology-act-2000.pdf, p.24",
      "skos:note": "Wind-back notice in relation to a State is in force at that time.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "14(1) Wind-back of reach of Act"
      },
      "wasDerivedFrom": "gene-technology-act-2000.pdf",
      "asserts": [
        "concept:gene-technology-act-2000-sec-14-2-ss-1-norm",
        "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-deontic-1",
        "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-alleninterval-2",
        "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-ltl-3",
        "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-diffusion-4",
        "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "8168cc6bcb1b98f24390b922d8af82dca2e527b90f11287bd7085ceb72fedc56",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:gene-technology-act-2000#sec-14-2-ss-1",
