    skos:prefLabel "72A Simplified outline"@en ;
    cml:realizedBy doc:sec-72a ;
    values:originalText "The following is a simplified outline of this Part: This Part provides a system under which the Minister can make determinations relating to dealings with GMOs in emergencies.   Emergency dealing determinations  Part 5A Making of emergency dealing determination  Division 2 Section 72B Gene Technology Act 2000 Compilation date: 14/10/2024" ;
    skos:definition "The following is a simplified outline of this Part: This Part provides a system under which the Minister can make determinations relating to dealings with GMOs in emergencies.   Emergency dealing determinations  Part 5A Making of emergency dealing determination  Division 2 Section 72B Gene Technology Act 2000 Compilation date: 14/10/2024"@en ;
    cml:integrityHash "6ec93e6af5269fa9f7ad3d491cc5726730ce67c2a50c3b0b58acc663f149213d" ;
    cof:pageNumber "68"^^xsd:integer ;
