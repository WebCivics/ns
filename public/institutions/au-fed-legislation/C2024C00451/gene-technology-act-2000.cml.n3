    cml:logicSummary "Temporal disjointness" ;
    cml:premiseText "(2) A licence is not in force throughout any period of suspension." ;
    cml:conclusionText "The period of suspension and the licence's effective period are disjoint temporal intervals." ;
    cml:executionSurface "modalities::interval_reasoning" ;
    cml:confidence "1.0000"^^xsd:decimal ;
