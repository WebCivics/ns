concept:gene-technology-act-2000-sec-101 a cml:Concept ;
    skos:prefLabel "101 Function of the Gene Technology Technical Advisory"@en ;
    cml:realizedBy doc:sec-101 ;
    values:originalText "Committee The function of the Gene Technology Technical Advisory Committee is to provide scientific and technical advice, on the request of the Regulator or the Ministerial Council, on the following:" ;
