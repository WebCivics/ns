doc:sec-183a-ss-1 a cof:Section ;
    cof:title "183A(1) Extended standing for judicial review" ;
    values:kind "subsection" ;
    values:originalText "(1) This section extends (and does not limit) the meaning of the term person aggrieved in the Administrative Decisions (Judicial Review) Act 1977 for the purposes of the application of that Act in relation to: (a) a decision made under this Act or the regulations; or (b) a failure to make a decision under this Act or the regulations; or (c) conduct engaged in for the purpose of making a decision under this Act or the regulations." ;
    cof:pageNumber "150"^^xsd:integer .

concept:gene-technology-act-2000-sec-183a-ss-2 a cml:Concept ;
    skos:prefLabel "183A(2) Extended standing for judicial review"@en ;
    cml:realizedBy doc:sec-183a-ss-2 ;
    values:originalText "(2) A State is taken to be a person aggrieved by the decision, failure or conduct." ;
