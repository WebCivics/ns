doc:sec-158-ss-2 a cof:Section ;
    cof:title "158(2) Powers available to inspectors for dealing with dangerous" ;
    values:kind "subsection" ;
    values:originalText "(2) The inspector may do any of the following: (a) enter the premises; (b) search the premises for the thing; (c) secure the thing, if the inspector finds it on the premises, until a warrant is obtained to seize the thing; (d) if the inspector has reasonable grounds for suspecting that a person has not complied with this Act or the regulations in respect of the thing—require the person to take such steps as the inspector considers necessary for the person to comply with this Act or the regulations; (e) take such steps, or arrange for such steps to be taken, in relation to the thing as the inspector considers appropriate." ;
    cof:pageNumber "132"^^xsd:integer .

concept:gene-technology-act-2000-sec-158-ss-3 a cml:Concept ;
    skos:prefLabel "158(3) Powers available to inspectors for dealing with dangerous"@en ;
    cml:realizedBy doc:sec-158-ss-3 ;
    values:originalText "(3) The inspector may exercise the powers in subsection (2) only to the extent that it is necessary for the purpose of avoiding an imminent risk of death, serious illness, serious injury or serious damage to the environment." ;
    skos:definition "(3) The inspector may exercise the powers in subsection (2) only to the extent that it is necessary for the purpose of avoiding an imminent risk of death, serious illness, serious injury or serious damage to the environment."@en ;
    cml:integrityHash "f2f343fa68eb1c61a3604a1333655a4d6c9959048338a234843157f4b7414144" ;
    values:partOf concept:gene-technology-act-2000-sec-158 ;
    cof:pageNumber "132"^^xsd:integer ;
    skos:note "Exercise powers only when necessary to avoid imminent risk of death or serious harm." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
