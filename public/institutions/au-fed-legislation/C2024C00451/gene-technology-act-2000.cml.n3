concept:gene-technology-act-2000-sec-134 a cml:Concept ;
    skos:prefLabel "134 Consultants"@en ;
    cml:realizedBy doc:sec-134 ;
    values:originalText "(1) The Regulator may engage persons with suitable qualifications and experience as consultants to the Regulator. (2) The terms and conditions of engagement of consultants are such as the Regulator determines." ;
