concept:gene-technology-act-2000-sec-30 a cml:Concept ;
    skos:prefLabel "30 Independence of the Regulator"@en ;
    cml:realizedBy doc:sec-30 ;
    values:originalText "Subject to this Act and to other laws of the Commonwealth, the Regulator has discretion in the performance or exercise of his or her functions or powers. In particular, the Regulator is not subject to direction from anyone in relation to: (a) whether a GMO licence is issued or refused in relation to a particular application; or (b) the conditions to which a particular GMO licence is subject." ;
    skos:definition "Subject to this Act and to other laws of the Commonwealth, the Regulator has discretion in the performance or exercise of his or her functions or powers. In particular, the Regulator is not subject to direction from anyone in relation to: (a) whether a GMO licence is issued or refused in relation to a particular application; or (b) the conditions to which a particular GMO licence is subject."@en ;
    cml:integrityHash "d1d59e98cda308f434165784aa15bc0151cf5b85dd9defb088957f0e2bb0b9c3" ;
    cof:pageNumber "33"^^xsd:integer ;
    skos:note "Regulator's discretion in GMO licence issuance and conditions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
