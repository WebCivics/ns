concept:gene-technology-act-2000-sec-2 a cml:Concept ;
    skos:prefLabel "2 Commencement"@en ;
    cml:realizedBy doc:sec-2 ;
    values:originalText "(1) Sections 1 and 2 of this Act commence on the day on which this Act receives the Royal Assent. (2) Subject to subsection (3), the other provisions of this Act commence on a day or days to be fixed by Proclamation. (3) If a provision of this Act does not commence under subsection (2) within 6 months after the day on which this Act receives the Royal Assent, it commences on the first day after the end of that period." ;
    skos:definition "(1) Sections 1 and 2 of this Act commence on the day on which this Act receives the Royal Assent. (2) Subject to subsection (3), the other provisions of this Act commence on a day or days to be fixed by Proclamation. (3) If a provision of this Act does not commence under subsection (2) within 6 months after the day on which this Act receives the Royal Assent, it commences on the first day after the end of that period."@en ;
    cml:integrityHash "0a8ee5d5b5c303c2e36b91cbb172b1eae61bec26d73ec2cee20718b11754dfa8" ;
    cof:pageNumber "13"^^xsd:integer ;
    cml:hasPart concept:gene-technology-act-2000-sec-2-ss-1 ;
    cml:hasPart concept:gene-technology-act-2000-sec-2-ss-2 ;
    cml:hasPart concept:gene-technology-act-2000-sec-2-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
