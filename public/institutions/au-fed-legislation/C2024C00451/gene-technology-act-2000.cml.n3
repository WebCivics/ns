concept:gene-technology-act-2000-sec-88 a cml:Concept ;
    skos:prefLabel "88 Suspension or cancellation of certification"@en ;
    cml:realizedBy doc:sec-88 ;
    values:originalText "The Regulator may, by notice in writing, suspend or cancel the certification of a facility if the Regulator believes on reasonable grounds that a condition of the certification has been breached." ;
    skos:definition "The Regulator may, by notice in writing, suspend or cancel the certification of a facility if the Regulator believes on reasonable grounds that a condition of the certification has been breached."@en ;
