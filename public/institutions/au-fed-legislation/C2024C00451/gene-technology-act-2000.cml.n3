concept:gene-technology-act-2000-sec-68 a cml:Concept ;
    skos:prefLabel "68 Suspension and cancellation of licence"@en ;
    cml:realizedBy doc:sec-68 ;
    values:originalText "The Regulator may, by notice in writing given to the holder of a GMO licence, suspend or cancel the licence if: (a) the Regulator believes on reasonable grounds that a condition of the licence has been breached, whether by the licence holder or by a person covered by the licence; or (b) the Regulator believes on reasonable grounds that the licence holder, or a person covered by the licence, has committed an offence against this Act or the regulations; or (c) any annual charge payable in respect of the licence remains unpaid after the due date; or (d) the licence was obtained improperly; or (e) the Regulator becomes aware of risks associated with the continuation of the dealings authorised by the licence, and is satisfied that the licence holder has not proposed, or is not in a position to implement, adequate measures to deal with those risks; or (f) the Regulator is satisfied that the licence holder is no longer a suitable person to hold the licence." ;
    skos:definition "The Regulator may, by notice in writing given to the holder of a GMO licence, suspend or cancel the licence if: (a) the Regulator believes on reasonable grounds that a condition of the licence has been breached, whether by the licence holder or by a person covered by the licence; or (b) the Regulator believes on reasonable grounds that the licence holder, or a person covered by the licence, has committed an offence against this Act or the regulations; or (c) any annual charge payable in respect of the licence remains unpaid after the due date; or (d) the licence was obtained improperly; or (e) the Regulator becomes aware of risks associated with the continuation of the dealings authorised by the licence, and is satisfied that the licence holder has not proposed, or is not in a position to implement, adequate measures to deal with those risks; or (f) the Regulator is satisfied that the licence holder is no longer a suitable person to hold the licence."@en ;
    cml:integrityHash "35b2de3ce60e5f7c99e6b31764df37858a833a3a67d744313a3dc2cb32bbf951" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Suspension or cancellation of GMO licence" ;
    cml:curationStatus cml:Proposed ;
