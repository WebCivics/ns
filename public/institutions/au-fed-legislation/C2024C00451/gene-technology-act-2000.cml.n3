doc:sec-17-ss-5 a cof:Section ;
    cof:title "17(5) Conferral of functions on Commonwealth officers and bodies" ;
    values:kind "subsection" ;
    values:originalText "(5) If a corresponding State law is expressed to confer on the Regulator the power to enter information on the Record of GMO Dealings, the Regulator may enter the information on the Record in accordance with the corresponding State law." ;
    cof:pageNumber "26"^^xsd:integer .

concept:gene-technology-act-2000-sec-17-ss-6 a cml:Concept ;
    skos:prefLabel "17(6) Conferral of functions on Commonwealth officers and bodies"@en ;
    cml:realizedBy doc:sec-17-ss-6 ;
    values:originalText "(6) The Regulator may: (a) make any notations in the GMO Register that the Regulator considers necessary to identify entries that relate to dealings included on the Register as mentioned in subsection (3) or (4); and (b) make any notations in the Record of GMO Dealings that the Regulator considers necessary to identify entries that relate to information entered on the Record as mentioned in subsection (5)." ;
    skos:definition "(6) The Regulator may: (a) make any notations in the GMO Register that the Regulator considers necessary to identify entries that relate to dealings included on the Register as mentioned in subsection (3) or (4); and (b) make any notations in the Record of GMO Dealings that the Regulator considers necessary to identify entries that relate to information entered on the Record as mentioned in subsection (5)."@en ;
    cml:integrityHash "b270be302e0a0eab0e4167a4d8c9cb464569e0c6d8781e69b14b5f80e17609ed" ;
    values:partOf concept:gene-technology-act-2000-sec-17 ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Regulator may make notations in GMO Register and Record of GMO Dealings." ;
