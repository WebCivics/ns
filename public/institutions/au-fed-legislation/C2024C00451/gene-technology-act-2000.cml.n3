concept:gene-technology-act-2000-sec-121 a cml:Concept ;
    skos:prefLabel "121 Acting appointment"@en ;
    cml:realizedBy doc:sec-121 ;
    values:originalText "The Minister may appoint a person to act as the Regulator: (a) during a vacancy in the office of Regulator, (whether or not an appointment has previously been made to the office); or (b) during any period, or during all periods, when the Regulator is absent from duty or from Australia, or is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see section 33A of the Acts Interpretation Act 1901." ;
    skos:definition "The Minister may appoint a person to act as the Regulator: (a) during a vacancy in the office of Regulator, (whether or not an appointment has previously been made to the office); or (b) during any period, or during all periods, when the Regulator is absent from duty or from Australia, or is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see section 33A of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "aeb2348c1c6484983385f3d88ed99b3cb5594c7d7dd30328cd1412db1cef957c" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "The Minister may appoint a person to act as the Regulator." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
