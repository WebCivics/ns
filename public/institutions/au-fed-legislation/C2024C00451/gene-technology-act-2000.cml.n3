concept:gene-technology-act-2000-sec-90 a cml:Concept ;
    skos:prefLabel "90 Guidelines"@en ;
    cml:realizedBy doc:sec-90 ;
    values:originalText "(1) The Regulator may, by written instrument, issue technical or procedural guidelines about the requirements for the certification of facilities to specified containment levels. (2) The Regulator may, by written instrument, vary or revoke the guidelines.   Certification and accreditation  Part 7 Accredited organisations  Division 3 Section 91 Gene Technology Act 2000 Compilation date: 14/10/2024" ;
    skos:definition "(1) The Regulator may, by written instrument, issue technical or procedural guidelines about the requirements for the certification of facilities to specified containment levels. (2) The Regulator may, by written instrument, vary or revoke the guidelines.   Certification and accreditation  Part 7 Accredited organisations  Division 3 Section 91 Gene Technology Act 2000 Compilation date: 14/10/2024"@en ;
    cml:integrityHash "a6fdeebff95e044177d732c5f95829e6bcaa3089d2ea407b1cb68d230ffbd68a" ;
    cof:pageNumber "88"^^xsd:integer ;
