concept:gene-technology-act-2000-sec-128 a cml:Concept ;
    skos:prefLabel "128 Notional payments by the Commonwealth"@en ;
    cml:realizedBy doc:sec-128 ;
    values:originalText "(1) The purpose of this section is to ensure that fees and charges under this Act and the regulations, and charges under the Gene Technology (Licence Charges) Act 2000, are notionally payable by the Commonwealth (or parts of the Commonwealth). (2) The Minister responsible for administering the Public Governance, Performance and Accountability Act 2013 may give written directions for the purpose of this section, including directions relating to the transfer of amounts within, or between, accounts operated by the Commonwealth." ;
    skos:definition "(1) The purpose of this section is to ensure that fees and charges under this Act and the regulations, and charges under the Gene Technology (Licence Charges) Act 2000, are notionally payable by the Commonwealth (or parts of the Commonwealth). (2) The Minister responsible for administering the Public Governance, Performance and Accountability Act 2013 may give written directions for the purpose of this section, including directions relating to the transfer of amounts within, or between, accounts operated by the Commonwealth."@en ;
    cml:integrityHash "9e2d9fdd19fd4fe3933ec808b0a87bc6ba4036e2bc4f1d51486a15ba6c2d82a4" ;
    cof:pageNumber "108"^^xsd:integer ;
    cml:hasPart concept:gene-technology-act-2000-sec-128-ss-1 ;
    cml:hasPart concept:gene-technology-act-2000-sec-128-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-act-2000.pdf> ;
    dc:source "gene-technology-act-2000.pdf, p.108" .
