concept:gene-technology-act-2000-sec-41 a cml:Concept ;
    skos:prefLabel "41 Application may be withdrawn"@en ;
    cml:realizedBy doc:sec-41 ;
    values:originalText "(1) The applicant may withdraw the application at any time before the licence is issued. (2) The application fee is not refundable if the applicant withdraws the application." ;
    skos:definition "(1) The applicant may withdraw the application at any time before the licence is issued. (2) The application fee is not refundable if the applicant withdraws the application."@en ;
