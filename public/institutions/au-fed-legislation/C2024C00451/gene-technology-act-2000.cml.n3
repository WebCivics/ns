concept:gene-technology-act-2000-sec-44 a cml:Concept ;
    skos:prefLabel "44 Regulator may consult with applicant"@en ;
    cml:realizedBy doc:sec-44 ;
    values:originalText "Before considering an application in accordance with the requirements of this Part, the Regulator may consult the applicant, or another regulatory agency, on any aspect of the application." ;
