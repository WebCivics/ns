concept:gene-technology-act-2000-sec-173-ss-1 a cml:Concept ;
    skos:prefLabel "173(1) Offence-related warrants"@en ;
    cml:realizedBy doc:sec-173-ss-1 ;
    values:originalText "(1) If, in an urgent case, an inspector considers it necessary to do so, the inspector may apply to a magistrate by telephone, telex, fax or other electronic means for a warrant under section 173 in relation to premises." ;
