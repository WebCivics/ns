concept:gene-technology-act-2000-sec-9 a cml:Concept ;
    skos:prefLabel "9 Simplified outline"@en ;
    cml:realizedBy doc:sec-9 ;
    values:originalText "The following is a simplified outline of this Part: This Part contains the definitions used in this Act. This Part contains provisions to facilitate the conferral of functions and powers on the Regulator under State legislation, in order to facilitate a nationally consistent regulatory scheme. This Part contains provisions to enable the concurrent operation of certain State legislation in relation to GMOs, and gives the capacity for this Act to have a more limited operation when corresponding State legislation is in force. This Part also enables the Ministerial Council to issue policy principles, policy guidelines and codes of practice.   Interpretation and operation of Act  Part 2 Definitions  Division 2 Section 10 Gene Technology Act 2000 Compilation date: 14/10/2024" ;
    skos:definition "The following is a simplified outline of this Part: This Part contains the definitions used in this Act. This Part contains provisions to facilitate the conferral of functions and powers on the Regulator under State legislation, in order to facilitate a nationally consistent regulatory scheme. This Part contains provisions to enable the concurrent operation of certain State legislation in relation to GMOs, and gives the capacity for this Act to have a more limited operation when corresponding State legislation is in force. This Part also enables the Ministerial Council to issue policy principles, policy guidelines and codes of practice.   Interpretation and operation of Act  Part 2 Definitions  Division 2 Section 10 Gene Technology Act 2000 Compilation date: 14/10/2024"@en ;
    cml:integrityHash "37bad6be85b8d6732390d8574e56295970b44644e7511f686f46feab467c3b2d" ;
    cof:pageNumber "16"^^xsd:integer ;
    skos:note "Part outline" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-act-2000.pdf> ;
    dc:source "gene-technology-act-2000.pdf, p.16" ;
