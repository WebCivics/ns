concept:gene-technology-act-2000-sec-46 a cml:Concept ;
    skos:prefLabel "46 Applications to which this Division applies"@en ;
    cml:realizedBy doc:sec-46 ;
    values:originalText "This Division applies to an application for a GMO licence if the Regulator is satisfied that none of the dealings proposed to be authorised by the licence would involve the intentional release of a GMO into the environment." ;
    skos:definition "This Division applies to an application for a GMO licence if the Regulator is satisfied that none of the dealings proposed to be authorised by the licence would involve the intentional release of a GMO into the environment."@en ;
    cml:integrityHash "fb02b23a4c9a0df24f52d8ef25fde9b8f30a7ba082ffddaff5952fee5ff164fa" ;
    cof:pageNumber "46"^^xsd:integer ;
    skos:note "Application for GMO licence must not involve intentional release into environment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
