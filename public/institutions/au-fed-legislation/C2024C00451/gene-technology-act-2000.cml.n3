concept:gene-technology-act-2000-sec-120 a cml:Concept ;
    skos:prefLabel "120 Disclosure of interests"@en ;
    cml:realizedBy doc:sec-120 ;
    values:originalText "The Regulator must give written notice to the Minister of all interests, pecuniary or otherwise, that the Regulator has or acquires and that could conflict with the proper performance of the Regulator’s functions." ;
