doc:sec-17-ss-6 a cof:Section ;
    cof:title "17(6) Conferral of functions on Commonwealth officers and bodies" ;
    values:kind "subsection" ;
    values:originalText "(6) The Regulator may: (a) make any notations in the GMO Register that the Regulator considers necessary to identify entries that relate to dealings included on the Register as mentioned in subsection (3) or (4); and (b) make any notations in the Record of GMO Dealings that the Regulator considers necessary to identify entries that relate to information entered on the Record as mentioned in subsection (5)." ;
    cof:pageNumber "26"^^xsd:integer .

concept:gene-technology-act-2000-sec-18 a cml:Concept ;
    skos:prefLabel "18 No doubling-up of liabilities"@en ;
    cml:realizedBy doc:sec-18 ;
    values:originalText "(1) If: (a) an act or omission is an offence against this Act and is also an offence against a corresponding State law; and (b) the offender has been punished for the offence under the corresponding State law; the offender is not liable to be punished for the offence under this Act." ;
    skos:definition "(1) If: (a) an act or omission is an offence against this Act and is also an offence against a corresponding State law; and (b) the offender has been punished for the offence under the corresponding State law; the offender is not liable to be punished for the offence under this Act."@en ;
    cml:integrityHash "09188ecc7aa5968d841a535f7630837426bde7364a6af930136fd0168118c5b6" ;
    cof:pageNumber "27"^^xsd:integer ;
    skos:note "No punishment for offence under this Act if already punished under corresponding State law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-act-2000.pdf> ;
    dc:source "gene-technology-act-2000.pdf, p.27" ;
