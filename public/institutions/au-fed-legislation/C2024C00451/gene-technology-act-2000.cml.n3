concept:gene-technology-act-2000-sec-147-ss-3 a cml:Concept ;
    skos:prefLabel "147(3) Injunctions"@en ;
    cml:realizedBy doc:sec-147-ss-3 ;
    values:originalText "(3) The power of the Court to grant an injunction may be exercised: (a) whether or not it appears to the Court that the person intends to engage, or to continue to engage, in conduct of that kind; and" ;
    skos:definition "(3) The power of the Court to grant an injunction may be exercised: (a) whether or not it appears to the Court that the person intends to engage, or to continue to engage, in conduct of that kind; and"@en ;
