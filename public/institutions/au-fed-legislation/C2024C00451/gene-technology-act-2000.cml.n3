concept:gene-technology-act-2000-sec-39 a cml:Concept ;
    skos:prefLabel "39 Simplified outline"@en ;
    cml:realizedBy doc:sec-39 ;
    values:originalText "The following is a simplified outline of this Part: This Part provides a licensing system under which a person can apply to the Regulator for a licence authorising dealings with GMOs. This Part sets out the processes to be followed by the Regulator in relation to applications involving 2 kinds of dealings: (a) those that involve the intentional release of a GMO into the environment; and (b) those that do not involve the intentional release of a GMO into the environment. A licence can cover dealings by persons other than the licence holder. The licence holder is required to inform such persons of any conditions of the licence that apply to them." ;
    skos:definition "The following is a simplified outline of this Part: This Part provides a licensing system under which a person can apply to the Regulator for a licence authorising dealings with GMOs. This Part sets out the processes to be followed by the Regulator in relation to applications involving 2 kinds of dealings: (a) those that involve the intentional release of a GMO into the environment; and (b) those that do not involve the intentional release of a GMO into the environment. A licence can cover dealings by persons other than the licence holder. The licence holder is required to inform such persons of any conditions of the licence that apply to them."@en ;
    cml:integrityHash "16a8b0f8a674db7ef64641cbea922ec54ca9110b8d3e63203c50a9ab472baf74" ;
    cof:pageNumber "41"^^xsd:integer ;
    skos:note "Licensing system for dealings with GMOs" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
