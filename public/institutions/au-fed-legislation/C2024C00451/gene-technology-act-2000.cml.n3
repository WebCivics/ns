concept:gene-technology-act-2000-sec-171 a cml:Concept ;
    skos:prefLabel "171 Disposal of goods if there is no owner or owner cannot be"@en ;
    cml:realizedBy doc:sec-171 ;
    values:originalText "located If: (a) a thing is seized under this Part; and (b) apart from this section, the Commonwealth is required to return the thing to the owner; and (c) there is no owner or the Regulator cannot, despite making reasonable efforts, locate the owner;   Powers of inspection  Part 11 General provisions relating to search and seizure  Division 9 Section 171 Gene Technology Act 2000 Compilation date: 14/10/2024 the Regulator may dispose of the thing in such manner as the Regulator thinks appropriate." ;
    skos:definition "located If: (a) a thing is seized under this Part; and (b) apart from this section, the Commonwealth is required to return the thing to the owner; and (c) there is no owner or the Regulator cannot, despite making reasonable efforts, locate the owner;   Powers of inspection  Part 11 General provisions relating to search and seizure  Division 9 Section 171 Gene Technology Act 2000 Compilation date: 14/10/2024 the Regulator may dispose of the thing in such manner as the Regulator thinks appropriate."@en ;
    cml:integrityHash "946709463c14a55592dad704b91b3dc2ce42f53249a1da9c621ab0ab1549b10c" ;
    cof:pageNumber "138"^^xsd:integer ;
    skos:note "The Regulator may dispose of a thing in such manner as the Regulator thinks appropriate." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
