doc:sec-40-ss-2 a cof:Section ;
    cof:title "40(2) Person may apply for a licence" ;
    values:kind "subsection" ;
    values:originalText "(2) The application must be in writing, and must contain: (a) such information as is prescribed by the regulations (if any); and (b) such information as is specified in writing by the Regulator." ;
    cof:pageNumber "42"^^xsd:integer .

