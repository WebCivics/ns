concept:gene-technology-act-2000-sec-61 a cml:Concept ;
    skos:prefLabel "61 Licence is subject to conditions"@en ;
    cml:realizedBy doc:sec-61 ;
    values:originalText "A GMO licence is subject to the following conditions: (a) the conditions set out in sections 63, 64 and 65; (b) any conditions prescribed by the regulations; (c) any conditions imposed by the Regulator at the time of issuing the licence; (d) any conditions imposed by the Regulator under section 71 after the licence is issued." ;
    skos:definition "A GMO licence is subject to the following conditions: (a) the conditions set out in sections 63, 64 and 65; (b) any conditions prescribed by the regulations; (c) any conditions imposed by the Regulator at the time of issuing the licence; (d) any conditions imposed by the Regulator under section 71 after the licence is issued."@en ;
    cml:integrityHash "07e7f4b94bf024fd247d302abe5e65573829aa07740454c10ae957a108884491" ;
    cof:pageNumber "59"^^xsd:integer ;
    skos:note "GMO licence is subject to conditions" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
