doc:sec-66 a cof:Section ;
    cof:title "66 Person may give information to Regulator" ;
    values:kind "section" ;
    values:originalText "A person covered by a licence may inform the Regulator if he or she: (a) becomes aware of additional information as to any risks to the health and safety of people, or to the environment, associated with the dealings authorised by the licence; or (b) becomes aware of any contraventions of the licence by a person covered by the licence; or (c) becomes aware of any unintended effects of the dealings authorised by the licence." ;
    cof:pageNumber "62"^^xsd:integer .

concept:gene-technology-act-2000-sec-67 a cml:Concept ;
    skos:prefLabel "67 Protection of persons who give information"@en ;
    cml:realizedBy doc:sec-67 ;
    values:originalText "A person (the first person) does not incur any civil liability in respect of loss, damage or injury of any kind suffered by another person because the first person gave information to the Regulator under section 65, 66 or paragraph 72D(2)(h).   Licensing system  Part 5 Suspension, cancellation and variation of licences  Division 7 Section 68 Gene Technology Act 2000 Compilation date: 14/10/2024" ;
    skos:definition "A person (the first person) does not incur any civil liability in respect of loss, damage or injury of any kind suffered by another person because the first person gave information to the Regulator under section 65, 66 or paragraph 72D(2)(h).   Licensing system  Part 5 Suspension, cancellation and variation of licences  Division 7 Section 68 Gene Technology Act 2000 Compilation date: 14/10/2024"@en ;
    cml:integrityHash "ec2589cf4c5a79402f7a1c5916a5ccf8872d4d92e53f1db35723a29bdf19ee7d" ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "No civil liability for providing information" ;
