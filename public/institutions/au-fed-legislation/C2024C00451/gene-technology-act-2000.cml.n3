concept:gene-technology-act-2000-sec-66 a cml:Concept ;
    skos:prefLabel "66 Person may give information to Regulator"@en ;
    cml:realizedBy doc:sec-66 ;
    values:originalText "A person covered by a licence may inform the Regulator if he or she: (a) becomes aware of additional information as to any risks to the health and safety of people, or to the environment, associated with the dealings authorised by the licence; or (b) becomes aware of any contraventions of the licence by a person covered by the licence; or (c) becomes aware of any unintended effects of the dealings authorised by the licence." ;
    skos:definition "A person covered by a licence may inform the Regulator if he or she: (a) becomes aware of additional information as to any risks to the health and safety of people, or to the environment, associated with the dealings authorised by the licence; or (b) becomes aware of any contraventions of the licence by a person covered by the licence; or (c) becomes aware of any unintended effects of the dealings authorised by the licence."@en ;
    cml:integrityHash "7f60cc653f302dfb4e36221ade53f4b33271096d94d1204176fa0f95245d9df5" ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "A person covered by a licence may inform the Regulator about certain risks and contraventions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
