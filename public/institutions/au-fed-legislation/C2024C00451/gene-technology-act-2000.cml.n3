doc:sec-160-ss-2 a cof:Section ;
    cof:title "160(2) Consent" ;
    values:kind "subsection" ;
    values:originalText "(2) An entry of an inspector by virtue of the consent of a person is not lawful unless the person voluntarily consented to the entry. 161  Details of warrant to be given to occupier etc." ;
    cof:pageNumber "133"^^xsd:integer .

concept:gene-technology-act-2000-sec-160-ss-1 a cml:Concept ;
    skos:prefLabel "160(1) Consent"@en ;
    cml:realizedBy doc:sec-160-ss-1 ;
    values:originalText "(1) If a warrant in relation to premises is being executed and the occupier of the premises or another person who apparently represents the occupier is present at the premises, the inspector must make available to that person a copy of the warrant." ;
    skos:definition "(1) If a warrant in relation to premises is being executed and the occupier of the premises or another person who apparently represents the occupier is present at the premises, the inspector must make available to that person a copy of the warrant."@en ;
