concept:gene-technology-act-2000-sec-94 a cml:Concept ;
    skos:prefLabel "94 Conditions of accreditation"@en ;
    cml:realizedBy doc:sec-94 ;
    values:originalText "The accreditation of an accredited organisation is subject to the following conditions: (a) any conditions imposed by the Regulator at the time of accreditation; (b) any conditions imposed by the Regulator under section 95 after accreditation; (c) any conditions prescribed by the regulations." ;
    skos:definition "The accreditation of an accredited organisation is subject to the following conditions: (a) any conditions imposed by the Regulator at the time of accreditation; (b) any conditions imposed by the Regulator under section 95 after accreditation; (c) any conditions prescribed by the regulations."@en ;
