concept:gene-technology-act-2000-sec-112 a cml:Concept ;
    skos:prefLabel "112 Expert advisers"@en ;
    cml:realizedBy doc:sec-112 ;
    values:originalText "(1) The Minister may appoint one or more persons (expert advisers) to give expert advice to the Ethics and Community Committee to assist it in the performance of its functions. Expert advisers may be appointed on a continuing or an ad hoc basis. (2) Expert advisers are not members of the Ethics and Community Committee.   Administration  Part 9 Simplified outline  Division 1 Section 117 Gene Technology Act 2000 Compilation date: 14/10/2024" ;
    skos:definition "(1) The Minister may appoint one or more persons (expert advisers) to give expert advice to the Ethics and Community Committee to assist it in the performance of its functions. Expert advisers may be appointed on a continuing or an ad hoc basis. (2) Expert advisers are not members of the Ethics and Community Committee.   Administration  Part 9 Simplified outline  Division 1 Section 117 Gene Technology Act 2000 Compilation date: 14/10/2024"@en ;
    cml:integrityHash "c5ba5b8813d9f28cf1dd9c3676002cada61eabe1c98752fc160fce062766eb1f" ;
    cof:pageNumber "102"^^xsd:integer ;
