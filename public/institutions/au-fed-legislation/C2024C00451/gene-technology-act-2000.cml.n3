concept:gene-technology-act-2000-sec-142 a cml:Concept ;
    skos:prefLabel "142 Regulator may give notice of consideration"@en ;
    cml:realizedBy doc:sec-142 ;
    values:originalText "(1) The Regulator may publish a notice inviting written submissions in relation to any matter that the Regulator may consider under section 140 or 141. The notice must: (a) specify the matters to which submissions are to relate; and" ;
    skos:definition "(1) The Regulator may publish a notice inviting written submissions in relation to any matter that the Regulator may consider under section 140 or 141. The notice must: (a) specify the matters to which submissions are to relate; and"@en ;
