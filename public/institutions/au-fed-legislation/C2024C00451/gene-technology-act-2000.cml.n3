concept:gene-technology-act-2000-sec-59 a cml:Concept ;
    skos:prefLabel "59 Notification of licence decision"@en ;
    cml:realizedBy doc:sec-59 ;
    values:originalText "The Regulator must notify the applicant in writing of the Regulator’s decision (including any conditions imposed by the Regulator, if applicable)." ;
