    cof:pageNumber "39"^^xsd:integer .

concept:gene-technology-act-2000-sec-37 a cml:Concept ;
    skos:prefLabel "37 Offence relating to notifiable low risk dealings"@en ;
    cml:realizedBy doc:sec-37 ;
    values:originalText "(1) A person commits an offence if: (a) the person deals with a GMO, knowing that it is a GMO; and (b) the dealing is a notifiable low risk dealing; and (c) the dealing by the person was not undertaken in accordance with the regulations. Maximum penalty: 50 penalty units. Note 1: Notifiable low risk dealings are specified in the regulations—see" ;
    skos:definition "(1) A person commits an offence if: (a) the person deals with a GMO, knowing that it is a GMO; and (b) the dealing is a notifiable low risk dealing; and (c) the dealing by the person was not undertaken in accordance with the regulations. Maximum penalty: 50 penalty units. Note 1: Notifiable low risk dealings are specified in the regulations—see"@en ;
    cml:integrityHash "f0a989f73607eccd2b74fb73d8ceedb812122516bce6657404b1923260514bd5" ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Dealing with GMO without proper regulation is an offence." ;
