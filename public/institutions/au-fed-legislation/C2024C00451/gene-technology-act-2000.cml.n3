concept:gene-technology-act-2000-sec-57 a cml:Concept ;
    skos:prefLabel "57 Other circumstances in which Regulator must not issue the"@en ;
    cml:realizedBy doc:sec-57 ;
    values:originalText "licence (1) The Regulator must not issue the licence if the Regulator is satisfied that issuing the licence would be inconsistent with a policy principle in force under section 21. (2) The Regulator must not issue the licence unless the Regulator is satisfied that the applicant is a suitable person to hold the licence. (3) Subsection (2) does not apply to an inadvertent dealings application." ;
    skos:definition "licence (1) The Regulator must not issue the licence if the Regulator is satisfied that issuing the licence would be inconsistent with a policy principle in force under section 21. (2) The Regulator must not issue the licence unless the Regulator is satisfied that the applicant is a suitable person to hold the licence. (3) Subsection (2) does not apply to an inadvertent dealings application."@en ;
    cml:integrityHash "8178ac72b28d77fcb851fcd301583182bd05d9663ed2ec8131e60f057c2795f7" ;
    cof:pageNumber "56"^^xsd:integer ;
    cml:hasPart concept:gene-technology-act-2000-sec-57-ss-1 ;
