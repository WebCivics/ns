doc:sec-139 a cof:Section ;
    cof:title "139 Inspection of Record" ;
    values:kind "section" ;
    values:originalText "The Regulator must permit any person to inspect any part of the Record.   Administration  Part 9 Reviews of notifiable low risk dealings and exemptions  Division 7 Section 140 Gene Technology Act 2000 Compilation date: 14/10/2024" ;
    cof:pageNumber "114"^^xsd:integer .

concept:gene-technology-act-2000-sec-140 a cml:Concept ;
    skos:prefLabel "140 Regulator may review notifiable low risk dealings"@en ;
    cml:realizedBy doc:sec-140 ;
    values:originalText "(1) The Regulator may, at any time, in accordance with this Division, consider the following matters: (a) whether a dealing with a GMO should be a notifiable low risk dealing; (b) whether an existing notifiable low risk dealing should no longer be a notifiable low risk dealing. (2) The basis of the Regulator’s consideration must relate to: (a) the matters of which the Regulator must be satisfied under subsection 74(2); or (b) the matters the Regulator must consider under subsection 74(3)." ;
    skos:definition "(1) The Regulator may, at any time, in accordance with this Division, consider the following matters: (a) whether a dealing with a GMO should be a notifiable low risk dealing; (b) whether an existing notifiable low risk dealing should no longer be a notifiable low risk dealing. (2) The basis of the Regulator’s consideration must relate to: (a) the matters of which the Regulator must be satisfied under subsection 74(2); or (b) the matters the Regulator must consider under subsection 74(3)."@en ;
    cml:integrityHash "04ec3f6454f95154bfb9f5fc02f1067ce44dbaba501bf63fe21c515351430747" ;
    cof:pageNumber "115"^^xsd:integer ;
