concept:gene-technology-act-2000-sec-179 a cml:Concept ;
    skos:prefLabel "179 Meaning of terms"@en ;
    cml:realizedBy doc:sec-179 ;
    values:originalText "The following table sets out: (a) decisions that are reviewable decisions; and (b) each eligible person in relation to a reviewable decision: Reviewable decisions and eligible persons Item Decision Provision under which decision made Eligible person in relation to decision 1A To refuse to consider an application on the basis that the applicant is not a suitable person to hold a licence paragraph 43(2)(f) the applicant To refuse to issue a licence section 55 the applicant for the licence To impose a licence condition section 55 the licence holder To suspend or cancel a licence section 68 the licence holder 3A To refuse to transfer a licence section 70 an applicant for the transfer To vary a licence section 71 the licence holder 4A To refuse to vary a licence section 71 the licence holder To refuse to certify a facility section 84 the applicant for certification To specify a condition of a certification section 86 the holder of the certification To vary a certification section 87 the holder of the certification 7A To refuse to transfer a section 89A an applicant for the" ;
    skos:definition "The following table sets out: (a) decisions that are reviewable decisions; and (b) each eligible person in relation to a reviewable decision: Reviewable decisions and eligible persons Item Decision Provision under which decision made Eligible person in relation to decision 1A To refuse to consider an application on the basis that the applicant is not a suitable person to hold a licence paragraph 43(2)(f) the applicant To refuse to issue a licence section 55 the applicant for the licence To impose a licence condition section 55 the licence holder To suspend or cancel a licence section 68 the licence holder 3A To refuse to transfer a licence section 70 an applicant for the transfer To vary a licence section 71 the licence holder 4A To refuse to vary a licence section 71 the licence holder To refuse to certify a facility section 84 the applicant for certification To specify a condition of a certification section 86 the holder of the certification To vary a certification section 87 the holder of the certification 7A To refuse to transfer a section 89A an applicant for the"@en ;
    cml:integrityHash "2a4cedd3eb86274840688459186509d56d9bef0b757d6a5080318dfb40bf6a67" ;
    cof:pageNumber "147"^^xsd:integer ;
    skos:note "List of reviewable decisions and eligible persons" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
