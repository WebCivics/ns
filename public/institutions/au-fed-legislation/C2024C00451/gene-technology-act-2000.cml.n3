concept:gene-technology-act-2000-sec-56-ss-2 a cml:Concept ;
    skos:prefLabel "56(2) Regulator must not issue the licence unless satisfied as to risk"@en ;
    cml:realizedBy doc:sec-56-ss-2 ;
