doc:sec-17-ss-2 a cof:Section ;
    cof:title "17(2) Conferral of functions on Commonwealth officers and bodies" ;
    values:kind "subsection" ;
    values:originalText "(2) If a function, power or duty is conferred on a person or body under subsection (1), the person or body may perform the function or duty or exercise the power, as the case requires." ;
    cof:pageNumber "26"^^xsd:integer .

