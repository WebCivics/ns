concept:gene-technology-act-2000-sec-11 a cml:Concept ;
    skos:prefLabel "11 Meaning of intentional release of a GMO into the environment"@en ;
    cml:realizedBy doc:sec-11 ;
    values:originalText "For the purposes of this Act, a dealing with a GMO involves the intentional release of the GMO into the environment if the GMO   Interpretation and operation of Act  Part 2 Definitions  Division 2 Section 12 Gene Technology Act 2000 Compilation date: 14/10/2024 is intentionally released into the open environment, whether or not it is released with provision for limiting the dissemination or persistence of the GMO or its genetic material in the environment." ;
    skos:definition "For the purposes of this Act, a dealing with a GMO involves the intentional release of the GMO into the environment if the GMO   Interpretation and operation of Act  Part 2 Definitions  Division 2 Section 12 Gene Technology Act 2000 Compilation date: 14/10/2024 is intentionally released into the open environment, whether or not it is released with provision for limiting the dissemination or persistence of the GMO or its genetic material in the environment."@en ;
    cml:integrityHash "f3b129b300f4ea94a6d543d4c47ed5a8206be4549b7c5c77142e403c54e07eab" ;
    cof:pageNumber "22"^^xsd:integer ;
    skos:note "Intentional release of GMO into environment is a dealing with a GMO." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-act-2000.pdf> ;
    dc:source "gene-technology-act-2000.pdf, p.22" ;
