concept:gene-technology-act-2000-sec-99 a cml:Concept ;
    skos:prefLabel "99 Simplified outline"@en ;
    cml:realizedBy doc:sec-99 ;
    values:originalText "The following is a simplified outline of this Part: This Part provides for the establishment of the Gene Technology Technical Advisory Committee and the Gene Technology Ethics and Community Consultative Committee. The Part sets out the membership of these bodies, and their functions." ;
    skos:definition "The following is a simplified outline of this Part: This Part provides for the establishment of the Gene Technology Technical Advisory Committee and the Gene Technology Ethics and Community Consultative Committee. The Part sets out the membership of these bodies, and their functions."@en ;
