concept:gene-technology-act-2000-sec-5 a cml:Concept ;
    skos:prefLabel "5 Nationally consistent scheme"@en ;
    cml:realizedBy doc:sec-5 ;
    values:originalText "It is the intention of the Parliament that this Act form a component of a nationally consistent scheme for the regulation of certain dealings with GMOs by the Commonwealth and the States." ;
