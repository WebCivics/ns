concept:gene-technology-act-2000-sec-4 a cml:Concept ;
    skos:prefLabel "4 Regulatory framework to achieve object"@en ;
    cml:realizedBy doc:sec-4 ;
    values:originalText "The object of this Act is to be achieved through a regulatory framework which: (aa) provides that where there are threats of serious or irreversible environmental damage, a lack of full scientific certainty should not be used as a reason for postponing cost-effective measures to prevent environmental degradation; and" ;
    skos:definition "The object of this Act is to be achieved through a regulatory framework which: (aa) provides that where there are threats of serious or irreversible environmental damage, a lack of full scientific certainty should not be used as a reason for postponing cost-effective measures to prevent environmental degradation; and"@en ;
    cml:integrityHash "45fd4341bc7451997f6f6581e5701ef50e94e70711d998d30a4ae88486767f78" ;
    cof:pageNumber "13"^^xsd:integer ;
    skos:note "Regulatory framework must prevent environmental degradation despite lack of full scientific certainty." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-act-2000.pdf> ;
    dc:source "gene-technology-act-2000.pdf, p.13" ;
