    cof:pageNumber "153"^^xsd:integer ;
    skos:note "Disclosing confidential commercial information is prohibited for certain individuals and entities." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
