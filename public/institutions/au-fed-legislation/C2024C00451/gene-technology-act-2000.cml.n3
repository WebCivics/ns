concept:gene-technology-act-2000-sec-48 a cml:Concept ;
    skos:prefLabel "48 Applications to which this Division applies"@en ;
    cml:realizedBy doc:sec-48 ;
    values:originalText "This Division applies to an application for a GMO licence if the Regulator is satisfied that at least one of the dealings proposed to be authorised by the licence would involve the intentional release of a GMO into the environment." ;
    skos:definition "This Division applies to an application for a GMO licence if the Regulator is satisfied that at least one of the dealings proposed to be authorised by the licence would involve the intentional release of a GMO into the environment."@en ;
    cml:integrityHash "e6354cf9b5cba4ebbdb557e5e56c62d4d1771271bb77df16994a8870ac51d5f9" ;
    cof:pageNumber "48"^^xsd:integer ;
    skos:note "Application for GMO licence must involve intentional release into environment." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
