concept:gene-technology-act-2000-sec-176 a cml:Concept ;
    skos:prefLabel "176 Part not to abrogate privilege against self-incrimination"@en ;
    cml:realizedBy doc:sec-176 ;
    values:originalText "Nothing in this Part affects the right of a person to refuse to answer a question, give information, or produce a document, on the ground that the answer to the question, the information, or the production of the document, might tend to incriminate him or her or make him or her liable to a penalty." ;
    skos:definition "Nothing in this Part affects the right of a person to refuse to answer a question, give information, or produce a document, on the ground that the answer to the question, the information, or the production of the document, might tend to incriminate him or her or make him or her liable to a penalty."@en ;
    cml:integrityHash "95332645b6a47123cd96c3f2ada19072106659226781b448cd411ff01ad75a60" ;
    cof:pageNumber "145"^^xsd:integer ;
    skos:note "Right to refuse self-incrimination" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-act-2000.pdf> ;
