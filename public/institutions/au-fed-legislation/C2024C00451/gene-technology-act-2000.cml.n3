concept:gene-technology-act-2000-sec-36 a cml:Concept ;
    skos:prefLabel "36 Person must not breach conditions on GMO Register"@en ;
    cml:realizedBy doc:sec-36 ;
    values:originalText "(1) A person commits an offence if the person: (a) deals with a GMO, knowing that it is a GMO; and (b) the dealing is on the GMO Register; and (c) the dealing contravenes a condition relating to the dealing that is specified in the GMO Register. Maximum penalty: 50 penalty units." ;
    skos:definition "(1) A person commits an offence if the person: (a) deals with a GMO, knowing that it is a GMO; and (b) the dealing is on the GMO Register; and (c) the dealing contravenes a condition relating to the dealing that is specified in the GMO Register. Maximum penalty: 50 penalty units."@en ;
    cml:integrityHash "832b0de2ff31660b89bc5959f66125393e416f958c42308704abdbd065453e40" ;
    cof:pageNumber "39"^^xsd:integer ;
    skos:note "Dealing with GMOs on the register is prohibited." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-act-2000.pdf> ;
