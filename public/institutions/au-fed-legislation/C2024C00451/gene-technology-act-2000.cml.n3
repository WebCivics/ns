    values:kind "section" ;
    values:originalText "Nothing in this Part affects the right of a person to refuse to answer a question, give information, or produce a document, on the ground that the answer to the question, the information, or the production of the document, might tend to incriminate him or her or make him or her liable to a penalty." ;
    cof:pageNumber "145"^^xsd:integer .

concept:gene-technology-act-2000-sec-177 a cml:Concept ;
    skos:prefLabel "177 Part does not limit power to impose conditions"@en ;
    cml:realizedBy doc:sec-177 ;
    values:originalText "This Part is not to be taken to limit the Regulator’s power to impose licence conditions or the Minister’s power to impose conditions on an emergency dealing determination." ;
    skos:definition "This Part is not to be taken to limit the Regulator’s power to impose licence conditions or the Minister’s power to impose conditions on an emergency dealing determination."@en ;
