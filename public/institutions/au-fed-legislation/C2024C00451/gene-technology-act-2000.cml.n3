concept:gene-technology-act-2000-sec-60-ss-2 cml:asserts concept:gene-technology-act-2000-sec-60-ss-2-logic-ltl-3 .
concept:gene-technology-act-2000-sec-60-ss-2-logic-ltl-3 a cml:LogicApplication ;
    cml:modality cml:LTL ;
    cml:operator "¬∃t (P(t) ∧ Q(t))" ;
    cml:logicSummary "Temporal negation" ;
    cml:premiseText "(2) A licence is not in force throughout any period of suspension." ;
    cml:conclusionText "There does not exist a time t such that the licence is in force at t and the period of suspension is also in force at t." ;
    cml:executionSurface "modalities::temporal_ltl" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

