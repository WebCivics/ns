doc:sec-170-ss-1 a cof:Section ;
    cof:title "170(1) Magistrate may permit a thing to be retained" ;
    values:kind "subsection" ;
    values:originalText "(1) An inspector may apply to a magistrate for an order that he or she may retain the thing for a further period if: (a) before the end of 60 days after the seizure; or (b) before the end of a period previously specified in an order of a magistrate under this section; proceedings in respect of which the thing may afford evidence have not commenced." ;
    cof:pageNumber "138"^^xsd:integer .

concept:gene-technology-act-2000-sec-170-ss-2 a cml:Concept ;
    skos:prefLabel "170(2) Magistrate may permit a thing to be retained"@en ;
    cml:realizedBy doc:sec-170-ss-2 ;
    values:originalText "(2) If the magistrate is satisfied that it is necessary for an inspector to continue to retain the thing: (a) for the purposes of an investigation as to whether an offence against this Act has been committed; or (b) to enable evidence of an offence against this Act to be secured for the purposes of a prosecution; the magistrate may order that an inspector may retain the thing for a period (not being a period exceeding 3 years) specified in the order." ;
    skos:definition "(2) If the magistrate is satisfied that it is necessary for an inspector to continue to retain the thing: (a) for the purposes of an investigation as to whether an offence against this Act has been committed; or (b) to enable evidence of an offence against this Act to be secured for the purposes of a prosecution; the magistrate may order that an inspector may retain the thing for a period (not being a period exceeding 3 years) specified in the order."@en ;
    cml:integrityHash "dc4f21f50a3c88a59844a0344fe23145bffb3870ec1c1f4faf021dfca5ff2f2c" ;
    values:partOf concept:gene-technology-act-2000-sec-170 ;
    cof:pageNumber "138"^^xsd:integer ;
    skos:note "Magistrate may permit inspector to retain thing for a specified period." ;
