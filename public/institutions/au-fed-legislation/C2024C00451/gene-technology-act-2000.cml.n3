concept:gene-technology-act-2000-sec-77 a cml:Concept ;
    skos:prefLabel "77 Contents of Register"@en ;
    cml:realizedBy doc:sec-77 ;
    values:originalText "If the Regulator determines under section 78 that a dealing with a GMO is to be included on the GMO Register, the Regulator must specify in the GMO Register: (a) a description of the dealing with the GMO; and (b) any condition to which the dealing is subject." ;
    skos:definition "If the Regulator determines under section 78 that a dealing with a GMO is to be included on the GMO Register, the Regulator must specify in the GMO Register: (a) a description of the dealing with the GMO; and (b) any condition to which the dealing is subject."@en ;
    cml:integrityHash "1e4c704481ff8b00adfadc2e2e57306058962eabdcab09c1f4ed6bd37d7030b4" ;
    cof:pageNumber "81"^^xsd:integer ;
    skos:note "Specify description and conditions of dealing with GMO in Register" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <gene-technology-act-2000.pdf> ;
    dc:source "gene-technology-act-2000.pdf, p.81" ;
