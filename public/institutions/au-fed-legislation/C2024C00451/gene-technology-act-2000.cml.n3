concept:gene-technology-act-2000-sec-159 a cml:Concept ;
    skos:prefLabel "159 Inspector must produce identity card on request"@en ;
    cml:realizedBy doc:sec-159 ;
    values:originalText "An inspector is not entitled to exercise any powers under this Part in relation to premises if: (a) the occupier of the premises has required the inspector to produce his or her identity card for inspection by the occupier; and (b) the inspector fails to comply with the requirement." ;
    skos:definition "An inspector is not entitled to exercise any powers under this Part in relation to premises if: (a) the occupier of the premises has required the inspector to produce his or her identity card for inspection by the occupier; and (b) the inspector fails to comply with the requirement."@en ;
    cml:integrityHash "f55758b70ae0c1a3a138e74b6b4491d1f4a8d08615b1e2d7fde32e0b6bc2c5b3" ;
    cof:pageNumber "133"^^xsd:integer ;
    skos:note "Inspector must produce identity card on request" ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
