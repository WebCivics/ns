    {
      "@id": "concept:gene-technology-act-2000-sec-131",
      "@type": "cml:Concept",
      "skos:prefLabel": "131 Recovery of amounts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-131"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.109",
      "values:originalText": "The following amounts may be recovered in a court of competent\njurisdiction as debts due to the Commonwealth:\n(a) amounts payable to the Commonwealth under the Gene\nTechnology (Licence Charges) Act 2000;\n(b) fees payable to the Commonwealth under this Act, the\nregulations or a corresponding State law;\n(c) amounts payable to the Commonwealth in connection with\nthe performance of the Regulator’s functions.",
      "skos:definition": "The following amounts may be recovered in a court of competent\njurisdiction as debts due to the Commonwealth:\n(a) amounts payable to the Commonwealth under the Gene\nTechnology (Licence Charges) Act 2000;\n(b) fees payable to the Commonwealth under this Act, the\nregulations or a corresponding State law;\n(c) amounts payable to the Commonwealth in connection with\nthe performance of the Regulator’s functions.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-131-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-131-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "550e3ee6cc42ed0eecd3d6c87b2dd9673ac239077ca19a4bd262567dea76d357",
      "skos:note": "Recovery of amounts payable to the Commonwealth"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-131",
      "@type": "cof:Section",
      "cof:title": "131 Recovery of amounts",
      "values:kind": "section",
      "cof:pageNumber": 109,
      "values:originalText": "The following amounts may be recovered in a court of competent\njurisdiction as debts due to the Commonwealth:\n(a) amounts payable to the Commonwealth under the Gene\nTechnology (Licence Charges) Act 2000;\n(b) fees payable to the Commonwealth under this Act, the\nregulations or a corresponding State law;\n(c) amounts payable to the Commonwealth in connection with\nthe performance of the Regulator’s functions."
    },
