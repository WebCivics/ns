    {
      "@id": "concept:gene-technology-act-2000-sec-135",
      "@type": "cml:Concept",
      "skos:prefLabel": "135 Seconded officers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-135"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.111",
      "values:originalText": "The Regulator may be assisted by the following:\n(a) persons engaged under the Public Service Act 1999;\n(b) officers and employees of Commonwealth authorities;\n(c) officers and employees of State agencies;\nwhose services are made available to the Regulator in connection\nwith the performance or exercise of any of the Regulator’s\nfunctions or powers.",
      "skos:definition": "The Regulator may be assisted by the following:\n(a) persons engaged under the Public Service Act 1999;\n(b) officers and employees of Commonwealth authorities;\n(c) officers and employees of State agencies;\nwhose services are made available to the Regulator in connection\nwith the performance or exercise of any of the Regulator’s\nfunctions or powers.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-135-norm"
        }
      ],
      "cml:integrityHash": "d1aa4ca2d10cb622d68c48b7b590496bf9d12552e52506d6eb2f776fb21e6d86",
      "skos:note": "The Regulator may be assisted by certain persons and authorities."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-135",
      "@type": "cof:Section",
      "cof:title": "135 Seconded officers",
      "values:kind": "section",
      "cof:pageNumber": 111,
      "values:originalText": "The Regulator may be assisted by the following:\n(a) persons engaged under the Public Service Act 1999;\n(b) officers and employees of Commonwealth authorities;\n(c) officers and employees of State agencies;\nwhose services are made available to the Regulator in connection\nwith the performance or exercise of any of the Regulator’s\nfunctions or powers."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-135-norm",
