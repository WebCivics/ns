    {
      "@id": "concept:gene-technology-act-2000-sec-125",
      "@type": "cml:Concept",
      "skos:prefLabel": "125 Leave of absence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-125"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
