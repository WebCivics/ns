    },
    {
      "@id": "concept:gene-technology-act-2000-sec-132",
      "@type": "cml:Concept",
      "skos:prefLabel": "132 Purposes of Account",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-132"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.110",
      "values:originalText": "Amounts standing to the credit of the Account may be expended:\n(a) in payment or discharge of the costs, expenses and other\nobligations incurred:\n(i) by the Regulator in the performance of the Regulator’s\nfunctions or in the exercise of the Regulator’s powers\nunder this Act, the regulations or a corresponding State\nlaw; or\n(ii) by an inspector under paragraph 158(2)(e) or under a\ncorresponding State law; and\n(b) in payment of any remuneration and allowances payable to\nany person under this Act or the regulations.\n\n\nAdministration  Part 9\nStaffing  Division 4\nSection 133\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "Amounts standing to the credit of the Account may be expended:\n(a) in payment or discharge of the costs, expenses and other\nobligations incurred:\n(i) by the Regulator in the performance of the Regulator’s\nfunctions or in the exercise of the Regulator’s powers\nunder this Act, the regulations or a corresponding State\nlaw; or\n(ii) by an inspector under paragraph 158(2)(e) or under a\ncorresponding State law; and\n(b) in payment of any remuneration and allowances payable to\nany person under this Act or the regulations.\n\n\nAdministration  Part 9\nStaffing  Division 4\nSection 133\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-132-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-132-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c162400d797d8bb57c3ba9c636e147c735fe12075f80d9eba6e286b890270c7",
      "skos:note": "Expenditure of Account amounts for costs, expenses, and obligations incurred by the Regulator or inspectors."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-132",
      "@type": "cof:Section",
      "cof:title": "132 Purposes of Account",
      "values:kind": "section",
      "cof:pageNumber": 110,
      "values:originalText": "Amounts standing to the credit of the Account may be expended:\n(a) in payment or discharge of the costs, expenses and other\nobligations incurred:\n(i) by the Regulator in the performance of the Regulator’s\nfunctions or in the exercise of the Regulator’s powers\nunder this Act, the regulations or a corresponding State\nlaw; or\n(ii) by an inspector under paragraph 158(2)(e) or under a\ncorresponding State law; and\n(b) in payment of any remuneration and allowances payable to\nany person under this Act or the regulations.\n\n\nAdministration  Part 9\nStaffing  Division 4\nSection 133\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
