        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Paragraph (2)(c) defines what constitutes a submission.",
      "cml:conclusionText": "Submission is an essential consideration for the Regulator."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-97-ss-4-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
