    {
      "@id": "concept:gene-technology-act-2000-sec-90",
      "@type": "cml:Concept",
      "skos:prefLabel": "90 Guidelines",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-90"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.88",
      "values:originalText": "(1) The Regulator may, by written instrument, issue technical or\nprocedural guidelines about the requirements for the certification\nof facilities to specified containment levels.\n(2) The Regulator may, by written instrument, vary or revoke the\nguidelines.\n\n\nCertification and accreditation  Part 7\nAccredited organisations  Division 3\nSection 91\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "(1) The Regulator may, by written instrument, issue technical or\nprocedural guidelines about the requirements for the certification\nof facilities to specified containment levels.\n(2) The Regulator may, by written instrument, vary or revoke the\nguidelines.\n\n\nCertification and accreditation  Part 7\nAccredited organisations  Division 3\nSection 91\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-90-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-90-ss-2"
        }
      ],
      "cml:integrityHash": "a6fdeebff95e044177d732c5f95829e6bcaa3089d2ea407b1cb68d230ffbd68a"
    },
