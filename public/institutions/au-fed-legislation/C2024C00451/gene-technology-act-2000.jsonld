    {
      "@id": "concept:gene-technology-act-2000-sec-89a",
      "@type": "cml:Concept",
      "skos:prefLabel": "89A Transfer of certification",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-89a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.87",
      "values:originalText": "(1) The holder of a certification and another person (the transferee)\nmay jointly apply to the Regulator for the certification to be\ntransferred from the holder of the certification to the transferee.\n(2) The application must be in writing, and must contain:\n(a) such information as is prescribed by the regulations (if any);\nand\n(b) such information as is specified in writing by the Regulator.\n(3) The Regulator must not transfer the certification unless the\nRegulator is satisfied that, if the certification is transferred, any\nconditions to which the certification is subject will continue to be\nmet.",
      "skos:definition": "(1) The holder of a certification and another person (the transferee)\nmay jointly apply to the Regulator for the certification to be\ntransferred from the holder of the certification to the transferee.\n(2) The application must be in writing, and must contain:\n(a) such information as is prescribed by the regulations (if any);\nand\n(b) such information as is specified in writing by the Regulator.\n(3) The Regulator must not transfer the certification unless the\nRegulator is satisfied that, if the certification is transferred, any\nconditions to which the certification is subject will continue to be\nmet.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-89a-ss-1"
        },
