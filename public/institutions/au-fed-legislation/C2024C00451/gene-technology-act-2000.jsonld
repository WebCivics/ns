    {
      "@id": "concept:gene-technology-act-2000-sec-15",
      "@type": "cml:Concept",
      "skos:prefLabel": "15 Relationship to other Commonwealth laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-15"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.25",
      "values:originalText": "The provisions of this Act are in addition to, and not in substitution\nfor, the requirements of any other law of the Commonwealth\n(whether passed or made before or after the commencement of this\nsection).",
      "skos:definition": "The provisions of this Act are in addition to, and not in substitution\nfor, the requirements of any other law of the Commonwealth\n(whether passed or made before or after the commencement of this\nsection).",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-15-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-15-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "30043efec391bf615393aaca0696ed7926972b929a39c54867d34ed47e7ee5cd",
      "skos:note": "Provisions of this Act do not substitute for other Commonwealth laws."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-15",
      "@type": "cof:Section",
      "cof:title": "15 Relationship to other Commonwealth laws",
      "values:kind": "section",
      "cof:pageNumber": 25,
      "values:originalText": "The provisions of this Act are in addition to, and not in substitution\nfor, the requirements of any other law of the Commonwealth\n(whether passed or made before or after the commencement of this\nsection)."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-15-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
