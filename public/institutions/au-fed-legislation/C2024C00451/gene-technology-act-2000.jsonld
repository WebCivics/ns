    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-151-ss-4",
      "@type": "cof:Section",
      "cof:title": "151(4) Identity card",
      "values:kind": "subsection",
      "cof:pageNumber": 124,
      "values:originalText": "(4) An inspector must carry his or her identity card at all times when\nexercising powers or performing functions as an inspector.\n\n\nPowers of inspection  Part 11\nMonitoring powers  Division 3\nSection 152\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
