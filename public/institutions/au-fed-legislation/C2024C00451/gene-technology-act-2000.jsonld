      "cml:integrityHash": "e844088158db146861faec9b011fccdf19d7df45c9fe54f7f91ce4acf8dfd205",
      "skos:note": "Defines period of effect for emergency dealing determination"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-72c-ss-7",
      "@type": "cof:Section",
      "cof:title": "72C(7) Period of effect of emergency dealing determination",
      "values:kind": "subsection",
      "cof:pageNumber": 70,
      "values:originalText": "(7) In subsection (5):"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-72c-ss-7-norm",
