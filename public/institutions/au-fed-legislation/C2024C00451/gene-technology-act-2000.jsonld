    },
    {
      "@id": "concept:gene-technology-act-2000-sec-193",
      "@type": "cml:Concept",
      "skos:prefLabel": "193 Regulations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-193"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.161",
      "values:originalText": "(1) The Governor-General may make regulations prescribing matters:\n(a) required or permitted by this Act to be prescribed; or\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.",
      "skos:definition": "(1) The Governor-General may make regulations prescribing matters:\n(a) required or permitted by this Act to be prescribed; or\n(b) necessary or convenient to be prescribed for carrying out or\ngiving effect to this Act.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-193-norm"
        }
      ],
      "cml:integrityHash": "41d9b5f08f739efdb4be2e3e507e095eba743b15b2df46ccc7bad40204423e3c",
      "skos:note": "Governor-General may make regulations for carrying out or giving effect to the Act."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-193",
      "@type": "cof:Section",
      "cof:title": "193 Regulations",
      "values:kind": "section",
