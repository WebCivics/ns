    {
      "@id": "concept:gene-technology-act-2000-sec-77",
      "@type": "cml:Concept",
      "skos:prefLabel": "77 Contents of Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-77"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.81",
      "values:originalText": "If the Regulator determines under section 78 that a dealing with a\nGMO is to be included on the GMO Register, the Regulator must\nspecify in the GMO Register:\n(a) a description of the dealing with the GMO; and\n(b) any condition to which the dealing is subject.",
      "skos:definition": "If the Regulator determines under section 78 that a dealing with a\nGMO is to be included on the GMO Register, the Regulator must\nspecify in the GMO Register:\n(a) a description of the dealing with the GMO; and\n(b) any condition to which the dealing is subject.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-77-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-77-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1e4c704481ff8b00adfadc2e2e57306058962eabdcab09c1f4ed6bd37d7030b4",
      "skos:note": "Specify description and conditions of dealing with GMO in Register",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-77",
      "@type": "cof:Section",
      "cof:title": "77 Contents of Register",
      "values:kind": "section",
      "cof:pageNumber": 81,
      "values:originalText": "If the Regulator determines under section 78 that a dealing with a\nGMO is to be included on the GMO Register, the Regulator must\nspecify in the GMO Register:\n(a) a description of the dealing with the GMO; and\n(b) any condition to which the dealing is subject."
    },
