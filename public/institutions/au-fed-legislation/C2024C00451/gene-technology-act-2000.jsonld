    {
      "@id": "concept:gene-technology-act-2000-sec-171",
      "@type": "cml:Concept",
      "skos:prefLabel": "171 Disposal of goods if there is no owner or owner cannot be",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-171"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.138",
      "values:originalText": "located\nIf:\n(a) a thing is seized under this Part; and\n(b) apart from this section, the Commonwealth is required to\nreturn the thing to the owner; and\n(c) there is no owner or the Regulator cannot, despite making\nreasonable efforts, locate the owner;\n\n\nPowers of inspection  Part 11\nGeneral provisions relating to search and seizure  Division 9\nSection 171\nGene Technology Act 2000\nCompilation date: 14/10/2024\nthe Regulator may dispose of the thing in such manner as the\nRegulator thinks appropriate.",
      "skos:definition": "located\nIf:\n(a) a thing is seized under this Part; and\n(b) apart from this section, the Commonwealth is required to\nreturn the thing to the owner; and\n(c) there is no owner or the Regulator cannot, despite making\nreasonable efforts, locate the owner;\n\n\nPowers of inspection  Part 11\nGeneral provisions relating to search and seizure  Division 9\nSection 171\nGene Technology Act 2000\nCompilation date: 14/10/2024\nthe Regulator may dispose of the thing in such manner as the\nRegulator thinks appropriate.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-171-norm"
        }
      ],
      "cml:integrityHash": "946709463c14a55592dad704b91b3dc2ce42f53249a1da9c621ab0ab1549b10c",
      "skos:note": "The Regulator may dispose of a thing in such manner as the Regulator thinks appropriate."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-171",
      "@type": "cof:Section",
      "cof:title": "171 Disposal of goods if there is no owner or owner cannot be",
      "values:kind": "section",
      "cof:pageNumber": 138,
      "values:originalText": "located\nIf:\n(a) a thing is seized under this Part; and\n(b) apart from this section, the Commonwealth is required to\nreturn the thing to the owner; and\n(c) there is no owner or the Regulator cannot, despite making\nreasonable efforts, locate the owner;\n\n\nPowers of inspection  Part 11\nGeneral provisions relating to search and seizure  Division 9\nSection 171\nGene Technology Act 2000\nCompilation date: 14/10/2024\nthe Regulator may dispose of the thing in such manner as the\nRegulator thinks appropriate."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-171-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
