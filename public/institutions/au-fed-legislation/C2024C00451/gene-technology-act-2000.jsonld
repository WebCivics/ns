      },
      "cml:operator": "During",
      "cml:logicSummary": "Equipment operation occurs during inspection",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
