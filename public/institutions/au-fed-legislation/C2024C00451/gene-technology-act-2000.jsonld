      ],
      "cml:integrityHash": "7f50955dfdbb63687c0063823e29eadad83d5e67af22dfae608cf5e95d0039c2",
      "skos:note": "Protect health and safety of people and environment by regulating GMOs."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-3",
