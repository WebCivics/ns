      "@type": "cml:Concept",
      "skos:prefLabel": "124(1) Remuneration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-124-ss-1"
      },
      "cml:curationStatus": {
