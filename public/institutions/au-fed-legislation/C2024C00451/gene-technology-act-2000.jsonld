    },
    {
      "@id": "concept:gene-technology-act-2000-sec-16",
      "@type": "cml:Concept",
      "skos:prefLabel": "16 State laws may operate concurrently",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-16"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.26",
      "values:originalText": "(1) This Act is not intended to exclude the operation of any State law,\nto the extent that the State law is capable of operating concurrently\nwith this Act, other than a State law prescribed by the regulations\nfor the purposes of this section.\n(2) The Governor-General may prescribe a State law under\nsubsection (1) only if:\n(a) there is no corresponding State law in effect in relation to\nthat State; and\n(b) either:\n(i) the State law relates specifically to dealings with\nGMOs; or\n(ii) for the purposes of a decision under the State law as to\nwhether or not a licence, authority or approval (however\ndescribed) is granted under the State law, the State law\ndistinguishes between dealings with GMOs and dealings\nwith other things.",
      "skos:definition": "(1) This Act is not intended to exclude the operation of any State law,\nto the extent that the State law is capable of operating concurrently\nwith this Act, other than a State law prescribed by the regulations\nfor the purposes of this section.\n(2) The Governor-General may prescribe a State law under\nsubsection (1) only if:\n(a) there is no corresponding State law in effect in relation to\nthat State; and\n(b) either:\n(i) the State law relates specifically to dealings with\nGMOs; or\n(ii) for the purposes of a decision under the State law as to\nwhether or not a licence, authority or approval (however\ndescribed) is granted under the State law, the State law\ndistinguishes between dealings with GMOs and dealings\nwith other things.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-16-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-16-ss-2"
        }
      ],
      "cml:integrityHash": "b9fbacd3e9a37c9f539608d164a7780b418756129468254a8f173a23d5220c16"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-16",
      "@type": "cof:Section",
      "cof:title": "16 State laws may operate concurrently",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "(1) This Act is not intended to exclude the operation of any State law,\nto the extent that the State law is capable of operating concurrently\nwith this Act, other than a State law prescribed by the regulations\nfor the purposes of this section.\n(2) The Governor-General may prescribe a State law under\nsubsection (1) only if:\n(a) there is no corresponding State law in effect in relation to\nthat State; and\n(b) either:\n(i) the State law relates specifically to dealings with\nGMOs; or\n(ii) for the purposes of a decision under the State law as to\nwhether or not a licence, authority or approval (however\ndescribed) is granted under the State law, the State law\ndistinguishes between dealings with GMOs and dealings\nwith other things."
    },
