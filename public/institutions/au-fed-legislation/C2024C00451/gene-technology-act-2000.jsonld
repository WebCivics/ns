    {
      "@id": "concept:gene-technology-act-2000-sec-72-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "72(3) Regulator to notify of proposed suspension, cancellation or",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-72-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
