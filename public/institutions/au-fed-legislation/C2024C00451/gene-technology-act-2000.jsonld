    {
      "@id": "concept:gene-technology-act-2000-sec-66",
      "@type": "cml:Concept",
      "skos:prefLabel": "66 Person may give information to Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-66"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.62",
      "values:originalText": "A person covered by a licence may inform the Regulator if he or\nshe:\n(a) becomes aware of additional information as to any risks to\nthe health and safety of people, or to the environment,\nassociated with the dealings authorised by the licence; or\n(b) becomes aware of any contraventions of the licence by a\nperson covered by the licence; or\n(c) becomes aware of any unintended effects of the dealings\nauthorised by the licence.",
      "skos:definition": "A person covered by a licence may inform the Regulator if he or\nshe:\n(a) becomes aware of additional information as to any risks to\nthe health and safety of people, or to the environment,\nassociated with the dealings authorised by the licence; or\n(b) becomes aware of any contraventions of the licence by a\nperson covered by the licence; or\n(c) becomes aware of any unintended effects of the dealings\nauthorised by the licence.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-66-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-66-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-66-logic-epistemic-2"
        }
      ],
      "cml:integrityHash": "7f60cc653f302dfb4e36221ade53f4b33271096d94d1204176fa0f95245d9df5",
      "skos:note": "A person covered by a licence may inform the Regulator about certain risks and contraventions."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-66",
      "@type": "cof:Section",
      "cof:title": "66 Person may give information to Regulator",
      "values:kind": "section",
