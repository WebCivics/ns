      ],
      "cml:integrityHash": "c32510a329cf5a6182a46bac58f270d01cc82c78c3d3b9c126b4f88f2553c62d",
      "skos:note": "Establishing state of mind of a body corporate in relation to conduct",
      "dc:description": "Director, employee or agent's actual or apparent authority and state of mind"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-188-ss-1",
      "@type": "cof:Section",
      "cof:title": "188(1) Conduct by directors, employees and agents",
      "values:kind": "subsection",
      "cof:pageNumber": 156,
      "values:originalText": "(1) If, in proceedings for an offence against this Act or the regulations,\nor an ancillary offence in relation to this Act or the regulations, it is\nnecessary to establish the state of mind of a body corporate in\nrelation to particular conduct, it is sufficient to show:\n(a) that the conduct was engaged in by a director, employee or\nagent of the body corporate within the scope of his or her\nactual or apparent authority; and\n(b) that the director, employee or agent had the state of mind."
    },
    {
