    {
      "@id": "concept:gene-technology-act-2000-sec-121",
      "@type": "cml:Concept",
      "skos:prefLabel": "121 Acting appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-121"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.106",
      "values:originalText": "The Minister may appoint a person to act as the Regulator:\n(a) during a vacancy in the office of Regulator, (whether or not\nan appointment has previously been made to the office); or\n(b) during any period, or during all periods, when the Regulator\nis absent from duty or from Australia, or is, for any reason,\nunable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.",
      "skos:definition": "The Minister may appoint a person to act as the Regulator:\n(a) during a vacancy in the office of Regulator, (whether or not\nan appointment has previously been made to the office); or\n(b) during any period, or during all periods, when the Regulator\nis absent from duty or from Australia, or is, for any reason,\nunable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-121-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-121-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "aeb2348c1c6484983385f3d88ed99b3cb5594c7d7dd30328cd1412db1cef957c",
      "skos:note": "The Minister may appoint a person to act as the Regulator."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-121",
      "@type": "cof:Section",
      "cof:title": "121 Acting appointment",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "The Minister may appoint a person to act as the Regulator:\n(a) during a vacancy in the office of Regulator, (whether or not\nan appointment has previously been made to the office); or\n(b) during any period, or during all periods, when the Regulator\nis absent from duty or from Australia, or is, for any reason,\nunable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-121-norm",
      "@type": "values:Obligation",
