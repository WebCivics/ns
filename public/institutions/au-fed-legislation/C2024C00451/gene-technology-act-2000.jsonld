    {
      "@id": "concept:gene-technology-act-2000-sec-157-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to secure thing",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector believes information/material may be accessible by operating thing.",
      "cml:conclusionText": "Inspector must do whatever is necessary to secure thing."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-157-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": ">=",
      "cml:logicSummary": "Timeframe for inspector's action must be before information/material is destroyed/alterated",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector does not take action under subsection.",
      "cml:conclusionText": "Timeframe for inspector's action must be before information/material is destroyed/alterated."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-157-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Inspector's action can occur at any time after thing is secured",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector secures thing.",
      "cml:conclusionText": "Inspector's action can occur at any time after thing is secured."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-157-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IF",
      "cml:logicSummary": "Inspector's action must be taken if expert assistance is required",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Expert assistance is required to operate thing.",
      "cml:conclusionText": "Inspector's action must be taken if expert assistance is required."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-157-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Thing is a security risk if not secured by AI system",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
