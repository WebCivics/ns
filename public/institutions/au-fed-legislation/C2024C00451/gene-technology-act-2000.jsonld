      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-18",
      "@type": "cml:Concept",
      "skos:prefLabel": "18 No doubling-up of liabilities",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-18"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.27",
      "values:originalText": "(1) If:\n(a) an act or omission is an offence against this Act and is also\nan offence against a corresponding State law; and\n(b) the offender has been punished for the offence under the\ncorresponding State law;\nthe offender is not liable to be punished for the offence under this\nAct.",
      "skos:definition": "(1) If:\n(a) an act or omission is an offence against this Act and is also\nan offence against a corresponding State law; and\n(b) the offender has been punished for the offence under the\ncorresponding State law;\nthe offender is not liable to be punished for the offence under this\nAct.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-18-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-18-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "09188ecc7aa5968d841a535f7630837426bde7364a6af930136fd0168118c5b6",
      "skos:note": "No punishment for offence under this Act if already punished under corresponding State law."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-18",
      "@type": "cof:Section",
      "cof:title": "18 No doubling-up of liabilities",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "(1) If:\n(a) an act or omission is an offence against this Act and is also\nan offence against a corresponding State law; and\n(b) the offender has been punished for the offence under the\ncorresponding State law;\nthe offender is not liable to be punished for the offence under this\nAct."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-18-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-18"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-18-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Implies",
      "cml:logicSummary": "If A implies B, and A is true, then B is true.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(A -> B)",
      "cml:conclusionText": "B"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Review of certain decisions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.28",
      "values:originalText": "(1) Application may be made to the Administrative Review Tribunal\nfor review of a reviewable State decision.\n(2) A decision made by the Regulator in the performance of a function\nor the exercise of a power conferred by a corresponding State law\nis a reviewable State decision for the purposes of this section if:\n(a) the law under which the decision was made provides for\nreview by the Administrative Review Tribunal; and\n(b) the decision is declared by the regulations to be a reviewable\nState decision for the purposes of this section.\n(3) For the purposes of this section, the Administrative Review\nTribunal Act 2024 has effect as if a corresponding State law were\nan Act.",
      "skos:definition": "(1) Application may be made to the Administrative Review Tribunal\nfor review of a reviewable State decision.\n(2) A decision made by the Regulator in the performance of a function\nor the exercise of a power conferred by a corresponding State law\nis a reviewable State decision for the purposes of this section if:\n(a) the law under which the decision was made provides for\nreview by the Administrative Review Tribunal; and\n(b) the decision is declared by the regulations to be a reviewable\nState decision for the purposes of this section.\n(3) For the purposes of this section, the Administrative Review\nTribunal Act 2024 has effect as if a corresponding State law were\nan Act.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-19-ss-1"
