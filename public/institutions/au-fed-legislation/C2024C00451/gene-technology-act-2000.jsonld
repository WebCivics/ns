      "cml:premiseText": "(a) the Regulator is removed or retired from office on the grounds of physical or mental incapacity; and (b) CSC gives a certificate under section 13 of that Act."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-120",
      "@type": "cml:Concept",
      "skos:prefLabel": "120 Disclosure of interests",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-120"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.106",
      "values:originalText": "The Regulator must give written notice to the Minister of all\ninterests, pecuniary or otherwise, that the Regulator has or acquires\nand that could conflict with the proper performance of the\nRegulator’s functions.",
      "skos:definition": "The Regulator must give written notice to the Minister of all\ninterests, pecuniary or otherwise, that the Regulator has or acquires\nand that could conflict with the proper performance of the\nRegulator’s functions.",
      "cml:asserts": [
