        "@id": "cml:Epistemic"
      },
      "cml:operator": "REASONABLE GROUNDS",
      "cml:logicSummary": "Magistrate has reasonable grounds to believe warrant is justified",
      "cml:executionSurface": "modalities::epistemic",
      "cml:confidence": {
