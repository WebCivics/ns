        }
      ],
      "cml:integrityHash": "a5e7a3de26a47bf0fdfd2a45be48020d0f09bae1ba83a7d8d58aad2db1de631a",
      "skos:note": "Record of GMO Dealings must contain specific information",
      "dc:description": "Yes"
    },
    {
