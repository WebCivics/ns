          "@id": "concept:gene-technology-act-2000-sec-12-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-12-ss-2"
        }
      ],
      "cml:integrityHash": "a5a7619717f95365ff0a08817b8bad520085429fd0f084a755cd548012c996f7"
    },
