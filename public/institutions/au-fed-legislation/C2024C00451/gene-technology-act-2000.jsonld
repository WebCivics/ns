    {
      "@id": "concept:gene-technology-act-2000-sec-123",
      "@type": "cml:Concept",
      "skos:prefLabel": "123 Outside employment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-123"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.106",
      "values:originalText": "The Regulator must not engage in paid employment outside the\nduties of the Regulator’s office without the approval of the\nMinister.\n\n\nAdministration  Part 9\nAppointment and conditions of Regulator  Division 2\nSection 124\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "The Regulator must not engage in paid employment outside the\nduties of the Regulator’s office without the approval of the\nMinister.\n\n\nAdministration  Part 9\nAppointment and conditions of Regulator  Division 2\nSection 124\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-123-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-123-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-123-logic-alleninterval-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-123-logic-argumentation-3"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-123-logic-diffusion-4"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-123-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "065a62268d1837b6bc2337732a3ed8d86f4fff81918d88e6eca57710e1b1d3c1",
      "skos:note": "Regulator cannot engage in paid employment outside office without Minister's approval."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-123",
      "@type": "cof:Section",
      "cof:title": "123 Outside employment",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "The Regulator must not engage in paid employment outside the\nduties of the Regulator’s office without the approval of the\nMinister.\n\n\nAdministration  Part 9\nAppointment and conditions of Regulator  Division 2\nSection 124\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
