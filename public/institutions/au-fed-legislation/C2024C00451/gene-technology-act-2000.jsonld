    {
      "@id": "concept:gene-technology-act-2000-sec-100-ss-7a",
      "@type": "cml:Concept",
      "skos:prefLabel": "100(7A) The Gene Technology Technical Advisory Committee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-100-ss-7a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.94",
      "values:originalText": "(7A) The Minister must ensure that the Committee includes at least one\nperson who is a member of the Ethics and Community Committee.\nThe Minister is not required to be satisfied that this person has\nskills or experience in an area mentioned in subsection (5).",
      "skos:definition": "(7A) The Minister must ensure that the Committee includes at least one\nperson who is a member of the Ethics and Community Committee.\nThe Minister is not required to be satisfied that this person has\nskills or experience in an area mentioned in subsection (5).",
