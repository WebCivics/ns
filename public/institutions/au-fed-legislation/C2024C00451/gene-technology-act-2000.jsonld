        },
        {
          "@id": "concept:gene-technology-act-2000-sec-47-ss-3-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "13530ead05dcddc2477b2978f12ea4b5293a95e0131c59ec6b7c8198f1b4a899",
      "skos:note": "Regulator must protect health and safety of people and environment in risk management plan."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-47-ss-3",
      "@type": "cof:Section",
      "cof:title": "47(3) What the Regulator must do in relation to application",
      "values:kind": "subsection",
      "cof:pageNumber": 46,
      "values:originalText": "(3) In preparing the risk management plan, the Regulator must take\ninto account the means of managing any risks posed by the\ndealings proposed to be authorised by the licence in such a way as\nto protect:\n(a) the health and safety of people; and\n(b) the environment."
    },
