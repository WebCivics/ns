    {
      "@id": "concept:gene-technology-act-2000-sec-39",
      "@type": "cml:Concept",
      "skos:prefLabel": "39 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-39"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.41",
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides a licensing system under which a person can\napply to the Regulator for a licence authorising dealings with\nGMOs.\nThis Part sets out the processes to be followed by the Regulator in\nrelation to applications involving 2 kinds of dealings:\n(a)\nthose that involve the intentional release of a GMO\ninto the environment; and\n(b)\nthose that do not involve the intentional release of\na GMO into the environment.\nA licence can cover dealings by persons other than the licence\nholder. The licence holder is required to inform such persons of\nany conditions of the licence that apply to them.",
      "skos:definition": "The following is a simplified outline of this Part:\nThis Part provides a licensing system under which a person can\napply to the Regulator for a licence authorising dealings with\nGMOs.\nThis Part sets out the processes to be followed by the Regulator in\nrelation to applications involving 2 kinds of dealings:\n(a)\nthose that involve the intentional release of a GMO\ninto the environment; and\n(b)\nthose that do not involve the intentional release of\na GMO into the environment.\nA licence can cover dealings by persons other than the licence\nholder. The licence holder is required to inform such persons of\nany conditions of the licence that apply to them.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-39-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-39-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-39-logic-linearlogic-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-39-logic-alleninterval-3"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-39-logic-diffusion-4"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-39-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "16a8b0f8a674db7ef64641cbea922ec54ca9110b8d3e63203c50a9ab472baf74",
      "skos:note": "Licensing system for dealings with GMOs"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-39",
      "@type": "cof:Section",
      "cof:title": "39 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 41,
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides a licensing system under which a person can\napply to the Regulator for a licence authorising dealings with\nGMOs.\nThis Part sets out the processes to be followed by the Regulator in\nrelation to applications involving 2 kinds of dealings:\n(a)\nthose that involve the intentional release of a GMO\ninto the environment; and\n(b)\nthose that do not involve the intentional release of\na GMO into the environment.\nA licence can cover dealings by persons other than the licence\nholder. The licence holder is required to inform such persons of\nany conditions of the licence that apply to them."
    },
