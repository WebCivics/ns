    {
      "@id": "concept:gene-technology-act-2000-sec-68",
      "@type": "cml:Concept",
      "skos:prefLabel": "68 Suspension and cancellation of licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-68"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.63",
      "values:originalText": "The Regulator may, by notice in writing given to the holder of a\nGMO licence, suspend or cancel the licence if:\n(a) the Regulator believes on reasonable grounds that a condition\nof the licence has been breached, whether by the licence\nholder or by a person covered by the licence; or\n(b) the Regulator believes on reasonable grounds that the licence\nholder, or a person covered by the licence, has committed an\noffence against this Act or the regulations; or\n(c) any annual charge payable in respect of the licence remains\nunpaid after the due date; or\n(d) the licence was obtained improperly; or\n(e) the Regulator becomes aware of risks associated with the\ncontinuation of the dealings authorised by the licence, and is\nsatisfied that the licence holder has not proposed, or is not in\na position to implement, adequate measures to deal with\nthose risks; or\n(f) the Regulator is satisfied that the licence holder is no longer a\nsuitable person to hold the licence.",
      "skos:definition": "The Regulator may, by notice in writing given to the holder of a\nGMO licence, suspend or cancel the licence if:\n(a) the Regulator believes on reasonable grounds that a condition\nof the licence has been breached, whether by the licence\nholder or by a person covered by the licence; or\n(b) the Regulator believes on reasonable grounds that the licence\nholder, or a person covered by the licence, has committed an\noffence against this Act or the regulations; or\n(c) any annual charge payable in respect of the licence remains\nunpaid after the due date; or\n(d) the licence was obtained improperly; or\n(e) the Regulator becomes aware of risks associated with the\ncontinuation of the dealings authorised by the licence, and is\nsatisfied that the licence holder has not proposed, or is not in\na position to implement, adequate measures to deal with\nthose risks; or\n(f) the Regulator is satisfied that the licence holder is no longer a\nsuitable person to hold the licence.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-68-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-68-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-68-logic-alleninterval-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-68-logic-argumentation-3"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-68-logic-diffusion-4"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-68-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "35b2de3ce60e5f7c99e6b31764df37858a833a3a67d744313a3dc2cb32bbf951",
      "skos:note": "Suspension or cancellation of GMO licence"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-68",
      "@type": "cof:Section",
      "cof:title": "68 Suspension and cancellation of licence",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "The Regulator may, by notice in writing given to the holder of a\nGMO licence, suspend or cancel the licence if:\n(a) the Regulator believes on reasonable grounds that a condition\nof the licence has been breached, whether by the licence\nholder or by a person covered by the licence; or\n(b) the Regulator believes on reasonable grounds that the licence\nholder, or a person covered by the licence, has committed an\noffence against this Act or the regulations; or\n(c) any annual charge payable in respect of the licence remains\nunpaid after the due date; or\n(d) the licence was obtained improperly; or\n(e) the Regulator becomes aware of risks associated with the\ncontinuation of the dealings authorised by the licence, and is\nsatisfied that the licence holder has not proposed, or is not in\na position to implement, adequate measures to deal with\nthose risks; or\n(f) the Regulator is satisfied that the licence holder is no longer a\nsuitable person to hold the licence."
    },
