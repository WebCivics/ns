    {
      "@id": "concept:gene-technology-act-2000-sec-192",
      "@type": "cml:Concept",
      "skos:prefLabel": "192 False or misleading information or document",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-192"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.160",
      "values:originalText": "A person must not:\n(a) in connection with an application made to the Regulator\nunder this Act or the regulations; or\n(b) in compliance or purported compliance with this Act or the\nregulations;\ndo either of the following:\n(c) give information (whether orally or in writing) that the\nperson knows to be false or misleading in a material\nparticular;\n(d) produce a document that the person knows to be false or\nmisleading in a material particular without:\n(i) indicating to the person to whom the document is\nproduced that it is false or misleading, and the respect in\nwhich it is false or misleading; and\n(ii) providing correct information to that person, if the\nperson producing the document is in possession of, or\ncan reasonably acquire, the correct information.\nMaximum penalty: Imprisonment for 1 year or 60 penalty units.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.",
      "skos:definition": "A person must not:\n(a) in connection with an application made to the Regulator\nunder this Act or the regulations; or\n(b) in compliance or purported compliance with this Act or the\nregulations;\ndo either of the following:\n(c) give information (whether orally or in writing) that the\nperson knows to be false or misleading in a material\nparticular;\n(d) produce a document that the person knows to be false or\nmisleading in a material particular without:\n(i) indicating to the person to whom the document is\nproduced that it is false or misleading, and the respect in\nwhich it is false or misleading; and\n(ii) providing correct information to that person, if the\nperson producing the document is in possession of, or\ncan reasonably acquire, the correct information.\nMaximum penalty: Imprisonment for 1 year or 60 penalty units.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-192-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-192-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "bda0a2c857879f5c3d8cbc78045f178c6dbcce1c8c5f52e190fd69ca3af130ee",
      "skos:note": "Prohibition on providing false or misleading information",
      "dc:description": "Correct information when requested"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-192",
      "@type": "cof:Section",
      "cof:title": "192 False or misleading information or document",
      "values:kind": "section",
      "cof:pageNumber": 160,
      "values:originalText": "A person must not:\n(a) in connection with an application made to the Regulator\nunder this Act or the regulations; or\n(b) in compliance or purported compliance with this Act or the\nregulations;\ndo either of the following:\n(c) give information (whether orally or in writing) that the\nperson knows to be false or misleading in a material\nparticular;\n(d) produce a document that the person knows to be false or\nmisleading in a material particular without:\n(i) indicating to the person to whom the document is\nproduced that it is false or misleading, and the respect in\nwhich it is false or misleading; and\n(ii) providing correct information to that person, if the\nperson producing the document is in possession of, or\ncan reasonably acquire, the correct information.\nMaximum penalty: Imprisonment for 1 year or 60 penalty units.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-192-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-192"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
