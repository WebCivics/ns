    {
      "@id": "concept:gene-technology-act-2000-sec-36",
      "@type": "cml:Concept",
      "skos:prefLabel": "36 Person must not breach conditions on GMO Register",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-36"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.39",
      "values:originalText": "(1) A person commits an offence if the person:\n(a) deals with a GMO, knowing that it is a GMO; and\n(b) the dealing is on the GMO Register; and\n(c) the dealing contravenes a condition relating to the dealing\nthat is specified in the GMO Register.\nMaximum penalty: 50 penalty units.",
      "skos:definition": "(1) A person commits an offence if the person:\n(a) deals with a GMO, knowing that it is a GMO; and\n(b) the dealing is on the GMO Register; and\n(c) the dealing contravenes a condition relating to the dealing\nthat is specified in the GMO Register.\nMaximum penalty: 50 penalty units.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-36-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-36-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "832b0de2ff31660b89bc5959f66125393e416f958c42308704abdbd065453e40",
      "skos:note": "Dealing with GMOs on the register is prohibited."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-36",
      "@type": "cof:Section",
      "cof:title": "36 Person must not breach conditions on GMO Register",
      "values:kind": "section",
      "cof:pageNumber": 39,
      "values:originalText": "(1) A person commits an offence if the person:\n(a) deals with a GMO, knowing that it is a GMO; and\n(b) the dealing is on the GMO Register; and\n(c) the dealing contravenes a condition relating to the dealing\nthat is specified in the GMO Register.\nMaximum penalty: 50 penalty units."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-36-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
