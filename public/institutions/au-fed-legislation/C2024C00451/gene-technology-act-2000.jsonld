    {
      "@id": "concept:gene-technology-act-2000-sec-138-ss-3a",
      "@type": "cml:Concept",
      "skos:prefLabel": "138(3A) Record of GMO Dealings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-138-ss-3a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
