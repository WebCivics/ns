      "skos:note": "The Regulator must disclose its interests to the Minister.",
      "dc:description": "written notice"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-120",
      "@type": "cof:Section",
      "cof:title": "120 Disclosure of interests",
      "values:kind": "section",
      "cof:pageNumber": 106,
      "values:originalText": "The Regulator must give written notice to the Minister of all\ninterests, pecuniary or otherwise, that the Regulator has or acquires\nand that could conflict with the proper performance of the\nRegulator’s functions."
    },
