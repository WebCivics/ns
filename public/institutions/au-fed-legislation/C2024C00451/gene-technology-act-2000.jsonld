      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-169-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "169(3) Retention of seized things",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-169-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.137",
      "values:originalText": "(3) The thing may be returned under subsection (2) either\nunconditionally or on such terms and conditions as the Regulator\nsees fit.",
      "skos:definition": "(3) The thing may be returned under subsection (2) either\nunconditionally or on such terms and conditions as the Regulator\nsees fit.",
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-169"
      },
      "cml:asserts": [
