    {
      "@id": "concept:gene-technology-act-2000-sec-53",
      "@type": "cml:Concept",
      "skos:prefLabel": "53 Regulator may take other actions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-53"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.53",
      "values:originalText": "(1) In addition to satisfying the requirements of this Division in\nrelation to an application for a licence to which this Division\napplies, the Regulator may take any other action the Regulator\nconsiders appropriate for the purpose of deciding the application,\nincluding holding a public hearing.\n(2) If the Regulator holds a public hearing, the Regulator may, having\nregard to the requirements of this Act in relation to confidential\ncommercial information, direct that any part of the hearing be held\nin private, and may determine who can attend.",
      "skos:definition": "(1) In addition to satisfying the requirements of this Division in\nrelation to an application for a licence to which this Division\napplies, the Regulator may take any other action the Regulator\nconsiders appropriate for the purpose of deciding the application,\nincluding holding a public hearing.\n(2) If the Regulator holds a public hearing, the Regulator may, having\nregard to the requirements of this Act in relation to confidential\ncommercial information, direct that any part of the hearing be held\nin private, and may determine who can attend.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-53-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-53-ss-2"
        }
      ],
      "cml:integrityHash": "fda2314bf28c37df6736d75d7c24fb2cbe93e2cedc3a08e1dd076d8b5476b9db"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-53",
      "@type": "cof:Section",
      "cof:title": "53 Regulator may take other actions",
