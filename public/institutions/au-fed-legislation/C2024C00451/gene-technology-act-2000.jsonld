    {
      "@id": "concept:gene-technology-act-2000-sec-144",
      "@type": "cml:Concept",
      "skos:prefLabel": "144 Regulator not required to review matters",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-144"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.117",
      "values:originalText": "Nothing in this Division requires the Regulator to consider a matter\nunder section 140 or 141.",
      "skos:definition": "Nothing in this Division requires the Regulator to consider a matter\nunder section 140 or 141.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-144-norm"
        }
      ],
