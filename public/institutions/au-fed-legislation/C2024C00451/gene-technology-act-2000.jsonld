    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-43-ss-3",
      "@type": "cof:Section",
      "cof:title": "43(3) Regulator must consider applications except in certain",
      "values:kind": "subsection",
      "cof:pageNumber": 44,
      "values:originalText": "(3) The Regulator must issue the licence, or refuse to issue the licence,\nwithin the period (if any) prescribed by the regulations."
    },
