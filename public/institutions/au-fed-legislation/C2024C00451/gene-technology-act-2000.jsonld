      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.104",
      "values:originalText": "(5) For the purposes of the Superannuation Act 1976, the Regulator is\ntaken to have been retired from office on the grounds of invalidity\nif:\n(a) the Regulator is removed or retired from office on the\ngrounds of physical or mental incapacity; and\n(b) CSC gives a certificate under section 54C of that Act.",
      "skos:definition": "(5) For the purposes of the Superannuation Act 1976, the Regulator is\ntaken to have been retired from office on the grounds of invalidity\nif:\n(a) the Regulator is removed or retired from office on the\ngrounds of physical or mental incapacity; and\n(b) CSC gives a certificate under section 54C of that Act.",
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-119"
      },
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-119-ss-5-norm"
