      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval for variation",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A variation may remove a dealing from the GMO Register;",
      "cml:conclusionText": "The removal of a dealing from the GMO Register occurs during the variation."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-80-ss-2-logic-ltl-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Temporal interval for variation",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
