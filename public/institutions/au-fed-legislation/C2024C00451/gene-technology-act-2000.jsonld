      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If the inspector, after operating the equipment...",
      "cml:conclusionText": "The seizure occurs repeatedly if the equipment is operated repeatedly."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-156-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Describes diffusion of evidential material from premises.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If the material can be transferred to a disk, tape or other storage device...",
      "cml:conclusionText": "The evidential material diffuses from the premises if it is transferred to a storage device."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-156-ss-2-logic-cogai-5",
      "@type": "cml:LogicApplication",
