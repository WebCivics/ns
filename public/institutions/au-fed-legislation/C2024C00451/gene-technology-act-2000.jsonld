    {
      "@id": "concept:gene-technology-act-2000-sec-64",
      "@type": "cml:Concept",
      "skos:prefLabel": "64 Condition about monitoring and audits",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-64"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.61",
      "values:originalText": "(1) It is a condition of a licence that if:\n(a) a person is authorised by the licence to deal with a GMO; and\n(b) a particular condition of the licence applies to the dealing by\nthe person;\nthe person must allow the Regulator, or a person authorised by the\nRegulator, to enter premises where the dealing is being undertaken,\nfor the purposes of auditing or monitoring the dealing.\n(2) Subsection (1) does not limit the conditions that may be imposed\nby the Regulator or prescribed by the regulations.",
      "skos:definition": "(1) It is a condition of a licence that if:\n(a) a person is authorised by the licence to deal with a GMO; and\n(b) a particular condition of the licence applies to the dealing by\nthe person;\nthe person must allow the Regulator, or a person authorised by the\nRegulator, to enter premises where the dealing is being undertaken,\nfor the purposes of auditing or monitoring the dealing.\n(2) Subsection (1) does not limit the conditions that may be imposed\nby the Regulator or prescribed by the regulations.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-64-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-64-ss-2"
        }
      ],
      "cml:integrityHash": "4e23e22c811a8173495100cf8ce28e22bf532203adcd6bd90f78cdc77f6656b6"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-64",
      "@type": "cof:Section",
      "cof:title": "64 Condition about monitoring and audits",
      "values:kind": "section",
      "cof:pageNumber": 61,
      "values:originalText": "(1) It is a condition of a licence that if:\n(a) a person is authorised by the licence to deal with a GMO; and\n(b) a particular condition of the licence applies to the dealing by\nthe person;\nthe person must allow the Regulator, or a person authorised by the\nRegulator, to enter premises where the dealing is being undertaken,\nfor the purposes of auditing or monitoring the dealing.\n(2) Subsection (1) does not limit the conditions that may be imposed\nby the Regulator or prescribed by the regulations."
    },
