      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.107",
      "values:originalText": "(1) The Regulator has the recreation leave entitlements that are\ndetermined by the Remuneration Tribunal.\n(2) The Minister may grant the Regulator leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.",
      "skos:definition": "(1) The Regulator has the recreation leave entitlements that are\ndetermined by the Remuneration Tribunal.\n(2) The Minister may grant the Regulator leave of absence, other than\nrecreation leave, on the terms and conditions as to remuneration or\notherwise that the Minister determines.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-125-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-125-ss-2"
        }
      ],
      "cml:integrityHash": "81aca3b48fe518974bf202bf804b21b1373c429941f0593116e185bc931d6981"
    },
    {
