      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-158-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:logicSummary": "Inspector can enter premises",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "Inspector may enter the premises"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-158-ss-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Inspector must secure thing if found on premises",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "Inspector must secure the thing, if the inspector finds it on the premises"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-158-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Inspector may require person to take steps",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "Inspector may require the person to take such steps as the inspector considers necessary for the person to comply with this Act or the regulations"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-158-ss-2-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Inspector must take steps in relation to thing",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:conclusionText": "Inspector must take such steps, or arrange for such steps to be taken, in relation to the thing as the inspector considers appropriate"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-158-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "158(3) Powers available to inspectors for dealing with dangerous",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-158-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.132",
      "values:originalText": "(3) The inspector may exercise the powers in subsection (2) only to the\nextent that it is necessary for the purpose of avoiding an imminent\nrisk of death, serious illness, serious injury or serious damage to\nthe environment.",
      "skos:definition": "(3) The inspector may exercise the powers in subsection (2) only to the\nextent that it is necessary for the purpose of avoiding an imminent\nrisk of death, serious illness, serious injury or serious damage to\nthe environment.",
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-158"
      },
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-158-ss-3-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-158-ss-3-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f2f343fa68eb1c61a3604a1333655a4d6c9959048338a234843157f4b7414144",
      "skos:note": "Exercise powers only when necessary to avoid imminent risk of death or serious harm."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-158-ss-3",
      "@type": "cof:Section",
      "cof:title": "158(3) Powers available to inspectors for dealing with dangerous",
      "values:kind": "subsection",
      "cof:pageNumber": 132,
      "values:originalText": "(3) The inspector may exercise the powers in subsection (2) only to the\nextent that it is necessary for the purpose of avoiding an imminent\nrisk of death, serious illness, serious injury or serious damage to\nthe environment."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-158-ss-3-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
