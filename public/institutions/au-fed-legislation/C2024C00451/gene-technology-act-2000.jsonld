      "skos:prefLabel": "143(3) What Regulator may do after consideration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-143-ss-3"
      },
      "cml:curationStatus": {
