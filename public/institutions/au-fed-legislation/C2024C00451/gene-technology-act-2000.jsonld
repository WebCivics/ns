      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 Offence relating to notifiable low risk dealings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.40",
      "values:originalText": "(1) A person commits an offence if:\n(a) the person deals with a GMO, knowing that it is a GMO; and\n(b) the dealing is a notifiable low risk dealing; and\n(c) the dealing by the person was not undertaken in accordance\nwith the regulations.\nMaximum penalty: 50 penalty units.\nNote 1:\nNotifiable low risk dealings are specified in the regulations—see",
      "skos:definition": "(1) A person commits an offence if:\n(a) the person deals with a GMO, knowing that it is a GMO; and\n(b) the dealing is a notifiable low risk dealing; and\n(c) the dealing by the person was not undertaken in accordance\nwith the regulations.\nMaximum penalty: 50 penalty units.\nNote 1:\nNotifiable low risk dealings are specified in the regulations—see",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-37-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-37-logic-deontic-1"
        },
        {
