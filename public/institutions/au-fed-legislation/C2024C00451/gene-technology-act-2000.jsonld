    },
    {
      "@id": "concept:gene-technology-act-2000-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Meaning of intentional release of a GMO into the environment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.22",
      "values:originalText": "For the purposes of this Act, a dealing with a GMO involves the\nintentional release of the GMO into the environment if the GMO\n\n\nInterpretation and operation of Act  Part 2\nDefinitions  Division 2\nSection 12\nGene Technology Act 2000\nCompilation date: 14/10/2024\nis intentionally released into the open environment, whether or not\nit is released with provision for limiting the dissemination or\npersistence of the GMO or its genetic material in the environment.",
      "skos:definition": "For the purposes of this Act, a dealing with a GMO involves the\nintentional release of the GMO into the environment if the GMO\n\n\nInterpretation and operation of Act  Part 2\nDefinitions  Division 2\nSection 12\nGene Technology Act 2000\nCompilation date: 14/10/2024\nis intentionally released into the open environment, whether or not\nit is released with provision for limiting the dissemination or\npersistence of the GMO or its genetic material in the environment.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-11-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-11-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f3b129b300f4ea94a6d543d4c47ed5a8206be4549b7c5c77142e403c54e07eab",
      "skos:note": "Intentional release of GMO into environment is a dealing with a GMO."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Meaning of intentional release of a GMO into the environment",
      "values:kind": "section",
      "cof:pageNumber": 22,
      "values:originalText": "For the purposes of this Act, a dealing with a GMO involves the\nintentional release of the GMO into the environment if the GMO\n\n\nInterpretation and operation of Act  Part 2\nDefinitions  Division 2\nSection 12\nGene Technology Act 2000\nCompilation date: 14/10/2024\nis intentionally released into the open environment, whether or not\nit is released with provision for limiting the dissemination or\npersistence of the GMO or its genetic material in the environment."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-11-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
