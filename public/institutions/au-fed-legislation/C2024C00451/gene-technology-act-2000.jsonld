    },
    {
      "@id": "concept:gene-technology-act-2000-sec-98",
      "@type": "cml:Concept",
      "skos:prefLabel": "98 Guidelines",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-98"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.92",
      "values:originalText": "(1) The Regulator may, by written instrument, issue technical or\nprocedural guidelines in relation to requirements that must be met\nin order for an organisation to be accredited under this Division.\n(2) The guidelines may relate to, but are not limited to, matters\nconcerning the establishment and maintenance of Institutional\nBiosafety Committees.\n(3) The Regulator may, by written instrument, vary or revoke the\nguidelines.\n\n\nThe Gene Technology Technical Advisory Committee and the Gene Technology Ethics\nand Community Consultative Committee  Part 8\nSimplified outline  Division 1\nSection 99\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "(1) The Regulator may, by written instrument, issue technical or\nprocedural guidelines in relation to requirements that must be met\nin order for an organisation to be accredited under this Division.\n(2) The guidelines may relate to, but are not limited to, matters\nconcerning the establishment and maintenance of Institutional\nBiosafety Committees.\n(3) The Regulator may, by written instrument, vary or revoke the\nguidelines.\n\n\nThe Gene Technology Technical Advisory Committee and the Gene Technology Ethics\nand Community Consultative Committee  Part 8\nSimplified outline  Division 1\nSection 99\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:hasPart": [
