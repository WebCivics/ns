      "@id": "concept:gene-technology-act-2000-sec-71-ss-2a-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Regulator cannot vary the license.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Section 50A applies to an application that proposes controls and limits on the dissemination, persistence and release of the GMO concerned",
      "cml:conclusionText": "The Regulator must not vary a licence if..."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-71-ss-2a-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Restrict",
      "cml:logicSummary": "Regulator's power to vary the license is restricted.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
