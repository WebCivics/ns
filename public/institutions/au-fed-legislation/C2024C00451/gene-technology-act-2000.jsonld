    },
    {
      "@id": "concept:gene-technology-act-2000-sec-142",
      "@type": "cml:Concept",
      "skos:prefLabel": "142 Regulator may give notice of consideration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-142"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.115",
      "values:originalText": "(1) The Regulator may publish a notice inviting written submissions in\nrelation to any matter that the Regulator may consider under\nsection 140 or 141. The notice must:\n(a) specify the matters to which submissions are to relate; and",
      "skos:definition": "(1) The Regulator may publish a notice inviting written submissions in\nrelation to any matter that the Regulator may consider under\nsection 140 or 141. The notice must:\n(a) specify the matters to which submissions are to relate; and",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-142-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-142-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "caa1bb6f8664c823d2ae98620fbfb59c69b126ecbccfde61388b5714758a4f7e",
      "skos:note": "Regulator must publish notice inviting written submissions on specified matters."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-142",
      "@type": "cof:Section",
      "cof:title": "142 Regulator may give notice of consideration",
      "values:kind": "section",
      "cof:pageNumber": 115,
      "values:originalText": "(1) The Regulator may publish a notice inviting written submissions in\nrelation to any matter that the Regulator may consider under\nsection 140 or 141. The notice must:\n(a) specify the matters to which submissions are to relate; and"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-142-norm",
