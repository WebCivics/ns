    {
      "@id": "concept:gene-technology-act-2000-sec-101",
      "@type": "cml:Concept",
      "skos:prefLabel": "101 Function of the Gene Technology Technical Advisory",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-101"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.95",
      "values:originalText": "Committee\nThe function of the Gene Technology Technical Advisory\nCommittee is to provide scientific and technical advice, on the\nrequest of the Regulator or the Ministerial Council, on the\nfollowing:",
      "skos:definition": "Committee\nThe function of the Gene Technology Technical Advisory\nCommittee is to provide scientific and technical advice, on the\nrequest of the Regulator or the Ministerial Council, on the\nfollowing:",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-101-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-101-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0015c781f40af5750a700a44107f65c3e1c3b437a36f542a5dc8b5df34871d1b",
      "skos:note": "Provide scientific and technical advice on request."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-101",
      "@type": "cof:Section",
      "cof:title": "101 Function of the Gene Technology Technical Advisory",
      "values:kind": "section",
      "cof:pageNumber": 95,
      "values:originalText": "Committee\nThe function of the Gene Technology Technical Advisory\nCommittee is to provide scientific and technical advice, on the\nrequest of the Regulator or the Ministerial Council, on the\nfollowing:"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-101-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-101"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-101-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Obligation to provide advice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-102",
      "@type": "cml:Concept",
      "skos:prefLabel": "102 Expert advisers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-102"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.96",
      "values:originalText": "(1) The Minister may appoint one or more persons (expert advisers) to\ngive expert advice to the Gene Technology Technical Advisory\nCommittee to assist it in the performance of its functions. Expert\nadvisers may be appointed on a continuing or an ad hoc basis.\n(2) For the avoidance of doubt, expert advisers are not Committee\nmembers.",
      "skos:definition": "(1) The Minister may appoint one or more persons (expert advisers) to\ngive expert advice to the Gene Technology Technical Advisory\nCommittee to assist it in the performance of its functions. Expert\nadvisers may be appointed on a continuing or an ad hoc basis.\n(2) For the avoidance of doubt, expert advisers are not Committee\nmembers.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-102-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-102-ss-2"
        }
      ],
      "cml:integrityHash": "92261d4eea015bd93bfffdf4714a80507f1837dca7330f5bcd02cd323ae707a9"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-102",
      "@type": "cof:Section",
      "cof:title": "102 Expert advisers",
      "values:kind": "section",
      "cof:pageNumber": 96,
      "values:originalText": "(1) The Minister may appoint one or more persons (expert advisers) to\ngive expert advice to the Gene Technology Technical Advisory\nCommittee to assist it in the performance of its functions. Expert\nadvisers may be appointed on a continuing or an ad hoc basis.\n(2) For the avoidance of doubt, expert advisers are not Committee\nmembers."
    },
