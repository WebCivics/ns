    },
    {
      "@id": "concept:gene-technology-act-2000-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Ministerial Council may issue policy guidelines",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-23"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.30",
      "values:originalText": "The Ministerial Council may issue policy guidelines in relation to\nmatters relevant to the functions of the Regulator.\nNote 1:\nSection 56 requires the Regulator to have regard to policy guidelines\nwhen deciding an application for a GMO licence. Section 30 provides\nthat the Regulator is not subject to direction in relation to individual\ndecisions.\nNote 2:\nSubsection 33(3) of the Acts Interpretation Act 1901 confers power to\nrevoke or amend an instrument issued under an Act.",
      "skos:definition": "The Ministerial Council may issue policy guidelines in relation to\nmatters relevant to the functions of the Regulator.\nNote 1:\nSection 56 requires the Regulator to have regard to policy guidelines\nwhen deciding an application for a GMO licence. Section 30 provides\nthat the Regulator is not subject to direction in relation to individual\ndecisions.\nNote 2:\nSubsection 33(3) of the Acts Interpretation Act 1901 confers power to\nrevoke or amend an instrument issued under an Act.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-23-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-23-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "b5dac20a8a69ddfc025bffb7e8ecdb9e84c3538370ee319c17edea76e8bfc062",
      "skos:note": "Ministerial Council may issue policy guidelines."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-23",
      "@type": "cof:Section",
      "cof:title": "23 Ministerial Council may issue policy guidelines",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "The Ministerial Council may issue policy guidelines in relation to\nmatters relevant to the functions of the Regulator.\nNote 1:\nSection 56 requires the Regulator to have regard to policy guidelines\nwhen deciding an application for a GMO licence. Section 30 provides\nthat the Regulator is not subject to direction in relation to individual\ndecisions.\nNote 2:\nSubsection 33(3) of the Acts Interpretation Act 1901 confers power to\nrevoke or amend an instrument issued under an Act."
    },
    {
