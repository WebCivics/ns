    {
      "@id": "concept:gene-technology-act-2000-sec-29-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "29(2) Delegation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-29-ss-2"
      },
      "cml:curationStatus": {
