    {
      "@id": "concept:gene-technology-act-2000-sec-88",
      "@type": "cml:Concept",
      "skos:prefLabel": "88 Suspension or cancellation of certification",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-88"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.86",
      "values:originalText": "The Regulator may, by notice in writing, suspend or cancel the\ncertification of a facility if the Regulator believes on reasonable\ngrounds that a condition of the certification has been breached.",
      "skos:definition": "The Regulator may, by notice in writing, suspend or cancel the\ncertification of a facility if the Regulator believes on reasonable\ngrounds that a condition of the certification has been breached.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-88-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-88-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "9c812e3408b6f28ee4a104daf9e10ee1be76ec36a841744dd39b1cddd8275d5c",
      "skos:note": "Suspension or cancellation of certification upon reasonable grounds"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-88",
      "@type": "cof:Section",
      "cof:title": "88 Suspension or cancellation of certification",
      "values:kind": "section",
      "cof:pageNumber": 86,
      "values:originalText": "The Regulator may, by notice in writing, suspend or cancel the\ncertification of a facility if the Regulator believes on reasonable\ngrounds that a condition of the certification has been breached."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-88-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
