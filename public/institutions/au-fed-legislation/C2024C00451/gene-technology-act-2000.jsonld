    {
      "@id": "concept:gene-technology-act-2000-sec-127",
      "@type": "cml:Concept",
      "skos:prefLabel": "127 Regulator may charge for services",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-127"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.108",
      "values:originalText": "The Regulator may charge for services provided by, or on behalf\nof, the Regulator in the performance of the Regulator’s functions.",
      "skos:definition": "The Regulator may charge for services provided by, or on behalf\nof, the Regulator in the performance of the Regulator’s functions.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-127-norm"
        }
      ],
      "cml:integrityHash": "c55088da7f0fd735a80323351c0e4e41d8bdad71123c8ccb58cf1e41d3363fb6",
      "skos:note": "Regulator may charge for services provided by or on behalf of the Regulator."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-127",
      "@type": "cof:Section",
      "cof:title": "127 Regulator may charge for services",
      "values:kind": "section",
      "cof:pageNumber": 108,
      "values:originalText": "The Regulator may charge for services provided by, or on behalf\nof, the Regulator in the performance of the Regulator’s functions."
    },
