    {
      "@id": "concept:gene-technology-act-2000-sec-133",
      "@type": "cml:Concept",
      "skos:prefLabel": "133 Staff assisting the Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-133"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.111",
      "values:originalText": "The staff assisting the Regulator are to be persons engaged under\nthe Public Service Act 1999 and made available for the purpose by\nthe Secretary of the Department.",
      "skos:definition": "The staff assisting the Regulator are to be persons engaged under\nthe Public Service Act 1999 and made available for the purpose by\nthe Secretary of the Department.",
