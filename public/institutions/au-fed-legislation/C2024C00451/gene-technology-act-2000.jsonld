    {
      "@id": "concept:gene-technology-act-2000-sec-187",
      "@type": "cml:Concept",
      "skos:prefLabel": "187 Confidential commercial information must not be disclosed",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-187"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.153",
      "values:originalText": "(1) A person who:\n(a) has confidential commercial information; and\n(b) has it only because of performing duties or functions under\nthis Act or under a corresponding State law; and\n(c) knows that the information is confidential commercial\ninformation;\nmust not disclose the information except:\n(d) to any of the following in the course of carrying out duties or\nfunctions under this Act or under a corresponding State law:\n(i) the Commonwealth or a Commonwealth authority;\n(ii) a State agency;",
      "skos:definition": "(1) A person who:\n(a) has confidential commercial information; and\n(b) has it only because of performing duties or functions under\nthis Act or under a corresponding State law; and\n(c) knows that the information is confidential commercial\ninformation;\nmust not disclose the information except:\n(d) to any of the following in the course of carrying out duties or\nfunctions under this Act or under a corresponding State law:\n(i) the Commonwealth or a Commonwealth authority;\n(ii) a State agency;",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-187-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-187-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-187-logic-alleninterval-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-187-logic-diffusion-3"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-187-logic-cogai-4"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-187-logic-shacl-5"
        }
      ],
      "cml:integrityHash": "977a8f13281dba95b9a645ed2e2b1d1caa9a6530c0bb31d1cc1adfe6fc8d3549",
      "skos:note": "Disclosing confidential commercial information is prohibited for certain individuals and entities."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-187",
      "@type": "cof:Section",
      "cof:title": "187 Confidential commercial information must not be disclosed",
      "values:kind": "section",
      "cof:pageNumber": 153,
      "values:originalText": "(1) A person who:\n(a) has confidential commercial information; and\n(b) has it only because of performing duties or functions under\nthis Act or under a corresponding State law; and\n(c) knows that the information is confidential commercial\ninformation;\nmust not disclose the information except:\n(d) to any of the following in the course of carrying out duties or\nfunctions under this Act or under a corresponding State law:\n(i) the Commonwealth or a Commonwealth authority;\n(ii) a State agency;"
    },
    {
