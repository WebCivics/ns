    },
    {
      "@id": "concept:gene-technology-act-2000-sec-141",
      "@type": "cml:Concept",
      "skos:prefLabel": "141 Regulator may review exemptions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-141"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.115",
      "values:originalText": "The Regulator may, at any time, in accordance with this Division,\nconsider the following matters:\n(a) whether a dealing that is an exempt dealing within the\nmeaning of subsection 32(3) should not be an exempt\ndealing;\n(b) whether a dealing should be an exempt dealing within the\nmeaning of that subsection.",
      "skos:definition": "The Regulator may, at any time, in accordance with this Division,\nconsider the following matters:\n(a) whether a dealing that is an exempt dealing within the\nmeaning of subsection 32(3) should not be an exempt\ndealing;\n(b) whether a dealing should be an exempt dealing within the\nmeaning of that subsection.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-141-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-141-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "7c9cde19e3366a514aafdf65bf4b87e177b845d0b7496fe2f428d140e38269cc",
      "skos:note": "Regulator may review exemptions"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-141",
      "@type": "cof:Section",
      "cof:title": "141 Regulator may review exemptions",
      "values:kind": "section",
      "cof:pageNumber": 115,
      "values:originalText": "The Regulator may, at any time, in accordance with this Division,\nconsider the following matters:\n(a) whether a dealing that is an exempt dealing within the\nmeaning of subsection 32(3) should not be an exempt\ndealing;\n(b) whether a dealing should be an exempt dealing within the\nmeaning of that subsection."
    },
    {
