    {
      "@id": "concept:gene-technology-act-2000-sec-180",
      "@type": "cml:Concept",
      "skos:prefLabel": "180 Notification of decisions and review rights",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-180"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.148",
      "values:originalText": "(1) The Regulator must, as soon as practicable after making a\nreviewable decision, cause a notice in writing to be given to each\neligible person in relation to the decision, containing:\n(a) the terms of the decision; and\n(b) the reasons for the decision; and\n(c) a statement setting out particulars of the person’s review\nrights.\n\n\nMiscellaneous  Part 12\nReview of decisions  Division 2\nSection 181\nGene Technology Act 2000\nCompilation date: 14/10/2024\n(2) A failure to comply with the requirements of subsection (1) in\nrelation to a decision does not affect the validity of the decision.",
      "skos:definition": "(1) The Regulator must, as soon as practicable after making a\nreviewable decision, cause a notice in writing to be given to each\neligible person in relation to the decision, containing:\n(a) the terms of the decision; and\n(b) the reasons for the decision; and\n(c) a statement setting out particulars of the person’s review\nrights.\n\n\nMiscellaneous  Part 12\nReview of decisions  Division 2\nSection 181\nGene Technology Act 2000\nCompilation date: 14/10/2024\n(2) A failure to comply with the requirements of subsection (1) in\nrelation to a decision does not affect the validity of the decision.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-180-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-180-ss-2"
        }
      ],
      "cml:integrityHash": "399acebd9a3af4594a3b83cc99475e71003a7cf6510d94b96f13945b65a216ec"
    },
