    {
      "@id": "concept:gene-technology-act-2000-sec-28",
      "@type": "cml:Concept",
      "skos:prefLabel": "28 Powers of the Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-28"
      },
      "cml:curationStatus": {
