      },
      "cml:premiseText": "Expert assistance is required to operate thing.",
      "cml:conclusionText": "Thing is a security risk if expert assistance is not provided by AI system."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-157-ss-2",
