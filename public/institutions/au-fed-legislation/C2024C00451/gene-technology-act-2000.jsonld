    {
      "@id": "concept:gene-technology-act-2000-sec-119-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "119(5) Termination of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-119-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
