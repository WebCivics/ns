    {
      "@id": "concept:gene-technology-act-2000-sec-60",
      "@type": "cml:Concept",
      "skos:prefLabel": "60 Period of licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-60"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.58",
      "values:originalText": "(1) A licence continues in force:\n(a) if the licence is expressed to be in force for a particular\nperiod—until the end of that period; or\n(b) otherwise—until it is cancelled or surrendered.\n(2) A licence is not in force throughout any period of suspension.\n(3) A licence issued as a result of an inadvertent dealings application\nmust not be expressed to be in force for a period of longer than\n12 months.\n\n\nLicensing system  Part 5\nConditions of licences  Division 6\nSection 61\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "(1) A licence continues in force:\n(a) if the licence is expressed to be in force for a particular\nperiod—until the end of that period; or\n(b) otherwise—until it is cancelled or surrendered.\n(2) A licence is not in force throughout any period of suspension.\n(3) A licence issued as a result of an inadvertent dealings application\nmust not be expressed to be in force for a period of longer than\n12 months.\n\n\nLicensing system  Part 5\nConditions of licences  Division 6\nSection 61\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-60-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-60-ss-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-60-ss-3"
        }
      ],
      "cml:integrityHash": "d036e7a17c362f2c4536f8848edad5a96b1cf3620bcfb66a69173102d49302d6"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-60",
      "@type": "cof:Section",
      "cof:title": "60 Period of licence",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "(1) A licence continues in force:\n(a) if the licence is expressed to be in force for a particular\nperiod—until the end of that period; or\n(b) otherwise—until it is cancelled or surrendered.\n(2) A licence is not in force throughout any period of suspension.\n(3) A licence issued as a result of an inadvertent dealings application\nmust not be expressed to be in force for a period of longer than\n12 months.\n\n\nLicensing system  Part 5\nConditions of licences  Division 6\nSection 61\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
