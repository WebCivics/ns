      "skos:note": "No obligation to review matters under sections 140 or 141."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-144",
      "@type": "cof:Section",
      "cof:title": "144 Regulator not required to review matters",
      "values:kind": "section",
