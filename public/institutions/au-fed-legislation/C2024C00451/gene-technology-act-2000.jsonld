    {
      "@id": "concept:gene-technology-act-2000-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.13",
      "values:originalText": "(1) Sections 1 and 2 of this Act commence on the day on which this\nAct receives the Royal Assent.\n(2) Subject to subsection (3), the other provisions of this Act\ncommence on a day or days to be fixed by Proclamation.\n(3) If a provision of this Act does not commence under subsection (2)\nwithin 6 months after the day on which this Act receives the Royal\nAssent, it commences on the first day after the end of that period.",
      "skos:definition": "(1) Sections 1 and 2 of this Act commence on the day on which this\nAct receives the Royal Assent.\n(2) Subject to subsection (3), the other provisions of this Act\ncommence on a day or days to be fixed by Proclamation.\n(3) If a provision of this Act does not commence under subsection (2)\nwithin 6 months after the day on which this Act receives the Royal\nAssent, it commences on the first day after the end of that period.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-2-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-2-ss-2"
