    {
      "@id": "concept:gene-technology-act-2000-sec-50a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "50A(2) Limited and controlled release applications",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-50a-ss-2"
      },
      "cml:curationStatus": {
