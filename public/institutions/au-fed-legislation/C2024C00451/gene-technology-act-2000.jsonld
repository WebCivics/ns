        }
      ],
      "cml:integrityHash": "a4adbfb8101bff61725195b0ba755fd4fbccf0b292b8343ecc85459333f706ad",
      "skos:note": "Retirement of Regulator on grounds of physical or mental incapacity with Regulator's consent."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-119-ss-4",
      "@type": "cof:Section",
      "cof:title": "119(4) Termination of appointment",
      "values:kind": "subsection",
      "cof:pageNumber": 104,
      "values:originalText": "(4) If the Regulator is:\n(a) an eligible employee for the purposes of the Superannuation\nAct 1976; or\n(b) a member of the superannuation scheme established by deed\nunder the Superannuation Act 1990; or\n(c) an ordinary employer-sponsored member of PSSAP, within\nthe meaning of the Superannuation Act 2005;\nthe Governor-General may, with the consent of the Regulator,\nretire the Regulator from office on the grounds of physical or\nmental incapacity."
    },
