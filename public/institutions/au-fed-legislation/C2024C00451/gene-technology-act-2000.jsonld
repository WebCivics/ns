    {
      "@id": "concept:gene-technology-act-2000-sec-177",
      "@type": "cml:Concept",
      "skos:prefLabel": "177 Part does not limit power to impose conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-177"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.145",
      "values:originalText": "This Part is not to be taken to limit the Regulator’s power to\nimpose licence conditions or the Minister’s power to impose\nconditions on an emergency dealing determination.",
      "skos:definition": "This Part is not to be taken to limit the Regulator’s power to\nimpose licence conditions or the Minister’s power to impose\nconditions on an emergency dealing determination.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-177-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-177-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-177-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "ad9eaecf525c2a694850953cfa017cf7a5af5903979fe0df18b5a67ad10cb06e",
      "skos:note": "Regulator and Minister have power to impose conditions."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-177",
      "@type": "cof:Section",
      "cof:title": "177 Part does not limit power to impose conditions",
      "values:kind": "section",
      "cof:pageNumber": 145,
      "values:originalText": "This Part is not to be taken to limit the Regulator’s power to\nimpose licence conditions or the Minister’s power to impose\nconditions on an emergency dealing determination."
    },
