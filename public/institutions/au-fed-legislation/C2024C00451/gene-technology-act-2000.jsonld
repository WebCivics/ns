    {
      "@id": "concept:gene-technology-act-2000-sec-96",
      "@type": "cml:Concept",
      "skos:prefLabel": "96 Suspension or cancellation of accreditation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-96"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.91",
      "values:originalText": "The Regulator may, by notice in writing, suspend or cancel the\naccreditation of an organisation if the Regulator believes on\nreasonable grounds that a condition of the accreditation has been\nbreached.",
      "skos:definition": "The Regulator may, by notice in writing, suspend or cancel the\naccreditation of an organisation if the Regulator believes on\nreasonable grounds that a condition of the accreditation has been\nbreached.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-96-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-96-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-96-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "e9ce19cb4613d54964fa613ae798c67add2b68b6168b9128b685074029cfe0f8",
      "skos:note": "Suspension or cancellation of accreditation"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-96",
      "@type": "cof:Section",
      "cof:title": "96 Suspension or cancellation of accreditation",
      "values:kind": "section",
      "cof:pageNumber": 91,
      "values:originalText": "The Regulator may, by notice in writing, suspend or cancel the\naccreditation of an organisation if the Regulator believes on\nreasonable grounds that a condition of the accreditation has been\nbreached."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-96-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
