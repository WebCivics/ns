      "@type": "cml:Concept",
      "skos:prefLabel": "47(2) What the Regulator must do in relation to application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-47-ss-2"
      },
