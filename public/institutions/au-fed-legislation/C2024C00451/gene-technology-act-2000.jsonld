    {
      "@id": "concept:gene-technology-act-2000-sec-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "4 Regulatory framework to achieve object",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.13",
      "values:originalText": "The object of this Act is to be achieved through a regulatory\nframework which:\n(aa) provides that where there are threats of serious or irreversible\nenvironmental damage, a lack of full scientific certainty\nshould not be used as a reason for postponing cost-effective\nmeasures to prevent environmental degradation; and",
      "skos:definition": "The object of this Act is to be achieved through a regulatory\nframework which:\n(aa) provides that where there are threats of serious or irreversible\nenvironmental damage, a lack of full scientific certainty\nshould not be used as a reason for postponing cost-effective\nmeasures to prevent environmental degradation; and",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-4-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-4-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "45fd4341bc7451997f6f6581e5701ef50e94e70711d998d30a4ae88486767f78",
      "skos:note": "Regulatory framework must prevent environmental degradation despite lack of full scientific certainty."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-4",
      "@type": "cof:Section",
      "cof:title": "4 Regulatory framework to achieve object",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "The object of this Act is to be achieved through a regulatory\nframework which:\n(aa) provides that where there are threats of serious or irreversible\nenvironmental damage, a lack of full scientific certainty\nshould not be used as a reason for postponing cost-effective\nmeasures to prevent environmental degradation; and"
    },
    {
