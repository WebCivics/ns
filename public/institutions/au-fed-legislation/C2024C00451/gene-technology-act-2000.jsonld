      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Imposes an obligation on the State.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a corresponding State law is in force in the notifying State at that time;",
      "cml:conclusionText": "The wind-back notice must be in force."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Specifies the temporal relationship between the wind-back notice and the corresponding State law.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a corresponding State law is in force in the notifying State at that time;",
      "cml:conclusionText": "The wind-back notice must overlap with the corresponding State law."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Describes the temporal relationship between the wind-back notice and its effect.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) a wind-back notice in relation to that State is in force at that time;",
      "cml:conclusionText": "The wind-back notice must be until the corresponding State law is no longer in force."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuses",
      "cml:logicSummary": "Describes how the obligation is propagated.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) a corresponding State law is in force in the notifying State at that time;",
      "cml:conclusionText": "The wind-back notice must diffuse to other States."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-2-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "Infer",
      "cml:logicSummary": "Describes how the obligation can be inferred.",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) a wind-back notice in relation to that State is in force at that time;",
      "cml:conclusionText": "The wind-back notice must infer the corresponding State law."
    },
    {
