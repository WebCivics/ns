      ],
      "cml:integrityHash": "0c89ff9474e9ee518165952d7def6b5d6cee72137b4a533de682cf1898e53858",
      "skos:note": "The Regulator has power to do all things necessary or convenient for the performance of its functions."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-28",
      "@type": "cof:Section",
