      "cml:operator": ">=",
      "cml:logicSummary": "Regulator's decision must be made after considering submissions.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Decision to suspend, cancel or vary accreditation should occur after submission has been considered.",
      "cml:conclusionText": "Submission is a prerequisite for the Regulator's decision."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-97-ss-4-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<=",
      "cml:logicSummary": "Regulator must consider submissions before making a decision.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Decision to suspend, cancel or vary accreditation should occur after submission has been considered.",
      "cml:conclusionText": "Submission is necessary for the Regulator's decision."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-97-ss-4-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:logicSummary": "Regulator must consider submissions from all relevant parties.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
