    {
      "@id": "concept:gene-technology-act-2000-sec-16-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "16(2) State laws may operate concurrently",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-16-ss-2"
      },
      "cml:curationStatus": {
