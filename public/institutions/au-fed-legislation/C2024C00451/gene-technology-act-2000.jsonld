    {
      "@id": "concept:gene-technology-act-2000-sec-178",
      "@type": "cml:Concept",
      "skos:prefLabel": "178 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-178"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.146",
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides for miscellaneous matters, including the\nfollowing:\n(a)\nreview of decisions;\n(b)\nprovisions relating to confidential commercial\ninformation;\n(c)\nthe making of regulations;\n(d)\ntransitional provisions;\n(e)\nreview of the operation of the Act.\n\n\nMiscellaneous  Part 12\nReview of decisions  Division 2\nSection 179\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "The following is a simplified outline of this Part:\nThis Part provides for miscellaneous matters, including the\nfollowing:\n(a)\nreview of decisions;\n(b)\nprovisions relating to confidential commercial\ninformation;\n(c)\nthe making of regulations;\n(d)\ntransitional provisions;\n(e)\nreview of the operation of the Act.\n\n\nMiscellaneous  Part 12\nReview of decisions  Division 2\nSection 179\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-178-norm"
        }
      ],
      "cml:integrityHash": "0191dace1f995d64f1df561ca81bfb83aae1b9a4b99e51f47bb4b687b18e3502",
      "skos:note": "Simplified outline of this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-178",
      "@type": "cof:Section",
      "cof:title": "178 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 146,
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides for miscellaneous matters, including the\nfollowing:\n(a)\nreview of decisions;\n(b)\nprovisions relating to confidential commercial\ninformation;\n(c)\nthe making of regulations;\n(d)\ntransitional provisions;\n(e)\nreview of the operation of the Act.\n\n\nMiscellaneous  Part 12\nReview of decisions  Division 2\nSection 179\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
