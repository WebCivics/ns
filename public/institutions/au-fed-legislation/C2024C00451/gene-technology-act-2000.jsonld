    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-60-ss-3",
      "@type": "cof:Section",
      "cof:title": "60(3) Period of licence",
      "values:kind": "subsection",
      "cof:pageNumber": 58,
      "values:originalText": "(3) A licence issued as a result of an inadvertent dealings application\nmust not be expressed to be in force for a period of longer than\n12 months.\n\n\nLicensing system  Part 5\nConditions of licences  Division 6\nSection 61\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-60-ss-3-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-60-ss-3"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-60-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits licence period exceeding 12 months",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Licence is subject to conditions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-61"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.59",
      "values:originalText": "A GMO licence is subject to the following conditions:\n(a) the conditions set out in sections 63, 64 and 65;\n(b) any conditions prescribed by the regulations;\n(c) any conditions imposed by the Regulator at the time of\nissuing the licence;\n(d) any conditions imposed by the Regulator under section 71\nafter the licence is issued.",
      "skos:definition": "A GMO licence is subject to the following conditions:\n(a) the conditions set out in sections 63, 64 and 65;\n(b) any conditions prescribed by the regulations;\n(c) any conditions imposed by the Regulator at the time of\nissuing the licence;\n(d) any conditions imposed by the Regulator under section 71\nafter the licence is issued.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-61-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-61-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "07e7f4b94bf024fd247d302abe5e65573829aa07740454c10ae957a108884491",
      "skos:note": "GMO licence is subject to conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-61",
      "@type": "cof:Section",
      "cof:title": "61 Licence is subject to conditions",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "A GMO licence is subject to the following conditions:\n(a) the conditions set out in sections 63, 64 and 65;\n(b) any conditions prescribed by the regulations;\n(c) any conditions imposed by the Regulator at the time of\nissuing the licence;\n(d) any conditions imposed by the Regulator under section 71\nafter the licence is issued."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-61-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-61"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
