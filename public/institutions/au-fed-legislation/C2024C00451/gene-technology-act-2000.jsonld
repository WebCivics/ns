    {
      "@id": "concept:gene-technology-act-2000-sec-87",
      "@type": "cml:Concept",
      "skos:prefLabel": "87 Variation of certification",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-87"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.86",
      "values:originalText": "(1) The Regulator may, at any time, by notice in writing given to the\nholder of the certification, vary the certification of a facility.\n(2) Without limiting subsection (1), the Regulator may:\n(a) impose additional conditions; or\n(b) remove or vary conditions that were imposed by the\nRegulator.",
      "skos:definition": "(1) The Regulator may, at any time, by notice in writing given to the\nholder of the certification, vary the certification of a facility.\n(2) Without limiting subsection (1), the Regulator may:\n(a) impose additional conditions; or\n(b) remove or vary conditions that were imposed by the\nRegulator.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-87-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-87-ss-2"
        }
