    {
      "@id": "concept:gene-technology-act-2000-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Application may be withdrawn",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
