        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.93",
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides for the establishment of the Gene Technology\nTechnical Advisory Committee and the Gene Technology Ethics\nand Community Consultative Committee.\nThe Part sets out the membership of these bodies, and their\nfunctions.",
      "skos:definition": "The following is a simplified outline of this Part:\nThis Part provides for the establishment of the Gene Technology\nTechnical Advisory Committee and the Gene Technology Ethics\nand Community Consultative Committee.\nThe Part sets out the membership of these bodies, and their\nfunctions.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-99-norm"
        }
      ],
      "cml:integrityHash": "74ce11623254e8c8e586cb0aad3d57b0af08f770a4281441f5c2f830cc827ceb",
      "skos:note": "Establishment of Gene Technology Technical Advisory Committee and Gene Technology Ethics and Community Consultative Committee."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-99",
      "@type": "cof:Section",
      "cof:title": "99 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 93,
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides for the establishment of the Gene Technology\nTechnical Advisory Committee and the Gene Technology Ethics\nand Community Consultative Committee.\nThe Part sets out the membership of these bodies, and their\nfunctions."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-99-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
