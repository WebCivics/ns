      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-31",
      "@type": "cml:Concept",
      "skos:prefLabel": "31 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-31"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.34",
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part deals with the regulation of dealings with GMOs.\nThis Part prohibits dealings with GMOs unless:\n(a)\nthe person undertaking the dealing is authorised to\ndo so by a GMO licence; or\n(aa)\nthe dealing is specified in an emergency dealing\ndetermination; or\n(b)\nthe dealing is a notifiable low risk dealing (see\nDivision 2 of Part 6); or\n(c)\nthe dealing is an exempt dealing; or\n(d)\nthe dealing is included in the GMO Register (see\nDivision 3 of Part 6).\nThis Part imposes heavier penalties on unlawful dealings that\ncause, or are likely to cause, significant damage to the health and\nsafety of people or to the environment.\n\n\nRegulation of dealings with GMOs  Part 4\nDealings with GMOs must be licensed  Division 2\nSection 32\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "The following is a simplified outline of this Part:\nThis Part deals with the regulation of dealings with GMOs.\nThis Part prohibits dealings with GMOs unless:\n(a)\nthe person undertaking the dealing is authorised to\ndo so by a GMO licence; or\n(aa)\nthe dealing is specified in an emergency dealing\ndetermination; or\n(b)\nthe dealing is a notifiable low risk dealing (see\nDivision 2 of Part 6); or\n(c)\nthe dealing is an exempt dealing; or\n(d)\nthe dealing is included in the GMO Register (see\nDivision 3 of Part 6).\nThis Part imposes heavier penalties on unlawful dealings that\ncause, or are likely to cause, significant damage to the health and\nsafety of people or to the environment.\n\n\nRegulation of dealings with GMOs  Part 4\nDealings with GMOs must be licensed  Division 2\nSection 32\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-31-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-31-logic-alleninterval-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-31-logic-ltl-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-31-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "de67aaf4fcaeed8c910eccb87b84182c79026bb67734e13924cd0b7f80595cef",
      "skos:note": "Dealing with GMOs unless authorized or exempt."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-31",
      "@type": "cof:Section",
      "cof:title": "31 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 34,
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part deals with the regulation of dealings with GMOs.\nThis Part prohibits dealings with GMOs unless:\n(a)\nthe person undertaking the dealing is authorised to\ndo so by a GMO licence; or\n(aa)\nthe dealing is specified in an emergency dealing\ndetermination; or\n(b)\nthe dealing is a notifiable low risk dealing (see\nDivision 2 of Part 6); or\n(c)\nthe dealing is an exempt dealing; or\n(d)\nthe dealing is included in the GMO Register (see\nDivision 3 of Part 6).\nThis Part imposes heavier penalties on unlawful dealings that\ncause, or are likely to cause, significant damage to the health and\nsafety of people or to the environment.\n\n\nRegulation of dealings with GMOs  Part 4\nDealings with GMOs must be licensed  Division 2\nSection 32\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-31-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-31"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-31-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "<>",
      "cml:logicSummary": "Defines permitted dealing types",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the person undertaking the dealing is authorised to do so by a GMO licence;",
      "cml:conclusionText": "Dealing with GMOs unless authorized or exempt."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-31-logic-ltl-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "<>",
      "cml:logicSummary": "Defines notifiable low risk dealings",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the dealing is a notifiable low risk dealing (see Division 2 of Part 6);",
      "cml:conclusionText": "Dealing with GMOs unless authorized or exempt."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-31-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Classifies dealings with GMOs as prohibited",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "This Part prohibits dealings with GMOs unless...",
      "cml:conclusionText": "Dealing with GMOs is prohibited"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Person not to deal with a GMO without a licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.35",
      "values:originalText": "(1) A person commits an offence if:\n(a) the person deals with a GMO, knowing that it is a GMO; and\n(b) the dealing with the GMO by the person is not authorised by\na GMO licence, and the person knows or is reckless as to that\nfact; and\n(c) the dealing with the GMO is not specified in an emergency\ndealing determination, and the person knows or is reckless as\nto that fact; and\n(d) the dealing is not a notifiable low risk dealing, and the person\nknows or is reckless as to that fact; and\n(e) the dealing is not an exempt dealing, and the person knows or\nis reckless as to that fact; and\n(f) the dealing is not included on the GMO Register, and the\nperson knows or is reckless as to that fact.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n(2) An offence under subsection (1) is punishable on conviction by\nwhichever of the following applies:\n(a) in the case of an aggravated offence— imprisonment for\n5 years or 2,000 penalty units;\n(b) in any other case— imprisonment for 2 years or 500 penalty\nunits.\nNote:\nSection 38 defines aggravated offence.\n(3) In this section:\nexempt dealing means a dealing specified by the regulations to be\nan exempt dealing.\n(4) Regulations under subsection (3) may be expressed to exempt:",
      "skos:definition": "(1) A person commits an offence if:\n(a) the person deals with a GMO, knowing that it is a GMO; and\n(b) the dealing with the GMO by the person is not authorised by\na GMO licence, and the person knows or is reckless as to that\nfact; and\n(c) the dealing with the GMO is not specified in an emergency\ndealing determination, and the person knows or is reckless as\nto that fact; and\n(d) the dealing is not a notifiable low risk dealing, and the person\nknows or is reckless as to that fact; and\n(e) the dealing is not an exempt dealing, and the person knows or\nis reckless as to that fact; and\n(f) the dealing is not included on the GMO Register, and the\nperson knows or is reckless as to that fact.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n(2) An offence under subsection (1) is punishable on conviction by\nwhichever of the following applies:\n(a) in the case of an aggravated offence— imprisonment for\n5 years or 2,000 penalty units;\n(b) in any other case— imprisonment for 2 years or 500 penalty\nunits.\nNote:\nSection 38 defines aggravated offence.\n(3) In this section:\nexempt dealing means a dealing specified by the regulations to be\nan exempt dealing.\n(4) Regulations under subsection (3) may be expressed to exempt:",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-32-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-32-ss-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-32-ss-3"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-32-ss-4"
        }
      ],
      "cml:integrityHash": "c50076ffe81bc3c697f8b7050d1ca73cb64fb58a77bc2cdeb03318a239a70bee"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Person not to deal with a GMO without a licence",
      "values:kind": "section",
      "cof:pageNumber": 35,
      "values:originalText": "(1) A person commits an offence if:\n(a) the person deals with a GMO, knowing that it is a GMO; and\n(b) the dealing with the GMO by the person is not authorised by\na GMO licence, and the person knows or is reckless as to that\nfact; and\n(c) the dealing with the GMO is not specified in an emergency\ndealing determination, and the person knows or is reckless as\nto that fact; and\n(d) the dealing is not a notifiable low risk dealing, and the person\nknows or is reckless as to that fact; and\n(e) the dealing is not an exempt dealing, and the person knows or\nis reckless as to that fact; and\n(f) the dealing is not included on the GMO Register, and the\nperson knows or is reckless as to that fact.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n(2) An offence under subsection (1) is punishable on conviction by\nwhichever of the following applies:\n(a) in the case of an aggravated offence— imprisonment for\n5 years or 2,000 penalty units;\n(b) in any other case— imprisonment for 2 years or 500 penalty\nunits.\nNote:\nSection 38 defines aggravated offence.\n(3) In this section:\nexempt dealing means a dealing specified by the regulations to be\nan exempt dealing.\n(4) Regulations under subsection (3) may be expressed to exempt:"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-32-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "32(1) Person not to deal with a GMO without a licence",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-32-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.35",
      "values:originalText": "(1) A person commits an offence if:\n(a) the person deals with a GMO, knowing that it is a GMO; and\n(b) the dealing with the GMO by the person is not authorised by\na GMO licence, and the person knows or is reckless as to that\nfact; and\n(c) the dealing with the GMO is not specified in an emergency\ndealing determination, and the person knows or is reckless as\nto that fact; and\n(d) the dealing is not a notifiable low risk dealing, and the person\nknows or is reckless as to that fact; and\n(e) the dealing is not an exempt dealing, and the person knows or\nis reckless as to that fact; and\n(f) the dealing is not included on the GMO Register, and the\nperson knows or is reckless as to that fact.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.",
      "skos:definition": "(1) A person commits an offence if:\n(a) the person deals with a GMO, knowing that it is a GMO; and\n(b) the dealing with the GMO by the person is not authorised by\na GMO licence, and the person knows or is reckless as to that\nfact; and\n(c) the dealing with the GMO is not specified in an emergency\ndealing determination, and the person knows or is reckless as\nto that fact; and\n(d) the dealing is not a notifiable low risk dealing, and the person\nknows or is reckless as to that fact; and\n(e) the dealing is not an exempt dealing, and the person knows or\nis reckless as to that fact; and\n(f) the dealing is not included on the GMO Register, and the\nperson knows or is reckless as to that fact.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.",
