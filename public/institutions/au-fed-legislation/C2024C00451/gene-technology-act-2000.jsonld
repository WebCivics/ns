        }
      ],
      "cml:integrityHash": "445f8350c39b93c69d397c941b2ec97d9c7e507e02fb30b4f9b2ac2d7f299f8a",
      "skos:note": "Eligible person may apply for review of Regulator's decisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-183-ss-1",
      "@type": "cof:Section",
      "cof:title": "183(1) Review of decisions by Administrative Review Tribunal",
      "values:kind": "subsection",
      "cof:pageNumber": 150,
      "values:originalText": "(1) Subject to the Administrative Review Tribunal Act 2024, an\napplication may be made by an eligible person in relation to:\n(a) a reviewable decision made by the Regulator personally; or\n(b) a decision made by the Regulator under section 181 (which\nprovides for internal review)."
    },
