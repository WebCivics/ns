          "@id": "concept:gene-technology-act-2000-sec-33-ss-3"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-33-ss-4"
        }
      ],
      "cml:integrityHash": "dd04d87829718f9c48780788259f9efb877c778151671a62aee54d384826e663"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-33",
