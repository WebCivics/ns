    {
      "@id": "concept:gene-technology-act-2000-sec-184",
      "@type": "cml:Concept",
      "skos:prefLabel": "184 Application for protection of confidential commercial",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-184"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.151",
      "values:originalText": "information\n(1) A person may apply to the Regulator for a declaration that\nspecified information to which this Act relates is confidential\ncommercial information for the purposes of this Act.\n(2) An application under subsection (1) must be in writing in the form\napproved by the Regulator.",
      "skos:definition": "information\n(1) A person may apply to the Regulator for a declaration that\nspecified information to which this Act relates is confidential\ncommercial information for the purposes of this Act.\n(2) An application under subsection (1) must be in writing in the form\napproved by the Regulator.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-184-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-184-ss-2"
        }
      ],
      "cml:integrityHash": "dea7111a8406e27cfc8bf5f49c5d40898402b0b584b3285f069170a36f9eec31"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-184",
      "@type": "cof:Section",
      "cof:title": "184 Application for protection of confidential commercial",
      "values:kind": "section",
      "cof:pageNumber": 151,
      "values:originalText": "information\n(1) A person may apply to the Regulator for a declaration that\nspecified information to which this Act relates is confidential\ncommercial information for the purposes of this Act.\n(2) An application under subsection (1) must be in writing in the form\napproved by the Regulator."
    },
