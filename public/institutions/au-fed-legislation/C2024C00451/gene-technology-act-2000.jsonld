          "@id": "concept:gene-technology-act-2000-sec-169-ss-3-norm"
        }
      ],
      "cml:integrityHash": "0a8ad4f4118e35f72bd97b297bccb92501be3b3d494b9207044b1d2a298a2145",
      "skos:note": "Terms and conditions for returning seized things"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-169-ss-3",
      "@type": "cof:Section",
      "cof:title": "169(3) Retention of seized things",
      "values:kind": "subsection",
      "cof:pageNumber": 137,
      "values:originalText": "(3) The thing may be returned under subsection (2) either\nunconditionally or on such terms and conditions as the Regulator\nsees fit."
    },
