    {
      "@id": "concept:gene-technology-act-2000-sec-188-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "188(2) Conduct by directors, employees and agents",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-188-ss-2"
