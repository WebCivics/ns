    {
      "@id": "concept:gene-technology-act-2000-sec-139",
      "@type": "cml:Concept",
      "skos:prefLabel": "139 Inspection of Record",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-139"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.114",
      "values:originalText": "The Regulator must permit any person to inspect any part of the\nRecord.\n\n\nAdministration  Part 9\nReviews of notifiable low risk dealings and exemptions  Division 7\nSection 140\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "The Regulator must permit any person to inspect any part of the\nRecord.\n\n\nAdministration  Part 9\nReviews of notifiable low risk dealings and exemptions  Division 7\nSection 140\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-139-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-139-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1201b4d5842b1d73927e2cf8a54e904239e03bd5cd94e2bba8ef91c1d3529882",
      "skos:note": "Permit inspection of Record"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-139",
      "@type": "cof:Section",
      "cof:title": "139 Inspection of Record",
      "values:kind": "section",
      "cof:pageNumber": 114,
      "values:originalText": "The Regulator must permit any person to inspect any part of the\nRecord.\n\n\nAdministration  Part 9\nReviews of notifiable low risk dealings and exemptions  Division 7\nSection 140\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
