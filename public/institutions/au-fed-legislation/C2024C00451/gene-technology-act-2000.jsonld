      ],
      "cml:integrityHash": "a5dbc132770357389e284094a2e6e89d4181e7bf8ac35467d9e56918b47f2e5a",
      "skos:note": "Must provide information within a specified period after receiving notice.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-72-ss-3",
      "@type": "cof:Section",
      "cof:title": "72(3) Regulator to notify of proposed suspension, cancellation or",
      "values:kind": "subsection",
      "cof:pageNumber": 66,
      "values:originalText": "(3) The notice must specify a period within which the licence holder:\n(a) must give the information referred to in paragraph (2)(b); and\n(b) may make a submission under paragraph (2)(c).\nThe period must not end earlier than 30 days after the day on\nwhich the notice was given."
    },
