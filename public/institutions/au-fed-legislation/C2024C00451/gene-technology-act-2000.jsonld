      },
      "cml:premiseText": "Regulator has the power to issue licences.",
      "cml:conclusionText": "Regulator's decision is based on consideration of risks."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-56-ss-1-logic-diffusion-4",
