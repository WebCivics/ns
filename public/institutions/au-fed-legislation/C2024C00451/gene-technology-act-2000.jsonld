          "@id": "concept:gene-technology-act-2000-sec-72d-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-72d-ss-2"
        }
      ],
      "cml:integrityHash": "9b6492b37f5a975ddc81049258237c95c609c15ef1b3fcace9416565042d4c35"
