    {
      "@id": "concept:gene-technology-act-2000-sec-47-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "47(3) What the Regulator must do in relation to application",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-47-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
