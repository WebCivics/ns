    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-106",
      "@type": "cof:Section",
      "cof:title": "106 The Gene Technology Ethics and Community Consultative",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "Committee\nThe Gene Technology Ethics and Community Consultative\nCommittee (the Ethics and Community Committee) is established."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-106-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-106"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-107",
      "@type": "cml:Concept",
      "skos:prefLabel": "107 Function of Ethics and Community Committee",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-107"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.98",
      "values:originalText": "The function of the Ethics and Community Committee is to\nprovide advice, on the request of the Regulator or the Ministerial\nCouncil, on the following:\n(a) ethical issues relating to gene technology;\n(b) the need for, and content of, codes of practice in relation to\nethics in respect of conducting dealings with GMOs;\n(c) the need for, and content of, policy principles in relation to\ndealings with GMOs that should not be conducted for ethical\nreasons;\n(d) the need for policy principles, policy guidelines, codes of\npractice and technical and procedural guidelines in relation to\nGMOs and GM products and the content of such principles,\nguidelines and codes;\n(e) community consultation in respect of the process for\napplications for licences covering dealings that involve the\nintentional release of a GMO into the environment;\n(f) risk communication matters in relation to dealings that\ninvolve the intentional release of a GMO into the\nenvironment;\n(g) matters of general concern identified by the Regulator in\nrelation to applications made under this Act;\n(h) matters of general concern in relation to GMOs.\n\n\nThe Gene Technology Technical Advisory Committee and the Gene Technology Ethics\nand Community Consultative Committee  Part 8\nThe Gene Technology Ethics and Community Consultative Committee  Division 3\nSection 108\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "The function of the Ethics and Community Committee is to\nprovide advice, on the request of the Regulator or the Ministerial\nCouncil, on the following:\n(a) ethical issues relating to gene technology;\n(b) the need for, and content of, codes of practice in relation to\nethics in respect of conducting dealings with GMOs;\n(c) the need for, and content of, policy principles in relation to\ndealings with GMOs that should not be conducted for ethical\nreasons;\n(d) the need for policy principles, policy guidelines, codes of\npractice and technical and procedural guidelines in relation to\nGMOs and GM products and the content of such principles,\nguidelines and codes;\n(e) community consultation in respect of the process for\napplications for licences covering dealings that involve the\nintentional release of a GMO into the environment;\n(f) risk communication matters in relation to dealings that\ninvolve the intentional release of a GMO into the\nenvironment;\n(g) matters of general concern identified by the Regulator in\nrelation to applications made under this Act;\n(h) matters of general concern in relation to GMOs.\n\n\nThe Gene Technology Technical Advisory Committee and the Gene Technology Ethics\nand Community Consultative Committee  Part 8\nThe Gene Technology Ethics and Community Consultative Committee  Division 3\nSection 108\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-107-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-107-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f8ee75b96a7c089fed4cf9813b18eef04afab9d6a9c6f1c3f9eaa23a78941096",
      "skos:note": "Provide advice on various matters related to gene technology"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-107",
      "@type": "cof:Section",
      "cof:title": "107 Function of Ethics and Community Committee",
      "values:kind": "section",
      "cof:pageNumber": 98,
      "values:originalText": "The function of the Ethics and Community Committee is to\nprovide advice, on the request of the Regulator or the Ministerial\nCouncil, on the following:\n(a) ethical issues relating to gene technology;\n(b) the need for, and content of, codes of practice in relation to\nethics in respect of conducting dealings with GMOs;\n(c) the need for, and content of, policy principles in relation to\ndealings with GMOs that should not be conducted for ethical\nreasons;\n(d) the need for policy principles, policy guidelines, codes of\npractice and technical and procedural guidelines in relation to\nGMOs and GM products and the content of such principles,\nguidelines and codes;\n(e) community consultation in respect of the process for\napplications for licences covering dealings that involve the\nintentional release of a GMO into the environment;\n(f) risk communication matters in relation to dealings that\ninvolve the intentional release of a GMO into the\nenvironment;\n(g) matters of general concern identified by the Regulator in\nrelation to applications made under this Act;\n(h) matters of general concern in relation to GMOs.\n\n\nThe Gene Technology Technical Advisory Committee and the Gene Technology Ethics\nand Community Consultative Committee  Part 8\nThe Gene Technology Ethics and Community Consultative Committee  Division 3\nSection 108\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-107-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-107"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-107-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must provide advice",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
