    {
      "@id": "concept:gene-technology-act-2000-sec-35b-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "35B(3) Person must not breach conditions of emergency dealing",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-35b-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.39",
      "values:originalText": "(3) An offence under this section is punishable on conviction by a fine\nof not more than whichever of the following amounts applies:\n(a) in the case of an aggravated offence—200 penalty units;\n(b) in any other case—50 penalty units.\nNote:\nSection 38 defines aggravated offence.",
      "skos:definition": "(3) An offence under this section is punishable on conviction by a fine\nof not more than whichever of the following amounts applies:\n(a) in the case of an aggravated offence—200 penalty units;\n(b) in any other case—50 penalty units.\nNote:\nSection 38 defines aggravated offence.",
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-35b"
      },
      "cml:asserts": [
