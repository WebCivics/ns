      "dc:source": "gene-technology-act-2000.pdf, p.76",
      "values:originalText": "(5) The day specified as mentioned in paragraph (4)(b) must not be\nearlier than 30 days after the day on which the variation,\nsuspension or revocation is made.",
      "skos:definition": "(5) The day specified as mentioned in paragraph (4)(b) must not be\nearlier than 30 days after the day on which the variation,\nsuspension or revocation is made.",
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-72e"
      },
      "cml:asserts": [
