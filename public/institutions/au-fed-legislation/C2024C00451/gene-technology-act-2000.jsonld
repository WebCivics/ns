    {
      "@id": "concept:gene-technology-act-2000-sec-63",
      "@type": "cml:Concept",
      "skos:prefLabel": "63 Condition about informing people of obligations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-63"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.60",
      "values:originalText": "(1) It is a condition of a licence that the licence holder inform any\nperson covered by the licence, to whom a particular condition of\nthe licence applies, of the following:\n(a) the particular condition, including any variations of it;\n(b) the cancellation or suspension of the licence;\n(c) the surrender of the licence.\n(2) Requirements in relation to the manner in which information is\nprovided under subsection (1) may be:\n(a) prescribed by the regulations; or\n(b) specified by the Regulator.\n(3) Such requirements may include, but are not limited to, measures\nrelating to labelling, packaging, conducting training and providing\ninformation.\n(4) If such requirements are prescribed or specified, it is a condition of\na licence that the licence holder comply with the requirements.\n\n\nLicensing system  Part 5\nConditions of licences  Division 6\nSection 64\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "(1) It is a condition of a licence that the licence holder inform any\nperson covered by the licence, to whom a particular condition of\nthe licence applies, of the following:\n(a) the particular condition, including any variations of it;\n(b) the cancellation or suspension of the licence;\n(c) the surrender of the licence.\n(2) Requirements in relation to the manner in which information is\nprovided under subsection (1) may be:\n(a) prescribed by the regulations; or\n(b) specified by the Regulator.\n(3) Such requirements may include, but are not limited to, measures\nrelating to labelling, packaging, conducting training and providing\ninformation.\n(4) If such requirements are prescribed or specified, it is a condition of\na licence that the licence holder comply with the requirements.\n\n\nLicensing system  Part 5\nConditions of licences  Division 6\nSection 64\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-63-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-63-ss-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-63-ss-3"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-63-ss-4"
        }
      ],
      "cml:integrityHash": "b4af18ca65fe2fb69edb2c89d5e462ded39d909411ad302eaa2b1417a9d77173"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-63",
      "@type": "cof:Section",
      "cof:title": "63 Condition about informing people of obligations",
      "values:kind": "section",
      "cof:pageNumber": 60,
      "values:originalText": "(1) It is a condition of a licence that the licence holder inform any\nperson covered by the licence, to whom a particular condition of\nthe licence applies, of the following:\n(a) the particular condition, including any variations of it;\n(b) the cancellation or suspension of the licence;\n(c) the surrender of the licence.\n(2) Requirements in relation to the manner in which information is\nprovided under subsection (1) may be:\n(a) prescribed by the regulations; or\n(b) specified by the Regulator.\n(3) Such requirements may include, but are not limited to, measures\nrelating to labelling, packaging, conducting training and providing\ninformation.\n(4) If such requirements are prescribed or specified, it is a condition of\na licence that the licence holder comply with the requirements.\n\n\nLicensing system  Part 5\nConditions of licences  Division 6\nSection 64\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
    {
