    {
      "@id": "concept:gene-technology-act-2000-sec-149",
      "@type": "cml:Concept",
      "skos:prefLabel": "149 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-149"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.123",
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides for powers of inspection in relation to\nmonitoring and offences.\nDivision 2 provides for the appointment of inspectors.\nDivisions 3 to 9 deal with the powers and obligations of inspectors,\nand the rights and responsibilities of an occupier of premises when\nan inspector seeks to exercise powers.\nDivision 10 sets out procedures relating to monitoring warrants and\noffence-related warrants.\nThis Part does not limit the conditions to which a licence or an\nemergency dealing determination can be subject, and section 64\nimposes a condition in relation to monitoring dealings with GMOs.",
      "skos:definition": "The following is a simplified outline of this Part:\nThis Part provides for powers of inspection in relation to\nmonitoring and offences.\nDivision 2 provides for the appointment of inspectors.\nDivisions 3 to 9 deal with the powers and obligations of inspectors,\nand the rights and responsibilities of an occupier of premises when\nan inspector seeks to exercise powers.\nDivision 10 sets out procedures relating to monitoring warrants and\noffence-related warrants.\nThis Part does not limit the conditions to which a licence or an\nemergency dealing determination can be subject, and section 64\nimposes a condition in relation to monitoring dealings with GMOs.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-149-norm"
        }
      ],
      "cml:integrityHash": "a4ae42d14107d689caf76d056097575324138d1996f3cec555d8de2276ad59fc",
      "skos:note": "Simplified outline of this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-149",
      "@type": "cof:Section",
      "cof:title": "149 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 123,
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides for powers of inspection in relation to\nmonitoring and offences.\nDivision 2 provides for the appointment of inspectors.\nDivisions 3 to 9 deal with the powers and obligations of inspectors,\nand the rights and responsibilities of an occupier of premises when\nan inspector seeks to exercise powers.\nDivision 10 sets out procedures relating to monitoring warrants and\noffence-related warrants.\nThis Part does not limit the conditions to which a licence or an\nemergency dealing determination can be subject, and section 64\nimposes a condition in relation to monitoring dealings with GMOs."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-149-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-149"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-150",
      "@type": "cml:Concept",
      "skos:prefLabel": "150 Appointment of inspectors",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-150"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.124",
      "values:originalText": "(1) The Regulator may, by instrument in writing, appoint any of the\nfollowing persons as inspectors:\n(a) a person who is appointed or employed by the\nCommonwealth;\n(b) a person who is appointed or employed by a State.\n(2) In exercising powers or performing functions as an inspector, an\ninspector must comply with any directions of the Regulator.",
