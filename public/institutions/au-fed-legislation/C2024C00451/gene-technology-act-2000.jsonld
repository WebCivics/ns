      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-112-ss-2",
      "@type": "cof:Section",
      "cof:title": "112(2) Expert advisers",
      "values:kind": "subsection",
      "cof:pageNumber": 102,
      "values:originalText": "(2) Expert advisers are not members of the Ethics and Community\nCommittee.\n\n\nAdministration  Part 9\nSimplified outline  Division 1\nSection 117\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
