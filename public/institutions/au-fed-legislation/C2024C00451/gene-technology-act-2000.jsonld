    {
      "@id": "concept:gene-technology-act-2000-sec-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "5 Nationally consistent scheme",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
