        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A variation may revoke or vary conditions to which a dealing on the GMO Register is subject;",
      "cml:conclusionText": "The revocation or variation of conditions occurs until the end of the variation."
    },
