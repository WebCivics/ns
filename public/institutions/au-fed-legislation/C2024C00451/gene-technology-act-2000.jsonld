    {
      "@id": "concept:gene-technology-act-2000-sec-80-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "remove",
      "cml:logicSummary": "Removal from the GMO Register",
