      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister is satisfied that adequate measures to address those risks are not able to be implemented."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-72e-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "Diffuse",
      "cml:logicSummary": "Risk to health and safety or environment associated with continuation of dealings will diffuse over time.",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Minister is satisfied that the threat to which the emergency dealing determination relates: (i) no longer exists; or (ii) is no longer sufficiently actual or imminent as to require the determination to be in force to address that threat."
    },
    {
