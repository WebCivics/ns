      "cml:operator": "revocation",
      "cml:logicSummary": "Revocation of conditions on the GMO Register",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A variation may revoke or vary conditions to which a dealing on the GMO Register is subject;",
      "cml:conclusionText": "Conditions on the GMO Register may be revoked or varied."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-80-ss-2-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "imposition",
      "cml:logicSummary": "Imposition of additional conditions on the GMO Register",
