    },
    {
      "@id": "concept:gene-technology-act-2000-sec-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 Applications to which this Division applies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.48",
      "values:originalText": "This Division applies to an application for a GMO licence if the\nRegulator is satisfied that at least one of the dealings proposed to\nbe authorised by the licence would involve the intentional release\nof a GMO into the environment.",
      "skos:definition": "This Division applies to an application for a GMO licence if the\nRegulator is satisfied that at least one of the dealings proposed to\nbe authorised by the licence would involve the intentional release\nof a GMO into the environment.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-48-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-48-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "e6354cf9b5cba4ebbdb557e5e56c62d4d1771271bb77df16994a8870ac51d5f9",
      "skos:note": "Application for GMO licence must involve intentional release into environment."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-48",
      "@type": "cof:Section",
      "cof:title": "48 Applications to which this Division applies",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "This Division applies to an application for a GMO licence if the\nRegulator is satisfied that at least one of the dealings proposed to\nbe authorised by the licence would involve the intentional release\nof a GMO into the environment."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-48-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-48"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-48-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:logicSummary": "Must be satisfied that at least one dealing would involve intentional release into environment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Division does not apply to an application relating to inadvertent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.48",
      "values:originalText": "dealings\nDespite section 48, this Division does not apply to an application\nfor a GMO licence if the Regulator is satisfied that:\n(a) the dealings proposed to be authorised by the licence are\nlimited to one or more of the following for purposes relating\nto disposing of a GMO:\n(i) conducting experiments with the GMO;\n(ii) propagating the GMO;\n(iii) growing, raising or culturing the GMO;\n(iv) transporting the GMO;\n(v) any other dealings to be undertaken for the purposes of,\nor for purposes relating to, disposing of the GMO; and\n(b) the applicant for the licence came into possession of the\nGMO inadvertently.",
      "skos:definition": "dealings\nDespite section 48, this Division does not apply to an application\nfor a GMO licence if the Regulator is satisfied that:\n(a) the dealings proposed to be authorised by the licence are\nlimited to one or more of the following for purposes relating\nto disposing of a GMO:\n(i) conducting experiments with the GMO;\n(ii) propagating the GMO;\n(iii) growing, raising or culturing the GMO;\n(iv) transporting the GMO;\n(v) any other dealings to be undertaken for the purposes of,\nor for purposes relating to, disposing of the GMO; and\n(b) the applicant for the licence came into possession of the\nGMO inadvertently.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-49-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-49-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-49-logic-alleninterval-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-49-logic-ltl-3"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-49-logic-diffusion-4"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-49-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "a57ae54936da81852cbeb08a4976b3b859e222f40699b0bb0399b7b0d9aa242e",
      "skos:note": "Regulator's satisfaction required for GMO licence application"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Division does not apply to an application relating to inadvertent",
      "values:kind": "section",
      "cof:pageNumber": 48,
      "values:originalText": "dealings\nDespite section 48, this Division does not apply to an application\nfor a GMO licence if the Regulator is satisfied that:\n(a) the dealings proposed to be authorised by the licence are\nlimited to one or more of the following for purposes relating\nto disposing of a GMO:\n(i) conducting experiments with the GMO;\n(ii) propagating the GMO;\n(iii) growing, raising or culturing the GMO;\n(iv) transporting the GMO;\n(v) any other dealings to be undertaken for the purposes of,\nor for purposes relating to, disposing of the GMO; and\n(b) the applicant for the licence came into possession of the\nGMO inadvertently."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-49-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-49"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-49-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Regulator's satisfaction is a requirement",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Regulator must be satisfied",
      "cml:conclusionText": "GMO licence application is allowed"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-49-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Dealing types are restricted to specific time periods",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Dealing types include experiments, propagation, growth, transportation, and other dealings",
      "cml:conclusionText": "GMO licence application is not affected by Division 48 during these times"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-49-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Dealing types are restricted to specific time periods",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Dealing types include experiments, propagation, growth, transportation, and other dealings",
      "cml:conclusionText": "GMO licence application is not affected by Division 48 during these times"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-49-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "if",
      "cml:logicSummary": "Regulator's satisfaction is a prerequisite for GMO licence application",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Regulator must be satisfied",
      "cml:conclusionText": "GMO licence application is allowed if Regulator is satisfied"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-49-logic-cogai-5",
      "@type": "cml:LogicApplication",
