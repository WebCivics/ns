    {
      "@id": "concept:gene-technology-act-2000-sec-119-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "119(4) Termination of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-119-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.104",
      "values:originalText": "(4) If the Regulator is:\n(a) an eligible employee for the purposes of the Superannuation\nAct 1976; or\n(b) a member of the superannuation scheme established by deed\nunder the Superannuation Act 1990; or\n(c) an ordinary employer-sponsored member of PSSAP, within\nthe meaning of the Superannuation Act 2005;\nthe Governor-General may, with the consent of the Regulator,\nretire the Regulator from office on the grounds of physical or\nmental incapacity.",
      "skos:definition": "(4) If the Regulator is:\n(a) an eligible employee for the purposes of the Superannuation\nAct 1976; or\n(b) a member of the superannuation scheme established by deed\nunder the Superannuation Act 1990; or\n(c) an ordinary employer-sponsored member of PSSAP, within\nthe meaning of the Superannuation Act 2005;\nthe Governor-General may, with the consent of the Regulator,\nretire the Regulator from office on the grounds of physical or\nmental incapacity.",
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-119"
      },
      "cml:asserts": [
