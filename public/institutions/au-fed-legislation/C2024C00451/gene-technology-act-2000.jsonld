    {
      "@id": "concept:gene-technology-act-2000-sec-167",
      "@type": "cml:Concept",
      "skos:prefLabel": "167 Occupier entitled to be present during search",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-167"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.136",
      "values:originalText": "(1) If a warrant in relation to premises is being executed and the\noccupier of the premises, or another person who apparently\nrepresents the occupier is present at the premises, the person is\nentitled to observe the search being conducted.\n(2) The right to observe the search being conducted ceases if the\nperson impedes the search.\n(3) This section does not prevent 2 or more areas of the premises being\nsearched at the same time.\n\n\nPowers of inspection  Part 11\nGeneral provisions relating to search and seizure  Division 9\nSection 168\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "skos:definition": "(1) If a warrant in relation to premises is being executed and the\noccupier of the premises, or another person who apparently\nrepresents the occupier is present at the premises, the person is\nentitled to observe the search being conducted.\n(2) The right to observe the search being conducted ceases if the\nperson impedes the search.\n(3) This section does not prevent 2 or more areas of the premises being\nsearched at the same time.\n\n\nPowers of inspection  Part 11\nGeneral provisions relating to search and seizure  Division 9\nSection 168\nGene Technology Act 2000\nCompilation date: 14/10/2024",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-167-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-167-ss-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-167-ss-3"
        }
      ],
      "cml:integrityHash": "4a597030623e4781809f5b6e8de8605e4060cce64ca30918593bdf013b6f9cb6"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-167",
      "@type": "cof:Section",
      "cof:title": "167 Occupier entitled to be present during search",
      "values:kind": "section",
      "cof:pageNumber": 136,
      "values:originalText": "(1) If a warrant in relation to premises is being executed and the\noccupier of the premises, or another person who apparently\nrepresents the occupier is present at the premises, the person is\nentitled to observe the search being conducted.\n(2) The right to observe the search being conducted ceases if the\nperson impedes the search.\n(3) This section does not prevent 2 or more areas of the premises being\nsearched at the same time.\n\n\nPowers of inspection  Part 11\nGeneral provisions relating to search and seizure  Division 9\nSection 168\nGene Technology Act 2000\nCompilation date: 14/10/2024"
    },
