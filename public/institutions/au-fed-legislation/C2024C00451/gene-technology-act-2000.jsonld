      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-156-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "Permission granted",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Inspector believes on reasonable grounds...",
      "cml:conclusionText": "Equipment operation is permitted."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-156-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
