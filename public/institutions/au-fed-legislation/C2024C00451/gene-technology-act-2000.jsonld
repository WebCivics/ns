        }
      ],
      "cml:integrityHash": "0bc3b37cbecdf0b6564b58ea1ab527eaa14dd101562de8b47b16da48a0dbd9df",
      "skos:note": "Minimum waiting period after variation, suspension or revocation of emergency dealing"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-72e-ss-5",
      "@type": "cof:Section",
      "cof:title": "72E(5) Variation, suspension and revocation of emergency dealing",
      "values:kind": "subsection",
      "cof:pageNumber": 76,
      "values:originalText": "(5) The day specified as mentioned in paragraph (4)(b) must not be\nearlier than 30 days after the day on which the variation,\nsuspension or revocation is made."
    },
