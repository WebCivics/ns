      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.116",
      "values:originalText": "(3) If the matter relates to whether a dealing:\n(a) should be an exempt dealing; or\n\n\nAdministration  Part 9\nReviews of notifiable low risk dealings and exemptions  Division 7\nSection 144\nGene Technology Act 2000\nCompilation date: 14/10/2024\n(b) should cease to be an exempt dealing;\nthe Regulator may recommend to the Ministerial Council that the\nregulations be amended accordingly.",
      "skos:definition": "(3) If the matter relates to whether a dealing:\n(a) should be an exempt dealing; or\n\n\nAdministration  Part 9\nReviews of notifiable low risk dealings and exemptions  Division 7\nSection 144\nGene Technology Act 2000\nCompilation date: 14/10/2024\n(b) should cease to be an exempt dealing;\nthe Regulator may recommend to the Ministerial Council that the\nregulations be amended accordingly.",
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-143"
      },
      "cml:asserts": [
