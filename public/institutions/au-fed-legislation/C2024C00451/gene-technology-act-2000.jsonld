      "cml:premiseText": "Regulator must not engage in paid employment outside the duties of the Regulator’s office.",
      "cml:conclusionText": "Minister's approval required."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-123-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
