    {
      "@id": "concept:gene-technology-act-2000-sec-138-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "138(3) Record of GMO Dealings",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-138-ss-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
