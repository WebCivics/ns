    },
    {
      "@id": "concept:gene-technology-act-2000-sec-176",
      "@type": "cml:Concept",
      "skos:prefLabel": "176 Part not to abrogate privilege against self-incrimination",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-176"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.145",
      "values:originalText": "Nothing in this Part affects the right of a person to refuse to answer\na question, give information, or produce a document, on the ground\nthat the answer to the question, the information, or the production\nof the document, might tend to incriminate him or her or make him\nor her liable to a penalty.",
      "skos:definition": "Nothing in this Part affects the right of a person to refuse to answer\na question, give information, or produce a document, on the ground\nthat the answer to the question, the information, or the production\nof the document, might tend to incriminate him or her or make him\nor her liable to a penalty.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-176-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-176-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "95332645b6a47123cd96c3f2ada19072106659226781b448cd411ff01ad75a60",
      "skos:note": "Right to refuse self-incrimination"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-176",
      "@type": "cof:Section",
      "cof:title": "176 Part not to abrogate privilege against self-incrimination",
      "values:kind": "section",
      "cof:pageNumber": 145,
      "values:originalText": "Nothing in this Part affects the right of a person to refuse to answer\na question, give information, or produce a document, on the ground\nthat the answer to the question, the information, or the production\nof the document, might tend to incriminate him or her or make him\nor her liable to a penalty."
    },
    {
