    {
      "@id": "concept:gene-technology-act-2000-sec-117",
      "@type": "cml:Concept",
      "skos:prefLabel": "117 Simplified outline",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-117"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.103",
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides for various administrative matters.\nDivision 2 sets out matters relating to the appointment, conditions\nand remuneration of the Regulator.\nDivision 3 provides for financial matters, including the\nestablishment of a special account, called the Gene Technology\nAccount.\nDivision 4 provides for matters relating to staffing.\nDivision 5 sets out reporting requirements.\nDivision 6 requires the Regulator to maintain a record of GMO\ndealings.\nDivision 7 permits the Regulator to review notifiable low risk\ndealings and exemptions.",
      "skos:definition": "The following is a simplified outline of this Part:\nThis Part provides for various administrative matters.\nDivision 2 sets out matters relating to the appointment, conditions\nand remuneration of the Regulator.\nDivision 3 provides for financial matters, including the\nestablishment of a special account, called the Gene Technology\nAccount.\nDivision 4 provides for matters relating to staffing.\nDivision 5 sets out reporting requirements.\nDivision 6 requires the Regulator to maintain a record of GMO\ndealings.\nDivision 7 permits the Regulator to review notifiable low risk\ndealings and exemptions.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-117-norm"
        }
      ],
      "cml:integrityHash": "61fabfc3f37167a69cefa4f22131f37d4644945968b15f13c39c7e2d24264e75",
      "skos:note": "Simplified outline of this Part"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-117",
      "@type": "cof:Section",
      "cof:title": "117 Simplified outline",
      "values:kind": "section",
      "cof:pageNumber": 103,
      "values:originalText": "The following is a simplified outline of this Part:\nThis Part provides for various administrative matters.\nDivision 2 sets out matters relating to the appointment, conditions\nand remuneration of the Regulator.\nDivision 3 provides for financial matters, including the\nestablishment of a special account, called the Gene Technology\nAccount.\nDivision 4 provides for matters relating to staffing.\nDivision 5 sets out reporting requirements.\nDivision 6 requires the Regulator to maintain a record of GMO\ndealings.\nDivision 7 permits the Regulator to review notifiable low risk\ndealings and exemptions."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-117-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-117"
      },
