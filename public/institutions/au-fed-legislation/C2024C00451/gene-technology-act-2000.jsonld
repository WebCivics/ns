        }
      ],
      "cml:integrityHash": "acebe2ceca2d45383159eeaa3fe5aae956ddf6e277c170cbfb5e012b8bccbab3",
      "skos:note": "Staff assisting the Regulator must be persons engaged under the Public Service Act 1999."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-133",
      "@type": "cof:Section",
      "cof:title": "133 Staff assisting the Regulator",
      "values:kind": "section",
      "cof:pageNumber": 111,
      "values:originalText": "The staff assisting the Regulator are to be persons engaged under\nthe Public Service Act 1999 and made available for the purpose by\nthe Secretary of the Department."
    },
