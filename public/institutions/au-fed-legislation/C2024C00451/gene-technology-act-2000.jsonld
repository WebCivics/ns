    {
      "@id": "concept:gene-technology-act-2000-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Offences",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.14",
      "values:originalText": "(1) Chapter 2 of the Criminal Code applies to all offences against this\nAct.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n(2) If a maximum penalty is specified:\n(a) at the foot of a section of this Act (other than a section that is\ndivided into subsections); or\n(b) at the foot of a subsection of this Act;\nthen:\n\n\nPreliminary  Part 1\n\nSection 8\nGene Technology Act 2000\nCompilation date: 14/10/2024\n(c) a person who contravenes the section or subsection commits\nan offence punishable, on conviction, by a penalty not\nexceeding the specified penalty; or\n(d) the offence referred to in the section or subsection is\npunishable, on conviction, by a penalty not exceeding the\nspecified penalty.",
      "skos:definition": "(1) Chapter 2 of the Criminal Code applies to all offences against this\nAct.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n(2) If a maximum penalty is specified:\n(a) at the foot of a section of this Act (other than a section that is\ndivided into subsections); or\n(b) at the foot of a subsection of this Act;\nthen:\n\n\nPreliminary  Part 1\n\nSection 8\nGene Technology Act 2000\nCompilation date: 14/10/2024\n(c) a person who contravenes the section or subsection commits\nan offence punishable, on conviction, by a penalty not\nexceeding the specified penalty; or\n(d) the offence referred to in the section or subsection is\npunishable, on conviction, by a penalty not exceeding the\nspecified penalty.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-8-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-8-ss-2"
        }
      ],
      "cml:integrityHash": "4f2997014bedefc354750d8a74e16ed64434f8483ba9d80c93f43e1a14b94b7a"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-8",
      "@type": "cof:Section",
      "cof:title": "8 Offences",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "(1) Chapter 2 of the Criminal Code applies to all offences against this\nAct.\nNote:\nChapter 2 of the Criminal Code sets out the general principles of\ncriminal responsibility.\n(2) If a maximum penalty is specified:\n(a) at the foot of a section of this Act (other than a section that is\ndivided into subsections); or\n(b) at the foot of a subsection of this Act;\nthen:\n\n\nPreliminary  Part 1\n\nSection 8\nGene Technology Act 2000\nCompilation date: 14/10/2024\n(c) a person who contravenes the section or subsection commits\nan offence punishable, on conviction, by a penalty not\nexceeding the specified penalty; or\n(d) the offence referred to in the section or subsection is\npunishable, on conviction, by a penalty not exceeding the\nspecified penalty."
    },
