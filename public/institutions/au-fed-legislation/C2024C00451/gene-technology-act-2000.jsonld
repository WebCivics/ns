        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) A variation may impose additional conditions to which a dealing on the GMO Register is subject;",
      "cml:conclusionText": "Additional conditions may be imposed on the GMO Register."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-80-ss-2-logic-alleninterval-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
