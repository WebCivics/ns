    {
      "@id": "concept:gene-technology-act-2000-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Things done for multiple purposes",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.28",
      "values:originalText": "The validity of a licence, certificate or other thing issued, given or\ndone for the purposes of this Act is not affected only because it\nwas issued, given or done also for the purposes of a corresponding\nState law.\nSubdivision B—Policy principles, policy guidelines and codes of\npractice",
      "skos:definition": "The validity of a licence, certificate or other thing issued, given or\ndone for the purposes of this Act is not affected only because it\nwas issued, given or done also for the purposes of a corresponding\nState law.\nSubdivision B—Policy principles, policy guidelines and codes of\npractice",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-20-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-20-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "94f54c51bfb3ff1bcc5bb3be2c7dc7341c7a5a3a0371ef86f29275343b835b57",
      "skos:note": "Validity of licenses/certificates not affected by concurrent purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-20",
      "@type": "cof:Section",
      "cof:title": "20 Things done for multiple purposes",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "The validity of a licence, certificate or other thing issued, given or\ndone for the purposes of this Act is not affected only because it\nwas issued, given or done also for the purposes of a corresponding\nState law.\nSubdivision B—Policy principles, policy guidelines and codes of\npractice"
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-20-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
