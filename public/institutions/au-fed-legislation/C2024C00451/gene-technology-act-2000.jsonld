    {
      "@id": "concept:gene-technology-act-2000-sec-112",
      "@type": "cml:Concept",
      "skos:prefLabel": "112 Expert advisers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-112"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
