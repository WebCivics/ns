        }
      ],
      "cml:integrityHash": "8168cc6bcb1b98f24390b922d8af82dca2e527b90f11287bd7085ceb72fedc56",
      "skos:note": "Wind-back notice in relation to a State is in force at that time."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-14-2-ss-1",
      "@type": "cof:Section",
      "cof:title": "14(1) Wind-back of reach of Act",
      "values:kind": "subsection",
      "cof:pageNumber": 24,
      "values:originalText": "(1) This section applies to a State (the notifying State) at a particular\ntime if:\n\n\nInterpretation and operation of Act  Part 2\nOperation of Act  Division 3\nSection 15\nGene Technology Act 2000\nCompilation date: 14/10/2024\n(a) a corresponding State law is in force in the notifying State at\nthat time; and\n(b) a wind-back notice in relation to that State is in force at that\ntime."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-14-2-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-14-2-ss-1"
      },
      "values:deonticStatus": {
