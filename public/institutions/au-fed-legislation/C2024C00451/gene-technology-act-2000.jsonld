    {
      "@id": "concept:gene-technology-act-2000-sec-192a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "192A(2) Interference with dealings with GMOs",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-192a-ss-2"
