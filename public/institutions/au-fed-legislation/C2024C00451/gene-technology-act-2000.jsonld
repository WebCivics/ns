      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(2) If the inspector, after operating the equipment...",
      "cml:conclusionText": "The inspector may not seize the equipment and any disk, tape or other associated device."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-156-ss-2-logic-alleninterval-2",
