      },
      "cml:operator": "¬∃t (P(t) ∧ Q(t))",
      "cml:logicSummary": "Temporal negation",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
