        },
        {
          "@id": "concept:gene-technology-act-2000-sec-119-ss-5-logic-ltl-3"
        }
      ],
      "cml:integrityHash": "96a094e7dfc3be5de6bc19c09173c78b5846eac8199221eeca50fcaab07ebe9b",
      "skos:note": "Regulator must be retired on grounds of invalidity if removed or retired due to incapacity and CSC gives a certificate."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-119-ss-5",
      "@type": "cof:Section",
      "cof:title": "119(5) Termination of appointment",
      "values:kind": "subsection",
      "cof:pageNumber": 104,
      "values:originalText": "(5) For the purposes of the Superannuation Act 1976, the Regulator is\ntaken to have been retired from office on the grounds of invalidity\nif:\n(a) the Regulator is removed or retired from office on the\ngrounds of physical or mental incapacity; and\n(b) CSC gives a certificate under section 54C of that Act."
    },
