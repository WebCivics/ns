          "@id": "concept:gene-technology-act-2000-sec-108-ss-3"
        }
      ],
      "cml:integrityHash": "44a72415e2e47243f39bd3664adb4a90e581acaf678b5d4de0122ba25ab46779"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-108",
      "@type": "cof:Section",
