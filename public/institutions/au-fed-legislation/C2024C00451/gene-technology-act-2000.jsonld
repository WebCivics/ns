    {
      "@id": "concept:gene-technology-act-2000-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Independence of the Regulator",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.33",
      "values:originalText": "Subject to this Act and to other laws of the Commonwealth, the\nRegulator has discretion in the performance or exercise of his or\nher functions or powers. In particular, the Regulator is not subject\nto direction from anyone in relation to:\n(a) whether a GMO licence is issued or refused in relation to a\nparticular application; or\n(b) the conditions to which a particular GMO licence is subject.",
      "skos:definition": "Subject to this Act and to other laws of the Commonwealth, the\nRegulator has discretion in the performance or exercise of his or\nher functions or powers. In particular, the Regulator is not subject\nto direction from anyone in relation to:\n(a) whether a GMO licence is issued or refused in relation to a\nparticular application; or\n(b) the conditions to which a particular GMO licence is subject.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-30-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-30-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "d1d59e98cda308f434165784aa15bc0151cf5b85dd9defb088957f0e2bb0b9c3",
      "skos:note": "Regulator's discretion in GMO licence issuance and conditions"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-30",
      "@type": "cof:Section",
      "cof:title": "30 Independence of the Regulator",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "Subject to this Act and to other laws of the Commonwealth, the\nRegulator has discretion in the performance or exercise of his or\nher functions or powers. In particular, the Regulator is not subject\nto direction from anyone in relation to:\n(a) whether a GMO licence is issued or refused in relation to a\nparticular application; or\n(b) the conditions to which a particular GMO licence is subject."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-30-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
