      ],
      "cml:integrityHash": "0aa23d8dacf36824769340e31eb276fb400e4e067f9a83437b169a9b0335d220",
      "skos:note": "Regulator must ensure risks can be managed to protect health and safety and the environment."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-56-ss-1",
      "@type": "cof:Section",
      "cof:title": "56(1) Regulator must not issue the licence unless satisfied as to risk",
      "values:kind": "subsection",
      "cof:pageNumber": 55,
      "values:originalText": "(1) The Regulator must not issue the licence unless the Regulator is\nsatisfied that any risks posed by the dealings proposed to be\nauthorised by the licence are able to be managed in such a way as\nto protect:\n(a) the health and safety of people; and\n(b) the environment."
    },
