          "@id": "concept:gene-technology-act-2000-sec-5-norm"
        }
      ],
      "cml:integrityHash": "fdbef0f7e778882993840bfda310e4abd9597f748a71b62545d244269e6deda4",
      "skos:note": "Intention of Parliament regarding national scheme"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-5",
      "@type": "cof:Section",
      "cof:title": "5 Nationally consistent scheme",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "It is the intention of the Parliament that this Act form a component\nof a nationally consistent scheme for the regulation of certain\ndealings with GMOs by the Commonwealth and the States."
    },
