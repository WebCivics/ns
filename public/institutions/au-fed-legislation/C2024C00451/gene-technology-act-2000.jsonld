    {
      "@id": "concept:gene-technology-act-2000-sec-159",
      "@type": "cml:Concept",
      "skos:prefLabel": "159 Inspector must produce identity card on request",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-159"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.133",
      "values:originalText": "An inspector is not entitled to exercise any powers under this\nPart in relation to premises if:\n(a) the occupier of the premises has required the inspector to\nproduce his or her identity card for inspection by the\noccupier; and\n(b) the inspector fails to comply with the requirement.",
      "skos:definition": "An inspector is not entitled to exercise any powers under this\nPart in relation to premises if:\n(a) the occupier of the premises has required the inspector to\nproduce his or her identity card for inspection by the\noccupier; and\n(b) the inspector fails to comply with the requirement.",
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-159-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-159-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "f55758b70ae0c1a3a138e74b6b4491d1f4a8d08615b1e2d7fde32e0b6bc2c5b3",
      "skos:note": "Inspector must produce identity card on request",
      "dc:description": "Yes"
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-159",
      "@type": "cof:Section",
      "cof:title": "159 Inspector must produce identity card on request",
      "values:kind": "section",
      "cof:pageNumber": 133,
      "values:originalText": "An inspector is not entitled to exercise any powers under this\nPart in relation to premises if:\n(a) the occupier of the premises has required the inspector to\nproduce his or her identity card for inspection by the\noccupier; and\n(b) the inspector fails to comply with the requirement."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-159-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-159"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-159-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Inspection is prohibited if occupier requests identity card",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-160",
      "@type": "cml:Concept",
      "skos:prefLabel": "160 Consent",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-160"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.133",
      "values:originalText": "(1) Before obtaining the consent of a person for the purposes of\nparagraph 152(2)(a) or 154(2)(a), the inspector must inform the\nperson that he or she may refuse consent.\n(2) An entry of an inspector by virtue of the consent of a person is not\nlawful unless the person voluntarily consented to the entry.\n161  Details of warrant to be given to occupier etc.\n(1) If a warrant in relation to premises is being executed and the\noccupier of the premises or another person who apparently\nrepresents the occupier is present at the premises, the inspector\nmust make available to that person a copy of the warrant.\n(2) The inspector must identify himself or herself to that person.\n(3) The copy of the warrant referred to in subsection (1) need not\ninclude the signature of the magistrate who issued the warrant.",
      "skos:definition": "(1) Before obtaining the consent of a person for the purposes of\nparagraph 152(2)(a) or 154(2)(a), the inspector must inform the\nperson that he or she may refuse consent.\n(2) An entry of an inspector by virtue of the consent of a person is not\nlawful unless the person voluntarily consented to the entry.\n161  Details of warrant to be given to occupier etc.\n(1) If a warrant in relation to premises is being executed and the\noccupier of the premises or another person who apparently\nrepresents the occupier is present at the premises, the inspector\nmust make available to that person a copy of the warrant.\n(2) The inspector must identify himself or herself to that person.\n(3) The copy of the warrant referred to in subsection (1) need not\ninclude the signature of the magistrate who issued the warrant.",
      "cml:hasPart": [
        {
          "@id": "concept:gene-technology-act-2000-sec-160-ss-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-160-ss-2"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-160-ss-1"
