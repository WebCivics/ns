    {
      "@id": "concept:gene-technology-act-2000-sec-85",
      "@type": "cml:Concept",
      "skos:prefLabel": "85 Regulator may require applicant to give further information",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-85"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.85",
      "values:originalText": "(1) The Regulator may, by notice in writing, require an applicant for\ncertification of a facility to give the Regulator such further\ninformation in relation to the application as the Regulator requires.\n(2) The notice may specify the period within which the information is\nto be provided.",
      "skos:definition": "(1) The Regulator may, by notice in writing, require an applicant for\ncertification of a facility to give the Regulator such further\ninformation in relation to the application as the Regulator requires.\n(2) The notice may specify the period within which the information is\nto be provided.",
      "cml:hasPart": [
