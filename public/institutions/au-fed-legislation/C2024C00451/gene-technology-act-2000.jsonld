        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Regulator has the power to issue licences.",
      "cml:conclusionText": "Risk management is required."
    },
    {
      "@id": "concept:gene-technology-act-2000-sec-56-ss-1-logic-alleninterval-2",
