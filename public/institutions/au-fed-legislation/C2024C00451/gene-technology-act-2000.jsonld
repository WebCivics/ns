    {
      "@id": "concept:gene-technology-act-2000-sec-173-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "173(1) Offence-related warrants",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-173-ss-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "gene-technology-act-2000.pdf"
      },
      "dc:source": "gene-technology-act-2000.pdf, p.140",
      "values:originalText": "(1) If, in an urgent case, an inspector considers it necessary to do so,\nthe inspector may apply to a magistrate by telephone, telex, fax or\nother electronic means for a warrant under section 173 in relation\nto premises.",
      "skos:definition": "(1) If, in an urgent case, an inspector considers it necessary to do so,\nthe inspector may apply to a magistrate by telephone, telex, fax or\nother electronic means for a warrant under section 173 in relation\nto premises.",
      "values:partOf": {
        "@id": "concept:gene-technology-act-2000-sec-173"
      },
      "cml:asserts": [
        {
          "@id": "concept:gene-technology-act-2000-sec-173-ss-1-norm"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-173-ss-1-logic-deontic-1"
        },
        {
          "@id": "concept:gene-technology-act-2000-sec-173-ss-1-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "26cc62a2faf7e3daf266a652e12bd1d49f5f63cd6f31bc74ca4248b64bea86f2",
      "skos:note": "Inspector may apply for warrant under section 173 in urgent cases. An inspector may apply for a warrant under this section in relation to premises."
    },
    {
      "@id": "https://ns.webcivics.net/values/gene-technology-act-2000#sec-173-ss-1",
      "@type": "cof:Section",
      "cof:title": "173(1) Offence-related warrants",
      "values:kind": "subsection",
      "cof:pageNumber": 140,
      "values:originalText": "(1) If, in an urgent case, an inspector considers it necessary to do so,\nthe inspector may apply to a magistrate by telephone, telex, fax or\nother electronic means for a warrant under section 173 in relation\nto premises."
    },
