    {
      "@id": "concept:public-service-act-1999-sec-58-ss-8-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The report must be prepared after the consultation starts.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The consultation must start before the appointment is made.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "BEGINS",
      "cml:premiseText": "The person who is expected to be the Agency Minister must be consulted before the appointment is made."
    },
    {
      "@id": "concept:public-service-act-1999-sec-58-ss-8-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The report is a cogent and coherent piece of information.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:logicSummary": "The report is a type of artificial intelligence output.",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The report from the Secretary of the Prime Minister’s Department is generated by an AI system."
    },
    {
      "@id": "concept:public-service-act-1999-sec-58-ss-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The report must be prepared after consultation with the Commissioner and the person expected to be the Agency Minister.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The report must be prepared.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "The Secretary of the Prime Minister’s Department is required to prepare a report."
    },
    {
      "@id": "concept:public-service-act-1999-sec-58-ss-8-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The report is part of the diffusion of information about the appointment process.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::diffusion",
      "cml:logicSummary": "The report is related to the appointment process.",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "IS_A",
      "cml:premiseText": "The report from the Secretary of the Prime Minister’s Department is about the appointment of the Secretary of another Department."
    },
    {
      "@id": "concept:public-service-act-1999-sec-58-ss-8-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The report must be prepared after the consultation starts, but there is no specific deadline.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "The report can be prepared at any time after the consultation starts.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "BUT",
      "cml:premiseText": "The report from the Secretary of the Prime Minister’s Department is about the appointment of the Secretary of another Department."
    },
