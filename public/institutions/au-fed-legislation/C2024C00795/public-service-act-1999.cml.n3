concept:public-service-act-1999-sec-67 a cml:Concept ;
    skos:prefLabel "67 Appointment etc. of Head"@en ;
    cml:realizedBy doc:sec-67 ;
    values:originalText "(1) The Agency Minister of an Executive Agency may appoint a person to be the Head of the Agency for a period of up to 5 years specified in the instrument of appointment. (2) Before making the appointment, the Agency Minister must have received a report about the vacancy from a relevant Secretary. (3) The Agency Minister may, by notice in writing, terminate the appointment at any time. (4) Before terminating the appointment, the Agency Minister must have received a report about the proposed termination from a relevant Secretary. (5) In this section: relevant Secretary means the Secretary of any Department that is administered by the same Minister who is the Agency Minister of the Executive Agency." ;
    skos:definition "(1) The Agency Minister of an Executive Agency may appoint a person to be the Head of the Agency for a period of up to 5 years specified in the instrument of appointment. (2) Before making the appointment, the Agency Minister must have received a report about the vacancy from a relevant Secretary. (3) The Agency Minister may, by notice in writing, terminate the appointment at any time. (4) Before terminating the appointment, the Agency Minister must have received a report about the proposed termination from a relevant Secretary. (5) In this section: relevant Secretary means the Secretary of any Department that is administered by the same Minister who is the Agency Minister of the Executive Agency."@en ;
    cml:integrityHash "ae110c3aa0e9a5c9b4b5f1ddba5b897c50ab7b202a4a41c33a517ae64312ffcf" ;
    cof:pageNumber "67"^^xsd:integer ;
    cml:hasPart concept:public-service-act-1999-sec-67-ss-1 ;
    cml:hasPart concept:public-service-act-1999-sec-67-ss-2 ;
    cml:hasPart concept:public-service-act-1999-sec-67-ss-3 ;
    cml:hasPart concept:public-service-act-1999-sec-67-ss-4 ;
    cml:hasPart concept:public-service-act-1999-sec-67-ss-5 ;
