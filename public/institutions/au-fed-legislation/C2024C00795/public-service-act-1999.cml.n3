concept:public-service-act-1999-sec-26 a cml:Concept ;
    skos:prefLabel "26 Voluntary moves between Agencies"@en ;
    cml:realizedBy doc:sec-26 ;
    values:originalText "(1) An Agency Head may enter into an agreement in writing with an APS employee for the employee to move to the Agency Head’s Agency from another Agency. (2) Subject to Commissioner’s Directions issued under subsection 11A(1), the agreement has effect according to its terms, by force of this section." ;
    skos:definition "(1) An Agency Head may enter into an agreement in writing with an APS employee for the employee to move to the Agency Head’s Agency from another Agency. (2) Subject to Commissioner’s Directions issued under subsection 11A(1), the agreement has effect according to its terms, by force of this section."@en ;
    cml:integrityHash "cabd62c36ee9c8787ba05c32ddf09b08894524396d7697ff53fd3354013ffb6f" ;
    cof:pageNumber "27"^^xsd:integer ;
