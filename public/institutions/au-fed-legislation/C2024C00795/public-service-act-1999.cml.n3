concept:public-service-act-1999-sec-37 a cml:Concept ;
    skos:prefLabel "37 Incentive to retire"@en ;
    cml:realizedBy doc:sec-37 ;
    values:originalText "(1) An Agency Head may give a notice in writing to an SES employee in the Agency, stating that the employee will become entitled to a payment of a specified amount if the employee retires within a period specified in the notice." ;
    skos:definition "(1) An Agency Head may give a notice in writing to an SES employee in the Agency, stating that the employee will become entitled to a payment of a specified amount if the employee retires within a period specified in the notice."@en ;
