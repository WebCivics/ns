concept:public-service-act-1999-sec-30 a cml:Concept ;
    skos:prefLabel "30 Retirement"@en ;
    cml:realizedBy doc:sec-30 ;
    values:originalText "(1) An APS employee who has reached the minimum retiring age is entitled to retire at any time by notice in writing to the Agency Head. (2) The minimum retiring age is 55 years, or such higher or lower age as is prescribed by the regulations." ;
    skos:definition "(1) An APS employee who has reached the minimum retiring age is entitled to retire at any time by notice in writing to the Agency Head. (2) The minimum retiring age is 55 years, or such higher or lower age as is prescribed by the regulations."@en ;
