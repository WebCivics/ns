concept:public-service-act-1999-sec-25 a cml:Concept ;
    skos:prefLabel "25 Assignment of duties"@en ;
    cml:realizedBy doc:sec-25 ;
    values:originalText "An Agency Head may from time to time determine the duties of an APS employee in the Agency, and the place or places at which the duties are to be performed." ;
