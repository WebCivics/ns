doc:sec-23-ss-5 a cof:Section ;
    cof:title "23(5) Classification Rules" ;
    values:kind "subsection" ;
    values:originalText "(5) If a relevant industrial instrument, determination under this Act or written contract of employment contains procedures to be followed when reducing the classification, then a reduction is of no effect unless those procedures are followed." ;
    cof:pageNumber "24"^^xsd:integer .

concept:public-service-act-1999-sec-23-ss-6 a cml:Concept ;
    skos:prefLabel "23(6) Classification Rules"@en ;
    cml:realizedBy doc:sec-23-ss-6 ;
    values:originalText "(6) In this section: industrial instrument means: (a) a modern award; or (b) an enterprise agreement; or (c) a workplace determination; or (d) a WR Act transitional instrument; or (e) a transitional APCS." ;
    skos:definition "(6) In this section: industrial instrument means: (a) a modern award; or (b) an enterprise agreement; or (c) a workplace determination; or (d) a WR Act transitional instrument; or (e) a transitional APCS."@en ;
