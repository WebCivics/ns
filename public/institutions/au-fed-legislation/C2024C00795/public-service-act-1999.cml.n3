concept:public-service-act-1999-sec-40 a cml:Concept ;
    skos:prefLabel "40 Australian Public Service Commissioner"@en ;
    cml:realizedBy doc:sec-40 ;
    values:originalText "(1) There is to be an Australian Public Service Commissioner. (2) The staff necessary to assist the Commissioner must be persons engaged under this Act. (3) For the purposes of this Act: (a) the Commissioner and the APS employees assisting the Commissioner together constitute a Statutory Agency; and (b) the Commissioner is the Head of that Statutory Agency. (4) The Commissioner may, on behalf of the Commonwealth, engage consultants to assist in the performance of the Commissioner’s functions." ;
    skos:definition "(1) There is to be an Australian Public Service Commissioner. (2) The staff necessary to assist the Commissioner must be persons engaged under this Act. (3) For the purposes of this Act: (a) the Commissioner and the APS employees assisting the Commissioner together constitute a Statutory Agency; and (b) the Commissioner is the Head of that Statutory Agency. (4) The Commissioner may, on behalf of the Commonwealth, engage consultants to assist in the performance of the Commissioner’s functions."@en ;
    cml:integrityHash "f77a8fa9663fc26891bedf3ce31329d2c287b86a41b528c572eb6be6c9dfc09e" ;
    cof:pageNumber "36"^^xsd:integer ;
    cml:hasPart concept:public-service-act-1999-sec-40-ss-1 ;
    cml:hasPart concept:public-service-act-1999-sec-40-ss-2 ;
    cml:hasPart concept:public-service-act-1999-sec-40-ss-3 ;
    cml:hasPart concept:public-service-act-1999-sec-40-ss-4 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-service-act-1999.pdf> ;
    dc:source "public-service-act-1999.pdf, p.36" .
doc:sec-40 a cof:Section ;
