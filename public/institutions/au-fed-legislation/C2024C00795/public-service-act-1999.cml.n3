doc:sec-41b-ss-8 a cof:Section ;
    cof:title "41B(8) Inquiry into alleged breach of Code of Conduct by APS" ;
    values:kind "subsection" ;
    values:originalText "(8) The Commissioner must report on the results of an inquiry and determination under this section (including an inquiry that is discontinued) in relation to an APS employee, or a former APS employee, in an Agency to: (a) the Agency Head; and (b) if the Prime Minister requested the inquiry—the Prime Minister. Recommendation of sanctions" ;
    cof:pageNumber "40"^^xsd:integer .

concept:public-service-act-1999-sec-41b-ss-9 a cml:Concept ;
    skos:prefLabel "41B(9) Inquiry into alleged breach of Code of Conduct by APS"@en ;
    cml:realizedBy doc:sec-41b-ss-9 ;
    values:originalText "(9) If: (a) the Commissioner finds that an APS employee in an Agency has breached the Code of Conduct; and (b) the Commissioner is requested to recommend sanctions in respect of the breach by: (i) the Agency Head; or" ;
    skos:definition "(9) If: (a) the Commissioner finds that an APS employee in an Agency has breached the Code of Conduct; and (b) the Commissioner is requested to recommend sanctions in respect of the breach by: (i) the Agency Head; or"@en ;
    cml:integrityHash "c4e34e9d0e4a75fa5af586cc2cb95a8a918cb9e82e72b747a8dbf18cb78308c1" ;
    values:partOf concept:public-service-act-1999-sec-41b ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Commissioner must recommend sanctions if breach of Code of Conduct is found." ;
    cml:curationStatus cml:Proposed ;
