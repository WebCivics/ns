concept:public-service-act-1999-sec-61 a cml:Concept ;
    skos:prefLabel "61 Remuneration and other terms and conditions of appointment"@en ;
    cml:realizedBy doc:sec-61 ;
    values:originalText "Remuneration and allowances (1) The remuneration of a Secretary is as provided by Division 4 of Part II of the Remuneration Tribunal Act 1973. Other terms and conditions (2) The other terms and conditions applying to the appointment of a Secretary are as determined by the Remuneration Tribunal under Division 4 of Part II of the Remuneration Tribunal Act 1973." ;
    skos:definition "Remuneration and allowances (1) The remuneration of a Secretary is as provided by Division 4 of Part II of the Remuneration Tribunal Act 1973. Other terms and conditions (2) The other terms and conditions applying to the appointment of a Secretary are as determined by the Remuneration Tribunal under Division 4 of Part II of the Remuneration Tribunal Act 1973."@en ;
    cml:integrityHash "c821f4c86583848f418eb6237204d46ef3f7a31c0e8c47f1f2e936b7ab2da8e3" ;
    cof:pageNumber "63"^^xsd:integer ;
