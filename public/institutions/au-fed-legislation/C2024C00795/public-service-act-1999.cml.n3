concept:public-service-act-1999-sec-41a-ss-3 a cml:Concept ;
    skos:prefLabel "41A(3) Inquiry into alleged breach of Code of Conduct by Agency"@en ;
    cml:realizedBy doc:sec-41a-ss-3 ;
