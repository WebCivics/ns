concept:public-service-act-1999-sec-61a a cml:Concept ;
    skos:prefLabel "61A Annual performance review"@en ;
    cml:realizedBy doc:sec-61a ;
    values:originalText "An annual review of the performance of a Secretary must be carried out in accordance with a framework established by the Secretary of the Prime Minister’s Department and the Commissioner." ;
    skos:definition "An annual review of the performance of a Secretary must be carried out in accordance with a framework established by the Secretary of the Prime Minister’s Department and the Commissioner."@en ;
