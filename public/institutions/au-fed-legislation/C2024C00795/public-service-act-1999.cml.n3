concept:public-service-act-1999-sec-19 a cml:Concept ;
    skos:prefLabel "19 Limitation on Ministerial directions to Agency Head"@en ;
    cml:realizedBy doc:sec-19 ;
    values:originalText "A Minister must not direct an Agency Head in relation to the exercise of powers by the Agency Head under section 15 or Division 1 or 2 of Part 4 in relation to particular individuals." ;
