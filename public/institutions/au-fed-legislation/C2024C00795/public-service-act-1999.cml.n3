concept:public-service-act-1999-sec-48b a cml:Concept ;
    skos:prefLabel "48B Remuneration and other terms and conditions of appointment"@en ;
    cml:realizedBy doc:sec-48b ;
    values:originalText "Remuneration and allowances (1) A Special Commissioner is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, a Special Commissioner is to be paid the remuneration that is prescribed by the regulations. (2) A Special Commissioner is to be paid the allowances that are prescribed by the regulations. (3) Subsections (1) and (2) have effect subject to the Remuneration Tribunal Act 1973." ;
    skos:definition "Remuneration and allowances (1) A Special Commissioner is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, a Special Commissioner is to be paid the remuneration that is prescribed by the regulations. (2) A Special Commissioner is to be paid the allowances that are prescribed by the regulations. (3) Subsections (1) and (2) have effect subject to the Remuneration Tribunal Act 1973."@en ;
    cml:integrityHash "c821f4c86583848f418eb6237204d46ef3f7a31c0e8c47f1f2e936b7ab2da8e3" ;
    cof:pageNumber "51"^^xsd:integer ;
    cml:hasPart concept:public-service-act-1999-sec-48b-ss-1 ;
    cml:hasPart concept:public-service-act-1999-sec-48b-ss-2 ;
    cml:hasPart concept:public-service-act-1999-sec-48b-ss-3 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-service-act-1999.pdf> ;
    dc:source "public-service-act-1999.pdf, p.51" .
