concept:public-service-act-1999-sec-20 a cml:Concept ;
    skos:prefLabel "20 Employer powers etc. of Agency Head"@en ;
    cml:realizedBy doc:sec-20 ;
    values:originalText "(1) An Agency Head, on behalf of the Commonwealth, has all the rights, duties and powers of an employer in respect of APS employees in the Agency. (2) Without limiting subsection (1), an Agency Head has, in respect of APS employees in the Agency, the rights, duties and powers that are prescribed by the regulations." ;
    skos:definition "(1) An Agency Head, on behalf of the Commonwealth, has all the rights, duties and powers of an employer in respect of APS employees in the Agency. (2) Without limiting subsection (1), an Agency Head has, in respect of APS employees in the Agency, the rights, duties and powers that are prescribed by the regulations."@en ;
    cml:integrityHash "a3f5fc75170cf2fa4daa2c739568ffcc2d5331090117ee191d2332bc5f07f336" ;
    cof:pageNumber "23"^^xsd:integer ;
