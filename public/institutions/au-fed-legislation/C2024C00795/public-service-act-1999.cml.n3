concept:public-service-act-1999-sec-62 a cml:Concept ;
    skos:prefLabel "62 Acting Secretary"@en ;
    cml:realizedBy doc:sec-62 ;
    values:originalText "The Prime Minister may appoint a person to act as the Secretary of a Department: (a) if there is a vacancy in the office of Secretary, whether or not an appointment has previously been made to the office; or (b) during any period, or during all periods, when the Secretary is absent from duty or from Australia or is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see section 33A of the Acts Interpretation Act 1901." ;
    skos:definition "The Prime Minister may appoint a person to act as the Secretary of a Department: (a) if there is a vacancy in the office of Secretary, whether or not an appointment has previously been made to the office; or (b) during any period, or during all periods, when the Secretary is absent from duty or from Australia or is, for any reason, unable to perform the duties of the office. Note: For rules that apply to acting appointments, see section 33A of the Acts Interpretation Act 1901."@en ;
    cml:integrityHash "db64f47f6ae4291f6c020fa8025531e5c747e1a5215fd8fe00ca1a573da02f19" ;
    cof:pageNumber "63"^^xsd:integer ;
    skos:note "Appoint acting Secretary under certain circumstances." ;
    dc:references "sec-33A" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
