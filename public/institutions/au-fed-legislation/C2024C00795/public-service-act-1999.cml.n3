concept:public-service-act-1999-sec-45 a cml:Concept ;
    skos:prefLabel "45 Appointment of Commissioner"@en ;
    cml:realizedBy doc:sec-45 ;
    values:originalText "The Commissioner is to be appointed by the Governor-General on a full-time basis for a period of up to 5 years specified in the instrument of appointment." ;
