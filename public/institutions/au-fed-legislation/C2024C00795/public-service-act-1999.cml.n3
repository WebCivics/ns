concept:public-service-act-1999-sec-68 a cml:Concept ;
    skos:prefLabel "68 Remuneration and other terms and conditions of appointment"@en ;
    cml:realizedBy doc:sec-68 ;
    values:originalText "Remuneration and allowances (1) The Head of an Executive Agency is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the Head of the Executive Agency is to be paid the remuneration that is prescribed by the regulations. (2) The Head of an Executive Agency is to be paid the allowances that are prescribed by the regulations." ;
    skos:definition "Remuneration and allowances (1) The Head of an Executive Agency is to be paid the remuneration that is determined by the Remuneration Tribunal. If no determination of that remuneration by the Tribunal is in operation, the Head of the Executive Agency is to be paid the remuneration that is prescribed by the regulations. (2) The Head of an Executive Agency is to be paid the allowances that are prescribed by the regulations."@en ;
    cml:integrityHash "c821f4c86583848f418eb6237204d46ef3f7a31c0e8c47f1f2e936b7ab2da8e3" ;
    cof:pageNumber "67"^^xsd:integer ;
    cml:hasPart concept:public-service-act-1999-sec-68-ss-1 ;
    cml:hasPart concept:public-service-act-1999-sec-68-ss-2 ;
    cml:curationStatus cml:Proposed ;
