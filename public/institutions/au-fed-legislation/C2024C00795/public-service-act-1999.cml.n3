doc:sec-41b-ss-1 a cof:Section ;
    cof:title "41B(1) Inquiry into alleged breach of Code of Conduct by APS" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commissioner may, for the purposes of paragraph 41(2)(n), inquire into and determine whether an APS employee, or a former APS employee, in an Agency has breached the Code of Conduct if: (a) the Agency Head or the Prime Minister requests the Commissioner to do so; and (b) the Commissioner considers it would be appropriate to do so." ;
    cof:pageNumber "40"^^xsd:integer .

concept:public-service-act-1999-sec-41b-ss-2 a cml:Concept ;
    skos:prefLabel "41B(2) Inquiry into alleged breach of Code of Conduct by APS"@en ;
    cml:realizedBy doc:sec-41b-ss-2 ;
    values:originalText "(2) The Prime Minister may make a request under paragraph (1)(a) in relation to an alleged breach of the Code of Conduct of which the Prime Minister has become aware as a result of, or in the course of, a systems review or a special review. Procedures for inquiry" ;
    skos:definition "(2) The Prime Minister may make a request under paragraph (1)(a) in relation to an alleged breach of the Code of Conduct of which the Prime Minister has become aware as a result of, or in the course of, a systems review or a special review. Procedures for inquiry"@en ;
    cml:integrityHash "9b8f27a6c3b62082ee7cf45c9d495774d6ce573dc7f8e9196b0b22caef1f9315" ;
    values:partOf concept:public-service-act-1999-sec-41b ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Request for inquiry into alleged breach of Code of Conduct" ;
    cml:curationStatus cml:Proposed ;
