doc:sec-78b-ss-1 a cof:Section ;
    cof:title "78B(1) Australian Public Service Employee Census—results and action" ;
    values:kind "subsection" ;
    values:originalText "(1) This section applies if a survey known as an Australian Public Service Employee Census is conducted in a financial year. Preparation of action plan" ;
    cof:pageNumber "87"^^xsd:integer .

concept:public-service-act-1999-sec-78b-ss-2 a cml:Concept ;
    skos:prefLabel "78B(2) Australian Public Service Employee Census—results and action"@en ;
    cml:realizedBy doc:sec-78b-ss-2 ;
