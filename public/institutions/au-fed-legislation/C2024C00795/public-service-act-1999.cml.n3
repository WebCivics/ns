doc:sec-67-ss-3 a cof:Section ;
    cof:title "67(3) Appointment etc. of Head" ;
    values:kind "subsection" ;
    values:originalText "(3) The Agency Minister may, by notice in writing, terminate the appointment at any time." ;
    cof:pageNumber "67"^^xsd:integer .

