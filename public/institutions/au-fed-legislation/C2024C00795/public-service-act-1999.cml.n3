concept:public-service-act-1999-sec-52 a cml:Concept ;
    skos:prefLabel "52 Appointment of Merit Protection Commissioner"@en ;
    cml:realizedBy doc:sec-52 ;
    values:originalText "The Merit Protection Commissioner is to be appointed by the Governor-General on a full-time basis for a period of up to 5 years specified in the instrument of appointment." ;
    skos:definition "The Merit Protection Commissioner is to be appointed by the Governor-General on a full-time basis for a period of up to 5 years specified in the instrument of appointment."@en ;
