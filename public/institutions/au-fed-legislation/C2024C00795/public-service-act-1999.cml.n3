concept:public-service-act-1999-sec-27 a cml:Concept ;
    skos:prefLabel "27 Compulsory moves between Agencies"@en ;
    cml:realizedBy doc:sec-27 ;
    values:originalText "(1) The Commissioner may, by direction in writing, move an excess APS employee to another Agency, without anyone’s consent. (2) For the purposes of this section, an APS employee is an excess APS employee if, and only if, the Agency Head has notified the Commissioner in writing that the employee is excess to the requirements of the Agency." ;
    skos:definition "(1) The Commissioner may, by direction in writing, move an excess APS employee to another Agency, without anyone’s consent. (2) For the purposes of this section, an APS employee is an excess APS employee if, and only if, the Agency Head has notified the Commissioner in writing that the employee is excess to the requirements of the Agency."@en ;
    cml:integrityHash "e1c8396fee2bbd04ebd190f035b23503c9de04ad442b9d43f7a1d6e8b6692709" ;
    cof:pageNumber "28"^^xsd:integer ;
    cml:hasPart concept:public-service-act-1999-sec-27-ss-1 ;
    cml:hasPart concept:public-service-act-1999-sec-27-ss-2 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-service-act-1999.pdf> ;
    dc:source "public-service-act-1999.pdf, p.28" .
