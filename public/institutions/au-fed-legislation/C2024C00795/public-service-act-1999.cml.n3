concept:public-service-act-1999-sec-38 a cml:Concept ;
    skos:prefLabel "38 Commissioner’s certificate required for termination of SES"@en ;
    cml:realizedBy doc:sec-38 ;
    values:originalText "employment An Agency Head cannot terminate the employment of an SES employee unless the Commissioner has issued a certificate stating that: (a) all relevant requirements of Commissioner’s Directions made under subsection 11A(1) have been satisfied in respect of the proposed termination; and (b) the Commissioner is of the opinion that the termination is in the public interest.   APS employees  Part 4 Heads of Mission  Division 3 Section 39 Public Service Act 1999 Compilation date: 11/12/2024" ;
    skos:definition "employment An Agency Head cannot terminate the employment of an SES employee unless the Commissioner has issued a certificate stating that: (a) all relevant requirements of Commissioner’s Directions made under subsection 11A(1) have been satisfied in respect of the proposed termination; and (b) the Commissioner is of the opinion that the termination is in the public interest.   APS employees  Part 4 Heads of Mission  Division 3 Section 39 Public Service Act 1999 Compilation date: 11/12/2024"@en ;
    cml:integrityHash "fd547de232b42d1fdcc0cf56fb2249cf303f710effcb588c6f89324c4a9d5b71" ;
    cof:pageNumber "34"^^xsd:integer ;
    skos:note "Commissioner's certificate required for termination of SES employee" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <public-service-act-1999.pdf> ;
    dc:source "public-service-act-1999.pdf, p.34" ;
