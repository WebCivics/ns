concept:public-service-act-1999-sec-10-ss-6 a cml:Concept ;
    skos:prefLabel "10(6) APS Values"@en ;
    cml:realizedBy doc:sec-10-ss-6 ;
    values:originalText "(6) The APS builds its capability and institutional knowledge, and supports the public interest now and into the future, by understanding the long-term impacts of what it does." ;
