    values:partOf concept:public-service-act-1999-sec-24 ;
    cof:pageNumber "26"^^xsd:integer ;
    skos:note "Overrules certain determinations and standards in case of inconsistency." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
