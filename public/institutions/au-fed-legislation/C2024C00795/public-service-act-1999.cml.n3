concept:public-service-act-1999-sec-2 a cml:Concept ;
    skos:prefLabel "2 Commencement"@en ;
    cml:realizedBy doc:sec-2 ;
    values:originalText "(1) Subject to subsection (2), this Act commences on a day to be fixed by Proclamation. (2) If this Act does not commence under subsection (1) within the period of 6 months beginning on the day on which it receives the Royal Assent, it commences on the first day after the end of that period." ;
    skos:definition "(1) Subject to subsection (2), this Act commences on a day to be fixed by Proclamation. (2) If this Act does not commence under subsection (1) within the period of 6 months beginning on the day on which it receives the Royal Assent, it commences on the first day after the end of that period."@en ;
    cml:integrityHash "4de5f3508234f4c70a8a8b87b774e9e5920d7c0db9de0332d9708b627d9b5376" ;
    cof:pageNumber "7"^^xsd:integer ;
