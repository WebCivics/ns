concept:public-service-act-1999-sec-78-ss-11 a cml:Concept ;
    skos:prefLabel "78(11) Delegations"@en ;
    cml:realizedBy doc:sec-78-ss-11 ;
    values:originalText "(11) A person exercising powers or functions under a delegation under this section must comply with any directions of the person who delegated the power or function." ;
