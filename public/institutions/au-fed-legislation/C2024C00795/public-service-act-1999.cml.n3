concept:public-service-act-1999-sec-58-ss-8 a cml:Concept ;
    skos:prefLabel "58(8) Appointment"@en ;
    cml:realizedBy doc:sec-58-ss-8 ;
    values:originalText "(8) The report from the Secretary of the Prime Minister’s Department about the appointment of the Secretary of another Department must: (a) be prepared after consultation with: (i) the Commissioner; and (ii) the person who is expected to be the Agency Minister of the other Department at the time the appointment is made; and" ;
    skos:definition "(8) The report from the Secretary of the Prime Minister’s Department about the appointment of the Secretary of another Department must: (a) be prepared after consultation with: (i) the Commissioner; and (ii) the person who is expected to be the Agency Minister of the other Department at the time the appointment is made; and"@en ;
    cml:integrityHash "74f53ffaf830f0af9df8cfaa62e698d63035e68b6dc6be7f4824fe432bc404a4" ;
