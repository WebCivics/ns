concept:public-service-act-1999-sec-78b-ss-3 a cml:Concept ;
    skos:prefLabel "78B(3) Australian Public Service Employee Census—results and action"@en ;
    cml:realizedBy doc:sec-78b-ss-3 ;
    values:originalText "(3) The Agency Head must: (a) publish: (i) the census results, so far as those results relate to the Agency; and (ii) the action plan prepared by the Agency Head under subsection (2); and (b) do so as soon as practicable after the first day on which a copy of the State of the Service report for the financial year is laid before a House of the Parliament. Exemptions" ;
    skos:definition "(3) The Agency Head must: (a) publish: (i) the census results, so far as those results relate to the Agency; and (ii) the action plan prepared by the Agency Head under subsection (2); and (b) do so as soon as practicable after the first day on which a copy of the State of the Service report for the financial year is laid before a House of the Parliament. Exemptions"@en ;
    cml:integrityHash "dda3b60202c649807aa7a0d7f6d1220fcab37762fc02575f223eba781ca9e83c" ;
    values:partOf concept:public-service-act-1999-sec-78b ;
    cof:pageNumber "87"^^xsd:integer ;
    skos:note "Publish census results and action plan within a specified timeframe." ;
    dc:description "Yes" ;
