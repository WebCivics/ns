    cml:hasPart concept:public-service-act-1999-sec-41b-ss-6 ;
    cml:hasPart concept:public-service-act-1999-sec-41b-ss-7 ;
    cml:hasPart concept:public-service-act-1999-sec-41b-ss-8 ;
    cml:hasPart concept:public-service-act-1999-sec-41b-ss-9 ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
