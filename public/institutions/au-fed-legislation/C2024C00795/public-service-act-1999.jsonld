    {
      "@id": "concept:public-service-act-1999-sec-11a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "11A(2) Commissioner’s Directions about employment matters",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-11a-ss-2"
      },
      "cml:curationStatus": {
