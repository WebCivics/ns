        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(i) professional or specialist expertise;"
    },
    {
      "@id": "concept:public-service-act-1999-sec-35-ss-3-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "hasValue",
      "cml:logicSummary": "Classifies SES employee's role",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) provides one or more of the following at a high level:"
    },
    {
      "@id": "concept:public-service-act-1999-sec-35-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Mandatory promotion of cooperation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) promotes cooperation within and between Agencies,"
    },
    {
      "@id": "concept:public-service-act-1999-sec-35-ss-3-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "hasValue",
      "cml:logicSummary": "Classifies SES employee's responsibility",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) by personal example and other appropriate means, promotes the APS Values, the APS Employment Principles and compliance with the Code of Conduct."
    },
    {
      "@id": "concept:public-service-act-1999-sec-35-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:logicSummary": "Mandatory promotion of APS values",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) by personal example and other appropriate means, promotes the APS Values, the APS Employment Principles and compliance with the Code of Conduct."
    },
    {
      "@id": "concept:public-service-act-1999-sec-35-ss-3-logic-alleninterval-6",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal relationship between provision and promotion",
      "cml:executionSurface": "modalities::interval_reasoning",
