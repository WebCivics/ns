    },
    {
      "@id": "concept:public-service-act-1999-sec-55",
      "@type": "cml:Concept",
      "skos:prefLabel": "55 Acting Merit Protection Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-55"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.58",
      "values:originalText": "The Public Service Minister may appoint a person to act as Merit\nProtection Commissioner:\n(a) if there is a vacancy in the office of Merit Protection\nCommissioner, whether or not an appointment has previously\nbeen made to the office; or\n(b) during any period, or during all periods, when the Merit\nProtection Commissioner is absent from duty or from\nAustralia or is, for any reason, unable to perform the duties\nof the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\n\nSecretaries of Departments  Part 7\n\nSection 56\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "skos:definition": "The Public Service Minister may appoint a person to act as Merit\nProtection Commissioner:\n(a) if there is a vacancy in the office of Merit Protection\nCommissioner, whether or not an appointment has previously\nbeen made to the office; or\n(b) during any period, or during all periods, when the Merit\nProtection Commissioner is absent from duty or from\nAustralia or is, for any reason, unable to perform the duties\nof the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\n\nSecretaries of Departments  Part 7\n\nSection 56\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-55-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-55-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "fb18b20e6023a05bf55c29312d3a0464c34d2523033346a2f95b3d1637afe289",
      "skos:note": "Appoint acting Merit Protection Commissioner under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-55",
      "@type": "cof:Section",
      "cof:title": "55 Acting Merit Protection Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 58,
      "values:originalText": "The Public Service Minister may appoint a person to act as Merit\nProtection Commissioner:\n(a) if there is a vacancy in the office of Merit Protection\nCommissioner, whether or not an appointment has previously\nbeen made to the office; or\n(b) during any period, or during all periods, when the Merit\nProtection Commissioner is absent from duty or from\nAustralia or is, for any reason, unable to perform the duties\nof the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\n\nSecretaries of Departments  Part 7\n\nSection 56\nPublic Service Act 1999\nCompilation date: 11/12/2024"
    },
    {
      "@id": "concept:public-service-act-1999-sec-55-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-55"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-55-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Public Service Minister has the power to appoint.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-56",
      "@type": "cml:Concept",
      "skos:prefLabel": "56 Creation of offices of Secretary",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-56"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.59",
      "values:originalText": "(1) On the establishment of a Department, an office of Secretary of\nthat Department is established by force of this subsection.\n(2) On the abolition of a Department, the office of Secretary of that\nDepartment is abolished by force of this subsection.\n(3) The Prime Minister may allocate a name to any office of Secretary,\nand may change the name from time to time.\n(4) Subject to subsection (3), the name of the office of Secretary of a\nDepartment is “Secretary of the [name of Department]”.",
      "skos:definition": "(1) On the establishment of a Department, an office of Secretary of\nthat Department is established by force of this subsection.\n(2) On the abolition of a Department, the office of Secretary of that\nDepartment is abolished by force of this subsection.\n(3) The Prime Minister may allocate a name to any office of Secretary,\nand may change the name from time to time.\n(4) Subject to subsection (3), the name of the office of Secretary of a\nDepartment is “Secretary of the [name of Department]”.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-56-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-56-ss-2"
        },
        {
          "@id": "concept:public-service-act-1999-sec-56-ss-3"
        },
        {
          "@id": "concept:public-service-act-1999-sec-56-ss-4"
        }
      ],
      "cml:integrityHash": "2c71a22579596f71947444fd8b1bdda1c3c8cc4439f6a5a61730b2edd778405e"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-56",
      "@type": "cof:Section",
      "cof:title": "56 Creation of offices of Secretary",
      "values:kind": "section",
      "cof:pageNumber": 59,
      "values:originalText": "(1) On the establishment of a Department, an office of Secretary of\nthat Department is established by force of this subsection.\n(2) On the abolition of a Department, the office of Secretary of that\nDepartment is abolished by force of this subsection.\n(3) The Prime Minister may allocate a name to any office of Secretary,\nand may change the name from time to time.\n(4) Subject to subsection (3), the name of the office of Secretary of a\nDepartment is “Secretary of the [name of Department]”."
    },
