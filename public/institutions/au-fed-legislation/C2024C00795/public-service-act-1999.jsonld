      "cml:operator": "during",
      "cml:logicSummary": "Establishes temporal relationship between SES and its employees",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The Senior Executive Service consists of the SES employees.",
      "cml:conclusionText": "The employee is part of the SES during their employment."
    },
    {
      "@id": "concept:public-service-act-1999-sec-35-ss-1-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "∴",
      "cml:logicSummary": "Establishes logical connection between SES and its employees",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The Senior Executive Service consists of the SES employees.",
      "cml:conclusionText": "The employee is part of the SES because they are SES employees."
    },
    {
      "@id": "concept:public-service-act-1999-sec-35-ss-1-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
