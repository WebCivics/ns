    {
      "@id": "concept:public-service-act-1999-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Appointment of Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.49",
      "values:originalText": "The Commissioner is to be appointed by the Governor-General on\na full-time basis for a period of up to 5 years specified in the\ninstrument of appointment.",
      "skos:definition": "The Commissioner is to be appointed by the Governor-General on\na full-time basis for a period of up to 5 years specified in the\ninstrument of appointment.",
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-45-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-45-logic-deontic-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-45-logic-alleninterval-2"
        },
        {
          "@id": "concept:public-service-act-1999-sec-45-logic-deontic-3"
        }
      ],
      "cml:integrityHash": "90757acd4827b2654aaab6ffe9d4f0226c5b4e76e7c192958bb2bbc1c5293be3",
      "skos:note": "The Commissioner is appointed by the Governor-General."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Appointment of Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 49,
      "values:originalText": "The Commissioner is to be appointed by the Governor-General on\na full-time basis for a period of up to 5 years specified in the\ninstrument of appointment."
    },
    {
      "@id": "concept:public-service-act-1999-sec-45-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-45"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-45-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Describes the appointment process.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Commissioner is to be appointed by the Governor-General on a full-time basis for a period of up to 5 years specified in the instrument of appointment.",
      "cml:conclusionText": "The Governor-General has the power to appoint the Commissioner."
    },
    {
      "@id": "concept:public-service-act-1999-sec-45-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Specifies the duration of the Commissioner's appointment.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "for a period of up to 5 years specified in the instrument of appointment.",
      "cml:conclusionText": "The Commissioner's appointment is for a maximum of 5 years."
    },
    {
      "@id": "concept:public-service-act-1999-sec-45-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Describes the basis of the Commissioner's appointment.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "on a full-time basis",
      "cml:conclusionText": "The Commissioner must work full-time."
    },
    {
      "@id": "concept:public-service-act-1999-sec-46",
      "@type": "cml:Concept",
      "skos:prefLabel": "46 Remuneration and other terms and conditions of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-46"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.49",
      "values:originalText": "Remuneration and allowances\n(1) The Commissioner is to be paid the remuneration that is\ndetermined by the Remuneration Tribunal. If no determination of\nthat remuneration by the Tribunal is in operation, the\nCommissioner is to be paid the remuneration that is prescribed by\nthe regulations.\n(2) The Commissioner is to be paid the allowances that are prescribed\nby the regulations.\n(3) Subsections (1) and (2) have effect subject to the Remuneration\nTribunal Act 1973.\nLeave of absence\n(4) The Commissioner has the recreation leave entitlements that are\ndetermined by the Remuneration Tribunal.\n(5) The Agency Minister may grant the Commissioner leave of\nabsence, other than recreation leave, on the terms and conditions as\nto remuneration or otherwise that the Agency Minister determines.\nOther terms and conditions\n(6) The Commissioner holds office on the terms and conditions (if\nany) in relation to matters not covered by this Act that are\ndetermined by the Agency Minister.",
      "skos:definition": "Remuneration and allowances\n(1) The Commissioner is to be paid the remuneration that is\ndetermined by the Remuneration Tribunal. If no determination of\nthat remuneration by the Tribunal is in operation, the\nCommissioner is to be paid the remuneration that is prescribed by\nthe regulations.\n(2) The Commissioner is to be paid the allowances that are prescribed\nby the regulations.\n(3) Subsections (1) and (2) have effect subject to the Remuneration\nTribunal Act 1973.\nLeave of absence\n(4) The Commissioner has the recreation leave entitlements that are\ndetermined by the Remuneration Tribunal.\n(5) The Agency Minister may grant the Commissioner leave of\nabsence, other than recreation leave, on the terms and conditions as\nto remuneration or otherwise that the Agency Minister determines.\nOther terms and conditions\n(6) The Commissioner holds office on the terms and conditions (if\nany) in relation to matters not covered by this Act that are\ndetermined by the Agency Minister.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-46-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-46-ss-2"
