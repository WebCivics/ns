      "cml:integrityHash": "7442c48930f80be9fd1ad818b3ea8ce7b6fa0162baa24b1c707863dd3784b202",
      "skos:note": "Agency Heads must implement measures to create a work environment enabling APS employee decisions."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-19a-ss-1",
      "@type": "cof:Section",
      "cof:title": "19A(1) Agency Heads to implement measures to create a work",
      "values:kind": "subsection",
      "cof:pageNumber": 22,
      "values:originalText": "(1) The Agency Head of an Agency must implement measures that\ncreate a work environment within the Agency that enables\ndecisions to be made by APS employees with classifications that\nthe Agency Head considers are the lowest appropriate for those\ndecisions."
    },
