    {
      "@id": "concept:public-service-act-1999-sec-51",
      "@type": "cml:Concept",
      "skos:prefLabel": "51 Annual report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-51"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
