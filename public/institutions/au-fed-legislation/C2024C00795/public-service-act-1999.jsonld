      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-60",
      "@type": "cml:Concept",
      "skos:prefLabel": "60 Engagement of former Secretaries",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-60"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.62",
      "values:originalText": "At any time after the appointment of a Secretary is terminated\nunder section 56 or 59, the Prime Minister, on behalf of the\nCommonwealth, may engage the former Secretary to perform\n\n\nSecretaries of Departments  Part 7\n\nSection 61\nPublic Service Act 1999\nCompilation date: 11/12/2024\nspecified duties (otherwise than as an APS employee), on terms\nand conditions determined by the Prime Minister.",
      "skos:definition": "At any time after the appointment of a Secretary is terminated\nunder section 56 or 59, the Prime Minister, on behalf of the\nCommonwealth, may engage the former Secretary to perform\n\n\nSecretaries of Departments  Part 7\n\nSection 61\nPublic Service Act 1999\nCompilation date: 11/12/2024\nspecified duties (otherwise than as an APS employee), on terms\nand conditions determined by the Prime Minister.",
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-60-norm"
        }
      ],
      "cml:integrityHash": "754df54a4fc8d49963830485668efa87fea6a0e9766df00d9d1e12df3e56c462",
      "skos:note": "Former Secretary may be engaged to perform specified duties"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-60",
      "@type": "cof:Section",
      "cof:title": "60 Engagement of former Secretaries",
      "values:kind": "section",
      "cof:pageNumber": 62,
      "values:originalText": "At any time after the appointment of a Secretary is terminated\nunder section 56 or 59, the Prime Minister, on behalf of the\nCommonwealth, may engage the former Secretary to perform\n\n\nSecretaries of Departments  Part 7\n\nSection 61\nPublic Service Act 1999\nCompilation date: 11/12/2024\nspecified duties (otherwise than as an APS employee), on terms\nand conditions determined by the Prime Minister."
    },
    {
      "@id": "concept:public-service-act-1999-sec-60-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
