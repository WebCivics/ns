      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.64",
      "values:originalText": "(3B) The Public Service Minister must cause a copy of a long-term\ninsights report to be tabled in each House of the Parliament within\n15 sitting days of that House after the report is given to the\nMinister.",
      "skos:definition": "(3B) The Public Service Minister must cause a copy of a long-term\ninsights report to be tabled in each House of the Parliament within\n15 sitting days of that House after the report is given to the\nMinister.",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-64a"
