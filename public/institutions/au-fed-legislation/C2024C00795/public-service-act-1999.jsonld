    {
      "@id": "concept:public-service-act-1999-sec-22",
      "@type": "cml:Concept",
      "skos:prefLabel": "22 Engagement of APS employees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-22"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.23",
      "values:originalText": "(1) An Agency Head, on behalf of the Commonwealth, may engage\npersons as employees for the purposes of the Agency.\n(2) The engagement of an APS employee (including an engagement\nunder section 72) must be:\n(a) as an ongoing APS employee; or\n(b) for a specified term or for the duration of a specified task; or\n(c) for duties that are irregular or intermittent.",
      "skos:definition": "(1) An Agency Head, on behalf of the Commonwealth, may engage\npersons as employees for the purposes of the Agency.\n(2) The engagement of an APS employee (including an engagement\nunder section 72) must be:\n(a) as an ongoing APS employee; or\n(b) for a specified term or for the duration of a specified task; or\n(c) for duties that are irregular or intermittent.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-22-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-22-ss-2"
        }
      ],
      "cml:integrityHash": "4d1446611631b7401155c71b702ce46a009fb9c64a1cbc6fed0c028f8d8f70f8"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-22",
      "@type": "cof:Section",
      "cof:title": "22 Engagement of APS employees",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "(1) An Agency Head, on behalf of the Commonwealth, may engage\npersons as employees for the purposes of the Agency.\n(2) The engagement of an APS employee (including an engagement\nunder section 72) must be:\n(a) as an ongoing APS employee; or\n(b) for a specified term or for the duration of a specified task; or\n(c) for duties that are irregular or intermittent."
    },
