        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-73-ss-5-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibition",
      "cml:logicSummary": "Payment recovery upon condition breach",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Condition is breached",
      "cml:conclusionText": "Payment may be recovered"
    },
    {
      "@id": "concept:public-service-act-1999-sec-74",
      "@type": "cml:Concept",
      "skos:prefLabel": "74 Locally engaged employees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-74"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.83",
      "values:originalText": "(1) An Agency Head, on behalf of the Commonwealth, may engage\npersons overseas to perform duties overseas as employees.\n(2) Subject to this Act, an Agency Head, on behalf of the\nCommonwealth, has all the rights, duties and powers of an\nemployer in respect of locally engaged employees in the Agency.\n(3) An Agency Head is not subject to direction by any Minister in\nrelation to the exercise of powers by the Agency Head under this\nsection in relation to particular individuals.\n(4) This section does not, by implication, limit any other power of an\nAgency Head to engage persons to work overseas.",
      "skos:definition": "(1) An Agency Head, on behalf of the Commonwealth, may engage\npersons overseas to perform duties overseas as employees.\n(2) Subject to this Act, an Agency Head, on behalf of the\nCommonwealth, has all the rights, duties and powers of an\nemployer in respect of locally engaged employees in the Agency.\n(3) An Agency Head is not subject to direction by any Minister in\nrelation to the exercise of powers by the Agency Head under this\nsection in relation to particular individuals.\n(4) This section does not, by implication, limit any other power of an\nAgency Head to engage persons to work overseas.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-74-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-74-ss-2"
        },
        {
          "@id": "concept:public-service-act-1999-sec-74-ss-3"
        },
        {
          "@id": "concept:public-service-act-1999-sec-74-ss-4"
        }
      ],
      "cml:integrityHash": "2c85d302d1e2de7a9ca6f7858f09d8667f7aece8fa86a24354e56fa4c79e4f8e"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-74",
      "@type": "cof:Section",
      "cof:title": "74 Locally engaged employees",
      "values:kind": "section",
      "cof:pageNumber": 83,
      "values:originalText": "(1) An Agency Head, on behalf of the Commonwealth, may engage\npersons overseas to perform duties overseas as employees.\n(2) Subject to this Act, an Agency Head, on behalf of the\nCommonwealth, has all the rights, duties and powers of an\nemployer in respect of locally engaged employees in the Agency.\n(3) An Agency Head is not subject to direction by any Minister in\nrelation to the exercise of powers by the Agency Head under this\nsection in relation to particular individuals.\n(4) This section does not, by implication, limit any other power of an\nAgency Head to engage persons to work overseas."
    },
