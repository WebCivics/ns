    {
      "@id": "concept:public-service-act-1999-sec-67",
      "@type": "cml:Concept",
      "skos:prefLabel": "67 Appointment etc. of Head",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-67"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.67",
      "values:originalText": "(1) The Agency Minister of an Executive Agency may appoint a\nperson to be the Head of the Agency for a period of up to 5 years\nspecified in the instrument of appointment.\n(2) Before making the appointment, the Agency Minister must have\nreceived a report about the vacancy from a relevant Secretary.\n(3) The Agency Minister may, by notice in writing, terminate the\nappointment at any time.\n(4) Before terminating the appointment, the Agency Minister must\nhave received a report about the proposed termination from a\nrelevant Secretary.\n(5) In this section:\nrelevant Secretary means the Secretary of any Department that is\nadministered by the same Minister who is the Agency Minister of\nthe Executive Agency.",
      "skos:definition": "(1) The Agency Minister of an Executive Agency may appoint a\nperson to be the Head of the Agency for a period of up to 5 years\nspecified in the instrument of appointment.\n(2) Before making the appointment, the Agency Minister must have\nreceived a report about the vacancy from a relevant Secretary.\n(3) The Agency Minister may, by notice in writing, terminate the\nappointment at any time.\n(4) Before terminating the appointment, the Agency Minister must\nhave received a report about the proposed termination from a\nrelevant Secretary.\n(5) In this section:\nrelevant Secretary means the Secretary of any Department that is\nadministered by the same Minister who is the Agency Minister of\nthe Executive Agency.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-67-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-67-ss-2"
        },
        {
          "@id": "concept:public-service-act-1999-sec-67-ss-3"
        },
        {
          "@id": "concept:public-service-act-1999-sec-67-ss-4"
        },
        {
          "@id": "concept:public-service-act-1999-sec-67-ss-5"
        }
      ],
      "cml:integrityHash": "ae110c3aa0e9a5c9b4b5f1ddba5b897c50ab7b202a4a41c33a517ae64312ffcf"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-67",
      "@type": "cof:Section",
      "cof:title": "67 Appointment etc. of Head",
      "values:kind": "section",
      "cof:pageNumber": 67,
      "values:originalText": "(1) The Agency Minister of an Executive Agency may appoint a\nperson to be the Head of the Agency for a period of up to 5 years\nspecified in the instrument of appointment.\n(2) Before making the appointment, the Agency Minister must have\nreceived a report about the vacancy from a relevant Secretary.\n(3) The Agency Minister may, by notice in writing, terminate the\nappointment at any time.\n(4) Before terminating the appointment, the Agency Minister must\nhave received a report about the proposed termination from a\nrelevant Secretary.\n(5) In this section:\nrelevant Secretary means the Secretary of any Department that is\nadministered by the same Minister who is the Agency Minister of\nthe Executive Agency."
    },
    {
