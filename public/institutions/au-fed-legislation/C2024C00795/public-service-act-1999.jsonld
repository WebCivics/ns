        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-61",
      "@type": "cml:Concept",
      "skos:prefLabel": "61 Remuneration and other terms and conditions of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-61"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.63",
      "values:originalText": "Remuneration and allowances\n(1) The remuneration of a Secretary is as provided by Division 4 of\nPart II of the Remuneration Tribunal Act 1973.\nOther terms and conditions\n(2) The other terms and conditions applying to the appointment of a\nSecretary are as determined by the Remuneration Tribunal under\nDivision 4 of Part II of the Remuneration Tribunal Act 1973.",
      "skos:definition": "Remuneration and allowances\n(1) The remuneration of a Secretary is as provided by Division 4 of\nPart II of the Remuneration Tribunal Act 1973.\nOther terms and conditions\n(2) The other terms and conditions applying to the appointment of a\nSecretary are as determined by the Remuneration Tribunal under\nDivision 4 of Part II of the Remuneration Tribunal Act 1973.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-61-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-61-ss-2"
        }
      ],
      "cml:integrityHash": "c821f4c86583848f418eb6237204d46ef3f7a31c0e8c47f1f2e936b7ab2da8e3"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-61",
      "@type": "cof:Section",
      "cof:title": "61 Remuneration and other terms and conditions of appointment",
      "values:kind": "section",
      "cof:pageNumber": 63,
      "values:originalText": "Remuneration and allowances\n(1) The remuneration of a Secretary is as provided by Division 4 of\nPart II of the Remuneration Tribunal Act 1973.\nOther terms and conditions\n(2) The other terms and conditions applying to the appointment of a\nSecretary are as determined by the Remuneration Tribunal under\nDivision 4 of Part II of the Remuneration Tribunal Act 1973."
    },
