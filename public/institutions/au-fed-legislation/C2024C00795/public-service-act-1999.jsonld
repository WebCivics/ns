    {
      "@id": "concept:public-service-act-1999-sec-21-2-logic-alleninterval-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Requires a relation between identifiable temporal intervals",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The commencement is specified as July 1, 2006",
      "cml:conclusionText": "A relation exists between the commencement date and the specified date"
    },
    {
      "@id": "concept:public-service-act-1999-sec-21-2-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Applicable",
      "cml:logicSummary": "Classifies the legal effect as a prohibition",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The text specifies a condition for commencement",
      "cml:conclusionText": "Commencement is prohibited unless the condition is met"
    },
    {
      "@id": "concept:public-service-act-1999-sec-21-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
