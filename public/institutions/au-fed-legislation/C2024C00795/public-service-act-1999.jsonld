    {
      "@id": "concept:public-service-act-1999-sec-31-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "31(2) Forfeiture of additional remuneration",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-31-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
