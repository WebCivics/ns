    {
      "@id": "concept:public-service-act-1999-sec-30",
      "@type": "cml:Concept",
      "skos:prefLabel": "30 Retirement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-30"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.29",
      "values:originalText": "(1) An APS employee who has reached the minimum retiring age is\nentitled to retire at any time by notice in writing to the Agency\nHead.\n(2) The minimum retiring age is 55 years, or such higher or lower age\nas is prescribed by the regulations.",
      "skos:definition": "(1) An APS employee who has reached the minimum retiring age is\nentitled to retire at any time by notice in writing to the Agency\nHead.\n(2) The minimum retiring age is 55 years, or such higher or lower age\nas is prescribed by the regulations.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-30-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-30-ss-2"
        }
      ],
      "cml:integrityHash": "7e0fd4daf2179ec8ed2b3ce75678fbf4e226304fe55658a5b98048d52fec3c65"
    },
    {
