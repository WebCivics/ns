      ],
      "cml:integrityHash": "df5bde3dbc35815b6b5f3603212926972080fd28ea43344f1cb40d5106093bd5",
      "skos:note": "Commissioner may decline inquiry under certain circumstances."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-41a-ss-3",
