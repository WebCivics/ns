    {
      "@id": "concept:public-service-act-1999-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Constitution of the APS",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.14",
      "values:originalText": "The Australian Public Service consists of Agency Heads and APS\nemployees.",
      "skos:definition": "The Australian Public Service consists of Agency Heads and APS\nemployees.",
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-9-norm"
        }
      ],
      "cml:integrityHash": "072424975e2580579f776fe61f832384454c5cfacd126fd575174fa06d4c1b24",
      "skos:note": "Definition of Australian Public Service"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-9",
      "@type": "cof:Section",
      "cof:title": "9 Constitution of the APS",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "The Australian Public Service consists of Agency Heads and APS\nemployees."
    },
    {
      "@id": "concept:public-service-act-1999-sec-9-norm",
