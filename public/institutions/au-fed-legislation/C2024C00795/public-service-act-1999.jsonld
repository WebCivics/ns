        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Permission granted by Agency Head",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "78(8) Delegations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-78-ss-8"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.84",
      "values:originalText": "(8) An Agency Head cannot, under subsection (7), delegate powers or\nfunctions to an outsider without the prior written consent of the\nCommissioner. For this purpose, outsider means a person other\nthan:\n(a) an APS employee; or\n(b) a person appointed to an office by the Governor-General, or\nby a Minister, under a law of the Commonwealth;\nor (c) a member of the Australian Defence Force.",
      "skos:definition": "(8) An Agency Head cannot, under subsection (7), delegate powers or\nfunctions to an outsider without the prior written consent of the\nCommissioner. For this purpose, outsider means a person other\nthan:\n(a) an APS employee; or\n(b) a person appointed to an office by the Governor-General, or\nby a Minister, under a law of the Commonwealth;\nor (c) a member of the Australian Defence Force.",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-78"
      },
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-8-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-8-logic-deontic-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-8-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "04a4002ca3c95f6901404ee2d12bdf5a15b359546bbf75d2ff64448e8419cbc4",
      "skos:note": "Prior written consent required for delegation of powers or functions to an outsider."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-78-ss-8",
      "@type": "cof:Section",
      "cof:title": "78(8) Delegations",
      "values:kind": "subsection",
      "cof:pageNumber": 84,
      "values:originalText": "(8) An Agency Head cannot, under subsection (7), delegate powers or\nfunctions to an outsider without the prior written consent of the\nCommissioner. For this purpose, outsider means a person other\nthan:\n(a) an APS employee; or\n(b) a person appointed to an office by the Governor-General, or\nby a Minister, under a law of the Commonwealth;\nor (c) a member of the Australian Defence Force."
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-8-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-78-ss-8"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-8-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Agency Head has an obligation to obtain prior written consent for delegation.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-8-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "ClassInclusion",
      "cml:logicSummary": "Delegation is a class of actions that require prior written consent.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "78(9) Delegations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-78-ss-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.84",
      "values:originalText": "(9) A person (the first delegate) to whom powers or functions are\ndelegated under subsection (5), (6) or (7) may, in writing, delegate\nany of those powers or functions to another person (the second\ndelegate). However, if the first delegate is subject to directions in\nrelation to the exercise of a power or function delegated under this\nsubsection, the first delegate must give corresponding directions to\nthe second delegate.",
      "skos:definition": "(9) A person (the first delegate) to whom powers or functions are\ndelegated under subsection (5), (6) or (7) may, in writing, delegate\nany of those powers or functions to another person (the second\ndelegate). However, if the first delegate is subject to directions in\nrelation to the exercise of a power or function delegated under this\nsubsection, the first delegate must give corresponding directions to\nthe second delegate.",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-78"
      },
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-9-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-9-logic-deontic-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-9-logic-alleninterval-2"
        },
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-9-logic-argumentation-3"
        }
      ],
      "cml:integrityHash": "bb1ff40a74f3c246e59cdea41ab74ff65e5abb90ea5b5a2eca165f46491165fd",
      "skos:note": "A person delegated powers or functions must give corresponding directions to the second delegate."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-78-ss-9",
      "@type": "cof:Section",
      "cof:title": "78(9) Delegations",
      "values:kind": "subsection",
      "cof:pageNumber": 84,
      "values:originalText": "(9) A person (the first delegate) to whom powers or functions are\ndelegated under subsection (5), (6) or (7) may, in writing, delegate\nany of those powers or functions to another person (the second\ndelegate). However, if the first delegate is subject to directions in\nrelation to the exercise of a power or function delegated under this\nsubsection, the first delegate must give corresponding directions to\nthe second delegate."
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-9-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-78-ss-9"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      },
      "skos:scopeNote": "borne by: Agent"
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-9-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Obligation",
      "cml:logicSummary": "Delegation of powers or functions",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The first delegate may delegate powers or functions to another person.",
      "cml:conclusionText": "The first delegate must give corresponding directions to the second delegate."
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-9-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:logicSummary": "Temporal overlap of delegations",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The first delegate is subject to directions in relation to the exercise of a power or function delegated under this subsection."
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-9-logic-argumentation-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "Implication",
      "cml:logicSummary": "Directional obligation",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "If the first delegate is subject to directions, then the second delegate must receive corresponding directions."
    },
    {
