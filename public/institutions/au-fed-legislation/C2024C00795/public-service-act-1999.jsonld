        }
      ],
      "cml:integrityHash": "74f53ffaf830f0af9df8cfaa62e698d63035e68b6dc6be7f4824fe432bc404a4",
      "skos:note": "The report must be prepared after consultation with the Commissioner and the person expected to be the Agency Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-58-ss-8",
      "@type": "cof:Section",
      "cof:title": "58(8) Appointment",
      "values:kind": "subsection",
      "cof:pageNumber": 60,
      "values:originalText": "(8) The report from the Secretary of the Prime Minister’s Department\nabout the appointment of the Secretary of another Department\nmust:\n(a) be prepared after consultation with:\n(i) the Commissioner; and\n(ii) the person who is expected to be the Agency Minister of\nthe other Department at the time the appointment is\nmade; and"
    },
    {
      "@id": "concept:public-service-act-1999-sec-58-ss-8-norm",
      "@type": "values:Obligation",
      "cml:modality": {
