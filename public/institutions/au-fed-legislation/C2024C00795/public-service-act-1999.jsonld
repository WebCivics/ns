    {
      "@id": "concept:public-service-act-1999-sec-40",
      "@type": "cml:Concept",
      "skos:prefLabel": "40 Australian Public Service Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-40"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.36",
      "values:originalText": "(1) There is to be an Australian Public Service Commissioner.\n(2) The staff necessary to assist the Commissioner must be persons\nengaged under this Act.\n(3) For the purposes of this Act:\n(a) the Commissioner and the APS employees assisting the\nCommissioner together constitute a Statutory Agency; and\n(b) the Commissioner is the Head of that Statutory Agency.\n(4) The Commissioner may, on behalf of the Commonwealth, engage\nconsultants to assist in the performance of the Commissioner’s\nfunctions.",
      "skos:definition": "(1) There is to be an Australian Public Service Commissioner.\n(2) The staff necessary to assist the Commissioner must be persons\nengaged under this Act.\n(3) For the purposes of this Act:\n(a) the Commissioner and the APS employees assisting the\nCommissioner together constitute a Statutory Agency; and\n(b) the Commissioner is the Head of that Statutory Agency.\n(4) The Commissioner may, on behalf of the Commonwealth, engage\nconsultants to assist in the performance of the Commissioner’s\nfunctions.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-40-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-40-ss-2"
        },
        {
          "@id": "concept:public-service-act-1999-sec-40-ss-3"
        },
        {
          "@id": "concept:public-service-act-1999-sec-40-ss-4"
        }
      ],
      "cml:integrityHash": "f77a8fa9663fc26891bedf3ce31329d2c287b86a41b528c572eb6be6c9dfc09e"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-40",
      "@type": "cof:Section",
      "cof:title": "40 Australian Public Service Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 36,
      "values:originalText": "(1) There is to be an Australian Public Service Commissioner.\n(2) The staff necessary to assist the Commissioner must be persons\nengaged under this Act.\n(3) For the purposes of this Act:\n(a) the Commissioner and the APS employees assisting the\nCommissioner together constitute a Statutory Agency; and\n(b) the Commissioner is the Head of that Statutory Agency.\n(4) The Commissioner may, on behalf of the Commonwealth, engage\nconsultants to assist in the performance of the Commissioner’s\nfunctions."
    },
