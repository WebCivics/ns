    {
      "@id": "concept:public-service-act-1999-sec-20",
      "@type": "cml:Concept",
      "skos:prefLabel": "20 Employer powers etc. of Agency Head",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-20"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.23",
      "values:originalText": "(1) An Agency Head, on behalf of the Commonwealth, has all the\nrights, duties and powers of an employer in respect of APS\nemployees in the Agency.\n(2) Without limiting subsection (1), an Agency Head has, in respect of\nAPS employees in the Agency, the rights, duties and powers that\nare prescribed by the regulations.",
      "skos:definition": "(1) An Agency Head, on behalf of the Commonwealth, has all the\nrights, duties and powers of an employer in respect of APS\nemployees in the Agency.\n(2) Without limiting subsection (1), an Agency Head has, in respect of\nAPS employees in the Agency, the rights, duties and powers that\nare prescribed by the regulations.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-20-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-20-ss-2"
        }
      ],
      "cml:integrityHash": "a3f5fc75170cf2fa4daa2c739568ffcc2d5331090117ee191d2332bc5f07f336"
    },
