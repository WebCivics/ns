    {
      "@id": "concept:public-service-act-1999-sec-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "2 Commencement",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.7",
      "values:originalText": "(1) Subject to subsection (2), this Act commences on a day to be fixed\nby Proclamation.\n(2) If this Act does not commence under subsection (1) within the\nperiod of 6 months beginning on the day on which it receives the\nRoyal Assent, it commences on the first day after the end of that\nperiod.",
      "skos:definition": "(1) Subject to subsection (2), this Act commences on a day to be fixed\nby Proclamation.\n(2) If this Act does not commence under subsection (1) within the\nperiod of 6 months beginning on the day on which it receives the\nRoyal Assent, it commences on the first day after the end of that\nperiod.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-2-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-2-ss-2"
        }
      ],
      "cml:integrityHash": "4de5f3508234f4c70a8a8b87b774e9e5920d7c0db9de0332d9708b627d9b5376"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-2",
      "@type": "cof:Section",
      "cof:title": "2 Commencement",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "(1) Subject to subsection (2), this Act commences on a day to be fixed\nby Proclamation.\n(2) If this Act does not commence under subsection (1) within the\nperiod of 6 months beginning on the day on which it receives the\nRoyal Assent, it commences on the first day after the end of that\nperiod."
    },
    {
      "@id": "concept:public-service-act-1999-sec-2-ss-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "2(1) Commencement",
      "cml:realizedBy": {
