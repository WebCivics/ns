      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Agency is a Department, Executive Agency, or Statutory Agency.",
      "cml:conclusionText": "Definition of Agency"
    },
    {
      "@id": "concept:public-service-act-1999-sec-7-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:logicSummary": "Class hierarchy definition",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
