    },
    {
      "@id": "concept:public-service-act-1999-sec-48",
      "@type": "cml:Concept",
      "skos:prefLabel": "48 Acting Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-48"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.50",
      "values:originalText": "The Agency Minister may appoint a person to act as\nCommissioner:\n(a) if there is a vacancy in the office of Commissioner, whether\nor not an appointment has previously been made to the\noffice; or\n(b) during any period, or during all periods, when the\nCommissioner is absent from duty or from Australia or is, for\nany reason, unable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\n\nThe Australian Public Service Commissioner  Part 5\nSpecial Commissioners  Division 3\nSection 48A\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "skos:definition": "The Agency Minister may appoint a person to act as\nCommissioner:\n(a) if there is a vacancy in the office of Commissioner, whether\nor not an appointment has previously been made to the\noffice; or\n(b) during any period, or during all periods, when the\nCommissioner is absent from duty or from Australia or is, for\nany reason, unable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\n\nThe Australian Public Service Commissioner  Part 5\nSpecial Commissioners  Division 3\nSection 48A\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-48-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-48-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "8019ec5689a388d793042b8ef46c9333672192f548dc26d346dd45a6587613a5",
      "skos:note": "The Agency Minister may appoint a person to act as Commissioner."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-48",
      "@type": "cof:Section",
      "cof:title": "48 Acting Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 50,
      "values:originalText": "The Agency Minister may appoint a person to act as\nCommissioner:\n(a) if there is a vacancy in the office of Commissioner, whether\nor not an appointment has previously been made to the\noffice; or\n(b) during any period, or during all periods, when the\nCommissioner is absent from duty or from Australia or is, for\nany reason, unable to perform the duties of the office.\nNote:\nFor rules that apply to acting appointments, see section 33A of the\nActs Interpretation Act 1901.\n\n\nThe Australian Public Service Commissioner  Part 5\nSpecial Commissioners  Division 3\nSection 48A\nPublic Service Act 1999\nCompilation date: 11/12/2024"
    },
    {
      "@id": "concept:public-service-act-1999-sec-48-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-48"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-48-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "May appoint",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-48a",
      "@type": "cml:Concept",
      "skos:prefLabel": "48A Appointment of Special Commissioners",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-48a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.51",
      "values:originalText": "(1) The Governor-General may, by written instrument, on the\nrecommendation of the Prime Minister, appoint one or more\nSpecial Commissioners to assist the Commissioner in conducting a\nspecified systems review or special review, or a part of such a\nreview.\n(2) The Prime Minister must not recommend that a person be\nappointed as a Special Commissioner unless the Prime Minister\nhas consulted the Commissioner about the appointment.\n(3) A Special Commissioner may be appointed on a full-time basis or\na part-time basis.\n(4) A Special Commissioner holds office for the period specified in the\ninstrument of appointment.",
      "skos:definition": "(1) The Governor-General may, by written instrument, on the\nrecommendation of the Prime Minister, appoint one or more\nSpecial Commissioners to assist the Commissioner in conducting a\nspecified systems review or special review, or a part of such a\nreview.\n(2) The Prime Minister must not recommend that a person be\nappointed as a Special Commissioner unless the Prime Minister\nhas consulted the Commissioner about the appointment.\n(3) A Special Commissioner may be appointed on a full-time basis or\na part-time basis.\n(4) A Special Commissioner holds office for the period specified in the\ninstrument of appointment.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-48a-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-48a-ss-2"
