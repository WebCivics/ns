    {
      "@id": "concept:public-service-act-1999-sec-78-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "78(7) Delegations",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-78-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.84",
      "values:originalText": "(7) An Agency Head may, in writing, delegate to another person any\nof the Agency Head’s powers or functions under this Act (other\nthan this section).\n\n\nMiscellaneous  Part 11\n\nSection 78\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "skos:definition": "(7) An Agency Head may, in writing, delegate to another person any\nof the Agency Head’s powers or functions under this Act (other\nthan this section).\n\n\nMiscellaneous  Part 11\n\nSection 78\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-78"
      },
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-7-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-78-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "33a37fcda5d9e817da30837135920590415dc78ddd7f3b4895439a754d8aa282",
      "skos:note": "Agency Head may delegate powers or functions to another person in writing."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-78-ss-7",
      "@type": "cof:Section",
      "cof:title": "78(7) Delegations",
      "values:kind": "subsection",
      "cof:pageNumber": 84,
      "values:originalText": "(7) An Agency Head may, in writing, delegate to another person any\nof the Agency Head’s powers or functions under this Act (other\nthan this section).\n\n\nMiscellaneous  Part 11\n\nSection 78\nPublic Service Act 1999\nCompilation date: 11/12/2024"
    },
    {
      "@id": "concept:public-service-act-1999-sec-78-ss-7-norm",
      "@type": "values:Permission",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-78-ss-7"
      },
