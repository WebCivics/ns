    {
      "@id": "concept:public-service-act-1999-sec-23-ss-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "23(6) Classification Rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-23-ss-6"
      },
      "cml:curationStatus": {
