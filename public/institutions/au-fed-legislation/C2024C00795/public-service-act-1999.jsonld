        }
      ],
      "cml:integrityHash": "80a963c2858724ee8478ea8bf807f40bcf817e0ee92585c7695b2163b927e772",
      "skos:note": "Cites this Act as the Public Service Act 1999.",
      "dc:references": [
        "may be cited"
      ]
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-1",
      "@type": "cof:Section",
      "cof:title": "1 Short title",
      "values:kind": "section",
      "cof:pageNumber": 7,
      "values:originalText": "This Act may be cited as the Public Service Act 1999.\nNote:\nSee also the Public Employment (Consequential and Transitional)\nAmendment Act 1999."
    },
