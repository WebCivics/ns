    {
      "@id": "concept:public-service-act-1999-sec-64a-ss-3b",
      "@type": "cml:Concept",
      "skos:prefLabel": "64A(3B) Long-term insights reports",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-64a-ss-3b"
      },
      "cml:curationStatus": {
