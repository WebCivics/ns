    {
      "@id": "concept:public-service-act-1999-sec-19",
      "@type": "cml:Concept",
      "skos:prefLabel": "19 Limitation on Ministerial directions to Agency Head",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-19"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.22",
      "values:originalText": "A Minister must not direct an Agency Head in relation to the\nexercise of powers by the Agency Head under section 15 or\nDivision 1 or 2 of Part 4 in relation to particular individuals.",
