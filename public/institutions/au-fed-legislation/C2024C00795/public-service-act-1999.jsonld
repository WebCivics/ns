    {
      "@id": "concept:public-service-act-1999-sec-26",
      "@type": "cml:Concept",
      "skos:prefLabel": "26 Voluntary moves between Agencies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-26"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.27",
      "values:originalText": "(1) An Agency Head may enter into an agreement in writing with an\nAPS employee for the employee to move to the Agency Head’s\nAgency from another Agency.\n(2) Subject to Commissioner’s Directions issued under\nsubsection 11A(1), the agreement has effect according to its terms,\nby force of this section.",
      "skos:definition": "(1) An Agency Head may enter into an agreement in writing with an\nAPS employee for the employee to move to the Agency Head’s\nAgency from another Agency.\n(2) Subject to Commissioner’s Directions issued under\nsubsection 11A(1), the agreement has effect according to its terms,\nby force of this section.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-26-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-26-ss-2"
        }
      ],
      "cml:integrityHash": "cabd62c36ee9c8787ba05c32ddf09b08894524396d7697ff53fd3354013ffb6f"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-26",
      "@type": "cof:Section",
      "cof:title": "26 Voluntary moves between Agencies",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "(1) An Agency Head may enter into an agreement in writing with an\nAPS employee for the employee to move to the Agency Head’s\nAgency from another Agency.\n(2) Subject to Commissioner’s Directions issued under\nsubsection 11A(1), the agreement has effect according to its terms,\nby force of this section."
    },
