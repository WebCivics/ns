      ],
      "cml:integrityHash": "25a5943bdddd7cb19612803ca65c22938b689e0f60ef3b97556deaa4f70f5fd6",
      "skos:note": "Appointment of Head of Mission requires APS employee status."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-39-ss-1",
      "@type": "cof:Section",
      "cof:title": "39(1) Heads of Mission",
      "values:kind": "subsection",
      "cof:pageNumber": 35,
      "values:originalText": "(1) The appointment of a Head of Mission by the Governor-General\ncannot take effect unless the person is an APS employee."
    },
    {
      "@id": "concept:public-service-act-1999-sec-39-ss-1-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
