    {
      "@id": "concept:public-service-act-1999-sec-32",
      "@type": "cml:Concept",
      "skos:prefLabel": "32 Right of return for election candidates",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-32"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.30",
      "values:originalText": "(1) This section applies to a person if:\n(a) the person resigned as an APS employee in order to contest\nan election specified in Commissioner’s Directions issued\nunder subsection 11A(1); and\n(b) the resignation took effect not earlier than 6 months before\nthe closing date for nominations; and\n(c) the person was a candidate in the election but failed to be\nelected.\n(2) The person is entitled to be again engaged as an APS employee, in\naccordance with Commissioner’s Directions issued under\nsubsection 11A(1) and within the time limits provided by those\nDirections.",
      "skos:definition": "(1) This section applies to a person if:\n(a) the person resigned as an APS employee in order to contest\nan election specified in Commissioner’s Directions issued\nunder subsection 11A(1); and\n(b) the resignation took effect not earlier than 6 months before\nthe closing date for nominations; and\n(c) the person was a candidate in the election but failed to be\nelected.\n(2) The person is entitled to be again engaged as an APS employee, in\naccordance with Commissioner’s Directions issued under\nsubsection 11A(1) and within the time limits provided by those\nDirections.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-32-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-32-ss-2"
        }
      ],
      "cml:integrityHash": "769c1bf3cbe830f631803f6803da8371e5386ad1a42fe12ed62dc5221fca6fdc"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-32",
      "@type": "cof:Section",
      "cof:title": "32 Right of return for election candidates",
      "values:kind": "section",
      "cof:pageNumber": 30,
      "values:originalText": "(1) This section applies to a person if:\n(a) the person resigned as an APS employee in order to contest\nan election specified in Commissioner’s Directions issued\nunder subsection 11A(1); and\n(b) the resignation took effect not earlier than 6 months before\nthe closing date for nominations; and\n(c) the person was a candidate in the election but failed to be\nelected.\n(2) The person is entitled to be again engaged as an APS employee, in\naccordance with Commissioner’s Directions issued under\nsubsection 11A(1) and within the time limits provided by those\nDirections."
    },
    {
