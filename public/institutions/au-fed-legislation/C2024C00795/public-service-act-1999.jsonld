    {
      "@id": "concept:public-service-act-1999-sec-68",
      "@type": "cml:Concept",
      "skos:prefLabel": "68 Remuneration and other terms and conditions of appointment",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-68"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.67",
      "values:originalText": "Remuneration and allowances\n(1) The Head of an Executive Agency is to be paid the remuneration\nthat is determined by the Remuneration Tribunal. If no\ndetermination of that remuneration by the Tribunal is in operation,\nthe Head of the Executive Agency is to be paid the remuneration\nthat is prescribed by the regulations.\n(2) The Head of an Executive Agency is to be paid the allowances that\nare prescribed by the regulations.",
      "skos:definition": "Remuneration and allowances\n(1) The Head of an Executive Agency is to be paid the remuneration\nthat is determined by the Remuneration Tribunal. If no\ndetermination of that remuneration by the Tribunal is in operation,\nthe Head of the Executive Agency is to be paid the remuneration\nthat is prescribed by the regulations.\n(2) The Head of an Executive Agency is to be paid the allowances that\nare prescribed by the regulations.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-68-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-68-ss-2"
        }
      ],
      "cml:integrityHash": "c821f4c86583848f418eb6237204d46ef3f7a31c0e8c47f1f2e936b7ab2da8e3"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-68",
      "@type": "cof:Section",
      "cof:title": "68 Remuneration and other terms and conditions of appointment",
      "values:kind": "section",
      "cof:pageNumber": 67,
      "values:originalText": "Remuneration and allowances\n(1) The Head of an Executive Agency is to be paid the remuneration\nthat is determined by the Remuneration Tribunal. If no\ndetermination of that remuneration by the Tribunal is in operation,\nthe Head of the Executive Agency is to be paid the remuneration\nthat is prescribed by the regulations.\n(2) The Head of an Executive Agency is to be paid the allowances that\nare prescribed by the regulations."
    },
    {
      "@id": "concept:public-service-act-1999-sec-68-ss-1",
