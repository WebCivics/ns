      "@id": "concept:public-service-act-1999-sec-77-ss-3-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "applies",
      "cml:logicSummary": "A provision applies to APS employees.",
