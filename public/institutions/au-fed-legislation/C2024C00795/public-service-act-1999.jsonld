    {
      "@id": "concept:public-service-act-1999-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 SES employees",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.33",
      "values:originalText": "SES employees are those APS employees who are classified as\nSES employees under the Classification Rules.",
      "skos:definition": "SES employees are those APS employees who are classified as\nSES employees under the Classification Rules.",
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-34-norm"
        }
      ],
      "cml:integrityHash": "8cfad9140d7093b0b7755ba2b5abbb83860a3b16f72f89df6da2a86aa6dc8ee1",
      "skos:note": "Definition of SES employees"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-34",
      "@type": "cof:Section",
      "cof:title": "34 SES employees",
      "values:kind": "section",
      "cof:pageNumber": 33,
      "values:originalText": "SES employees are those APS employees who are classified as\nSES employees under the Classification Rules."
    },
    {
      "@id": "concept:public-service-act-1999-sec-34-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
