      "cml:logicSummary": "Obligation on use of protected information",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Merit Protection Commissioner may use protected information for the purposes of, or in connection with, the performance of functions or duties.",
      "cml:conclusionText": "There is an obligation to use protected information."
    },
    {
      "@id": "concept:public-service-act-1999-sec-72b-ss-3-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Obligation on record-keeping",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "An entrusted person may make a record of, disclose or otherwise use protected information.",
      "cml:conclusionText": "There is an obligation to keep records of protected information."
    },
    {
      "@id": "concept:public-service-act-1999-sec-72b-ss-3-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Obligation on disclosure limits",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Merit Protection Commissioner may disclose protected information for the purposes of, or in connection with, the performance of functions or duties.",
      "cml:conclusionText": "There are limits to authorized disclosure."
    },
    {
      "@id": "concept:public-service-act-1999-sec-72b-ss-3-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:logicSummary": "Obligation on use limits",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The Merit Protection Commissioner may use protected information for the purposes of, or in connection with, the performance of functions or duties.",
      "cml:conclusionText": "There are limits to authorized use."
    },
    {
      "@id": "concept:public-service-act-1999-sec-72b-ss-4",
      "@type": "cml:Concept",
      "skos:prefLabel": "72B(4) Protection of information—Merit Protection Commissioner’s",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-72b-ss-4"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.74",
      "values:originalText": "(4) The Merit Protection Commissioner may disclose protected\ninformation in a report prepared for purposes connected with the\nperformance of the functions, or the exercise of the powers, of the\nMerit Protection Commissioner under this Act or the regulations, if\nthe Merit Protection Commissioner is satisfied that the disclosure\nis necessary for the purpose of setting out the grounds for the\nconclusions and recommendations contained in the report.",
      "skos:definition": "(4) The Merit Protection Commissioner may disclose protected\ninformation in a report prepared for purposes connected with the\nperformance of the functions, or the exercise of the powers, of the\nMerit Protection Commissioner under this Act or the regulations, if\nthe Merit Protection Commissioner is satisfied that the disclosure\nis necessary for the purpose of setting out the grounds for the\nconclusions and recommendations contained in the report.",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-72b"
      },
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-72b-ss-4-norm"
        },
