      },
      "cml:premiseText": "(a) the Commissioner and the APS employees assisting the\nCommissioner together constitute a Statutory Agency;",
      "cml:conclusionText": "The Commissioner and the APS employees assisting the\nCommissioner together constitute a Statutory Agency."
    },
    {
      "@id": "concept:public-service-act-1999-sec-40-ss-3-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "is",
      "cml:logicSummary": "Establishes the Commissioner as Head of the Statutory Agency",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the Commissioner is the Head of that Statutory Agency;",
      "cml:conclusionText": "The Commissioner is the Head of that Statutory Agency."
    },
    {
      "@id": "concept:public-service-act-1999-sec-40-ss-3-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "together with",
      "cml:logicSummary": "Establishes a temporal relationship between the Commissioner and APS employees",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the Commissioner and the APS employees assisting the\nCommissioner together constitute a Statutory Agency;",
      "cml:conclusionText": "The Commissioner and the APS employees assisting the\nCommissioner are together with each other."
    },
    {
      "@id": "concept:public-service-act-1999-sec-40-ss-3-logic-argumentation-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Argumentation"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Establishes a logical implication between the Statutory Agency and its Head",
      "cml:executionSurface": "modalities::argumentation",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) the Commissioner is the Head of that Statutory Agency;",
      "cml:conclusionText": "The Commissioner being the Head of the Statutory Agency implies the existence of the Statutory Agency."
    },
    {
      "@id": "concept:public-service-act-1999-sec-40-ss-3-logic-diffusion-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "constitutes",
      "cml:logicSummary": "Establishes a diffusion relationship between the Statutory Agency and its constituent parts",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) the Commissioner and the APS employees assisting the\nCommissioner together constitute a Statutory Agency;",
      "cml:conclusionText": "The Statutory Agency is constituted by the Commissioner and the APS employees assisting the\nCommissioner."
    },
