      ],
      "cml:integrityHash": "0a4b92f4877f979bf0009674b1e315526b76bf072d78695072f8107d6f67f7c4",
      "skos:note": "Notice required for non-Commonwealth remuneration",
      "dc:description": "Notice in writing"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-31-ss-1",
      "@type": "cof:Section",
      "cof:title": "31(1) Forfeiture of additional remuneration",
      "values:kind": "subsection",
      "cof:pageNumber": 29,
      "values:originalText": "(1) If an APS employee receives any non-Commonwealth\nremuneration for performing duties as an APS employee, then the\nAgency Head may give a notice in writing to the employee in\nrelation to the whole, or a specified part, of the remuneration."
    },
