    {
      "@id": "concept:public-service-act-1999-sec-73-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "73(5) Payments in special circumstances",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-73-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.82",
      "values:originalText": "(5) Conditions may be attached to payments under this section. If a\ncondition is breached, the payment may be recovered by the\nCommonwealth as a debt in a court of competent jurisdiction.\nNote:\nPayments under this section must be made from money appropriated\nby the Parliament. Generally, a payment can be debited against an\nAgency’s annual appropriation, providing that it relates to some\nmatter that has arisen in the course of its administration.\n\n\nMiscellaneous  Part 11\n\nSection 74\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "skos:definition": "(5) Conditions may be attached to payments under this section. If a\ncondition is breached, the payment may be recovered by the\nCommonwealth as a debt in a court of competent jurisdiction.\nNote:\nPayments under this section must be made from money appropriated\nby the Parliament. Generally, a payment can be debited against an\nAgency’s annual appropriation, providing that it relates to some\nmatter that has arisen in the course of its administration.\n\n\nMiscellaneous  Part 11\n\nSection 74\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-73"
      },
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-73-ss-5-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-73-ss-5-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "077dcb7042d8978d9400c6d5f7858fe18fb8acd89d68f0331eb2d3814f34ae4e",
      "skos:note": "Payment recovery upon condition breach"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-73-ss-5",
      "@type": "cof:Section",
      "cof:title": "73(5) Payments in special circumstances",
      "values:kind": "subsection",
      "cof:pageNumber": 82,
      "values:originalText": "(5) Conditions may be attached to payments under this section. If a\ncondition is breached, the payment may be recovered by the\nCommonwealth as a debt in a court of competent jurisdiction.\nNote:\nPayments under this section must be made from money appropriated\nby the Parliament. Generally, a payment can be debited against an\nAgency’s annual appropriation, providing that it relates to some\nmatter that has arisen in the course of its administration.\n\n\nMiscellaneous  Part 11\n\nSection 74\nPublic Service Act 1999\nCompilation date: 11/12/2024"
    },
    {
      "@id": "concept:public-service-act-1999-sec-73-ss-5-norm",
      "@type": "values:Prohibition",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-73-ss-5"
      },
