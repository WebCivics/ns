      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:Agent"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-64a-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "May",
      "cml:logicSummary": "The Secretaries Board has the obligation to cause long-term insights reports.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:public-service-act-1999-sec-64a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "64A(2) Long-term insights reports",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-64a-ss-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.64",
      "values:originalText": "(2) The purpose of a long-term insights report is to make available:\n(a) information about medium-term and long-term trends, risks,\nand opportunities that affect or may affect Australia or\nAustralian society; and\n(b) information and impartial analysis relating to those trends,\nrisks and opportunities.",
      "skos:definition": "(2) The purpose of a long-term insights report is to make available:\n(a) information about medium-term and long-term trends, risks,\nand opportunities that affect or may affect Australia or\nAustralian society; and\n(b) information and impartial analysis relating to those trends,\nrisks and opportunities.",
