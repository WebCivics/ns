      "dc:source": "public-service-act-1999.pdf, p.35",
      "values:originalText": "(2) An Agency Head must comply with any direction in writing by the\nAgency Minister:\n(a) directing the Agency Head to engage a particular person as\nan APS employee so that the person can become a Head of\nMission; or\n(b) directing the Agency Head to assign particular duties to an\nAPS employee who has been appointed as a Head of\nMission.",
      "skos:definition": "(2) An Agency Head must comply with any direction in writing by the\nAgency Minister:\n(a) directing the Agency Head to engage a particular person as\nan APS employee so that the person can become a Head of\nMission; or\n(b) directing the Agency Head to assign particular duties to an\nAPS employee who has been appointed as a Head of\nMission.",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-39"
      },
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-39-ss-2-norm"
        },
