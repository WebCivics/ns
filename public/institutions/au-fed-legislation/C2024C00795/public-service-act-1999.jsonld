    {
      "@id": "concept:public-service-act-1999-sec-75",
      "@type": "cml:Concept",
      "skos:prefLabel": "75 Attachment of salaries to satisfy judgment debts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-75"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
