      },
      "cml:premiseText": "APS employee is a person engaged under section 22 or section 72.",
      "cml:conclusionText": "Definition of APS employee"
    },
    {
      "@id": "concept:public-service-act-1999-sec-8",
      "@type": "cml:Concept",
      "skos:prefLabel": "8 Relationship with Fair Work Acts",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-8"
      },
      "cml:curationStatus": {
