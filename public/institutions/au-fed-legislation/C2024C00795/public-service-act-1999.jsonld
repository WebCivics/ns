      },
      "cml:premiseText": "(1) The appointment of a Head of Mission by the Governor-General\ncannot take effect unless the person is an APS employee.",
      "cml:conclusionText": "The appointment cannot take effect unless the person is an APS employee."
    },
    {
      "@id": "concept:public-service-act-1999-sec-39-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:logicSummary": "Temporal interval for appointment",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The appointment of a Head of Mission by the Governor-General\ncannot take effect unless the person is an APS employee.",
      "cml:conclusionText": "The appointment takes effect during the period when the person is an APS employee."
    },
    {
      "@id": "concept:public-service-act-1999-sec-39-ss-1-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Temporal interval for appointment",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The appointment of a Head of Mission by the Governor-General\ncannot take effect unless the person is an APS employee.",
      "cml:conclusionText": "The appointment takes effect until the period when the person ceases to be an APS employee."
    },
    {
      "@id": "concept:public-service-act-1999-sec-39-ss-1-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "implies",
      "cml:logicSummary": "Consequence of appointment",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(1) The appointment of a Head of Mission by the Governor-General\ncannot take effect unless the person is an APS employee.",
      "cml:conclusionText": "The appointment implies that the person must be an APS employee."
    },
    {
      "@id": "concept:public-service-act-1999-sec-39-ss-1-logic-cogai-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:CogAI"
      },
      "cml:operator": "is-a",
      "cml:logicSummary": "Definition of Head of Mission",
      "cml:executionSurface": "sparql_library::parsers::chk_parser",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
