    {
      "@id": "concept:public-service-act-1999-sec-49",
      "@type": "cml:Concept",
      "skos:prefLabel": "49 Merit Protection Commissioner",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-49"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.53",
      "values:originalText": "(1) There is to be a Merit Protection Commissioner.\n(2) The staff necessary to assist the Merit Protection Commissioner\nmust be persons engaged under this Act and made available by the\nAustralian Public Service Commissioner.\n(3) The Merit Protection Commissioner may, on behalf of the\nCommonwealth, engage consultants to assist in the performance of\nthe Merit Protection Commissioner’s functions.",
      "skos:definition": "(1) There is to be a Merit Protection Commissioner.\n(2) The staff necessary to assist the Merit Protection Commissioner\nmust be persons engaged under this Act and made available by the\nAustralian Public Service Commissioner.\n(3) The Merit Protection Commissioner may, on behalf of the\nCommonwealth, engage consultants to assist in the performance of\nthe Merit Protection Commissioner’s functions.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-49-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-49-ss-2"
        },
        {
          "@id": "concept:public-service-act-1999-sec-49-ss-3"
        }
      ],
      "cml:integrityHash": "545ff2dc8ff527f1e88e1e680e2f778d5b7245165730e7b4cb6889fbca8b6499"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-49",
      "@type": "cof:Section",
      "cof:title": "49 Merit Protection Commissioner",
      "values:kind": "section",
      "cof:pageNumber": 53,
      "values:originalText": "(1) There is to be a Merit Protection Commissioner.\n(2) The staff necessary to assist the Merit Protection Commissioner\nmust be persons engaged under this Act and made available by the\nAustralian Public Service Commissioner.\n(3) The Merit Protection Commissioner may, on behalf of the\nCommonwealth, engage consultants to assist in the performance of\nthe Merit Protection Commissioner’s functions."
    },
