    {
      "@id": "concept:public-service-act-1999-sec-25",
      "@type": "cml:Concept",
      "skos:prefLabel": "25 Assignment of duties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-25"
      },
      "cml:curationStatus": {
