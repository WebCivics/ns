    {
      "@id": "concept:public-service-act-1999-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Compulsory moves between Agencies",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.28",
      "values:originalText": "(1) The Commissioner may, by direction in writing, move an excess\nAPS employee to another Agency, without anyone’s consent.\n(2) For the purposes of this section, an APS employee is an excess\nAPS employee if, and only if, the Agency Head has notified the\nCommissioner in writing that the employee is excess to the\nrequirements of the Agency.",
      "skos:definition": "(1) The Commissioner may, by direction in writing, move an excess\nAPS employee to another Agency, without anyone’s consent.\n(2) For the purposes of this section, an APS employee is an excess\nAPS employee if, and only if, the Agency Head has notified the\nCommissioner in writing that the employee is excess to the\nrequirements of the Agency.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-27-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-27-ss-2"
        }
      ],
      "cml:integrityHash": "e1c8396fee2bbd04ebd190f035b23503c9de04ad442b9d43f7a1d6e8b6692709"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Compulsory moves between Agencies",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "(1) The Commissioner may, by direction in writing, move an excess\nAPS employee to another Agency, without anyone’s consent.\n(2) For the purposes of this section, an APS employee is an excess\nAPS employee if, and only if, the Agency Head has notified the\nCommissioner in writing that the employee is excess to the\nrequirements of the Agency."
    },
