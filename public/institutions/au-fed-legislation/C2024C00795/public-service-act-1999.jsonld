          "@id": "concept:public-service-act-1999-sec-41c-ss-4"
        },
        {
          "@id": "concept:public-service-act-1999-sec-41c-ss-5"
        }
      ],
      "cml:integrityHash": "77560711d3817121542c31db602b6b4f5b65fb838e636d319bbe4664d6a1c7a5"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-41c",
