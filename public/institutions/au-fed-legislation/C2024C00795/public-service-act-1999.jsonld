    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-10-ss-1",
      "@type": "cof:Section",
      "cof:title": "10(1) APS Values",
      "values:kind": "subsection",
      "cof:pageNumber": 14,
      "values:originalText": "(1) The APS is professional, objective, innovative and efficient, and\nworks collaboratively to achieve the best results for the Australian\ncommunity and the Government.\nEthical"
    },
