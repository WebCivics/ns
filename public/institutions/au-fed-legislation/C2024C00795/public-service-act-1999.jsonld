    {
      "@id": "concept:public-service-act-1999-sec-19a-ss-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "19A(2) Agency Heads to implement measures to create a work",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-19a-ss-2"
      },
      "cml:curationStatus": {
