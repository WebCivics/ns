    {
      "@id": "concept:public-service-act-1999-sec-42",
      "@type": "cml:Concept",
      "skos:prefLabel": "42 Commissioner’s Directions",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-42"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.43",
      "values:originalText": "(1) Commissioner’s Directions cannot create offences or impose\npenalties.\n(2) Agency Heads and APS employees must comply with\nCommissioner’s Directions.\n(3) Commissioner’s Directions may apply, adopt or incorporate (with\nor without modifications) any matter contained in the\nClassification Rules or a direction issued by the Prime Minister\nunder section 21, either:\n(a) as in force or existing at a particular time; or\n(b) as in force or existing from time to time.\n(4) Commissioner’s Directions are legislative instruments.",
      "skos:definition": "(1) Commissioner’s Directions cannot create offences or impose\npenalties.\n(2) Agency Heads and APS employees must comply with\nCommissioner’s Directions.\n(3) Commissioner’s Directions may apply, adopt or incorporate (with\nor without modifications) any matter contained in the\nClassification Rules or a direction issued by the Prime Minister\nunder section 21, either:\n(a) as in force or existing at a particular time; or\n(b) as in force or existing from time to time.\n(4) Commissioner’s Directions are legislative instruments.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-42-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-42-ss-2"
