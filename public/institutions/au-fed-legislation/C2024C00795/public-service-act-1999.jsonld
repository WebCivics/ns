      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.7",
      "values:originalText": "(1) Subject to subsection (2), this Act commences on a day to be fixed\nby Proclamation.",
      "skos:definition": "(1) Subject to subsection (2), this Act commences on a day to be fixed\nby Proclamation.",
      "values:partOf": {
