      },
      "dc:source": "public-service-act-1999.pdf, p.27",
      "values:originalText": "An Agency Head may from time to time determine the duties of an\nAPS employee in the Agency, and the place or places at which the\nduties are to be performed.",
      "skos:definition": "An Agency Head may from time to time determine the duties of an\nAPS employee in the Agency, and the place or places at which the\nduties are to be performed.",
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-25-norm"
        }
      ],
      "cml:integrityHash": "620c64d46df8af1879915f034ba6cde3f388abf72a882c46d4bd926e0ca38da5",
      "skos:note": "Agency Head determines APS employee duties and performance locations."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-25",
      "@type": "cof:Section",
      "cof:title": "25 Assignment of duties",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "An Agency Head may from time to time determine the duties of an\nAPS employee in the Agency, and the place or places at which the\nduties are to be performed."
    },
