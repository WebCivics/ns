    {
      "@id": "concept:public-service-act-1999-sec-41d",
      "@type": "cml:Concept",
      "skos:prefLabel": "41D Special reviews",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-41d"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.43",
      "values:originalText": "(1) The Prime Minister may direct the Commissioner to conduct a\nreview (a special review) of:\n(a) any matter relating to an Agency; or\n(b) the functional relationships between 2 or more Agencies.\n(2) The Commissioner must give a report on the review to:\n(a) the Prime Minister; and\n(b) the Agency Minister of each Agency to which the review\nrelates.\n(3) If a direction under subsection (1) is given in writing, the direction\nis not a legislative instrument.",
      "skos:definition": "(1) The Prime Minister may direct the Commissioner to conduct a\nreview (a special review) of:\n(a) any matter relating to an Agency; or\n(b) the functional relationships between 2 or more Agencies.\n(2) The Commissioner must give a report on the review to:\n(a) the Prime Minister; and\n(b) the Agency Minister of each Agency to which the review\nrelates.\n(3) If a direction under subsection (1) is given in writing, the direction\nis not a legislative instrument.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-41d-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-41d-ss-2"
        },
