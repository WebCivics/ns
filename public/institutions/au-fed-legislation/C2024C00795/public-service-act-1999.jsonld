      },
      "cml:premiseText": "(1) The appointment of a Head of Mission by the Governor-General\ncannot take effect unless the person is an APS employee.",
      "cml:conclusionText": "The person must be an APS employee to be appointed as Head of Mission."
    },
    {
      "@id": "concept:public-service-act-1999-sec-39-ss-2",
      "@type": "cml:Concept",
