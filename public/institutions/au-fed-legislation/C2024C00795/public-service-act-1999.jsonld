      "cml:premiseText": "SES employee is a non-SES employee acting in a position usually occupied by an SES employee.",
      "cml:conclusionText": "Definition of SES employee"
    },
    {
      "@id": "concept:public-service-act-1999-sec-7-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
