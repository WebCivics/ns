      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:public-service-act-1999-sec-39-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires APS employee status",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
