    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-41c-ss-4",
      "@type": "cof:Section",
      "cof:title": "41C(4) Systems reviews",
      "values:kind": "subsection",
      "cof:pageNumber": 42,
      "values:originalText": "(4) The Commissioner must give a report on the review to:\n(a) the Prime Minister; and\n(b) if the review was conducted because of a request by an\nAgency Minister or a Secretary—the Agency Minister or the\nSecretary."
    },
