      "cml:integrityHash": "e4ddad7ef0dd73b6e6f29b36157b70e40311a07b3e15928272258e5409f4866d",
      "skos:note": "Must provide long-term insights report to Public Service Minister",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-64a-ss-3a",
      "@type": "cof:Section",
      "cof:title": "64A(3A) Long-term insights reports",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(3A) As soon as practicable after a long-term insights report has been\ncompleted, the Secretaries Board must give the report to the Public\nService Minister."
