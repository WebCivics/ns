        }
      ],
      "cml:integrityHash": "4c6a15f02434d6f9e7bc1c767d95183c885b7914b9db1799d91ffa70ca4e3fb6",
      "skos:note": "Must provide a copy of long-term insights report to each House within 15 sitting days.",
      "dc:description": "true"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-64a-ss-3b",
      "@type": "cof:Section",
      "cof:title": "64A(3B) Long-term insights reports",
      "values:kind": "subsection",
      "cof:pageNumber": 64,
      "values:originalText": "(3B) The Public Service Minister must cause a copy of a long-term\ninsights report to be tabled in each House of the Parliament within\n15 sitting days of that House after the report is given to the\nMinister."
    },
