    {
      "@id": "concept:public-service-act-1999-sec-44",
      "@type": "cml:Concept",
      "skos:prefLabel": "44 State of the Service report",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-44"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.44",
      "values:originalText": "(1) As soon as practicable after the end of each financial year, the\nCommissioner must give a report to the Agency Minister, for\npresentation to the Parliament, on the state of the APS during the\nyear.\n(2) An Agency Head must give the Commissioner whatever\ninformation the Commissioner requires for the purpose of\npreparing the report referred to in subsection (1).\n(3) The Agency Minister must cause a copy of the report given to the\nMinister under subsection (1) to be laid before each House of the\nParliament by 30 November after the financial year to which the\nreport relates.\n\n\nThe Australian Public Service Commissioner  Part 5\nCommissioner’s functions etc.  Division 1\nSection 44A\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "skos:definition": "(1) As soon as practicable after the end of each financial year, the\nCommissioner must give a report to the Agency Minister, for\npresentation to the Parliament, on the state of the APS during the\nyear.\n(2) An Agency Head must give the Commissioner whatever\ninformation the Commissioner requires for the purpose of\npreparing the report referred to in subsection (1).\n(3) The Agency Minister must cause a copy of the report given to the\nMinister under subsection (1) to be laid before each House of the\nParliament by 30 November after the financial year to which the\nreport relates.\n\n\nThe Australian Public Service Commissioner  Part 5\nCommissioner’s functions etc.  Division 1\nSection 44A\nPublic Service Act 1999\nCompilation date: 11/12/2024",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-44-ss-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-44-ss-2"
        },
        {
          "@id": "concept:public-service-act-1999-sec-44-ss-3"
        }
      ],
      "cml:integrityHash": "79d22073475b366e6c7b9cc3ba2740fceb60a89acf50a89f046162f1474cac2c"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-44",
      "@type": "cof:Section",
      "cof:title": "44 State of the Service report",
      "values:kind": "section",
      "cof:pageNumber": 44,
      "values:originalText": "(1) As soon as practicable after the end of each financial year, the\nCommissioner must give a report to the Agency Minister, for\npresentation to the Parliament, on the state of the APS during the\nyear.\n(2) An Agency Head must give the Commissioner whatever\ninformation the Commissioner requires for the purpose of\npreparing the report referred to in subsection (1).\n(3) The Agency Minister must cause a copy of the report given to the\nMinister under subsection (1) to be laid before each House of the\nParliament by 30 November after the financial year to which the\nreport relates.\n\n\nThe Australian Public Service Commissioner  Part 5\nCommissioner’s functions etc.  Division 1\nSection 44A\nPublic Service Act 1999\nCompilation date: 11/12/2024"
    },
