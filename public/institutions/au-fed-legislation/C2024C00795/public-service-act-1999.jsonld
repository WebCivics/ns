      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.29",
      "values:originalText": "(2) The amount notified by the Agency Head:\n(a) is taken to have been received by the employee on behalf of\nthe Commonwealth; and\n(b) may be recovered by the Commonwealth from the employee\nas a debt in a court of competent jurisdiction.",
      "skos:definition": "(2) The amount notified by the Agency Head:\n(a) is taken to have been received by the employee on behalf of\nthe Commonwealth; and\n(b) may be recovered by the Commonwealth from the employee\nas a debt in a court of competent jurisdiction.",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-31"
      },
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-31-ss-2-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-31-ss-2-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "1eec69f94e875b2206349072c2a47ab7f30940f78df5f52781317862ba524406",
      "skos:note": "Employee must return additional remuneration to the Commonwealth."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-31-ss-2",
      "@type": "cof:Section",
      "cof:title": "31(2) Forfeiture of additional remuneration",
      "values:kind": "subsection",
      "cof:pageNumber": 29,
      "values:originalText": "(2) The amount notified by the Agency Head:\n(a) is taken to have been received by the employee on behalf of\nthe Commonwealth; and\n(b) may be recovered by the Commonwealth from the employee\nas a debt in a court of competent jurisdiction."
    },
