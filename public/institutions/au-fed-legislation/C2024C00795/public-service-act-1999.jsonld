    },
    {
      "@id": "concept:public-service-act-1999-sec-23-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "23(5) Classification Rules",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-23-ss-5"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
