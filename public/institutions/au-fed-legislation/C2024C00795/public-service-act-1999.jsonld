    {
      "@id": "concept:public-service-act-1999-sec-41b-ss-7",
      "@type": "cml:Concept",
      "skos:prefLabel": "41B(7) Inquiry into alleged breach of Code of Conduct by APS",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-41b-ss-7"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.40",
      "values:originalText": "(7) For the purposes of inquiring into and determining whether an APS\nemployee, or a former APS employee, in an Agency has breached\nthe Code of Conduct, the Commissioner may exercise the same\npowers as the Agency Head may exercise in determining whether\nan APS employee, or a former APS employee, in the Agency has\nbreached the Code of Conduct.\nReport on results of inquiry",
      "skos:definition": "(7) For the purposes of inquiring into and determining whether an APS\nemployee, or a former APS employee, in an Agency has breached\nthe Code of Conduct, the Commissioner may exercise the same\npowers as the Agency Head may exercise in determining whether\nan APS employee, or a former APS employee, in the Agency has\nbreached the Code of Conduct.\nReport on results of inquiry",
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-41b"
      },
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-41b-ss-7-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-41b-ss-7-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "a8e9fa7a21d3902a97ecfd90b450be33549ac0e6340a967a0620802dcb355c7a",
      "skos:note": "Commissioner may exercise powers to determine breach of Code of Conduct."
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-41b-ss-7",
      "@type": "cof:Section",
      "cof:title": "41B(7) Inquiry into alleged breach of Code of Conduct by APS",
      "values:kind": "subsection",
      "cof:pageNumber": 40,
      "values:originalText": "(7) For the purposes of inquiring into and determining whether an APS\nemployee, or a former APS employee, in an Agency has breached\nthe Code of Conduct, the Commissioner may exercise the same\npowers as the Agency Head may exercise in determining whether\nan APS employee, or a former APS employee, in the Agency has\nbreached the Code of Conduct.\nReport on results of inquiry"
    },
    {
      "@id": "concept:public-service-act-1999-sec-41b-ss-7-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:public-service-act-1999-sec-41b-ss-7"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:public-service-act-1999-sec-41b-ss-7-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "may",
      "cml:logicSummary": "Exercise power to inquire into breach",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
