        },
        {
          "@id": "concept:public-service-act-1999-sec-23-ss-6-logic-descriptionlogic-1"
        },
        {
          "@id": "concept:public-service-act-1999-sec-23-ss-6-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "fca50394900efa6368d704be12423682cd24e137d2884f0e221e6e0a708945cf",
      "skos:note": "Defines industrial instrument for classification purposes"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-23-ss-6",
      "@type": "cof:Section",
      "cof:title": "23(6) Classification Rules",
      "values:kind": "subsection",
      "cof:pageNumber": 24,
      "values:originalText": "(6) In this section:\nindustrial instrument means:\n(a) a modern award; or\n(b) an enterprise agreement; or\n(c) a workplace determination; or\n(d) a WR Act transitional instrument; or\n(e) a transitional APCS."
    },
