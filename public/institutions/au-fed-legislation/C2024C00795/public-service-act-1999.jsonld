      "cml:confidence": {
        "@value": 0.5,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "The commencement date is specified as July 1, 2006",
      "cml:conclusionText": "A sequence of events can be traced to the commencement date"
    },
    {
      "@id": "concept:public-service-act-1999-sec-21-2-logic-diffusion-4",
