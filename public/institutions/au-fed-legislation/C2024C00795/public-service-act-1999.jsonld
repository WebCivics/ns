      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-49-ss-3",
      "@type": "cof:Section",
      "cof:title": "49(3) Merit Protection Commissioner",
      "values:kind": "subsection",
      "cof:pageNumber": 53,
      "values:originalText": "(3) The Merit Protection Commissioner may, on behalf of the\nCommonwealth, engage consultants to assist in the performance of\nthe Merit Protection Commissioner’s functions."
    },
    {
      "@id": "concept:public-service-act-1999-sec-49-ss-3-norm",
      "@type": "values:Undertaking",
      "cml:modality": {
        "@id": "cml:Deontic"
