    },
    {
      "@id": "concept:public-service-act-1999-sec-1",
      "@type": "cml:Concept",
      "skos:prefLabel": "1 Short title",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-1"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
