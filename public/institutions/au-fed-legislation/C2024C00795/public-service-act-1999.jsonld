    {
      "@id": "concept:public-service-act-1999-sec-43",
      "@type": "cml:Concept",
      "skos:prefLabel": "43 Commissioner’s inquiry powers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-43"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.43",
      "values:originalText": "(1) Each of the following is a special inquiry for the purpose of this\nsection:\n(a) an inquiry that is conducted by the Commissioner for the\npurpose of paragraph 41(2)(c), (f) or (l) and is notified by the\nCommissioner in the Gazette;",
      "skos:definition": "(1) Each of the following is a special inquiry for the purpose of this\nsection:\n(a) an inquiry that is conducted by the Commissioner for the\npurpose of paragraph 41(2)(c), (f) or (l) and is notified by the\nCommissioner in the Gazette;",
      "cml:asserts": [
        {
          "@id": "concept:public-service-act-1999-sec-43-norm"
        },
        {
          "@id": "concept:public-service-act-1999-sec-43-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "caecf10a101ab7e2346033d93bba8e8456c297d7562f026fc3c83eebc59da6d5",
      "skos:note": "Commissioner's inquiry powers"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-43",
      "@type": "cof:Section",
      "cof:title": "43 Commissioner’s inquiry powers",
      "values:kind": "section",
      "cof:pageNumber": 43,
      "values:originalText": "(1) Each of the following is a special inquiry for the purpose of this\nsection:\n(a) an inquiry that is conducted by the Commissioner for the\npurpose of paragraph 41(2)(c), (f) or (l) and is notified by the\nCommissioner in the Gazette;"
    },
