    {
      "@id": "concept:public-service-act-1999-sec-72b-ss-5",
      "@type": "cml:Concept",
      "skos:prefLabel": "72B(5) Protection of information—Merit Protection Commissioner’s",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-72b-ss-5"
      },
