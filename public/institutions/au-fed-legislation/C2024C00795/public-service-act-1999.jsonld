    {
      "@id": "concept:public-service-act-1999-sec-149-2",
      "@type": "cml:Concept",
      "skos:prefLabel": "149 Section 149",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-149-2"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "public-service-act-1999.pdf"
      },
      "dc:source": "public-service-act-1999.pdf, p.80",
      "values:originalText": "1 of the Criminal Code that relates to this Act).\nPerson not liable to penalty\n(4) The person is not liable to any penalty under the provisions of any\nother law by reason of his or her giving the information or\nproducing the document to the Merit Protection Commissioner.\nDisclosure of personal information is authorised for purposes of\nPrivacy Act\n(5) To the extent that the giving of the information or the production of\nthe document to the Merit Protection Commissioner involves a\ndisclosure of personal information, the disclosure is taken to be\nauthorised by this Act for the purposes of the Privacy Act 1988.\nLegal professional privilege not affected\n(6) Subsection (3) does not otherwise affect a claim of legal\nprofessional privilege that anyone may make in relation to the\ninformation or document.",
      "skos:definition": "1 of the Criminal Code that relates to this Act).\nPerson not liable to penalty\n(4) The person is not liable to any penalty under the provisions of any\nother law by reason of his or her giving the information or\nproducing the document to the Merit Protection Commissioner.\nDisclosure of personal information is authorised for purposes of\nPrivacy Act\n(5) To the extent that the giving of the information or the production of\nthe document to the Merit Protection Commissioner involves a\ndisclosure of personal information, the disclosure is taken to be\nauthorised by this Act for the purposes of the Privacy Act 1988.\nLegal professional privilege not affected\n(6) Subsection (3) does not otherwise affect a claim of legal\nprofessional privilege that anyone may make in relation to the\ninformation or document.",
      "cml:hasPart": [
        {
          "@id": "concept:public-service-act-1999-sec-149-2-ss-4"
        },
        {
          "@id": "concept:public-service-act-1999-sec-149-2-ss-5"
        },
        {
          "@id": "concept:public-service-act-1999-sec-149-2-ss-6"
        }
      ],
      "cml:integrityHash": "8c08fd6d92a0dc45a5085a5203e9c25d651f4316279a0ca8caa60a2203a3fc61"
    },
    {
      "@id": "https://ns.webcivics.net/values/public-service-act-1999#sec-149-2",
      "@type": "cof:Section",
      "cof:title": "149 Section 149",
      "values:kind": "section",
      "cof:pageNumber": 80,
      "values:originalText": "1 of the Criminal Code that relates to this Act).\nPerson not liable to penalty\n(4) The person is not liable to any penalty under the provisions of any\nother law by reason of his or her giving the information or\nproducing the document to the Merit Protection Commissioner.\nDisclosure of personal information is authorised for purposes of\nPrivacy Act\n(5) To the extent that the giving of the information or the production of\nthe document to the Merit Protection Commissioner involves a\ndisclosure of personal information, the disclosure is taken to be\nauthorised by this Act for the purposes of the Privacy Act 1988.\nLegal professional privilege not affected\n(6) Subsection (3) does not otherwise affect a claim of legal\nprofessional privilege that anyone may make in relation to the\ninformation or document."
    },
    {
