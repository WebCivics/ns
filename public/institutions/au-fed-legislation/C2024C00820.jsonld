      "cml:logicSummary": "The Commissioner must give a data scheme entity written directions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "must",
      "cml:premiseText": "(1) The Commissioner may give a data scheme entity a written direction requiring the entity to take, or not to take, specified actions if..."
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-112-ss-1-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Commissioner can give a data scheme entity written directions.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "can",
      "cml:premiseText": "(1) The Commissioner may give a data scheme entity a written direction requiring the entity to take, or not to take, specified actions if..."
    },
    {
