      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "9a7b2279e44bef56ccc7edce0e1fc7f1efe868e71b15d00bed2145ba40ef6219",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
