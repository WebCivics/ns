        "@id": "cml:Deontic"
      },
      "cml:operator": "authorise",
      "cml:premiseText": "Commonwealth bodies are authorised to share their public sector data with accredited users."
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-12-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Commonwealth bodies must control the data.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "0.5000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
