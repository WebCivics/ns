      },
      "realizedBy": "doc:data-availability-and-transparency-act-2022#sec-13",
      "cml:schemaVersion": "2"
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-13-ss-1",
      "@type": "cml:Concept",
      "dc:source": "data-availability-and-transparency-act-2022.pdf, p.29",
      "skos:note": "Authorises data custodian to share public sector data with another entity under specified conditions.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "13(1) Authorisation for data custodian to share public sector data"
      },
      "wasDerivedFrom": "data-availability-and-transparency-act-2022.pdf",
      "asserts": [
        "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-norm",
        "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-deontic-1",
        "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-descriptionlogic-2",
        "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-alleninterval-3",
        "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-deontic-4",
        "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-descriptionlogic-5",
        "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-deontic-6"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "5a76bcc9238c1e12f91cf0a99a7a7803842f4b225f1d5781eb6d061ffaa47e8e",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:data-availability-and-transparency-act-2022#sec-13-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:data-availability-and-transparency-act-2022-sec-13"
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The sharer shares with an accredited user if the sharing is in accordance with the data sharing agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Sharing occurs during the effect of a registered data sharing agreement.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "During",
      "cml:premiseText": "(d) the sharing is in accordance with the data sharing agreement;"
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The sharer is authorised to share data with another entity.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorisation to share data.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permit",
      "cml:premiseText": "(a) the constitutional requirements in subsection (4) are met;"
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The intermediary shares with the user on behalf of the sharer if it is an ADSP and accredited.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorisation to share ADSP-enhanced data.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permits",
      "cml:premiseText": "(h) if the sharer shares through an intermediary—the intermediary is an ADSP and its accreditation is not suspended;"
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The sharer shares personal information with an accredited user if it meets the privacy coverage condition.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Authorisation to share personal information.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Permits",
      "cml:premiseText": "(g) if the data shared with the user includes personal information—the privacy coverage condition in section 16E is met in relation to the user;"
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The sharer shares with an accredited user if the project is covered by a registered data sharing agreement.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines a class of entities that can share public sector data.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:premiseText": "(c) the project the sharing is part of is covered by a registered data sharing agreement that is in effect and that meets the requirements of this Act;"
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-13-ss-1-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The intermediary shares with the user on behalf of the sharer if it meets the privacy coverage condition.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Defines a class of entities that can share ADSP-enhanced data.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "Classifies",
      "cml:premiseText": "(i) if the sharer shares through an intermediary—the privacy coverage condition in section 16E is met in relation to the intermediary."
    },
