      "cml:logicSummary": "Prohibition on certain sharing",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "bar",
      "cml:premiseText": "Some sharing of data is barred (e.g. if the sharing would contravene a prescribed law or an agreement)."
