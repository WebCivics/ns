    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-39-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner is assisted in the performance of these functions by APS employees during their working hours.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The Commissioner is assisted in the performance of these functions by APS employees during their working hours.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "The Commissioner is assisted in the performance of these functions by APS employees in the Department who are made available by the Secretary."
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-39-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner has obligations to regulate and enforce the scheme.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Commissioner has obligations.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "The Commissioner is the regulator for the data sharing scheme."
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-39-logic-deontic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner has the power to engage contractors and consultants.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Commissioner may engage contractors and consultants.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "The Commissioner may also engage contractors and consultants."
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-39-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner has access to the advice of the National Data Advisory Council.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The Commissioner is assisted by the advice of the National Data Advisory Council.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "The Commissioner is also assisted by the advice of the National Data Advisory Council."
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-39-logic-deontic-6",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner's role is constitutionally mandated.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "The constitutional basis for the roles of the Commissioner and Council is set out in subsections 42(2) and 61(2).",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "has",
      "cml:premiseText": "The constitutional basis for the roles of the Commissioner and Council is set out in subsections 42(2) and 61(2)."
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-39-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The Commissioner's functions include regulating and enforcing the scheme.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "The Commissioner's functions include regulating and enforcing the scheme.",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "is",
      "cml:premiseText": "The Commissioner also has the function of regulating and enforcing the scheme, which includes dealing with complaints..."
    },
