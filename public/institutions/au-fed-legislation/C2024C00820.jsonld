      "@type": "cml:LogicApplication",
      "cml:conclusionText": "unless at least one of the following paragraphs applies in relation to the conduct constituting the alleged contravention or offence:",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Obligation to comply with the Act's civil penalty provisions.",
