    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-39",
      "@type": "cml:Concept",
      "dc:source": "data-availability-and-transparency-act-2022.pdf, p.77",
      "skos:note": "The Commissioner has obligations to regulate and enforce the data sharing scheme.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "39 Simplified outline of this Chapter"
      },
      "wasDerivedFrom": "data-availability-and-transparency-act-2022.pdf",
