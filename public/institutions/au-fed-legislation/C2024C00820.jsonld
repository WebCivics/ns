      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "The direction must be given during an emergency or high risk situation.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "during",
      "cml:premiseText": "(b) for a requirement to take specified actions—it is necessary, to address the situation or prevent it arising again, for the entity to take the actions immediately or as soon as practicable; and"
    },
