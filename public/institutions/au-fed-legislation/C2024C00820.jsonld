      "cml:logicSummary": "Data custodian requirement",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "control",
      "cml:premiseText": "Commonwealth bodies must be the data custodian of public sector data they share."
    },
    {
      "@id": "concept:data-availability-and-transparency-act-2022-sec-12-logic-deontic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Sharing of data is prohibited in certain circumstances.",
      "cml:confidence": {
