concept:data-availability-and-transparency-act-2022-sec-122 a cml:Concept ;
    skos:prefLabel "122 Review by the Administrative Review Tribunal"@en ;
    cml:realizedBy doc:sec-122 ;
    values:originalText "Applications may be made to the Administrative Review Tribunal to review a reviewable decision if any of the following apply: (a) the decision was made personally by the Commissioner (other than a decision made by the Commissioner in the Commissioner’s capacity as a delegate of the Minister); (aa) the decision was made personally by the Minister; (b) the decision has been affirmed under paragraph 120(1)(a); (c) the decision has been varied under paragraph 120(1)(b); (d) the decision was made in substitution for another decision under paragraph 120(1)(c).  Chapter 6  Other matters" ;
    skos:definition "Applications may be made to the Administrative Review Tribunal to review a reviewable decision if any of the following apply: (a) the decision was made personally by the Commissioner (other than a decision made by the Commissioner in the Commissioner’s capacity as a delegate of the Minister); (aa) the decision was made personally by the Minister; (b) the decision has been affirmed under paragraph 120(1)(a); (c) the decision has been varied under paragraph 120(1)(b); (d) the decision was made in substitution for another decision under paragraph 120(1)(c).  Chapter 6  Other matters"@en ;
    cml:integrityHash "39616824def90a12c4b9a4f2c88a2bdeb09fe429d9861e08c4e752090b56a0dc" ;
    cof:pageNumber "139"^^xsd:integer ;
    skos:note "Applications may be made to review a reviewable decision under certain circumstances." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.139" ;
    cml:asserts concept:data-availability-and-transparency-act-2022-sec-122-norm .
