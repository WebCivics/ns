concept:data-availability-and-transparency-act-2022-sec-35 a cml:Concept ;
    skos:prefLabel "35 Definition of data breach"@en ;
    cml:realizedBy doc:sec-35 ;
    values:originalText "If: (a) a data scheme entity holds scheme data; and (b) any of the following apply: (i) there is unauthorised access to or disclosure of the data; (ii) the data is lost in circumstances where there is likely to be unauthorised access to or disclosure of the data; (iii) an event prescribed by a data code occurs in relation to the data; the access, disclosure, loss or event is a data breach of the data scheme entity." ;
    skos:definition "If: (a) a data scheme entity holds scheme data; and (b) any of the following apply: (i) there is unauthorised access to or disclosure of the data; (ii) the data is lost in circumstances where there is likely to be unauthorised access to or disclosure of the data; (iii) an event prescribed by a data code occurs in relation to the data; the access, disclosure, loss or event is a data breach of the data scheme entity."@en ;
    cml:integrityHash "f7f589df0f0392f6cee20f9d4dcabaa609632de7730a7853217d0b2e1c1459ac" ;
    cof:pageNumber "72"^^xsd:integer ;
    skos:note "Data breach definition" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.72" ;
