    cml:logicSummary "Penalty for failing to comply with a notice." ;
    cml:premiseText "(3) A person commits an offence if..." ;
    cml:conclusionText "...Penalty: Imprisonment for 6 months." ;
    cml:executionSurface "modalities::logic::deontic" ;
    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

