concept:data-availability-and-transparency-act-2022-sec-107 a cml:Concept ;
    skos:prefLabel "107 Transfer of matters to appropriate authority"@en ;
    cml:realizedBy doc:sec-107 ;
    values:originalText "If, at any time while dealing with a matter under this Act (including a complaint under section 88 or 94), the Commissioner forms the opinion that the matter: (a) is capable of being dealt with by an agency or body to which the Commissioner is authorised to disclose information under section 108; and (b) could be more effectively or conveniently dealt with by that agency or body; the Commissioner may cease to deal with the matter and request the other agency or body to deal with the matter instead.  Chapter 5  Regulation and enforcement" ;
    skos:definition "If, at any time while dealing with a matter under this Act (including a complaint under section 88 or 94), the Commissioner forms the opinion that the matter: (a) is capable of being dealt with by an agency or body to which the Commissioner is authorised to disclose information under section 108; and (b) could be more effectively or conveniently dealt with by that agency or body; the Commissioner may cease to deal with the matter and request the other agency or body to deal with the matter instead.  Chapter 5  Regulation and enforcement"@en ;
    cml:integrityHash "5eada329e8addead6409d88a4662d39eed40f337f4d3f486785a5678564f94e0" ;
    cof:pageNumber "125"^^xsd:integer ;
    skos:note "Commissioner may transfer matter to another agency or body." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.125" ;
    cml:asserts concept:data-availability-and-transparency-act-2022-sec-107-norm .
