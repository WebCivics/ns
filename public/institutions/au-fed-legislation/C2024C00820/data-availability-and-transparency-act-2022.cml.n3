concept:data-availability-and-transparency-act-2022-sec-58 a cml:Concept ;
    skos:prefLabel "58 Resignation"@en ;
    cml:realizedBy doc:sec-58 ;
    values:originalText "(1) The Commissioner may resign the Commissioner’s appointment by giving the Governor-General a written resignation. (2) The resignation takes effect on the day it is received by the Governor-General or, if a later day is specified in the resignation, on that later day." ;
    skos:definition "(1) The Commissioner may resign the Commissioner’s appointment by giving the Governor-General a written resignation. (2) The resignation takes effect on the day it is received by the Governor-General or, if a later day is specified in the resignation, on that later day."@en ;
    cml:integrityHash "5c234ee46e9263bd63034339b3d08f27d41a65e0cecf4d57b5f99d9e482c5e57" ;
    cof:pageNumber "84"^^xsd:integer ;
