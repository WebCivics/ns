doc:sec-16c-ss-3 a cof:Section ;
    cof:title "16C(3) Project involving use of de-identification or secure access data" ;
    values:kind "subsection" ;
    values:originalText "(3) A de-identification data service is a service to treat data that includes personal information so that the data is de-identified, using techniques that restrict the data being used in a way that would have the result that the data ceases to be de-identified." ;
    cof:pageNumber "46"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-16c-ss-4 a cml:Concept ;
    skos:prefLabel "16C(4) Project involving use of de-identification or secure access data"@en ;
    cml:realizedBy doc:sec-16c-ss-4 ;
    values:originalText "(4) A secure access data service is: (a) the service of providing ADSP-controlled access; or (b) any other service that enables an entity to access data under the control of another entity and that includes controls to prevent or minimise the risk of the data being misused." ;
    skos:definition "(4) A secure access data service is: (a) the service of providing ADSP-controlled access; or (b) any other service that enables an entity to access data under the control of another entity and that includes controls to prevent or minimise the risk of the data being misused."@en ;
    cml:integrityHash "0d940191e313f6c4cf622715dab7ecc397f13c2113d8f3ff5011aa3c4de556d9" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-16c ;
    cof:pageNumber "46"^^xsd:integer ;
    skos:note "Definition of secure access data service" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.46" ;
    cml:asserts concept:data-availability-and-transparency-act-2022-sec-16c-ss-4-norm .
