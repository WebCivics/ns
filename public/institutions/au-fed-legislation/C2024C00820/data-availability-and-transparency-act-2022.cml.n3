doc:sec-89-ss-1 a cof:Section ;
    cof:title "89(1) Respondents" ;
    values:kind "subsection" ;
    values:originalText "(1) If the complaint is about an entity that is a Commonwealth body, the respondent is whichever of the following applies: (a) if the Commonwealth body is a body corporate or an individual—the Commonwealth body; (b) if the Commonwealth body is unincorporated—the principal executive of the Commonwealth body within the meaning of section 37 of the Privacy Act 1988." ;
    cof:pageNumber "111"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-89-ss-2 a cml:Concept ;
    skos:prefLabel "89(2) Respondents"@en ;
    cml:realizedBy doc:sec-89-ss-2 ;
    values:originalText "(2) If the complaint is about an entity that is not a Commonwealth body, the respondent is the entity.  Chapter 5  Regulation and enforcement" ;
    skos:definition "(2) If the complaint is about an entity that is not a Commonwealth body, the respondent is the entity.  Chapter 5  Regulation and enforcement"@en ;
    cml:integrityHash "ca1f645c3429ccc45819f110b9dec7d2803c2dfceb7378b4bae0b57322dd6a99" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-89 ;
    cof:pageNumber "111"^^xsd:integer ;
    skos:note "The respondent is the entity about which the complaint is made." ;
    cml:curationStatus cml:Proposed ;
