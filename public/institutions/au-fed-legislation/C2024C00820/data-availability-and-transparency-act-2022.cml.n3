doc:sec-51 a cof:Section ;
    cof:title "51 Independence of Commissioner" ;
    values:kind "section" ;
    values:originalText "Subject to this Act and other laws of the Commonwealth, the Commissioner has discretion in the performance or exercise of the Commissioner’s functions or powers and is not subject to direction by any person in relation to the performance or exercise of those functions or powers." ;
    cof:pageNumber "82"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-52 a cml:Concept ;
    skos:prefLabel "52 Commissioner not to be sued"@en ;
    cml:realizedBy doc:sec-52 ;
    values:originalText "The Commissioner, and any person acting under the direction or authority of the Commissioner, is not liable to an action, suit or proceeding in relation to an act done or omitted to be done in good faith in the performance or purported performance, or exercise or purported exercise, of a function or power conferred by this Act, the rules or a data code.  National Data Commissioner and National Data Advisory Council  Chapter 4 National Data Commissioner  Part 4.2 Terms and conditions etc.  Division 2 Section 53 Data Availability and Transparency Act 2022 Compilation date: 11/12/2024" ;
    skos:definition "The Commissioner, and any person acting under the direction or authority of the Commissioner, is not liable to an action, suit or proceeding in relation to an act done or omitted to be done in good faith in the performance or purported performance, or exercise or purported exercise, of a function or power conferred by this Act, the rules or a data code.  National Data Commissioner and National Data Advisory Council  Chapter 4 National Data Commissioner  Part 4.2 Terms and conditions etc.  Division 2 Section 53 Data Availability and Transparency Act 2022 Compilation date: 11/12/2024"@en ;
    cml:integrityHash "a28ce8548b7c26c1a0470ec067e927e6726d9e128601b2dcb114091aa5d45a4d" ;
    cof:pageNumber "82"^^xsd:integer ;
    skos:note "Commissioner and employees are not liable for actions taken in good faith." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.82" ;
