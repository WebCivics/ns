concept:data-availability-and-transparency-act-2022-sec-16a-ss-3 a cml:Concept ;
    skos:prefLabel "16A(3) General privacy protections"@en ;
    cml:realizedBy doc:sec-16a-ss-3 ;
    values:originalText "(3) If data that has been de-identified is shared, the data sharing agreement that covers the sharing must prohibit the accredited user from taking any action that may have the result that the data ceases to be de-identified." ;
    skos:definition "(3) If data that has been de-identified is shared, the data sharing agreement that covers the sharing must prohibit the accredited user from taking any action that may have the result that the data ceases to be de-identified."@en ;
