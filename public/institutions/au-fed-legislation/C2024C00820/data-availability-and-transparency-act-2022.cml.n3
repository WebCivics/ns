concept:data-availability-and-transparency-act-2022-sec-57 a cml:Concept ;
    skos:prefLabel "57 Leave of absence"@en ;
    cml:realizedBy doc:sec-57 ;
    values:originalText "(1) The Commissioner has the recreation leave entitlements that are determined by the Remuneration Tribunal. (2) The Minister may grant the Commissioner leave of absence, other than recreation leave, on the terms and conditions as to remuneration or otherwise that the Minister determines." ;
    skos:definition "(1) The Commissioner has the recreation leave entitlements that are determined by the Remuneration Tribunal. (2) The Minister may grant the Commissioner leave of absence, other than recreation leave, on the terms and conditions as to remuneration or otherwise that the Minister determines."@en ;
    cml:integrityHash "3927a3752d3044f4c314aea9b669b01d8e4ca1c77f528af1b2b3e49580efa4ed" ;
