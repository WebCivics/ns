doc:sec-11-2-ss-2 a cof:Section ;
    cof:title "11(2) Entity definitions" ;
    values:kind "subsection" ;
    values:originalText "(2) An entity is a data custodian if the entity: (a) is a Commonwealth body; and (b) is not an excluded entity; and (c) either: (i) controls public sector data (whether alone or jointly with another entity), including by having the right to deal with that data; or (ii) has become the data custodian of output of a project in accordance with section 20F." ;
    cof:pageNumber "22"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-11-2-ss-2a a cml:Concept ;
    skos:prefLabel "11(2A) Entity definitions"@en ;
    cml:realizedBy doc:sec-11-2-ss-2a ;
    values:originalText "(2A) If a data custodian of public sector data shares the data with an intermediary under section 13 as part of a project, the data custodian is taken also to be the data custodian of any ADSP-enhanced data of the project." ;
    skos:definition "(2A) If a data custodian of public sector data shares the data with an intermediary under section 13 as part of a project, the data custodian is taken also to be the data custodian of any ADSP-enhanced data of the project."@en ;
