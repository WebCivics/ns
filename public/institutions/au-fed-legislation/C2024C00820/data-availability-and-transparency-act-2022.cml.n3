concept:data-availability-and-transparency-act-2022-sec-125a-ss-3 a cml:Concept ;
    skos:prefLabel "125A(3) Contraventions by entities of civil penalty provisions and other"@en ;
    cml:realizedBy doc:sec-125a-ss-3 ;
    values:originalText "(3) An individual whose conduct is attributed to a government entity under subsection (1) is not personally liable for a contravention of a civil penalty provision (including an ancillary contravention) in relation to the conduct." ;
    skos:definition "(3) An individual whose conduct is attributed to a government entity under subsection (1) is not personally liable for a contravention of a civil penalty provision (including an ancillary contravention) in relation to the conduct."@en ;
    cml:integrityHash "7f388e17f8c904dc240d777ecc0015d68b323f24915394aa77b3dc191357de40" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-125a ;
    cof:pageNumber "142"^^xsd:integer ;
    skos:note "Immunity from personal liability for contraventions of civil penalty provisions attributed to government entities." ;
    cml:curationStatus cml:Proposed ;
