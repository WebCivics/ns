    values:partOf concept:data-availability-and-transparency-act-2022-sec-85 ;
    cof:pageNumber "108"^^xsd:integer ;
    skos:note "Entity's accreditation will be suspended or cancelled under section 81." ;
    dc:description "(a) the reason for the refusal; (b) that the entity’s accreditation will be suspended or cancelled under section 81; (c) the entity’s review rights under Part 6.2." ;
