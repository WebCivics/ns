doc:sec-20f-ss-5 a cof:Section ;
    cof:title "20F(5) Data custodian of output of project" ;
    values:kind "subsection" ;
    values:originalText "(5) A data sharing agreement that covers a project may appoint an entity that is party to the agreement, other than in the capacity of user, as the data custodian of specified output of the project, if: (a) the entity is a Commonwealth body; and (b) the entity is not an excluded entity; and (c) the output is public sector data and not a copy of the shared data collected by the user; and (d) the agreement allows the user to provide the entity with access to the output in circumstances allowed by section 20C.  Chapter 2  Authorisations" ;
    cof:pageNumber "64"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-22 a cml:Concept ;
    skos:prefLabel "22 Other authorisations for data custodians not limited"@en ;
    cml:realizedBy doc:sec-22 ;
    values:originalText "The authorisation in section 13 for a data custodian to share particular data does not limit any other law of the Commonwealth or a State or Territory that authorises the data custodian to share or disclose the data." ;
    skos:definition "The authorisation in section 13 for a data custodian to share particular data does not limit any other law of the Commonwealth or a State or Territory that authorises the data custodian to share or disclose the data."@en ;
    cml:integrityHash "9e93a301d6afc274cf250a35590df3436a0c0ece140029c18aa59507d8dd25a8" ;
    cof:pageNumber "66"^^xsd:integer ;
    skos:note "No limitation on data sharing by data custodians under other laws." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.66" ;
