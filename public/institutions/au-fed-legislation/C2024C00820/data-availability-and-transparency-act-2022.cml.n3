doc:sec-77a-ss-2 a cof:Section ;
    cof:title "77A(2) General provisions relating to accreditation" ;
    values:kind "subsection" ;
    values:originalText "(2) An entity accredited as an accredited user continues to be an accredited user (including while its accreditation as an accredited user is suspended) until the accreditation is cancelled." ;
    cof:pageNumber "97"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-77a-ss-3 a cml:Concept ;
    skos:prefLabel "77A(3) General provisions relating to accreditation"@en ;
    cml:realizedBy doc:sec-77a-ss-3 ;
    values:originalText "(3) Accreditation is granted on the basis that: (a) under Part 5.2, the entity may be accredited with conditions of accreditation and conditions of accreditation may be imposed, varied or removed while the entity is accredited; and (b) the accreditation may be suspended or cancelled under section 81; and (c) the accreditation may be cancelled, revoked, terminated or varied, and conditions of accreditation may be imposed, varied or removed, by or under later legislation; and (d) no compensation is payable in any of those events.  Chapter 5  Regulation and enforcement" ;
    skos:definition "(3) Accreditation is granted on the basis that: (a) under Part 5.2, the entity may be accredited with conditions of accreditation and conditions of accreditation may be imposed, varied or removed while the entity is accredited; and (b) the accreditation may be suspended or cancelled under section 81; and (c) the accreditation may be cancelled, revoked, terminated or varied, and conditions of accreditation may be imposed, varied or removed, by or under later legislation; and (d) no compensation is payable in any of those events.  Chapter 5  Regulation and enforcement"@en ;
    cml:integrityHash "a5d59f8662031104a9e8fa4fb33d2159863ca83e5415206ef0cfe4e6b21bf000" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-77a ;
    cof:pageNumber "97"^^xsd:integer ;
    skos:note "Conditions for accreditation" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
