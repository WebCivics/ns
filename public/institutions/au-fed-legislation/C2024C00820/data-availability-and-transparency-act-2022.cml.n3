concept:data-availability-and-transparency-act-2022-sec-93 a cml:Concept ;
    skos:prefLabel "93 Admissibility of things said or done in conciliation"@en ;
    cml:realizedBy doc:sec-93 ;
    values:originalText "If a complaint is dealt with by conciliation, evidence of anything said or done in the course of the conciliation is not admissible in any legal proceedings under this Act or any other law, unless: (a) the complainant and respondent otherwise agree; or (b) the thing was said or done in the course of committing an offence or contravening a civil penalty provision.  Regulation and enforcement  Chapter 5 Complaints  Part 5.3 General complaints  Division 2 Section 94 Data Availability and Transparency Act 2022 Compilation date: 11/12/2024" ;
    skos:definition "If a complaint is dealt with by conciliation, evidence of anything said or done in the course of the conciliation is not admissible in any legal proceedings under this Act or any other law, unless: (a) the complainant and respondent otherwise agree; or (b) the thing was said or done in the course of committing an offence or contravening a civil penalty provision.  Regulation and enforcement  Chapter 5 Complaints  Part 5.3 General complaints  Division 2 Section 94 Data Availability and Transparency Act 2022 Compilation date: 11/12/2024"@en ;
    cml:integrityHash "1861099598c04b4e4370af0029b81271973ee3c0aa3c2b14b623f8daa52d87db" ;
    cof:pageNumber "114"^^xsd:integer ;
    skos:note "Evidence of things said or done in conciliation is not admissible unless agreed upon by parties or related to an offence." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
