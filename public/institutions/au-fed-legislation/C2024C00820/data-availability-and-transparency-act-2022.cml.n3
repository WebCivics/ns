concept:data-availability-and-transparency-act-2022-sec-120-ss-4 a cml:Concept ;
    skos:prefLabel "120(4) Reconsideration by reviewer"@en ;
    cml:realizedBy doc:sec-120-ss-4 ;
    values:originalText "(4) Within 28 days after making the decision on the reconsideration, the reviewer must give the applicant a written statement of the reviewer’s reasons for the decision." ;
    skos:definition "(4) Within 28 days after making the decision on the reconsideration, the reviewer must give the applicant a written statement of the reviewer’s reasons for the decision."@en ;
