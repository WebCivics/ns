doc:sec-99-ss-1 a cof:Section ;
    cof:title "99(1) Assessments" ;
    values:kind "subsection" ;
    values:originalText "(1) The Commissioner may, from time to time, assess whether conduct that an entity engages or engaged in while it is or was a data scheme entity is consistent with the requirements of this Act." ;
    cof:pageNumber "117"^^xsd:integer .

