concept:data-availability-and-transparency-act-2022-sec-24 a cml:Concept ;
    skos:prefLabel "24 Simplified outline of this Chapter"@en ;
    cml:realizedBy doc:sec-24 ;
    values:originalText "The responsibilities imposed on data scheme entities are mainly set out in this Chapter, although some important responsibilities are set out elsewhere (see especially sections 14 and 14A in Chapter 2). Civil penalties apply in some cases if responsibilities in this Chapter are not met. In any case, the responsibilities may be enforced by use of the Commissioner’s other regulatory powers under Part 5.5.  Chapter 3  Responsibilities of data scheme entities" ;
    skos:definition "The responsibilities imposed on data scheme entities are mainly set out in this Chapter, although some important responsibilities are set out elsewhere (see especially sections 14 and 14A in Chapter 2). Civil penalties apply in some cases if responsibilities in this Chapter are not met. In any case, the responsibilities may be enforced by use of the Commissioner’s other regulatory powers under Part 5.5.  Chapter 3  Responsibilities of data scheme entities"@en ;
    cml:integrityHash "ed0ce5f78e09511fb3fe04e74863ebe68fd304e0c1636af47bf1062fcc35be25" ;
    cof:pageNumber "67"^^xsd:integer ;
    skos:note "Responsibilities of data scheme entities are mainly set out in this Chapter." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
