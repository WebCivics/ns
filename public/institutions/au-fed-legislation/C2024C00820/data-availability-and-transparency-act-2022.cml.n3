concept:data-availability-and-transparency-act-2022-sec-13a a cml:Concept ;
    skos:prefLabel "13A Authorisation for accredited user to collect and use data"@en ;
    cml:realizedBy doc:sec-13a ;
    values:originalText "An entity (the user) is authorised to collect data shared with the user under, or purportedly under, section 13 as part of a project, or to use output of the project, if all of the following apply: (a) the project is covered by a registered data sharing agreement that is in effect and that meets the requirements of this Act; (b) the collection or use is in accordance with the data sharing agreement; (c) the user is satisfied that the project is consistent with the data sharing principles; (d) the user is an accredited user and its accreditation is not suspended; (e) if the data shared with the user includes personal information—the privacy coverage condition in section 16E is met in relation to the user; (f) if the sharing by the sharer is not authorised by section 13— the user does not know and could not reasonably be expected to know that.  Chapter 2  Authorisations" ;
    skos:definition "An entity (the user) is authorised to collect data shared with the user under, or purportedly under, section 13 as part of a project, or to use output of the project, if all of the following apply: (a) the project is covered by a registered data sharing agreement that is in effect and that meets the requirements of this Act; (b) the collection or use is in accordance with the data sharing agreement; (c) the user is satisfied that the project is consistent with the data sharing principles; (d) the user is an accredited user and its accreditation is not suspended; (e) if the data shared with the user includes personal information—the privacy coverage condition in section 16E is met in relation to the user; (f) if the sharing by the sharer is not authorised by section 13— the user does not know and could not reasonably be expected to know that.  Chapter 2  Authorisations"@en ;
    cml:integrityHash "d9b1adb39caa9debc20b6b4eeedd8600fe0abff0296870dd2862b5dad474f9ef" ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Authorized entity can collect and use data under specified conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.31" ;
    cml:asserts concept:data-availability-and-transparency-act-2022-sec-13a-norm .
