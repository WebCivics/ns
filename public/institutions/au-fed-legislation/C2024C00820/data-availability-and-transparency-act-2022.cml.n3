doc:sec-138-ss-3 a cof:Section ;
    cof:title "138(3) Annual report" ;
    values:kind "subsection" ;
    values:originalText "(3) The report may include any other information relating to the operation of the data sharing scheme that the Commissioner considers appropriate." ;
    cof:pageNumber "160"^^xsd:integer .

