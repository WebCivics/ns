concept:data-availability-and-transparency-act-2022-sec-83a a cml:Concept ;
    skos:prefLabel "83A Lifting of suspension"@en ;
    cml:realizedBy doc:sec-83a ;
    values:originalText "If an entity’s accreditation is suspended under section 81, the accreditation authority for the entity may lift the suspension by written notice to the entity if satisfied that: (a) there are no longer any grounds for the suspension; or (b) it is otherwise no longer appropriate for the accreditation to be suspended.  Regulation and enforcement  Chapter 5 Accreditation framework  Part 5.2 Renewal of accreditation of ADSPs  Division 4 Section 84 Data Availability and Transparency Act 2022 Compilation date: 11/12/2024" ;
    skos:definition "If an entity’s accreditation is suspended under section 81, the accreditation authority for the entity may lift the suspension by written notice to the entity if satisfied that: (a) there are no longer any grounds for the suspension; or (b) it is otherwise no longer appropriate for the accreditation to be suspended.  Regulation and enforcement  Chapter 5 Accreditation framework  Part 5.2 Renewal of accreditation of ADSPs  Division 4 Section 84 Data Availability and Transparency Act 2022 Compilation date: 11/12/2024"@en ;
    cml:integrityHash "c261a82e26a88ecc59c4c2e86fe0aa3878302de3a5f9b651dd1ca6b88f76a11b" ;
    cof:pageNumber "106"^^xsd:integer ;
    skos:note "Entity must lift suspension upon request from accreditation authority if grounds no longer exist." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
