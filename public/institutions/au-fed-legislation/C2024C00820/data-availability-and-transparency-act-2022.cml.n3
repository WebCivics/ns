concept:data-availability-and-transparency-act-2022-sec-51 a cml:Concept ;
    skos:prefLabel "51 Independence of Commissioner"@en ;
    cml:realizedBy doc:sec-51 ;
    values:originalText "Subject to this Act and other laws of the Commonwealth, the Commissioner has discretion in the performance or exercise of the Commissioner’s functions or powers and is not subject to direction by any person in relation to the performance or exercise of those functions or powers." ;
    skos:definition "Subject to this Act and other laws of the Commonwealth, the Commissioner has discretion in the performance or exercise of the Commissioner’s functions or powers and is not subject to direction by any person in relation to the performance or exercise of those functions or powers."@en ;
    cml:integrityHash "73b96a41c96da8038c29c200eb44c24978c6e93808319ef729ce862d0ab14e3c" ;
    cof:pageNumber "82"^^xsd:integer ;
    skos:note "Commissioner's discretion in performance/exercise of functions/powers" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.82" ;
    cml:asserts concept:data-availability-and-transparency-act-2022-sec-51-norm .
