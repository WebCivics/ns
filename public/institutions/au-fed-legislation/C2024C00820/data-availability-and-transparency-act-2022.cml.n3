doc:sec-68-ss-1 a cof:Section ;
    cof:title "68(1) Disclosure of interests to Council" ;
    values:kind "subsection" ;
    values:originalText "(1) A member of the Council who has an interest, pecuniary or otherwise, in a matter being considered or about to be considered by the Council must disclose the nature of the interest to a meeting of the Council." ;
    cof:pageNumber "89"^^xsd:integer .

