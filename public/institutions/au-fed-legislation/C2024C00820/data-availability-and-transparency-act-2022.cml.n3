concept:data-availability-and-transparency-act-2022-sec-79 a cml:Concept ;
    skos:prefLabel "79 Notice before decision relating to conditions of accreditation"@en ;
    cml:realizedBy doc:sec-79 ;
    values:originalText "(1) Subject to subsection (4), the accreditation authority for an entity must not make any of the following decisions in relation to an  Chapter 5  Regulation and enforcement" ;
    skos:definition "(1) Subject to subsection (4), the accreditation authority for an entity must not make any of the following decisions in relation to an  Chapter 5  Regulation and enforcement"@en ;
