    cof:pageNumber "110"^^xsd:integer ;
    skos:note "Rules for accreditation framework procedures and requirements" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
