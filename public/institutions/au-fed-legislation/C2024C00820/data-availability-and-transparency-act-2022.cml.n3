doc:sec-20e-ss-5 a cof:Section ;
    cof:title "20E(5) Exit of ADSP-enhanced data or output of project" ;
    values:kind "subsection" ;
    values:originalText "(5) For the purposes of subsection (4), the applicable time is: (a) the time the user collected the copy of the shared data; or (b) if the individual’s consent as mentioned in paragraph (4)(c) specified a later time—that later time." ;
    cof:pageNumber "62"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-20e-ss-6 a cml:Concept ;
    skos:prefLabel "20E(6) Exit of ADSP-enhanced data or output of project"@en ;
    cml:realizedBy doc:sec-20e-ss-6 ;
    values:originalText "(6) The user is taken to collect a copy of data that exits the data sharing scheme under subsection (4) from the individual concerned, at the time the data exits. Exit for accredited user that is appointed data custodian of output" ;
    skos:definition "(6) The user is taken to collect a copy of data that exits the data sharing scheme under subsection (4) from the individual concerned, at the time the data exits. Exit for accredited user that is appointed data custodian of output"@en ;
