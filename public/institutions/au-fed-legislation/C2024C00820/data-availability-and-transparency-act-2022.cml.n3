concept:data-availability-and-transparency-act-2022-sec-103a a cml:Concept ;
    skos:prefLabel "103A Recommendations"@en ;
    cml:realizedBy doc:sec-103a ;
    values:originalText "If the Commissioner completes an assessment or investigation, under this Part, of the operations of a data scheme entity, the Commissioner may give the entity written recommendations about any action the Commissioner considers the entity should take in relation to matters covered by the assessment or investigation.  Chapter 5  Regulation and enforcement" ;
    skos:definition "If the Commissioner completes an assessment or investigation, under this Part, of the operations of a data scheme entity, the Commissioner may give the entity written recommendations about any action the Commissioner considers the entity should take in relation to matters covered by the assessment or investigation.  Chapter 5  Regulation and enforcement"@en ;
    cml:integrityHash "6add2115e082370feef94d908e00187778384e99959f018bbeef2f9d41d0154c" ;
    cof:pageNumber "121"^^xsd:integer ;
    skos:note "Commissioner may give written recommendations about actions an entity should take." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.121" ;
    cml:asserts concept:data-availability-and-transparency-act-2022-sec-103a-norm .
concept:data-availability-and-transparency-act-2022-sec-103a-norm a values:Obligation ;
    cml:modality cml:Deontic ;
