concept:data-availability-and-transparency-act-2022-sec-13c a cml:Concept ;
    skos:prefLabel "13C Authorisation for data custodian to collect and use submitted"@en ;
    cml:realizedBy doc:sec-13c ;
    values:originalText "data If an entity (the sharer) has shared data with the user under section 13 as part of a project, either directly or through an intermediary, the sharer is authorised to collect output or ADSP-enhanced data of the project from the user or intermediary, or to use output or ADSP-enhanced data of the project collected from the user or intermediary, if both of the following apply: (a) the project is covered by a registered data sharing agreement that is in effect and that meets the requirements of this Act; (b) the collection or use by the sharer is in accordance with the data sharing agreement.  Authorisations  Chapter 2 Authorisations  Part 2.2  Section 14 Data Availability and Transparency Act 2022 Compilation date: 11/12/2024" ;
    skos:definition "data If an entity (the sharer) has shared data with the user under section 13 as part of a project, either directly or through an intermediary, the sharer is authorised to collect output or ADSP-enhanced data of the project from the user or intermediary, or to use output or ADSP-enhanced data of the project collected from the user or intermediary, if both of the following apply: (a) the project is covered by a registered data sharing agreement that is in effect and that meets the requirements of this Act; (b) the collection or use by the sharer is in accordance with the data sharing agreement.  Authorisations  Chapter 2 Authorisations  Part 2.2  Section 14 Data Availability and Transparency Act 2022 Compilation date: 11/12/2024"@en ;
    cml:integrityHash "df44c42476b021bf7692a99f4d161bb93f6a793868d3f841329f12a39f3937bb" ;
    cof:pageNumber "32"^^xsd:integer ;
    skos:note "Sharer has permission to collect output or ADSP-enhanced data from user or intermediary under certain conditions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
