doc:sec-20c a cof:Section ;
    cof:title "20C Allowed access: providing access to or releasing output in other" ;
    values:kind "section" ;
    values:originalText "circumstances (1) The data sharing agreement may allow the accredited user to provide another entity with access to, or to release, specified output of the project, if the agreement: (a) allows the provision of access, or release, in specified circumstances that do not contravene any other law of the Commonwealth or a law of a State or Territory (disregarding section 23 of this Act); and (b) if the output includes personal information about an individual—prohibits provision of access or release unless the individual consents; and (c) requires the data custodian of the source data to be satisfied, before the access is provided or the release occurs, that the access or release will be an authorised use of the output under section 13A.  Chapter 2  Authorisations" ;
    cof:pageNumber "61"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-20d a cml:Concept ;
    skos:prefLabel "20D Allowed access: sharing under section 13"@en ;
    cml:realizedBy doc:sec-20d ;
    values:originalText "The data sharing agreement may allow the accredited user to share output of the project under section 13, if: (a) the accredited user is appointed as the data custodian of the output in accordance with subsection 20F(2); and (b) the agreement requires the data custodian of the source data to be satisfied, before the sharing occurs, that the sharing will be an authorised use of the output under section 13A." ;
    skos:definition "The data sharing agreement may allow the accredited user to share output of the project under section 13, if: (a) the accredited user is appointed as the data custodian of the output in accordance with subsection 20F(2); and (b) the agreement requires the data custodian of the source data to be satisfied, before the sharing occurs, that the sharing will be an authorised use of the output under section 13A."@en ;
    cml:integrityHash "d39ec6012baad71bf100dcd0eac699e40db98d34eff6d074a9361058ff9807db" ;
    cof:pageNumber "62"^^xsd:integer ;
    skos:note "Sharing of output under section 13 is allowed if certain conditions are met." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.62" ;
    cml:asserts concept:data-availability-and-transparency-act-2022-sec-20d-norm .
