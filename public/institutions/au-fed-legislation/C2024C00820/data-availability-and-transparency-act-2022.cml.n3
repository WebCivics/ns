doc:sec-25-ss-1 a cof:Section ;
    cof:title "25(1) No duty to share but reasons required for not sharing" ;
    values:kind "subsection" ;
    values:originalText "(1) This Act does not require, or authorise any person to require, a data custodian to share public sector data." ;
    cof:pageNumber "68"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-25-ss-2 a cml:Concept ;
    skos:prefLabel "25(2) No duty to share but reasons required for not sharing"@en ;
    cml:realizedBy doc:sec-25-ss-2 ;
    values:originalText "(2) However, a data custodian of public sector data must, within a reasonable period, consider a request for it to share the data, if the request is made: (a) by an accredited user; and (b) in the approved form (if any) or in writing (if there is no approved form)." ;
    skos:definition "(2) However, a data custodian of public sector data must, within a reasonable period, consider a request for it to share the data, if the request is made: (a) by an accredited user; and (b) in the approved form (if any) or in writing (if there is no approved form)."@en ;
    cml:integrityHash "51f34fb8eb58eb9b6ab5076c68ccb51a0eedb90ca3d048c169f8966fd4bf6a59" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-25 ;
    cof:pageNumber "68"^^xsd:integer ;
    skos:note "Data custodian must consider sharing public sector data upon request." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.68" ;
