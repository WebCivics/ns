doc:sec-19-ss-6 a cof:Section ;
    cof:title "19(6) Requirements to be met by all data sharing agreements" ;
    values:kind "subsection" ;
    values:originalText "(6) The agreement must: (a) specify: (i) the data sharing purpose, or data sharing purposes, of the project; and (ii) if, under the agreement, the accredited user is to be allowed to use output of the project for any purpose incidental to that purpose or those purposes—any such incidental purpose; and (b) except in relation to any use of the output allowed in accordance with section 20D—prohibit the accredited user from collecting and using output of the project for any of the following: (i) any purpose not specified; (ii) any precluded purpose." ;
    cof:pageNumber "56"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-19-ss-6a a cml:Concept ;
    skos:prefLabel "19(6A) Requirements to be met by all data sharing agreements"@en ;
    cml:realizedBy doc:sec-19-ss-6a ;
    values:originalText "(6A) The agreement must prohibit the accredited user from creating output of the project, other than: (a) the final output; and (b) output the creation of which is reasonably necessary or incidental to creation of the final output." ;
    skos:definition "(6A) The agreement must prohibit the accredited user from creating output of the project, other than: (a) the final output; and (b) output the creation of which is reasonably necessary or incidental to creation of the final output."@en ;
    cml:integrityHash "2ec2b73348b7d96fd34a7aa96ba7120f3513bdbe56c3ea7051424c103c152962" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-19 ;
    cof:pageNumber "56"^^xsd:integer ;
    skos:note "Prohibits accredited user from creating output other than final output and incidental output." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
