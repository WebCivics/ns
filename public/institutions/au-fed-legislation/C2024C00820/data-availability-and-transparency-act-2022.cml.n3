    cml:confidence "1.0000"^^xsd:decimal ;
    cml:curationStatus cml:Proposed .

concept:data-availability-and-transparency-act-2022-sec-35 cml:asserts concept:data-availability-and-transparency-act-2022-sec-35-logic-ltl-3 .
