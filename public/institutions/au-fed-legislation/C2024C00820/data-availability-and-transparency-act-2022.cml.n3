    cof:pageNumber "56"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-19-ss-5 a cml:Concept ;
    skos:prefLabel "19(5) Requirements to be met by all data sharing agreements"@en ;
    cml:realizedBy doc:sec-19-ss-5 ;
    values:originalText "(5) The agreement must specify the title of any law that the sharing would contravene but for section 23 (authorisation to share overrides other laws)." ;
    skos:definition "(5) The agreement must specify the title of any law that the sharing would contravene but for section 23 (authorisation to share overrides other laws)."@en ;
    cml:integrityHash "ee033598a0872516324a08f806df4dd34d5eed5e16542132c7a02f9e06c72ea7" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-19 ;
    cof:pageNumber "56"^^xsd:integer ;
    skos:note "Sharing data without authorisation may contravene a law." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
