doc:sec-13-ss-1 a cof:Section ;
    cof:title "13(1) Authorisation for data custodian to share public sector data" ;
    values:kind "subsection" ;
    values:originalText "(1) An entity (the sharer) is authorised to share data with another entity (the user), either directly or through another entity (the intermediary), if all of the following apply: (a) the constitutional requirements in subsection (4) are met; (b) the data custodian requirements in subsection (2) are met; (c) the project the sharing is part of is covered by a registered data sharing agreement that is in effect and that meets the requirements of this Act; (d) the sharing is in accordance with the data sharing agreement; (e) the sharer is satisfied that the project is consistent with the data sharing principles; (f) the user is an accredited user and its accreditation is not suspended; (g) if the data shared with the user includes personal information—the privacy coverage condition in section 16E is met in relation to the user; (h) if the sharer shares through an intermediary—the intermediary is an ADSP and its accreditation is not suspended; (i) if the data shared with the intermediary includes personal information—the privacy coverage condition in section 16E is met in relation to the intermediary. Note: This section authorises the sharer to share its public sector data with the user and with the intermediary (if any). It also authorises the intermediary (if any) to share with the user, on behalf of the sharer, ADSP-enhanced data of which the sharer is the data custodian." ;
    cof:pageNumber "29"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-13-ss-2 a cml:Concept ;
    skos:prefLabel "13(2) Authorisation for data custodian to share public sector data"@en ;
    cml:realizedBy doc:sec-13-ss-2 ;
    values:originalText "(2) The data custodian requirements are the following: (a) the data is public sector data and the sharer is the data custodian of the data;  Chapter 2  Authorisations" ;
    skos:definition "(2) The data custodian requirements are the following: (a) the data is public sector data and the sharer is the data custodian of the data;  Chapter 2  Authorisations"@en ;
    cml:integrityHash "fed085d3381fb2345cae0c5c63b79496cbbd3649da5e6b53af9fdd8755b83fbe" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-13 ;
    cof:pageNumber "29"^^xsd:integer ;
    skos:note "Data custodian may share public sector data" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <data-availability-and-transparency-act-2022.pdf> ;
    dc:source "data-availability-and-transparency-act-2022.pdf, p.29" ;
