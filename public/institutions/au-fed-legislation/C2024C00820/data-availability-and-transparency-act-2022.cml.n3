doc:sec-25-ss-2 a cof:Section ;
    cof:title "25(2) No duty to share but reasons required for not sharing" ;
    values:kind "subsection" ;
    values:originalText "(2) However, a data custodian of public sector data must, within a reasonable period, consider a request for it to share the data, if the request is made: (a) by an accredited user; and (b) in the approved form (if any) or in writing (if there is no approved form)." ;
    cof:pageNumber "68"^^xsd:integer .

concept:data-availability-and-transparency-act-2022-sec-25-ss-3 a cml:Concept ;
    skos:prefLabel "25(3) No duty to share but reasons required for not sharing"@en ;
    cml:realizedBy doc:sec-25-ss-3 ;
    values:originalText "(3) The data custodian may refuse the request for any reason (including that the request is unreasonable), but must give the accredited user written notice of the reasons no later than 28 days after the day the decision to refuse is made." ;
    skos:definition "(3) The data custodian may refuse the request for any reason (including that the request is unreasonable), but must give the accredited user written notice of the reasons no later than 28 days after the day the decision to refuse is made."@en ;
    cml:integrityHash "b87e416d61df5a76e5263828686a971b726b50975bc6c328538927d2efd2faca" ;
    values:partOf concept:data-availability-and-transparency-act-2022-sec-25 ;
    cof:pageNumber "68"^^xsd:integer ;
    skos:note "Data custodian must provide written notice of reasons for refusing a request." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
