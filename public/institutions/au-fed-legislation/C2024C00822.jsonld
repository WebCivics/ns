    {
      "@id": "concept:australian-information-commissioner-act-2010-sec-29-ss-1",
      "@type": "cml:Concept",
      "dc:source": "australian-information-commissioner-act-2010.pdf, p.27",
      "skos:note": "Making a record of, disclosing or using information acquired in the course of performing certain functions is an offence.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "29(1) Unauthorised dealing with information"
      },
      "wasDerivedFrom": "australian-information-commissioner-act-2010.pdf",
      "asserts": [
        "concept:australian-information-commissioner-act-2010-sec-29-ss-1-norm",
        "concept:australian-information-commissioner-act-2010-sec-29-ss-1-logic-deontic-1",
        "concept:australian-information-commissioner-act-2010-sec-29-ss-1-logic-alleninterval-2",
        "concept:australian-information-commissioner-act-2010-sec-29-ss-1-logic-ltl-3",
        "concept:australian-information-commissioner-act-2010-sec-29-ss-1-logic-diffusion-4",
        "concept:australian-information-commissioner-act-2010-sec-29-ss-1-logic-cogai-5"
      ],
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:integrityHash": "070ebc70d31f679827b96d7c4a57b1efe386a0a8ec9c2778b0a6c4662aca067c",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "realizedBy": "doc:australian-information-commissioner-act-2010#sec-29-ss-1",
      "cml:schemaVersion": "2",
      "partOf": "concept:australian-information-commissioner-act-2010-sec-29"
    },
    {
      "@id": "concept:australian-information-commissioner-act-2010-sec-29-ss-1-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "(1) A person commits an offence if: (a) the person makes a record of, discloses or otherwise uses information; and (b) the information was acquired by the person in the course of performing functions or exercising powers conferred for the purposes of an information commissioner function, a freedom of information function or a privacy function.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Defines the temporal scope of the offence.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(b) the information was acquired by the person in the course of performing functions or exercising powers conferred for the purposes of an information commissioner function, a freedom of information function or a privacy function."
    },
