concept:australian-information-commissioner-act-2010-sec-6 a cml:Concept ;
    skos:prefLabel "6 Definition of information officers"@en ;
    cml:realizedBy doc:sec-6 ;
    values:originalText "Each of the following is an information officer: (a) the Information Commissioner; (b) the Freedom of Information Commissioner; (c) the Privacy Commissioner.   Office of the Australian Information Commissioner  Part 2 Functions and powers of the information officers  Division 3 Section 7 Australian Information Commissioner Act 2010 Compilation date: 11/12/2024" ;
    skos:definition "Each of the following is an information officer: (a) the Information Commissioner; (b) the Freedom of Information Commissioner; (c) the Privacy Commissioner.   Office of the Australian Information Commissioner  Part 2 Functions and powers of the information officers  Division 3 Section 7 Australian Information Commissioner Act 2010 Compilation date: 11/12/2024"@en ;
    cml:integrityHash "9c61a877a636d92e31a5fd2d33c43e5962906706e024b6ae7df0680054db8b3a" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "List of information officers" ;
