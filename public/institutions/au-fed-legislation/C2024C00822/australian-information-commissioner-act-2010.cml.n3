doc:sec-2-2 a cof:Section ;
    cof:title "2 Sections 3 to" ;
    values:kind "section" ;
    values:originalText "A single day to be fixed by Proclamation. However, if any of the provision(s) do not commence within the period of 6 months beginning on the day this Act receives the Royal Assent, they commence on the day after the end of that period." ;
    cof:pageNumber "5"^^xsd:integer .

