doc:sec-12-ss-2 a cof:Section ;
    cof:title "12(2) Functions and powers of the Privacy Commissioner" ;
    values:kind "subsection" ;
    values:originalText "(2) The Privacy Commissioner may also perform the freedom of information functions (whether or not the Privacy Commissioner holds the qualifications mentioned in subsection 14(3))." ;
    cof:pageNumber "14"^^xsd:integer .

