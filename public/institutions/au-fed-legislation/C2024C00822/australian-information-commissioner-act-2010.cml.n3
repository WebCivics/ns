concept:australian-information-commissioner-act-2010-sec-30 a cml:Concept ;
    skos:prefLabel "30 Annual report"@en ;
    cml:realizedBy doc:sec-30 ;
    values:originalText "The annual report prepared by the Information Commissioner and given to the Minister under section 46 of the Public Governance, Performance and Accountability Act 2013 for a period must include: (a) the freedom of information matters (see section 31); and (b) the privacy matters (see section 32); and (c) the consumer data right matters (see section 32A)." ;
    skos:definition "The annual report prepared by the Information Commissioner and given to the Minister under section 46 of the Public Governance, Performance and Accountability Act 2013 for a period must include: (a) the freedom of information matters (see section 31); and (b) the privacy matters (see section 32); and (c) the consumer data right matters (see section 32A)."@en ;
    cml:integrityHash "4555ea98b37686626380e7a90f5fb28dd3229c6e836683230c523b36decc68f8" ;
    cof:pageNumber "30"^^xsd:integer ;
    skos:note "Annual report must include specific information." ;
    dc:description "Yes" ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-information-commissioner-act-2010.pdf> ;
    dc:source "australian-information-commissioner-act-2010.pdf, p.30" ;
    cml:asserts concept:australian-information-commissioner-act-2010-sec-30-norm .
