doc:sec-27-ss-3 a cof:Section ;
    cof:title "27(3) Establishment and functions" ;
    values:kind "subsection" ;
    values:originalText "(3) A Committee member appointed by the Minister for the purposes of paragraph (2)(c) is entitled to be paid travel allowance in accordance with the regulations." ;
    cof:pageNumber "24"^^xsd:integer .

concept:australian-information-commissioner-act-2010-sec-27-ss-4 a cml:Concept ;
    skos:prefLabel "27(4) Establishment and functions"@en ;
    cml:realizedBy doc:sec-27-ss-4 ;
    values:originalText "(4) However, a person covered by subsection (3) is not entitled to be paid any remuneration or allowances in relation to the holding of the position of Committee member other than any travel allowance that is prescribed for the purposes of subsection (3).   Information Advisory Committee  Part 4  Section 27A Australian Information Commissioner Act 2010 Compilation date: 11/12/2024" ;
    skos:definition "(4) However, a person covered by subsection (3) is not entitled to be paid any remuneration or allowances in relation to the holding of the position of Committee member other than any travel allowance that is prescribed for the purposes of subsection (3).   Information Advisory Committee  Part 4  Section 27A Australian Information Commissioner Act 2010 Compilation date: 11/12/2024"@en ;
    cml:integrityHash "4d49a089ba95a4dae86f0edf3e634713596132d6fc64b2f45b4b3aa1175b8e14" ;
    values:partOf concept:australian-information-commissioner-act-2010-sec-27 ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "No remuneration or allowances for Committee members except travel allowance." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
