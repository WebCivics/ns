concept:australian-information-commissioner-act-2010-sec-28 a cml:Concept ;
    skos:prefLabel "28 Guide to this Part"@en ;
    cml:realizedBy doc:sec-28 ;
    values:originalText "This Part deals with a number of other matters relevant to the operation of the Office of the Australian Information Commissioner. These are as follows: (a) an offence for unauthorised dealings with information; (b) the requirements for annual reports; (c) immunity from legal suit; (d) the making of regulations." ;
    skos:definition "This Part deals with a number of other matters relevant to the operation of the Office of the Australian Information Commissioner. These are as follows: (a) an offence for unauthorised dealings with information; (b) the requirements for annual reports; (c) immunity from legal suit; (d) the making of regulations."@en ;
    cml:integrityHash "f1a12c70e4884cf8e64f9b7f39a2cf6af1205abd9078c7fc740adf7122ce70e9" ;
    cof:pageNumber "27"^^xsd:integer ;
