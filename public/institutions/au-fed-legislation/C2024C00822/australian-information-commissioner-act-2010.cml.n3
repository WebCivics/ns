concept:australian-information-commissioner-act-2010-sec-13 a cml:Concept ;
    skos:prefLabel "13 Guide to this Part"@en ;
    cml:realizedBy doc:sec-13 ;
    values:originalText "This Division provides for: (a) the appointment of the information officers; and (b) the staff of the Office of the Australian Information Commissioner, who are engaged under the Public Service Act 1999. The Information Commissioner may engage consultants. The Information Commissioner may delegate all of his or her functions or powers, other than the information commissioner functions, the preparation of reports, the making of certain instruments (such as guidelines and determinations) and certain formal procedural steps." ;
    skos:definition "This Division provides for: (a) the appointment of the information officers; and (b) the staff of the Office of the Australian Information Commissioner, who are engaged under the Public Service Act 1999. The Information Commissioner may engage consultants. The Information Commissioner may delegate all of his or her functions or powers, other than the information commissioner functions, the preparation of reports, the making of certain instruments (such as guidelines and determinations) and certain formal procedural steps."@en ;
    cml:integrityHash "2dc2554b032e191d5b4eb156759445b700d679561548405c7e1d8035d96a3259" ;
    cof:pageNumber "17"^^xsd:integer ;
    skos:note "Provides for appointment of information officers and staff, and delegation of functions." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-information-commissioner-act-2010.pdf> ;
    dc:source "australian-information-commissioner-act-2010.pdf, p.17" ;
    cml:asserts concept:australian-information-commissioner-act-2010-sec-13-norm .
