concept:australian-information-commissioner-act-2010-sec-26 a cml:Concept ;
    skos:prefLabel "26 Guide to this Part"@en ;
    cml:realizedBy doc:sec-26 ;
    values:originalText "This Part establishes an Information Advisory Committee to assist and advise the Information Commissioner on matters relating to the performance of the information commissioner functions." ;
