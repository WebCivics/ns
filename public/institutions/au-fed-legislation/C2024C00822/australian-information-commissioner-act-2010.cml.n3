concept:australian-information-commissioner-act-2010-sec-2-2 a cml:Concept ;
    skos:prefLabel "2 Sections 3 to"@en ;
    cml:realizedBy doc:sec-2-2 ;
    values:originalText "A single day to be fixed by Proclamation. However, if any of the provision(s) do not commence within the period of 6 months beginning on the day this Act receives the Royal Assent, they commence on the day after the end of that period." ;
    skos:definition "A single day to be fixed by Proclamation. However, if any of the provision(s) do not commence within the period of 6 months beginning on the day this Act receives the Royal Assent, they commence on the day after the end of that period."@en ;
