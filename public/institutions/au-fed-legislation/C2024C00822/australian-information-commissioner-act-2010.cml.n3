concept:australian-information-commissioner-act-2010-sec-18 a cml:Concept ;
    skos:prefLabel "18 Leave of absence"@en ;
    cml:realizedBy doc:sec-18 ;
    values:originalText "(1) An information officer has the recreation leave entitlements that are determined by the Remuneration Tribunal. (2) The Minister may grant an information officer leave of absence, other than recreation leave, on the terms and conditions as to remuneration or otherwise that the Minister determines." ;
    skos:definition "(1) An information officer has the recreation leave entitlements that are determined by the Remuneration Tribunal. (2) The Minister may grant an information officer leave of absence, other than recreation leave, on the terms and conditions as to remuneration or otherwise that the Minister determines."@en ;
    cml:integrityHash "1d7c34f73de4b89d5d6aef80a3e3141e23f7c4f09984204979bec19cd68af8be" ;
    cof:pageNumber "19"^^xsd:integer ;
