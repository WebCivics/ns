      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The minutes of a private committee meeting are not subject to subsection (2) if the previous meeting was also private.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
