    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-3-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "Assembly is a subclass of LegislativeAssembly",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Class hierarchy definition",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Assembly means the Legislative Assembly for the Australian Capital Territory established by section 8."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-3-logic-descriptionlogic-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "AttorneyGeneral is a subclass of Minister",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Classification of roles",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Attorney-General of the Territory means the Minister who has the responsibility for the administration of justice in the Territory."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-3-logic-descriptionlogic-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "ChiefMagistrate is a subclass of Magistrate",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition of Chief Magistrate",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Chief Magistrate means the Chief Magistrate appointed under the Magistrates Court Act 1930 of the Territory."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-3-logic-descriptionlogic-5",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "ChiefMinister is a subclass of ElectedMember",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::dl",
      "cml:logicSummary": "Definition of Chief Minister",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "=",
      "cml:premiseText": "Chief Minister means the Chief Minister elected under section 40."
    },
