    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-44-ss-4",
      "@type": "cml:Concept",
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.28",
      "skos:note": "Exercise of powers by Deputy Chief Minister does not affect exercise of power by Chief Minister.",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "44(4) Deputy Chief Minister for the Territory"
      },
      "wasDerivedFrom": "australian-capital-territory-self-government-act-1988.pdf",
