    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-44-ss-4-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exercise of the powers of the Chief Minister by the Deputy Chief Minister during the absence of the Chief Minister from Australia overlaps with the exercise of a power by the Chief Minister.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:logicSummary": "Exercise of powers overlaps.",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Overlaps",
      "cml:premiseText": "(4) The exercise of the powers of the Chief Minister by the Deputy Chief Minister during the absence of the Chief Minister from Australia does not affect the exercise of a power by the Chief Minister."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-44-ss-4-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exercise of the powers of the Chief Minister by the Deputy Chief Minister during the absence of the Chief Minister from Australia is exclusive.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exercise of powers is exclusive.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Exclusion",
      "cml:premiseText": "(4) The exercise of the powers of the Chief Minister by the Deputy Chief Minister during the absence of the Chief Minister from Australia does not affect the exercise of a power by the Chief Minister."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-44-ss-4-logic-deontic-2",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exercise of the powers of the Chief Minister by the Deputy Chief Minister during the absence of the Chief Minister from Australia is inclusive.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:logicSummary": "Exercise of powers is inclusive.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Inclusion",
      "cml:premiseText": "(4) The exercise of the powers of the Chief Minister by the Deputy Chief Minister during the absence of the Chief Minister from Australia does not affect the exercise of a power by the Chief Minister."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-44-ss-4-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:conclusionText": "The exercise of the powers of the Chief Minister by the Deputy Chief Minister during the absence of the Chief Minister from Australia repeats with the exercise of a power by the Chief Minister.",
      "cml:confidence": {
        "@type": "xsd:decimal",
        "@value": "1.0000"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:logicSummary": "Exercise of powers repeats.",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Repeats",
      "cml:premiseText": "(4) The exercise of the powers of the Chief Minister by the Deputy Chief Minister during the absence of the Chief Minister from Australia does not affect the exercise of a power by the Chief Minister."
    },
