      "cml:logicSummary": "The enactment must provide for the commission to be constituted by persons who have been or are judges of a superior court.",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "MUST",
      "cml:premiseText": "(1) An enactment relating to the establishment of a judicial commission for the Territory..."
    },
