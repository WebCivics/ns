concept:australian-capital-territory-self-government-act-1988-sch-5-sec-19 a cml:Concept ;
    skos:prefLabel "19 Resolution of no confidence in Chief Minister"@en ;
    cml:realizedBy doc:sch-5-sec-19 ;
    values:originalText "A resolution of no confidence in the Chief Minister has no effect unless: (a) it affirms a motion that is expressed to be a motion of no confidence in the Chief Minister; (b) at least one week’s notice of the motion has been given in accordance with the standing rules and orders; and (c) the resolution is passed by at least the number of members necessary to be a quorum." ;
    skos:definition "A resolution of no confidence in the Chief Minister has no effect unless: (a) it affirms a motion that is expressed to be a motion of no confidence in the Chief Minister; (b) at least one week’s notice of the motion has been given in accordance with the standing rules and orders; and (c) the resolution is passed by at least the number of members necessary to be a quorum."@en ;
    cml:integrityHash "8a3f5403bd66395a46a348501b8162e1405c3504ed47501f5900efb16871d776" ;
    cof:pageNumber "18"^^xsd:integer ;
    skos:note "Resolution of no confidence in Chief Minister requires specific conditions to be effective." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-self-government-act-1988.pdf> ;
