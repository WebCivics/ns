concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48aa a cml:Concept ;
    skos:prefLabel "48AA ACT laws may give concurrent jurisdiction to the Federal"@en ;
    cml:realizedBy doc:sch-5-sec-48aa ;
    values:originalText "Court of Australia Nothing in section 48A is to be taken to imply that a law of the Australian Capital Territory may not confer on the Federal Court of Australia original or appellate jurisdiction in any matter in respect of which, by virtue of section 48A, jurisdiction is conferred on the Supreme Court." ;
    skos:definition "Court of Australia Nothing in section 48A is to be taken to imply that a law of the Australian Capital Territory may not confer on the Federal Court of Australia original or appellate jurisdiction in any matter in respect of which, by virtue of section 48A, jurisdiction is conferred on the Supreme Court."@en ;
    cml:integrityHash "65d066d9d9932939b3deaf8054491329fe1f20dddc3e3778028776c9fb1e794a" ;
    cof:pageNumber "31"^^xsd:integer ;
    skos:note "Jurisdiction may be given to the Federal Court of Australia." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
