concept:australian-capital-territory-self-government-act-1988-sch-5-sec-42 a cml:Concept ;
    skos:prefLabel "42 Presiding Officer or Deputy Presiding Officer not to be a"@en ;
    cml:realizedBy doc:sch-5-sec-42 ;
    values:originalText "Minister The person for the time being holding office as Presiding Officer or Deputy Presiding Officer is not eligible to be a Minister." ;
    skos:definition "Minister The person for the time being holding office as Presiding Officer or Deputy Presiding Officer is not eligible to be a Minister."@en ;
