concept:australian-capital-territory-self-government-act-1988-sch-5-sec-45 a cml:Concept ;
    skos:prefLabel "45 Resignation of Ministers"@en ;
    cml:realizedBy doc:sch-5-sec-45 ;
    values:originalText "(1) The Chief Minister may resign office as Chief Minister by written notice delivered to the Presiding Officer. (2) Any other Minister may resign office as Minister by written notice delivered to the Chief Minister." ;
