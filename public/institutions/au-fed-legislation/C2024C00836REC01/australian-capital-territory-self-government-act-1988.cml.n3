doc:sch-5-sec-73-ss-3a a cof:Section ;
    cof:title "73(3A) Remuneration and allowances" ;
    values:kind "subsection" ;
    values:originalText "(3A) The remuneration and allowances of a person holding an office specified in paragraph (1)(fa), (fb), (fc), (fd) or (fe) are not to be diminished while the person holds that office." ;
    cof:pageNumber "40"^^xsd:integer .

concept:australian-capital-territory-self-government-act-1988-sch-5-sec-73-ss-4 a cml:Concept ;
    skos:prefLabel "73(4) Remuneration and allowances"@en ;
    cml:realizedBy doc:sch-5-sec-73-ss-4 ;
    values:originalText "(4) Where: (a) the term of office of a person as member ends on the polling day for a general election; and (b) the person is re-elected at that general election; then, for the purposes of this section, the person shall be taken to have continued to serve in the office of member until the day on which the election of the person is declared." ;
    skos:definition "(4) Where: (a) the term of office of a person as member ends on the polling day for a general election; and (b) the person is re-elected at that general election; then, for the purposes of this section, the person shall be taken to have continued to serve in the office of member until the day on which the election of the person is declared."@en ;
    cml:integrityHash "f5189fa99912fe06ecf126cd8f8eccfd844337bc001324c4833bd09e84f2c138" ;
    values:partOf concept:australian-capital-territory-self-government-act-1988-sch-5-sec-73 ;
    cof:pageNumber "40"^^xsd:integer ;
    skos:note "Continuation of service in office after election" ;
    cml:curationStatus cml:Proposed ;
