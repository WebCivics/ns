doc:sch-5-sec-73-ss-4 a cof:Section ;
    cof:title "73(4) Remuneration and allowances" ;
    values:kind "subsection" ;
    values:originalText "(4) Where: (a) the term of office of a person as member ends on the polling day for a general election; and (b) the person is re-elected at that general election; then, for the purposes of this section, the person shall be taken to have continued to serve in the office of member until the day on which the election of the person is declared." ;
    cof:pageNumber "40"^^xsd:integer .

concept:australian-capital-territory-self-government-act-1988-sch-5-sec-73-ss-5 a cml:Concept ;
    skos:prefLabel "73(5) Remuneration and allowances"@en ;
    cml:realizedBy doc:sch-5-sec-73-ss-5 ;
    values:originalText "(5) Where: (a) the term of office of a person as member ends because the Assembly is dissolved under section 16; and (b) the person is a candidate at the next general election; then, for the purposes of this section, the person shall be taken to have continued to serve in the office of member until the polling day for that general election or, if the person is re-elected, until the day on which the election of the person is declared." ;
    skos:definition "(5) Where: (a) the term of office of a person as member ends because the Assembly is dissolved under section 16; and (b) the person is a candidate at the next general election; then, for the purposes of this section, the person shall be taken to have continued to serve in the office of member until the polling day for that general election or, if the person is re-elected, until the day on which the election of the person is declared."@en ;
    cml:integrityHash "c3d36a082669c165098bb87d15ffc76f8a458f0cbe1a99f0c25d384b0c8de17d" ;
    values:partOf concept:australian-capital-territory-self-government-act-1988-sch-5-sec-73 ;
