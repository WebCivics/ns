concept:australian-capital-territory-self-government-act-1988-sch-5-sec-67a a cml:Concept ;
    skos:prefLabel "67A General elections"@en ;
    cml:realizedBy doc:sch-5-sec-67a ;
    values:originalText "(1) The members to be elected at a general election are to be elected as provided by sections 67, 67C and 67D and by an enactment that: (a) provides for general elections; and (b) complies with section 67B; and (c) was made after polling day for the second general election." ;
    skos:definition "(1) The members to be elected at a general election are to be elected as provided by sections 67, 67C and 67D and by an enactment that: (a) provides for general elections; and (b) complies with section 67B; and (c) was made after polling day for the second general election."@en ;
    cml:integrityHash "32f016072428c9369dc0c523233bff47a49735237b3a6ea75822942d5d30f4df" ;
    cof:pageNumber "36"^^xsd:integer ;
    skos:note "Members must be elected as provided by sections 67, 67C and 67D." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
    prov:wasDerivedFrom <australian-capital-territory-self-government-act-1988.pdf> ;
