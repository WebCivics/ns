concept:australian-capital-territory-self-government-act-1988-sch-5-sec-4 a cml:Concept ;
    skos:prefLabel "4 Meaning of day on which election held"@en ;
    cml:realizedBy doc:sch-5-sec-4 ;
    values:originalText "A reference in this Act to the day on which an election has been, is, or is to be, held, is a reference to the polling day for that election." ;
    skos:definition "A reference in this Act to the day on which an election has been, is, or is to be, held, is a reference to the polling day for that election."@en ;
    cml:integrityHash "cb3b963f87a9c598b8d7fb327fd40cca115b7fe3f60d4dec58691d908ec95035" ;
    cof:pageNumber "10"^^xsd:integer ;
    skos:note "Reference to polling day for an election is a reference to the day on which the election has been, is, or is to be held." ;
