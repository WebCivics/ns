    values:originalText "(2) A person’s name is taken not to be on the Roll for the purposes of paragraph (1)(a) if an electoral enactment so provides." ;
    cof:pageNumber "37"^^xsd:integer .

concept:australian-capital-territory-self-government-act-1988-sch-5-sec-67c-ss-3 a cml:Concept ;
