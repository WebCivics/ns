    values:kind "subsection" ;
    values:originalText "(2) In addition, the Supreme Court may have such further jurisdiction as is conferred on it by any Act, enactment or Ordinance, or any law made under any Act, enactment or Ordinance." ;
    cof:pageNumber "31"^^xsd:integer .

concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48a-ss-3 a cml:Concept ;
    skos:prefLabel "48A(3) Jurisdiction and powers of the Supreme Court"@en ;
    cml:realizedBy doc:sch-5-sec-48a-ss-3 ;
    values:originalText "(3) The Supreme Court is not bound to exercise any powers where it has concurrent jurisdiction with another court or tribunal." ;
    skos:definition "(3) The Supreme Court is not bound to exercise any powers where it has concurrent jurisdiction with another court or tribunal."@en ;
