concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10 a cml:Concept ;
    skos:prefLabel "10 Term of office of member"@en ;
    cml:realizedBy doc:sch-5-sec-10 ;
    values:originalText "The term of office of a member duly elected begins at the end of the day on which the election of the member is declared and, unless sooner ended by resignation or disqualification, or by   Legislative Assembly  Part III Constitution of Assembly  Division 1 Section 11 Australian Capital Territory (Self-Government) Act 1988 Compilation date: 11/12/2024 dissolution of the Assembly, ends on the polling day for the next general election." ;
    skos:definition "The term of office of a member duly elected begins at the end of the day on which the election of the member is declared and, unless sooner ended by resignation or disqualification, or by   Legislative Assembly  Part III Constitution of Assembly  Division 1 Section 11 Australian Capital Territory (Self-Government) Act 1988 Compilation date: 11/12/2024 dissolution of the Assembly, ends on the polling day for the next general election."@en ;
    cml:integrityHash "3009bcfd55998c285f841b22a5b93d2631e250d2cc0312368a8024bb48344dd6" ;
    cof:pageNumber "12"^^xsd:integer ;
    skos:note "Term of office begins at election day and ends on polling day for next general election." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
