doc:sch-5-sec-19 a cof:Section ;
    cof:title "19 Resolution of no confidence in Chief Minister" ;
    values:kind "section" ;
    values:originalText "A resolution of no confidence in the Chief Minister has no effect unless: (a) it affirms a motion that is expressed to be a motion of no confidence in the Chief Minister; (b) at least one week’s notice of the motion has been given in accordance with the standing rules and orders; and (c) the resolution is passed by at least the number of members necessary to be a quorum." ;
    cof:pageNumber "18"^^xsd:integer .

concept:australian-capital-territory-self-government-act-1988-sch-5-sec-20 a cml:Concept ;
    skos:prefLabel "20 Minutes of meetings"@en ;
    cml:realizedBy doc:sch-5-sec-20 ;
    values:originalText "(1) The Assembly shall cause minutes to be kept of meetings. (2) A copy of any minutes so kept shall, on request made by a person: (a) be made available for inspection by the person; or (b) be supplied to the person on payment of such fee (if any) as is fixed by or under enactment. (3) Subsection (2) does not apply to minutes of a committee meeting held in private." ;
    skos:definition "(1) The Assembly shall cause minutes to be kept of meetings. (2) A copy of any minutes so kept shall, on request made by a person: (a) be made available for inspection by the person; or (b) be supplied to the person on payment of such fee (if any) as is fixed by or under enactment. (3) Subsection (2) does not apply to minutes of a committee meeting held in private."@en ;
    cml:integrityHash "0bdf8f7b5a76da1e709e4181251a7e629db9533f7e7cecf0064f55deafa811d0" ;
    cof:pageNumber "18"^^xsd:integer ;
    cml:hasPart concept:australian-capital-territory-self-government-act-1988-sch-5-sec-20-ss-1 ;
    cml:hasPart concept:australian-capital-territory-self-government-act-1988-sch-5-sec-20-ss-2 ;
    cml:hasPart concept:australian-capital-territory-self-government-act-1988-sch-5-sec-20-ss-3 ;
