concept:australian-capital-territory-self-government-act-1988-sch-5-sec-60 a cml:Concept ;
    skos:prefLabel "60 Borrowing from Commonwealth"@en ;
    cml:realizedBy doc:sch-5-sec-60 ;
    values:originalText "The Finance Minister may, on behalf of the Commonwealth, out of money appropriated by the Parliament for the purpose, lend money to the Territory or to a Territory authority on such terms and conditions as that Minister determines in writing." ;
    skos:definition "The Finance Minister may, on behalf of the Commonwealth, out of money appropriated by the Parliament for the purpose, lend money to the Territory or to a Territory authority on such terms and conditions as that Minister determines in writing."@en ;
    cml:integrityHash "bf94b9ed7b8cf813f01e692bbcc3f4033578d65e470e8b8690ad160962e187cd" ;
    cof:pageNumber "35"^^xsd:integer ;
    skos:note "The Finance Minister may lend money to the Territory or a Territory authority." ;
    cml:curationStatus cml:Proposed ;
    cml:schemaVersion "2" ;
    cml:proposedBy <https://ns.webcivics.net/tools/legis2cml> ;
