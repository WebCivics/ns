concept:australian-capital-territory-self-government-act-1988-sch-5-sec-29-ss-2 a cml:Concept ;
    skos:prefLabel "29(2) Avoidance of application of enactments to Parliament"@en ;
    cml:realizedBy doc:sch-5-sec-29-ss-2 ;
    values:originalText "(2) If either House of the Parliament passes a resolution declaring that an enactment made after the commencing day does not apply: (a) to that House; (b) to the members of that House; or (c) in the Parliamentary precincts; the resolution has effect according to its tenor and the enactment does not apply accordingly." ;
    skos:definition "(2) If either House of the Parliament passes a resolution declaring that an enactment made after the commencing day does not apply: (a) to that House; (b) to the members of that House; or (c) in the Parliamentary precincts; the resolution has effect according to its tenor and the enactment does not apply accordingly."@en ;
    cml:integrityHash "eebd8b3f8fdd38614dde86ae62cea476e32bb2503c447dc4f28e3dcd7479c044" ;
    values:partOf concept:australian-capital-territory-self-government-act-1988-sch-5-sec-29 ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Resolution declaring enactment does not apply to Parliament" ;
    cml:curationStatus cml:Proposed ;
