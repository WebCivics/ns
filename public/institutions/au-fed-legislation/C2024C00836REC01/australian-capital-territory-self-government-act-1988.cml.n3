concept:australian-capital-territory-self-government-act-1988-sch-5-sec-2 a cml:Concept ;
    skos:prefLabel "2 Commencement"@en ;
    cml:realizedBy doc:sch-5-sec-2 ;
    values:originalText "(1) Section 1 and this section commence on the day on which this Act receives the Royal Assent. (2) The remaining provisions of this Act commence on a day or days to be fixed by Proclamation." ;
