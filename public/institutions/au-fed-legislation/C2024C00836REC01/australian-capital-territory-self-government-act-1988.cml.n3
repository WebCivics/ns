doc:sch-5-sec-43-ss-1 a cof:Section ;
    cof:title "43(1) Ministerial portfolios" ;
    values:kind "subsection" ;
    values:originalText "(1) A Minister shall administer such matters relating to the powers of the Executive as are allocated to that Minister from time to time by the Chief Minister." ;
    cof:pageNumber "28"^^xsd:integer .

