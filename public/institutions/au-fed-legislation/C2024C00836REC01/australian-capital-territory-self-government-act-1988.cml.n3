doc:sch-5-sec-29-ss-2 a cof:Section ;
    cof:title "29(2) Avoidance of application of enactments to Parliament" ;
    values:kind "subsection" ;
    values:originalText "(2) If either House of the Parliament passes a resolution declaring that an enactment made after the commencing day does not apply: (a) to that House; (b) to the members of that House; or (c) in the Parliamentary precincts; the resolution has effect according to its tenor and the enactment does not apply accordingly." ;
    cof:pageNumber "24"^^xsd:integer .

concept:australian-capital-territory-self-government-act-1988-sch-5-sec-29-ss-3 a cml:Concept ;
    skos:prefLabel "29(3) Avoidance of application of enactments to Parliament"@en ;
    cml:realizedBy doc:sch-5-sec-29-ss-3 ;
    values:originalText "(3) A resolution under subsection (2): (a) does not have effect in respect of the application of an enactment on a day before the day on which the resolution is passed; and (b) has effect, to the extent that the enactment ceases to apply, as if the enactment were repealed by another enactment." ;
    skos:definition "(3) A resolution under subsection (2): (a) does not have effect in respect of the application of an enactment on a day before the day on which the resolution is passed; and (b) has effect, to the extent that the enactment ceases to apply, as if the enactment were repealed by another enactment."@en ;
    cml:integrityHash "5a9bc94fca772aa1719a70044a34e251a801d2c490f857d241e5199beed0bef2" ;
    values:partOf concept:australian-capital-territory-self-government-act-1988-sch-5-sec-29 ;
    cof:pageNumber "24"^^xsd:integer ;
    skos:note "Enactments do not apply to Parliament before the resolution is passed." ;
