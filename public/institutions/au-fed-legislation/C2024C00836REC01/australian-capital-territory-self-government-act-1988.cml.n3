concept:australian-capital-territory-self-government-act-1988-sch-5-sec-5 a cml:Concept ;
    skos:prefLabel "5 Meaning of day on which result of election declared"@en ;
    cml:realizedBy doc:sch-5-sec-5 ;
    values:originalText "Where the results of a general election are declared on different days, a reference in this Act to the day on which the result of the election is declared is a reference to the last of those days." ;
    skos:definition "Where the results of a general election are declared on different days, a reference in this Act to the day on which the result of the election is declared is a reference to the last of those days."@en ;
