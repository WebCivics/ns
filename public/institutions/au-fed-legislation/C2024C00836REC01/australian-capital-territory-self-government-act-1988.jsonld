        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) that is established by or under an enactment;",
      "cml:conclusionText": "...benefits for a person upon ceasing to hold an office of member..."
    },
