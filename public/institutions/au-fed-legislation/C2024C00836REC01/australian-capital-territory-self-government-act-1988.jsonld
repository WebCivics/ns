    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-41",
      "@type": "cml:Concept",
      "skos:prefLabel": "41 Ministers for the Territory",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-41"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.27",
      "values:originalText": "(1) The Chief Minister must appoint Ministers for the Territory from\namong the members of the Assembly.\n(2) The number of Ministers is to be as provided by enactment.\n(2A) Until provision is made, the number of Ministers is not to exceed 5.\n(3) A Minister may be dismissed from office at any time by a person\nholding office as Chief Minister at that time.",
      "skos:definition": "(1) The Chief Minister must appoint Ministers for the Territory from\namong the members of the Assembly.\n(2) The number of Ministers is to be as provided by enactment.\n(2A) Until provision is made, the number of Ministers is not to exceed 5.\n(3) A Minister may be dismissed from office at any time by a person\nholding office as Chief Minister at that time.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-41-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-41-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-41-ss-2a"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-41-ss-3"
        }
      ],
      "cml:integrityHash": "4fbe1073b032ded9ef2f62af888a94f4354c4e7b08cf50350549ccc095fee5ad"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-41",
      "@type": "cof:Section",
      "cof:title": "41 Ministers for the Territory",
      "values:kind": "section",
      "cof:pageNumber": 27,
      "values:originalText": "(1) The Chief Minister must appoint Ministers for the Territory from\namong the members of the Assembly.\n(2) The number of Ministers is to be as provided by enactment.\n(2A) Until provision is made, the number of Ministers is not to exceed 5.\n(3) A Minister may be dismissed from office at any time by a person\nholding office as Chief Minister at that time."
    },
    {
