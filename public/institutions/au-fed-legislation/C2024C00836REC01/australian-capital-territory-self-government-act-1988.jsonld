    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-21",
      "@type": "cml:Concept",
      "skos:prefLabel": "21 Standing rules and orders",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-21"
