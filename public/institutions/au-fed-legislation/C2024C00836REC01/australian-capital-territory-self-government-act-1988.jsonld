    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "3 Interpretation",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-3"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.7",
      "values:originalText": "In this Act, unless the contrary intention appears:\nAssembly means the Legislative Assembly for the Australian\nCapital Territory established by section 8.\nAttorney-General of the Territory means the Minister who has the\nresponsibility for the administration of justice in the Territory.\ncasual vacancy means a vacancy in the membership of the\nAssembly occurring otherwise than because of section 10 or 16.\nChief Magistrate means the Chief Magistrate appointed under the\nMagistrates Court Act 1930 of the Territory.\nChief Minister means the Chief Minister elected under section 40.",
      "skos:definition": "In this Act, unless the contrary intention appears:\nAssembly means the Legislative Assembly for the Australian\nCapital Territory established by section 8.\nAttorney-General of the Territory means the Minister who has the\nresponsibility for the administration of justice in the Territory.\ncasual vacancy means a vacancy in the membership of the\nAssembly occurring otherwise than because of section 10 or 16.\nChief Magistrate means the Chief Magistrate appointed under the\nMagistrates Court Act 1930 of the Territory.\nChief Minister means the Chief Minister elected under section 40.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-3-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-3-logic-deontic-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-3-logic-descriptionlogic-2"
        },
