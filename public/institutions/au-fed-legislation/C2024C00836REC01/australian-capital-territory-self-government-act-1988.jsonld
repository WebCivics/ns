    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-6",
      "@type": "cml:Concept",
      "skos:prefLabel": "6 Powers includes functions and duties",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-6"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.10",
      "values:originalText": "In this Act, unless the contrary intention appears:\n(a) a reference to powers includes a reference to functions or\nduties; and\n(b) a reference to the exercise of powers includes a reference to\nthe performance of functions or duties.\n\n\nAustralian Capital Territory  Part II\n\nSection 7\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024",
      "skos:definition": "In this Act, unless the contrary intention appears:\n(a) a reference to powers includes a reference to functions or\nduties; and\n(b) a reference to the exercise of powers includes a reference to\nthe performance of functions or duties.\n\n\nAustralian Capital Territory  Part II\n\nSection 7\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-6-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-6-logic-deontic-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-6-logic-descriptionlogic-2"
        }
      ],
      "cml:integrityHash": "3a6109eb6e81b46929ccaef7e8ee513928fffbf1b53783190ccafd96e245f07b",
      "skos:note": "A reference to powers includes a reference to functions or duties."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-6",
      "@type": "cof:Section",
      "cof:title": "6 Powers includes functions and duties",
      "values:kind": "section",
      "cof:pageNumber": 10,
      "values:originalText": "In this Act, unless the contrary intention appears:\n(a) a reference to powers includes a reference to functions or\nduties; and\n(b) a reference to the exercise of powers includes a reference to\nthe performance of functions or duties.\n\n\nAustralian Capital Territory  Part II\n\nSection 7\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024"
    },
