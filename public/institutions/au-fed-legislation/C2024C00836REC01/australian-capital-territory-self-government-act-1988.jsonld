    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-23",
      "@type": "cml:Concept",
      "skos:prefLabel": "23 Matters excluded from power to make laws",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-23"
      },
