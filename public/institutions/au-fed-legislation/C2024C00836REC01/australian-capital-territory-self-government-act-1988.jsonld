    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10",
      "@type": "cml:Concept",
      "skos:prefLabel": "10 Term of office of member",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-10"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.12",
      "values:originalText": "The term of office of a member duly elected begins at the end of\nthe day on which the election of the member is declared and,\nunless sooner ended by resignation or disqualification, or by\n\n\nLegislative Assembly  Part III\nConstitution of Assembly  Division 1\nSection 11\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024\ndissolution of the Assembly, ends on the polling day for the next\ngeneral election.",
      "skos:definition": "The term of office of a member duly elected begins at the end of\nthe day on which the election of the member is declared and,\nunless sooner ended by resignation or disqualification, or by\n\n\nLegislative Assembly  Part III\nConstitution of Assembly  Division 1\nSection 11\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024\ndissolution of the Assembly, ends on the polling day for the next\ngeneral election.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10-logic-deontic-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10-logic-alleninterval-2"
        }
      ],
      "cml:integrityHash": "3009bcfd55998c285f841b22a5b93d2631e250d2cc0312368a8024bb48344dd6",
      "skos:note": "Term of office begins at election day and ends on polling day for next general election."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-10",
      "@type": "cof:Section",
      "cof:title": "10 Term of office of member",
      "values:kind": "section",
      "cof:pageNumber": 12,
      "values:originalText": "The term of office of a member duly elected begins at the end of\nthe day on which the election of the member is declared and,\nunless sooner ended by resignation or disqualification, or by\n\n\nLegislative Assembly  Part III\nConstitution of Assembly  Division 1\nSection 11\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024\ndissolution of the Assembly, ends on the polling day for the next\ngeneral election."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10-norm",
      "@type": "values:Obligation",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "values:partOf": {
        "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10"
      },
      "values:deonticStatus": {
        "@id": "values:HeuristicDerived"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "values:borneBy": {
        "@id": "values:State"
      },
      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "holds",
      "cml:logicSummary": "Member holds office until next election.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Election day",
      "cml:conclusionText": "Term of office begins"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-10-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "overlaps",
      "cml:logicSummary": "Term of office overlaps with next general election.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "Next general election",
      "cml:conclusionText": "Term of office ends on polling day for next general election"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-11",
      "@type": "cml:Concept",
      "skos:prefLabel": "11 Presiding Officer of Assembly",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-11"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.13",
      "values:originalText": "(1) At the first meeting of the Assembly after a general election, the\nmembers present shall, before any other business, elect one of their\nnumber to be the Presiding Officer of the Assembly.\n(2) The title of the Presiding Officer shall be determined by the\nAssembly.\n(3) If there is a vacancy in the office of Presiding Officer (not because\nof a dissolution of the Assembly), then:\n(a) if the vacancy happens at a meeting, the members present\nshall, before any further business, elect one of their number\nto be the Presiding Officer; or\n(b) if the vacancy happens at any other time, at the next meeting\nthe members present shall, before any other business, elect\none of their number to be the Presiding Officer.\n(4) This section does not prevent the Assembly from appointing a\nperson to preside at meetings in the absence of the Presiding\nOfficer, but a person holding office as a Minister shall not be so\nappointed.",
      "skos:definition": "(1) At the first meeting of the Assembly after a general election, the\nmembers present shall, before any other business, elect one of their\nnumber to be the Presiding Officer of the Assembly.\n(2) The title of the Presiding Officer shall be determined by the\nAssembly.\n(3) If there is a vacancy in the office of Presiding Officer (not because\nof a dissolution of the Assembly), then:\n(a) if the vacancy happens at a meeting, the members present\nshall, before any further business, elect one of their number\nto be the Presiding Officer; or\n(b) if the vacancy happens at any other time, at the next meeting\nthe members present shall, before any other business, elect\none of their number to be the Presiding Officer.\n(4) This section does not prevent the Assembly from appointing a\nperson to preside at meetings in the absence of the Presiding\nOfficer, but a person holding office as a Minister shall not be so\nappointed.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-11-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-11-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-11-ss-3"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-11-ss-4"
        }
      ],
      "cml:integrityHash": "596dfb0fda8af004f8246595582f5f8ba991f423f307d98df16f8f4aab3076e5"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-11",
      "@type": "cof:Section",
      "cof:title": "11 Presiding Officer of Assembly",
      "values:kind": "section",
      "cof:pageNumber": 13,
      "values:originalText": "(1) At the first meeting of the Assembly after a general election, the\nmembers present shall, before any other business, elect one of their\nnumber to be the Presiding Officer of the Assembly.\n(2) The title of the Presiding Officer shall be determined by the\nAssembly.\n(3) If there is a vacancy in the office of Presiding Officer (not because\nof a dissolution of the Assembly), then:\n(a) if the vacancy happens at a meeting, the members present\nshall, before any further business, elect one of their number\nto be the Presiding Officer; or\n(b) if the vacancy happens at any other time, at the next meeting\nthe members present shall, before any other business, elect\none of their number to be the Presiding Officer.\n(4) This section does not prevent the Assembly from appointing a\nperson to preside at meetings in the absence of the Presiding\nOfficer, but a person holding office as a Minister shall not be so\nappointed."
    },
