          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-65-ss-2-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-65-ss-2-logic-deontic-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-65-ss-2-logic-deontic-2"
        }
      ],
      "cml:integrityHash": "0ee80b350a1084a7bc209d6584975992a86baaa346cd5fb2f519a342505779c7",
      "skos:note": "Prevents a member from moving an amendment to increase public money unless authorized by the Minister."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-65-ss-2",
      "@type": "cof:Section",
      "cof:title": "65(2) Proposal of money votes",
      "values:kind": "subsection",
      "cof:pageNumber": 35,
      "values:originalText": "(2) Subsection (1) does not prevent a member other than a Minister\nfrom moving an amendment to a proposal made by a Minister\nunless the amendment is to increase the amount of public money of\nthe Territory to be appropriated."
    },
