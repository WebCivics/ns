      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.13",
      "values:originalText": "(4) This section does not prevent the Assembly from appointing a\nperson to preside at meetings in the absence of the Presiding\nOfficer, but a person holding office as a Minister shall not be so\nappointed.",
      "skos:definition": "(4) This section does not prevent the Assembly from appointing a\nperson to preside at meetings in the absence of the Presiding\nOfficer, but a person holding office as a Minister shall not be so\nappointed.",
