      "skos:scopeNote": "borne by: State"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-26-ss-6-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires referendums on enactments.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(6) If an entrenching law passed by the Assembly:"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-26-ss-6-logic-descriptionlogic-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:DescriptionLogic"
      },
      "cml:operator": "applies to",
      "cml:logicSummary": "Applies to entrenching laws and enactments.",
      "cml:executionSurface": "modalities::dl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(a) includes the requirement (however expressed) that an enactment or enactments be submitted to a referendum of the electors of the Territory;"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-26-ss-6-logic-alleninterval-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "between",
      "cml:logicSummary": "Referendums must occur between specified dates.",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(b) includes provision (however expressed) that, to have effect, the referendum is to be passed by a specified majority of the electors;"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-26-ss-6-logic-ltl-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "until",
      "cml:logicSummary": "Referendums must occur until specified dates.",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(d) if the entrenching law specifies different special majorities for different enactments—the highest of those special majorities."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-26-ss-6-logic-deontic-5",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "requires",
      "cml:logicSummary": "Requires a specified majority for referendums.",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(c) that special majority;"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-27",
      "@type": "cml:Concept",
      "skos:prefLabel": "27 Crown may be bound",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-27"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.23",
      "values:originalText": "Except as provided by the regulations, an enactment does not bind\nthe Crown in right of the Commonwealth.",
      "skos:definition": "Except as provided by the regulations, an enactment does not bind\nthe Crown in right of the Commonwealth.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-27-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-27-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "0cf0f303bc820ab7f25c0a30ce8dd488c544acd92dbd3874bfdda26fc09c2dcb",
      "skos:note": "The Crown is not bound by enactments."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-27",
      "@type": "cof:Section",
      "cof:title": "27 Crown may be bound",
      "values:kind": "section",
      "cof:pageNumber": 23,
      "values:originalText": "Except as provided by the regulations, an enactment does not bind\nthe Crown in right of the Commonwealth."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-27-norm",
      "@type": "values:Obligation",
      "cml:modality": {
