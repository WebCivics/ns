    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-8-ss-3",
      "@type": "cml:Concept",
      "skos:prefLabel": "8(3) Legislative Assembly",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-8-ss-3"
      },
