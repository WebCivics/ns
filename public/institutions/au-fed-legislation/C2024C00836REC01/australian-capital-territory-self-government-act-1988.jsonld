    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48-ss-2-logic-deontic-1",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Deontic"
      },
      "cml:operator": "Prohibit",
      "cml:logicSummary": "Prohibits general election if Assembly does not elect Chief Minister within 30 days",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(Assembly passes resolution of no confidence in Chief Minister) and (Governor-General does not dissolve Assembly within 30 days)",
      "cml:conclusionText": "No general election shall be held"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48-ss-2-logic-alleninterval-2",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:AllenInterval"
      },
      "cml:operator": "Within",
      "cml:logicSummary": "Requires a general election to occur within 36-90 days after the end of the 30-day period",
      "cml:executionSurface": "modalities::interval_reasoning",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(Governor-General does not dissolve Assembly within 30 days) and (Commonwealth Minister specifies day for general election)",
      "cml:conclusionText": "General election must occur within 36-90 days after Governor-General's inaction"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48-ss-2-logic-ltl-3",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:LTL"
      },
      "cml:operator": "Until",
      "cml:logicSummary": "Requires a general election to occur until the Assembly elects a Chief Minister or the Governor-General dissolves the Assembly",
      "cml:executionSurface": "modalities::temporal_ltl",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(Assembly passes resolution of no confidence in Chief Minister) and (Governor-General does not dissolve Assembly within 30 days)",
      "cml:conclusionText": "General election continues until Assembly elects Chief Minister or Governor-General dissolves Assembly"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48-ss-2-logic-diffusion-4",
      "@type": "cml:LogicApplication",
      "cml:modality": {
        "@id": "cml:Diffusion"
      },
      "cml:operator": "If-Then",
      "cml:logicSummary": "Requires a general election if the Assembly passes a resolution of no confidence in the Chief Minister and the Governor-General does not dissolve the Assembly within 30 days",
      "cml:executionSurface": "modalities::diffusion",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:premiseText": "(Assembly passes resolution of no confidence in Chief Minister) and (Governor-General does not dissolve Assembly within 30 days)",
      "cml:conclusionText": "General election required if Assembly passes resolution of no confidence in Chief Minister and Governor-General does not act"
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48-ss-2-logic-cogai-5",
