    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-37",
      "@type": "cml:Concept",
      "skos:prefLabel": "37 General powers of Executive",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-37"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.26",
      "values:originalText": "The Executive has the responsibility of:\n(a) governing the Territory with respect to matters specified in\nSchedule 4;\n(b) executing and maintaining enactments and subordinate laws;\n(c) exercising such other powers as are vested in the Executive\nby or under a law in force in the Territory or an agreement or\narrangement between the Territory and the Commonwealth, a\nState or another Territory; and\n(d) exercising prerogatives of the Crown so far as they relate to\nthe Executive’s responsibility mentioned in paragraph (a), (b)\nor (c).",
      "skos:definition": "The Executive has the responsibility of:\n(a) governing the Territory with respect to matters specified in\nSchedule 4;\n(b) executing and maintaining enactments and subordinate laws;\n(c) exercising such other powers as are vested in the Executive\nby or under a law in force in the Territory or an agreement or\narrangement between the Territory and the Commonwealth, a\nState or another Territory; and\n(d) exercising prerogatives of the Crown so far as they relate to\nthe Executive’s responsibility mentioned in paragraph (a), (b)\nor (c).",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-37-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-37-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "35225251050a41cab5ec4fefe8fce5cff8dbae1452344db423ac0986802290e5",
      "skos:note": "The Executive has responsibility for governing the Territory and executing enactments."
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-37",
      "@type": "cof:Section",
      "cof:title": "37 General powers of Executive",
      "values:kind": "section",
      "cof:pageNumber": 26,
      "values:originalText": "The Executive has the responsibility of:\n(a) governing the Territory with respect to matters specified in\nSchedule 4;\n(b) executing and maintaining enactments and subordinate laws;\n(c) exercising such other powers as are vested in the Executive\nby or under a law in force in the Territory or an agreement or\narrangement between the Territory and the Commonwealth, a\nState or another Territory; and\n(d) exercising prerogatives of the Crown so far as they relate to\nthe Executive’s responsibility mentioned in paragraph (a), (b)\nor (c)."
    },
