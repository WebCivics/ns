    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-45",
      "@type": "cml:Concept",
      "skos:prefLabel": "45 Resignation of Ministers",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-45"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.29",
      "values:originalText": "(1) The Chief Minister may resign office as Chief Minister by written\nnotice delivered to the Presiding Officer.\n(2) Any other Minister may resign office as Minister by written notice\ndelivered to the Chief Minister.",
      "skos:definition": "(1) The Chief Minister may resign office as Chief Minister by written\nnotice delivered to the Presiding Officer.\n(2) Any other Minister may resign office as Minister by written notice\ndelivered to the Chief Minister.",
      "cml:hasPart": [
        {
