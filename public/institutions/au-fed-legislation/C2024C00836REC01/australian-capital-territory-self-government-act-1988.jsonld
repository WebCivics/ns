        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48-ss-2-logic-cogai-5"
        }
      ],
      "cml:integrityHash": "bb6d9a37ca9ffa1ba855579bf4557e13245a3dd863a3a7e10f6401ae00289de1",
      "skos:note": "No general election if Assembly does not elect Chief Minister within 30 days"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-48-ss-2",
      "@type": "cof:Section",
      "cof:title": "48(2) Resolution of no confidence in Chief Minister",
      "values:kind": "subsection",
      "cof:pageNumber": 30,
      "values:originalText": "(2) If:\n(a) on a particular day, the Assembly passes a resolution of no\nconfidence in the Chief Minister;\n(b) the Assembly does not, within the period of 30 days after that\nday, elect a Chief Minister; and\n(c) the Governor-General does not, within that period of 30 days,\ndissolve the Assembly under section 16;\na general election shall be held on a day specified by the\nCommonwealth Minister by notice published in the\nCommonwealth Gazette, being not earlier than 36 days, nor later\nthan 90 days, after the end of that period of 30 days."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-48-ss-2-norm",
