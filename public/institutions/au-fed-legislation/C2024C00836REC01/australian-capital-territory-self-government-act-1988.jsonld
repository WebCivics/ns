    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-67c",
      "@type": "cml:Concept",
      "skos:prefLabel": "67C Qualifications of electors",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-67c"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.37",
      "values:originalText": "(1) At a general election held on a particular day, a person is entitled to\nvote if:\n(a) on that day, the person’s name is on the Roll of the electors\nof the Territory for the purposes of general elections; and\n(b) the person would be entitled to vote at an election held on\nthat day to choose a member of the House of Representatives\nfor the Territory.\n(2) A person’s name is taken not to be on the Roll for the purposes of\nparagraph (1)(a) if an electoral enactment so provides.\n(3) This section does not prevent an electoral enactment from\nproviding that other persons, in addition to persons entitled under\nsubsection (1), be entitled to vote at a general election.",
      "skos:definition": "(1) At a general election held on a particular day, a person is entitled to\nvote if:\n(a) on that day, the person’s name is on the Roll of the electors\nof the Territory for the purposes of general elections; and\n(b) the person would be entitled to vote at an election held on\nthat day to choose a member of the House of Representatives\nfor the Territory.\n(2) A person’s name is taken not to be on the Roll for the purposes of\nparagraph (1)(a) if an electoral enactment so provides.\n(3) This section does not prevent an electoral enactment from\nproviding that other persons, in addition to persons entitled under\nsubsection (1), be entitled to vote at a general election.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-67c-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-67c-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-67c-ss-3"
        }
      ],
      "cml:integrityHash": "6f1f6c8a66758ca02987663dd37789e52b9df7b8e04da4847ec8d9b96d703209"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-67c",
      "@type": "cof:Section",
      "cof:title": "67C Qualifications of electors",
      "values:kind": "section",
      "cof:pageNumber": 37,
      "values:originalText": "(1) At a general election held on a particular day, a person is entitled to\nvote if:\n(a) on that day, the person’s name is on the Roll of the electors\nof the Territory for the purposes of general elections; and\n(b) the person would be entitled to vote at an election held on\nthat day to choose a member of the House of Representatives\nfor the Territory.\n(2) A person’s name is taken not to be on the Roll for the purposes of\nparagraph (1)(a) if an electoral enactment so provides.\n(3) This section does not prevent an electoral enactment from\nproviding that other persons, in addition to persons entitled under\nsubsection (1), be entitled to vote at a general election."
    },
