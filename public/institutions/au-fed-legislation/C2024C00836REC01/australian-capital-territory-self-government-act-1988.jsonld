      "values:originalText": "(1) The qualifications of a person to be elected and take a seat as a\nmember shall be as provided by enactment.",
      "skos:definition": "(1) The qualifications of a person to be elected and take a seat as a\nmember shall be as provided by enactment.",
      "cml:asserts": [
