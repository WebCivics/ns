    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-33",
      "@type": "cml:Concept",
      "skos:prefLabel": "33 Application of Acts Interpretation Act",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-33"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.24",
      "values:originalText": "Neither paragraph 46(1)(a) of the Acts Interpretation Act 1901 nor\nparagraph 13(1)(a) or (b) of the Legislation Act 2003 applies to:\n(a) an enactment;\n\n\nPowers of Legislative Assembly  Part IV\n\nSection 34\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024\n(b) a subordinate law; or\n(c) an instrument required by this Act to be published in the\nTerritory Gazette.",
      "skos:definition": "Neither paragraph 46(1)(a) of the Acts Interpretation Act 1901 nor\nparagraph 13(1)(a) or (b) of the Legislation Act 2003 applies to:\n(a) an enactment;\n\n\nPowers of Legislative Assembly  Part IV\n\nSection 34\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024\n(b) a subordinate law; or\n(c) an instrument required by this Act to be published in the\nTerritory Gazette.",
      "cml:asserts": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-33-norm"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-33-logic-deontic-1"
        }
      ],
      "cml:integrityHash": "3d01956d14962b0c70ffd5595300c27c033f0804dcf0b98a4db9547fe7f12039",
      "skos:note": "Exemptions from certain Acts"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-33",
      "@type": "cof:Section",
      "cof:title": "33 Application of Acts Interpretation Act",
      "values:kind": "section",
      "cof:pageNumber": 24,
      "values:originalText": "Neither paragraph 46(1)(a) of the Acts Interpretation Act 1901 nor\nparagraph 13(1)(a) or (b) of the Legislation Act 2003 applies to:\n(a) an enactment;\n\n\nPowers of Legislative Assembly  Part IV\n\nSection 34\nAustralian Capital Territory (Self-Government) Act 1988\nCompilation date: 11/12/2024\n(b) a subordinate law; or\n(c) an instrument required by this Act to be published in the\nTerritory Gazette."
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-33-norm",
