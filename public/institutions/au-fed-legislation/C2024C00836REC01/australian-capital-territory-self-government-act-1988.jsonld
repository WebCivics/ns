    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-66a",
      "@type": "cml:Concept",
      "skos:prefLabel": "66A Part to bind Crown",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-66a"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
