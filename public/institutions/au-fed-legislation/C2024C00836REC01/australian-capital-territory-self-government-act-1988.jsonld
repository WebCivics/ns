    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-43",
      "@type": "cml:Concept",
      "skos:prefLabel": "43 Ministerial portfolios",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-43"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.28",
      "values:originalText": "(1) A Minister shall administer such matters relating to the powers of\nthe Executive as are allocated to that Minister from time to time by\nthe Chief Minister.\n(2) The Chief Minister may authorise a Minister or Ministers to act on\nbehalf of the Chief Minister or any other Minister.\n(3) The Chief Minister shall publish particulars of such arrangements\nin the Territory Gazette.",
      "skos:definition": "(1) A Minister shall administer such matters relating to the powers of\nthe Executive as are allocated to that Minister from time to time by\nthe Chief Minister.\n(2) The Chief Minister may authorise a Minister or Ministers to act on\nbehalf of the Chief Minister or any other Minister.\n(3) The Chief Minister shall publish particulars of such arrangements\nin the Territory Gazette.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-43-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-43-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-43-ss-3"
        }
      ],
      "cml:integrityHash": "f704ddf813218fb8df04c12d051539c855988bd2e869f8c9d675daaa10b829d7"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-43",
      "@type": "cof:Section",
      "cof:title": "43 Ministerial portfolios",
      "values:kind": "section",
      "cof:pageNumber": 28,
      "values:originalText": "(1) A Minister shall administer such matters relating to the powers of\nthe Executive as are allocated to that Minister from time to time by\nthe Chief Minister.\n(2) The Chief Minister may authorise a Minister or Ministers to act on\nbehalf of the Chief Minister or any other Minister.\n(3) The Chief Minister shall publish particulars of such arrangements\nin the Territory Gazette."
    },
