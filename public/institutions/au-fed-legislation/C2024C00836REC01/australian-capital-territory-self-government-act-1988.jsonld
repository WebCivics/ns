      },
      "cml:operator": "must",
      "cml:logicSummary": "Mandatory obligation",
      "cml:executionSurface": "modalities::logic::deontic",
      "cml:confidence": {
        "@value": 1.0,
        "@type": "xsd:decimal"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      }
    },
    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-13",
      "@type": "cml:Concept",
      "skos:prefLabel": "13 Resignation of members",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-13"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
        "@id": "australian-capital-territory-self-government-act-1988.pdf"
      },
      "dc:source": "australian-capital-territory-self-government-act-1988.pdf, p.14",
      "values:originalText": "(1) A member may resign office as a member by written notice\ndelivered to a person authorised by the Assembly to receive it.\n(2) The Presiding Officer may resign office as Presiding Officer by\nwritten notice delivered to a person authorised by the Assembly to\nreceive it.\n(3) The person receiving a notice of resignation must arrange for it to\nbe laid before the Assembly as soon as practicable after receiving\nthat notice.",
      "skos:definition": "(1) A member may resign office as a member by written notice\ndelivered to a person authorised by the Assembly to receive it.\n(2) The Presiding Officer may resign office as Presiding Officer by\nwritten notice delivered to a person authorised by the Assembly to\nreceive it.\n(3) The person receiving a notice of resignation must arrange for it to\nbe laid before the Assembly as soon as practicable after receiving\nthat notice.",
      "cml:hasPart": [
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-13-ss-1"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-13-ss-2"
        },
        {
          "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-13-ss-3"
        }
      ],
      "cml:integrityHash": "90a661816a411c493dca6707a7ddffed04209d265a58f21e8a9d11320aa79985"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-13",
      "@type": "cof:Section",
      "cof:title": "13 Resignation of members",
      "values:kind": "section",
      "cof:pageNumber": 14,
      "values:originalText": "(1) A member may resign office as a member by written notice\ndelivered to a person authorised by the Assembly to receive it.\n(2) The Presiding Officer may resign office as Presiding Officer by\nwritten notice delivered to a person authorised by the Assembly to\nreceive it.\n(3) The person receiving a notice of resignation must arrange for it to\nbe laid before the Assembly as soon as practicable after receiving\nthat notice."
    },
