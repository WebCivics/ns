        }
      ],
      "cml:integrityHash": "f8c991063f3c85ace8ee07bde66ef630f9a4653b352762dffc5bd571f1f9930b",
      "skos:note": "Enactment requires majority vote for Assembly size changes"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-8-ss-3",
      "@type": "cof:Section",
      "cof:title": "8(3) Legislative Assembly",
      "values:kind": "subsection",
      "cof:pageNumber": 12,
      "values:originalText": "(3) An enactment providing for the number of members of the\nAssembly (or an enactment amending or repealing such an\nenactment) has no effect unless it is passed by a number of\nmembers at least equal to two-thirds of the number of members\nprovided for, at that time, by or in accordance with subsection (2)."
    },
