      "cml:integrityHash": "211b896a81954adea775534c6fa7012ea362dc7bfd2d29cd6cb6e99544b7c98e",
      "skos:note": "Ensure equal treatment of Territory as States and Northern Territory"
    },
    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-59-ss-1",
      "@type": "cof:Section",
      "cof:title": "59(1) Financial relations between Commonwealth and Territory",
      "values:kind": "subsection",
      "cof:pageNumber": 34,
      "values:originalText": "(1) The Commonwealth shall conduct its financial relations with the\nTerritory so as to ensure that the Territory is treated on the same\nbasis as the States and the Northern Territory, while having regard\nto the special circumstances arising from the existence of the\nnational capital and the seat of government of the Commonwealth\nin the Territory."
    },
