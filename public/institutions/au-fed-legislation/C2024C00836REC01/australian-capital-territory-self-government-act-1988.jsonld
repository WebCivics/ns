    {
      "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-45",
      "@type": "cof:Section",
      "cof:title": "45 Resignation of Ministers",
      "values:kind": "section",
      "cof:pageNumber": 29,
      "values:originalText": "(1) The Chief Minister may resign office as Chief Minister by written\nnotice delivered to the Presiding Officer.\n(2) Any other Minister may resign office as Minister by written notice\ndelivered to the Chief Minister."
    },
