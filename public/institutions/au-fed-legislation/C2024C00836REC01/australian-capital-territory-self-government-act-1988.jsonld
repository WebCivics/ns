    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-9",
      "@type": "cml:Concept",
      "skos:prefLabel": "9 Oath or Affirmation of Allegiance",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-9"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
        "@id": "https://ns.webcivics.net/tools/legis2cml"
      },
      "prov:wasDerivedFrom": {
