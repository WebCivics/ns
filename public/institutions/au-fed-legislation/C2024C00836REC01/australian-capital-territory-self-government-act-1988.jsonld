    {
      "@id": "concept:australian-capital-territory-self-government-act-1988-sch-5-sec-34",
      "@type": "cml:Concept",
      "skos:prefLabel": "34 Certain laws converted into enactments",
      "cml:realizedBy": {
        "@id": "https://ns.webcivics.net/values/australian-capital-territory-self-government-act-1988#sch-5-sec-34"
      },
      "cml:curationStatus": {
        "@id": "cml:Proposed"
      },
      "cml:schemaVersion": "2",
      "cml:proposedBy": {
